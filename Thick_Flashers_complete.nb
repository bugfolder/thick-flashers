      RowBox[{"GoldbergTiling", "[", 
       RowBox[{"7", ",", "2", ",", 
        RowBox[{"Numeric", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"EmbedTiling", "[", 
        RowBox[{"tiling", ",", "Tiling", ",", 
         RowBox[{"TileIndices", "\[Rule]", "True"}], ",", 
         RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
         RowBox[{"Numeric", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.631638020316904*^9, 3.6316380708122463`*^9}, {
   3.631638169755094*^9, 3.631638195952936*^9}, {3.631638956030108*^9, 
   3.631639010810246*^9}, {3.631639040999403*^9, 3.631639066717733*^9}, {
   3.631639213149783*^9, 3.631639216994059*^9}, 3.691001640676555*^9},
 CellLabel->
