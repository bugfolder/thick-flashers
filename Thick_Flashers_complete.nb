Cell[TextData[{
 "TransformGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "] applies the transformation to any GraphicsComplex objects in the \
expression."
}], "Text",
