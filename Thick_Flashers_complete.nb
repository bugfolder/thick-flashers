Cell[BoxData[
 RowBox[{
  RowBox[{"ConicSection2DSystem", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fl_",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["fr_",
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["hl_",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["hr_",
       FontSlant->"Italic"]}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "sfn", ",", "t", ",", "f", ",", "bl", ",", "cl", ",",
       "dl", ",", "el", ",", "br", ",", "cr", ",", "dr", ",", "er"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fl", "\[Equal]", "0"}], "||", 
        RowBox[{"fl", "\[Equal]", "\[Infinity]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"ConicSection2DSystem", "::", "badleft"}], ",", "fl"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fr", "\[Equal]", "0"}], "||", 
        RowBox[{"fr", "\[Equal]", 
         RowBox[{"-", "\[Infinity]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"ConicSection2DSystem", "::", "badright"}], ",", "fr"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
