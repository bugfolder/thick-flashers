Cell[BoxData[
 RowBox[{
  RowBox[{"CurvedFoldUniformHelix2D", "[", 
   RowBox[{"r_", ",", "\[Theta]_", ",", "\[Gamma]0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"r", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{"Tan", "[", "\[Theta]", "]"}], "#"}]}], "}"}]}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"\[Gamma]0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           FractionBox["1", "4"], " ", 
           RowBox[{"(", 
            RowBox[{"3", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"4", " ", "r", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", 
                   RowBox[{"Cos", "[", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], 
                    "]"}]}], ")"}], " ", 
                 RowBox[{"Sec", "[", 
                  FractionBox["\[Gamma]0", "2"], "]"}]}]}], ")"}], " ", 
              SuperscriptBox[
               RowBox[{"Sec", "[", "\[Theta]", "]"}], "2"]}], "-", 
             SuperscriptBox[
              RowBox[{"Tan", "[", "\[Theta]", "]"}], "2"]}], ")"}]}], ",", 
          RowBox[{"r", " ", 
           RowBox[{"Sec", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}], " ", 
           SuperscriptBox[
            RowBox[{"Sec", "[", "\[Theta]", "]"}], "2"], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"Cos", "[", 
              FractionBox["\[Gamma]0", "2"], "]"}], " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], "]"}]}]}], 
         "}"}], "&"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
             SqrtBox["2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"Cos", "[", 
                   FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                  RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], "]"}], " ", 
                RowBox[{"Sin", "[", 
                 FractionBox["\[Gamma]0", "2"], "]"}]}], "+", 
               RowBox[{
                RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{
                  RowBox[{"Cos", "[", 
                   FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                  RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], 
                 "]"}]}]}], ")"}]}], 
            SqrtBox[
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
               SuperscriptBox[
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]]}], ",", 
          FractionBox[
           RowBox[{
            SqrtBox["2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], "]"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Sin", "[", 
                FractionBox["\[Gamma]0", "2"], "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], 
                "]"}]}]}], ")"}]}], 
           SqrtBox[
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]]}], "}"}], "&"}],
        ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox["2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Cos", "[", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], "]"}], " ", 
               RowBox[{"Sin", "[", 
                FractionBox["\[Gamma]0", "2"], "]"}]}], "-", 
              RowBox[{
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], 
                "]"}]}]}], ")"}]}], 
           SqrtBox[
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]], ",", 
          FractionBox[
           RowBox[{
            SqrtBox["2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], "]"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Sin", "[", 
                FractionBox["\[Gamma]0", "2"], "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  FractionBox["\[Gamma]0", "2"], "]"}], " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "#1"}], 
                "]"}]}]}], ")"}]}], 
           SqrtBox[
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]]}], "}"}], "&"}],
        ",", 
       RowBox[{"\[Gamma]0", "&"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.79974476769153*^9, 3.799744784857356*^9}, {
