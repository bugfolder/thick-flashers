  3.922206651246937*^9}},ExpressionUUID->"11ebb42a-446d-461f-ad6c-\
17d8004831a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "gc", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gc", "=", "CubeGC"}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", "gc", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"gc", ",", "SolidStyle"}], "]"}], "]"}]}]}], 
