       RowBox[{"FlapWidth", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeFlapCubeBox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fi", "=", 
      RowBox[{"fw", " ", 
       RowBox[{"Cot", "[", "fa", "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"inset", " ", "distance"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"fi", "\[GreaterEqual]", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeFlapCubeBox", "::", "badflap"}], ",", "fw", ",", 
          "fa"}], "]"}], ";", 
