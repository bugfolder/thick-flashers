Cell["\<\
Example. Use a circular arc, a conical set of rulings on the left, and a \
linear increase in fold angle from zero.\
\>", "Text",
 CellChangeTimes->{{3.799499951552946*^9, 3.799499952817136*^9}, {
  3.7997055703186483`*^9, 3.79970558343076*^9}, {3.79970565444727*^9, 
