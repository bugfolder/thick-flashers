Cell[TextData[{
 "ParaboloidalFlasherIsometryFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m, f, opts",
  FontSlant->"Italic"],
