Cell[BoxData[
 RowBox[{
  RowBox[{"ReshapeTandev3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"b_Function", ",", "d_Function", ",", "\[Sigma]_"}], "}"}], ",", 
    "\[Tau]_Function", ",", "\[Psi]_", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bbi_List", ",", "ddi_List", ",", "uui_List"}], 
     "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sim", ",", "as", ",", "sfn", ",", "dsopts", ",", "s", ",", "ds", ",", 
      "t", ",", "l", ",", "u", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", 
      "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", "sd\[Tau]g", ",", "\[Zeta]", ",",
       "\[IndentingNewLine]", "lli", ",", "tti", ",", "tt", ",", "ll", ",", 
      "uu", ",", "bb", ",", "dd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sim", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ReshapeTandev3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", 
        RowBox[{
         RowBox[{"Assumptions", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "ReshapeTandev3D", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sim", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"sim", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "algorithm", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"b", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"db", "=", 
             RowBox[{
              RowBox[{"b", "'"}], "[", "s", "]"}]}], "}"}], ",", 
           RowBox[{"NormalizeReal", "[", "db", "]"}]}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ddd", "=", 
             RowBox[{
              RowBox[{"d", "'"}], "[", "s", "]"}]}], "}"}], ",", 
           RowBox[{"\[Sigma]", " ", "\[Psi]", " ", 
            RowBox[{
             RowBox[{"NormalizeReal", "[", "ddd", "]"}], "\[Cross]", 
             RowBox[{"d", "[", "s", "]"}]}]}]}], "]"}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{
           RowBox[{"t", "'"}], "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g", "=", "\[Tau]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Zeta]", "=", 
      RowBox[{
       RowBox[{"t", "[", "ui", "]"}], ".", 
       RowBox[{"d", "[", "ui", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tti", "=", 
      RowBox[{"\[Zeta]", " ", "ddi"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lli", " ", "=", " ", 
      RowBox[{"uui", " ", "\[Cross]", "tti"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "tt", ",", "ll", ",", "uu"}], "}"}], "=", 
      RowBox[{"RecoverDarboux3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ds", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", "sd\[Tau]g"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "tti", ",", "lli", ",", "uui"}], 
         "}"}], ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Zeta]", " ", 
          RowBox[{"tt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}]}]}], "]"}]}]], "Input",\

