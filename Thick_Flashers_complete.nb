Cell[BoxData[
 RowBox[{
  RowBox[{"TwistCreasePatternLines", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "types"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "types"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "EdgeTypes"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{"Style", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{
            "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
            "]"}], "&"}], "/@", "edges"}], ",", 
         RowBox[{"types", "/.", "TypeToCreasePatternStyleRules"}]}], "}"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
