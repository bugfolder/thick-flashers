Cell[CellGroupData[{

Cell["Yoshimura-Miura-ori", "Subsection",
 CellChangeTimes->{{3.642339969596236*^9, 3.642339982040982*^9}, {
   3.642359920162285*^9, 3.642359924163896*^9}, {3.642631572094855*^9, 
   3.642631573597302*^9}, {3.643119543889488*^9, 3.643119564667826*^9}, 
   3.643239763503297*^9, 
   3.703598045687562*^9},ExpressionUUID->"94cb092e-b4af-4385-8f44-\
2bc07c5889cb"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.642339987029708*^9, 
  3.642339987427761*^9}},ExpressionUUID->"20beb89a-2ed0-4efd-aac5-\
875414678ded"],

Cell["\<\
A \[OpenCurlyDoubleQuote]Yoshimura-Miura ori\[CloseCurlyDoubleQuote] is a \
generalization of the Yoshimura and Miura-ori patterns that can describe \
combinations of the two patterns, including Miura\[CloseCurlyQuote]s original \
method of splicing together positive and negative curvature Yoshimura \
patterns.\
\>", "Text",
 CellChangeTimes->{{3.642339989054991*^9, 
  3.6423400985880013`*^9}},ExpressionUUID->"c7efc177-4885-4bd8-995a-\
1c59ae36d3c8"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeYoshimuraMiuraOri[",
 StyleBox["alist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 ", \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nMakeYoshimuraMiuraOri[\[Alpha], {",
 StyleBox["runs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}, \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.642341624530274*^9, {3.642591669376007*^9, 3.642591669740275*^9}, {
   3.642591793939969*^9, 3.642591803910603*^9}, {3.642600184844102*^9, 
   3.6426002130299807`*^9}, {3.642600243089184*^9, 3.642600248461362*^9}, {
   3.642601960065381*^9, 3.642601962211811*^9}, {3.6426021869747252`*^9, 
   3.64260219877277*^9}, {3.6426033014038963`*^9, 3.642603302474794*^9}, 
   3.6426034371061707`*^9, {3.642603472290635*^9, 3.642603480710105*^9}, {
   3.642623500356611*^9, 
   3.642623502451737*^9}},ExpressionUUID->"00c33149-b437-4a04-930e-\
429ee638e27e"],

Cell[TextData[{
 "MakeYoshimuraMiuraOri[",
 StyleBox["alist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 ", \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraph3D+TAssigned+TCornerIndices that represents a \
Yoshimura-Miura ori where\n\t",
 StyleBox["alist",
  FontSlant->"Italic"],
 " is a list of the signed tilt angles in each column, positive=tilt-up, \
negative=tilt-down.\n\t",
 StyleBox["nv",
  FontSlant->"Italic"],
 " is the number of rows in the pattern.\n\t\[Gamma] is the signed fold angle \
of the horizontal folds in the first column\nThe fold pattern is a series of \
vertical stripes of rectangles, each of which is crossed by a diagonal fold \
that slopes upward or downward at angle \[Alpha]. The offset from stripe to \
strip is determined by the requirements of flat-foldability at the vertices \
and the values in ",
 StyleBox["alist",
  FontSlant->"Italic"],
 ". Options are:\n\tOptions[FoldGraph3D] are passed through. (See, e.g., \
StationaryFace.)"
}], "Text",
 CellChangeTimes->{{3.642340248926059*^9, 3.64234027629237*^9}, {
   3.642341082519075*^9, 3.642341253780287*^9}, {3.64234133776624*^9, 
   3.642341340776283*^9}, {3.642341377874543*^9, 3.642341401621662*^9}, {
   3.642341454664818*^9, 3.64234160359496*^9}, {3.642345988888227*^9, 
   3.642346019983223*^9}, {3.642347326132826*^9, 3.642347350975942*^9}, 
   3.642591019066684*^9, {3.642591192569651*^9, 3.642591216330982*^9}, {
   3.642591672369001*^9, 3.642591827171427*^9}, {3.642601966803692*^9, 
   3.642601983073469*^9}, 3.64260344077828*^9, {3.642603497614812*^9, 
   3.6426035997201023`*^9}, {3.642623523221652*^9, 3.6426235235586033`*^9}, {
   3.643239731097626*^9, 
   3.643239734072691*^9}},ExpressionUUID->"305a5a24-0096-4d26-b139-\
52a6e294bdf6"],

Cell[TextData[{
 "Sign-alternating values in ",
 StyleBox["alist",
  FontSlant->"Italic"],
 " give rise to a Yoshimura pattern; a run of same-sign values gives the \
Miura-ori pattern. "
}], "Text",
 CellChangeTimes->{
  3.642603576497071*^9, {3.642603611862671*^9, 
   3.642603635081658*^9}},ExpressionUUID->"e1fe950b-8756-4921-8479-\
66430534aeaa"],

Cell["\<\
TBD: this is the only function where the vertex numbering starts out \
vertically. It would be nice to rewrite it to run horizontally.\
\>", "Text",
 CellChangeTimes->{{3.642624354291364*^9, 
  3.642624378278941*^9}},ExpressionUUID->"c375cba3-aa01-4c53-a3c0-\
f43fd03348f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeYoshimuraMiuraOri", "[", 
   RowBox[{"alist_List", ",", "nv_", ",", "\[Gamma]_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nh", ",", "gp", ",", "vertfn", ",", "verts", ",", "edges", ",", 
      "foldangles", ",", "types", ",", "tbase", ",", "tilt", ",", "asign", ",",
       "ibl", ",", "ibr", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nh", "=", 
      RowBox[{"Length", "[", "alist", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"number", " ", "of", " ", "columns"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"build", " ", "a", " ", "grid", " ", "of", " ", "vertices"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vertfn", "[", 
       RowBox[{"0", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vertfn", "[", 
        RowBox[{"0", ",", "j"}], "]"}], "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "j"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vertfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vertfn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vertfn", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", "j"}], "]"}], "+", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"Cot", "[", 
            RowBox[{
            "alist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "]"}], "]"}], ",", "0"}], "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"vertfn", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "nh"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "nv"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"foldangles", "=", 
       RowBox[{"types", "=", 
        RowBox[{"{", "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "edges", " ", "and", " ", "fold", " ", "angles"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"left", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"j", "+", "1"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", "0"}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", "B"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"each", " ", "full", " ", "column"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"bottom", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "-", "1"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}]}], ",", 
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"(", "i", ")"}], 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}]}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", "0"}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", "B"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "column", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"tbase", " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[Equal]", "1"}], ",", 
           RowBox[{"Sign", "[", 
            RowBox[{
            "alist", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sign", "[", 
               RowBox[{
               "alist", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "]"}], "\[NotEqual]", 
              RowBox[{"Sign", "[", 
               RowBox[{"alist", "\[LeftDoubleBracket]", 
                RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}], "]"}]}], ",", 
             RowBox[{"-", "tbase"}], ",", "tbase"}], "]"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"tilt", " ", "of", " ", "bottom", " ", "row"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"asign", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[Equal]", "1"}], ",", 
           RowBox[{"Sign", "[", "\[Gamma]", "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sign", "[", 
               RowBox[{
               "alist", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "]"}], "\[NotEqual]", 
              RowBox[{"Sign", "[", 
               RowBox[{"alist", "\[LeftDoubleBracket]", 
                RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}], "]"}]}], ",",
              "asign", ",", 
             RowBox[{"-", "asign"}]}], "]"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"sign", " ", "of", " ", "fold", " ", "angles"}], " ", "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ibl", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "-", "1"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}], "+", "j"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
            "index", " ", "of", " ", "bottom", " ", "left", " ", "corner"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"ibr", "=", 
            RowBox[{"ibl", "+", 
             RowBox[{"(", 
              RowBox[{"1", "+", "nv"}], ")"}]}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
            "index", " ", "of", " ", "bottom", " ", "right", " ", "corner"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", " ", "diagonal", " ", "*)"}], "\[IndentingNewLine]", 
           
           RowBox[{"tilt", "=", 
            RowBox[{"tbase", "*", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"j", ",", "2"}], "]"}], "\[Equal]", "1"}], ",", "1", 
               ",", 
               RowBox[{"-", "1"}]}], "]"}]}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"tilt", " ", "within", " ", "this", " ", 
               RowBox[{"cell", ":", " ", 
                RowBox[{"+", "1"}]}]}], "=", "up"}], ",", " ", 
             RowBox[{
              RowBox[{"-", "1"}], "=", "down"}]}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"edges", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"tilt", ">", "0"}], ",", 
               RowBox[{"{", 
                RowBox[{"ibl", ",", 
                 RowBox[{"ibr", "+", "1"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ibl", "+", "1"}], ",", "ibr"}], "}"}]}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"gp", "=", 
            RowBox[{
             RowBox[{"-", "2"}], " ", 
             RowBox[{"ArcCot", "[", 
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{
                "alist", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}], "]"}], 
               RowBox[{"Cot", "[", 
                RowBox[{"\[Gamma]", "/", "2"}], "]"}]}], "]"}]}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"signed", " ", "major", " ", "fold", " ", "angle"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"foldangles", ",", 
             RowBox[{"asign", "*", "gp"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"types", ",", 
             RowBox[{"Switch", "[", 
              RowBox[{
               RowBox[{"Sign", "[", 
                RowBox[{"asign", "*", "gp"}], "]"}], ",", "1", ",", "V", ",", 
               
               RowBox[{"-", "1"}], ",", "M", ",", "0", ",", "U"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"top", " ", "of", " ", "cell"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"edges", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ibr", "+", "1"}], ",", 
               RowBox[{"ibl", "+", "1"}]}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"foldangles", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"j", "\[Equal]", "nv"}], ",", "0", ",", 
               RowBox[{"asign", "*", "\[Gamma]"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"types", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"j", "\[Equal]", "nv"}], ",", "B", ",", 
               RowBox[{"Switch", "[", 
                RowBox[{
                 RowBox[{"Sign", "[", 
                  RowBox[{"asign", "*", "\[Gamma]"}], "]"}], ",", "1", ",", 
                 "V", ",", 
                 RowBox[{"-", "1"}], ",", "M", ",", "0", ",", "U"}], "]"}]}], 
              "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"right", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"nh", 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}], "+", "j"}], ",", 
            RowBox[{
             RowBox[{"nh", 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}], "+", "j", "+", "1"}]}], 
           "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", "0"}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", "B"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"MakeTGraph", "[", 
          RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], "//", 
        RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
       RowBox[{"AddTCornerIndices", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}], "nh"}], "+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"nv", "+", "1"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nv", "+", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"nh", "+", "1"}], ")"}]}]}], "}"}]}], "}"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"FoldGraph3D", "[", 
      RowBox[{"tobj", ",", "foldangles", ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.642341639382946*^9, 3.642341717581852*^9}, {
   3.642341849742863*^9, 3.642341868648898*^9}, {3.642342237346209*^9, 
   3.642342361287148*^9}, {3.64234245984105*^9, 3.642342516792337*^9}, {
   3.642342552335288*^9, 3.642342674763942*^9}, {3.642342712743418*^9, 
   3.642342864402365*^9}, {3.642343342755734*^9, 3.642343410930844*^9}, {
   3.6423434638315067`*^9, 3.642343581650497*^9}, {3.642343618677451*^9, 
   3.6423436657528057`*^9}, {3.642343702326556*^9, 3.642343772569965*^9}, {
   3.6423438067316008`*^9, 3.642343852546088*^9}, {3.642343889123172*^9, 
   3.642343994139618*^9}, {3.642344790263754*^9, 3.642344992402982*^9}, {
   3.6423451145119143`*^9, 3.642345153892143*^9}, {3.642345206869294*^9, 
   3.642345455457258*^9}, {3.6423454957979403`*^9, 3.642345614723304*^9}, {
   3.64234595244011*^9, 3.642345957644287*^9}, {3.6423460371658363`*^9, 
   3.6423460937542763`*^9}, {3.642346350995802*^9, 3.642346403659262*^9}, {
   3.642346452098784*^9, 3.642346620119353*^9}, {3.642346687980973*^9, 
   3.64234670615333*^9}, {3.642346771314746*^9, 3.642346816323002*^9}, {
   3.642346986905072*^9, 3.64234699038759*^9}, {3.64234704712718*^9, 
   3.642347073593214*^9}, {3.642347147921391*^9, 3.642347239805175*^9}, {
   3.642347291891696*^9, 3.642347320748411*^9}, {3.642347365189665*^9, 
   3.642347372398436*^9}, {3.642347599049115*^9, 3.642347602722352*^9}, {
   3.642347703109519*^9, 3.642347922489717*^9}, {3.642591586934481*^9, 
   3.642591603064393*^9}, {3.642591841295656*^9, 3.642592044075777*^9}, 
   3.642592087886681*^9, {3.642601323290317*^9, 3.642601324882942*^9}, {
   3.642601992814323*^9, 3.642601994488738*^9}, {3.642602108000572*^9, 
   3.642602126586021*^9}, {3.642602314605513*^9, 3.64260232453935*^9}, {
   3.642602369347378*^9, 3.64260240442153*^9}, {3.642602449783907*^9, 
   3.6426024502209473`*^9}, {3.642602511266808*^9, 3.642602549589518*^9}, {
   3.642602584975156*^9, 3.642602593783123*^9}, {3.642602646753767*^9, 
   3.642602892844182*^9}, {3.642602984390236*^9, 3.6426029876777267`*^9}, {
   3.642610633710166*^9, 3.642610638738021*^9}, {3.642610681870932*^9, 
   3.642610743655847*^9}, 3.642614118945745*^9, 3.642623506169853*^9, {
   3.643239487630651*^9, 3.643239500993575*^9}, {3.643239538692654*^9, 
   3.643239566081294*^9}},
