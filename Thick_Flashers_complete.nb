      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "q", ",", "z", ",", "t", ",", "gg", ",", "aa", ",", "mji", ",", 
        "mni"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
