   RowBox[{"Options", "[", "FoldLinearChain", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"RotateToZ", "\[Rule]", "True"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.443018995863688*^9, 3.443019014072824*^9}, {
   3.443020126930275*^9, 3.443020127249515*^9}, 3.592829655891449*^9, 
