Cell[CellGroupData[{

Cell["RigidlyFoldableDuckGraph3DAssigned", "Subsubsection",
 CellChangeTimes->{{3.731193243177878*^9, 3.731193250376576*^9}, {
   3.833025314897537*^9, 3.833025321771966*^9}, 
   3.962634845121516*^9},ExpressionUUID->"fc99ac39-f957-40e6-a911-\
2f87111f6d3c"],

Cell["\<\
This is a crease assignment that gives a rigidly foldable pattern where all \
of the angles move relatively together.\
\>", "Text",
 CellChangeTimes->{{3.707681210557097*^9, 
