Cell["Example. Show the name, patch, and a 2x2 lattice.", "Text",
 CellChangeTimes->{{3.631140668685993*^9, 3.631140670986658*^9}, {
   3.631144977830364*^9, 3.6311449792146397`*^9}, {3.631145226948807*^9, 
