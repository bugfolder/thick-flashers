   3.707868660444245*^9, 3.707868664042342*^9}, {3.707903150793907*^9, 
   3.707903209908344*^9}, {3.707903252655496*^9, 3.707903332056777*^9}, {
   3.707903371625989*^9, 3.707903407387201*^9}, {3.707903478363647*^9, 
   3.707903509434166*^9}, {3.707903558561436*^9, 3.707903566395375*^9}, {
