}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeTVertexFromCreaseVectors[",
 StyleBox["creasevectors",
  FontSlant->"Italic"],
 ", foldangles]\nMakeTVertexFromAngles[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", foldangles",
 StyleBox[", opts",
  FontSlant->"Italic"],
 "]\n\t(options) OffsetAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.594942610215967*^9, 3.594942629709951*^9}, {
   3.5975071721879177`*^9, 3.597507214177578*^9}, {3.597507631959015*^9, 
   3.597507647972739*^9}, 3.61617378575276*^9, {3.7045708591864243`*^9, 
   3.7045708592235208`*^9}},ExpressionUUID->"36810f32-589d-4f49-8c20-\
5f7dcc258f67"],

Cell[TextData[{
 "MakeTVertexFromCreaseVectors[",
 StyleBox["creasevectors",
  FontSlant->"Italic"],
 ", foldangles] creates a TVertex with the given crease vectors and dihedral \
angles. The sector angles are given as the actual angles between the 2D \
crease vectors."
}], "Text",
 CellChangeTimes->{{3.597507228944982*^9, 3.5975072450872*^9}, {
   3.597507336379035*^9, 3.597507365919367*^9}, 
   3.704570859270102*^9},ExpressionUUID->"bc63b757-5984-417b-b2dc-\
f5a28ff0e0f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTVertexFromCreaseVectors", "[", 
   RowBox[{
    StyleBox["creasevectors_List",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["foldangles_List",
     FontSlant->"Italic"]}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sectorangles", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sectorangles", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"RotationAngle", ",", 
        RowBox[{"{", 
         RowBox[{"creasevectors", ",", 
          RowBox[{"RotateLeft", "[", "creasevectors", "]"}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTObj", "[", 
      RowBox[{"TVertex", ",", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SectorAngles", "\[Rule]", "sectorangles"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DihedralAngles", "\[Rule]", "foldangles"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DihedralTypes", "\[Rule]", 
          RowBox[{"FoldAngleToType", "[", "foldangles", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreaseVectors", "\[Rule]", "creasevectors"}]}], "}"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.59750725787196*^9, 3.597507271601213*^9}, {
   3.597507314166341*^9, 3.597507322525051*^9}, {3.597507378281498*^9, 
   3.597507420793948*^9}, {3.59750745326175*^9, 3.597507465513401*^9}, {
   3.597507518919676*^9, 3.597507532036231*^9}, {3.59751564845558*^9, 
   3.597515650572356*^9}, 3.628786222465103*^9, {3.704570859291621*^9, 
   3.704570859313392*^9}, 3.778749050406064*^9},
 CellLabel->
  "In[2126]:=",ExpressionUUID->"85f594bc-704b-4dde-b2ae-7057d8cd6d47"],

Cell["Example", "Text",
 CellChangeTimes->{{3.594942921118313*^9, 
  3.594942921899295*^9}},ExpressionUUID->"973674c3-b3a8-40f8-86fc-\
c461276910e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cv", ",", "da", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cv", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"U", "[", 
         RowBox[{"0", "\[Degree]"}], "]"}], ",", 
        RowBox[{"U", "[", 
         RowBox[{"120", "\[Degree]"}], "]"}], ",", 
        RowBox[{"U", "[", 
         RowBox[{"180", "\[Degree]"}], "]"}], ",", 
        RowBox[{"U", "[", 
         RowBox[{"240", "\[Degree]"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"da", "=", 
      RowBox[{"{", 
       RowBox[{"\[Pi]", ",", "\[Pi]", ",", 
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertexFromCreaseVectors", "[", 
       RowBox[{"cv", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "//", "GetAllRules"}], "//", "ColumnForm"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594942925277827*^9, 3.594942996431424*^9}, 
   3.59750717268696*^9, {3.597507546694933*^9, 3.597507602234375*^9}, 
   3.628786729084545*^9, 3.628786796585545*^9},
 CellLabel->
  "In[2127]:=",ExpressionUUID->"cbeb0abb-340b-4abd-b133-8fb8139e784f"],

Cell[TextData[{
 "MakeTVertexFromAngles[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", foldangles",
 StyleBox[", opts",
  FontSlant->"Italic"],
 "] creates a TVertex with the given sector angles and dihedral angles. The \
first crease is taken to lie along the x-axis unless OffsetAngle is \
specified. Options are:\n\tOffsetAngle \[Rule] \[Alpha], where \[Alpha] is \
the absolute angle of the first crease."
}], "Text",
 CellChangeTimes->{{3.59494263725768*^9, 3.594942677363021*^9}, {
   3.595001289231485*^9, 3.5950012950871*^9}, {3.597507070470456*^9, 
   3.597507086111062*^9}, 3.59750717240799*^9, {3.597507249454645*^9, 
   3.597507251606483*^9}, {3.597507654452607*^9, 3.597507698337205*^9}, 
   3.616173785875044*^9, 
   3.704570859362076*^9},ExpressionUUID->"6d74fffe-616a-4626-93a6-\
0399a180305a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OffsetAngle", "::", "usage"}], 
   "=", "\"\<OffsetAngle is an option to MakeTVertexFromAngles that specifies \
the offset angle to use for the first crease relative to the x-axis.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.597507730786253*^9, 3.597507763605036*^9}, 
   3.616173785951041*^9},
 CellLabel->
  "In[2128]:=",ExpressionUUID->"aa85adfe-e314-461c-80f3-a8a76eddede1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeTVertexFromAngles", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"OffsetAngle", "\[Rule]", "0"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.597507711963725*^9, 3.597507726329763*^9}, 
   3.616173786050383*^9},
 CellLabel->
  "In[2129]:=",ExpressionUUID->"d853d335-b340-4e75-af4e-0104a0918410"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTVertexFromAngles", "::", "badangles"}], 
   "=", "\"\<Sector angles `1` and dihedral angles `2` must have the same \
number of entries.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.616174546796907*^9, 3.616174565962866*^9}},
 CellLabel->
  "In[2130]:=",ExpressionUUID->"39a33b99-3fe2-44b2-a562-c643e664e182"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTVertexFromAngles", "[", 
   RowBox[{"sectorangles_List", ",", "foldangles_List", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"oa", ",", "nal", ",", "creasevectors"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "sectorangles", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "foldangles", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTVertexFromAngles", "::", "badangles"}], ",", 
          "sectorangles", ",", "foldangles"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"oa", "=", 
      RowBox[{
       RowBox[{"OffsetAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTVertexFromAngles", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nal", "=", 
      RowBox[{"2", "\[Pi]", " ", 
       RowBox[{"sectorangles", " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{"Plus", "@@", "sectorangles"}], ")"}]}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "sector", " ", "angles", " ", "normalized", " ", "to", " ", "sum", " ", 
       "to", " ", "2", "\[Pi]"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"creasevectors", "=", 
      RowBox[{"U", "/@", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"FoldList", "[", 
          RowBox[{"Plus", ",", "oa", ",", "nal"}], "]"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "unit", " ", "vectors", " ", "along", " ", "crease", " ", "lines", " ", 
       "in", " ", "2", "D"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"MakeTObj", "[", 
      RowBox[{"TVertex", ",", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SectorAngles", "\[Rule]", "sectorangles"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DihedralAngles", "\[Rule]", "foldangles"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DihedralTypes", "\[Rule]", 
          RowBox[{"FoldAngleToType", "[", "foldangles", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreaseVectors", "\[Rule]", "creasevectors"}]}], "}"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.594942741643887*^9, 3.594942890489223*^9}, {
   3.595001227105516*^9, 3.595001280886215*^9}, {3.595001322970686*^9, 
