Cell[TextData[{
 "Arguments:\n\t\[Kappa] \[LongDash] the curvature, as a pure function or \
InterpolatingFunction\n\t\[Tau] \[LongDash] the torsion, as a pure function \
or InterpolatingFunction\n\t",
 StyleBox["v",
  FontSlant->"Italic"],
 " \[LongDash] the curve speed, as a pure function or InterpolatingFunction"
}], "Text",
 CellChangeTimes->{{3.69124099372663*^9, 3.691240998239414*^9}, {
