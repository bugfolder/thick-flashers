Cell["\<\
Implementation note: we don\[CloseCurlyQuote]t set the pattern verts_List, \
etc., because that interferes with the behavior of the HoldAll attribute.\
\>", "Text",
 CellChangeTimes->{{3.62740807942029*^9, 
  3.627408112265778*^9}},ExpressionUUID->"e88367e5-b869-4802-8b74-\
56a6b6a40443"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CircularlyCompletePoly", "[", 
   RowBox[{
   "verts_", ",", "edges_", " ", ",", "faces_", ",", "pface_", ",", "ctr_", ",",
     "r_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cd", ",", "astart", ",", "aend", ",", "alen", ",", "k", ",", "jstart", ",",
       "jend", ",", "jrange"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cd", "=", 
      RowBox[{
       RowBox[{"CircleDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CircularlyCompletePoly", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"astart", "=", 
      RowBox[{"N", "[", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"verts", "\[LeftDoubleBracket]", 
           RowBox[{"pface", "\[LeftDoubleBracket]", 
            RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], "-", "ctr"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aend", "=", 
      RowBox[{"N", "[", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"verts", "\[LeftDoubleBracket]", 
           RowBox[{
           "pface", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], "-", "ctr"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alen", "=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"aend", "-", "astart"}], ",", 
        RowBox[{"2", "\[Pi]"}], ",", 
        RowBox[{"-", "\[Pi]"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "arc", " ", "length"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"aend", "=", 
      RowBox[{"astart", "+", "alen"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"revise", " ", "ending", " ", "arc", " ", "angle"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"k", "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Round", "[", 
         RowBox[{"cd", " ", "*", " ", 
          RowBox[{
           RowBox[{"Abs", "[", "alen", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "\[Pi]"}], ")"}]}]}], "]"}], ",", "2"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "number", " ", "of", " ", "divisions", " ", "to", " ", "use", " ", 
       "for", " ", "arc"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"jstart", "=", 
      RowBox[{
       RowBox[{"Length", "[", "verts", "]"}], "+", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"verts", ",", 
         RowBox[{"ctr", " ", "+", " ", 
          RowBox[{"r", " ", 
           RowBox[{"U", "[", 
            RowBox[{"astart", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"j", "/", "k"}], ")"}], 
              RowBox[{"(", "alen", ")"}]}]}], "]"}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"add", "'"}], "l", " ", "face", " ", "vertices"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"jend", "=", 
      RowBox[{"Length", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"jrange", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"jstart", ",", "jend"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"JoinTo", "[", 
      RowBox[{"edges", ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pface", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", "jstart"}], 
           "}"}], "}"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"jrange", ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", 
            RowBox[{"Drop", "[", 
             RowBox[{"jrange", ",", "1"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"jend", ",", 
            RowBox[{
            "pface", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
            "}"}], "}"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"faces", ",", 
       RowBox[{"Join", "[", 
        RowBox[{"pface", ",", "jrange"}], "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.457901179965849*^9, 3.457901238224203*^9}, {
   3.457901270769289*^9, 3.457901437301969*^9}, {3.45790149118131*^9, 
   3.45790149278841*^9}, {3.457901525382599*^9, 3.457901617916111*^9}, {
   3.457901655924981*^9, 3.457901731695231*^9}, {3.457901781427524*^9, 
   3.4579018345089283`*^9}, {3.457908381251971*^9, 3.457908403632933*^9}, {
   3.457908497437161*^9, 3.457908517645735*^9}, {3.457908635945128*^9, 
   3.45790868889291*^9}, {3.457908744743758*^9, 3.457908744948471*^9}, {
   3.457908992341377*^9, 3.457909007444318*^9}, {3.457909089244176*^9, 
   3.4579090917950277`*^9}, 3.457909149785912*^9, {3.457916925677114*^9, 
   3.457916941674358*^9}, 3.457917073505825*^9, 3.457917178435706*^9, {
   3.457917230949122*^9, 3.457917240486237*^9}, {3.457917301182721*^9, 
