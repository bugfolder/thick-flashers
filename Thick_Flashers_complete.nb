Cell[TextData[{
 "AddDistinctEmbeddedEdge[",
 StyleBox["edge",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a pure function that adds the embedded edge to the given TGraph, \
adding vertices if necessary and returns just the modified TGraph."
}], "Text",
