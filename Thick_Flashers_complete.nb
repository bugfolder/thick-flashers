Cell[TextData[{
 "RectVertices[{",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h}",
  FontSlant->"Italic"],
 "] returns the vertices of a rectangle of width ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", height ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", with lower left corner at the origin."
}], "Text",
 CellChangeTimes->{{3.627658843338604*^9, 3.627658872976105*^9}, 
   3.627659539359568*^9, {3.6276634403678308`*^9, 
   3.6276634424634*^9}},ExpressionUUID->"f9b59dcd-8b6c-4890-a0be-\
a8a5fc7e6d06"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RectVertices", "[", 
   RowBox[{"{", 
    RowBox[{"w_", ",", "h_"}], "}"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"w", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"w", ",", "h"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "h"}], "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.627659551952091*^9, 3.627659574710175*^9}, {
  3.627663444304624*^9, 3.627663446106016*^9}},
 CellLabel->
  "In[469]:=",ExpressionUUID->"c5beb3be-5bd7-4a88-89d3-b91baa65e431"],

Cell[TextData[{
 "RectVertices[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "] takes two points ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 " and returns the vertices of the rectangle that encloses them. For example, \
",
 StyleBox["p",
  FontSlant->"Italic"],
 " could be the bottom left corner, ",
 StyleBox["q",
  FontSlant->"Italic"],
 " the top right."
}], "Text",
 CellChangeTimes->{{3.627663454487598*^9, 
  3.627663546353838*^9}},ExpressionUUID->"8229d0cc-1f36-4f5f-960f-\
5f4c3803f193"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RectVertices", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"px_", ",", "py_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"qx_", ",", "qy_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xmin", ",", "xmax", ",", "ymin", ",", "ymax"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xmin", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"px", ",", "qx"}], "]"}]}], ";", 
     RowBox[{"xmax", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"px", ",", "qx"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ymin", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"py", ",", "qy"}], "]"}]}], ";", 
     RowBox[{"ymax", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"py", ",", "qy"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xmin", ",", "ymin"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"xmax", ",", "ymin"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"xmax", ",", "ymax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"xmin", ",", "ymax"}], "}"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.62766355249142*^9, 3.6276636601578493`*^9}},
 CellLabel->
  "In[470]:=",ExpressionUUID->"ef2badfd-a477-4aa8-bea9-fb026862478e"],

