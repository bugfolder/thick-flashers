Cell[TextData[{
 "ReplaceRule[",
 StyleBox["list",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lhs",
  FontSlant->"Italic"],
 "\[Rule]",
 StyleBox["rhs",
  FontSlant->"Italic"],
 "] replaces any occurrence of a rule lhs\[Rule]_ with the specified rule lhs\
\[Rule]rhs."
}], "Text",
 CellChangeTimes->{{3.675849019874346*^9, 
  3.675849055197153*^9}},ExpressionUUID->"ea2de209-5750-42c8-9bf3-\
fbf1bc558445"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceRule", "[", 
   RowBox[{"list_List", ",", 
    RowBox[{"lhs_", "\[Rule]", "rhs_"}]}], "]"}], ":=", 
  RowBox[{"list", "/.", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"lhs", "\[Rule]", "_"}], ")"}], "\[Rule]", 
    RowBox[{"(", 
     RowBox[{"lhs", "\[Rule]", "rhs"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.6758490721194353`*^9, 3.675849125780517*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"dde8247b-94ed-40c4-b966-0698369e4a58"],

