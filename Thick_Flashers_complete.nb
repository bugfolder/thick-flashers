Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the fold line\n\t{",
 StyleBox["rl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rr",
  FontSlant->"Italic"],
 "} \[LongDash] two pure functions giving the scaled ruling line vectors of \
the left and right ruled surfaces.\n\t{u0, u1} \[LongDash] the domain of the \
parameter along the curved fold."
}], "Text",
 CellChangeTimes->{{3.691410176588348*^9, 3.691410235807106*^9}, {
   3.691496540224122*^9, 3.691496572012128*^9}, {3.691503214939596*^9, 
