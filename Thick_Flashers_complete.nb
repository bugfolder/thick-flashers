Cell[CellGroupData[{

Cell[TextData[{
 "HatVertexConsistencyConditions3D[",
 StyleBox["foldhats",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sectorhats, opts",
  FontSlant->"Italic"],
 "]\n\t(options) HatMatrixSplit"
}], "Subsubsection",
 CellChangeTimes->{{3.595528802751949*^9, 3.595528830386354*^9}, {
   3.595528864136568*^9, 3.595528874543359*^9}, 3.5955295293995647`*^9, 
   3.595613099505708*^9, {3.595705476069476*^9, 3.595705483993409*^9}, {
   3.596023122127158*^9, 3.59602315092052*^9}, {3.736638294014103*^9, 
   3.7366382952880173`*^9}},ExpressionUUID->"983658d9-321a-40e4-a838-\
64fec9c68434"],

Cell[TextData[{
 "HatVertexConsistencyConditions3D[",
 StyleBox["foldhats",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sectorhats, opts",
  FontSlant->"Italic"],
 "] takes a list of hat-transformed fold angles and a list of hat-transformed \
sector angles around a vertex and returns the 3-vector whose components must \
be equal to zero in order for self-consistency to be satisfied. For an order-",
 StyleBox["N",
  FontSlant->"Italic"],
 " vertex, the condition is a polynomial of degree 2 in each ",
 StyleBox["foldhats",
  FontSlant->"Italic"],
 " variable, of degree 2 in each ",
 StyleBox["sectorhats",
  FontSlant->"Italic"],
 " variable and of degree 2",
 StyleBox["N",
  FontSlant->"Italic"],
 " overall. Options are:\n\tHatMatrixSplit \[Rule] Automatic | None | ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where n is the number of matrices on the left and the remainder are on \
the right. None puts all of the numerators on the left. Automatic splits them \
as evenly as possible between left and right. In either case, denominators \
are cleared from either side so that each entry is a polynomial."
}], "Text",
 CellChangeTimes->{{3.595528891031413*^9, 3.595528996408587*^9}, 
   3.595529530568789*^9, {3.595613099610295*^9, 3.5956131322422*^9}, {
   3.595705476193434*^9, 3.5957055253911123`*^9}, 3.596023596278183*^9, {
   3.736638287446642*^9, 
   3.736638319380148*^9}},ExpressionUUID->"c32ec0c0-9071-4743-8682-\
bfa37ad91add"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "HatVertexConsistencyConditions3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"HatMatrixSplit", "\[Rule]", "Automatic"}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.595670719640242*^9, 3.595670753649089*^9}, 
   3.59568619478012*^9, 3.595700174411302*^9, {3.595703788241143*^9, 
   3.5957037953602247`*^9}, {3.5957056558806477`*^9, 3.595705658118566*^9}},
 CellLabel->
  "In[794]:=",ExpressionUUID->"38ad5151-c0e7-4019-a3cc-52498290aee3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatVertexConsistencyConditions3D", "::", "badsplit"}], 
   "=", "\"\<The split distance `1` must be between 0 and `2` or None or \
Automatic.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595686457129794*^9, 3.595686462764573*^9}, {
   3.595686555952579*^9, 3.595686561222593*^9}, {3.595690548868716*^9, 
   3.59569057139565*^9}, 3.595700174659847*^9, {3.595705661142733*^9, 
   3.595705672460429*^9}},
 CellLabel->
  "In[795]:=",ExpressionUUID->"ab38cfd9-d1a0-436f-9a37-71ca14825b6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatVertexConsistencyConditions3D", "[", 
   RowBox[{"foldhats_List", ",", " ", "sectorhats_List", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hms", ",", "gpairs", ",", "spairs", ",", "apairs", ",", "nl", ",", "nr",
       ",", "lpairs", ",", "rpairs", ",", "lnums", ",", "ldens", ",", "rnums",
       ",", "rdens", ",", "lhs", ",", "rhs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hms", "=", 
      RowBox[{
       RowBox[{"HatMatrixSplit", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HatVertexConsistencyConditions3D", "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"gpairs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"HatRotationMatrix3DNumerator", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", 
          RowBox[{"HatRotationDenominator", "[", "#", "]"}]}], "}"}], "&"}], "/@",
        "foldhats"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"spairs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"HatRotationMatrix3DNumerator", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
          RowBox[{"HatRotationDenominator", "[", "#", "]"}]}], "}"}], "&"}], "/@",
        "sectorhats"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"apairs", "=", 
      RowBox[{"Riffle", "[", 
       RowBox[{"gpairs", ",", "spairs"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nl", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"hms", ",", "\[IndentingNewLine]", "Automatic", ",", 
        RowBox[{"Ceiling", "[", 
         RowBox[{
          RowBox[{"Length", "[", "apairs", "]"}], "/", "2"}], "]"}], ",", 
        "\[IndentingNewLine]", "None", ",", 
        RowBox[{"Length", "[", "apairs", "]"}], ",", "\[IndentingNewLine]", 
        "_", ",", "hms"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nr", "=", 
      RowBox[{
       RowBox[{"Length", "[", "apairs", "]"}], "-", "nl"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"nl", "<", "0"}], "||", 
        RowBox[{"nr", "<", "0"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"HatRotationConditions2D", "::", "badsplit"}], ",", "hms", ",", 
          RowBox[{"Length", "[", "apairs", "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lpairs", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nl", ">", "0"}], ",", 
        RowBox[{"Take", "[", 
         RowBox[{"apairs", ",", "nl"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", "1"}], "}"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rpairs", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nr", ">", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}], ",", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
           "}"}], "&"}], "/@", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Take", "[", 
           RowBox[{"apairs", ",", 
            RowBox[{"-", "nr"}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", "1"}], "}"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lnums", ",", "ldens"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "lpairs", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rnums", ",", "rdens"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "rpairs", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lhs", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Times", "@@", "rdens"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"Dot", "@@", "lnums"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhs", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Times", "@@", "ldens"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"Dot", "@@", "rnums"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lhs", "-", "rhs"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5955294988728943`*^9, 3.595529750315512*^9}, {
   3.595531147244128*^9, 3.595531150892449*^9}, 3.5956130996541967`*^9, {
   3.59561317983049*^9, 3.595613199729619*^9}, {3.59561338111472*^9, 
