be46efd27738"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FaceupFace", "::", "usage"}], 
   "=", "\"\<FaceupFace is an option to LocalFaceOrdering that specifies a \
face that is considered to be face-up. Pass the negative of the index to \
specify that the face is face-down.\>\""}], ";"}]], "Input",
