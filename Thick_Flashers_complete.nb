Cell["Example with a pure function.", "Text",
 CellChangeTimes->{{3.799330928020735*^9, 
  3.799330934244959*^9}},ExpressionUUID->"541fa506-7064-4dfa-9f81-\
1d223476a657"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "ff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Unplanarize", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "ff", "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799330215241061*^9, 3.799330266624402*^9}, 
   3.799330611414932*^9, {3.799330827134829*^9, 3.799330830573479*^9}, 
   3.7993311870841312`*^9, {3.799338085568261*^9, 3.799338102329026*^9}},
 CellLabel->
