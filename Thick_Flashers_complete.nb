Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTMiuraMarsOri", "[", 
   RowBox[{"vtobj_TObj", ",", 
    RowBox[{"{", 
     RowBox[{"dlist1_List", ",", "dlist2_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sa", ",", "da", ",", "dt", ",", "cv", ",", "nh", ",", "nv", ",", "vfn", 
      ",", "gtobj", ",", "types", ",", "foldangles", ",", "ei"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"vtobj", ",", "TVertex", ",", "MakeTMiuraMarsOri"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sa", ",", "da", ",", "dt", ",", "cv"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"vtobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "SectorAngles", ",", "DihedralAngles", ",", "DihedralTypes", ",", 
          "CreaseVectors"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "da", "]"}], "\[NotEqual]", "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTMiuraMarsOri", "::", "badsize"}], ",", "vtobj", ",", 
          RowBox[{"Length", "[", "da", "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sign", "[", 
         RowBox[{"da", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "]"}], "\[Equal]", 
        RowBox[{"Sign", "[", 
         RowBox[{"da", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
          "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTMiuraMarsOri", "::", "badminor"}], ",", "vtobj", ",", 
          "da"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sa", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "+", 
         RowBox[{
         "sa", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], "\[NotEqual]",
         "\[Pi]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTMiuraMarsOri", "::", "notflatf"}], ",", "vtobj"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "sa", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]", 
            RowBox[{
            "sa", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
           ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "sa", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]", 
            RowBox[{
            "sa", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[Equal]", 
            RowBox[{"\[Pi]", "/", "2"}]}], ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "sa", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]", 
            RowBox[{
            "sa", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "\[Equal]", 
            RowBox[{"\[Pi]", "/", "2"}]}], ")"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTMiuraMarsOri", "::", "notsym"}], ",", "vtobj"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nh", "=", 
      RowBox[{"Length", "[", "dlist1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"Length", "[", "dlist2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"0", ",", "0"}], "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "0"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vfn", "[", 
        RowBox[{"i", ",", "0"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vfn", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", "0"}], "]"}], "+", 
        RowBox[{
         RowBox[{
         "dlist1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "i", "]"}], ",", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{"-", 
            RowBox[{
            "cv", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}]}], 
          "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vfn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vfn", "[", 
         RowBox[{"i", ",", 
          RowBox[{"j", "-", "1"}]}], "]"}], "+", 
        RowBox[{
         RowBox[{
         "dlist2", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "j", "]"}], ",", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{"-", 
            RowBox[{
            "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}]}], 
          "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gtobj", "=", 
      RowBox[{"MakeRectangularQuadMesh", "[", 
       RowBox[{"nh", ",", "nv", ",", "vfn", ",", 
        RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Go", " ", "back", " ", "and", " ", "assign", " ", "edge", " ", "types",
        " ", "and", " ", "fold", " ", "angles"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"gtobj", "[", "EdgeTypes", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"mostly", " ", "U"}], ",", " ", 
       RowBox[{"but", " ", "borders", " ", "are", " ", "B"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "types", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"\"\<horizontal\>\"", " ", "folds"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ei", "=", 
           RowBox[{"i", "+", 
            RowBox[{"j", " ", "nh"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "===", "B"}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", "i", "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"EvenQ", "[", "j", "]"}], ",", "1", ",", 
                    RowBox[{"-", "1"}]}], "]"}], 
                  RowBox[{
                  "da", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}]}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"EvenQ", "[", "j", "]"}], ",", "1", ",", 
                    RowBox[{"-", "1"}]}], "]"}], 
                  RowBox[{
                  "da", "\[LeftDoubleBracket]", "3", 
                   "\[RightDoubleBracket]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}],
          "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nh"}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nv"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"\"\<vertical\>\"", " ", "folds"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ei", "=", 
           RowBox[{
            RowBox[{"nh", 
             RowBox[{"(", 
              RowBox[{"nv", "+", "1"}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "-", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"nh", "+", "1"}], ")"}]}], "+", "i", "+", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "===", "B"}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", "j", "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"EvenQ", "[", "i", "]"}], ",", "1", ",", 
                    RowBox[{"-", "1"}]}], "]"}], 
                  RowBox[{
                  "da", "\[LeftDoubleBracket]", "2", 
                   "\[RightDoubleBracket]"}]}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"EvenQ", "[", "i", "]"}], ",", "1", ",", 
                    RowBox[{"-", "1"}]}], "]"}], 
                  RowBox[{
                  "da", "\[LeftDoubleBracket]", "4", 
                   "\[RightDoubleBracket]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}],
          "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "nv"}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gtobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"gtobj", "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"EdgeTypes", "\[Rule]", "types"}], "]"}]}], "//", 
         "AddTPlaneGraph"}], "//", 
        RowBox[{"AddTGeneratingVertex", "[", "vtobj", "]"}]}], "//", 
       RowBox[{"AddClass", "[", "TMiuraMarsOri", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Now", " ", "fold", " ", "the", " ", "graph", " ", "into", " ", "3", 
       "D"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"And", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "foldangles"}], 
         ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"gtobj", "//", "AddTGraph3D"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FoldGraph3D", "[", 
        RowBox[{"gtobj", ",", "foldangles"}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594992266592838*^9, 3.59499230161492*^9}, {
