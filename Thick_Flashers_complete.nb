Cell[CellGroupData[{

Cell[TextData[{
 "ReassignGraphAssigned",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph, TAssigned\n\t(options) TypeMinimumAngle, \
TypeMaximumAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.594309855921566*^9, 3.594309912947491*^9}, {
   3.594309944417188*^9, 3.594309950953203*^9}, {3.594310015373197*^9, 
   3.594310016876488*^9}, {3.594310090216409*^9, 3.594310092839552*^9}, {
   3.594311577649417*^9, 3.594311578547271*^9}, {3.59456818000513*^9, 
   3.594568182667623*^9}, {3.594568420924315*^9, 3.594568427700399*^9}, 
   3.5945986338411813`*^9, {3.59464961914516*^9, 3.5946496351643133`*^9}, {
   3.595286940765623*^9, 3.59528694190239*^9}, 3.650064346202422*^9, 
   3.650064493654098*^9, 
   3.673096600221203*^9},ExpressionUUID->"e1daddc5-0942-43d1-9132-\
b4175e3f9468"],

Cell[TextData[{
 "ReassignGraphAssigned[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph+TAssigned ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " and a list of fold angle ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " and computes a new assignment of the non-B edges based on the values of \
the fold angles. Options are:\n\tTypeMinimumAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "min"], TraditionalForm]],ExpressionUUID->
  "c33e3531-3a4e-4cef-af30-b4291ebb3206"],
 ", where any angle whose absolute value is less than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "min"], TraditionalForm]],ExpressionUUID->
  "72f079a7-7dd0-416f-9044-635104e4ce6d"],
 " is given the type U.\n\tTypeMaximumAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "max"], TraditionalForm]],ExpressionUUID->
  "92f545cb-038a-4388-9275-b5600c7e984f"],
 ", where any angle whose absolute value is greater than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "max"], TraditionalForm]],ExpressionUUID->
  "611f02e3-78f1-4252-892a-38d4735be63b"],
 " is not reassigned from ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", but instead is left with its original assignment. This is useful when ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " have been calculated numerically, where for fully folded angles, numerical \
roundoff errors might give erroneous fold angles near the values \[PlusMinus]\
\[Pi]."
}], "Text",
 CellChangeTimes->{
  3.5943098762898903`*^9, {3.594309919243072*^9, 3.594309960392065*^9}, {
   3.5943100201169586`*^9, 3.594310106303575*^9}, {3.5945681889468937`*^9, 
   3.594568305436053*^9}, {3.594568338441334*^9, 3.594568418516281*^9}, {
   3.594649619295858*^9, 3.594649635339843*^9}, {3.594649676705567*^9, 
   3.594649678973497*^9}, 3.594661651939755*^9, 3.650064346257134*^9, 
   3.650064493704666*^9, 
   3.673096600304283*^9},ExpressionUUID->"1a904371-ebac-448b-bc57-\
a104bdfb6389"],

