Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "bb", ",", "dd", ",", "ccds", ",", "ss"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], 
           RowBox[{"Sin", "[", "#", "]"}]}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
           RowBox[{"Cos", "[", "#", "]"}]}]}], "}"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ccds", "=", 
      RowBox[{"CanonicalConeDevelopableSystem", "[", 
       RowBox[{"bb", ",", "dd", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ccds", "/.", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", "\[Rule]", "\"\<\[Theta]\>\""}], "}"}]}], 
         ")"}], "//", "PrettyParameters"}], "//", "ColumnForm"}], "//", 
      "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"DevelopableSurface", "/.", "ccds"}], "/.", 
       RowBox[{"\[Theta]", "\[Rule]", 
        RowBox[{"30", "\[Degree]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"StyledCrossRuledPatch", "[", 
            RowBox[{"ss", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "\[Pi]"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"CrossLineStyle", "\[Rule]", "Purple"}]}], "]"}], "//", 
           "ReverseFillStyle"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], ",", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6898497649612083`*^9, 3.68984986764654*^9}, {
   3.689866270997853*^9, 3.689866278465755*^9}, {3.689866313820064*^9, 
