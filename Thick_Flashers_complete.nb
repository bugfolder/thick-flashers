       RowBox[{"{", 
        RowBox[{
        "B", ",", "B", ",", "B", ",", "V", ",", "B", ",", "B", ",", "B"}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d1", "=", 
      RowBox[{"verts3d2", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"RotationYMatrix3D", "[", 
           RowBox[{"45", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
