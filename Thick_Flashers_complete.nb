 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeFoldVectorsFromSubarcs", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"OsculatingVectorNear", "\[Rule]", "None"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
