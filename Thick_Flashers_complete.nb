Cell["\<\
A tiling of two tiles and then render it as tiling, crease pattern, and \
folded form.\
\>", "Text",
 CellChangeTimes->{{3.629828567835726*^9, 3.629828588433327*^9}, {
   3.707838728265875*^9, 3.707838732211155*^9}, 
   3.707840728445429*^9},ExpressionUUID->"282ca43e-205c-4682-a183-\
4881a198d669"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "w", ",", "\[Alpha]", ",", "types", ",", "tiling"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"UnitRegularPolygonVertices", "[", "4", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
          "PolygonCenteredTwistAltTile", ",", "verts", ",", "w", ",", 
           "\[Alpha]", ",", "types"}], "}"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "PolygonCenteredTwistAltTile", ",", "verts", ",", "w", ",", 
            "\[Alpha]", ",", "types"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "Tiling", ",", 
             RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowDF"}]}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629828101472671*^9, 3.629828167961506*^9}, 
   3.629828494028514*^9, {3.629828599943145*^9, 3.629828738380302*^9}, {
