Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BorderlessCreasePatternToPlaneGraphAssigned", "::", "badmerge"}], 
   "=", "\"\<The number of merged edges doesn't match the number of merge \
vertices, possibly because a merge vertex is incident to both mountain and \
valley folds.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.533678880766869*^9, 3.533679015012471*^9}, 
   3.533681522447179*^9, 3.592468182299544*^9, 3.592828731271478*^9, 
