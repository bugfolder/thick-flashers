Cell[CellGroupData[{

Cell[TextData[{
 "AllCyclicTwistTypes[",
 StyleBox["n",
  FontSlant->"Italic"],
 "]\n",
 "AllValidTwistTypes",
 "[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Alpha]]"
}], "Subsubsection",
 CellChangeTimes->{3.457921638875961*^9, 3.457921756965293*^9, 
  3.457921807271212*^9},ExpressionUUID->"4cbf55b7-8899-4db0-ae58-\
e64b9be13e53"],

Cell[TextData[{
 "AllCyclicTwistTypes[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns a list of all distinct MV-assignments of length ",
 StyleBox["n",
  FontSlant->"Italic"],
 ". For ",
 StyleBox["n",
  FontSlant->"Italic"],
 "=8 and above, the computational time is large (this is a brute-force \
analysis) so we'll remember the result for each ",
 StyleBox["n",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{
  3.457921756985499*^9},ExpressionUUID->"fa5c184c-b1dc-470b-9c64-\
ac8c768ec254"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AllCyclicTwistTypes", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"AllCyclicTwistTypes", "[", "n", "]"}], "=", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{"Nest", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"x", ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Prepend", "[", 
                RowBox[{"#", ",", "M"}], "]"}], ",", 
               RowBox[{"Prepend", "[", 
                RowBox[{"#", ",", "V"}], "]"}]}], "}"}], "&"}], "/@", "x"}], ",",
            "1"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "M", "}"}], ",", 
         RowBox[{"{", "V", "}"}]}], "}"}], ",", 
       RowBox[{"n", "-", "1"}]}], "]"}], ",", 
     RowBox[{"SameTest", "\[Rule]", "CyclicSameQ"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.457921757006715*^9, 3.457921757251881*^9}},
 CellLabel->
  "In[2715]:=",ExpressionUUID->"7ac08fbb-7112-4745-9565-27fa64195fd2"],

Cell["Example", "Text",ExpressionUUID->"35c36746-0bcb-44f1-82ec-43ca993d5221"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AllCyclicTwistTypes", "[", "5", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{3.457921757489272*^9},
 CellLabel->
  "In[2716]:=",ExpressionUUID->"5733603f-3f86-471e-9d46-feec1eb43793"],

Cell[TextData[{
 "AllValidTwistTypes[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Alpha]] returns a list of all distinct MV-assignments that are valid \
for a unit polygon twist of order ",
 StyleBox["n",
  FontSlant->"Italic"],
 " with twist angle \[Alpha]. Note that for sufficiently small (or large) \
twist angle \[Alpha], all twist types are valid."
}], "Text",
 CellChangeTimes->{
  3.457921769621824*^9, 3.4579218072956133`*^9, {3.4579218531800756`*^9, 
   3.457921887622923*^9}},ExpressionUUID->"b766670f-4849-4dd4-abb3-\
62c018df02e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AllValidTwistTypes", "[", 
   RowBox[{"n_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"AllCyclicTwistTypes", "[", "n", "]"}], ",", 
    RowBox[{
     RowBox[{"RegularPolygonTwistValidQ", "[", 
      RowBox[{"n", ",", "\[Alpha]", ",", "#"}], "]"}], "&"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{3.457921757741266*^9, 3.457921807326214*^9, 
  3.5921653443356743`*^9, 3.62863704975738*^9, 3.628637203076386*^9},
 CellLabel->
  "In[2717]:=",ExpressionUUID->"12eb78c6-4e46-4d65-a471-2263486b1bd1"],

Cell["Example", "Text",ExpressionUUID->"a928b1be-a571-4024-9192-67e64d451cc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AllValidTwistTypes", "[", 
   RowBox[{"5", ",", 
    RowBox[{"60", "\[Degree]"}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{3.457921807561198*^9},
 CellLabel->
  "In[2718]:=",ExpressionUUID->"566ea65a-8ac9-4179-a777-0eb14e050a96"]
}, Closed]]
}, Closed]],

