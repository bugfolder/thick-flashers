Cell[TextData[{
 "RotationAngle[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 "] returns the CCW rotation angle from direction ",
 StyleBox["r1",
  FontSlant->"Italic"],
 " to direction ",
 StyleBox["r2",
  FontSlant->"Italic"],
 " with the angle in the range (-\[Pi], \[Pi]]."
}], "Text",
