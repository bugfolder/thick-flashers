Cell["\<\
I\[CloseCurlyQuote]m phasing this out. Instead of providing display pairs and \
graph pairs, the preferred method is to generate either TGraph2D+TAssigned or \
TGraph3D+TAssigned. It\[CloseCurlyQuote]s retained to provide support for \
class TRotationalPot until I finish converting its functionality.\
\>", "Text",
 CellChangeTimes->{{3.595200888715513*^9, 3.595200893665819*^9}, {
  3.5975261791641903`*^9, 3.59752620943398*^9}, {3.615288229378662*^9, 
  3.615288229888483*^9}, {3.615288270405467*^9, 3.61528827300838*^9}, {
  3.615302290515175*^9, 
  3.615302340135804*^9}},ExpressionUUID->"f6308494-c82a-4e35-b442-\
7f48c81dd6ee"]
}, Closed]],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.592439742230821*^9, 
  3.5924397432148743`*^9}},ExpressionUUID->"72bdde6d-2513-42f6-aac8-\
deaedd04a6eb"],

Cell["\<\
It\[CloseCurlyQuote]s common to generate a crease pattern and folded form \
together as a display pair, as in this example:\
\>", "Text",
 CellChangeTimes->{{3.592667597973455*^9, 3.592667638706434*^9}, {
  3.5947411436606083`*^9, 
  3.594741158434469*^9}},ExpressionUUID->"940292ef-3f49-490e-a03a-\
5f4186c833a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "types", ",", "tobj", ",", "cp", ",", "ff"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", 
          RowBox[{"5", "/", "4"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "3"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "V", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"MakeTGraph", "[", 
          RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], "//", 
        RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
       "FoldGraph2DAll"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"VisibleFoldedFormGraphics", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
          RowBox[{"Graph2DGraphics", "[", "tobj", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cp", ",", "ff"}], "}"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592667159413827*^9, 3.592667371670163*^9}, {
   3.5926674194573793`*^9, 3.592667547815458*^9}, {3.592667694480383*^9, 
   3.5926677093271017`*^9}, 3.59279126906847*^9, 3.59282873283011*^9, 
   3.592828866358914*^9, {3.59282890202507*^9, 3.592828902110611*^9}, {
   3.592867526864974*^9, 3.592867527954414*^9}, 3.592871225757769*^9, 
   3.59287126669667*^9, {3.593021057919512*^9, 3.593021072494143*^9}, {
   3.594734257616365*^9, 3.594734257653363*^9}, 3.594734827902754*^9, 
   3.594735271754012*^9, {3.594741068958499*^9, 3.594741134324337*^9}, 
   3.595200246832874*^9, 3.5952005274664392`*^9, 3.5952007101802187`*^9, 
   3.595358083140778*^9, 3.706789345367167*^9},
 CellLabel->
  "In[3521]:=",ExpressionUUID->"352151fa-a808-474d-9a2e-0bd2e7895bb1"],

Cell["\<\
The folded form can be either 2D (Graphics) or 3D (Graphics3D). We introduce \
a mixin class that captures the graphical rendering of both, so that the \
graphical renderings can be stored in an object, sometimes along with the \
generating graph.\
\>", "Text",
 CellChangeTimes->{{3.592667662715931*^9, 3.592667680088594*^9}, {
  3.5947411811306343`*^9, 
  3.594741259651756*^9}},ExpressionUUID->"c5f1e711-f4e7-4e65-971c-\
19f1c1130faf"]
}, Closed]],

