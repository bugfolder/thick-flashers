Cell[CellGroupData[{

Cell[TextData[{
 "MakeRectangularPotWedge[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Rho], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TypeMinimumAngle, PotGapHalfAngle, PotFlatFlangeInset, \
PotFlangeExcess\n\t(properties) PotWedgeJoinVertices"
}], "Subsubsection",
 CellChangeTimes->{{3.651436194229604*^9, 3.6514362000690827`*^9}, {
  3.651436250369392*^9, 
  3.6514362570974016`*^9}},ExpressionUUID->"1a80a646-f2b1-4a22-81f5-\
1cbfad0493b3"],

Cell[TextData[{
 "MakeRectangularPotWedge[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Rho], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " defining a cross-section of a rotational pot with ",
 StyleBox["m",
  FontSlant->"Italic"],
 "-fold rotational symmetry and asymmetry factor \[Rho] and returns a \
TGraph3D+TAssigned describing a single wedge of the pot, both crease pattern \
and folded form. The first point of ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " should have a z-height of 0, but if it isn\[CloseCurlyQuote]t, we\
\[CloseCurlyQuote]ll translate the cross section to the x-axis. The asymmetry \
factor ",
 StyleBox["\[Rho] ",
  FontSlant->"Italic"],
 "\[Element] [\[Dash]1, 1] has this effect: for ",
 StyleBox["\[Rho] ",
  FontSlant->"Italic"],
 "\[Rule] +1, the flanges are flat and point CCW (viewed from the top); for \
\[Dash]1, they point CW; and for ",
 StyleBox["\[Rho] ",
  FontSlant->"Italic"],
 "\[Rule] 0, the flanges are solid and symmetric (Mosely condition). \
Intermediate values give asymmetric solid flanges. Options are:\n\t\
TypeMinimumAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "min"], TraditionalForm]],ExpressionUUID->
  "0c49f5eb-17eb-4491-9a55-70caf2470b07"],
 ", specifies the minimum fold angle that is assigned M or V. This is useful \
when we have very shallow angles going up the gores. This options is passed \
through to FoldAngleToType.\n\tPotGapHalfAngle \[Rule] \[Delta], specifies \
the half-angle of the gap between the seams along the inner edges of the pot. \
Note that if the gap angle is nonzero, there may not be a solution for \
asymmetric \[Rho]. In particular, for flat-bottomed cases, there is no \
solution except for \[Rho] \[Rule] 0.\n\tPotFlatFlangeInset \[Rule] \
\[Epsilon], specifies a fractional inset toward the z-axis to be applied to \
the vertices on the inside of a flat flange version (\[Rho] = -1 or 1). This \
makes the renderer happy when rendering the 3D version, because it avoids \
coplanar facets.\n\tPotFlangeExcess \[Rule] ",
 StyleBox["fe",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["fe",
  FontSlant->"Italic"],
 " is the proportional increase in flange width relative to the widest part \
of the gore."
}], "Text",
 CellChangeTimes->{{3.594583620914513*^9, 3.594583712451603*^9}, {
   3.5945841191157427`*^9, 3.594584144471924*^9}, 3.594584713429246*^9, {
   3.594584779079007*^9, 3.594584810893369*^9}, {3.594585161806385*^9, 
   3.5945851903196163`*^9}, {3.594585321292512*^9, 3.5945853642580023`*^9}, {
   3.594585446884306*^9, 3.594585461394816*^9}, {3.594593332557025*^9, 
   3.594593343847333*^9}, 3.594598806391003*^9, {3.594652881856471*^9, 
   3.594652976312571*^9}, {3.594665041393795*^9, 3.5946650759317827`*^9}, {
   3.594678531075056*^9, 3.594678619564049*^9}, {3.615302088365167*^9, 
   3.615302091676679*^9}, {3.650034408267655*^9, 3.650034415496528*^9}, {
   3.650034506418766*^9, 3.650034541984724*^9}, {3.650034589197397*^9, 
   3.650034597589144*^9}, {3.650034644937892*^9, 3.650034648322154*^9}, {
   3.650035594335135*^9, 3.650035596613913*^9}, {3.650035676632546*^9, 
   3.650035684055887*^9}, {3.65003574449161*^9, 3.650035744915497*^9}, {
   3.6500476142283077`*^9, 3.650047673670881*^9}, {3.650052431521241*^9, 
   3.650052483598957*^9}, {3.650053858360255*^9, 3.650053889820717*^9}, {
   3.650053928267414*^9, 3.650053967479802*^9}, {3.6500646352691517`*^9, 
   3.65006470686545*^9}, {3.650110770988643*^9, 3.650110912125697*^9}, {
   3.650288751919765*^9, 3.650288951987486*^9}, {3.650303038347497*^9, 
   3.650303111807828*^9}, 3.651436281824049*^9, {3.651436318475265*^9, 
   3.651436329269035*^9}, {3.651436368114962*^9, 3.651436382802599*^9}, {
   3.651436479453218*^9, 3.651436481891746*^9}, {3.651445169654411*^9, 
   3.6514451752329273`*^9}, {3.651514271159067*^9, 
   3.651514297298238*^9}},ExpressionUUID->"8be146a6-1930-4cc3-ae15-\
7cc0ad8b933d"],

Cell["\<\
The points must be strictly monotonic in z-height (either increasing or \
decreasing), with the possible exception that the first two can be equal (to \
give a flat bottom or top).\
\>", "Text",
 CellChangeTimes->{{3.650053521157255*^9, 3.6500535488415756`*^9}, {
  3.651514315193033*^9, 
  3.651514338846384*^9}},ExpressionUUID->"41447cef-e5bb-4ef7-95f9-\
daf16d6a7a6a"],

Cell[TextData[{
 "As in MakeRadialPotWedge, we add an extra property to the TObj: \
PotWedgeJoinVertices\[Rule]{",
 StyleBox["vlist1, vlist2",
  FontSlant->"Italic"],
 "}, which gives the indices of the vertices along the two edges, starting \
from the shared middle vertex. These are useful when assembling multiple \
wedges (or rectangles) into a single structure."
}], "Text",
 CellChangeTimes->{{3.6500357751878843`*^9, 3.650035861931844*^9}, 
   3.650054174884356*^9, {3.6500717483654757`*^9, 3.650071786831525*^9}, {
   3.650112246406307*^9, 3.6501122520862637`*^9}, {3.651442533622626*^9, 
   3.651442539786923*^9}},ExpressionUUID->"29565c46-8a8a-4c90-95ab-\
c588546a1aff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PotFlangeExcess", "::", "usage"}], 
   "=", "\"\<PotFlangeExcess is an option to MakeRectangularPotWedge that \
specifies the extra flange width to add relative to the widest part of the \
gore.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592128512835625*^9, 3.592128544790277*^9}, {
  3.651436461797686*^9, 3.651436486195207*^9}},
 CellLabel->
  "In[3481]:=",ExpressionUUID->"5ee558e1-fd1a-4e09-8691-67117df6b386"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRectangularPotWedge", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PotGapHalfAngle", "\[Rule]", "0"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"PotFlatFlangeInset", "\[Rule]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PotFlangeExcess", "\[Rule]", "0"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.594585510168417*^9, 3.594585535065568*^9}, {
   3.650111007110558*^9, 3.650111018261142*^9}, {3.65028920525263*^9, 
   3.650289221386045*^9}, 3.650303085809967*^9, {3.651436541709813*^9, 
   3.651436566327229*^9}},
 CellLabel->
  "In[3482]:=",ExpressionUUID->"4aea2a9b-f0c1-44b9-8e40-c26da6972aed"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeRectangularPotWedge", "::", "badpts"}], 
   "=", "\"\<Point list `1` is not strictly monontonically increasing or \
decreasing.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.650052354199219*^9, 3.6500523905559273`*^9}, 
   3.651436542870886*^9},
 CellLabel->
  "In[3483]:=",ExpressionUUID->"28d2b041-24b0-4d5a-8259-6ff9c3426abc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeRectangularPotWedge", "::", "badgap"}], 
   "=", "\"\<The nonzero gap of `1` and asymmetry factor `2` gave rise to \
some negative distances in the crease pattern: s = `3`, t = `4`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.5946791377253304`*^9, 3.594679192840883*^9}, {
   3.594679233990183*^9, 3.5946792392382927`*^9}, 3.5946793049100327`*^9, {
   3.650052283769839*^9, 3.650052330559752*^9}, 3.651443345679188*^9},
 CellLabel->
  "In[3484]:=",ExpressionUUID->"75a76363-7014-4362-a069-dd8b25cee4fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRectangularPotWedge", "[", 
   RowBox[{"pts_List", ",", " ", "m_Integer", ",", " ", 
    RowBox[{"\[Rho]_", ":", "0"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Delta]", ",", "\[Epsilon]", ",", "fe", ",", "\[Phi]", ",", "cdt", ",",
       "fb", ",", "x", ",", "z", ",", "r", ",", "w", ",", "h", ",", "s", ",", 
      "t", ",", "v", ",", "u", ",", "n", ",", "a", ",", "b", ",", "c", ",", 
      "d", ",", "e", ",", "f", ",", "pts1", ",", "aa", ",", "bb", ",", "cc", ",",
       "dd", ",", "ee", ",", "ff", ",", "soln", ",", "vv", ",", "vi", ",", 
      "verts", ",", "verts3d", ",", "edges", ",", "types", ",", "addv", ",", 
      "adde", ",", "arcify", ",", "tobj", ",", "foldangles"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Delta]", "=", 
      RowBox[{
       RowBox[{"PotGapHalfAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectangularPotWedge", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]", "=", 
      RowBox[{
       RowBox[{"PotFlatFlangeInset", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectangularPotWedge", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fe", "=", 
      RowBox[{
       RowBox[{"PotFlangeExcess", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectangularPotWedge", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"pts", "\[LeftDoubleBracket]", 
