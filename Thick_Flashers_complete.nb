Cell[BoxData[
 RowBox[{
  RowBox[{"DynamicModule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"aa", ",", "dd", ",", "tt", ",", "tobj", ",", "tobj1"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"aa", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"90", "\[Degree]"}], ",", 
          RowBox[{"90", "\[Degree]"}], ",", 
