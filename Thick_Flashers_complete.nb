Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ds", ",", "\[Kappa]l", ",", "ui", ",", "ci", ",", "ti", ",", "u0", ",", 
      "u1", ",", "csys", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ds", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]l", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", " ", "ci", ",", " ", "ti"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"NRecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "ci", ",", "ti"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Curve2D", "/.", "csys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"c", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799487328819302*^9, 3.7994874384596863`*^9}, {
   3.79948762659752*^9, 3.799487652023319*^9}, {3.799487702240016*^9, 
