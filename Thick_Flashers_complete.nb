        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "ff", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"aa", "=", 
      RowBox[{
       RowBox[{"xi", " ", 
        RowBox[{"U3D", "[", "0", "]"}]}], "+", 
       RowBox[{"zi", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"aa", "+", 
       RowBox[{"wi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"bb", "+", 
       RowBox[{"si", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"\[Phi]", "-", "\[Delta]"}], ")"}]}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"xi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{"2", "\[Phi]"}], "]"}]}], "+", 
       RowBox[{"zi", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ee", "=", 
      RowBox[{"ff", " ", "+", " ", 
       RowBox[{"wi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"2", "\[Phi]"}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"ee", "+", 
       RowBox[{"ti", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], "+", 
          RowBox[{"2", "\[Delta]"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "parameters", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vixi", " ", 
      RowBox[{"Sec", "[", 
       RowBox[{"\[Phi]", "-", "\[Delta]"}], "]"}], 
      RowBox[{"Sin", "[", "\[Delta]", "]"}], 
      RowBox[{"Sec", "[", 
       RowBox[{"\[Phi]", "-", 
        RowBox[{"2", "\[Delta]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ri", " ", 
           RowBox[{"Tan", "[", "\[Phi]", "]"}]}], "-", "wi"}], ")"}], "ui", " ", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"1", "-", "\[Rho]"}], "2"], ")"}]}], "-", "v"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ti", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ri", " ", 
           RowBox[{"Tan", "[", "\[Phi]", "]"}]}], "-", "wi"}], ")"}], "ui", " ", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"1", "+", "\[Rho]"}], "2"], ")"}]}], "-", "v"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"distance", " ", "condition"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mag2", "[", 
          RowBox[{"cc", "-", "dd"}], "]"}], "\[Equal]", 
         RowBox[{"Mag2", "[", 
          RowBox[{"c", "-", "d"}], "]"}]}], ",", "ui"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"LeafCount", "[", "soln", "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.651505961312973*^9, 3.65150600891113*^9}, {
  3.651506048245743*^9, 3.651506172070189*^9}, {3.651506216924984*^9, 
  3.6515064554298363`*^9}, {3.651506497325713*^9, 3.651506515200515*^9}, {
  3.651506579166685*^9, 3.651506617065239*^9}, {3.651511302633647*^9, 
  3.651511305227422*^9}, {3.651511339081779*^9, 3.651511352616905*^9}, {
  3.651511437153325*^9, 3.651511502492641*^9}, {3.651511970584841*^9, 
  3.651511971238737*^9}, {3.651515521092943*^9, 3.651515551106098*^9}, {
  3.707922413157328*^9, 3.707922426582164*^9}},
 CellLabel->
  "In[3496]:=",ExpressionUUID->"49d8abde-6fc9-42b3-b883-931997af2430"]
