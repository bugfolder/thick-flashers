07b36e57bdd9"],

Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronSignedVolume[",
 StyleBox["p, q, r, s",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595714733200908*^9, 3.595714741101797*^9}, {
  3.595980234226913*^9, 
  3.595980234784748*^9}},ExpressionUUID->"b9d4ed9a-a043-4cc9-bb58-\
16b24d47ee16"],

Cell[TextData[{
 "TetrahedronVolume[",
 StyleBox["p, q, r, s",
  FontSlant->"Italic"],
 "] gives the signed volume of a tetrahedron with vertices ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", and s, where the sign is positive if point ",
 StyleBox["s",
  FontSlant->"Italic"],
 " lies in the half-space that the cross product ",
 StyleBox["(p-r)\[Cross](q-r)",
  FontSlant->"Italic"],
 " points into. This is used to determine TetrahedronSinA, see below; it is \
the angle of rotation from plane ",
 StyleBox["p,q,r",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p,q,s",
  FontSlant->"Italic"],
 " about axis ",
 StyleBox["p,q",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.595714756094829*^9, 3.595714788850821*^9}, {
  3.595980242776709*^9, 3.595980259103387*^9}, {3.595980290662032*^9, 
  3.595980294636699*^9}, {3.595980328971315*^9, 3.59598036904062*^9}, {
  3.5959804179181337`*^9, 3.595980450371653*^9}, {3.595980529870269*^9, 
  3.5959806025288963`*^9}},ExpressionUUID->"f842a20a-5c3c-4655-a78b-\
5f4f4ff5ea03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronSignedVolume", "[", 
   RowBox[{"p_List", ",", "q_List", ",", "r_List", ",", "s_List"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"s", "-", "r"}], ")"}], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"q", "-", "r"}], ")"}], "\[Cross]", 
      RowBox[{"(", 
       RowBox[{"p", "-", "r"}], ")"}]}], ")"}]}], "6"]}]], "Input",
 CellChangeTimes->{{3.595714803112255*^9, 3.595714863792007*^9}, 
   3.595715023137314*^9, {3.595980382570952*^9, 3.59598043478573*^9}, {
   3.595980476373332*^9, 3.59598048227597*^9}},
 CellLabel->
  "In[659]:=",ExpressionUUID->"083039e6-6c0a-4b89-adf5-3342aca093dc"],

Cell["Example. A regular tetrahedron.", "Text",
 CellChangeTimes->{{3.595715312391916*^9, 
  3.595715319965427*^9}},ExpressionUUID->"3a9af8ef-9f59-4f93-9c13-\
4179514d91da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         SqrtBox["2"]}], ",", "0", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         SqrtBox["2"]}], ",", "0", ",", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "q"}], "}"}], "]"}], ",", "Red"}], "]"}], ",", 
         
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "r"}], "}"}], "]"}], ",", "Green"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "s"}], "}"}], "]"}], ",", "Blue"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"q", ",", "r"}], "}"}], "]"}], ",", "Cyan"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"q", ",", "s"}], "}"}], "]"}], ",", "Magenta"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"r", ",", "s"}], "}"}], "]"}], ",", "Yellow"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p\>\"", ",", "p"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<q\>\"", ",", "q"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<r\>\"", ",", "r"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<s\>\"", ",", "s"}], "]"}]}], "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TetrahedronSignedVolume", "[", 
      RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.5957153213917*^9, 3.595715417444004*^9}, 
   3.595980436701611*^9, {3.695303334670783*^9, 3.695303568680785*^9}},
 CellLabel->
  "In[660]:=",ExpressionUUID->"a6371418-8ae1-40bc-955d-e6f9867dc077"]
}, Closed]],

