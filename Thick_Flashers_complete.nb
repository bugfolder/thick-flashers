Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", "dir", ",", "tobj"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobjpd", "=", 
      RowBox[{"MakePenroseRhombTilingPrimalDualGraph", "[", "3", "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"15.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CCW"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"Direction", "\[Rule]", "dir"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PrimalDualGraphics", "[", "tobjpd", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"FaceupFace", "\[Rule]", 
            RowBox[{"-", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", "}"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
