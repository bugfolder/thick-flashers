   3.6276810460569577`*^9},ExpressionUUID->"fd504b3e-ad90-466e-b807-\
c920bf8e0247"],

Cell[TextData[{
 "UnitTriangleOffsetTwistSelfContainedQ[",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", d, ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns True if the angles and MV-assignment are consistent with a valid \
simple flat twist AND the resulting tile is self-contained, i.e., the twist \
polygon lies wholly within its tile."
}], "Text",
 CellChangeTimes->{{3.4577463017989073`*^9, 3.457746323657337*^9}, 
   3.627339676723423*^9, 3.6273859759738817`*^9, 3.62740355806841*^9, 
   3.627403599944899*^9, {3.62764553466708*^9, 3.6276455433922358`*^9}, {
   3.627645576876946*^9, 
   3.62764559474104*^9}},ExpressionUUID->"3d6b59e1-37cf-47bc-87f2-\
3f2df6835f7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitTriangleOffsetTwistSelfContainedQ", "[", 
    RowBox[{"angles_", ",", "w_", ",", "d_", ",", "types_List"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"RegularPolygonTwistValidQ", "[", 
     RowBox[{"angles", ",", 
      RowBox[{"UnitTriangleOffsetTwistAngle", "[", 
       RowBox[{"angles", ",", "w", ",", "d"}], "]"}], ",", "types"}], "]"}], "&&", 
    RowBox[{"w", "\[LessEqual]", 
     RowBox[{
      FractionBox["1", "3"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", 
         RowBox[{"Abs", "[", "d", "]"}]}]}], ")"}]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.592165344659134*^9, {3.627339676756432*^9, 3.627339676789706*^9}, 
