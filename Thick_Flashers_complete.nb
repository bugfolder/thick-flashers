Cell[CellGroupData[{

Cell["Unit triangle offset twist properties", "Subsection",
 CellChangeTimes->{{3.627400679174342*^9, 3.627400683077199*^9}, {
   3.627402198046246*^9, 3.627402202834943*^9}, 3.627406641207399*^9, {
   3.628693192959133*^9, 3.628693194758811*^9}, 
   3.62870878051777*^9},ExpressionUUID->"ca757d54-7046-4b4b-9f72-\
047aa102c839"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.627403152992134*^9, 
  3.627403153534317*^9}},ExpressionUUID->"df4fa596-df50-495f-bbf2-\
b06874c8a5bf"],

Cell["\<\
With offset twists, the polygons that give a flat-foldable tile with the \
offset construction are fewer than with tilted-pleat twists, which worked for \
any circumscribable polygon. For offset twists, all regular polygons work, \
and all triangles work. But for higher-order non-regular polygons, \
circumscribable ones don\[CloseCurlyQuote]t necessarily work. In fact, it\
\[CloseCurlyQuote]s an open problem of what polygons do work.\
\>", "Text",
 CellChangeTimes->{{3.627403158054021*^9, 3.62740319619571*^9}, {
  3.627403267782975*^9, 
  3.62740333946378*^9}},ExpressionUUID->"35b51732-8e2e-4245-8de4-\
2c5219097ebb"],

Cell["\<\
One of the differences that shows up even with triangles is that the \
circumcenter is not the same for the central and outer polygons, which we\
\[CloseCurlyQuote]ll show in this example.\
\>", "Text",
 CellChangeTimes->{{3.627403344618033*^9, 
  3.627403381695924*^9}},ExpressionUUID->"1e4944bc-b85f-4f8d-bff8-\
9a4ef4b3a2ac"],

Cell["\<\
Here\[CloseCurlyQuote]s an example of a triangle offset twist for which we \
compare various properties of the outer and central polygon. These \
demonstrate that the pleat-to-central-polygon angles are the same (same twist \
angles) and the central polygon is similar to the outer one (same corner \
angles), but there is not a universal stationary point the way there is for \
the tilted-pleat twist.\
\>", "Text",
 CellChangeTimes->{{3.627398916511569*^9, 3.627398930654462*^9}, {
  3.627399698499547*^9, 3.627399781910302*^9}, {3.627400652950402*^9, 
  3.627400655606498*^9}, {3.6287783317947817`*^9, 
  3.628778357726086*^9}},ExpressionUUID->"570ecd17-25b7-430b-960d-\
5a7e5a9a78b5"],

Cell["\<\
Some of the calculations are done symbolically so we also output explicit \
expressions for the twist angles. It takes further manipulation to obtain the \
simpler expression for twist angle below, but we do check their equivalence.\
\>", "Text",
 CellChangeTimes->{{3.6287783854648933`*^9, 3.628778446200179*^9}, {
  3.628783356766161*^9, 
  3.628783369076293*^9}},ExpressionUUID->"0f75316a-1923-45f4-be0d-\
6d655066e275"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tverts", ",", "tobj", ",", "ex", ",", "n", ",", "verts", ",", "pverts", 
      ",", "cverts", ",", "tas"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tverts", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"UnitTriangleVertices", "[", 
         RowBox[{"{", 
          RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "}"}], 
         "]"}], "/.", 
        RowBox[{
         RowBox[{"\[Theta]1", "+", "\[Theta]2"}], "\[Rule]", 
         RowBox[{"\[Pi]", "-", "\[Theta]3"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RenderTile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "PolygonOffsetTwistTile", ",", "tverts", ",", "w", ",", "d", " ", ",", 
          RowBox[{"{", 
           RowBox[{"M", ",", "M", ",", "M"}], "}"}]}], "}"}], ",", 
        "TGraphAssigned"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ex", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]1", "\[Rule]", 
         RowBox[{"50.", "\[Degree]"}]}], ",", 
        RowBox[{"\[Theta]2", "\[Rule]", 
         RowBox[{"60.", "\[Degree]"}]}], ",", 
        RowBox[{"\[Theta]3", "\[Rule]", 
         RowBox[{"70.", "\[Degree]"}]}], ",", 
        RowBox[{"w", "\[Rule]", "0.1"}], ",", 
        RowBox[{"d", "\[Rule]", "0.06"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", 
       RowBox[{
        RowBox[{"tobj", "[", "Faces", "]"}], "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"tobj", "[", "TwistFaces", "]"}], "\[LeftDoubleBracket]", 
         "1", "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"tobj", "[", "Vertices", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"verts", "\[LeftDoubleBracket]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "5", ",", "9"}], "}"}], "\[RightDoubleBracket]"}]}],
      ";", 
     RowBox[{"(*", " ", 
      RowBox[{"outer", " ", "polygon", " ", "vertices"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cverts", "=", 
      RowBox[{"verts", "\[LeftDoubleBracket]", 
       RowBox[{"{", 
        RowBox[{"4", ",", "8", ",", "12"}], "}"}], 
       "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"central", " ", "polygon", " ", "vertices"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"Append", "[", 
               RowBox[{"pverts", ",", 
                RowBox[{
                "pverts", "\[LeftDoubleBracket]", "1", 
                 "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", 
             "LightGray"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"GraphGraphics", "[", "tobj", "]"}], "\[LeftDoubleBracket]",
             "1", "\[RightDoubleBracket]"}]}], "}"}], "]"}], "/.", "ex"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<critical twist angles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"TriangleCriticalTwistAngles", "[", 
          RowBox[{"{", 
           RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "}"}], 
          "]"}], "/", "\[Degree]"}], "/.", "ex"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"directly", " ", "computed", " ", "twist", " ", "angles"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"all", " ", "three", " ", "twist", " ", "angles"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"tas", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationAngle", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}]}], "]"}], "&"}], "/@", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"4", ",", "8", ",", "3"}], "}"}], "+", 
             RowBox[{"4", "i"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"4", "n"}], ",", "1"}], "]"}]}], "/.", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         RowBox[{"x_", ",", "y_"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"ArcTan", "[", 
         RowBox[{"y", "/", "x"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tas", "=", 
      RowBox[{"FullSimplify", "[", "tas", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Twist angles = \>\"", ",", "tas"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Twist angles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{"tas", "/", "\[Degree]"}], "/.", "ex"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Check", " ", "our", " ", "alternate", " ", "formula", " ", "for", " ", 
       "the", " ", "twist", " ", "angle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<check: \>\"", ",", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "tas", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
           RowBox[{"ArcTan", "[", 
            RowBox[{
             RowBox[{"(", 
              FractionBox["w", 
               RowBox[{"2", "d"}]], ")"}], 
             RowBox[{"(", 
              FractionBox[
               RowBox[{
                RowBox[{"Sin", "[", "\[Theta]1", "]"}], 
                RowBox[{"Sin", "[", "\[Theta]2", "]"}], 
                RowBox[{"Sin", "[", "\[Theta]3", "]"}]}], 
               RowBox[{"1", "+", 
                RowBox[{
                 RowBox[{"Cos", "[", "\[Theta]1", "]"}], 
                 RowBox[{"Cos", "[", "\[Theta]2", "]"}], 
                 RowBox[{"Cos", "[", "\[Theta]3", "]"}]}]}]], ")"}]}], 
            "]"}]}], ")"}], "/.", "ex"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Triangle", " ", "angles", " ", 
       RowBox[{"(", "same", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Corner angles/\[Degree]: outer = \>\"", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"TriangleAngles2D", "@@", "pverts"}], ")"}], "/", 
         "\[Degree]"}], "/.", "ex"}], ",", "\"\< inner = \>\"", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"TriangleAngles2D", "@@", "cverts"}], ")"}], "/", 
         "\[Degree]"}], " ", "/.", "ex"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Triangle", " ", "circumcenters", " ", 
       RowBox[{"(", "different", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Circumcenters: outer = \>\"", ",", 
       RowBox[{
        RowBox[{"Circumcenter", "[", "pverts", "]"}], "/.", "ex"}], 
       ",", "\"\< inner = \>\"", ",", 
       RowBox[{
        RowBox[{"Circumcenter", "[", "cverts", "]"}], "/.", "ex"}]}], " ", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Triangle", " ", "incenters", " ", 
       RowBox[{"(", "different", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Incenters: outer = \>\"", ",", 
       RowBox[{
        RowBox[{"TriangleIncenter2D", "@@", "pverts"}], "/.", "ex"}], 
       ",", "\"\< inner = \>\"", ",", 
       RowBox[{
        RowBox[{"TriangleIncenter2D", "@@", "cverts"}], " ", "/.", "ex"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Triangle", " ", "Brocard", " ", "points", " ", 
       RowBox[{"(", "different", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{"Triangle", " ", "Brocard", " ", "points"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Brocard points: outer = \>\"", ",", 
         RowBox[{
          RowBox[{"BrocardTriangleInfo", "[", 
           RowBox[{"pverts", "/.", "ex"}], "]"}], "\[LeftDoubleBracket]", "2",
           "\[RightDoubleBracket]"}], ",", "\"\< inner = \>\"", ",", 
         RowBox[{
          RowBox[{"BrocardTriangleInfo", "[", 
           RowBox[{"cverts", "/.", "ex"}], "]"}], "\[LeftDoubleBracket]", "2",
           "\[RightDoubleBracket]"}]}], " ", "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Fixed", " ", "point", " ", "of", " ", "the", " ", "transformation"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{"ScaleRotationOffsetFixedPoint", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"pverts", ",", "2"}], "]"}], "/.", "ex"}], ",", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"cverts", ",", "2"}], "]"}], "/.", "ex"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Fixed point of twist = \>\"", ",", 
       RowBox[{"ctr", "/.", "ex"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6273989339060097`*^9, 3.627399073600842*^9}, {
   3.627399130604056*^9, 3.627399207736958*^9}, {3.627399243446846*^9, 
   3.627399282301092*^9}, {3.627399317932867*^9, 3.627399409495248*^9}, {
   3.6273994451232862`*^9, 3.627399558437455*^9}, {3.627403663097726*^9, 
   3.627403665137203*^9}, {3.628774661220168*^9, 3.62877468463663*^9}, {
   3.628774758286269*^9, 3.628774772134342*^9}, {3.628774805717826*^9, 
   3.628774816266897*^9}, {3.628774868199603*^9, 3.628774888023698*^9}, {
   3.628774922308014*^9, 3.628774980352754*^9}, {3.628775031445987*^9, 
   3.628775036939948*^9}, {3.628775228426282*^9, 3.628775347555632*^9}, 
   3.628775452313988*^9, {3.628775565341466*^9, 3.628775720976111*^9}, {
   3.628775757780385*^9, 3.628775765472492*^9}, {3.628775886381035*^9, 
   3.628775958329184*^9}, {3.628776099554067*^9, 3.628776168604253*^9}, {
   3.628776239066588*^9, 3.62877628857529*^9}, {3.628776407805647*^9, 
   3.628776521126624*^9}, {3.628776600530326*^9, 3.628776601122933*^9}, {
   3.628776904976057*^9, 3.628776975350345*^9}, {3.628777015521393*^9, 
   3.628777019398595*^9}, {3.628777271819191*^9, 3.628777345542294*^9}, {
   3.628777379892818*^9, 3.6287776371241417`*^9}, {3.628778178161187*^9, 
   3.628778293668129*^9}, {3.62877837748638*^9, 3.628778380846434*^9}, {
   3.628778479710805*^9, 3.628778518625355*^9}, {3.628782221319919*^9, 
   3.628782248142373*^9}, {3.628783337179973*^9, 3.628783343294545*^9}, 
   3.628786222715707*^9, 3.629219927043474*^9, {3.629850991151477*^9, 
   3.629851016360291*^9}, {3.629851092385717*^9, 3.6298511013507233`*^9}, {
   3.631469668204265*^9, 3.631469671971175*^9}, {3.63146990819145*^9, 
   3.631469909359374*^9}, {3.631470032471341*^9, 3.631470057153203*^9}, {
   3.632080699716528*^9, 3.632080699749365*^9}, {3.632082178303527*^9, 
   3.632082178366659*^9}, {3.707920490047252*^9, 3.707920497175496*^9}, 
   3.778749050570679*^9},
 CellLabel->
