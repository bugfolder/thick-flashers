Cell[TextData[{
 "UncurlCurveInDevelopableSystem[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a space curve embedded in a developable surface and constructs the \
2D and 3D descriptions of the curve and its frames."
}], "Text",
 CellChangeTimes->{{3.67206297700732*^9, 3.6720629884601293`*^9}, {
   3.672063048247298*^9, 3.672063153265608*^9}, {3.672063184564661*^9, 
   3.672063214741748*^9}, {3.672063381214768*^9, 3.672063385819169*^9}, {
   3.67206352324258*^9, 3.672063577783233*^9}, {3.687478611051678*^9, 
