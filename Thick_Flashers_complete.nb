 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj", ",", "tobj1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
