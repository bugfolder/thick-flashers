 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "alist", ",", "dlist", ",", "w", ",", "nw", ",", "\[Gamma]", ",", "tobj",
       ",", "ci"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"alist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90", "\[Degree]"}], ",", 
