Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitBrocardPolygonInfo", "::", "baddir"}], 
   "=", "\"\<Twist direction `1` must be CCW or CW.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629129514425538*^9, 3.629129543765858*^9}, {
   3.629129882178124*^9, 3.629129895704105*^9}, 3.629131640152631*^9, 
