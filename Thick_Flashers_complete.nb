       RowBox[{"pinfo", ",", "qinfo"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Append", "[", 
             RowBox[{"ppoly", ",", 
              RowBox[{
              "ppoly", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", "Red"}], "]"}],
          ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Append", "[", 
             RowBox[{"qpoly", ",", 
              RowBox[{
              "qpoly", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", "Green"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"If", "[", 
         RowBox[{
         "int", ",", "\"\<intersecting\>\"", 
          ",", "\"\<non-intersecting\>\""}], "]"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.62882217538386*^9, 3.6288223240266533`*^9}, 
   3.628822457458253*^9, {3.628822602385006*^9, 3.628822628439296*^9}, {
   3.628854956605219*^9, 3.628855048092129*^9}, {3.628855880103804*^9, 
   3.628855928005643*^9}, {3.628855959729665*^9, 3.6288559886413803`*^9}, {
   3.628856186770869*^9, 3.628856222087966*^9}, {3.628862856617515*^9, 
   3.628862859671318*^9}, {3.628862896600801*^9, 3.628862899264131*^9}, {
   3.628863103976602*^9, 3.628863106366033*^9}, 3.676486346200267*^9},
 CellLabel->
