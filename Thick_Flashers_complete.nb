Cell[CellGroupData[{

Cell[TextData[{
 "MakePrimalDualTwistTessellationBoundaryEdge",
 "[",
 StyleBox["bedge",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bface",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", \[Rho], \[Beta]]"
}], "Subsubsection",
 CellChangeTimes->{{3.465915859740906*^9, 3.465915884114718*^9}, {
   3.465915928271497*^9, 3.465915991027135*^9}, {3.465916141561344*^9, 
   3.4659161577117*^9}, {3.465916760295277*^9, 3.465916761030854*^9}, 
   3.465926075399856*^9, 3.465926196216913*^9, 3.465926593149192*^9, 
   3.465927228843145*^9, {3.46592754724012*^9, 3.465927584770458*^9}, {
   3.485256126894574*^9, 3.485256140430397*^9}, {3.48525652418583*^9, 
   3.485256525815651*^9}, 3.55175437738165*^9, 
   3.551754432608417*^9},ExpressionUUID->"947218ce-9c81-4e09-8f6b-\
9dba395442b1"],

Cell[TextData[{
 "MakePrimalDualBoundaryEdges[",
 StyleBox["bedge",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bface",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", \[Rho], \[Beta]] takes a boundary edge ",
 StyleBox["bedge",
  FontSlant->"Italic"],
 " (specified as a vertex index pair) and the index ",
 StyleBox["bface",
  FontSlant->"Italic"],
 " of the dual vertex that corresponds to the face incident to that edge, an \
embedding of the primary vertices ",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", an embedding of the dual vertices ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", a shrinkage parameter \[Rho], rotation angle \[Beta], and it returns a \
list {",
 StyleBox["edgepair",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edgetype",
  FontSlant->"Italic"],
 "} where ",
 StyleBox["edgepair",
  FontSlant->"Italic"],
 " is a vertex pair for the corresponding edge and ",
 StyleBox["edgetype",
  FontSlant->"Italic"],
 " is its type (which will always be B)."
}], "Text",
 CellChangeTimes->{{3.465916009500443*^9, 3.465916303437623*^9}, {
   3.465916338475544*^9, 3.465916374536664*^9}, {3.4659167733409867`*^9, 
   3.465916791645625*^9}, {3.46592607651521*^9, 3.46592607911454*^9}, {
   3.465926196796556*^9, 3.465926197746943*^9}, {3.465926381860821*^9, 
   3.4659263985238247`*^9}, {3.465926593918154*^9, 3.46592659499684*^9}, 
   3.465927228862213*^9, {3.465927596486957*^9, 3.4659277415283017`*^9}, {
   3.485256144722559*^9, 
   3.485256252604935*^9}},ExpressionUUID->"46c03aed-38f1-44a3-8d46-\
f78e55a59253"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePrimalDualTwistTessellationBoundaryEdge", "[", 
   RowBox[{
   "bedge_", ",", "bface_", ",", "pverts_", ",", "dverts_", ",", "\[Rho]_", ",",
     "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "d1", ",", "d2", ",", "p1d1", ",", "p1d2", ",", 
      "p2d1", ",", "p2d2", ",", "p1b", ",", "p2b", ",", "s1", ",", "s2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}], "=", 
      RowBox[{
      "pverts", "\[LeftDoubleBracket]", "bedge", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"d1", "=", 
      RowBox[{
      "dverts", "\[LeftDoubleBracket]", "bface", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"p1d1", "=", 
      RowBox[{"ScaleAndTwistPoint", "[", 
       RowBox[{"p1", ",", "d1", ",", "\[Rho]", ",", "\[Beta]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p2d1", "=", 
      RowBox[{"ScaleAndTwistPoint", "[", 
       RowBox[{"p2", ",", "d1", ",", "\[Rho]", ",", "\[Beta]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1d1", ",", "p2d1"}], "}"}], ",", "B"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.465916731507865*^9, 3.4659167542890472`*^9}, {
   3.465916801902034*^9, 3.465916813965774*^9}, {3.465916846995219*^9, 
