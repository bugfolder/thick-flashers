Cell[CellGroupData[{

Cell[TextData[{
 "SimilarityPair2D3D[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q3",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.650289998913982*^9, 3.6502900091705713`*^9}, {
  3.65029011016861*^9, 
  3.650290128815609*^9}},ExpressionUUID->"055ec4ca-f959-4caa-928b-\
42f0726fcedc"],

Cell[TextData[{
 "SimilarityPair2D3D[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2, p3",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, q3",
  FontSlant->"Italic"],
 "}] returns a list {",
 StyleBox["mat, offset",
  FontSlant->"Italic"],
 "} that describes the handedness-preserving similarity transformation from \
the 2D vertex trio {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2, p3",
  FontSlant->"Italic"],
 "} to the 3D vertex trio {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, q3",
  FontSlant->"Italic"],
 "}, via sequential matrix multiplication by ",
 StyleBox["mat",
  FontSlant->"Italic"],
 " followed by an addition of ",
 StyleBox["offset.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.627572047396574*^9, 3.62757216630088*^9}, 
   3.627572765625537*^9, {3.627572832600632*^9, 3.627572859231009*^9}, 
   3.627572902303552*^9, {3.627572980208088*^9, 3.6275730025175357`*^9}, {
   3.627573366497279*^9, 3.6275733879085636`*^9}, 3.627573427982486*^9, {
   3.6287823357448463`*^9, 3.628782357404974*^9}, 3.628786247150931*^9, {
   3.649955513406292*^9, 3.6499555188681393`*^9}, {3.649955626919237*^9, 
   3.649955630916848*^9}, {3.649955671275254*^9, 3.6499557935149403`*^9}, 
   3.6499559186164293`*^9, {3.649955949624859*^9, 3.649955949920956*^9}, {
   3.6499559949410887`*^9, 3.649956071249892*^9}, {3.649957093008771*^9, 
   3.6499570931923532`*^9}, {3.649957871841477*^9, 3.64995790626087*^9}, {
   3.649958154453204*^9, 3.64995822279266*^9}, {3.6502900239126883`*^9, 
   3.650290035301555*^9}, {3.650290114856732*^9, 3.650290127280403*^9}, 
   3.7079248499430537`*^9},ExpressionUUID->"a4d4d001-397e-4088-afeb-\
8c038a6734b9"],

Cell["\<\
This is particularly useful for going from crease pattern to folded form; if \
you know three points of a planar polygon in the crease pattern and folded \
form, then this gives you the mapping between CP and FF for any other point \
within the polygon.\
\>", "Text",
 CellChangeTimes->{{3.650290994528466*^9, 
  3.650291058972604*^9}},ExpressionUUID->"672471b9-4a8a-4cb8-854d-\
0412dc4ed6af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SimilarityPair2D3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_", ",", "q3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rm", ",", "offset"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rm", ",", "offset"}], "}"}], "=", 
      RowBox[{"SimilarityPair3D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Drop", "[", 
          RowBox[{"#", ",", 
           RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "rm"}], ",", "offset"}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.650290095579421*^9, 3.65029021906168*^9}, {
  3.650290620796899*^9, 3.6502906398965187`*^9}},
 CellLabel->
  "In[718]:=",ExpressionUUID->"0afe312a-5902-4285-b425-4c6aa2266cdf"],

Cell["\<\
Example. Note the blue dot is at the computed location of q2 (so it agrees \
with the actual location).\
\>", "Text",
 CellChangeTimes->{{3.649958684332283*^9, 3.649958694061329*^9}, {
  3.649961035743753*^9, 
  3.649961050381167*^9}},ExpressionUUID->"a3331b14-23b2-4d56-ac92-\
