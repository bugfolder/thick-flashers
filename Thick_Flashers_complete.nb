  3.650064064625618*^9}},ExpressionUUID->"0d7c5d07-62fe-4695-b6c2-\
73e81a8d765f"],

Cell[TextData[{
 "TypeToFlatFoldAngle[",
 StyleBox["type",
  FontSlant->"Italic"],
 "] returns the fold angle for a flat fold for a given fold type."
}], "Text",
 CellChangeTimes->{{3.597515406966316*^9, 
  3.597515443789762*^9}},ExpressionUUID->"85adf72c-8a07-4f47-9348-\
27065a33aa15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TypeToFlatFoldAngle", "[", 
   StyleBox["type_",
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{"Switch", "[", 
   RowBox[{"type", ",", "V", ",", "\[Pi]", ",", "M", ",", 
    RowBox[{"-", "\[Pi]"}], ",", "_", ",", "0"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.597515452647375*^9, 3.5975154836384*^9}},
 CellLabel->
  "In[1813]:=",ExpressionUUID->"d91613d2-9ad7-4c03-a63e-67dad8d4f341"],

