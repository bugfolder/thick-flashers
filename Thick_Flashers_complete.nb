Cell[TextData[{
 "ReplaceStyleArgs[",
 StyleBox["obj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["oldstyleargs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["newstyleargs",
  FontSlant->"Italic"],
 "] takes an object ",
 StyleBox["obj",
  FontSlant->"Italic"],
 " and changes the style arguments that were ",
 StyleBox["oldstyleargs",
  FontSlant->"Italic"],
 " to new style arguments ",
 StyleBox["newstyleargs",
  FontSlant->"Italic"],
 ". One will typically import a crease pattern, use ",
 "ExtractStyleArgs",
 "[] to get a list of the existing styles, then reassign them to some other \
style, either to symbolic styles or to literal style directives."
}], "Text",
 CellChangeTimes->{{3.45653036154381*^9, 3.456530390366248*^9}, {
   3.456530421119024*^9, 3.456530485648037*^9}, {3.456530565822141*^9, 
   3.456530576594195*^9}, {3.589465801284256*^9, 3.589465805800981*^9}, 
   3.628786592448845*^9},ExpressionUUID->"f43009f2-e7ae-4c22-a2e4-\
3f80c7017325"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceStyleArgs", "[", 
   RowBox[{"obj_", ",", "oldstyleargs_", ",", "newstyleargs_"}], "]"}], ":=", 
  
  RowBox[{"obj", "/.", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"xobj_", ",", "style___"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"Style", "[", 
     RowBox[{"xobj", ",", 
      RowBox[{
       RowBox[{"{", "style", "}"}], "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{"Rule", "[", 
         RowBox[{"oldstyleargs", ",", "newstyleargs"}], "]"}], "]"}]}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.456530488501417*^9, 3.4565305671856213`*^9}},
 CellLabel->
  "In[875]:=",ExpressionUUID->"cb311829-c5cc-4dc5-834f-ffb5b43f8932"]
}, Closed]]
}, Closed]],

