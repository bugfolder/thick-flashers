Cell[TextData[{
 "MakeGeneralTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}] does the same thing as MakeGeneralTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 "}], but makes all the ",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 " distances equal to ",
 StyleBox["d1",
  FontSlant->"Italic"],
 " (",
 StyleBox["nh",
  FontSlant->"Italic"],
 " repeats) and all the ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 " distances equal to ",
 StyleBox["d2",
  FontSlant->"Italic"],
 " (",
 StyleBox["nv",
  FontSlant->"Italic"],
 " repeats)."
}], "Text",
