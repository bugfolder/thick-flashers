ec069b724ce8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TileArrowCF", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "q_"}], "}"}], ",", " ", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "s", ",", "ctr", ",", "sz", ",", "w", ",", "pts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"Rotate90", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sz", "=", "0.18"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"sz", "#"}]}], "&"}], "/@", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dir", ">", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", ".5"}], "s"}], ",", 
           RowBox[{
            RowBox[{".5", "s"}], "+", 
            RowBox[{"w", " ", "r"}]}], ",", 
           RowBox[{
            RowBox[{".5", "s"}], "-", 
            RowBox[{"w", " ", "r"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "w"}], " ", "r"}], "-", 
            RowBox[{".5", "s"}]}], ",", 
           RowBox[{
            RowBox[{"w", " ", "r"}], "-", 
            RowBox[{".5", "s"}]}], ",", 
           RowBox[{".5", "s"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Polygon", "[", "pts", "]"}], ",", "TilingLine"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627580968539734*^9, 3.627581201475292*^9}, {
