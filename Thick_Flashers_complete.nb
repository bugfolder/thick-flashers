Cell[CellGroupData[{

Cell[TextData[{
 "MakeAltMoselyPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MinimumAngle, ",
 "FoldedFormGapSize"
}], "Subsubsection",
 CellChangeTimes->{{3.526835329401933*^9, 3.526835370101651*^9}, 
   3.5268390882697153`*^9, 
   3.592127768727127*^9},ExpressionUUID->"74b3fc90-3722-4291-b3a1-\
c4434e4195e4"],

Cell[TextData[{
 "MakeAltMoselyPot",
 "[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates an alternating-direction pot with a rectangular crease pattern; \
the equivalent of Jeannine Mosely's Orb. The first and last points must lie \
on the rotational axis (if they don't, a point will be appended to make it \
so), and the rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " must be even."
}], "Text",
 CellChangeTimes->{{3.526835384118589*^9, 3.52683548205446*^9}, 
   3.526839088285783*^9},ExpressionUUID->"f208abaf-caab-4c8f-8dd7-\
b2670ef41ecf"],

Cell["\<\
Note that this only returns the SplitWedge shapes, none of the standard \
wedges, since we've built up the whole thing from split wedges.\
\>", "Text",
 CellChangeTimes->{{3.526838916428273*^9, 3.526838940433345*^9}, {
  3.533659604908497*^9, 
  3.533659608988153*^9}},ExpressionUUID->"1d53423b-39f6-434f-ae40-\
203e5c90029c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeAltMoselyPot", "::", "badm"}], 
   "=", "\"\<The rotational order `1` must be positive even.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.526835798510378*^9, 3.526835832264188*^9}, 
   3.526839088304927*^9},
 CellLabel->
  "In[3552]:=",ExpressionUUID->"d203151e-5aa0-4de0-9dbd-c56fcc2ee237"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeAltMoselyPot", "[", 
   RowBox[{"pts_", ",", "m_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Phi]", ",", "pts1", ",", "ht", ",", "cs", ",", "cpsw1", ",", "ffsw1", 
      ",", "cpsw2", ",", "ffsw2", ",", "w", ",", "cpsw", ",", "ffsw", ",", 
      "cp", ",", "ff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"m", ",", "2"}], "]"}], "\[NotEqual]", "0"}], "||", 
        RowBox[{"m", "\[LessEqual]", "0"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeAltMoselyPot", "::", "badm"}], ",", "m"}], "]"}], ";", 
        
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"pts", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "<", 
         RowBox[{"pts", "\[LeftDoubleBracket]", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"Append", "[", 
         RowBox[{"pts", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pts", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{"pts", "\[LeftDoubleBracket]", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}], "+",
              ".0001"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pts", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ">", 
         RowBox[{"pts", "\[LeftDoubleBracket]", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"Prepend", "[", 
         RowBox[{"pts", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pts", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}], ",", 
            
            RowBox[{
             RowBox[{"pts", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "-", 
             ".0001"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", "True", 
        ",", "pts"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"start", " ", "and", " ", "end", " ", "on", " ", "axis"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ht", "=", 
      RowBox[{
       RowBox[{"pts", "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}], "-", 
       RowBox[{"pts", "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"height", " ", "of", " ", "pot"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cs", ",", "cpsw1", ",", "ffsw1"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{
        RowBox[{"MakeMoselyPot", "[", 
         RowBox[{"pts1", ",", "m", ",", "opts"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "CrossSection", ",", "CreasePatternSplitWedge", ",", 
          "FoldedFormSplitWedge"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cpsw2", ",", "ffsw2"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{
        RowBox[{"MakeMoselyPot", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "pts1", "]"}], ",", "m", ",", "opts"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"CreasePatternSplitWedge", ",", "FoldedFormSplitWedge"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", 
      RowBox[{
       RowBox[{"GraphicsBoundingBox", "[", "cpsw1", "]"}], "\[LeftDoubleBracket]", 
       RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "xmax", " ", "of", " ", "first", " ", "piece", " ", "of", " ", "cp"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cpsw", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "cpsw1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"FunctionTransform", "[", 
           RowBox[{
            RowBox[{
            "cpsw2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"w", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", 
                  RowBox[{"2", "\[Phi]"}], "]"}], ",", 
                 RowBox[{"Sin", "[", 
                  RowBox[{"2", "\[Phi]"}], "]"}]}], "}"}]}], "+", 
              RowBox[{"ReflectionYMatrix2D", ".", 
               RowBox[{"RotationMatrix2D", "[", 
                RowBox[{
                 RowBox[{"-", "2"}], 
                 RowBox[{"\[Pi]", "/", "m"}]}], "]"}], ".", "#"}]}], "&"}]}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Translate2D", "[", 
           RowBox[{
            RowBox[{
            "cpsw", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"w", " ", "i", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{"2", "\[Phi]"}], "]"}], "-", "1"}], ",", 
               RowBox[{"Sin", "[", 
                RowBox[{"2", "\[Phi]"}], "]"}]}], "}"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"m", "/", "2"}], "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ffsw", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "ffsw1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"FunctionTransform", "[", 
            RowBox[{
             RowBox[{
             "ffsw2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "ht"}], "}"}], "+", 
               RowBox[{
                RowBox[{"RotationZMatrix3D", "[", 
                 RowBox[{"2", 
                  RowBox[{"\[Pi]", "/", "m"}]}], "]"}], ".", "#"}]}], "&"}]}],
             "]"}], "/.", 
           RowBox[{
            RowBox[{"Polygon", "[", "x_", "]"}], "\[RuleDelayed]", 
            RowBox[{"Polygon", "[", 
             RowBox[{"Reverse", "[", "x", "]"}], "]"}]}]}]}], "}"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"MatrixTransform", "[", 
           RowBox[{
            RowBox[{
            "ffsw", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"RotationZMatrix3D", "[", 
             RowBox[{"4", "\[Pi]", " ", 
              RowBox[{"i", "/", "m"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"m", "/", "2"}], "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MakeTDisplayPair", "[", 
       RowBox[{
        RowBox[{"Rotate2D", "[", 
         RowBox[{"cp", ",", 
          RowBox[{"-", "\[Phi]"}]}], "]"}], ",", "ff"}], "]"}], "//", 
      RowBox[{"AddClass", "[", 
       RowBox[{"TRotationalPot", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CrossSection", "\[Rule]", "cs"}], ",", 
          RowBox[{"CreasePatternSplitWedge", "\[Rule]", 
           RowBox[{"Rotate2D", "[", 
            RowBox[{"cpsw", ",", 
             RowBox[{"-", "\[Phi]"}]}], "]"}]}], ",", 
          RowBox[{"FoldedFormSplitWedge", "\[Rule]", "ffsw"}]}], "}"}]}], 
       "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.526835495079723*^9, 3.526835527102881*^9}, {
   3.526835570203247*^9, 3.526835708530774*^9}, {3.526835748930672*^9, 
   3.526835793717492*^9}, {3.526835837571315*^9, 3.526835892359758*^9}, {
   3.526835926110038*^9, 3.526835964879823*^9}, {3.526835994915386*^9, 
   3.526836051840136*^9}, {3.526836094594047*^9, 3.526836104101478*^9}, {
   3.526836816238715*^9, 3.5268368346161823`*^9}, {3.526836925586562*^9, 
   3.526837006773225*^9}, {3.526837109664122*^9, 3.526837177657939*^9}, {
   3.526837221016021*^9, 3.526837235544044*^9}, {3.526837271645898*^9, 
   3.526837326105885*^9}, {3.526837388085413*^9, 3.526837388583372*^9}, {
   3.526837423722645*^9, 3.526837450839306*^9}, {3.526837491447614*^9, 
   3.52683754688028*^9}, {3.526837577895937*^9, 3.526837585838708*^9}, {
   3.526837671202004*^9, 3.52683767772926*^9}, {3.526837735932996*^9, 
   3.526837838725127*^9}, {3.526837894239814*^9, 3.526837975836845*^9}, {
   3.526838007347638*^9, 3.52683809515579*^9}, {3.526838173595081*^9, 
   3.526838251312571*^9}, {3.526838328217738*^9, 3.526838338905311*^9}, {
   3.526838371856522*^9, 3.526838552832662*^9}, {3.526838595936008*^9, 
   3.526838681598834*^9}, {3.526838750909618*^9, 3.526838821639977*^9}, {
   3.526838854902326*^9, 3.526838855145741*^9}, {3.526839088350734*^9, 
   3.526839088386185*^9}, {3.592128704016893*^9, 3.592128738331765*^9}, 
   3.592213916211029*^9, 3.592435766597503*^9, {3.592670440331348*^9, 
   3.5926704403971233`*^9}, {3.592670635550507*^9, 3.592670635614746*^9}, {
   3.592671074863542*^9, 3.5926710749284277`*^9}, {3.593090030913379*^9, 
   3.5930903211842213`*^9}, 3.5947413834504623`*^9, 3.628786441649313*^9},
 CellLabel->
  "In[3553]:=",ExpressionUUID->"d5e15839-a897-462b-badf-f48f708542d3"],

