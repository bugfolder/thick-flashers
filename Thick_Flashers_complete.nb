Cell["\<\
Returns: A list of rules containing functions that describe the conic section.\
\>", "Text",
 CellChangeTimes->{{3.692198372572508*^9, 3.692198496764723*^9}, {
   3.692281941520776*^9, 3.692281952694111*^9}, 
   3.693950246952415*^9},ExpressionUUID->"27ba5410-3851-418d-9bcc-\
d93cfbfdc361"],

Cell[TextData[{
 "Note that if the left focus is to the left of the fold, we should have ",
 StyleBox["fl",
  FontSlant->"Italic"],
 " < ",
 StyleBox["hl",
  FontSlant->"Italic"],
 ". Similarly, if the right focus is to the right of the fold, we should have \
",
 StyleBox["hr",
  FontSlant->"Italic"],
 " < ",
 StyleBox["fr.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{
  3.692184612456163*^9, {3.692198018604524*^9, 3.692198018609542*^9}, {
