Cell[TextData[{
 "StyledColoredPatch[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces Graphics or Graphics3D elements for a styled patch using a \
SurfaceColorFunction to color the surface."
}], "Text",
 CellChangeTimes->{{3.672144204921938*^9, 3.6721443950838137`*^9}, {
   3.67214446184886*^9, 3.672144529787459*^9}, {3.672146235402009*^9, 
