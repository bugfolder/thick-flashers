Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nx", ",", "ny", ",", "r", ",", "tobj", ",", "verts3d"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nx", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ny", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", "1.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeWaterbombTessellation", "[", 
       RowBox[{"nx", ",", "ny", ",", "0.95"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices3D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"StrainTQMesh", "[", 
       RowBox[{"tobj", ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"(*", " ", 
          RowBox[{
          "constrain", " ", "two", " ", "vertices", " ", "to", " ", "their", " ",
            "original", " ", "position"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"VertexPointEqualityConstraints", "[", 
           RowBox[{"4", ",", 
            RowBox[{
            "verts3d", "\[LeftDoubleBracket]", "4", 
             "\[RightDoubleBracket]"}]}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"VertexPointEqualityConstraints", "[", 
           RowBox[{"9", ",", 
            RowBox[{
            "verts3d", "\[LeftDoubleBracket]", "9", 
             "\[RightDoubleBracket]"}]}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "stretch", " ", "two", " ", "vertices", " ", "away", " ", "from", " ",
             "their", " ", "original", " ", "position"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"VertexPointEqualityConstraints", "[", 
           RowBox[{"32", ",", 
            RowBox[{
             RowBox[{
             "verts3d", "\[LeftDoubleBracket]", "32", 
              "\[RightDoubleBracket]"}], "-", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "r"}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"VertexPointEqualityConstraints", "[", 
           RowBox[{"35", ",", 
            RowBox[{
             RowBox[{
             "verts3d", "\[LeftDoubleBracket]", "35", 
              "\[RightDoubleBracket]"}], "-", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "r"}], "}"}]}]}], "]"}]}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"QuadBendStiffness", "\[Rule]", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FlatFoldStiffness", "\[Rule]", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"SplitBentFaces", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"MatrixTransform", "[", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], ",", 
           RowBox[{"RotationXMatrix3D", "[", 
            RowBox[{".75", "\[Pi]"}], "]"}]}], "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
