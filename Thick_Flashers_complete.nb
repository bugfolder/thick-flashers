Cell["Example.", "Text",
 CellChangeTimes->{{3.64995168750569*^9, 3.649951688207208*^9}, 
   3.649964305792065*^9},ExpressionUUID->"12c00377-ae46-4bc3-81d2-\
36809d6e23a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts1", ",", "edges1", ",", "verts2d1", ",", "types1", ",", "tobj1", ",",
       "verts2", ",", "edges2", ",", "verts2d2", ",", "types2", ",", "tobj2", 
      ",", "vlist", ",", "elist", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d1", "=", "verts1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types1", "=", 
      RowBox[{"{", 
       RowBox[{"B", ",", "B", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"MakeTGraph2DAssigned", "[", 
        RowBox[{"verts1", ",", "edges1", ",", 
         RowBox[{"{", "}"}], ",", "verts2d1", ",", "types1"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d2", "=", "verts2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types2", "=", 
      RowBox[{"{", 
       RowBox[{"B", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{
       RowBox[{"MakeTGraph2DAssigned", "[", 
        RowBox[{"verts2", ",", "edges2", ",", 
         RowBox[{"{", "}"}], ",", "verts2d2", ",", "types2"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"JoinGraph2DAssigneds", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tobj1", ",", 
            RowBox[{"{", "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"tobj2", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "4"}], "}"}]}], "}"}]}], "}"}]}], "}"}], 
        "]"}], "//", "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"CreasePatternGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1 CP\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"CreasePatternGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2 CP\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"CreasePatternGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged CP\>\""}]}], "]"}]}],
           "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"GenericFoldedFormGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1 FF\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"GenericFoldedFormGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2 FF\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"GenericFoldedFormGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged FF\>\""}]}], "]"}]}],
           "\[IndentingNewLine]", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594663894798616*^9, 3.594664130749181*^9}, {
   3.594664326661407*^9, 3.5946643368284073`*^9}, {3.594664401025264*^9, 
   3.594664414552273*^9}, 3.594664465127211*^9, {3.594664571710458*^9, 
   3.594664584367658*^9}, {3.594734253872629*^9, 3.594734253936652*^9}, 
   3.594928983200805*^9, {3.594929553011519*^9, 3.59492957052628*^9}, 
   3.594929639244863*^9, {3.594930803983424*^9, 3.594930810447532*^9}, {
   3.64988956781438*^9, 3.649889723398097*^9}, 3.649889775149764*^9, {
   3.649890666973032*^9, 3.649890683897067*^9}, 3.649891101972361*^9, {
   3.649891758046391*^9, 3.649891758982553*^9}, {3.649953480179121*^9, 
   3.649953548165152*^9}, {3.649954200091621*^9, 3.6499542923081217`*^9}, {
   3.649964308658388*^9, 3.649964310011701*^9}, {3.70782582078547*^9, 
   3.707825835496898*^9}, 3.707911962994779*^9},
 CellLabel->
  "In[2013]:=",ExpressionUUID->"6d8f7165-63b6-41b9-83fe-271a047de165"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "JoinGraph3DAssigneds[",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph3D+TAssigned\n\t(options) KillMergedEdges, \
SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.649951102251536*^9, 3.649951107196585*^9}, {
   3.649951280333678*^9, 3.649951297936036*^9}, {3.6499537346469398`*^9, 
   3.649953742837015*^9}, {3.649954371918158*^9, 3.64995437478891*^9}, 
   3.6499640583199596`*^9, 3.707825858313099*^9, 
   3.707843430283409*^9},ExpressionUUID->"eb7f3038-c3ef-45bb-abae-\
8eb6066e3755"],

Cell[TextData[{
 "JoinGraph3DAssigneds[",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of ",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 " that describe how a series of TGraph3D+TAssigned objects should be joined, \
repositions and merges them into a single TGraph3DAssigned."
}], "Text",
 CellChangeTimes->{{3.649953580651525*^9, 3.649953641719568*^9}, 
   3.649964090533964*^9, {3.707818896128908*^9, 3.707818937184185*^9}, {
   3.707818985801503*^9, 3.70781900456876*^9}, {3.707825717025475*^9, 
   3.707825725885808*^9}, {3.70782587254457*^9, 
   3.707825878654811*^9}},ExpressionUUID->"f1a0a50b-3929-48cd-a59e-\
0bb1dd14b6a1"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 " \[LongDash] a list consisting of entries that describe how a series of \
TGraph3D+TAssigned objects should be joined. See details below."
}], "Text",
 CellChangeTimes->{{3.707767526764463*^9, 3.70776754143788*^9}, 
   3.707818924665851*^9, {3.707819007791748*^9, 3.707819030400925*^9}, {
   3.70782185463499*^9, 3.707821855443193*^9}, {3.707825918124948*^9, 
   3.707825990520718*^9}, {3.707827256267058*^9, 
   3.707827273164168*^9}},ExpressionUUID->"382d8593-3b0d-4ac7-80f3-\
bd8ee5fd0bff"],

Cell[TextData[{
 "Options:\n\tKillMergedEdges \[Rule] True | False, specify whether to remove \
merged edges.\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", tolerance on whether two vertices are distinct."
}], "Text",
 CellChangeTimes->{{3.707777850542234*^9, 3.707777853581541*^9}, {
   3.707778293920401*^9, 3.70777842795789*^9}, {3.707781820295705*^9, 
   3.707781862978016*^9}, 3.707823804527522*^9, 3.707824770447994*^9, 
   3.707824974120908*^9, {3.70782556161154*^9, 
   3.707825563363729*^9}},ExpressionUUID->"7a519ee8-f67e-48a7-aa30-\
78a1d15a8ae7"],

Cell["Returns the joined TGraph3DAssigned.", "Text",
 CellChangeTimes->{{3.707819033855734*^9, 3.707819043208968*^9}, {
   3.7078257285644016`*^9, 3.707825729373938*^9}, 
   3.707825882742394*^9},ExpressionUUID->"02f3c4ad-32c9-488b-9a8d-\
d5d82399bea1"],

Cell[TextData[{
 "There are two acceptable forms of the entries in list ",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.707827211619102*^9, 
  3.707827225499799*^9}},ExpressionUUID->"1fc97cb0-bef1-4af4-b194-\
c445807b5d9b"],

Cell[TextData[{
 "The first acceptable form for each entry is {",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}} (same as in JoinGraphs, JoinGraphAssigneds, etc.), where \n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is a TGraph, \n\t{",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}} specifies how that graph is to be joined to one of its predecessors in \
the list. \nThe TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is offset, rotated, and scaled in the ",
 StyleBox["x-y",
  FontSlant->"Italic"],
 " plane so that the vertex pair {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "} of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th TGraph will be the position of the {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "} vertex pair of the transformed ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " in both the crease pattern and in 3D. This form is appropriate for \
subgraphs that are already sitting in the x-y plane and where the merged \
graph is also roughly planar."
}], "Text",
 CellChangeTimes->{{3.707827281122936*^9, 3.707827346077532*^9}, {
  3.707827378660532*^9, 3.707827445806215*^9}, {3.70782747847856*^9, 
  3.707827487102028*^9}, {3.7078275244869437`*^9, 
  3.707827549238978*^9}},ExpressionUUID->"78df92f4-ae9a-4c96-92a2-\
9799c622a3f7"],

Cell[TextData[{
 "The first {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}} in ",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 " can be an empty list because it is ignored."
}], "Text",
 CellChangeTimes->{
  3.707826134458828*^9, {3.707827573415591*^9, 3.707827577223197*^9}, {
   3.707828075650326*^9, 
   3.707828095674531*^9}},ExpressionUUID->"88346788-7248-4626-aacd-\
a78309f1db91"],

Cell[TextData[{
 "The second acceptable form is {",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2, j3",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2, k3",
  FontSlant->"Italic"],
 "}}, where \n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is a TGraph, \n\t{",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2, j3",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2, k3",
  FontSlant->"Italic"],
 "}} specify how that graph is to be joined to one of its predecessors in the \
list. \nThe TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is offset, rotated, and scaled in 3D so that the vertex trio {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2, j3",
  FontSlant->"Italic"],
 "} of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th TGraph will be the position of the {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2, k3",
  FontSlant->"Italic"],
 "} vertex trio of the transformed ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " in both the crease pattern and in 3D. The three points may not be \
collinear in 3D! This form is suitable for assembling subgraphs into \
arbitrary 3D shapes."
}], "Text",
 CellChangeTimes->{{3.649953580651525*^9, 3.649953641719568*^9}, {
   3.6499537386611238`*^9, 3.64995376366775*^9}, {3.6499543776369886`*^9, 
   3.6499543816605062`*^9}, {3.64995450094052*^9, 3.649954513307819*^9}, 
   3.649954557849552*^9, {3.649954606973736*^9, 3.649954610693499*^9}, {
   3.64995486837326*^9, 3.6499549960052834`*^9}, 3.649964097525691*^9, {
   3.707826001706776*^9, 3.707826056180306*^9}, {3.707826131387641*^9, 
   3.7078261324908657`*^9}, 3.707827465769801*^9, {3.70782755783041*^9, 
   3.707827598007201*^9}},ExpressionUUID->"6459ebf5-61fa-4713-8bde-\
bff5184156dd"],

Cell[TextData[{
 "The first {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2, j3",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2, k3",
  FontSlant->"Italic"],
 "}} in ",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 " can be an empty list because it is ignored."
}], "Text",
 CellChangeTimes->{
  3.707826134458828*^9, {3.70782808507487*^9, 
   3.707828092938396*^9}},ExpressionUUID->"9abc6d22-350a-44b3-96b1-\
3ac73de34fca"],

Cell["\<\
JoinGraph3DAssigneds is used to create rotational forms; see \
\[OpenCurlyDoubleQuote]Rotationally Symmetric Pots,\[CloseCurlyDoubleQuote] \
below.\
\>", "Text",
 CellChangeTimes->{{3.649942581803131*^9, 3.649942612761127*^9}, 
   3.707826265225876*^9, {3.707828060708672*^9, 
   3.707828060987359*^9}},ExpressionUUID->"24ce9a83-237d-44df-9f32-\
0dc26203715d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"JoinGraph3DAssigneds", "::", "badspec"}], 
   "=", "\"\<graphspec `1` has mismatched position information.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.707828366918233*^9, 3.707828399158315*^9}},
 CellLabel->
  "In[2014]:=",ExpressionUUID->"e4b3ccc1-3efa-43f0-be23-734d459f31c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JoinGraph3DAssigneds", "[", 
   RowBox[{"graphspecs_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gs", ",", "tglist", ",", "posinfo", ",", "i", ",", "j1", ",", "j2", ",",
       "j3", ",", "k1", ",", "k2", ",", "k3", ",", "vertsj", ",", "vertsk", ",",
       "rm", ",", "offset"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "graphspecs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"Take", "[", 
               RowBox[{
                RowBox[{"#", "\[LeftDoubleBracket]", 
                 RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
                "2"}], "]"}], ",", 
              RowBox[{"Take", "[", 
               RowBox[{
                RowBox[{"#", "\[LeftDoubleBracket]", 
                 RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
                "2"}], "]"}]}], "}"}]}], "}"}], "&"}], "/@", 
         RowBox[{"Drop", "[", 
          RowBox[{"graphspecs", ",", "1"}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tglist", "=", 
      RowBox[{"JoinGraphsData", "[", "gs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Construct", " ", "transformed", " ", "Vertex3D", " ", "coordinates", " ",
        "for", " ", "each", " ", "subgraph"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"posinfo", "=", 
         RowBox[{"graphspecs", "\[LeftDoubleBracket]", 
          RowBox[{"l", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "posinfo", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
             "]"}], "\[NotEqual]", 
           RowBox[{"Length", "[", 
            RowBox[{
            "posinfo", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
             "]"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"JoinGraph3DAssigneds", "::", "badspec"}], ",", 
             RowBox[{"graphspecs", "\[LeftDoubleBracket]", 
              RowBox[{"l", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "posinfo", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
             "]"}], "\[Equal]", "3"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"match", " ", "3", " ", "vertices"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "i", ",", "j1", ",", "j2", ",", "j3", ",", "k1", ",", "k2", ",", 
              "k3"}], "}"}], "=", 
            RowBox[{"Flatten", "[", "posinfo", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"vertsj", "=", 
            RowBox[{
             RowBox[{
             "tglist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
              "[", "Vertices3D", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"vertsk", "=", 
            RowBox[{
             RowBox[{
             "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}],
              "[", "Vertices3D", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rm", ",", "offset"}], "}"}], "=", 
            RowBox[{"SimilarityPair3D", "[", 
             RowBox[{
              RowBox[{"vertsk", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"k1", ",", "k2", ",", "k3"}], "}"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"vertsj", "\[LeftDoubleBracket]", 
               RowBox[{"{", 
                RowBox[{"j1", ",", "j2", ",", "j3"}], "}"}], 
               "\[RightDoubleBracket]"}]}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"match", " ", "2", " ", "vertices"}], ",", " ", 
            RowBox[{
             RowBox[{"so", " ", "do", " ", "it", " ", "in"}], "-", 
             "plane"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", "j1", ",", "j2", ",", "k1", ",", "k2"}], "}"}],
             "=", 
            RowBox[{"Flatten", "[", "posinfo", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"vertsj", "=", 
            RowBox[{
             RowBox[{
             "tglist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
              "[", "Vertices3D", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"vertsk", "=", 
            RowBox[{
             RowBox[{
             "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}],
              "[", "Vertices3D", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"get", " ", "the", " ", "in"}], "-", 
             RowBox[{"plane", " ", "similarity", " ", "transformation"}]}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rm", ",", "offset"}], "}"}], "=", 
            RowBox[{"SimilarityPair2D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Drop", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", 
               RowBox[{"vertsk", "\[LeftDoubleBracket]", 
                RowBox[{"{", 
                 RowBox[{"k1", ",", "k2"}], "}"}], 
                "\[RightDoubleBracket]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Drop", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", 
               RowBox[{"vertsj", "\[LeftDoubleBracket]", 
                RowBox[{"{", 
                 RowBox[{"j1", ",", "j2"}], "}"}], 
                "\[RightDoubleBracket]"}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"convert", " ", "it", " ", "to", " ", "3", "D"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"rm", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Append", "[", 
               RowBox[{
                RowBox[{
                "rm", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                ",", "0"}], "]"}], ",", 
              RowBox[{"Append", "[", 
               RowBox[{
                RowBox[{
                "rm", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                ",", "0"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"offset", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"offset", ",", 
              RowBox[{
               RowBox[{"vertsj", "\[LeftDoubleBracket]", 
                RowBox[{"k1", ",", "3"}], "\[RightDoubleBracket]"}], "-", 
               RowBox[{"vertsk", "\[LeftDoubleBracket]", 
                RowBox[{"k1", ",", "3"}], "\[RightDoubleBracket]"}]}]}], 
             "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vertsk", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"offset", "+", 
             RowBox[{"rm", ".", "#"}]}], ")"}], "&"}], "/@", "vertsk"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"Vertices3D", "\[Rule]", "vertsk"}], "]"}]}]}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MergeGraph3DAssigneds", "[", 
      RowBox[{"tglist", ",", "opts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.649951491309664*^9, 3.649951519996139*^9}, {
