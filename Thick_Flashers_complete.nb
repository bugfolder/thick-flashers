Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixToMatlab", "[", 
   RowBox[{"m_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"of", ",", "br"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"of", "=", 
      RowBox[{
       RowBox[{"MatlabOutputForm", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MatrixToMatlab", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"br", "=", 
      RowBox[{
       RowBox[{"MatlabMatrixByRow", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MatrixToMatlab", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"And", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ListQ", "[", "#", "]"}], "&&", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"Dimensions", "[", "#", "]"}], "]"}], "\[Equal]", 
              "1"}]}], "&"}], "/@", "m"}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MatrixToMatlab", "::", "badmat"}], ",", "m"}], "]"}], ";", 
        
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"StringRiffle", "[", 
           RowBox[{
            RowBox[{"of", "/@", "#"}], ",", "\"\<,\>\""}], "]"}], "&"}], "/@",
          "m"}], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<[\>\"", ",", 
         RowBox[{"If", "[", 
          RowBox[{"br", ",", "\"\<\\n\>\"", ",", "\"\<;\>\""}], "]"}], 
         ",", "\"\<]\>\""}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.706914491781241*^9, 3.70691456409803*^9}, {
