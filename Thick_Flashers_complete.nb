   3.708311622769353*^9, {3.708311656158226*^9, 3.708311658115528*^9}, 
   3.708443386589827*^9, {3.70864837605092*^9, 3.708648419428217*^9}, 
   3.708871521792082*^9, 3.709071888020146*^9, {3.712841221624612*^9, 
