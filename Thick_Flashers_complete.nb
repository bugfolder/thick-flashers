Cell[BoxData[
 RowBox[{
  RowBox[{"AssertProperties", "[", 
   RowBox[{"tobj_TObj", ",", " ", "properties_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "missing", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"missing", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"properties", ",", 
        RowBox[{"GetAllProperties", "[", "tobj", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListEmptyQ", "[", "missing", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"AssertProperties", "::", "missing"}], ",", "tobj", ",", 
          "missing"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.591380163483273*^9, 3.591380240365049*^9}, {
