   3.628786903267581*^9, 
   3.6288636721376457`*^9},ExpressionUUID->"5dec922b-cd82-4013-aed6-\
cfebfacd16c4"],

Cell[TextData[{
 "LocalFaceOrdering",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph+TAssigned and returns a list of directed edges on the \
faces (expressed as ordered face index pairs) that gives the local facet \
ordering that can be inferred from the incidence/adjacency relations of the \
TGraph and the crease directions of the TAssigned. Options are:\n\tFaceupFace\
\[Rule]",
 StyleBox["fuface",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["fuface",
  FontSlant->"Italic"],
 " is the index of a face that is considered to be face-up. Default is 1. If \
you pass a negative value of the index, then that face is assumed to be \
face-down."
}], "Text",
 CellChangeTimes->{{3.484781461011994*^9, 3.4847814680589952`*^9}, {
   3.484781553637553*^9, 3.484781569220851*^9}, {3.484781621456838*^9, 
   3.484781653734926*^9}, {3.484781714738878*^9, 3.484781718978612*^9}, {
   3.484781766647518*^9, 3.484781784086495*^9}, {3.484781836004548*^9, 
   3.484781836523437*^9}, 3.484781900920712*^9, {3.4847829698575687`*^9, 
   3.48478297161655*^9}, {3.484785577012752*^9, 3.484785590588519*^9}, 
   3.484785636620736*^9, 3.484786374441057*^9, {3.485269439136221*^9, 
   3.485269455222189*^9}, {3.485269486225542*^9, 3.485269552277178*^9}, {
   3.485269643893443*^9, 3.485269663468596*^9}, {3.591804505337343*^9, 
   3.591804505792322*^9}, {3.591804657182974*^9, 3.5918046595030513`*^9}, {
   3.59242853755518*^9, 3.59242853908215*^9}, {3.592428791439356*^9, 
   3.5924288314233427`*^9}, 3.592472034184059*^9, {3.592828726999004*^9, 
   3.592828727119821*^9}, 3.592828892633335*^9, 3.592828957058039*^9, {
   3.592859519265449*^9, 3.592859545236183*^9}, {3.627842670760358*^9, 
   3.6278426770638943`*^9}, 3.628786903388268*^9, {3.628863672201436*^9, 
