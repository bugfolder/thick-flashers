Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherR", "::", "usage"}], 
   "=", "\"\<FlasherR is a property of a flasher TObj that specifies the \
number of reversed rings in the flasher.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.719936781358113*^9, 3.719936861796754*^9}, {
  3.825783957220402*^9, 3.825783991360312*^9}},
 CellLabel->
  "In[4180]:=",ExpressionUUID->"139c9e58-55cd-494e-969b-760b2694a7f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherH", "::", "usage"}], 
   "=", "\"\<FlasherH is a property of a flasher TObj that specifies the \
height (i.e., the number of turns it takes for a diagonal to get to the top \
of the flasher).\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.719936781358113*^9, 3.719936861796754*^9}, {
  3.825783957220402*^9, 3.825784028784299*^9}},
 CellLabel->
  "In[4181]:=",ExpressionUUID->"76db7285-eb75-4d50-868b-4403434ea316"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherM", "::", "usage"}], 
   "=", "\"\<FlasherM is a property of a flasher TObj that specifies the \
rotational symmetry of the flasher.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.719936781358113*^9, 3.719936861796754*^9}, {
  3.825783957220402*^9, 3.825783991360312*^9}, {3.825784033920938*^9, 
