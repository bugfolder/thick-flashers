Cell[TextData[{
 "MakeCourteousAnarchyGraph[",
 StyleBox["ngoal",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mindist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["boundary",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] does the same thing but returns a TGraph of the Intersectified lines, \
suitable for feeding to MakeWovenTessellation."
}], "Text",
 CellChangeTimes->{{3.627818116235773*^9, 3.627818134857791*^9}, {
  3.627818862360289*^9, 
  3.627818869848531*^9}},ExpressionUUID->"02c79ef5-11f9-42db-ba90-\
e6c0d1cdc787"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeCourteousAnarchyGraph", "[", 
   RowBox[{"ngoal_", ",", "mindist_", ",", "boundary_List", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"lines", ",", "verts", ",", "edges", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lines", "=", 
      RowBox[{"MakeCourteousAnarchyLines", "[", 
       RowBox[{"ngoal", ",", "mindist", ",", "boundary", ",", "opts"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"lines", ",", "2", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Intersectify", "[", "tobj", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.6278182504938583`*^9, 3.627818337895195*^9}, {
  3.627818588366516*^9, 3.627818588748971*^9}},
 CellLabel->
  "In[3408]:=",ExpressionUUID->"a4b8e677-a255-4bc4-8275-caab78c48c83"],

