Cell[CellGroupData[{

Cell["{UnitCairoPentagonTile, \[Delta]}", "Subsubsection",
 CellChangeTimes->{{3.631101309147657*^9, 3.631101355951819*^9}, {
  3.631101386751283*^9, 3.631101388197524*^9}, {3.631101430219574*^9, 
  3.631101431634777*^9}, {3.63112216160234*^9, 
  3.6311221659749203`*^9}},ExpressionUUID->"9531dc34-b09f-483b-883f-\
a56cfc07fe78"],

Cell["\<\
{UnitCairoPentagonTile, \[Delta]} is a tiletype that specifies a unit \
equilateral pentagon that supports a Cairo tiling, where \[Delta] is the base \
angle of the pentagon.\
\>", "Text",
 CellChangeTimes->{{3.631101442955093*^9, 3.631101495055157*^9}, {
  3.631101530902124*^9, 
  3.631101532211823*^9}},ExpressionUUID->"3468fb51-ad36-4482-b4a1-\
631217d67283"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitCairoPentagonTile", "::", "usage"}], 
   "=", "\"\<UnitCairoPentagonTile is a tile type that produces a unit \
equilateral pentagon that supports a Cairo tiling.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629848065795904*^9, 3.629848099695691*^9}, {
   3.629849741077285*^9, 3.629849755285906*^9}, {3.631101522153964*^9, 
   3.631101547398238*^9}, 3.6311221348267508`*^9},
 CellLabel->
  "In[3279]:=",ExpressionUUID->"76eac066-9c95-499c-b2d5-1f931524102c"],

Cell["\<\
There are two tiles that are mirror-symmetric. They have base angles of \
\[Delta]=90\[Degree] and \[Delta]=CairoSymmetricPentagonBaseAngle (~ 98.7074\
\[Degree])\
\>", "Text",
 CellChangeTimes->{{3.631224600460468*^9, 
  3.631224652912154*^9}},ExpressionUUID->"2009296d-5204-4e1a-aabb-\
2d47dbfb97bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CairoSymmetricPentagonBaseAngle", "/", "\[Degree]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.631224626373507*^9, 3.631224658218175*^9}},
 CellLabel->
  "In[3280]:=",ExpressionUUID->"b6ecbc00-534e-4f00-86b6-822197939fe6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RenderTile[{UnitCairoPentagonTile, \[Delta]}, ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629848058132703*^9, 3.629848060684216*^9}, {
