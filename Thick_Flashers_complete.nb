   3.617314484944568*^9, 3.617314802640039*^9}, {3.617314847238047*^9, 
   3.617314908782483*^9}, {3.61731495116225*^9, 3.617314958207979*^9}, {
   3.617314996174327*^9, 3.617315007376354*^9}, {3.617315069082509*^9, 
