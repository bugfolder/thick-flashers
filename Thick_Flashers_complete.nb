Cell[TextData[{
 "TypesToString[",
 StyleBox["types",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["types",
  FontSlant->"Italic"],
 " of crease assignments and returns a string consisting of all the type \
letters. (This is used to label twists.)"
}], "Text",
 CellChangeTimes->{{3.457997950333484*^9, 3.457998033637101*^9}, {
  3.594726576014153*^9, 
