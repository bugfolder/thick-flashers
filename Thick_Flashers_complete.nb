   RowBox[{"ConcyclicCenterAngles", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"98", "\[Degree]"}], ",", 
      RowBox[{"108", "\[Degree]"}], ",", 
      RowBox[{"118", "\[Degree]"}], ",", 
