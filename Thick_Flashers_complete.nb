Cell[TextData[{
 "Note that you can\[CloseCurlyQuote]t pass v0 and v1 as functions as you can \
with StyledRuledPatch since we\[CloseCurlyQuote]re dividing along ",
 StyleBox["v",
  FontSlant->"Italic"],
 " for the cross rulings."
}], "Text",
