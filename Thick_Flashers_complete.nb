}, Closed]],

Cell[CellGroupData[{

Cell["Fold lines and labeled vertices", "Subsection",
 CellChangeTimes->{{3.719878902864891*^9, 
  3.719878916441631*^9}},ExpressionUUID->"d853d2ee-410e-4a99-bdd3-\
d85d13e5d927"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.719879423841566*^9, 
  3.719879424314015*^9}},ExpressionUUID->"418e951c-34fe-485c-b23e-\
3785a60dd8fa"],

Cell["\<\
This section constructs portions of flashers in 2D (crease pattern, CP) and \
3D (folded form, FF).\
\>", "Text",
 CellChangeTimes->{{3.555954475818254*^9, 3.555954498323057*^9}, {
   3.555956337146302*^9, 3.555956339360248*^9}, 
   3.719943517277972*^9},ExpressionUUID->"b8206d40-7783-4472-b1be-\
79132abeb0bb"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll construct a parameterized representation of the fold \
pattern for a single sector that describes the structure of both the crease \
pattern and the folded form. Three parameters characterize the structure \
topologically: {",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "}, where\n\t ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the number of \[OpenCurlyDoubleQuote]rings\[CloseCurlyDoubleQuote] \
(basically, the number of up-and-down layers), \n\t ",
 StyleBox["h",
  FontSlant->"Italic"],
 " is the height order (the number of basic panels in each up-and-down \
layer), \n\t ",
 StyleBox["m",
  FontSlant->"Italic"],
 " is the rotational symmetry. \nFor sector-specific functions, ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is the rotational index of the particular sector."
}], "Text",
 CellChangeTimes->{{3.555751963968362*^9, 3.555752008678177*^9}, {
   3.555798632514474*^9, 3.555798754120902*^9}, {3.555799346692149*^9, 
   3.5557993577689548`*^9}, {3.555854305396418*^9, 3.555854305490774*^9}, {
   3.55585434396255*^9, 3.55585434405429*^9}, 3.555854407041315*^9, {
   3.71994357103975*^9, 3.719943594614736*^9}, {3.825671557388948*^9, 
   3.825671592758766*^9}, {3.825671656794579*^9, 
   3.82567166953345*^9}},ExpressionUUID->"ce9780e8-1415-423f-a138-\
f7be9b8c80fe"],

Cell[TextData[{
 "For paraboloidal functions,\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " is the focal length of the paraboloid."
}], "Text",
 CellChangeTimes->{{3.82567167376381*^9, 
  3.825671675717601*^9}},ExpressionUUID->"21b84704-7813-4522-b729-\
66658ef505d3"],

Cell["Fold lines are used to extract the isometry lines.", "Text",
 CellChangeTimes->{{3.719918831318593*^9, 3.719918862783457*^9}, {
  3.911857524202898*^9, 
  3.911857525430038*^9}},ExpressionUUID->"88c3a522-a9eb-4ebb-948e-\
0f6615a339f5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherBorderFold\nFlasherSharpFold[",
 StyleBox["f",
  FontSlant->"Italic"],
 "]\nFlasherMedFold[",
 StyleBox["f",
  FontSlant->"Italic"],
 "]\nFlasherLightFold"
}], "Subsubsection",
 CellChangeTimes->{{3.555749686488753*^9, 3.55574968830324*^9}, {
  3.555758369452789*^9, 3.555758372163226*^9}, {3.555758464959719*^9, 
  3.5557584784685583`*^9}, {3.719848932522398*^9, 
  3.719848980051491*^9}},ExpressionUUID->"af13162d-1448-4ebe-b591-\
e7d6ea8fd4e3"],

Cell["\<\
Color-coding for crease types. There are three weights of creases, each of \
which may come in either mountain or valley parity. We'll make functions that \
return the color for each type.\
\>", "Text",
 CellChangeTimes->{{3.555954298310379*^9, 
  3.555954298797683*^9}},ExpressionUUID->"df34a397-a539-40b1-9e13-\
78c32534922d"],

Cell["FlasherBorderFold is the border of the pattern.", "Text",
 CellChangeTimes->{{3.555754275834998*^9, 3.555754283212432*^9}, {
   3.555758364734621*^9, 3.555758365107924*^9}, {3.555954412609301*^9, 
   3.555954412702036*^9}, 
   3.719848932533565*^9},ExpressionUUID->"a744d51b-53a6-46ac-925a-\
af5430719100"],

Cell[BoxData[
 RowBox[{"FlasherBorderFold", ":=", "Black"}]], "Input",
 CellChangeTimes->{{3.555754264064242*^9, 3.555754270162347*^9}, 
   3.555758377465667*^9, 3.7198489324874907`*^9},
 CellLabel->
  "In[4104]:=",ExpressionUUID->"834eb1df-ae7d-4b3d-bdcf-eedfeffc535a"],

Cell[TextData[{
 "FlasherSharpFold[",
 StyleBox["f",
  FontSlant->"Italic"],
 "] is the color for a sharp fold, one that is around 180\[Degree]. The type \
(signified by hue) is set by the parity variable ",
 StyleBox["f",
  FontSlant->"Italic"],
 ": even = valley (red), odd = mountain (blue). Sharp folds are darker than \
the other two flavors."
}], "Text",
 CellChangeTimes->{{3.555749691407651*^9, 3.555749693222949*^9}, {
   3.555954420551435*^9, 3.555954421693747*^9}, 
   3.719848950016255*^9},ExpressionUUID->"8bac23f1-38b9-48c5-b831-\
9765f6eb1aad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherSharpFold", "[", "f_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{"f", ",", "2"}], "]"}], "\[Equal]", "0"}], ",", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0", ",", "0", ",", "1"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555749696818022*^9, 3.555749698850081*^9}, 
   3.719848949949815*^9},
 CellLabel->
  "In[4105]:=",ExpressionUUID->"6d4d0871-068a-4097-8a04-f47ba6311d99"],

Cell[TextData[{
 "FlasherMedFold[",
 StyleBox["p",
  FontSlant->"Italic"],
 "] is the color for a medium fold, one that is around 90\[Degree]. As with \
FlasherSharpFold[], the type (signified by hue) is set by the parity variable \
",
 StyleBox["p",
  FontSlant->"Italic"],
 ". Medium folds are lighter than sharp folds."
}], "Text",
 CellChangeTimes->{{3.555954432574112*^9, 3.555954433637282*^9}, {
  3.719848949962057*^9, 
  3.71984896228555*^9}},ExpressionUUID->"35452419-2ff7-4833-97dc-\
efb9d595e1a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherMedFold", "[", "f_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{"f", ",", "2"}], "]"}], "\[Equal]", "0"}], ",", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"1", ",", ".7", ",", ".7"}], "]"}], ",", 
    RowBox[{"RGBColor", "[", 
     RowBox[{".6", ",", ".6", ",", "1"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555749701288617*^9, 3.555749703385754*^9}, {
   3.555954324070876*^9, 3.555954330206064*^9}, 3.71984896224149*^9},
 CellLabel->
  "In[4106]:=",ExpressionUUID->"e1782b33-e65e-4c28-9efe-83d63d249600"],

Cell["\<\
FlasherLightFold is the color for a light fold, one that is around 0\[Degree] \
(a slight bend). Since the direction of a light fold is not generally known, \
we do not give it a type and we use light gray for the color.\
\>", "Text",
 CellChangeTimes->{{3.55595444098914*^9, 3.555954451076268*^9}, 
   3.719848980062467*^9},ExpressionUUID->"ce08bab7-6c42-4125-815c-\
b50091f0e62b"],

Cell[BoxData[
 RowBox[{"FlasherLightFold", " ", ":=", " ", 
  RowBox[{"GrayLevel", "[", ".85", "]"}]}]], "Input",
 CellChangeTimes->{3.719848980005087*^9},
 CellLabel->
  "In[4107]:=",ExpressionUUID->"d22fa660-addf-4a92-99c0-cd60859070d9"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherVertexLabel[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "13c65fdf-82f5-4cad-aa49-4989cf147b8d"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.555758524361294*^9, 3.555758541256321*^9}, {
   3.5557589479982*^9, 3.555758955341433*^9}, {3.555759905367029*^9, 
   3.555759905643087*^9}, {3.555956283852733*^9, 3.55595631171741*^9}, {
   3.555956403335479*^9, 3.555956432422386*^9}, {3.719848861061886*^9, 
   3.719848861062504*^9}, 3.7198490917311163`*^9, 3.7198491438215113`*^9, 
   3.719850453575667*^9, 3.719850658278862*^9, {3.719850816256719*^9, 
   3.719850824384582*^9}, 3.719853417010936*^9, {3.719853533282037*^9, 
   3.719853533309916*^9}, 3.719856392161834*^9, 3.719879064812713*^9, {
   3.719879227742058*^9, 3.7198792611082883`*^9}, {3.719879406373743*^9, 
   3.719879411028216*^9}, 3.719944472235669*^9, {3.911858574222054*^9, 
   3.911858582897533*^9}, 3.911858623953912*^9, 
   3.911858794569625*^9},ExpressionUUID->"9b76681b-eb75-4d9f-9e57-\
155cbcde6746"],

Cell[TextData[{
 "FlasherVertexLabel[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "7d382cd3-8b48-4ecb-a4fc-482ead9268fd"],
 "] takes a subscripted point and returns a label at its position, using \
character ",
 StyleBox["u",
  FontSlant->"Italic"],
 ". Note that the subscripts are given exactly as passed, but we apply index \
wrap-around to the position vector."
}], "Text",
 CellChangeTimes->{{3.555758551879572*^9, 3.5557585946609993`*^9}, {
   3.555758648465425*^9, 3.55575866099341*^9}, 3.719848860999813*^9, {
   3.719879176275717*^9, 3.719879190425721*^9}, 3.719879227181245*^9, {
   3.719879287537504*^9, 
   3.719879316290175*^9}},ExpressionUUID->"f921a663-8fd2-4232-8acf-\
9281a14d7040"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherVertexLabel", "[", 
   RowBox[{"u_", ",", 
    SubscriptBox["v_", 
     RowBox[{"i_", ",", "j_", ",", "k_"}]]}], "]"}], ":=", 
  RowBox[{"Text", "[", 
   RowBox[{
    SubscriptBox[
     RowBox[{"Style", "[", 
      RowBox[{"u", ",", "Bold"}], "]"}], 
     RowBox[{"i", ",", "j", ",", "k"}]], ",", 
    RowBox[{
     SubscriptBox["v", 
      RowBox[{"i", ",", "j", ",", "k"}]], "/.", 
     RowBox[{"FlasherWrapRules", "[", "v", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555758599640738*^9, 3.5557586455090027`*^9}, {
   3.564316908315996*^9, 3.564316914138399*^9}, {3.564317009661351*^9, 
   3.564317038825954*^9}, 3.564324905396448*^9, {3.719848861005693*^9, 
   3.719848870634247*^9}, 3.719879227195176*^9, {3.7198792745136538`*^9, 
   3.719879280338369*^9}, {3.719879323947393*^9, 3.7198793316275473`*^9}},
 CellLabel->
  "In[4108]:=",ExpressionUUID->"75933a25-ce2e-4256-b1c7-7206e2a00145"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.719943626053959*^9, 3.719943627630396*^9}, 
   3.825671241013037*^9},ExpressionUUID->"38388bc4-ffcc-4a77-8fd5-\
9885a8f88850"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "p", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FlasherVertexLabel", "[", 
     RowBox[{"\"\<p\>\"", ",", 
      SubscriptBox["p", 
       RowBox[{"0", ",", "0", ",", "0"}]]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.719943629441073*^9, 3.719943660702574*^9}, {
  3.719946080521709*^9, 3.71994608725506*^9}, {3.825671718177293*^9, 
  3.825671720786366*^9}},
 CellLabel->
  "In[4109]:=",ExpressionUUID->"fa707ee8-d746-4ff7-b622-f318e657e92c"],

Cell["Example, showing wrap-around.", "Text",
 CellChangeTimes->{{3.719943626053959*^9, 3.719943627630396*^9}, {
  3.719943663518525*^9, 
  3.719943666909609*^9}},ExpressionUUID->"604744bf-65dd-46f1-8f25-\
a8743ba504d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "p", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"FlasherVertexLabel", "[", 
     RowBox[{"\"\<p\>\"", ",", 
      SubscriptBox["p", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "2", ",", "4"}]]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.719943629441073*^9, 3.719943644566307*^9}, {
  3.719943676319706*^9, 3.719943678446556*^9}, {3.719946093608508*^9, 
  3.719946098528409*^9}, {3.825671724117083*^9, 3.825671726929202*^9}, {
  3.82567230017096*^9, 3.825672304490011*^9}},
 CellLabel->
  "In[4110]:=",ExpressionUUID->"c474b080-a983-4cee-a545-25ffa9d2aec3"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherFirstSectorAllPossibleVerticesLabels[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.911858801070603*^9, 
  3.91185883209074*^9}},ExpressionUUID->"415681e8-3c02-4ac5-bfc0-\
f13bc5bcbee3"],

Cell[TextData[{
 "FlasherFirstSectorAllPossibleVerticesLabels[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns a set of labels for all points in the first (",
 StyleBox["k",
  FontSlant->"Italic"],
 "=0) sector up to the ",
 StyleBox["n",
  FontSlant->"Italic"],
 "th ring, using ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "7c6bc187-80c4-44cf-9294-56a0566da905"],
 " (where u is a string) to represent point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", 
     RowBox[{"i", ",", "j", ",", "k"}]], "."}], TraditionalForm]],
  ExpressionUUID->"1b45b990-4da3-42f1-9e38-84969715c152"]
}], "Text",
 CellChangeTimes->{{3.555758807714596*^9, 3.555758836021223*^9}, 
   3.555759922470333*^9, 3.555956432471549*^9, 3.719849091656046*^9, {
   3.719878932153125*^9, 3.71987898917941*^9}, 3.719944472252015*^9, 
   3.911858623993228*^9, 
   3.911858832132306*^9},ExpressionUUID->"cd5d2d6c-3e39-462a-accf-\
1ced1a4b7ee5"],

Cell[TextData[{
 "Note that this displays all possible vertices, even those that fall in the \
middle of a panel line (which is the case for ",
 StyleBox["h",
  FontSlant->"Italic"],
 "\[GreaterEqual]2)."
}], "Text",
 CellChangeTimes->{{3.7199444860961113`*^9, 
  3.719944527534706*^9}},ExpressionUUID->"60d7caa1-f560-4721-b1e6-\
fc303b7a4146"],

Cell["\<\
This is not used very often. Most of the time we can apply FlasherVertexLabel \
to one of the lists of vertices below.\
\>", "Text",
 CellChangeTimes->{{3.911858896661105*^9, 
  3.911858988083014*^9}},ExpressionUUID->"3440ed7a-5088-4d92-a3ed-\
a141876a4042"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherFirstSectorAllPossibleVerticesLabels", "[", 
   RowBox[{"u_", ",", "v_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Style", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"FlasherVertexLabel", "[", 
       RowBox[{"u", ",", 
        SubscriptBox["v", 
         RowBox[{"i", ",", "j", ",", "0"}]]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"-", "1"}], ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "n"}], "}"}]}], "]"}], ",", "Black"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5557587035266323`*^9, 3.555758805162476*^9}, 
   3.5557588960770903`*^9, 3.555759911359599*^9, 3.555956432490443*^9, 
   3.71984886101046*^9, 3.7198490916620417`*^9, {3.719878928114731*^9, 
   3.719878928906181*^9}, 3.719878998876861*^9, {3.7198790439897*^9, 
   3.719879052043496*^9}, {3.7198791150895777`*^9, 3.71987913270647*^9}, {
   3.719879349069564*^9, 3.71987936919366*^9}, 3.719944472260474*^9, 
   3.91185862401084*^9, 3.91185883214983*^9},
 CellLabel->
  "In[4111]:=",ExpressionUUID->"123fa4b0-7a5c-47c0-a7a3-c4023b0313d9"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.555750956230774*^9, 3.555750957034926*^9}, 
