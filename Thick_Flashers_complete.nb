Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "um", ",", "u0", ",", "u1", ",", "b1", ",", "d1", ",", "bb1", ",", "dd1",
       ",", "b2i", ",", "bb2i", ",", "b2", ",", "d2", ",", "bb2", ",", "dd2", 
      ",", "f", ",", "ff", ",", "s"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[Pi]"}], "/", "3"}], ",", "\[Pi]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "#"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"-", "1"}]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b2i", "=", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
