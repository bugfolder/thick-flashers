   3.799918360497425*^9},ExpressionUUID->"17735f7e-4e58-48e0-9632-\
4a7340badd57"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["sys",
  FontSlant->"Italic"],
 " \[LongDash] the set of rules returned from Curve3DSystem.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the desired plot range."
}], "Text",
 CellChangeTimes->{{3.7995199975645847`*^9, 
  3.799520024101035*^9}},ExpressionUUID->"a894f7da-6421-4b62-9503-\
bc0f6ce2e91d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Curve3DSystemPlots", "[", 
   RowBox[{"sys_List", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "t", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Curve3D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<Curve3D\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Speed3D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<Speed3D\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Curvature3D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<Curvature3D\>\""}]}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Torsion3D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<Torsion3D\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"TangentVector3D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<TangentVector3D\>\""}]}], "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NormalVector3D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<NormalVector3D\>\""}]}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"BinormalVector3D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<BinormalVector3D\>\""}]}], 
       "]"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.691197387539918*^9, 3.691197446083116*^9}, 
   3.691199515991446*^9, {3.691199785521703*^9, 3.691199838433719*^9}, {
   3.691199874997556*^9, 3.691199880618965*^9}, {3.691199929292095*^9, 
   3.691199929652487*^9}, 3.691252690697042*^9, 3.69125273372284*^9, 
   3.6915053622822*^9, {3.799518867000227*^9, 3.799518887329589*^9}, {
   3.799523095266946*^9, 3.799523107203609*^9}, 3.7999183605128736`*^9},
 CellLabel->
  "In[3662]:=",ExpressionUUID->"58280b31-3af5-4f53-855d-4eaaa6c2c586"],

Cell["Example. A helix.", "Text",
 CellChangeTimes->{{3.691197462986072*^9, 3.691197472516904*^9}, {
  3.6911998532770977`*^9, 
  3.691199854416183*^9}},ExpressionUUID->"6d457131-d83a-4d21-ad0c-\
97b7227b1cc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pcs", ",", "u0", ",", "u1", ",", "plots"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pcs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Curve3D", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "#1", "]"}], ",", 
             RowBox[{"Sin", "[", "#1", "]"}], ",", 
             FractionBox["#1", "2"]}], "}"}], "&"}], ")"}]}], ",", 
        RowBox[{"Speed3D", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            SqrtBox["5"], "2"], "&"}], ")"}]}], ",", 
        RowBox[{"Curvature3D", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["4", "5"], "&"}], ")"}]}], ",", 
        RowBox[{"Torsion3D", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["2", "5"], "&"}], ")"}]}], ",", 
        RowBox[{"TangentVector3D", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              FractionBox[
               RowBox[{"2", " ", 
                RowBox[{"Sin", "[", "#1", "]"}]}], 
               SqrtBox["5"]]}], ",", 
             FractionBox[
              RowBox[{"2", " ", 
               RowBox[{"Cos", "[", "#1", "]"}]}], 
              SqrtBox["5"]], ",", 
             FractionBox["1", 
              SqrtBox["5"]]}], "}"}], "&"}], ")"}]}], ",", 
        RowBox[{"BinormalVector3D", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             FractionBox[
              RowBox[{"Sin", "[", "#1", "]"}], 
              SqrtBox["5"]], ",", 
             RowBox[{"-", 
              FractionBox[
               RowBox[{"Cos", "[", "#1", "]"}], 
               SqrtBox["5"]]}], ",", 
             FractionBox["2", 
              SqrtBox["5"]]}], "}"}], "&"}], ")"}]}], ",", 
        RowBox[{"NormalVector3D", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Cos", "[", "#1", "]"}]}], ",", 
             RowBox[{"-", 
              RowBox[{"Sin", "[", "#1", "]"}]}], ",", "0"}], "}"}], "&"}], 
          ")"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1.9", "\[Pi]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"plots", "=", 
      RowBox[{"Curve3DSystemPlots", "[", 
       RowBox[{"pcs", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PartitionedGraphicsGrid", "[", 
      RowBox[{"plots", ",", "4"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.691197473996893*^9, 3.691197600260702*^9}, 
   3.691199516022324*^9, {3.691199785604259*^9, 3.691199785612285*^9}, {
