Cell["\<\
Example. Four concentric circles. We\[CloseCurlyQuote]ll quiet the \
extrapolation warnings that arise due to numerical round-off issues at the \
endpoints and we\[CloseCurlyQuote]ll precompute the Curve2DSystems for the \
fold lines, and since they\[CloseCurlyQuote]re simple analytic functions, we\
\[CloseCurlyQuote]ll do that calculation analytically.\
\>", "Text",
 CellChangeTimes->{{3.804524322626646*^9, 3.8045243354839377`*^9}, {
  3.804527714476867*^9, 3.804527718732233*^9}, {3.804527916701171*^9, 
  3.8045279415490236`*^9}, {3.804528829780526*^9, 3.804528849444825*^9}, {
  3.804536763333063*^9, 
  3.804536763692732*^9}},ExpressionUUID->"3ae44106-bf8d-4b67-8b5e-\
0449c907fa3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "w", ",", "e", ",", "u0", ",", "u1", ",", "s", ",", "tf", ",", "q", ",", 
      "\[Gamma]", ",", "f", ",", "cs", ",", "ff", ",", "tt", ",", "ll", ",", 
      "uu", ",", "flist", ",", "fflist", ",", "gc", ",", "gf"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tf", "[", "i_", "]"}], ":=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"i", " ", "w"}]}], ")"}], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "s", "]"}], ",", 
           RowBox[{"Sin", "[", "s", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "i_", "]"}], ":=", 
