Cell[CellGroupData[{

Cell[TextData[{
 "Degree4Vertex3DGaussianSphereGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TDegree4Vertex3D\n\t(options) ShowOsculatingVector, \
ShowRulingVector, ShowTangentVector, ShowOsculatingPlane, ShowRulingPlane, \
ShowTangentPlane, ShowRulingGreatCircles, \
Options[Vertex3DGaussianSphereGraphics3D], Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{
  3.594820882416817*^9, 3.594820939199877*^9, {3.594821142281982*^9, 
   3.594821158127687*^9}, 3.594823909078941*^9, {3.615298837602303*^9, 
   3.615298862312998*^9}},ExpressionUUID->"c1439d7b-02a7-4717-801e-\
f17f7640909b"],

Cell[TextData[{
 "Degree4Vertex3DGaussianSphereGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TDegree4Vertex3D and returns a Graphics3D rendering of the \
Gaussian sphere. Options are:\n\tShowOsculatingVector\[Rule]True | False, \
specifies whether to show the osculating normal on the Gaussian sphere.\n\t\
ShowRulingVector\[Rule]True | False, specifies whether to show the normal \
plane\[CloseCurlyQuote]s normal vector on the Gaussian sphere.\n\t\
ShowTangentVector\[Rule]True | False, specifies whether to show the tangent \
vector.\n\tShowOsculatingPlane\[Rule]True | False, specifies whether to add a \
representation of the osculating plane (which contains the two major creases) \
to the vertex.\n\tShowRulingPlane\[Rule]True | False, specifies whether to \
add a representation of the ruling plane (which contains the two minor \
creases) to the vertex.\n\tShowTangentPlane\[Rule]True | False, specifies \
whether to show the tangent plane to the vertex.\n\tShowRulingGreatCircles\
\[Rule]True | False, specifies whether to draw the great circles whose \
intersection defines the normal of the ruling plane.\n\t\
Options[Vertex3DGaussianSphereGraphics3D] are passed through.\n\t\
Options[Graphics3D] are passed through."
}], "Text",
 CellChangeTimes->{{3.594820923778823*^9, 3.594820976055009*^9}, {
  3.594821329055019*^9, 3.594821382681349*^9}, {3.594821787760645*^9, 
  3.594821796273952*^9}, {3.594823892074551*^9, 
  3.594823923269763*^9}},ExpressionUUID->"a688c18b-bcde-45bb-ab5d-\
2230b32cb391"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowRulingGreatCircles", "::", "usage"}], 
   "=", "\"\<ShowRulingGreatCircles is an option to \
Degree4Vertex3DGaussianSphereGraphics3D that specifies whether to show the \
great circles whose intersection defines the normal to the ruling plane on \
the Gaussian sphere.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592079868604634*^9, 3.592079893324048*^9}, {
   3.592079924539099*^9, 3.5920799261876307`*^9}, 3.592080022060769*^9, 
