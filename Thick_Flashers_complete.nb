Cell[TextData[{
 "RigidlyFoldableSingleVertexQuadMesh[{\[Phi]b, \[Gamma]b}, {\[Phi]l, \
\[Gamma]l}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a rigidly foldable single vertex from a specification of fold \
direction and fold angle along the bottom and left side."
}], "Text",
