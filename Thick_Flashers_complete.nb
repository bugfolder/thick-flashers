           RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}], ",", 
        RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
        RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Show", "[", 
            RowBox[{"gg", ",", 
             RowBox[{"Graphics3D", "[", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"StyledFrenetTrihedron", "[", 
                 RowBox[{
                  RowBox[{"ff", "[", "t0", "]"}], ",", 
                  RowBox[{"tt", "[", "t0", "]"}], ",", 
                  RowBox[{"nn", "[", "t0", "]"}], ",", 
                  RowBox[{"bb", "[", "t0", "]"}], ",", 
                  RowBox[{"FrenetVectorLength", "\[Rule]", "dr"}]}], "]"}], ",",
                 "\[IndentingNewLine]", 
                RowBox[{"{", "}"}]}], "}"}], "]"}], ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Frenet frame\>\""}]}], 
            "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Show", "[", 
            RowBox[{"gg", ",", 
             RowBox[{"Graphics3D", "[", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"StyledDarbouxTrihedron", "[", 
                 RowBox[{
                  RowBox[{"ff", "[", "t0", "]"}], ",", 
                  RowBox[{"tt", "[", "t0", "]"}], ",", 
                  RowBox[{"ll", "[", "t0", "]"}], ",", 
                  RowBox[{"uu", "[", "t0", "]"}], ",", 
                  RowBox[{"DarbouxVectorLength", "\[Rule]", "dr"}]}], "]"}], ",",
                 "\[IndentingNewLine]", 
                RowBox[{"{", "}"}]}], "}"}], "]"}], ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Darboux frame\>\""}]}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], "/.", 
       "CurveVectorStyle"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
