  3.676469239498882*^9}},ExpressionUUID->"e2b6326a-9a74-410a-94ca-\
c66c157c8ec4"],

Cell["\<\
Including a nonzero IntersectionTolerance may be necessary if you have \
T-intersections, since numerical roundoff could shift the crossbar of the T \
slightly away from the riser and you\[CloseCurlyQuote]d miss that \
intersection.\
\>", "Text",
 CellChangeTimes->{{3.676469264921082*^9, 3.676469294879246*^9}, {
  3.676469329188952*^9, 
  3.676469345131433*^9}},ExpressionUUID->"2ac732b4-a59e-4d48-9298-\
7c30f5d49f02"],

Cell["EmbeddedintersectifyOld is pre-2.7 version, now obsolete.", "Text",
 CellChangeTimes->{{3.676471690081272*^9, 
  3.676471705030745*^9}},ExpressionUUID->"7190e5d4-81cb-4d01-a076-\
24f80848076d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbeddedIntersectifyOld", "[", 
   RowBox[{"verts_List", ",", " ", "edges_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"emedges", ",", "intfn", ",", "accum", ",", "newpts"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"emedges", "=", 
      RowBox[{"Embed", "[", 
       RowBox[{"verts", ",", "edges", ",", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"intfn", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1_", ",", "q2_"}], "}"}]}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"detd", ",", "tp", ",", "tq"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"detd", "=", 
          RowBox[{"Det", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"p2", "-", "p1"}], ",", 
             RowBox[{"q2", "-", "q1"}]}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Chop", "[", 
             RowBox[{"Abs", "[", "detd", "]"}], "]"}], "\[Equal]", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"tp", "=", 
             RowBox[{
              RowBox[{"Det", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"q1", "-", "p1"}], ",", 
                 RowBox[{"q2", "-", "q1"}]}], "}"}], "]"}], "/", "detd"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"tq", "=", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Det", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"p1", "-", "q1"}], ",", 
                  RowBox[{"p2", "-", "p1"}]}], "}"}], "]"}]}], "/", 
              "detd"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"tp", ",", "tq", ",", 
              RowBox[{"p1", "+", 
               RowBox[{"tp", 
                RowBox[{"(", 
                 RowBox[{"p2", "-", "p1"}], ")"}]}]}]}], "}"}]}]}], "]"}]}]}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"accum", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"newpts", "=", 
         RowBox[{"Join", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"emedges", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], 
            "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", 
              RowBox[{"emedges", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}], 
            "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"intfn", "[", 
              RowBox[{
               RowBox[{
               "emedges", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], ",", "#"}], "]"}], "&"}], "/@", 
            RowBox[{"Drop", "[", 
             RowBox[{"emedges", ",", 
              RowBox[{"{", "i", "}"}]}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"newpts", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"newpts", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[GreaterEqual]", 
              RowBox[{"-", "0.01"}]}], "&&", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LessEqual]",
               "1.01"}], "&&", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[GreaterEqual]", 
              RowBox[{"-", "0.01"}]}], "&&", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[LessEqual]",
               "1.01"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newpts", "=", 
         RowBox[{"Union", "[", 
          RowBox[{"newpts", ",", 
           RowBox[{"SameTest", "\[Rule]", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"SamePtQ", "[", 
               RowBox[{
                RowBox[{
                "#1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
                ",", 
                RowBox[{
                "#2", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
                ",", "opts"}], "]"}], "&"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"newpts", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"newpts", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "<", 
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
            "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newpts", "=", 
         RowBox[{"Last", "/@", "newpts"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"JoinTo", "[", 
         RowBox[{"accum", ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "i"}], "}"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Drop", "[", 
               RowBox[{"newpts", ",", 
                RowBox[{"-", "1"}]}], "]"}], ",", 
              RowBox[{"Drop", "[", 
               RowBox[{"newpts", ",", "1"}], "]"}]}], "}"}]}], "]"}]}], "]"}],
         ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", "accum", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.462814035687296*^9, 3.462814049304615*^9}, {
   3.4628141141842527`*^9, 3.462814120375095*^9}, {3.462833188393023*^9, 
   3.462833532502612*^9}, {3.462833574557254*^9, 3.462833639001878*^9}, {
   3.4628337856662073`*^9, 3.4628338305583897`*^9}, {3.462833867197804*^9, 
   3.462833927798047*^9}, 3.462833970060639*^9, {3.462834008758484*^9, 
   3.462834063822287*^9}, 3.462847410698962*^9, {3.462847465902348*^9, 
   3.462847496768951*^9}, {3.462847561351924*^9, 3.4628475955020113`*^9}, 
   3.462847645344796*^9, {3.462847726993155*^9, 3.462847742767037*^9}, {
   3.462847809095396*^9, 3.462847825299028*^9}, {3.4628478843329153`*^9, 
   3.462847890081089*^9}, {3.462848041569846*^9, 3.462848202847126*^9}, {
   3.462848234256283*^9, 3.462848407943578*^9}, 3.462848446901691*^9, {
   3.4628484856855*^9, 3.462848807439784*^9}, {3.4628993717870407`*^9, 
   3.462899393799014*^9}, {3.462928077265877*^9, 3.462928129274531*^9}, {
   3.462928192183054*^9, 3.462928233172214*^9}, {3.462928275261896*^9, 
   3.462928302976666*^9}, {3.462965628315235*^9, 3.462965915061028*^9}, 
   3.627328592811836*^9, 3.627328639036392*^9, {3.676398412926853*^9, 
   3.676398435687851*^9}, {3.676398500230898*^9, 3.6763986025906153`*^9}, {
   3.67639870926327*^9, 3.676398716311336*^9}, {3.676398755052365*^9, 
   3.676398798736734*^9}, 3.676399890452831*^9, {3.676400057731304*^9, 
   3.676400143028954*^9}, {3.6764001912461*^9, 3.676400197969709*^9}, {
   3.676400231398603*^9, 3.67640027510863*^9}, {3.676400470159603*^9, 
   3.676400636235323*^9}, {3.6764006710518003`*^9, 3.6764007193613358`*^9}, 
   3.676400756839115*^9, {3.676400826130093*^9, 3.676400857305266*^9}, {
   3.676400894935798*^9, 3.676400897512679*^9}, {3.676400954715672*^9, 
