Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonTwistCentralPolygonAngles", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "v", ",", "p", ",", "q", ",", "r"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", 
       RowBox[{
        RowBox[{"tobj", "[", "Faces", "]"}], "\[LeftDoubleBracket]", "1", 
        "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"tobj", "[", "Vertices", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "q", ",", "r"}], "}"}], "=", 
         RowBox[{"v", "\[LeftDoubleBracket]", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"4", "i"}], "+", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "4"}], ",", "0", ",", "4"}], "}"}]}], ",", 
            RowBox[{"Length", "[", "v", "]"}], ",", "1"}], "]"}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Pi]", "-", 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", "-", "q"}], ")"}], ".", 
            RowBox[{"(", 
             RowBox[{"q", "-", "p"}], ")"}]}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", "-", "q"}], ")"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"RotationMatrix2D", "[", 
               FractionBox["\[Pi]", "2"], "]"}], ".", 
              RowBox[{"(", 
               RowBox[{"q", "-", "p"}], ")"}]}], ")"}]}]}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
