Cell[TextData[{
 "ClipSegmentToConvexPolygon",
 "[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] takes the segment {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} and returns a segment {",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2a",
  FontSlant->"Italic"],
 "} that lies wholly within the convex polygon ",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", which is given as a list of vertices. If the original segment lies wholly \
outside of the polygon, its length is set to zero."
}], "Text",
 CellChangeTimes->{{3.462923525309966*^9, 3.4629235368746347`*^9}, 
   3.462926538204567*^9},ExpressionUUID->"d5c5862c-d175-41f9-ad86-\
4b592dcece02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentToConvexPolygon", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", "poly_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"cn", "=", 
       RowBox[{
        RowBox[{"Plus", "@@", "poly"}], "/", 
        RowBox[{"Length", "[", "poly", "]"}]}]}], ",", "tl"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tl", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"poly", ",", 
         RowBox[{"RotateLeft", "[", "poly", "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{"cn", ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "poly", "]"}], "}"}]}], "]"}]}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Fold", "[", 
      RowBox[{"ClipSegmentToHalfPlane", ",", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2"}], "}"}], ",", "tl"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.462926506957477*^9, 3.46292653823594*^9}, {
   3.466794326610835*^9, 3.466794372609395*^9}, 3.466797916835932*^9},
 CellLabel->
  "In[532]:=",ExpressionUUID->"33bf8b02-91cc-4f3e-b272-3dd09fbafd00"],

Cell["Example", "Text",ExpressionUUID->"01a0b00d-b234-4d76-ab0f-f3a702ae9e97"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"poly", ",", "segments"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"poly", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"segments", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", ".2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", 
              RowBox[{"-", ".2"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "0"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", ".25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", ".25"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", ".5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{".3", ",", ".5"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{".7", ",", ".5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", ".5"}], "}"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}], ",", 
              RowBox[{"2.5", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", "40", "}"}]}], "]"}], ",", "2"}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"LightGray", ",", 
        RowBox[{"Polygon", "[", "poly", "]"}], ",", "Gray", ",", 
        RowBox[{"Line", "/@", "segments"}], ",", "Red", ",", 
        RowBox[{"Thickness", "[", ".01", "]"}], ",", 
        RowBox[{"Line", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ClipSegmentToConvexPolygon", "[", 
             RowBox[{"#", ",", "poly"}], "]"}], "&"}], "/@", "segments"}], 
          ")"}]}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462923192673673*^9, 3.462923194125084*^9}, {
   3.462923569326766*^9, 3.462923618175355*^9}, 3.462926538471352*^9, {
   3.462926571888483*^9, 3.462926593231887*^9}, 3.484770658254258*^9, 
   3.484770706044407*^9, 3.484770748567298*^9, 3.484770787094734*^9},
 CellLabel->
  "In[533]:=",ExpressionUUID->"f5aaae92-9a38-40ca-8f87-e36ce9b1d679"],

Cell[TextData[{
 "ClipSegmentToSegmentExterior[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}] takes the segment {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} and returns a segment {",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2a",
  FontSlant->"Italic"],
 "} that has been clipped by the segment {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} so that it lies in the same half-plane as ",
 StyleBox["p3.",
  FontSlant->"Italic"],
 " Clipping only occurs if the two segments intersect anywhere (including \
endpoints)."
}], "Text",
 CellChangeTimes->{{3.4629236218611794`*^9, 
  3.462923633971773*^9}},ExpressionUUID->"7a54d547-0743-4081-9983-\
9f02a83e3260"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentToSegmentExterior", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Rotate90", "[", 
        RowBox[{"q2", "-", "q1"}], "]"}]}], ",", "tp", ",", "tq", ",", 
      "q12"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"r", ".", 
         RowBox[{"(", 
          RowBox[{"p2", "-", "p1"}], ")"}]}], "\[Equal]", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tq", "=", " ", 
      FractionBox[
       RowBox[{"Det", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p1", "-", "q1"}], ",", 
          RowBox[{"p2", "-", "p1"}]}], "}"}], "]"}], 
       RowBox[{"Det", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q2", "-", "q1"}], ",", 
          RowBox[{"p2", "-", "p1"}]}], "}"}], "]"}]]}], ";", 
     RowBox[{"tp", "=", " ", 
      FractionBox[
       RowBox[{"Det", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q1", "-", "p1"}], ",", 
          RowBox[{"q2", "-", "q1"}]}], "}"}], "]"}], 
       RowBox[{"Det", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p2", "-", "p1"}], ",", 
          RowBox[{"q2", "-", "q1"}]}], "}"}], "]"}]]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"tp", "\[LessEqual]", "0"}], "||", 
        RowBox[{"tp", "\[GreaterEqual]", "1"}], "||", 
        RowBox[{"tq", "\[LessEqual]", "0"}], "||", 
        RowBox[{"tq", "\[GreaterEqual]", "1"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"tq", "\[Equal]", "0"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PtInHalfPlaneQ", "[", 
          RowBox[{"q2", ",", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q1"}], "}"}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2"}], "}"}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"tq", "\[Equal]", "1"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PtInHalfPlaneQ", "[", 
          RowBox[{"q1", ",", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"q2", ",", "q2"}], "}"}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2"}], "}"}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q12", "=", 
      RowBox[{"q1", "+", 
       RowBox[{"tq", 
        RowBox[{"(", 
         RowBox[{"q2", "-", "q1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PtInHalfPlaneQ", "[", 
        RowBox[{"q2", ",", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q12", ",", "q2"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.462923785578532*^9},
 CellLabel->
  "In[534]:=",ExpressionUUID->"e3c71130-82f7-4577-a2a1-e5cf824dab3a"],

Cell["Example", "Text",ExpressionUUID->"3f10256d-ff25-4ab1-81c1-0249124bbdab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"halfplane", ",", "segments"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"halfplane", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", ".5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"segments", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", ".25"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", 
              RowBox[{"-", ".25"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", ".25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", ".25"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}], ",", 
              RowBox[{"1", "-", 
               RowBox[{"2", 
                RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", "40", "}"}]}], "]"}], ",", "2"}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Green", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"halfplane", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], "]"}], ",", 
        RowBox[{"PointSize", "[", ".05", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{
         "halfplane", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
         "]"}], ",", "Gray", ",", 
        RowBox[{"Line", "/@", "segments"}], ",", "Red", ",", 
        RowBox[{"Thickness", "[", ".01", "]"}], ",", 
        RowBox[{"Line", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ClipSegmentToSegmentExterior", "[", 
             RowBox[{"#", ",", "halfplane"}], "]"}], "&"}], "/@", 
           "segments"}], ")"}]}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462923121666172*^9, 3.462923124010919*^9}, {
   3.462923195059527*^9, 3.46292319670314*^9}, {3.46292365922971*^9, 
   3.46292373675263*^9}, 3.484770658390337*^9, 3.484770787215875*^9},
 CellLabel->
  "In[535]:=",ExpressionUUID->"4e276deb-9216-4668-99fa-3459707035d8"],

Cell[TextData[{
 "ClipSegmentToConvexPolygonExterior[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] takes the segment {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} and returns a segment {",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2a",
  FontSlant->"Italic"],
 "} that lies outside of the polygon ",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", which is given as a list of vertices. Note, however, that if the segment \
straddles the polygon so that the polygon would break it into two pieces, \
only one piece is returned. To properly handle such cases, you should use \
interval sets and segment sets, as defined in the next sections of \
functions."
}], "Text",
 CellChangeTimes->{{3.462923741085258*^9, 3.462923748932455*^9}, 
   3.462926538732686*^9, {3.484755091032178*^9, 3.484755173281912*^9}, {
   3.484755204447598*^9, 
   3.484755231133977*^9}},ExpressionUUID->"04e3069a-067b-42c3-a51a-\
e828d3adeed3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentToConvexPolygonExterior", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", "poly_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ctrd", "=", 
       RowBox[{
        RowBox[{"Plus", "@@", "poly"}], "/", 
        RowBox[{"Length", "[", "poly", "]"}]}]}], ",", "pedges"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pedges", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"poly", ",", 
         RowBox[{"RotateLeft", "[", "poly", "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{"ctrd", ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "poly", "]"}], "}"}]}], "]"}]}], "}"}], 
       "]"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"Fold", "[", 
      RowBox[{"ClipSegmentToSegmentExterior", ",", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2"}], "}"}], ",", "pedges"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.462923771949007*^9, 3.462923777589717*^9}, 
   3.462926538739603*^9},
 CellLabel->
  "In[536]:=",ExpressionUUID->"26ca10e0-78a2-4214-a4dc-0d88f624c573"],

Cell["\<\
Example. You will see what happens when the segment straddles the polygon.\
\>", "Text",
 CellChangeTimes->{{3.484755154099229*^9, 
  3.484755167586141*^9}},ExpressionUUID->"4fe01e4b-aadb-4c97-8545-\
b255631aaf50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"poly", ",", "segments"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"poly", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"segments", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", ".2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", 
              RowBox[{"-", ".2"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "0"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", ".25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", ".25"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", ".5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{".3", ",", ".5"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{".7", ",", ".5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", ".5"}], "}"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}], ",", 
              RowBox[{"2.5", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", "50", "}"}]}], "]"}], ",", "2"}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"LightGray", ",", 
        RowBox[{"Polygon", "[", "poly", "]"}], ",", "Gray", ",", 
        RowBox[{"Line", "/@", "segments"}], ",", "Red", ",", 
        RowBox[{"Thickness", "[", ".01", "]"}], ",", 
        RowBox[{"Line", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ClipSegmentToConvexPolygonExterior", "[", 
             RowBox[{"#", ",", "poly"}], "]"}], "&"}], "/@", "segments"}], 
          ")"}]}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462923197661623*^9, 3.46292319941078*^9}, {
   3.462923572765308*^9, 3.462923574512732*^9}, {3.462923796571898*^9, 
   3.462923826395226*^9}, 3.462926538910056*^9, 3.484755058778545*^9, 
   3.484755295355463*^9, {3.4847554206510878`*^9, 3.484755420916008*^9}, 
   3.484770706051959*^9, 3.484770748573501*^9, 3.4847707873257236`*^9},
 CellLabel->
  "In[537]:=",ExpressionUUID->"bc638834-9a8a-4390-9d62-537b272e0464"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Interval Sets\nIntervalSetValidQ[",
 StyleBox["is",
  FontSlant->"Italic"],
 "]\nIntervalSetCleanup[",
 StyleBox["is",
  FontSlant->"Italic"],
 "]\nIntervalSetIntersect[",
 StyleBox["is",
  FontSlant->"Italic"],
 ", {",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "}]\nIntervalSetMinus[",
 StyleBox["is",
  FontSlant->"Italic"],
 ", {",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "}], \nIntervalSetMinus[",
 StyleBox["is1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is2",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.484750584850271*^9, 3.4847505895781107`*^9}, {
   3.484753482482634*^9, 3.4847534951376057`*^9}, {3.48475473411901*^9, 
   3.484754738774317*^9}, {3.4847576793324413`*^9, 3.484757695658807*^9}, 
   3.628118977682851*^9, {3.628987574296331*^9, 
   3.628987580014822*^9}},ExpressionUUID->"21e84c71-0a29-4b16-bcdc-\
dd37ab562107"],

Cell["\<\
This and the next section support a more general model of line segments, \
which supports an object representing several finite segments along a given \
line. We use the same parametric model of the line, but introduce \"interval \
sets\" to describe the ranges of parameters that will describe the multiple \
segments.\
\>", "Text",
 CellChangeTimes->{{3.484775893251429*^9, 
  3.484775996156603*^9}},ExpressionUUID->"430db778-e4e1-4d83-ae67-\
741e31387e4f"],

Cell[TextData[{
 "An interval set represents a finite set of nonintersecting intervals on the \
real line. It is represented as a nested list of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["s", "1"], ",", 
       SubscriptBox["t", "1"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["s", "2"], ",", 
       SubscriptBox["t", "2"]}], "}"}], ",", " ", "...", ","}], " ", "}"}], 
   TraditionalForm]],ExpressionUUID->"e647d370-aaf9-4ad3-a306-540f6e32b29f"],
 ", where each pair defines an interval that is contained within the set, and \
the numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["s", "1"], ",", 
     SubscriptBox["t", "1"], ",", 
     SubscriptBox["s", "2"], ",", 
     SubscriptBox["t", "2"], ",", " ", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"8fba0192-939e-401b-bb05-7d6ef9fe46ae"],
 " are strictly ordered in increasing order. Note that we allow values of \
\[PlusMinus]\[Infinity] for endpoints of an interval, provided, of course, \
that \[Dash]\[Infinity] only occurs at the beginning and +\[Infinity] only \
occurs at the end."
}], "Text",
 CellChangeTimes->{{3.484750052007193*^9, 3.48475021553898*^9}, {
  3.484754541773514*^9, 3.484754547244052*^9}, {3.484758856687415*^9, 
  3.484758914577853*^9}},ExpressionUUID->"09176880-0485-4f38-9326-\
b1f201dc1750"],

Cell["\<\
We use interval sets to represent interrupted lines when we render the folded \
form of general crease patterns.\
\>", "Text",
 CellChangeTimes->{{3.484750217669965*^9, 3.4847502482483397`*^9}, {
  3.484755314472691*^9, 
  3.484755321984053*^9}},ExpressionUUID->"e62b8844-a269-4f2f-a020-\
c5de2f6096c9"],

Cell[TextData[{
 "IntervalSetValidQ[",
 StyleBox["is",
  FontSlant->"Italic"],
 "] returns True iff the set is is properly ordered or empty."
}], "Text",
 CellChangeTimes->{{3.48475059135226*^9, 
  3.4847506292790537`*^9}},ExpressionUUID->"cef08195-e592-470f-8a10-\
9b4d2e81461b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntervalSetValidQ", "[", "is_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dim", ",", "nums"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "is", "]"}], ",", 
       RowBox[{"Return", "[", "True", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{"Dimensions", "[", "is", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "dim", "]"}], "\[NotEqual]", "2"}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dim", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
         "\[NotEqual]", "2"}], ",", " ", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nums", "=", 
      RowBox[{"Flatten", "[", "is", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"And", "@@", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Less", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Drop", "[", 
           RowBox[{"nums", ",", 
            RowBox[{"-", "1"}]}], "]"}], ",", 
          RowBox[{"Drop", "[", 
           RowBox[{"nums", ",", "1"}], "]"}]}], "}"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.4847506305397673`*^9, 3.484750654367214*^9}, {
  3.484750685966031*^9, 3.48475071795197*^9}, {3.484750792344716*^9, 
  3.4847509593411407`*^9}, {3.484750991731813*^9, 3.484751013739626*^9}, {
  3.484753553404129*^9, 3.484753553753319*^9}},
 CellLabel->
  "In[538]:=",ExpressionUUID->"3abeebc2-ec0d-4d83-9320-f3e34e6a4d9c"],

