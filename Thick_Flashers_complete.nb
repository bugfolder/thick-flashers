   3.5924206418966293`*^9, 3.592420652901762*^9}, {3.592428516715374*^9, 
   3.592428522218512*^9}, {3.592428667883452*^9, 3.592428669977542*^9}, {
   3.5924292427330713`*^9, 3.592429247172687*^9}, {3.5924298595914087`*^9, 
   3.592429864293497*^9}, {3.592472409242022*^9, 3.59247244181603*^9}, {
