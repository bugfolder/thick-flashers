Cell[CellGroupData[{

Cell[TextData[{
 "MakeYoshimuraVertex[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", {",
 StyleBox["gm2, gm6}, opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[MakeTVertexFromAngles], \
Options[MakeTVertex3DFromAngles], "
}], "Subsubsection",
 CellChangeTimes->{
  3.616162862882765*^9, {3.616163703177861*^9, 3.616163705759424*^9}, 
   3.6161637743190603`*^9, {3.6161638456491203`*^9, 3.6161638793170033`*^9}, {
   3.616164544058678*^9, 3.616164553369857*^9}, {3.616175338415649*^9, 
   3.6161753772209997`*^9}, 
   3.616178487087901*^9},ExpressionUUID->"4e3fd0d7-496a-421f-8601-\
a2ba0c9ffc55"],

Cell[TextData[{
 "MakeYoshimuraVertex[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", {",
 StyleBox["gm2, gm6}, opts",
  FontSlant->"Italic"],
 "] creates a TVertex3D that is a degree-6 vertex with sector angles given by \
",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", two specified dihedral angles {",
 StyleBox["gm2, gm6}",
  FontSlant->"Italic"],
 ", and that satisifies the condition that lets it tile to make the Yoshimura \
pattern, which is that ",
 StyleBox["gm1",
  FontSlant->"Italic"],
 "==",
 StyleBox["gm4 ",
  FontSlant->"Italic"],
 "and those two folds are collinear in the crease pattern",
 StyleBox[".",
  FontSlant->"Italic"],
 " The vertex is assumed to be oriented so that folds 1 and 4 are the same \
parity and folds 2,3,5,6 are opposite parity. The first 3 sector angles must \
sum to 180\[Degree], also the last 3. In the returned TVertex3D, the vertex \
satisfies the Yoshimura condition so that it can be tiled helically in 3D, \
fold 1 runs along the x-axis and in 3D, sector angle 1 lies in the x-y plane. \
Options are:\n\tOptions[MakeTVertexFromAngles] are passed through\n\t\
Options[MakeTVertex3DFromAngles] are passed through"
}], "Text",
 CellChangeTimes->{{3.616162527812245*^9, 3.616162537516487*^9}, {
  3.616162619510932*^9, 3.6161626210050693`*^9}, {3.61616265675524*^9, 
  3.616162844142987*^9}, {3.616163196298218*^9, 3.616163284402941*^9}, {
  3.61616378963472*^9, 3.616163844281394*^9}, {3.616163891804369*^9, 
  3.616163904947503*^9}, {3.6161643760558147`*^9, 3.6161644395849853`*^9}, {
  3.616175384662464*^9, 3.6161754075710907`*^9}, {3.616178491590296*^9, 
  3.616178605602201*^9}},ExpressionUUID->"85c05dd7-3ffe-4395-ac30-\
36ff099df471"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeYoshimuraVertex", "::", "badsectors"}], 
   "=", "\"\<The sector angle list `1` must contain 6 angles.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.616163533758789*^9, 3.616163568618398*^9}, {
  3.6161639416440687`*^9, 3.616163969472775*^9}},
