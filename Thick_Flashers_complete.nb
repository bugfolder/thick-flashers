   3.5923775228681917`*^9, 3.5923775331053753`*^9}, 3.592377647708188*^9, 
   3.5924358576172457`*^9, 3.592648918624249*^9, 3.592670434294907*^9, 
   3.592670629865819*^9, 3.592671068293684*^9, 3.59282877068147*^9, {
   3.625686329610145*^9, 3.625686345410191*^9}, 3.628786727717686*^9, 
   3.6287867950848618`*^9},
 CellLabel->
  "In[1408]:=",ExpressionUUID->"0bfbe0bb-9b6f-4c10-b250-1ec9e361e62d"],

Cell[TextData[{
 "AddTGraph3D[",
 StyleBox["verts3d, foldangles",
  FontSlant->"Italic"],
 "] returns a pure function that makes adds the TGraph3D class with property \
values ",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 " and ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ". Both are optional, so one can use AddTGraph3D[",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 "] (which will calculate the fold angles) or AddTGraph3D[] (which will use \
the unfolded embedding). If you want to supply ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " but not ",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 ", see FoldGraph3D, below."
}], "Text",
 CellChangeTimes->{{3.592648932176953*^9, 3.592649023648555*^9}, {
  3.592649317334541*^9, 3.592649325171477*^9}, {3.592828770768604*^9, 
  3.5928287708593597`*^9}, {3.5942305194151087`*^9, 3.59423056114052*^9}, {
  3.594233769857174*^9, 3.594233771121087*^9}, {3.625664444127439*^9, 
  3.625664481812812*^9}, {3.625664527180399*^9, 
  3.625664552312571*^9}},ExpressionUUID->"ed27f9a7-ae56-4013-bd9f-\
12548cc9585c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTGraph3D", "[", 
   RowBox[{
    RowBox[{"verts3d_List", ":", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"foldangles_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"AddTGraph3DTo", "[", 
    RowBox[{"#", ",", "verts3d", ",", "foldangles"}], "]"}], "&"}]}]], "Input",\

 CellChangeTimes->{{3.592648996476391*^9, 3.592649042282383*^9}, {
  3.59282877094932*^9, 3.592828771017113*^9}, {3.594230507996653*^9, 
  3.594230515457159*^9}, {3.594230569221558*^9, 3.59423057403999*^9}},
 CellLabel->
  "In[1409]:=",ExpressionUUID->"75844f3e-aaf2-4f61-8b46-c0f757c73f04"],

Cell[TextData[{
 "Note that when chaining this constructor, you must call the function, even \
if you\[CloseCurlyQuote]re relying on the default empty list, i.e., do this:\n\
\ttobj // AddTGraph3D[]\nnot this:\n\ttobj // AddTGraph3D\nMost of the time, \
though, you will have 3D vertex data and so will do this:\n\ttobj // \
AddTGraph3D[",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 "]\nor this\n\ttobj // AddTGraph3D[",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 "]"
}], "Text",
 CellChangeTimes->{{3.592649046151081*^9, 3.592649101507053*^9}, {
  3.592649236465539*^9, 3.5926492476171417`*^9}, {3.5926597443034363`*^9, 
  3.592659800019793*^9}, {3.592828771110568*^9, 3.592828771296648*^9}, {
  3.594230591058146*^9, 
  3.594230610120966*^9}},ExpressionUUID->"96caa0f0-738c-486e-9803-\
d86ef1ae52b1"],

Cell[TextData[{
 "MakeTGraph3D[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["verts3d, foldangles",
  FontSlant->"Italic"],
 "] creates a TGraph3D from parameters."
}], "Text",
 CellChangeTimes->{{3.5928520882926197`*^9, 3.592852131097822*^9}, {
  3.594230615280573*^9, 
  3.594230616456756*^9}},ExpressionUUID->"7e05add6-8d47-4cbe-b4c3-\
f1ff20e2d992"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTGraph3D", "[", 
   RowBox[{"verts_List", ",", "edges_List", ",", "faces_List", ",", 
    RowBox[{"verts3d_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", 
    RowBox[{"foldangles_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"MakeTGraph", "[", 
    RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], "//", 
   RowBox[{"AddTGraph3D", "[", 
    RowBox[{"verts3d", ",", "foldangles"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.592852138639703*^9, 3.592852197232526*^9}, {
  3.594230618979234*^9, 3.594230632201729*^9}},
 CellLabel->
  "In[1410]:=",ExpressionUUID->"80d99c26-3598-4b6b-a16c-97340c2be9ba"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["TGraph3D rendering", "Subsection",
 CellChangeTimes->{{3.594734420720774*^9, 
  3.594734423831052*^9}},ExpressionUUID->"29512b69-c306-44fc-a290-\
baccd6814d4c"],

Cell[CellGroupData[{

Cell["\<\
FoldAngleForm
FoldAngleDigits\
\>", "Subsubsection",
 CellChangeTimes->{{3.64337370750878*^9, 
  3.643373714322389*^9}},ExpressionUUID->"88017db6-b0ad-47c2-808f-\
4ee5dfbbad94"],

Cell[TextData[{
 "FoldAngleForm is an option to FoldAngleLabels that specifies the formatter \
to use for angles. Some useful examples:\n\tFoldAngleForm \[Rule] Round \
\[LongDash] rounds to integer degrees.\n\tFoldAngleForm \[Rule] \
FoldAngleDigits[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] \[LongDash] display all angles numerically to ",
 StyleBox["n",
  FontSlant->"Italic"],
 " decimal places."
}], "Text",
 CellChangeTimes->{{3.595326906536026*^9, 3.595327111713085*^9}, {
  3.595327145219575*^9, 3.595327147737241*^9}, {3.595327187078129*^9, 
  3.5953271890958443`*^9}, {3.595327242385982*^9, 3.595327243392876*^9}, {
  3.617406619068659*^9, 3.617406620717699*^9}, {3.6433737384335957`*^9, 
  3.643373753359694*^9}, {3.643373909032707*^9, 
  3.643373917942111*^9}},ExpressionUUID->"c48036cc-ecea-43bd-9cc2-\
3752527bb8e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FoldAngleForm", "::", "usage"}], 
   "=", "\"\<FoldAngleForm is an option to FoldAngleLabels that specifies the \
printed form of the fold angle.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595326894155533*^9, 3.595326895582858*^9}, {
  3.595327151929925*^9, 3.595327239188877*^9}},
 CellLabel->
  "In[1411]:=",ExpressionUUID->"72d2c9ea-0ebb-4d90-95d6-0d405f34db8d"],

Cell[TextData[{
 "FoldAngleDigits[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] is a number function that displays angles with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " digits beyond the decimal point."
}], "Text",
 CellChangeTimes->{{3.643373758159037*^9, 
  3.6433737921970673`*^9}},ExpressionUUID->"e9447e1f-af3e-46f5-a15a-\
bd4fa0ead136"],

Cell["\<\
The use of Round ensures that super-tiny numbers won\[CloseCurlyQuote]t \
default to scientific notation.\
\>", "Text",
 CellChangeTimes->{{3.687006268022075*^9, 
  3.687006293427348*^9}},ExpressionUUID->"921e7197-0962-486a-b0d9-\
01a2d4a464db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAngleDigits", "[", 
   RowBox[{"n_", ":", "0"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"n", "\[Equal]", "0"}], ",", "Round", ",", 
    RowBox[{
     RowBox[{"NumberForm", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Round", "[", 
          RowBox[{"#", " ", 
           SuperscriptBox["10", "n"]}], "]"}], 
         SuperscriptBox["10", 
          RowBox[{"-", "n"}]]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"5", ",", "n"}], "}"}]}], "]"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.643373798912094*^9, 3.643373845980172*^9}, {
  3.687006070740835*^9, 3.687006133880763*^9}},
 CellLabel->
  "In[1412]:=",ExpressionUUID->"9595a1a0-b8be-46df-82e2-fa225fafe2b2"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.6433738595449553`*^9, 3.643373860279972*^9}, 
   3.687006209170112*^9},ExpressionUUID->"5f0d5ccf-1fef-4652-b3c3-\
a38d7efd1a76"],

