Cell[CellGroupData[{

Cell["Properties", "Subsection",
 CellChangeTimes->{{3.9223563038871393`*^9, 
  3.9223563049004498`*^9}},ExpressionUUID->"4678e57e-5fed-493a-a329-\
535bdaeadb91"],

Cell[CellGroupData[{

Cell[TextData[{
 "FaceNormalsGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.922356310573407*^9, 
  3.9223563260079393`*^9}},ExpressionUUID->"3a4cc7c5-8bbf-4582-b055-\
ca55ea28bfc2"],

Cell[TextData[{
 "FaceNormalsGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 "] returns a list of (outward-pointing) normal vectors for the faces of a \
GraphicsComplex panel."
}], "Text",
 CellChangeTimes->{{3.9223563349680223`*^9, 
  3.922356371495305*^9}},ExpressionUUID->"49dfa34b-2436-4617-a500-\
4c6f1a69344c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceNormalsGC", "[", "gc_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "polys", ",", "face", ",", "ctrd"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"gc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", "#", "]"}], "&"}], "/@", 
       RowBox[{
       "gc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"face", "=", 
         RowBox[{"verts", "\[LeftDoubleBracket]", 
          RowBox[{
          "polys", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ctrd", "=", 
         RowBox[{
          RowBox[{"Plus", "@@", "face"}], "/", 
          RowBox[{"Length", "[", "face", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "face", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-",
             "ctrd"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "face", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-",
             "ctrd"}], ")"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "polys", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.922356387598901*^9, 3.922356393422155*^9}, {
  3.9223564490375023`*^9, 3.922356753015667*^9}, {3.922356866887652*^9, 
  3.922356868261487*^9}},
 CellLabel->
  "In[4248]:=",ExpressionUUID->"4c967755-c527-415f-93ba-cb007369fff7"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.922356759955866*^9, 
  3.922356761380192*^9}},ExpressionUUID->"796daab0-bcb4-453b-ab84-\
f88502fcb0a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gc", ",", "fnorms"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gc", "=", "CubeGC"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fnorms", "=", 
      RowBox[{"FaceNormalsGC", "[", "gc", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<face normals = \>\"", ",", "fnorms"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"gc", ",", "SolidStyle"}], "]"}], ",", 
        RowBox[{"AllLabelsGC", "[", "gc", "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.9223567790172043`*^9, 3.922356931778897*^9}},
 CellLabel->
  "In[4249]:=",ExpressionUUID->"95937ab6-c02a-419f-b529-d000ca94e222"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "BoundingBoxGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.925063920068454*^9, 
  3.925063925268619*^9}},ExpressionUUID->"2829f736-2c67-4637-ad69-\
85b6b5bcc40e"],

Cell[TextData[{
 "BoundingBoxGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] takes an expression containing GraphicsComplex objects and returns the \
bounding box for all of the points of the expression."
}], "Text",
 CellChangeTimes->{{3.925063952323382*^9, 
  3.925063981442898*^9}},ExpressionUUID->"2485d6f9-08b3-498d-b1e2-\
182fc5863b45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BoundingBoxGC", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"First", "/@", 
         RowBox[{"Cases", "[", 
          RowBox[{"expr", ",", "_GraphicsComplex", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"BoundingBox", "[", "pts", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.925063985426776*^9, 3.92506400214211*^9}, {
  3.925064184582906*^9, 3.92506428073639*^9}},
 CellLabel->
  "In[4250]:=",ExpressionUUID->"eab829ae-6abf-4b2e-8e9b-72d0bf1267d9"],

Cell["Example. Two intersecting cubes.", "Text",
 CellChangeTimes->{{3.925064025145439*^9, 3.925064027554184*^9}, {
  3.9250641433518333`*^9, 
  3.925064146631831*^9}},ExpressionUUID->"0647a2fd-cbec-4779-ae70-\
f25586e6dd07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cgc1", ",", "cgc2", ",", "expr", ",", "bbox"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cgc1", "=", 
      RowBox[{"cgc2", "=", "CubeGC"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cgc2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
      "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.5", ",", "0.7", ",", "0.9"}], "}"}], "+", "#"}], "&"}], "/@", 
       RowBox[{
       "cgc2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"expr", "=", 
      RowBox[{"{", 
       RowBox[{"cgc1", ",", "cgc2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bbox", "=", 
      RowBox[{"BoundingBoxGC", "[", "expr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"Axes", "->", "True"}]}], "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Bounding box = \>\"", ",", "bbox"}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.925064032840951*^9, 3.925064211295616*^9}, {
  3.925064296702589*^9, 3.925064334469535*^9}},
 CellLabel->
  "In[4251]:=",ExpressionUUID->"b8de6106-699b-498b-a450-1daeb0097839"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["3D solids", "Subsection",
 CellChangeTimes->{{3.7084698933850107`*^9, 3.708469897265794*^9}, {
   3.708599452058729*^9, 3.7085994550808787`*^9}, 
   3.720309818029768*^9},ExpressionUUID->"3141826c-1b41-4e1e-b81f-\
77c3831614ef"],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeCubeGC[",
 StyleBox["d",
  FontSlant->"Italic"],
 "]\nMakeCubeGC[]"
}], "Subsubsection",
 CellChangeTimes->{{3.933004278690048*^9, 
  3.9330043105022373`*^9}},ExpressionUUID->"2b047d23-6b12-4100-a812-\
68707126dc5e"],

Cell[TextData[{
 "MakeCubeGC[",
 StyleBox["d",
  FontSlant->"Italic"],
 "] returns a GraphicsComplex object that is a cube of side length ",
 StyleBox["d",
  FontSlant->"Italic"],
 " with one corner at the origin. If d is omitted, it is a unit cube."
}], "Text",
 CellChangeTimes->{{3.9330042994212313`*^9, 
  3.933004362374606*^9}},ExpressionUUID->"ed79f40f-eda5-4d93-8880-\
45a9206d5e12"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeCubeGC", "[", 
   RowBox[{"d_", ":", "1"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "polys"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{"Polygon", "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "6", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4", ",", "8", ",", "7"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3", ",", "7", ",", "6"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "5", ",", "8", ",", "4"}], "}"}]}], "}"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"GraphicsComplex", "[", 
      RowBox[{
       RowBox[{"d", " ", "pts"}], ",", "polys"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.933004350332737*^9, 3.933004426404306*^9}},
 CellLabel->
  "In[4252]:=",ExpressionUUID->"d545d535-bab7-4a80-8cf4-7edb6945b567"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.933004435927989*^9, 
  3.933004437007819*^9}},ExpressionUUID->"517c613d-626c-42a1-b86e-\
2968a6667a51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gc", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gc", "=", 
      RowBox[{"MakeCubeGC", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"gc", ",", "SolidStyle"}], "]"}], ",", 
       RowBox[{"Axes", "->", "True"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.93300444020277*^9, 3.933004481773921*^9}},
 CellLabel->
  "In[4253]:=",ExpressionUUID->"df00b123-426d-4dbd-a2f7-1ea0a9b7ff39"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeCylinderGC[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) RoundingDivisions"
}], "Subsubsection",
 CellChangeTimes->{{3.935684999901259*^9, 3.9356850256004133`*^9}, {
  3.935685068773892*^9, 3.935685070563449*^9}, {3.935685230388802*^9, 
  3.935685232108877*^9}},ExpressionUUID->"85bb02cf-f5c5-4f3c-a4d2-\
f51a33314db6"],

Cell[TextData[{
 "MakeCylinderGC[",
 StyleBox["{p, q}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a GraphicsComplex of a closed 3D cylinder."
}], "Text",
 CellChangeTimes->{{3.7084708894784393`*^9, 3.7084709462775793`*^9}, {
   3.70847099173938*^9, 3.708470998860431*^9}, {3.708473450031004*^9, 
   3.708473450240202*^9}, 3.708601740020692*^9, {3.935685043189814*^9, 
   3.935685049284532*^9}, {3.935685086250449*^9, 3.9356850909778337`*^9}, {
   3.935685239653022*^9, 
   3.9356852411816063`*^9}},ExpressionUUID->"9291b405-2834-4e92-bbcf-\
ce30feee42bc"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p, q",
  FontSlant->"Italic"],
 " \[LongDash] the endpoints of the cylinder.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of the tube."
}], "Text",
 CellChangeTimes->{{3.708470971350868*^9, 3.70847097286454*^9}, {
   3.708471013661922*^9, 3.708471049520111*^9}, 3.708473460147217*^9, {
   3.935685096911751*^9, 3.935685107581257*^9}, {3.935685234580844*^9, 
   3.9356852364120083`*^9}},ExpressionUUID->"0fbad36f-2da8-4347-ac58-\
095fc359b147"],

Cell[TextData[{
 "Options:\n\tRoundingDivisions \[Rule] ",
 StyleBox["nd",
  FontSlant->"Italic"],
 ", specifies the number of divisions to use around the cylinder."
}], "Text",
 CellChangeTimes->{{3.708471304304471*^9, 3.7084713388136687`*^9}, {
  3.7084777286947737`*^9, 3.708477733394681*^9}, {3.708875990294807*^9, 
  3.708875997747208*^9}, {3.935685120816353*^9, 
  3.93568512326484*^9}},ExpressionUUID->"2e548851-3126-41a3-a730-\
ec813ecac9ec"],

Cell["Returns: a GraphicsComplex of the cylinder.", "Text",
 CellChangeTimes->{{3.70847095931019*^9, 3.708470967487243*^9}, {
  3.935685128537678*^9, 
  3.935685129464149*^9}},ExpressionUUID->"ea662d13-52fa-4827-8e03-\
dcaf7a65013f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeCylinderGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"RoundingDivisions", "->", "16"}], "\[IndentingNewLine]", "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.9356851628335943`*^9, 3.935685184650968*^9}},
 CellLabel->
  "In[4254]:=",ExpressionUUID->"170c13fd-4149-4910-a600-02c1bae94a44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeCylinderGC", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", " ", "q_"}], "}"}], ",", " ", "r_", ",", " ", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "pq", ",", "lpq", ",", "x", ",", "y", ",", "z", ",", "\[Phi]", 
      ",", "cir"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{
       RowBox[{"RoundingDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeCylinderGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pq", "=", 
      RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lpq", "=", 
      RowBox[{"Mag", "[", "pq", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"local", " ", "coordinate", " ", "system"}], ",", " ", 
       RowBox[{"x", " ", "is", " ", "along", " ", "the", " ", "axis"}], ",", 
       " ", 
       RowBox[{"y", " ", "and", " ", "z", " ", "are", " ", "transverse"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{"pq", "/", "lpq"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "\[Cross]", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", 
            RowBox[{"x", "\[Cross]", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
            RowBox[{"x", "\[Cross]", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Mag", "[", "#1", "]"}], ">", 
            RowBox[{"Mag", "[", "#2", "]"}]}], "&"}]}], "]"}], "\[LeftDoubleBracket]",
         "1", "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"z", "=", 
      RowBox[{"x", "\[Cross]", "y"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"A", " ", "2", "D", " ", "CW", " ", "circle"}], ",", " ", 
       RowBox[{
       "used", " ", "for", " ", "computation", " ", "of", " ", "cylinders"}], 
       ",", " ", 
       RowBox[{"scaled", " ", "to", " ", "have", " ", "unit", " ", 
        RowBox[{"diameter", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cir", "=", 
      RowBox[{"r", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "=", 
           RowBox[{"N", "[", 
            FractionBox[
             RowBox[{"2", "\[Pi]", " ", "k"}], "m"], "]"}]}], ";", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsComplex", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"p", "+", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "y"}], "+", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "z"}]}], "&"}], "/@", "cir"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "+", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "y"}], "+", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "z"}]}], "&"}], "/@", "cir"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Polygon", "[", 
           RowBox[{"Range", "[", "m", "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"1", ",", "m"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"m", "+", 
               RowBox[{"Range", "[", 
                RowBox[{"1", ",", "m"}], "]"}]}], ",", "\[IndentingNewLine]", 
              
              RowBox[{"m", "+", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"2", ",", 
                   RowBox[{"m", "+", "1"}]}], "]"}], ",", "m", ",", "1"}], 
                "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"Range", "[", 
                 RowBox[{"2", ",", 
                  RowBox[{"m", "+", "1"}]}], "]"}], ",", "m", ",", "1"}], 
               "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"Polygon", "[", 
           RowBox[{"Reverse", "[", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"m", "+", "1"}], ",", 
              RowBox[{"2", "m"}]}], "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9356851457445917`*^9, 3.9356851602576017`*^9}, {
   3.935685251421316*^9, 3.9356853451210423`*^9}, 3.9356853765117197`*^9, {
   3.9356854088518143`*^9, 3.935685461477955*^9}},
 CellLabel->
  "In[4255]:=",ExpressionUUID->"f046095e-b6aa-419c-ab87-b2fb174359fb"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.935685470528207*^9, 
  3.935685471585496*^9}},ExpressionUUID->"4b18f66b-0dfe-4516-8fdd-\
d4c6ebe1a1d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "q"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "q"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"MakeCylinderGC", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p", ",", "q"}], "}"}], ",", "0.2", ",", 
            RowBox[{"RoundingDivisions", "->", "12"}]}], "]"}], ",", 
          "SolidStyle", ",", 
          RowBox[{"Opacity", "[", "1", "]"}]}], "]"}], ",", 
        RowBox[{"Axes", "->", "True"}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], "//", "ShowExample"}], ";"}]], "Input",
 CellChangeTimes->{{3.935685472895215*^9, 3.935685586924858*^9}},
 CellLabel->
  "In[4256]:=",ExpressionUUID->"cf3639b1-b047-47df-8289-92cfec9538bd"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakePolygonalTubeGC[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] [NEEDS DEBUGGING, see examples]\n\t(options) RoundingDivisions"
}], "Subsubsection",
 CellChangeTimes->{{3.708477757891589*^9, 3.708477768427956*^9}, 
   3.708601739954815*^9, {3.935685609723773*^9, 
   3.935685619812346*^9}},ExpressionUUID->"3944bfe6-776a-49e0-95b1-\
eb5385f39a0e"],

Cell[TextData[{
 "MakePolygonalTubeGC[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a GraphicsComplex of a 3D tube with rounded joins that follows a \
3D list of points."
}], "Text",
 CellChangeTimes->{{3.7084708894784393`*^9, 3.7084709462775793`*^9}, {
   3.70847099173938*^9, 3.708470998860431*^9}, {3.708473450031004*^9, 
   3.708473450240202*^9}, 
   3.708601740020692*^9},ExpressionUUID->"bd362c16-2154-481e-ae0c-\
09ed1b40b29e"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["pts",
  FontSlant->"Italic"],
 " \[LongDash] a list of 3D points that defines the path that the tube \
follows.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of the tube."
}], "Text",
 CellChangeTimes->{{3.708470971350868*^9, 3.70847097286454*^9}, {
   3.708471013661922*^9, 3.708471049520111*^9}, 
   3.708473460147217*^9},ExpressionUUID->"6f97349e-d299-41f2-b554-\
3374dde44160"],

Cell[TextData[{
 "Options:\n\tRoundingDivisions \[Rule] ",
 StyleBox["nd",
  FontSlant->"Italic"],
 ", specifies the number of divisions to use per \[Pi] radians of bend, also \
for the end caps if it\[CloseCurlyQuote]s an open tube."
}], "Text",
 CellChangeTimes->{{3.708471304304471*^9, 3.7084713388136687`*^9}, {
  3.7084777286947737`*^9, 3.708477733394681*^9}, {3.708875990294807*^9, 
  3.708875997747208*^9}},ExpressionUUID->"0e848f8e-167c-4dc8-8f94-\
1c1890abe8f4"],

Cell["Returns: a GraphicsComplex of the polygonal tube.", "Text",
 CellChangeTimes->{{3.70847095931019*^9, 
  3.708470967487243*^9}},ExpressionUUID->"02e548af-3187-4ff4-b49f-\
bd1e29084084"],

Cell[TextData[{
 StyleBox["pts",
  FontSlant->"Italic"],
 " may or may not be a closed loop."
}], "Text",
 CellChangeTimes->{{3.708470949174034*^9, 3.708470954644239*^9}, 
   3.708473465346555*^9},ExpressionUUID->"20fbd693-372e-46c9-b490-\
ca6b62e8379a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakePolygonalTubeGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"RoundingDivisions", "\[Rule]", "5"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.708470790076441*^9, 3.708470794965274*^9}, {
   3.708470825102792*^9, 3.708470858902161*^9}, {3.708471264784436*^9, 
   3.708471271903161*^9}, 3.70847773808246*^9, 3.708601740052672*^9},
 CellLabel->
  "In[4257]:=",ExpressionUUID->"7ed3098a-6bbe-45fa-a327-2abcb2af9a1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePolygonalTubeGC", "[", 
   RowBox[{"pts_", ",", " ", "r_", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nd", ",", "np", ",", "closed", ",", "verts", ",", "faces", ",", "cfn", ",",
       "bfn", ",", "xp", ",", "xn", ",", "z", ",", "strt", ",", "cap", ",", 
      "wm", ",", "ba", ",", "wp", ",", "wn", ",", "vi", ",", "dj", ",", "na", 
      ",", "da"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nd", "=", 
      RowBox[{
       RowBox[{"RoundingDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakePolygonalTubeGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"np", "=", 
      RowBox[{"Length", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"closed", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
         "\[Equal]", 
        RowBox[{
        "pts", "\[LeftDoubleBracket]", "np", "\[RightDoubleBracket]"}]}], 
       ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"faces", "=", 
       RowBox[{"{", "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"radial", " ", "position", " ", "at", " ", "a", " ", "vertex"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cfn", "[", 
       RowBox[{"z_", ",", "w_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Theta]", "=", 
          RowBox[{"j", " ", 
           RowBox[{"\[Pi]", "/", "nd"}]}]}], "}"}], ",", 
        RowBox[{"r", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"z", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
           RowBox[{"w", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bfn", "[", 
       RowBox[{"z_", ",", "w_", ",", "j_", ",", "x_", ",", "\[Phi]_"}], "]"}],
       ":=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Theta]", "=", 
          RowBox[{"j", " ", 
           RowBox[{"\[Pi]", "/", "nd"}]}]}], "}"}], ",", 
        RowBox[{"r", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"z", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
           RowBox[{"w", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}], 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
           RowBox[{"x", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}], 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "local", " ", "coordinates", " ", "and", " ", "info", " ",
        "for", " ", "each", " ", "vertex"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"vector", " ", "from", " ", "previous", " ", "point"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"xp", "[", "i", "]"}], "=", 
         RowBox[{"NormalizeReal", "[", 
          RowBox[{
           RowBox[{
           "pts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "-", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "1"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{"closed", ",", 
               RowBox[{"pts", "\[LeftDoubleBracket]", 
                RowBox[{"np", "-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "pts", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"pts", "\[LeftDoubleBracket]", 
              RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"vector", " ", "to", " ", "next", " ", "point"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"xn", "[", "i", "]"}], "=", 
         RowBox[{"NormalizeReal", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "np"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{"closed", ",", 
               RowBox[{
               "pts", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               ",", 
               RowBox[{"pts", "\[LeftDoubleBracket]", 
                RowBox[{"np", "-", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
             ",", 
             RowBox[{"pts", "\[LeftDoubleBracket]", 
              RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "-", 
           RowBox[{
           "pts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"end", " ", "needs", " ", "to", " ", "be", " ", "capped"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"cap", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{"!", "closed"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", "\[Equal]", "1"}], "||", 
            RowBox[{"i", "\[Equal]", "np"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"vertical", " ", "direction"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"z", "[", "i", "]"}], " ", "=", 
         RowBox[{
          RowBox[{"xp", "[", "i", "]"}], "\[Cross]", " ", 
          RowBox[{"xn", "[", "i", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"strt", "[", "i", "]"}], "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Mag", "[", 
            RowBox[{"z", "[", "i", "]"}], "]"}], "\[Equal]", "0"}], ")"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"straight", " ", "vertex"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"z", "[", "i", "]"}], "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"strt", "[", "i", "]"}], ",", 
           RowBox[{
            RowBox[{"Normals3D", "[", 
             RowBox[{"xp", "[", "i", "]"}], "]"}], "\[LeftDoubleBracket]", 
            "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{"z", "[", "i", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "bend", " ", "angle", " ", "is", " ", "always", " ", "to", " ", 
          "the", " ", "left", " ", "relative", " ", "to", " ", "z"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ba", "[", "i", "]"}], "=", 
         RowBox[{"DirectedAngle3D", "[", 
          RowBox[{
           RowBox[{"xp", "[", "i", "]"}], ",", 
           RowBox[{"xn", "[", "i", "]"}], ",", 
           RowBox[{"z", "[", "i", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"horizontal", " ", "vectors"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wp", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{"z", "[", "i", "]"}], "\[Cross]", 
          RowBox[{"xp", "[", "i", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wn", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{"z", "[", "i", "]"}], "\[Cross]", 
          RowBox[{"xn", "[", "i", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"wm", "[", "i", "]"}], "=", 
         RowBox[{"Which", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"!", "closed"}], "&&", 
            RowBox[{"i", "\[Equal]", "1"}]}], ",", 
           RowBox[{"wn", "[", "i", "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"!", "closed"}], "&&", 
            RowBox[{"i", "\[Equal]", "np"}]}], ",", 
           RowBox[{"wp", "[", "i", "]"}], ",", "\[IndentingNewLine]", "True", 
           ",", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{
             RowBox[{"wp", "[", "i", "]"}], "+", 
             RowBox[{"wn", "[", "i", "]"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"number", " ", "of", " ", "angular", " ", "divisions"}], " ",
          "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"na", "[", "i", "]"}], "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"cap", "[", "i", "]"}], ",", "nd", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"strt", "[", "i", "]"}], ",", "0", ",", 
             RowBox[{"Round", "[", 
              RowBox[{"nd", " ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"ba", "[", "i", "]"}], "]"}], "/", "\[Pi]"}]}], 
              "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"angular", " ", "change"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"da", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"cap", "[", "i", "]"}], ",", 
            RowBox[{"\[Pi]", "/", 
             RowBox[{"na", "[", "i", "]"}]}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"strt", "[", "i", "]"}], "||", 
               RowBox[{
                RowBox[{"na", "[", "i", "]"}], "\[Equal]", "0"}]}], ",", "0", 
              ",", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"ba", "[", "i", "]"}], "]"}], "/", 
               RowBox[{"na", "[", "i", "]"}]}]}], "]"}]}], "]"}], "//", 
          "N"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"build", " ", "vertices", " ", "of", " ", "cylinders"}], " ",
          "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Which", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"j", "\[Equal]", 
             RowBox[{"2", "nd"}]}], ",", 
            RowBox[{"(*", " ", 
             RowBox[{"wrap", "-", 
              RowBox[{"around", " ", "in", " ", "j"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"vi", "[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "i", ",", "j"}], "]"}], "=", 
             RowBox[{
              RowBox[{"vi", "[", 
               RowBox[{"1", ",", "i", ",", "j"}], "]"}], "=", 
              RowBox[{"vi", "[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "i", ",", "0"}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"strt", "[", "i", "]"}], ",", 
            RowBox[{"(*", " ", 
             RowBox[{"straight", " ", "vertex"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"verts", ",", 
               RowBox[{
                RowBox[{
                "pts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
                 "+", 
                RowBox[{"cfn", "[", 
                 RowBox[{
                  RowBox[{"z", "[", "i", "]"}], ",", 
                  RowBox[{"wm", "[", "i", "]"}], ",", "j"}], "]"}]}]}], "]"}],
              ";", 
             RowBox[{
              RowBox[{"vi", "[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "i", ",", "j"}], "]"}], "=", 
              RowBox[{
               RowBox[{"vi", "[", 
                RowBox[{"1", ",", "i", ",", "j"}], "]"}], "=", 
               RowBox[{"Length", "[", "verts", "]"}]}]}]}], ",", 
            "\[IndentingNewLine]", "True", ",", 
            RowBox[{"(*", " ", 
             RowBox[{"bend", " ", 
              RowBox[{"(", 
               RowBox[{"to", " ", "the", " ", "left"}], ")"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"j", "\[LessEqual]", "nd"}], "||", 
               RowBox[{"cap", "[", "i", "]"}], "||", 
               RowBox[{
                RowBox[{"na", "[", "i", "]"}], "\[Equal]", "0"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "both", " ", "edges", " ", "end", " ", "on", " ", "angle", " ",
                 "bisector", " ", "plane"}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"verts", ",", 
                 RowBox[{
                  RowBox[{
                  "pts", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "+", 
                  RowBox[{"cfn", "[", 
                   RowBox[{
                    RowBox[{"z", "[", "i", "]"}], ",", 
                    RowBox[{"wm", "[", "i", "]"}], ",", "j"}], "]"}]}]}], 
                "]"}], ";", 
               RowBox[{
                RowBox[{"vi", "[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "i", ",", "j"}], "]"}], "=", 
                RowBox[{
                 RowBox[{"vi", "[", 
                  RowBox[{"1", ",", "i", ",", "j"}], "]"}], "=", 
                 RowBox[{"Length", "[", "verts", "]"}]}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"outside", " ", "of", " ", "bend"}], ",", " ", 
                RowBox[{
                "separate", " ", "edges", " ", "for", " ", "previous", " ", 
                 "and", " ", "next", " ", "cylinder"}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"verts", ",", 
                 RowBox[{
                  RowBox[{
                  "pts", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "+", 
                  RowBox[{"cfn", "[", 
                   RowBox[{
                    RowBox[{"z", "[", "i", "]"}], ",", 
                    RowBox[{"wp", "[", "i", "]"}], ",", "j"}], "]"}]}]}], 
                "]"}], ";", 
               RowBox[{
                RowBox[{"vi", "[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "i", ",", "j"}], "]"}], "=", 
                RowBox[{"Length", "[", "verts", "]"}]}], ";", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"verts", ",", 
                 RowBox[{
                  RowBox[{
                  "pts", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "+", 
                  RowBox[{"cfn", "[", 
                   RowBox[{
                    RowBox[{"z", "[", "i", "]"}], ",", 
                    RowBox[{"wn", "[", "i", "]"}], ",", "j"}], "]"}]}]}], 
                "]"}], ";", 
               RowBox[{
                RowBox[{"vi", "[", 
                 RowBox[{"1", ",", "i", ",", "j"}], "]"}], "=", 
                RowBox[{"Length", "[", "verts", "]"}]}]}]}], "]"}]}], "]"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"2", "nd"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "np"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"build", " ", "cylindrical", " ", "faces"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"find", " ", "the", " ", "next", " ", "j"}], "-", 
         RowBox[{"value", " ", "closest", " ", "to", " ", "this", " ", 
          RowBox[{"vertex", "'"}], "s", " ", "j"}]}], "=", "0"}], " ", "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"dj", "=", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"p0", "=", 
