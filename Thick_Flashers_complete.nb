   3.595286865966511*^9}, {3.6151433960780473`*^9, 3.615143411929904*^9}, {
   3.703155358216518*^9, 3.703155373480051*^9}, {3.703155500036129*^9, 
   3.703155502537518*^9}, {3.703162330740692*^9, 3.703162343940326*^9}, {
