  3.7998657396537943`*^9, 3.799865741333189*^9}, {3.801649612464096*^9, 
  3.801649614599312*^9}},ExpressionUUID->"3f02c1a3-e749-4a78-abf4-\
0b899b81d25c"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.799525126696835*^9, 
  3.799525133983824*^9}},ExpressionUUID->"d5e19c79-3323-400b-9b5a-\
ee3924f555cd"],

Cell["\<\
The functions in this section work with ruled neighborhoods of a fold: a \
triple {f, rL, rR} of the fold vector and its left and right ruling vectors. \
Functions come in both analytic and numeric versions.\
\>", "Text",
 CellChangeTimes->{{3.799525136263863*^9, 3.799525187807949*^9}, {
  3.799525253520174*^9, 
  3.799525266376683*^9}},ExpressionUUID->"adec1c36-b1b9-4d75-afdc-\
0dfc7afed8a6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "CurvedFoldShapePlots2D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rR",
  FontSlant->"Italic"],
 ", \[Gamma], {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve], \
Options[NDSolve]"
}], "Subsubsection",
 CellChangeTimes->{{3.799843101330282*^9, 3.79984313976266*^9}, {
  3.799843448628371*^9, 3.7998434507322073`*^9}, {3.7998435881810308`*^9, 
  3.799843626245243*^9}},ExpressionUUID->"f5d7a94a-5a4a-4c9d-a100-\
7f73af184832"],

Cell[TextData[{
 "CurvedFoldShapePlots2D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rR",
  FontSlant->"Italic"],
 ", \[Gamma] {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a list of two plots that show the shape functions for the \
specified 2D curved fold."
}], "Text",
 CellChangeTimes->{{3.799843217340068*^9, 3.7998432529709387`*^9}, 
   3.799843456685609*^9, {3.799843591884646*^9, 3.799843592556816*^9}, {
   3.799845526832039*^9, 
   3.799845527584332*^9}},ExpressionUUID->"d601af28-1001-4904-9cd4-\
ce3b309274cf"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the 2D fold function, could be analytic or numeric.\n\t",
 StyleBox["rL",
  FontSlant->"Italic"],
 " \[LongDash] the left ruling vector function.\n\t",
 StyleBox["rR",
  FontSlant->"Italic"],
 " \[LongDash] the right ruling vector function.\n\t\[Gamma] \[LongDash] the \
fold angle function.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the plot range."
}], "Text",
 CellChangeTimes->{{3.799843467972809*^9, 
  3.799843537460747*^9}},ExpressionUUID->"6e5a8988-cb89-4ac1-a98b-\
9ec8842eaa8c"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results for analytic ",
 StyleBox["f",
  FontSlant->"Italic"],
 ".\n\tAssumptions \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify for \
analytic ",
 StyleBox["f",
  FontSlant->"Italic"],
 ".\n\tOptions[DSolve] are passed through for analytic ",
 StyleBox["f",
  FontSlant->"Italic"],
 ".\n\tOptions[NDSolve] are passed through for numeric ",
 StyleBox["f",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
   3.6912356648227*^9}, {3.691696354142725*^9, 3.6916963964564757`*^9}, {
   3.6916967872943177`*^9, 3.6916967876341476`*^9}, 3.691697514251375*^9, {
   3.691697597209193*^9, 3.69169762262678*^9}, {3.6916979883579497`*^9, 
   3.691698005633368*^9}, 3.691698253142771*^9, 3.691921636608643*^9, 
   3.6919216713298798`*^9, 3.691921758889015*^9, 3.79944345041487*^9, {
   3.799843678718225*^9, 
   3.799843725597896*^9}},ExpressionUUID->"d940ad4d-4b2e-4545-a299-\
57835f6bc7ff"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["plot1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["plot2",
  FontSlant->"Italic"],
 "} plotting the left curvature in ",
 StyleBox["plot1",
  FontSlant->"Italic"],
 " and left ruling angle, right ruling angle, and fold angle in ",
 StyleBox["plot2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.799843633989221*^9, 3.799843639236563*^9}, {
  3.799843737318478*^9, 
  3.799843781294032*^9}},ExpressionUUID->"bb714b8a-3cde-4f28-8312-\
b5e01901e6b7"],

Cell["\<\
It works for both numerical and analytic functions. If the fold function is \
analytic, we will construct the analytic version of the curve system.\
\>", "Text",
 CellChangeTimes->{{3.7998432566111813`*^9, 3.799843264074566*^9}, {
  3.799847679863052*^9, 
  3.799847726846711*^9}},ExpressionUUID->"8acaba86-e954-4bec-9c76-\
4ad0d08df927"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "CurvedFoldShapePlots2D", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.79984355443265*^9, 3.799843562769157*^9}},
 CellLabel->
  "In[3917]:=",ExpressionUUID->"d351af77-aaad-493d-9b6e-4be5baee2cce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CurvedFoldShapePlots2D", "[", 
   RowBox[{
    RowBox[{"f_Function", "|", "f_InterpolatingFunction"}], ",", 
    RowBox[{"rL_Function", "|", "rL_InterpolatingFunction"}], ",", 
    RowBox[{"rR_Function", "|", "rR_InterpolatingFunction"}], ",", 
    RowBox[{"\[Gamma]_Function", "|", "\[Gamma]_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"csys", ",", "\[Kappa]l", ",", "t"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"csys", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ContainsInterpolatingFunctionQ", "[", "f", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"NCurve2DSystem", "[", 
         RowBox[{"f", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Curve2DSystem", "[", 
         RowBox[{"f", ",", "opts"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Kappa]l", ",", "t"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"LeftCurvature2D", ",", "TangentVector2D"}], "}"}], "/.", 
       "csys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Kappa]l", "[", "s", "]"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", 
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Kappa]\), \(l\)]\)\>\"", ",", 
            "Blue"}], "]"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Blue", ",", "White"}], "}"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcCos", "[", 
             RowBox[{
              RowBox[{"rL", "[", "s", "]"}], ".", 
              RowBox[{"t", "[", "s", "]"}]}], "]"}], "/", "\[Degree]"}], ",", 
           
           RowBox[{
            RowBox[{"ArcCos", "[", 
             RowBox[{
              RowBox[{"rR", "[", "s", "]"}], ".", 
              RowBox[{"t", "[", "s", "]"}]}], "]"}], "/", "\[Degree]"}], ",", 
           
           RowBox[{
            RowBox[{"\[Gamma]", "[", "s", "]"}], "/", "\[Degree]"}], ",", 
           "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(L\)]\)/\[Degree]\>\
\"", ",", "Red"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(R\)]\)/\[Degree]\>\
\"", ",", 
              RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<\[Gamma]/\[Degree]\>\"", ",", "Purple"}], "]"}]}], 
           "}"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "Red", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Darker", "[", "Green", "]"}], ",", "Dashed"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Purple", ",", "Dotted"}], "}"}], ",", "White"}], 
           "}"}]}]}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.799843144512265*^9, 3.79984320961935*^9}, {
   3.799843426515924*^9, 3.799843440051792*^9}, {3.799843547445088*^9, 
   3.799843585348713*^9}, {3.79984380874298*^9, 3.799844054584405*^9}, {
   3.799844556726501*^9, 3.799844580531967*^9}, {3.799844703710834*^9, 
   3.799844704019574*^9}, {3.79984474591744*^9, 3.7998448054137707`*^9}, {
   3.799844846543462*^9, 3.799844875160243*^9}, {3.799844995279896*^9, 
   3.799845046171204*^9}, {3.799845085130078*^9, 3.799845093286681*^9}, 
   3.799845134546589*^9, {3.799845204474105*^9, 3.799845271582962*^9}, {
   3.799845404265989*^9, 3.799845405880762*^9}, {3.799845438434719*^9, 
   3.79984544641648*^9}, {3.799846625034837*^9, 3.799846625425579*^9}, {
   3.79984816302897*^9, 3.799848185572161*^9}, {3.7998658316969357`*^9, 
   3.799865892759647*^9}, {3.799865930474472*^9, 3.799865958438939*^9}, {
   3.799866105066997*^9, 3.799866217409685*^9}},
 CellLabel->
  "In[3918]:=",ExpressionUUID->"b1fd735b-5976-450c-bea0-6380d6e956ca"],

Cell["\<\
Example. Note the interpolation artifact that appears in \[Kappa]l in this \
example.\
\>", "Text",
 CellChangeTimes->{{3.7998441544655027`*^9, 3.799844156400947*^9}, {
  3.799845318799458*^9, 3.799845334358439*^9}, {3.799846339165704*^9, 
  3.799846356980753*^9}},ExpressionUUID->"d6e1274b-1f2d-4614-bb22-\
b26beaf4edce"],

Cell["\<\
We post-apply Hold rather than ShowExample because NCurvedFoldHelix2D isn\
\[CloseCurlyQuote]t defined yet.\
\>", "Text",
 CellChangeTimes->{{3.799846359029358*^9, 
  3.79984637987783*^9}},ExpressionUUID->"ba68ade9-d811-4ff3-9c0c-\
db6f8ca96f3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "u0", ",", "u1", ",", "f", ",", "rL", ",", "rR", ",", "\[Gamma]", ",", 
       "plots"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Gamma]", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"60", "\[Degree]"}], "+", 
         RowBox[{"60", "\[Degree]", 
          RowBox[{"(", 
           RowBox[{"#", "/", "\[Pi]"}], ")"}]}]}], "&"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f", ",", "rL", ",", "rR", ",", "\[Gamma]"}], "}"}], "=", 
       RowBox[{"NCurvedFoldHelix2D", "[", 
        RowBox[{"1", ",", 
         RowBox[{"30", "\[Degree]"}], ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plots", "=", 
       RowBox[{"CurvedFoldShapePlots2D", "[", 
        RowBox[{"f", ",", "rL", ",", "rR", ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GraphicsRow", "[", "plots", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.799844162068718*^9, 3.799844176193336*^9}, {
   3.799844258907401*^9, 3.799844373650291*^9}, {3.79984442807646*^9, 
   3.799844508690871*^9}, 3.799844585142114*^9, {3.799844933135893*^9, 
   3.799844945236453*^9}, {3.799846382937562*^9, 3.799846384901689*^9}},
 CellLabel->
  "In[3919]:=",ExpressionUUID->"8bc4dd92-ae4e-43f1-84c2-e9b607ce2b34"]
}, Closed]],

