}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ClampZGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z",
  FontSlant->"Italic"],
 "]\nPrintMinZGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.932834045606078*^9, 3.93283407924472*^9}, 
   3.9328341830083733`*^9, {3.932834250637473*^9, 3.932834251012933*^9}, {
   3.932834365126339*^9, 3.9328343953488007`*^9}, {3.932834521590385*^9, 
   3.932834525903556*^9}},ExpressionUUID->"64be6a50-2da5-439f-a519-\
e9bcdd1e529c"],

Cell[TextData[{
 "ClampZGCs[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z",
  FontSlant->"Italic"],
 "] shifts any GraphicsComplex whose z-coordinate is below ",
 StyleBox["z",
  FontSlant->"Italic"],
 " up to the value of ",
 StyleBox["z",
  FontSlant->"Italic"],
 ".  Note that it shifts the entire GraphicsComplex upward, not just the \
errant point. In a collection of GraphicsComplex objects, the individual \
objects are shifted individually, not all by the same amount."
}], "Text",
 CellChangeTimes->{{3.932834067149548*^9, 3.932834167886766*^9}, {
   3.932834252957901*^9, 3.932834277526651*^9}, {3.932834310910131*^9, 
   3.932834338092786*^9}, 3.9339717395504713`*^9, {3.933971770240893*^9, 
   3.93397179791569*^9}},ExpressionUUID->"0dffd0ab-74a6-4d9f-aec3-\
ba4e7b7e12a0"],

Cell["\<\
This is useful when a 3D-printed object has tiny \[OpenCurlyDoubleQuote]bumps\
\[CloseCurlyDoubleQuote] on its bottom that are artifacts of construction; \
these will result in \[OpenCurlyDoubleQuote]poor bed adhesion\
\[CloseCurlyDoubleQuote] warnings.\
\>", "Text",
 CellChangeTimes->{
  3.932834170175329*^9},ExpressionUUID->"3dafc322-b9b3-41df-8dee-\
a75d63d6b5a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClampZGC", "[", 
   RowBox[{"expr_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{
    RowBox[{"GraphicsComplex", "[", 
     RowBox[{"pts_", ",", "objs_"}], "]"}], ":>", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "zmin", "}"}], ",", 
      RowBox[{
       RowBox[{"zmin", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"Last", "/@", "pts"}], "]"}]}], ";", 
       RowBox[{"GraphicsComplex", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"zmin", "<", "z"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "+", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", 
                RowBox[{"z", "-", "zmin"}]}], "}"}]}], "&"}], "/@", "pts"}], ",",
            "pts"}], "]"}], ",", "objs"}], "]"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.932834176097291*^9, 3.93283423011414*^9}, {
   3.9328342841445007`*^9, 3.932834299297318*^9}, 3.9328343434117737`*^9, {
   3.932834967389104*^9, 3.932834967684325*^9}, {3.93283499952002*^9, 
   3.932835008911224*^9}, {3.932835049395918*^9, 3.932835053511434*^9}},
 CellLabel->
  "In[4309]:=",ExpressionUUID->"cf28e423-2ebe-45fb-b0ca-d29053409711"],

Cell["\<\
PrintMinZGC[expr] prints the minimum z-values for all GCs in a collection of \
them. It\[CloseCurlyQuote]s a good way to see what the bottom of a collection \
of objects is and what the exceptions are.\
\>", "Text",
 CellChangeTimes->{{3.932834399324094*^9, 
  3.932834508180344*^9}},ExpressionUUID->"9cb8ed02-7ea5-4cde-a357-\
9e7f3dca8c47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PrintMinZGC", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gcs", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"expr", ",", "_GraphicsComplex", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"Print", "[", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Last", "/@", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         "]"}], "&"}], "/@", "gcs"}], "]"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9328344506275787`*^9, 3.9328344728142548`*^9}, {
  3.935062152612741*^9, 3.935062187476157*^9}},
 CellLabel->
  "In[4310]:=",ExpressionUUID->"ca127f81-bab3-4919-a319-efd0f787d7c6"]
}, Closed]],

Cell[CellGroupData[{

Cell["InsetBottomFaceTolerance", "Subsubsection",
 CellChangeTimes->{{3.9367071855312767`*^9, 
  3.936707203145547*^9}},ExpressionUUID->"714a8537-9768-4f18-b347-\
5e2dab45fc79"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InsetBottomFaceTolerance", "::", "usage"}], 
   "=", "\"\<InsetBottomFaceTolerance is an option to InsetBottomFaceUpwardGC \
that specifies the maximum angular deviation from straight-down allowed for a \
face to be inset upward.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.93670719263142*^9, 3.9367072394045153`*^9}},
 CellLabel->
  "In[4311]:=",ExpressionUUID->"91854aa3-c5f4-47aa-b4de-cf3f4a78d0ec"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "InsetBottomFaceUpwardGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nInsetBottomFaceUpwardGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) InsetBottomFaceTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.933971661853477*^9, 3.9339717106349163`*^9}, {
  3.93670724340446*^9, 3.936707250055814*^9}, {3.936707286396598*^9, 
  3.936707292744028*^9}},ExpressionUUID->"e7d8246b-79a3-48c4-83dc-\
de625313eefe"],

Cell[TextData[{
 "InsetBottomFaceUpwardGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "] finds the \[OpenCurlyDoubleQuote]bottom face\[CloseCurlyDoubleQuote] of a \
GC and shifts all of its vertices upward by a distance ",
 StyleBox["d",
  FontSlant->"Italic"],
 ". The \[OpenCurlyDoubleQuote]bottom face\[CloseCurlyDoubleQuote] is defined \
as the face incident to the lowest vertex whose face normal points most \
nearly straight down and is within the specified angle of being horizontal."
}], "Text",
 CellChangeTimes->{{3.933973468866159*^9, 3.933973533465391*^9}, {
  3.936707599504294*^9, 
  3.936707624673905*^9}},ExpressionUUID->"082af68d-b0f6-4c48-b35d-\
035bef0891ee"],

Cell["\<\
The use of this is for 3D printing where horizontal surface rest on a support \
structure and the bottom surface would end up lower (relative to other parts \
of the shape) that it is supposed to; this function allows you to do some \
compensation for that.\
\>", "Text",
 CellChangeTimes->{{3.933973544285822*^9, 
  3.933973632983583*^9}},ExpressionUUID->"2a5a08a6-08fb-4044-89df-\
262bd81aa5b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "InsetBottomFaceUpwardGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"InsetBottomFaceTolerance", "->", 
     RowBox[{"10.", "\[Degree]"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.936707256788622*^9, 3.936707280292535*^9}, 
   3.9367073263008003`*^9},
 CellLabel->
  "In[4312]:=",ExpressionUUID->"cf881e0c-1971-494a-a06b-2404a205d144"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsetBottomFaceUpwardGC", "[", 
   RowBox[{
    StyleBox["gc_GraphicsComplex",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["d_",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bft", ",", "bv", ",", "cfaces", ",", "cnorms", ",", "sface", ",", "vi", 
      ",", "gc1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bft", "=", 
      RowBox[{
       RowBox[{"InsetBottomFaceTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "InsetBottomFaceUpwardGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Find", " ", "the", " ", "lowest", " ", "vertex"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"bv", "=", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"gc", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "i", ",", "3"}], "\[RightDoubleBracket]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", 
              RowBox[{
              "gc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<", 
           
           RowBox[{
           "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "&"}]}], "]"}], "\[LeftDoubleBracket]", 
       RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Find", " ", "all", " ", "faces", " ", "that", " ", "contain", " ", 
       "that", " ", "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cfaces", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"First", "/@", 
         RowBox[{
         "gc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",", 
        
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"#", ",", "bv"}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Get", " ", "face", " ", "normals", " ", "of", " ", 
       RowBox[{"those", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cnorms", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"TriangleNormal3D", "[", 
         RowBox[{"gc", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", 
           RowBox[{"Take", "[", 
            RowBox[{"#", ",", "3"}], "]"}]}], "\[RightDoubleBracket]"}], 
         "]"}], "&"}], "/@", "cfaces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Sort", " ", "faces", " ", "by", " ", "the", " ", "z"}], "-", 
       RowBox[{
       "component", " ", "of", " ", "their", " ", "normaland", " ", "pick", " ",
         "the", " ", "one", " ", "that", " ", "points", " ", "the", " ", 
        "most", " ", 
        RowBox[{"downward", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sface", "=", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"cfaces", ",", 
            RowBox[{"Last", "/@", "cnorms"}]}], "}"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<", 
           
           RowBox[{
           "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "&"}]}], "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "But", " ", "if", " ", "its", " ", "normal", " ", "is", " ", "not", " ",
         "sufficiently", " ", "downward"}], ",", " ", 
       RowBox[{
        RowBox[{"don", "'"}], "t", " ", "do", " ", 
        RowBox[{"anything", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
         "sface", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "<", 
        RowBox[{"Cos", "[", "bft", "]"}]}], ",", 
       RowBox[{"Return", "[", "gc", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vi", "=", 
      RowBox[{
      "sface", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Shift", " ", "just", " ", "those", " ", "vertices", " ", "upward", " ",
        "by", " ", "the", " ", "specified", " ", 
       RowBox[{"distance", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gc1", "=", "gc"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gc1", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", 
          RowBox[{
          "vi", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
         "\[RightDoubleBracket]"}], "+=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "d"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "vi", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "gc1"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.933971815712206*^9, 3.9339718331084538`*^9}, {
   3.9339718918134193`*^9, 3.9339720286469717`*^9}, 3.9339720687650423`*^9, {
   3.93397211714116*^9, 3.933972156582819*^9}, {3.933972192093177*^9, 
   3.933972390438985*^9}, {3.933972452255372*^9, 3.9339727992981243`*^9}, {
   3.933972923431244*^9, 3.933973001078034*^9}, {3.936707311118615*^9, 
   3.936707346350211*^9}, {3.936707482515706*^9, 3.936707517379949*^9}, {
   3.936707656862405*^9, 3.93670773918608*^9}, {3.9367080545273867`*^9, 
   3.936708158647615*^9}, {3.93670822518117*^9, 3.936708253554446*^9}, 
   3.9367086098677063`*^9},
 CellLabel->
  "In[4313]:=",ExpressionUUID->"0b80ad0f-d82e-4271-af05-605e39b8678d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsetBottomFaceUpwardGC", "[", 
   RowBox[{"expr_", ",", "d_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{
    RowBox[{"GraphicsComplex", "[", "x___", "]"}], ":>", 
    RowBox[{"InsetBottomFaceUpwardGC", "[", 
     RowBox[{
      RowBox[{"GraphicsComplex", "[", "x", "]"}], ",", "d"}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.933973115500239*^9, 3.933973183128389*^9}, {
  3.933973261140396*^9, 3.933973268114472*^9}, {3.933973305328287*^9, 
  3.93397330552958*^9}, {3.9367082004063463`*^9, 3.9367082018528557`*^9}},
 CellLabel->
  "In[4314]:=",ExpressionUUID->"5ebfa22a-8440-4cab-a276-a77acd9bf5b4"],

Cell["Example. A slightly rotated cube.", "Text",
 CellChangeTimes->{{3.933973198923472*^9, 3.933973199979767*^9}, {
  3.936708358086618*^9, 
  3.936708361469431*^9}},ExpressionUUID->"0123438f-f204-4647-affd-\
f7c8d4afb31f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cube", ",", "cube1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cube", "=", 
      RowBox[{"TransformGC", "[", 
       RowBox[{
        RowBox[{"MakeCubeGC", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"Rotate3D", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"-", "5."}], "\[Degree]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cube1", "=", 
      RowBox[{"InsetBottomFaceUpwardGC", "[", 
       RowBox[{"cube", ",", "0.1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"cube", ",", "LightBlue", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{"cube1", ",", "Pink", ",", 
          RowBox[{"Opacity", "[", ".5", "]"}]}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.933972033489869*^9, 3.933972081250012*^9}, {
   3.933972402427269*^9, 3.933972442701798*^9}, {3.933972803141638*^9, 
   3.933972848501624*^9}, {3.933973036067955*^9, 3.9339731026890078`*^9}, {
   3.933973221673428*^9, 3.9339732234714327`*^9}, 3.936707356907341*^9, {
   3.936708275457425*^9, 3.936708283104506*^9}, {3.936708333453919*^9, 
   3.9367084655062017`*^9}, 3.936708551577962*^9, 3.936708634858242*^9},
 CellLabel->
  "In[4315]:=",ExpressionUUID->"550f0a1c-918c-4950-892c-217e56be7164"],

Cell["Example. Same thing, but now applied to an expression.", "Text",
 CellChangeTimes->{{3.933973188482749*^9, 3.93397318954064*^9}, {
  3.9367085177347813`*^9, 
  3.936708535652687*^9}},ExpressionUUID->"d6a47e1b-aec7-4e0d-a258-\
e1dbbacce6aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cube", ",", "cube1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cube", "=", 
      RowBox[{"{", 
       RowBox[{"MakeCubeGC", "[", "]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"cube1", "=", 
      RowBox[{"InsetBottomFaceUpwardGC", "[", 
       RowBox[{
        RowBox[{"{", "cube", "}"}], ",", "0.1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"cube", ",", "LightBlue", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{"cube1", ",", "Pink", ",", 
          RowBox[{"Opacity", "[", ".5", "]"}]}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.933972033489869*^9, 3.933972081250012*^9}, {
   3.933972402427269*^9, 3.933972442701798*^9}, {3.933972803141638*^9, 
   3.933972848501624*^9}, {3.933973036067955*^9, 3.9339731026890078`*^9}, {
   3.933973211658725*^9, 3.9339732185240602`*^9}, {3.933973313452156*^9, 
   3.933973315317379*^9}, 3.9367073585468407`*^9, {3.936708512468266*^9, 
   3.9367085489451323`*^9}, 3.9367086300926857`*^9},
 CellLabel->
  "In[4316]:=",ExpressionUUID->"27348729-6ba0-4d46-92a5-deaff7dc020e"],

Cell["\<\
Example. Set a low tolerance on insetting so there should be no insetting.\
\>", "Text",
 CellChangeTimes->{{3.933973198923472*^9, 3.933973199979767*^9}, {
  3.936708358086618*^9, 3.936708361469431*^9}, {3.936708574380765*^9, 
  3.9367086191891108`*^9}},ExpressionUUID->"5c6cda5c-7317-48c3-b122-\
8b2ee5e34c5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cube", ",", "cube1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cube", "=", 
      RowBox[{"TransformGC", "[", 
       RowBox[{
        RowBox[{"MakeCubeGC", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"Rotate3D", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"-", "5."}], "\[Degree]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cube1", "=", 
      RowBox[{"InsetBottomFaceUpwardGC", "[", 
       RowBox[{"cube", ",", "0.1", ",", 
        RowBox[{"InsetBottomFaceTolerance", "->", 
         RowBox[{"4.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"cube", ",", "LightBlue", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{"cube1", ",", "Pink", ",", 
          RowBox[{"Opacity", "[", ".5", "]"}]}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.933972033489869*^9, 3.933972081250012*^9}, {
   3.933972402427269*^9, 3.933972442701798*^9}, {3.933972803141638*^9, 
   3.933972848501624*^9}, {3.933973036067955*^9, 3.9339731026890078`*^9}, {
   3.933973221673428*^9, 3.9339732234714327`*^9}, 3.936707356907341*^9, {
   3.936708275457425*^9, 3.936708283104506*^9}, {3.936708333453919*^9, 
   3.9367084655062017`*^9}, 3.936708551577962*^9, {3.9367085837996073`*^9, 
   3.936708625204082*^9}},
 CellLabel->
  "In[4317]:=",ExpressionUUID->"386e78b8-1149-4a1a-8961-d0f82ce7c5b4"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Exploding and scaling", "Subsection",
 CellChangeTimes->{{3.911990913588249*^9, 3.911990918206332*^9}, {
   3.911993603410439*^9, 3.911993604579329*^9}, 3.914837194450379*^9, {
   3.914838377274084*^9, 3.914838397953109*^9}, {3.9226322612852993`*^9, 
   3.922632293297476*^9}},ExpressionUUID->"892262cf-2f99-46ef-8847-\
40a85a6f4664"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.9148376006227493`*^9, 
  3.914837603076758*^9}},ExpressionUUID->"5d33c4eb-45d9-48a0-9604-\
07205c0a50bd"],

Cell["\<\
In contrast to the preceding functions, which effect changes on individual \
GraphicsComplex polyhedra, these functions act on collections of GC polyhedra \
(e.g., entire complexes of multiple polyhedra).\
\>", "Text",
 CellChangeTimes->{{3.914837605910839*^9, 
  3.9148376447680798`*^9}},ExpressionUUID->"6d679cb4-44d3-4c09-82c7-\
ff8fb8411a2b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "BoxRatiosGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.9671208217375803`*^9, 
  3.967120826271968*^9}},ExpressionUUID->"6bb96b81-baa8-4c34-86f8-\
63d1847a7697"],

Cell[TextData[{
 "BoxRatiosGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] explicitly computes a BoxRatios setting for an expression containing \
multiple GraphicsComplex polyhedra, which can be passed to Graphics3D. This \
is to overcome a bug in Mathematica 14.3+ in which Graphics3D rendering of \
collections of GraphicsComplex polyhedra sometimes inexplicably ignored \
BoxRatios\[Rule]Automatic settings, resulting in weird aspect ratios in \
rendered figures."
}], "Text",
 CellChangeTimes->{{3.967120828847756*^9, 
  3.9671209928420267`*^9}},ExpressionUUID->"0945dd44-cf54-4aa3-80d8-\
707df0e444eb"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any expression containing GraphicsComplex objects."
}], "Text",
 CellChangeTimes->{{3.967127683977919*^9, 
  3.967127697712047*^9}},ExpressionUUID->"a84ffd53-b3ba-4183-925c-\
020b0a716a13"],

Cell[TextData[{
 "Returns: a trio of {",
 StyleBox["length",
  FontSlant->"Italic"],
 ", ",
 StyleBox["width",
  FontSlant->"Italic"],
 ", ",
 StyleBox["height",
  FontSlant->"Italic"],
 "}, suitable as an argument to BoxRatios in Graphics3D."
}], "Text",
 CellChangeTimes->{{3.9671277005617847`*^9, 
  3.967127727087747*^9}},ExpressionUUID->"a925011f-3b27-4c16-a349-\
9f767a9f2dc9"],

Cell["\<\
If Mathematica fixes this bug in a future version (they are aware of it), \
then this function won\[CloseCurlyQuote]t be needed.\
\>", "Text",
 CellChangeTimes->{{3.96712100207302*^9, 
  3.9671210210217943`*^9}},ExpressionUUID->"c1b457e7-f3ab-4534-ba1c-\
1d0b051adcc8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BoxRatiosGC", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "pts", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pts", "=", 
       RowBox[{"Join", "@@", 
        RowBox[{"(", 
         RowBox[{"First", "/@", 
          RowBox[{"Cases", "[", 
           RowBox[{"expr", ",", "_GraphicsComplex", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#", "]"}], "-", 
         RowBox[{"Min", "[", "#", "]"}]}], "&"}], "/@", 
       RowBox[{"Transpose", "[", "pts", "]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.967121022505992*^9, 3.967121084583926*^9}, {
  3.967121137954403*^9, 3.967121159152748*^9}, {3.9671275340730124`*^9, 
  3.967127642844667*^9}, {3.9671276751125298`*^9, 3.9671276762829123`*^9}},
 CellLabel->
  "In[4318]:=",ExpressionUUID->"d1946c80-de22-425b-9395-b6863f4353c4"],

Cell["Example. Two pyramids.", "Text",
 CellChangeTimes->{{3.91193528992109*^9, 3.911935292380048*^9}, {
  3.911979216928957*^9, 3.9119792234357967`*^9}, {3.9671212574741077`*^9, 
  3.9671212582599993`*^9}},ExpressionUUID->"566bca00-81e4-4501-b007-\
12492117c580"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gclist", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gclist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"TransformGC", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1.2", ",", "1.4", ",", "0"}], "}"}], "+", "#"}], 
             "&"}]}], "]"}]}], "}"}], "&"}], "[", 
       RowBox[{"GraphicsComplex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
         RowBox[{"Polygon", "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "4", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "3", ",", "4"}], "}"}]}], "}"}]}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"gclist", ",", 
        RowBox[{"Axes", "->", "True"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"BoxRatiosGC", "[", "gclist", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.91199310819886*^9, 3.911993136887628*^9}, {
   3.9119934345183363`*^9, 3.911993475177412*^9}, {3.91483774817982*^9, 
   3.914837750136471*^9}, {3.935323747714641*^9, 3.935323849161936*^9}, {
   3.967121109520458*^9, 3.9671211509278107`*^9}, {3.9671212719072313`*^9, 
   3.9671213783573093`*^9}, 3.9671275259173117`*^9, {3.967127664425356*^9, 
   3.967127667840678*^9}, {3.9671277627885103`*^9, 3.967127766163765*^9}},
 CellLabel->
  "In[4319]:=",ExpressionUUID->"ef8b5960-4b08-4264-89f7-4d5e1f10b722"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ExplodeGCs[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["amt, opts",
  FontSlant->"Italic"],
 "]\n\t(options) ExplodeGCsXYOnly"
}], "Subsubsection",
 CellChangeTimes->{{3.911934651642504*^9, 3.911934670625604*^9}, {
  3.911934703183304*^9, 3.911934732351756*^9}, {3.911935165571422*^9, 
  3.9119351674744053`*^9}, {3.911993497743921*^9, 3.911993510157792*^9}, {
  3.9353235531763144`*^9, 3.935323554867176*^9}, {3.935323607299818*^9, 
  3.93532361598748*^9}},ExpressionUUID->"0879e5db-4f3d-4eab-86b9-\
8c17fc39e2d4"],

Cell[TextData[{
 "ExplodeGCs[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["amt",
  FontSlant->"Italic"],
 "] takes a list of GraphicsComplex objects and moves them apart by a factor ",
 StyleBox["amt",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.911934736559162*^9, 3.911934812791178*^9}, 
   3.911935172546784*^9, {3.911993497774288*^9, 
   3.911993514472266*^9}},ExpressionUUID->"b4597c50-9c7b-4b40-bebc-\
e61a4e2ce16b"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] an expression containing GraphicsComplex objects that will be \
exploded.\n\t",
 StyleBox["amt",
  FontSlant->"Italic"],
 " \[LongDash] the relative factor of explosion, which should be \
\[GreaterEqual]1."
}], "Text",
 CellChangeTimes->{{3.911934875589912*^9, 3.911934904191231*^9}, {
  3.911993524527987*^9, 3.91199353773415*^9}, {3.913540994616561*^9, 
  3.913541016689732*^9}},ExpressionUUID->"54c05a4b-12fe-4a9d-8cda-\
c42761c80592"],

Cell["\<\
Options:
\tExplodeGCsXYOnly \[Rule] True | False, whether to restrict shifts to the \
x-y plane.\
\>", "Text",
 CellChangeTimes->{{3.935323558385858*^9, 
  3.9353235993638144`*^9}},ExpressionUUID->"3be5cf29-c621-4f1b-8df3-\
6938dde968a4"],

Cell[TextData[{
 "Returns: a revised ",
 StyleBox["expr",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.911934914014236*^9, 3.91193491900632*^9}, {
  3.911993544309197*^9, 
  3.911993544792849*^9}},ExpressionUUID->"3c659744-ffb1-4a96-a952-\
f05773913251"],

Cell[TextData[{
 "The algorithm is to find the centroid of each GC, then find the centroid of \
the centroids. Characterize each GC by the distance of its centroid from the \
overall centroid. Shift each GC along the direction it currently is from the \
overall centroid by the factor ",
 StyleBox["amt",
  FontSlant->"Italic"],
 " relative to its initial position."
}], "Text",
 CellChangeTimes->{{3.911934928476117*^9, 3.91193494704009*^9}, {
   3.9119349795978613`*^9, 3.911935098058558*^9}, 3.911935131274499*^9, {
   3.911993553858776*^9, 
   3.9119935543253202`*^9}},ExpressionUUID->"955df680-6dc4-4c90-b9d7-\
deabe6d27254"],

Cell["\<\
This is useful for examining the individual elements of tightly packed \
collections of GCs.\
\>", "Text",
 CellChangeTimes->{{3.911934833287225*^9, 3.911934864065262*^9}, 
   3.9148377445800247`*^9},ExpressionUUID->"55d77a78-63e8-4b4d-8331-\
edf1ff347a93"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExplodeGCsXYOnly", "::", "usage"}], 
   "=", "\"\<ExplodeGCsXYOnly is an option to ExplodeGCs that restricts the \
explosion shifts to the XY plane.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9353236254961967`*^9, 3.9353236510593*^9}},
 CellLabel->
  "In[4320]:=",ExpressionUUID->"5cabc7b1-78ff-42fe-84f2-74994e2fa4a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ExplodeGCs", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"ExplodeGCsXYOnly", "->", "False"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.935323660470872*^9, 3.935323681334629*^9}},
 CellLabel->
  "In[4321]:=",ExpressionUUID->"c26486a5-a0aa-443a-8f71-5214bb6ee4e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExplodeGCs", "[", 
   RowBox[{"expr_", ",", "amt_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xyo", ",", "ctrds", ",", "ctrd"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xyo", "=", 
      RowBox[{
       RowBox[{"ExplodeGCsXYOnly", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExplodeGCs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Centroids", " ", "of", " ", "all", " ", "GC", " ", 
       RowBox[{"objects", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ctrds", "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"Plus", "@@", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         RowBox[{"Length", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}]], "&"}], "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"expr", ",", "_GraphicsComplex", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Centroid", " ", "of", " ", "the", " ", "centroids"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ctrd", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Plus", "@@", "ctrds"}], ")"}], "/", 
       RowBox[{"Length", "[", "ctrds", "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
      "Shift", " ", "all", " ", "GCs", " ", "by", " ", "offsetting", " ", 
       "each", " ", "point", " ", "by", " ", "a", " ", "scaled", " ", 
       "version", " ", "of", " ", "the", " ", "centroid", " ", "offset"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"expr", "/.", 
      RowBox[{
       RowBox[{"GraphicsComplex", "[", 
        RowBox[{"pts_", ",", "more___"}], "]"}], ":>", 
       RowBox[{"GraphicsComplex", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{"xyo", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "]"}], 
             RowBox[{"(", 
              RowBox[{
               FractionBox[
                RowBox[{"Plus", "@@", "pts"}], 
                RowBox[{"Length", "[", "pts", "]"}]], "-", "ctrd"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"amt", "-", "1"}], ")"}]}], "+", "#"}], "&"}], "/@", 
          "pts"}], ",", "more"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.911992905679556*^9, 3.911992971880602*^9}, {
   3.911993005010691*^9, 3.911993008949828*^9}, {3.911993040367276*^9, 
   3.911993082530863*^9}, {3.91199312297731*^9, 3.91199312634956*^9}, {
   3.911993185000105*^9, 3.911993213824091*^9}, {3.911993252426499*^9, 
   3.9119934237005*^9}, 3.91199346997869*^9, {3.911993572433177*^9, 
   3.911993582446413*^9}, {3.935323655797597*^9, 3.9353237393002*^9}},
 CellLabel->
  "In[4322]:=",ExpressionUUID->"65dcf984-4aac-4154-b69c-9e7b85689622"],

Cell["Example. Two touching pyramids.", "Text",
 CellChangeTimes->{{3.91193528992109*^9, 3.911935292380048*^9}, {
  3.911979216928957*^9, 
  3.9119792234357967`*^9}},ExpressionUUID->"740c2c87-a2e0-43d6-b099-\
e2ebb203d5a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gclist", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gclist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphicsComplex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "4", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "3", ",", "4"}], "}"}]}], "}"}]}]}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"GraphicsComplex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "4", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "3", ",", "4"}], "}"}]}], "}"}]}]}], "]"}]}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"gclist", ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<before\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"ExplodeGCs", "[", 
           RowBox[{"gclist", ",", "2.0"}], "]"}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<after\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"ExplodeGCs", "[", 
           RowBox[{"gclist", ",", "2.0", ",", 
            RowBox[{"ExplodeGCsXYOnly", "->", "True"}]}], "]"}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<xy only\>\""}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.91199310819886*^9, 3.911993136887628*^9}, {
  3.9119934345183363`*^9, 3.911993475177412*^9}, {3.91483774817982*^9, 
  3.914837750136471*^9}, {3.935323747714641*^9, 3.935323849161936*^9}},
 CellLabel->
  "In[4323]:=",ExpressionUUID->"6bedb6a5-5c98-41ae-afc7-9c9cc271e775"]
}, Closed]],

