c683986f47f0"],

Cell[TextData[{
 "StyledCurvedFoldOptical[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", {",
 StyleBox["cl, cr",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["bl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["br",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["dl, dr",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a graphical representation of a curved fold in optical style, \
with left and right cross curve phase fronts and ruling lines. It draws \
ruling lines from the cross curves to the fold and draws virtual rays from \
the directrices to the fold."
}], "Text",
 CellChangeTimes->{{3.597679832574546*^9, 3.59768013428932*^9}, {
   3.59768141252602*^9, 3.597681420413231*^9}, {3.597692737918897*^9, 
   3.5976928540147953`*^9}, {3.597697491467472*^9, 3.597697530833322*^9}, {
   3.68942096493208*^9, 3.689421072094565*^9}, {3.689421105519108*^9, 
   3.689421116867865*^9}, {3.68942117011675*^9, 3.689421198874342*^9}, {
   3.6894282832653017`*^9, 3.689428312545267*^9}, 3.689428402886383*^9, {
   3.689428485768089*^9, 3.689428512748381*^9}, {3.689428710628743*^9, 
   3.689428727609211*^9}, {3.689431212601534*^9, 3.68943121490416*^9}, {
   3.6894317208276057`*^9, 3.689431781008799*^9}, {3.689432609359009*^9, 
   3.689432670550655*^9}, 3.691524101984056*^9, {3.692184515512373*^9, 
   3.692184517594835*^9}, {3.692184588199212*^9, 3.692184621217136*^9}, {
   3.692198018586148*^9, 3.692198018589306*^9}, {3.692198113230746*^9, 
   3.6921981322795053`*^9}, {3.69219986464995*^9, 3.692199895137217*^9}, 
   3.692201022357416*^9, {3.692201390781775*^9, 3.692201414879765*^9}, {
   3.692201486827338*^9, 3.692201488166936*^9}, {3.692201718175451*^9, 
   3.692201762186385*^9}, 3.692204257296817*^9, 3.69220448369566*^9, 
   3.6922048007607193`*^9, 3.692205844474471*^9, {3.800014092488187*^9, 
   3.800014107975211*^9}},ExpressionUUID->"6256c63f-d59d-4065-bc43-\
8ab956c81cb6"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the curved fold line as a pure function.\n\t{",
 StyleBox["cl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cr",
  FontSlant->"Italic"],
 "} \[LongDash] the left and right cross curves, as pure functions.\n\t{",
 StyleBox["bl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["br",
  FontSlant->"Italic"],
 "} \[LongDash] the left and right directrices, as pure functions.\n\t{",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t1",
  FontSlant->"Italic"],
 "} specifies the range of the parameters for all curves."
}], "Text",
 CellChangeTimes->{{3.692184623987392*^9, 3.692184644064939*^9}, {
  3.692198018596112*^9, 3.692198018600329*^9}, {3.692198143104441*^9, 
  3.692198168336187*^9}, {3.692199906405621*^9, 3.692199925112428*^9}, {
  3.692201040368391*^9, 3.692201070694245*^9}, {3.692204295102268*^9, 
  3.692204309779869*^9}, {3.800014092512209*^9, 
  3.800014108000918*^9}},ExpressionUUID->"3f4508be-6d92-42e5-a78f-\
9528b885b7f1"],

Cell[TextData[{
 "Options:\n\tFoldLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the fold line.\n\tDirectrixLeftStyle \[Rule] \
",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the left directrix.\n\tDirectrixRightStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the right directrix.\n\t\
DirectrixLeftPointStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the left directrix as a point.\n\t\
DirectrixRightPointStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the right directrix as a point.\n\t\
CrossCurveLeftStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the left cross curve.\n\tCrossCurveRightStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the right cross curve.\n\tRulingLineLeftStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the left ruling lines from cross curve to \
fold.\n\tRulingLineRightStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the right ruling lines from cross curve to \
fold.\n\tVirtualLineLeftStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the left virtual source lines from left \
directrix to fold.\n\tVirtualLineRightStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the right virtual source lines from right \
directrix to fold.\n\tCurveDivisions, RulingLineDivisions, FillStyle, \
SurfaceOrientation are passed through to StyledCurvedFoldBounded."
}], "Text",
 CellChangeTimes->{{3.692184591773707*^9, 3.69218459380928*^9}, {
