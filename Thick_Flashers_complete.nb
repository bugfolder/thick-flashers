Cell[TextData[{
 "FlasherSectorFoldedFoldLines[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "] returns a list of styled fold lines for the sharp and medium folds, but \
doesn\[CloseCurlyQuote]t include any if the diagonal folds that cross quads \
that are only slightly folded."
}], "Text",
 CellChangeTimes->{{3.5557886496219797`*^9, 3.555788686714507*^9}, 
   3.5558543055183*^9, 3.555854344085237*^9, {3.5559545429198093`*^9, 
