Cell["Example. Tiling, crease pattern, and folded form.", "Text",
 CellChangeTimes->{{3.629848764316999*^9, 
  3.62984877231464*^9}},ExpressionUUID->"c3881ca3-b031-424c-a023-\
3765ec98e6bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "\[Theta]1", ",", "\[Theta]2", ",", "i1", ",", "i2", ",", "w", 
      ",", "d", ",", "types", ",", "tiling"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]1", "=", 
      RowBox[{"110", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]2", "=", 
      RowBox[{"90", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"i1", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"i2", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.15"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"M", ",", 
        RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"UnitCyclicBrocardPolygonOffsetTwistTile", ",", 
            RowBox[{"{", 
             RowBox[{
             "n", ",", "\[Theta]1", ",", "\[Theta]2", ",", "i1", ",", "i2"}], 
             "}"}], ",", "w", ",", "d", ",", "types"}], "}"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"UnitCyclicBrocardPolygonOffsetTwistTile", ",", 
             RowBox[{"{", 
              RowBox[{
              "n", ",", "\[Theta]1", ",", "\[Theta]2", ",", "i1", ",", "i2"}],
               "}"}], ",", "w", ",", 
             RowBox[{"-", "d"}], ",", "types"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "Tiling", ",", 
             RowBox[{"TilePolys", "\[Rule]", "True"}], ",", 
             RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowDF"}]}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
