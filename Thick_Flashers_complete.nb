Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTwistedPot", "[", 
   RowBox[{
   "pts_List", ",", "m_", ",", "\[Rho]_", ",", "\[Tau]_", ",", " ", 
    "\[Zeta]_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pff", ",", "\[Epsilon]", ",", "pb", ",", "pt", ",", "\[Phi]", ",", "nn",
       ",", "pts1", ",", "x", ",", "z", ",", "w", ",", "rg", ",", "R2", ",", 
      "R2p", ",", "R2m", ",", "R3", ",", "R3p", ",", "R3m", ",", "rfl", ",", 
      "p", ",", "pp", ",", "q", ",", "qq", ",", "r", ",", "rr", ",", "\[Xi]", 
      ",", "v\[Xi]", ",", "vp", ",", "vpp", ",", "vr", ",", "vrr", ",", "vr0",
       ",", "rx", ",", "ry", ",", "dv", ",", "dp", ",", "dm", ",", "dh", ",", 
      "eqns", ",", "soln", ",", "fn", ",", "vq", ",", "vqq", ",", "vq0", ",", 
      "vqq0", ",", "t", ",", "tx", ",", "ty", ",", "tz", ",", "eqns1", " ", ",",
       "vars", ",", "fom", ",", "cp", ",", "ff", ",", "ifc", ",", "addifc", ",",
       "cc", ",", "\[IndentingNewLine]", "verts", ",", "edges", ",", "types", 
      ",", "verts3d", ",", "foldangles", ",", "ev", ",", "addv", ",", "addet",
       ",", "vi", ",", "ei", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Rho]", "\[Equal]", "1"}], "||", 
          RowBox[{"\[Rho]", "\[Equal]", 
           RowBox[{"-", "1"}]}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTwistedPot", "::", "badrho"}], ",", "\[Rho]"}], "]"}], 
        ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Tau]", "\[Equal]", "1"}], "||", 
          RowBox[{"\[Tau]", "\[Equal]", 
           RowBox[{"-", "1"}]}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTwistedPot", "::", "badtau"}], ",", "\[Tau]"}], "]"}], 
        ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pff", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"PotFlatFlanges", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "MakeTwistedPot", "]"}]}], ")"}], "===", 
       "PotFlatFlangesFaceted"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]", "=", 
      RowBox[{
       RowBox[{"PotFlatFlangeInset", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTwistedPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{
       RowBox[{"PotBorder", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTwistedPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pt", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{
       "pb", ",", "\[IndentingNewLine]", "PotTrimmed", ",", "True", ",", 
        "\[IndentingNewLine]", "PotPlanar", ",", "False", ",", 
        "\[IndentingNewLine]", "_", ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"MakeTwistedPot", "::", "badbord"}], ",", "pb"}], "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "-", 
          RowBox[{
          "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         "&"}], "/@", "pts"}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "z"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "pts1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"test", " ", "for", " ", "flat"}], "-", 
       RowBox[{"bottom", " ", "condition"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[NotEqual]", 
        RowBox[{"z", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
        ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTwistedPot", "::", "notflat"}], ",", "pts"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "test", " ", "for", " ", "strict", " ", "monotonicity", " ", "in", " ", 
       
       RowBox[{"z", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"zinc", " ", "=", " ", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RotateLeft", "[", "z", "]"}], "-", "z"}], ",", 
           RowBox[{"-", "1"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "zinc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]",
            "0"}], ",", 
          RowBox[{"zinc", "=", 
           RowBox[{"Drop", "[", 
            RowBox[{"zinc", ",", "1"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Union", "[", 
             RowBox[{"Sign", "/@", "zinc"}], "]"}], "]"}], ">", "1"}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"MakeTwistedPot", "::", "badpts"}], ",", "pts"}], "]"}], 
           ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", 
      RowBox[{
       RowBox[{"Tan", "[", "\[Phi]", "]"}], "x"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"gore", " ", "half"}], "-", "width"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rg", " ", "is", " ", "cumulative", " ", "distance", " ", "along", " ", 
       "ctr", " ", "of", " ", "gore"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rg", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Accumulate", "[", 
         RowBox[{"Mag", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"pts", ",", "1"}], "]"}], "-", 
            RowBox[{"Drop", "[", 
             RowBox[{"pts", ",", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}]}], "]"}], ",", "0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Assorted", " ", "useful", " ", "rotation", " ", "stuff"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"R2", "[", "j_", "]"}], ":=", 
      RowBox[{
       RowBox[{"RotationMatrix2D", "[", 
        RowBox[{"2", "j", " ", "\[Phi]"}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"R2p", "=", 
      RowBox[{"R2", "[", "1", "]"}]}], ";", 
     RowBox[{"R2m", "=", 
      RowBox[{"R2", "[", 
       RowBox[{"-", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"R3", "[", "j_", "]"}], ":=", 
      RowBox[{
       RowBox[{"RotationZMatrix3D", "[", 
        RowBox[{"2", "j", " ", "\[Phi]"}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"R3p", "=", 
      RowBox[{"R3", "[", "1", "]"}]}], ";", 
     RowBox[{"R3m", "=", 
      RowBox[{"R3", "[", 
       RowBox[{"-", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rfl", "=", 
      RowBox[{
       RowBox[{"U", "[", 
        RowBox[{"\[Phi]", "+", "\[Zeta]"}], "]"}], "//", "N"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "direction", " ", "vector", " ", "for", " ", "straight", " ", "flange", 
       " ", "fold"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{"Solve", " ", "for", " ", "the", " ", "gore", " ", "points", " ", 
       RowBox[{"(", 
        RowBox[{"p", ",", " ", "pp", ",", " ", "r", ",", " ", "rr"}], ")"}], " ",
        "by", " ", "forcing", " ", 
       RowBox[{"isometry", ".", " ", "We"}], " ", "choose", " ", "which", " ",
        "diagonal", " ", "of", " ", "the", " ", "quad", " ", "to", " ", 
       "force", " ", "isometric", " ", "based", " ", "on", " ", 
       RowBox[{"\[Tau]", "."}]}], "\[IndentingNewLine]", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"q", "=", 
       RowBox[{"r", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], "}"}]}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"center", " ", "of", " ", "cp"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"pp", "=", 
      RowBox[{"qq", "=", 
       RowBox[{"rr", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], "}"}]}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"center", " ", "of", " ", "ff"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Xi]", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"corner", " ", "of", " ", "base"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"p", ",", "#"}], "]"}], ";", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"q", ",", "#"}], "]"}], ";", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"r", ",", "#"}], "]"}]}], ")"}], "&"}], "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
        RowBox[{"w", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
        "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"pp", ",", "#"}], "]"}], ";", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"qq", ",", "#"}], "]"}], ";", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"rr", ",", "#"}], "]"}]}], ")"}], "&"}], "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
        RowBox[{"w", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
         "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"For", " ", "subsequent", " ", "r"}], "-", " ", 
        RowBox[{"and", " ", "p"}], "-", "points"}], ",", " ", 
       RowBox[{"solve", " ", "isometry", " ", "conditions"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"vr", "=", 
         RowBox[{"{", 
          RowBox[{"rx", ",", "ry"}], "}"}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"next", " ", "r"}], "-", "point"}], ",", " ", 
          RowBox[{"parameterized", " ", "on", " ", "rx"}], ",", " ", "ry"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"vp", "=", 
         RowBox[{"Reflect2D", "[", 
          RowBox[{"vr", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "r", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
             RowBox[{
              RowBox[{
              "r", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "+",
               "rfl"}]}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"next", " ", "p"}], "-", "point"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"vrr", "=", 
         RowBox[{"vpp", "=", 
          RowBox[{
           RowBox[{"RotationZMatrix3D", "[", "v\[Xi]", "]"}], ".", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "x", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "w", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "z", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
            "}"}]}]}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{"twisted", " ", "3", "D", " ", "vertices", " ", "coincide"}],
          " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"isometry", " ", "conditions"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"dv", "=", 
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{"vr", "-", 
            RowBox[{"r", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "-", 
          RowBox[{"Mag", "[", 
           RowBox[{"vrr", "-", 
            RowBox[{"rr", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}]}], ";", 
        
        RowBox[{"(*", " ", 
         RowBox[{"radial", " ", "fold"}], " ", "*)"}], "\[IndentingNewLine]", 
        
        RowBox[{"dp", "=", 
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{"vr", "-", 
            RowBox[{"R2p", ".", 
             RowBox[{"p", "\[LeftDoubleBracket]", 
              RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}]}], "]"}], "-", 
          RowBox[{"Mag", "[", 
           RowBox[{"vrr", "-", 
            RowBox[{"R3p", ".", 
             RowBox[{"pp", "\[LeftDoubleBracket]", 
              RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}]}], "]"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"uphill", " ", "diagonal"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"dm", "=", 
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{
            RowBox[{"R2p", ".", "vp"}], "-", 
            RowBox[{"r", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "-", 
          RowBox[{"Mag", "[", 
           RowBox[{
            RowBox[{"R3p", ".", "vpp"}], "-", 
            RowBox[{"rr", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}]}], ";", 
        
        RowBox[{"(*", " ", 
         RowBox[{"downhill", " ", "diagonal"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"dh", "=", 
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{"vr", "-", 
            RowBox[{"R2p", ".", "vp"}]}], "]"}], "-", 
          RowBox[{"Mag", "[", 
           RowBox[{"vrr", "-", 
            RowBox[{"R3p", ".", "vpp"}]}], "]"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"axial", " ", "fold"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"eqns", "=", 
         RowBox[{"{", 
          RowBox[{"dv", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"\[Tau]", "\[Equal]", "1"}], ",", "dm", ",", "dp"}], 
            "]"}], " ", ",", "dh"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vr0", "=", 
         RowBox[{
          RowBox[{"r", "\[LeftDoubleBracket]", 
           RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}], "+", 
          RowBox[{"0.1", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "rg", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "-", 
             RowBox[{"rg", "\[LeftDoubleBracket]", 
              RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}]}], ")"}], 
           "rfl"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "initial", " ", "guess", " ", "for", " ", "next", " ", "r"}], "-", 
          "point"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"soln", "=", 
         RowBox[{"FindRoot", "[", 
          RowBox[{"eqns", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rx", ",", 
               RowBox[{
               "vr0", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"ry", ",", 
               RowBox[{
               "vr0", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"v\[Xi]", ",", 
               RowBox[{"\[Xi]", "\[LeftDoubleBracket]", 
                RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}],
             "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Plus", "@@", 
            RowBox[{"Abs", "/@", 
             RowBox[{"(", 
              RowBox[{"eqns", "/.", "soln"}], ")"}]}]}], ">", 
           SuperscriptBox["10", 
            RowBox[{"-", "6"}]]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
