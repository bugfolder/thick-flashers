Cell["Example with a FunctionInterpolationAlt function.", "Text",
 CellChangeTimes->{{3.79933085891672*^9, 3.799330876517127*^9}, 
   3.801733050192178*^9},ExpressionUUID->"93016f33-6619-4337-b109-\
2c49affe9e24"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "f", ",", "ff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "t", "]"}], ",", 
          RowBox[{"Sin", "[", "t", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
