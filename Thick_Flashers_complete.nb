Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "VeneerScoringGraphics", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ImageWidth", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ImageHeight", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"VeneerThickness", "\[Rule]", "2.3"}], " ", ",", 
     RowBox[{"(*", " ", 
      RowBox[{"=", " ", 
       RowBox[{"32", " ", "mil"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"MultilineSpacing", "\[Rule]", "0.5"}], ",", 
     RowBox[{"(*", " ", 
      RowBox[{
      "maximum", " ", "spacing", " ", "for", " ", "kerf", " ", "lines"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"InvertFolds", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"FoldAngles", "\[Rule]", "Automatic"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
