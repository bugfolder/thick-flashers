Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "FoldCurvedFold3D", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.79944345788535*^9, 3.7994434660770397`*^9}, 
   3.7995128144069*^9, 3.799530296608669*^9, 3.8016582439173803`*^9},
 CellLabel->
  "In[3968]:=",ExpressionUUID->"6351cff5-5b6d-4e49-bf2d-60cd5f0a93cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldCurvedFold3D", "[", 
   RowBox[{"f_Function", ",", "rL_Function", ",", "rR_Function", ",", 
    RowBox[{"{", 
     RowBox[{
     "ui_", ",", "\[Gamma]i_", ",", "ffi_", ",", "tti_", ",", "bbti_"}], 
     "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "dsopts", ",", "c2dsys", ",",
       "ds", ",", "\[Kappa]l", ",", "t", ",", "l", ",", "cot\[Rho]L", ",", 
      "cot\[Rho]R", ",", "\[Gamma]", ",", "soln", ",", "\[Tau]", ",", 
      "\[Kappa]", ",", "c3dsys", ",", "ff", ",", "tt", ",", "nn", ",", "bb", ",",
       "\[FinalSigma]", ",", "llL", ",", "\[Kappa]g", ",", "\[Kappa]n", ",", 
      "\[Tau]g", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "rrL", ",", "llR", ",",
       "c\[Rho]R", ",", "s\[Rho]R", ",", "rrR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldCurvedFold3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldCurvedFold3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c2dsys", "=", 
      RowBox[{"Curve2DSystem", "[", 
       RowBox[{"f", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed2D", ",", "LeftCurvature2D", ",", "TangentVector2D", ",", 
         "LeftNormalVector2D"}], "}"}], "/.", "c2dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", "s", "]"}], ".", 
          RowBox[{"rL", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{"rL", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
