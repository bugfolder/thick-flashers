Cell[TextData[{
 "TwoCycleCriticalTwistAngleCCW[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "}]\nTwoCycleCriticalTwistAngleCW[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "}]\nTwoCycleCriticalTwistAngles[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "}]\nTwoCycleCriticalTwistAngles[",
 StyleBox["plist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.6274976146481657`*^9, 3.62749767413111*^9}, 
   3.627497738217695*^9, {3.6274978344016333`*^9, 3.6274978553774037`*^9}, {
   3.62749868896349*^9, 3.6274986892990217`*^9}, {3.62749928581509*^9, 
   3.627499288646639*^9}, {3.627499340488337*^9, 3.62749934159347*^9}, {
   3.627499380511102*^9, 3.627499385870238*^9}, {3.627499656854668*^9, 
   3.627499662396439*^9}, {3.627499841545516*^9, 
   3.627499852960926*^9}},ExpressionUUID->"1d5f9c2e-6bda-4f33-bb7c-\
632d0fe21047"],

Cell[TextData[{
 "TwoCycleCriticalTwistAngleCCW[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "}] returns the counterclockwise twist angle (\[Alpha]<\[Pi]/2) at which \
there is a 2-cycle overlap between edges {",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "} and {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "} of a polygon; the vertices in each pair should be given in CCW order."
}], "Text",
 CellChangeTimes->{{3.627497752764758*^9, 3.627497828169616*^9}, {
   3.62749786772199*^9, 3.627497900509591*^9}, {3.627499256686692*^9, 
   3.62749929779617*^9}, 3.6274993393780117`*^9, {3.627499388301939*^9, 
   3.627499389118184*^9}},ExpressionUUID->"a99a597d-0fdc-4f85-9e8e-\
8f37b4bc1739"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoCycleCriticalTwistAngleCCW", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1a_",
       FontSlant->"Italic"], ",", 
      StyleBox["q1b_",
       FontSlant->"Italic"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q2a_",
       FontSlant->"Italic"], ",", 
      StyleBox["q2b_",
       FontSlant->"Italic"]}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a1", ",", "a2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a1", "=", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q2b", "-", "q1b"}], ")"}], ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RotationMatrix2D", "[", 
            RowBox[{"-", 
             FractionBox["\[Pi]", "2"]}], "]"}], ".", 
           RowBox[{"(", 
            RowBox[{"q1a", "-", "q1b"}], ")"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q2b", "-", "q1b"}], ")"}], ".", 
         RowBox[{"(", 
          RowBox[{"q1a", "-", "q1b"}], ")"}]}]], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q1b", "-", "q2b"}], ")"}], ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RotationMatrix2D", "[", 
            RowBox[{"-", 
             FractionBox["\[Pi]", "2"]}], "]"}], ".", 
           RowBox[{"(", 
            RowBox[{"q2a", "-", "q2b"}], ")"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q1b", "-", "q2b"}], ")"}], ".", 
         RowBox[{"(", 
          RowBox[{"q2a", "-", "q2b"}], ")"}]}]], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Max", "[", 
      RowBox[{"a1", ",", "a2"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627498438024425*^9, 3.627498624326661*^9}, {
   3.627498715431436*^9, 3.627498733058926*^9}, 3.627498786202321*^9, {
   3.627499393636527*^9, 3.627499394433737*^9}, {3.627503422901703*^9, 
   3.627503492809625*^9}, {3.688166836925848*^9, 3.688166836941854*^9}},
 CellLabel->
  "In[2684]:=",ExpressionUUID->"fe252d83-2e5f-4ec6-aeca-bdd24007cb2c"],

