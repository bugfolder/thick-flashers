Cell[TextData[{
 "TriangleNormal3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]\nTriangleNormal3D[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r}",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.701092497351657*^9, 3.701092501190764*^9}, {
  3.915801615107663*^9, 
  3.9158016195070868`*^9}},ExpressionUUID->"051288bd-cdb6-4b71-838f-\
5c1b7207528a"],

Cell[TextData[{
 "TriangleNormal3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] returns just the ",
 StyleBox["z",
  FontSlant->"Italic"],
 "-vector of TriangleBasis3D, since that\[CloseCurlyQuote]s often all that we \
want."
}], "Text",
 CellChangeTimes->{{3.6499598341859007`*^9, 3.649959990928333*^9}, 
   3.649960373340371*^9, {3.686847331186198*^9, 3.686847377198447*^9}, {
