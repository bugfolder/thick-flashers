Cell["Check the isometry condition for \[Delta]=0 and \[Rho]=+1.", "Text",
 CellChangeTimes->{{3.6515059427185698`*^9, 3.651505960049159*^9}, {
  3.651506765982071*^9, 3.651506784213295*^9}, {3.651514877750577*^9, 
  3.651514889546917*^9}},ExpressionUUID->"b64b542a-e3df-4090-8661-\
c6d6e6e96770"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "wi", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", 
      "aa", ",", "bb", ",", "cc", ",", "dd", ",", "ee", ",", "ff", ",", "si", 
      ",", "ti", ",", "dc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"wi", "=", 
      RowBox[{"xi", " ", 
       RowBox[{"Tan", "[", "\[Phi]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "cp", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"ri", " ", 
       RowBox[{"U", "[", "0", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"a", "+", 
       RowBox[{"wi", " ", 
        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"b", "+", 
       RowBox[{"si", " ", 
        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"{", 
       RowBox[{"ri", ",", 
        RowBox[{"2", "h"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", 
      RowBox[{"f", "-", 
       RowBox[{"wi", " ", 
        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"e", "-", 
       RowBox[{"ti", " ", 
        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "ff", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"aa", "=", 
      RowBox[{
       RowBox[{"xi", " ", 
        RowBox[{"U3D", "[", "0", "]"}]}], "+", 
       RowBox[{"zi", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"aa", "+", 
       RowBox[{"wi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"bb", "+", 
       RowBox[{"si", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"2", "\[Phi]"}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"xi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{"2", "\[Phi]"}], "]"}]}], "+", 
       RowBox[{"zi", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ee", "=", 
      RowBox[{"ff", " ", "+", " ", 
       RowBox[{"wi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"2", "\[Phi]"}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"ee", "+", 
       RowBox[{"ti", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "parameters", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", "-", "wi"}], ")"}], "ui", " ", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"1", "-", "\[Rho]"}], "2"], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ti", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", "-", "wi"}], ")"}], "ui", " ", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"1", "+", "\[Rho]"}], "2"], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"distance", " ", "condition"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Mag2", "[", 
            RowBox[{"cc", "-", "dd"}], "]"}], "\[Equal]", 
           RowBox[{"Mag2", "[", 
            RowBox[{"c", "-", "d"}], "]"}]}], ")"}], "/.", 
         RowBox[{"\[Rho]", "\[Rule]", "1"}]}], ",", "ui"}], "]"}], "//", 
      "FullSimplify"}]}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.651505961312973*^9, 3.65150600891113*^9}, {
