Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"DihedralAngles", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[Gamma]", "1"], ",", " ", 
