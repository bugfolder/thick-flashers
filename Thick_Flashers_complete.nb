Cell["\<\
We post-apply Hold rather than ShowExample because NCurvedFoldHelix3D isn\
\[CloseCurlyQuote]t defined yet.\
\>", "Text",
 CellChangeTimes->{{3.799846359029358*^9, 
  3.79984639778126*^9}},ExpressionUUID->"beb29b69-b5db-495c-a7cd-\
bdbda98b4ae5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "u0", ",", "u1", ",", "\[Gamma]", ",", "ip", ",", "ff", ",", "rrL", ",",
        "rrR", ",", "plots"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Gamma]", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"60", "\[Degree]"}], "+", 
         RowBox[{"60", "\[Degree]", 
          RowBox[{"(", 
           RowBox[{"#", "/", "\[Pi]"}], ")"}]}]}], "&"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ip", "=", "64"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}], "=", 
       RowBox[{"NCurvedFoldHelix3D", "[", 
        RowBox[{"1", ",", 
         RowBox[{"30", "\[Degree]"}], ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plots", "=", 
       RowBox[{"CurvedFoldShapePlots3D", "[", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GraphicsRow", "[", "plots", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.799844162068718*^9, 3.799844176193336*^9}, {
