d3031e111b6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]", ",", "bb", ",", "dd", ",", "ss", ",", "ff", ",", "u", ",", 
      "u0", ",", "v"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"cone", " ", "half"}], "-", "angle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}], "&"}]}], ";", 
     RowBox[{"(*", " ", "directrix", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
          RowBox[{"Cos", "[", "#", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bb", "[", "u", "]"}], "+", 
         RowBox[{"v", " ", 
          RowBox[{"dd", "[", "u", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Styled3DAxes", "[", 
           RowBox[{"1", ",", "1", ",", ".7"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"StyledCrossRuledPatch", "[", 
              RowBox[{"ss", ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}], ",", 
               RowBox[{"CrossLineStyle", "\[Rule]", "Purple"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}]}], "}"}], "//", 
        "ReversePolygons"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.689466888674877*^9, 3.689466983298786*^9}, {
