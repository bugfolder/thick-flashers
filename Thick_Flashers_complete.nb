       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ConicSection2DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
