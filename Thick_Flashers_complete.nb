Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Graph3DGraphics3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"VertexLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"EdgeLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"FaceLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DirectedEdges", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DirectedEdges3D", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"VertexColor", "\[Rule]", "DarkGray"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"EdgeColor", "\[Rule]", 
      RowBox[{"Darker", "[", "Magenta", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FaceColor", "\[Rule]", "Green"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FaceColoring", "\[Rule]", "None"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.455906216103409*^9, 3.45590623248654*^9}, 
