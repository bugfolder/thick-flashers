Cell[CellGroupData[{

Cell["Quadrilateral centered split twist tiles", "Subsection",
 CellChangeTimes->{{3.630101290335145*^9, 3.630101299564138*^9}, {
   3.630101405702787*^9, 3.6301014072687607`*^9}, 3.630108715469328*^9, 
   3.6301115595512547`*^9, {3.630112947684699*^9, 
   3.630112960703269*^9}},ExpressionUUID->"aba96916-82b3-464a-a7ee-\
85da8201cf8e"],

Cell[CellGroupData[{

Cell[TextData[{
 "{QuadrilateralCenteredSplitTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.630108711055298*^9, 3.630108711500474*^9}, {
  3.630108791585964*^9, 
  3.630108801246539*^9}},ExpressionUUID->"c76f6dd4-e268-4b52-ab0c-\
550d5e034d32"],

Cell[TextData[{
 "{QuadrilateralCenteredSplitTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} is a tiletype that describes a split twist in a quadrilateral specified \
by its vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where \n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \n\t\
\[Tau] is the pleat angle, defined as the rotation angle of the pleat \
measured with respect to the edge, \n\t",
 StyleBox["ip",
  FontSlant->"Italic"],
 " is the index of the vertex to preserve,\n\t",
 StyleBox["ctype",
  FontSlant->"Italic"],
 " is the fold type of the crossing fold,\n\t",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
   3.457740055563382*^9}, {3.457899240889505*^9, 3.457899262921368*^9}, {
   3.533668819444027*^9, 3.533668840458009*^9}, {3.533683624395843*^9, 
   3.533683629667203*^9}, {3.533683676248049*^9, 3.533683676297819*^9}, {
   3.533683730482073*^9, 3.533683812423534*^9}, {3.592170850586206*^9, 
