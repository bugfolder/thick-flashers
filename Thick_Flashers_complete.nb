Cell["Triangle properties from vertices", "Subsection",
 CellChangeTimes->{{3.595977245125183*^9, 3.595977248650592*^9}, {
  3.5959777272681108`*^9, 3.595977749945916*^9}, {3.701270231818793*^9, 
