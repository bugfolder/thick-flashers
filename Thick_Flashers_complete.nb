fd18999bf622"],

Cell[TextData[{
 "ConvexHullifyEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TObj containing a set of vertices and edges and returns a ",
 "TObj",
 " containing the same vertices and a modified set of edges that include the \
convex hull of the vertices. Duplicate edges are eliminated (e.g., if any \
hull edges were part of the original set.)"
}], "Text",
 CellChangeTimes->{
  3.457620386588288*^9, 3.462972309273203*^9, {3.591651047985223*^9, 
   3.591651070398559*^9}, {3.5924357383241034`*^9, 
   3.592435738432744*^9}},ExpressionUUID->"391ee324-eaca-4770-9a97-\
e00d71d449d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ConvexHullifyEdges", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "chull", ",", "newedges"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "ConvexHullifyEdges"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"chull", "=", 
      RowBox[{"ConvexHull", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newedges", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"chull", ",", 
             RowBox[{"RotateLeft", "[", "chull", "]"}]}], "}"}], "]"}]}], 
         "]"}], ",", 
        RowBox[{"SameTest", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", "\[Equal]", "#2"}], "||", 
            RowBox[{"#1", "\[Equal]", 
             RowBox[{"Reverse", "[", "#2", "]"}]}]}], "&"}], ")"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", "verts"}], ",", 
         RowBox[{"Edges", "\[Rule]", "newedges"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.455897959086773*^9, 3.455897969308069*^9}, 
   3.455898047394611*^9, 3.455898151818101*^9, 3.455898253007297*^9, 
