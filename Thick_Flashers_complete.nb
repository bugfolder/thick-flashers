Cell[TextData[{
 "SplitGraph2DGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pfinfo, opts",
  FontSlant->"Italic"],
 "] produces a Graphics object that gives a visualization of the \
splitting-by-fold in the folded form by drawing all of the folded edges and \
face splitting lines on top of the Graph2DGraphics representation and \
overlaying that on the fold line."
}], "Text",
