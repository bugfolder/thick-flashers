Cell["\<\
Example. Same general vertex, but now rotated to be minor-connected.\
\>", "Text",
 CellChangeTimes->{{3.617245551259931*^9, 3.617245551929839*^9}, {
  3.6173414716577682`*^9, 3.6173414769353456`*^9}, {3.617343063291631*^9, 
  3.617343083023736*^9}, {3.617343142751142*^9, 3.617343151139844*^9}, {
  3.617349263623755*^9, 3.617349288236176*^9}, {3.617349890264711*^9, 
  3.617349904852632*^9}, {3.617405019126094*^9, 3.6174050194861727`*^9}, {
  3.617405049555181*^9, 3.617405055093057*^9}, {3.617431927342264*^9, 
  3.617431929622582*^9}, {3.6174321872386227`*^9, 3.617432194177769*^9}, {
  3.617432243351628*^9, 
  3.617432280805942*^9}},ExpressionUUID->"ef325aa4-5976-4b60-a7c0-\
caf1b48359e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sa", ",", "\[Gamma]", ",", "n", ",", "w", ",", "da", ",", "vtobj", ",", 
      "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"100.", "\[Degree]"}], ",", 
        RowBox[{"100.", "\[Degree]"}], ",", 
        RowBox[{"60.", "\[Degree]"}], ",", 
        RowBox[{"100.", "\[Degree]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"10", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", "6"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"da", "=", 
      RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "[", 
       RowBox[{"sa", ",", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vtobj", "=", 
      RowBox[{"MakeTDegree4Vertex3DFromSectorsAndDihedrals", "[", 
       RowBox[{"sa", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeAlternatingMinorConnectedUnitChain", "[", 
       RowBox[{"sa", ",", 
        RowBox[{"FoldAngleToType", "[", "\[Gamma]", "]"}], ",", "n", ",", 
        "w"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldLinearChain", "[", 
       RowBox[{"tobj", ",", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex3DCreasePatternGraphics", "[", "vtobj", "]"}], ",", 
         RowBox[{"Vertex3DFoldedFormGraphics3D", "[", "vtobj", "]"}], ",", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"Vertex3DStyle", "[", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.617257443776836*^9, 3.61725762505096*^9}, {
   3.617257765334271*^9, 3.617257817388159*^9}, {3.617326725419659*^9, 
