Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gc", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gc", "=", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"gc", ",", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
        RowBox[{"(*", " ", "original", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"FuzzGC", "[", 
           RowBox[{"gc", ",", ".1"}], "]"}], ",", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{"fuzzed", " ", "by", " ", "vertex"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"FuzzGC", "[", 
           RowBox[{"gc", ",", ".1", ",", 
            RowBox[{"FuzzMethod", "\[Rule]", "FuzzByGroup"}]}], "]"}], ",", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], 
       RowBox[{"(*", " ", 
        RowBox[{"fuzzed", " ", "all", " ", "same"}], " ", "*)"}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.708593056106222*^9, 3.708593108804583*^9}, {
