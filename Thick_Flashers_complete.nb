Cell["Example. Tiling, crease pattern, and folded form.", "Text",
 CellChangeTimes->{{3.629848764316999*^9, 
  3.62984877231464*^9}},ExpressionUUID->"a3f3aa8c-b4ed-4f51-a2f8-\
6f7022cf60cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "angles", ",", "is", ",", "side", ",", "w", ",", "d", ",", "ip", ",", 
      "ctype1", ",", "ctype2", ",", "types", ",", "tiling"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"70", "\[Degree]"}], ",", 
        RowBox[{"85", "\[Degree]"}], ",", 
        RowBox[{"95", "\[Degree]"}], ",", 
        RowBox[{"110", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"is", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"side", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.15"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.09"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype1", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype2", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"UnitQuadrilateralOffsetSplitTwistTile", ",", 
            RowBox[{"{", 
             RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",",
             "d", ",", "ip", ",", "ctype1", ",", "types"}], "}"}], "}"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"UnitQuadrilateralOffsetSplitTwistTile", ",", 
             RowBox[{"{", 
              RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",", 
             RowBox[{"-", "d"}], ",", "ip", ",", "ctype2", ",", "types"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "Tiling", ",", 
             RowBox[{"TilePolys", "\[Rule]", "True"}], ",", 
             RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowDF"}]}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629828101472671*^9, 3.629828167961506*^9}, 
   3.629828494028514*^9, {3.629828599943145*^9, 3.629828738380302*^9}, 
   3.629847503663728*^9, {3.629848834679508*^9, 3.629848850092079*^9}, {
