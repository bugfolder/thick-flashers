9ffe0ecb89bf"],

Cell[TextData[{
 "MakeFoldVectorsFromSectorsAndDihedrals[",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "93150270-65de-440c-b62a-f1a101d6751f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], ",", 
     SubscriptBox["\[Gamma]", "2"], ",", 
     SubscriptBox["\[Gamma]", "3"], ",", 
     SubscriptBox["\[Gamma]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "fdc27a31-25c7-40a4-afb7-8ceaca074f94"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a complete list of sector angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "17af5b49-6f25-4f18-a0a5-171256f30af6"],
 " and dihedral angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], ",", 
     SubscriptBox["\[Gamma]", "2"], ",", 
     SubscriptBox["\[Gamma]", "3"], ",", 
     SubscriptBox["\[Gamma]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "355e3f7c-97f6-4436-8af8-a93658298292"],
 " for a degree-4 vertex and constructs the four fold vectors for the vertex. \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "ce177b96-59fd-431b-8333-23b72fb0197d"],
 "is taken to run along the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " axis initially, although we then rotate to align the osculating vector if \
one is specified. Useful for constructing visual examples."
}], "Text",
 CellChangeTimes->{{3.617241559002275*^9, 3.6172415946483603`*^9}, {
  3.6172416293883243`*^9, 3.617241683625777*^9}, {3.617241869131446*^9, 
  3.61724189558912*^9}, {3.707925108789277*^9, 
  3.707925115205771*^9}},ExpressionUUID->"0c6e9845-b6e7-48a3-b48f-\
0d3b3450a9f4"],

Cell[TextData[{
 "Options:\n\tOsculatingVectorNear \[Rule] None | ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["q",
  FontSlant->"Italic"],
 " is the desired direction for the osculating vector, or None if you don\
\[CloseCurlyQuote]t care (in which case ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "f59eef04-2d78-4538-9769-595861079084"],
 " will lie along the x axis)."
}], "Text",
 CellChangeTimes->{{3.707925117414324*^9, 
  3.707925119820717*^9}},ExpressionUUID->"09988875-a691-4671-b167-\
e2daefb3b965"],

