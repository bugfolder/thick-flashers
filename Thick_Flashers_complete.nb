Cell["Example.", "Text",
 CellChangeTimes->{{3.629826293494502*^9, 3.629826294309113*^9}, {
  3.630018453289089*^9, 
  3.630018461153905*^9}},ExpressionUUID->"b0c53f21-ab7f-4f50-81ab-\
8351cbedb8bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "w", ",", "d", ",", "\[Tau]", ",", "ccw", ",", "ip", ",", 
      "ctype", ",", "types"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.1", ",", "1.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2"}], ",", "1.0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"70", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccw", "=", "True"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RenderTile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "QuadrilateralSplitTwistTile", ",", "verts", ",", "w", ",", "d", ",", 
         "\[Tau]", ",", "ccw", ",", "ip", ",", "ctype", ",", "types"}], "}"}],
        ",", "TileVertices"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6298263240615673`*^9, 3.629826402339705*^9}, {
   3.630018473341446*^9, 3.630018494513693*^9}, 3.630018634105878*^9, 
