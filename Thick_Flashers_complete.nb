Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pa", ",", "pb", ",", "pc", ",", "pd"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pa", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pc", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{
         SqrtBox["3"], "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pd", "=", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "2"], ",", 
        FractionBox["1", 
         RowBox[{"2", " ", 
          SqrtBox["3"]}]], ",", 
        SqrtBox[
         FractionBox["2", "3"]]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pa", ",", "pb", ",", "pc"}], "}"}], "]"}], ",", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pa", ",", "pb", ",", "pd"}], "}"}], "]"}], ",", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pa", ",", "pc", ",", "pd"}], "}"}], "]"}], ",", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pb", ",", "pc", ",", "pd"}], "}"}], "]"}]}], "}"}], ",", 
           RowBox[{"Opacity", "[", "0.9", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", 
            RowBox[{"{", 
             RowBox[{"pa", ",", "pb", ",", "pc", ",", "pd"}], "}"}]}], ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Text", "[", 
              
              RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(a\)]\)\>\"", ",", "pa",
                ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              
              RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(b\)]\)\>\"", ",", "pb",
                ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"-", "1.5"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              
              RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(c\)]\)\>\"", ",", "pc",
                ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              
              RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(d\)]\)\>\"", ",", "pd",
                ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"FontSize", "\[Rule]", "14"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"\"\<a\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"pa", "+", "pd"}], ")"}], "/", "2"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<b\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"pb", "+", "pd"}], ")"}], "/", "2"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<c\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"pc", "+", "pd"}], ")"}], "/", "2"}]}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"FontSize", "\[Rule]", "14"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"Lighting", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"Boxed", "\[Rule]", "True"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.595802214892312*^9, 3.595802376137965*^9}, {
  3.595802415594048*^9, 3.595802810698934*^9}, {3.595975958392028*^9, 
  3.5959759701421757`*^9}, {3.768662196570677*^9, 3.768662244542864*^9}, {
  3.768662398344456*^9, 3.768662552026271*^9}, {3.768662586815912*^9, 
  3.76866260626376*^9}},
 CellLabel->
  "In[649]:=",ExpressionUUID->"4cd54826-94d6-4b1a-9e40-7a354270383b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronVolumeSquared[{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.768658980177991*^9, 3.768658993799364*^9}, {
   3.76865907627341*^9, 3.76865909186657*^9}, 
   3.768663108409414*^9},ExpressionUUID->"e0bb8d84-5a31-44cb-a8fc-\
07cdce191e97"],

Cell[TextData[{
 "TetrahedronVolumeSquared[{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}] returns the square of the volume of a tetrahedron given three points of \
one face and distances to the 4th vertex, returning a negative value if there \
is no real solution for the 4th vertex."
}], "Text",
 CellChangeTimes->{{3.768659107618738*^9, 
  3.7686591575860662`*^9}},ExpressionUUID->"20441c6c-7c1c-407b-a4ce-\
556c32872d1b"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "} \[LongDash] first point and distance from that point.\n\t{",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "} \[LongDash] second point and distance from that point.\n\t{",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "} \[LongDash] third point and distance from that point."
}], "Text",
 CellChangeTimes->{{3.768658537716063*^9, 3.768658627603674*^9}, 
   3.768662832207377*^9},ExpressionUUID->"c663311d-d731-467e-8af5-\
f42e3ae769ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronVolumeSquared", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pa_List", ",", "a_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pb_List", ",", "b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pc_List", ",", "c_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "d12", ",", "d23", ",", "d31", ",", "d14", ",", "d24", ",", "d34"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d12", "=", 
      RowBox[{"Mag2", "[", 
       RowBox[{"pa", "-", "pb"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d23", "=", 
      RowBox[{"Mag2", "[", 
       RowBox[{"pb", "-", "pc"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d31", "=", 
      RowBox[{"Mag2", "[", 
       RowBox[{"pc", "-", "pa"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d14", "=", 
      SuperscriptBox["a", "2"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d24", "=", 
      SuperscriptBox["b", "2"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d34", "=", 
      SuperscriptBox["c", "2"]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      FractionBox["1", "288"], 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "d12", ",", "d31", ",", "d14"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "d12", ",", "0", ",", "d23", ",", "d24"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "d31", ",", "d23", ",", "0", ",", "d34"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "d14", ",", "d24", ",", "d34", ",", "0"}], 
          "}"}]}], "}"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.768659166374758*^9, 3.768659194856852*^9}, {
  3.7686605818140697`*^9, 3.768660590925053*^9}, {3.768660675169757*^9, 
  3.7686606830427313`*^9}, {3.768661064390823*^9, 3.768661237492976*^9}, {
  3.76866140549014*^9, 3.768661405940058*^9}},
 CellLabel->
  "In[650]:=",ExpressionUUID->"3cebc097-08e0-4cac-95d6-d1eb5e679ffa"],

Cell["Example. Regular tetrahedron.", "Text",
 CellChangeTimes->{{3.76825766378582*^9, 3.768257669444715*^9}, {
  3.768258060459039*^9, 3.768258081802534*^9}, {3.768658953257174*^9, 
  3.7686589566689863`*^9}, {3.768661284050118*^9, 
