Cell[CellGroupData[{

Cell["Circular vertex graphs", "Subsection",
 CellChangeTimes->{{3.597503939717875*^9, 3.5975039504411592`*^9}, 
   3.597504108129278*^9, {3.597509915927087*^9, 3.597509916823924*^9}, 
   3.5975223155477*^9},ExpressionUUID->"6249ce9d-7784-4713-b861-1c8b769cab43"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.5975039667680807`*^9, 3.597503967176275*^9}, 
   3.5975041081296062`*^9},ExpressionUUID->"9229f028-3d2c-4144-b5d8-\
e3e4ad77ade2"],

Cell["\<\
A TVertex describes the vertex and its surroundings. If you want a visual \
representation, create a MakeCircularVertexGraph, which will provide a \
TGraph+TAssigned that represents the vertex, located at the origin, and \
surrounding faces, clipped to a circle. The crease assignment is taken from \
the DihedralAngles property of the pattern.\
\>", "Text",
 CellChangeTimes->{{3.597503969535762*^9, 3.597504005382127*^9}, {
   3.597504043555389*^9, 3.597504057970231*^9}, {3.5975041081298847`*^9, 
   3.597504113438459*^9}, {3.5975041451642513`*^9, 3.597504160467542*^9}, {
   3.59750419831283*^9, 3.597504201100654*^9}, {3.597504706039202*^9, 
   3.597504706399167*^9}, {3.5975056689869137`*^9, 3.597505695150156*^9}, 
   3.597516395321917*^9, 
   3.5975223031139708`*^9},ExpressionUUID->"354377cc-7b9c-4d4a-8c3e-\
2ef2af6ec803"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeCircularVertexGraph",
 "[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(options) CircleDivisions, CircleRadius\n\t(checked class) TVertex"
}], "Subsubsection",
 CellChangeTimes->{{3.597504167690942*^9, 3.597504214855382*^9}, {
   3.597504318938644*^9, 3.597504325384467*^9}, {3.597504700736736*^9, 
   3.597504712510764*^9}, 3.5975163950432568`*^9, {3.5975220878339252`*^9, 
   3.5975220900638523`*^9}, 
   3.5975223012448053`*^9},ExpressionUUID->"0b98f924-5f10-4616-8479-\
15eb2a7ae6ee"],

Cell[TextData[{
 "MakeCircularVertexGraph",
 "[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TVertex describing a vertex and creates a TGraph that represents \
a circularly clipped vertex located at the origin with the crease running \
along the CreaseVectors property of the TVertex. Options are:\n\t\
CircleDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", which specifies the angular quantization to use in creating the circle.\n\
\tCircleRadius \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", which specifies the radius of the circle."
}], "Text",
 CellChangeTimes->{{3.597504226657774*^9, 3.597504362333768*^9}, {
   3.5975044349308243`*^9, 3.5975044430164146`*^9}, {3.597504713758555*^9, 
   3.597504728821808*^9}, 3.597504759069287*^9, 3.5975163951156273`*^9, {
   3.597522159483258*^9, 3.597522172526864*^9}, 
   3.597522301313747*^9},ExpressionUUID->"55cdec00-4e7e-4b94-8c1c-\
199e95f392c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CircleRadius", "::", "usage"}], 
   "=", "\"\<CircleRadius is an option to MakeCircularVertexGraph that \
specifies the radius of the circle.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5975221258046093`*^9, 3.597522150886144*^9}, 
   3.597522301345679*^9},
 CellLabel->
  "In[2133]:=",ExpressionUUID->"9705ddd7-866a-4bcf-af0c-e5af1e29e653"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeCircularVertexGraph", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"CircleRadius", "\[Rule]", "1"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.597522197995504*^9, 3.59752220339878*^9}, 
   3.597522301609789*^9},
 CellLabel->
  "In[2134]:=",ExpressionUUID->"cb3f3e59-c16c-4e50-bbf9-34fb14a3d093"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeCircularVertexGraph", "[", 
   StyleBox[
    RowBox[{"tobj_TObj", ",", " ", "opts___"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cr", ",", "cv", ",", "da", ",", "nv", ",", "verts", ",", "edges", ",", 
      "faces", ",", "types"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TVertex", ",", "MakeCircularVertexGraph"}], "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"cr", "=", 
      RowBox[{
       RowBox[{"CircleRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeCircularVertexGraph", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cv", ",", "da"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"CreaseVectors", ",", "DihedralAngles"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"Length", "[", "cv", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"cr", " ", "cv"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "+", "i"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nv"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "da", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ">", 
           "0"}], ",", "V", ",", 
          RowBox[{
           RowBox[{
           "da", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "<", 
           "0"}], ",", "M", ",", "True", ",", "U"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nv"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"CircularlyCompletePoly", "[", 
        RowBox[{"verts", ",", "edges", ",", "faces", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "nv", ",", "1"}], "]"}]}], ",", 
           "1", ",", 
           RowBox[{"i", "+", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", "cr", ",", "opts"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nv"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"types", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"types", ",", 
        RowBox[{"Table", "[", 
         RowBox[{"B", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Length", "[", "edges", "]"}], "-", "nv"}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTGraphAssigned", "[", 
      RowBox[{"verts", ",", "edges", ",", "faces", ",", "types"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.597504313361916*^9, 3.597504331409808*^9}, {
   3.5975043712948914`*^9, 3.597504399527338*^9}, {3.597504455001744*^9, 
   3.59750465260905*^9}, {3.597504740055701*^9, 3.59750476007661*^9}, {
   3.5975048697182693`*^9, 3.597504950483556*^9}, {3.597505172337312*^9, 
   3.597505210084598*^9}, {3.597505314912457*^9, 3.5975053158539867`*^9}, {
   3.5975053559132*^9, 3.597505358041197*^9}, {3.597505505759108*^9, 
   3.597505629082356*^9}, 3.597509507418034*^9, {3.597514978302217*^9, 
   3.597514983858666*^9}, {3.597516395137672*^9, 3.5975163951460447`*^9}, {
   3.59752211695761*^9, 3.597522120583729*^9}, {3.597522181912062*^9, 
   3.597522192996892*^9}, {3.5975222331347*^9, 3.597522248252616*^9}, {
   3.597522301862152*^9, 3.597522302345274*^9}},
 CellLabel->
  "In[2135]:=",ExpressionUUID->"33774e5f-6779-4b23-b708-8bc5feeaf506"],

