Cell[TextData[{
 "ReplaceOrAppendRule[",
 StyleBox["list",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lhs",
  FontSlant->"Italic"],
 "\[Rule]",
 StyleBox["rhs",
  FontSlant->"Italic"],
 "] replaces a rule in a list if it exists, or appends it if it doesn\
\[CloseCurlyQuote]t."
}], "Text",
 CellChangeTimes->{{3.675849240031514*^9, 3.675849270420149*^9}, {
