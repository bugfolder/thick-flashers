9bf7677ebd93"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PrintThis", "[", 
      RowBox[{"IntervalSetValidQ", "[", 
       RowBox[{"{", "}"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
