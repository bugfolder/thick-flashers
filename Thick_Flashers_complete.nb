Cell[BoxData[
 RowBox[{
  RowBox[{"DynamicModule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sa", ",", "ba"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"40", "\[Degree]"}], ",", 
        RowBox[{"110", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ba", "=", 
      RowBox[{"MinorFirstBindingDihedralAngles", "[", "sa", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Binding angles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{"ba", "/", "\[Degree]"}], "//", "N"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tobj", ",", "vp", ",", "rs", ",", "gs"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"vp", "=", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1000"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "=", 
           RowBox[{"MakeTDegree4Vertex3DFromSectorsAndMinorDihedral", "[", 
            RowBox[{"sa", ",", 
             RowBox[{"g1", " ", "\[Degree]"}], ",", " ", 
             RowBox[{"OsculatingVectorNear", "\[Rule]", "vp"}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"rs", "=", 
           RowBox[{
            RowBox[{"Vertex3DFoldedFormGraphics3D", "[", 
             RowBox[{"tobj", ",", 
              RowBox[{"ViewPoint", "\[Rule]", "vp"}]}], "]"}], "/.", 
            RowBox[{"Vertex3DStyle", "[", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"gs", "=", 
           RowBox[{
            RowBox[{"Vertex3DGaussianSphereGraphics3D", "[", 
             RowBox[{"tobj", ",", 
              RowBox[{"ShowMidfoldVectors", "\[Rule]", "True"}], ",", 
              RowBox[{"ViewPoint", "\[Rule]", "vp"}]}], "]"}], "/.", 
            RowBox[{"Vertex3DStyle", "[", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"GraphicsRow", "[", 
           RowBox[{"{", 
            RowBox[{"rs", ",", "gs"}], "}"}], "]"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"g1", ",", "0.1", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "ba", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "/", 
           "\[Degree]"}], "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.597666067110077*^9, 3.597666286100053*^9}, {
   3.597666372603862*^9, 3.597666377003833*^9}, {3.597666424468584*^9, 
