Cell[BoxData[
 RowBox[{
  RowBox[{"CollinearCleanupGraph3DAssigned", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ccdata", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ccdata", "=", 
      RowBox[{"CollinearCleanupData", "[", 
       RowBox[{"tobj", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"tobj", "//", 
        RowBox[{"ApplyCollinearCleanup", "[", "ccdata", "]"}]}], "//", 
       RowBox[{"ApplyCollinearCleanupAssigned", "[", "ccdata", "]"}]}], "//", 
      
      RowBox[{"ApplyCollinearCleanup3D", "[", "ccdata", "]"}]}]}]}], 
   "]"}]}]], "Input",
