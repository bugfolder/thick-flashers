Cell[CellGroupData[{

Cell[TextData[{
 "Embed[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ",  ",
 StyleBox["obj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["levspec",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.456533564974131*^9, {3.591898058228776*^9, 
   3.591898060863076*^9}},ExpressionUUID->"d5f0a3c8-321b-4533-9ba3-\
ee843cd53e11"],

Cell[TextData[{
 "Embed[",
 StyleBox["pts, obj, levspec",
  FontSlant->"Italic"],
 "] is the opposite of Indexify[]. It takes a list of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " and uses it to embed the indexed object ",
 StyleBox["obj",
  FontSlant->"Italic"],
 ", by taking the indices at level ",
 StyleBox["levspec",
  FontSlant->"Italic"],
 " in ",
 StyleBox["obj",
  FontSlant->"Italic"],
 " and replacing them with the corresponding point in ",
 StyleBox["pts",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.455923145255522*^9, 
  3.455923160750117*^9}},ExpressionUUID->"a106eb64-17cc-4eda-8799-\
938477266863"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Embed", "[", 
   RowBox[{"pts_", ",", "obj_", ",", 
    RowBox[{"levspec_Integer", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"pts", "[", 
      RowBox[{"[", "#", "]"}], "]"}], "&"}], ",", "obj", ",", 
    RowBox[{"{", "levspec", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.455923164617607*^9, 3.4559231680656853`*^9}},
 CellLabel->
  "In[1099]:=",ExpressionUUID->"b94b3405-1bae-46ca-941f-97027431ae24"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["TGraph modification", "Subsection",
 CellChangeTimes->{{3.455899244026635*^9, 3.455899247629985*^9}, {
   3.457743592596808*^9, 3.457743595227794*^9}, {3.458261214770569*^9, 
   3.458261215618617*^9}, {3.462972669531931*^9, 3.462972672267508*^9}, 
   3.484829029105711*^9, {3.591896382738348*^9, 3.5918963838728743`*^9}, {
   3.5923458929290643`*^9, 3.592345893887811*^9}, 3.592435846774898*^9, {
   3.59244102760334*^9, 
   3.592441028995829*^9}},ExpressionUUID->"cdf0c4e1-1fed-429e-b5a9-\
b5e227e7c266"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.458172365775696*^9, 
  3.458172366207324*^9}},ExpressionUUID->"09c9f3fe-535a-4be0-8168-\
a46c12b78d29"],

Cell["\<\
These functions pertain specifically to embedded plane graphs, i.e., graphs \
where we give a specific set of coordinates to the vertices. With a plane \
graph, we can introduce the concept of a face, which is a closed cycle of the \
graph that contains no vertices in its interior, so long as there are no \
crossings in the graph. In our system, a plane graph can represent a crease \
pattern (where the faces of the graph are facets of the crease pattern and \
the edges are folds), but we can also use a plane graph as the input to a \
tessellation-generation algorithm.\
\>", "Text",
 CellChangeTimes->{{3.458172368167532*^9, 3.458172395454013*^9}, {
   3.4582160520257607`*^9, 3.458216158480542*^9}, {3.484829043729534*^9, 
   3.484829044014661*^9}, 
   3.591898099331408*^9},ExpressionUUID->"708af5bc-d5c0-4f34-b0ab-\
e053bd2f0edc"],

Cell["\<\
Relatively low-level routines work directly on lists of vertices, edges, etc. \
Higher-level routines that rely on relationships between multiple lists take \
and return TGraph\[CloseCurlyQuote]s.\
\>", "Text",
 CellChangeTimes->{{3.591644107103833*^9, 3.591644162931107*^9}, {
   3.592349921836295*^9, 3.592349922514331*^9}, 
   3.592435846885803*^9},ExpressionUUID->"fda3c3ca-01e5-41ce-8bec-\
9512ee1fc4ea"],

Cell["\<\
Note that if you apply one of these functions to a subclass of TGraph, \
subclass properties will be unaffected but they may be invalidated by changes \
in Vertices, Edges, and/or Faces.\
\>", "Text",
 CellChangeTimes->{{3.592349928354424*^9, 3.592349976351525*^9}, 
   3.5924358469840803`*^9},ExpressionUUID->"5fae7245-80be-4596-b5fb-\
2f0f2e1ca5c5"]
}, Closed]],

