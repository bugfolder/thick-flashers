 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sectorangles", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sectorangles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"80", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"100", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"FlatFoldabilityExcess", "[", "sectorangles", "]"}], "/", 
      "\[Degree]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
