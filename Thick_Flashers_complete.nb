Cell[BoxData[
 RowBox[{
  RowBox[{"HCwCPairGraphics3D", "[", 
   RowBox[{"hcwc_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gg", ",", "p0", ",", "pv"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"gg", "=", 
      RowBox[{"HCwCGraphics3D", "[", 
       RowBox[{"hcwc", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p0", "=", 
      RowBox[{
       RowBox[{"hcwc", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}],
        "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pv", "=", 
      RowBox[{
      "hcwc", "\[LeftDoubleBracket]", "14", "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{"gg", ",", 
       RowBox[{"1", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "gg", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{"FunctionTransform", "[", 
           RowBox[{
            RowBox[{
            "gg", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{"p0", "+", 
              RowBox[{
               RowBox[{"RotationMatrix3D", "[", 
                RowBox[{"\[Pi]", ",", "pv"}], "]"}], ".", 
               RowBox[{"(", 
                RowBox[{"#", "-", "p0"}], ")"}]}]}], "&"}]}], "]"}]}], 
         "}"}]}]}], "]"}]}]}], "]"}]}]], "Input",
