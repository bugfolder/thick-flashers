Cell[CellGroupData[{

Cell["\<\
Unit symmetric trapezoid offset twist properties [deprecated]\
\>", "Subsection",
 CellChangeTimes->{{3.629380826389841*^9, 3.62938083305239*^9}, {
   3.629381471387327*^9, 3.629381474114076*^9}, {3.62938209608236*^9, 
   3.629382104457425*^9}, 3.629397989691023*^9, {3.629398285992111*^9, 
   3.629398288919806*^9}, 3.629402663529117*^9, {3.629978584712134*^9, 
   3.629978585908668*^9}, {3.631893655782304*^9, 
   3.63189365806147*^9}},ExpressionUUID->"32921310-6685-41d4-9e70-\
39be732539cf"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.6293808349674187`*^9, 
  3.629380840635442*^9}},ExpressionUUID->"0483cef2-2e88-4822-bd28-\
0184e7a6cb6d"],

Cell["\<\
A symmetric trapezoid can form an offset twist tile for any base angle, but \
only for a particular aspect ratio. So the tile polygon is specified solely \
by its base angle \[Delta].\
\>", "Text",
 CellChangeTimes->{{3.629380844179282*^9, 3.629380923534*^9}, {
  3.629380963413611*^9, 3.629380965650922*^9}, {3.62938141225416*^9, 
  3.629381431549082*^9}},ExpressionUUID->"1f37127c-34d5-4802-b22b-\
e8595f930619"],

Cell["\<\
This examples works out the formula for the twist angle (= rotation) and \
shrinkage as a function of  base angle.\
\>", "Text",
 CellChangeTimes->{{3.629401224685386*^9, 3.629401247394095*^9}, {
  3.629402435232079*^9, 3.629402437686161*^9}, {3.629420355322953*^9, 
  3.6294203624514437`*^9}},ExpressionUUID->"db796a8a-ecdf-42c1-be95-\
3272b50ac473"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "ctr", ",", "acrit", ",", "tobj", ",", "tverts", ",", "dx",
       ",", "dy"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "ctr", ",", "acrit"}], "}"}], "=", 
      RowBox[{"UnitBrocardTrapezoidInfo", "[", "\[Delta]", "]"}]}], ";", 
     RowBox[{"tobj", "=", 
      RowBox[{"RenderTile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"PolygonOffsetTwistTile", ",", "verts", ",", "w", ",", "d", ",", 
          RowBox[{"{", 
           RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}]}], "}"}], ",", 
        "TGraphAssigned"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"GraphGraphics", "[", "tobj", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Delta]", "\[Rule]", 
          RowBox[{"70", "\[Degree]"}]}], ",", 
         RowBox[{"w", "\[Rule]", ".2"}], ",", 
         RowBox[{"d", "\[Rule]", ".1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tverts", "=", 
      RowBox[{"tobj", "[", "Vertices", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dx", ",", "dy"}], "}"}], "=", 
      RowBox[{
       RowBox[{
       "tverts", "\[LeftDoubleBracket]", "8", "\[RightDoubleBracket]"}], "-", 
       
       RowBox[{
       "tverts", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Twist angle = \>\"", ",", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"ArcCot", "[", 
         RowBox[{"TrigExpand", "[", 
          RowBox[{"dy", "/", "dx"}], "]"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Shrinkage = \>\"", ",", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Mag", "[", 
         RowBox[{"{", 
          RowBox[{"dx", ",", "dy"}], "}"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<height of v4 = \>\"", ",", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"tverts", "\[LeftDoubleBracket]", 
          RowBox[{"4", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Delta]", ">", "0"}], ",", 
           RowBox[{"\[Delta]", "<", "\[Pi]"}]}], "}"}]}], "]"}]}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.62940078367479*^9, 3.629401030237734*^9}, {
   3.629401097520996*^9, 3.629401110153096*^9}, {3.629401147188435*^9, 
   3.629401200808782*^9}, {3.629401250502206*^9, 3.629401252184678*^9}, {
   3.629401635151021*^9, 3.629401723338936*^9}, 3.629402371257034*^9, {
   3.629420316931978*^9, 3.629420319011054*^9}, {3.629978624862784*^9, 
   3.629978697995266*^9}, 3.631469739651586*^9, 3.632080659393347*^9, 
   3.632082211260034*^9, {3.707920546390834*^9, 3.707920547442194*^9}},
 CellLabel->
  "In[3047]:=",ExpressionUUID->"aff53806-becb-422f-a09f-42faf3fb2801"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "UnitTrapezoidOffsetTwistAngle[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "]\nUnitTrapezoidOffsetTwistOffset[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha]]"
}], "Subsubsection",
 CellChangeTimes->{{3.6293980385100937`*^9, 3.629398115867009*^9}, {
  3.62940133891124*^9, 
  3.629401357755273*^9}},ExpressionUUID->"5d6c61b3-27a1-4562-8577-\
f62dd2f0c079"],

Cell[TextData[{
 "UnitTrapezoidOffsetTwistAngle[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "] returns the twist angle for a unit trapezoid offset twist with base \
angles \[Delta], pleat width ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", and offset ",
 StyleBox["d",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.629398053796221*^9, 3.629398069974343*^9}, {
  3.629398125325904*^9, 3.629398132146291*^9}, {3.629398184710471*^9, 
  3.629398213973076*^9}},ExpressionUUID->"b2e69fe2-ef7f-4893-b1f1-\
3d95111cf508"],

Cell["\<\
Note that there\[CloseCurlyQuote]s a discontinuity between CW and CCW twists \
that happens at d=0.\
\>", "Text",
 CellChangeTimes->{{3.629402538969198*^9, 
  3.629402557374172*^9}},ExpressionUUID->"65e479d8-e34a-486a-8dfa-\
2063b634f212"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTrapezoidOffsetTwistAngle", "[", 
   RowBox[{"\[Delta]_", ",", " ", "w_", ",", "d_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"d", "\[GreaterEqual]", "0"}], ",", "0", ",", "\[Pi]"}], "]"}], "+", 
   RowBox[{"ArcCot", "[", 
    FractionBox[
     RowBox[{
      SqrtBox["2"], " ", "d", " ", 
      SqrtBox[
       RowBox[{"3", "+", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Delta]"}], "]"}]}]], " ", 
      RowBox[{"Csc", "[", "\[Delta]", "]"}]}], "w"], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.629400702565605*^9, 3.629400713720907*^9}, {
   3.6294012617499256`*^9, 3.629401264464061*^9}, {3.629401994671503*^9, 
   3.629401996029644*^9}, {3.629402027675555*^9, 3.629402091471099*^9}, {
   3.629402265181174*^9, 3.62940226663631*^9}, 3.629402393717937*^9},
 CellLabel->
  "In[3048]:=",ExpressionUUID->"8aacf7a1-d170-43b1-a3f4-707cae1a941f"],

Cell["Example, a CCW twist.", "Text",
 CellChangeTimes->{{3.6294019533982067`*^9, 3.629401954124824*^9}, {
  3.629402099859791*^9, 
  3.629402102019241*^9}},ExpressionUUID->"dfd4fc04-1ff7-46bf-9ed2-\
d7f1851b3352"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitTrapezoidOffsetTwistAngle", "[", 
    RowBox[{
     RowBox[{"70", "\[Degree]"}], ",", ".2", ",", ".1"}], "]"}], "/", 
   "\[Degree]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629401958518027*^9, 3.629402006647528*^9}},
 CellLabel->
  "In[3049]:=",ExpressionUUID->"af6490e3-c40f-4be3-a3f8-017a2bc7584f"],

Cell["Example, a CW twist.", "Text",
 CellChangeTimes->{{3.6294021046005373`*^9, 
  3.629402109650685*^9}},ExpressionUUID->"030c2176-39db-428d-9877-\
fb08d43e9500"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitTrapezoidOffsetTwistAngle", "[", 
    RowBox[{
     RowBox[{"70", "\[Degree]"}], ",", ".2", ",", 
     RowBox[{"-", ".1"}]}], "]"}], "/", "\[Degree]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629401958518027*^9, 3.629402014594428*^9}},
 CellLabel->
  "In[3050]:=",ExpressionUUID->"b33c37e4-9a00-4b45-bddb-0c3b35cb07d0"],

Cell["Example, a 90\[Degree] twist angle twist.", "Text",
 CellChangeTimes->{{3.629402272312723*^9, 
  3.62940228027938*^9}},ExpressionUUID->"41348e28-71fa-48de-9653-\
a169efeb17b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitTrapezoidOffsetTwistAngle", "[", 
    RowBox[{
     RowBox[{"70", "\[Degree]"}], ",", ".2", ",", "0"}], "]"}], "/", 
   "\[Degree]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629401958518027*^9, 3.629402014594428*^9}, 
   3.629402287012197*^9},
 CellLabel->
  "In[3051]:=",ExpressionUUID->"5f4574fa-c760-4d02-9f9f-a8e0c5a8356d"],

Cell[TextData[{
 "UnitTrapezoidOffsetTwistOffset[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha]] returns the offset ",
 StyleBox["d",
  FontSlant->"Italic"],
 " for a unit trapezoid offset twist with base angle \[Delta], pleat width \
\[Omega], and a twist angle of \[Alpha]."
}], "Text",
 CellChangeTimes->{{3.629401373675958*^9, 3.629401394616608*^9}, {
  3.629401432935213*^9, 
  3.629401459565394*^9}},ExpressionUUID->"203afc40-71ea-43cd-a4a0-\
9b6d7138d2e7"],

Cell[TextData[{
 "Note that for \[Alpha] \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "crit"], TraditionalForm]],ExpressionUUID->
  "756b25a5-3b82-4b64-b92d-b7c0d61e8723"],
 ", this will reduce to ",
 StyleBox["w",
  FontSlant->"Italic"],
 "/2."
}], "Text",
 CellChangeTimes->{{3.629401568191077*^9, 
  3.629401591092256*^9}},ExpressionUUID->"81c8175f-fb39-421e-abca-\
7705420edde1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTrapezoidOffsetTwistOffset", "[", 
   RowBox[{"\[Delta]_", ",", " ", "w_", ",", " ", 
    StyleBox["\[Alpha]_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  FractionBox[
   RowBox[{"w", " ", 
    RowBox[{"Cot", "[", "\[Alpha]", "]"}], " ", 
    RowBox[{"Sin", "[", "\[Delta]", "]"}]}], 
   RowBox[{
    SqrtBox["2"], " ", 
    SqrtBox[
     RowBox[{"3", "+", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Delta]"}], "]"}]}]]}]]}]], "Input",
 CellChangeTimes->{{3.629401406462214*^9, 3.629401418192734*^9}, 
   3.62940150792728*^9, 3.629402491545765*^9},
 CellLabel->
  "In[3052]:=",ExpressionUUID->"0b726cf7-f3c0-4d5d-a8bb-cbca5a2507bd"],

Cell["Example, CCW twist.", "Text",
 CellChangeTimes->{{3.629402136001104*^9, 
  3.629402140528838*^9}},ExpressionUUID->"85a28e8e-8033-4904-95dd-\
cf9bf411b486"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTrapezoidOffsetTwistOffset", "[", 
   RowBox[{
    RowBox[{"70", "\[Degree]"}], ",", ".2", ",", 
    RowBox[{"42", "\[Degree]"}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629402145811607*^9, 3.62940217857*^9}},
 CellLabel->
  "In[3053]:=",ExpressionUUID->"3f663e1e-0d13-478b-9676-bec473fa4211"],

Cell["Example, CW twist.", "Text",
 CellChangeTimes->{{3.629402169951935*^9, 
  3.629402173342995*^9}},ExpressionUUID->"1e978950-b47d-4e20-8e3b-\
087d82c64cd4"],

