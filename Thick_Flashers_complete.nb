Cell[TextData[{
 "PtOnLineQ[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns True if a point lies within a specified tolerance of a line."
}], "Text",
 CellChangeTimes->{{3.706715059553174*^9, 
  3.706715097769676*^9}},ExpressionUUID->"5f578d54-b650-49d9-aff2-\
eda1dbb5f63f"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the point\n\t",
 StyleBox["q",
  FontSlant->"Italic"],
 " \[LongDash] a point on the line\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] a vector in the direction of the line."
}], "Text",
 CellChangeTimes->{{3.706715351532359*^9, 
  3.7067153699630957`*^9}},ExpressionUUID->"9c52c874-cc65-40e1-9dc6-\
24bd857dd040"],

Cell[TextData[{
 "Options:\n\tPtOnLineTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the allowable separation distance between the point and line."
}], "Text",
 CellChangeTimes->{{3.706714906168742*^9, 3.706714913582951*^9}, 
   3.706714981280258*^9, {3.7067173565023756`*^9, 
