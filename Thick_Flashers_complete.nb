Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LFFReduction", "::", "notff"}], 
   "=", "\"\<The vertex with sectors `1` is not flat foldable because it does \
not satisfy Kawasaki-Justin.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.534601050392427*^9, 3.534601065736226*^9}, {
  3.534601132418318*^9, 3.534601159943925*^9}},
 CellLabel->
  "In[2052]:=",ExpressionUUID->"004442e8-ae1a-400a-bc6c-d2587f819c36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LFFReduction", "[", "slist_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "angles", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Length", "[", "slist", "]"}], ",", "2"}], "]"}], "\[NotEqual]",
         "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"LFFReduction", "::", "noteven"}], ",", "slist"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"Last", "/@", "slist"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"Equal", " ", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Plus", "@@", "#"}], "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Partition", "[", 
             RowBox[{"angles", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"LFFReduction", "::", "notff"}], ",", "angles"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Drop", "[", 
      RowBox[{
       RowBox[{"FixedPointList", "[", 
        RowBox[{"LFFReduce", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "}"}], ",", "slist"}], "}"}]}], "]"}], ",", 
       RowBox[{"-", "1"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.534594162230577*^9, 3.53459418491595*^9}, {
   3.534594227673239*^9, 3.53459423213843*^9}, {3.534594427588804*^9, 
   3.5345944301837587`*^9}, {3.534594699833996*^9, 3.534594736369747*^9}, {
   3.534594872296376*^9, 3.534594876072212*^9}, {3.534601096828103*^9, 
