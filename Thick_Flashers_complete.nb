Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457626158317848*^9, 
  3.457626158821782*^9}},ExpressionUUID->"16d5a340-86a3-4233-a4d2-\
774347ca5aa2"],

Cell["\<\
TGeneratingVertex is a mixin class that has the property GeneratingVertex, \
which specifies a single TVertex from which an entire crease pattern can be \
built. This includes Huffman grids, Yoshimura-oris, Miura-oris, and mixtures \
of the latter two.\
\>", "Text",
 CellChangeTimes->{{3.642610350268178*^9, 3.642610386735517*^9}, {
  3.643238022893188*^9, 3.643238110647987*^9}, {3.643238909553523*^9, 
  3.643238909587508*^9}, {3.643240252968924*^9, 
  3.6432403221312857`*^9}},ExpressionUUID->"5a2983dd-b228-4781-9439-\
fb066c19fc44"]
}, Closed]],

