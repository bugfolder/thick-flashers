     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"65", "\[Degree]"}], ",", 
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"115", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa2", "=", 
      RowBox[{"{", 
