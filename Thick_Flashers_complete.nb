Cell[BoxData[
 RowBox[{
  RowBox[{"Styled3DArc", "[", 
   RowBox[{"r1_List", ",", " ", "r2_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "al", ",", "ls", ",", "fs", ",", "m1", ",", "m2", ",", "x", ",", "y", ",",
       "z", ",", "a", ",", "arc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"al", "=", 
      RowBox[{
       RowBox[{"ArcLabel", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DArc", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ls", "=", 
      RowBox[{
       RowBox[{"LineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DArc", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{
       RowBox[{"FillStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DArc", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m1", "=", 
      RowBox[{"Mag", "[", "r1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m2", "=", 
      RowBox[{"Mag", "[", "r2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{"r1", "/", "m1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"r2", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", ".", "r2"}], ")"}], "x"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"x", "~", "Cross", "~", "y"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{"x", ".", "r2"}], ",", 
        RowBox[{"y", ".", "r2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"arc", "=", 
      RowBox[{"PolygonalEllipseArc3D", "[", 
       RowBox[{"r1", ",", "r2", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"fs", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}], "}"}], "~", "Join", "~",
              "arc", "~", "Join", "~", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}], "}"}]}], "]"}], ",", 
           "fs"}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ls", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", "arc", "]"}], ",", "ls"}], "]"}]}], "]"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"al", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"al", ",", 
           RowBox[{
            SuperscriptBox["m1", 
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}]], 
            SuperscriptBox["m2", 
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}]], 
            RowBox[{
             RowBox[{"U", "[", 
              RowBox[{"0.5", " ", "a"}], "]"}], ".", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}]}]}], "]"}]}], "]"}]}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.439841500019602*^9, 3.439841655590064*^9}, {
   3.4398417225542507`*^9, 3.439841933739073*^9}, {3.439841979990861*^9, 
