Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTYoshimuraOri", "::", "badsize"}], 
   "=", "\"\<TVertex `1` must be degree-6; its degree is `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.595005148978063*^9, 3.5950051820813847`*^9}, 
   3.595010922831157*^9, {3.6161801299291363`*^9, 3.616180132585767*^9}},
