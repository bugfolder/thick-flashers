Cell[CellGroupData[{

Cell[TextData[{
 "MakeSpacerMiuraOri[\[Alpha], {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dv, ds",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MajorFoldAngle, SpacerMiuraOriOffset"
}], "Subsubsection",
 CellChangeTimes->{{3.703601494450306*^9, 3.703601523738122*^9}, 
   3.704023928838139*^9, {3.9140087316485023`*^9, 
   3.9140087380404453`*^9}},ExpressionUUID->"4d05d9e7-2b0b-41b7-91b1-\
f5b15de7b8b6"],

Cell[TextData[{
 "MakeSpacerMiuraOri[\[Alpha], {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dv",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ds",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}] creates a Miura-ori  with spacers in which the crease pattern is \
oriented so that major folds zigzag vertically, minor folds run strictly \
horizontally."
}], "Text",
 CellChangeTimes->{{3.703598860718053*^9, 3.703598884115151*^9}, {
  3.703598916462899*^9, 3.703598940803869*^9}, {3.70359909166179*^9, 
  3.703599094245612*^9}, {3.703601625621866*^9, 
  3.703601643772078*^9}},ExpressionUUID->"8f3762d6-64d6-42d2-8b4c-\
d2724a8b878b"],

Cell[TextData[{
 "Arguments:\n\t\[Alpha] \[LongDash] the bottom left sector angle (typically \
acute).\n\t{",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dv, ds",
  FontSlant->"Italic"],
 "} \[LongDash] lengths of the horizontal, near-vertical, and vertical spacer \
creases, respectively.\n\t{",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "} \[LongDash] number of facets in the horizontal and vertical directions, \
respectively."
}], "Text",
 CellChangeTimes->{{3.703598951539398*^9, 3.703599029292788*^9}, {
  3.7035991125415807`*^9, 3.703599118260792*^9}, {3.703600018462603*^9, 
  3.703600029693411*^9}, {3.703601652699983*^9, 
  3.703601663436122*^9}},ExpressionUUID->"e9f5787d-4faa-4fce-96ad-\
4a271452d900"],

Cell[TextData[{
 "Options:\n\tMajorFoldAngle \[Rule] \[Gamma], specifies the major fold angle \
in the 3D form.\n\tSpacerMiuraOriOffset \[Rule] ",
 StyleBox["so",
  FontSlant->"Italic"],
 ", specifies the row offset that determines what type of facet is in the \
first row."
}], "Text",
 CellChangeTimes->{{3.70360012517419*^9, 3.703600152742341*^9}, {
  3.91400875033062*^9, 
  3.914008786031076*^9}},ExpressionUUID->"f7b217f8-17eb-462f-ad5e-\
a6c9ec49aa07"],

Cell["\<\
Returns a TGraph3D+TAssigned of the crease pattern and folded form.\
\>", "Text",
 CellChangeTimes->{{3.703599120461484*^9, 3.7035991362138033`*^9}, {
  3.703599170245399*^9, 
  3.703599175293489*^9}},ExpressionUUID->"06a81c82-3f99-4b83-ac1c-\
f080f427a5cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SpacerMiuraOriOffset", "::", "usage"}], 
   "=", "\"\<SpacerMiuraOriOffset is an option to MakeSpacerMiuraOri that \
specifies the row offset that determines what type of facet is in the first \
row.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.7036031123055058`*^9, 3.7036031876046047`*^9}},
 CellLabel->
  "In[2527]:=",ExpressionUUID->"bc5f1d1e-820a-433e-8e73-8af00e97f43b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeSpacerMiuraOri", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MajorFoldAngle", "\[Rule]", 
      RowBox[{"90", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"SpacerMiuraOriOffset", "\[Rule]", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.703600225055538*^9, 3.703600255256542*^9}, 
   3.703601678792663*^9, {3.703603171280801*^9, 3.703603178544014*^9}},
 CellLabel->
  "In[2528]:=",ExpressionUUID->"d714dec4-0bda-423c-96ac-b1ef9ddf4a8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSpacerMiuraOri", "[", 
   RowBox[{"\[Alpha]_", ",", 
    RowBox[{"{", 
     RowBox[{"dh_", ",", "dv_", ",", "ds_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"nh_", ",", "nv_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "so", ",", "gmj", ",", "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",",
       "\[Gamma]4", ",", "ca", ",", "sa", ",", "vfn", ",", "v3dfn", ",", 
      "hetfn", ",", "vetfn", ",", "heafn", ",", "veafn", ",", "tobj"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"so", "=", 
      RowBox[{
       RowBox[{"SpacerMiuraOriOffset", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSpacerMiuraOri", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gmj", "=", 
      RowBox[{
       RowBox[{"MajorFoldAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSpacerMiuraOri", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4"}], 
       "}"}], "=", 
      RowBox[{"MakeDihedralsFromSectorsAndMajorDihedral", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Pi]", "-", "\[Alpha]"}], ",", 
          RowBox[{"\[Pi]", "/", "2"}], ",", 
          RowBox[{"\[Pi]", "/", "2"}], ",", "\[Alpha]"}], "}"}], ",", "gmj"}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<fold angles: \>\"", ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", 
            "\[Gamma]4"}], "}"}], "/", "\[Degree]"}], "]"}]}], "]"}], "//", 
      "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ca", ",", "sa"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Alpha]", "]"}], ",", 
        RowBox[{"Sin", "[", "\[Alpha]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "0"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", " ", "dh"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vfn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"j", "+", "so"}], ",", "4"}], "]"}], ",", 
         "\[IndentingNewLine]", "0", ",", 
         RowBox[{
          RowBox[{"vfn", "[", 
           RowBox[{"i", ",", 
            RowBox[{"j", "-", "1"}]}], "]"}], "+", 
          RowBox[{"ds", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}]}], ",", "\[IndentingNewLine]", 
         "1", ",", 
         RowBox[{
          RowBox[{"vfn", "[", 
           RowBox[{"i", ",", 
            RowBox[{"j", "-", "1"}]}], "]"}], "+", 
          RowBox[{"dv", 
           RowBox[{"{", 
            RowBox[{"ca", ",", "sa"}], "}"}]}]}], ",", "\[IndentingNewLine]", 
         "2", ",", 
         RowBox[{
          RowBox[{"vfn", "[", 
           RowBox[{"i", ",", 
            RowBox[{"j", "-", "1"}]}], "]"}], "+", 
          RowBox[{"ds", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}]}], ",", "\[IndentingNewLine]", 
         "3", ",", 
         RowBox[{
          RowBox[{"vfn", "[", 
           RowBox[{"i", ",", 
            RowBox[{"j", "-", "1"}]}], "]"}], "+", 
          RowBox[{"dv", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "ca"}], ",", "sa"}], "}"}]}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"veafn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"veafn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "=", 
       RowBox[{
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"j", "+", "so"}], ",", "2"}], "]"}], ",", 
          "\[IndentingNewLine]", "0", ",", "\[Gamma]1", ",", 
          "\[IndentingNewLine]", "1", ",", "\[Gamma]3"}], "]"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"i", ",", "2"}], "]"}], "\[Equal]", "1"}], ",", "1", ",", 
          
          RowBox[{"-", "1"}]}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"FoldAngleToType", "[", 
       RowBox[{"veafn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"heafn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"heafn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "=", 
       RowBox[{
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"j", "+", "so"}], ")"}], "/", "2"}], "]"}], ",", "2"}],
            "]"}], ",", "\[IndentingNewLine]", "0", ",", "\[Gamma]2", ",", 
          "\[IndentingNewLine]", "1", ",", "\[Gamma]4"}], "]"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"i", ",", "2"}], "]"}], "\[Equal]", "0"}], ",", "1", ",", 
          
          RowBox[{"-", "1"}]}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"FoldAngleToType", "[", 
       RowBox[{"heafn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeQuadMesh", "[", 
        RowBox[{"nh", ",", "nv", ",", "\[IndentingNewLine]", 
         RowBox[{"VerticesFn", "\[Rule]", "vfn"}], ",", "\[IndentingNewLine]", 
         RowBox[{"HorizontalEdgeTypeFn", "\[Rule]", "hetfn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VerticalEdgeTypeFn", "\[Rule]", "vetfn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"HorizontalEdgeAngleFn", "\[Rule]", "heafn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VerticalEdgeAngleFn", "\[Rule]", "veafn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"FoldGraph3D", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"tobj", "[", "FoldAngles", "]"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.703599178944511*^9, 3.703599199005152*^9}, {
   3.703599334015287*^9, 3.703599375127532*^9}, {3.703599425401246*^9, 
   3.703599460544527*^9}, {3.703599623571434*^9, 3.703599839284009*^9}, {
   3.703599909845066*^9, 3.7035999199887257`*^9}, {3.703599955806253*^9, 
   3.703599987197762*^9}, {3.703600038135757*^9, 3.703600078021848*^9}, {
   3.703600261311837*^9, 3.703600289376577*^9}, {3.70360045904334*^9, 
   3.7036004806657457`*^9}, {3.703600526447012*^9, 3.703600745582404*^9}, {
   3.703600788151904*^9, 3.703600795853896*^9}, {3.703600841595739*^9, 
   3.7036008547598886`*^9}, {3.703600923246702*^9, 3.703601012759622*^9}, {
   3.70360104442437*^9, 3.703601076328532*^9}, {3.70360111685032*^9, 
   3.7036011329032297`*^9}, 3.70360168279429*^9, {3.703602011984455*^9, 
   3.703602045136661*^9}, {3.703602112385505*^9, 3.703602114489276*^9}, {
   3.703602159755996*^9, 3.703602165792714*^9}, {3.703602476164819*^9, 
