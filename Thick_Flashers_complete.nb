Cell[TextData[{
 "ExtractFracturedStyledLines",
 "[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] adds one more step; it then selects out just the styled Lines so that \
what is returned is a flat list of styled line segments."
}], "Text",
 CellChangeTimes->{{3.484863359539217*^9, 3.484863448557379*^9}, {
