Cell[TextData[{
 "FlasherSectorTriangles[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h, k",
  FontSlant->"Italic"],
 "] returns a list of vertex triplets for the triangle facets in this order:\n\
\tbottom-outside\n\tbottom-inside\n\ttop-inside\n\ttop-outside\nSo that in \
the major region, the vertices cycle counterclockwise and in the minor region \
they cycle clockwise. "
}], "Text",
 CellChangeTimes->{{3.5557871358253098`*^9, 3.5557871483932943`*^9}, {
   3.555787180565534*^9, 3.5557872809976187`*^9}, 3.5557873285904927`*^9, 
   3.555854306606194*^9, 3.555854344852313*^9, {3.555871949805155*^9, 
   3.555871958649729*^9}, {3.5558719950956717`*^9, 3.555872013533843*^9}, {
   3.555954590986568*^9, 3.555954618232604*^9}, 
   3.71994379729462*^9},ExpressionUUID->"9fd1bfce-5456-47aa-998f-\
eec90e9ea792"],

Cell["\<\
Note that we build this function by duplicating the quad function and editing \
slightly. When the strict inequalities of the latter reach equality (the \
former), we get a triangle.\
\>", "Text",
 CellChangeTimes->{
  3.719943800328022*^9},ExpressionUUID->"194189dc-087b-446c-8f44-\
99dc6068fd79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherSectorTriangles", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "i", ",", "j", ",", "quad"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"r", "*", "h"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "total", " ", "number", " ", "of", " ", "radial", " ", "increments"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"major", " ", "region"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"j", "=", 
               RowBox[{"h", "*", "ig"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{
                   RowBox[{"j", "+", "h"}], ",", "i"}], "]"}], "\[Equal]", 
                 "j"}], ",", 
                RowBox[{"quad", "[", 
                 RowBox[{
                  SubscriptBox["v", 
                   RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"i", "-", "1"}], ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{"i", ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "h"}], ",", 
                    RowBox[{"i", "+", "1"}]}], "]"}], ",", "k"}]]}], "]"}], ",", 
                RowBox[{"{", "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ig", ",", "0", ",", 
              RowBox[{"r", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"h", "*", "ig"}], ",", "n"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"minor", " ", "region"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{
                RowBox[{"h", "*", "ig"}], "-", "1"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{
                   RowBox[{"i", "+", "h"}], ",", 
                   RowBox[{"j", "-", "2"}]}], "]"}], "\[Equal]", "i"}], ",", 
                RowBox[{"quad", "[", 
                 RowBox[{
                  SubscriptBox["v", 
                   RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{"i", ",", 
                    RowBox[{"j", "-", "1"}], ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"i", "+", "h"}], ",", 
                    RowBox[{"j", "-", "1"}]}], "]"}], ",", "j", ",", "k"}]]}],
                  "]"}], ",", 
                RowBox[{"{", "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ig", ",", "0", ",", 
              RowBox[{"r", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{
               RowBox[{"h", "*", "ig"}], "+", "1"}], ",", "n"}], "}"}]}], 
           "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"quad", "\[Rule]", "List"}]}], "/.", 
      RowBox[{"FlasherWrapRules", "[", "v", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555752024152504*^9, 3.555752074979555*^9}, {
   3.555752202331157*^9, 3.555752222580246*^9}, {3.555752274078933*^9, 
   3.555752277280715*^9}, {3.5557523475801153`*^9, 3.55575237310624*^9}, {
   3.555752407119998*^9, 3.555752445388029*^9}, {3.555752545862665*^9, 
   3.555752604516288*^9}, 3.555752900442992*^9, {3.555753058696467*^9, 
