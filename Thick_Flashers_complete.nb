Cell[TextData[{
 "FaceCentroid[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["face",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.591983020427122*^9, 
  3.591983024312618*^9}},ExpressionUUID->"683b736a-693b-4e00-a68e-\
844d2f9afa28"],

Cell[TextData[{
 "FaceCentroid[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["face",
  FontSlant->"Italic"],
 "] takes a list of vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " and a CCW ",
 StyleBox["face",
  FontSlant->"Italic"],
 " as indices into ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " and returns the centroid of the face. Note this works in any dimension."
}], "Text",
 CellChangeTimes->{{3.591983035342994*^9, 3.591983074885067*^9}, {
  3.591983575045144*^9, 3.591983579436971*^9}, {3.62784358531793*^9, 
  3.627843586126031*^9}},ExpressionUUID->"2e26a4ae-67a0-4407-9f5b-\
9b226453624f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceCentroid", "[", 
   RowBox[{"verts_List", ",", "face_"}], "]"}], ":=", 
  RowBox[{"Centroid", "[", 
   RowBox[{"verts", "\[LeftDoubleBracket]", "face", "\[RightDoubleBracket]"}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.591982990194078*^9, 3.591983030930868*^9}, {
   3.591983104877582*^9, 3.59198312302964*^9}, 3.627328600934901*^9},
 CellLabel->
  "In[1175]:=",ExpressionUUID->"31f4335c-0edf-4f04-8994-ed7f7538835f"],

