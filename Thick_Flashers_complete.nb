         RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"prp", "=", 
      RowBox[{"MakePlanarRoundedPlateGC", "[", 
       RowBox[{"poly", ",", "0.2", ",", 
        RowBox[{"RoundingDivisions", "\[Rule]", "5"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"prp", ",", 
        RowBox[{"FaceForm", "[", 
         RowBox[{"Green", ",", "Red"}], "]"}], ",", 
        RowBox[{"Opacity", "[", ".5", "]"}]}], "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
