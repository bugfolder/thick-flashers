Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "alist", ",", "dlist", ",", "w", ",", "nw", ",", "\[Gamma]", ",", "tobj",
       ",", "ci"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"alist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}], ",", 
        RowBox[{"89", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dlist", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nw", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"45.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSemigeneralizedMiuraOriA", "[", 
       RowBox[{"alist", ",", "dlist", ",", "w", ",", "nw", ",", "\[Gamma]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ci", "=", 
      RowBox[{"tobj", "[", "CornerIndices", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CornerIndices = \>\"", ",", "ci"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"FoldAngleGraphics", "[", "tobj", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"FoldedFormGraphics3D", "[", 
        RowBox[{"VertexRotateGraph3D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "4", ",", "11"}], "}"}]}], "]"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
