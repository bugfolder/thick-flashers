Cell[CellGroupData[{

Cell[TextData[{
 "PruneTiling[",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.627576400981699*^9, 3.627576402812664*^9}, 
   3.627659949373043*^9, 
   3.627660090154933*^9},ExpressionUUID->"b5b597eb-8ad8-4c2c-9caa-\
1a10d4b00146"],

Cell[TextData[{
 "PruneTiling[",
 StyleBox["tilespecs, verts",
  FontSlant->"Italic"],
 "] takes the tiling specified by ",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 " and eliminates any tiles that lie wholly outside of the convex polygon \
verts, returning the reduced list of tilespecs. The clipping polygon verts is \
given as a list of coordinate pairs for the vertices of the clipping \
polygon."
}], "Text",
 CellChangeTimes->{{3.457784981304348*^9, 3.4577850325231943`*^9}, 
   3.457785142370901*^9, {3.457786003182385*^9, 3.457786018091217*^9}, {
   3.593043617780239*^9, 3.593043617938672*^9}, 3.617469034480527*^9, 
   3.627385976116486*^9, {3.627576437760943*^9, 3.627576441201474*^9}, {
   3.627659950779231*^9, 
   3.627659955100171*^9}},ExpressionUUID->"64eb06ad-c057-485c-bfb0-\
6ce033fa348f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PruneTiling", "[", 
   RowBox[{"tilespecs_", ",", "verts_List"}], "]"}], ":=", 
  RowBox[{"Select", "[", 
   RowBox[{"tilespecs", ",", 
    RowBox[{
     RowBox[{"TilespecInTilingQ", "[", 
      RowBox[{"#", ",", "verts"}], "]"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.457782136533043*^9, 3.457785142393678*^9, {3.4577859558995*^9, 
   3.457785959257265*^9}, {3.457786097337102*^9, 3.457786097695617*^9}, {
