  3.457529360289851*^9}},ExpressionUUID->"f267523f-531c-4635-9bdd-\
2168c667ea17"],

Cell[TextData[{
 "U[\[Phi]] returns a unit vector at angle \[Phi]. U[\[Phi]1, \[Phi]2, \
\[Ellipsis] \[Phi]",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns the sum U[\[Phi]1]+U[\[Phi]2]+\[Ellipsis]U[\[Phi]",
 StyleBox["n",
  FontSlant->"Italic"],
 "]."
}], "Text",
 CellChangeTimes->{{3.4575293654747477`*^9, 
  3.457529369306418*^9}},ExpressionUUID->"9e33bf72-bdb9-4fc7-b8a9-\
eb0f5b4ef6bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"U", "[", "\[Phi]_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "}"}]}]], "Input",
 CellLabel->
  "In[213]:=",ExpressionUUID->"8d65f0b1-22fb-4355-a844-97523ca39391"],

Cell[BoxData[
 RowBox[{
  RowBox[{"U", "[", "\[Phi]list___", "]"}], ":=", 
  RowBox[{"Plus", "@@", 
   RowBox[{"(", 
    RowBox[{"U", "/@", 
     RowBox[{"{", "\[Phi]list", "}"}]}], ")"}]}]}]], "Input",
 CellLabel->
  "In[214]:=",ExpressionUUID->"393855cf-3e0e-4cec-ad9c-aa29c9015650"],

