f7cc2c66d693"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gclist", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gclist", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
