Cell[CellGroupData[{

Cell[TextData[{
 "Indexify[",
 StyleBox["obj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["levspec",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ",
 "SamePtTolerance",
 ", StartPoints, SameTest"
}], "Subsubsection",
 CellChangeTimes->{{3.455895390979546*^9, 3.45589540160826*^9}, {
   3.455923043521679*^9, 3.455923076355988*^9}, {3.45592313041294*^9, 
   3.455923135596507*^9}, {3.456533558910507*^9, 3.456533560877943*^9}, {
   3.464013808855545*^9, 3.4640138401237917`*^9}, 
   3.594653993100479*^9},ExpressionUUID->"5dfcbbd4-9fad-4112-8623-\
1b3dbdb4abc0"],

Cell[TextData[{
 "Indexify[",
 StyleBox["obj, levspec, opts",
  FontSlant->"Italic"],
 "] takes an object ",
 StyleBox["obj",
  FontSlant->"Italic"],
 " that has points (lists of real numbers) at level ",
 StyleBox["levpec",
  FontSlant->"Italic"],
 " and returns a list {",
 StyleBox["pts, obj1",
  FontSlant->"Italic"],
 "} where ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " is a list of all unique points in the object and ",
 StyleBox["obj1",
  FontSlant->"Italic"],
 " is the same as ",
 StyleBox["obj",
  FontSlant->"Italic"],
 " but with each point replaced by its index into ",
 StyleBox["pts",
  FontSlant->"Italic"],
 ". If you don't supply ",
 StyleBox["levspec",
  FontSlant->"Italic"],
 ", level 1 is assumed. Options are:\n\t",
 "SamePtTolerance ",
 "\[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the distance tolerance passed to SamePtQ (when we use as the default \
comparison function).\n\tSameTest \[Rule] ",
 StyleBox["test",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["test",
  FontSlant->"Italic"],
 " is the test for whether two points are the same. SamePtQ is the default, \
but we can also use Equal[] to compare algebraic point descriptions.\n\t\
StartPoints \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["list",
  FontSlant->"Italic"],
 " is a set of initial points to choose from. Use this if you already have a \
list and want to preserve the order."
}], "Text",
 CellChangeTimes->{{3.455895403701448*^9, 3.455895437985524*^9}, {
   3.455923072479362*^9, 3.455923100204255*^9}, {3.464014056934086*^9, 
   3.4640141901320057`*^9}, {3.5946500641353617`*^9, 3.594650064468911*^9}, 
   3.594653994455545*^9, {3.693410573812074*^9, 
   3.69341058064333*^9}},ExpressionUUID->"dd2d5366-18b7-47ab-b25d-\
7598aa2bf076"],

Cell[TextData[{
 "This function can be used, for example, to create a GraphicsComplex, or to \
take an imported ",
 "plane graph",
 " and convert it to the standard {",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 "} representation."
}], "Text",
 CellChangeTimes->{{3.457620509547132*^9, 3.457620546848832*^9}, 
   3.484829044103731*^9},ExpressionUUID->"48f0ed17-384a-48fa-97b3-\
89a429ed8251"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StartPoints", "::", "usage"}], 
   "=", "\"\<StartPoints is an option to Indexify that specifies an initial \
list of points to use in when indexifying an object.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592042424317895*^9, 3.592042475790908*^9}},
 CellLabel->
  "In[1092]:=",ExpressionUUID->"dfb0f2f5-7610-43d1-aa6b-5ecefc497d70"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Indexify", "]"}], "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Options", "[", "SamePtQ", "]"}], ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"StartPoints", "\[Rule]", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"SameTest", "\[Rule]", "SamePtQ"}]}], "\[IndentingNewLine]", 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.464013865096822*^9, 3.464013907555201*^9}, {
   3.464014040530739*^9, 3.464014043666436*^9}, 3.464014210446513*^9},
 CellLabel->
  "In[1093]:=",ExpressionUUID->"2fd219d8-a33a-4b9a-bbed-16cc85ea4a54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Indexify", "[", 
   RowBox[{"obj_", ",", 
    RowBox[{"levspec_Integer", ":", "1"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sp", ",", "st", ",", "allpts", ",", "il"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"StartPoints", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Indexify", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"st", "=", 
      RowBox[{
       RowBox[{"SameTest", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Indexify", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allpts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"obj", ",", "levspec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Reverse", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"p", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"il", "=", 
                RowBox[{"Position", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"st", "[", 
                    RowBox[{"#", ",", "p", ",", "opts"}], "]"}], "&"}], "/@", 
                   "sp"}], ",", "True"}], "]"}]}], ";", 
               RowBox[{
                RowBox[{"Length", "[", "il", "]"}], "\[Equal]", "0"}]}], ",", 
              
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"sp", ",", "p"}], "]"}], ";", 
               RowBox[{"Length", "[", "sp", "]"}]}], ",", 
              RowBox[{"il", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], 
           "]"}], ",", "obj", ",", 
          RowBox[{"{", "levspec", "}"}]}], "]"}], ",", "sp"}], "}"}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.455895413735746*^9, 3.455895424574218*^9}, {
   3.45592310910557*^9, 3.455923119014896*^9}, {3.464013860076861*^9, 
   3.464013860746434*^9}, {3.464013919122305*^9, 3.464014031018732*^9}, {
   3.701729308604926*^9, 3.7017293087077*^9}, {3.701729394486114*^9, 
   3.701729399099461*^9}, 3.7017294849602833`*^9},
 CellLabel->
  "In[1094]:=",ExpressionUUID->"c629ea7e-7abc-4ce2-9ccb-9b2847d44351"],

