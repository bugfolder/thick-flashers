   3.555956267396833*^9}, 3.719848622652294*^9, 3.719848673636278*^9, 
   3.719853924223839*^9, 3.719854079697782*^9, 3.7198788760566463`*^9, 
   3.719936124527488*^9},ExpressionUUID->"dfc36fd7-60e9-4fe4-9781-\
2dadb73e9506"],

Cell[TextData[{
 "FlasherDefaultCPRules[",
 StyleBox["p, m",
  FontSlant->"Italic"],
 "] returns a rule that maps any CP vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"004ea454-abc4-4bde-8440-495b9e8d2d73"],
 " to its theoretically ideal position in the CP for rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.555750564981019*^9, 3.555750606946005*^9}, 
   3.5557584440023203`*^9, {3.719848591164627*^9, 3.719848622665248*^9}, 
   3.7198486736487713`*^9, 3.719853926593741*^9, 3.7198540797103157`*^9, 
   3.719936124549892*^9, {3.825671042152316*^9, 
   3.8256710423544893`*^9}},ExpressionUUID->"705a42ac-066b-48d4-b12b-\
406ccd10efe2"],

Cell["This is the exact position for a zero-thickness flasher.", "Text",
 CellChangeTimes->{{3.825671413274153*^9, 
  3.825671421665993*^9}},ExpressionUUID->"916544da-e5ca-4099-b53e-\
1ffd0fa1d412"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherDefaultCPRules", "[", 
   RowBox[{"p_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["p", 
     RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
    RowBox[{
     RowBox[{"FlasherRotation2D", "[", 
      RowBox[{"k", ",", "m"}], "]"}], ".", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Tan", "[", 
        FractionBox["\[Pi]", "m"], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Pi]", "m"], "]"}], ",", "1"}], "}"}]}], "+", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"i", "+", "1"}], "\[GreaterEqual]", "j"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "+", "1"}], ")"}], " ", 
             RowBox[{"U", "[", 
              RowBox[{
               FractionBox["\[Pi]", "2"], "+", 
               FractionBox[
                RowBox[{"2", "\[Pi]"}], "m"]}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"Tan", "[", 
              FractionBox["\[Pi]", "m"], "]"}], "j", " ", 
             RowBox[{"U", "[", 
              FractionBox[
               RowBox[{"2", "\[Pi]"}], "m"], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"j", " ", 
             RowBox[{"U", "[", 
              FractionBox["\[Pi]", "2"], "]"}]}], "-", 
            RowBox[{
             RowBox[{"Tan", "[", 
              FractionBox["\[Pi]", "m"], "]"}], 
             RowBox[{"(", 
              RowBox[{"i", "+", "1"}], ")"}], 
             RowBox[{"U", "[", "0", "]"}]}]}]}], "]"}]}], ")"}]}], "]"}]}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.5557504815133343`*^9, 3.555750540411933*^9}, 
   3.555758452927258*^9, {3.55585029280422*^9, 3.555850294009338*^9}, {
   3.719848622675411*^9, 3.719848673655019*^9}, 3.719854079717201*^9, 
   3.719936124563055*^9, 3.719943219316766*^9, 3.719943285707497*^9, 
   3.854917666098461*^9, {3.854988037477578*^9, 3.854988045619648*^9}},
 CellLabel->
  "In[4096]:=",ExpressionUUID->"ee5d796f-dad6-4191-905a-c6bb07e6846e"],

