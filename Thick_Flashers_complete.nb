 RowBox[{
  RowBox[{"Hat", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "\[Pi]"}], ",", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", "0", ",", 
