Cell[CellGroupData[{

Cell["\<\
Collinear cleanup of TGraphAssigned, TGraph2DAssigned, TGraph3DAssigned\
\>", "Subsection",
 CellChangeTimes->{{3.707912053389978*^9, 
  3.707912069999239*^9}},ExpressionUUID->"ec20d403-0667-4fb5-84ac-\
