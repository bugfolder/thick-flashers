Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherDefaultDPRules[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.911583270300634*^9, 3.911583312197386*^9}, {
   3.911583343562877*^9, 3.911583344732511*^9}, {3.9115834672259417`*^9, 
   3.911583490907662*^9}, 3.9115843382444887`*^9, {3.911815796135847*^9, 
   3.911815796630776*^9}, 
   3.9118164402765923`*^9},ExpressionUUID->"c552271c-bcbd-46f7-b06f-\
1bc00ffeb47d"],

Cell[TextData[{
 "ThickFlasherDefaultDPRules[",
 StyleBox["p, r, h, m, t",
  FontSlant->"Italic"],
 "] returns a rule that maps any vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"5835e59e-629e-40fd-ab32-7506cee4dcd4"],
 " to its position in the Deployed Pattern (DP) for rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 ". This adds the desired sag of the deployed form to the otherwise \
zero-thickness flasher pattern."
}], "Text",
 CellChangeTimes->{{3.911583299555171*^9, 3.9115833089150457`*^9}, {
  3.911583353677216*^9, 3.91158335510524*^9}, {3.911583484371084*^9, 
  3.91158352507426*^9}, {3.91158434104525*^9, 3.911584361193976*^9}, {
  3.911815802213584*^9, 3.911815848066235*^9}, {3.9118164420497828`*^9, 
  3.9118164498570538`*^9}, {3.913542383663423*^9, 3.913542386318994*^9}, {
  3.9135424249763193`*^9, 
  3.913542489798656*^9}},ExpressionUUID->"fa9f6189-1c62-4e57-84e0-\
a164e238c707"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the variable to use.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the number of rings.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational index.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the desired panel thickness."
}], "Text",
 CellChangeTimes->{{3.91158331950962*^9, 3.911583328331612*^9}, {
   3.911583370203165*^9, 3.911583430988226*^9}, 3.9115835161208963`*^9, 
   3.91158434246274*^9},ExpressionUUID->"198cc6d4-c3eb-44e8-aaea-\
801dac13fe58"],

Cell["\<\
Returns: a list of rules that gives the vertex positions in the thick \
deployed pattern for the default configuration. \
\>", "Text",
 CellChangeTimes->{{3.911583432765998*^9, 3.911583438582089*^9}, {
   3.9115835306550813`*^9, 3.911583603218736*^9}, {3.911646365443915*^9, 
   3.911646366634304*^9}, {3.911815906949933*^9, 3.911815977329935*^9}, 
   3.91182728014123*^9, 
   3.9135425058424053`*^9},ExpressionUUID->"ceee1736-48c9-4ae4-ae03-\
3619bebd1300"],

Cell["\<\
Note that this is a 3D form, as it incorporates the sag that gives the \
thickness. The sag is exact; the x-y position is approximate, and will be \
used as the starting point when computing the exact solution.\
\>", "Text",
 CellChangeTimes->{
  3.91182728244215*^9, {3.91354251887166*^9, 
   3.9135425280730762`*^9}},ExpressionUUID->"22a026af-5ac8-4dba-99ca-\
ac8ef3d9ee78"],

Cell["\<\
This surface is the Embedded Zero-Thickness  (EZT) surface of the thick-panel \
flasher.\
\>", "Text",
 CellChangeTimes->{{3.9118272930724697`*^9, 3.911827323489313*^9}, {
  3.913542548122596*^9, 
  3.913542554578495*^9}},ExpressionUUID->"8303b83b-c4b8-43c5-9e9f-\
ffc86697a459"],

Cell[TextData[{
 "The central polygon and all of the major valley folds are at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "ec7e19fd-f09b-4215-9435-f1b4ce516b86"],
 ". The major mountain folds are at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{"-", "t"}]}], TraditionalForm]],ExpressionUUID->
  "a9e70c6e-9b19-4348-b087-97dff30b6b8f"],
 "."
}], "Text",
 CellChangeTimes->{{3.911902640500665*^9, 
  3.911902696251671*^9}},ExpressionUUID->"831d2a05-fe8c-4630-a16f-\
ef5c888e9b37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherDefaultDPRules", "[", 
   RowBox[{"p_", ",", "r_", ",", "h_", ",", "m_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ffls", ",", "cprules", ",", "tpverts", ",", "btverts", ",", "rules", ",",
       "q"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Get", " ", "the", " ", "first", " ", "sector", " ", "structure"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ffls", "=", 
      RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Get", " ", "default", " ", "CP", " ", "rules"}], ",", " ", 
       RowBox[{"which", " ", 
        RowBox[{"we", "'"}], "ll", " ", "use", " ", "for", " ", "X", " ", 
        "and", " ", "Y", " ", 
        RowBox[{"coordinates", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"cprules", "=", 
      RowBox[{"FlasherDefaultCPRules", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Collect", " ", "lines", " ", "of", " ", "each", " ", "sag", " ", 
        "value", " ", "for", " ", "k"}], "=", 
       RowBox[{"0", " ", 
        RowBox[{"vertices", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tpverts", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "&"}], "/@", 
           RowBox[{"Select", "[", 
            RowBox[{"ffls", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
               "==", "\"\<tp\>\""}], "&"}]}], "]"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}],
           "==", "0"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"btverts", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "&"}], "/@", 
           RowBox[{"Select", "[", 
            RowBox[{"ffls", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
               "==", "\"\<bt\>\""}], "&"}]}], "]"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}],
           "==", "0"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rules", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"#", "/.", "cprules"}], ",", "0"}], "]"}]}], "&"}], "/@",
          "tpverts"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"#", "/.", "cprules"}], ",", 
             RowBox[{"-", "t"}]}], "]"}]}], "&"}], "/@", "btverts"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Augment", " ", "this", " ", "for", " ", "the", " ", "remaining", " ", 
       RowBox[{"sectors", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"rules", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["p", 
              RowBox[{"i_", ",", "j_", ",", "k_"}]], "->", "q_"}], ")"}], "->", 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["p", 
              RowBox[{"i", ",", "j", ",", 
               RowBox[{"k", "+", "l"}]}]], "->", 
             RowBox[{
              RowBox[{"FlasherRotation3D", "[", " ", 
               RowBox[{"l", ",", "m"}], "]"}], ".", "q"}]}], ")"}]}], "}"}]}],
         ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "//", "Flatten"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.91181646529412*^9, 3.911816586928973*^9}, {
   3.911825637500778*^9, 3.911825685409631*^9}, {3.911825730922537*^9, 
   3.911825731868479*^9}, {3.911825764615582*^9, 3.911826016574104*^9}, {
   3.911826106845628*^9, 3.911826178492694*^9}, {3.911826219497302*^9, 
   3.911826339786438*^9}, {3.91182637110623*^9, 3.911826418402466*^9}, {
   3.911826480572397*^9, 3.911826514329316*^9}, {3.911826556752758*^9, 
   3.91182662285502*^9}, {3.911826685578178*^9, 3.9118267645325603`*^9}, 
   3.911826830702453*^9, {3.911827022908309*^9, 3.911827037223246*^9}, {
   3.911898665907433*^9, 3.911898707937593*^9}, {3.911898758019927*^9, 
   3.911898770201207*^9}, {3.911902598901725*^9, 3.911902603070112*^9}, 
   3.912573977788831*^9},
 CellLabel->
  "In[4459]:=",ExpressionUUID->"15922a4b-67e7-4e7d-8a6c-88df9c3ebaef"],

