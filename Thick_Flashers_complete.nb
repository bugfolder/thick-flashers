Cell[CellGroupData[{

Cell[TextData[{
 "VertexRotateGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["io",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ix",
  FontSlant->"Italic"],
 ", ",
 StyleBox["iy",
  FontSlant->"Italic"],
 "}]\n\t(checked class) TGraph3D"
}], "Subsubsection",
 CellChangeTimes->{{3.642360427415785*^9, 3.6423604320580177`*^9}, {
  3.642360515836137*^9, 3.642360553358583*^9}, {3.642360623721933*^9, 
  3.642360653841341*^9}, {3.642361522948436*^9, 3.642361523467172*^9}, {
  3.643114901383357*^9, 3.643114908478421*^9}, {3.643207169517273*^9, 
  3.643207170482561*^9}},ExpressionUUID->"a3c19780-c81a-4178-9068-\
1b1c633ae142"],

Cell[TextData[{
 "VertexRotateGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["io",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ix",
  FontSlant->"Italic"],
 ", ",
 StyleBox["iy",
  FontSlant->"Italic"],
 "}] takes a TGraph3D ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", translates it so that vertex ",
 StyleBox["io",
  FontSlant->"Italic"],
 " is at the origin, then rotates its folded form so that vertex ",
 StyleBox["ix",
  FontSlant->"Italic"],
 " lies on the positive x-axis and vertex ",
 StyleBox["iy",
  FontSlant->"Italic"],
 " lies on the positive y-axis."
}], "Text",
 CellChangeTimes->{
  3.642360563416326*^9, {3.642360601622755*^9, 
   3.642360703457687*^9}},ExpressionUUID->"52970a82-641d-4d75-a0a8-\
ff068cf7ef81"],

Cell["\<\
This is useful for, among other things, putting planar mechanisms (like \
Miura-ori) into a standard orientation.\
\>", "Text",
 CellChangeTimes->{{3.642361310321446*^9, 
  3.642361331171303*^9}},ExpressionUUID->"dc9f481b-b31a-4b38-b81e-\
266ae3b9b94b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VertexRotateGraph3D", "::", "badind"}], 
   "=", "\"\<Index specification `1` is invalid because `2` only has `3` \
vertices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.643064356386359*^9, 3.643064403058377*^9}},
 CellLabel->
  "In[1472]:=",ExpressionUUID->"83c3b920-d7a0-4608-a5f3-0b9573e50c6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexRotateGraph3D", "[", 
   RowBox[{"tobj_TObj", ",", " ", 
    RowBox[{"{", 
     RowBox[{"io_", ",", " ", "ix_", ",", " ", "iy_"}], "}"}]}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nv", ",", "verts3d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "VertexRotateGraph3D"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"tobj", "[", "Vertices", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"io", "<", "1"}], "||", 
        RowBox[{"io", ">", "nv"}], "||", 
        RowBox[{"ix", "<", "1"}], "||", 
        RowBox[{"ix", ">", "nv"}], "||", 
        RowBox[{"iy", "<", "1"}], "||", 
        RowBox[{"iy", ">", "nv"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"VertexRotateGraph3D", "::", "badind"}], ",", 
          RowBox[{"{", 
           RowBox[{"io", ",", "ix", ",", "iy"}], "}"}], ",", "tobj", ",", 
          "nv"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices3D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "io", "\[RightDoubleBracket]"}]}],
         "&"}], "/@", "verts3d"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{
           "verts3d", "\[LeftDoubleBracket]", "ix", "\[RightDoubleBracket]"}],
            "\[Cross]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}], "]"}], "\[NotEqual]",
         "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"verts3d", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RotationMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "verts3d", "\[LeftDoubleBracket]", "ix", 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}], ".", 
           "#"}], "&"}], "/@", "verts3d"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{
           "verts3d", "\[LeftDoubleBracket]", "iy", "\[RightDoubleBracket]"}],
            "\[Cross]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "]"}], "]"}], "\[NotEqual]",
         "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"verts3d", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RotationMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "verts3d", "\[LeftDoubleBracket]", "iy", 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}], "]"}], ".", 
           "#"}], "&"}], "/@", "verts3d"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices3D", "\[Rule]", "verts3d"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.642360567214306*^9, 3.642360583062255*^9}, {
   3.642360862370487*^9, 3.642361013662765*^9}, 3.64236106340038*^9, {
