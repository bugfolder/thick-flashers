Cell[TextData[{
 "PolygonTwistTwistAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraphAssigned"
}], "Subsubsection",
 CellChangeTimes->{{3.63002263427103*^9, 3.630022646725075*^9}, 
