        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"115", "\[Degree]"}], ",", 
        RowBox[{"65", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa3", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"70", "\[Degree]"}], ",", 
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"105", "\[Degree]"}], ",", 
