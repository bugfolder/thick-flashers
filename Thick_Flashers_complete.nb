Cell["Example, 3D surface, rainbow color function.", "Text",
 CellChangeTimes->{{3.672145215392436*^9, 3.672145218792354*^9}, {
   3.694010887217538*^9, 3.69401088934606*^9}, {3.785593247327591*^9, 
   3.78559324991249*^9}, 3.7855933027519493`*^9, {3.800014975607056*^9, 
   3.800014984174674*^9}, 3.800017676017181*^9, {3.800017756394482*^9, 
   3.8000177573209896`*^9}},ExpressionUUID->"a8ff8694-f767-446d-8cab-\
b1013150c58a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "u0", ",", "u1", ",", "v0", ",", "v1", ",", "uu", ",", "scf", ",", 
      "sgmp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{".25", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["#1", "2"], "+", 
              SuperscriptBox["#2", "2"]}], ")"}]}], ")"}]}]}], "}"}], "&"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"scf", "=", 
      RowBox[{"RainbowSurfaceColorFunction", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sgmp", "=", 
      RowBox[{"StyledColoredPatch", "[", 
       RowBox[{"uu", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"SurfaceColorFunction", "\[Rule]", "scf"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"sgmp", ",", "\[IndentingNewLine]", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.672145224678674*^9, 3.672145283829448*^9}, {
   3.672145344356303*^9, 3.672145377370901*^9}, {3.688134485732688*^9, 
   3.688134489251348*^9}, {3.688134525427079*^9, 3.688134530464501*^9}, 
   3.688134613008705*^9, 3.689247665111615*^9, {3.689272396271357*^9, 
   3.6892724259494553`*^9}, 3.689555710414833*^9, {3.691523931159422*^9, 
