Cell[CellGroupData[{

Cell[TextData[{
 "EdgesFromFaces[",
 StyleBox["faces",
  FontSlant->"Italic"],
 "]\nBoundaryFromFaces[",
 StyleBox["faces",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.465935791299692*^9, 3.465935795627635*^9}, {
  3.466096027426301*^9, 
  3.46609603408922*^9}},ExpressionUUID->"bce8be7f-44b4-4264-8ab7-\
2742d3a10789"],

Cell[TextData[{
 "EdgesFromFaces[",
 StyleBox["faces",
  FontSlant->"Italic"],
 "] takes a list of faces of a simply connected ",
 "plane graph",
 " and returns a list of all edges in the graph."
}], "Text",
 CellChangeTimes->{{3.466096037609164*^9, 3.466096058111325*^9}, 
   3.484829044497074*^9},ExpressionUUID->"2b48711c-75ca-473a-b0f9-\
8acc5f55c947"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgesFromFaces", "[", "faces_", "]"}], ":=", 
  RowBox[{"Union", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "/@",
        "faces"}], ",", "1"}], "]"}], ",", 
    RowBox[{"SameTest", "\[Rule]", "SameEdgeQ"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.466096060095683*^9, 3.466096116888075*^9}},
 CellLabel->
  "In[1177]:=",ExpressionUUID->"0f82c5c0-97c5-4b9b-936e-0649c9f950c5"],

Cell["Example", "Text",
 CellChangeTimes->{{3.466096120189226*^9, 
  3.466096120811173*^9}},ExpressionUUID->"87348ed2-aafe-4d8b-bc53-\
288445adf6e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "faces", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"EdgesFromFaces", "[", "faces", "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592049143374988*^9, 3.592049166113369*^9}},
 CellLabel->
  "In[1178]:=",ExpressionUUID->"273112c1-cf9c-4111-80de-2c06228bc971"],

Cell[TextData[{
 "BoundaryFromFaces[",
 StyleBox["faces",
  FontSlant->"Italic"],
 "] takes a list of faces of a simply connected ",
 "plane graph",
 " (said faces must all be going the same direction, typically CCW) and \
reconstructs the boundary face, returning it going the same direction."
}], "Text",
 CellChangeTimes->{{3.465935798795258*^9, 3.465935842602228*^9}, {
   3.465935985615408*^9, 3.465936013708585*^9}, 
   3.484829044603539*^9},ExpressionUUID->"ce87219a-b20c-4bdf-8cb6-\
478b453048e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BoundaryFromFaces", "[", "faces_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"halfedges", ",", "bedges", ",", "boundary", ",", "nextitem"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"halfedges", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "/@",
          "faces"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bedges", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tally", "[", 
          RowBox[{"halfedges", ",", 
           RowBox[{
            RowBox[{"#1", "\[Equal]", 
             RowBox[{"Reverse", "[", "#2", "]"}]}], "&"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]",
            "1"}], "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"boundary", "=", 
      RowBox[{
      "bedges", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"bedges", "=", 
      RowBox[{"DropFirst", "[", "bedges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"NotListEmptyQ", "[", "bedges", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nextitem", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"bedges", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]", 
             RowBox[{"boundary", "\[LeftDoubleBracket]", 
              RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "&"}], ",", 
           "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nextitem", "\[Equal]", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Abort", "[", "]"}]}], "]"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"to", " ", "prevent", " ", "infinite", " ", "loop"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"boundary", ",", 
          RowBox[{"nextitem", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bedges", "=", 
         RowBox[{"DeleteItem", "[", 
          RowBox[{"bedges", ",", 
           RowBox[{
           "nextitem", "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}]}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DropLast", "[", "boundary", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.46593602324911*^9, 3.4659361131052103`*^9}, {
