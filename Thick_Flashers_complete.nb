Cell[BoxData[
 RowBox[{
  RowBox[{"CanonicalConeDevelopableSystem", "[", 
   RowBox[{"bbf_Function", ",", "ddf_Function", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "sfn", ",", "u", ",", "v", ",", "ss", ",", "bb", ",",
       "dd", ",", "ndd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CanonicalConeDevelopableSystem", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CanonicalConeDevelopableSystem", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "\[Element]", "Reals"}], ",", 
           RowBox[{"v", "\[Element]", "Reals"}]}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SlotCount", "[", "bb", "]"}], "\[NotEqual]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"CanonicalConeDevelopableSystem", "::", "baddir"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"bbf", "[", "u", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"evaluated", " ", "directrix"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"ddf", "[", "u", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"evaluated", " ", "director"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ndd", "=", 
      RowBox[{
       RowBox[{"Mag", "[", "dd", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"its", " ", "magnitude"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"dd", "/", "ndd"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "unit", " ", "director"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"bb", "+", 
        RowBox[{"v", " ", "dd"}]}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"surface", " ", "function"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Directrix", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"bb", ",", "u"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Director", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"dd", " ", ",", "u"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"DevelopableSurface", " ", "\[Rule]", " ", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"ss", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"CrossCurveSurface", " ", "\[Rule]", " ", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"ss", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]",
       "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.6898485407815847`*^9, 3.689848603650024*^9}, {
   3.689848663064756*^9, 3.689848896066011*^9}, {3.6898490097902527`*^9, 
   3.689849043075843*^9}, {3.68984969408715*^9, 3.689849728051909*^9}, {
