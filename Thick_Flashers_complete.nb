    RowBox[{"p_", ",", "q_", ",", "r_"}], "}"}], "]"}], ":=", 
  RowBox[{"TriangleNormal3D", "[", 
   RowBox[{"p", ",", "q", ",", "r"}], "]"}]}]], "Input",
