Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "tobj", ",", "tobjdp", ",", "devex"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"devex", "=", 
     RowBox[{"ThickFlasherDevelopabilityExcess", "[", "tobjdp", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Developability excess/\[Degree] = \>\"", ",", 
      RowBox[{"devex", "/", "Degree"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"GraphicsRow", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.555852580447597*^9, 3.555852714790588*^9}, {
