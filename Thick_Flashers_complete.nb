   3.594229314539443*^9, 
   3.594229344017834*^9}},ExpressionUUID->"652bef16-f514-4f56-9570-\
01a479cfb82d"],

Cell[TextData[{
 "AddTGraph3DTo[",
 StyleBox["tobj, verts3d",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a TGraph3D using the specified 3D embedding ",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 " and calculates the appropriate FoldAngles."
}], "Text",
 CellChangeTimes->{{3.591971785196355*^9, 3.591971817409107*^9}, {
   3.591971857615106*^9, 3.591971885686222*^9}, 3.592208526031864*^9, {
   3.592377163725953*^9, 3.592377165381288*^9}, 3.592377387959678*^9, {
   3.592378814414811*^9, 3.592378881466339*^9}, {3.592378919505906*^9, 
   3.592378919943574*^9}, 3.592435857429759*^9, {3.592464917458364*^9, 
   3.59246494555871*^9}, 3.592648918523217*^9, {3.592828770286561*^9, 
   3.59282877036289*^9}, {3.594229469714078*^9, 3.59422949309606*^9}, {
   3.594229564452744*^9, 
   3.59422957213883*^9}},ExpressionUUID->"bcd36693-d7b6-499a-bc31-\
f9908405a23a"],

Cell[TextData[{
 "AddTGraph3DTo[",
 StyleBox["tobj, verts3d, foldangles",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a TGraph3D using the specified 3D embedding ",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 " and fold angles ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ". Note that there is no consistency check, so you can supply inconsistent \
values in the constructor."
}], "Text",
 CellChangeTimes->{{3.591971785196355*^9, 3.591971817409107*^9}, {
   3.591971857615106*^9, 3.591971885686222*^9}, 3.592208526031864*^9, {
   3.592377163725953*^9, 3.592377165381288*^9}, 3.592377387959678*^9, {
   3.592378814414811*^9, 3.592378881466339*^9}, {3.592378919505906*^9, 
   3.592378919943574*^9}, 3.592435857429759*^9, {3.592464917458364*^9, 
   3.59246494555871*^9}, 3.592648918523217*^9, {3.592828770286561*^9, 
   3.59282877036289*^9}, {3.594229469714078*^9, 3.594229472152971*^9}, {
   3.594229588770206*^9, 3.594229595481147*^9}, {3.594229728408844*^9, 
   3.594229752375338*^9}, {3.62568891208196*^9, 
   3.6256889143939*^9}},ExpressionUUID->"8a6500e4-86e8-4e18-87a9-\
b0218673775b"],

Cell[TextData[{
 "If you want consistency between ",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 " and ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " but only have values for one of them,\n\tIf you have only ",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 ", use RecalcFoldAngles, below.\n\tIf you have only ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", use FoldGraph3D, below."
}], "Text",
 CellChangeTimes->{{3.625688890532786*^9, 3.625689006068283*^9}, {
  3.625690145911566*^9, 
  3.625690193979512*^9}},ExpressionUUID->"d55c78b9-9e38-4da1-9beb-\
b0a3b2267256"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTGraph3DTo", "[", 
   RowBox[{"tobj_TObj", ",", 
    RowBox[{"verts3d_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", 
    RowBox[{"foldangles_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"v3d", ",", "fa", ",", "tobj1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "AddTGraph3DTo"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v3d", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"verts3d", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
         RowBox[{"GetValue", "[", 
          RowBox[{"tobj", ",", "Vertices"}], "]"}]}], ",", "verts3d"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"foldangles", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"Length", "[", 
            RowBox[{"GetValue", "[", 
             RowBox[{"tobj", ",", "Edges"}], "]"}], "]"}], "}"}]}], "]"}], ",",
         "foldangles"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AddClassTo", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices3D", "\[Rule]", "v3d"}], ",", 
         RowBox[{"FoldAngles", "\[Rule]", "fa"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.591971698217072*^9, 3.59197178201532*^9}, {
   3.591971827250785*^9, 3.591971829228731*^9}, {3.591972053974255*^9, 
   3.591972057365447*^9}, 3.5922076116916647`*^9, 3.592208526051597*^9, {
   3.592377323504434*^9, 3.59237735492407*^9}, 3.592377387990113*^9, {
