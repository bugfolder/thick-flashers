           "PlotLabel", "\[Rule]", "\"\<TwistFoldedFormGraphics\>\""}]}], 
          "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
