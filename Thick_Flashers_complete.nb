Cell[TextData[{
 "RadialAxialOrderingFn[",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) RadialAxialTolerance, RadialMajor, AxialDirection, \
RadialDirection\nOrientEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph"
}], "Subsubsection",
