Cell[TextData[{
 "Interestingly, this condition works for a ",
 StyleBox["folded",
  FontSlant->"Italic"],
 " vertex, as long as we give the vertices in their ",
 StyleBox["unfolded",
  FontSlant->"Italic"],
 " order."
}], "Text",
 CellChangeTimes->{{3.617550808500246*^9, 
  3.617550833975828*^9}},ExpressionUUID->"d89bec86-3010-4a7e-b73c-\
5a1cc768399d"],

