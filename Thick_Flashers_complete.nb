Cell[BoxData[
 RowBox[{
  RowBox[{"GenericGraphGraphics", "[", 
   RowBox[{"verts_List", ",", "edges_List", ",", 
    RowBox[{"faces_", ":", 
     RowBox[{"{", "}"}]}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vl", ",", "el", ",", "fl", ",", "de", ",", "vc", ",", "ec", ",", "fc", ",",
       "fcng", ",", "hf", ",", "gg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vl", "=", 
      RowBox[{
       RowBox[{"VertexLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"el", "=", 
      RowBox[{
       RowBox[{"EdgeLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fl", "=", 
      RowBox[{
       RowBox[{"FaceLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"de", "=", 
      RowBox[{
       RowBox[{"DirectedEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vc", "=", 
      RowBox[{
       RowBox[{"VertexColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ec", "=", 
      RowBox[{
       RowBox[{"EdgeColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{
       RowBox[{"FaceColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fcng", "=", 
      RowBox[{
       RowBox[{"FaceColoring", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GenericGraphGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hf", " ", "=", " ", 
      RowBox[{"!", 
       RowBox[{"(", 
        RowBox[{"faces", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListQ", "[", "vc", "]"}]}], ",", 
       RowBox[{"vc", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"vc", ",", 
          RowBox[{"{", 
           RowBox[{"Length", "[", "verts", "]"}], "}"}]}], "]"}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListQ", "[", "ec", "]"}]}], ",", 
       RowBox[{"ec", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"ec", ",", 
          RowBox[{"{", 
           RowBox[{"Length", "[", "edges", "]"}], "}"}]}], "]"}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListQ", "[", "fc", "]"}]}], ",", 
       RowBox[{"fc", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"fc", ",", 
          RowBox[{"{", 
           RowBox[{"Length", "[", "faces", "]"}], "}"}]}], "]"}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"gg", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"hf", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{"fcng", "===", "None"}], ")"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"gg", ",", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"Polygon", "[", 
                  RowBox[{
                  "verts", "\[LeftDoubleBracket]", "#1", 
                   "\[RightDoubleBracket]"}], "]"}], ",", 
                 RowBox[{"Lighter", "[", 
                  RowBox[{"fc", ",", 
                   RowBox[{".9", "-", 
                    RowBox[{".05", "#2"}]}]}], "]"}]}], "]"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"faces", ",", "fcng"}], "}"}]}], "]"}]}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"gg", ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{"Style", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"PolyLines", "[", 
               RowBox[{"verts", ",", "faces"}], "]"}], ",", "fc"}], "}"}]}], 
           "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"gg", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"de", ",", "DirectedEdgeLines", ",", "EdgeLines"}], 
             "]"}], "[", 
            RowBox[{"verts", ",", "edges"}], "]"}], ",", "ec"}], "}"}]}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"hf", "&&", 
        RowBox[{"!", 
         RowBox[{"(", 
          RowBox[{"fl", "===", "None"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Style", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"fl", "===", "Automatic"}], ",", 
               RowBox[{"StdFaceLabels", "[", 
                RowBox[{"verts", ",", "faces"}], "]"}], ",", "fl"}], "]"}], ",", 
             RowBox[{"Darker", "/@", "fc"}]}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{"el", "===", "None"}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Style", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"el", "===", "Automatic"}], ",", 
               RowBox[{"StdEdgeLabels", "[", 
                RowBox[{"verts", ",", "edges"}], "]"}], ",", "el"}], "]"}], ",", 
             RowBox[{"Darker", "/@", "ec"}]}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{"vl", "===", "None"}], ")"}]}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Style", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"vl", "===", "Automatic"}], ",", 
               RowBox[{"StdVertexLabels", "[", "verts", "]"}], ",", "vl"}], 
              "]"}], ",", 
             RowBox[{"Darker", "/@", "vc"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "4", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"Length", "[", "verts", "]"}], "}"}]}], "]"}]}], 
            "}"}]}], "]"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"gg", ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.455897388549263*^9, 3.455897388993318*^9}, {
