Cell["\<\
5/25/2018. Found and fixed an error in our expression for \
HatRotationMatrix3DNumerator: rotation angle was negated. This affected all \
3D Hat functions.\
\>", "Text",
 CellChangeTimes->{{3.736637187563525*^9, 3.736637216076543*^9}, {
  3.73663809163868*^9, 
  3.736638135308614*^9}},ExpressionUUID->"c240f540-1c72-4dcc-b4fb-\
52dc69e7b38d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "HatRotationMatrix3DNumerator[",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]\nHatRotationDenominator[",
 StyleBox["h",
  FontSlant->"Italic"],
 "]\nHatRotationMatrix3D[",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595527231586637*^9, 3.595527245768503*^9}, {
  3.595528269454214*^9, 3.5955282835894947`*^9}, {3.595529137913808*^9, 
  3.595529190325327*^9}, {3.595529316893307*^9, 3.59552933668294*^9}, {
  3.595529973753851*^9, 3.595529974417202*^9}, {3.5956107986942987`*^9, 
  3.595610800163499*^9}, {3.5956114736229057`*^9, 
  3.595611477286543*^9}},ExpressionUUID->"caa6d8c3-4371-4763-aa61-\
e10a281bffdf"],

Cell[TextData[{
 "HatRotationMatrix3DNumerator[",
 StyleBox["h, w",
  FontSlant->"Italic"],
 "] returns the numerator of the rotation matrix through an angle whose hat \
transform is ",
 StyleBox["h",
  FontSlant->"Italic"],
 " about an axis ",
 StyleBox["w",
  FontSlant->"Italic"],
 " in 3-space."
}], "Text",
 CellChangeTimes->{{3.59552817369357*^9, 3.5955282115939693`*^9}, {
  3.595528244856963*^9, 3.595528256143252*^9}, {3.5955283083948717`*^9, 
  3.5955283134118*^9}, {3.595528416752006*^9, 3.595528448003197*^9}, {
  3.595611508132729*^9, 3.595611555151956*^9}, {3.595705271907032*^9, 
  3.595705272721342*^9}},ExpressionUUID->"40d790f3-0c8a-46f4-94c9-\
96eaecfac468"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatRotationMatrix3DNumerator", "[", 
   RowBox[{"h_", ",", "w_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"wx", ",", "wy", ",", "wz", ",", "s", ",", "c", ",", "d"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"wx", ",", "wy", ",", "wz"}], "}"}], "=", "w"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"2", "h"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["h", "2"]}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["h", "2"]}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"d", "-", "c"}], ")"}], " ", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "w", ",", "w"}], "]"}]}], "+", 
      RowBox[{"s", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "wz"}], ",", "wy"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"wz", ",", "0", ",", 
           RowBox[{"-", "wx"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "wy"}], ",", "wx", ",", "0"}], "}"}]}], "}"}]}]}]}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.595527754361866*^9, 3.595527821575969*^9}, {
   3.595527861855826*^9, 3.5955280118846817`*^9}, {3.595528473923346*^9, 
   3.595528500188231*^9}, 3.595529199246683*^9, {3.736637887078082*^9, 
   3.736637902045395*^9}, {3.736637975745565*^9, 3.736637987719737*^9}},
 CellLabel->
  "In[787]:=",ExpressionUUID->"a9a4cbc5-0502-4ce8-95d6-d2d4864a931b"],

Cell["Examples. Rotation about x, y, and z axes.", "Text",
