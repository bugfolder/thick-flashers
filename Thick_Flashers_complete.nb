}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["TGraph augmentation", "Subsection",
 CellChangeTimes->{{3.594649889199905*^9, 3.594649892543846*^9}, {
   3.594650273247031*^9, 3.594650274711562*^9}, 3.5946581437874737`*^9, {
   3.5946647171832*^9, 3.594664718508267*^9}, {3.594725618154599*^9, 
   3.5947256253289557`*^9}, 3.594940757463454*^9, 
   3.643582376439643*^9},ExpressionUUID->"c781a691-a5c8-4d6e-a770-\
e93b187ebcc3"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.5946498946403*^9, 
  3.594649895096038*^9}},ExpressionUUID->"82bc705e-1d01-4d2f-9c44-\
cd2a8967850a"],

Cell["\<\
These functions are used to build up or expand a TGraph incrementally by \
adding vertices and/or edges, the latter either indexed into existing \
vertices, or as an embedded edge (point pairs), in which case new vertices \
are added if necessary. This allows you to build up a crease pattern graph \
from its numerical vertex data without having to develop an indexing scheme.\
\>", "Text",
 CellChangeTimes->{{3.594649896994849*^9, 3.594649958835209*^9}, {
  3.594650193556271*^9, 3.594650267487523*^9}, {3.594654665083572*^9, 
  3.594654667987737*^9}, {3.594657291075747*^9, 
  3.594657313297455*^9}},ExpressionUUID->"46b773ad-1bd9-4741-8cca-\
cb877a91ec0c"],

Cell[TextData[{
 "Note that all of these functions have \[OpenCurlyDoubleQuote]Distinct\
\[CloseCurlyDoubleQuote] in their name. If the TGraph already contains the \
passed vertex or edge, they return indices to the existing vertex or edge and \
make no changes to the graph. (Also, this avoids namespace collisions with \
the existing ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " functions AddVertex and AddEdge.)"
}], "Text",
 CellChangeTimes->{{3.594655723368082*^9, 3.594655815481628*^9}, {
  3.594657445048864*^9, 
  3.59465744656883*^9}},ExpressionUUID->"c042ac1e-de3b-4007-88bb-\
35c7a704ebc7"],

Cell["See MakeRadialPotWedge for an example of usage.", "Text",
 CellChangeTimes->{{3.594650279134657*^9, 3.594650282862842*^9}, {
  3.594654682115414*^9, 3.594654683650584*^9}, {3.5946581236703663`*^9, 
  3.594658129244749*^9}},ExpressionUUID->"bbd3a85e-1d41-45c2-acb4-\
6fb0ab6bd589"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FindVertex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph\n\t(options) SamePtTolerance\n\
AddDistinctVertexData[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph\n\t(options) SamePtTolerance\n\
AddDistinctVertex[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph\n\t(options) SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.594658520412851*^9, 3.594658547857781*^9}, {
  3.594658789222156*^9, 3.594658789689853*^9}, {3.594658821906335*^9, 
  3.5946588225759983`*^9}, {3.594658968239822*^9, 3.594658969591876*^9}, {
  3.594732490650532*^9, 3.594732490856456*^9}, {3.59528663390416*^9, 
  3.595286639471068*^9}, {3.5952866713335533`*^9, 
  3.595286672517084*^9}},ExpressionUUID->"485a52c9-f0fb-4324-b447-\
364b105415ab"],

Cell[TextData[{
 "FindVertex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the index of vertex ",
 StyleBox["v",
  FontSlant->"Italic"],
 " in TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " or Null if it doesn\[CloseCurlyQuote]t exist."
}], "Text",
 CellChangeTimes->{{3.59465848234194*^9, 3.594658505084624*^9}, {
   3.594658693297775*^9, 3.594658693792609*^9}, 3.594658794283935*^9, {
   3.59465883268748*^9, 
   3.594658833447999*^9}},ExpressionUUID->"54ad6099-4992-4d3b-bcf2-\
86bfd7e76dde"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindVertex", "[", 
   RowBox[{"tobj_TObj", ",", " ", "v_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"SamePtQ", "[", 
           RowBox[{
            RowBox[{
            "verts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
             "v", ",", "opts"}], "]"}], ",", 
          RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594658424110594*^9, 3.594658476416802*^9}, {
  3.594658633189801*^9, 3.59465871725809*^9}, {3.594658795473705*^9, 
  3.5946588248915777`*^9}, {3.594658878147623*^9, 3.594658879735692*^9}, {
  3.59465918726121*^9, 3.59465918752448*^9}},
 CellLabel->
  "In[1205]:=",ExpressionUUID->"feb329b0-4c3f-4134-9d47-7606d73f4325"],

Cell["Example: vertex exists.", "Text",
 CellChangeTimes->{{3.594654922029072*^9, 3.594654922738881*^9}, {
  3.594656098432868*^9, 3.5946561001753483`*^9}, {3.594658851302396*^9, 
  3.5946588538459873`*^9}},ExpressionUUID->"47241568-5979-4341-bc33-\
16b926ddbf6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "tobj", ",", "v", ",", "vi", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"FindVertex", "[", 
      RowBox[{"tobj", ",", " ", "v"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594654924084831*^9, 3.594654989386535*^9}, {
  3.594655158115902*^9, 3.594655191042697*^9}, {3.594655221232504*^9, 
  3.594655255567222*^9}, {3.59465582657559*^9, 3.594655837743516*^9}, {
  3.594656120618348*^9, 3.594656120826174*^9}, {3.594657530857066*^9, 
  3.594657545864114*^9}, {3.594658757273597*^9, 3.5946588673325157`*^9}},
 CellLabel->
  "In[1206]:=",ExpressionUUID->"6d2f710f-b515-4c1d-a477-8c6d0807bd02"],

Cell["Example: vertex does not exist.", "Text",
 CellChangeTimes->{{3.594654922029072*^9, 3.594654922738881*^9}, {
  3.594656098432868*^9, 3.5946561001753483`*^9}, {3.594658851302396*^9, 
  3.594658861157395*^9}},ExpressionUUID->"dd219be4-a11a-448b-8811-\
e8fad4ae7c2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "tobj", ",", "v", ",", "vi", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"FindVertex", "[", 
      RowBox[{"tobj", ",", " ", "v"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594654924084831*^9, 3.594654989386535*^9}, {
  3.594655158115902*^9, 3.594655191042697*^9}, {3.594655221232504*^9, 
  3.594655255567222*^9}, {3.59465582657559*^9, 3.594655837743516*^9}, {
  3.594656120618348*^9, 3.594656120826174*^9}, {3.594657530857066*^9, 
  3.594657545864114*^9}, {3.594658757273597*^9, 3.594658844058079*^9}},
 CellLabel->
  "In[1207]:=",ExpressionUUID->"f1fc44f7-57b8-4c1e-b96f-7e29e8372ac0"],

Cell[TextData[{
 "AddDistinctVertexData",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " and a 2D vertex ",
 StyleBox["v",
  FontSlant->"Italic"],
 " and adds the vertex to the TGraph if necessary, returning a list {",
 StyleBox["tobj1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vi",
  FontSlant->"Italic"],
 "} where ",
 StyleBox["tobj1",
  FontSlant->"Italic"],
 " is the modified TGraph and ",
 StyleBox["vi",
  FontSlant->"Italic"],
 " is the index of the added vertex. If the vertex already exists (to within \
SamePtTolerance), then the index of the existing vertex is returned and the \
returned value is identical to ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". Options are:\n\tOptions[SamePtQ]"
}], "Text",
 CellChangeTimes->{{3.594653810435079*^9, 3.59465381392277*^9}, {
   3.59465384505497*^9, 3.59465394790683*^9}, 3.594654048476849*^9, {
   3.594654429643064*^9, 3.594654455129256*^9}, {3.594654806191699*^9, 
   3.594654840112608*^9}, {3.594655483934933*^9, 3.594655490550412*^9}, 
   3.594655630343038*^9, 3.59465747871379*^9, {3.64358227621955*^9, 
   3.6435822771581173`*^9}},ExpressionUUID->"8e345ce5-bb63-4710-a094-\
0380f90d3e21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddDistinctVertexData", "[", 
   RowBox[{"tobj_TObj", ",", " ", "v_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "vi"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vi", "=", 
      RowBox[{"FindVertex", "[", 
       RowBox[{"tobj", ",", "v", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"vi", "===", "Null"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tobj", "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"Vertices", "\[Rule]", 
            RowBox[{"Append", "[", 
             RowBox[{"verts", ",", "v"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"1", "+", 
          RowBox[{"Length", "[", "verts", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"tobj", ",", "vi"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.59465446543862*^9, 3.594654647024859*^9}, 
