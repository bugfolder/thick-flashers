   3.7997763499644136`*^9}},ExpressionUUID->"70c1ba99-7f0a-43fd-9dd7-\
6fa3aace2ad6"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of the curve.\n\t",
 StyleBox["\[Theta]",
  FontSlant->"Italic"],
 " \[LongDash] the helicity angle.\n\t",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 " \[LongDash] the fold angle function.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.799748099776724*^9, 3.799748125937078*^9}, {
   3.79974880353203*^9, 3.799748816372216*^9}, 3.7997756764303617`*^9, {
