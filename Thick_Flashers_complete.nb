Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeFoldVectorsFromSectorsAndMinorDihedral", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", " ", 
       SubscriptBox["\[Alpha]", "2"], ",", 
       SubscriptBox["\[Alpha]", "3"], ",", " ", 
       SubscriptBox["\[Alpha]", "4"]}], "}"}], ",", 
     SubscriptBox["\[Gamma]", "1"], ",", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "2e8598a5-2673-41fc-9f70-1acdfa6235ea"],
 " constructs a valid TDegree4Vertex3D from the sector angles and the \
specified minor dihedral angle, which is taken to run along the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " axis initially, although we then rotate to align the osculating vector if \
one is specified. Useful for constructing visual examples. Options are:\n\t\
Options[MakeDihedralsFromSectorsAndMinorDihedral] (",
 "AllowSelfIntersection",
 ") are passed through.\n\tOptions[MakeFoldVectorsFromSectorsAndDihedrals] \
(OsculatingVectorNear) are passed through."
}], "Text",
 CellChangeTimes->{{3.44044481625184*^9, 3.440444858689953*^9}, 
