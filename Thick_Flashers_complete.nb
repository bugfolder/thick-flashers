Cell[BoxData[
 RowBox[{
  RowBox[{"NCurvedFoldHelix2D", "[", 
   RowBox[{"r_", ",", "\[Theta]_", ",", 
    RowBox[{"\[Gamma]_Function", "|", "\[Gamma]_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]1", ",", "f", ",", "rL", ",",
       "rR"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]1"}], "}"}], "=", 
