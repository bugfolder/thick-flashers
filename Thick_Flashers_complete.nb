   3.708345192312046*^9, {3.70834526854034*^9, 3.70834531595553*^9}, {
   3.708345392135308*^9, 3.708345416132126*^9}, {3.708413973285635*^9, 
   3.708414028922042*^9}, {3.708414155349126*^9, 3.7084141879701853`*^9}, {
   3.70859175885254*^9, 3.708591819186685*^9}, {3.70896337303452*^9, 
   3.708963373041302*^9}, {3.708963822011008*^9, 3.708963831227477*^9}, {
