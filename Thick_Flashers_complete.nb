Cell[TextData[{
 "ShrinkPoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]\nInsetPoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 "]\nInsetPoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hlist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.462431697301199*^9, 3.4624317153937893`*^9}, {
  3.462431980817953*^9, 3.4624320302850013`*^9}, {3.7218150022849507`*^9, 
  3.7218150043542223`*^9}},ExpressionUUID->"2646262f-c6e4-4821-ad38-\
e2ae841c46cd"],

Cell[TextData[{
 "ShrinkPoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] takes a polygon as a list of vertices and shrinks it about its centroid \
by a fixed ratio ",
 StyleBox["r",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.462431718337429*^9, 3.462431741232152*^9}, {
  3.462431846161252*^9, 3.462431863375897*^9}, {3.462432014590246*^9, 
  3.462432038156865*^9}, {3.72181501836974*^9, 
  3.721815019086843*^9}},ExpressionUUID->"83150b6b-434e-44c9-a054-\
5221f7ad7af2"],

Cell[TextData[{
 "Returns a list ",
 StyleBox["newverts",
  FontSlant->"Italic"],
 " of the shrunken vertices."
}], "Text",
 CellChangeTimes->{{3.721815021499105*^9, 
  3.721815025004137*^9}},ExpressionUUID->"1c8b8245-7e42-45eb-8aa5-\
d90c1b5aff83"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ShrinkPoly", "[", 
   RowBox[{"verts_List", ",", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ct", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ct", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Plus", "@@", "verts"}], ")"}], "/", 
       RowBox[{"Length", "[", "verts", "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"r", "#"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "r"}], ")"}], "ct"}]}], "&"}], "/@", 
      "verts"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.462431742587615*^9, 3.462431841133627*^9}, {
   3.462431873844767*^9, 3.462431875852581*^9}, {3.462432047737185*^9, 
   3.462432061001445*^9}, 3.462432140983968*^9, 3.627328586617622*^9, 
   3.722173429088976*^9},
 CellLabel->
  "In[926]:=",ExpressionUUID->"893e5d57-f1c1-4fa4-a953-53d1671d0468"],

