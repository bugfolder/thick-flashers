Cell[CellGroupData[{

Cell[TextData[{
 "RotationMatrix3D[\[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.5955270361785803`*^9, 
  3.595527050549437*^9}},ExpressionUUID->"7d29d047-09be-4fc3-9437-\
e5e98f2f2864"],

Cell[TextData[{
 "RotationMatrix3D[\[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "] gives the 3D rotation matrix for a counterclockwise rotation about the 3D \
vector ",
 StyleBox["w",
  FontSlant->"Italic"],
 ". We use the built-in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function RotationMatrix, which does not require that w be normalized, but \
is algebraically quite complex, involving Abs and Conjugate functions."
}], "Text",
 CellChangeTimes->{{3.59552705675715*^9, 3.595527135503434*^9}, {
  3.688124704973551*^9, 3.688124728603874*^9}, {3.6881247860807457`*^9, 
  3.688124795919877*^9}, {3.691276407743347*^9, 
  3.691276413399012*^9}},ExpressionUUID->"317b165e-39b1-4f78-a30f-\
c09ce911e385"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationMatrix3D", "[", 
   RowBox[{"\[Phi]_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"RotationMatrix", "[", 
   RowBox[{"\[Phi]", ",", "w"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595527099745146*^9, 3.595527123227006*^9}},
 CellLabel->
  "In[694]:=",ExpressionUUID->"88c77ca6-3e1c-4ec3-be3c-8b85768b343f"],

