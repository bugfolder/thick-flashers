Cell[TextData[{
 "CreasePatternGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph+TAssigned and returns a Graphics object that show the full \
crease pattern, both lines and polys. Options are:\n\tOptions[Graphics] are \
passed through to Graphics."
}], "Text",
