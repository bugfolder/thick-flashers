Cell[BoxData[
 RowBox[{
  RowBox[{"NRecoverCurve3DSystemOld", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kp_Function", "|", "kp_InterpolatingFunction"}], ",", 
      RowBox[{"ta_Function", "|", "ta_InterpolatingFunction"}]}], "}"}], ",", 
    
    RowBox[{"v_Function", "|", "v_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ip", ",", "it", ",", "in", ",", "ib", ",", "ndopts", ",", "t", ",", 
      "soln", ",", "tx", ",", "ty", ",", "tz", ",", "nx", ",", "ny", ",", 
      "nz", ",", "bx", ",", "by", ",", "bz", ",", "cx", ",", "cy", ",", 
      "cz"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ip", "=", 
      RowBox[{
       RowBox[{"InitialPosition3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NRecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"it", "=", 
      RowBox[{
       RowBox[{"InitialTangentVector3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NRecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"in", "=", 
      RowBox[{
       RowBox[{"InitialNormalVector3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NRecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"it", "=", 
      RowBox[{"NormalizeReal", "[", "it", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"in", "=", 
      RowBox[{"NormalizeReal", "[", "in", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ib", "=", 
      RowBox[{"it", "\[Cross]", "in"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ndopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Integrate", " ", "the", " ", "matrix", " ", "system"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"tx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"ty", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"tz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"v", "[", "t", "]"}], 
             RowBox[{"kp", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"nx", "[", "t", "]"}], ",", 
               RowBox[{"ny", "[", "t", "]"}], ",", 
               RowBox[{"nz", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"nx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"ny", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"nz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"v", "[", "t", "]"}]}], 
              RowBox[{"kp", "[", "t", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tx", "[", "t", "]"}], ",", 
                RowBox[{"ty", "[", "t", "]"}], ",", 
                RowBox[{"tz", "[", "t", "]"}]}], "}"}]}], "+", 
             RowBox[{
              RowBox[{"v", "[", "t", "]"}], " ", 
              RowBox[{"ta", "[", "t", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"bx", "[", "t", "]"}], ",", 
                RowBox[{"by", "[", "t", "]"}], ",", 
                RowBox[{"bz", "[", "t", "]"}]}], "}"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"bx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"by", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"bz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"v", "[", "t", "]"}]}], " ", 
             RowBox[{"ta", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"nx", "[", "t", "]"}], ",", 
               RowBox[{"ny", "[", "t", "]"}], ",", 
               RowBox[{"nz", "[", "t", "]"}]}], "}"}]}]}], ",", 
