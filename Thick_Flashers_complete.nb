Cell[CellGroupData[{

Cell["TPlaneGraph modifications", "Subsection",
 CellChangeTimes->{{3.643582486544139*^9, 3.643582491192492*^9}, {
  3.643720385120058*^9, 3.64372040669405*^9}, {3.643720485402875*^9, 
  3.6437204862409286`*^9}, {3.643720525487018*^9, 3.643720526061901*^9}, {
  3.643737193192721*^9, 3.643737198776922*^9}, {3.825767446628416*^9, 
  3.825767448172572*^9}, {3.825866543657662*^9, 
  3.825866556650116*^9}},ExpressionUUID->"b8e8fcb1-2cfb-4944-bebc-\
7e9967d30d4f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.825867445822994*^9, 
  3.825867446271431*^9}},ExpressionUUID->"12162efe-2dd5-4758-bf02-\
132004098bba"],

Cell["\<\
The functions here are similar to the modfication functions above that \
operation on TGraphs, but these modifications require the additional \
information that is present in a TPlaneGraph.\
\>", "Text",
 CellChangeTimes->{{3.825867458823412*^9, 
  3.825867530016371*^9}},ExpressionUUID->"73380555-769c-466d-b228-\
bbba004ddd65"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "SplitEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sedges",
  FontSlant->"Italic"],
 "]\n\t(checked class) TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{
  3.643720697813147*^9, {3.643721031334776*^9, 3.643721036933977*^9}, {
   3.704409265659217*^9, 3.7044092660589952`*^9}, {3.825767008449055*^9, 
   3.825767009265108*^9}, 3.825767069721807*^9, 
   3.8258674326556263`*^9},ExpressionUUID->"bc9f9d39-3e94-4bc8-9d52-\
084eb690c477"],

Cell[TextData[{
 "SplitEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sedges",
  FontSlant->"Italic"],
 "] cuts a TPlaneGraph along a set of edges to be split."
}], "Text",
 CellChangeTimes->{{3.643582688171281*^9, 3.6435827120744963`*^9}, {
   3.643719130713034*^9, 3.643719184988191*^9}, {3.643719253511198*^9, 
   3.643719414709853*^9}, {3.643720196469913*^9, 3.64372028812563*^9}, {
   3.643720579114888*^9, 3.643720587530353*^9}, {3.643720624200754*^9, 
   3.643720688035933*^9}, {3.643720878162363*^9, 3.643720891374988*^9}, {
   3.64372092151099*^9, 3.643720946043837*^9}, {3.704409269396731*^9, 
   3.7044092964365396`*^9}, {3.825766914400133*^9, 3.825766927480392*^9}, {
   3.8257670157230673`*^9, 3.825767021057206*^9}, 3.825767069744727*^9, 
   3.8258674326769*^9},ExpressionUUID->"9734b370-fea1-4a41-9d1e-b76b6870f0bf"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TPlaneGraph to be slit.\n\t",
 StyleBox["sedges",
  FontSlant->"Italic"],
 " \[LongDash] a list of edge indices."
}], "Text",
 CellChangeTimes->{{3.704409298123194*^9, 3.704409329268875*^9}, 
   3.825767016915053*^9},ExpressionUUID->"e4703aa3-9f81-4c96-9c81-\
1f5cde1fb8d8"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["nverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nedges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nfaces",
  FontSlant->"Italic"],
 "} where\n\t",
 StyleBox["nverts",
  FontSlant->"Italic"],
 " is a list of the new vertices, given as indices into the old vertices \
(tobj[Vertices]);\n\t",
 StyleBox["nedges",
  FontSlant->"Italic"],
 " is a list of the new edges, given as pairs of indices of the new vertices.\
\n\t",
 StyleBox["nfaces",
  FontSlant->"Italic"],
 " is a list of the new faces, given as lists of the new vertices."
}], "Text",
 CellChangeTimes->{{3.82576678319916*^9, 3.825766853135778*^9}, {
  3.825769483419609*^9, 
  3.825769505444319*^9}},ExpressionUUID->"a61aeac8-f5f1-4589-9cde-\
05bc69900833"],

Cell[TextData[{
 "The reason this doesn\[CloseCurlyQuote]t return a fully-rebuilt TPlaneGraph \
is that it might be necessary to map two sets of values to the new vertices \
(e.g., Vertices and Vertices3D); ",
 StyleBox["nverts",
  FontSlant->"Italic"],
 " provides the necessary information to do so. Also, because some vertices \
are superimposed, the planarization algorithm in AddTPlaneGraph will fail if \
applied directly; you\[CloseCurlyQuote]ll need to perturb the vertices \
slightly for purposes of planarization, e.g., using FaceShrink (see next)."
}], "Text",
 CellChangeTimes->{{3.825766873231339*^9, 3.825766903448146*^9}, {
  3.825766935544235*^9, 3.825766977160667*^9}, {3.825767172041935*^9, 
  3.825767263771024*^9}, {3.825769521443734*^9, 
  3.825769533020547*^9}},ExpressionUUID->"02795c85-29fb-444a-b782-\
ea5ccf43c56f"],

Cell["\<\
Note that if you will be rebuilding a TPlaneGraph, the topology of the split \
edges must leave the graph connected with no holes. If this is not the case, \
then reconstructing the faces via AddTPlaneGraph will fail (even with \
perturbed vertex position).\
\>", "Text",
 CellChangeTimes->{{3.704409358971651*^9, 3.704409426860038*^9}, {
  3.825766991425129*^9, 3.825766993136843*^9}, {3.825767269770817*^9, 
  3.825767275995012*^9}, {3.825769542028386*^9, 
  3.825769553884263*^9}},ExpressionUUID->"f3030fe3-f99c-49a3-b49e-\
e2ee49bd0b9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitEdges", "[", 
   RowBox[{"tobj_TObj", ",", "sedges_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "bv", ",", "be", ",", "vei", ",",
       "vfi", ",", "vva", ",", "fei", ",", "\[IndentingNewLine]", "vev", ",", 
      "sverts", ",", "nfaces", ",", "nverts", ",", "nedges"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPlaneGraph", ",", "SplitEdges"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "faces", ",", "bv", ",", "be", ",", "vei", 
        ",", "vfi", ",", "vva", ",", "fei"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "Faces", ",", "BoundaryVertices", ",",
           "BoundaryEdges", ",", "VertexEdgeIncidence", ",", 
          "VertexFaceIncidence", ",", "VertexVertexAdjacency", ",", 
          "FaceEdgeIncidence"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"vev", " ", "is", " ", "a", " ", "list", " ", "of", " ", 
        RowBox[{"{", 
         RowBox[{"e", ",", "v"}], "}"}], " ", "pairs", " ", "ordered", " ", 
        "around", " ", "each", " ", "vertex", " ", "where", " ", "e", " ", 
        "is", " ", "the", " ", "incident", " ", "edge"}], ",", " ", 
       RowBox[{
       "v", " ", "is", " ", "the", " ", "opposite", " ", "vertex", " ", 
        "across", " ", 
        RowBox[{"v", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vev", " ", "=", " ", 
      RowBox[{"Transpose", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"vei", ",", "vva"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "sverts", " ", "is", " ", "the", " ", "list", " ", "of", " ", 
       "vertices", " ", "to", " ", "split"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"nse", ",", "vbv", ",", "sv"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"nse", "=", 
           RowBox[{"Length", "[", 
            RowBox[{"Intersection", "[", 
             RowBox[{"sedges", ",", 
              RowBox[{"First", "/@", 
               RowBox[{
               "vev", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}]}], "]"}], "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{"num", " ", "incident", " ", "split", " ", "edges"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"vbv", "=", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"bv", ",", "i"}], "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{
           "True", " ", "if", " ", "vertex", " ", "is", " ", "on", " ", 
            "boundary"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"sv", "=", 
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"nse", "\[Equal]", "0"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"nse", "\[Equal]", "1"}], "&&", 
                RowBox[{"!", "vbv"}]}], ")"}]}], ")"}]}]}], ";", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "whether", " ", "to", " ", "split", " ", "the", " ", "vertex"}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"sv", ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"sverts", ",", "i"}], "]"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "nfaces", " ", "is", " ", "the", " ", "list", " ", "of", " ", "faces", " ",
        "after", " ", "the", " ", "split", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"i", ".", "e", "."}], ",", " ", 
          RowBox[{"with", " ", "new", " ", "vertex", " ", "indices"}]}], 
         ")"}], "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nfaces", "=", "faces"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "nverts", " ", "are", " ", "the", " ", "indices", " ", "of", " ", 
        "new", " ", "vertices"}], ",", " ", 
       RowBox[{"indexed", " ", "into", " ", "verts"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "verts", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Go", " ", "through", " ", "all", " ", "split", " ", "vertices", " ", 
       "and", " ", "substitute", " ", "new", " ", "vertex", " ", "indices", " ",
        "into", " ", "nfaces", " ", "as", " ", 
       RowBox[{"appropriate", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "vv", ",", "vvei", ",", "vvfi", ",", "rpos", ",", "nv", ",", 
           "prevnum", ",", "added"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"vv", "=", 
           RowBox[{
           "sverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"vvei", "=", 
           RowBox[{
           "vei", "\[LeftDoubleBracket]", "vv", "\[RightDoubleBracket]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"vvfi", "=", 
           RowBox[{
           "vfi", "\[LeftDoubleBracket]", "vv", "\[RightDoubleBracket]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Always", " ", "start", " ", "going", " ", "around", " ", "a", " ",
             "vertex", " ", "from", " ", "a", " ", "face", " ", "that", " ", 
            "is", " ", "CCW", " ", "from", " ", "either", " ", "a", " ", 
            "boundary", " ", "edge", " ", "or", " ", "a", " ", "split", " ", 
            RowBox[{"edge", ".", " ", "rpos"}], " ", "is", " ", "the", " ", 
            "position", " ", "of", " ", "the", " ", "first", " ", "edge", " ",
             "in", " ", "vvei", " ", "that", " ", "is", " ", "one", " ", "of",
             " ", 
            RowBox[{"those", ".", " ", "Boundary"}], " ", "gets", " ", 
            RowBox[{"priority", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"rpos", "=", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"MemberQ", "[", 
                RowBox[{"be", ",", "#"}], "]"}], "&"}], "/@", "vvei"}], ",", 
             "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ListEmptyQ", "[", "rpos", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"rpos", "=", 
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"MemberQ", "[", 
                   RowBox[{"sedges", ",", "#"}], "]"}], "&"}], "/@", "vvei"}],
                 ",", "True"}], "]"}], "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"rpos", "=", 
             RowBox[{"rpos", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}]}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"vvei", "=", 
           RowBox[{"RotateLeft", "[", 
            RowBox[{"vvei", ",", 
             RowBox[{"rpos", "-", "1"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"vvfi", "=", 
           RowBox[{"RotateLeft", "[", 
            RowBox[{"vvfi", ",", 
             RowBox[{"rpos", "-", "1"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "Now", " ", "go", " ", "through", " ", "the", " ", "faces", " ", 
             "and", " ", "edges", " ", "around", " ", "the", " ", "vertex"}], 
            ",", " ", 
            RowBox[{"creating", " ", "new", " ", "vertices", " ", "as", " ", 
             RowBox[{"needed", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
          
          RowBox[{"nv", "=", "vv"}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{
           "index", " ", "of", " ", "the", " ", "current", " ", "new", " ", 
            "vertex", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
              "which", " ", "starts", " ", "as", " ", "the", " ", "old", " ", 
               "vertex"}], ")"}], "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"prevnum", "=", 
           RowBox[{"Length", "[", "nverts", "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{"record", " ", "the", " ", "previous", " ", "number"}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"pe", ",", "cf"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"pe", "=", 
                RowBox[{
                "vvei", "\[LeftDoubleBracket]", "j", 
                 "\[RightDoubleBracket]"}]}], ";", 
               RowBox[{"(*", " ", 
                RowBox[{
                "index", " ", "of", " ", "edge", " ", "preceding", " ", 
                 "current", " ", "face"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"cf", "=", 
                RowBox[{
                "vvfi", "\[LeftDoubleBracket]", "j", 
                 "\[RightDoubleBracket]"}]}], ";", 
               RowBox[{"(*", " ", 
                RowBox[{
                "index", " ", "of", " ", "the", " ", "current", " ", "face"}],
                 " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"cf", "\[Equal]", "0"}], ",", 
                 RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
               RowBox[{"(*", " ", 
                RowBox[{
                "do", " ", "nothing", " ", "for", " ", "the", " ", "border", " ",
                  "face"}], " ", "*)"}], "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"sedges", ",", "pe"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                   RowBox[{
                   "if", " ", "preceding", " ", "edge", " ", "was", " ", "a", 
                    " ", "split", " ", "edge"}], ",", " ", 
