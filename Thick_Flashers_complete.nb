Cell["\<\
Example. Connect a square to a pleat-reduced square, rotated by 45\[Degree] \
from the square.\
\>", "Text",
 CellChangeTimes->{{3.6753737634366493`*^9, 
  3.675373776459972*^9}},ExpressionUUID->"72981d42-f64b-48e3-ac01-\
43e3a3baead7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "\[Phi]", ",", "dz", ",", "botpts2d", ",", "toppts2d", ",", 
      "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"45.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dz", "=", "0.5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{
       RowBox[{"DiscreteCircle", "[", 
        RowBox[{"m", ",", "1"}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"toppts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", "\[Phi]", "]"}], ".", "#"}], "&"}], 
       "/@", 
       RowBox[{"PleatReducePolygon", "[", 
        RowBox[{"botpts2d", ",", "0.5"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"DoubleJoinedTubes", "[", 
       RowBox[{"botpts2d", ",", "toppts2d", ",", "dz"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}], ",", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6711793832328787`*^9, 3.671179568554941*^9}, {
   3.671179608644779*^9, 3.671179632783592*^9}, {3.671180537675157*^9, 
   3.671180595760953*^9}, {3.671180721215306*^9, 3.671180721486787*^9}, {
   3.671181434010552*^9, 3.6711814347886133`*^9}, {3.671181587664304*^9, 
   3.67118158821384*^9}, 3.671181746672982*^9, {3.671182046157445*^9, 
   3.671182048382059*^9}, 3.671182127130238*^9, 3.671182163011779*^9, 
   3.671182251838939*^9, {3.671182577554877*^9, 3.671182617337886*^9}, {
   3.67120710574034*^9, 3.671207158854443*^9}, {3.671207352855898*^9, 
   3.671207368995403*^9}, {3.67124377944036*^9, 3.671243786480406*^9}, {
   3.6712462311154747`*^9, 3.671246236613549*^9}, 3.671246344682671*^9, {
