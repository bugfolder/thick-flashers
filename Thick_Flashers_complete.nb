  3.912661046306326*^9}},ExpressionUUID->"630e83e3-db76-4ec2-a47e-\
8b6ed99abcc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gc", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gc", "=", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TransformGC", "[", 
      RowBox[{"gc", ",", 
       RowBox[{
        RowBox[{"2", "*", "#"}], "&"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.912661048326859*^9, 3.912661122604766*^9}, {
