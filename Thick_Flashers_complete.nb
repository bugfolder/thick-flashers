   3.594307249252133*^9}, {3.594307286931732*^9, 3.594307287161955*^9}, 
   3.594307369133841*^9, {3.594307426891878*^9, 3.594307459031402*^9}, 
   3.594307549076696*^9, {3.594308169732396*^9, 3.594308197993348*^9}, {
   3.594308281308763*^9, 3.594308284308713*^9}, {3.594308371864827*^9, 
   3.59430843925721*^9}, {3.594311212293791*^9, 3.594311241597382*^9}, {
   3.594311723134492*^9, 3.594311748818953*^9}, {3.594311836418953*^9, 
   3.594311856799446*^9}, 3.594734827552539*^9, 3.5947401780010633`*^9, {
   3.594740404394885*^9, 3.59474043800983*^9}, 3.595200527149412*^9, 
   3.595200832744478*^9, 3.5952781986020517`*^9, {3.5953263453736258`*^9, 
   3.595326400039508*^9}, {3.595326615695381*^9, 3.595326620566381*^9}, {
   3.595326686194346*^9, 3.595326689195929*^9}, {3.595327654803099*^9, 
   3.595327717322665*^9}, {3.595327758230871*^9, 3.595327762126856*^9}, {
   3.617406799920416*^9, 3.617406804115695*^9}, {3.643374205487677*^9, 
   3.643374208452733*^9}, 3.673096600464834*^9, 3.706827181142462*^9, {
   3.7069654267295227`*^9, 3.7069654710185947`*^9}, {3.7069655104580717`*^9, 
   3.706965532729178*^9}, {3.707923705634873*^9, 3.707923707352186*^9}},
 CellLabel->
