Cell[TextData[{
 "Returns a list {",
 StyleBox["vlist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["elist",
  FontSlant->"Italic"],
 "} where:\n\t",
 StyleBox["vlist",
  FontSlant->"Italic"],
 " is a list where ",
 StyleBox["vlist",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "\[RightDoubleBracket] is the index in the new graph of the",
 StyleBox["j",
  FontSlant->"Italic"],
 "th vertex in ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[RightDoubleBracket]\n\t",
 StyleBox["elist",
  FontSlant->"Italic"],
 " is a list where ",
 StyleBox["elist",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "\[RightDoubleBracket] is the index in the new graph of the ",
 StyleBox["j",
  FontSlant->"Italic"],
 "th edge in ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[RightDoubleBracket]. "
}], "Text",
 CellChangeTimes->{{3.5946628331911*^9, 3.594662979716426*^9}, {
