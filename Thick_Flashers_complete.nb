53ec26597f6b"],

Cell[TextData[{
 "ApplyCollinearCleanupAssignedTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 "] takes a TGraphAssigned that has already had ApplyCollinearCleanup applied \
and applies the modifications described by ",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 " to the EdgeTypes data."
}], "Text",
 CellChangeTimes->{{3.707843669233399*^9, 3.707843705887328*^9}, {
  3.707852955658692*^9, 3.707852972206331*^9}, {3.707853184365459*^9, 
