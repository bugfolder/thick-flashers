Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "efp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTPlaneGraph", "[", 
        RowBox[{"pgvertscp", ",", "pgedges", ",", "pgfaces"}], "]"}], "//", 
       RowBox[{"AddTAssigned", "[", "pgtypes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"TypeToFlatFoldAngle", "[", "pgtypes", "]"}], ",", 
        RowBox[{"StationaryFace", "\[Rule]", "4"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"efp", "=", 
      RowBox[{"EdgeFacePairs", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "efp", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphGraphics", "[", "tobj", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
