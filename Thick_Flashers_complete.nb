            RowBox[{"4", ",", "8", ",", "5", ",", "1"}], "}"}]}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"panel2", "=", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
