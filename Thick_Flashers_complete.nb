 CellLabel->
  "In[2117]:=",ExpressionUUID->"837532ba-13a4-4d78-8b8d-82105af4d14e"],

Cell[TextData[{
 "RigidlyScaleFoldAngles[",
 StyleBox["glist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["grule",
  FontSlant->"Italic"],
 "] scales a list of angles so that the fold angle multiplier between any \
pair is preserved."
}], "Text",
 CellChangeTimes->{{3.693511244113511*^9, 3.693511282792955*^9}, 
   3.693511410990114*^9},ExpressionUUID->"832329d9-8ccb-46c9-85d9-\
d4bf848d731b"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["glist",
  FontSlant->"Italic"],
 " \[LongDash] a list of fold angles.\n\t",
 StyleBox["grule",
  FontSlant->"Italic"],
 " \[LongDash] a rule of the form \[Gamma]a \[Rule] \[Gamma]b, specifying how \
\[Gamma]a maps to new angle \[Gamma]b."
}], "Text",
 CellChangeTimes->{{3.693511413754986*^9, 
  3.6935114523870783`*^9}},ExpressionUUID->"f8d4ee77-b2f3-401b-bd1b-\
81281eca9349"],

Cell["\<\
This comes in useful if you\[CloseCurlyQuote]ve developed a nice \
RigidlyFoldableQuadMesh and want to see what it looks like with the same \
crease pattern but a different state of foldedness.\
\>", "Text",
 CellChangeTimes->{{3.693513924518982*^9, 
  3.693513961966256*^9}},ExpressionUUID->"f38d4b7e-249f-431f-bae0-\
382482c37284"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RigidlyScaleFoldAngles", "[", 
   RowBox[{"glist_List", ",", "grule_Rule"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ga", ",", "gb", ",", "mu"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ga", ",", "gb"}], "}"}], "=", 
      RowBox[{"List", "@@", "grule"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mu", "=", 
      RowBox[{
       RowBox[{"Tan", "[", 
        RowBox[{"gb", "/", "2"}], "]"}], "/", 
       RowBox[{"Tan", "[", 
        RowBox[{"ga", "/", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"RigidlyScaleFoldAngles", "[", 
      RowBox[{"glist", ",", "mu"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.693511212415983*^9, 3.693511240617878*^9}, {
  3.6935113104014*^9, 3.693511404716475*^9}, {3.693513682381596*^9, 
  3.693513692156512*^9}, {3.695231619721552*^9, 3.695231630505204*^9}},
