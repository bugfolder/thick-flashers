     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}], "//", "ColumnForm"}],
   "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.643373865390345*^9, 3.6433738935837793`*^9}, 
   3.687006196278323*^9, {3.687006229332072*^9, 3.687006248409079*^9}, 
   3.6870063331276093`*^9},
