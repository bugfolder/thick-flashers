         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"q", ",", "s"}], "}"}], "]"}], ",", "Magenta"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"r", ",", "s"}], "}"}], "]"}], ",", "Yellow"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p\>\"", ",", "p"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<q\>\"", ",", "q"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<r\>\"", ",", "r"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<s\>\"", ",", "s"}], "]"}]}], "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TetrahedronSinA", "[", 
      RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
