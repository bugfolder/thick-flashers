Cell[TextData[{
 "ScaleRotationOffsetFixedPoint[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}] returns the fixed point of the scale-rotation-offset transformation that \
takes segment {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ",",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} to ",
 StyleBox["q1",
  FontSlant->"Italic"],
 ",",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.628782810122484*^9, 
  3.62878284159822*^9}},ExpressionUUID->"44167b2a-37e4-4a9a-bdbd-\
9ec886c1da54"],

