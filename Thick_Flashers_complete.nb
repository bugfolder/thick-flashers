Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CanonicalConeDevelopableSystem", "::", "baddir"}], 
   "=", "\"\<Directrix `1` is not a constant function.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.689848624945204*^9, 3.689848657439632*^9}, {
  3.689849672814333*^9, 3.689849675673622*^9}},
 CellLabel->
