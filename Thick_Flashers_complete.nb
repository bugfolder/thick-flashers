   3.825768997730348*^9, 3.825769034304742*^9}, {3.825769821640825*^9, 
   3.825769889006728*^9}, {3.825769948503428*^9, 3.825769956671217*^9}, {
   3.825769990616748*^9, 3.825770015584085*^9}, {3.825770047931222*^9, 
