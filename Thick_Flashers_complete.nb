Cell[BoxData[
 RowBox[{
  RowBox[{"FlattenGeneric2D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bb_Function", ",", "dd_Function", ",", "\[Sigma]_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bi_List", ",", "ti_List"}], "}"}], ",", "opts___"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sim", ",", "as", ",", "sfn", ",", "dsopts", ",", "s", ",", "uu", ",", 
      "cc", ",", "tt", ",", "ll", ",", "d3dsys", ",", "ds", ",", "\[Kappa]g", 
      ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "c2dsys", ",", "b", ",", "t", ",",
       "l", ",", "d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sim", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ReshapeGeneric3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", 
        RowBox[{
         RowBox[{"Assumptions", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "ReshapeGeneric3D", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sim", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"sim", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"txd", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"bb", "'"}], "[", "s", "]"}], "\[Cross]", 
              RowBox[{"dd", "[", "s", "]"}]}]}], "}"}], ",", 
           RowBox[{"\[Sigma]", " ", 
            RowBox[{"NormalizeReal", "[", "txd", "]"}]}]}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d3dsys", "=", 
      RowBox[{"Darboux3DSystem", "[", 
       RowBox[{"bb", ",", "uu", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "ll", ",", "ds", ",", "\[Kappa]g"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector3D", ",", "TangentNormalVector3D", ",", "Speed3D", ",", 
         "GeodesicCurvature3D"}], "}"}], "/.", "d3dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", " ", 
          RowBox[{
           RowBox[{"tt", "[", "s", "]"}], ".", 
           RowBox[{"dd", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", " ", 
          RowBox[{
           RowBox[{"ll", "[", "s", "]"}], ".", 
           RowBox[{"dd", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c2dsys", "=", 
      RowBox[{"RecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]g", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bi", ",", "ti"}], "}"}], ",", "opts"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Curve2D", ",", "TangentVector2D", ",", "LeftNormalVector2D"}], "}"}],
        "/.", "c2dsys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
             RowBox[{"t", "[", "s", "]"}]}], "+", 
            RowBox[{
             RowBox[{"s\[Rho]L", "[", "s", "]"}], 
             RowBox[{"l", "[", "s", "]"}]}]}], ")"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.798572927592586*^9, 3.798572964094378*^9}, {
