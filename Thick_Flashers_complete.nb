Cell[CellGroupData[{

Cell["Unit regular polygon offset twist properties", "Subsection",
 CellChangeTimes->{{3.457747160155204*^9, 3.457747161329598*^9}, 
   3.627340100081899*^9, 3.627385975969592*^9, {3.628693157473204*^9, 
   3.6286931604097433`*^9}, 
   3.628708778511884*^9},ExpressionUUID->"dc4f207a-eb35-41ff-9ea6-\
085ff67bb4d4"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.4626262288526*^9, 3.462626229250251*^9}, 
   3.62738597596988*^9},ExpressionUUID->"250419aa-5ded-418f-8904-\
f543c4465f4e"],

Cell["\<\
These functions implement offset twists (pleats perpendicular to the tile \
edges) in unit regular polygons.\
\>", "Text",
 CellChangeTimes->{{3.627345810572134*^9, 3.627345814558327*^9}, 
   3.6273859759702053`*^9},ExpressionUUID->"2dd1c9ee-5221-48c0-9195-\
801f6a293387"],

Cell[TextData[{
 "This example computes and plots the vertices of three consecutive edges, \
symbolically on ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", from which we can compute symbolic expressions for the twist angle, \
shrinkage, and rotation."
}], "Text",
 CellChangeTimes->{{3.62836307141155*^9, 3.628363106197625*^9}, {
  3.628363492821849*^9, 3.628363495381082*^9}, {3.628364107151298*^9, 
  3.6283641082542*^9}, {3.629978379436409*^9, 
  3.629978401457119*^9}},ExpressionUUID->"c71fa8b7-0838-4aeb-afa9-\
4954e29be366"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", ",", "v", ",", "r", ",", "s", ",", "q"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{"UnitRegularPolygonCenter", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"v", "[", "i_", "]"}], ":=", 
      RowBox[{"c", "-", 
       RowBox[{
        RowBox[{"RotationMatrix2D", "[", 
         RowBox[{"2", "\[Pi]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"i", "-", "1"}], ")"}], "/", "n"}]}], "]"}], ".", 
        "c"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"1", "+", "w"}], "2"], "-", "d"}], ")"}], 
        RowBox[{"v", "[", "i", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"1", "-", "w"}], "2"], "+", "d"}], ")"}], 
        RowBox[{"v", "[", 
         RowBox[{"i", "+", "1"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"1", "-", "w"}], "2"], "-", "d"}], ")"}], 
        RowBox[{"v", "[", "i", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"1", "+", "w"}], "2"], "+", "d"}], ")"}], 
        RowBox[{"v", "[", 
         RowBox[{"i", "+", "1"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "i_", "]"}], ":=", 
      RowBox[{"LineInt2D", "[", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"i", "-", "1"}], "]"}], ",", 
        RowBox[{"U", "[", 
         RowBox[{
          RowBox[{"2", "\[Pi]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", "2"}], ")"}], "/", "n"}]}], "+", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}], ",", 
        RowBox[{"r", "[", "i", "]"}], ",", 
        RowBox[{"U", "[", 
         RowBox[{
          RowBox[{"2", "\[Pi]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", "1"}], ")"}], "/", "n"}]}], "+", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Twist angle = \>\"", ",", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"ArcTan", "[", 
         FractionBox["w", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"q", "[", "2", "]"}], "-", 
             RowBox[{"q", "[", "1", "]"}]}], ")"}], "\[LeftDoubleBracket]", 
           "2", "\[RightDoubleBracket]"}]], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Shrinkage = \>\"", ",", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Mag", "[", 
         RowBox[{
          RowBox[{"q", "[", "2", "]"}], "-", 
          RowBox[{"q", "[", "1", "]"}]}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Rotation = \>\"", ",", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"q", "[", "2", "]"}], "-", 
             RowBox[{"q", "[", "1", "]"}]}], ")"}], "\[LeftDoubleBracket]", 
           "2", "\[RightDoubleBracket]"}], "w"], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"v", "[", "0", "]"}], ",", 
               RowBox[{"v", "[", "1", "]"}], ",", 
               RowBox[{"v", "[", "2", "]"}], ",", 
               RowBox[{"v", "[", "3", "]"}]}], "}"}], "]"}], ",", "Black"}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"s", "[", "0", "]"}], ",", 
                 RowBox[{"q", "[", "1", "]"}], ",", 
                 RowBox[{"r", "[", "1", "]"}]}], "}"}], "]"}], ",", 
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"s", "[", "1", "]"}], ",", 
                 RowBox[{"q", "[", "2", "]"}], ",", 
                 RowBox[{"r", "[", "2", "]"}]}], "}"}], "]"}]}], "}"}], ",", 
            "Blue"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"q", "[", "0", "]"}], ",", 
               RowBox[{"q", "[", "1", "]"}], ",", 
               RowBox[{"q", "[", "2", "]"}], ",", 
               RowBox[{"q", "[", "3", "]"}]}], "}"}], "]"}], ",", "Red"}], 
           "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "\[Rule]", "5"}], ",", 
        RowBox[{"w", "\[Rule]", "0.2"}], ",", 
        RowBox[{"d", "\[Rule]", "0.1"}]}], "}"}]}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.628363108000286*^9, 3.628363174467701*^9}, {
   3.62836324961952*^9, 3.628363302754607*^9}, {3.628363334115803*^9, 
   3.628363410175282*^9}, {3.628363484317801*^9, 3.628363486001401*^9}, {
   3.628363529864543*^9, 3.628363819952659*^9}, {3.628363858766806*^9, 
   3.628364096320188*^9}, {3.628364139252715*^9, 3.628364306843851*^9}, {
   3.628364359258357*^9, 3.628364402913029*^9}, 3.628364437764236*^9, {
   3.628364503926543*^9, 3.628364643373829*^9}, {3.628364828590788*^9, 
   3.62836484907952*^9}, {3.628365227578593*^9, 3.628365230927504*^9}, 
   3.688166837257395*^9},
 CellLabel->
  "In[3009]:=",ExpressionUUID->"c05adb20-36c5-4c32-9c38-a15a21f541d7"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "UnitRegularPolygonOffsetTwistAngle",
 "[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "]\nUnitRegularPolygonOffsetTwistOffset[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha]]"
}], "Subsubsection",
 CellChangeTimes->{{3.45774623147645*^9, 3.457746235273218*^9}, {
   3.6273396760708933`*^9, 3.62733967617743*^9}, 3.627345724948496*^9, 
   3.6273457967319326`*^9, 
   3.627385975970557*^9},ExpressionUUID->"22cd00cf-ff04-47fe-b926-\
082c53303a1f"],

Cell[TextData[{
 "UnitRegularPolygonOffsetTwistAngle[",
 StyleBox["n, w, d",
  FontSlant->"Italic"],
 "] returns the twist angle \[Alpha] for a unit polygon offset twist of order \
",
 StyleBox["n",
  FontSlant->"Italic"],
 ", pleat width ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", and offset ",
 StyleBox["d",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.457746247244007*^9, 3.457746248393016*^9}, 
   3.627339676290949*^9, 3.627345725077775*^9, 3.627345796828601*^9, 
   3.627385975971027*^9, {3.627680050921874*^9, 
   3.627680051328474*^9}},ExpressionUUID->"7e344505-751e-43d1-bebe-\
28abb4432b5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitRegularPolygonOffsetTwistAngle", "[", 
   RowBox[{"n_", ",", "w_", ",", "d_"}], "]"}], ":=", 
  RowBox[{"Mod", "[", 
   RowBox[{
    RowBox[{"ArcTan", "[", 
     RowBox[{
      FractionBox["w", 
       RowBox[{"2", "d"}]], 
      RowBox[{"Cot", "[", 
       FractionBox["\[Pi]", "n"], "]"}]}], "]"}], ",", "\[Pi]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{3.627339676322954*^9, 3.627345725124464*^9, 
  3.627345796856303*^9, 3.627385975971443*^9},
 CellLabel->
  "In[3010]:=",ExpressionUUID->"90667840-e745-420e-9da7-d8bc4b2365cc"],

Cell[TextData[{
 "UnitRegularPolygon",
 "OffsetTwistOffset[",
 StyleBox["n",
  FontSlant->"Italic"],
 ",",
 StyleBox["w",
  FontSlant->"Italic"],
 ",\[Alpha]] returns the offset parameter ",
 StyleBox["d",
  FontSlant->"Italic"],
 " for a unit polygon offset twist of order ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", pleat width ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", and twist angle \[Alpha]."
}], "Text",
 CellChangeTimes->{3.6273396764109926`*^9, 
  3.6273859759717917`*^9},ExpressionUUID->"9eac2284-a3e3-4795-8886-\
6bc1fd10ca5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitRegularPolygonOffsetTwistOffset", "[", 
   RowBox[{"n_", ",", "w_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["w", "2"], 
   RowBox[{"Cot", "[", 
    FractionBox["\[Pi]", "n"], "]"}], 
   RowBox[{"Cot", "[", "\[Alpha]", "]"}]}]}]], "Input",
 CellChangeTimes->{3.627339676442377*^9, 3.627385975972129*^9},
 CellLabel->
  "In[3011]:=",ExpressionUUID->"a656bd43-d715-46a7-8c3e-980a4110c616"],

Cell[TextData[{
 "The important thing to note here is that tile mating happens for constant \
",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", so \[Alpha] is going to vary from tile to tile (if the number of sides, \
",
 StyleBox["n",
  FontSlant->"Italic"],
 ", is different). This example plot shows that, in general, the twist angle \
gets larger for increasing ",
 StyleBox["n",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.627680065935693*^9, 3.627680154122176*^9}, {
  3.627680582255965*^9, 
  3.6276806014536057`*^9}},ExpressionUUID->"8d2061ff-acaf-409f-81ea-\
0d3af0904e71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"w", ",", "d", ",", "pts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{
           RowBox[{"UnitRegularPolygonOffsetTwistAngle", "[", 
            RowBox[{"n", ",", "w", ",", "d"}], "]"}], "/", "\[Degree]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "3", ",", "12"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "12"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "90"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"AxesLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<n\>\"", ",", "\"\<\[Alpha]/\[Degree]\>\""}], "}"}]}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.627680348283852*^9, 3.627680420254313*^9}, {
   3.627680455619358*^9, 3.627680579050415*^9}, 3.688996830769807*^9},
 CellLabel->
  "In[3012]:=",ExpressionUUID->"246abc77-93cb-4c9e-884f-99f8e0744bcf"]
}, Closed]],

