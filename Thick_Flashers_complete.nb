               "mji", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", "OsculatingLine"}], ",", 
              RowBox[{"FillStyle", "\[Rule]", "OsculatingFill"}]}], "]"}], 
            "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"osculating", " ", "plane"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"srp", ",", 
           RowBox[{"{", 
            RowBox[{"Styled3DUnitDiskFromInPlaneVectors", "[", 
             RowBox[{
              RowBox[{"gg", "\[LeftDoubleBracket]", 
               RowBox[{
               "mni", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"gg", "\[LeftDoubleBracket]", 
