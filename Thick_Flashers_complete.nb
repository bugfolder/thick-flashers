Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives the arbitrary-speed 3D space curve.\
\n\t",
 StyleBox["u",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives the 3D surface normal vector along \
the curve."
}], "Text",
 CellChangeTimes->{{3.691245584336808*^9, 3.691245586673559*^9}, {
