Cell["Example: {1,3} Torus knot.", "Text",
 CellChangeTimes->{{3.800642847257657*^9, 3.8006428480415382`*^9}, {
  3.800643873048978*^9, 3.800643875576474*^9}, {3.800648052814384*^9, 
  3.8006480588216953`*^9}},ExpressionUUID->"71860ac0-7b20-4de4-b97f-\
53b5510edbd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", ",", "u0", ",", "u1", ",", "frpp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{"KnotData", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<TorusKnot\>\"", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "}"}], 
        ",", "\"\<SpaceCurve\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"c", "//", "PrettyParameters"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"2", "\[Pi]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"frpp", "=", 
      RowBox[{"FrenetRibbonPlotPair", "[", 
       RowBox[{"c", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"InterpolationPoints", "\[Rule]", "64"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"CurveDivisions", "\[Rule]", "500"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"frpp", ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], "]"}],
       "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.800642855491624*^9, 3.8006429672110567`*^9}, {
   3.800643289917918*^9, 3.80064333935758*^9}, {3.8006433982567263`*^9, 
   3.800643420168021*^9}, {3.800643671026515*^9, 3.800643671271268*^9}, {
   3.800643710403275*^9, 3.80064373339156*^9}, {3.80064380801782*^9, 
