Cell[TextData[{
 "RenderTile[{QuadrilateralSplitTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraphAssigned+TTwistGraph that describes the creases for a \
twist in polygon specified by its vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where \t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \n\t\
\[Tau] is the pleat angle, defined as the rotation angle of the pleat \
measured with respect to the edge, \n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the offset from the center of the edge, \n\t",
 StyleBox["ccw",
  FontSlant->"Italic"],
 " is a flag indicating whether the pleat crease assignment should assume a \
CCW twist, \n\t",
 StyleBox["ip",
  FontSlant->"Italic"],
 " is the index of the degree-6 vertex,\n\t",
 StyleBox["ctype",
  FontSlant->"Italic"],
 " is the type of the connecting fold,\n\t",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
   3.457740055563382*^9}, {3.457899240889505*^9, 3.457899262921368*^9}, {
   3.533668819444027*^9, 3.533668840458009*^9}, {3.533683624395843*^9, 
   3.533683629667203*^9}, {3.533683676248049*^9, 3.533683676297819*^9}, {
   3.533683730482073*^9, 3.533683812423534*^9}, {3.592170850586206*^9, 
   3.5921708645033407`*^9}, {3.592171015904443*^9, 3.592171017781418*^9}, {
   3.592214871731565*^9, 3.592214878400432*^9}, {3.59221494757358*^9, 
   3.592214948427593*^9}, 3.592435762083316*^9, {3.592828736153255*^9, 
   3.592828736410353*^9}, 3.592870181118533*^9, {3.5950280696996307`*^9, 
   3.595028075080748*^9}, {3.595028386510235*^9, 3.595028392557011*^9}, {
   3.595028427489479*^9, 3.595028427745745*^9}, {3.5950284895595284`*^9, 
   3.595028489703443*^9}, {3.6273330655629077`*^9, 3.627333085207815*^9}, {
   3.627339667803769*^9, 3.627339667945515*^9}, {3.627340454810054*^9, 
   3.627340504910087*^9}, {3.62734354968379*^9, 3.627343579265236*^9}, {
   3.627343862257011*^9, 3.627343862807916*^9}, {3.627346019472095*^9, 
   3.627346020702108*^9}, {3.627385864562024*^9, 3.627385864922184*^9}, 
   3.627385975627675*^9, 3.628531175117343*^9, {3.628637058189805*^9, 
   3.628637058369692*^9}, {3.629826857356954*^9, 3.629826902238055*^9}, {
   3.629977401212065*^9, 3.629977408713543*^9}, 3.6300188255006943`*^9, 
   3.63001893324739*^9, {3.630019010272143*^9, 3.630019026980763*^9}, 
   3.630072615924238*^9, {3.630073280139172*^9, 3.630073328267875*^9}, {
   3.630092875371728*^9, 3.630092880250402*^9}, {3.630245073803347*^9, 
   3.630245092488196*^9}, 
   3.70783894766348*^9},ExpressionUUID->"297af37f-c070-49b7-837f-\
c59b1ba72ac5"],

Cell["\<\
We create the TGraphAssigned by building a (non-flat-foldable) twist, then \
tweaking it into flat-foldability, moving and creating vertices, edges, and \
faces.\
\>", "Text",
 CellChangeTimes->{{3.630092097895248*^9, 3.630092117732113*^9}, {
   3.630100438234941*^9, 3.630100451722199*^9}, 
   3.707838955543488*^9},ExpressionUUID->"03678ece-375a-47b0-92a7-\
8c9c82ab4c2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuadrilateralSplitTwistTile", "::", "badsize"}], 
   "=", "\"\<Vertex list `1` is not length 4.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.630074776481698*^9, 3.6300747962635*^9}},
 CellLabel->
  "In[2932]:=",ExpressionUUID->"3b17f4f8-a8e7-4aba-bb27-1bf0e0a136ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuadrilateralSplitTwistTile", "::", "badip"}], 
   "=", "\"\<The specified vertex `1`'s Kawasaki excess `2` is not \
positive.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.630074716045592*^9, 3.630074769504153*^9}},
 CellLabel->
  "In[2933]:=",ExpressionUUID->"8b089a1f-0cfe-4a56-aa62-0365182113fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "QuadrilateralSplitTwistTile", ",", "verts_List", ",", " ", "w_", ",", 
      "d_", ",", " ", "\[Tau]_", ",", "ccw_", ",", "ip_", ",", "ctype_", ",", 
      "types_List"}], "}"}], ",", "TGraphAssigned", ",", "opts___"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "tobj", ",", "tae", ",", "ta", ",", "sta", ",", "vfn", ",", 
      "efn", ",", "v", ",", "e", ",", "f", ",", "t", ",", "\[Alpha]l", ",", 
      "\[Alpha]r", ",", "vil", ",", "vir", ",", "vib", ",", "vb", ",", "pdir",
       ",", "vl", ",", "vr", ",", "en"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[NotEqual]", "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"QuadrilateralSplitTwistTile", "::", "badsize"}], ",", 
          "verts"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RenderTile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "PolygonTwistTile", ",", "verts", ",", "w", ",", "d", ",", "\[Tau]", 
          ",", "ccw", ",", "types"}], "}"}], ",", "TGraphAssigned"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"tae", "=", 
      RowBox[{"PolygonTwistCentralPolygonAnglesExcess", "[", "tobj", "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "tae", "\[LeftDoubleBracket]", "ip", "\[RightDoubleBracket]"}], "\[LessEqual]",
          "0"}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"QuadrilateralSplitTwistTile", "::", "badip"}], ",", "ip", 
           ",", 
           RowBox[{
           "tae", "\[LeftDoubleBracket]", "ip", "\[RightDoubleBracket]"}]}], 
          "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ta", "=", 
      RowBox[{"PolygonTwistTwistAngles", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "gets", " ", "vertex", " ", "index", " ", "based", " ", "on", " ", 
       "rotational", " ", "position", " ", "i"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"4", "i"}], "+", "j"}], ",", "16", ",", "1"}], "]"}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{
      "gets", " ", "edge", " ", "index", " ", "based", " ", "on", " ", 
       "rotational", " ", "position", " ", "i"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"efn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"6", 
          RowBox[{"(", 
           RowBox[{"i", "-", "1"}], ")"}]}], "+", "j"}], ",", "24", ",", 
        "1"}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v", ",", "e", ",", "f", ",", "t"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "Faces", ",", "EdgeTypes"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]l", ",", "\[Alpha]r"}], "}"}], "=", 
      RowBox[{"ta", "\[LeftDoubleBracket]", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ip", "-", "1"}], ",", "ip"}], "}"}], ",", "4", ",", "1"}],
         "]"}], "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "preceding", " ", "and", " ", "following", " ", "twist", " ", 
       "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ta", "\[LeftDoubleBracket]", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ip", "-", "2"}], ",", 
           RowBox[{"ip", "+", "1"}]}], "}"}], ",", "4", ",", "1"}], "]"}], 
       "\[RightDoubleBracket]"}], "=", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]l", ",", "\[Alpha]r"}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "split", " ", "twist", " ", "angles"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"vil", "=", 
      RowBox[{"vfn", "[", 
       RowBox[{
        RowBox[{"ip", "+", "2"}], ",", "0"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"index", " ", "of", " ", "vertex", " ", "to", " ", "split"}], ",",
        " ", 
       RowBox[{"will", " ", "become", " ", "left", " ", "vertex"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"v", ",", 
       RowBox[{
       "v", "\[LeftDoubleBracket]", "vil", "\[RightDoubleBracket]"}]}], "]"}],
      ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"the", " ", "new", " ", "vertex"}], ",", " ", 
       RowBox[{"will", " ", "become", " ", "right", " ", "vertex"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vir", "=", 
      RowBox[{"Length", "[", "v", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"index", " ", "of", " ", "the", " ", "right", " ", "vertex"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vib", "=", 
      RowBox[{"vfn", "[", 
       RowBox[{"ip", ",", "0"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"index", " ", "of", " ", "the", " ", "base", " ", 
       RowBox[{"(", 
        RowBox[{"degree", "-", "6"}], ")"}], " ", "vertex"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vb", "=", 
      RowBox[{"v", "\[LeftDoubleBracket]", "vib", "\[RightDoubleBracket]"}]}],
      ";", 
     RowBox[{"(*", " ", 
      RowBox[{"coordinates", " ", "of", " ", "the", " ", "base", " ", 
       RowBox[{"(", 
        RowBox[{"degree", "-", "6"}], ")"}], " ", "vertex"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "location", " ", "of", " ", "altered", " ", 
       "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pdir", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"v", "\[LeftDoubleBracket]", 
         RowBox[{"vfn", "[", 
          RowBox[{
           RowBox[{"ip", "+", "2"}], ",", "0"}], "]"}], 
         "\[RightDoubleBracket]"}], "-", 
        RowBox[{"v", "\[LeftDoubleBracket]", 
         RowBox[{"vfn", "[", 
          RowBox[{
           RowBox[{"ip", "+", "2"}], ",", 
           RowBox[{"-", "2"}]}], "]"}], "\[RightDoubleBracket]"}]}], ")"}]}], 
     ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "direction", " ", "of", " ", "one", " ", "altered", " ", "pleat"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vl", "=", 
      RowBox[{"LineInt2D", "[", 
       RowBox[{
        RowBox[{"v", "\[LeftDoubleBracket]", 
         RowBox[{"vfn", "[", 
          RowBox[{
           RowBox[{"ip", "-", "1"}], ",", "0"}], "]"}], 
         "\[RightDoubleBracket]"}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"-", "\[Alpha]l"}], "]"}], ".", "pdir"}], ",", 
        RowBox[{"v", "\[LeftDoubleBracket]", "vil", "\[RightDoubleBracket]"}],
         ",", "pdir"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"first", " ", "new", " ", "vertex"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"pdir", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"v", "\[LeftDoubleBracket]", 
         RowBox[{"vfn", "[", 
          RowBox[{
           RowBox[{"ip", "+", "1"}], ",", "0"}], "]"}], 
         "\[RightDoubleBracket]"}], "-", 
        RowBox[{"v", "\[LeftDoubleBracket]", 
         RowBox[{"vfn", "[", 
          RowBox[{
           RowBox[{"ip", "+", "1"}], ",", 
           RowBox[{"-", "2"}]}], "]"}], "\[RightDoubleBracket]"}]}], ")"}]}], 
     ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "direction", " ", "of", " ", "other", " ", "altered", " ", "pleat"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vr", "=", 
      RowBox[{"LineInt2D", "[", 
       RowBox[{
        RowBox[{"v", "\[LeftDoubleBracket]", 
         RowBox[{"vfn", "[", 
          RowBox[{
           RowBox[{"ip", "+", "1"}], ",", "0"}], "]"}], 
         "\[RightDoubleBracket]"}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"\[Pi]", "-", "\[Alpha]r"}], "]"}], ".", "pdir"}], ",", 
        RowBox[{"v", "\[LeftDoubleBracket]", "vil", "\[RightDoubleBracket]"}],
         ",", "pdir"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"second", " ", "new", " ", "vertex"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "put", " ", "them", " ", "into", " ", "our", " ", "vertex", " ", 
