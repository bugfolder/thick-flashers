Cell[CellGroupData[{

Cell["Nonperiodic tilings", "Section",
 CellChangeTimes->{{3.631032251158033*^9, 3.6310322598868847`*^9}, {
   3.631089508353812*^9, 3.6310895120246267`*^9}, {3.631123275977325*^9, 
   3.631123280781438*^9}, 
   3.631185233565597*^9},ExpressionUUID->"c6fd95ee-9ae3-42ce-b3a7-\
4bc86a7dc7a8"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.6310323253468733`*^9, 
  3.631032325778609*^9}},ExpressionUUID->"9e3d8822-a104-4ffc-8a62-\
fe931fd5e82a"],

Cell["\<\
Lots of interesting tilings are not periodic, but can still be defined and/or \
constructed efficiently as assemblies of smaller building blocks. In this \
section we set up functions to facilitate the construction of such tilings, \
along with some examples of specific tilings and families of tilings of \
interest.\
\>", "Text",
 CellChangeTimes->{{3.6310323294509172`*^9, 3.631032413013085*^9}, {
  3.6310577010190277`*^9, 
  3.631057707968643*^9}},ExpressionUUID->"925f2671-c583-4916-9d9d-\
80fa9e3d646f"]
}, Closed]],

Cell[CellGroupData[{

Cell["Combining patches", "Subsection",
 CellChangeTimes->{{3.631100977539094*^9, 3.63110098099168*^9}, {
  3.631123551765282*^9, 3.631123552912429*^9}, {3.631139998183723*^9, 
  3.631139999240148*^9}},ExpressionUUID->"4e3a30d3-0b1f-407f-8586-\
c4ff2fd4ef37"],

Cell[CellGroupData[{

Cell[TextData[{
 "JoinTilingPatches[",
 StyleBox["patchinfolist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t",
 "(options) Simplification",
 ", Numeric"
}], "Subsubsection",
 CellChangeTimes->{{3.6310331549999638`*^9, 3.631033175076225*^9}, 
   3.631034936101644*^9, {3.63104169675827*^9, 3.6310416971005373`*^9}, 
   3.690988444321795*^9},ExpressionUUID->"543c145b-e3bc-420c-8b2e-\
7ad49b7aae2b"],

Cell[TextData[{
 "JoinTilingPatches[",
 StyleBox["patchinfolist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of patches combined with offset information and assembles \
them into a tiling, i.e., a single list of tilespecs. The format of patchlist \
is\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["patch",
         FontSlant->"Italic"], "1"], ",", " ", 
       StyleBox["any",
        FontSlant->"Italic"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["patch",
         FontSlant->"Italic"], "2"], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["h", "2"], ",", 
           SubscriptBox["i", "2"], ",", 
           SubscriptBox["j", "2"]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["k", "2"], ",", 
           SubscriptBox["l", "2"]}], "}"}]}], "}"}]}], "}"}], ",", " ", 
     "..."}], "}"}], TraditionalForm]],ExpressionUUID->
  "ed63cf93-34f2-4c18-9b3e-f3ad233d42cd"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["patch",
     FontSlant->"Italic"], "1"], TraditionalForm]],ExpressionUUID->
  "01488c67-63e7-47cb-94a7-531bb8dfbece"],
 " is an initial patch (a list of tilespecs), and each subsquent element is a \
pair consisting of a patch and an ordered list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["h", "2"], ",", 
       SubscriptBox["i", "2"], ",", 
       SubscriptBox["j", "2"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["k", "2"], ",", 
       SubscriptBox["l", "2"]}], "}"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"59bc243a-917a-4759-9f91-f0394a6ec788"],
 " that descriptions its position. In a fashion similar to JoinTiling, the \
(",
 StyleBox["l",
  FontSlant->"Italic"],
 "-1)th and ",
 StyleBox["l",
  FontSlant->"Italic"],
 "th vertices of the ",
 StyleBox["k",
  FontSlant->"Italic"],
 "th tile in the patch is aligned with the (",
 StyleBox["j",
  FontSlant->"Italic"],
 "+1)th and ",
 StyleBox["j",
  FontSlant->"Italic"],
 "th vertices (respectively) of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th tile of the ",
 StyleBox["h",
  FontSlant->"Italic"],
 "th patch in the list (which must precede the current patch). Note that the \
variable ",
 StyleBox["any",
  FontSlant->"Italic"],
 "  after ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["patch",
     FontSlant->"Italic"], "1"], TraditionalForm]],ExpressionUUID->
  "4aa5d05a-9d79-47ef-8da9-8a8043a27c51"],
 " is ignored and may be omitted. Options are:\n\tSimplify, Numeric have the \
same meaning as they do in JoinTiling."
}], "Text",
 CellChangeTimes->{{3.631033185581518*^9, 3.631033590554018*^9}, {
   3.631033642030602*^9, 3.6310336443746853`*^9}, {3.631034598688902*^9, 
   3.631034612160676*^9}, {3.631034912318771*^9, 3.631034962218622*^9}, {
   3.631036072678089*^9, 3.631036086218303*^9}, {3.631040629738383*^9, 
   3.6310406378962092`*^9}, 3.6310417329030027`*^9, {3.631638666326058*^9, 
   3.631638667955478*^9}, {3.631638709624984*^9, 
   3.63163875340813*^9}},ExpressionUUID->"05214b17-d953-46ea-8b97-\
b9e10113e785"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JoinTilingPatches", "[", 
   RowBox[{"patchinfolist_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "nm", ",", "sfn", ",", "np", ",", "patchlist", ",", 
      "patchinfo", ",", "patch", ",", "h", ",", "i", ",", "j", ",", "k", ",", 
      "l", ",", "sverts", ",", "tverts", ",", "ps", ",", "pr", ",", "po", ",",
       "nt", ",", "tilespec", ",", "tiletype", ",", "to", ",", "tr", ",", 
      "ts", ",", "verts", ",", "pos"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "JoinTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nm", "=", 
      RowBox[{
       RowBox[{"Numeric", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "JoinTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "Automatic"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{"nm", ",", "N", ",", 
          RowBox[{"#", "&"}]}], "]"}], ",", "Simplify"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"np", "=", 
      RowBox[{"Length", "[", "patchinfolist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"patchlist", "=", 
      RowBox[{"First", "/@", "patchinfolist"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"just", " ", "the", " ", "patches"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"for", " ", "each", " ", "patch"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"patchinfo", "=", 
         RowBox[{
         "patchinfolist", "\[LeftDoubleBracket]", "ip", 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"patch", "=", 
         RowBox[{
         "patchinfo", "\[LeftDoubleBracket]", "1", 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"h", ",", "i", ",", "j"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "l"}], "}"}]}], "}"}], "=", 
         RowBox[{
         "patchinfo", "\[LeftDoubleBracket]", "2", 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sverts", "=", 
         RowBox[{"EmbedTile", "[", 
          RowBox[{
           RowBox[{"patchlist", "\[LeftDoubleBracket]", 
            RowBox[{"h", ",", "i"}], "\[RightDoubleBracket]"}], ",", 
           "TileVertices"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"source", " ", "tile", " ", "vertices"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"tverts", "=", 
         RowBox[{"EmbedTile", "[", 
          RowBox[{
           RowBox[{
           "patch", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], ",",
            "TileVertices"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "target", " ", "tile", " ", "vertices", " ", "within", " ", "in", " ",
           "this", " ", "patch"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"scale", ",", " ", "rotation", ",", " ", 
          RowBox[{
          "offset", " ", "to", " ", "be", " ", "applied", " ", "to", " ", 
           "each", " ", "tile", " ", "in", " ", "the", " ", "patch"}]}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ps", ",", "pr", ",", "po"}], "}"}], "=", 
         RowBox[{"ScaleRotationOffset", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "tverts", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}],
              ",", 
             RowBox[{"tverts", "\[LeftDoubleBracket]", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"l", "-", "1"}], ",", 
                RowBox[{"Length", "[", "tverts", "]"}], ",", "1"}], "]"}], 
              "\[RightDoubleBracket]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "sverts", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}],
              ",", 
             RowBox[{"sverts", "\[LeftDoubleBracket]", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"j", "+", "1"}], ",", 
                RowBox[{"Length", "[", "sverts", "]"}], ",", "1"}], "]"}], 
              "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nt", "=", 
         RowBox[{"Length", "[", "patch", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Do", "[", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"for", " ", "each", " ", "tile", " ", "in", " ", "patch"}],
            ",", " ", 
           RowBox[{"compose", " ", 
            RowBox[{
             RowBox[{"scale", "/", "rotation"}], "/", "offset"}]}]}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"tilespec", "=", 
            RowBox[{
            "patch", "\[LeftDoubleBracket]", "it", 
             "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"tiletype", "=", 
            RowBox[{
            "tilespec", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"to", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "tilespec", "]"}], "\[GreaterEqual]", 
               "2"}], ",", 
              RowBox[{
              "tilespec", "\[LeftDoubleBracket]", "2", 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";", 
           RowBox[{"(*", " ", "offset", " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"tr", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "tilespec", "]"}], "\[GreaterEqual]", 
               "3"}], ",", 
              RowBox[{
              "tilespec", "\[LeftDoubleBracket]", "3", 
               "\[RightDoubleBracket]"}], ",", "0"}], "]"}]}], ";", 
           RowBox[{"(*", " ", "rotation", " ", "*)"}], "\[IndentingNewLine]", 
           
           RowBox[{"ts", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "tilespec", "]"}], "\[GreaterEqual]", 
               "4"}], ",", 
              RowBox[{
              "tilespec", "\[LeftDoubleBracket]", "4", 
               "\[RightDoubleBracket]"}], ",", "1"}], "]"}]}], ";", 
           RowBox[{"(*", " ", "scale", " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"patchlist", "\[LeftDoubleBracket]", 
             RowBox[{"ip", ",", "it"}], "\[RightDoubleBracket]"}], "=", 
            RowBox[{"{", 
             RowBox[{"tiletype", ",", 
              RowBox[{"sfn", "[", 
               RowBox[{"po", "+", 
                RowBox[{"ps", " ", 
                 RowBox[{
                  RowBox[{"RotationMatrix2D", "[", "pr", "]"}], ".", 
                  "to"}]}]}], "]"}], ",", 
              RowBox[{"sfn", "[", 
               RowBox[{"pr", "+", "tr"}], "]"}], ",", 
              RowBox[{"sfn", "[", 
               RowBox[{"ps", "*", "ts"}], "]"}]}], "}"}]}]}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"it", ",", "nt"}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
        ",", 
       RowBox[{"{", 
        RowBox[{"ip", ",", "2", ",", "np"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"patchlist", ",", "1"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.631034750824819*^9, 3.63103476126087*^9}, {
   3.631034858827887*^9, 3.631034862874364*^9}, {3.631036244969666*^9, 
   3.631036322661924*^9}, {3.631036383546873*^9, 3.631036493573228*^9}, {
   3.631036536537312*^9, 3.631036573174932*^9}, {3.631036671997282*^9, 
   3.631036712987564*^9}, {3.63103676447742*^9, 3.631036805250806*^9}, {
   3.631036903132307*^9, 3.6310369095183563`*^9}, {3.631036971400878*^9, 
   3.631037008030908*^9}, {3.631037046204473*^9, 3.631037046841998*^9}, {
   3.6310399985945663`*^9, 3.631040265900503*^9}, {3.631040309716841*^9, 
   3.631040549552439*^9}, {3.63104061508543*^9, 3.631040667705559*^9}, {
   3.631041231895493*^9, 3.631041338426189*^9}, {3.631041474454796*^9, 
   3.631041489579344*^9}, {3.63104164200394*^9, 3.6310416714912577`*^9}, {
   3.6310417432394342`*^9, 3.631041928515532*^9}, {3.6310419641213307`*^9, 
   3.6310419818725243`*^9}, {3.631042087754613*^9, 3.631042137792654*^9}, {
   3.631042298996662*^9, 3.631042300555657*^9}, {3.631042359078985*^9, 
   3.631042359507417*^9}, {3.631042417128948*^9, 3.631042420097636*^9}, {
   3.631042658181987*^9, 3.6310427173939743`*^9}, {3.631042756185913*^9, 
   3.631042829203085*^9}, {3.63105510846596*^9, 3.631055133918419*^9}, {
   3.631055169738524*^9, 3.63105517333429*^9}, {3.631055260169986*^9, 
   3.631055311663352*^9}, {3.631055349755517*^9, 3.631055350651276*^9}, {
   3.631055544654067*^9, 3.63105558290989*^9}, {3.6310556509378023`*^9, 
   3.631055654517572*^9}, {3.631055836989748*^9, 3.6310558778830547`*^9}, {
   3.631056315961699*^9, 3.631056328598317*^9}, {3.631056360948197*^9, 
   3.631056377209783*^9}, 3.688166837311376*^9, 3.690989197388595*^9, 
   3.691001617506438*^9, {3.707758224889913*^9, 3.707758226836709*^9}, 
   3.778751179647639*^9},
 CellLabel->
  "In[3318]:=",ExpressionUUID->"e762798a-eeba-4141-baf7-fab2674a466d"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.631035141751813*^9, 3.63103514256643*^9}, 
   3.631056463784348*^9},ExpressionUUID->"075d9ebc-513a-4098-8326-\
471b5c707e69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"patch1", ",", "patch2", ",", "patchinfolist", ",", "tiling"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"patch1", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], "}"}], "}"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"patch2", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "1"}], "}"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], "}"}]}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"patch1", ",", "Tiling", ",", 
             RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
             RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"patch2", ",", "Tiling", ",", 
             RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
             RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}]}], 
         "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"patchinfolist", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"patch1", ",", "Null"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"patch2", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"patch2", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"patch2", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"patch2", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTilingPatches", "[", "patchinfolist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"EmbedTiling", "[", 
        RowBox[{"tiling", ",", "Tiling", ",", 
         RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
         RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
