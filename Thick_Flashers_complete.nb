Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]1", ",", "\[Theta]2", ",", "i1", ",", "i2", ",", "angles", ",", 
