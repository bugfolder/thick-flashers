 Cell[BoxData[
  FormBox[
   RowBox[{"DihedralTypes", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["t", "1"], ",", " ", 
      SubscriptBox["t", "2"], ",", " ", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"1c194eac-e0be-4caf-9a71-2ffad56cce08"],
 " is a TObj property that specifies the dihedral fold types (M, V, or U) \
around a vertex."
}], "Text",
 CellChangeTimes->{{3.592076394786401*^9, 3.592076460301359*^9}, {
   3.592076495066163*^9, 3.592076533643237*^9}, 3.592435752921059*^9, 
