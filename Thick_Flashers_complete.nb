Cell[TextData[{
 "MakeMajorConnectedUnitChain[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "L"], ",", 
     SubscriptBox["w", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "0f69e07b-09aa-4ea7-b6c4-c4126aa956e3"],
 StyleBox["}, opts",
  FontSlant->"Italic"],
 "] takes a list of four sector angles and returns a TLinearChain that is a \
chain of ",
 StyleBox["n+1",
  FontSlant->"Italic"],
 " of these vertices spaced unit distance apart and connected by a chain of \
folds of the same type ",
 StyleBox["type",
  FontSlant->"Italic"],
 " (i.e., major-connected)."
}], "Text",
 CellChangeTimes->{{3.616611903229444*^9, 3.616612211747788*^9}, {
