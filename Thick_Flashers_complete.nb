          RowBox[{"lpq", "-", "lb", "-", "le", "+", "dc"}], ",", 
          RowBox[{"do", "+", "dc"}]}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
         "room", " ", "for", " ", "the", " ", "middle", " ", "knuckle"}], " ",
          "*)"}], "\[IndentingNewLine]", 
        RowBox[{"cyl", "[", 
         RowBox[{
          RowBox[{"lpq", "-", "lb", "-", "le"}], ",", 
          RowBox[{"lpq", "-", "lb"}], ",", 
          RowBox[{"do", "-", "dc"}]}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
         "attachment", " ", "for", " ", "the", " ", "other", " ", "end", " ", 
          "knuckle"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"cyl", "[", 
         RowBox[{
          RowBox[{"lpq", "-", "lb", "-", "dc"}], ",", 
          RowBox[{"lpq", "-", "lb", "+", 
           RowBox[{
           "la", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"do", "+", "dc"}]}], "]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"end", " ", "access"}], ",", " ", 
       RowBox[{
       "stop", " ", "at", " ", "the", " ", "outer", " ", "knuckle"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Create", " ", "cylinders", " ", "for", " ", "the", " ", "knuckles"}], 
