Cell[CellGroupData[{

Cell[TextData[{
 "CutParaboloidalFlasher[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TypeMinimumAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.825870958193788*^9, 3.82587096710484*^9}, {
   3.825874285110148*^9, 3.825874302814999*^9}, 
   3.91183033591574*^9},ExpressionUUID->"402b7fae-53b0-4780-aee5-\
dc7ba7934ec7"],

Cell[TextData[{
 "CutParaboloidalFlasher[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes the output of MakeParaboloidalFlasher and produces a \
TGraph3DAssigned that represents the version whose deployed form has been cut \
so that it can be flattened; so the TGraph part of the object represents a \
cut development of the deployed form."
}], "Text",
 CellChangeTimes->{{3.8258709692971563`*^9, 3.825871061521827*^9}, {
   3.825874309271597*^9, 3.82587431352423*^9}, 3.911830075049823*^9, 
   3.9118303359510717`*^9},ExpressionUUID->"f1e3591b-8734-4d7f-b3e2-\
b0e148d547f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CutParaboloidalFlasher", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobjdp", ",", "r", ",", "h", ",", "m", ",", "f", ",", "verts", ",", 
      "edges", ",", "faces", ",", "ijkmap", ",", "n", ",", "vi", ",", 
      "cutedges", ",", "cutlines", ",", "labels", ",", "cverts", ",", 
      "cedges", ",", "cfaces", ",", "fsverts", ",", "tobjcf"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobjdp", "=", 
      RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r", ",", "h", ",", "m", ",", "f", ",", "verts", ",", "edges", ",", 
        "faces", ",", "ijkmap"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "FlasherR", ",", "FlasherH", ",", "FlasherM", ",", 
          "ParaboloidalFlasherFocalLength", ",", "Vertices", ",", "Edges", ",",
           "Faces", ",", "FlasherIJKMap"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", " ", "=", " ", 
      RowBox[{"r", " ", "h"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Lookup", " ", "function", " ", "for", " ", "vertex", " ", "index", " ",
        "from", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "j", ",", "k"}], "}"}], " ", "indices"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vi", "[", 
       RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "pos", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pos", "=", 
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"First", "/@", "ijkmap"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j", ",", "k"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ListEmptyQ", "[", "pos", "]"}], ",", "0", ",", 
           RowBox[{"ijkmap", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{"pos", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", "2"}], 
            "\[RightDoubleBracket]"}]}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Build", " ", "list", " ", "of", " ", "cut", " ", "edges", " ", "as", " ",
        "index", " ", "pairs"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cutedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", " ", 
      RowBox[{"(*", " ", "bottoms", " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"cutedges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vi", "[", 
               RowBox[{"i", ",", "0", ",", "k"}], "]"}], ",", 
              RowBox[{"vi", "[", 
               RowBox[{
                RowBox[{"i", "+", "1"}], ",", "0", ",", "k"}], "]"}]}], 
             "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", " ", 
        RowBox[{"(*", " ", "diags", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"cutedges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vi", "[", 
               RowBox[{"i", ",", 
                RowBox[{"i", "+", "1"}], ",", "k"}], "]"}], ",", 
              RowBox[{"vi", "[", 
               RowBox[{
                RowBox[{"i", "+", "1"}], ",", 
                RowBox[{"i", "+", "2"}], ",", "k"}], "]"}]}], "}"}]}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"n", "-", "2"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"left", " ", "axials"}], " ", "*)"}], "\[IndentingNewLine]", 
        
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"cutedges", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"vi", "[", 
                 RowBox[{"i", ",", 
                  RowBox[{"h", " ", "l"}], ",", "k"}], "]"}], ",", 
                RowBox[{"vi", "[", 
                 RowBox[{"i", ",", 
                  RowBox[{"Min", "[", 
                   RowBox[{
                    RowBox[{"i", "+", "1"}], ",", 
                    RowBox[{
                    RowBox[{"h", " ", "l"}], "+", "h"}]}], "]"}], ",", "k"}], 
                 "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"h", " ", "l"}], ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "1", ",", 
            RowBox[{"r", "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"right", " ", "axials"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"cutedges", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"vi", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"h", " ", "l"}], "-", "1"}], ",", "j", ",", "k"}], 
                 "]"}], ",", 
                RowBox[{"vi", "[", 
                 RowBox[{
                  RowBox[{"Min", "[", 
                   RowBox[{
                    RowBox[{"j", "-", "1"}], ",", 
                    RowBox[{
                    RowBox[{"h", " ", "l"}], "-", "1", "+", "h"}]}], "]"}], ",",
                   "j", ",", "k"}], "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{
               RowBox[{"h", " ", "l"}], "+", "1"}], ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "1", ",", 
            RowBox[{"r", "-", "1"}]}], "}"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Change", " ", "cutedges", " ", "to", " ", "be", " ", "indices", " ", 
       "into", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cutedges", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"edges", ",", "#"}], "]"}], ",", 
           RowBox[{"Position", "[", 
            RowBox[{"edges", ",", 
             RowBox[{"Reverse", "[", "#", "]"}]}], "]"}]}], "]"}], "&"}], "/@",
         "cutedges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Show", " ", "the", " ", "crease", " ", "pattern", " ", "with", " ", 
       "our", " ", "cut", " ", "lines"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"labels", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"verts", "\[LeftDoubleBracket]", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "2"}], "}"}]}], "]"}], "&"}], "/@", "ijkmap"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"cutlines", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Line", "[", 
         RowBox[{"verts", "\[LeftDoubleBracket]", 
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
          "\[RightDoubleBracket]"}], "]"}], "&"}], "/@", "cutedges"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"cutlines", ",", "Red", ",", 
               RowBox[{"Thickness", "[", ".015", "]"}]}], "]"}], ",", 
             "labels"}], "}"}], "]"}]}], "}"}], "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Cut", " ", "the", " ", "crease", " ", "pattern", " ", "along", " ", 
       "these", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cverts", ",", "cedges", ",", "cfaces"}], "}"}], "=", 
      RowBox[{"SplitEdges", "[", 
       RowBox[{"tobjdp", ",", " ", "cutedges"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Create", " ", "a", " ", "face"}], "-", 
       RowBox[{"shrunken", " ", 
        RowBox[{"version", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fsverts", "=", 
      RowBox[{"FaceShrink", "[", 
       RowBox[{
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "cverts", "\[RightDoubleBracket]"}], 
        ",", "cfaces", ",", 
        RowBox[{"FaceShrinkage", "\[Rule]", "0.2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Debugging", ",", " ", 
       RowBox[{
        RowBox[{"show", " ", "both", " ", "the", " ", "pre"}], "-", 
        RowBox[{"cut", " ", "and", " ", "face"}], "-", 
        RowBox[{"shrunk", " ", "post"}], "-", 
        RowBox[{"cut", " ", "graphs"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GenericGraphGraphics", "[", 
          RowBox[{"verts", ",", "edges", ",", "faces", ",", 
           RowBox[{"VertexLabels", "\[Rule]", "None"}], ",", 
           RowBox[{"EdgeLabels", "\[Rule]", "None"}], ",", 
           RowBox[{"FaceLabels", "\[Rule]", "None"}]}], "]"}], ",", 
         RowBox[{"GenericGraphGraphics", "[", 
          RowBox[{"fsverts", ",", "cedges", ",", "cfaces", ",", 
           RowBox[{"VertexLabels", "\[Rule]", "None"}], ",", 
           RowBox[{"EdgeLabels", "\[Rule]", "None"}], ",", 
           RowBox[{"FaceLabels", "\[Rule]", "None"}]}], "]"}]}], "}"}], "]"}],
       "//", "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
        "Build", " ", "a", " ", "new", " ", "TPlaneGraph", " ", "using", " ", 
         "the", " ", "face"}], "-", 
        RowBox[{
        "shrunk", " ", "vertices", " ", "for", " ", "planarization"}]}], ",", 
       " ", 
       RowBox[{
       "then", " ", "using", " ", "cverts", " ", "as", " ", "a", " ", "key", " ",
         "to", " ", "build", " ", "the", " ", "true", " ", "CP", " ", "and", " ", 
        RowBox[{"DP", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjcf", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MakeTGraph", "[", 
           RowBox[{"fsverts", ",", "cedges"}], "]"}], "//", 
          "AddTPlaneGraph"}], "//", 
         RowBox[{"AddTGraph3D", "[", 
          RowBox[{
           RowBox[{"tobjdp", "[", "Vertices3D", "]"}], "\[LeftDoubleBracket]",
            "cverts", "\[RightDoubleBracket]"}], "]"}]}], "//", 
        "RecalcFoldAngles"}], "//", 
       RowBox[{
        RowBox[{"ReassignGraph3D", "[", 
         RowBox[{"#", ",", "opts"}], "]"}], "&"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"FoldedFormGraphics3D", "[", "tobjcf", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjcf", "=", 
      RowBox[{"tobjcf", "//", "UnfoldGraph3D"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"CreasePatternGraphics", "[", "tobjcf", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", "tobjcf"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.825874320538027*^9, 3.825874638298946*^9}, {
   3.825875926785651*^9, 3.825875931394979*^9}, 3.825875985647072*^9, 
   3.911830335973259*^9, 3.91257417062761*^9, 3.913480752144937*^9},
 CellLabel->
  "In[4206]:=",ExpressionUUID->"28f8a6d4-e823-430d-93ad-6a57cb597170"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.82587465301071*^9, 
  3.8258746539774528`*^9}},ExpressionUUID->"413d197f-d8c3-4d82-a3eb-\
d09a321c62ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "2"}], ",", 
      RowBox[{"m", "=", "5"}], ",", 
      RowBox[{"f", "=", "3"}], ",", 
      RowBox[{"dr", "=", ".10"}], ",", "tobj", ",", "tobjdp", ",", "tobjcf"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeParaboloidalFlasher", "[", 
       RowBox[{"r", ",", "h", ",", "m", ",", "f", ",", "dr", ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"20.", "\[Degree]"}]}], ",", 
        RowBox[{
        "FlasherSectorDiagFoldLines", "\[Rule]", 
         "FlasherSectorDiagFoldLinesZ"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjdp", "=", 
      RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Show", " ", "all", " ", "three", " ", "versions"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Build", " ", "the", " ", "cut", " ", "version"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobjcf", "=", 
      RowBox[{"CutParaboloidalFlasher", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", "\[Pi]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Show", " ", "the", " ", "crease", " ", "pattern", " ", "and", " ", 
       "deployed", " ", "form", " ", "of", " ", "the", " ", "cut", " ", 
       "version"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobjcf", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobjcf", "]"}]}], "}"}], "/.", 
       
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.825874724271758*^9, 3.825874785881166*^9}, {
   3.825875786989766*^9, 3.825875899603425*^9}, {3.82587607242769*^9, 
   3.825876084980633*^9}, 3.9118300750657473`*^9, 3.911830335980278*^9},
 CellLabel->
  "In[4207]:=",ExpressionUUID->"bc54bf79-1fda-42e0-b6c3-acae70f642d0"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Laser scoring", "Section",
 CellChangeTimes->{{3.624889449436005*^9, 3.6248894517755632`*^9}, {
  3.627837541017604*^9, 
  3.627837541785671*^9}},ExpressionUUID->"3484daed-bf46-48ca-85d5-\
302bd8bab119"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.6295038351105003`*^9, 
  3.629503835578328*^9}},ExpressionUUID->"c6693b55-0afb-4231-85cb-\
aa5cab58fc87"],

Cell["\<\
These functions support various forms of laser-scoring. The simplest form of \
output for laser scoring is to export the Graphics object while applying \
ScoringStyle[]. This will produce single linear cuts for all fold lines and \
the border, in different colors, so that one can set different power levels.\
\>", "Text",
 CellChangeTimes->{{3.62950384691511*^9, 3.629503878143572*^9}, {
  3.6295039097181587`*^9, 
  3.629503976945857*^9}},ExpressionUUID->"3a463146-9311-4eaf-bec0-\
fc52b13a820c"],

Cell[TextData[{
 "Note that we must add the option PlotRangePadding\[Rule]0 to Graphics \
objects when we export them so that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " doesn\[CloseCurlyQuote]t add an additional border and down-size the image \
from the specified dimensions."
}], "Text",
 CellChangeTimes->{{3.629503779745983*^9, 
  3.629503823564649*^9}},ExpressionUUID->"f4489bbf-9164-43dc-a9c0-\
552c7ccae666"]
}, Closed]],

Cell[CellGroupData[{

Cell["Perforated scoring", "Subsection",
 CellChangeTimes->{{3.627837551025977*^9, 
  3.627837553962226*^9}},ExpressionUUID->"e99edff0-0650-4ebf-a13c-\
233171724325"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.627837571450399*^9, 
  3.627837573695231*^9}},ExpressionUUID->"398fb7f2-9564-4f66-b50e-\
0a464069ec70"],

Cell["\<\
One can laser-score patterns in two ways: you can partially ablate fold lines \
to weaken the paper along the folds, but that requires very good control over \
power and uniformity. A more forgiving technique is to perforate fold lines. \
Since the perforation punches all the way through the paper, it\
\[CloseCurlyQuote]s relatively less sensitive to variation in power level. \
When we perforate a pattern, though, there are a few tweaks we\
\[CloseCurlyQuote]d like to make:
\t(1) Leave gaps at the ends of lines, to avoid holes precisely at vertices \
(which creates tear nucleation sites)
\t(2) Vary the dashing pattern of perforation, depending on the materials.
Because different laser cutters provide varying level of support for precise \
perforations, our strategy is to preprocess all of the perforation, \
fracturing lines into many tiny segments to create the perforation.\
\>", "Text",
 CellChangeTimes->{{3.627837588740378*^9, 3.627837594359657*^9}, {
  3.627837657557241*^9, 
  3.627837924103861*^9}},ExpressionUUID->"8108e36b-8f36-4cf5-8075-\
a4df661a13fc"],

Cell["\<\
The function in this section takes a TGraph+TAssigned, representing a styled \
crease pattern, and exports a scaled perforated pattern that can be imported \
into the program that drives the laser cutter (e.g., Corel Draw).\
\>", "Text",
 CellChangeTimes->{{3.627837926757777*^9, 
  3.6278379652387457`*^9}},ExpressionUUID->"e958f545-6009-4676-987a-\
adba46ac194b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ExportPerforatedScoring[",
 StyleBox["file",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph, TAssigned\n\t(options) ImageWidth, \
ImageHeight, GapLength, DashPattern, ScoreLineThickness, ShowProgress"
}], "Subsubsection",
 CellChangeTimes->{{3.627827531761579*^9, 3.627827595298505*^9}, {
  3.6278276294646883`*^9, 3.627827649679399*^9}, {3.627827696670765*^9, 
  3.627827720066435*^9}, {3.6278283082686853`*^9, 3.627828311244701*^9}, {
  3.627828345538309*^9, 3.6278283913429832`*^9}, {3.6278284215654387`*^9, 
  3.6278284378761997`*^9}, {3.627829448706909*^9, 3.627829450218857*^9}, {
  3.627829504695307*^9, 
  3.627829511646954*^9}},ExpressionUUID->"185ab086-fd26-47e1-ae86-\
fc9a9e6f4bd4"],

Cell[TextData[{
 "ExportPerforatedScoring[",
 StyleBox["file",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph+TAssigned and exports a perforated scoring pattern of the \
crease pattern  of size ",
 StyleBox["imagesize",
  FontSlant->"Italic"],
 " to  ",
 StyleBox["file",
  FontSlant->"Italic"],
 " (typically EPS). Options are as follows (all distances in points):\n\t\
ImageWidth \[Rule] ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the desired image width.\n\tImageHeight \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["h",
  FontSlant->"Italic"],
 " is the desired image height. You must supply either width or height (if \
you specify both, ImageWidth wins out).\n\tGapLength \[Rule] ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", length of gaps to leave at ends of peforated lines. See Gapify.\n\t\
DashPattern \[Rule] ",
 StyleBox["pat",
  FontSlant->"Italic"],
 ", the dashing pattern to use for perforation. See Dashify.\n\t\
ScoreLineThickness \[Rule] ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", the desired thickness to use for scoring lines.\n\tShowProgress \[Rule] \
True | False, whether to display detailed size and the perforated image."
}], "Text",
 CellChangeTimes->{{3.627828324303227*^9, 3.627828429605271*^9}, {
  3.627828492202003*^9, 3.627828523494644*^9}, {3.627829162143865*^9, 
  3.62782929296478*^9}, {3.627829383464513*^9, 3.6278293858150887`*^9}, {
  3.627829433003776*^9, 3.627829559675803*^9}, {3.627829700711156*^9, 
  3.627829738184127*^9}, {3.627830525733927*^9, 
  3.627830533076626*^9}},ExpressionUUID->"47e60400-5010-4839-b797-\
31b13d98e877"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ImageWidth", "::", "usage"}], 
   "=", "\"\<ImageWidth is an option to ExportPerforatedScoring that \
specifies the desired width of the score pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627834333455987*^9, 3.627834361790799*^9}},
 CellLabel->
  "In[4208]:=",ExpressionUUID->"e7778ba7-48e2-4da7-82f5-1ea3e62c8f8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ImageHeight", "::", "usage"}], 
   "=", "\"\<ImageHeight is an option to ExportPerforatedScoring that \
specifies the desired height of the score pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627834333455987*^9, 3.62783437933404*^9}},
 CellLabel->
  "In[4209]:=",ExpressionUUID->"ea5cdeb4-6e3e-4af5-927c-cab47c8d48f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ExportPerforatedScoring", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ImageWidth", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ImageHeight", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"GapLength", "\[Rule]", "1.5"}], ",", "\[IndentingNewLine]", 
     RowBox[{"DashPattern", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1.7", ",", "False"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.3", ",", "True"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ScoreLineThickness", "\[Rule]", "0.216"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.627829397835539*^9, 3.627829427437945*^9}, {
  3.627829573780819*^9, 3.62782961551363*^9}, {3.627829751227363*^9, 
  3.62782979989964*^9}, {3.6278305039537153`*^9, 3.627830504729188*^9}, {
  3.627834892686502*^9, 3.62783489313521*^9}},
 CellLabel->
  "In[4210]:=",ExpressionUUID->"be4582ff-9daf-422f-a5c4-d6239ff0611b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExportPerforatedScoring", "::", "badsize"}], 
   "=", "\"\<You must specify either ImageWidth or ImageHeight.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.627830506760784*^9, 3.62783052012681*^9}},
 CellLabel->
  "In[4211]:=",ExpressionUUID->"ba918c60-91c3-46ed-86d7-8d44b2e6e433"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExportPerforatedScoring", "[", 
   RowBox[{"file_String", ",", " ", "tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "iw", ",", "ih", ",", "gl", ",", "dp", ",", "sp", ",", "slt", ",", "cp", 
      ",", "scale", ",", "w", ",", "h", ",", "g"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph", ",", "TAssigned"}], "}"}], ",", 
       "ExportPerforatedScoring"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"iw", "=", 
      RowBox[{
       RowBox[{"ImageWidth", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportPerforatedScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ih", "=", 
      RowBox[{
       RowBox[{"ImageHeight", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportPerforatedScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gl", "=", 
      RowBox[{
       RowBox[{"GapLength", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportPerforatedScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dp", "=", 
      RowBox[{
       RowBox[{"DashPattern", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportPerforatedScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportPerforatedScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"slt", "=", 
      RowBox[{
       RowBox[{"ScoreLineThickness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportPerforatedScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"w", ",", "h"}], "}"}], "=", 
      RowBox[{"GraphicsExtent", "[", "cp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{"iw", "===", "None"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"scale", "=", 
         RowBox[{"iw", "/", "w"}]}], ";", 
        RowBox[{"ih", "=", 
         RowBox[{"scale", " ", "h"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{"ih", "===", "None"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"scale", "=", 
           RowBox[{"ih", "/", "h"}]}], ";", 
          RowBox[{"iw", "=", 
           RowBox[{"scale", " ", "w"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{"ExportPerforatedScoring", "::", "badsize"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"ScaleLines", "[", 
       RowBox[{"cp", ",", "scale"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<width = \>\"", ",", "iw", ",", "\"\< pt, \>\"", ",", 
          " ", 
          RowBox[{"iw", "/", "28.35"}], ",", "\"\< cm, \>\"", ",", 
          RowBox[{"iw", "/", "72."}], ",", "\"\< in\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<height = \>\"", ",", "ih", ",", "\"\< pt, \>\"", ",", 
          RowBox[{"ih", "/", "28.35"}], ",", "\"\< cm, \>\"", ",", 
          RowBox[{"ih", "/", "72."}], ",", "\"\< in\>\""}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"ExtractFracturedStyledLines", "[", "cp", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{"GapifyByStyle", "[", 
       RowBox[{"g", ",", 
        RowBox[{"{", 
         RowBox[{"ValleyLine", ",", "MountainLine"}], "}"}], ",", 
        RowBox[{"GapLength", "\[Rule]", "gl"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{"DashifyByStyle", "[", 
       RowBox[{"g", ",", 
        RowBox[{"{", 
         RowBox[{"ValleyLine", ",", "MountainLine"}], "}"}], ",", 
        RowBox[{"DashPattern", "\[Rule]", "dp"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"g", "/.", 
            RowBox[{"ScoringStyle", "[", 
             RowBox[{"ScoreLineThickness", "\[Rule]", "1"}], "]"}]}], ",", 
           RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"file", ",", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"g", "/.", 
          RowBox[{"ScoringStyle", "[", 
           RowBox[{"ScoreLineThickness", "\[Rule]", "slt"}], "]"}]}], ",", 
         RowBox[{"PlotRangePadding", "\[Rule]", "0"}]}], "]"}], ",", 
       RowBox[{"ImageSize", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"iw", ",", " ", "ih"}], "}"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627829302202251*^9, 3.627829348534548*^9}, {
   3.62783018717409*^9, 3.627830252740117*^9}, {3.627830288169832*^9, 
   3.627830494564334*^9}, {3.62783057026442*^9, 3.6278308195631647`*^9}, {
   3.627834804258217*^9, 3.627834842824545*^9}, {3.627834909422001*^9, 
   3.627834915394007*^9}, {3.627834966489361*^9, 3.62783497102833*^9}, {
   3.627835006354051*^9, 3.62783501794062*^9}, {3.627835138487713*^9, 
   3.627835139909086*^9}, {3.627835174972375*^9, 3.627835180435258*^9}, {
   3.627835212841934*^9, 3.627835245016876*^9}, {3.627835553078155*^9, 
   3.627835617012889*^9}, {3.627836373228938*^9, 3.62783638415266*^9}, {
   3.627836826709996*^9, 3.62783685622855*^9}, 3.627836934640313*^9, {
   3.627837262850489*^9, 3.627837310354349*^9}, 3.627837384581345*^9, 
   3.627837466556538*^9, 3.627905378944946*^9, 3.628786495366074*^9, 
   3.628786571743384*^9, {3.629503425784358*^9, 3.629503434102551*^9}},
 CellLabel->
  "In[4212]:=",ExpressionUUID->"160a5a9b-dec9-4c39-b67d-6841f6fd123e"],

Cell["\<\
Example. Show progress, displaying the dimensions and perforated image.\
\>", "Text",
 CellChangeTimes->{{3.627834390781461*^9, 3.627834391612007*^9}, {
  3.62783797851737*^9, 
  3.627837987892795*^9}},ExpressionUUID->"db94797a-0626-4062-b4b4-\
413f74a89404"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "faces", ",", "types", ",", "tobj"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "8"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "6", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "7", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4", ",", "8", ",", "7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", 
        "M", ",", "V", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraphAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", "faces", ",", "types"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ExportPerforatedScoring", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ExamplesDir", "[", "]"}], 
        "<>", "\"\<ExportPerforatedScoring.eps\>\""}], ",", "tobj", ",", 
       RowBox[{"ImageHeight", "\[Rule]", "72"}], " ", 
