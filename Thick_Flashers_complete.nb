Cell[TextData[{
 "TwoColorableGraphQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.484778985223304*^9, 3.484778991982451*^9}, {
   3.484779257581377*^9, 3.484779270012064*^9}, {3.484781952620837*^9, 
