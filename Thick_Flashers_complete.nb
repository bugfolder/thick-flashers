Cell[BoxData[
 RowBox[{
  RowBox[{"StyledCrossRuledPatch", "[", 
   RowBox[{
    RowBox[{"ss_Function", "|", "s_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", "v1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nu", ",", "cld", ",", "cls", ",", "du", ",", "dv"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nu", "=", 
      RowBox[{
       RowBox[{"CurveDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCrossRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cld", "=", 
      RowBox[{
       RowBox[{"CrossLineDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCrossRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cls", "=", 
      RowBox[{
       RowBox[{"CrossLineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCrossRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"du", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u1", "-", "u0"}], ")"}], "/", "nu"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "v0", "]"}], "===", "Function"}], "||", 
        RowBox[{
         RowBox[{"Head", "[", "v0", "]"}], "===", "InterpolatingFunction"}], "||", 
        RowBox[{
         RowBox[{"Head", "[", "v1", "]"}], "===", "Function"}], "||", 
        RowBox[{
         RowBox[{"Head", "[", "v1", "]"}], "===", "InterpolatingFunction"}]}],
        ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"StyledCrossRuledPatch", "::", "badv"}], ",", 
          RowBox[{"{", 
           RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dv", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v1", "-", "v0"}], ")"}], "/", "cld"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"StyledRuledPatch", "[", 
        RowBox[{"ss", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v0", ",", "v1"}], "}"}], ",", "opts"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"ss", "[", 
               RowBox[{"u", ",", "v"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u", ",", "u0", ",", "u1", ",", "du"}], "}"}]}], "]"}],
             "]"}], ",", "cls"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "v0", ",", "v1", ",", "dv"}], "}"}]}], "]"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.689466591399076*^9, 3.689466627923038*^9}, {
   3.689466794961776*^9, 3.689466868998724*^9}, {3.68955289318596*^9, 
