   3.692205668344729*^9}, {3.692205713622656*^9, 3.6922057361003933`*^9}, {
   3.692211817407569*^9, 3.692211907766015*^9}, {3.69228105769844*^9, 
   3.692281058853411*^9}, {3.692281365696269*^9, 3.692281373304077*^9}, {
   3.692281500279435*^9, 3.692281504168992*^9}, {3.692286142207421*^9, 
   3.692286158951252*^9}, {3.692286204740551*^9, 3.692286242805126*^9}, 
   3.694009564878962*^9, {3.694012071806134*^9, 3.694012109028234*^9}, {
