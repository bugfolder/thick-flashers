Cell[CellGroupData[{

Cell[TextData[{
 "FlasherOuterRingFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dz",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.7199264957907143`*^9, 3.719926498558271*^9}, {
  3.71993430347626*^9, 3.719934303628301*^9}, {3.911879914029564*^9, 
  3.911879935367988*^9}},ExpressionUUID->"873ca0ab-588d-41da-9a9e-\
65c4b5a02a3a"],

Cell[TextData[{
 "FlasherOuterRingFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["soln",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dz",
  FontSlant->"Italic"],
 "] returns a set of functions that pins the ",
 StyleBox["z",
  FontSlant->"Italic"],
 "-values of the outer ring vertices to the values from the default solution \
times the quantity (1+",
 StyleBox["dz",
  FontSlant->"Italic"],
 "), which lets you nudge the outer ring to be taller or shorter than the \
default value."
}], "Text",
 CellChangeTimes->{{3.555838449551999*^9, 3.5558385618964443`*^9}, {
   3.555839183591411*^9, 3.5558391998224077`*^9}, {3.55584259345015*^9, 
   3.555842635004098*^9}, 3.55585432022409*^9, 3.55585435676064*^9, {
   3.564329366982036*^9, 3.564329371835703*^9}, 3.719869806271595*^9, {
   3.719869850566351*^9, 3.719869851158022*^9}, 3.719925980279303*^9, {
   3.825679394087544*^9, 3.8256793954876223`*^9}, 3.911879914072459*^9, {
   3.911879994656519*^9, 3.911879996064758*^9}, {3.922657035785947*^9, 
   3.922657036999267*^9}},ExpressionUUID->"6ee25a3f-7594-4eeb-b570-\
cade8ab58ffa"],

Cell["\<\
This is analogous to the most successful rule set used in my initial \
analysis. A nice aspect of it is that it always perfectly balances the number \
of degrees of freedom.\
\>", "Text",
 CellChangeTimes->{
  3.911879998966926*^9},ExpressionUUID->"5c03444d-7b98-4d63-b7e8-\
21a56e603629"],

Cell["\<\
Note that since this only affects the z coordinates, it doesn\
\[CloseCurlyQuote]t depend on the value of dr.\
\>", "Text",
 CellChangeTimes->{{3.91188001246644*^9, 
  3.911880058446963*^9}},ExpressionUUID->"2b53c775-beb0-4745-bb9d-\
cef89533a37c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherOuterRingFns", "[", 
   RowBox[{"vars_", ",", "r_", ",", "h_", ",", "m_", ",", 
    RowBox[{"dz_", ":", "0"}]}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "verts", ",", "ffrules"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"FlasherOuterRingSectorVertices", "[", 
       RowBox[{"pp", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ffrules", "=", 
      RowBox[{"FlasherDefaultFFRules", "[", 
       RowBox[{"pp", ",", "h", ",", "m", ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Last", "/@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"FlasherScalarize", "[", 
         RowBox[{"vars", ",", "verts", ",", "m"}], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "dz"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"verts", "/.", "ffrules"}], ")"}]}]}], ")"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.555838575573948*^9, 3.555838727962781*^9}, {
   3.555838759996403*^9, 3.5558387952460318`*^9}, {3.555838840075305*^9, 
