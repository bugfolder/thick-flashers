Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "f", ",", "rL", ",", "rR", ",", "\[Gamma]", ",", "\[Gamma]0", ",",
       "as", ",", "u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rL", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "#", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{
       RowBox[{"\[Gamma]0", " ", "#"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]0", ">", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "rL", ",", "rR"}], "}"}], "=", 
      RowBox[{"FoldAcrossRight2D", "[", 
       RowBox[{"f", ",", "rL", ",", "\[Gamma]", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<rR[t] = \>\"", ",", 
       RowBox[{"rR", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0.001", ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]0", "=", 
      RowBox[{"1", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CurvedFoldGraphics", "[", 
       RowBox[{"f", ",", "rL", ",", "rR", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
