   3.6868474526657333`*^9}},ExpressionUUID->"a4465d0e-bcfd-412f-9c20-\
ed8d76e422db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleNormal3D", "[", 
   RowBox[{"p_", ",", "q_", ",", "r_"}], "]"}], ":=", 
  RowBox[{"NormalizeReal", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"q", "-", "p"}], ")"}], "\[Cross]", 
    RowBox[{"(", 
     RowBox[{"r", "-", "p"}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.649960001488458*^9, 3.649960062629581*^9}, 
   3.649960374944026*^9, {3.686847471123386*^9, 3.686847520545198*^9}, 
