Cell[TextData[{
 "GenericFoldedFormLines[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a list of Graphics elements that \
shows the folded form using the symbolic styles (apply rule set OrigamiStyle \
or equivalent to render)."
}], "Text",
 CellChangeTimes->{{3.457626491906258*^9, 3.4576264987674527`*^9}, {
   3.457634207546055*^9, 3.457634230367691*^9}, 3.457733400008393*^9, {
   3.45789456933185*^9, 3.457894660019393*^9}, {3.484782169632646*^9, 
   3.484782187956321*^9}, {3.591803642315019*^9, 3.5918036974059258`*^9}, 
   3.5921799052242312`*^9, 3.59220798284188*^9, {3.592405941059786*^9, 
   3.5924059424503508`*^9}, {3.5924282064345207`*^9, 3.592428217990209*^9}, 
   3.592433562715253*^9, {3.59282888978974*^9, 3.59282888988978*^9}, 
   3.59287129188559*^9, {3.594732278939805*^9, 3.594732293769552*^9}, 
   3.594733035693559*^9, 3.594734935080398*^9, 3.594736281438233*^9, 
   3.595200633054712*^9, 
   3.693872225688181*^9},ExpressionUUID->"a0fe15d7-ccb6-4fc1-a98d-\
fb263ab4f0c6"],

Cell["\<\
Note that this function uses type Hidden*Line uniformly to represent all fold \
lines whether visible or hidden. In general this will not be correct, and \
tessellation functions will have to create their own line generation to take \
into account hidden lines. Although, as we will see, we have some good \
heuristic algorithms for the general case and some special cases (e.g., \
twists).\
\>", "Text",
 CellChangeTimes->{{3.5918037065233917`*^9, 3.591803716835854*^9}, {
   3.5924059576247783`*^9, 3.5924060227575274`*^9}, 3.628948526669292*^9, 
   3.628956486019058*^9},ExpressionUUID->"c5653b6e-29b8-43e7-a098-\
f4904b5f8227"],

Cell["See also VisibleFoldedFormGraphics below.", "Text",
 CellChangeTimes->{{3.593018683370138*^9, 3.593018692112103*^9}, 
   3.594735275106284*^9, 
   3.5952007134182777`*^9},ExpressionUUID->"c2e51465-a14e-4a59-a293-\
abf7abc43973"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GenericFoldedFormLines", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts2d", ",", "edges", ",", "types"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", "edges", ",", "types"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices2D", ",", "Edges", ",", "EdgeTypes"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MapThread", "[", 
       RowBox[{"Style", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Line", "/@", 
           RowBox[{"Embed", "[", 
            RowBox[{"verts2d", ",", "edges"}], "]"}]}], ",", "types"}], 
         "}"}]}], "]"}], "/.", "TypeToGenericFoldedFormStyleRules"}]}]}], 
   "]"}]}]], "Input",
