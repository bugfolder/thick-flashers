   3.555953006534617*^9, 3.555953025477289*^9}, {3.555953212137144*^9, 
   3.555953213486215*^9}, {3.55595324942822*^9, 3.555953249653328*^9}, 
   3.555953297081149*^9, 3.719931029040756*^9, {3.719938702046335*^9, 
