Cell[TextData[{
 "MakeAlternatingMajorConnectedUnitChain[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "L"], ",", 
     SubscriptBox["w", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "f30b102b-7e37-433c-8ac3-5bbf99a4b452"],
 StyleBox["}, opts",
  FontSlant->"Italic"],
 "] takes a list of four sector angles and returns a TLinearChain that is a \
chain of ",
 StyleBox["n+1",
  FontSlant->"Italic"],
 " of these vertices spaced unit distance apart and connected along their ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "a917d854-6495-49b1-ac65-d88d30e0327b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "3"], TraditionalForm]],ExpressionUUID->
  "1c0a5a8b-4f78-4d1c-939d-1cde2c8e86a1"],
 " folds, assumed to be major-connected so that the creases are the same type \
along the spine, which is ",
 StyleBox["type",
  FontSlant->"Italic"],
 ". We alternate the orientation of consecutive vertices, so that the \
resulting crease pattern is always periodic."
}], "Text",
 CellChangeTimes->{{3.616611903229444*^9, 3.616612211747788*^9}, {
   3.616612260080491*^9, 3.616612300434742*^9}, {3.616622565371917*^9, 
