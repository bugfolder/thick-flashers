Cell[CellGroupData[{

Cell["Manipulable flat-foldable vertex", "Subsubsection",
 CellChangeTimes->{{3.628784945785527*^9, 3.628784946599238*^9}, {
  3.636737693890946*^9, 
  3.636737699860756*^9}},ExpressionUUID->"47ef2c72-7998-446e-b500-\
409072cb3275"],

Cell["Here\[CloseCurlyQuote]s a manipulable 3D vertex that is \
flat-foldable.", "Text",
 CellChangeTimes->{{3.59766653011241*^9, 3.59766654959671*^9}, {
  3.597671076165353*^9, 
  3.5976710980329943`*^9}},ExpressionUUID->"b49fa533-b63d-40cd-9c9e-\
6c238753dc64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj", ",", "vp", ",", "rs", ",", "gs"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vp", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1000"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"MakeTDegree4Vertex3DFromSectorsAndMinorDihedral", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"120", "\[Degree]"}], ",", 
            RowBox[{"90", "\[Degree]"}], ",", 
            RowBox[{"60", "\[Degree]"}], ",", 
            RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
          RowBox[{"g1", " ", "\[Degree]"}], ",", " ", 
          RowBox[{"OsculatingVectorNear", "\[Rule]", "vp"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rs", "=", 
        RowBox[{
         RowBox[{"Vertex3DFoldedFormGraphics3D", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"ViewPoint", "\[Rule]", "vp"}]}], "]"}], "/.", 
         RowBox[{"Vertex3DStyle", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"gs", "=", 
        RowBox[{
         RowBox[{"Vertex3DGaussianSphereGraphics3D", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"DihedralAngleLabels", "\[Rule]", "None"}], ",", 
           RowBox[{"ShowMidfoldVectors", "\[Rule]", "True"}], ",", 
           RowBox[{"ViewPoint", "\[Rule]", "vp"}]}], "]"}], "/.", 
         RowBox[{"Vertex3DStyle", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", 
         RowBox[{"rs", ",", "gs"}], "}"}], "]"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"g1", ",", "0.1", ",", "179.9"}], "}"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.597666067110077*^9, 3.597666286100053*^9}, {
   3.597666372603862*^9, 3.597666377003833*^9}, {3.597666424468584*^9, 
   3.597666424624213*^9}, {3.597666468993209*^9, 3.597666469087944*^9}, {
