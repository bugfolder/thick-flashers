Cell[CellGroupData[{

Cell[TextData[{
 "FlasherDefaultFFRules[",
 StyleBox["pp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.719856920600662*^9, 3.719856924329483*^9}, 
   3.719936134162424*^9},ExpressionUUID->"8cfeda57-c71c-436b-a6f1-\
03b27abc1de7"],

Cell[TextData[{
 "FlasherDefaultFFRules[",
 StyleBox["pp, h, m, dr",
  FontSlant->"Italic"],
 "] returns a set of rules giving 3-dimensional coordinates for the points of \
the folded form for height order ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", rotational order ",
 StyleBox["m,",
  FontSlant->"Italic"],
 " with ",
 StyleBox["dr",
  FontSlant->"Italic"],
 " being the radial spacing of the concentric layers within a given \
horizontal plane relative to the radial distance of the innermost vertex \
(central polygon). This is an idealized structure, and in general will not be \
isometric to a flat crease pattern. But we\[CloseCurlyQuote]ll use it as a \
starting point when we solve for the crease pattern."
}], "Text",
 CellChangeTimes->{{3.555765854618403*^9, 3.555765904317943*^9}, {
   3.555765942659822*^9, 3.555765949659213*^9}, {3.5557663958455553`*^9, 
   3.555766412827883*^9}, {3.5557667541835623`*^9, 3.555766759374092*^9}, {
   3.555766796723678*^9, 3.555766811530325*^9}, {3.5557673005706997`*^9, 
   3.555767300977767*^9}, {3.555854313152871*^9, 3.555854313273855*^9}, 
   3.71985689693543*^9, {3.719856928873528*^9, 3.719856934344864*^9}, 
   3.719936134260705*^9},ExpressionUUID->"e68858fe-ca16-4b7a-aef1-\
96181b4a50e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherDefaultFFRules", "[", 
   RowBox[{"pp_", ",", "h_", ",", "m_", ",", 
    RowBox[{"dr_", ":", ".1"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["pp", 
     RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"FlasherRotation3D", "[", 
       RowBox[{
        RowBox[{"k", "+", 
         RowBox[{"FlasherFFPointRotation", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}], ",", "m"}], "]"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tan", "[", 
         FractionBox["\[Pi]", "m"], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"dr", " ", 
              RowBox[{
               RowBox[{"FlasherFFPointRadialOffset", "[", 
                RowBox[{"i", ",", "j"}], "]"}], "/", "h"}]}]}], ")"}], 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cot", "[", 
              FractionBox["\[Pi]", "m"], "]"}], ",", "1", ",", "0"}], "}"}]}],
           "+", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", " ", 
            RowBox[{
             RowBox[{"FlasherFFPointDiscreteHeight", "[", 
              RowBox[{"i", ",", "j", ",", "h"}], "]"}], 
             RowBox[{"Tan", "[", 
              FractionBox["\[Pi]", "m"], "]"}]}]}], "}"}]}], ")"}]}], ")"}]}],
      "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.555765796889297*^9, 3.5557658148851*^9}, {
   3.55576593656566*^9, 3.555765937269701*^9}, {3.555765980759676*^9, 
   3.555765998532903*^9}, 3.55576610831581*^9, {3.555766224314859*^9, 
   3.555766241929373*^9}, {3.555766281377778*^9, 3.555766290518588*^9}, {
   3.555766325398485*^9, 3.555766374931508*^9}, 3.555766519493807*^9, 
   3.555766556615101*^9, 3.55576659184709*^9, 3.555766625476776*^9, 
   3.555766665562224*^9, {3.555766764106739*^9, 3.555766765817194*^9}, {
   3.555776425145282*^9, 3.555776426303939*^9}, 3.55577662379895*^9, {
   3.555850281467123*^9, 3.555850282777381*^9}, {3.555854313345834*^9, 
   3.555854313473244*^9}, 3.719856896946647*^9, {3.7198569453152723`*^9, 
   3.71985695028816*^9}, {3.719918658143127*^9, 3.719918683838968*^9}, 
   3.7199187334514637`*^9, 3.7199361342697163`*^9, 3.719943299356538*^9, 
