Cell[CellGroupData[{

Cell[TextData[{
 "HatVertexFlatFoldabilityConditions2D[",
 StyleBox["sectorhats",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HatExcess, HatMatrixSplit"
}], "Subsubsection",
 CellChangeTimes->{{3.595704468704026*^9, 3.595704486671072*^9}, {
   3.595704517220508*^9, 3.595704518744132*^9}, 3.595705204239098*^9, 
   3.596023082295052*^9, {3.596023547222632*^9, 3.596023547646824*^9}, {
   3.596031060603712*^9, 
   3.596031066721307*^9}},ExpressionUUID->"8310ec88-f8d7-472e-9902-\
ea3fc00ce691"],

Cell[TextData[{
 "HatVertexFlatFoldabilityConditions2D[",
 StyleBox["sectorhats",
  FontSlant->"Italic"],
 "] returns the 2x2 matrix whose entries must be zero in order for the \
alternating sum of the sector angles around the vertex to be 2\[Pi]",
 StyleBox["n",
  FontSlant->"Italic"],
 " for some integer ",
 StyleBox["n",
  FontSlant->"Italic"],
 " or 2\[Pi]",
 StyleBox["n",
  FontSlant->"Italic"],
 "+ArcHat[",
 StyleBox["excess",
  FontSlant->"Italic"],
 "] if you provide a nonzero value for HatExcess. Options are:\n\tHatExcess \
\[Rule] ",
 StyleBox["excess",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["excess",
  FontSlant->"Italic"],
 " is the hat transformation of the excess angle, or 0 for a developable \
vertex.\n\tHatMatrixSplit \[Rule] Automatic | None | ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where n is the number of matrices on the left and the remainder are on \
the right. None puts all of the numerators on the left. Automatic splits them \
as evenly as possible between left and right. In either case, denominators \
are cleared from either side so that each entry is a polynomial."
}], "Text",
 CellChangeTimes->{{3.595611934877542*^9, 3.595611964333376*^9}, {
   3.595612011691249*^9, 3.595612082429765*^9}, {3.595612112636605*^9, 
   3.595612138642123*^9}, 3.59561260392588*^9, {3.595700505096412*^9, 
   3.595700564614696*^9}, {3.595700833881599*^9, 3.595700850199109*^9}, {
   3.595702165387916*^9, 3.595702166266199*^9}, 3.5957022075537148`*^9, {
   3.595704532909668*^9, 3.595704558930636*^9}, 3.595705204435515*^9, 
   3.596023581567647*^9, {3.596031057733855*^9, 
   3.596031127422538*^9}},ExpressionUUID->"6bb4100c-ad24-407f-a58f-\
846c987261ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatVertexFlatFoldabilityConditions2D", "[", 
   RowBox[{
    StyleBox[
     RowBox[{
      StyleBox["sectorhats_",
       FontSlant->"Italic"], "List"}]], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "shats", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"shats", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OddQ", "[", "i", "]"}], ",", 
          RowBox[{
          "sectorhats", "\[LeftDoubleBracket]", "i", 
           "\[RightDoubleBracket]"}], ",", 
          RowBox[{"-", 
           RowBox[{
           "sectorhats", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "sectorhats", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"HatRotationConditions2D", "[", 
      RowBox[{"shats", ",", "opts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595612141092373*^9, 3.595612305947384*^9}, {
   3.59561235540265*^9, 3.595612355904353*^9}, {3.5956123945569077`*^9, 
   3.595612434394558*^9}, {3.595612468050631*^9, 3.59561246836974*^9}, 
