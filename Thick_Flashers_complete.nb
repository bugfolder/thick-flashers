 RowBox[{
  RowBox[{
   RowBox[{"BorderOverride", "::", "usage"}], 
   "=", "\"\<BorderOverride is an option to CreasePatternToPlaneGraphAssigned \
that overrides any fold line assignments on the border lines, setting them to \
B.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591809415890162*^9, 3.591809470249457*^9}, 
