   3.485093515302033*^9, 3.485093529434548*^9}, 3.485093569777441*^9, {
   3.485096457052559*^9, 3.485096488469287*^9}, 3.534555179646114*^9, {
   3.59180960952277*^9, 3.59180965515392*^9}, {3.5918096963322067`*^9, 
   3.591809716771374*^9}, {3.591809894132382*^9, 3.591809914922008*^9}, {
   3.5918099915212107`*^9, 3.591809996115223*^9}, 3.592039963581832*^9, 
   3.592208508315271*^9, 3.592224370420021*^9, {3.592434698949301*^9, 
   3.592434708642909*^9}, {3.592434744856522*^9, 3.592434760690627*^9}, 
   3.592435864227016*^9, {3.592468074304071*^9, 3.59246807525484*^9}, 
   3.592647648115087*^9, 3.592661140793049*^9, {3.592828729893439*^9, 
   3.592828730244364*^9}, 3.592828899672105*^9, {3.592828958535452*^9, 
   3.592828958804099*^9}, {3.592855148283045*^9, 3.592855156480612*^9}, {
   3.594654113580291*^9, 3.594654115957761*^9}, {3.594739162443256*^9, 
   3.594739163376808*^9}, {3.62732882011451*^9, 3.627328820513137*^9}, {
   3.628786571629396*^9, 3.628786592635055*^9}, 3.628948773983244*^9},
 CellLabel->
