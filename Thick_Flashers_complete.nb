Cell[CellGroupData[{

Cell["Kawasaki R(\[Gamma])=1 condition from angles", "Subsection",
 CellChangeTimes->{{3.5913653726072617`*^9, 3.591365399440153*^9}, 
   3.591382005868789*^9, {3.591382086989428*^9, 3.591382087916288*^9}, {
   3.592208965719982*^9, 3.592208978982377*^9}, {3.594756761221034*^9, 
   3.5947567707948227`*^9}, {3.594756980351035*^9, 3.594756982645585*^9}, {
   3.594757422810999*^9, 3.594757423568886*^9}, {3.594757508395448*^9, 
   3.594757511643128*^9}, {3.595528790334428*^9, 3.5955287922461867`*^9}, {
   3.595983107711394*^9, 3.595983113279557*^9}, 3.6881668361527247`*^9, 
   3.70457120589043*^9, 
   3.708400916203657*^9},ExpressionUUID->"390c9eca-4efe-4413-a2ab-\
1683a3b03a62"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.591365408143817*^9, 
  3.591365410247493*^9}},ExpressionUUID->"49a21e56-a617-4e5a-ac93-\
202b3865d467"],

Cell[TextData[{
 "Here we construct the 3D \
\[OpenCurlyDoubleQuote]consistency-around-the-vertex\[CloseCurlyDoubleQuote] \
condition that is the equivalent of the Kawasaki-Justin condition for 2D. Or, \
as Kawasaki put it, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"RotationMatrix2D", "(", "\[Gamma]", ")"}], "\[Equal]", "1"}], 
   TraditionalForm]],ExpressionUUID->"7d105639-4d51-4439-be5d-7dca911fdd0d"],
 "."
}], "Text",
 CellChangeTimes->{{3.591365413855545*^9, 3.591365468411282*^9}, {
  3.591376017518654*^9, 3.591376037725288*^9}, {3.68816683618681*^9, 
  3.688166836187561*^9}},ExpressionUUID->"5f0de7db-6290-499d-8914-\
b44c651bf92a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "VertexConsistencyMatrix3D[",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.591381820016262*^9, 3.59138183245334*^9}, 
   3.592645253272173*^9, {3.59598248998563*^9, 3.595982495262208*^9}, 
   3.595982548884863*^9, 3.595982950163372*^9, 
   3.7045708587301083`*^9},ExpressionUUID->"6642f3f4-45bf-4351-bb88-\
4fc476017428"],

Cell[TextData[{
 "VertexConsistencyMatrix3D[",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 "] returns the 3D rotation matrix that tranforms a point all the way around \
the vertex. Self-consistency is satisfied when this gives the identity \
matrix. Note that this matrix, being a composition of rotations, is always \
unitary and preserves handedness, even if the dihedral and sector angles don\
\[CloseCurlyQuote]t satisfy generalized KJT."
}], "Text",
 CellChangeTimes->{{3.591381842444835*^9, 3.591381926734481*^9}, 
   3.592645253324098*^9, {3.594163896950463*^9, 3.594164019699903*^9}, {
   3.594224186559387*^9, 3.594224207035784*^9}, 3.595982950289671*^9, 
   3.7045708587543993`*^9},ExpressionUUID->"f26f31d4-224e-4aed-943a-\
606bcd50cf7d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VertexConsistencyMatrix3D", "[", 
    RowBox[{"foldangles_List", ",", "sectorangles_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gmats", ",", "amats"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gmats", "=", 
       RowBox[{"RotationXMatrix3D", "/@", "foldangles"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"amats", "=", 
       RowBox[{"RotationZMatrix3D", "/@", "sectorangles"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Dot", "@@", 
       RowBox[{"Riffle", "[", 
        RowBox[{"gmats", ",", "amats"}], "]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.591381458270413*^9, 3.591381501918029*^9}, {
   3.591381642325422*^9, 3.591381709666946*^9}, {3.591381749079984*^9, 
   3.591381766623374*^9}, 3.594224172147079*^9, 3.595982950312076*^9, {
   3.616180210697759*^9, 3.616180233758884*^9}, {3.704570858770833*^9, 
   3.704570858803834*^9}},
 CellLabel->
  "In[736]:=",ExpressionUUID->"6c9ee5c4-139c-444f-a654-0012de874df3"],

Cell["Example (a consistent flat-foldable degree-4 vertex).", "Text",
 CellChangeTimes->{{3.591365471499288*^9, 3.5913654718189483`*^9}, {
  3.591381505738391*^9, 3.591381509106139*^9}, {3.591381964292693*^9, 
  3.591381974644208*^9}},ExpressionUUID->"69cdd290-6887-48cc-a54f-\
dc45802139af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"glist", ",", "alist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"glist", "=", 
      RowBox[{"{", 
       RowBox[{"0.5235987755982988`", ",", "0.871136020378918`", ",", 
        RowBox[{"-", "0.5235987755982974`"}], ",", "0.8711360203789182`"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Fold angles = \>\"", ",", 
       RowBox[{"glist", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alist", "=", 
      RowBox[{"{", 
       RowBox[{
       "2.0943951023931953`", ",", "0.8726646259971648`", ",", 
        "1.0471975511965976`", ",", "2.2689280275926285`"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Sector angles = \>\"", ",", 
       RowBox[{"alist", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{"VertexConsistencyMatrix3D", "[", 
        RowBox[{"glist", ",", "alist"}], "]"}], "]"}], "//", 
      "MatrixForm"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.591381510529553*^9, 3.591381611640764*^9}, {
   3.591381783976893*^9, 3.591381800992807*^9}, {3.591381978425333*^9, 
   3.591381980316917*^9}, 3.594224175742584*^9, 3.595982950347766*^9, {
   3.704570665686822*^9, 3.704570666142375*^9}, 3.704571185438588*^9},
 CellLabel->
  "In[737]:=",ExpressionUUID->"791c82f7-c889-4c85-b923-5fda0c606475"],

Cell["An example with inconsistent fold angles.", "Text",
 CellChangeTimes->{{3.616165520350737*^9, 3.6161655289954453`*^9}, {
