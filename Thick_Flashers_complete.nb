 RowBox[{
  RowBox[{"FlasherFirstSectorVerticesAll", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_"}], "]"}], ":=", 
  RowBox[{"Union", "[", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"FlasherSectorFoldLines", "[", 
       RowBox[{"v", ",", "r", ",", "h", ",", "0"}], "]"}], "}"}], ",", 
     SubscriptBox["v", "___"], ",", "\[Infinity]"}], "]"}], "]"}]}]], "Input",\

