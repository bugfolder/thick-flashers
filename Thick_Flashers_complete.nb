Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dirs", ",", "tobj", ",", "vp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vp", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1000"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"sectors", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"120", "\[Degree]"}], ",", 
          RowBox[{"90", "\[Degree]"}], ",", 
          RowBox[{"60", "\[Degree]"}], ",", 
          RowBox[{"90", "\[Degree]"}]}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"minor", " ", "dihedral"}], " ", "=", " ", 
        RowBox[{"30.", "\[Degree]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"dirs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.7522953764156599`", ",", 
          RowBox[{"-", "0.07402862994944666`"}], ",", "0.6546536707079771`"}],
          "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.5848104500843038`"}], ",", "0.8111699806281014`", ",",
           "2.775557561562892`*^-17"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.6131868684980109`"}], ",", 
          RowBox[{"-", "0.4420751471528054`"}], ",", "0.6546536707079771`"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.09793067237253185`"}], ",", 
          RowBox[{"-", "0.995193239229781`"}], ",", 
          RowBox[{"-", "1.1102230246251568`*^-16"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", "dirs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Vertex3DFoldedFormGraphics3D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"ViewPoint", "\[Rule]", "vp"}]}], "]"}], "/.", 
      RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "ShowExample"}]], "Input",
