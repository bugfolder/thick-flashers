Cell[TextData[{
 "FlasherSectorFoldLines[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h, k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a flat list of both folded fold lines and diagonal bend lines."
}], "Text",
