Cell[TextData[{
 "MergeGraph3DAssigneds[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of Graph3DAssigned that have vertices in common and returns \
a single TGraph3DAssigned merged from the list."
}], "Text",
