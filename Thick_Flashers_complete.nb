Cell["\<\
This is used to generate the ijk-map that is part of the finished Flasher, \
which gives a lookup table from {i,j,k} indices to indices in the TGraph \
representation.\
\>", "Text",
 CellChangeTimes->{{3.82577718384595*^9, 
  3.8257772512702107`*^9}},ExpressionUUID->"015dbd70-56aa-4023-9708-\
9b98856a5672"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherVertices", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "fsvd", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fsvd", "=", 
      RowBox[{"FlasherFirstSectorVertices", "[", 
       RowBox[{"v", ",", "r", ",", "h"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"fsvd", "/.", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["v", 
             RowBox[{"i_", ",", "j_", ",", "_"}]], "\[Rule]", 
            SubscriptBox["v", 
             RowBox[{"i", ",", "j", ",", "k"}]]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.825776960674499*^9, 3.825777000779582*^9}, {
  3.825777032100848*^9, 3.825777102365452*^9}, {3.911861316556871*^9, 
