Cell[BoxData[
 RowBox[{
  RowBox[{"VeneerScoringCarveGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "is", ",", "ht", ",", "vt", ",", "if", ",", "verts", ",", "edges", ",", 
      "types", ",", "foldangles", ",", "ll"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph", ",", "TAssigned"}], "}"}], ",", 
       "VeneerScoringCarveGraphics"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"is", "=", 
      RowBox[{
       RowBox[{"ImageSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "VeneerScoringCarveGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ht", "=", 
      RowBox[{
       RowBox[{"ScoreLineThickness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "VeneerScoringCarveGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vt", "=", 
      RowBox[{
       RowBox[{"VeneerThickness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "VeneerScoringCarveGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"if", "=", 
      RowBox[{
       RowBox[{"InvertFolds", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "VeneerScoringCarveGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "types", ",", "foldangles"}], 
       "}"}], " ", "=", " ", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "EdgeTypes", ",", "FoldAngles"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{
       FractionBox["is", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Max", "[", "#", "]"}], "-", 
            RowBox[{"Min", "[", "#", "]"}]}], ")"}], "&"}], "@", 
         RowBox[{"(", 
          RowBox[{"First", "/@", "verts"}], ")"}]}]], "verts"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "scale", " ", "to", " ", "desired", " ", "image", " ", "width"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"ll", "=", 
          RowBox[{"Line", "[", 
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{
            "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{
           "types", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"if", ",", "V", ",", "M"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"ll", ",", "Blue", ",", 
             RowBox[{"AbsoluteThickness", "[", "ht", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{"if", ",", "M", ",", "V"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"ll", ",", "Red", ",", 
             RowBox[{"AbsoluteThickness", "[", 
              RowBox[{"Max", "[", 
               RowBox[{"ht", ",", 
                RowBox[{"2", " ", "vt", " ", 
                 RowBox[{"Sin", "[", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    "foldangles", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "]"}], "/", "2"}], "]"}]}]}], 
               "]"}], "]"}], ",", 
             RowBox[{"CapForm", "[", "\"\<Butt\>\"", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "U", ",", 
           RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "_", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"ll", ",", "Black", ",", 
             RowBox[{"AbsoluteThickness", "[", "ht", "]"}]}], "]"}]}], " ", 
          RowBox[{"(*", " ", "border", " ", "*)"}], "\[IndentingNewLine]", 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.624890235467551*^9, 3.624890256985441*^9}, {
   3.62489106316939*^9, 3.624891088439446*^9}, {3.624891257130622*^9, 
   3.624891289378034*^9}, {3.62489135704589*^9, 3.624891360709459*^9}, {
   3.624891413697235*^9, 3.624891522991411*^9}, {3.624892005612266*^9, 
   3.6248920062404413`*^9}, {3.624892067391641*^9, 3.624892223472917*^9}, {
   3.624893473969715*^9, 3.624893754441461*^9}, {3.62489387848973*^9, 
   3.624893909687932*^9}, {3.624893992041285*^9, 3.624894000374734*^9}, {
   3.624894033369151*^9, 3.62489403792546*^9}, {3.624894125752527*^9, 
   3.624894147359855*^9}, {3.624894348121101*^9, 3.624894383887424*^9}, {
   3.62489456602712*^9, 3.624894572734136*^9}, {3.624894638518723*^9, 
   3.624894651677805*^9}, {3.6248948244745417`*^9, 3.6248948573189*^9}, {
   3.624895821763269*^9, 3.62489584772221*^9}, {3.624896014624798*^9, 
   3.624896018224515*^9}, {3.624913969412105*^9, 3.624913970772785*^9}, 
   3.625164210607603*^9, {3.62636097501132*^9, 3.626360975865209*^9}},
 CellLabel->
  "In[4234]:=",ExpressionUUID->"7e148642-6220-4fe8-bb5a-7d6871e6006c"],

