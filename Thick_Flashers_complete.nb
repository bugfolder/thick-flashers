Cell[CellGroupData[{

Cell[TextData[{
 "MakeFlapCubeBox[\[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FlapAngle, FlapWidth"
}], "Subsubsection",
 CellChangeTimes->{{3.719837640450873*^9, 
  3.719837686161057*^9}},ExpressionUUID->"57356eef-a2a0-4219-a341-\
b12376f6438d"],

Cell[TextData[{
 "MakeFlapCubeBox[\[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a partially folded cubical box with flaps across the edge \
joints."
}], "Text",
 CellChangeTimes->{{3.719837728650525*^9, 
  3.719837789113281*^9}},ExpressionUUID->"8c45127e-be3b-4694-aab7-\
c21ff0b5bd83"],

Cell["\<\
Arguments:
\t\[Gamma] \[LongDash] the fold angle of the edges of the box and flaps.\
\>", "Text",
 CellChangeTimes->{{3.719837863391643*^9, 
  3.719837880701852*^9}},ExpressionUUID->"1ccae73b-d3ef-4c37-bf9d-\
11ece64f474f"],

Cell[TextData[{
 "Options:\n\tFlapFoldAngle \[Rule] ",
 StyleBox["ffa",
  FontSlant->"Italic"],
 ", defines the final fold angle of the flaps.\n\tFlapAngle \[Rule] ",
 StyleBox["fa",
  FontSlant->"Italic"],
 ", defines the bevel angle of the flaps.\n\tFlapWidth \[Rule] ",
 StyleBox["fw",
  FontSlant->"Italic"],
 ", defines the width of the flaps."
}], "Text",
 CellChangeTimes->{{3.719837884546851*^9, 3.719837918542969*^9}, {
  3.719840049043474*^9, 
  3.7198400640286813`*^9}},ExpressionUUID->"7b31e7b4-5e7b-437d-b429-\
5274d85eb60c"],

Cell["Return: a TGraph3DAssigned of the box.", "Text",
 CellChangeTimes->{{3.7198379227083673`*^9, 
  3.7198379337705927`*^9}},ExpressionUUID->"38d01e09-b29d-46d3-aab1-\
2ec12480b24f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlapFoldAngle", "::", "usage"}], 
   "=", "\"\<FlapFoldAngle is an option to MakeFlapCubeBox that specifies the \
final fold angle to be used on the box flaps.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.719838933233181*^9, 3.719838964899496*^9}, {
  3.719840093990623*^9, 3.719840100738222*^9}},
