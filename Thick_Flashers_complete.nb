Cell[CellGroupData[{

Cell["Twist tiling patches", "Subsection",
 CellChangeTimes->{{3.631180926821004*^9, 3.631180930196974*^9}, {
   3.631181069093137*^9, 3.631181072587446*^9}, 
   3.6311848270432253`*^9},ExpressionUUID->"c34ca079-c3cf-42af-9c79-\
da725d8c0075"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.631180945395659*^9, 
  3.631180945795527*^9}},ExpressionUUID->"a745273a-fe85-4714-bea1-\
a634fa628008"],

Cell["\<\
By weaving together polygon tilings with twist parameters and edge types, we \
can create twist patches that can be made into tessellations on the same \
lattice.\
\>", "Text",
 CellChangeTimes->{{3.631180952115462*^9, 
  3.631181008784062*^9}},ExpressionUUID->"62016bd7-cb49-47fd-94b4-\
01e8f21d5a1e"],

Cell["\<\
Note that you can render the Tiling decoration for any of these to generate a \
patch that shows just the tiling, with optional edge arrows and/or tile \
colorings.\
\>", "Text",
 CellChangeTimes->{{3.629920422397619*^9, 3.629920450111302*^9}, {
  3.629979289158839*^9, 
  3.629979299205909*^9}},ExpressionUUID->"dc954b4d-a652-4115-ab24-\
80cda2248ede"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PatchCheckTypes[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629920477599247*^9, 3.629920494699992*^9}, {
  3.631181145633501*^9, 
  3.631181146327755*^9}},ExpressionUUID->"d2bfc75f-b7d0-408f-a0a0-\
98ab644cfeac"],

Cell[TextData[{
 "PatchCheckTypes[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] checks to verify that the lengths of the entries of ",
 StyleBox["types",
  FontSlant->"Italic"],
 " match the required lengths specified by ",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", where patch is a list of {UnitRegularPolygon, ",
 StyleBox["n",
  FontSlant->"Italic"],
 "} tiletypes. If they don\[CloseCurlyQuote]t match, it throws an error \
message and aborts the evaluation."
}], "Text",
 CellChangeTimes->{{3.629920510518349*^9, 3.629920541697158*^9}, {
  3.629920994604336*^9, 3.629921009739218*^9}, {3.631181148438925*^9, 
  3.631181177405627*^9}},ExpressionUUID->"8bbd0206-4234-46d9-8bee-\
7be121846959"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PatchCheckTypes", "::", "badlens"}], 
   "=", "\"\<The length `1` of types `2` does not match the length `3` of \
patch `4`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629920593402944*^9, 3.629920619602415*^9}, {
  3.629920809611515*^9, 3.629920814281189*^9}, {3.631181213948372*^9, 
  3.631181215044215*^9}},
 CellLabel->
  "In[3170]:=",ExpressionUUID->"28394f55-65fe-4cfb-b6cb-0f387a5bc531"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PatchCheckTypes", "::", "badtypes"}], "=", 
   "\[IndentingNewLine]", "\"\<The length `1` of typelist `2` does not match \
the required length `3` from tilespec `4` of patch `5`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.629920761395938*^9, 3.629920778403163*^9}, {
  3.629920826712613*^9, 3.62992086371069*^9}, {3.629921121431349*^9, 
  3.629921124653913*^9}, {3.631181268994656*^9, 3.631181299056528*^9}},
 CellLabel->
  "In[3171]:=",ExpressionUUID->"ee53c75f-6379-4cd5-88d3-61a9c74e29ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PatchCheckTypes", "[", 
   RowBox[{"patch_List", ",", "types_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "types", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "patch", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"PatchCheckTypes", "::", "badlens"}], ",", 
          RowBox[{"Length", "[", "types", "]"}], ",", "types", ",", 
          RowBox[{"Length", "[", "patch", "]"}], ",", "patch"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "types", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", 
           RowBox[{"patch", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PatchCheckTypes", "::", "badtypes"}], ",", 
             RowBox[{"Length", "[", 
              RowBox[{
              "types", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               "]"}], ",", 
             RowBox[{
             "types", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             ",", 
             RowBox[{"patch", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",",
              "i", ",", "patch"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "patch", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.62992055086625*^9, 3.629920588208498*^9}, {
  3.629920628095998*^9, 3.629920639169999*^9}, {3.629920694538536*^9, 
  3.629920755455705*^9}, {3.629920789935519*^9, 3.629920806830146*^9}, {
  3.629920875312492*^9, 3.629920914752339*^9}, {3.629921079810245*^9, 
