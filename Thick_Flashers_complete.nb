Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     "TestMakeT3DDegree4VertexCreaseVectorsFromSubarcs", "[", "args___", 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirs", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dirs", "=", 
         RowBox[{"MakeFoldVectorsFromSubarcs", "[", "args", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tobj", "=", 
         RowBox[{"MakeTDegree4Vertex3D", "[", "dirs", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<OsculatingVector = \>\"", ",", 
          RowBox[{"tobj", "[", "OsculatingVector", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<SectorAngles/\[Degree] = \>\"", ",", 
          RowBox[{
           RowBox[{"tobj", "[", "SectorAngles", "]"}], "/", "\[Degree]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<DihedralAngles/\[Degree] = \>\"", ",", 
          RowBox[{
           RowBox[{"tobj", "[", "DihedralAngles", "]"}], "/", "\[Degree]"}]}],
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<SubarcAngles/\[Degree] = \>\"", ",", 
          RowBox[{
           RowBox[{"tobj", "[", "SubarcAngles", "]"}], "/", "\[Degree]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Degree4Vertex3DGraphicsTrio", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"ShowOsculatingVector", "\[Rule]", "True"}]}], "]"}], "/.", 
         RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ")"}], "//", "ShowExample"}], ";"}]], "Input",
