Cell[TextData[{
 "TriangleGraphQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph and returns true if the graph consists entirely of \
triangles."
}], "Text",
 CellChangeTimes->{{3.465946825344399*^9, 3.4659468328312597`*^9}, {
   3.4659468697735033`*^9, 3.465946890131847*^9}, {3.591734852598845*^9, 
   3.591734852957334*^9}, {3.592403173314059*^9, 3.59240317600986*^9}, 
   3.592828722637533*^9, 
   3.593016866374369*^9},ExpressionUUID->"466192a2-9ec6-42b5-ba61-\
4157aa054c4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleGraphQ", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "faces", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "TriangleGraphQ"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Faces"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"And", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "\[Equal]", "3"}], "&"}], "/@", 
        "faces"}], ")"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.4659468828090467`*^9, 3.465946917808824*^9}, {
   3.59173486718556*^9, 3.591734894396393*^9}, {3.592403089138092*^9, 
   3.592403092010305*^9}, {3.592431810991247*^9, 3.5924318136930313`*^9}, 
   3.592435748151379*^9, 3.592828722737769*^9, 3.593006102203876*^9, 
   3.593016873545512*^9},
 CellLabel->
  "In[1511]:=",ExpressionUUID->"66880f65-d35d-4794-843f-4d89720cd5dc"],

