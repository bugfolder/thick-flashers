Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nr", ",", "na", ",", "vfn", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nr", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"na", "=", "6"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", "i", ")"}], 
       RowBox[{"U", "[", 
        RowBox[{"2", "\[Pi]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", "-", "1"}], ")"}], "/", "na"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRotationalMesh", "[", 
       RowBox[{"nr", ",", "na", ",", "vfn"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594057643412326*^9, 3.5940577370554457`*^9}, {
   3.5940579825602827`*^9, 3.594057989712686*^9}, {3.59405826556793*^9, 
   3.59405844221087*^9}, {3.594058525206237*^9, 3.594058527919942*^9}, {
   3.59405871575379*^9, 3.594058752216541*^9}, {3.594058900101481*^9, 
   3.594058922692294*^9}, {3.594058982187069*^9, 3.594059011272228*^9}, {
   3.594059196995329*^9, 3.5940592280087233`*^9}, 3.594060037453629*^9, 
   3.594060498083675*^9, {3.594061590129327*^9, 3.594061682060021*^9}, {
   3.5940618741444473`*^9, 3.594061918084995*^9}, {3.594061973721918*^9, 
   3.594061993576104*^9}, {3.594062045677178*^9, 3.594062047075718*^9}, {
   3.594068960721479*^9, 3.594068977364011*^9}, 3.594069123643806*^9, 
