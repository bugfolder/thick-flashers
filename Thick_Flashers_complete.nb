Cell[TextData[{
 "Here\[CloseCurlyQuote]s another example, using silver rectangle tiles with \
offset split twists that gives a woven-like appearance. Note that ",
 StyleBox["ip",
  FontSlant->"Italic"],
 " is different for the two tiles."
}], "Text",
 CellChangeTimes->{{3.6301124329226513`*^9, 3.6301124892047153`*^9}, {
  3.630112649772025*^9, 
  3.630112656074051*^9}},ExpressionUUID->"739366de-0475-448f-b142-\
830876644e44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "w", ",", "d", ",", "ip", ",", "ctype", ",", "types", ",", 
      "tiling"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "/", 
           SqrtBox["2"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"1", "/", 
           SqrtBox["2"]}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.12"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype", "=", "V"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
           "QuadrilateralOffsetSplitTwistTile", ",", "verts", ",", "w", ",", 
            "d", ",", "1", ",", "ctype", ",", "types"}], "}"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "QuadrilateralOffsetSplitTwistTile", ",", "verts", ",", "w", ",", 
             
             RowBox[{"-", "d"}], ",", "4", ",", "ctype", ",", "types"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "Tiling", ",", 
             RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowDF"}]}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
