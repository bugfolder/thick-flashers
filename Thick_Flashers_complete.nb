}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MaxSliceAngle",
 "[",
 StyleBox["glist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.442792103349173*^9, 3.442792108802588*^9}, 
   3.628786999734034*^9},ExpressionUUID->"89c667fe-0286-40f6-9bc2-\
1051270d970f"],

Cell[TextData[{
 "MaxSliceAngle",
 "[",
 StyleBox["glist",
  FontSlant->"Italic"],
 "] takes a list of crease directions for a fluted cone and returns the \
maximum angular tilt of a plane (relative to the z axis) that is guaranteed \
not to produce a surface self-intersection when used to slice the given \
fluted vertex."
}], "Text",
 CellChangeTimes->{{3.442792115275042*^9, 3.442792206085828*^9}, {
   3.442792353518062*^9, 3.442792402052327*^9}, 
   3.628786999816752*^9},ExpressionUUID->"7f95c8c0-2835-447a-8f8c-\
748dd3929254"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MaxSliceAngle", "[", "glist_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "aa"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", "glist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aa", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
        "&"}], "/@", 
       RowBox[{"tobj", "[", "SectorVectors", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "2"}], "-", 
      RowBox[{"ArcCos", "[", 
       RowBox[{
        RowBox[{"Sort", "[", "aa", "]"}], "\[LeftDoubleBracket]", "1", 
        "\[RightDoubleBracket]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.44279248237764*^9, 3.442792657928415*^9}, {
   3.442792734623014*^9, 3.442792784869802*^9}, 3.442792826018364*^9, {
   3.5921539785901213`*^9, 3.592154009666395*^9}, 3.592437131942353*^9, 
   3.592437165820113*^9, 3.592829170408566*^9, {3.593039210228557*^9, 
   3.593039212925792*^9}, 3.61617372431999*^9, 3.6287869998392467`*^9},
 CellLabel->
  "In[2582]:=",ExpressionUUID->"869cb9d8-766c-4a04-af3c-2dff5c796d82"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "SlicedVertexGraphicsTrio",
 "[",
 StyleBox["glist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.442791335202982*^9, 3.442791358074596*^9}, {
  3.595017627360405*^9, 
  3.5950176522358313`*^9}},ExpressionUUID->"7147e485-9ba3-46ae-bd2b-\
eef5f98e48dc"],

Cell[TextData[{
 "SlicedVertexGraphicsTrio[",
 StyleBox["glist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a set of crease directions and a vector ",
 StyleBox["r",
  FontSlant->"Italic"],
 " and produces a GraphicsRow that renders a vertex that has been sliced by a \
plane perpendicular to vector ",
 StyleBox["r",
  FontSlant->"Italic"],
 " at  distance |",
 StyleBox["r",
  FontSlant->"Italic"],
 "| from the origin. It returns the same imagery as Vertex3DGraphicsTrio but \
both the crease pattern and the folded form will have a line of a specified \
type located at the slicing plane and the point ",
 StyleBox["r",
  FontSlant->"Italic"],
 " will appear on the Gaussian sphere. Options are:\n\tSliceLine\[Rule]",
 StyleBox["line",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["line",
  FontSlant->"Italic"],
 " is one of the symbolic origami line styles.\n\tOptions[Graphics], \
Options[Graphics3D] are passed through."
}], "Text",
 CellChangeTimes->{{3.442779022047723*^9, 3.442779221248878*^9}, {
   3.442779912992087*^9, 3.442779960369249*^9}, {3.4427914141074457`*^9, 
   3.4427914161278257`*^9}, 3.592437132089811*^9, 3.592829170571713*^9, {
   3.593039245766941*^9, 3.5930392588441677`*^9}, {3.595017627513315*^9, 
   3.595017685448493*^9}},ExpressionUUID->"5850247d-b95b-4804-a074-\
fa5e158aa7a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SliceLine", "::", "usage"}], 
   "=", "\"\<SliceLine is an option to SlicedVertexGraphicsTrio that \
specifies the type of line to use at the slicing plane.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592153532311697*^9, 3.592153571391254*^9}, {
  3.595017627591696*^9, 3.595017650197644*^9}},
 CellLabel->
  "In[2583]:=",ExpressionUUID->"2d340b0f-07a0-45b2-a27f-c9d938a2549d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SlicedVertexGraphicsTrio", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"SliceLine", "\[Rule]", "CreaseLine"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.442779866325618*^9, 3.442779881320068*^9}, {
   3.5950176279428864`*^9, 3.5950176505431423`*^9}, 3.628948740043943*^9},
 CellLabel->
  "In[2584]:=",ExpressionUUID->"4a6645e6-69ec-4f29-bbcf-1ba9338da9a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SlicedVertexGraphicsTrio", "[", 
   RowBox[{"glist_", ",", "r_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sl", ",", "tobj", ",", "vv", ",", "rn", ",", "dd", ",", "gr", ",", 
      "gr2", ",", "cp", ",", "ff", ",", "gs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sl", "=", 
      RowBox[{
       RowBox[{"SliceLine", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SlicedVertexGraphicsTrio", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", 
       RowBox[{"glist", ",", "opts"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "create", " ", "all", " ", "the", " ", "parts", " ", "of", " ", "the", " ",
        "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vv", "=", 
      RowBox[{"GetAllRules", "[", "tobj", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rn", "=", 
      RowBox[{"NormalizeReal", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"r", ".", "r"}], "/", 
         RowBox[{"(", 
          RowBox[{"#", ".", "r"}], ")"}]}], "&"}], "/@", "glist"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"distances", " ", "out", " ", "each", " ", "crease"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gr", "=", 
      RowBox[{"dd", "*", "glist"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "vectors", " ", "out", " ", "to", " ", "the", " ", "planar", " ", 
       "ring", " ", "in", " ", "the", " ", "folded", " ", "form"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gr2", "=", 
      RowBox[{"dd", "*", 
       RowBox[{"(", 
        RowBox[{"CreaseVectors", "/.", "vv"}], ")"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "vectors", " ", "out", " ", "to", " ", "the", " ", "planar", " ", 
       "ring", " ", "in", " ", "the", " ", "crease", " ", "pattern"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Build", " ", "imagery"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"Vertex3DCreasePatternGraphics", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Vertex3DFoldedFormGraphics3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs", "=", 
      RowBox[{"Vertex3DGaussianSphereGraphics3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
            "cp", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"Append", "[", 
                 RowBox[{"gr2", ",", 
                  RowBox[{
                  "gr2", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", "sl"}], 
              "]"}], "}"}]}], "]"}], ",", 
          RowBox[{"FilterRules", "[", 
           RowBox[{
            RowBox[{"{", "opts", "}"}], ",", 
            RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
            "ff", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"Append", "[", 
                 RowBox[{"gr", ",", 
                  RowBox[{
                  "gr", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", "sl"}], 
              "]"}], "}"}]}], "]"}], ",", 
          RowBox[{"FilterRules", "[", 
           RowBox[{
            RowBox[{"{", "opts", "}"}], ",", 
            RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
            "gs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Point", "[", "rn", "]"}], ",", 
                RowBox[{"AbsolutePointSize", "[", "3", "]"}]}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Styled3DUnitCircleFromNormal", "[", "rn", "]"}], ",",
                 "CreaseLine"}], "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"FilterRules", "[", 
           RowBox[{
            RowBox[{"{", "opts", "}"}], ",", 
            RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], " ", 
         "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.442778990234822*^9, 3.442779014348659*^9}, {
