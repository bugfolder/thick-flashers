Cell[BoxData[
 RowBox[{
  RowBox[{"StyledCurvedFold", "[", 
   RowBox[{
    RowBox[{"ff_Function", "|", "ff_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rrl_Function", "|", "rrl_InterpolatingFunction"}], ",", 
      RowBox[{"rrr_Function", "|", "rrr_InterpolatingFunction"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", " ", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "bbl", ",", "bbr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bbl", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ff", "[", "t", "]"}], "+", 
         RowBox[{"rrl", "[", "t", "]"}]}], ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bbr", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ff", "[", "t", "]"}], "+", 
         RowBox[{"rrr", "[", "t", "]"}]}], ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"StyledCurvedFoldBounded", "[", 
      RowBox[{"ff", ",", 
       RowBox[{"{", 
        RowBox[{"bbl", ",", "bbr"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
