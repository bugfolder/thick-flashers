   3.591978797541709*^9},
 CellLabel->
  "In[612]:=",ExpressionUUID->"fad99e87-a096-4c25-a049-2da51e347019"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Normals3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.701259825750451*^9, 3.701259838262261*^9}, {
  3.701259882702032*^9, 
  3.701259905910067*^9}},ExpressionUUID->"dc31f329-38ea-4f7c-89fe-\
af3562ebe633"],

Cell[TextData[{
 "Normals3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 "] returns two unit vectors {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "} that are nornal to vector ",
 StyleBox["p",
  FontSlant->"Italic"],
 " and to each other, with the triple {",
 StyleBox["p, q, r",
  FontSlant->"Italic"],
 "} forming a right-handed orthonormal basis."
}], "Text",
 CellChangeTimes->{{3.701259848116708*^9, 3.701259870373761*^9}, {
  3.701259907493227*^9, 
  3.701259944741434*^9}},ExpressionUUID->"257c5759-e2c8-465e-a960-\
98e9fac45401"],

Cell[TextData[{
 "There is an inherent ambiguity in the problem, since any rotation of {",
 StyleBox["q",
  FontSlant->"Italic"],
 ",",
 StyleBox["r",
  FontSlant->"Italic"],
 "} about the ",
 StyleBox["p",
  FontSlant->"Italic"],
 "-axis provides a solution. We choose the solution where ",
 StyleBox["q",
  FontSlant->"Italic"],
 " lies approximately along the canonical axis (x, y, or z) that is most \
nearly perpendicular to ",
 StyleBox["p",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.701259995318603*^9, 3.701260169904348*^9}, {
  3.7012603071630497`*^9, 3.701260338769747*^9}, {3.701261019782145*^9, 
  3.701261020832725*^9}},ExpressionUUID->"a084d5ea-63a0-46b6-a638-\
3e3fac889588"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Normals3D", "[", "p_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"wl", ",", "q"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"wl", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Mag", "[", 
             RowBox[{"p", ".", "#"}], "]"}], ",", "#"}], "}"}], "&"}], "/@", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "<", 
          RowBox[{
          "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"wl", "\[LeftDoubleBracket]", 
       RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"q", "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p", ".", "q"}], ")"}], "p"}], 
         RowBox[{"Mag2", "[", "p", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"q", ",", 
       RowBox[{"p", "\[Cross]", "q"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.701259954470073*^9, 3.701259969913849*^9}, {
  3.701260182193429*^9, 3.701260268389225*^9}, {3.701260349409615*^9, 
  3.701260468028584*^9}, {3.701260515228691*^9, 3.701260535402994*^9}, {
  3.701260636165891*^9, 3.7012608372443657`*^9}, {3.701260996821891*^9, 
  3.701261000637847*^9}},
 CellLabel->
  "In[613]:=",ExpressionUUID->"440dd638-03ed-4589-9196-baeb0780153f"],

Cell["Example", "Text",
 CellChangeTimes->{{3.701260547259119*^9, 
  3.701260548020144*^9}},ExpressionUUID->"cda1cb5a-7ce3-4795-926b-\
c986cd1faeba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "q", ",", "r"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", ".9", ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q", ",", "r"}], "}"}], "=", 
      RowBox[{"Normals3D", "[", "p", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "p"}], "}"}], 
            "]"}], ",", "Red", ",", 
           RowBox[{"Thickness", "[", ".05", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "q"}], "}"}], 
            "]"}], ",", "Green", ",", 
           RowBox[{"Thickness", "[", ".03", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "r"}], "}"}], 
            "]"}], ",", "Blue", ",", 
           RowBox[{"Thickness", "[", ".03", "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Boxed", "\[Rule]", "True"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.701260550104856*^9, 3.701260602612255*^9}, {
  3.7012606949565153`*^9, 3.701260696908463*^9}, {3.70126086283815*^9, 
  3.701260979693754*^9}},
 CellLabel->
  "In[614]:=",ExpressionUUID->"8a59164d-533c-46cf-9165-f161638399ee"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Intersections", "Subsection",
 CellChangeTimes->{{3.743278023983715*^9, 
  3.743278028543153*^9}},ExpressionUUID->"6e3c6f12-25b9-4065-910e-\
74748aa6418f"],

Cell[CellGroupData[{

Cell[TextData[{
 "LinePlaneInt3D[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pr",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qn",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.925233806559486*^9, 3.9252338301992273`*^9}, 
   3.925234245897841*^9, 
   3.925235722264288*^9},ExpressionUUID->"3ea43e1a-f3ec-430d-a723-\
7980262c95fe"],

Cell[TextData[{
 "LinePlaneInt3D[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pr",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qn",
  FontSlant->"Italic"],
 "}] finds the point that is the intersection between a line and a plane."
}], "Text",
 CellChangeTimes->{{3.925233836848279*^9, 3.925233877086841*^9}, {
  3.9252357283913*^9, 
  3.925235728443097*^9}},ExpressionUUID->"7f1c7549-f7b2-410d-bab1-\
4c10af3510bc"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pr",
  FontSlant->"Italic"],
 "} \[LongDash] a point on the line and a direction vector along the line. ",
 StyleBox["pr",
  FontSlant->"Italic"],
 " does not have to be normalized.\n\t(",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qn",
  FontSlant->"Italic"],
 "} \[LongDash] a point in the plane and the normal vector to the plane. ",
 StyleBox["qn",
  FontSlant->"Italic"],
 " does not have to be normalized."
}], "Text",
 CellChangeTimes->{{3.925233880229497*^9, 3.925233916046048*^9}, 
   3.925234247524415*^9, {3.925235110850031*^9, 3.925235140960115*^9}, {
   3.925235712176384*^9, 
   3.925235719400433*^9}},ExpressionUUID->"b5ff2247-82c0-4b85-84ba-\
a2ea7437327e"],

Cell["Returns: the intersection point.", "Text",
 CellChangeTimes->{{3.925233920030607*^9, 
  3.925233925030319*^9}},ExpressionUUID->"1713b4d4-d906-4776-8727-\
61e11ec9b53b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LinePlaneInt3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_List", ",", "pr_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q_List", ",", "qn_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"p", "+", 
   RowBox[{"pr", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"q", "-", "p"}], ")"}], ".", "qn"}], 
     RowBox[{"pr", ".", "qn"}]]}]}]}]], "Input",
 CellChangeTimes->{{3.925233943365322*^9, 3.925234013708262*^9}, {
  3.925234151635184*^9, 3.925234206627284*^9}, {3.925234252611487*^9, 
  3.925234255467654*^9}, {3.9252346720942087`*^9, 3.925234675156966*^9}, {
  3.925235688901907*^9, 3.925235698586169*^9}, {3.92523574477737*^9, 
  3.925235752330567*^9}},
 CellLabel->
  "In[615]:=",ExpressionUUID->"c0899f34-15ad-4177-9312-77570c13cd66"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.925234214545793*^9, 
  3.925234215530773*^9}},ExpressionUUID->"ea5a753d-8e91-4fa6-aeee-\
7039de3f0128"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "pr", ",", "q", ",", "qn", ",", "s"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", "0", ",", "0.5"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pr", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", ".1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qn", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"LinePlaneInt3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", ",", "pr"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "qn"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "q", "]"}], ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Red"}], "]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<q\>\"", ",", "q", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"q", "+", "#"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}]}], "]"}], ",",
            "LightGray"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"{", 
             RowBox[{"q", ",", 
              RowBox[{"q", "+", 
               RowBox[{"0.3", "qn"}]}]}], "}"}], "]"}], ",", "Orange"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "p", "]"}], ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", 
           RowBox[{"Darker", "[", 
            RowBox[{"Green", ",", "0.5"}], "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p\>\"", ",", "p", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"p", "+", 
               RowBox[{"0.3", "pr"}]}]}], "}"}], "]"}], ",", "Orange"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "s", "]"}], ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Blue"}], "]"}],
          ",", "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<s\>\"", ",", "s", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"s", ",", "p"}], "}"}], "]"}], ",", "Blue"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], ",", 
       RowBox[{"Axes", "->", "True"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.925234216818052*^9, 3.925234371613355*^9}, {
   3.925234418291635*^9, 3.92523465487364*^9}, {3.925234685292427*^9, 
   3.92523484096953*^9}, {3.9252348771538*^9, 3.925234896336836*^9}, {
   3.925235756656299*^9, 3.925235804706151*^9}, 3.925236046034396*^9, {
   3.925237191487763*^9, 3.925237193501568*^9}},
 CellLabel->
  "In[616]:=",ExpressionUUID->"bb4ba8b5-d762-4df4-8d67-13e3ea4cc2b6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PlanePlaneInt3D[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pn",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qn",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.743277898366441*^9, 3.743277908238227*^9}, {
  3.743278036967025*^9, 
  3.7432780374231253`*^9}},ExpressionUUID->"8172abc1-1a71-4611-b9e3-\
8075b495372e"],

Cell[TextData[{
 "PlanePlaneInt3D[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pn",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qn",
  FontSlant->"Italic"],
 "}] finds the line that is the intersection of two planes."
}], "Text",
 CellChangeTimes->{{3.743277923289864*^9, 3.743277955142687*^9}, 
   3.743278041633766*^9, {3.925233791616487*^9, 
   3.925233793295442*^9}},ExpressionUUID->"ffc5bd34-a865-41e2-a19d-\
3cdef8753e44"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pn",
  FontSlant->"Italic"],
 "} \[LongDash] a point on one plane and its normal vector.\n\t{",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qn",
  FontSlant->"Italic"],
 "} \[LongDash] a point on the other plane and its normal vector."
}], "Text",
 CellChangeTimes->{{3.7432779596382847`*^9, 3.74327797741464*^9}, {
  3.743278065408103*^9, 
  3.743278074559525*^9}},ExpressionUUID->"7fb4f954-b8e8-4b3d-8b2f-\
8a4b3a0dd12f"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "} where\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " is a point on the line.\n\t",
 StyleBox["s",
  FontSlant->"Italic"],
 " is a vector along the line."
}], "Text",
 CellChangeTimes->{{3.74327807804635*^9, 3.74327811100688*^9}, {
  3.743278602514752*^9, 3.743278608330508*^9}, {3.743278856067708*^9, 
  3.743278862762601*^9}},ExpressionUUID->"808b841a-4a9b-465f-88de-\
e5475fba8393"],

Cell[TextData[{
 "Of course, if ",
 StyleBox["pn",
  FontSlant->"Italic"],
 " and ",
 StyleBox["qn",
  FontSlant->"Italic"],
 " are parallel, there will be no solution and we\[CloseCurlyQuote]ll get an \
error due to singular matrix inversion."
}], "Text",
 CellChangeTimes->{{3.743279507734169*^9, 
  3.743279532517317*^9}},ExpressionUUID->"f70e0ade-e74b-40f6-aa4d-\
ce404900209a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PlanePlaneInt3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_List", ",", "pn_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q_List", ",", "qn_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tp", ",", "tq"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tp", ",", "tq"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Inverse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pn", ".", "pn"}], ",", 
             RowBox[{"pn", ".", "qn"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pn", ".", "qn"}], ",", 
             RowBox[{"qn", ".", "qn"}]}], "}"}]}], "}"}], "]"}], ".", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pn", ".", 
           RowBox[{"(", 
            RowBox[{"p", "-", "q"}], ")"}]}], ",", 
          RowBox[{"qn", ".", 
           RowBox[{"(", 
            RowBox[{"q", "-", "p"}], ")"}]}]}], "}"}]}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"p", "+", "q"}], "2"], "+", 
        RowBox[{"tp", " ", "pn"}], "+", 
        RowBox[{"tq", " ", "qn"}]}], ",", 
       RowBox[{"pn", "\[Cross]", "qn"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.743278116714286*^9, 3.743278311840277*^9}, {
  3.7432786126030006`*^9, 3.743278631257021*^9}, {3.743278676714389*^9, 
  3.74327877545939*^9}, {3.743278868922089*^9, 3.743278888588898*^9}, {
  3.743278921706871*^9, 3.743278923298471*^9}, {3.743279284581492*^9, 
  3.74327930791659*^9}, {3.743279431461936*^9, 3.743279474511073*^9}, {
  3.743281191151924*^9, 3.743281192601027*^9}},
 CellLabel->
  "In[617]:=",ExpressionUUID->"b9049310-3614-4dd0-8ffd-b2799bfb6957"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.743278790594112*^9, 
  3.743278791514121*^9}},ExpressionUUID->"c71307d6-23e2-4464-b713-\
1590fb392517"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "pn", ",", "q", ",", "qn", ",", "r", ",", "s"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pn", "=", 
      RowBox[{"{", 
       RowBox[{".5", ",", "0", ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qn", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "s"}], "}"}], "=", 
      RowBox[{"PlanePlaneInt3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", ",", "pn"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "qn"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "p", "]"}], ",", "Red", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Cylinder", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"p", ",", 
               RowBox[{"p", "+", 
                RowBox[{".01", "pn"}]}]}], "}"}], ",", "2"}], "]"}], ",", 
           "Red", ",", 
           RowBox[{"Opacity", "[", ".25", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "q", "]"}], ",", "Green", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Cylinder", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"q", ",", 
               RowBox[{"q", "+", 
                RowBox[{".01", "qn"}]}]}], "}"}], ",", "2"}], "]"}], ",", 
           "Green", ",", 
           RowBox[{"Opacity", "[", ".25", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"r", "-", "s"}], ",", 
              RowBox[{"r", "+", "s"}]}], "}"}], "]"}], ",", "Blue", ",", 
           RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.743278793285713*^9, 3.743278844866362*^9}, {
   3.74327893196292*^9, 3.743278946930405*^9}, {3.743279481246422*^9, 
   3.74327948419644*^9}, {3.743280168505865*^9, 3.7432802118098316`*^9}, {
   3.743280263801759*^9, 3.743280562149754*^9}, {3.743281099104698*^9, 
   3.743281112311245*^9}, 3.743281211762468*^9, {3.743281256751781*^9, 
   3.743281260836351*^9}},
 CellLabel->
  "In[618]:=",ExpressionUUID->"d481dfcc-a644-45ea-a2e6-b870de3bc6f1"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Arcs", "Subsection",
 CellChangeTimes->{{3.650297111245851*^9, 3.650297136561692*^9}, 
   3.7084009386232033`*^9},ExpressionUUID->"f68810c2-27d4-4c2f-ba6e-\
25fa4c7fdf36"],

Cell[CellGroupData[{

Cell[TextData[{
 "PolygonalEllipseArc3D[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ArcDivisions, ",
 "ArcMaximumAngle",
 ", ArcMethod, ArcDirection, RotationAxis\n\t(option values)  InscribedArc, \
CircumscribedArc"
}], "Subsubsection",
 CellChangeTimes->{{3.483690525263499*^9, 3.48369064003011*^9}, {
   3.484057609091383*^9, 3.484057623314441*^9}, 3.595973396498966*^9, 
   3.595977849542705*^9, 3.595982783083143*^9, {3.6502990484269257`*^9, 
   3.650299052551976*^9}, 3.66898490004906*^9, {3.703971931526561*^9, 
   3.703971934156754*^9}},ExpressionUUID->"4a373dfc-1366-4213-91f4-\
850965cd3094"],

Cell[TextData[{
 "PolygonalEllipseArc3D[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a list of points that descries a polygonal arc  that approximates \
the surface of an ellipsoid centered on the origin that runs through both ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ". The arc takes the \"shortest way\" from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "; if they are diametrically opposite, the RotationAxis option resolves the \
ambiguity."
}], "Text",
 CellChangeTimes->{{3.483690555829352*^9, 3.4836905632274733`*^9}, {
   3.483690642925875*^9, 3.483690707169496*^9}, {3.483690746158805*^9, 
   3.483690972510628*^9}, {3.4837033917382936`*^9, 3.483703416161321*^9}, {
   3.484038913757167*^9, 3.484038922681961*^9}, {3.484038962450033*^9, 
   3.48403897970202*^9}, {3.484039040485818*^9, 3.4840390826467547`*^9}, {
   3.484055880885295*^9, 3.484055896324124*^9}, {3.48405593200026*^9, 
   3.484055963637096*^9}, {3.484057522426022*^9, 3.484057595481192*^9}, 
   3.595973396774885*^9, 3.595977849619669*^9, 3.5959827833715076`*^9, {
   3.668984225582541*^9, 3.668984234998204*^9}, {3.6689843414959197`*^9, 
   3.668984344263687*^9}, {3.668984639367051*^9, 3.668984649709053*^9}, {
   3.668984862958231*^9, 3.668984901081419*^9}, 3.693836581410638*^9, {
   3.6938367247924433`*^9, 3.693836748168274*^9}, {3.693836783215951*^9, 
   3.693836804328712*^9}},ExpressionUUID->"21f66102-8c7b-41af-963f-\
08119cbdae26"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p1",
  FontSlant->"Italic"],
 " \[LongDash] starting point of the arc.\n\t",
 StyleBox["p2",
  FontSlant->"Italic"],
 " \[LongDash] endpoint of the arc."
}], "Text",
 CellChangeTimes->{{3.693836649918157*^9, 
  3.693836666455347*^9}},ExpressionUUID->"a66bbfd6-0b92-43db-8b86-\
b2d6b563e5b5"],

Cell[TextData[{
 "Options:\n\tArcDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " specifies the minimum number of segments to use in the arc.\n\t\
ArcMaximumAngle \[Rule] ",
 StyleBox["ama",
  FontSlant->"Italic"],
 ", where ama specifies the maximum angle quantization to use.\n\tArcMethod \
\[Rule] InscribedArc | CircumscribedArc. If InscribedArc, then the path lies \
entirely within the ellipsoid with its vertices on the surface. If \
CircumscribedArc, then the path lies outside the ellipsoid with each segment \
tangent to the surface (or roughly so). If ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " have the same magnitude, then all segments for options CircumscribedArc \
will be tangent to the sphere whose surface contains both ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2.\n\t",
  FontSlant->"Italic"],
 "ArcDirection \[Rule] CCW | CW, which specifies the rotation direction of \
the arc about the rotation axis.\n\tRotationAxis \[Rule] Automatic | ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["u",
  FontSlant->"Italic"],
 " is the axis of rotation from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.6938365868336577`*^9, 3.693836588679467*^9}, {
  3.693836625776093*^9, 3.693836635776291*^9}, {3.70396996457213*^9, 
  3.703969965068019*^9}, {3.703970123791943*^9, 
  3.703970161734529*^9}},ExpressionUUID->"62bf3e4f-7972-43a6-be6f-\
ad814c8ad3de"],

Cell[TextData[{
 "Returns a list of points {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ..., ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} that describes the arc."
}], "Text",
 CellChangeTimes->{{3.6938367112739973`*^9, 
  3.6938367189272957`*^9}},ExpressionUUID->"0b81e89b-4a00-4e17-b4ec-\
f93475565838"],

Cell[TextData[{
 "If RotationAxis is given, then the arc runs CCW from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " about RotationAxis. Otherwise the arc takes the \
\[OpenCurlyDoubleQuote]shortest way\[CloseCurlyDoubleQuote] from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2.",
  FontSlant->"Italic"],
 " Note that if ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " are diametrically opposite (rotation angle of \[Pi]), RotationAxis ",
 StyleBox["must",
  FontSlant->"Italic"],
 " be given and must be perpendicular to ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.703969795867564*^9, 3.703969908938832*^9}, {
  3.703969953862829*^9, 
  3.703969981252576*^9}},ExpressionUUID->"8676b405-c77b-4855-af1d-\
829770467be4"],

Cell["See also PolygonalEllipseArc2D.", "Text",
 CellChangeTimes->{{3.593989949701412*^9, 3.593989953868464*^9}, 
   3.59597339689054*^9, 3.595982783483142*^9, 3.650297609144026*^9, {
   3.650297654866022*^9, 
   3.650297656136887*^9}},ExpressionUUID->"9fa3a9ba-60d7-4631-b943-\
e6665ded8895"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RotationAxis", "::", "usage"}], 
   "=", "\"\<RotationAxis is an option to PolygonalEllipseArc3D that \
specifies the axis of rotation when creating the arc.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.59180093314872*^9, 3.591801017458861*^9}, {
   3.591801128473906*^9, 3.591801267924249*^9}, 3.595973397009824*^9, 
   3.5959778496531887`*^9, 3.595982783597744*^9, {3.703969995196047*^9, 
   3.703969995691972*^9}},
 CellLabel->
  "In[619]:=",ExpressionUUID->"33b13f81-0133-4b93-8b20-fd9d57396e78"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PolygonalEllipseArc3D", "::", "badmet"}], 
   "=", "\"\<ArcMethod\[Rule]`1` is not a valid option.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{3.703970498969211*^9},
 CellLabel->
  "In[620]:=",ExpressionUUID->"319ca747-4e5f-4a8e-9997-53f54075bf1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PolygonalEllipseArc3D", "::", "baddiv"}], 
   "=", "\"\<The value of ArcDivisions (`1`) must be \[GreaterEqual]1\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{3.703970504585232*^9},
 CellLabel->
  "In[621]:=",ExpressionUUID->"c8c2aa06-6959-4e40-b9f6-053dbe20273b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PolygonalEllipseArc3D", "::", "misrot"}], 
   "=", "\"\<Points `1` and `2` are diametrically opposite; you must provide \
a value for option RotationAxis.\>\""}], ";"}]], "Input",
 CellLabel->
  "In[622]:=",ExpressionUUID->"ff883f40-3064-4140-b4fa-48d9f9bfa994"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PolygonalEllipseArc3D", "::", "badrot"}], 
   "=", "\"\<RotationAxis\[Rule]`1` is not perpendicular to directions `2` \
and `3`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.48369126326139*^9, 3.483691306120932*^9}, 
   3.48405616628185*^9, {3.484057490022403*^9, 3.484057502061843*^9}, {
   3.5959733971242447`*^9, 3.595973397338235*^9}, {3.595977849687953*^9, 
   3.595977849756291*^9}, {3.595982783695271*^9, 3.5959827838978443`*^9}, {
   3.703970016059853*^9, 3.703970017018762*^9}, {3.703970495987401*^9, 
   3.703970510937193*^9}},
 CellLabel->
  "In[623]:=",ExpressionUUID->"8cf42d92-2f1a-43b5-99e1-3fa1cda4919a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PolygonalEllipseArc3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ArcDivisions", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ArcMaximumAngle", "\[Rule]", 
      RowBox[{"5", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"ArcMethod", "\[Rule]", "InscribedArc"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ArcDirection", "\[Rule]", "CCW"}], ",", "\[IndentingNewLine]", 
     RowBox[{"RotationAxis", "\[Rule]", "Automatic"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.483691087025951*^9, 3.4836911182947493`*^9}, {
   3.48403911177534*^9, 3.4840391137271233`*^9}, {3.484056699925251*^9, 
   3.48405670893934*^9}, 3.595973397437779*^9, 3.595977849788549*^9, 
   3.595982783996252*^9, {3.650299060858073*^9, 3.650299068409558*^9}, 
   3.66898434833807*^9, 3.668984902001281*^9, 3.7039700879028816`*^9, {
   3.703970170959115*^9, 3.703970171781142*^9}},
 CellLabel->
  "In[624]:=",ExpressionUUID->"c189c106-0b30-4204-8a5b-340d3e9bd514"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonalEllipseArc3D", "[", 
   RowBox[{"p1_List", ",", " ", "p2_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "ama", ",", "am", ",", "ad", ",", "ra", ",", "m1", ",", "m2", ",",
       "x", ",", "y", ",", "u", ",", "z", ",", "a", ",", "dw", ",", "w", ",", 
      "r"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{
       RowBox[{"ArcDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonalEllipseArc3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ama", "=", 
      RowBox[{
       RowBox[{"ArcMaximumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonalEllipseArc3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"am", "=", 
      RowBox[{
       RowBox[{"ArcMethod", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonalEllipseArc3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ad", "=", 
      RowBox[{
       RowBox[{"ArcDirection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonalEllipseArc3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ra", "=", 
      RowBox[{
       RowBox[{"RotationAxis", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonalEllipseArc3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "<", "1"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"PolygonalEllipseArc3D", "::", "baddiv"}], ",", "n"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"InscribedArc", ",", "CircumscribedArc"}], "}"}], ",", 
          "am"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"PolygonalEllipseArc3D", "::", "badmet"}], ",", "am"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"m1", "=", 
      RowBox[{"Mag", "[", "p1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m2", "=", 
      RowBox[{"Mag", "[", "p2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{"p1", "/", "m1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ra", "===", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"calculate", " ", "RotationAxis"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"u", "=", 
         RowBox[{"x", "\[Cross]", "p2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mag", "[", "u", "]"}], "\[Equal]", "0"}], " ", ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PolygonalEllipseArc3D", "::", "misrot"}], ",", "p1", ",",
              "p2"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"z", "=", 
         RowBox[{"NormalizeReal", "[", "u", "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "RotationAxis", " ", "was", " ", "explicitly", " ", "provided"}], " ",
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Chop", "[", 
             RowBox[{"ra", ".", "x"}], "]"}], "\[NotEqual]", "0"}], " ", "||",
            " ", 
           RowBox[{
            RowBox[{"Chop", "[", 
             RowBox[{"ra", ".", "p2"}], "]"}], "\[NotEqual]", "0"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PolygonalEllipseArc3D", "::", "badrot"}], ",", "ra", ",",
              "p1", ",", "p2"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"z", "=", 
         RowBox[{"NormalizeReal", "[", "ra", "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"z", "\[Cross]", "x"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{"x", ".", "p2"}], ",", 
        RowBox[{"y", ".", "p2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{"ra", "===", "Automatic"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ad", "===", "CCW"}], ",", "\[IndentingNewLine]", 
         RowBox[{"a", "=", 
          RowBox[{"Mod", "[", 
           RowBox[{"a", ",", 
            RowBox[{"2", "\[Pi]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"a", "=", 
          RowBox[{"Mod", "[", 
           RowBox[{"a", ",", 
            RowBox[{"2", "\[Pi]"}], ",", 
            RowBox[{
             RowBox[{"-", "2"}], "\[Pi]"}]}], "]"}]}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"n", ",", 
        RowBox[{"Ceiling", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"Abs", "[", "a", "]"}], "]"}], "/", "ama"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dw", "=", 
      RowBox[{"1", "/", "n"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"am", ",", "\[IndentingNewLine]", "InscribedArc", ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "p1", "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox["m1", 
             RowBox[{"(", 
              RowBox[{"1", "-", "w"}], ")"}]], 
            SuperscriptBox["m2", 
             RowBox[{"(", "w", ")"}]], 
            RowBox[{
             RowBox[{"U", "[", 
              RowBox[{"w", " ", "a"}], "]"}], ".", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"w", ",", "dw", ",", 
             RowBox[{"1", "-", "dw"}], ",", "dw"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "p2", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
       "CircumscribedArc", ",", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"Sec", "[", 
          RowBox[{"a", " ", 
           RowBox[{"dw", "/", "2"}]}], "]"}]}], ";", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "p1", "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"r", " ", 
             SuperscriptBox["m1", 
              RowBox[{"(", 
               RowBox[{"1", "-", "w"}], ")"}]], 
             SuperscriptBox["m2", 
              RowBox[{"(", "w", ")"}]], 
             RowBox[{
              RowBox[{"U", "[", 
               RowBox[{"w", " ", "a"}], "]"}], ".", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"w", ",", 
              RowBox[{"dw", "/", "2"}], ",", 
              RowBox[{"1", "-", 
