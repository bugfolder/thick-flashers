             RowBox[{"(", 
              RowBox[{"i", "-", "1"}], ")"}], "1.5", "t"}], ",", "0", ",", 
            "0"}], "}"}], "+", "#"}], "&"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"panelparts", "\[LeftDoubleBracket]", 
         RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "=", 
        RowBox[{"TransformGC", "[", 
         RowBox[{
          RowBox[{"panelparts", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", "xfrm"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"panelparts", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "k", ",", "j"}], "\[RightDoubleBracket]"}], "=", 
            RowBox[{"TransformGC", "[", 
             RowBox[{
              RowBox[{"panelparts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "k", ",", "j"}], "\[RightDoubleBracket]"}], ",",
               "xfrm"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", 
              RowBox[{"panelparts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "k"}], "\[RightDoubleBracket]"}], "]"}]}], 
            "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "2", ",", "4"}], "}"}]}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "panels", "]"}]}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "&"}], "/@", "panelparts"}], ",", "SolidStyle"}], "]"}], ",", 
         RowBox[{"(*", " ", "panels", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "&"}], "/@", "panelparts"}], ",", "LightGray", ",", 
           RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}], ",", 
         RowBox[{"(*", " ", "cutouts", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
             "&"}], "/@", "panelparts"}], ",", "Orange", ",", 
           RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
         RowBox[{"(*", " ", "knuckles", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
             "&"}], "/@", "panelparts"}], ",", "Purple"}], "]"}], ",", 
         RowBox[{"(*", " ", "holes", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", ".2"}], ",", 
            RowBox[{"d", "+", ".2"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Panels and hinge parts, exploded\>\""}]}], 
      "]"}], "//", "Print"}], ";"}]}], "\[IndentingNewLine]", "]"}]], "Input",\

