      RowBox[{"{", 
       RowBox[{"2", ",", "0.5"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1.5", ",", "0.1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pp", "=", 
      RowBox[{"Reflect2D", "[", 
       RowBox[{"p", ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
