Cell[TextData[{
 "RotateGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Phi]]\n\t(checked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.706822837587078*^9, 3.70682288396387*^9}, {
  3.706822939116528*^9, 3.7068229396121387`*^9}, {3.7221018478705606`*^9, 
  3.722101849333711*^9}},ExpressionUUID->"43c89133-b400-4cd2-a9b6-\
f1f684d33f63"],

Cell[TextData[{
 "RotateGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Phi]] rotates the folded form of a graph through angle \[Phi] about its \
centroid."
}], "Text",
 CellChangeTimes->{{3.706822926349248*^9, 3.706822954403977*^9}, {
  3.706823035766759*^9, 3.706823037180987*^9}, {3.7221018507817717`*^9, 
  3.722101850957979*^9}},ExpressionUUID->"34d1b2f8-4776-41cf-be02-\
7b85133142ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotateGraph", "[", 
   RowBox[{
    StyleBox["tobj_",
     FontSlant->"Italic"], ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "ctr", ",", "rr"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "RotateGraph"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#1", "]"}], "+", 
             RowBox[{"Min", "[", "#1", "]"}]}], ")"}], "/", "2"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#2", "]"}], "+", 
             RowBox[{"Min", "[", "#2", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "&"}], "@@", 
       RowBox[{"Transpose", "[", "verts", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rr", "=", 
      RowBox[{"RotationMatrix2D", "[", "\[Phi]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"rr", ".", 
          RowBox[{"(", 
           RowBox[{"#", "-", "ctr"}], ")"}]}]}], "&"}], "/@", "verts"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices", "\[Rule]", "verts"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627767928398541*^9, 3.627768044131306*^9}, {
  3.627768136345787*^9, 3.627768244068619*^9}, {3.627768277187147*^9, 
