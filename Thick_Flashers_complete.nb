Cell[CellGroupData[{

Cell[TextData[{
 "OrientPolygonsSimpleGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.9119763356819267`*^9, 3.911976343864335*^9}, 
   3.911988071207226*^9, 
   3.913540880236452*^9},ExpressionUUID->"42b3d099-30e0-460c-919b-\
bb402ee4da43"],

Cell[TextData[{
 "OrientPolygonsSimpleGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 "] takes a GraphicsComplex of a polyhedron and reorients the faces if \
necessary so they all face outward."
}], "Text",
 CellChangeTimes->{{3.911976347634354*^9, 3.91197636053196*^9}, {
   3.911976412664996*^9, 3.911976459154559*^9}, 3.911988071235038*^9, {
   3.913391454397596*^9, 3.913391456096531*^9}, 
   3.913540880259451*^9},ExpressionUUID->"e5afc49a-880b-4282-a392-\
75eb56d1855a"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["gc",
  FontSlant->"Italic"],
 " \[LongDash] a GraphicsComplex containing a list of Polygons for the face."
}], "Text",
 CellChangeTimes->{{3.911976462585126*^9, 
  3.911976479576161*^9}},ExpressionUUID->"661b518d-5113-4e18-b987-\
3d0242b3f6c7"],

Cell["\<\
Returns: a modified version of the GraphicsComplex with reoriented faces.\
\>", "Text",
 CellChangeTimes->{{3.9119764827527103`*^9, 3.911976494628407*^9}, {
  3.911993651383559*^9, 
  3.911993656661178*^9}},ExpressionUUID->"cb077dd6-6324-4552-acac-\
9d0b34be6443"],

Cell["\<\
This function is useful when you are programmatically building a GC \
polyhedron and the face orientation isn\[CloseCurlyQuote]t easily controlled \
during the construction. Just build all the faces in the most convenient way, \
then run this function to clean things up.\
\>", "Text",
 CellChangeTimes->{{3.911993667343175*^9, 
  3.9119937388919*^9}},ExpressionUUID->"796ad623-2465-45e8-afe1-eaea36c85553"],

Cell["\<\
This is a quick-and-dirty implementation that required that the centroid of \
the vertices be enclosed by the polyhedron, which is how we determine the \
correct orientation of the faces. So this function is likely to break with \
non-convex polyhedra. (Hence the \[OpenCurlyDoubleQuote]Simple\
\[CloseCurlyDoubleQuote] in the name of the function.)\
\>", "Text",
 CellChangeTimes->{{3.911976496813527*^9, 3.911976553206418*^9}, {
  3.911978603155527*^9, 3.911978638694127*^9}, {3.911978723983173*^9, 
  3.911978732356358*^9}, {3.913540814231558*^9, 3.913540842874975*^9}, {
  3.9135409072194357`*^9, 
  3.913540922861244*^9}},ExpressionUUID->"8bfe6e56-184e-4414-861f-\
df3fb3bade56"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrientPolygonsSimpleGC", "[", "gc_GraphicsComplex", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pts", ",", "polys", ",", "ctrd", ",", "epolys", ",", "dx", ",", "dy", ",",
       "dz"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pts", ",", "polys"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"First", "/@", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{
           "gc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{"Polygon", "[", "_", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"embed", " ", "the", " ", "polys"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"epolys", "=", 
      RowBox[{"Embed", "[", 
       RowBox[{"pts", ",", "polys", ",", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Centroid", " ", "of", " ", "the", " ", "polyhedron"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ctrd", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Plus", "@@", "pts"}], ")"}], "/", 
       RowBox[{"Length", "[", "pts", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Reverse", " ", "some", " ", "faces", " ", "based", " ", "on", " ", 
       "winding", " ", "relative", " ", "to", " ", "the", " ", "centroid"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "\[LeftDoubleBracket]", 
                 RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "-", 
                RowBox[{"#", "\[LeftDoubleBracket]", 
                 RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ")"}], 
              "\[Cross]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "\[LeftDoubleBracket]", 
                 RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], "-", 
                RowBox[{"#", "\[LeftDoubleBracket]", 
                 RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
               ")"}]}], ")"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Plus", "@@", 
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], ")"}], "/", 
               RowBox[{"Length", "[", 
                RowBox[{
                "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                "]"}]}], "-", "ctrd"}], ")"}]}], ">", "0"}], ",", 
          RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"Reverse", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
           "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"epolys", ",", "polys"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsComplex", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"Polygon", "/@", "polys"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 CellChangeTimes->{{3.9119765559351597`*^9, 3.911976648282436*^9}, {
   3.911976916994948*^9, 3.911976932943645*^9}, {3.9119771986761303`*^9, 
   3.91197720237996*^9}, {3.911977241109305*^9, 3.911977317598198*^9}, {
