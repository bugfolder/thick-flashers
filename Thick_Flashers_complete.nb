Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RecoverCurve3DSystem", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.690971199004568*^9, 3.690971217037642*^9}, 
   3.690988493844738*^9, 3.691164193355864*^9, 3.69118372085557*^9, 
   3.691241322190337*^9, 3.691252750688355*^9, {3.691697849118641*^9, 
   3.691697865164342*^9}, 3.6916979882239017`*^9, {3.691698197837618*^9, 
   3.6916982041370277`*^9}, {3.6916982530079403`*^9, 3.691698265816877*^9}, 
   3.691921637022266*^9, 3.691921671632251*^9, 3.691921709979253*^9, {
   3.691921857058308*^9, 3.691921858501229*^9}, 3.800465142209219*^9, 
