Cell[CellGroupData[{

Cell["Patches and periodic tilings", "Section",
 CellChangeTimes->{{3.631139362752641*^9, 3.631139368822822*^9}, 
   3.6311867479989443`*^9, {3.707760966524195*^9, 
   3.707760984403831*^9}},ExpressionUUID->"6d08cb8e-1f2d-45ed-9032-\
44722f3e9b37"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.631139381576559*^9, 
  3.631139381973662*^9}},ExpressionUUID->"774feb71-827a-4ef5-9668-\
dab289ff2d6c"],

Cell["\<\
While one can build up a tiling by manually assembling tilespecs one by one, \
that can get tedious for very large tilings. Many tilings are periodic, \
though, and so one can build up fairly large tilings by replicating patches \
of tilespecs on a lattice. This section builds tools for creating such \
tilings, and in particular, implements all of the Archimedean tilings \
\[LongDash] the 1-vertex-uniform tilings composed of regular polygons. With \
these tilings, we can construct both regular twist tilings and, for the \
2-colorable Archimedean tilings, regular offset twist tilings.\
\>", "Text",
 CellChangeTimes->{{3.627592199730041*^9, 3.627592359112287*^9}, {
  3.627602886809663*^9, 
  3.627602908518868*^9}},ExpressionUUID->"b00c7974-d1b4-42e1-bb31-\
841635f8cb42"]
}, Closed]],

Cell[CellGroupData[{

Cell["Patches", "Subsection",
 CellChangeTimes->{{3.631139444891183*^9, 
  3.631139452705399*^9}},ExpressionUUID->"48d8877d-7f5e-41b5-a1b0-\
27480e4c0c62"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.6311399273010077`*^9, 
  3.631139927739946*^9}},ExpressionUUID->"b9cf0d52-1bf0-40ce-855e-\
2fa2cdda5366"],

Cell[TextData[{
 "A ",
 StyleBox["patch",
  FontSlant->"Italic"],
 " is a piece of a tiling with the same format as a tiling, i.e., a list of \
",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 ". In a periodic tiling, we replicate a patch on a set of lattice vectors."
}], "Text",
 CellChangeTimes->{{3.631139457545679*^9, 
  3.631139529476836*^9}},ExpressionUUID->"21f9f9c4-7a90-41c1-a820-\
3c2652755f48"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RegularizePatch[",
 StyleBox["patch",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.631128214309588*^9, 
  3.6311282203431683`*^9}},ExpressionUUID->"4dd3741b-e0f5-47c1-a5aa-\
a699db1c92f6"],

Cell[TextData[{
 "RegularizePatch[",
 StyleBox["patch",
  FontSlant->"Italic"],
 "] takes a patch and returns the same version but in which every ",
 StyleBox["tilespec",
  FontSlant->"Italic"],
 " has explicit ",
 StyleBox["offset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", ",
 StyleBox["scale",
  FontSlant->"Italic"],
 " entries."
}], "Text",
 CellChangeTimes->{{3.63112823846246*^9, 3.631128260876152*^9}, {
  3.631139558036737*^9, 3.631139577401754*^9}, {3.63113994627528*^9, 
  3.631139958674532*^9}},ExpressionUUID->"fb29711f-147e-4bf6-bcff-\
334aedbaf07c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RegularizePatch", "::", "badlen"}], 
   "=", "\"\<`1` has the wrong length to be in a tiling.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.631128441625958*^9, 3.631128484001335*^9}},
 CellLabel->
  "In[3087]:=",ExpressionUUID->"dbff088e-3cc2-44c3-af8b-22a0d0482e02"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RegularizePatch", "[", "patch_List", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"Length", "[", "#", "]"}], ",", "\[IndentingNewLine]", "4", ",",
        "#", ",", "\[IndentingNewLine]", "3", ",", 
       RowBox[{"Append", "[", 
        RowBox[{"#", ",", "1"}], "]"}], ",", "\[IndentingNewLine]", "2", ",", 
       
       RowBox[{"Join", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]",
        "1", ",", 
       RowBox[{"Join", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", "0", ",", "1"}], "}"}]}], 
        "]"}], ",", "\[IndentingNewLine]", "_", ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"RegularizePatch", "::", "badlen"}], ",", "#"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], "&"}], "/@", "patch"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.631128228630692*^9, 3.6311282286462*^9}, {
  3.631128274814596*^9, 3.631128318968787*^9}, {3.631128349967626*^9, 
  3.63112843083736*^9}, {3.631128491879141*^9, 3.631128493422545*^9}},
 CellLabel->
  "In[3088]:=",ExpressionUUID->"fb24680b-872e-4d37-b212-c8f7a3fb95ad"],

