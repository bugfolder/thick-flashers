 RowBox[{
  RowBox[{"TriangleSignedArea2D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.595804029849597*^9, 3.595804045925337*^9}, {
