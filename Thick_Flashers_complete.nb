          RowBox[{"{", "p2", "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       "_", ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"PolygonalEllipseArc3D", "::", "badmet"}], ",", "am"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
