Cell[BoxData[
 RowBox[{"temp", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "ffprules", ",", 
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "2"}], ",", 
      RowBox[{"m", "=", "5"}], ",", 
      RowBox[{"t", "=", "0.2"}], ",", "lines", ",", "fsverts", ",", 
      "gverts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ffprules", "=", 
      RowBox[{"MakeThickFlasherFFProjectionRules", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}], ",", 
        RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"lines", "=", 
        RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ")"}], "//", 
      "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gverts", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"lines", ",", 
         SubscriptBox["p", 
          RowBox[{"_", ",", "_", ",", "_"}]], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fsverts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"FlasherSectorVerticesRadiallyOrdered", "[", 
        RowBox[{"p", ",", "r", ",", "h"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Show", " ", "the", " ", "first", " ", "two", " ", "quadrants", " ", 
       "with", " ", "all", " ", 
       RowBox[{"vertices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Arrow", "[", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "]"}], ",", 
              RowBox[{"Switch", "[", 
               RowBox[{
                RowBox[{
                "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                ",", "\"\<mj\>\"", ",", 
                RowBox[{"Lighter", "[", 
                 RowBox[{"Red", ",", "0.75"}], "]"}], ",", "\"\<mn\>\"", ",", 
                
                RowBox[{"Lighter", "[", 
                 RowBox[{"Blue", ",", "0.75"}], "]"}], ",", "\"\<dg\>\"", ",",
                 "Green"}], "]"}]}], "]"}], "&"}], "/@", "lines"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"FlasherVertexLabel", "[", 
             RowBox[{"\"\<p\>\"", ",", "#"}], "]"}], "&"}], "/@", "gverts"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], "/.", 
        RowBox[{"FlasherDefaultCPRules", "[", 
         RowBox[{"p", ",", "m"}], "]"}]}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Show", " ", "the", " ", "FFP", " ", "with", " ", "first"}], "-", 
       RowBox[{"sector", " ", "vertices", " ", "labeled"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"FlasherLines", "[", 
          RowBox[{"p", ",", "r", ",", "h", ",", "m"}], "]"}], "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["p", 
           RowBox[{"i_", ",", "j_", ",", 
            RowBox[{"-", "1"}]}]], "->", 
          SubscriptBox["p", 
           RowBox[{"i", ",", "j", ",", 
            RowBox[{"m", "-", "1"}]}]]}], "}"}]}], "/.", "ffprules"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
