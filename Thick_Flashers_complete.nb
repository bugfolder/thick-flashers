Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "PolygonTwistTile", ",", "verts_List", ",", " ", "w_", ",", "d_", ",", 
      " ", "\[Tau]_", ",", "ccw_", ",", "types_List"}], "}"}], ",", 
    "TGraphAssigned", ",", "opts___"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "gverts", ",", "dirs", ",", "cverts", ",", "averts", ",", 
      "edges", ",", "atypes", ",", "twistface", ",", "faces", ",", "pleats", ",",
       "wedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TileCheckTypes", "[", 
      RowBox[{"verts", ",", "types"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"vertices", " ", "on", " ", "tile", " ", "boundary"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gverts", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"1", "+", "w"}], "2"], "#1"}], "+", 
            RowBox[{
             FractionBox[
              RowBox[{"1", "-", "w"}], "2"], "#2"}], "+", 
            RowBox[{"d", 
             RowBox[{"(", 
              RowBox[{"#2", "-", "#1"}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"1", "-", "w"}], "2"], "#1"}], "+", 
            RowBox[{
             FractionBox[
              RowBox[{"1", "+", "w"}], "2"], "#2"}], "+", 
            RowBox[{"d", 
             RowBox[{"(", 
              RowBox[{"#2", "-", "#1"}], ")"}]}]}]}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"verts", ",", 
          RowBox[{"RotateLeft", "[", "verts", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", "\[Tau]", "]"}], ".", "#"}], "&"}], 
       "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"RotateLeft", "[", "verts", "]"}], "-", "verts"}], ")"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"central", " ", "polygon", " ", "vertices"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cverts", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"LineInt2D", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "&"}], "/@", "gverts"}], ",", "dirs", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
            "&"}], "/@", 
           RowBox[{"RotateRight", "[", "gverts", "]"}]}], ",", 
          RowBox[{"RotateRight", "[", "dirs", "]"}]}], "}"}]}], "]"}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{"all", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"averts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{"Append", ",", 
          RowBox[{"{", 
           RowBox[{"gverts", ",", "cverts"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "5"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "4"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "8"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "8"}], "}"}]}], "}"}], "+", 
             RowBox[{"4", "i"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        RowBox[{"4", "n"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"atypes", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"B", ",", "B", ",", "B", ",", 
           RowBox[{"If", "[", 
            RowBox[{"ccw", ",", "#", ",", 
             RowBox[{"InvertFoldType", "[", "#", "]"}]}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{"ccw", ",", 
             RowBox[{"InvertFoldType", "[", "#", "]"}], ",", "#"}], "]"}], ",",
            "#"}], "}"}], "&"}], "/@", "types"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pleats", "=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "3", ",", "8", ",", "4"}], "}"}], "+", 
           RowBox[{"4", "i"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"4", "n"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"wedges", "=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "4", ",", 
             RowBox[{"-", "1"}]}], "}"}], "+", 
           RowBox[{"4", "i"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"4", "n"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"twistface", "=", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"4", "i"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
        RowBox[{"4", "n"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "twistface", "}"}], ",", "pleats", ",", "wedges"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"averts", ",", "edges", ",", "faces"}], "]"}], "//", 
       RowBox[{"AddTAssigned", "[", "atypes", "]"}]}], "//", 
      RowBox[{"AddTTwistGraph", "[", 
       RowBox[{"{", "1", "}"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
