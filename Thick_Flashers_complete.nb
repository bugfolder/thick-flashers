Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"poly", ",", "segments", ",", "csegments"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"poly", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", ".5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"segments", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0.75"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "0.75"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csegments", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ClipSegmentSetToQuasiConvexPolygonExterior", "[", 
         RowBox[{"#", ",", "poly"}], "]"}], "&"}], "/@", "segments"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"LightGray", ",", 
         RowBox[{"Polygon", "[", "poly", "]"}], ",", "\[IndentingNewLine]", 
         "Gray", ",", 
         RowBox[{"SegmentSetLine", "/@", "segments"}], ",", 
         "\[IndentingNewLine]", "Red", ",", 
         RowBox[{"Thickness", "[", ".01", "]"}], ",", 
         RowBox[{"SegmentSetLine", "/@", "csegments"}]}], "}"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], 
