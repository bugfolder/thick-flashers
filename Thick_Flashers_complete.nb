          RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", "dirs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Vertex3DFoldedFormGraphics3D", "[", 
       RowBox[{"tobj", ",", "\[IndentingNewLine]", 
        RowBox[{"DihedralAngleLabels", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "Italic", ",", " ", "16"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<a\>\"", " ", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], 
            "}"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"SectorAngleLabels", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "Italic", ",", " ", "16"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\""}], 
            "}"}]}], ")"}]}]}], "]"}], "/.", 
      RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "ShowExample"}]], "Input",
