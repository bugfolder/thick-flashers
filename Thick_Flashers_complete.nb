   3.800016533800769*^9},ExpressionUUID->"621f83e3-a96f-4f9d-b51b-\
138e585681a3"],

Cell[TextData[{
 "StyledSurfaceNormalGrid[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates an array of styled surface normal vectors for a surface."
}], "Text",
 CellChangeTimes->{{3.6912825086792*^9, 3.6912825277633877`*^9}, {
   3.691282564182978*^9, 3.691282567522933*^9}, {3.6912828158255987`*^9, 
   3.691282828806187*^9}, 3.691283924876347*^9, {3.691283956369951*^9, 
