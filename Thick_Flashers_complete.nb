Cell[CellGroupData[{

Cell["Unit cyclic Brocard polygon offset twist tiles", "Subsection",
 CellChangeTimes->{{3.631893620259907*^9, 3.631893629726188*^9}, {
  3.631893671732411*^9, 3.63189367320183*^9}, {3.633536999664282*^9, 
  3.633537000543324*^9}},ExpressionUUID->"b84c9b8f-7765-48d3-9c86-\
a5c06a477351"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.6318936610212383`*^9, 
  3.631893661452156*^9}},ExpressionUUID->"a5b358e8-0dc6-4417-9c6c-\
f0ba31caded8"],

Cell[TextData[{
 "In order to form a generic offset twist tile (one that works for any (",
 StyleBox["w,d",
  FontSlant->"Italic"],
 ") combination), the polygon must be cyclic AND must be a Brocard polygon. \
In a Brocard polygon, for a given set of corner angles, the relative side \
lengths are unique. For a cyclic quadrilateral, diagonally opposite angles \
must sum to 180\[Degree]. For higher-order polygons, it\[CloseCurlyQuote]s \
not so simple, but in general, the entire polygon is uniquely specified by \
its first two corner angles."
}], "Text",
 CellChangeTimes->{{3.631893700531504*^9, 3.631893849640673*^9}, {
  3.6335376197461977`*^9, 
  3.633537638374497*^9}},ExpressionUUID->"a4dcfd21-dcfa-4ec4-9689-\
e09ff1d43cb9"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "{UnitCyclicBrocardPolygonOffsetTwistTile, {",
 StyleBox["n, angle1, angle2, i1, i2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.6335370129671397`*^9, 3.633537038421068*^9}, {
  3.633537773886174*^9, 3.633537778925704*^9}, {3.633538503976835*^9, 
  3.633538508679116*^9}},ExpressionUUID->"8ca71f73-302b-465b-8a10-\
444b122fcb34"],

Cell[TextData[{
 "{UnitCyclicBrocardPolygonOffsetTwistTile, {",
 StyleBox["angle1, i1, angle2, i2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} represents an offset twist in a symmetric unit cyclic Brocard polygon \
with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " sides, the ",
 StyleBox["i1",
  FontSlant->"Italic"],
 "th corner angle ",
 StyleBox["angle1",
  FontSlant->"Italic"],
 ", the ",
 StyleBox["i2",
  FontSlant->"Italic"],
 "th corner angle ",
 StyleBox["angle2",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of the pleat where it subtends the edge, ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the offset, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
