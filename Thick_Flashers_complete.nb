Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "xmin", ",", "xmax", ",", "ymin", ",", "ymax", ",", "p1", ",", "p2", ",",
        "p3", ",", "p4", ",", "dr"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xmin", ",", "xmax", ",", "ymin", ",", "ymax"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2", ",", "0", ",", "1"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p1", "=", 
       RowBox[{"{", 
        RowBox[{"xmin", ",", "ymin"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"p2", "=", 
       RowBox[{"{", 
        RowBox[{"xmax", ",", "ymin"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"p3", "=", 
       RowBox[{"{", 
        RowBox[{"xmax", ",", "ymax"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"p4", "=", 
       RowBox[{"{", 
        RowBox[{"xmin", ",", "ymax"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"{", 
              RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], "]"}], ",",
             "PaperWhiteSideFill"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4", ",", "p1"}], 
              "}"}], "]"}], ",", "BorderLine"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "t"}], ")"}], "p1"}], "+", 
                  RowBox[{"t", " ", "p2"}]}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "t"}], ")"}], "p4"}], "+", 
                  RowBox[{"t", " ", "p3"}]}]}], "}"}], "]"}], ",", 
              RowBox[{"Which", "[", 
               RowBox[{
                RowBox[{"t", ">", 
                 RowBox[{"1", "/", "2"}]}], ",", "ValleyRulingLine", ",", 
                RowBox[{"t", "<", 
                 RowBox[{"1", "/", "2"}]}], ",", "MountainRulingLine", ",", 
                "True", ",", "UndefinedRulingLine"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "1", ",", 
              RowBox[{"1", "/", "10"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{".67", " ", "p1"}], "+", 
                RowBox[{".33", "p4"}]}], ",", 
               RowBox[{
                RowBox[{".67", "p2"}], "+", 
                RowBox[{".33", "p3"}]}]}], "}"}], "]"}], ",", "ValleyLine"}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{".33", " ", "p1"}], "+", 
                RowBox[{".67", "p4"}]}], ",", 
               RowBox[{
                RowBox[{".33", "p2"}], "+", 
                RowBox[{".67", "p3"}]}]}], "}"}], "]"}], ",", 
            "MountainLine"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
    "//", "ShowExample"}], "\[IndentingNewLine]"}]], "Input",
