Cell[BoxData[
 RowBox[{
  RowBox[{"MakeOriceps", "[", 
   RowBox[{"\[Gamma]_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "od", ",", "x1", ",", "x2", ",", "x3", ",", "y1", ",", "y2", ",", "y3", ",",
       "verts", ",", "edges", ",", "tobj", ",", "a", ",", "g1", ",", "g2", ",",
       "g3", ",", "g4", ",", "types", ",", "sangles", ",", "foldangles"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"od", "=", 
      RowBox[{
       RowBox[{"OricepsDimensions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeOriceps", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3", ",", "y1", ",", "y2", ",", "y3"}], 
       "}"}], "=", "od"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "x1"}], ",", 
          RowBox[{"-", "y3"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x1", ",", 
          RowBox[{"-", "y3"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "x3"}], ",", 
          RowBox[{"-", "y1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "x2"}], ",", 
          RowBox[{"-", "y2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x2", ",", 
          RowBox[{"-", "y2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x3", ",", 
          RowBox[{"-", "y1"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "x3"}], ",", "y1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "x2"}], ",", "y2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x2", ",", "y2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x3", ",", "y1"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "x1"}], ",", "y3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x1", ",", "y3"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "12"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"11", ",", "12"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"12", ",", "10"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "B", ",", "B", ",", "V", ",", "V", ",", "V", ",", "M", ",", 
        "V", ",", "B", ",", "V", ",", "V", ",", "B", ",", "V", ",", "M", ",", 
        "V", ",", "V", ",", "V", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraphAssigned", "[", 
        RowBox[{"verts", ",", "edges", ",", 
         RowBox[{"{", "}"}], ",", "types"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "relevant", " ", "dihedral", " ", "angles"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sangles", "=", 
      RowBox[{"RotationAngles", "[", 
       RowBox[{
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "9", "\[RightDoubleBracket]"}], ",", 
        
        RowBox[{"verts", "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"5", ",", "10", ",", "12", ",", "8"}], "}"}], 
         "\[RightDoubleBracket]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g1", ",", "g2", ",", "g3", ",", "g4"}], "}"}], "=", 
      RowBox[{"MakeDihedralsFromSectorsAndMajorDihedral", "[", 
       RowBox[{"sangles", ",", "\[Gamma]", ",", 
        RowBox[{"AllowSelfIntersection", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "g3", ",", "g3", ",", "g2", ",", "g4", ",",
         "g2", ",", "0", ",", "g1", ",", "g1", ",", "0", ",", "g2", ",", "g4",
         ",", "g2", ",", "g3", ",", "g3", ",", "0", ",", "0", ",", "0"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj", ",", "foldangles", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "5"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"ReassignGraphAssigned", "[", 
       RowBox[{"tobj", ",", "foldangles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Rotate", " ", "to", " ", "point", " ", "in"}], " ", "+", 
       RowBox[{"x", " ", "direction"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"ReplacePropertyIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"Vertices3D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RotationYMatrix3D", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", "#"}], "&"}], "/@", 
          RowBox[{"tobj", "[", "Vertices3D", "]"}]}], ")"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.7575055751307592`*^9, 3.757505770830198*^9}, {
   3.757505802437085*^9, 3.7575058099638166`*^9}, {3.757505875422663*^9, 
