 StyleBox["p3",
  FontSlant->"Italic"],
 "]\nTriangleCriticalTwistAngles[",
 StyleBox["angles",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.627497362959807*^9, 
  3.627497365169674*^9}},ExpressionUUID->"dd190996-ad0e-4676-8ed7-\
58ca9e89d37b"],

Cell[TextData[{
 "TriangleCriticalTwistAngles[",
 StyleBox["p1, p2, p3",
  FontSlant->"Italic"],
 "] returns the critical twist angle range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["\[Alpha]", "crit"]}], TraditionalForm]],ExpressionUUID->
  "8cb21b6e-769f-4ae9-9a75-cbb137fb366a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "-", 
    SubscriptBox["\[Alpha]", "crit"]}], TraditionalForm]],ExpressionUUID->
  "705fd124-9314-4082-b425-83cde1777ef5"],
 "} for a triangular polygon given its endpoints. For twist angles within \
this range, there is a NAE 3-SAT assignment condition."
}], "Text",
 CellChangeTimes->{{3.627432296836474*^9, 3.6274322988603706`*^9}, {
  3.627497380526485*^9, 
  3.6274974398428087`*^9}},ExpressionUUID->"a4e4f65c-b7d1-42b0-9fa8-\
9e0bdd083235"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleCriticalTwistAngles", "[", 
   RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "]"}], ":=", 
  RowBox[{"ThreeCycleCriticalTwistAngles", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p2", ",", "p3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p3", ",", "p1"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.627497475539743*^9, 3.627497476907898*^9}, 
   3.627501315464421*^9},
 CellLabel->
  "In[2701]:=",ExpressionUUID->"af9d45b8-4d9f-44b7-8c6b-64faae489d4a"],

Cell["\<\
Example. Triangle critical twist angles from the input angles of the triangle.\
\>", "Text",
 CellChangeTimes->{{3.627431402399906*^9, 3.627431414053012*^9}, {
  3.627431569900716*^9, 
  3.627431570282897*^9}},ExpressionUUID->"b363faee-03ca-43dc-83e7-\
4f61cf694dc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"TriangleCriticalTwistAngles", "@@", 
    RowBox[{"UnitTriangleVertices", "[", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "}"}], 
     "]"}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.627431416394696*^9, 3.627431490931484*^9}, {
  3.627431536343641*^9, 3.627431558159634*^9}, {3.628778001444476*^9, 
  3.628778010077805*^9}},
 CellLabel->
  "In[2702]:=",ExpressionUUID->"69d67875-b368-4abe-a2aa-458b78e2b0a1"],

Cell["\<\
We use that result in the next function, along with this simplification \
showing that for triangle angles, the numerator and denominator of this \
expression are the same:\
\>", "Text",
 CellChangeTimes->{{3.627431865377615*^9, 3.62743187016776*^9}, {
  3.62863129339073*^9, 3.628631320963939*^9}, {3.628778083257923*^9, 
  3.628778085287738*^9}},ExpressionUUID->"45334324-0325-47c7-b65d-\
599c76e71ddd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    FractionBox[
     FractionBox[
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]1", "]"}], 
       RowBox[{"Sin", "[", "\[Theta]2", "]"}], 
       RowBox[{"Sin", "[", "\[Theta]3", "]"}]}], 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]1", "]"}], 
        RowBox[{"Cos", "[", "\[Theta]2", "]"}], 
        RowBox[{"Cos", "[", "\[Theta]3", "]"}]}]}]], 
     FractionBox[
      RowBox[{"4", " ", 
       RowBox[{"Sin", "[", "\[Theta]1", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]2", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]3", "]"}]}], 
      RowBox[{"3", "-", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Theta]1"}], "]"}], "-", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Theta]2"}], "]"}], "-", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"\[Pi]", "-", "\[Theta]3"}], ")"}]}], "]"}]}]]], "/.", 
    RowBox[{"\[Theta]3", "\[Rule]", 
     RowBox[{"\[Pi]", "-", 
      RowBox[{"(", 
       RowBox[{"\[Theta]1", "+", "\[Theta]2"}], ")"}]}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.628631248334426*^9, 3.6286312845131893`*^9}, {
  3.628631328288841*^9, 3.628631330150819*^9}, {3.628777203014631*^9, 
  3.62877720978067*^9}},
 CellLabel->
  "In[2703]:=",ExpressionUUID->"1bbfe67a-5254-4e7a-ab12-9f02141006ba"],

Cell[TextData[{
 "TriangleCriticalTwistAngles[",
 StyleBox["angles",
  FontSlant->"Italic"],
 "] returns the critical twist angles for a triangular polygon given its ",
 StyleBox["angles",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.627432282662881*^9, 
  3.627432288572962*^9}},ExpressionUUID->"808636ab-a8bb-4f9f-9d6f-\
c219141604b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleCriticalTwistAngles", "[", "angles_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", "B", ",", "C", ",", "\[Alpha]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A", ",", "B", ",", "C"}], "}"}], "=", "angles"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"Sin", "[", "A", "]"}], 
         RowBox[{"Sin", "[", "B", "]"}], 
         RowBox[{"Sin", "[", "C", "]"}]}], 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"Cos", "[", "A", "]"}], 
          RowBox[{"Cos", "[", "B", "]"}], 
          RowBox[{"Cos", "[", "C", "]"}]}]}]], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", 
       RowBox[{"\[Pi]", "-", "\[Alpha]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.627431603752659*^9, 3.627431640356843*^9}, {
  3.627431688383348*^9, 3.627431730388485*^9}, {3.627431813203163*^9, 
  3.627431846798037*^9}, {3.628631340856454*^9, 3.628631353333909*^9}},
 CellLabel->
  "In[2704]:=",ExpressionUUID->"b1b50b14-78a1-471c-afe1-1cf1cfbb3ca1"],

