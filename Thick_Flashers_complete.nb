Cell["A small example of courteous anarchy.", "Text",
 CellChangeTimes->{{3.627817844460412*^9, 
  3.627817851386504*^9}},ExpressionUUID->"88dc550c-a284-4e48-b100-\
5fd1ad2b3e0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "boundary", ",", "lines", ",", "verts", ",", "edges", ",", "tobj", ",", 
      "tobjw"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"boundary", "=", 
      RowBox[{"SquareVertices", "[", "1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeCourteousAnarchyGraph", "[", 
       RowBox[{"6", ",", "0.1", ",", "boundary", ",", 
        RowBox[{"RandSeed", "\[Rule]", "0"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", "tobj", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"InsetSeparationPlot", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "0.07"}], "}"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjw", "=", 
      RowBox[{"MakeSimpleWovenTessellation", "[", 
       RowBox[{"tobj", ",", "0.035", ",", 
        RowBox[{"WovenParity", "\[Rule]", 
         RowBox[{"-", "1"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobjw", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", 
          RowBox[{
           RowBox[{"FlopGraph2D", "[", "tobjw", "]"}], ",", 
           RowBox[{"FaceupFace", "\[Rule]", 
            RowBox[{"Length", "[", 
             RowBox[{"GetValue", "[", 
              RowBox[{"tobjw", ",", "Faces"}], "]"}], "]"}]}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
