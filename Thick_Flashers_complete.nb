   3.6172509794222403`*^9}},ExpressionUUID->"dd283685-989c-48ec-bb3f-\
eb96e24a6671"],

Cell[TextData[{
 "MakeDevelopableAngles[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 "] takes a list of sector angles and adds another angle that completes a \
developable vertex."
}], "Text",
 CellChangeTimes->{{3.616624191929911*^9, 3.6166242309418373`*^9}, 
   3.617250678310499*^9, 3.617250940824586*^9, {3.6172509883735228`*^9, 
   3.617251011556647*^9}},ExpressionUUID->"2f714a3b-73fd-40bb-87cf-\
a23f276303bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeDevelopableAngles", "[", "sectorangles_List", "]"}], ":=", 
  RowBox[{"Append", "[", 
   RowBox[{"sectorangles", ",", 
    RowBox[{
     RowBox[{"2", "\[Pi]"}], "-", 
     RowBox[{"(", 
      RowBox[{"Plus", "@@", "sectorangles"}], ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.616624245724449*^9, 3.6166242504428043`*^9}, 
   3.617250678331414*^9, 3.617250940842759*^9, {3.617251028306788*^9, 
   3.61725106346222*^9}},
 CellLabel->
