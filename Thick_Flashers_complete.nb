   "=", "\"\<HingeWireSquareCapExtra is a value for the HingeWireSquareCap \
option that specifies the fractional extension to end the wire with a square \
cap.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.920732957632264*^9, 3.920732971113518*^9}, {
  3.92073301637759*^9, 3.920733060977755*^9}, {3.9328354239375896`*^9, 
  3.932835452236363*^9}},
 CellLabel->
  "In[4348]:=",ExpressionUUID->"fea5a6e9-40ed-4504-8ee9-64b852d245f7"]
}, Closed]],

Cell[CellGroupData[{

Cell["HingeWireZ", "Subsubsection",
 CellChangeTimes->{{3.920733140545516*^9, 
  3.920733144929034*^9}},ExpressionUUID->"021974e3-80bd-4991-9443-\
fb73315d0914"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeWireZ", "::", "usage"}], 
   "=", "\"\<HingeWireZ is an option to HingeRectWireGC that specifies the \
local z-direction of the wire.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.92073315760736*^9, 3.92073320116294*^9}, 
   3.920736411502685*^9, 3.932818140140875*^9},
 CellLabel->
  "In[4349]:=",ExpressionUUID->"07713c21-e8de-4419-8cd2-2e8e62db9c2b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "HingeRectWireGC[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HingeThickness, HingeWireWidth, HingeWireCap, \
HingeWireSquareCapExtra, HingeWireZ"
}], "Subsubsection",
 CellChangeTimes->{{3.920732667327209*^9, 3.920732705905075*^9}, {
   3.920732751729525*^9, 3.920732821329223*^9}, {3.92073286368027*^9, 
   3.920732868209622*^9}, {3.920733105951427*^9, 3.920733106689595*^9}, {
   3.920733205529755*^9, 3.920733207185709*^9}, 3.920736411525036*^9, {
   3.932816513510009*^9, 3.932816516118333*^9}, 3.9328181401457376`*^9, {
   3.9328354679036617`*^9, 
   3.932835474015047*^9}},ExpressionUUID->"2acc6f51-c864-48e4-8477-\
c6614d57adee"],

Cell[TextData[{
 "HingeRectWireGC[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a square-cross-section wire hinge between two points p and q."
}], "Text",
 CellChangeTimes->{{3.920732708976368*^9, 3.920732733505413*^9}, {
   3.920733110491634*^9, 3.920733119776909*^9}, 3.920736411551387*^9, 
   3.932818140151931*^9},ExpressionUUID->"435ce504-ae27-4d60-9448-\
c62f7006065a"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 " \[LongDash] the endpoints of the wire"
}], "Text",
 CellChangeTimes->{{3.920732825526593*^9, 
  3.920732861761272*^9}},ExpressionUUID->"a66d1640-9f57-4fd7-b476-\
3ef5a7258d36"],

Cell[TextData[{
 "Options:\n\tHingeThickness \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", specifies the thickness (and possibly width) of the wire.\n\t\
HingeWireWidth \[Rule] ",
 StyleBox["hw",
  FontSlant->"Italic"],
 " | Automatic, specifies the width of the wire. Automatic uses the value of \
HingeThickness.\n\tHingeWireCap \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", specifies the style of the end cap for the wire.\n\t\
HIngeWireSquareCapExtra \[Rule] ",
 StyleBox["f",
  FontSlant->"Italic"],
 ", specifies the fractional extension of the square cap. Only used with \
HingeWireSquareCap.\n\tHingeWireZ \[Rule] ",
 StyleBox["dir",
  FontSlant->"Italic"],
 " | Automatic, specifies the local z-direction for the wire. Doesn\
\[CloseCurlyQuote]t need to be normalized."
}], "Text",
 CellChangeTimes->{{3.92073307937702*^9, 3.920733102769565*^9}, {
  3.920733213273168*^9, 3.92073325155402*^9}, {3.920733501705689*^9, 
  3.920733505377818*^9}, {3.932816532598772*^9, 3.932816576830082*^9}, {
  3.932816608549242*^9, 3.9328166174381638`*^9}, {3.9328354800539303`*^9, 
  3.9328355068709097`*^9}},ExpressionUUID->"ccfd2d12-70c2-4ee9-b5a8-\
6bbaa424d007"],

Cell[TextData[{
 "Returns: a single GraphicsComplex object that implements the square wire \
running from ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.922629842920045*^9, 
  3.922629857576132*^9}},ExpressionUUID->"af04332f-7358-4e4e-85dc-\
22afabbe003e"],

Cell["\<\
Note that if HingeWireWidth is not Automatic, you should provide HingeWireZ \
to make sure that the wire is properly oriented.\
\>", "Text",
 CellChangeTimes->{{3.9328180006663837`*^9, 
  3.932818036483932*^9}},ExpressionUUID->"efa88196-ae4d-4330-8df2-\
a3b5cebb9b66"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "HingeRectWireGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HingeThickness", "->", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeWireWidth", "->", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"HingeWireCap", "->", "HingeWirePointCap"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"HingeWireSquareCapExtra", "->", "1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"HingeWireZ", "->", "Automatic"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.920733267973895*^9, 3.920733321498388*^9}, 
   3.920736411564231*^9, {3.920736551291766*^9, 3.920736551690834*^9}, {
   3.932816594806717*^9, 3.9328166014379*^9}, 3.932818140154578*^9, {
   3.932835515607432*^9, 3.932835521198738*^9}},
 CellLabel->
  "In[4350]:=",ExpressionUUID->"90eca6e0-60b7-45bc-a2a6-4ccc194cfb8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HingeRectWireGC", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "q_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ht", ",", "hw", ",", "hwc", ",", "hwsce", ",", "hwz", ",", "x", ",", 
      "y", ",", "z", ",", "hth", ",", "hwh", ",", "p1", ",", "p2", ",", "p3", 
      ",", "p4", ",", "p5", ",", "q1", ",", "q2", ",", "q3", ",", "q4", ",", 
      "q5", ",", "pts", ",", "polys", ",", "gc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ht", ",", "hw", ",", "hwc", ",", "hwsce", ",", "hwz"}], "}"}],
       "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "HingeThickness", ",", "HingeWireWidth", ",", "HingeWireCap", ",", 
          "HingeWireSquareCapExtra", ",", "HingeWireZ"}], "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HingeRectWireGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"hw", "===", "Automatic"}], ",", 
       RowBox[{"hw", "=", "ht"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"q", "-", "p"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"hwz", "===", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Find", " ", "a", " ", "direction", " ", "perpendicular", " ", "to", " ",
          "x", " ", "and", " ", "use", " ", 
         RowBox[{"that", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"hwz", "=", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "\[Cross]", 
              RowBox[{"{", 
               RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", 
             RowBox[{"x", "\[Cross]", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
             RowBox[{"x", "\[Cross]", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Mag2", "[", "#1", "]"}], ">", 
             RowBox[{"Mag2", "[", "#2", "]"}]}], "&"}]}], "]"}], "\[LeftDoubleBracket]",
          "1", "\[RightDoubleBracket]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"hwz", "\[Cross]", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"z", "=", 
      RowBox[{"x", "\[Cross]", "y"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hth", "=", 
      RowBox[{"ht", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hwh", "=", 
      RowBox[{"hw", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "p", ",", "p", ",", "p"}], "}"}], "+", 
       RowBox[{"hth", 
        RowBox[{"{", 
         RowBox[{"z", ",", "z", ",", 
          RowBox[{"-", "z"}], ",", 
          RowBox[{"-", "z"}]}], "}"}]}], "+", 
       RowBox[{"hwh", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "y"}], ",", 
          RowBox[{"-", "y"}], ",", "y"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q1", ",", "q2", ",", "q3", ",", "q4"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "q", ",", "q", ",", "q"}], "}"}], "+", 
       RowBox[{"hth", 
        RowBox[{"{", 
         RowBox[{"z", ",", "z", ",", 
          RowBox[{"-", "z"}], ",", 
          RowBox[{"-", "z"}]}], "}"}]}], "+", 
       RowBox[{"hwh", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "y"}], ",", 
          RowBox[{"-", "y"}], ",", "y"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"hwc", "===", "HingeWireSquareCap"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], "-=", 
         RowBox[{"hwsce", " ", "hth", 
          RowBox[{"{", 
           RowBox[{"x", ",", "x", ",", "x", ",", "x"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q1", ",", "q2", ",", "q3", ",", "q4"}], "}"}], "+=", 
         RowBox[{"hwsce", " ", "hth", 
          RowBox[{"{", 
           RowBox[{"x", ",", "x", ",", "x", ",", "x"}], "}"}]}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "q3", ",", "q4"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "6", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "7", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4", ",", "8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1", ",", "5", ",", "8"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{
       "hwc", ",", "\[IndentingNewLine]", "HingeWireButtCap", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphicsComplex", "[", 
         RowBox[{"pts", ",", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Join", "[", 
            RowBox[{"polys", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}]}], "}"}]}],
             "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        "HingeWirePointCap", ",", "\[IndentingNewLine]", 
        RowBox[{"GraphicsComplex", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"pts", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"p", "-", 
               RowBox[{"hth", " ", "x"}]}], ",", 
              RowBox[{"q", "+", 
               RowBox[{"hth", " ", "x"}]}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Join", "[", 
            RowBox[{"polys", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"2", ",", "1", ",", "9"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"3", ",", "2", ",", "9"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "3", ",", "9"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "4", ",", "9"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"5", ",", "6", ",", "10"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"6", ",", "7", ",", "10"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "8", ",", "10"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"8", ",", "5", ",", "10"}], "}"}]}], "}"}]}], 
            "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        "HingeWireSquareCap", ",", " ", "\[IndentingNewLine]", 
        RowBox[{"GraphicsComplex", "[", 
         RowBox[{"pts", ",", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Join", "[", 
            RowBox[{"polys", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}]}], "}"}]}],
             "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", "_", ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"HingeWireCap", "::", "badval"}], ",", "hwc"}], "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.920733329147641*^9, 3.920733397412268*^9}, {
   3.920733441730588*^9, 3.92073346317136*^9}, {3.92073351700351*^9, 
   3.92073363673254*^9}, {3.920733717685356*^9, 3.920733858901951*^9}, {
   3.920733896942024*^9, 3.920733946453655*^9}, {3.920734013856515*^9, 
   3.920734066559545*^9}, {3.920734115529133*^9, 3.920734173486806*^9}, 
   3.92073421406615*^9, {3.920734265649345*^9, 3.92073444909372*^9}, {
   3.920734521741374*^9, 3.920734646533552*^9}, {3.920734697494795*^9, 
   3.920734813120246*^9}, {3.920734892383612*^9, 3.920734896890283*^9}, {
   3.92073495400634*^9, 3.920734966705514*^9}, {3.92073500218806*^9, 
   3.920735005448206*^9}, {3.920735080245064*^9, 3.92073508633203*^9}, {
   3.920735119546472*^9, 3.9207352557951612`*^9}, {3.920735319620453*^9, 
   3.92073536587486*^9}, {3.920735421142325*^9, 3.920735489624741*^9}, {
   3.920735528295163*^9, 3.920735545046432*^9}, {3.920736411603437*^9, 
   3.9207364116171*^9}, {3.9328166273294077`*^9, 3.93281668487992*^9}, {
   3.93281674140169*^9, 3.9328168205992203`*^9}, 3.9328170455413847`*^9, {
   3.9328181401569967`*^9, 3.932818140159*^9}, {3.932835532293664*^9, 
   3.932835570517614*^9}},
 CellLabel->
  "In[4351]:=",ExpressionUUID->"e8fc161c-2601-459d-be7a-c0d2195b6be4"],

Cell["\<\
Example. All three wire types, plus a square cap that is extended.\
\>", "Text",
 CellChangeTimes->{{3.9207334691138763`*^9, 3.9207334798576527`*^9}, {
  3.932835578934135*^9, 3.93283559392598*^9}, {3.932835633349476*^9, 
  3.932835634181175*^9}},ExpressionUUID->"abeb5232-9ba7-4183-bd60-\
6da3f16e8b03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", "1"}], ",", 
      RowBox[{"b", "=", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"a", ",", 
                RowBox[{"-", "1"}], ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "7", ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", "7", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", 
                RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"b", ",", 
                RowBox[{"-", "1"}], ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "7", ",", 
                RowBox[{"-", "1"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "7", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", 
                RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"HingeRectWireGC", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"a", ",", "0", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"b", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
             RowBox[{"HingeThickness", "->", "1"}], ",", 
             RowBox[{"HingeWireCap", "->", "HingeWireButtCap"}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"HingeRectWireGC", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"a", ",", "2", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"b", ",", "2", ",", "0"}], "}"}]}], "}"}], ",", 
             RowBox[{"HingeThickness", "->", "1"}], ",", 
             RowBox[{"HingeWireCap", "->", "HingeWirePointCap"}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"HingeRectWireGC", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"a", ",", "4", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"b", ",", "4", ",", "0"}], "}"}]}], "}"}], ",", 
             RowBox[{"HingeThickness", "->", "1"}], ",", 
             RowBox[{"HingeWireCap", "->", "HingeWireSquareCap"}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"HingeRectWireGC", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"a", ",", "6", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"b", ",", "6", ",", "0"}], "}"}]}], "}"}], ",", 
             RowBox[{"HingeThickness", "->", "1"}], ",", 
             RowBox[{"HingeWireCap", "->", "HingeWireSquareCap"}], ",", 
             RowBox[{"HingeWireSquareCapExtra", "->", "2"}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", "SolidStyle"}], "]"}]}], "}"}], 
     "]"}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.92073363964014*^9, 3.920733691920351*^9}, {
   3.920734828906855*^9, 3.92073486660093*^9}, {3.9207350631554403`*^9, 
   3.920735063394363*^9}, {3.920735277699842*^9, 3.920735306292804*^9}, {
   3.92073550184067*^9, 3.920735510253689*^9}, {3.920735579853503*^9, 
   3.920735820640735*^9}, {3.920735853993313*^9, 3.920735856023163*^9}, {
   3.920736411634473*^9, 3.920736411649327*^9}, {3.920736559911882*^9, 
   3.920736602214365*^9}, 3.932817024817593*^9, 3.932817712485627*^9, {
   3.932818140160671*^9, 3.932818140162922*^9}, {3.932818220776515*^9, 
   3.93281822396436*^9}, 3.932835255260664*^9, {3.932835602006744*^9, 
   3.932835660761755*^9}, {3.9328357614507027`*^9, 3.93283576317212*^9}},
 CellLabel->
