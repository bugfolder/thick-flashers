Cell[TextData[{
 "AddDistinctEmbeddedEdgeData[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{v1, v2}, opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph\n\t(options) SamePtTolerance\n\
AddDistinctEmbeddedEdge[",
 StyleBox["{v1, v2}, opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph\n\t(options) SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.594653658124963*^9, 3.594653748918605*^9}, {
   3.59465405040867*^9, 3.594654052155352*^9}, {3.594655342257544*^9, 
   3.594655367008528*^9}, {3.5946565872318077`*^9, 3.594656603968597*^9}, {
   3.5946567139933023`*^9, 3.59465671903159*^9}, 3.594657671398521*^9, {
   3.594732491250498*^9, 3.5947324913627853`*^9}, {3.595286677772519*^9, 
   3.5952866833967867`*^9}},ExpressionUUID->"6ee80239-04b0-49e8-9ef8-\
ee025c3ac487"],

Cell[TextData[{
 "AddDistinctEmbeddedEdgeData[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{v1, v2}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] adds an embedded edge with vertices {",
 StyleBox["v1, v2",
  FontSlant->"Italic"],
 "} to the given TGraph adding vertices to it if necessary. It returns a list \
{",
 StyleBox["tobj1",
  FontSlant->"Italic"],
 ", {",
 StyleBox["vi1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vi2}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ei",
  FontSlant->"Italic"],
 "} where ",
 StyleBox["tobj1",
  FontSlant->"Italic"],
 " is the modified graph, ",
 StyleBox["ei",
  FontSlant->"Italic"],
 " is the added edge index, and ",
 StyleBox["vi1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["vi2",
  FontSlant->"Italic"],
 " are the vertex indices. Options are:\n\tOptions[SamePtQ]"
}], "Text",
 CellChangeTimes->{{3.5946499950492477`*^9, 3.594650015535738*^9}, {
   3.594650071652143*^9, 3.59465010873806*^9}, {3.594656606882903*^9, 
   3.594656652571669*^9}, 3.5946567259772243`*^9, {3.594656825304763*^9, 
   3.594656835816675*^9}, {3.594656929323105*^9, 3.594656946272872*^9}, {
   3.594657671498423*^9, 3.5946577555492487`*^9}, {3.594657844529054*^9, 
   3.594657845471157*^9}, {3.594673455867937*^9, 3.594673511988097*^9}, {
   3.6435823315543017`*^9, 
   3.6435823324508142`*^9}},ExpressionUUID->"aa5d3214-2aa0-4ce2-9cd1-\
44d0037238d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddDistinctEmbeddedEdgeData", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    RowBox[{"{", 
     StyleBox[
      RowBox[{"v1_List", ",", "v2_List"}],
      FontSlant->"Italic"], 
     StyleBox["}",
      FontSlant->"Italic"]}], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj1", ",", "vi1", ",", "vi2", ",", "ei"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj1", ",", "vi1"}], "}"}], "=", 
      RowBox[{"AddDistinctVertexData", "[", 
       RowBox[{"tobj", ",", "v1", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj1", ",", "vi2"}], "}"}], "=", 
      RowBox[{"AddDistinctVertexData", "[", 
       RowBox[{"tobj1", ",", "v2", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj1", ",", "ei"}], "}"}], "=", 
      RowBox[{"AddDistinctEdgeData", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{"vi1", ",", "vi2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"tobj1", ",", 
       RowBox[{"{", 
        RowBox[{"vi1", ",", "vi2"}], "}"}], ",", "ei"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5946565643965073`*^9, 3.594656580010287*^9}, {
   3.594656662389666*^9, 3.594656802885226*^9}, {3.59465713745714*^9, 
