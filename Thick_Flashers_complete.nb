Cell[CellGroupData[{

Cell["Four lines, variable widths", "Subsubsection",
 CellChangeTimes->{{3.7218201180983*^9, 3.7218201276513247`*^9}, {
  3.722252885675853*^9, 
  3.722252887275666*^9}},ExpressionUUID->"eb2bc5c3-319a-41d8-9ec7-\
639a5a61442f"],

Cell[TextData[{
 "This example shows off the new variable line width function. Note that the \
list of inset distances, ",
 StyleBox["hlist",
  FontSlant->"Italic"],
 ", must correspond with the edges of the intersectified line set and should \
be consistent along any collinear group of line segments."
}], "Text",
 CellChangeTimes->{{3.722108901774489*^9, 
  3.722108963303689*^9}},ExpressionUUID->"ef57a50a-eb46-45c1-9ef1-\
f06f460f41ee"],

