   3.630149682677463*^9},ExpressionUUID->"629351d6-f391-4bcf-9ebe-\
18f037012f05"],

Cell[TextData[{
 "{",
 "QuadrilateralCenteredSplitTwistAltTile",
 ", ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} is a tiletype that describes a split twist in a quadrilateral specified \
by its vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where \n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \n\t\
\[Alpha] is the desired twist angle (although the actual twist angle may end \
up different), \n\t",
 StyleBox["ip",
  FontSlant->"Italic"],
 " is the index of the vertex to preserve,\n\t",
 StyleBox["ctype",
  FontSlant->"Italic"],
 " is the fold type of the crossing fold,\n\t",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
