Cell[CellGroupData[{

Cell["2D transformations on Graphics expressions", "Subsection",
 CellChangeTimes->{{3.595972948962683*^9, 3.59597295227241*^9}, {
  3.595973527076819*^9, 3.595973543810542*^9}, {3.643207257237406*^9, 
  3.643207270557081*^9}},ExpressionUUID->"08995878-b4e1-4d89-afc6-\
ee3e93e52ee0"],

Cell[CellGroupData[{

Cell[TextData[{
 "Rotate2D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", \[Phi]]"
}], "Subsubsection",
 CellChangeTimes->{
  3.441505253400242*^9},ExpressionUUID->"5738a93c-82f0-4028-8ea7-\
5f244998ebf7"],

Cell["Rotate2D[g, \[Phi]] rotates the graphic object g by the angle \[Phi].", \
"Text",
 CellChangeTimes->{
  3.595526993240528*^9},ExpressionUUID->"2c08e2fc-b6c4-42f4-a5aa-\
2b53fe2e6556"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rotate2D", "[", 
   RowBox[{"g_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"MatrixTransform", "[", 
   RowBox[{"g", ",", 
    RowBox[{"RotationMatrix2D", "[", "\[Phi]", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.441499806476729*^9},
 CellLabel->
  "In[607]:=",ExpressionUUID->"e9735077-b175-40e1-a769-e913d9bef927"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Translate2D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.526834463411737*^9, 3.526834469683195*^9}, {
  3.526834512864375*^9, 
  3.526834530015477*^9}},ExpressionUUID->"0dfff0de-e3e7-468f-84ef-\
1333a3817a5e"],

Cell[TextData[{
 "Translate2D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "] translates the graphics object ",
 StyleBox["g",
  FontSlant->"Italic"],
 " by the vector ",
 StyleBox["v",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.526834475144257*^9, 3.526834499731064*^9}, {
  3.526834608794495*^9, 
  3.5268346102174067`*^9}},ExpressionUUID->"20d380b5-bd8f-4f7d-8806-\
735524682b1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Translate2D", "[", 
   RowBox[{"g_", ",", "v_"}], "]"}], ":=", 
  RowBox[{"FunctionTransform", "[", 
   RowBox[{"g", ",", 
    RowBox[{
     RowBox[{"#", "+", "v"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.526834547708643*^9, 3.52683458623894*^9}},
 CellLabel->
  "In[608]:=",ExpressionUUID->"32e4bf01-434c-40dd-b1dd-a77782082a0e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DupReflect2D[",
 StyleBox["g",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",ExpressionUUID->"c52452d5-231c-4fc2-bc73-0aef6465c51d"],

Cell["\<\
DupReflect2D[g] takes the graphic components g and returns a list consisting \
of g plus its reflection in the x axis.\
\>", "Text",ExpressionUUID->"02ed100e-4cb5-4f93-935f-ed3343c3f869"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DupReflect2D", "[", "g_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"g", ",", 
    RowBox[{"MatrixTransform", "[", 
     RowBox[{"g", ",", "ReflectionXMatrix2D"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{3.441499806569793*^9},
 CellLabel->
  "In[609]:=",ExpressionUUID->"d3f53061-fed1-4a04-ac3d-a536b2f06ff9"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DupRotate2D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.441505239663781*^9},ExpressionUUID->"814ce67e-4748-4136-b61d-\
d17cf93f56a9"],

Cell["\<\
DupRotate2D[g,m] takes the graphics components g and returns a list \
consisting of g plus the m-1 rotated duplicates.\
\>", "Text",ExpressionUUID->"0e42937b-b9d4-45a1-a6f0-f613864f50fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DupRotate2D", "[", 
   RowBox[{"g_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"MatrixTransform", "[", 
     RowBox[{"g", ",", 
      RowBox[{"RotationMatrix2D", "[", 
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"i", "/", "m"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.441499806653018*^9},
 CellLabel->
  "In[610]:=",ExpressionUUID->"44ac0bc3-9707-48c5-bbe9-2c96909b4f7f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DupReflectAndRotate2D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.441505242431793*^9},ExpressionUUID->"466981a3-e73b-412f-b580-\
e04b8f879516"],

Cell["\<\
DupReflectAndRotate2D[g,m] takes the graphics components g and returns a list \
consisting of the reflection plus the m-1 rotated duplicates of both.\
\>", "Text",ExpressionUUID->"5c45901d-23f9-44fa-980c-60931cdfb9f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DupReflectAndRotate2D", "[", 
   RowBox[{"g_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gg", "=", 
      RowBox[{"{", 
       RowBox[{"g", ",", 
        RowBox[{"MatrixTransform", "[", 
         RowBox[{"g", ",", "ReflectionXMatrix2D"}], "]"}]}], "}"}]}], "}"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"MatrixTransform", "[", 
       RowBox[{"gg", ",", 
        RowBox[{"RotationMatrix2D", "[", 
         RowBox[{"2", "\[Pi]", " ", 
          RowBox[{"i", "/", "m"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.441499806724195*^9, 3.441499806756113*^9}},
 CellLabel->
  "In[611]:=",ExpressionUUID->"3295292b-70a8-4df4-be72-62c618e198a5"]
}, Closed]]
}, Closed]]
}, Closed]],

