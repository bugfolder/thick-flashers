   3.800005459367556*^9, 3.800005460424267*^9}, {3.800005504762689*^9, 
   3.800005557255025*^9}, {3.800005598808675*^9, 3.800005601726776*^9}, 
   3.800005726434586*^9, {3.800005782378757*^9, 3.800005801137122*^9}, {
   3.800005840193695*^9, 3.800005848970839*^9}, {3.800005923447001*^9, 
