Cell[CellGroupData[{

Cell[TextData[{
 "HatFacePlanarityConditions2D[",
 StyleBox["sectorhats, opts",
  FontSlant->"Italic"],
 "]\n\t(options) HatMatrixSplit"
}], "Subsubsection",
 CellChangeTimes->{{3.595611881981205*^9, 3.595611925560431*^9}, {
   3.59561203019345*^9, 3.595612034112474*^9}, {3.5956125976681557`*^9, 
   3.595612622682333*^9}, {3.595615234187002*^9, 3.595615235945767*^9}, 
   3.595700505470727*^9, {3.595702409438397*^9, 3.595702430826619*^9}, {
   3.595703450475904*^9, 3.595703451051714*^9}, 3.595704443339012*^9, 
   3.595705224452154*^9, 3.596023085919736*^9, {3.596023548918865*^9, 
   3.596023549382921*^9}, {3.596032108638101*^9, 
   3.59603210941413*^9}},ExpressionUUID->"ef85d9ff-031d-4e89-976d-\
14edf6a25886"],

Cell[TextData[{
 "HatFacePlanarityConditions2D[",
 StyleBox["sectorhats, excess",
  FontSlant->"Italic"],
 "] returns the 2x2 matrix whose entries must be zero in order for the sum of \
the supplements of ",
 StyleBox["sectorhats",
  FontSlant->"Italic"],
 " around the face to be 2\[Pi]",
 StyleBox["n",
  FontSlant->"Italic"],
 " for some integer ",
 StyleBox["n ",
  FontSlant->"Italic"],
 "or 2\[Pi]",
 StyleBox["n",
  FontSlant->"Italic"],
 "\[Dash]ArcHat[",
 StyleBox["excess",
  FontSlant->"Italic"],
 "] if you provide a nonzero value for option HatExcess. Options are:\n\t\
HatExcess \[Rule] ",
 StyleBox["excess",
  FontSlant->"Italic"],
 ", which is the hat transformation of the excess angle, or 0 for a planar \
face. For a negative ",
 StyleBox["excess",
  FontSlant->"Italic"],
 ", there is sometimes a solution that corresponds to a bent face in 3D. For \
a positive ",
 StyleBox["excess",
  FontSlant->"Italic"],
 ", there is generally no isometric configuration.\n\tHatMatrixSplit \[Rule] \
Automatic | None | ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where n is the number of matrices on the left and the remainder are on \
the right. None puts all of the numerators on the left. Automatic splits them \
as evenly as possible between left and right. In either case, denominators \
are cleared from either side so that each entry is a polynomial."
}], "Text",
 CellChangeTimes->{{3.595611934877542*^9, 3.595611964333376*^9}, {
   3.595612011691249*^9, 3.595612082429765*^9}, {3.595612112636605*^9, 
   3.595612138642123*^9}, 3.59561260392588*^9, {3.595612638956883*^9, 
   3.5956126695762577`*^9}, {3.5956138356564713`*^9, 3.59561391554285*^9}, {
   3.595615241027442*^9, 3.595615261520343*^9}, {3.5957005056786747`*^9, 
   3.595700506032034*^9}, {3.595702439474646*^9, 3.595702455649703*^9}, 
   3.5957044434640903`*^9, 3.595705224644246*^9, 3.59602309839032*^9, 
   3.596023588471583*^9, {3.596031596074616*^9, 3.596031721959407*^9}, {
   3.596031932706213*^9, 3.596031938594357*^9}, {3.596031974176173*^9, 
   3.596031986910151*^9}},ExpressionUUID->"7b792104-fdd5-4ce9-be9a-\
830ccbc94e22"],

Cell["\<\
Note that the sign of HatExcess has the opposite effect in this condition \
than in developability or flat-foldability. A negative excess means that some \
of the corner angles of the polygon are smaller than their planar values.\
\>", "Text",
 CellChangeTimes->{{3.596031995559458*^9, 
  3.596032087759322*^9}},ExpressionUUID->"561c2356-206c-4855-8eea-\
cdc92b989ad4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatFacePlanarityConditions2D", "[", 
   RowBox[{
    StyleBox[
     RowBox[{
      StyleBox["sectorhats_",
       FontSlant->"Italic"], "List"}]], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "hsg", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hsg", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", 
         RowBox[{"Length", "[", "sectorhats", "]"}], "]"}], ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"HatRotationConditions2D", "[", 
      RowBox[{"sectorhats", ",", 
       RowBox[{"HatMatrixSign", "\[Rule]", "hsg"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.595612141092373*^9, 3.595612305947384*^9}, {
   3.59561235540265*^9, 3.595612355904353*^9}, {3.5956123945569077`*^9, 
