Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "w", ",", "e", ",", "u0", ",", "u1", ",", "s", ",", "tf", ",", "q", ",", 
      "\[Gamma]", ",", "f", ",", "flist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tf", "[", "i_", "]"}], ":=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"i", " ", "w"}]}], ")"}], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "s", "]"}], ",", 
           RowBox[{"Sin", "[", "s", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"f", "[", "i", "]"}], "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{"tf", "[", "i", "]"}], "[", 
          RowBox[{
           RowBox[{"q", "[", "i", "]"}], "[", "s", "]"}], "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "0", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "1", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"s", "+", 
         RowBox[{"e", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", "s"}], "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "0", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"120.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Gamma]", "[", "1", "]"}], ",", 
        RowBox[{"q", "[", "2", "]"}]}], "}"}], "=", 
      RowBox[{"NLinkedFoldsNext2D", "[", 
       RowBox[{
        RowBox[{"tf", "[", "0", "]"}], ",", 
        RowBox[{"q", "[", "0", "]"}], ",", 
        RowBox[{"\[Gamma]", "[", "0", "]"}], ",", 
        RowBox[{"tf", "[", "1", "]"}], ",", 
        RowBox[{"q", "[", "1", "]"}], ",", 
        RowBox[{"tf", "[", "2", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"flist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", "[", "0", "]"}], ",", 
        RowBox[{"f", "[", "1", "]"}], ",", 
        RowBox[{"f", "[", "2", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StyledRuledPatchSequence", "[", 
          RowBox[{"flist", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"RulingLineDivisions", "\[Rule]", "50"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"StyledCurve", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", 
              RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "&"}], "/@", 
          "flist"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
