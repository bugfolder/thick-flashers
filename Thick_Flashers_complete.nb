762894d00b99"],

Cell[TextData[{
 "The ruling line vectors {",
 StyleBox["rl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rr",
  FontSlant->"Italic"],
 "} are in general not normalized; their magnitudes will be the length of \
each ruling line."
}], "Text",
 CellChangeTimes->{{3.691496695775322*^9, 3.691496787717866*^9}, {
  3.6915032150198793`*^9, 3.691503220552685*^9}, {3.6915033191630993`*^9, 
