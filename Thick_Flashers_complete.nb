0c38ffe32fbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "q", ",", "r", ",", "s", ",", "qt", ",", "rt", ",", "st", ",", 
      "zt", ",", "t"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", ".1", ",", ".1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"{", 
       RowBox[{".9", ",", ".8", ",", ".2"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{".7", ",", ".2", ",", ".6"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qt", ",", "rt", ",", "st", ",", "zt"}], "}"}], "=", 
      RowBox[{"Barycentric3D", "[", 
       RowBox[{"p", ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "r", ",", "s"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Barycentric triangle coordinates: \>\"", ",", 
       RowBox[{"{", 
        RowBox[{"qt", ",", "rt", ",", "st", ",", "zt"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{
       RowBox[{"qt", " ", "q"}], " ", "+", " ", 
       RowBox[{"rt", " ", "r"}], " ", "+", " ", 
       RowBox[{"st", " ", "s"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{"q", ",", "r", ",", "s"}], "}"}], "]"}], ",", 
           RowBox[{"Opacity", "[", ".25", "]"}], ",", "Gray"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "q", "]"}], ",", "Red", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "r", "]"}], ",", "Green", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "s", "]"}], ",", "Blue", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "p", "]"}], ",", "Black", ",", 
           RowBox[{"PointSize", "[", ".015", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "t", "]"}], ",", "Orange", ",", 
           RowBox[{"PointSize", "[", ".025", "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.726093867413413*^9, 3.72609412707271*^9}, {
   3.72609421713961*^9, 3.726094271249908*^9}, {3.726094658829914*^9, 
   3.726094700974196*^9}, {3.726094731767589*^9, 3.726094807180884*^9}, 
