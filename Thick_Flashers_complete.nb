Cell[TextData[{
 "EmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", MonolithicTGraph2D, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) StationaryFace"
}], "Subsubsection",
 CellChangeTimes->{{3.6301609274749403`*^9, 3.630160942480586*^9}, {
