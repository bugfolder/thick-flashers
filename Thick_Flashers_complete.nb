Cell[TextData[{
 "RenderTile[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decorations",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a list of the results of RenderTile applied to each of the \
individual decorations in turn."
}], "Text",
 CellChangeTimes->{{3.629817695184983*^9, 3.629817713711137*^9}, 
   3.629817748749419*^9, {3.629818414210367*^9, 3.629818424329933*^9}, {
