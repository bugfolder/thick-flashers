Cell[CellGroupData[{

Cell[TextData[{
 "MakeHingeSamples[",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.933171394687982*^9, 3.9331713960648737`*^9}, {
   3.933171478554454*^9, 3.933171484513513*^9}, 3.933175875732423*^9, 
