Cell[CellGroupData[{

Cell[TextData[{
 "TClasses\nMakeTObj[]\nMakeTObj[",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["properties",
  FontSlant->"Italic"],
 "]\nAddClassTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class",
  FontSlant->"Italic"],
 "]\nAddClassTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["properties",
  FontSlant->"Italic"],
 "]\nAddClass[",
 StyleBox["class",
  FontSlant->"Italic"],
 "]\nAddClass[",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["properties",
  FontSlant->"Italic"],
 "]\nHasClassQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class",
  FontSlant->"Italic"],
 "]\nAssertClass[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class, where",
  FontSlant->"Italic"],
 "]\n",
 "AssertClasses",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["classes, where",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.592344849933736*^9, 3.592344850597858*^9}, {
   3.592345244820483*^9, 3.592345263382204*^9}, {3.5923470322369957`*^9, 
   3.592347036371776*^9}, {3.592349167255919*^9, 3.592349171549026*^9}, 
   3.592407075205196*^9, {3.592430746839816*^9, 3.592430778555484*^9}, 
   3.592435824745249*^9, {3.592440271149066*^9, 3.592440277428322*^9}, 
   3.592465161669651*^9, 3.592654738570607*^9, {3.59266641976596*^9, 
   3.592666423053016*^9}, {3.592668607657687*^9, 3.592668607741654*^9}, {
   3.592668970071838*^9, 3.592668989308474*^9}, {3.593006100471964*^9, 
   3.593006114306861*^9}},ExpressionUUID->"67c3622d-d83a-40b6-9698-\
207072c6e0ec"],

Cell["\<\
TClasses is a TObj property that is a list of all object classes that the \
TObj belongs to. Every TObj has this property. We use it to implement the \
inheritance hierarchy for TObj\[CloseCurlyQuote]s.\
\>", "Text",
 CellChangeTimes->{{3.59234485376545*^9, 3.592344937201404*^9}, {
   3.59234505355985*^9, 3.592345053744113*^9}, {3.592435734185909*^9, 
   3.592435734457295*^9}, 3.59265473864098*^9, {3.593006141843374*^9, 
   3.593006144761554*^9}},ExpressionUUID->"05809c1a-7e45-475e-a2d1-\
f1ace3137bf7"],

Cell["\<\
As a shorthand bit of documentation, we will talk about TObj objects as \
objects by their class. So, for example, we may talk about a TGraph, but \
really it\[CloseCurlyQuote]s a TObj whose TClasses property contains the \
symbol TGraph. Since the TClasses property is a list, a TObj can \
simultaneously be more than one class of TObj by containing multiple entries \
in this list. This supports an inheritance hierarchy where we can have mixin \
classes that can join at multiple places in the inheritance hierarchy. The \
order of the TClasses list in an object typically reflects the order in which \
the object was built, but you should not use or rely upon this order. In \
fact, you should never access the TClasses property directly, but instead, \
should use the getter/setter functions in this section.\
\>", "Text",
 CellChangeTimes->{{3.592345584846127*^9, 3.592345692941741*^9}, 
   3.592348465094954*^9, {3.5924309552343073`*^9, 3.592431002036618*^9}, {
   3.592435734582403*^9, 3.59243573491419*^9}, {3.592435824870219*^9, 
   3.592435843601162*^9}, {3.592654570176869*^9, 3.592654706391652*^9}, {
   3.592654738710227*^9, 3.592654738828017*^9}, {3.593006360029168*^9, 
   3.593006362251354*^9}},ExpressionUUID->"c98f77bc-1637-4f18-8b26-\
1b4ac28892ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TClasses", "::", "usage"}], 
   "=", "\"\<TClasses is a TObj property that specifies the classes of TObj \
that a particular TObj belongs to.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592344945553297*^9, 3.5923449677775*^9}, {
  3.5924357349877663`*^9, 3.592435735121372*^9}, {3.592435825054082*^9, 
  3.592435825108827*^9}, {3.592654738860145*^9, 3.592654738890138*^9}},
 CellLabel->
  "In[1002]:=",ExpressionUUID->"229db622-2d66-4489-8bd0-3d410aafddb1"],

Cell[TextData[{
 "MakeTObj creates a new blank TObj. You should always use MakeTObj to create \
a new TObj; in fact, you should never use the head TObj at all, except to \
pattern-match in arguments (e.g., MyFunction[",
 StyleBox["tobj_TObj",
  FontSlant->"Italic"],
 "])."
}], "Text",
 CellChangeTimes->{{3.592666468546912*^9, 3.592666480850244*^9}, {
  3.593006172488375*^9, 3.593006222677069*^9}, {3.594732598821168*^9, 
  3.594732598981716*^9}},ExpressionUUID->"c8e91d7a-115e-4731-b056-\
d2cb98ff30b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTObj", "[", "]"}], ":=", 
  RowBox[{"TObj", "[", 
   RowBox[{"{", 
    RowBox[{"TClasses", "\[Rule]", 
     RowBox[{"{", "}"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.592666432472396*^9, 3.592666461405772*^9}},
 CellLabel->
  "In[1003]:=",ExpressionUUID->"36049193-5bca-476e-bd02-b1892db2ea46"],

Cell[TextData[{
 "MakeTObj",
 "[",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["properties",
  FontSlant->"Italic"],
 "] creates a TObj of the specified class and properties."
}], "Text",
 CellChangeTimes->{{3.59234512509128*^9, 3.5923451385233*^9}, 
   3.592435735213985*^9, 
   3.59246516174232*^9},ExpressionUUID->"9f7ccda6-0417-493b-93e9-\
1e98ccb942ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTObj", "[", 
   RowBox[{"class_Symbol", ",", "properties_List"}], "]"}], ":=", 
  RowBox[{"TObj", "[", 
   RowBox[{"Prepend", "[", 
    RowBox[{"properties", ",", 
     RowBox[{"TClasses", "\[Rule]", 
      RowBox[{"{", "class", "}"}]}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.592345065581795*^9, 3.592345121244133*^9}, {
   3.5923470044293213`*^9, 3.59234700628812*^9}, 3.592435735288021*^9, 
   3.592435825207306*^9, 3.592465161777229*^9, 3.592654738924477*^9, {
   3.592666401347526*^9, 3.592666409409597*^9}},
 CellLabel->
  "In[1004]:=",ExpressionUUID->"bfda52b7-4601-4b9d-8d0f-ceb9df7cf440"],

Cell[TextData[{
 "AddClassTo",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class",
  FontSlant->"Italic"],
 "] adds the specified class to ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s list of classes, i.e., its TClasses property, without \
altering its other properties."
}], "Text",
 CellChangeTimes->{{3.592347137110417*^9, 3.592347186841692*^9}, 
   3.592435825297999*^9, {3.5924402538462667`*^9, 3.592440254982325*^9}, {
   3.592440642350466*^9, 3.592440647908771*^9}, 3.592654738980166*^9, {
   3.592668607828551*^9, 
   3.592668635519555*^9}},ExpressionUUID->"1063acf9-ff92-4f21-bd8d-\
6383d0b95789"],

Cell[TextData[{
 "AddClassTo",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["properties",
  FontSlant->"Italic"],
 "] adds the specified class and the specified properties as well. This is a \
useful way to add a mixin class."
}], "Text",
 CellChangeTimes->{{3.592440287339932*^9, 3.592440308090203*^9}, {
   3.592440490178957*^9, 3.592440502973435*^9}, 
   3.592668607913488*^9},ExpressionUUID->"baa0093f-3758-4cf0-a7f7-\
d4b9c001367a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddClassTo", "[", 
   RowBox[{"tobj_TObj", ",", "class_Symbol", ",", 
    RowBox[{"properties_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{"AddPropertiesTo", "[", 
   RowBox[{"tobj", ",", 
    RowBox[{"Prepend", "[", 
     RowBox[{"properties", ",", 
      RowBox[{"TClasses", "\[Rule]", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"GetValue", "[", 
          RowBox[{"tobj", ",", "TClasses"}], "]"}], ",", "class"}], "]"}]}]}],
      "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5924403120323467`*^9, 3.592440423882481*^9}, {
   3.592654739014896*^9, 3.592654739039989*^9}, 3.592668607956869*^9, 
   3.592677025223157*^9, {3.592677782307025*^9, 3.592677851436822*^9}, {
   3.592677944438709*^9, 3.592677966042241*^9}, {3.592678854779476*^9, 
   3.592678857777666*^9}, {3.592679405060116*^9, 3.592679514656137*^9}, {
