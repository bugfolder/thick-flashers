Cell[TextData[{
 "MakeChordStarGraph[",
 StyleBox["specs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] does the same thing as MakeChordStarLines but returns a TGraph consisting \
of the Intersectified lines, ready for feeding to MakeWovenTessellation."
}], "Text",
 CellChangeTimes->{{3.462927208710092*^9, 3.462927234187994*^9}, {
   3.592559329951579*^9, 3.592559333920939*^9}, 3.592559365119151*^9, {
