    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTDegree4Vertex3DFromSubarcs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.7071067811865475`"}], ",", 
          RowBox[{"-", "0.7071067811865475`"}], ",", "0.`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "1.", ",", "0."}], "}"}], ",", 
        RowBox[{"10", " ", "\[Degree]"}], ",", 
        RowBox[{"10", " ", "\[Degree]"}], ",", "1", ",", 
        RowBox[{"OsculatingVectorNear", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "0.", ",", 
           RowBox[{"-", "1."}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Degree4Vertex3DGraphicsTrio", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"SectorAngleLabels", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", " ", "16"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(1\)]\)\>\"", 
             ",", "\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(2\)]\)\>\"", 
