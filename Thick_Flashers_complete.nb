Cell[TextData[{
 "ScaleRotationOffsetFixedPoint[{",
 StyleBox["scale",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", ",
 StyleBox["offset",
  FontSlant->"Italic"],
 "}] returns the point {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 "} that is left unchanged by application of the specified ",
 StyleBox["scale",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["offset",
  FontSlant->"Italic"],
 ". It can be considered the center of a {",
 StyleBox["scale",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 "} transformation."
}], "Text",
 CellChangeTimes->{{3.628782396799987*^9, 3.628782427656363*^9}, {
  3.628782579911208*^9, 3.62878258768637*^9}, {3.6287827443403187`*^9, 
  3.628782773850589*^9}, {3.631089386490818*^9, 
  3.631089389816576*^9}},ExpressionUUID->"e377647a-c0b2-44b1-bf75-\
e90e20953f89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ScaleRotationOffsetFixedPoint", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["scale_",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["rotation_",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["offset_",
      FontSlant->"Italic"]}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], "/.", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "\[Equal]", 
         RowBox[{
          RowBox[{"scale", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"RotationMatrix2D", "[", "rotation", "]"}], ".", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}], ")"}]}], "+", "offset"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "\[LeftDoubleBracket]", "1",
       "\[RightDoubleBracket]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.628782438179922*^9, 3.628782515695488*^9}, 
   3.688166835977981*^9, {3.7786782340977483`*^9, 3.778678238522605*^9}},
