Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeFoldVectorsFromSubarcs", "[", 
    RowBox[{
     SubscriptBox["g", "4"], ",", " ", 
     SubscriptBox["g", "2"], ",", " ", 
     SubscriptBox["\[Sigma]", "3"], ",", " ", 
     SubscriptBox["\[Sigma]", "4"], ",", "\[Rho]", ",", " ", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "be0ac52b-4652-48d1-b8cd-bae6d32fe55f"],
 "\n\t(options) OsculatingVectorNear"
}], "Subsubsection",
 CellChangeTimes->{{3.441374216285058*^9, 3.441374307423646*^9}, {
  3.441374683029278*^9, 3.441374684117354*^9}, {3.441375244663342*^9, 
  3.441375254091898*^9}, {3.441377942877171*^9, 3.441377942877224*^9}, {
  3.441921406998927*^9, 3.441921406998982*^9}, {3.442875527696392*^9, 
  3.442875527696454*^9}, {3.5928296577696333`*^9, 3.592829657769734*^9}, {
  3.592868198793348*^9, 3.592868198793441*^9}, {3.594982085942265*^9, 
  3.594982085942418*^9}},ExpressionUUID->"86e192d7-6e44-4ef4-94fb-\
6f96f30f2ecd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeFoldVectorsFromSubarcs", "[", 
    RowBox[{
     SubscriptBox["g", "4"], ",", " ", 
     SubscriptBox["g", "2"], ",", " ", 
     SubscriptBox["\[Sigma]", "3"], ",", " ", 
     SubscriptBox["\[Sigma]", "4"], ",", " ", "\[Rho]", ",", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "8b7f03e3-4bc2-4ada-b1e3-9180f4fcbb03"],
 " returns the list of dihedral vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["g", "1"], ",", 
     SubscriptBox["g", "2"], ",", 
     SubscriptBox["g", "3"], ",", 
     SubscriptBox["g", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "e0669a7e-e79f-4553-8ffc-348ddebec8b7"],
 " for a degree-4 vertex where we have specified the normalized dihedral \
vectors for the two major creases ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["g", "4"], ",", 
     SubscriptBox["g", "2"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "09542e26-64f2-4678-9e3c-73edcd6e6ee2"],
 ",  the two subarc angles on the \"incoming\" side ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Sigma]", "3"], ",", 
     SubscriptBox["\[Sigma]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "1f379e59-4dac-438b-bf91-f18b711b5f0d"],
 ", and the expansion factor \[Rho] . Options are:\n\tOsculatingVectorNear\
\[Rule]None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["q", "x"], ",", 
     SubscriptBox["q", "y"], ",", 
     SubscriptBox["q", "z"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "926b8225-14ca-4630-ba46-d6b255de566d"],
 ", where, if a vector is given, we choose the sign of the osculating vector \
that points into the same half-space as the given option."
}], "Text",
 CellChangeTimes->{{3.4413743239744453`*^9, 3.441374495267419*^9}, {
  3.441374694290188*^9, 3.441374763951827*^9}, {3.4413779431298027`*^9, 
  3.441377943129855*^9}, {3.441495576930586*^9, 3.441495577436147*^9}, {
  3.44192140725159*^9, 3.441921407251649*^9}, {3.442875527927442*^9, 
  3.442875527927505*^9}, {3.592829658101564*^9, 3.59282965810168*^9}, {
  3.592868199043847*^9, 3.5928681990439363`*^9}, {3.5949820840730743`*^9, 
  3.594982084073213*^9}, {3.6881660787025642`*^9, 
  3.688166096820796*^9}},ExpressionUUID->"4d4931fe-2cfa-4513-8861-\
0bcf1d2017b3"],

