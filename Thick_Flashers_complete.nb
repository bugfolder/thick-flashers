Cell[TextData[{
 "ReshapeCone3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Beta], ",
 StyleBox["\[Psi]",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, uui",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{
  3.79857276150193*^9, {3.798572806666256*^9, 3.79857284013316*^9}, {
   3.798573047101912*^9, 3.798573047750756*^9}, {3.798573191670987*^9, 
   3.798573194063023*^9}, {3.799318056173518*^9, 3.799318060157711*^9}, {
   3.7993245962218733`*^9, 3.799324599127043*^9}, {3.799332439904475*^9, 
   3.799332466902612*^9}, {3.799335581452736*^9, 3.799335581980678*^9}, {
   3.799344056904434*^9, 3.799344057272032*^9}, {3.799344087440324*^9, 
   3.799344106168263*^9}, {3.79934474959636*^9, 3.799344750060589*^9}, 
   3.7993529170409603`*^9, {3.799398617844849*^9, 3.799398619561557*^9}, 
   3.800480739658304*^9, {3.800529257743701*^9, 
   3.800529258018793*^9}},ExpressionUUID->"979e68e0-5fa7-4760-a916-\
831be7ad5c79"],

Cell[TextData[{
 "ReshapeCone3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Beta], ",
 StyleBox["sv",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, uui",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D oriented developable surface specified by an oriented ruled \
parameterization with cone point directrix and returns a different oriented \
developable surface with the specified normal curvature along the directrix."
}], "Text",
 CellChangeTimes->{{3.798572847292226*^9, 3.798572899717365*^9}, {
   3.7985731966001863`*^9, 3.798573197766917*^9}, {3.798574876085689*^9, 
   3.798574885212594*^9}, {3.798624528951817*^9, 3.798624530092536*^9}, {
   3.799324637560071*^9, 3.799324655520765*^9}, {3.799332469887213*^9, 
   3.799332506695383*^9}, {3.799335590716183*^9, 3.799335626092291*^9}, {
   3.799344112121814*^9, 3.799344145800688*^9}, {3.799344672411291*^9, 
   3.799344674627437*^9}, {3.7993986233154097`*^9, 3.799398631043969*^9}, 
   3.800480739680028*^9},ExpressionUUID->"80629794-0c1d-4148-b13b-\
9aa6c1f2498e"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the 3D directrix, as a pure function. It should return a \
constant value.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] the 3D director, as a pure function. It should be \
well-behaved.\n\t\[Sigma] \[LongDash] the orientation, which should be \
\[PlusMinus]1.\n\t\[Beta] \[LongDash] the product (curve speed) \[Times] \
(normal curvature), as a pure function\n\t",
 StyleBox["\[Psi]",
  FontSlant->"Italic"],
 " \[LongDash] the sign of ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", indicating which branch we\[CloseCurlyQuote]re on; should be \
\[PlusMinus]1.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter.\n\t",
 StyleBox["bbi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position of the new directrix.\n\t",
 StyleBox["ddi",
  FontSlant->"Italic"],
 " \[LongDash] the initial director of the new surface.\n\t",
 StyleBox["uui",
  FontSlant->"Italic"],
 " \[LongDash] the initial surface normal vector of the new surface."
}], "Text",
 CellChangeTimes->{{3.798572971597745*^9, 3.798573067343102*^9}, {
  3.799324637570926*^9, 3.799324655529855*^9}, {3.799332511270781*^9, 
  3.799332544247019*^9}, {3.7993355394999647`*^9, 3.7993355691326942`*^9}, {
  3.799344257681477*^9, 3.799344288273257*^9}, {3.799344693604991*^9, 
  3.799344765588034*^9}, {3.799398639535269*^9, 3.799398640893705*^9}, {
  3.800529263715433*^9, 
  3.800529264081578*^9}},ExpressionUUID->"04759842-19f4-4db8-bbac-\
9ae3bb5a41ae"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify.\n\t\
Options[DSolve] are passed through."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
   3.6912356648227*^9}, {3.691241735558269*^9, 3.691241736473103*^9}, {
   3.694215733040501*^9, 3.69421576583174*^9}, {3.694217281461211*^9, 
   3.694217296724212*^9}, {3.6942183546369*^9, 3.694218359821371*^9}, {
   3.694218471807096*^9, 3.6942184743823833`*^9}, {3.797958405540965*^9, 
   3.797958426213867*^9}, 3.79857320891115*^9, {3.798576234758256*^9, 
   3.798576244797916*^9}, 
   3.7986245590458803`*^9},ExpressionUUID->"dfeb300f-fd81-4b0f-a46b-\
5b48a4eedbcc"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", \[Sigma]} for the new surface."
}], "Text",
 CellChangeTimes->{{3.799324786467416*^9, 3.799324817160604*^9}, {
  3.79933255056643*^9, 
  3.799332563159402*^9}},ExpressionUUID->"94df1652-1dd1-4881-910f-\
639a5bdd4249"],

Cell["\<\
Note that the 3rd initial value is the surface normal, since the tangent of a \
cone point is undefined.\
\>", "Text",
 CellChangeTimes->{{3.799344332241483*^9, 
  3.799344351041743*^9}},ExpressionUUID->"087f215f-6db9-4882-aeee-\
97a9418a20a7"],

