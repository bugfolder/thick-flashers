Cell[CellGroupData[{

Cell[TextData[{
 "LabelAngleAtBase[",
 StyleBox["lbl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.471290357228796*^9, 3.471290358956038*^9}, {
  3.5894662248435283`*^9, 
  3.589466241409491*^9}},ExpressionUUID->"b264f3c9-a308-472f-adc9-\
b6f57487a97c"],

Cell[TextData[{
 "LabelAngleAtBase",
 "[",
 StyleBox["lbl,q1,q2,q3",
  FontSlant->"Italic"],
 "] places a string label ",
 StyleBox["lbl",
  FontSlant->"Italic"],
 " at the base of the angle between lines ",
 StyleBox["q1",
  FontSlant->"Italic"],
 "-",
 StyleBox["q2",
  FontSlant->"Italic"],
 " and ",
 StyleBox["q1",
  FontSlant->"Italic"],
 "-",
 StyleBox["q3.",
  FontSlant->"Italic"],
 " Optional value ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the normalized distance from point ",
 StyleBox["q1.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.457613581598115*^9, 3.457613583330431*^9}, 
   3.589466225009183*^9},ExpressionUUID->"203145b9-14ac-45a6-b861-\
9f44c28210fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LabelAngleAtBase", "[", 
   RowBox[{"lbl_", ",", "q1_", ",", "q2_", ",", "q3_", ",", 
    RowBox[{"r_", ":", "2"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f2", "=", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{"q2", "-", "q1"}], ")"}]}]}], ",", 
      RowBox[{"f3", "=", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{"q3", "-", "q1"}], ")"}]}]}], ",", "fa"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fa", "=", 
      RowBox[{"f2", "+", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"f3", "-", "f2"}], ",", 
          RowBox[{"2", "\[Pi]"}]}], "]"}], "/", "2"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Text", "[", 
      RowBox[{"lbl", ",", "q1", ",", 
       RowBox[{
        RowBox[{"-", "r"}], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "fa", "]"}], ",", 
          RowBox[{"Sin", "[", "fa", "]"}]}], "}"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.457613502016982*^9, 3.457613550824323*^9}, 
   3.5894662250821857`*^9},
 CellLabel->
  "In[885]:=",ExpressionUUID->"989da237-7ae1-4b5f-a162-a2b5ec1d2267"],

Cell["Example", "Text",ExpressionUUID->"b0e4015f-0131-41c6-a902-3c66c7c409c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Show", "[", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Gray", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "}"}], "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
          "}"}], "]"}], ",", "Black", ",", 
        RowBox[{"LabelAngleAtBase", "[", 
         RowBox[{"\"\<\[Alpha]\>\"", ",", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
           ",", "2"}], "]"}]}], "}"}], "]"}], "]"}], "&"}], "@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.", ",", ".5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{".5", ",", "1."}], "}"}]}], "}"}]}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{
  3.457613263609707*^9, {3.589466129594022*^9, 3.589466182247274*^9}, 
   3.58946622474238*^9},
 CellLabel->
  "In[886]:=",ExpressionUUID->"709fa01c-b5c0-4d58-bcb2-6a72e4e578cf"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "EndArrow[",
 StyleBox["start",
  FontSlant->"Italic"],
 ", ",
 StyleBox["finish",
  FontSlant->"Italic"],
 "]\nMidArrow[",
 StyleBox["start",
  FontSlant->"Italic"],
 ", ",
 StyleBox["finish",
  FontSlant->"Italic"],
 "]\nTextArrow[",
 StyleBox["text",
  FontSlant->"Italic"],
 ", ",
 StyleBox["start",
  FontSlant->"Italic"],
 ", ",
 StyleBox["finish",
  FontSlant->"Italic"],
 ", ",
 StyleBox["offset",
  FontSlant->"Italic"],
 "]\nArcArrow[",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.457613625061556*^9, 3.45761364637638*^9}, {
   3.4576146046413536`*^9, 3.457614629257454*^9}, {3.457614747832013*^9, 
   3.45761475241475*^9}, {3.457614933961167*^9, 3.457614944592727*^9}, 
   3.5894722251249332`*^9},ExpressionUUID->"e9e0462e-f228-4a81-bf0e-\
ac0bf34651c8"],

Cell[TextData[{
 "EndArrow[",
 StyleBox["start",
  FontSlant->"Italic"],
 ", ",
 StyleBox["finish",
  FontSlant->"Italic"],
 "] creates an arrow with the arrowhead at the end. Note that we differ from \
the built-in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Arrow", "[", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["pt", "1"], ",", " ", 
      SubscriptBox["pt", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "09a1f470-a9a3-4dc3-b183-10c38f3dde91"],
 "}] in that the points are two different arguments, rather than a point pair."
}], "Text",
 CellChangeTimes->{{3.457614503597464*^9, 3.457614541570824*^9}, {
  3.457614640837193*^9, 3.457614694816555*^9}, {3.589466363511066*^9, 
  3.589466386863296*^9}},ExpressionUUID->"9c66992d-deab-40f7-9a01-\
4950b3b0641d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EndArrow", "[", 
   RowBox[{"start_", ",", " ", "finish_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Arrowheads", "[", "Medium", "]"}], ",", 
    RowBox[{"Arrow", "[", 
     RowBox[{"{", 
      RowBox[{"start", ",", "finish"}], "}"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.457614698676258*^9, 3.457614727641607*^9}},
 CellLabel->
  "In[887]:=",ExpressionUUID->"10340984-93a4-4334-be23-b1206dc48cec"],

Cell["Example", "Text",
 CellChangeTimes->{{3.457614545522763*^9, 
  3.457614546264435*^9}},ExpressionUUID->"734eeb25-ee8b-465f-88f4-\
d88a42c3225e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics", "[", 
   RowBox[{"{", 
    RowBox[{"EndArrow", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], "]"}], "}"}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.45761454939962*^9, 3.45761458858595*^9}, {
  3.457614731817446*^9, 3.457614739471842*^9}},
 CellLabel->
