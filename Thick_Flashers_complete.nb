}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "NRecoverCurve2DSystem[ ds, ",
 StyleBox["\[Kappa]l",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[NDSolve], Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{{3.799450734497087*^9, 3.7994507924117813`*^9}, {
   3.799450861994305*^9, 3.799450863762088*^9}, 3.799486751390749*^9, {
   3.7994869033805637`*^9, 3.799486903959707*^9}, {3.799487507098015*^9, 
   3.799487519699705*^9}, 3.799488853345255*^9, {3.7994889803447733`*^9, 
   3.799488981151876*^9}, 3.799490939573889*^9, 3.799491207868783*^9, 
   3.800464839891038*^9, 
   3.801317328254945*^9},ExpressionUUID->"65e61d21-456d-4a7c-b4e0-\
3a6035881929"],

Cell[TextData[{
 "NRecoverCurve2DSystem[ds, \[Kappa]l, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, opts] creates a 2D curve given specified curve speed and geodesic (left) \
torsion using numerical interpolation."
}], "Text",
 CellChangeTimes->{{3.799450814768171*^9, 3.799450834873296*^9}, 
   3.799450948450263*^9, {3.799487251233275*^9, 3.799487268270891*^9}, {
   3.799487530678258*^9, 3.799487540125266*^9}, 3.799488853360955*^9, 
   3.799490939589248*^9, 3.799491207882728*^9, 3.800464843173668*^9, 
   3.801317328285685*^9},ExpressionUUID->"74df5ba6-4314-4424-b3f6-\
f4b77ae2d2e7"],

Cell[TextData[{
 "Arguments:\n\tds \[LongDash] the curve speed as a pure function.\n\t\
\[Kappa]l \[LongDash] the left (geodesic) curvature as a pure function.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the curve parameter.\n\t",
 StyleBox["ci",
  FontSlant->"Italic"],
 " \[LongDash] initial position of the curve.\n\t",
 StyleBox["ti",
  FontSlant->"Italic"],
 " \[LongDash] initial tangent of the curve.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.799450839250968*^9, 3.79945091913232*^9}, {
   3.799487542754706*^9, 3.799487551869171*^9}, 3.799491207897328*^9, {
   3.799597253386043*^9, 3.799597258807156*^9}, 
   3.801317328313238*^9},ExpressionUUID->"e0d3eb5d-6a6b-4cd4-9ef0-\
8914caefdc75"],

Cell["\<\
Options:
\tOptions[NDSolve], Options[FunctionInterpolation] are passed through.\
\>", "Text",
 CellChangeTimes->{{3.799488961216237*^9, 
  3.7994889750618052`*^9}},ExpressionUUID->"29902d69-cb47-4575-8f96-\
d0953dcf8cc2"],

Cell["\<\
Returns: a list of rules giving pure functions for vectors and \
InterpolatingFunctions for scalar fields of the plane curve.\
\>", "Text",
 CellChangeTimes->{{3.691256589686189*^9, 
  3.69125664256*^9}},ExpressionUUID->"e4a0f691-0c16-4aae-b2e4-b83055f92fd9"],

Cell["\<\
There is a subtle issue here regarding the differential equation solution \
that we get from NDSolve for the curve function c[s]. If we use that function \
directly and feed it back to NCurveSystem[c,...], the latter will compute a \
delta-function in the geodesic curvature which, when interpolated, puts a \
substantial kink in the computed curvature (which can be seen by plotting \
it). Simply reinterpolating c[s] avoids the issue. To be consistent, we also \
reinterpolate t[s] and l[s], just in case there\[CloseCurlyQuote]s something \
similar lurking inside.\
\>", "Text",
 CellChangeTimes->{{3.799858254961391*^9, 3.799858286473297*^9}, {
  3.799858373474311*^9, 3.7998583810746512`*^9}, {3.799858470034898*^9, 
  3.799858519827011*^9}, {3.79985857866052*^9, 
  3.799858684772311*^9}},ExpressionUUID->"a5f9b787-4083-4194-a2df-\
19dc48727952"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NRecoverCurve2DSystem", "::", "nosoln"}], 
   "=", "\"\<NDSolve couldn't integrate the 2D curve equations.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.7994871182869396`*^9, 
   3.79948714206791*^9}, {3.799487560664079*^9, 3.79948756336404*^9}, 
   3.799488853365415*^9, 3.799490939593255*^9, 3.800464847162306*^9},
 CellLabel->
  "In[3636]:=",ExpressionUUID->"030d222a-7597-4740-a9ec-6bdf7b0426cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NRecoverCurve2DSystem", "[", 
   RowBox[{
    RowBox[{"ds_Function", "|", "ds_InterpolatingFunction"}], ",", 
    RowBox[{"\[Kappa]l_Function", "|", "\[Kappa]l_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "ci_List", ",", "ti_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "s", ",", "soln", ",", "tx", ",", "ty", ",", "lx", ",", 
      "ly", ",", "cx", ",", "cy", ",", "c", ",", "t", ",", "l", ",", 
      "\[Kappa]", ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"cx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"cy", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"ds", "[", "s", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "s", "]"}], ",", 
               RowBox[{"ty", "[", "s", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"tx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"ty", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"ds", "[", "s", "]"}], 
             RowBox[{"\[Kappa]l", "[", "s", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"lx", "[", "s", "]"}], ",", 
               RowBox[{"ly", "[", "s", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"lx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"ly", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"ds", "[", "s", "]"}]}], 
             RowBox[{"\[Kappa]l", "[", "s", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "s", "]"}], ",", 
               RowBox[{"ty", "[", "s", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"cx", "[", "ui", "]"}], ",", 
              RowBox[{"cy", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ci"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tx", "[", "ui", "]"}], ",", 
              RowBox[{"ty", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ti"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"lx", "[", "ui", "]"}], ",", 
              RowBox[{"ly", "[", "ui", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"RotationMatrix2D", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", "ti"}]}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cx", "[", "s", "]"}], ",", 
           RowBox[{"cy", "[", "s", "]"}], ",", 
           RowBox[{"tx", "[", "s", "]"}], ",", 
           RowBox[{"ty", "[", "s", "]"}], ",", 
           RowBox[{"lx", "[", "s", "]"}], ",", 
           RowBox[{"ly", "[", "s", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "NDSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"NRecoverCurve2DSystem", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cx", "[", "s", "]"}], ",", 
           RowBox[{"cy", "[", "s", "]"}]}], "}"}], "/.", "soln"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"c", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tx", "[", "s", "]"}], ",", 
           RowBox[{"ty", "[", "s", "]"}]}], "}"}], "/.", "soln"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"t", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lx", "[", "s", "]"}], ",", 
           RowBox[{"ly", "[", "s", "]"}]}], "}"}], "/.", "soln"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"l", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}], 
         RowBox[{"l", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve2D", "\[Rule]", "c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed2D", "\[Rule]", "ds"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LeftCurvature2D", "\[Rule]", "\[Kappa]l"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Curvature2D", "\[Rule]", "\[Kappa]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TangentVector2D", "\[Rule]", "t"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LeftNormalVector2D", "\[Rule]", "l"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalVector2D", "\[Rule]", "n"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.7994509525591087`*^9, 3.799450988708941*^9}, {
   3.79948665388072*^9, 3.799486705402948*^9}, {3.79948674667326*^9, 
   3.799487103427636*^9}, {3.799487146853024*^9, 3.799487158780837*^9}, {
   3.799487194309795*^9, 3.799487235823642*^9}, {3.799487452060792*^9, 
   3.799487457574492*^9}, {3.799487571110549*^9, 3.7994876079008408`*^9}, {
   3.79948767167154*^9, 3.7994876751384*^9}, {3.799488853370604*^9, 
   3.799488951822129*^9}, {3.799489046410342*^9, 3.799489074945938*^9}, {
   3.799490939596925*^9, 3.799490939599782*^9}, {3.799491207905564*^9, 
   3.79949120791721*^9}, {3.799492818201444*^9, 3.799492887954075*^9}, {
   3.799493204491421*^9, 3.799493451772107*^9}, {3.799512126551093*^9, 
   3.799512139393771*^9}, {3.799597228685421*^9, 3.799597245906234*^9}, {
   3.799858212187594*^9, 3.799858230803471*^9}, 3.799858291495566*^9, 
   3.79985846566966*^9, {3.799858690395364*^9, 3.799858723735715*^9}, {
   3.799858756975409*^9, 3.799858782856988*^9}, {3.800464860259674*^9, 
   3.800464864477209*^9}, {3.800643153969357*^9, 3.8006431543826523`*^9}, {
   3.801317328326214*^9, 3.801317328345794*^9}, {3.80173302021347*^9, 
   3.801733050026061*^9}},
 CellLabel->
  "In[3637]:=",ExpressionUUID->"65ddbfd2-da6a-4575-96f4-86574093fcd5"],

Cell["Example. A circle.", "Text",
 CellChangeTimes->{{3.799487309350591*^9, 3.799487325660516*^9}, {
