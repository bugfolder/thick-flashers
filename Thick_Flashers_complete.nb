Cell["\<\
Here\[CloseCurlyQuote]s a version using multi-wire hinges with the number of \
wires set automatically by minimum spacing. (This forces PrusaSlicer to run \
filaments transverse to all hinges, at the cost of potentially introducing \
\[OpenCurlyDoubleQuote]zipper-mode\[CloseCurlyDoubleQuote] weaknesses in the \
hinges.)\
\>", "Text",
 CellChangeTimes->{{3.925730963826405*^9, 
  3.925731051088806*^9}},ExpressionUUID->"4e6d1847-e867-48a8-8a47-\
efddc4ed75bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", "1"}], ",", 
       RowBox[{"h", "=", "2"}], ",", 
       RowBox[{"m", "=", "6"}], ",", 
       RowBox[{"t", "=", "0.15"}], ",", "tobj", ",", "panels", ",", 
       "panelinfo", ",", "joinedpanels"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"tobj", "=", 
       RowBox[{"MakeThickFlasher", "[", 
        RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
         RowBox[{"TypeMinimumAngle", "\[Rule]", 
          RowBox[{"10.", "\[Degree]"}]}], ",", 
         RowBox[{
         "FlasherSectorDiagFoldLines", "->", 
          "FlasherSectorDiagFoldLinesY"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
       RowBox[{"MakeThickFlasherPanels", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"FlasherScale", "->", "2.0"}], ",", 
         RowBox[{"PanelClearance", "->", "0.1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"joinedpanels", "=", 
       RowBox[{"ThickFlasherStowedHingeJoinPanels", "[", 
        RowBox[{
        "panels", ",", "panelinfo", ",", "tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"PanelClearance", "->", "0.1"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"PanelMinThickness", "->", "0.03"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CentralHingeThickness", "->", "0.05"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"OuterHingeThickness", "->", "0.03"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"HingeLengthInset", "->", "0.025"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"HingeType", "->", "HingeMultiWireGC"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"HingeNumWires", "->", "100"}], ",", "\[IndentingNewLine]", 
         RowBox[{"HingeMinWireGap", "->", "0.015"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
            "joinedpanels", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}], ",", "SolidStyle", ",", 
            RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
            "joinedpanels", "\[LeftDoubleBracket]", "2", 
             "\[RightDoubleBracket]"}], ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.911902955986402*^9, 3.911902958738657*^9}, {
