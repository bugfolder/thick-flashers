     "m", ",", "a", ",", "b", ",", "botpts2d", ",", "toppts2d", ",", "dz", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "24"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"rotational", " ", "order"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", "1.732"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dz", "=", "0.95"}], ";", "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "a"}], ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "b"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", 
          RowBox[{"-", "b"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"toppts2d", "=", 
      RowBox[{"RotateLeft", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RotationMatrix2D", "[", 
            RowBox[{"60", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
         "botpts2d"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
