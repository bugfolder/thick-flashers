  3.629848697448406*^9}},ExpressionUUID->"daa3d728-6645-42f1-92fb-\
be7dca8c48c9"],

Cell[TextData[{
 "{UnitRegularPolygonCenteredTwistTile, ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} represents an edge-centered simple flat twist in a unit ",
 StyleBox["n",
  FontSlant->"Italic"],
 "-gon where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of the pleat where it subtends the edge, \[Tau] is the pleat \
angle, defined as the rotation angle of the pleat measured with respect to \
the edge, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
