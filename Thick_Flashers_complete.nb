Cell[CellGroupData[{

Cell[TextData[{
 "MakeTLFFGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.534543177874239*^9, 3.534543190801265*^9}, 
   3.5345433926861467`*^9, {3.591792275534697*^9, 3.591792296483409*^9}, 
   3.5917934730403433`*^9, {3.592407266748285*^9, 3.5924073039442444`*^9}, {
   3.592433169330429*^9, 3.592433170122223*^9}, {3.592659974254388*^9, 
   3.5926599966742*^9}, {3.592828723978836*^9, 3.592828724088587*^9}, {
   3.592828834675614*^9, 3.592828834758089*^9}, {3.592853920075862*^9, 
   3.5928539284869328`*^9}},ExpressionUUID->"4f22c94c-be67-4174-96e5-\
e0b73b079600"],

Cell[TextData[{
 "MakeTLFFGraph",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TPlaneGraph whose interior vertices are all degree-4 and returns \
a new TLFFGraph that describes the local flat-foldability graph, where \
Vertices are the midpoints of the interior edges of the original graph, Edges \
is a list of the TLFFGraph\[CloseCurlyQuote]s edges (indexed on its \
vertices), and LFFEdgeTypes is a list of the parities associated with the \
edges, either +1 (for iso) or \[Dash]1 (for anto). The ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th vertex of the TLFFGraph corresponds to the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th edge of the original graph so that you can overlay the LFF graph onto \
the crease pattern defined by the original TPlaneGraph."
}], "Text",
 CellChangeTimes->{{3.534543395643952*^9, 3.534543511932049*^9}, {
   3.53454355694591*^9, 3.534543716231195*^9}, {3.591792563020006*^9, 
   3.5917926639872417`*^9}, {3.592418580561313*^9, 3.592418719500564*^9}, 
   3.592659974433786*^9, {3.592828724294384*^9, 3.592828724453897*^9}, {
   3.5928288349406767`*^9, 3.59282883540042*^9}, 
   3.592853920125833*^9},ExpressionUUID->"eb4916d1-faaf-4143-87c1-\
703a02451c29"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTLFFGraph", "::", "badstars"}], 
   "=", "\"\<The list of internal vertex adjacency, `1`, is not all degree-4.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5345462583430247`*^9, 3.534546293549054*^9}, {
   3.591896081728395*^9, 3.591896084271681*^9}, 3.592659974452709*^9, 
   3.592828835484706*^9, 3.592853920156818*^9},
 CellLabel->
  "In[2044]:=",ExpressionUUID->"87b22672-9127-4248-a373-73aab4bac98c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTLFFGraph", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "vva", ",", "boundary", ",", 
      "everts", ",", "eedges", ",", "edgetypes", ",", "eind", ",", "ivva", ",",
       "star", ",", "alist", ",", "tobj1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPlaneGraph", ",", "MakeTLFFGraph"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "faces", ",", "vva", ",", "boundary"}], 
       "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "Faces", ",", "VertexVertexAdjacency",
           ",", "BoundaryVertices"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"everts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Plus", "@@", 
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], "/",
          "2"}], "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edgetypes", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "need", " ", "a", " ", "lookup", " ", "function", " ", "that", " ", 
       "returns", " ", "edge", " ", "index", " ", "from", " ", "an", " ", 
       "index", " ", "pair"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"eind", "[", 
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         "]"}], "=", 
        RowBox[{
         RowBox[{"eind", "[", 
          RowBox[{"Reverse", "[", 
           RowBox[{
           "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "]"}], "]"}], "=", "i"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "select", " ", "the", " ", "vertex", " ", "adjacency", " ", "stars", " ",
        "that", " ", 
       RowBox[{"aren", "'"}], "t", " ", "on", " ", "the", " ", "boundary"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ivva", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
              "#1"}], "}"}], "&"}], ",", "vva"}], "]"}], ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"boundary", ",", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "]"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"they", " ", "better", " ", "all", " ", "be", " ", "degree"}], 
       "-", "4"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"And", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "]"}], "\[Equal]", "4"}], "&"}], "/@", "ivva"}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTLFFGraph", "::", "badstars"}], ",", "ivva"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"star", "=", 
         RowBox[{
         "ivva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "Each", " ", "element", " ", "of", " ", "alist", " ", "describes", " ",
            "a", " ", "sector", " ", "angle"}], ",", " ", 
          RowBox[{
          "consisting", " ", "of", " ", "the", " ", "vertex", " ", "index"}], 
          ",", " ", 
          RowBox[{
          "indices", " ", "of", " ", "the", " ", "2", " ", "vertices", " ", 
           "that", " ", "define", " ", "the", " ", "sector", " ", "angle"}], ",",
           " ", 
          RowBox[{
          "and", " ", "the", " ", "value", " ", "of", " ", "the", " ", 
           "sector", " ", "angle", " ", "itself"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"alist", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
