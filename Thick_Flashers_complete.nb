Cell["Example of chaining multiple classes.", "Text",
 CellChangeTimes->{{3.592669395031927*^9, 3.59266940038249*^9}, 
   3.59266960418864*^9},ExpressionUUID->"b119ca2e-0cc6-4554-97b1-\
bc08ad3e9758"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTObj", "[", 
         RowBox[{"X", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A", "\[Rule]", "1"}], ",", 
            RowBox[{"B", "\[Rule]", "2"}]}], "}"}]}], "]"}], "//", 
        RowBox[{"AddClass", "[", 
         RowBox[{"Y", ",", 
          RowBox[{"{", 
           RowBox[{"C", "\[Rule]", "3"}], "}"}]}], "]"}]}], "//", 
       RowBox[{"AddClass", "[", 
        RowBox[{"Z", ",", 
         RowBox[{"{", 
          RowBox[{"D", "\[Rule]", "4"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GetAllRules", "[", "tobj", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592347205482222*^9, 3.592347264163422*^9}, 
   3.592347384224559*^9, {3.592348515791878*^9, 3.59234851675492*^9}, {
   3.592348590136859*^9, 3.592348593788693*^9}, 3.592348735024459*^9, {
   3.592440460973012*^9, 3.592440464163888*^9}, 3.592465161876241*^9, 
   3.592668608017305*^9, {3.592668914910537*^9, 3.592668920116997*^9}, {
   3.592669410027177*^9, 3.592669420169465*^9}, 3.592669567732853*^9, 
   3.592670433832928*^9, 3.592670629632625*^9, 3.5926710675907297`*^9, 
   3.628786727176514*^9, 3.628786794456523*^9},
 CellLabel->
  "In[1011]:=",ExpressionUUID->"ab481226-4869-4426-a6e6-4828d909f234"],

Cell[TextData[{
 "HasClassQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class",
  FontSlant->"Italic"],
 "] returns True if ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " belongs to ",
 "TClasses",
 " ",
 StyleBox["class",
  FontSlant->"Italic"],
 ". A class is different from a property because a TObj can only have a \
single value for each property but it can belong to several classes at the \
same time. Typically classes will be related to one another in an inheritance \
hierarchy."
}], "Text",
 CellChangeTimes->{{3.59234517084853*^9, 3.592345204710191*^9}, {
   3.592345284433036*^9, 3.5923453391766863`*^9}, {3.592346205835195*^9, 
   3.592346219162642*^9}, 3.592407075294656*^9, 3.592435735499902*^9, 
   3.592435825543645*^9, 
   3.592654739084322*^9},ExpressionUUID->"7254b0bd-1b5f-44d8-b5a9-\
4b809ea26b76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HasClassQ", "[", 
   RowBox[{"tobj_TObj", ",", " ", "class_Symbol"}], "]"}], ":=", 
  RowBox[{"MemberQ", "[", 
   RowBox[{
    RowBox[{"GetValue", "[", 
     RowBox[{"tobj", ",", "TClasses"}], "]"}], ",", "class"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.592345347032496*^9, 3.592345380404629*^9}, 
   3.592407075315298*^9, 3.592435735572397*^9, 3.592435825625409*^9, 
   3.592654739179571*^9},
 CellLabel->
  "In[1012]:=",ExpressionUUID->"b8bd137d-e3e5-4e87-b674-5981decef2ed"],

Cell[TextData[{
 "AssertClass",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["where",
  FontSlant->"Italic"],
 "] returns True if the TObj belongs to the given class. If it doesn\
\[CloseCurlyQuote]t, it  issues an error message and Aborts using ",
 StyleBox["where",
  FontSlant->"Italic"],
 " to describe the context, typically, the name of the calling function or \
definition."
}], "Text",
 CellChangeTimes->{{3.592346123408546*^9, 3.592346142527381*^9}, {
   3.592346235985585*^9, 3.5923462666388593`*^9}, {3.592430792297946*^9, 
   3.592430889603685*^9}, {3.5924310319633017`*^9, 3.59243108312748*^9}, {
   3.5924312701794653`*^9, 3.592431270355995*^9}, {3.5924313116011147`*^9, 
   3.592431311784925*^9}, {3.592431435642325*^9, 3.59243143620984*^9}, 
   3.592435735677739*^9, 3.593006100553793*^9, {3.593006383898088*^9, 
   3.593006394049736*^9}, 
   3.6149595017644467`*^9},ExpressionUUID->"2c8dcf87-7860-4904-8f7f-\
a0ffa7424227"],

Cell[TextData[{
 "AssertClass",
 " helps you deal with the common ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " phenomenon that an error occurs deeply inside a nested series of functions \
and ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " barfs, but continues on its merry way, spewing errors galore to the \
Messages console until it finally encounters a fatal error. In our system, we \
assume that all dynamic type errors are fatal. Iif you\[CloseCurlyQuote]ve \
made a type error (passing the wrong kind of class to a function), you don\
\[CloseCurlyQuote]t want ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to keep trying things with the deficient object; you want it to stop right \
there and flag the error. So, most publicly exposed functions that take TObj\
\[CloseCurlyQuote]s as arguments check the class(es) of the passed-in \
arguments and if they aren\[CloseCurlyQuote]t of the right type, it aborts \
and tells you at least what function the error happened inside of."
}], "Text",
 CellChangeTimes->{{3.5926547994757433`*^9, 3.5926550723122993`*^9}, 
   3.593006100797285*^9},ExpressionUUID->"7701bb2c-b01a-4efd-bbdf-\
9e6a4b7e09b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AssertClass", "::", "missing"}], 
   "=", "\"\<In `1`, `2` is not a `3`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59234633629656*^9, 3.592346403302779*^9}, {
   3.592431134127887*^9, 3.592431148477935*^9}, 3.593006100816987*^9, 
   3.6758073373185797`*^9},
 CellLabel->
  "In[1013]:=",ExpressionUUID->"fe7404c9-351e-4513-9bac-29d3e5e90963"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AssertClass", "::", "nottobj"}], 
   "=", "\"\<`1` is not a TObj.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627948553897115*^9, 3.6279485757487693`*^9}},
 CellLabel->
  "In[1014]:=",ExpressionUUID->"4de68221-bb55-43de-a187-64b36476dff1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AssertClass", "[", 
   RowBox[{"tobj_", ",", "___"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Message", "[", 
     RowBox[{
      RowBox[{"AssertClass", "::", "nottobj"}], ",", "tobj"}], "]"}], ";", 
    RowBox[{"Abort", "[", "]"}], ";"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.627948582226314*^9, 3.627948680326489*^9}},
 CellLabel->
  "In[1015]:=",ExpressionUUID->"0eb51ea7-e256-4423-9bf0-08eb51c879c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AssertClass", "[", 
   RowBox[{"tobj_TObj", ",", " ", "class_Symbol", ",", 
    RowBox[{"where_", ":", "\"\<<unspecified>\>\""}]}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "TClasses"}], "]"}], ",", "class"}], "]"}], ",", 
    "True", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Message", "[", 
      RowBox[{
       RowBox[{"AssertClass", "::", "missing"}], ",", "where", ",", "tobj", ",",
        "class"}], "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.592346405267478*^9, 3.59234651004128*^9}, 
   3.592346882147812*^9, {3.592346985325735*^9, 3.592346985662171*^9}, {
   3.592349186929934*^9, 3.592349218407721*^9}, {3.5923492544782133`*^9, 
   3.592349254843149*^9}, {3.59243111479646*^9, 3.592431126129985*^9}, {
   3.5924311744402113`*^9, 3.592431184109689*^9}, 3.592435735756569*^9, {
   3.592435825725534*^9, 3.59243582579138*^9}, {3.592654739279659*^9, 
   3.592654739347672*^9}, {3.593006100865555*^9, 3.593006100900448*^9}, {
   3.675807353633824*^9, 3.6758073541268177`*^9}},
 CellLabel->
  "In[1016]:=",ExpressionUUID->"b2b54a15-4673-40ce-bbd1-1ad422180f8e"],

