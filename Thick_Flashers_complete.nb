Cell[TextData[{
 "CircularlyExtendEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts, ctr, r",
  FontSlant->"Italic"],
 "] extends the edges of a TObj and returns the modified TObj."
}], "Text",
 CellChangeTimes->{{3.597494599419369*^9, 3.597494623824992*^9}, {
  3.59749466709408*^9, 
  3.597494671045821*^9}},ExpressionUUID->"de823c59-ecd1-4e26-8c71-\
2a81aa8f024f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CircularlyExtendEdges", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", 
    StyleBox["bverts_List",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["ctr_List",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["r_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "newverts"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newverts", "=", 
      RowBox[{"CircularlyExtendEdges", "[", 
       RowBox[{"verts", ",", "edges", ",", "bverts", ",", "ctr", ",", "r"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices", "\[Rule]", "newverts"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
