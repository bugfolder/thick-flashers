Cell[CellGroupData[{

Cell["Constraints", "Subsection",
 CellChangeTimes->{{3.911880912048502*^9, 3.91188091886793*^9}, 
   3.911885026801845*^9},ExpressionUUID->"b8e558ad-16ab-41f9-879c-\
3ed6f26eb733"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.719932898469047*^9, 
  3.719932899411323*^9}},ExpressionUUID->"9e9e99e0-6ee7-4bb7-8718-\
9285aaad4687"],

Cell[TextData[{
 "The functions in this section generate the thick-flasher-specific equations \
that we solve to find the CP, DP, and FF of a thick flasher. All equations \
are given in terms of subscripted scalar variables, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "95abe76a-d6f6-423d-a32f-f25bc16f069f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "0f280211-0ec2-4168-a1e3-dc2c1a52e551"],
 ". See similarly-named functions for ordinary flashers and parabolic \
flashers."
}], "Text",
 CellChangeTimes->{{3.7199329013959107`*^9, 3.719932959953071*^9}, {
  3.719933442308381*^9, 3.719933442764176*^9}, {3.913544734562791*^9, 
  3.913544795088831*^9}},ExpressionUUID->"8d2b13ed-1e13-434d-9a76-\
e1d0a2a372f3"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherIsometryFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FlasherSectorDiagFoldLines"
}], "Subsubsection",
 CellChangeTimes->{{3.555780275359147*^9, 3.555780277529156*^9}, 
   3.555838016515161*^9, 3.555854316300352*^9, 3.555854353118908*^9, {
   3.719868815331238*^9, 3.719868819997046*^9}, 3.719925980131103*^9, {
   3.7199315688942633`*^9, 3.719931571052328*^9}, {3.825607158921658*^9, 
   3.825607170321612*^9}, 3.8256792864857073`*^9, 3.911828441553198*^9, {
   3.911834394433446*^9, 
   3.911834399430608*^9}},ExpressionUUID->"4c1094b6-c93a-44ec-9116-\
4ed64879b370"],

Cell[TextData[{
 "ThickFlasherIsometryFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m, t, opts",
  FontSlant->"Italic"],
 "] returns a list of functions whose value must be zero when isometry is \
satisfied: DP length = FF length for each segment."
}], "Text",
 CellChangeTimes->{{3.555768370803039*^9, 3.555768426711442*^9}, {
   3.5557722685242*^9, 3.555772285818809*^9}, {3.555780306024274*^9, 
   3.5557803433232727`*^9}, {3.555789132797584*^9, 3.555789140328512*^9}, 
   3.555838016549026*^9, 3.555854316394964*^9, 3.555854353220299*^9, {
   3.719868815343635*^9, 3.719868824853323*^9}, 3.7199259801487627`*^9, {
   3.719932081478602*^9, 3.71993208263758*^9}, {3.825607175913307*^9, 
   3.825607189465219*^9}, 3.911828441586369*^9, {3.9118344092167263`*^9, 
   3.911834417471532*^9}},ExpressionUUID->"5c29d6ac-753f-406f-9d16-\
b97fa808b874"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] A list of the symbolic variables of the form {",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["px",
  FontSlant->"Italic"],
 ", ",
 StyleBox["py",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppy",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppz",
  FontSlant->"Italic"],
 "} where\n\t\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " is the symbol for points in the DP, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "9b20e540-ed25-4dec-9590-0a892bb63640"],
 ".\n\t\t",
 StyleBox["px",
  FontSlant->"Italic"],
 ", ",
 StyleBox["py",
  FontSlant->"Italic"],
 " are the scalar variables used for x and y coordinates of the DP, .e.g, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["px",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "97763e7e-4966-4084-9898-393382efbf91"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["py",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "70720498-70e3-432f-9ad1-8d6c048fdafb"],
 ". Note, no ",
 StyleBox["k",
  FontSlant->"Italic"],
 "-dependence due to rotational symmetry. Sag values (third coordinate of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "3179afe5-dff3-4233-b6d2-f40f57787903"],
 ") are computed.\n\t\t",
 StyleBox["pp",
  FontSlant->"Italic"],
 " is the symbol for points in the FF, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["pp",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "9f177c82-d9ac-47e2-8503-3e90b7a00df4"],
 ".\n\t\t",
 StyleBox["ppx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppy",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppz",
  FontSlant->"Italic"],
 " are the scalar variables used for coordinates of the FF, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["ppx",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "cef84014-94b1-40dd-bf9c-b86922e60bb1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["ppy",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "8daed9e3-48a7-4d24-b8d8-6f41eeef728d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["ppz",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "1ae793a9-7706-4242-bb0a-b93b38f556d3"],
 ".\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the number of rings.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational symmetry.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the desired thickness of the DP (used to define the sag values \
in the unfolded (deployed) form)."
}], "Text",
 CellChangeTimes->{{3.9118388009082327`*^9, 3.911839059495854*^9}, {
  3.911839142921675*^9, 3.9118391520110397`*^9}, {3.9118391990257664`*^9, 
  3.911839262431355*^9}, {3.913476666549242*^9, 
  3.913476674243342*^9}},ExpressionUUID->"3ca552f4-1a25-4671-bb4f-\
0786795bc2ee"],

Cell[TextData[{
 "Options:\n\tFlasherSectorDiagFoldLines \[Rule] ",
 StyleBox["f",
  FontSlant->"Italic"],
 ", to specify which diagonals are used. Passed through to \
FlasherSectorFoldLines."
}], "Text",
 CellChangeTimes->{{3.719932092911273*^9, 
  3.719932139948949*^9}},ExpressionUUID->"52cc0397-3298-4c42-a1c2-\
762f94ee786c"],

Cell["\<\
This is the same as FlasherIsometryFns, but for thick flashers. Instead of \
enforcing isometry between the CP and FF, it enforces isometry between the DP \
and FF.\
\>", "Text",
 CellChangeTimes->{
  3.719932085524315*^9, {3.825679300093281*^9, 3.825679328790861*^9}, {
   3.911834428528118*^9, 
   3.91183442894872*^9}},ExpressionUUID->"ceea2a6c-d49c-4ee4-a734-\
08f3c4d0c50f"],

Cell["\<\
See also ParaboloidalFlasherIsometryFns, which this is similar to in that \
both use a 3-dimensional deployed pattern (DP).\
\>", "Text",
 CellChangeTimes->{{3.911834513302656*^9, 3.911834530048196*^9}, {
  3.913544828501834*^9, 
  3.913544841372802*^9}},ExpressionUUID->"78a33249-694f-4050-aa52-\
bded00772a36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherIsometryFns", "[", 
   RowBox[{
   "vars_", ",", "r_", ",", "h_", ",", "m_", ",", "t_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "v", ",", "fs", ",", "lp", ",", "dfn", ",", "dp", ",", "dpp"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"first", " ", "sector", " ", "of", " ", "flasher"}], ",", " ", 
       
       RowBox[{"symbolic", " ", "variable", " ", "v"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{"FlasherSectorFoldLines", "[", 
       RowBox[{
        StyleBox["v",
         FontSlant->"Italic"], ",", 
        StyleBox["r",
         FontSlant->"Italic"], ",", 
        StyleBox["h",
         FontSlant->"Italic"], 
        StyleBox[",",
         FontSlant->"Italic"], 
        StyleBox["0",
         FontSlant->"Italic"], 
        StyleBox[",",
         FontSlant->"Italic"], 
        StyleBox["opts",
         FontSlant->"Italic"]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "all", " ", "line", " ", "segment", " ", "vertex", " ", "pairs", " ", 
       "in", " ", "the", " ", "first", " ", "sector"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"lp", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"fs", ",", 
          RowBox[{"Line", "[", "_", "]"}], ",", "\[Infinity]"}], "]"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "distance", " ", "fn", " ", "that", " ", "takes", " ", "a", " ", "list",
        " ", "of", " ", "point", " ", "pairs"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dfn", "=", 
      RowBox[{
       RowBox[{"Mag", "[", 
        RowBox[{"Subtract", "@@", "#"}], "]"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Scalarize", " ", "dp", " ", "pairs", " ", "and", " ", "compute", " ", 
       "length"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dp", "=", 
      RowBox[{"dfn", "/@", 
       RowBox[{"N", "[", 
        RowBox[{"ThickFlasherScalarize", "[", 
         RowBox[{"vars", ",", 
          RowBox[{"lp", "/.", 
           RowBox[{"v", "\[Rule]", "p"}]}], ",", "r", ",", "h", ",", "m", ",",
           "t"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Scalarize", " ", "ff", " ", "pairs", " ", "and", " ", "compute", " ", 
       "length"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dpp", "=", 
      RowBox[{"dfn", "/@", 
       RowBox[{"N", "[", 
        RowBox[{"ThickFlasherScalarize", "[", 
         RowBox[{"vars", ",", 
          RowBox[{"lp", "/.", 
           RowBox[{"v", "\[Rule]", "pp"}]}], ",", "r", ",", "h", ",", "m", ",",
           "t"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"return", " ", "difference", " ", "between", " ", "lengths"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dpp", "-", "dp"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.55576846937304*^9, 3.5557685968683147`*^9}, {
   3.555768632111178*^9, 3.555768649309908*^9}, {3.555768683811018*^9, 
   3.555768873307034*^9}, {3.555768929658718*^9, 3.555768983255069*^9}, {
   3.555769111619939*^9, 3.555769181523418*^9}, {3.555769243676826*^9, 
   3.555769331164014*^9}, {3.555769366882574*^9, 3.555769376028386*^9}, {
   3.5557694087994947`*^9, 3.555769632616748*^9}, {3.5557696682785587`*^9, 
   3.555769803510561*^9}, {3.5557768760337687`*^9, 3.555776878220969*^9}, {
   3.555778233870908*^9, 3.555778239298958*^9}, {3.555778503005746*^9, 
   3.555778540075726*^9}, {3.555778593960585*^9, 3.5557785952739153`*^9}, {
   3.555779438591881*^9, 3.555779442973919*^9}, {3.555788856931918*^9, 
   3.555788857024246*^9}, {3.555790034204051*^9, 3.555790034228225*^9}, 
   3.555790082032705*^9, {3.555805218341537*^9, 3.555805223017948*^9}, {
   3.55580526495388*^9, 3.555805268745501*^9}, {3.555805355827932*^9, 
   3.55580535824148*^9}, {3.5558054077923183`*^9, 3.555805432748993*^9}, {
   3.555835372420403*^9, 3.5558353747072268`*^9}, 3.555838016572718*^9, {
   3.555854316475465*^9, 3.55585431654349*^9}, {3.555854353310375*^9, 
   3.5558543533770437`*^9}, {3.5559538106154003`*^9, 3.555953816578834*^9}, 
   3.71985341698151*^9, {3.719868815351284*^9, 3.719868882141933*^9}, {
   3.719925980160534*^9, 3.719925980175416*^9}, 3.719926067398695*^9, {
   3.719932145822009*^9, 3.719932150868198*^9}, {3.7199334674139013`*^9, 
   3.719933529309382*^9}, {3.719933559429541*^9, 3.719933563750798*^9}, {
   3.719942738617432*^9, 3.719942742863065*^9}, {3.82560719644313*^9, 
   3.825607230285041*^9}, {3.911828158181841*^9, 3.911828158186977*^9}, 
   3.9118284416015863`*^9, 3.9118344388104343`*^9, {3.911834498922388*^9, 
   3.911834502740757*^9}, {3.911834534908088*^9, 3.9118345360608463`*^9}, {
   3.911838338404097*^9, 3.911838338776306*^9}, {3.911844837220317*^9, 
   3.911844842585886*^9}, {3.911844873570244*^9, 3.911844878113516*^9}, {
   3.9118808613295794`*^9, 3.911880861332346*^9}, {3.913544866755225*^9, 
   3.913544866887973*^9}},
 CellLabel->
  "In[4482]:=",ExpressionUUID->"8aa93422-fef0-406c-bb52-2d1557918805"],

Cell["\<\
Example. Since our default solution is fairly close to correct, these numbers \
should all be pretty small.\
\>", "Text",
 CellChangeTimes->{{3.555768985847327*^9, 3.5557689895465117`*^9}, {
  3.555779451021374*^9, 3.5557794620849953`*^9}, {3.719945503647086*^9, 
  3.719945505727211*^9}, {3.913544911799737*^9, 
  3.913544912586522*^9}},ExpressionUUID->"3a29aacc-0354-4129-ac3f-\
bc059a697207"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "4"}], ",", 
     RowBox[{"t", "=", ".2"}], ",", "vars", ",", "ifns", ",", "srules"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"FlasherVars", "[", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ifns", "=", 
     RowBox[{"ThickFlasherIsometryFns", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"srules", "=", 
     RowBox[{"FlasherDefaultScalarRules", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ifns", "/.", "srules"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
