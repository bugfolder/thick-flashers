              RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "qvfc"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
