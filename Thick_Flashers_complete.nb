2a1194f525db"],

Cell[TextData[{
 "MakeSimpleWovenTessellationOld[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["inset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs a woven tessellation from a TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " and inset distance ",
 StyleBox["inset",
  FontSlant->"Italic"],
 ", and returns a TGraph2D+TAssigned that describe the crease pattern and \
folded form. The width of the woven strips is twice the inset distance ",
 StyleBox["inset",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.462801090830243*^9, 3.4628011766818523`*^9}, {
