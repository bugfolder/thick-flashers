   3.799599763770184*^9}, {3.799599868914957*^9, 3.799599869866759*^9}, 
   3.799601034415482*^9, {3.799602614869937*^9, 
   3.799602619166463*^9}},ExpressionUUID->"6232427a-7128-4d8e-a96d-\
848a18c3c998"],

Cell[TextData[{
 "NConstantWidthScale2D[",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w0",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the scaling function ",
 StyleBox["w",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] that puts the point ",
 StyleBox["b",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "]+",
 StyleBox["w",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] ",
 StyleBox["d",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] at a perpendicular offset ",
 StyleBox["w0",
  FontSlant->"Italic"],
 " from the curve ",
 StyleBox["b",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] in 2D."
}], "Text",
 CellChangeTimes->{
  3.799598260328206*^9, {3.7995984255766783`*^9, 3.799598517513376*^9}, {
   3.799598600874802*^9, 3.7995986173698683`*^9}, {3.799599648489292*^9, 
   3.799599659705914*^9}, {3.799599781354108*^9, 3.799599782320483*^9}, 
   3.799599867123399*^9},ExpressionUUID->"0c8fd9b9-cf70-4593-a7d7-\
c52fbaaa2ae4"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the curve, as a pure function.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] the directrix of the curve as a pure function.\n\t",
 StyleBox["w0",
  FontSlant->"Italic"],
 " \[LongDash] the desired distance from the curve in the direction of d. Can \
be either + or \[Dash].\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.7995985205448017`*^9, 3.799598578601894*^9}, {
   3.799599662017919*^9, 3.799599670057985*^9}, {3.7995997670905123`*^9, 
   3.799599799490016*^9}, 3.799599872411229*^9, {3.799601073859335*^9, 
   3.7996010846836987`*^9}},ExpressionUUID->"94002bbb-3f41-40ae-b3f0-\
b03d2d2d7b0a"],

Cell["\<\
We only offer a numeric function because analytic functions are rarely \
directly solvable, and even when soluble, the analytic equations may have \
multiple solutions (for example, if the ruling lines form a cusp).\
\>", "Text",
 CellChangeTimes->{{3.799599802170363*^9, 
  3.799599946011812*^9}},ExpressionUUID->"57518b4b-74e7-4d33-9a4b-\
5ed006856556"],

Cell["\<\
Note that with angled directors, the \[OpenCurlyDoubleQuote]point of \
perpendicular distance\[CloseCurlyDoubleQuote] can lie off of the curve (as \
you can see in the example). So we extrapolate things linearly, assuming that \
the extrapolated curve is straight and tangent to the original curve and that \
the ruling angles are constant along the curve. If you need precision near \
the endpoints, then generate the interpolated curve over a larger region and \
then take a subset of its length for the constant-width calculation.\
\>", "Text",
 CellChangeTimes->{{3.7996043455144176`*^9, 
  3.799604478250745*^9}},ExpressionUUID->"c8029c3e-3a3f-42f8-8978-\
81705826e121"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NConstantWidthScale2D", "::", "nosoln"}], 
   "=", "\"\<FindRoot couldn't find a root to the width equation at \
`1`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.7994871182869396`*^9, 
   3.79948714206791*^9}, {3.799487560664079*^9, 3.79948756336404*^9}, 
   3.799488853365415*^9, 3.799490939593255*^9, {3.799600950061861*^9, 
   3.7996009620272284`*^9}, {3.799603283589793*^9, 3.799603285035128*^9}, 
   3.7996196473583813`*^9},
 CellLabel->
  "In[3873]:=",ExpressionUUID->"575136cc-2131-4016-948c-93b84d8b4ce7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NConstantWidthScale2D", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.799415376038302*^9, 3.7994153855383797`*^9}, 
   3.799570395657018*^9, 3.799598350891574*^9, 3.79960033495303*^9, 
   3.7996196473658857`*^9},
 CellLabel->
  "In[3874]:=",ExpressionUUID->"798a3452-bf8a-4113-92ad-38a284d06161"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NConstantWidthScale2D", "[", 
   RowBox[{
    RowBox[{"b_Function", "|", "b_InterpolatingFunction"}], ",", 
    RowBox[{"d_Function", "|", "d_InterpolatingFunction"}], ",", "w0_", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fiopts", ",", "s", ",", "bp", ",", "t", ",", "l", ",", "be", ",", "te", 
      ",", "le", ",", "ui", ",", "wi", ",", "wfn"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fiopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"tangent", " ", "and", " ", "left", " ", "normal"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bp", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"b", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"NormalizeReal", "[", 
         RowBox[{"bp", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", 
         RowBox[{"t", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "extended", " ", "versions", " ", "to", " ", "allow", " ", "for", " ", 
       RowBox[{"extrapolation", ".", " ", "Assume"}], " ", "straight", " ", 
       RowBox[{"lines", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"be", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"s", "\[LessEqual]", "u0"}], ",", 
          RowBox[{
           RowBox[{"b", "[", "u0", "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s", "-", "u0"}], ")"}], 
            RowBox[{"bp", "[", "u0", "]"}]}]}], ",", 
          RowBox[{"s", "\[GreaterEqual]", "u1"}], ",", 
          RowBox[{
           RowBox[{"b", "[", "u1", "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s", "-", "u1"}], ")"}], 
            RowBox[{"bp", "[", "u1", "]"}]}]}], ",", "True", ",", 
          RowBox[{"b", "[", "s", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"te", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"s", "\[LessEqual]", "u0"}], ",", 
          RowBox[{"t", "[", "u0", "]"}], ",", 
          RowBox[{"s", "\[GreaterEqual]", "u1"}], ",", 
          RowBox[{"t", "[", "u1", "]"}], ",", "True", ",", 
          RowBox[{"t", "[", "s", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"le", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"s", "\[LessEqual]", "u0"}], ",", 
          RowBox[{"l", "[", "u0", "]"}], ",", 
          RowBox[{"s", "\[GreaterEqual]", "u1"}], ",", 
          RowBox[{"l", "[", "u1", "]"}], ",", "True", ",", 
          RowBox[{"l", "[", "s", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"This", " ", "solves", " ", "the", " ", "width", " ", 
        RowBox[{"equation", ".", " ", "Note"}], " ", "the", " ", 
        "restriction", " ", "to", " ", "numeric"}], ",", " ", 
       RowBox[{"otherwise", " ", 
        RowBox[{"badness", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"wfn", "[", 
       RowBox[{"s_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"b", "[", "s", "]"}], "+", 
              RowBox[{"wi", " ", 
               RowBox[{"d", "[", "s", "]"}]}]}], "\[Equal]", 
             RowBox[{
              RowBox[{"b", "[", "ui", "]"}], "+", 
              RowBox[{"w0", " ", 
               RowBox[{"l", "[", "ui", "]"}], 
               RowBox[{"Sign", "[", 
                RowBox[{
                 RowBox[{"l", "[", "ui", "]"}], ".", 
                 RowBox[{"d", "[", "ui", "]"}]}], "]"}]}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"wi", ",", 
               RowBox[{".5", "w0"}], ",", "w0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"ui", ",", "s", ",", 
               RowBox[{"s", "+", 
                RowBox[{".01", 
                 RowBox[{"(", 
                  RowBox[{"u1", "-", "u0"}], ")"}]}]}]}], "}"}]}], "}"}]}], 
          "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"NConstantWidthScale2D", "::", "nosoln"}], ",", "s"}], 
          "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"FindRoot", "::", "cvmit"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Quiet", "[", 
      RowBox[{
       RowBox[{"FunctionInterpolation", "[", 
        RowBox[{
         RowBox[{"wfn", "[", "s", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "fiopts", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FunctionInterpolation", "::", "dmval"}], ",", 
         RowBox[{"FunctionInterpolation", "::", "ncvb"}]}], "}"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->CompressedData["
