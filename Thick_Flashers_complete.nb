       RowBox[{"{", 
        RowBox[{"v1", ",", "v2", ",", "v3", ",", "v4"}], "}"}], "+", 
       RowBox[{"hth", 
        RowBox[{"{", 
         RowBox[{"e1", ",", "e2", ",", "e3", ",", "e4"}], "}"}]}], "+", 
       RowBox[{"hth", 
        RowBox[{"{", 
         RowBox[{"u1", ",", "u2", ",", "u3", ",", "u4"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s5", ",", "s6", ",", "s7", ",", "s8"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s1", ",", "s2", ",", "s3", ",", "s4"}], "}"}], "-", 
       RowBox[{"ht", 
        RowBox[{"{", 
         RowBox[{"u1", ",", "u2", ",", "u3", ",", "u4"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Debugging", " ", 
