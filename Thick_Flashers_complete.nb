             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
