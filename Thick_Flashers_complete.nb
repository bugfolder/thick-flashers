   3.707865322740394*^9},ExpressionUUID->"b8def5d8-bd39-4560-87d2-\
f2d39c2beb4c"],

Cell[TextData[{
 "MonolithicEmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] embeds a tiling as a single TGraphAssigned by merging individual tiles."
}], "Text",
 CellChangeTimes->{{3.707836500641687*^9, 3.707836546655613*^9}, {
  3.707836582304219*^9, 3.707836589239737*^9}, {3.707864416797285*^9, 
  3.7078644481061716`*^9}},ExpressionUUID->"5f0bdfb6-1dfc-4554-ab24-\
6f948997520f"],

Cell[TextData[{
 "Options:\n\tKillMergedEdges \[Rule] True | False, specify whether to remove \
borders edges of tiles.\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", tolerance on whether two vertices are distinct.\n\tCollinearCleanup \
\[Rule] True | False, specify whether to remove degree-2 vertices between \
collinear edges.\n\tCollinearTolerance \[Rule] tol, tolerance on whether two \
edges at degree-2 vertices are collinear."
}], "Text",
 CellChangeTimes->{{3.707777850542234*^9, 3.707777853581541*^9}, {
   3.707778293920401*^9, 3.70777842795789*^9}, {3.707781820295705*^9, 
   3.707781862978016*^9}, 3.707823804527522*^9, 3.707824770447994*^9, 
   3.707824974120908*^9, {3.70782556161154*^9, 3.707825563363729*^9}, {
   3.707832655987712*^9, 3.707832669492002*^9}, {3.7078642049287176`*^9, 
   3.707864244948243*^9}, {3.707864602319542*^9, 
   3.707864652147869*^9}},ExpressionUUID->"7158920a-f47b-46cd-aac1-\
de8822c326f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MonolithicEmbedTiling", "[", 
   RowBox[{"tiling_List", ",", "TGraphAssigned", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cc", ",", "kme", ",", "tlist", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kme", "=", 
      RowBox[{
       RowBox[{"KillMergedEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MonolithicEmbedTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"CollinearCleanup", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MonolithicEmbedTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tlist", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"tiling", ",", "TGraphAssigned"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MergeGraphAssigneds", "[", 
       RowBox[{"tlist", ",", 
        RowBox[{"KillMergedEdges", "\[Rule]", "kme"}], ",", "opts"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"cc", ",", 
       RowBox[{"tobj", "=", 
        RowBox[{"CollinearCleanupGraphAssigned", "[", "tobj", "]"}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.630160978600581*^9, 3.63016099822439*^9}, {
   3.630161058580984*^9, 3.630161076601981*^9}, {3.707767435949171*^9, 
