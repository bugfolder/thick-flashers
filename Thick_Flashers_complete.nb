Cell[TextData[{
 "RenderTile[{QuadrilateralSplitTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TileVertices, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the vertices of the tiling polygon."
}], "Text",
 CellChangeTimes->{{3.629826543752584*^9, 3.629826558268348*^9}, 
   3.63001835571412*^9, 3.630072604351982*^9, 3.630072950190323*^9, 
   3.707758146552753*^9},ExpressionUUID->"50b087fa-2737-429f-85ac-\
486671217c55"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "QuadrilateralSplitTwistTile", ",", "verts_List", ",", "w_", ",", "d_", ",",
       "\[Tau]_", ",", "ccw_", ",", "ip_", ",", "ctype_", ",", "types_List"}],
      "}"}], ",", "TileVertices", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "verts", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "types", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"QuadrilateralSplitTwistTile", "::", "badtypes"}], ",", 
          RowBox[{"Length", "[", "verts", "]"}], ",", "verts", ",", 
          RowBox[{"Length", "[", "types", "]"}], ",", "types"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "verts"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629825816001389*^9, 3.62982581819101*^9}, {
   3.629826043030598*^9, 3.6298260721092653`*^9}, {3.629826144409466*^9, 
   3.629826186112677*^9}, {3.630018358031962*^9, 3.630018359543345*^9}, {
   3.630018425464896*^9, 3.630018430560445*^9}, {3.630072605211358*^9, 
   3.630072606412033*^9}, {3.630072925447437*^9, 3.630072928928318*^9}, 
   3.707758148489691*^9},
 CellLabel->
