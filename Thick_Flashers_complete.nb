Cell[TextData[{
 "FrenetRibbonPlotPair[c, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a pair of Graphics3D plots of a curve, plotting the surfaces \
swept out by the binormal vector and the normal vector."
}], "Text",
