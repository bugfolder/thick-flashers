Cell[TextData[{
 "NRibbonPair[c",
 StyleBox["c",
  FontSlant->"Italic"],
 ", \[Eta], \[Sigma], {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, {",
