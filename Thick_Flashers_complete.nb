Cell[TextData[{
 "NRecoverCurve2DSystemOld[\[Kappa], ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{u0, u1}",
  FontSlant->"Italic"],
 "] constructs a 2D curve from its signed (left) curvature and curve speed. "
}], "Text",
 CellChangeTimes->{{3.690970877159718*^9, 3.690971036930356*^9}, {
   3.690971094765877*^9, 3.690971173216427*^9}, {3.690975305260523*^9, 
