                RowBox[{"{", 
                 RowBox[{"g6", ",", 
                  RowBox[{"g5", "-", "g6"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"g7", ",", "uq"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"LinePlaneInt3D", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"g2", ",", 
                  RowBox[{"g3", "-", "g2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"g7", ",", "uq"}], "}"}]}], "]"}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"ff1", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "2", ",", "8", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "4", ",", "5", ",", "6"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "5", ",", "4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"8", ",", "6", ",", "5", ",", "3"}], "}"}], ",", 
