Cell["\<\
Show the FFP (top view of the pattern) with a little more thickness to show \
what happens as the thickness increases. Note that the diagonal lines form a \
distinctly curved series of segments due to the splitting of layers as we go \
outward; this is as opposed to the original flasher code (based on variable \
dr), in which those lines are assumed to be perfectly straight, and therefore \
result in slightly uneven spacings of the panel layers.\
\>", "Text",
 CellChangeTimes->{{3.911899488718048*^9, 3.911899503434005*^9}, {
  3.913552169964334*^9, 3.913552326526425*^9}, {3.913640119469925*^9, 
  3.913640120563058*^9}},ExpressionUUID->"2c39ab42-8e49-4a80-910a-\
85d31b5428d0"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "3"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.2"}], ",", "ffprules"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ffprules", "=", 
     RowBox[{"MakeThickFlasherFFProjectionRules", "[", 
      RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"FlasherLines", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "m"}], "]"}], "}"}], "/.", 
       RowBox[{"FlasherWrapRules", "[", 
        RowBox[{"p", ",", "m"}], "]"}]}], "/.", "ffprules"}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.911753382386656*^9, 3.9117535761407127`*^9}, {
   3.911753616478991*^9, 3.911753709598409*^9}, {3.911753913602195*^9, 
