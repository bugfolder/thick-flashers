Cell[TextData[{
 "OrientEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "] takes a ",
 "TGraph",
 " containing Vertices and Edges (and possibly other properties) and orders \
the edge indices using an ordering function ",
 StyleBox["fn",
  FontSlant->"Italic"],
 " that acts on the vertices at each end of the edge. That is, for each edge \
{",
 StyleBox["e1",
  FontSlant->"Italic"],
 ",",
 StyleBox["e2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "[",
 StyleBox["verts",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["e1",
  FontSlant->"Italic"],
 "\[RightDoubleBracket], ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["e2",
  FontSlant->"Italic"],
 "\[RightDoubleBracket]] will return True (assuming that ",
 StyleBox["f",
  FontSlant->"Italic"],
 " is a proper antisymmetric ordering function)."
}], "Text",
 CellChangeTimes->{{3.456535103923277*^9, 3.4565351401977587`*^9}, {
   3.456535212944069*^9, 3.456535364822382*^9}, {3.456535399708008*^9, 
   3.4565354228585043`*^9}, {3.458215820747612*^9, 3.458215821474359*^9}, 
   3.4848290442697697`*^9, {3.485264894752741*^9, 3.485264896432311*^9}, {
   3.591654147309276*^9, 3.5916542227647047`*^9}, {3.591654329807118*^9, 
   3.591654388433845*^9}, {3.59165528640336*^9, 3.5916552917372227`*^9}, {
   3.592350332395442*^9, 3.592350359357679*^9}, 
   3.5924358502204647`*^9},ExpressionUUID->"594c54c4-c33c-4f3c-81c7-\
33c8fab355b1"],

Cell[TextData[{
 "Note that if ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " contains Faces, orienting the edges will not affect the faces and the \
returned object will still include the same faces."
}], "Text",
 CellChangeTimes->{{3.5916552886712437`*^9, 
  3.591655299262868*^9}},ExpressionUUID->"7a2069d2-a08f-408e-85b6-\
2d63239ed64d"],

Cell["\<\
OrientEdges will typically be used to orient the edges of the dual graph in a \
primal-dual tessellation for subsequent in crease assignment.\
\>", "Text",
 CellChangeTimes->{{3.485267028271706*^9, 3.485267061447468*^9}, {
  3.591654214932415*^9, 3.591654215284409*^9}, {3.5923503869718323`*^9, 
  3.5923503894920387`*^9}},ExpressionUUID->"bbf6c939-12d8-473c-a3f9-\
efd2016d617c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrientEdges", "[", 
   RowBox[{"tobj_TObj", ",", " ", "fn_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "newedges"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "OrientEdges"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newedges", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"fn", "[", 
           RowBox[{
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], "]"}], ",", "#", ",", 
          RowBox[{"Reverse", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
       "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"Edges", "\[Rule]", "newedges"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.456535393694216*^9, 3.456535394486062*^9}, {
   3.456535432939155*^9, 3.4565355068568974`*^9}, {3.591654229542207*^9, 
   3.591654296108223*^9}, {3.591654395845899*^9, 3.591654413827217*^9}, {
   3.591655239926526*^9, 3.591655251008241*^9}, {3.592350406080267*^9, 
   3.5923504157963667`*^9}, {3.592431701319979*^9, 3.592431703206634*^9}, 
   3.592435739474895*^9, 3.592435850294313*^9, 3.592681720814554*^9, 
   3.592707736160403*^9, 3.593006101600312*^9},
 CellLabel->
  "In[1135]:=",ExpressionUUID->"4557d9c8-98f0-4e26-af67-c4b09b58fdab"],

Cell["\<\
Example. Use radial ordering with a bunch of random points so that every \
arrow ends up point radially outward. Arrows that satisfy the condition are \
green, those that violate are red.\
\>", "Text",
 CellChangeTimes->{{3.591655538291016*^9, 3.591655561645176*^9}, {
  3.592504107524173*^9, 
  3.592504122584696*^9}},ExpressionUUID->"d49dac4f-d481-466e-8f59-\
2ebb581f2cfe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "ctr", ",", "tobj", ",", "fn", ",", "tobj1", 
      ",", "newverts", ",", "newedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"edges", "=", 
       RowBox[{"{", "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"SeedRandom", "[", "0", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"r", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Random", "[", "]"}], "-", ".5"}], ",", 
               RowBox[{
                RowBox[{"Random", "[", "]"}], "-", ".5"}]}], "}"}]}], ",", 
            RowBox[{"s", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Random", "[", "]"}], "-", ".5"}], ",", 
               RowBox[{
                RowBox[{"Random", "[", "]"}], "-", ".5"}]}], "}"}]}]}], "}"}],
           ",", 
          RowBox[{"JoinTo", "[", 
           RowBox[{"verts", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", 
              RowBox[{"r", "+", 
               RowBox[{"0.3", 
                RowBox[{"Mag", "[", "r", "]"}], "s"}]}]}], "}"}]}], "]"}]}], 
         "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "verts", "]"}], "-", "1"}], ",", 
            RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", "50", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", " ", "=", " ", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fn", "=", 
      RowBox[{"RadialAxialOrderingFn", "[", 
       RowBox[{"ctr", ",", 
        RowBox[{"RadialMajor", "\[Rule]", "True"}], ",", 
        RowBox[{"RadialAxialTolerance", "\[Rule]", "0.1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"OrientEdges", "[", 
       RowBox[{"tobj", ",", "fn"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"newverts", ",", "newedges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "ctr", "]"}], ",", 
              RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Blue"}], 
             "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Arrow", "[", "#", "]"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"fn", "[", 
                   RowBox[{
                    RowBox[{
                    "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", 
                    RowBox[{
                    "#", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], "]"}], ",", "Green", ",", 
                  "Red"}], "]"}]}], "]"}], "&"}], "/@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                "verts", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}], "&"}], "/@", "edges"}], ")"}]}]}],
            "}"}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Input\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "ctr", "]"}], ",", 
              RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Blue"}], 
             "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Arrow", "[", "#", "]"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"fn", "[", 
                   RowBox[{
                    RowBox[{
                    "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", 
                    RowBox[{
                    "#", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], "]"}], ",", "Green", ",", 
                  "Red"}], "]"}]}], "]"}], "&"}], "/@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                "newverts", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}], "&"}], "/@", "newedges"}], 
              ")"}]}]}], "}"}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Oriented\>\""}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
