   3.6274997205612392`*^9}, 
   3.6274999434038477`*^9},ExpressionUUID->"506f7db1-abd4-402c-8241-\
7013b74c31d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoCycleCriticalTwistAngles", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1a_", ",", "q1b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q2a_", ",", "q2b_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"TwoCycleCriticalTwistAngleCCW", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q1a", ",", "q1b"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q2a", ",", "q2b"}], "}"}]}], "]"}], ",", 
    RowBox[{"TwoCycleCriticalTwistAngleCW", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q1a", ",", "q1b"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q2a", ",", "q2b"}], "}"}]}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.627499886889738*^9, 3.627499923207949*^9}},
 CellLabel->
