Cell[CellGroupData[{

Cell[TextData[{
 "FlatFoldabilityExcess",
 "[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.594757019915144*^9, 3.59475702441019*^9}, 
   3.594757150348773*^9, 
   3.594940835352231*^9},ExpressionUUID->"ac92000a-b92d-4a6d-8603-\
ab59b1378906"],

Cell[TextData[{
 "FlatFoldabilityExcess[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 "] returns the angular deviation from the Kawasaki-Justin ",
 "condition",
 ". If this is zero, the vertex is flat-foldable."
}], "Text",
 CellChangeTimes->{{3.5947571557311*^9, 3.594757182688842*^9}, 
   3.594940835450973*^9, 
   3.624645831827214*^9},ExpressionUUID->"a4763202-c921-40f8-b08b-\
cbc531117eaf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlatFoldabilityExcess", "[", 
   StyleBox["sectorangles_List",
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{"Plus", "@@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}]}], "}"}], "*", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Partition", "[", 
       RowBox[{"sectorangles", ",", "2"}], "]"}], "]"}]}], "]"}]}]}]], "Input",\

 CellChangeTimes->{{3.594757186180188*^9, 3.594757192786262*^9}, {
   3.594757301132803*^9, 3.594757394718726*^9}, 3.594940835481827*^9},
 CellLabel->
  "In[600]:=",ExpressionUUID->"cf162b36-759e-4141-9776-1d583f0ff630"],

