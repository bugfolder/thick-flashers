Cell["TPlaneGraph angle interrogators", "Subsection",
 CellChangeTimes->{{3.591981417067137*^9, 3.591981426145006*^9}, {
   3.591987439678833*^9, 3.591987439909032*^9}, {3.5924360957756987`*^9, 
