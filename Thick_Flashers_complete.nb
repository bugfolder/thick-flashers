Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "al", ",", "gm", ",", "tobj", ",", "al1", ",", "gm1", ",", "gg"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"al", "=", 
      RowBox[{"{", 
       RowBox[{
       "0.8165869079343493`", ",", "1.437331070129374`", ",", 
        "0.8165885649372293`", ",", "0.8521230921706928`", ",", 
        "1.5084171807542006`", ",", "0.8521384913245504`"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gm", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.1283891523711123`"}], ",", "1.5110965081320082`", ",",
         "1.5110857291055109`", ",", 
        RowBox[{"-", "1.1283725344135453`"}], ",", "1.511083161370419`", ",", 
        "1.5110990757718343`"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromAngles", "[", 
       RowBox[{"al", ",", "gm"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"verify", " ", "that", " ", "we", " ", 
       RowBox[{"didn", "'"}], "t", " ", "alter", " ", "the", " ", "sector", " ",
        "or", " ", "dihedral", " ", "angles", " ", "when", " ", "we", " ", 
       "built", " ", "the", " ", "3", "D", " ", 
       RowBox[{"vertex", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"al1", ",", "gm1"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"SectorAngles", ",", "DihedralAngles"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "FoldVectors"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
