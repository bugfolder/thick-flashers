Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "\[Alpha]", ",", "patch", ",", "lattice", ",", "tiling"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"40.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<tiling = \>\"", ",", 
       RowBox[{"ReschStarName", "[", "n", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"patch", "=", 
      RowBox[{"ReschStarPatch", "[", 
       RowBox[{"n", ",", "\[Alpha]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"EmbedTiling", "[", 
          RowBox[{"patch", ",", "Tiling", ",", 
           RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
           RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "\"\<patch\>\""}]}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lattice", "=", 
      RowBox[{"ReschStarPatchLatticeVectors", "[", 
       RowBox[{"n", ",", "\[Alpha]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"MakeLatticeTiling", "[", 
       RowBox[{"patch", ",", "lattice", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"EmbedTiling", "[", 
         RowBox[{"tiling", ",", "Tiling", ",", 
          RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<tiling\>\""}]}], "]"}], "/.", 
