              RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"f", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "b2i", "]"}], ",", "Black"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"bb1", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"ff", "[", "s", "]"}], "-", 
                 RowBox[{"bb1", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"SurfaceOrientation", "\[Rule]", 
               RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"ff", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"bb2", "[", "s", "]"}], "-", 
                 RowBox[{"ff", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"SurfaceOrientation", "\[Rule]", 
               RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
