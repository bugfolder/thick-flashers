Cell[CellGroupData[{

Cell[TextData[{
 "MakePrimalDualTwistTessellation",
 "InteriorEdges[",
 StyleBox["iedge",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dedge",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 ", \[Rho], \[Beta]]"
}], "Subsubsection",
 CellChangeTimes->{{3.465915859740906*^9, 3.465915884114718*^9}, {
   3.465915928271497*^9, 3.465915991027135*^9}, {3.465916141561344*^9, 
   3.4659161577117*^9}, {3.465916760295277*^9, 3.465916761030854*^9}, 
   3.465926075399856*^9, 3.465926196216913*^9, 3.465926593149192*^9, 
   3.465927228843145*^9, {3.465927955001651*^9, 3.465927968888357*^9}, {
   3.485254121056813*^9, 3.485254130839714*^9}, 3.485254385339024*^9, {
   3.485255320659884*^9, 3.485255321083405*^9}, {3.4852565030009947`*^9, 
   3.485256505312611*^9}, {3.485256586815299*^9, 3.4852565915585003`*^9}, 
   3.485263204537171*^9, {3.4852633081680317`*^9, 3.485263308800251*^9}, 
   3.551754377935913*^9},ExpressionUUID->"3cf56e85-39e9-4697-8771-\
16a7a1094609"],

Cell[TextData[{
 "MakePrimalDualTwistTessellation",
 "InteriorEdges[",
 StyleBox["iedge",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dedge",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 ", \[Rho], \[Beta]] takes an interior edge of the primal graph ",
 StyleBox["iedge",
  FontSlant->"Italic"],
 " (specified as a vertex index pair), its corresponding dual graph edge ",
 StyleBox["dedge",
  FontSlant->"Italic"],
 ", an embedding of the primary vertices ",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", an embedding of the dual vertices ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", a list of the boundary vertex indices ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 ", shrinkage parameter \[Rho], rotation angle \[Beta], and it returns lists \
{",
 StyleBox["edgepairs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edgetypes",
  FontSlant->"Italic"],
 "} that specify the corresponding creases in the tessellation. ",
 StyleBox["edgepairs",
  FontSlant->"Italic"],
 " is a list of vertex pairs; ",
 StyleBox["edgetypes",
  FontSlant->"Italic"],
 " is a list of their types (M, V,  or B; U is not used)."
}], "Text",
 CellChangeTimes->{{3.465916009500443*^9, 3.465916303437623*^9}, {
   3.465916338475544*^9, 3.465916374536664*^9}, {3.4659167733409867`*^9, 
   3.465916791645625*^9}, {3.46592607651521*^9, 3.46592607911454*^9}, {
   3.465926196796556*^9, 3.465926197746943*^9}, {3.465926381860821*^9, 
   3.4659263985238247`*^9}, {3.465926593918154*^9, 3.46592659499684*^9}, 
   3.465927228862213*^9, {3.465927958510712*^9, 3.465928006543195*^9}, {
   3.485254135468622*^9, 3.485254159999639*^9}, {3.4852541969615517`*^9, 
   3.485254279724492*^9}, {3.4852543108942947`*^9, 3.48525432402145*^9}, {
   3.4852559585046177`*^9, 3.485256104006597*^9}, 3.485256510413094*^9, {
   3.485263207003877*^9, 3.485263247529785*^9}, 
   3.551754378183208*^9},ExpressionUUID->"ace25536-1a4d-40ec-9c73-\
accf949b3a5e"],

Cell[TextData[{
 "In such a tessellation, the centers of rotation are the vertices of the \
dual graph; each interior edge transforms into a parallelogram; and each \
boundary edge transforms into a boundary edge of the tessellation. By \
suitable choice of the scale \[Rho] and rotation angle \[Beta] and the line \
specification ",
 StyleBox["linetype",
  FontSlant->"Italic"],
 ", this function can construct lines for either the CP or the FF."
}], "Text",
 CellChangeTimes->{
  3.485254320701092*^9},ExpressionUUID->"ad2d5880-1869-442f-a340-\
8e3c60bdc35a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePrimalDualTwistTessellationInteriorEdges", "[", 
   RowBox[{
   "pedge_", ",", "dedge_", ",", "pverts_", ",", "dverts_", ",", "bverts_", ",",
     "\[Rho]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "d1", ",", "d2", ",", "p1d1", ",", "p1d2", ",", 
      "p2d1", ",", "p2d2", ",", "p1b", ",", "p2b", ",", "ob", ",", 
      "edgepairs", ",", "edgetypes"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}], "=", 
      RowBox[{
      "pverts", "\[LeftDoubleBracket]", "pedge", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"d1", ",", "d2"}], "}"}], "=", 
      RowBox[{
      "dverts", "\[LeftDoubleBracket]", "dedge", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"p1d1", "=", 
      RowBox[{"ScaleAndTwistPoint", "[", 
       RowBox[{"p1", ",", "d1", ",", "\[Rho]", ",", "\[Beta]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p2d1", "=", 
      RowBox[{"ScaleAndTwistPoint", "[", 
       RowBox[{"p2", ",", "d1", ",", "\[Rho]", ",", "\[Beta]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p1d2", "=", 
      RowBox[{"ScaleAndTwistPoint", "[", 
       RowBox[{"p1", ",", "d2", ",", "\[Rho]", ",", "\[Beta]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p2d2", "=", 
      RowBox[{"ScaleAndTwistPoint", "[", 
       RowBox[{"p2", ",", "d2", ",", "\[Rho]", ",", "\[Beta]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p1b", "=", 
      RowBox[{"MemberQ", "[", 
       RowBox[{"bverts", ",", 
        RowBox[{
        "pedge", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p2b", "=", 
      RowBox[{"MemberQ", "[", 
       RowBox[{"bverts", ",", 
        RowBox[{
        "pedge", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ob", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p2d1", "-", "p1d1"}], ")"}], ".", 
        RowBox[{"(", 
         RowBox[{"p1d2", "-", "p1d1"}], ")"}]}], "<", "0"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"p1d1", " ", "is", " ", "obtuse"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"edgepairs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p2d1", ",", "p1d1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p1d1", ",", "p1d2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p1d2", ",", "p2d2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p2d1", ",", "p2d2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edgetypes", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", 
        RowBox[{"If", "[", 
         RowBox[{"p1b", ",", "B", ",", 
          RowBox[{"If", "[", 
           RowBox[{"ob", ",", "M", ",", "V"}], "]"}]}], "]"}], ",", "V", ",", 
        
        RowBox[{"If", "[", 
         RowBox[{"p2b", ",", "B", ",", 
          RowBox[{"If", "[", 
           RowBox[{"ob", ",", "V", ",", "M"}], "]"}]}], "]"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"edgepairs", ",", "edgetypes"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.465916731507865*^9, 3.4659167542890472`*^9}, {
   3.465916801902034*^9, 3.465916813965774*^9}, {3.465916846995219*^9, 
   3.465917219141582*^9}, {3.465917256349368*^9, 3.465917285421918*^9}, {
   3.465917346568237*^9, 3.465917366819685*^9}, {3.465917460431788*^9, 
   3.465917525862807*^9}, {3.46591755652401*^9, 3.465917598914154*^9}, {
   3.465917631832442*^9, 3.465917849052984*^9}, {3.465917903165172*^9, 
   3.465918035800806*^9}, {3.465918080652083*^9, 3.465918166848619*^9}, {
   3.4659183569468603`*^9, 3.4659185533628607`*^9}, 3.465918593281559*^9, {
   3.46591993250476*^9, 3.46591994828319*^9}, {3.4659199880014*^9, 
   3.465920034043064*^9}, {3.465926085284175*^9, 3.465926087261598*^9}, {
   3.465926199608207*^9, 3.465926201535048*^9}, {3.465926598007076*^9, 
   3.465926599987352*^9}, 3.465927228903223*^9, {3.465928024952997*^9, 
   3.465928053229944*^9}, {3.484834042389555*^9, 3.48483404313932*^9}, {
   3.485254175601624*^9, 3.485254183590191*^9}, {3.485254393273497*^9, 
   3.485254416087212*^9}, {3.485254452720852*^9, 3.485254476083771*^9}, {
   3.485254545318427*^9, 3.4852547706184072`*^9}, 3.485254802338395*^9, {
   3.485254871265393*^9, 3.485254917608508*^9}, {3.485254960712994*^9, 
   3.48525532834277*^9}, 3.4852557855428534`*^9, {3.485255897868808*^9, 
   3.48525590054465*^9}, 3.48525651353821*^9, {3.485258024989132*^9, 
   3.485258043063711*^9}, 3.485258770752438*^9, {3.485259460730116*^9, 
   3.4852596536818027`*^9}, {3.485263257597719*^9, 3.485263295355074*^9}, 
   3.551754378249004*^9},
 CellLabel->
  "In[3342]:=",ExpressionUUID->"b633105e-1bc7-4e66-8a62-a6017656ca42"],

Cell["Example", "Text",
 CellChangeTimes->{{3.465918595968738*^9, 3.465918596703989*^9}, {
