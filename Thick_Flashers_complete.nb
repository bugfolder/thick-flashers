     RowBox[{"panels", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"InsetGC", "[", 
         RowBox[{"#", ",", "0.05"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"panel1", ",", "panel2"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Graphics3D", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"panels", ",", "SolidStyle"}], "]"}], ",", 
          RowBox[{"AllLabelsGC", "/@", "panels"}]}], "}"}], "]"}], "]"}], "//",
       "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{"panelinfo", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"4", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"4", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "4"}], "}"}]}], "}"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"joinedpanels", "=", 
      RowBox[{"HingeJoinPanels", "[", 
       RowBox[{
       "panels", ",", "panelinfo", ",", "tobj", ",", "\[IndentingNewLine]", 
        RowBox[{"HingeThickness", "->", "0.05"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"HingeShift", "->", "True"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeType", "->", "HingeMultiWireGC"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"HingeNumWires", "->", "100"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeMinWireGap", "->", "0.01"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"joinedpanels", ",", "SolidStyle"}], "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.925729213230358*^9, 3.925729215245445*^9}, {
  3.925729459822049*^9, 3.925729495644259*^9}, {3.925729548621463*^9, 
  3.9257296014281*^9}},
 CellLabel->
  "In[4381]:=",ExpressionUUID->"56752290-6141-49e0-808b-985f694b08dc"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Pin hinges", "Section",
 CellChangeTimes->{{3.933695965583918*^9, 3.933695966455434*^9}, {
  3.938460830389028*^9, 
  3.938460831513465*^9}},ExpressionUUID->"e3915ce7-0ded-43ad-bf5f-\
55eb1ec40b1d"],

Cell[CellGroupData[{

Cell["Pin-hinge parts functions", "Subsection",
 CellChangeTimes->{{3.933688603965508*^9, 
  3.933688609180052*^9}},ExpressionUUID->"bb203ea0-fab0-4a7a-8761-\
5c1a3708c99b"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.9336943581174803`*^9, 
  3.933694358581368*^9}},ExpressionUUID->"533f6806-a80f-4df6-bf07-\
91207eaf2088"],

Cell["\<\
Here we create lists of cutouts, knuckles, and holes to be added to panels to \
create pin hinges. We provide them as separate lists as part of a strategy \
for getting around Mathematica\[CloseCurlyQuote]s problems with performing \
Boolean operations on MeshRegions, to whit: the Mathematica functions \
RegionDifference and RegionUnion when fed with perfectly valid watertight \
MeshRegions can and does regularly fail to perform the operation or to \
produce a watertight mesh, so that subsequent operations on the mesh fail. In \
particular, our pin-hinged flasher models fail when we try to build them \
entirely within Mathematica.\
\>", "Text",
 CellChangeTimes->{{3.9336915070571537`*^9, 3.933691539647299*^9}, {
  3.93369437698239*^9, 3.9336944787008963`*^9}, {3.93402790361436*^9, 
  3.93402791968395*^9}, {3.934047005573103*^9, 3.934047111302267*^9}, {
  3.9343054098413773`*^9, 3.934305564078665*^9}, {3.934734004817891*^9, 
  3.934734006087428*^9}},ExpressionUUID->"ee9170de-e172-439b-bf3c-\
5e9fd189625a"],

Cell["\<\
To get around this problem, we generate lists of the simple geometric \
primitives that get combined to create pin-hinged mechanisms; then with those \
lists, we can combine them in Mathematica (if the overall structure is simple \
enough), or export them to files to use external tools, e.g., MeshLab, to \
perform the Boolean operations.\
\>", "Text",
 CellChangeTimes->{{3.934305566422922*^9, 
  3.9343056389502497`*^9}},ExpressionUUID->"36f8d663-99b3-423e-b84c-\
c2006fc5aec6"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
PinHingeHoleDia
PinHingeHoleDia
PinHingeOuterDia
PinHingeClearance
PinHingeEndLength
PinHingeAccessLength
PinHingeMinGapLength
PinHingeMaxHingeLength
PinHingeScaleKnuckles\
\>", "Subsubsection",
 CellChangeTimes->{{3.933364043557661*^9, 3.9333640620699997`*^9}, {
   3.933611579953327*^9, 3.9336115891364098`*^9}, {3.933611661907584*^9, 
   3.933611673984214*^9}, 3.933689030603242*^9, 3.9336972281442423`*^9, {
   3.933799184382291*^9, 3.933799209340805*^9}, {3.933799392661284*^9, 
   3.9337993937361507`*^9}, 3.933799682225058*^9, {3.935063320253497*^9, 
   3.935063328268536*^9}, {3.96662910464132*^9, 3.966629111161212*^9}, {
   3.966629164415506*^9, 
   3.966629167999345*^9}},ExpressionUUID->"063401a8-e125-4c9b-8a00-\
5daa927e5a6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeHoleDia", "::", "usage"}], 
   "=", "\"\<PinHingeHoleDia is an option to MakePinHinge that specifies the \
diameter of the hole through the knuckles.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933364069064911*^9, 3.933364114429677*^9}, {
  3.933799195463017*^9, 3.933799195463311*^9}, {3.933799245343132*^9, 
  3.933799246286965*^9}},
 CellLabel->
  "In[4382]:=",ExpressionUUID->"d12da6bd-d4ad-4a47-816e-d9a878c4bf5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeOuterDia", "::", "usage"}], 
   "=", "\"\<PinHingeOuterDia is an option to MakePinHinge that specifies the \
outer diameter of the knuckles.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933364069064911*^9, 3.933364094627325*^9}, {
  3.933364153168778*^9, 3.933364167890189*^9}, {3.933799256458695*^9, 
  3.933799256637735*^9}},
 CellLabel->
  "In[4383]:=",ExpressionUUID->"6032de07-a5f7-45bd-8590-3a63886094b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeClearance", "::", "usage"}], 
   "=", "\"\<PinHingeClearance is an option to MakePinHinge that specifies \
the clearances between the knuckles, each other, and their cutouts.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.933364069064911*^9, 3.933364094627325*^9}, {
  3.933364153168778*^9, 3.9333642084382477`*^9}},
 CellLabel->
  "In[4384]:=",ExpressionUUID->"f5c433ab-b2f9-491a-adb4-100ac59a58bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeEndLength", "::", "usage"}], 
   "=", "\"\<PinHingeEndLength is an option to MakePinHinge that specifies \
the lengths of the end knuckles and minimum length of a single middle \
knuckle.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933364069064911*^9, 3.933364094627325*^9}, {
  3.933364153168778*^9, 3.933364286065206*^9}, {3.93379927799155*^9, 
  3.9337992936959667`*^9}},
 CellLabel->
  "In[4385]:=",ExpressionUUID->"9da101b9-3ac4-4a97-85af-e14ac1835c8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeAccessLength", "::", "usage"}], 
   "=", "\"\<PinHingeAccessLength is an option to MakePinHinge that specifies \
the distances to extend the access holes beyond the endpoints of the \
axis.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933364069064911*^9, 3.933364094627325*^9}, {
  3.933364153168778*^9, 3.933364248131301*^9}, {3.933611604164598*^9, 
  3.9336116360257597`*^9}, {3.933611686510171*^9, 3.933611687814642*^9}},
 CellLabel->
  "In[4386]:=",ExpressionUUID->"938fde58-7fdb-402b-a3fd-95c2237a53b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeMinGapLength", "::", "usage"}], 
   "=", "\"\<PinHingeMinGapLength is an option to MakePinHinge that specifies \
the minimum size gap between a split middle knuckle.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933364069064911*^9, 3.933364094627325*^9}, {
  3.933364153168778*^9, 3.933364286065206*^9}, {3.93379927799155*^9, 
  3.9337992936959667`*^9}, {3.9337993612405567`*^9, 3.933799377127357*^9}, {
  3.933799682226778*^9, 3.933799682227147*^9}},
 CellLabel->
  "In[4387]:=",ExpressionUUID->"85cc6f28-58fa-4bca-a242-836432f39647"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeMaxHingeLength", "::", "usage"}], 
   "=", "\"\<PinHingeMaxHingeLength is an option to MakePinHinge that \
specifies the maximum distance between the outside edges of the end knuckles.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933364069064911*^9, 3.933364094627325*^9}, {
  3.933364153168778*^9, 3.933364286065206*^9}, {3.93379927799155*^9, 
  3.9337992936959667`*^9}, {3.9337993612405567`*^9, 3.933799377127357*^9}, {
  3.933799682226778*^9, 3.933799682227147*^9}, {3.935063339230904*^9, 
  3.935063378454793*^9}},
 CellLabel->
  "In[4388]:=",ExpressionUUID->"602a54b1-cfb6-4174-8713-ea53ac5ff36c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingeScaleKnuckles", "::", "usage"}], 
   "=", "\"\<PinHingeScaleKnuckles is an option to MakePinHinge that \
specifies whether to scale down knuckle lengths for short edges so that they \
will always fit.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9666291197373447`*^9, 3.9666292595046597`*^9}},
 CellLabel->
  "In[4389]:=",ExpressionUUID->"59325e9d-2145-4080-afc8-fc1f3d3ab5b7"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakePinHingeParts[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PinHingeHoleDia, PinHingeOuterDia, PinHingeClearance, \
PinHingeEndLength, PinHingeAccessLength, PinHingeMinGapLength, \
PinHingeMaxHingeLength, PinHingeScaleKnuckles,RoundingDivisions"
}], "Subsubsection",
 CellChangeTimes->{{3.9333630812340717`*^9, 3.933363113275485*^9}, {
   3.93336320276372*^9, 3.933363205396893*^9}, {3.933527673546302*^9, 
   3.93352772113832*^9}, {3.933611709979958*^9, 3.933611716691597*^9}, {
   3.933689038211651*^9, 3.933689057427734*^9}, {3.933697233930429*^9, 
   3.933697235082906*^9}, {3.9337991766600447`*^9, 3.93379923420586*^9}, {
   3.933799403820814*^9, 3.933799407326871*^9}, 3.93379968223166*^9, 
   3.9343050707822447`*^9, 3.934305133298324*^9, {3.9350633936058817`*^9, 
   3.935063395157629*^9}, {3.966629268888011*^9, 
   3.966629270410121*^9}},ExpressionUUID->"2fa37062-1b7e-4638-9cf3-\
e68e493b694d"],

Cell[TextData[{
 "MakePinHingeParts[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes two points that define an axis and creates knuckles and cutouts \
that create a pin hinge. The hinge consists of three or four knuckles, one or \
two middle knuckles that will be attached to one panel and two end knuckles, \
one to either side of the middle, that will be attached to the other panel."
}], "Text",
 CellChangeTimes->{{3.933363135937915*^9, 3.933363199300276*^9}, {
   3.933363354420545*^9, 3.933363399558455*^9}, {3.9336890614756403`*^9, 
   3.933689143076214*^9}, {3.933799445891385*^9, 3.933799461212955*^9}, {
   3.934027942404875*^9, 3.934027963186067*^9}, 3.9343050707868967`*^9, 
   3.934305133303095*^9},ExpressionUUID->"cc39f5f0-90dc-4a28-8526-\
26f81ec3259e"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "} \[LongDash] the endpoints of the axis of rotation."
}], "Text",
 CellChangeTimes->{{3.933363266891419*^9, 3.933363314481844*^9}, 
   3.933689148668735*^9},ExpressionUUID->"227dc884-b12b-4b3f-8da3-\
b96130392fae"],

Cell[TextData[{
 "Options:\n\tPinHingeHoleDia \[Rule] ",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", the diameter of the middle hole knuckle.\n\tPinHingeOuterDia \[Rule] ",
 StyleBox["do",
  FontSlant->"Italic"],
 ", the diameter of all of the knuckles.\n\tPinHingeClearance \[Rule] ",
 StyleBox["dc",
  FontSlant->"Italic"],
 ", the clearance distance for moving parts.\n\tPinHingeEndLength \[Rule] ",
 StyleBox["le",
  FontSlant->"Italic"],
 ", the length of the two end knuckles. The middle knuckle fills the space \
between them.\n\tPinHingeAccessLength \[Rule] ",
 StyleBox["la",
  FontSlant->"Italic"],
 " | {",
 StyleBox["la1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["la2",
  FontSlant->"Italic"],
 "}, the distances to extend the access holes from the axis endpoints.\n\t\
PinHingeMinGapLength \[Rule] ",
 StyleBox["lg",
  FontSlant->"Italic"],
 ", the minimum gap between a split middle knuckle.\n\tPinHingeMaxHingeLength \
\[Rule] ",
 StyleBox["lh",
  FontSlant->"Italic"],
 ", the maximum length allowed for the hinge.\n\tPinHingeScaleKnuckles \
\[Rule] True | False, whether to scale down hinge knuckles if the edge is too \
short.\n\tRoundingDivisions \[Rule] ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", the number of divisions of a circle to use to approximate a cylinder."
}], "Text",
 CellChangeTimes->{{3.9333633225358686`*^9, 3.9333633518549147`*^9}, {
   3.933363412562714*^9, 3.9333636317435102`*^9}, {3.933363829187258*^9, 
   3.933363874999344*^9}, {3.933611721243478*^9, 3.933611789380505*^9}, 
   3.9336891541265917`*^9, 3.933697241905281*^9, {3.933799176665155*^9, 
   3.933799195472845*^9}, {3.93379934029462*^9, 3.933799348666445*^9}, {
   3.933799413264255*^9, 3.933799436350913*^9}, 3.933799682236512*^9, {
   3.935063397908186*^9, 3.935063416853033*^9}, {3.9666292757791357`*^9, 
   3.966629305680873*^9}},ExpressionUUID->"24d1e01d-a054-440d-aff7-\
a117217e212a"],

Cell[TextData[{
 "Returns: a list {{",
 StyleBox["cutouts1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["knuckles1, holes1",
  FontSlant->"Italic"],
 "), {",
 StyleBox["cutouts2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["knuckles2, holes2",
  FontSlant->"Italic"],
 "}} where\n\t",
 StyleBox["cutouts1",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex objects that should be removed from the first \
panel (to make room for opposing knuckles)\n\t",
 StyleBox["knuckles1",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex objects that should be subsequently unioned \
with the first panel (to create the knuckles)\n\t",
 StyleBox["holes1",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex objects that should be subsequently removed \
from the first panel (to drill the holes through the knuckles)\n\t",
 StyleBox["cutouts2",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex objects that should be removed from the \
second panel;\n\t",
 StyleBox["knuckles2",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex objects that should be subsequently unioned \
with the second panel;\n\t",
 StyleBox["holes2",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex objects that should be removed from the \
second panel."
}], "Text",
 CellChangeTimes->{{3.9333636363562517`*^9, 3.9333636599590607`*^9}, {
  3.9336891617890873`*^9, 3.9336893113538027`*^9}, {3.933943068930675*^9, 
  3.9339431529542007`*^9}, {3.934027974731176*^9, 
  3.9340279946661043`*^9}},ExpressionUUID->"e709c2fb-54ee-43c3-962c-\
105b88690b3e"],

Cell[TextData[{
 "If there is enough room, the middle knuckle will be split into two knuckles \
of length ",
 StyleBox["le",
  FontSlant->"Italic"],
 " with a gap in between. If there is not enough room for the gap, then the \
middle will be a single knuckle."
}], "Text",
 CellChangeTimes->{{3.9337995115282717`*^9, 3.933799585576654*^9}, {
  3.9338430023879633`*^9, 
  3.933843004674563*^9}},ExpressionUUID->"160f4a45-0c69-408a-9b49-\
915a273322dc"],

Cell["\<\
There is an overall size check: while the middle knuckle is variably sized, \
there should be at least enough room for it to have the length of the end \
knuckles and if there\[CloseCurlyQuote]s not, the function will fail with an \
error message.\
\>", "Text",
 CellChangeTimes->{{3.933422664407281*^9, 3.933422717255007*^9}, {
  3.934028002368857*^9, 
  3.9340280032557917`*^9}},ExpressionUUID->"a36a7510-5649-407d-9686-\
0b554ddaf437"],

Cell["\<\
If the available length is greater than PinHingeMaxHingeLength, then the \
hinge will will placed in the middle of the available length. Note that if \
the specified available length is too small (insufficient room for 3 knuckles \
plus 2 clearance gaps), then we consider the value of PinHingeScaleKnuckles: \
if True, the knuckles will be down-sized to fit. If False, an error message \
will be issued that quantifies the shortfall.\
\>", "Text",
 CellChangeTimes->{{3.9350635402787323`*^9, 3.935063622342417*^9}, {
  3.966629812534112*^9, 
  3.966629843751582*^9}},ExpressionUUID->"5d799c1f-1628-4038-8080-\
138bfe5c73a1"],

Cell["\<\
The reason for generating lists of parts is that it allows us to use external \
tools to perform the Boolean operations, and in each case, the second operand \
(of the difference or union) is a simple cylinder. We return GraphicsComplex \
objects (like panels) because they\[CloseCurlyQuote]re easily manipulated and \
rendered; they can also be exported by Mathematica as STL files for external \
manipulations.\
\>", "Text",
 CellChangeTimes->{{3.933943162698311*^9, 3.933943237195368*^9}, {
  3.9340280174494877`*^9, 3.934028102869576*^9}, {3.935063658655451*^9, 
  3.935063686123228*^9}},ExpressionUUID->"9bee02de-8afb-449a-8672-\
5fdb8815c50d"],

Cell["\<\
The default values for options are values that work with the Mk4 3D printer \
using PETG filament.\
\>", "Text",
 CellChangeTimes->{{3.9370499266040163`*^9, 
  3.937049971051517*^9}},ExpressionUUID->"5ae8410a-eedc-460c-b4be-\
80a6e4e36dc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakePinHingeParts", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PinHingeHoleDia", "->", "1.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PinHingeOuterDia", "->", "2.5"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PinHingeClearance", "->", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PinHingeEndLength", "->", "2.0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PinHingeAccessLength", "->", "10.0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PinHingeMinGapLength", "->", "2.0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PinHingeMaxHingeLength", "->", "100.0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PinHingeScaleKnuckles", "->", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"RoundingDivisions", "->", "16"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.933363919889276*^9, 3.933364020376624*^9}, 
   3.933364987548457*^9, 3.9333653096733913`*^9, 3.933365368194578*^9, {
   3.9333655080412407`*^9, 3.933365508489341*^9}, {3.933365841729808*^9, 
   3.933365841908331*^9}, 3.933422107424121*^9, {3.9334225450780983`*^9, 
   3.933422552299035*^9}, {3.9336120762471657`*^9, 3.933612097656892*^9}, {
   3.933689352301899*^9, 3.933689372971746*^9}, {3.9336911814208107`*^9, 
   3.933691182001746*^9}, {3.933692435029359*^9, 3.933692435226721*^9}, 
   3.933697246139091*^9, {3.933799176666648*^9, 3.933799195474111*^9}, {
   3.933799468392707*^9, 3.93379948009409*^9}, 3.933799682238044*^9, 
   3.934305070788597*^9, 3.934305133304615*^9, {3.93506343775933*^9, 
   3.9350634800762157`*^9}, {3.935066969213238*^9, 3.935066972043208*^9}, {
