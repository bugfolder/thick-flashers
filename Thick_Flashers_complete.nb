           RowBox[{"{", 
            RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MonolithicEmbedTiling", "[", 
       RowBox[{"tiling", ",", "TGraph2DAssigned"}], "]"}]}], ";", 
