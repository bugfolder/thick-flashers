Cell[CellGroupData[{

Cell["\<\
Joining TGraphAssigned, TGraph2DAssigned, and TGraph3DAssigned\
\>", "Subsection",
 CellChangeTimes->{{3.649945841630827*^9, 3.6499458432834797`*^9}, {
   3.6499464691354322`*^9, 3.649946470363493*^9}, 3.649951044663437*^9, {
   3.649964696685559*^9, 3.64996469969354*^9}, {3.707912839997493*^9, 
