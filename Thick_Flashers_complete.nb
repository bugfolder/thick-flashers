 "AddTPrimalDualGraphTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TPlaneGraph\nAddTPrimalDualGraph\n\t(checked class) \
TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.465925563051913*^9, 3.465925570779444*^9}, {
   3.465929370121188*^9, 3.46592937049673*^9}, {3.465930207312016*^9, 
   3.465930220454935*^9}, {3.466093815359706*^9, 3.466093828749922*^9}, 
   3.4848290764813547`*^9, 3.5922374207177477`*^9, {3.592237977085704*^9, 
   3.592238002690447*^9}, {3.592255717876309*^9, 3.592255731297194*^9}, {
   3.592255772293202*^9, 3.5922557725565443`*^9}, {3.592401504880495*^9, 
   3.592401509120583*^9}, 3.592401548622741*^9, 3.592432275590014*^9, 
   3.592659844162963*^9, {3.592659906870529*^9, 3.592659919576699*^9}, {
   3.592828721156836*^9, 3.592828721260561*^9}, {3.592828804128238*^9, 
   3.592828804208018*^9}, {3.592853131554883*^9, 
   3.592853157383172*^9}},ExpressionUUID->"2a688125-7f10-4004-9b5c-\
b236dfc049ec"],

Cell[TextData[{
 "AddTPrimalDualGraphTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TPlaneGraph that represent the primal graph and returns a ",
 "TPrimalDualGraph",
 " containing all of the plane graph data you need to create a primal-dual \
tessellation. The returned dual embedding DualVertices is computed from the \
centroids of the faces, so it doesn\[CloseCurlyQuote]t necessarily satisfy \
the orthogonality condition that gives a reciprocal diagram (see next \
section). You'll need to solve for the reciprocal diagram embedding to \
construct a valid tessellation (but you can use this embedding as a starting \
point). You also might want to reorient the InteriorEdges+DualEdges in order \
to specify a particular MV-assignment."
}], "Text",
 CellChangeTimes->{{3.465925573139381*^9, 3.4659257316086817`*^9}, 
   3.46592614340162*^9, 3.465926249173004*^9, {3.465926952240943*^9, 
   3.465927009977395*^9}, {3.4659293048575587`*^9, 3.46592935330623*^9}, 
   3.484829045057684*^9, 3.484829076559063*^9, {3.533594482516011*^9, 
   3.533594529812508*^9}, 3.551754380262323*^9, {3.592237002444187*^9, 
   3.592237038174759*^9}, {3.592238010458498*^9, 3.592238022185651*^9}, {
   3.5922557781249866`*^9, 3.592255802257382*^9}, 3.592401548689973*^9, {
   3.592401961860343*^9, 3.592402014174439*^9}, 3.592659844352612*^9, 
   3.5928287214766197`*^9, {3.592828804363164*^9, 
   3.592828804506752*^9}},ExpressionUUID->"04c3a3bf-2b37-4dc1-bada-\
19f41968023c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTPrimalDualGraphTo", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "iedges", ",", "dedges", ",", 
      "dverts", ",", "vfi", ",", "iverts", ",", "dfaces"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPlaneGraph", ",", "AddTPrimalDualGraphTo"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "faces", ",", "iverts"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "Faces", ",", "InteriorVertices"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"InteriorEdges", ",", " ", "DualEdges"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"iedges", ",", "dedges"}], "}"}], "=", 
      RowBox[{"OrientedInteriorEdgePairs", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "DualVertices", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{"FaceCentroids", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "InteriorVertices", " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vfi", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "VertexFaceIncidence"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"iverts", "=", 
      RowBox[{
       RowBox[{"Reap", "[", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{
               "vfi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
               ",", "0"}], "]"}]}], ",", 
            RowBox[{"Sow", "[", "i", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], "]"}], "\[LeftDoubleBracket]",
        "2", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListEmptyQ", "[", "iverts", "]"}]}], ",", 
       RowBox[{"iverts", "=", 
        RowBox[{"Flatten", "[", "iverts", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "DualFaces", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dfaces", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"vfi", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}],
         "&"}], "/@", "iverts"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AddClassTo", "[", 
      RowBox[{"tobj", ",", "TPrimalDualGraph", ",", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"InteriorVertices", "\[Rule]", "iverts"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"InteriorEdges", "\[Rule]", "iedges"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DualVertices", "\[Rule]", "dverts"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DualEdges", "\[Rule]", "dedges"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DualFaces", "\[Rule]", "dfaces"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.592238041643717*^9, 3.59223806976896*^9}, {
   3.592238544196797*^9, 3.592238600656005*^9}, {3.592238648112211*^9, 
