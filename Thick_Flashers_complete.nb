6544c775fc47"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SphericalAngleLabels", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SectorAngleLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DihedralAngleLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SectorAngleRadius", "\[Rule]", "1.0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DihedralAngleRadius", "\[Rule]", "1.1"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
