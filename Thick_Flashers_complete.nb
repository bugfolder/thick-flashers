Cell[TextData[{
 "VisiblePairGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned representing the crease pattern and the folded \
form, and returns a single Graphics object that displays both the crease \
pattern and hidden-line-removed folded form side-by-side, centered on the \
x-axis about the origin. Options are:\n\tSpacing\[Rule]",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the fractional width by which to space the two objections.\n\tPaperFill \
\[Rule] PaperWhiteSideFill | PaperColoredSideFill, specifies the color of the \
paper that will be used to render all polygons.\t\n\tFacesAbove \[Rule] ",
 StyleBox["fa",
  FontSlant->"Italic"],
 " | Automatic, where ",
 StyleBox["fa",
  FontSlant->"Italic"],
 " is a list of of the face indices that lie above each face. Automatic means \
we calculate it using our own algorithm, which will make use of FaceupFace, \
see next.\n\tFaceupFace \[Rule] ",
 StyleBox["fuface",
  FontSlant->"Italic"],
 " specifies a face-up face if we have to calculate our own facet ordering.\n\
\tShowProgress \[Rule] True | False, if true, display some graphs showing the \
relationships that are used along the way.\n\tOptions[Graphics] are passed \
through."
}], "Text",
 CellChangeTimes->{{3.484926817998731*^9, 3.484926918166051*^9}, {
   3.4849271731566567`*^9, 3.484927182041171*^9}, {3.484927325901083*^9, 
