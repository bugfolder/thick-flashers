Cell[TextData[{
 "VertexEdgeAngles",
 "3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked classes) TGraph3D, TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.591908535268428*^9, 3.591908559665609*^9}, {
   3.591916250165678*^9, 3.591916257851864*^9}, {3.591958476048588*^9, 
   3.591958484079148*^9}, {3.591980408090514*^9, 3.59198041313847*^9}, 
   3.59198132585384*^9, 3.591982606995936*^9, {3.592380932841991*^9, 
   3.592380942297021*^9}, 3.592828718549396*^9, 3.592828773446642*^9, 
   3.594732492673957*^9, 3.595345619605365*^9, 
   3.6264604088581877`*^9},ExpressionUUID->"ec05af44-358f-4d93-8dfd-\
0df1463833b9"],

Cell[TextData[{
 "VertexEdgeAngles3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TObj representing a 3D plane graph and returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", " ", 
       SubscriptBox["\[Alpha]", "2"], ",", " ", "..."}], "}"}], ",", " ", 
     "..."}], "}"}], TraditionalForm]],ExpressionUUID->
  "c38efb30-6525-4c9e-90e4-21f6ed41bdc8"],
 " of the sector angles around each vertex where each list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", " ", 
     SubscriptBox["\[Alpha]", "2"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"3f7f8161-7b79-4e33-83cd-71e671acd8f1"],
 " is a list of the sector angles around the corresponding vertex. Exterior \
angles are given as Null since there is no reference plane for any exterior \
angle in 3D. The list is ordered to correspond to \
propertyVertexFaceIncidence, i.e., an angle in VertexEdgeAngles3D is at the \
same position as its corresponding face in VertexFaceIncidence."
}], "Text",
 CellChangeTimes->{{3.5919085628987103`*^9, 3.591908751070115*^9}, {
   3.591908784651951*^9, 3.5919087951727743`*^9}, {3.591958207068511*^9, 
   3.591958215824911*^9}, 3.5919583081391683`*^9, {3.591973054520548*^9, 
   3.591973063391632*^9}, {3.591981325963595*^9, 3.591981326055972*^9}, {
   3.591981666234586*^9, 3.591981676815632*^9}, {3.5919817623737807`*^9, 
   3.591981784324365*^9}, 3.591982463566327*^9, {3.591982633041925*^9, 
   3.591982633994032*^9}, 3.592435745358458*^9, {3.626460409027734*^9, 
   3.626460409192296*^9}, 
   3.933679439285386*^9},ExpressionUUID->"8700de76-3939-4db4-9209-\
0e7c8b627eef"],

Cell["\<\
As with VertexEdgeAngles2D, a good check of the consistency of the folded \
form is to see if VertexEdgeAngles and VertexEdgeAngles3D return the same \
values.\
\>", "Text",
 CellChangeTimes->{{3.595273760215751*^9, 3.595273783012699*^9}, {
  3.595273893509224*^9, 3.595273904796665*^9}, {3.595275383869159*^9, 
  3.595275391211513*^9}, {3.626460380655841*^9, 
  3.6264604094988723`*^9}},ExpressionUUID->"9bab0dae-4832-4645-8e22-\
e8342ac8beb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexEdgeAngles3D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts3d", ",", "vva", ",", "vfi", ",", "fn", ",", "vc", ",", "va", ",", 
      "vf"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "vva", ",", "vfi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices3D", ",", "VertexVertexAdjacency", ",", 
          "VertexFaceIncidence"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fn", "=", 
      RowBox[{"FaceNormals3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"vc", "=", 
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
        ";", 
        RowBox[{"(*", " ", 
         RowBox[{"this", " ", "vertex", " ", "coords"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"va", "=", 
         RowBox[{
         "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "vertices", " ", "adjacent", " ", "to", " ", "this", " ", 
           "vertex"}], ",", " ", 
          RowBox[{"by", " ", "index"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        
        RowBox[{"vf", "=", 
         RowBox[{
         "vfi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "faces", " ", "incident", " ", "to", " ", "this", " ", "vertex"}], ",",
           " ", 
          RowBox[{"by", " ", 
           RowBox[{"index", ".", " ", "Could"}], " ", "include", " ", 
           RowBox[{"zeroes", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "vf", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "\[Equal]",
              "0"}], ",", "\[IndentingNewLine]", "Null", ",", 
            "\[IndentingNewLine]", 
            RowBox[{"DirectedAngle3D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"verts3d", "\[LeftDoubleBracket]", 
                RowBox[{
                "va", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
                "\[RightDoubleBracket]"}], "-", "vc"}], ",", 
              RowBox[{
               RowBox[{"verts3d", "\[LeftDoubleBracket]", 
                RowBox[{"va", "\[LeftDoubleBracket]", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"j", "+", "1"}], ",", 
                   RowBox[{"Length", "[", "va", "]"}], ",", "1"}], "]"}], 
                 "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "-", 
               "vc"}], ",", 
              RowBox[{"fn", "\[LeftDoubleBracket]", 
               RowBox[{
               "vf", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}]}], "]"}]}], "\[IndentingNewLine]", 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "va", "]"}]}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
