Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianSphericalAngleLabels", "[", 
   StyleBox[
    RowBox[{"sectorvectors_List", ",", " ", "opts___"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sal", ",", "dal", ",", "sar", ",", "dar", ",", "nn", ",", 
      "foldvectors"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sal", "=", 
      RowBox[{
       RowBox[{"SectorAngleLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GaussianSphericalAngleLabels", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dal", "=", 
      RowBox[{
       RowBox[{"DihedralAngleLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GaussianSphericalAngleLabels", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sar", "=", 
      RowBox[{
       RowBox[{"SectorAngleRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GaussianSphericalAngleLabels", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dar", "=", 
      RowBox[{
       RowBox[{"DihedralAngleRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GaussianSphericalAngleLabels", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "sectorvectors", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sal", "===", "Automatic"}], ",", 
       RowBox[{"sal", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            SubscriptBox["\"\<\[Alpha]\>\"", 
             RowBox[{"ToString", "[", "i", "]"}]], ",", "16"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nn"}], "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dal", "===", "Automatic"}], ",", 
       RowBox[{"dal", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            SubscriptBox["\"\<\[Gamma]\>\"", 
             RowBox[{"ToString", "[", "i", "]"}]], ",", "16"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nn"}], "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldvectors", "=", " ", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"(", 
        RowBox[{"sectorvectors", " ", "+", " ", 
         RowBox[{"RotateLeft", "[", "sectorvectors", "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sal", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Text", ",", 
           RowBox[{"{", 
            RowBox[{"sal", ",", 
             RowBox[{"sar", " ", "sectorvectors"}]}], "}"}]}], "]"}]}], "]"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dal", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Text", ",", 
           RowBox[{"{", 
            RowBox[{"dal", ",", 
             RowBox[{"dar", " ", "foldvectors"}]}], "}"}]}], "]"}]}], "]"}]}],
       "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
