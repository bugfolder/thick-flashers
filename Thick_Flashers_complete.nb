     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{"Cos", "[", "#", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "the", " ", "system"}], " ", "*)"}], 
