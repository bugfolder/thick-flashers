Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"halfplane", ",", "segments", ",", "csegments"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"halfplane", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", ".5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"segments", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", ".25"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", 
              RowBox[{"-", ".25"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", ".25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", ".25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}], ",", 
              RowBox[{"1", "-", 
               RowBox[{"2", 
                RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}], ",", 
              RowBox[{"1", "-", 
               RowBox[{"2", 
                RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"Sort", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Random", "[", "]"}], ",", 
                 RowBox[{"{", "8", "}"}]}], "]"}], "]"}], ",", "2"}], "]"}]}],
            "}"}], ",", 
          RowBox[{"{", "20", "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csegments", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ClipSegmentSetToHalfPlane", "[", 
         RowBox[{"#", ",", "halfplane"}], "]"}], "&"}], "/@", "segments"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"Green", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"halfplane", "\[LeftDoubleBracket]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], "]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"PointSize", "[", ".03", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{
          "halfplane", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
           "]"}], ",", "\[IndentingNewLine]", "Gray", ",", 
         RowBox[{"SegmentSetLine", "/@", "segments"}], ",", 
         "\[IndentingNewLine]", "Red", ",", 
         RowBox[{"Thickness", "[", ".01", "]"}], ",", 
         RowBox[{"SegmentSetLine", "/@", "csegments"}]}], "}"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462923112756584*^9, 3.46292311505275*^9}, {
   3.462923159360147*^9, 3.4629232564321632`*^9}, {3.462923292497732*^9, 
   3.462923316396075*^9}, 3.4629251787733917`*^9, 3.462925286981114*^9, {
   3.466795233548555*^9, 3.466795256612616*^9}, 3.484763525329578*^9, {
   3.484763583496614*^9, 3.484763683754896*^9}, {3.484763727337178*^9, 
   3.4847638153050632`*^9}, {3.484763869733479*^9, 3.484763929712541*^9}, {
   3.484767386894539*^9, 3.484767421591167*^9}, {3.48476757413934*^9, 
   3.484767587256541*^9}, 3.484767617654014*^9, {3.484767712610609*^9, 
   3.484767729838669*^9}, {3.484767813271243*^9, 3.484767841874013*^9}, {
   3.484769864587128*^9, 3.484769864928772*^9}, {3.484769929957506*^9, 
