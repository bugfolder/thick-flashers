Cell[TextData[{
 "RecoverCurve3DSystemOld[{\[Kappa], \[Tau]}",
 StyleBox[",v, opts",
  FontSlant->"Italic"],
 "] constructs a 3D arbitrary-speed curve as a pure function from its \
curvature,  torsion, and curve speed."
}], "Text",
 CellChangeTimes->{{3.690970877159718*^9, 3.690971036930356*^9}, {
   3.690971094765877*^9, 3.690971173216427*^9}, {3.690986089921571*^9, 
   3.69098615225642*^9}, {3.690986183680284*^9, 3.690986212842161*^9}, 
   3.690989404778408*^9, 3.690990056673417*^9, 3.6911837208418417`*^9, {
   3.6912409803871737`*^9, 3.691241005484527*^9}, {3.691241088435383*^9, 
   3.691241122288872*^9}, 3.691252750634756*^9, 3.800465142169359*^9, 
   3.800465266120887*^9, 
   3.800465300361668*^9},ExpressionUUID->"9c9c0f3a-8851-45ed-9666-\
f3605fff7050"],

Cell[TextData[{
 "Arguments:\n\t\[Kappa] \[LongDash] the curvature, as a pure function\n\t\
\[Tau] \[LongDash] the torsion, as a pure function\n\t",
 StyleBox["v",
  FontSlant->"Italic"],
 " \[LongDash] the curve speed, as a pure function"
}], "Text",
 CellChangeTimes->{{3.69124099372663*^9, 3.691240998239414*^9}, {
  3.69124112500037*^9, 
  3.691241135577682*^9}},ExpressionUUID->"950b5315-3cb6-46de-bcbf-\
67a5b3e3c023"],

Cell[TextData[{
 "Options: \n\tInitialPosition2D \[Rule] ",
 StyleBox["c0",
  FontSlant->"Italic"],
 ", specifies the initial (t=0) position of the curve.\n\t\
InitialTangentVector2D \[Rule] ",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", specifies the initial tangent direction of the curve as a unit vector.\n\t\
InitialNormal\[Rule] ",
 StyleBox["n0",
  FontSlant->"Italic"],
 ", specifies the initial normal direction of the curve as a unit vector.\n\t\
Simplification \[Rule] None | Simplify | FullSimplify, specifies the level of \
simplification of intermediate results.\n\tAssumptions \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
   3.6912356648227*^9}, {3.691241159021409*^9, 3.691241164777029*^9}, 
   3.691697846765064*^9, {3.691697914485812*^9, 3.691697920392486*^9}, 
   3.691697988624395*^9, {3.691698149229921*^9, 3.691698157608934*^9}, {
   3.691698194461128*^9, 3.691698195053616*^9}, 3.691698252996705*^9, 
   3.691921637000603*^9, 3.691921671615711*^9, {3.691921713996528*^9, 
   3.6919217153404713`*^9}},ExpressionUUID->"cf03aa41-be7c-4714-8a8d-\
fc94ca93b8d4"],

Cell["\<\
Returns: a list of rules giving the differential geometry functions of the \
curve. The returned curve is in standard position: c[0] = {0,0,0}, with \
initial direction along the x-axis, normal vector along the y-axis, and \
binormal vector along the z axis.\
\>", "Text",
 CellChangeTimes->{{3.69124100849686*^9, 3.691241075156137*^9}, 
   3.691242038212811*^9},ExpressionUUID->"40d2b10e-5b09-4852-b0aa-\
d0ecd5ec2975"],

Cell[TextData[{
 "RecoverCurve3DSystemOld[{\[Kappa], \[Tau]}",
 StyleBox[", opts",
  FontSlant->"Italic"],
 "] constructs a 3D unit-speed curve as a pure function from its curvature \
and torsion."
}], "Text",
 CellChangeTimes->{{3.690970877159718*^9, 3.690971036930356*^9}, {
   3.690971094765877*^9, 3.690971173216427*^9}, {3.690986089921571*^9, 
