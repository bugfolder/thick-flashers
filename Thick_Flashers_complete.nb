             RowBox[{"(", 
              RowBox[{"g2", "+", 
               RowBox[{"y", 
                RowBox[{"(", 
                 RowBox[{"g1", "-", "g2"}], ")"}]}]}], ")"}], "-", 
             RowBox[{"(", 
              RowBox[{"g6", "+", 
               RowBox[{"x", 
                RowBox[{"(", 
                 RowBox[{"g4", "-", "g6"}], ")"}]}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"x", "=", 
            RowBox[{"x", "/.", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sign", "[", 
                    RowBox[{"ut", ".", 
                    RowBox[{"(", 
                    RowBox[{"g1", "-", "g4"}], ")"}]}], "]"}], 
                   RowBox[{"ut", ".", "dg"}]}], "==", "pmt"}], "&&", 
                 RowBox[{
                  RowBox[{"uq", ".", "dg"}], "==", "0"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "\[LeftDoubleBracket]",
               "1", "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "<=", "0"}], "||", 
              RowBox[{"x", ">=", "1"}]}], ",", 
             RowBox[{
              RowBox[{"Message", "[", 
               RowBox[{
                RowBox[{"ThickFlasherTrimTrianglePanels", "::", "badtrim"}], ",",
                 "pmt"}], "]"}], ";", 
              RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"g7", "=", 
            RowBox[{"g6", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"g4", "-", "g6"}], ")"}], "x"}]}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
            "point", " ", "in", " ", "desired", " ", "trim", " ", "plane"}], 
