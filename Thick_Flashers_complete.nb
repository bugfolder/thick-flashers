d59fe93ae259"],

Cell[TextData[{
 "StyledCurvedFoldBounded[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{bl, br}",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces Graphics/Graphics3D elements that represent a curved fold on a \
ruled surface from the fold and its left and bounding curves, which should be \
parameterized as the endpoints of ruling lines. "
}], "Text",
