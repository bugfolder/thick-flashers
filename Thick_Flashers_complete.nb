Cell["Example. Intersection of a cylinder and a plane.", "Text",
 CellChangeTimes->{{3.6721504547278423`*^9, 3.672150460735135*^9}, {
  3.690763129764428*^9, 
  3.690763133212617*^9}},ExpressionUUID->"0a12d8d3-63e2-435c-bece-\
e35027d50546"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ss1", ",", "ss2", ",", "v1", ",", "t", ",", "soln", ",", "u1", ",", 
      "uuu", ",", "ff", ",", "uu", ",", "ucids", ",", "f"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", 
         RowBox[{"Sin", "[", "#2", "]"}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#2", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss1 = \>\"", ",", 
       RowBox[{"ss1", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ss2", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "-", "#1"}], ",", "#2", ",", "#1"}], "}"}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss2 = \>\"", ",", 
       RowBox[{"ss2", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"surface", " ", "normal"}], ",", " ", 
       RowBox[{"parameterized", " ", "on", " ", "two", " ", "variables"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuu", "=", 
      RowBox[{"SurfaceNormalFromSurface", "[", 
       RowBox[{"ss1", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uuu = \>\"", ",", 
       RowBox[{"uuu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Solve", " ", "for", " ", "intersection"}], ",", " ", 
       RowBox[{
        RowBox[{"parameterized", " ", "on", " ", "v1"}], " ", "=", " ", 
        RowBox[{"t", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"v1", "\[Rule]", "t"}], "}"}], ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ss1", "[", 
             RowBox[{"u1", ",", "t"}], "]"}], "\[Equal]", 
            RowBox[{"ss2", "[", 
             RowBox[{"u2", ",", "v2"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"u1", ",", "u2", ",", "v2"}], "}"}]}], "]"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<soln = \>\"", ",", "soln"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "curve", " ", "function", " ", "and", " ", "surface", " ", "normal", " ",
        "on", " ", "one", " ", "variable"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ss1", "[", 
          RowBox[{"u1", ",", "v1"}], "]"}], "/.", "soln"}], ",", "t"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ff = \>\"", ",", 
       RowBox[{"ff", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "DevelopableSurface", " ", "normal", " ", "on", " ", "one", " ", 
       "variable"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"uuu", "[", 
          RowBox[{"u1", ",", "v1"}], "]"}], "/.", "soln"}], ",", "t"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "the", " ", "system"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ucids", "=", 
      RowBox[{"UncurlCurveInDevelopableSystem", "[", 
       RowBox[{"ff", ",", "uu", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"ucids", "//", "PrettyParameters"}], "//", "ColumnForm"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Curve2D", "/.", "ucids"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledPatch", "[", 
             RowBox[{"ss1", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1."}], ",", "2.0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
                RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
              RowBox[{"OutlineStyle", "\[Rule]", "BorderLine"}]}], "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"StyledPatch", "[", 
             RowBox[{"ss2", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", ".5"}], ",", "1.5"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
                RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
              RowBox[{"OutlineStyle", "\[Rule]", "BorderLine"}], ",", 
              RowBox[{"FillStyle", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"Gray", ",", 
                 RowBox[{"Opacity", "[", "0.25", "]"}], ",", 
                 RowBox[{"EdgeForm", "[", "]"}]}], "}"}]}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"ff", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
                RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"DarkGray", ",", 
                 RowBox[{"Thickness", "[", ".015", "]"}]}], "}"}]}]}], "]"}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Graphics", "[", 
          RowBox[{"StyledCurve", "[", 
           RowBox[{"f", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
              RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
            RowBox[{"LineStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"DarkGray", ",", 
               RowBox[{"Thickness", "[", ".015", "]"}]}], "}"}]}]}], "]"}], 
          "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.672146796363988*^9, 3.67214711449957*^9}, {
   3.672147147072768*^9, 3.672147403818366*^9}, {3.672147462022353*^9, 
