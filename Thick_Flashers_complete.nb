f0f16217b9a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "QuadrilateralSplitTwistTile", ",", "verts_List", ",", "w_", ",", "d_", ",",
       "\[Tau]_", ",", "ccw_", ",", "ip_", ",", "ctype_", ",", "types_List"}],
      "}"}], ",", "Tiling", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PolygonTile", ",", "verts"}], "}"}], ",", "Tiling", ",", 
    "opts"}], "]"}]}]], "Input",
