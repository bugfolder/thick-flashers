Cell["\<\
A tiling of two tiles and then render it as tiling, crease pattern, and \
folded form.\
\>", "Text",
 CellChangeTimes->{{3.629828567835726*^9, 3.629828588433327*^9}, {
   3.7077762797823267`*^9, 3.707776284190566*^9}, 
   3.7078410214720592`*^9},ExpressionUUID->"55592d04-709c-4602-bdb0-\
a9ae6b4ba6cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "w", ",", "\[Alpha]", ",", "ip", ",", "ctype", ",", 
      "types", ",", "tiling"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".9", ",", ".8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".2", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
           "QuadrilateralCenteredSplitTwistAltTile", ",", "verts", ",", "w", ",",
             "\[Alpha]", ",", "ip", ",", "ctype", ",", "types"}], "}"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "QuadrilateralCenteredSplitTwistAltTile", ",", "verts", ",", "w", 
             ",", "\[Alpha]", ",", "ip", ",", "ctype", ",", "types"}], "}"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "Tiling", ",", 
             RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowDF"}]}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629828101472671*^9, 3.629828167961506*^9}, 
