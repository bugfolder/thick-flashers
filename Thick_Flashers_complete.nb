Cell[TextData[{
 "TwistCreasePatternPolys[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] take an ",
 "TGraphAssigned",
 " and returns a list of all the polygons in the crease pattern, which should \
simply be a dissection of the paper surface into polygons."
}], "Text",
 CellChangeTimes->{{3.457736238343054*^9, 3.457736304543166*^9}, 
