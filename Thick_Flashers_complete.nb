 RowBox[{
  RowBox[{
   RowBox[{"RadialEdgeFn", "::", "usage"}], 
   "=", "\"\<RadialEdgeFn is a option to MakeRectangularQuadMesh that returns \
the type to be assigned to the {i,j}\[Theta] radial edge.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594070558714256*^9, 3.594070596229224*^9}, {
