   3.799752171149387*^9}},ExpressionUUID->"43117217-6eda-4005-88e4-\
b671cf00a251"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of the curve.\n\t",
 StyleBox["\[Theta]",
  FontSlant->"Italic"],
 " \[LongDash] the helicity angle.\n\t",
 StyleBox["\[Gamma]0",
  FontSlant->"Italic"],
 " \[LongDash] the constant fold angle.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.799748099776724*^9, 3.799748125937078*^9}, {
   3.79975079647245*^9, 3.799750799523525*^9}, 3.799750902998814*^9, {
