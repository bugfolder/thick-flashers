Cell["Example: two ellipses, rotated with respect to each other.", "Text",
 CellChangeTimes->{{3.671179378580347*^9, 3.671179379315285*^9}, {
  3.671179476269991*^9, 3.67117948130822*^9}, {3.6712467136301928`*^9, 
  3.671246714636716*^9}, {3.671251073782176*^9, 
  3.671251080572001*^9}},ExpressionUUID->"93146d7b-28fd-4556-a874-\
f085181edd85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "a", ",", "b", ",", "botpts2d", ",", "toppts2d", ",", "dz", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "24"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"rotational", " ", "order"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", "GoldenRatio"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dz", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{"DiscreteEllipseEquilateral", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"toppts2d", "=", 
      RowBox[{"RotateLeft", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RotationMatrix2D", "[", 
            RowBox[{"90", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
         "botpts2d"}], ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"TwistJoinedTubeGraphics", "[", 
        RowBox[{"botpts2d", ",", "toppts2d"}], "]"}], "]"}], "//", "Hold"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"TwistJoinedTubes", "[", 
       RowBox[{"botpts2d", ",", "toppts2d", ",", "dz", ",", 
        RowBox[{"PanelOverlap", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
