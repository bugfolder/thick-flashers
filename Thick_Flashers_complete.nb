Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeFaceAngles3D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts3d", ",", "edges", ",", "faces", ",", "efi", ",", "fc", ",", "fn", 
      ",", "ei", ",", "fi"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "edges", ",", "faces", ",", "efi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices3D", ",", "Edges", ",", "Faces", ",", "EdgeFaceIncidence"}],
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{"FaceCentroids3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fn", "=", 
      RowBox[{"FaceNormals3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ei", "=", 
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "each", " ", "edge", " ", "as", " ", "vertex", " ", "index", " ", 
          "pair"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"fi", "=", 
         RowBox[{
         "efi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "faces", " ", "incident", " ", "to", " ", "the", " ", "edge", " ", 
          "as", " ", "face", " ", "indices"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"fi", ",", "0"}], "]"}], ",", "\[IndentingNewLine]", "0", ",", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"is", " ", "boundary", " ", "edge"}], ",", " ", 
            RowBox[{"return", " ", "0"}], ",", " ", 
            RowBox[{"else", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"DirectedAngle3D", "[", 
           RowBox[{
            RowBox[{"fn", "\[LeftDoubleBracket]", 
             RowBox[{
             "fi", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"fn", "\[LeftDoubleBracket]", 
             RowBox[{
             "fi", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{"verts3d", "\[LeftDoubleBracket]", 
              RowBox[{
              "ei", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}], "-", 
             RowBox[{"verts3d", "\[LeftDoubleBracket]", 
              RowBox[{
              "ei", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}]}]}], "]"}]}], " ", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.591645570812914*^9, 3.591645611046671*^9}, {
   3.591819661635329*^9, 3.5918196967416143`*^9}, {3.591821080535297*^9, 
