Cell[CellGroupData[{

Cell["Pruned tilings", "Subsection",
 CellChangeTimes->{{3.457791789396468*^9, 3.457791792865348*^9}, 
   3.627385976103436*^9, {3.627569997225407*^9, 3.6275700182219057`*^9}, {
   3.627575925930686*^9, 
   3.627575926250708*^9}},ExpressionUUID->"0a2e526e-88ab-448e-a9b8-\
a95aa557cf4e"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457781974220977*^9, 3.457781974501023*^9}, 
   3.457790172164316*^9, 
   3.627385976103724*^9},ExpressionUUID->"1558ed75-b996-4607-860a-\
2916d743cb37"],

Cell[TextData[{
 "These functions are used for pruning tilings to the minimum necessary to \
cover convex polygonal regions. Some tiling generation functions, such as the \
Archimedean lattice tilings that we will encounter below, naturally generate \
very irregular-shaped regions of tiles (as always, defined by lists of ",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 "). Using these functions, we can prune a larger (possibly irregular) tiling \
down to a roughly rectangular tiling prior to rendering. This keeps the \
rendering time low, and if we export a tiling with a clipping rectangle, this \
ensures that unnecessary tiles outside of the cliprect are not rendered."
}], "Text",
 CellChangeTimes->{{3.45778518011489*^9, 3.457785215722889*^9}, {
   3.4577852580920486`*^9, 3.45778525841666*^9}, {3.457785301035184*^9, 
   3.457785341824833*^9}, {3.457790182923568*^9, 3.457790215774412*^9}, {
   3.592219798786392*^9, 3.592219798985011*^9}, 3.6273859761040916`*^9, {
   3.627575959008644*^9, 
   3.627576153091379*^9}},ExpressionUUID->"788e55fd-503c-4da8-850c-\
479bb19ec629"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TilespecInPolygonQ[",
 StyleBox["tilespec",
  FontSlant->"Italic"],
 ", ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.457781969728283*^9, 3.457782136403358*^9, {3.457785064946526*^9, 
   3.457785072982191*^9}, {3.457785142296657*^9, 3.457785142314516*^9}, {
   3.4577869442087293`*^9, 3.457786956020717*^9}, 3.592219814561184*^9, {
   3.592219993769006*^9, 3.59222002144219*^9}, {3.617459534327738*^9, 
   3.617459540747767*^9}, {3.617469088075317*^9, 3.617469142204477*^9}, 
   3.627385976104493*^9, 3.627576395510337*^9, 3.627659643601054*^9, 
   3.627659937494065*^9},ExpressionUUID->"fc571a98-69de-4dbe-acb0-\
dbb9392c5472"],

Cell[TextData[{
 "TilespecInPolygonQ[",
 StyleBox["tilespec",
  FontSlant->"Italic"],
 ", ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "] takes a ",
 StyleBox["tilespec",
  FontSlant->"Italic"],
 " and returns true if any part of the tile lies within the specified convex \
polygon ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ". It does this by looking at whether any of the vertices of the tile lie \
within the polygon or vice-versa. It relies on convexity of both polygons."
}], "Text",
 CellChangeTimes->{{3.45778689772171*^9, 3.457786938445897*^9}, {
   3.457786977599122*^9, 3.457787009185856*^9}, {3.592220041611803*^9, 
   3.592220046451845*^9}, {3.617469431649068*^9, 3.617469463838511*^9}, {
   3.617472208413787*^9, 3.617472234142563*^9}, 3.627385976110832*^9, {
   3.6276599383471603`*^9, 3.627659939753532*^9}, {3.627659974779841*^9, 
   3.62765997551432*^9}},ExpressionUUID->"b2ad84ff-f3db-4846-8c96-\
152e269a4d92"],

Cell[TextData[{
 "TBD: this will fail if we have two crossed rectangles that overlap without \
enclosing each others vertices. In ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 10, there are nice built-in functions for determining polygon \
intersection, so we\[CloseCurlyQuote]ll use those at the next upgrade."
}], "Text",
 CellChangeTimes->{{3.627658664551835*^9, 3.627658711258633*^9}, {
  3.627659987257135*^9, 
  3.627659998040395*^9}},ExpressionUUID->"e0b13fa1-681c-494f-85b4-\
1ac71336b88c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TilespecInTilingQ", "[", 
   RowBox[{"tilespec_", ",", "verts_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"EmbedTile", "[", 
       RowBox[{"tilespec", ",", "TileVertices", ",", 
        RowBox[{"Numeric", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Or", "@@", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"PtInConvexPolygonQ", "[", 
           RowBox[{"#", ",", "verts"}], "]"}], "&"}], "/@", "pts"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"PtInConvexPolygonQ", "[", 
           RowBox[{"#", ",", "pts"}], "]"}], "&"}], "/@", "verts"}]}], " ", 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.45778708352654*^9, 3.457787177356368*^9}, {
   3.457787214077903*^9, 3.457787237444954*^9}, {3.457787307263984*^9, 
