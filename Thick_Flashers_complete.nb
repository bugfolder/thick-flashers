Cell[TextData[{
 "FoldGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] folds a TGraph according to a set of fold angles."
}], "Text",
 CellChangeTimes->{{3.45825702176451*^9, 3.458257129091948*^9}, {
