    RowBox[{
     RowBox[{"u0", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"u1", "=", 
      RowBox[{"3", "\[Pi]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"kp", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ta", "=", 
      RowBox[{"0.5", "&"}]}], ";", "\[IndentingNewLine]", 
