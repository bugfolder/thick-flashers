Cell[TextData[{
 "PtInHalfPlaneQ[",
 StyleBox["q",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}]\nPtNotInHalfPlaneQ[",
 StyleBox["q",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}]\nPtInWedgeQ[",
 StyleBox["q",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}]\nPtInTriangleQ[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}]\nPtInTrianglesQ[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 "]\nPtInConvexPolygonQ[",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.462900121927037*^9, 3.462900240124719*^9}, {
   3.463410045533608*^9, 3.46341005701782*^9}, 3.628852809803301*^9, {
   3.628852903196701*^9, 3.62885290705702*^9}, {3.628854801944733*^9, 
   3.628854810582604*^9}, {3.628854848533287*^9, 3.628854849172525*^9}, 
   3.6288627598984222`*^9},ExpressionUUID->"6a885ace-99db-452c-8d21-\
4a65ddc0febf"],

Cell[TextData[{
 "PtInHalfPlaneQ[",
 StyleBox["q",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}] returns True if the point ",
 StyleBox["q",
  FontSlant->"Italic"],
 " lies within the half-plane defined by the line through {",
 StyleBox["p1,",
  FontSlant->"Italic"],
 " ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} that contains ",
 StyleBox["p3",
  FontSlant->"Italic"],
 " (which should not lie on that line)",
 StyleBox[".",
  FontSlant->"Italic"],
 " If the test point lies on the line, it returns True."
}], "Text",
 CellChangeTimes->{{3.4629002499807034`*^9, 3.462900292913322*^9}, {
  3.6288530078354053`*^9, 
  3.6288530131303053`*^9}},ExpressionUUID->"94f85704-ec6f-4841-b451-\
411c010c08e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PtInHalfPlaneQ", "[", 
   RowBox[{"q_", ",", 
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", "=", 
      RowBox[{"Rotate90", "[", 
       RowBox[{"p2", "-", "p1"}], "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"q", "-", "p1"}], ")"}], ".", "r"}], "\[Equal]", "0"}], "||", 
     
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q", "-", "p1"}], ")"}], ".", "r"}], "]"}], "\[Equal]", 
      RowBox[{"Sign", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p3", "-", "p1"}], ")"}], ".", "r"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
