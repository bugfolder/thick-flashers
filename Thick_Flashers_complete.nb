   3.692478733620674*^9}, 3.692485342217918*^9, {3.692485389706559*^9, 
   3.692485397849819*^9}, 3.692485451103676*^9, {3.692529714746084*^9, 
   3.69252971652264*^9}, {3.692529793650779*^9, 3.692529845226585*^9}, {
   3.692529914708342*^9, 3.692529921030209*^9}, {3.692530955214039*^9, 
   3.692530974382926*^9}, {3.6925313238984833`*^9, 3.692531330341197*^9}, {
   3.692531653941312*^9, 3.692531722343091*^9}, {3.6925569143361263`*^9, 
   3.692556939637704*^9}, {3.692905719217561*^9, 3.692905726525771*^9}, {
   3.692909003873024*^9, 3.692909013769547*^9}, {3.692910136490967*^9, 
   3.6929101616644497`*^9}, {3.692911085263094*^9, 3.692911095580448*^9}, {
   3.692971359979321*^9, 3.692971367373915*^9}, {3.692971776095176*^9, 
   3.692971796416678*^9}, {3.692971915452207*^9, 3.692971928014117*^9}, {
   3.693354852260995*^9, 3.6933551896971483`*^9}, {3.69339577165703*^9, 
   3.693395792935763*^9}, 3.693396229538565*^9, {3.693396302234818*^9, 
   3.6933963195386*^9}, {3.693396582506974*^9, 3.693396616729794*^9}, {
   3.693396647146668*^9, 3.693396707814127*^9}, {3.693402027017714*^9, 
   3.693402057474179*^9}, 3.693419384498763*^9, {3.703531548340308*^9, 
   3.703531640723859*^9}, 3.703601361070341*^9},
