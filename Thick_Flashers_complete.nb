   3.799530296648636*^9, 3.80165825386152*^9, 
   3.803995361107443*^9},ExpressionUUID->"79aca3b3-1f26-426e-ba88-\
4fa8a41a4cab"],

Cell[TextData[{
 "NCurvedFoldFrom 2D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrR",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ffi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", bbti}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 2D ruled neighborhood of a fold and constructs the 3D folded form."
}], "Text",
 CellChangeTimes->{{3.799443038645782*^9, 3.799443087820142*^9}, {
   3.799525636131332*^9, 3.7995256404592113`*^9}, 
   3.803995361949232*^9},ExpressionUUID->"7dd6920e-7ac5-46dc-b965-\
ab4c71f8aef2"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the 2D curved fold as a vector-valued function.\n\t",
 StyleBox["rrL",
  FontSlant->"Italic"],
 " \[LongDash] the left ruling vector in the plane, as a vector-valued \
function.\n\t",
 StyleBox["rrR",
  FontSlant->"Italic"],
 " \[LongDash] the right ruling vector in the plane, as a vector-valued \
function.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value parameter.\n\t",
 StyleBox["\[Gamma]i",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the fold angle.\n\t",
 StyleBox["ffi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position in 3D of the curved fold.\n\t",
 StyleBox["tti",
  FontSlant->"Italic"],
 " \[LongDash] the initial tangent vector in 3D of the curved fold.\n\tbbti \
\[LongDash] the initial binormal vector of the fold, which lies halfway \
between the left and right sides of the fold.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.79951259049842*^9, 3.799512745723276*^9}, {
   3.799525609011341*^9, 3.7995256167874827`*^9}, 
   3.803995362861864*^9},ExpressionUUID->"e73ffc2e-ef05-476a-9126-\
e470d27ae784"],

Cell[TextData[{
 "Returns: the 3D ruled neighborhood {",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrR",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.79944272256857*^9, 3.799442736259595*^9}, {
  3.799443369626952*^9, 
  3.799443378481267*^9}},ExpressionUUID->"76f15946-3c6e-4a5a-9314-\
ac9fc716e7b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NFoldCurvedFold3D", "::", "nosoln"}], 
   "=", "\"\<NDSolve couldn't integrate the fold angle equation.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.7994871182869396`*^9, 
   3.79948714206791*^9}, 3.7994882597419653`*^9, 3.799490874181484*^9, {
   3.799515096517729*^9, 3.7995151031861362`*^9}, {3.79952560136334*^9, 
   3.799525602707302*^9}, {3.79952565760431*^9, 3.7995256667401247`*^9}, 
   3.799530296654007*^9, 3.801658253876041*^9},
 CellLabel->
  "In[3972]:=",ExpressionUUID->"0eb1c679-9961-4970-ad46-236da9d0303f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NFoldCurvedFold3D", "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.79944345788535*^9, 3.7994434660770397`*^9}, 
   3.7995128144069*^9, 3.799525604460568*^9, 3.799530296656177*^9, 
   3.80165825388015*^9},
 CellLabel->
  "In[3973]:=",ExpressionUUID->"58b37d60-7a48-4205-819f-9e32b565763e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NFoldCurvedFold3D", "[", 
   RowBox[{
    RowBox[{"f_Function", "|", "f_InterpolatingFunction"}], ",", 
    RowBox[{"rL_Function", "|", "rL_InterpolatingFunction"}], ",", 
    RowBox[{"rR_Function", "|", "rR_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "ui_", ",", "\[Gamma]i_", ",", "ffi_", ",", "tti_", ",", "bbti_"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "dsopts", ",", "c2dsys", ",", "ds", ",", "\[Kappa]l", ",", "t",
       ",", "l", ",", "cot\[Rho]L", ",", "cot\[Rho]R", ",", "\[Gamma]", ",", 
      "soln", ",", "\[Tau]", ",", "\[Kappa]", ",", "c3dsys", ",", "ff", ",", 
      "tt", ",", "nn", ",", "bb", ",", "\[FinalSigma]", ",", "llL", ",", 
      "\[Kappa]g", ",", "\[Kappa]n", ",", "\[Tau]g", ",", "c\[Rho]L", ",", 
      "s\[Rho]L", ",", "rrL", ",", "llR", ",", "c\[Rho]R", ",", "s\[Rho]R", ",",
       "rrR"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "the", " ", "2", "D", " ", "frame", " ", "of", " ", "the", " ",
        "curve"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"c2dsys", "=", 
      RowBox[{"NCurve2DSystem", "[", 
       RowBox[{"f", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed2D", ",", "LeftCurvature2D", ",", "TangentVector2D", ",", 
         "LeftNormalVector2D"}], "}"}], "/.", "c2dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"t", "[", "s", "]"}], ".", 
         RowBox[{"rL", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"l", "[", "s", "]"}], ".", 
         RowBox[{"rL", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"t", "[", "s", "]"}], ".", 
         RowBox[{"rR", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"-", 
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{"rR", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cot\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"c\[Rho]L", "[", "s", "]"}], 
         RowBox[{"s\[Rho]L", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cot\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"c\[Rho]R", "[", "s", "]"}], 
         RowBox[{"s\[Rho]R", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Gamma]", "'"}], "[", "s", "]"}], 
            RowBox[{"Cot", "[", 
             FractionBox[
              RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}]}], "\[Equal]", 
           
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"\[Kappa]l", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"cot\[Rho]L", "[", "s", "]"}], "-", 
              RowBox[{"cot\[Rho]R", "[", "s", "]"}]}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{"\[Gamma]", "[", "ui", "]"}], "\[Equal]", "\[Gamma]i"}]}], 
         "}"}], ",", "\[Gamma]", ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "NDSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"NFoldCurvedFold3D", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"\[Gamma]", "/.", 
       RowBox[{"Flatten", "[", "soln", "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}], " ", 
         RowBox[{"Sec", "[", 
          FractionBox[
           RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Tan", "[", 
          FractionBox[
           RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
         RowBox[{"\[Kappa]l", "[", "s", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"cot\[Rho]L", "[", "s", "]"}], "+", 
           RowBox[{"cot\[Rho]R", "[", "s", "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[FinalSigma]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Sign", "[", 
         RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c3dsys", "=", 
      RowBox[{"NRecoverCurve3DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]", ",", "\[Tau]", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "ffi", ",", "tti", ",", 
          RowBox[{
           RowBox[{"\[FinalSigma]", "[", "ui", "]"}], "bbti"}]}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Curve3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
         "BinormalVector3D"}], "}"}], "/.", "c3dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"llL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[FinalSigma]", "[", "s", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", 
             FractionBox[
              RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
            RowBox[{"nn", "[", "s", "]"}]}], "+", 
           RowBox[{
            RowBox[{"Sin", "[", 
             FractionBox[
              RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
            RowBox[{"bb", "[", "s", "]"}]}]}], ")"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c\[Rho]L", "[", "s", "]"}], 
          RowBox[{"tt", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"s\[Rho]L", "[", "s", "]"}], " ", 
          RowBox[{"llL", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"llR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[FinalSigma]", "[", "s", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", 
             FractionBox[
              RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
            RowBox[{"nn", "[", "s", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Sin", "[", 
             FractionBox[
              RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
            RowBox[{"bb", "[", "s", "]"}]}]}], ")"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c\[Rho]R", "[", "s", "]"}], 
          RowBox[{"tt", "[", "s", "]"}]}], "-", 
         RowBox[{
          RowBox[{"s\[Rho]R", "[", "s", "]"}], " ", 
          RowBox[{"llR", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.799512515743082*^9, 3.799512556961553*^9}, {
   3.799512859735985*^9, 3.799512898811159*^9}, {3.799513282512126*^9, 
