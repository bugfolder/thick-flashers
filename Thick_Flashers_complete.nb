   3.6690640343378267`*^9, 3.669064065069372*^9}, {3.669070319089156*^9, 
   3.6690703275734653`*^9}, {3.6721018927568893`*^9, 3.672101909363738*^9}, {
   3.688132113326176*^9, 3.688132266183436*^9}, 3.688997938505866*^9, {
