Cell["\<\
Example. Three panels, two hinges between them, one on top, one on bottom.\
\>", "Text",
 CellChangeTimes->{{3.933843462700878*^9, 3.933843464966213*^9}, {
  3.933844061237239*^9, 3.933844067636639*^9}, {3.9339440448564568`*^9, 
  3.9339440539920397`*^9}, {3.934030013906102*^9, 3.934030041481729*^9}, {
  3.934734800018195*^9, 3.934734829498077*^9}, {3.935858410665731*^9, 
  3.935858411192754*^9}},ExpressionUUID->"d732e695-8fb9-4084-8d05-\
9fddd9b8163c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", "t", ",", "a", ",", "b", ",", "c", ",", "panels", ",", 
       "panelinfo", ",", "axes", ",", "panelparts", ",", "xfrm", ",", 
       "assy"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", "t"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"10", ",", "2"}], "}"}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"dimensions", " ", "of", " ", "the", " ", "panels"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"b", "=", 
        RowBox[{"c", "=", 
         RowBox[{"MakeCubeGC", "[", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "a", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"d", ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "b", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "d"}], ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"panels", "=", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"axes", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "1", ",", "t"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", 
             RowBox[{"d", "-", "1"}], ",", "t"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "d"}], ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "d"}], ",", 
             RowBox[{"d", "-", "1"}], ",", "0"}], "}"}]}], "}"}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"panelinfo", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "7"}], "}"}]}], "}"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"{", 
              RowBox[{"5", ",", "8"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", 
             RowBox[{"{", 
              RowBox[{"6", ",", "7"}], "}"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"{", 
             RowBox[{"5", ",", "8"}], "}"}]}], "}"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Show", " ", "the", " ", "panels", " ", "and", " ", "the", " ", "axes",
         " ", "where", " ", "the", " ", "pin", " ", "hinges", " ", "should", " ", 
        RowBox[{"go", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "SolidStyle", ",", 
             RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Cylinder", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"t", "/", "2"}]}], "]"}], ",", "Orange"}], "]"}], 
             "&"}], "/@", "axes"}]}], "}"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Panels and hinge locations\>\""}]}], 
        "]"}], "//", "Print"}], ";", "\[IndentingNewLine]", 
      RowBox[{"panelparts", "=", 
       RowBox[{"MakePinHingedPanelParts", "[", 
        RowBox[{"panels", ",", "panelinfo", ",", "axes"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Show", " ", "each", " ", "panel", " ", "with", " ", "its", " ", 
        RowBox[{"elements", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Panels and parts\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "/@", 
       RowBox[{"PinHingedPanelPartsGraphics3D", "[", "panelparts", "]"}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}], "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.9338434666037188`*^9, 3.933843753165881*^9}, {
   3.933843810464285*^9, 3.933843941364746*^9}, {3.933844161890683*^9, 
