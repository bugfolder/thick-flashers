Cell["\<\
An algebraic example, to check expressions for the normal and geodesic \
curvature in terms of the principal curvatures.\
\>", "Text",
 CellChangeTimes->{{3.687999680570673*^9, 
  3.6879997284455643`*^9}},ExpressionUUID->"b7c36fda-0c10-44f5-800e-\
a040b14a2280"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "k1", ",", "k2", ",", "ss", ",", "u", ",", "v", ",", "t", ",", "ssu", ",",
       "ssv", ",", "soln", ",", "uuu", ",", "\[Alpha]", ",", "qq", ",", "ff", 
      ",", "uu", ",", "cs3s", ",", "tt", ",", "nn", ",", "bb", ",", "ll", ",",
       "fda", ",", "kn", ",", "kg", ",", "tg", ",", "r"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], "k1", 
           SuperscriptBox["#1", "2"]}], "+", 
          RowBox[{
           FractionBox["1", "2"], "k2", 
           SuperscriptBox["#2", "2"]}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss = \>\"", ",", 
       RowBox[{"ss", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "two", " ", "principle", " ", "lines", " ", "of", " ", "curvature"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ssu", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"ss", "[", 
         RowBox[{"u", ",", "0"}], "]"}], ",", "u"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ssv", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"ss", "[", 
         RowBox[{"0", ",", "v"}], "]"}], ",", "v"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"surface", " ", "normal"}], ",", " ", 
       RowBox[{"parameterized", " ", "on", " ", "two", " ", "variables"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuu", "=", 
      RowBox[{"SurfaceNormalFromSurface", "[", 
       RowBox[{"ss", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uuu = \>\"", ",", 
       RowBox[{"uuu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "line", " ", "of", " ", "curve", " ", "in", " ", "parameterized", " ", 
       "space"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"qq", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", " ", 
