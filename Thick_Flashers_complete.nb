        RowBox[{"hr", ",", "ur"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dr", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"cl", "+", 
       RowBox[{"vl", " ", "dl"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xh", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v0", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xh", ".", "cl"}], ")"}], "/", 
           RowBox[{"(", 
