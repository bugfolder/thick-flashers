         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graphics", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", "pts", "]"}], ",", "Red"}], "]"}], "]"}], "]"}],
      ";", "\[IndentingNewLine]", 
