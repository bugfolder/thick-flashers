Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "=", "2.5"}], ",", 
      RowBox[{"mm", "=", 
       RowBox[{
        RowBox[{"RotationXMatrix3D", "[", 
         RowBox[{"15.", "\[Degree]"}], "]"}], ".", 
        RowBox[{"RotationYMatrix3D", "[", 
         RowBox[{"20.", "\[Degree]"}], "]"}]}]}], ",", "p", ",", "plist", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "[", "0", "]"}], "=", 
      RowBox[{"m", " ", "*", 
       RowBox[{"mm", ".", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", "1", "]"}], "=", 
      RowBox[{"m", " ", "*", 
       RowBox[{"mm", ".", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", "2", "]"}], "=", 
      RowBox[{"m", " ", "*", 
       RowBox[{"mm", ".", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "0"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", "3", "]"}], "=", 
      RowBox[{"m", " ", "*", 
       RowBox[{"mm", ".", 
        RowBox[{"{", 
         RowBox[{"0", ",", "3", ",", 
          RowBox[{"+", "0.3"}]}], "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"plist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "[", "0", "]"}], ",", 
        RowBox[{"p", "[", "1", "]"}], ",", 
        RowBox[{"p", "[", "2", "]"}], ",", 
        RowBox[{"p", "[", "3", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTSpaceCurve", "[", 
       RowBox[{"plist", ",", "0.65", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"60", "\[Degree]"}], ",", 
          RowBox[{"30", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"OsculatingVectorNear", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SpaceCurveMaximumWidth\>\"", "\[Rule]", 
       RowBox[{"tobj", "[", "SpaceCurveMaximumWidth", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
