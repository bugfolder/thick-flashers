Cell[TextData[{
 "DropOrphanVertices[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.457624107071236*^9, 3.457624111975116*^9}, {
   3.457624159982296*^9, 3.4576241627714868`*^9}, {3.591649197930746*^9, 
   3.591649203647306*^9}, {3.5916495760959873`*^9, 3.591649576406678*^9}, 
   3.591728608644031*^9, {3.5923496612774553`*^9, 3.592349665860012*^9}, 
