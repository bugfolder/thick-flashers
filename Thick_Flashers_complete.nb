Cell[CellGroupData[{

Cell[TextData[{
 "UnitRegularPolygonCenteredTwistPatch[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629919974322876*^9, 3.6299200423850746`*^9}, {
  3.629921373643578*^9, 3.6299213745802608`*^9}, {3.631181386699806*^9, 
  3.631181387495667*^9}},ExpressionUUID->"7fb60c72-f440-44c8-ae81-\
2d55e105f30e"],

Cell[TextData[{
 "UnitRegularPolygonCenteredTwistPatch[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] takes a patch composed of {UnitRegularPolygonTile, ",
 StyleBox["n",
  FontSlant->"Italic"],
 "} tiletypes and returns a patch of UnitRegularPolygonCenteredTwistTile with \
parameters {w, \[Tau]} and edge types ",
 StyleBox["types",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.629920051453157*^9, 3.629920117404588*^9}, {
  3.6299213780941677`*^9, 3.629921403819909*^9}, {3.631181389665432*^9, 
  3.631181433439084*^9}},ExpressionUUID->"32b163de-2e22-41b3-ab02-\
b55cd9ddcf7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitRegularPolygonCenteredTwistPatch", "[", 
   RowBox[{"patch_List", ",", "w_", ",", "\[Tau]_", ",", "types_List"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PatchCheckTypes", "[", 
      RowBox[{"patch", ",", "types"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"UnitRegularPolygonCenteredTwistTile", ",", 
            RowBox[{"#1", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", "w", ",",
             "\[Tau]", ",", "#2"}], "}"}], ",", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
         "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RegularizePatch", "[", "patch", "]"}], ",", "types"}], 
        "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629921366647694*^9, 3.629921379238908*^9}, {
  3.629921416245736*^9, 3.629921434369371*^9}, {3.629921465745446*^9, 
  3.6299215136935053`*^9}, {3.629921647477094*^9, 3.629921672586972*^9}, {
  3.62992171434524*^9, 3.629921765073333*^9}, {3.6299218157736883`*^9, 
  3.629921818938834*^9}, {3.629921858607747*^9, 3.629921861279186*^9}, {
  3.629921924540119*^9, 3.629921938562531*^9}, {3.63118144709683*^9, 
  3.631181454151209*^9}, {3.631181611020363*^9, 3.631181620445962*^9}, {
