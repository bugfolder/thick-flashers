     RowBox[{"FrenetDrop", "\[Rule]", "0"}]}], "\[IndentingNewLine]", "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.668983474348447*^9, 3.668983510043645*^9}, {
