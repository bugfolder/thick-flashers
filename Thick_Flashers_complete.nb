Cell[TextData[{
 "FuzzGCs[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fuzzrad",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FuzzSeed, FuzzMethod"
}], "Subsubsection",
 CellChangeTimes->{{3.7085908592254877`*^9, 3.708590884779992*^9}, {
   3.708591314580946*^9, 3.708591315586484*^9}, {3.708591433862939*^9, 
   3.708591439039196*^9}, {3.7085941558820467`*^9, 3.708594156949421*^9}, 
   3.708963373124638*^9, {3.708963505929191*^9, 
   3.708963507752076*^9}},ExpressionUUID->"7b1dec36-8f6a-4d6b-b46f-\
0517f248ecc3"],

Cell[TextData[{
 "FuzzGCs[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fuzzrad",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] fuzzes the vertices of any GraphicsComplex elements in an expression."
}], "Text",
 CellChangeTimes->{{3.708593572330606*^9, 3.708593631572958*^9}, {
   3.708594148420541*^9, 3.708594152148922*^9}, {3.708598146193145*^9, 
   3.708598146513823*^9}, 
   3.708963373145669*^9},ExpressionUUID->"d4b4ce6a-a4f6-4c44-b994-\
fc248dccbc02"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any expression that contains GraphicsComplex elements.\n\t",
 StyleBox["fuzzrad",
  FontSlant->"Italic"],
 " \[LongDash] the magnitude of the desired random perturbation vector."
}], "Text",
 CellChangeTimes->{{3.70859849835569*^9, 3.708598527908586*^9}, 
   3.708963373168467*^9},ExpressionUUID->"83ef24fc-1aee-4b20-94fc-\
24a396eebc74"],

Cell[TextData[{
 "Options:\n\tFuzzSeed \[Rule] ",
 StyleBox["seed",
  FontSlant->"Italic"],
 " is passed through to FuzzPoints.\n\tFuzzMethod \[Rule] FuzzByVertex | \
FuzzByGroup, whether to perturb each vertex differently or by the same amount \
within each GraphicsComplex."
}], "Text",
 CellChangeTimes->{{3.708591568529192*^9, 3.7085915851793556`*^9}, {
  3.708593001774769*^9, 3.708593015083487*^9}, {3.708963510055407*^9, 
  3.708963543176064*^9}, {3.708964294759344*^9, 3.70896430563881*^9}, {
  3.708964367217945*^9, 
  3.708964381943405*^9}},ExpressionUUID->"756e5c7f-ee5f-47c2-9200-\
bf3e3948f6a0"],

Cell[TextData[{
 "Returns: ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " with all of its GraphicsComplex elements having perturbed vertex positions."
}], "Text",
 CellChangeTimes->{{3.708598543173945*^9, 
  3.708598564601204*^9}},ExpressionUUID->"71659625-820c-48f6-b19f-\
e849c8c0d17e"],

Cell["\<\
Note that different GraphicsComplex elements will be perturbed independently, \
so vertices in different GraphicsComplex expressions that were originally \
aligned will, in general, be misaligned. This is useful to create STLs with \
no unintentional vertex coincidences that give rise to non-manifold forms.\
\>", "Text",
 CellChangeTimes->{{3.708598566231844*^9, 
  3.708598651053758*^9}},ExpressionUUID->"909ca9f2-89d5-459c-a64f-\
bdc72418421c"],

Cell["\<\
Note that if you use FuzzByVertex, any formerly planar polygons with >3 \
vertices will be nonplanar. If that is a problem (e.g., in STL generation), \
you should triangulate the GraphicComplexes before fuzzing them. Usually, \
though, it should suffice to use FuzzByGroup.\
\>", "Text",
 CellChangeTimes->{{3.708598681075801*^9, 3.708598725438406*^9}, {
  3.708964399705068*^9, 
  3.708964426007611*^9}},ExpressionUUID->"f9edb2b5-0913-4b35-9847-\
840d44b21d07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FuzzGCs", "[", 
   RowBox[{"expr_", ",", "fuzzrad_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{"gc_GraphicsComplex", "\[RuleDelayed]", 
    RowBox[{"FuzzGC", "[", 
     RowBox[{"gc", ",", "fuzzrad", ",", "opts"}], "]"}]}]}]}]], "Input",
