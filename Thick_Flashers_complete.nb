Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ss1", ",", "ss2", ",", "soln", ",", "uuu", ",", "ff", ",", "uu", ",", 
      "cs3s"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", 
         RowBox[{"Sin", "[", "#2", "]"}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#2", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss1 = \>\"", ",", 
       RowBox[{"ss1", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
