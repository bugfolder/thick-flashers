Cell[CellGroupData[{

Cell[TextData[{
 "MakeTwistTube[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {{",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "},...}]\nMakeTwistTube[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["nh",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.643365613803889*^9, 3.6433656737366447`*^9}, {
  3.643365847813353*^9, 3.643365873463208*^9}, {3.654259853848158*^9, 
  3.654259859331765*^9}},ExpressionUUID->"30b26780-e6c6-4825-8681-\
7caf11006862"],

Cell[TextData[{
 "MakeTwistTube[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {{",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "},...}] returns a TGraph3D+TAssigned+TCornerIndices that represents a twist \
tube defined by a list of parameters where\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " is the rotational order of the tube\n\t{{",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "},...} is a list of specifiers for each level of the tube, where for each \
level,\n\t\t",
 StyleBox["h1",
  FontSlant->"Italic"],
 " specifies one stable height for that level\n\t\t",
 StyleBox["h2",
  FontSlant->"Italic"],
 " specifies the second stable height, which is the one used for the folded \
form\n\t\t",
 StyleBox["dir",
  FontSlant->"Italic"],
 " = \[PlusMinus]1 specifies the desired direction of twist"
}], "Text",
 CellChangeTimes->{{3.643365811242515*^9, 3.643365838269869*^9}, {
  3.6433658820514407`*^9, 3.643365992035451*^9}, {3.643368479880849*^9, 
  3.6433684823694897`*^9}},ExpressionUUID->"c52c3cfe-f041-4c76-b832-\
3c5e92a8a0c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTwistTube", "[", 
   RowBox[{"m_", ",", "hlist_List"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Phi]", ",", "verts", ",", "edges", ",", "types", ",", "verts3d", ",",
        "nv", ",", "\[Alpha]", ",", "r", ",", "d\[Phi]1", ",", "d\[Phi]2", ",",
        "h2", ",", "dir", ",", "rr", ",", "tobj"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"bottom", " ", "row"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Phi]", "=", 
       RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"verts", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"m", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"edges", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"i", "+", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"types", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"B", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verts3d", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationZMatrix3D", "[", 
           RowBox[{"2", " ", "i", " ", "\[Phi]"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"Cot", "[", "\[Phi]", "]"}]}], ",", 
            RowBox[{"-", 
             FractionBox["1", "2"]}], ",", "0"}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "m"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"add", " ", "each", " ", "row", " ", "in", " ", "order"}], " ",
        "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"nv", "=", 
          RowBox[{"Length", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", "r", ",", "d\[Phi]1", ",", "d\[Phi]2"}], 
           "}"}], "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"TwistTubeParameters", "[", 
            RowBox[{"m", ",", " ", 
             RowBox[{
             "hlist", "\[LeftDoubleBracket]", "j", 
              "\[RightDoubleBracket]"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"h2", "=", 
          RowBox[{"hlist", "\[LeftDoubleBracket]", 
           RowBox[{"j", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dir", "=", 
          RowBox[{"hlist", "\[LeftDoubleBracket]", 
           RowBox[{"j", ",", "3"}], "\[RightDoubleBracket]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rr", "=", 
          RowBox[{"r", " ", 
           RowBox[{"U", "[", "\[Alpha]", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"verts", ",", 
              RowBox[{
               RowBox[{"verts", "\[LeftDoubleBracket]", 
                RowBox[{"nv", "-", 
                 RowBox[{"(", 
                  RowBox[{"m", "+", "1"}], ")"}], "+", "i"}], 
                "\[RightDoubleBracket]"}], "+", "rr"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"verts3d", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "h2"}], "}"}], "+", 
               RowBox[{
                RowBox[{"RotationZMatrix3D", "[", "d\[Phi]2", "]"}], ".", 
                RowBox[{"verts3d", "\[LeftDoubleBracket]", 
                 RowBox[{"nv", "-", 
                  RowBox[{"(", 
                   RowBox[{"m", "+", "1"}], ")"}], "+", "i"}], 
                 "\[RightDoubleBracket]"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", "verticals", " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"edges", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nv", "-", 
                 RowBox[{"(", 
                  RowBox[{"m", "+", "1"}], ")"}], "+", "i"}], ",", 
                RowBox[{"nv", "+", "i"}]}], "}"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"types", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"i", "\[Equal]", "0"}], "||", 
                 RowBox[{"i", "\[Equal]", 
                  RowBox[{"m", "+", "1"}]}]}], ",", "B", ",", "M"}], "]"}]}], 
             "]"}], ";"}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"m", "+", "1"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "diagonals", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dir", ">", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"edges", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"nv", "+", "i", "-", 
                    RowBox[{"(", 
                    RowBox[{"m", "+", "1"}], ")"}]}], ",", 
                   RowBox[{"nv", "+", "i", "+", "1"}]}], "}"}]}], "]"}], ";", 
               
               RowBox[{"AppendTo", "[", 
                RowBox[{"types", ",", "V"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "m"}], "}"}]}], "]"}], ";"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"edges", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"nv", "+", "i", "+", "1", "-", 
                   RowBox[{"(", 
                    RowBox[{"m", "+", "1"}], ")"}]}], ",", 
                  RowBox[{"nv", "+", "i"}]}], "}"}]}], "]"}], ";", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"types", ",", "V"}], "]"}], ";"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "tops", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"edges", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nv", "+", "i"}], ",", 
                RowBox[{"nv", "+", "i", "+", "1"}]}], "}"}]}], "]"}], ";", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"types", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"j", "\[Equal]", 
                 RowBox[{"Length", "[", "hlist", "]"}]}], ",", "B", ",", 
                "M"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "m"}], "}"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "hlist", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tobj", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"MakeTGraph3D", "[", 
          RowBox[{"verts", ",", "edges", ",", 
           RowBox[{"{", "}"}], ",", "verts3d"}], "]"}], "//", 
         "AddTPlaneGraph"}], "//", 
        RowBox[{"AddTAssigned", "[", "types", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RecalcFoldAngles", "[", "tobj", "]"}]}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"Dimensions", "[", "hlist", "]"}], "]"}], "\[Equal]", 
    "2"}]}]}]], "Input",
 CellChangeTimes->{{3.6433657743397293`*^9, 3.643365795402309*^9}, {
   3.643366009387446*^9, 3.64336602485087*^9}, {3.643366157565666*^9, 
