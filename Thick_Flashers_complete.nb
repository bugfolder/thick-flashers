Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeFoldVectorsFromSectorsAndMajorDihedral", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", 
       SubscriptBox["\[Alpha]", "2"], ",", 
       SubscriptBox["\[Alpha]", "3"], ",", 
       SubscriptBox["\[Alpha]", "4"]}], "}"}], ",", 
     SubscriptBox["\[Gamma]", "1"], ",", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "0efebcd8-ee11-40bc-86b3-a0492816a4d1"],
 "\n\t(options) ",
 "AllowSelfIntersection, ",
 "OsculatingVectorNear"
}], "Subsubsection",
 CellChangeTimes->{{3.440444696095467*^9, 3.440444809393157*^9}, {
   3.440445154773081*^9, 3.44044515636386*^9}, {3.44044571010603*^9, 
