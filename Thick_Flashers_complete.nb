Cell["2D or 3D styled Graphics/Graphics3D elements", "Subsection",
 CellChangeTimes->{{3.443218208604177*^9, 3.443218246234925*^9}, {
   3.533658975246952*^9, 3.533658976598312*^9}, 3.5336604854834223`*^9, {
   3.5922088348473673`*^9, 
   3.592208835487487*^9}},ExpressionUUID->"76fb7c0a-d845-4c19-a6a0-\
167dd098952f"],

Cell[CellGroupData[{

Cell[TextData[{
 "StyledPoint",
 "[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PointStyle"
}], "Subsubsection",
 CellChangeTimes->{{3.443217996621383*^9, 3.443218008499104*^9}, 
   3.668985639310264*^9},ExpressionUUID->"46920181-e078-4189-81f0-\
8c74b66fc459"],

Cell[TextData[{
 "StyledPoint",
 "[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a Point[",
 StyleBox["p",
  FontSlant->"Italic"],
 "] wrapped in the given style directive."
}], "Text",
 CellChangeTimes->{{3.4432180194435863`*^9, 3.443218040412094*^9}, 
   3.6689856393558187`*^9},ExpressionUUID->"e829793c-e643-4f19-b028-\
5281bc253b9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PointStyle", "::", "usage"}], 
   "=", "\"\<PointStyle is an option to StyledPoint that specifies style \
directives for the point.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591800868983067*^9, 3.5918009004116993`*^9}, 
   3.66898563937292*^9},
 CellLabel->
  "In[1600]:=",ExpressionUUID->"399cde1e-fdaf-483c-a438-cf0e7e273d60"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledPoint", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PointStyle", "\[Rule]", 
     RowBox[{"{", "}"}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.443218047913186*^9, 3.443218064889263*^9}, 
   3.668985639391508*^9},
 CellLabel->
  "In[1601]:=",ExpressionUUID->"9da5924c-4c7c-4844-8ecc-e20d5afdbcae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledPoint", "[", 
   RowBox[{"p_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ps", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ps", "=", 
      RowBox[{
       RowBox[{"PointStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledPoint", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Point", "[", "p", "]"}], ",", "ps"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.44321806889849*^9, 3.443218097410699*^9}, {
  3.668985639409655*^9, 3.668985639424616*^9}},
 CellLabel->
  "In[1602]:=",ExpressionUUID->"76cfa5ec-03df-4924-b89f-92cbca0429af"],

