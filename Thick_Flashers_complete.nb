Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["s",
  FontSlant->"Italic"],
 " \[LongDash] the surface function as a cross-ruled surface as a pure \
function.\n\t{u0, u1} \[LongDash] domain of the first argument of s.\n\t{v0, \
v1} \[LongDash] domain of the second argument of s."
}], "Text",
