Cell[TextData[{
 "FoldedFormPolys3D",
 "[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes an TGraphAssigned and returns a list of Graphics elements that \
gives a set of (possibly overlapping) polygons that render the folded form. \
Options are:\n\tPaperOrientation \[Rule] WhiteUp | ColorUp, specifies the \
color to be shown on the side of the face that is CCW with respect to the \
vertices.\t"
}], "Text",
 CellChangeTimes->{{3.45789193755861*^9, 3.457891975666669*^9}, 
