Cell[BoxData[
 RowBox[{
  RowBox[{"NLinkedFoldsNext3D", "[", 
   RowBox[{
    RowBox[{"f0_Function", "|", "f0_InterpolatingFunction"}], ",", 
    RowBox[{"f1_Function", "|", "f1_InterpolatingFunction"}], ",", 
    RowBox[{"\[Gamma]1_Function", "|", "\[Gamma]1_InterpolatingFunction"}], ",", 
    RowBox[{"ff0_Function", "|", "ff0_InterpolatingFunction"}], ",", 
    RowBox[{"tt0_Function", "|", "tt0_InterpolatingFunction"}], ",", 
    RowBox[{"ll0_Function", "|", "ll0_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cs", ",", "c2dsys0", ",", "c2dsys1", ",", "t0", ",", "l0", ",", "t1", ",",
       "l1", ",", "s", ",", "df", ",", "ff1", ",", "cd\[Rho]", ",", 
      "sd\[Rho]", ",", "tt1", ",", "llL1", ",", "uuL1", ",", "llR1"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cs", "=", 
      RowBox[{
       RowBox[{"Curve2DSystems", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NLinkedFoldsFirst3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"cs", "===", "Automatic"}], ",", 
       RowBox[{"cs", "=", 
        RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c2dsys0", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "cs", "]"}], "\[GreaterEqual]", "1"}], ",", 
        RowBox[{"cs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"NCurve2DSystem", "[", 
         RowBox[{"f0", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"c2dsys1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "cs", "]"}], "\[GreaterEqual]", "2"}], ",", 
        RowBox[{"cs", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"NCurve2DSystem", "[", 
         RowBox[{"f0", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t0", ",", "l0"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"TangentVector2D", ",", "LeftNormalVector2D"}], "}"}], "/.", 
       "c2dsys0"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t1", ",", "l1"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"TangentVector2D", ",", "LeftNormalVector2D"}], "}"}], "/.", 
       "c2dsys1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"df", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"f1", "[", "s", "]"}], "-", 
         RowBox[{"f0", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff1", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ff0", "[", "s", "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"t0", "[", "s", "]"}], ".", 
            RowBox[{"df", "[", "s", "]"}]}], ")"}], 
          RowBox[{"tt0", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"l0", "[", "s", "]"}], ".", 
            RowBox[{"df", "[", "s", "]"}]}], ")"}], 
          RowBox[{"ll0", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"cd\[Rho]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"t0", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"t1", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"l0", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"l1", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}]}]}], 
         RowBox[{
          RowBox[{"df", "[", "s", "]"}], ".", 
          RowBox[{"df", "[", "s", "]"}]}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Rho]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"l0", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"t1", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"t0", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"l1", "[", "s", "]"}], ".", 
             RowBox[{"df", "[", "s", "]"}]}], ")"}]}]}], 
         RowBox[{
          RowBox[{"df", "[", "s", "]"}], ".", 
          RowBox[{"df", "[", "s", "]"}]}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tt1", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"cd\[Rho]", "[", "s", "]"}], 
          RowBox[{"tt0", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"sd\[Rho]", "[", "s", "]"}], 
          RowBox[{"ll0", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"llL1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"sd\[Rho]", "[", "s", "]"}]}], 
          RowBox[{"tt0", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"cd\[Rho]", "[", "s", "]"}], 
          RowBox[{"ll0", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uuL1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"tt1", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"llL1", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"llR1", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Gamma]1", "[", "s", "]"}], "]"}]}], 
          RowBox[{"uuL1", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Gamma]1", "[", "s", "]"}], "]"}], 
          RowBox[{"llL1", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ff1", ",", "tt1", ",", "llR1"}], "}"}]}]}], "]"}]}]], "Input",
