Cell["Number of distinct vertices in the first sector:", "Text",
 CellChangeTimes->{{3.555771410572643*^9, 
  3.555771420635289*^9}},ExpressionUUID->"e0730ce3-75f9-4519-8a8a-\
103b87da092c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"r", "=", "2"}], ",", 
