Cell[CellGroupData[{

Cell[TextData[{
 "FaceShrink[",
 StyleBox["verts, faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FaceShrinkage"
}], "Subsubsection",
 CellChangeTimes->{{3.825767522316693*^9, 3.825767546653105*^9}, {
  3.825767597725091*^9, 3.82576759808543*^9}, {3.825767748749975*^9, 
  3.825767752022418*^9}, {3.825768001512151*^9, 3.825768016240635*^9}, {
  3.82576975095682*^9, 
  3.8257697567001967`*^9}},ExpressionUUID->"471102d7-ff74-48f6-b260-\
28f0715723c2"],

Cell[TextData[{
 "FaceShrink[",
 StyleBox["verts, faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of vertices and faces and pulls all the vertices slightly \
toward the centroids of their surrounding faces."
}], "Text",
 CellChangeTimes->{{3.82576755262037*^9, 3.8257675580932617`*^9}, {
  3.825767605452773*^9, 3.825767658734257*^9}, {3.825768203530573*^9, 
  3.825768204162181*^9}, {3.825769758580214*^9, 
  3.825769782293002*^9}},ExpressionUUID->"4e3a56dc-e334-4a63-8b97-\
3f29e837335d"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["verts",
  FontSlant->"Italic"],
 " \[LongDash] a list of vertices to be perturbed.\n\t",
 StyleBox["faces",
  FontSlant->"Italic"],
 " \[LongDash] a list of the faces indexed on the vertices."
}], "Text",
 CellChangeTimes->{{3.825767660717114*^9, 3.825767676733959*^9}, {
  3.825769786740468*^9, 
  3.8257698102054462`*^9}},ExpressionUUID->"2f6336d4-b9ec-4432-a253-\
3eecf38b1392"],

Cell[TextData[{
 "Options:\n\tFaceShrinkage \[Rule] ",
 StyleBox["fs",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["fs",
  FontSlant->"Italic"],
 " is the scaling factor for the amount of shrinkage (usually small)."
}], "Text",
 CellChangeTimes->{{3.825767744677683*^9, 3.825767781702832*^9}, {
  3.825867116669131*^9, 
  3.825867122416016*^9}},ExpressionUUID->"dc1ce9c4-a9c6-41a9-960e-\
3a9fd4bda679"],

Cell["\<\
Returns: a list of the perturbed vertex positions. Note that a vertex \
surrounded by multiple faces will be pulled in multiple directions.\
\>", "Text",
 CellChangeTimes->{{3.825767679133443*^9, 3.825767704118757*^9}, {
  3.825767786006266*^9, 
  3.8257678001746817`*^9}},ExpressionUUID->"13257c1f-fb57-49ea-8d6f-\
1f26ffadc70f"],

Cell["\<\
This is a utility that is useful when we need to recalculate a TPlaneGraph \
(see below) after splitting edges. Performing FaceShrink on the vertices will \
(usually) allow the planarization of AddTPlaneGraph to work.\
\>", "Text",
 CellChangeTimes->{{3.825767706245667*^9, 3.825767735286622*^9}, {
  3.825768027512219*^9, 3.825768031849022*^9}, {3.8257682279066343`*^9, 
  3.825768274898778*^9}, {3.825866691122197*^9, 
  3.825866693009704*^9}},ExpressionUUID->"4993ae21-44fc-4e84-ab7b-\
d90e35dc0037"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FaceShrinkage", "::", "usage"}], 
   "=", "\"\<FaceShrinkage is an option to FaceShrink that specifies the \
relative amount by which vertices are pulled toward the centroids of their \
surrounding faces.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.825768305771311*^9, 3.82576835564388*^9}},
 CellLabel->
  "In[951]:=",ExpressionUUID->"76c8d797-686d-4169-9939-d0bea0ec3766"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FaceShrink", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"FaceShrinkage", "\[Rule]", "0.1"}], " ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"this", " ", "is", " ", "a", " ", "good", " ", "all"}], "-", 
      RowBox[{"around", " ", "value"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.825768277410818*^9, 3.825768298683394*^9}, {
  3.8258649087680483`*^9, 3.8258649306393423`*^9}},
 CellLabel->
  "In[952]:=",ExpressionUUID->"6ba5e4cf-7293-42d6-8b23-1e28c628000b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceShrink", "[", 
   RowBox[{"verts_List", ",", "faces_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fs", ",", "vfi", ",", "ctrs", ",", "pulls"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fs", "=", 
      RowBox[{
       RowBox[{"FaceShrinkage", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FaceShrink", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "create", " ", "centroids", " ", "of", " ", "all", " ", "faces"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ctrs", "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"Plus", "@@", 
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
         RowBox[{"Length", "[", "#", "]"}]], "&"}], "/@", "faces"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "create", " ", "a", " ", "list", " ", "of", " ", "faces", " ", 
       "incident", " ", "to", " ", "the", " ", "vertices", " ", 
       RowBox[{"(", 
        RowBox[{"no", " ", "particular", " ", "order"}], ")"}]}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"vfi", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "verts", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{
           RowBox[{
           "vfi", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], ",",
            "i"}], "]"}], "&"}], "/@", 
        RowBox[{
        "faces", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "faces", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "create", " ", "centroid", " ", "of", " ", "pull", " ", "for", " ", 
        "each", " ", "vertex"}], ";", " ", 
       RowBox[{"empty", " ", "list", " ", "for", " ", "orphan", " ", 
        RowBox[{"vertices", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pulls", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ListEmptyQ", "[", "#", "]"}], ",", 
          RowBox[{"{", "}"}], ",", 
          FractionBox[
           RowBox[{"Plus", "@@", 
            RowBox[{
            "ctrs", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
           
           RowBox[{"Length", "[", "#", "]"}]]}], "]"}], "&"}], "/@", 
       "vfi"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"pull", " ", "vertices", " ", 
       RowBox[{"(", 
        RowBox[{
        "no", " ", "pull", " ", "for", " ", "orphan", " ", "vertices"}], 
        " "}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#1", "===", 
           RowBox[{"{", "}"}]}], ",", "#2", ",", 
          RowBox[{
           RowBox[{"fs", " ", "#1"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "fs"}], ")"}], "#2"}]}]}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"pulls", ",", "verts"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.825768424798121*^9, 3.8257685163649883`*^9}, {
   3.825768637335607*^9, 3.825768702766551*^9}, {3.825768739016009*^9, 
