Cell[CellGroupData[{

Cell["Primal-dual graph actions", "Subsection",
 CellChangeTimes->{{3.592649414317658*^9, 
  3.5926494180696993`*^9}},ExpressionUUID->"8752ddcf-9900-43d6-9589-\
74b0d72184db"],

Cell[CellGroupData[{

Cell[TextData[{
 "OrientEdgePairs[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "]\n\t(checked class) ",
 "PrimalDualGraphics"
}], "Subsubsection",
 CellChangeTimes->{{3.592504291056659*^9, 3.592504309292686*^9}, 
   3.592505481954423*^9, 3.592828805468184*^9, 
   3.595200377251994*^9},ExpressionUUID->"b58b906d-ea5a-48f5-b34c-\
03f7b0ce7a43"],

Cell[TextData[{
 "OrientEdgePairs[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "] takes a TPrimalDualGraph and reorients the DualEdges and InteriorEdges so \
that the ordering function ",
 StyleBox["fn",
  FontSlant->"Italic"],
 " acting on each dual edge returns True while maintaining the directed \
orthogonality of the DualEdges and InteriorEdges (namely, that each \
InteriorEdge is a 90\[Degree] CCW rotation of its corresponding DualEdge)."
}], "Text",
 CellChangeTimes->{{3.5925043119249887`*^9, 3.5925044090376997`*^9}, {
   3.592504442555691*^9, 3.592504526998438*^9}, {3.5925053824649897`*^9, 
   3.592505382814582*^9}, {3.592505418487495*^9, 3.592505419413382*^9}, 
   3.592828805574687*^9},ExpressionUUID->"1281e089-d205-48d6-ab83-\
8efb2750749c"],

Cell["\<\
This is used to orient a TPrimalDualGraph that specifies a primal-dual twist \
tessellation; the direction of the dual edges will specify the pleat \
directions.\
\>", "Text",
 CellChangeTimes->{{3.592505428109175*^9, 3.592505460161684*^9}, 
   3.592828805649496*^9},ExpressionUUID->"1e0eec1c-b203-4fa2-bc82-\
156284e6c547"],

Cell[TextData[{
 "See also OrientEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "]."
}], "Text",
 CellChangeTimes->{
  3.592505421290296*^9},ExpressionUUID->"cabe1d09-0259-427e-87cd-\
0f7f6e68c241"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrientEdgePairs", "[", 
   RowBox[{"tobj_TObj", ",", " ", "fn_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "iedges", ",", "dverts", ",", "dedges"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPrimalDualGraph", ",", "OrientEdgePairs"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dverts", ",", "dedges", ",", "iedges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"DualVertices", ",", "DualEdges", ",", "InteriorEdges"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"fn", "[", 
           RowBox[{
            RowBox[{"dverts", "\[LeftDoubleBracket]", 
             RowBox[{"dedges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"dverts", "\[LeftDoubleBracket]", 
             RowBox[{"dedges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "dedges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "=", 
           RowBox[{"Reverse", "[", 
            RowBox[{
            "dedges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "]"}]}], ";", 
          RowBox[{
           RowBox[{
           "iedges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "=", 
           RowBox[{"Reverse", "[", 
            RowBox[{
            "iedges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "]"}]}]}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "dedges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InteriorEdges", "\[Rule]", "iedges"}], ",", 
         RowBox[{"DualEdges", "\[Rule]", "dedges"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.592504535734603*^9, 3.592504597920704*^9}, {
   3.592504642779383*^9, 3.592504934035824*^9}, 3.592681720865913*^9, 
   3.592707736211117*^9, 3.592828805723076*^9, 3.593006102054489*^9},
 CellLabel->
  "In[1502]:=",ExpressionUUID->"dec898f4-091e-4efa-bb2c-7f881247d8b6"],

Cell["Example", "Text",
 CellChangeTimes->{{3.592504947235759*^9, 
  3.592504947954872*^9}},ExpressionUUID->"17a3d05c-26d8-41be-b84d-\
e8b2f1c85ddd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj", ",", "fn", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "9"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraphTo"}], "//",
        "AddTPrimalDualGraphTo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fn", "=", 
      RowBox[{"RadialAxialOrderingFn", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"RadialMajor", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"OrientEdgePairs", "[", 
       RowBox[{"tobj", ",", "fn"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrimalDualGraphics", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"PrimalDirectedEdges", "\[Rule]", "True"}], ",", 
          RowBox[{"DualDirectedEdges", "\[Rule]", "True"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PrimalDualGraphics", "[", 
         RowBox[{"tobj1", ",", 
          RowBox[{"PrimalDirectedEdges", "\[Rule]", "True"}], ",", 
          RowBox[{"DualDirectedEdges", "\[Rule]", "True"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.5925049492071037`*^9, 3.5925052612555113`*^9}, {
   3.592505339715691*^9, 3.592505352593051*^9}, 3.592505399851511*^9, 
   3.592647647499048*^9, 3.592659844600892*^9, {3.592792658675273*^9, 
   3.592792668179995*^9}, 3.592828722216621*^9, {3.592828805793849*^9, 
   3.59282880589066*^9}, {3.5942075841710997`*^9, 3.594207600185166*^9}, {
   3.595200377320322*^9, 3.595200377356141*^9}},
 CellLabel->
  "In[1503]:=",ExpressionUUID->"6024f4e3-931e-4fcc-a89a-fc180ee16d1d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Primal-dual graph interrogators", "Subsection",
 CellChangeTimes->{{3.703974472533772*^9, 
  3.703974478619596*^9}},ExpressionUUID->"1785179e-a144-4ddf-b4ae-\
cdf0e45aefc6"],

Cell[CellGroupData[{

Cell[TextData[{
 "InteriorEdgeMap[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.703974481133231*^9, 
  3.703974486324152*^9}},ExpressionUUID->"2fc1d92b-ad37-4f00-a114-\
38e57f8a6dc3"],

Cell[TextData[{
 "InteriorEdgeMap take a TPrimalDualGraph and returns a list of indices into \
Edges that gives the correspondence between InteriorEdges and Edges. The ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th element of the return list is the index into Edges of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th interior edge."
}], "Text",
 CellChangeTimes->{{3.703974487915984*^9, 3.703974512357056*^9}, {
  3.703974758447382*^9, 3.703974788174623*^9}, {3.703974870704549*^9, 
  3.703974878522065*^9}},ExpressionUUID->"d23d2510-a0af-409e-ab0a-\
3c7361c804d7"],

Cell["\<\
This is useful if we want to get information about interior edges that is \
ordered relative to Edges, e.g., crease assignment and fold angles.\
\>", "Text",
 CellChangeTimes->{{3.7039748024311247`*^9, 
  3.7039748479519877`*^9}},ExpressionUUID->"c1597c7c-2b6e-4f44-992a-\
2619a03aaf48"],

Cell["\<\
Note that OrientedInteriorEdgePairs constructs InteriorEdges to have the same \
orientation as Edges, but OrientEdgePairs (see previous) might have changed \
their orientation, so we need to check both orientations to construct the map.\
\>", "Text",
 CellChangeTimes->{{3.703974624373263*^9, 
  3.703974692958375*^9}},ExpressionUUID->"da639ac2-0e4a-4faa-9e6b-\
f67a4532fe5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InteriorEdgeMap", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"edges", ",", "iedges", ",", "emap"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "iedges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "InteriorEdges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"emap", "[", 
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          "]"}], "=", "i"}], ";", 
        RowBox[{
         RowBox[{"emap", "[", 
          RowBox[{"Reverse", "[", 
           RowBox[{
           "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "]"}], "]"}], "=", "i"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"emap", "/@", "iedges"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.703974854798625*^9, 3.70397506245468*^9}},
 CellLabel->
  "In[1504]:=",ExpressionUUID->"94524ef3-a210-42b1-adfd-20523f10f9e7"],

Cell["Example", "Text",
 CellChangeTimes->{{3.592504947235759*^9, 
  3.592504947954872*^9}},ExpressionUUID->"4a826db0-e9de-45ce-be65-\
e874eaa6432e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj", ",", "fn", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
