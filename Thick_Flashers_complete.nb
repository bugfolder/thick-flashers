Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Styled2DArc", "[", 
    RowBox[{"r1_List", ",", "r2_List", ",", "opts___"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Alpha]", ",", "alr", ",", "as", ",", "q1", ",", "q2", ",", "dq"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Alpha]", "=", 
       RowBox[{
        RowBox[{"ArcLabel", "/.", 
         RowBox[{"{", "opts", "}"}]}], "/.", 
        RowBox[{"Options", "[", "Styled2DArc", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"alr", "=", 
       RowBox[{
        RowBox[{"ArcLabelRadius", "/.", 
         RowBox[{"{", "opts", "}"}]}], "/.", 
        RowBox[{"Options", "[", "Styled2DArc", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"as", "=", 
       RowBox[{
        RowBox[{"LineStyle", "/.", 
         RowBox[{"{", "opts", "}"}]}], "/.", 
        RowBox[{"Options", "[", "Styled2DArc", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q1", "=", 
       RowBox[{"ArcTan", "@@", "r1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q2", "=", 
       RowBox[{"ArcTan", "@@", "r2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dq", "=", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"q2", "-", "q1"}], ",", 
         RowBox[{"2", "\[Pi]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", 
              RowBox[{"q1", "+", "dq"}]}], "}"}]}], "]"}], ",", "as"}], "]"}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"\[Alpha]", "===", "None"}], ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{"Text", "[", 
           RowBox[{"\[Alpha]", ",", 
            RowBox[{"alr", " ", 
             RowBox[{"U", "[", 
              RowBox[{"q1", "+", 
               RowBox[{"dq", "/", "2"}]}], "]"}]}]}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.440258047415174*^9, 3.440258071088681*^9}, {
   3.440258112085349*^9, 3.440258134299312*^9}, {3.440258331663875*^9, 
