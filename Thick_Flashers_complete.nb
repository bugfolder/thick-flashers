              RowBox[{"{", 
               RowBox[{"1", ",", "2.5"}], "}"}]}], "}"}], "]"}], ",", 
           "UnfoldedLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3"}], "}"}]}], "}"}], "]"}], ",", 
           "HiddenUnfoldedLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "3.5"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3.5"}], "}"}]}], "}"}], "]"}], ",", 
           "BorderLine"}], "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{"g", ",", 
         RowBox[{"KillFolds", "[", "g", "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.52685429342737*^9, 3.526854397130142*^9}, {
   3.533658733399068*^9, 3.5336587645399637`*^9}, {3.5918014750326147`*^9, 
   3.591801481346793*^9}, 3.628948739727746*^9, {3.779544260847332*^9, 
   3.779544358619592*^9}, {3.77954443259084*^9, 3.779544447158979*^9}, {
   3.7795445102412033`*^9, 3.779544518618626*^9}},
 CellLabel->
  "In[1699]:=",ExpressionUUID->"c814c143-e4ce-4d38-afae-bbb4532ee0c1"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "KillBorder[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.703184587112529*^9, 
  3.703184589006728*^9}},ExpressionUUID->"557e093f-837b-41cf-ac90-\
ad4aebbcc03c"],

Cell[TextData[{
 "KillBorder[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] completely removes all BorderLine and HiddenBorderLine lines."
}], "Text",
 CellChangeTimes->{{3.628969626143067*^9, 3.628969653557125*^9}, {
  3.6892475306868134`*^9, 
  3.689247531192831*^9}},ExpressionUUID->"1070b493-8d92-439d-b11c-\
6ab78ed51654"],

Cell["\<\
Useful particularly to display shapes where you don\[CloseCurlyQuote]t want \
to suggest a sharp edge of the paper, e.g., circular polygons twists. You can \
also accomplish the same effect by applying rules {BorderLine \[Rule] NoLine, \
HiddenBorderLine \[Rule] NoLine}.\
\>", "Text",
 CellChangeTimes->{{3.689247533825981*^9, 3.689247615216459*^9}, {
  3.703184575054989*^9, 3.703184575973296*^9}, {3.7031846331272388`*^9, 
  3.7031846458704243`*^9}},ExpressionUUID->"695cabd2-ce5f-4fbb-98d1-\
0d89007c695a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"KillBorder", "[", "expr_", "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"_", ",", "BorderLine"}], "]"}], "\[Rule]", 
      RowBox[{"Sequence", "[", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"_", ",", "HiddenBorderLine"}], "]"}], "\[Rule]", 
      RowBox[{"Sequence", "[", "]"}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.628969662967835*^9, 3.628969688222315*^9}},
 CellLabel->
  "In[1700]:=",ExpressionUUID->"1cb7cac2-19d7-480b-b4ba-ec17dd4ef5f2"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "KillHidden[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.703184592550013*^9, 3.70318459743825*^9}, 
   3.779543949937649*^9},ExpressionUUID->"bd470910-b599-4a62-823a-\
68c46eec0d22"],

Cell[TextData[{
 "KillHidden[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] completely removes all HiddenLine and HiddenBorderLine lines."
}], "Text",
 CellChangeTimes->{{3.628969626143067*^9, 3.628969653557125*^9}, {
  3.6892475306868134`*^9, 3.689247531192831*^9}, {3.703184609560182*^9, 
  3.703184618405949*^9}},ExpressionUUID->"a187d4cf-8ba5-46d1-871d-\
8c3f8ddeb45c"],

Cell["\<\
Useful particularly to display shapes where you don\[CloseCurlyQuote]t want \
to suggest a sharp edge of the paper, e.g., circular polygons twists. You can \
also accomplish the same effect by applying rules {HiddenFoldedLine \[Rule] \
NoLine, HiddenUnfoldedLine \[Rule] NoLine, HiddenBorderLine \[Rule] NoLine}.\
\>", "Text",
 CellChangeTimes->{{3.689247533825981*^9, 3.689247615216459*^9}, {
  3.703184575054989*^9, 3.703184575973296*^9}, {3.703184658321006*^9, 
  3.70318466756673*^9}, {3.7031847205991306`*^9, 
  3.703184732167135*^9}},ExpressionUUID->"9dc8f2d1-9ba3-4682-8ba7-\
cb22bb8f996b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"KillHidden", "[", "expr_", "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"_", ",", "HiddenFoldedLine"}], "]"}], "\[Rule]", 
      RowBox[{"Sequence", "[", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"_", ",", "HiddenUnfoldedLine"}], "]"}], "\[Rule]", 
      RowBox[{"Sequence", "[", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"_", ",", "HiddenBorderLine"}], "]"}], "\[Rule]", 
      RowBox[{"Sequence", "[", "]"}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.628969662967835*^9, 3.628969688222315*^9}, 
   3.703184610825931*^9, {3.703184674800424*^9, 3.703184707870726*^9}},
 CellLabel->
  "In[1701]:=",ExpressionUUID->"4531ff40-633d-4986-ad1d-25fc32eebd10"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Reversing line and fill styles", "Subsection",
 CellChangeTimes->{{3.68946709002387*^9, 3.689467097669258*^9}, {
   3.689467150152317*^9, 3.689467151506043*^9}, {3.689467585372295*^9, 
   3.689467589166651*^9}, {3.6894682594362783`*^9, 3.6894682611411953`*^9}, {
   3.689503077031268*^9, 3.6895030796598597`*^9}, 
   3.689867489294993*^9},ExpressionUUID->"5190dbad-9a0c-4bc1-aa09-\
9c0e7b739adc"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.689503322673809*^9, 
  3.689503323141208*^9}},ExpressionUUID->"c4ef8c46-1ce1-4ee7-9c39-\
f19f8e0ff0b3"],

Cell["\<\
Sometimes we\[CloseCurlyQuote]d like to change mountains to valleys or white \
side to colored after an object is constructed. These functions let us do \
that in CPs and FFs.\
\>", "Text",
 CellChangeTimes->{{3.689503327758164*^9, 
  3.689503376339272*^9}},ExpressionUUID->"008dec97-5f56-4090-b9dd-\
83e0c3269a63"],

Cell["\<\
Note, though, that the functions need to be applied while styles are still \
symbolic, i.e., before the application of OrigamiStyle rules.\
\>", "Text",
 CellChangeTimes->{{3.689503378081634*^9, 3.689503401412813*^9}, 
   3.693872225338955*^9},ExpressionUUID->"a2f7657f-b306-45d3-a89b-\
12f80801b0bb"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ReverseLineStyle[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.689467156522176*^9, 3.689467173278672*^9}, {
  3.689503083189804*^9, 
  3.689503083894474*^9}},ExpressionUUID->"3adf6a62-a312-4afb-b192-\
e1d27a2c25b3"],

Cell[TextData[{
 "ReverseLineStyle",
 "[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] swaps mountain and valley line styles."
}], "Text",
 CellChangeTimes->{{3.68946717498447*^9, 3.689467192253119*^9}, 
   3.689503087433629*^9},ExpressionUUID->"ac73de17-d07d-41f2-9234-\
2af6a32e1e8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReverseLineStyle", "[", "obj_", "]"}], ":=", 
   RowBox[{"obj", "/.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MountainLine", "\[Rule]", "ValleyLine"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ValleyLine", "\[Rule]", "MountainLine"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"MountainRulingLine", "\[Rule]", "ValleyRulingLine"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ValleyRulingLine", "\[Rule]", "MountainRulingLine"}]}], 
     "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.689467202512291*^9, 3.689467254969715*^9}, 
   3.689503088392427*^9},
 CellLabel->
  "In[1702]:=",ExpressionUUID->"d112a10c-109a-478d-9a13-3a141c551ad1"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.689467260252316*^9, 3.689467261089469*^9}, 
   3.68950316143201*^9},ExpressionUUID->"b11be9e0-2d99-4694-a1fb-\
1e98ceb8ef9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GraphicsRow", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"OrigamiSampleGraphics", ",", "\[IndentingNewLine]", 
      RowBox[{"OrigamiSampleGraphics", "//", "ReverseLineStyle"}]}], 
     "\[IndentingNewLine]", "}"}], "/.", 
    RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.68946729459652*^9, 3.689467335324498*^9}, 
   3.689503089753495*^9},
 CellLabel->
  "In[1703]:=",ExpressionUUID->"39fe9b10-177a-400e-968e-f8ed1dd4d76f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ReverseFillStyle[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.689468269045616*^9, 3.689468274137002*^9}, {
  3.689503092646808*^9, 
  3.689503093497292*^9}},ExpressionUUID->"b811b408-ad9a-43d1-a668-\
eee6e5fb1632"],

Cell[TextData[{
 "ReverseFillStyle",
 "[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] swaps white and colored side fill styles."
}], "Text",
 CellChangeTimes->{{3.689468276837212*^9, 3.689468292617243*^9}, 
   3.689503097139092*^9},ExpressionUUID->"78f0b82e-2fd2-4360-b31f-\
be65392fcd67"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReverseFillStyle", "[", "obj_", "]"}], ":=", 
   RowBox[{"obj", "/.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Paper3DFill", "\[Rule]", "Paper3DFillReversed"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PaperWhiteSideFill", "\[Rule]", "PaperColoredSideFill"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PaperColoredSideFill", "\[Rule]", "PaperWhiteSideFill"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Paper3DFillBothWhite", "\[Rule]", "Paper3DFillBothColored"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Paper3DFillBothColored", "\[Rule]", "Paper3DFillBothWhite"}]}],
      "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.689503069213877*^9, 3.689503199634357*^9}},
 CellLabel->
  "In[1704]:=",ExpressionUUID->"226551b6-292e-4a79-aefd-629975360dbe"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.68950316387131*^9, 
  3.689503164860107*^9}},ExpressionUUID->"0ad23a5a-2535-4e42-8a07-\
df266db7410f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"OrigamiSampleGraphics2D", ",", 
         RowBox[{"OrigamiSampleGraphics2D", "//", "ReverseFillStyle"}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"OrigamiSampleGraphics3D", ",", 
         RowBox[{"OrigamiSampleGraphics3D", "//", "ReverseFillStyle"}]}], 
        "}"}]}], "\[IndentingNewLine]", "}"}], "/.", 
     RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "ShowExample"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.689503214795125*^9, 3.689503275044508*^9}},
 CellLabel->
  "In[1705]:=",ExpressionUUID->"0a3024e0-6827-4e51-8ab6-a22ba93ac607"]
