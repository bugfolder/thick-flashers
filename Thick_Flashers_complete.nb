Cell[CellGroupData[{

Cell["Fold angle constraints", "Subsection",
 CellChangeTimes->{{3.702581466949069*^9, 3.702581481276614*^9}, 
   3.7026631206215553`*^9},ExpressionUUID->"eb1a337e-82ec-458f-a475-\
a0f043767b65"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.702581611045897*^9, 
  3.702581611533719*^9}},ExpressionUUID->"13d7a13d-8864-4fd1-ae82-\
1957e878f909"],

Cell["\<\
A drawback of the truss model is that there is no checking for \
self-intersection, and, in particular, the paper can pass through itself. \
Detecting non-local self-intersections is pretty hard, but we can add \
constraints on individual folds that prevent local self-intersection, e.g., a \
valley fold that passes through itself (thereby creating a mountain fold via \
wrap-around).\
\>", "Text",
 CellChangeTimes->{{3.702581615029942*^9, 
  3.7025817166552353`*^9}},ExpressionUUID->"45342e83-1211-4bc8-8a07-\
191572815d24"],

Cell["\<\
These constraints are only used internally, so for efficiency, they take the \
vertex list as a separate argument, rather than returning a function, as \
above.\
\>", "Text",
 CellChangeTimes->{{3.7026683798507543`*^9, 
  3.7026684369001923`*^9}},ExpressionUUID->"82af6334-bf1d-4bed-be2d-\
8c05bb7bdf29"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "InteriorEdgeVertexNeighborhoods[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.701268149128457*^9, 3.7012681750278463`*^9}, {
   3.701268360289169*^9, 3.701268361114588*^9}, {3.702657185376713*^9, 
   3.702657220334834*^9}, 
   3.702662207142804*^9},ExpressionUUID->"e053ac56-b674-4c35-ab07-\
568456de4255"],

Cell[TextData[{
 "InteriorEdgeVertexNeighborhoods[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of information that describes the vertex neighborhood of \
each edge.\n\nvertex indices of quadrilaterals that straddle each interior \
edge of a TPlaneGraph. Its entries are of the form {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i4",
  FontSlant->"Italic"],
 "}, where {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i3",
  FontSlant->"Italic"],
 "} is the edge, ",
 StyleBox["i2",
  FontSlant->"Italic"],
 " is the index of another vertex of the face on one side of the edge, and ",
 StyleBox["i4",
  FontSlant->"Italic"],
 " is the index of a vertex of the face on the other side of the edge."
}], "Text",
 CellChangeTimes->{{3.701268158255435*^9, 3.7012682138568892`*^9}, {
   3.70126829675353*^9, 3.701268321138443*^9}, {3.70126837250608*^9, 
   3.701268467541622*^9}, {3.701268497731513*^9, 3.701268505604916*^9}, 
   3.70265719320172*^9, {3.702657224257897*^9, 3.702657246552146*^9}, 
   3.702662207169682*^9},ExpressionUUID->"9327bc49-cb96-43eb-930c-\
45198e72a4c3"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TPlaneGraph."
}], "Text",
 CellChangeTimes->{{3.702657262167612*^9, 
  3.702657271095482*^9}},ExpressionUUID->"99484a9e-800a-4035-bf93-\
08d8ee8084c5"],

Cell[TextData[{
 "Returns: a list of entries, one for each edge, in the same order as ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "[Edges]. For each boundary edge, the entry is an empty list. For each \
interior edge, the entry is a list {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f2",
  FontSlant->"Italic"],
 "}, where:\n\t",
 StyleBox["i1",
  FontSlant->"Italic"],
 " is a vertex at one end of the edge\n\t",
 StyleBox["f1",
  FontSlant->"Italic"],
 " is a list of the vertices of the face on the right\n\t",
 StyleBox["i2",
  FontSlant->"Italic"],
 " is the vertex at the other end of the edge\n\t",
 StyleBox["f2",
  FontSlant->"Italic"],
 " is a list of the vertices of the face on the left."
}], "Text",
 CellChangeTimes->{{3.702657273647723*^9, 3.702657333344067*^9}, {
  3.702657433144797*^9, 3.7026575194256167`*^9}, {3.702657552283077*^9, 
  3.7026576237947197`*^9}, {3.702662159484522*^9, 
  3.7026621599143047`*^9}},ExpressionUUID->"b05a35ea-e42c-44fe-902a-\
5703290950d3"],

Cell["\<\
These are used to constraint mountain/valley angle constraints in strained TQ \
meshes.\
\>", "Text",
 CellChangeTimes->{{3.702662167289822*^9, 3.702662184970097*^9}, {
  3.70266221788201*^9, 
  3.702662221458745*^9}},ExpressionUUID->"ef33484d-0fc8-470e-9fe9-\
b2377e4420bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InteriorEdgeVertexNeighborhoods", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"edges", ",", "efi", ",", "faces", ",", "ieinfo"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "efi", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "EdgeFaceIncidence", ",", "Faces"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"efi", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]", 
           "0"}], "||", 
          RowBox[{
           RowBox[{"efi", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "\[Equal]", 
           "0"}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"edges", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"faces", "\[LeftDoubleBracket]", 
            RowBox[{"efi", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{"edges", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"faces", "\[LeftDoubleBracket]", 
            RowBox[{"efi", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.701268552965724*^9, 3.701268604470253*^9}, {
   3.701268699460328*^9, 3.701268708582039*^9}, {3.701268742367462*^9, 
   3.701268748335062*^9}, {3.701268785335424*^9, 3.701268797871176*^9}, {
   3.701268845782717*^9, 3.7012689546279697`*^9}, {3.701268989040102*^9, 
   3.701269065347307*^9}, {3.7012691828998337`*^9, 3.701269196026002*^9}, {
   3.701269295330519*^9, 3.7012693287464*^9}, {3.7012694172589283`*^9, 
   3.701269551875893*^9}, {3.701269609413885*^9, 3.701269612635705*^9}, {
   3.701269648100887*^9, 3.701269693438691*^9}, {3.701269813039852*^9, 
   3.701269868718664*^9}, {3.701269921938836*^9, 3.701269952703968*^9}, 
   3.70265765063127*^9, {3.702657711340452*^9, 3.7026577278622293`*^9}, {
   3.702658074265565*^9, 3.702658077313877*^9}, {3.702660849799798*^9, 
   3.702661006704627*^9}, {3.702661049443687*^9, 3.70266110092142*^9}, {
   3.702661133019664*^9, 3.702661161674449*^9}, 3.702662207187869*^9},
 CellLabel->
  "In[2634]:=",ExpressionUUID->"ecaf0ea7-af1b-4541-9c88-bfece74f2c9a"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.591978218453109*^9, 3.591978223855441*^9}, {
  3.592790818529162*^9, 3.592790818742697*^9}, {3.701268531764668*^9, 
  3.7012685491706543`*^9}},ExpressionUUID->"de778e35-2657-4978-9f91-\
76b90fc02fb1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "faces", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"1", "/", 
           SqrtBox["3"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           SqrtBox["3"]}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4", ",", "5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "8", ",", "9", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], "//", 
       "RebuildPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", "tobj", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"InteriorEdgeVertexNeighborhoods", "[", "tobj", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.484778479752207*^9, 3.484778765342606*^9}, {
   3.484779119192333*^9, 3.484779120860991*^9}, {3.484832614869236*^9, 
   3.4848326149258738`*^9}, {3.484928180321309*^9, 3.48492818110406*^9}, 
   3.533505179154046*^9, {3.533505405413027*^9, 3.533505407958847*^9}, {
   3.591728946872057*^9, 3.591729061946227*^9}, 3.591737011649512*^9, 
   3.59203996156065*^9, {3.59204955550389*^9, 3.592049565577346*^9}, 
   3.5922085063943777`*^9, 3.592344303754323*^9, 3.592345817185869*^9, 
   3.5923521415056667`*^9, {3.5923766762707233`*^9, 3.592376684751494*^9}, 
   3.592432865704179*^9, {3.592435856059639*^9, 3.59243585625252*^9}, 
   3.592647646712911*^9, {3.592790916468617*^9, 3.592790950763648*^9}, 
   3.592791268158547*^9, {3.594727241528916*^9, 3.594727247992619*^9}, 
   3.594734254879321*^9, 3.594734339951556*^9, 3.59520024621437*^9, {
   3.595271068335042*^9, 3.595271243992586*^9}, {3.595271280109735*^9, 
   3.595271305692822*^9}, {3.59527147450243*^9, 3.5952715912467613`*^9}, {
   3.595271623469436*^9, 3.5952717025141697`*^9}, {3.595271763637871*^9, 
