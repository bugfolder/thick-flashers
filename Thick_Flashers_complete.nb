Cell[BoxData[
 RowBox[{
  RowBox[{"NSurfaceNormalFromSurface", "[", 
   RowBox[{
    RowBox[{"ss_Function", "|", "ss_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", "v1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"so", ",", "u", ",", "v", ",", "su", ",", "sv", ",", "uu"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"so", "=", 
      RowBox[{
       RowBox[{"SurfaceOrientation", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NSurfaceNormalFromSurface", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"su", "=", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"ss", "[", 
         RowBox[{"u", ",", "v"}], "]"}], ",", "u"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sv", "=", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"ss", "[", 
         RowBox[{"u", ",", "v"}], "]"}], ",", "v"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"su", "\[Cross]", "sv"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"so", " ", 
       RowBox[{"uu", "/", 
        RowBox[{"Mag", "[", "uu", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"FunctionInterpolationAlt", "[", 
      RowBox[{"uu", ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "u0", ",", "u1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "v0", ",", "v1"}], "}"}], ",", 
       RowBox[{"Sequence", "@@", 
        RowBox[{"FilterRules", "[", 
         RowBox[{"opts", ",", 
          RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}],
       "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.67206163460301*^9, 3.672061634605708*^9}, {
   3.6720616651615*^9, 3.672061673880254*^9}, {3.672061758892337*^9, 
