Cell[BoxData[
 RowBox[{
  RowBox[{"WindingNumber", "[", 
   RowBox[{"verts_List", ",", " ", "face_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sverts", ",", "absangles", ",", "relangles"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "face", "]"}], "<", "3"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"WindingNumber", "::", "ftooshort"}], ",", "face"}], "]"}], 
        ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RotateLeft", "[", "face", "]"}], "-", "face"}], ",", "0"}],
         "]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"WindingNumber", "::", "badface"}], ",", "face"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"WindingNumber", "[", 
      RowBox[{
      "verts", "\[LeftDoubleBracket]", "face", "\[RightDoubleBracket]"}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.458174592871118*^9, 3.458174606141253*^9}, {
   3.458213638517716*^9, 3.458213759335387*^9}, {3.458213799911519*^9, 
