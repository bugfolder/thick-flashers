  FontSlant->"Italic"],
 "}, ",
 StyleBox["normal",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a description of a cone consisting of a ring of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " around its base and its vertex ",
 StyleBox["vrtx",
  FontSlant->"Italic"],
 ", and returns a new list {",
 StyleBox["vrtx1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pts1",
  FontSlant->"Italic"],
 "} that defines a slice of this cone through a plane perpendicular to the \
unit vector ",
 StyleBox["normal",
  FontSlant->"Italic"],
 ". The default position of the slice is chosen so that the plane slices the \
entire cone and contains the \"farthest\" vertex of the ring, but the plane \
can be moved closer to the vertex by reducing the value ConeReduction in the \
options."
}], "Text",
 CellChangeTimes->{
  3.5921558341598787`*^9, {3.59215629734481*^9, 
   3.592156298214403*^9}},ExpressionUUID->"227b49ab-e92a-4b75-9e1c-\
86a11d0ebdd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConeReduction", "::", "usage"}], 
   "=", "\"\<ConeReduction is an option to SliceCone that specifies the \
relative distance of the slice plane from the tip.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592156247297205*^9, 3.592156288730157*^9}},
 CellLabel->
  "In[2592]:=",ExpressionUUID->"f37aae88-6e77-409c-b962-162d59936d4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SliceCone", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"ConeReduction", "\[Rule]", "1"}], "\[IndentingNewLine]", "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{3.592155834181666*^9},
 CellLabel->
  "In[2593]:=",ExpressionUUID->"b6e4fb0d-df4e-471a-a08c-ed875313b27b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SliceCone", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vrtx_", ",", " ", "pts_"}], "}"}], ",", " ", "nr_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "re", ",", "dd", ",", "pavg", ",", "rr1", ",", "dd1", ",", "r", ",", 
      "pts1", ",", "vrtx1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"re", "=", 
      RowBox[{
       RowBox[{"ConeReduction", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SliceCone", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"#", "-", "vrtx"}], "]"}], "&"}], "/@", "pts"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pavg", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Plus", "@@", "pts"}], ")"}], "/", 
       RowBox[{"Length", "[", "pts", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rr1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", "vrtx"}], ")"}], 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"pavg", "-", "vrtx"}], ")"}], ".", "nr"}], " "}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "-", "vrtx"}], ")"}], ".", "nr"}]]}], "&"}], "/@", 
       "pts"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd1", "=", 
      RowBox[{"Mag", "/@", "rr1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"re", " ", "*", " ", 
       RowBox[{"Min", "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"dd", "/", "dd1"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"vrtx", "+", 
         RowBox[{"r", " ", "#"}]}], "&"}], "/@", "rr1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pavg", "=", 
      RowBox[{"vrtx", "+", 
       RowBox[{"r", 
        RowBox[{"(", 
         RowBox[{"pavg", "-", "vrtx"}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vrtx1", "=", 
      RowBox[{"vrtx", "-", 
       RowBox[{"2", "nr", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"vrtx", "-", "pavg"}], ")"}], ".", "nr"}], ")"}]}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"vrtx1", ",", " ", "pts1"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.59215583421615*^9},
 CellLabel->
  "In[2594]:=",ExpressionUUID->"6d06e836-71ee-4595-87ee-cbc6dd025bfe"],

Cell["\<\
Example. We\[CloseCurlyQuote]ll show the heavy slice line and the position of \
the point and folds if it were inverted.\
\>", "Text",
 CellChangeTimes->{{3.592156360363927*^9, 
  3.5921563819931083`*^9}},ExpressionUUID->"50f1caf3-f557-4d68-a8ea-\
71404c68faa8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobj", ",", "verts3d", ",", "pts", ",", "vrtx", ",", "pts1", ",", 
      "vrtx1", ",", 
      RowBox[{"\[Gamma]", "=", 
       RowBox[{
        RowBox[{"-", "10"}], "\[Degree]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSimpleFlutedCone", "[", 
       RowBox[{"8", ",", 
        RowBox[{"30", "\[Degree]"}], ",", 
        RowBox[{"ConePhaseShift", "\[Rule]", "0"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices3D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vrtx", "=", 
      RowBox[{"verts3d", "\[LeftDoubleBracket]", 
       RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{"verts3d", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vrtx1", ",", "pts1"}], "}"}], "=", 
      RowBox[{"SliceCone", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vrtx", ",", "pts"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Gamma]", "]"}], ",", "0", ",", 
          RowBox[{"Cos", "[", "\[Gamma]", "]"}]}], "}"}], ",", 
        RowBox[{"ConeReduction", "\[Rule]", "0.9"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"EdgeForm", "[", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Polygon", "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"pts", ",", 
             RowBox[{"RotateLeft", "[", "pts", "]"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{"vrtx", ",", 
               RowBox[{"{", 
                RowBox[{"Length", "[", "pts", "]"}], "}"}]}], "]"}]}], "}"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "Red", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"vrtx", ",", "#"}], "}"}], "]"}], "&"}], "/@", "pts"}], ",",
          "\[IndentingNewLine]", "Blue", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"vrtx1", ",", "#"}], "}"}], "]"}], "&"}], "/@", "pts1"}],
          ",", "\[IndentingNewLine]", "Black", ",", 
         RowBox[{"Line", "[", "pts", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Green", ",", 
         RowBox[{"Point", "/@", "pts1"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Black", ",", 
         RowBox[{"Point", "[", "vrtx1", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AbsoluteThickness", "[", "5", "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"pts1", ",", 
            RowBox[{
            "pts1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "]"}], "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{
  3.537202446253003*^9, 3.592154288806526*^9, 3.592154347334064*^9, 
   3.592155187408967*^9, 3.592155834252516*^9, 3.592156232144506*^9, {
   3.59215632711514*^9, 3.592156329926287*^9}, {3.592156391696126*^9, 
   3.592156395344379*^9}, 3.592670439329241*^9, 3.592670634535091*^9, 
   3.592671073828168*^9, 3.592829339780661*^9, {3.593039726360454*^9, 
   3.593039754188939*^9}, 3.615247456641076*^9, 3.615249125749775*^9, {
   3.6152492266282*^9, 3.615249367520049*^9}, {3.615285516628356*^9, 
   3.615285517760984*^9}},
 CellLabel->
  "In[2595]:=",ExpressionUUID->"f21343f5-d230-4383-9d56-1f6fa71d2936"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeMultiSlicedCone[{",
 StyleBox["vrtx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pts",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ConeSlicePlanes, ",
 "ConeReductions, Options[Graphics], Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{{3.592156439920073*^9, 3.592156455958895*^9}, {
  3.593039776604475*^9, 
  3.593039784050396*^9}},ExpressionUUID->"73906549-a288-45a2-8575-\
eb8e128d5cc8"],

Cell[TextData[{
 "MakeMultiSlicedCone[{",
 StyleBox["vrtx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pts",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a generalized cone specified by its vertex ",
 StyleBox["vrtx",
  FontSlant->"Italic"],
 " and an intial ring of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " and slices it ",
 StyleBox["n",
  FontSlant->"Italic"],
 " times, reflecting each slice according to the specified options. It \
returns a TGraph3D+TAssigned.\nOptions are:\n\tConeSlicePlanes\[Rule]",
 StyleBox["v",
  FontSlant->"Italic"],
 " | ",
 StyleBox["vlist",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["v",
  FontSlant->"Italic"],
 " is a vector normal to a single slicing plane that is used over and over, \
or ",
 StyleBox["vlist",
  FontSlant->"Italic"],
 " is a list of ",
 StyleBox["n",
  FontSlant->"Italic"],
 " individual slicing plane normals.\n\tConeReductions\[Rule]",
 StyleBox["r",
  FontSlant->"Italic"],
 " | ",
 StyleBox["rlist",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is a reduction factor used for all slices or ",
 StyleBox["rlist",
  FontSlant->"Italic"],
 " is a list of ",
 StyleBox["n",
  FontSlant->"Italic"],
 " reduction factors for each slicing plane."
}], "Text",
 CellChangeTimes->{{3.53720283134793*^9, 3.537202833675988*^9}, {
   3.592156439996694*^9, 3.5921564560411463`*^9}, {3.592156550790443*^9, 
   3.592156562709339*^9}, 3.5924357596171083`*^9, {3.592439569915525*^9, 
   3.592439572531503*^9}, {3.5924396475986643`*^9, 3.59243965846032*^9}, {
   3.592467164582601*^9, 3.5924671673896513`*^9}, 3.5926554196099243`*^9, 
   3.59282898677377*^9, 3.59474129880603*^9, 3.595018024123676*^9, {
   3.615249408088085*^9, 
   3.615249412067951*^9}},ExpressionUUID->"bdeb1310-777b-4cf3-bf67-\
fa15db08af63"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConeSlicePlanes", "::", "usage"}], " ", "=", 
   " ", "\"\<ConeSlicePlanes is an option to MakeMultiSlicedCone that \
specifies a vector or list of vectors to slice the cone.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592156474413838*^9, 3.592156500939161*^9}},
 CellLabel->
  "In[2596]:=",ExpressionUUID->"3cb51737-de2f-4048-a384-903161175151"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConeReductions", "::", "usage"}], 
   "=", "\"\<ConeReductions is an option to MakeMultiSlicedCone that \
specifies the relative reduction from one slice to the next.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.5921565105087137`*^9, 3.592156541124996*^9}},
 CellLabel->
  "In[2597]:=",ExpressionUUID->"ce4cc94a-e28a-49f4-a775-801c9f3667af"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeMultiSlicedCone", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ConeSlicePlanes", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"ConeReductions", "\[Rule]", "0.9"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.592156439750448*^9, 3.592156455780291*^9}},
 CellLabel->
  "In[2598]:=",ExpressionUUID->"17d4ab88-67c8-4c51-9bc8-43e919518db7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeMultiSlicedCone", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vrtx_", ",", "pts_"}], "}"}], ",", "n_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sp", ",", "re", ",", "mm", ",", "mmod", ",", "verts", ",", "edges", ",",
       "verts3d", ",", "types", ",", "v", ",", "p", ",", "ps", ",", "wa", ",",
       "uu", ",", "pp", ",", "vi"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ConeSlicePlanes", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeMultiSlicedCone", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"re", "=", 
      RowBox[{
       RowBox[{"ConeReductions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeMultiSlicedCone", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "sp", "]"}], "]"}], "\[Equal]", "2"}], 
         " ", ")"}]}], ",", 
       RowBox[{"sp", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"sp", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Head", "[", "re", "]"}], "===", "List"}], ")"}]}], ",", 
       RowBox[{"re", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"re", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mm", "=", 
      RowBox[{"Length", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mmod", "=", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{"#", ",", "mm", ",", "1"}], "]"}], "&"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"for", " ", "wrap"}], "-", 
       RowBox[{"around", " ", "indexing"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"3", "D", " ", "POINTS"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"v", "[", "0", "]"}], "=", "vrtx"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{
       RowBox[{"p", "[", "0", "]"}], "=", "pts"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"v", "[", "i", "]"}], ",", 
           RowBox[{"p", "[", "i", "]"}]}], "}"}], "=", 
         RowBox[{"SliceCone", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"v", "[", 
              RowBox[{"i", "-", "1"}], "]"}], ",", 
             RowBox[{"p", "[", 
              RowBox[{"i", "-", "1"}], "]"}]}], "}"}], ",", 
           RowBox[{
           "sp", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{"ConeReduction", "\[Rule]", 
            RowBox[{
            "re", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], 
          "]"}]}], ";", 
        RowBox[{"JoinTo", "[", 
         RowBox[{"verts3d", ",", 
          RowBox[{"p", "[", "i", "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"verts3d", ",", 
       RowBox[{"v", "[", "n", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"2", "D", " ", "POINTS"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ps", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "[", "0", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{
         RowBox[{"p", "[", "0", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wa", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ArcCos", "[", 
          FractionBox[
           RowBox[{"#1", ".", "#2"}], 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#1", ".", "#1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"#2", ".", "#2"}], ")"}]}]]], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "-", "vrtx"}], "&"}], "/@", 
           RowBox[{"p", "[", "0", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "-", "vrtx"}], "&"}], "/@", 
           RowBox[{"RotateLeft", "[", 
            RowBox[{"p", "[", "0", "]"}], "]"}]}]}], "}"}], ",", "1"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"angles", " ", "between", " ", "wedges"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"FoldList", "[", 
          RowBox[{"Plus", ",", "ps", ",", "wa"}], "]"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"unit", " ", "vectors", " ", "of", " ", "cp"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"pp", "[", "i", "]"}], "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Times", ",", 
           RowBox[{"{", 
            RowBox[{"uu", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Mag", "[", 
                RowBox[{"#", "-", 
                 RowBox[{"v", "[", "i", "]"}]}], "]"}], "&"}], "/@", 
              RowBox[{"p", "[", "i", "]"}]}]}], "}"}], ",", "1"}], "]"}]}], ";", 
        RowBox[{"JoinTo", "[", 
         RowBox[{"verts", ",", 
          RowBox[{"pp", "[", "i", "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"verts", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vi", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"1", "+", 
       RowBox[{"mm", " ", "i"}], "+", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "\[NotEqual]", 
          RowBox[{"n", "+", "1"}]}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"j", "-", "1"}], ",", "mm"}], "]"}], ",", "0"}], "]"}]}]}],
      ";", 
     RowBox[{"(*", " ", 
      RowBox[{"maps", " ", 
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}], " ", "to", " ", "index", " ", "into", 
       " ", "verts", " ", "or", " ", "verts3d"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vi", "[", 
               RowBox[{"i", ",", "j"}], "]"}], ",", 
              RowBox[{"vi", "[", 
               RowBox[{"i", ",", 
                RowBox[{"j", "+", "1"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "mm"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vi", "[", 
               RowBox[{"i", ",", "j"}], "]"}], ",", 
              RowBox[{"vi", "[", 
               RowBox[{
                RowBox[{"i", "+", "1"}], ",", "j"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "mm"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", "\[Equal]", "0"}], ",", "B", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"OddQ", "[", "i", "]"}], ",", "M", ",", "V"}], 
               "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "mm"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"EvenQ", "[", 
               RowBox[{"i", "+", "j"}], "]"}], ",", "M", ",", "V"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "mm"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"MakeTPlaneGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", 
       RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}], "//", 
      RowBox[{"AddTAssigned", "[", "types", "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
