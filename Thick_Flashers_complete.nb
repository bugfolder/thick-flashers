Cell[CellGroupData[{

Cell["Local flat-foldability", "Section",
 CellChangeTimes->{{3.594128258984576*^9, 3.594128276181081*^9}, {
   3.594128365606972*^9, 3.594128365911778*^9}, 3.594300858431489*^9, 
   3.594300939824074*^9},ExpressionUUID->"be03ac7d-f89b-4756-aedd-\
a71c8640069d"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.594300948922516*^9, 
  3.594300949287854*^9}},ExpressionUUID->"edae8309-b091-4708-9a2c-\
5ce53921eff1"],

Cell["\<\
Local flat-foldability has to do whether two facets have crease assignments \
that force them to intersect with one another\[CloseCurlyQuote]s fold. This \
section contains functions that probe this.\
\>", "Text",
 CellChangeTimes->{{3.594128278557146*^9, 3.594128300491399*^9}, {
