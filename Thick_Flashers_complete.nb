       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Random", "[", "]"}], ",", 
          RowBox[{".5", "-", 
           RowBox[{"Random", "[", "]"}]}]}], "}"}], ",", 
        RowBox[{"{", "40", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"halfplane", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", ".5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
