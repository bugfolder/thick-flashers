       RowBox[{"h", ",", "#"}], "]"}], "//", "MatrixForm"}], ")"}], "&"}], "/@", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.595528059507421*^9, 3.5955281241244507`*^9}, 
