           "as"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "Hold"}], ";"}]], "Input",
