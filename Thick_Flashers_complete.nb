Cell[BoxData[
 RowBox[{
  RowBox[{"StyledRuledPatchSequence", "[", 
   RowBox[{"clist_List", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nu", ",", "tls", ",", "rls", ",", "nc", ",", "cs", ",", "rs", ",", "u", 
      ",", "v"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nu", "=", 
      RowBox[{
       RowBox[{"CurveDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatchSequence", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tls", "=", 
      RowBox[{
       RowBox[{"TransverseLineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatchSequence", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rls", "=", 
      RowBox[{
       RowBox[{"RulingLineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatchSequence", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nc", "=", 
      RowBox[{"Length", "[", "clist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"rs", "=", 
           RowBox[{"Switch", "[", 
            RowBox[{
             RowBox[{"Length", "[", "rls", "]"}], ",", "\[IndentingNewLine]", 
             "0", ",", "rls", ",", "\[IndentingNewLine]", "1", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Head", "[", 
                 RowBox[{
                 "rls", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "]"}], "===", "List"}], ",", 
               RowBox[{"rls", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "rls", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"nc", "-", "1"}], ",", 
             RowBox[{
             "rls", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
              "\[IndentingNewLine]", "_", ",", 
             RowBox[{
              RowBox[{"Message", "[", 
               RowBox[{
                RowBox[{"StyledRuledPatchSequence", "::", "badruling"}], ",", 
                "rls"}], "]"}], ";", 
              RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"StyledRuledPatch", "[", 
           RowBox[{
            RowBox[{"Functionize", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"u", ",", "v"}], "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", "v", ")"}], 
                RowBox[{
                 RowBox[{
                 "clist", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}], "[", "u", "]"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "v"}], ")"}], 
                RowBox[{
                 RowBox[{"clist", "\[LeftDoubleBracket]", 
                  RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "[", 
                 "u", "]"}]}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"RulingLineStyle", "\[Rule]", "rs"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"EndLineStyle", "\[Rule]", "None"}], ",", "opts"}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"nc", "-", "1"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"cs", "=", 
           RowBox[{"Switch", "[", 
            RowBox[{
             RowBox[{"Length", "[", "tls", "]"}], ",", "\[IndentingNewLine]", 
             "0", ",", "tls", ",", "\[IndentingNewLine]", "1", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Head", "[", 
                 RowBox[{
                 "tls", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "]"}], "===", "List"}], ",", 
               RowBox[{"tls", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "tls", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Length", "[", "clist", "]"}], ",", 
             RowBox[{
             "tls", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
              "\[IndentingNewLine]", "_", ",", 
             RowBox[{
              RowBox[{"Message", "[", 
               RowBox[{
                RowBox[{"StyledRuledPatchSequence", "::", "badxvrs"}], ",", 
                "tls"}], "]"}], ";", 
              RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"StyledCurve", "[", 
           RowBox[{
            RowBox[{
            "clist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"CurveDivisions", "\[Rule]", "nu"}], ",", 
            RowBox[{"LineStyle", "\[Rule]", "cs"}], ",", "opts"}], "]"}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nc"}], "}"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.693959991995409*^9, 3.693960014231138*^9}, {
   3.693960346986074*^9, 3.693960361620034*^9}, {3.693960430940302*^9, 
   3.693960584820801*^9}, {3.693960653510247*^9, 3.693960729377675*^9}, {
   3.693960767655614*^9, 3.693960849688437*^9}, {3.693961248186829*^9, 
   3.6939613360356693`*^9}, {3.694001405014543*^9, 3.694001454871178*^9}, {
   3.69400155035791*^9, 3.694001605142999*^9}, {3.694001765337569*^9, 
   3.694001797456305*^9}, {3.694001834048511*^9, 3.694001996952289*^9}, 
   3.694002552297369*^9, {3.694003067999811*^9, 3.694003094614768*^9}, 
   3.694007283109329*^9, {3.694007977083788*^9, 3.694007977955624*^9}, 
   3.694008663163658*^9, {3.694008849571446*^9, 3.694008948196692*^9}, {
   3.694011099581484*^9, 3.694011101683814*^9}, 3.798622844258373*^9, {
   3.800013997028026*^9, 3.80001402143683*^9}, {3.802095053583139*^9, 
