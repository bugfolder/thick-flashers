   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"HatRotationMatrix3DDenominator", "[", 
       RowBox[{"h", ",", "#"}], "]"}], "//", "MatrixForm"}], ")"}], "&"}], "/@", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.595528059507421*^9, 3.5955281241244507`*^9}, 
   3.5955285599692907`*^9, 3.59552859604681*^9, 3.595529205370015*^9, 
