Cell[CellGroupData[{

Cell["Regular 7-star", "Subsubsection",
 CellChangeTimes->{{3.462926955991117*^9, 
  3.4629269594462557`*^9}},ExpressionUUID->"b876e828-6e97-4c4c-b268-\
a12bf76d54e5"],

Cell["\<\
This example shows the progressive construction of a regular 7-star from a \
chord star graph.\
\>", "Text",
 CellChangeTimes->{{3.462927012539743*^9, 
  3.4629270310820107`*^9}},ExpressionUUID->"85cb9f3f-4e59-46cd-9761-\
f3eccac2d7d9"],

Cell["\<\
Display with generic folded form because of irreconcilable overlaps.\
\>", "Text",
 CellChangeTimes->{{3.635371940324609*^9, 
  3.635371954045442*^9}},ExpressionUUID->"784a6eb7-89fc-4aa0-b94f-\
7f5528507912"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobjcsg", ",", "tobjw"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Make", " ", "a", " ", "chord", " ", "star", " ", "graph"}], " ",
      "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobjcsg", "=", 
      RowBox[{"MakeChordStarGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Degree]"}], ",", "0.15"}], "}"}], "}"}], ",", 
        "7"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", "tobjcsg", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "plot", " ", "the", " ", "inset", " ", "separation", " ", "to", " ", 
       "find", " ", "an", " ", "aesthetically", " ", "pleasing", " ", "strip",
        " ", "width"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"InsetSeparationPlot", "[", 
       RowBox[{"tobjcsg", ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "0.04"}], "}"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "the", " ", "new", " ", "woven", " ", "tessellation"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjw", "=", 
      RowBox[{"MakeSimpleWovenTessellationOld", "[", 
       RowBox[{"tobjcsg", ",", "0.03", ",", 
        RowBox[{"WovenParity", "\[Rule]", 
         RowBox[{"-", "1"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Turn", " ", "over", " ", "the", " ", "folded", " ", "form"}], 
       ",", " ", 
       RowBox[{"i", ".", "e", "."}], ",", " ", 
       RowBox[{
       "invert", " ", "the", " ", "crease", " ", "assignment", " ", "and", " ",
         "flop", " ", "the", " ", 
        RowBox[{"image", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobjw", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"GenericFoldedFormGraphics", "[", 
          RowBox[{
           RowBox[{"FlopGraph2D", "[", "tobjw", "]"}], ",", 
           RowBox[{"FaceupFace", "\[Rule]", 
            RowBox[{"Length", "[", 
             RowBox[{"GetValue", "[", 
              RowBox[{"tobjw", ",", "Faces"}], "]"}], "]"}]}]}], "]"}]}], 
