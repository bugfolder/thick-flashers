Cell[CellGroupData[{

Cell[TextData[{
 "SplitSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TSplitGraph2D"
}], "Subsubsection",
 CellChangeTimes->{{3.706795861850968*^9, 
  3.706795888323155*^9}},ExpressionUUID->"1a65305b-9a8c-40bc-b49a-\
544e8b627503"],

Cell[TextData[{
 "SplitSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TSplitGraph2D and splits edges and faces according to the \
SplitInfo property."
}], "Text",
 CellChangeTimes->{{3.70679587832384*^9, 3.70679588425933*^9}, {
  3.7067959277243237`*^9, 
  3.7067959532120447`*^9}},ExpressionUUID->"a8211c31-80eb-47f7-8621-\
1912907043ee"],

Cell["\<\
Returns: a new TGraph2D of the split graph. If the input was a TPlaneGraph2D, \
then we will regenerate TPlaneGraph2D data (so Faces may be different, even \
for unaffected faces). Note that the returned object is no longer a \
TSplitGraph2D.\
\>", "Text",
 CellChangeTimes->{{3.706798307713748*^9, 3.706798320921613*^9}, {
  3.706798355537864*^9, 3.7067983945382357`*^9}, {3.70679864814235*^9, 
  3.70679866310116*^9}, {3.706818574328042*^9, 
  3.7068185972541*^9}},ExpressionUUID->"09d9d149-a600-4bd6-bdf6-9bff66271790"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitSplitGraph2D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "verts2d", ",", "sinfo", ",", 
      "vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo", ",", "j", ",", 
      "t", ",", "i1", ",", "i2", ",", "p1", ",", "p2", ",", "evi", ",", 
      "tobj1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TSplitGraph2D", ",", "SplitSplitGraph2D"}], "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "faces", ",", "verts2d", ",", "sinfo"}], 
       "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "Faces", ",", "Vertices2D", ",", 
          "SplitInfo"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo"}], "}"}],
       "=", "sinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"split", " ", "edges"}], ",", " ", 
       RowBox[{
       "creating", " ", "new", " ", "vertices", " ", "and", " ", "append", " ",
         "the", " ", "new", " ", "vertex", " ", "index", " ", "and", " ", 
        "new", " ", "edge", " ", "index", " ", "to", " ", "the", " ", 
        "entries", " ", "in", " ", "esinfo"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"j", ",", "t"}], "}"}], "=", 
         RowBox[{
         "esinfo", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i1", ",", "i2"}], "}"}], "=", 
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2"}], "}"}], "=", 
         RowBox[{"verts", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"i1", ",", "i2"}], "}"}], "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"verts", ",", 
          RowBox[{"p1", "+", 
           RowBox[{"t", 
            RowBox[{"(", 
             RowBox[{"p2", "-", "p1"}], ")"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2"}], "}"}], "=", 
         RowBox[{"verts2d", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"i1", ",", "i2"}], "}"}], "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"verts2d", ",", 
          RowBox[{"p1", "+", 
           RowBox[{"t", 
            RowBox[{"(", 
             RowBox[{"p2", "-", "p1"}], ")"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "=", 
         RowBox[{
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "/.", 
          RowBox[{"i2", "\[Rule]", 
           RowBox[{"Length", "[", "verts", "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Length", "[", "verts", "]"}], ",", "i2"}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"evi", "[", "j", "]"}], "=", 
         RowBox[{"Length", "[", "verts", "]"}]}]}], 
       RowBox[{"(*", " ", 
        RowBox[{
        "lookup", " ", "from", " ", "edge", " ", "index", " ", "to", " ", 
         "its", " ", "new", " ", "vertex"}], " ", "*)"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "esinfo", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "add", " ", "new", " ", "edges", " ", "that", " ", "split", " ", 
       "faces"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"i1", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]",
             "0"}], ",", 
           RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"evi", "[", 
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"i2", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "3", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]",
             "0"}], ",", 
           RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "3", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"evi", "[", 
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "3", ",", "2"}], "\[RightDoubleBracket]"}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{"i1", ",", "i2"}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
        ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "fsinfo", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"MakeTGraph2D", "[", 
       RowBox[{"verts", ",", "edges", ",", 
        RowBox[{"{", "}"}], ",", "verts2d"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", 
       RowBox[{"tobj1", "=", 
        RowBox[{"tobj1", "//", "AddTPlaneGraph"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "tobj1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.706796008000489*^9, 3.706796126109451*^9}, {
  3.706796612435833*^9, 3.706796851485914*^9}, {3.706796914766712*^9, 
  3.706797056215109*^9}, {3.706797117511625*^9, 3.706797125511878*^9}, {
  3.706797703559224*^9, 3.706798278259104*^9}, {3.7067984053877974`*^9, 
  3.706798407061339*^9}, {3.706798583943712*^9, 3.706798632507266*^9}},
 CellLabel->
  "In[1386]:=",ExpressionUUID->"1bbca122-cb4a-41e1-b68e-6aa28584ffba"],

