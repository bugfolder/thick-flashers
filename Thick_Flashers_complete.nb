          RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", 
          RowBox[{"150", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"-", "90"}], "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
