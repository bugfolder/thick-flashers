 CellChangeTimes->{{3.555768028729858*^9, 3.5557680352974377`*^9}, {
   3.719926339222028*^9, 3.71992634465239*^9}, 
   3.719934918564828*^9},ExpressionUUID->"027c95c8-c3cf-4971-ad35-\
165b49b7c28e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "pp", ",", 
