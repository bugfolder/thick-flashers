             RowBox[{"nw", ">", "1"}], ",", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"nw", "-", "1"}], ")"}]}], ",", "1"}], "]"}]}], 
          "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"a", " ", "single", " ", "wire"}], ",", " ", 
         RowBox[{
         "position", " ", "it", " ", "in", " ", "the", " ", "middle"}]}], " ",
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pw", "=", 
         RowBox[{"0.5", 
          RowBox[{"(", 
           RowBox[{"p1r", "+", "p2r"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"qw", "=", 
         RowBox[{"0.5", 
          RowBox[{"(", 
           RowBox[{"q1r", "+", "q2r"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"HingeRectWireGC", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"pw", ",", "qw"}], "}"}], ",", 
           RowBox[{"HingeWireZ", "->", "wz"}], ",", "opts"}], "]"}], 
         "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
