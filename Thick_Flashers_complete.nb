Cell[CellGroupData[{

Cell["Stacking", "Subsection",
 CellChangeTimes->{{3.720297582667761*^9, 
  3.720297584496532*^9}},ExpressionUUID->"6932bddc-42c2-46b8-97b8-\
9c90ccab0c97"],

Cell[CellGroupData[{

Cell[TextData[{
 "StackXGC[",
 StyleBox["objs",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.713828228046253*^9, 
  3.7138282344164*^9}},ExpressionUUID->"111242bb-4a69-4aee-838e-b79327e2cf58"],

Cell[TextData[{
 "StackXGC[",
 StyleBox["objs",
  FontSlant->"Italic"],
 "] takes a list of GraphicsComplex objects and stacks them in the \
x-direction so their bounding boxes are in contact."
}], "Text",
 CellChangeTimes->{{3.713828243362237*^9, 
  3.713828261921181*^9}},ExpressionUUID->"e00584d0-2c39-49b3-a285-\
d7e5a319c950"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StackXGC", "[", "objs_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xex", ",", "wids", ",", "objs1", ",", "offs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xex", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"BoundingBoxGC", "/@", "objs"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"x", "-", "extents"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"wids", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "-", 
         RowBox[{
         "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "&"}],
        "/@", "xex"}]}], ";", 
     RowBox[{"(*", " ", "widths", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"offs", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", "wids"}], "]"}]}], ";", 
     RowBox[{"(*", " ", "offsets", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "move", " ", "objects", " ", "to", " ", "all", " ", "start", " ", "at",
         " ", "x"}], "=", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FunctionTransform", "[", 
        RowBox[{
         RowBox[{
         "objs", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{
          RowBox[{"#", "+", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
