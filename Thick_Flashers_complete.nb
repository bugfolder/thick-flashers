Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TransverseLineStyle", "::", "usage"}], 
   "=", "\"\<TransverseLineStyle is an option to StyledRuledPatchSequence \
that specifies the style(s) to apply to the transverse lines that run \
transversely to the ruling lines.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.803404467817483*^9, 3.803404520842624*^9}},
 CellLabel->
  "In[1758]:=",ExpressionUUID->"b8b479ee-b003-4f23-a86c-d69f7e4834b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StyledRuledPatchSequence", "::", "badruling"}], 
   "=", "\"\<`1` is an invalid format for the RulingLineStyle option.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.689272201267986*^9, 3.689272246702151*^9}, 
   3.691407764494983*^9, {3.693959499918167*^9, 3.693959504197316*^9}, {
