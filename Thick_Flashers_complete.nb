   3.707905256268597*^9},ExpressionUUID->"38a5ac56-c6f3-44ac-a218-\
be63bd28c51e"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tglist",
  FontSlant->"Italic"],
 " \[LongDash] a list of TGraph2D+TAssigneds to be merged."
}], "Text",
 CellChangeTimes->{{3.707767526764463*^9, 3.70776754143788*^9}, {
   3.7077836651004486`*^9, 3.707783665693546*^9}, 
