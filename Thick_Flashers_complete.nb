Cell[TextData[{
 "IntervalSetCleanup[",
 StyleBox["is",
  FontSlant->"Italic"],
 "] removes any zero-length intervals from the set."
}], "Text",
 CellChangeTimes->{{3.628987540220063*^9, 
  3.628987567647496*^9}},ExpressionUUID->"7c55102a-0131-45c4-9ffe-\
051331af8ed2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntervalSetCleanup", "[", "is_", "]"}], ":=", 
  RowBox[{"Select", "[", 
   RowBox[{"is", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
        "]"}], "\[NotEqual]", "0"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.628987587436068*^9, 3.628987635214593*^9}},
 CellLabel->
  "In[540]:=",ExpressionUUID->"015ed53d-4df8-4c4f-9c4a-bc3c28815764"],

