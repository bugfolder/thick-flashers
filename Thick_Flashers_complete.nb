Cell[TextData[{
 "AbsoluteAngles[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["plist",
  FontSlant->"Italic"],
 "] gives the absolute angles from point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to to each of the points in ",
 StyleBox["plist",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.6770775570934367`*^9, 3.677077596940702*^9}, {
  3.778748987711408*^9, 
