   3.706831060020838*^9}},ExpressionUUID->"a96778b5-c1a6-40db-9b1f-\
7d9316fdb345"],

Cell["\<\
SingleVertexGraph3DAssigned returns a square containing a single degree-4 \
vertex in its center that contains a 3D partially folded form.\
\>", "Text",
 CellChangeTimes->{{3.595278082941935*^9, 3.595278158951273*^9}, 
   3.706827077627328*^9, {3.706831069294339*^9, 
   3.706831076740797*^9}},ExpressionUUID->"91394f48-27ad-4f63-81bf-\
8d1a915bb2fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SingleVertexGraph3DAssigned", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"SingleVertexGraph3DAssigned", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "faces", ",", "verts2d", ",", "verts3d", ",",
         "foldangles", ",", "types", ",", "tobj"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tobj", "=", 
        RowBox[{"SingleVertexGraph", "//", "RebuildPlaneGraph"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"verts3d", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], ",", "1", ",", 
             RowBox[{"-", 
              FractionBox[
               SqrtBox["3"], "2"]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], ",", 
             FractionBox["1", 
              SqrtBox["3"]], ",", 
             RowBox[{"-", 
              FractionBox[
               SqrtBox["3"], "2"]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              FractionBox["1", "8"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "5"}], "-", 
                SqrtBox["3"]}], ")"}]}], ",", 
             RowBox[{
              FractionBox["1", "52"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", 
                RowBox[{"29", " ", 
                 SqrtBox["3"]}]}], ")"}]}], ",", 
             RowBox[{
              RowBox[{"-", 
               FractionBox["9", "104"]}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "9"}], "+", 
                SqrtBox["3"]}], ")"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", 
               SqrtBox["3"]]}], ",", 
             RowBox[{
              FractionBox["2", "13"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", 
                RowBox[{"3", " ", 
                 SqrtBox["3"]}]}], ")"}]}], ",", 
             RowBox[{"Sin", "[", 
              RowBox[{"2", " ", 
               RowBox[{"ArcTan", "[", 
                RowBox[{"1", "+", 
                 FractionBox["2", 
                  SqrtBox["3"]]}], "]"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{
              FractionBox["2", "13"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", 
                RowBox[{"3", " ", 
                 SqrtBox["3"]}]}], ")"}]}], ",", 
             RowBox[{"Sin", "[", 
              RowBox[{"2", " ", 
               RowBox[{"ArcTan", "[", 
                RowBox[{"1", "+", 
                 FractionBox["2", 
                  SqrtBox["3"]]}], "]"}]}], "]"}]}], "}"}]}], "}"}], "//", 
         "N"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"foldangles", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"ArcTan", "[", 
             RowBox[{"1", "+", 
              FractionBox["2", 
               SqrtBox["3"]]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"-", "60"}], " ", "\[Degree]"}], ",", 
           RowBox[{"2", " ", 
            RowBox[{"ArcTan", "[", 
             RowBox[{"1", "+", 
              FractionBox["2", 
               SqrtBox["3"]]}], "]"}]}], ",", 
           RowBox[{"60", " ", "\[Degree]"}], ",", "0", ",", "0", ",", "0", ",",
            "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], "//", 
         "N"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"types", "=", 
        RowBox[{"{", 
         RowBox[{
         "V", ",", "M", ",", "V", ",", "V", ",", "B", ",", "B", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tobj", "//", 
         RowBox[{"AddTGraph3D", "[", 
          RowBox[{"verts3d", ",", "foldangles"}], "]"}]}], "//", 
        RowBox[{"AddTAssigned", "[", "types", "]"}]}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.595277810545285*^9, 3.595277938322707*^9}, {
   3.595279000893552*^9, 3.595279010912078*^9}, 3.706827081863113*^9, 
   3.706827126525547*^9, {3.706831056038189*^9, 3.706831181904113*^9}, 
   3.708400178081468*^9, 3.708603657171018*^9},
 CellLabel->
  "In[1985]:=",ExpressionUUID->"e87d3cc4-5aa4-43fc-9734-a84d14984522"],

