   3.630163497733265*^9}},ExpressionUUID->"42dda988-1e62-44b0-bb96-\
130f7894b1dd"],

Cell[TextData[{
 "{UnitQuadrilateralCenteredSplitTwistTile, {",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["side",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} represents an edge-centered split twist in a quadrilateral with corner \
angles ",
 StyleBox["angles",
  FontSlant->"Italic"],
 " and side length ",
 StyleBox["side",
  FontSlant->"Italic"],
 " on the ",
 StyleBox["is",
  FontSlant->"Italic"],
 "-th side of the polygon, where \n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of the pleat where it subtends the edge, \n\t\[Tau] is the \
pleat angle,\n\t",
 StyleBox["ip",
  FontSlant->"Italic"],
 " specifies the degree-6 vertex,\n\t",
 StyleBox["ctype",
  FontSlant->"Italic"],
 " is the type of the longest added crease,\n\t",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
