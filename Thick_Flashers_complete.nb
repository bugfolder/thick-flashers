Cell["\<\
Example; a single sector. Here you can see the small variations in panel \
thickness and the (unavoidable) triangularly trimmed panels where a vertex \
splits into multiple lines.\
\>", "Text",
 CellChangeTimes->{{3.911598389751522*^9, 3.91159839056161*^9}, {
  3.911646598533641*^9, 3.911646600709366*^9}, {3.913542802151312*^9, 
  3.913542846656726*^9}},ExpressionUUID->"33b01dc9-31c4-4ced-b898-\
28f1e9d818c1"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"k", "=", "0"}], ",", "lines"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lines", "=", 
     RowBox[{
      RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["p", 
         RowBox[{"i_", ",", "j_", ",", 
          RowBox[{"-", "1"}]}]], "->", 
        SubscriptBox["p", 
         RowBox[{"i", ",", "j", ",", 
          RowBox[{"m", "-", "1"}]}]]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "]"}], ",", 
             RowBox[{"Switch", "[", 
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               ",", "\"\<mj\>\"", ",", "Red", ",", "\"\<mn\>\"", ",", "Blue", 
               ",", "\"\<dg\>\"", ",", "Green"}], "]"}]}], "]"}], "&"}], "/@",
           "lines"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "/.", 
       RowBox[{"ThickFlasherDefaultFFProjectionRules", "[", 
        RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "0.1"}], "]"}]}], ",", 
      RowBox[{"Axes", "->", "True"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.555752770244678*^9, 3.555752822227908*^9}, {
   3.555752901500042*^9, 3.555752920876604*^9}, 3.555753748262662*^9, 
