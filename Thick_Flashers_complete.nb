  3.69400921577253*^9}},ExpressionUUID->"08660264-4925-4bcb-8d2c-\
ecac4ac42f7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "clist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"clist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"2", "#1"}], ",", 
           RowBox[{
            FractionBox["3", "2"], "+", 
            SuperscriptBox["#1", "2"]}]}], "}"}], "&"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "#1"}], ",", 
           RowBox[{"1", "-", 
            FractionBox[
             SuperscriptBox["#1", "2"], "2"]}]}], "}"}], "&"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"2", "#1"}], ",", 
           RowBox[{
            FractionBox["3", "2"], "-", 
            FractionBox[
             RowBox[{"3", " ", 
              SuperscriptBox["#1", "2"]}], "2"]}]}], "}"}], "&"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", 
