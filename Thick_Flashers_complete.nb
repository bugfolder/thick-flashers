Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "4"}], "}"}]}], "}"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRadialPot", "[", 
       RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", 
        RowBox[{"PotGapHalfAngle", "\[Rule]", 
         RowBox[{"3", "\[Degree]"}]}], ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"10", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", 
          RowBox[{"CreaseColor", "\[Rule]", "LightGray"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", 
          RowBox[{"ShowUnfolded", "\[Rule]", "False"}], "]"}]}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

