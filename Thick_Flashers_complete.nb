Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "w", ",", "d", ",", "\[Tau]", ",", "ccw", ",", "ip", ",", 
      "ctype", ",", "types"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.1", ",", "1.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2"}], ",", "1.0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"70", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccw", "=", "True"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"RenderTile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "QuadrilateralSplitTwistTile", ",", "verts", ",", "w", ",", "d", ",",
            "\[Tau]", ",", "ccw", ",", "ip", ",", "ctype", ",", "types"}], 
          "}"}], ",", "Tiling"}], "]"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6298263240615673`*^9, 3.629826442238137*^9}, {
   3.6300185919445667`*^9, 3.63001859879489*^9}, 3.630018642548717*^9, 
   3.630072612557309*^9, {3.6300732135693073`*^9, 3.630073228101599*^9}},
 CellLabel->
  "In[2931]:=",ExpressionUUID->"5d6a9fa7-5a0c-49b4-a6e5-e2d0a420a225"]
}, Closed]],

