Cell[CellGroupData[{

Cell[TextData[{
 "CCWTwistQ[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["face",
  FontSlant->"Italic"],
 "]\nMakePartialFoldedLine[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1}]\nCoverPartialLine[{",
 StyleBox["a1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tmin1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tmax1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["a2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mi",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.457660548146956*^9, 3.457660583088572*^9}, 
   3.457732870179689*^9, {3.457732973759033*^9, 3.4577329959127483`*^9}, {
   3.457733089381979*^9, 3.457733089945703*^9}, {3.457736904723947*^9, 
   3.457736918504571*^9}, {3.457737387844174*^9, 3.457737400091979*^9}, {
   3.457737543623247*^9, 3.457737544899448*^9}, {3.457738476137825*^9, 
   3.4577384819242287`*^9}, {3.457738575108622*^9, 3.457738579388669*^9}, {
   3.457741305831451*^9, 3.457741309802976*^9}, {3.4851968367588577`*^9, 
   3.485196848949401*^9}, 3.592172417984991*^9, {3.800014092594379*^9, 
   3.800014108078858*^9}},ExpressionUUID->"fdc1cdcd-1714-4e7c-85ba-\
61b53f844c59"],

Cell[TextData[{
 "CCWTwistQ[",
 StyleBox["verts, edges, face",
  FontSlant->"Italic"],
 "] returns True if the twist polygon ",
 StyleBox["face",
  FontSlant->"Italic"],
 ", part of a folded form crease pattern specified by ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " and ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", is a CCW twist (versus CW). This is surprisingly complicated. We find the \
4 pleats emanating from an edge of ",
 StyleBox["face",
  FontSlant->"Italic"],
 ", measure their angle with respect to the edge, then keep the angle that is \
duplicated in the list. The value of this angle (greater or less than \
\[Pi]/2) tells the direction of the twist."
}], "Text",
 CellChangeTimes->{{3.457660591048531*^9, 3.457660593009359*^9}, 
   3.485196851969187*^9, {3.485196885827273*^9, 
   3.485196889168439*^9}},ExpressionUUID->"028ba773-ca0a-42ac-bb54-\
9f82d2dfe86a"],

Cell["\<\
If we don't find a duplicate angle, then there's something wrong with the \
twist description. Since CCWTwistQ may be buried deep inside the calling \
function, we throw an unusually informative error message and Abort.\
\>", "Text",
 CellChangeTimes->{{3.457832760536952*^9, 3.457832836124834*^9}, {
  3.592166779766856*^9, 
  3.592166782924898*^9}},ExpressionUUID->"8d278558-b85c-4807-b3aa-\
92999b4af129"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CCWTwistQ", "::", "badangles"}], 
   "=", "\"\<Error: CCWTwistQ couldn't find the pleat for this twist. Pleat \
angles (\[Degree]) were `1` (\[Degree]), twist network is printed.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592166831033813*^9, 3.5921668984794073`*^9}, {
  3.592166996274469*^9, 3.592167009208618*^9}, {3.592167113291028*^9, 
  3.592167122276577*^9}},
 CellLabel->
  "In[2739]:=",ExpressionUUID->"9fde2d61-0c8e-4c4d-8b95-407b57c5072c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CCWTwistQ", "[", 
   RowBox[{"verts_List", ",", "edges_List", ",", "face_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pe", ",", "tedges", ",", "eas", ",", "ma"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pe", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"face", ",", "2"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "edge", " ", 
       RowBox[{"we", "'"}], "re", " ", "checking"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tedges", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"edges", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Intersection", "[", 
             RowBox[{"pe", ",", "#"}], "]"}], "]"}], "\[Equal]", "1"}], "&&", 
          
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Intersection", "[", 
             RowBox[{"face", ",", "#"}], "]"}], "]"}], "\[Equal]", "1"}]}], 
         "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"test", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"eas", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"#", "-", 
           RowBox[{"ArcTan", "@@", 
            RowBox[{"-", 
             RowBox[{"Subtract", "@@", 
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "pe", 
               "\[RightDoubleBracket]"}]}]}]}]}], ",", 
          RowBox[{"2", "\[Pi]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"ArcTan", "@@", 
           RowBox[{"-", 
            RowBox[{"Subtract", "@@", 
             RowBox[{"verts", "\[LeftDoubleBracket]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MemberQ", "[", 
                 RowBox[{"pe", ",", 
                  RowBox[{"First", "[", "#", "]"}]}], "]"}], ",", "#", ",", 
                RowBox[{"Reverse", "[", "#", "]"}]}], "]"}], 
              "\[RightDoubleBracket]"}]}]}]}], "&"}], "/@", "tedges"}], 
        ")"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "angles", " ", "of", " ", "test", " ", "edges", " ", "relative", " ", 
       "to", " ", "pleats"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ma", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
              "eas", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[Equal]", 
              RowBox[{
              "eas", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}],
              ",", 
             RowBox[{
             "eas", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}], "]"}], ",", 
        "Null"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"angles", " ", 
       RowBox[{"w", "/", " ", "multiplicity"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "ma", "]"}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"oh", "-", "oh"}], ",", " ", "error", ",", " ", 
         RowBox[{
         "we", " ", "found", " ", "no", " ", "duplicate", " ", "angles"}], ",",
          " ", 
         RowBox[{"this", " ", 
          RowBox[{"isn", "'"}], "t", " ", "a", " ", 
          RowBox[{"twist", "!"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"CCWTwistQ", "::", "badangles"}], ",", 
          RowBox[{"eas", "/", "\[Degree]"}]}], "]"}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"GraphGraphics", "[", 
          RowBox[{"MakeTGraph", "[", 
           RowBox[{"verts", ",", "edges", ",", 
            RowBox[{"{", "face", "}"}]}], "]"}], "]"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ma", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "<", 
      RowBox[{"\[Pi]", "/", "2"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.457830828363389*^9, 3.457830934719749*^9}, {
   3.4578315069592876`*^9, 3.457831523121614*^9}, {3.457831570975305*^9, 
   3.457831612691407*^9}, {3.457831663299756*^9, 3.4578316861707983`*^9}, {
   3.45783247937807*^9, 3.45783247945223*^9}, {3.457832534314266*^9, 
   3.45783259400983*^9}, {3.457832627757906*^9, 3.4578327526692*^9}, 
   3.458214847314927*^9, 3.45821730115411*^9, 3.484065871371574*^9, {
   3.484251047338419*^9, 3.484251065958397*^9}, {3.484251745993215*^9, 
   3.484251755895319*^9}, 3.4848326160814*^9, 3.484834027797551*^9, {
   3.485196890452475*^9, 3.485196893681445*^9}, {3.59216690210962*^9, 
   3.592166946437585*^9}, {3.5921670129902697`*^9, 3.592167076451426*^9}, 
   3.5923443050528193`*^9, 3.592345819549359*^9, 3.5924357611086903`*^9, 
   3.592435865590255*^9, {3.592480134491459*^9, 3.592480149857805*^9}, 
   3.594734258422393*^9, 3.627328604436291*^9, 3.627328639300113*^9},
