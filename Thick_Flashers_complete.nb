Cell["\<\
A TVertex3D describes a 3D vertex and its surroundings. If you want a visual \
representation, call MakeSphericalVertexGraph3D, which will provide a \
TGraph3D+TAssigned that represents the vertex, located at the origin, and \
surrounding faces, clipped to a circle.\
\>", "Text",
 CellChangeTimes->{{3.597503969535762*^9, 3.597504005382127*^9}, {
   3.597504043555389*^9, 3.597504057970231*^9}, {3.5975041081298847`*^9, 
   3.597504113438459*^9}, {3.5975041451642513`*^9, 3.597504160467542*^9}, {
   3.59750419831283*^9, 3.597504201100654*^9}, {3.597504706039202*^9, 
   3.597504706399167*^9}, {3.5975056689869137`*^9, 3.597505695150156*^9}, {
   3.597516316476721*^9, 3.597516326036086*^9}, {3.597516424857567*^9, 
   3.597516437245087*^9}, {3.597516769599175*^9, 3.5975167701113796`*^9}, 
   3.59752481488373*^9},ExpressionUUID->"2aa1ec09-eda1-4abb-8042-\
affc4d49550a"]
}, Closed]],

