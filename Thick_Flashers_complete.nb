Cell[TextData[{
 "Options:\n\tCrossLineDivisions \[Rule] ",
 StyleBox["nc",
  FontSlant->"Italic"],
 ", the number of divisions for rendering cross curves.\n\tCrossLineStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the cross curves.\n\tRulingLineDivisions, \
RulingLineStyle, CurveDivisions, FillStyle, SurfaceOrientation are passed \
through to StyledRuledPatch."
}], "Text",
