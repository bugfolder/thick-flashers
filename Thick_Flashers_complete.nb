 RowBox[{
  RowBox[{
   RowBox[{"InitialPosition2D", "::", "usage"}], 
   "=", "\"\<InitialPosition2D is an option to RecoverCurve2D that specifies \
the position of the curve at t=0.\>\""}], ";"}]], "Input",
