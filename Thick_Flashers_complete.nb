Cell[CellGroupData[{

Cell["Ring tessellations", "Section",
 CellChangeTimes->{{3.5940777613628902`*^9, 3.594077765640973*^9}, {
  3.594127254056458*^9, 
  3.5941272544009*^9}},ExpressionUUID->"9db40144-c65b-4326-a4a1-49454485e8f1"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.594077768329643*^9, 
  3.59407776876125*^9}},ExpressionUUID->"943c3810-b995-4c8c-add5-\
947f6f6207f0"],

Cell["\<\
Ring tessellations incorporate one of my earliest tessellation algorithms \
(which, interestingly, is sort of a generalized Miura-ori pattern). In \
particular, it\[CloseCurlyQuote]s the basis of \
\[OpenCurlyDoubleQuote]Squaring the Circle\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]Egg17 Tessellation\[CloseCurlyDoubleQuote]. The idea \
is to define a series of nested vector-valued functions in polar coordinates, \
define a central twist, then propagate it outward, reflecting the propagating \
lines each time they hit one of the polar curves, always satisfying KJT at \
each vertex.\
\>", "Text",
 CellChangeTimes->{{3.5940777713210783`*^9, 3.594077840428343*^9}, 
   3.594077876138404*^9, {3.594077961469234*^9, 3.594078029542924*^9}, {
   3.594078394327365*^9, 3.594078408302225*^9}, {3.594081016290004*^9, 
   3.594081023248127*^9}, {3.594127257608059*^9, 
   3.594127257975132*^9}},ExpressionUUID->"0eaf368d-8bc9-4ac0-8b15-\
bbe0cfcb81b9"]
}, Closed]],

Cell[CellGroupData[{

Cell["Ring tessellations", "Subsection",
 CellChangeTimes->{{3.595030981350672*^9, 3.5950309833798423`*^9}, 
   3.6174444819297743`*^9},ExpressionUUID->"5e2a3c57-f530-4fbd-a4be-\
24637edc853a"],

Cell[CellGroupData[{

Cell[TextData[{
 "PolarInt2D[",
 StyleBox["rfn, p, d",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.594079153974477*^9, {3.594080271198268*^9, 3.594080272115498*^9}, {
   3.5940805317955837`*^9, 
   3.594080532089691*^9}},ExpressionUUID->"e9f7daf1-2880-4159-a264-\
5e7a01efb751"],

Cell[TextData[{
 "PolarInt2D[",
 StyleBox["rfn, p, d",
  FontSlant->"Italic"],
 "] takes a vector-valued polar function ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 "[\[Phi]], a point ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", and a direction vector ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", and numerically finds the intersection of the ray defined by ",
 StyleBox["p",
  FontSlant->"Italic"],
 " and ",
 StyleBox["d",
  FontSlant->"Italic"],
 " with the curve defined by function ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 "[\[Phi]]. It returns the point of intersection. Function ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 "[\[Phi]] should return a 2D point for its argument \[Phi]."
}], "Text",
 CellChangeTimes->{
  3.594079154022602*^9, {3.594080277163867*^9, 3.5940803154217443`*^9}, {
   3.594080536435285*^9, 3.594080546937056*^9}, {3.5940809467984548`*^9, 
   3.594080966252722*^9}, {3.594081060038876*^9, 3.5940810735087433`*^9}, {
   3.595018212503132*^9, 
   3.595018218173995*^9}},ExpressionUUID->"ba2ddc3f-6ac1-48f1-9db9-\
f2cb2b8e1ced"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolarInt2D", "[", 
   RowBox[{"rfn_", ",", "p_", ",", "d_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "\[Phi]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "+", 
      RowBox[{"r", " ", "d"}]}], " ", "/.", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{"p", "+", 
        RowBox[{"r", " ", "d"}], " ", "-", " ", 
        RowBox[{"rfn", "[", "\[Phi]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", 
         RowBox[{"ArcTan", "@@", "p"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.594079154047139*^9, 3.594080331474511*^9, {3.594080555869122*^9, 
   3.594080562999514*^9}},
 CellLabel->
  "In[2674]:=",ExpressionUUID->"333f4419-861b-44b8-88e3-fc983e04ed40"],

Cell["Example", "Text",
 CellChangeTimes->{{3.594080341513302*^9, 
  3.594080342278825*^9}},ExpressionUUID->"5912b83d-106a-41a1-b080-\
18d13cf835ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rfn", ",", "p", ",", "d", ",", "q"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"rfn", "[", "\[Phi]_", "]"}], ":=", 
      RowBox[{"2", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "}"}]}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"a", " ", "circle"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"PolarInt2D", "[", 
       RowBox[{"rfn", ",", "p", ",", "d"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"p", ",", 
               RowBox[{"p", "+", "d"}]}], "}"}], "]"}], ",", 
            RowBox[{"Point", "[", "p", "]"}]}], "}"}], ",", 
          RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Gray"}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"rfn", "[", "\[Phi]", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Phi]", ",", "0", ",", 
               RowBox[{"2", "\[Pi]"}], ",", 
               RowBox[{".02", "\[Pi]"}]}], "}"}]}], "]"}], "]"}], ",", 
          "Black"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "[", "q", "]"}], ",", 
          RowBox[{"AbsolutePointSize", "[", "8", "]"}], ",", "Red"}], "]"}]}],
        "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594080344305772*^9, 3.594080521646326*^9}, {
  3.594080568469269*^9, 3.594080674590819*^9}, {3.594080933319135*^9, 
  3.5940809419947033`*^9}, {3.594080981753457*^9, 3.59408099492821*^9}},
 CellLabel->
  "In[2675]:=",ExpressionUUID->"47339144-c486-474c-b255-25aa42628b8d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RingFunctionGraphics[",
 StyleBox["pfn",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n, opts",
  FontSlant->"Italic"],
 "]\n\t",
 "(options)",
 " Options[Graphics]"
}], "Subsubsection",
 CellChangeTimes->{{3.59407808910784*^9, 3.594078130239527*^9}, {
   3.594078413101457*^9, 3.594078420115847*^9}, {3.594127275701882*^9, 
   3.594127276047079*^9}, 
   3.594732524213578*^9},ExpressionUUID->"7dc0683c-cd6e-4358-b360-\
1dff8c145934"],

Cell[TextData[{
 "RingFunctionGraphics[",
 StyleBox["pfn",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n, opts",
  FontSlant->"Italic"],
 "] returns a Graphics object that displays the polar functions ",
 StyleBox["pfn",
  FontSlant->"Italic"],
 "[\[Phi]], ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 "[\[Phi]] for ",
 StyleBox["n",
  FontSlant->"Italic"],
 " iterations, closing with an n+1th iteration of ",
 StyleBox["pfn",
  FontSlant->"Italic"],
 ". It\[CloseCurlyQuote]s a way of visualizing the curves that define a ring \
tessellation. Options are:\n\tOptions[Graphics] are passed through to \
Graphics."
}], "Text",
 CellChangeTimes->{{3.594078121664106*^9, 3.594078157093685*^9}, {
   3.594078262105295*^9, 3.59407827776558*^9}, {3.594078410628506*^9, 
   3.594078428371646*^9}, {3.59408110966713*^9, 3.594081161471031*^9}, 
   3.594127280287593*^9, {3.595018160603363*^9, 
   3.59501816132948*^9}},ExpressionUUID->"b0b91145-353a-48de-a907-\
a009967eed52"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RingFunctionGraphics", "[", 
   RowBox[{
    StyleBox["pfn_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["rfn_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["n_",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"pfn", "[", "i", "]"}], "[", "\[Phi]", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Phi]", ",", "0", ",", 
                 RowBox[{"2", "\[Pi]"}], ",", 
                 RowBox[{".02", "\[Pi]"}]}], "}"}]}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}], ",", "Gray"}],
          "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"rfn", "[", "i", "]"}], "[", "\[Phi]", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Phi]", ",", "0", ",", 
                 RowBox[{"2", "\[Pi]"}], ",", 
                 RowBox[{".02", "\[Pi]"}]}], "}"}]}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Lighter", "[", 
           RowBox[{"Gray", ",", "0.25"}], "]"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"FilterRules", "[", 
       RowBox[{
        RowBox[{"{", "opts", "}"}], ",", 
        RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594078282893056*^9, 3.5940783920875397`*^9}, 
   3.594078432071495*^9, {3.594078558911582*^9, 3.594078566336632*^9}, {
   3.594078834852281*^9, 3.594078850796961*^9}, {3.594078896263887*^9, 
   3.5940788978177023`*^9}, {3.594078997857148*^9, 3.594079011822532*^9}, 
   3.594127282869773*^9},
 CellLabel->
  "In[2676]:=",ExpressionUUID->"ec504566-fb12-4d52-af0d-30ef65e7f823"],

Cell["\<\
Example. A function that grades from circles to superellipse. (This is the \
function from Squaring the Circle.)\
\>", "Text",
 CellChangeTimes->{{3.5940784373952003`*^9, 3.594078438090827*^9}, {
  3.594079027300337*^9, 3.594079048200523*^9}, {3.594079186257165*^9, 
  3.594079197214836*^9}},ExpressionUUID->"b3bc58b5-9b2b-4d3c-85ae-\
fea682f4a9a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"F", ",", "pfn", ",", "rfn", ",", "n"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"x_", ",", "i_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"Sign", "[", "x", "]"}], 
        SuperscriptBox[
         RowBox[{"Abs", "[", "x", "]"}], 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", "i"}], ")"}]}]]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"0", ",", "i_"}], "]"}], ":=", "0"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"x_", ",", "0"}], "]"}], ":=", "x"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"pfn", "[", "i_", "]"}], "[", "\[Phi]_", "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0.75", "+", "i"}], ")"}], 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "i"}], "]"}], ",", 
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", "i"}], "]"}]}], 
         "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"rfn", "[", "i_", "]"}], "[", "\[Phi]_", "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1.0", "+", "i"}], ")"}], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "i"}], "]"}], ",", 
          RowBox[{"F", "[", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", "i"}], "]"}]}], 
         "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", "3"}], ";", "\[IndentingNewLine]", 
      RowBox[{"RingFunctionGraphics", "[", 
       RowBox[{"pfn", ",", "rfn", ",", "n"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "ShowExample"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.594078449611912*^9, 3.59407851141061*^9}, {
   3.5940787138034983`*^9, 3.594078714997308*^9}, {3.59407897146799*^9, 
   3.594078983778996*^9}, 3.594127295982917*^9},
 CellLabel->
  "In[2677]:=",ExpressionUUID->"35377883-0ce1-4d39-8b66-ab55d487487a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeRingTessellation[",
 StyleBox["m, n, \[Alpha], pfn, rfn, opts",
  FontSlant->"Italic"],
 "]\n\t(options) ",
 "RingOffsetAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.594079513434334*^9, 3.594079525551599*^9}, {
  3.594081390112018*^9, 3.594081396182165*^9}, {3.59408145394361*^9, 
  3.594081454946334*^9}, {3.594126824051399*^9, 3.594126846361815*^9}, {
  3.594126925309272*^9, 3.5941269260777607`*^9}, {3.594127312571961*^9, 
  3.594127326359174*^9}},ExpressionUUID->"f9d0cbf9-1d4a-461c-be80-\
833e47eaf0e7"],

Cell[TextData[{
 "MakeRingTessellation[",
 StyleBox["m, n, pfn, rfn, opts",
  FontSlant->"Italic"],
 "] takes an axial rotation order ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", a radial order ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", and polar functions ",
 StyleBox["pfn",
  FontSlant->"Italic"],
 " and ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 " that define a set of concentric rings and returns a TGraph2DAssigned \
describing the crease pattern and folded form of a tessellation with this \
ring structure. "
}], "Text",
 CellChangeTimes->{
  3.594081273100182*^9, {3.5940813136691628`*^9, 3.594081313752094*^9}, 
   3.594081417848913*^9, {3.594081502750947*^9, 3.594081512694609*^9}, {
   3.594126770211431*^9, 3.594126841547255*^9}, 3.594126929452913*^9, {
   3.5941269749378643`*^9, 3.594127076899674*^9}, 3.594127312637081*^9, {
   3.59501828472332*^9, 3.595018312016408*^9}, 
   3.924866547022098*^9},ExpressionUUID->"4a8734d1-ab43-4cbd-a8e4-\
30b582ea28c5"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the number of pleats encountered going axially around the \
pattern.\n\t",
 StyleBox["n",
  FontSlant->"Italic"],
 " \[LongDash] the number full rings, plus the boundary.\n\t\[Alpha] \
\[LongDash] the twist angle.\n\t",
 StyleBox["pfn",
  FontSlant->"Italic"],
 " \[LongDash] the polar function for the p-points (first points encountered \
in each ring when traveling outward).\n\t",
 StyleBox["rfn",
  FontSlant->"Italic"],
 " \[LongDash] the polar function for the r-points (second points encountered \
in each ring when traveling outward)."
}], "Text",
 CellChangeTimes->{{3.9248665590836487`*^9, 
  3.924866715360565*^9}},ExpressionUUID->"23be1022-2a2a-4283-82bf-\
7f8cbd6e6645"],

Cell["\<\
Options:
\tRingOffsetAngle \[Rule] \[Phi]0, specifies the initial offset angle for the \
axial divisions.\
\>", "Text",
 CellChangeTimes->{{3.924866551102438*^9, 3.924866555019692*^9}, {
  3.924866728071355*^9, 
  3.924866739562688*^9}},ExpressionUUID->"50b89a5c-6376-42f3-b292-\
f55dda8bbbd1"],

Cell[TextData[{
 "The tessellation pattern has four types of points: p-, q-, r-, and \
s-points. We constrain p-points and r-points to lie on their respective polar \
functions ",
 StyleBox["pfn",
  FontSlant->"Italic"],
 "[",
 StyleBox["i",
  FontSlant->"Italic"],
 "][\[Phi]], ",
 StyleBox["rfn",
  FontSlant->"Italic"],
 "[",
 StyleBox["i",
  FontSlant->"Italic"],
 "][\[Phi]], and solve for the positions of the q- and s-points that satisfy \
flat-foldability with the specified tilt angle."
}], "Text",
 CellChangeTimes->{{3.5941229061278276`*^9, 3.594123015254877*^9}, {
  3.59412708693953*^9, 
  3.594127098012123*^9}},ExpressionUUID->"75a0ea64-1d17-4066-8ca1-\
716cbc72a5ea"],

Cell["\<\
We do not automatically calculate the CP and FF, because the visible folded \
form can take a long time to compute and render. So we\[CloseCurlyQuote]ll \
leave that to the user. See the example.\
\>", "Text",
 CellChangeTimes->{{3.5941269330845547`*^9, 3.594126967515051*^9}, {
  3.594127116411034*^9, 
  3.594127119584656*^9}},ExpressionUUID->"02225bf0-ad1d-42d1-aad9-\
5bfaff3015f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RingOffsetAngle", "::", "usage"}], " ", "=", 
   " ", "\"\<RingOffsetAngle is an option to MakeRingTessellation that \
specifies the rotational offset angle from 0\[Degree].\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.59408154513894*^9, 3.594081565229155*^9}, {
