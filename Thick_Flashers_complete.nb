Cell["\<\
Example. Show the panels and knuckles as solid and cutouts and holes as faint.\
\>", "Text",
 CellChangeTimes->{{3.933364414026718*^9, 3.933364414971925*^9}, {
  3.933943680515881*^9, 3.933943702748231*^9}, {3.934028908115847*^9, 
