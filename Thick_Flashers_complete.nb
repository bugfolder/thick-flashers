Cell[TextData[{
 "This works for generic developables and cylinders, but not if ",
 StyleBox["bb",
  FontSlant->"Italic"],
 " is a cone point or EOR."
}], "Text",
 CellChangeTimes->{{3.799332569079427*^9, 3.799332588295621*^9}, {
