Cell["Example. Intersection of two cylinders.", "Text",
 CellChangeTimes->{{3.6721504547278423`*^9, 
  3.672150460735135*^9}},ExpressionUUID->"1b082fef-5953-4840-ac20-\
50985514d5b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ss1", ",", "ss2", ",", "soln", ",", "uuu", ",", "ff", ",", "uu", ",", 
      "csys", ",", "dsys"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", 
         RowBox[{"Sin", "[", "#2", "]"}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#2", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss1 = \>\"", ",", 
       RowBox[{"ss1", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ss2", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#2", "]"}]}], ",", 
         RowBox[{"Sin", "[", "#2", "]"}], ",", "#1"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<ss2 = \>\"", ",", "ss2"}], "]"}], "//", 
      "PrettyParameters"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"surface", " ", "normal"}], ",", " ", 
       RowBox[{"parameterized", " ", "on", " ", "two", " ", "variables"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuu", "=", 
      RowBox[{"SurfaceNormalFromSurface", "[", 
       RowBox[{"ss1", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uuu = \>\"", ",", 
       RowBox[{"uuu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "curve", " ", "function", " ", "and", " ", "surface", " ", "normal", " ",
        "on", " ", "one", " ", "variable"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ff = \>\"", ",", 
       RowBox[{"ff", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{"Cos", "[", "#", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "the", " ", "system"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"ff", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"csys", "//", "PrettyParameters"}], "//", "ColumnForm"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsys", "=", 
      RowBox[{"Darboux3DSystem", "[", 
       RowBox[{"ff", ",", "uu", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"dsys", "//", "PrettyParameters"}], "//", "ColumnForm"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"StyledPatch", "[", 
           RowBox[{"ss1", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1."}], ",", "1.5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
              RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
            RowBox[{"OutlineStyle", "\[Rule]", "BorderLine"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"StyledPatch", "[", 
           RowBox[{"ss2", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", ".5"}], ",", "1.5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
              RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
            RowBox[{"OutlineStyle", "\[Rule]", "BorderLine"}], ",", 
            RowBox[{"FillStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"Gray", ",", 
               RowBox[{"Opacity", "[", "0.25", "]"}], ",", 
               RowBox[{"EdgeForm", "[", "]"}]}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"StyledCurve", "[", 
           RowBox[{"ff", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
              RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
            RowBox[{"LineStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"DarkGray", ",", 
               RowBox[{"Thickness", "[", ".015", "]"}]}], "}"}]}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.672146796363988*^9, 3.67214711449957*^9}, {
   3.672147147072768*^9, 3.672147403818366*^9}, {3.672147462022353*^9, 
