  3.691240453771187*^9}},ExpressionUUID->"748d2eac-971d-4b2e-adb6-\
3824faa9c93d"],

Cell["\<\
The order of construction and subexpressions are chosen to allow Mathematica \
to apply derivatives to InterpolatingFunction objects while minimizing the \
number of InterpolatingFunction evaluations required for each function \
evaluation.\
\>", "Text",
 CellChangeTimes->{{3.79985786142257*^9, 
  3.799857958310246*^9}},ExpressionUUID->"40d618a2-ebad-49bc-a542-\
81bd464f2da4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NCurve3DSystem", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.799520377289408*^9, 3.799520385121112*^9}},
 CellLabel->
  "In[3672]:=",ExpressionUUID->"fd2175ae-755f-4429-92db-2958afc6bfed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NCurve3DSystem", "[", 
   RowBox[{
    RowBox[{"c_Function", "|", "c_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "dc", ",", "mdc", ",", "ddc", ",", "dddc", ",", "dcxddc", ",", 
      "ds", ",", "t", ",", "\[Kappa]", ",", "n", ",", "b", ",", "\[Tau]"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mdc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"dc", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ddc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c", "''"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dddc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c", "'''"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dcxddc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"dc", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"ddc", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"mdc", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"dc", "[", "s", "]"}], 
         RowBox[{"mdc", "[", "s", "]"}]], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"Mag", "[", 
          RowBox[{"dcxddc", "[", "s", "]"}], "]"}], 
         SuperscriptBox[
          RowBox[{"mdc", "[", "s", "]"}], "3"]], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"dcxddc", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"dc", "[", "s", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{"dcxddc", "[", "s", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"dcxddc", "[", "s", "]"}], ".", 
          RowBox[{"dddc", "[", "s", "]"}]}], 
         RowBox[{"Mag2", "[", 
          RowBox[{"dcxddc", "[", "s", "]"}], "]"}]], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve3D", "\[Rule]", "c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed3D", "\[Rule]", "ds"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Curvature3D", "\[Rule]", "\[Kappa]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Torsion3D", "\[Rule]", "\[Tau]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", "t"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BinormalVector3D", "\[Rule]", "b"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalVector3D", "\[Rule]", "n"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.668362892429557*^9, 3.66836289243172*^9}, {
