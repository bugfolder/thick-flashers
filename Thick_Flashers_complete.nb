 "MinorFirstBindingDihedralAngles[",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "d5d5601f-b3fb-43fd-ab76-8e23621c9cd1"],
 "]\n",
 "MajorFirstBindingDihedralAngles",
 "[",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "5945b2a4-0acc-4038-9272-fbca30e1ba23"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.617434434155024*^9, 3.617434442963122*^9}, {
  3.617434532930037*^9, 3.617434539380376*^9}, {3.617436347634907*^9, 
  3.617436362855384*^9}},ExpressionUUID->"70eea12a-f6b3-4cd1-b1e7-\
a9fa58db20a1"],

Cell[TextData[{
 "MinorFirstBindingDihedralAngles[",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "0a0682ee-6a43-4d67-97c0-a22bba19e2f8"],
 "] takes a minor-first list of four sector angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "175e070f-dbc9-4810-a38e-510bd4fda36c"],
 "and returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], ",", 
     SubscriptBox["\[Gamma]", "2"], ",", 
     SubscriptBox["\[Gamma]", "3"], ",", 
     SubscriptBox["\[Gamma]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "4d0bef49-ef5a-4187-8a2e-aa59593bfc03"],
 " of the magnitude of the angles for all four fold angles at the point of \
binding (signs would be determined by the specific crease assignment of the \
major folds, of course). It returns \[Pi] if the fold can fully fold, less \
otherwise.  The vertex is assumed to be valley-like, i.e., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "97776414-2d8e-4971-8278-03786e60df49"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "08927c9f-d326-42cc-938f-81d5e0b19127"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "4"], TraditionalForm]],ExpressionUUID->
  "74523d2c-a21f-49b7-964b-02d475cb7e30"],
 " are positive, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "3"], TraditionalForm]],ExpressionUUID->
  "3c03dde2-baa3-479a-b8f7-116a40d35305"],
 " is negative."
}], "Text",
 CellChangeTimes->{{3.6172734842813873`*^9, 3.617273527290641*^9}, 
   3.617307999980966*^9, {3.6173095508078756`*^9, 3.617309570574632*^9}, {
   3.617310327976358*^9, 3.617310343998301*^9}, {3.617313456098721*^9, 
   3.61731346672082*^9}, {3.617434451738997*^9, 3.617434459092127*^9}, 
   3.617436347787491*^9, {3.703602242060682*^9, 
   3.703602242393525*^9}},ExpressionUUID->"63075939-eb5f-422f-a6da-\
85efa5006628"],

Cell["\<\
Note that we\[CloseCurlyQuote]re talking about fold angles, not dihedral \
angles, but I\[CloseCurlyQuote]m keeping the historical name for consistency \
with past usage. TBD: rename this function.\
\>", "Text",
 CellChangeTimes->{{3.70360225469047*^9, 
  3.703602295673289*^9}},ExpressionUUID->"3bdfcf23-4ce8-4bc4-8709-\
1c06a49fd240"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MinorFirstBindingDihedralAngles", "[", 
   RowBox[{"{", 
    RowBox[{
    "\[Alpha]1_", ",", "\[Alpha]2_", ",", "\[Alpha]3_", ",", "\[Alpha]4_"}], 
    "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r", ",", "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", 
      "\[Gamma]4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FlatFoldableAnglesQ", "[", 
        RowBox[{"{", 
         RowBox[{
         "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
         "}"}], "]"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{"flat", "-", "foldable"}], " ", "*)"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"\[Pi]", ",", "\[Pi]", ",", "\[Pi]", ",", "\[Pi]"}], "}"}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MinorFirstStraightMajorAnglesQ", "[", 
        RowBox[{"{", 
         RowBox[{
         "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
         "}"}], "]"}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{"straignt", "-", 
         RowBox[{"major", " ", "but", " ", "not", " ", "flat"}], "-", 
         "foldable"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Pi]", ",", "0", ",", "\[Pi]"}], "}"}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
         RowBox[{"Sin", "[", "\[Alpha]2", "]"}]}], 
        RowBox[{
         RowBox[{"Sin", "[", "\[Alpha]3", "]"}], 
         RowBox[{"Sin", "[", "\[Alpha]4", "]"}]}]]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r", "<", "1"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{"\[Gamma]2", " ", "binds", " ", "first"}], " ", "*)"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Gamma]2", "=", "\[Pi]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]4", "=", 
         RowBox[{"2", " ", 
          RowBox[{"ArcSin", "[", "r", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"r", " ", ">", " ", "1"}], ",", " ", 
         RowBox[{"\[Gamma]4", " ", "binds", " ", "first"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Gamma]4", "=", "\[Pi]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]2", "=", 
         RowBox[{"2", " ", 
          RowBox[{"ArcSin", "[", 
           RowBox[{"1", "/", "r"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MinorFirstStraightMinorAnglesQ", "[", 
        RowBox[{"{", 
         RowBox[{
         "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
         "}"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"straight", "-", "minor"}], ",", " ", 
         RowBox[{"use", " ", "simpler", " ", "formulas"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Gamma]1", "=", 
         RowBox[{"2", 
          RowBox[{"ArcCot", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Cot", "[", 
                 FractionBox["\[Gamma]2", "2"], "]"}], " ", 
                RowBox[{"Csc", "[", "\[Alpha]1", "]"}]}], "+", 
               RowBox[{
                RowBox[{"Cot", "[", 
                 FractionBox["\[Gamma]4", "2"], "]"}], 
                RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}]}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
               RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}]}], 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Csc", "[", "\[Alpha]3", "]"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"Csc", "[", "\[Alpha]2", "]"}], "2"]}]], "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]3", "=", 
         RowBox[{"-", "\[Gamma]1"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"general", " ", "vertex"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Gamma]1", "=", 
         RowBox[{"2", 
          RowBox[{"ArcCot", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]2", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]4", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]2", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]4", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]3", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]1", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}]}], ")"}]}], "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]3", "=", 
         RowBox[{"2", " ", 
          RowBox[{"ArcCot", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]2", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]2", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]4", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]1", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]4", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]3", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]1", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}]}], ")"}]}], 
           "]"}]}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Abs", "/@", 
      RowBox[{"{", 
       RowBox[{
       "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4"}], 
