   3.594992960704607*^9, 
   3.594992964073661*^9}},ExpressionUUID->"5c11b995-49ee-45ee-a3ba-\
13c9dbd67b0b"],

Cell["\<\
Note that since FoldAngles and EdgeTypes are provided separately, you can end \
up with FoldAngles that are inconsistent with the EdgeTypes. See the \
Reassign* functions below for several ways to make them consistent.\
\>", "Text",
 CellChangeTimes->{{3.650050161847793*^9, 3.650050229035741*^9}, {
  3.650050263593369*^9, 
  3.650050302711837*^9}},ExpressionUUID->"0244c780-33ff-486a-97e1-\
6d12b26c55ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTGraph3DAssigned", "[", 
   RowBox[{"verts_List", ",", " ", "edges_List", ",", 
    RowBox[{"faces_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", 
    RowBox[{"verts3d_List", ":", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"foldangles_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", 
    RowBox[{"types_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], "//", 
     RowBox[{"AddTGraph3D", "[", 
      RowBox[{"verts3d", ",", "foldangles"}], "]"}]}], "//", 
    RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
   RowBox[{"AddClass", "[", "TGraph3DAssigned", "]"}]}]}]], "Input",
