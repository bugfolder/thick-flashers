Cell[TextData[{
 "FacesAboveOld[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] [deprecated]\n\t(options) FaceupFace, MaxDistance, ShowProgress"
}], "Subsubsection",
 CellChangeTimes->{{3.484787574065311*^9, 3.484787579905038*^9}, {
   3.484787611519256*^9, 3.484787617742523*^9}, 3.484788887930915*^9, 
