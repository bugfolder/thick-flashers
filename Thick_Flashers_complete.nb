Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "w", ",", "d", ",", "\[Tau]", ",", "ccw", ",", "ip", ",", 
      "ctype", ",", "types", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.1", ",", "1.4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2"}], ",", "1.0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.15"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"70", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccw", "=", 
      RowBox[{"\[Tau]", "<", 
       RowBox[{"\[Pi]", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RenderTile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "QuadrilateralSplitTwistTile", ",", "verts", ",", "w", ",", "d", ",",
           "\[Tau]", ",", "ccw", ",", "ip", ",", "ctype", ",", "types"}], 
         "}"}], ",", "TGraph2DAssigned"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}]}], "}"}], ",", 
         
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Graph2DGraphics", "[", "tobj", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"VisibleFoldedFormGraphics", "[", "tobj", "]"}]}], "}"}]}],
         "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
