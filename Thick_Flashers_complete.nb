}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RenderTile[{PolygonTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "}, TileVertices, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nRenderTile[{PolygonTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "}, Tiling, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TilePolys, TileEdges, TileVertexIndices, TileEdgeArrowStyle, \
TilePolyFill, TileEdgeArrowDirs, TileIndex"
}], "Subsubsection",
 CellChangeTimes->{{3.629820260668853*^9, 3.62982029687235*^9}, {
   3.629820885802676*^9, 3.629820912609026*^9}, 3.629822285847002*^9, {
   3.629823271150034*^9, 3.629823327798771*^9}, {3.629825953311316*^9, 
   3.6298259652907743`*^9}, 3.6298391863907843`*^9, 3.629839227026646*^9, 
   3.707757425974727*^9},ExpressionUUID->"f3c64b80-7d8b-4c72-bd76-\
14f9ccd21487"],

Cell[TextData[{
 "RenderTile[{PolygonTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "}, TileVertices, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " as the vertices of the tile."
}], "Text",
 CellChangeTimes->{{3.629820490766101*^9, 3.629820503778924*^9}, 
   3.707757427696067*^9},ExpressionUUID->"21da8272-e2fc-4d6e-b0bb-\
ab6f5c89d988"],

