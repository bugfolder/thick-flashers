7bf8a6c23263"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "pstr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pstr", "=", 
      RowBox[{"ToString", "[", "p", "]"}]}], ";", 
     RowBox[{"Print", "[", "pstr", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1.0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Gray", ",", 
        RowBox[{"Point", "[", "p", "]"}], ",", "Black", ",", 
        RowBox[{"LabelPtStr", "[", "pstr", "]"}]}], "}"}], "]"}]}]}], "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.471289543440601*^9, 3.471289599834382*^9}, 
