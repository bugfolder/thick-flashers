Cell["Example. A polygon with reflex vertices.", "Text",
 CellChangeTimes->{{3.7221733925071588`*^9, 3.722173405722443*^9}, 
   3.722173725220618*^9},ExpressionUUID->"2d76d840-8b06-4971-a860-\
97340e40a1b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "newverts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newverts", "=", 
      RowBox[{"InsetPoly", "[", 
       RowBox[{"verts", ",", 
        RowBox[{"{", 
         RowBox[{
         ".05", ",", ".1", ",", ".15", ",", ".2", ",", ".25", ",", ".3"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"AppendFirst", "[", "verts", "]"}], "]"}], ",", "Black"}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "/@", "verts"}], ",", 
          RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"AppendFirst", "[", "newverts", "]"}], "]"}], ",", 
          "Green"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "/@", "newverts"}], ",", 
          RowBox[{"PointSize", "[", ".01", "]"}], ",", 
          RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462431882462409*^9, 3.4624319730222797`*^9}, {
  3.462432078798387*^9, 3.4624320796687927`*^9}, {3.462432163367775*^9, 
