Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "f1", ",", "f2", ",", "sinfo", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"SingleVertexGraph2D", "//", "RebuildPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f1", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", ".1"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.3"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"f1", ",", 
          RowBox[{"f2", "-", "f1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<All split information\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SplitGraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SplitGraph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sinfo", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "SplitInfo"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sinfo", "//", "ColumnForm"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"SplitSplitGraph2D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<The split pattern\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobj1", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graph2DGraphics", "[", "tobj1", "]"}]}], "}"}], "]"}], "//",
       "Print"}], ";"}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.706791840799945*^9, 3.706791934239752*^9}, {
   3.706791968800919*^9, 3.706792019447933*^9}, {3.706792164694173*^9, 
