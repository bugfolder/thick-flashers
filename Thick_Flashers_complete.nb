        RowBox[{"cyl", "[", 
         RowBox[{"lb", ",", 
          RowBox[{"lb", "+", "le"}], ",", 
          RowBox[{"do", "-", "dc"}]}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
         "attachment", " ", "for", " ", "one", " ", "end", " ", "knuckle"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"cyl", "[", 
