Cell[CellGroupData[{

Cell[TextData[{
 "BoundingBoxesIntersectQ[",
 StyleBox["pbox",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qbox, opts",
  FontSlant->"Italic"],
 "]\n\t(options) IntersectionTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.628861700974155*^9, 3.628861712066824*^9}, {
  3.6764653103870773`*^9, 
  3.676465322386565*^9}},ExpressionUUID->"70581f87-efe6-41bd-9009-\
1b80082d0375"],

Cell[TextData[{
 "BoundingBoxesIntersectQ[",
 StyleBox["pbox",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qbox, opts",
  FontSlant->"Italic"],
 "] takes two bounding boxes of the form {{",
 StyleBox["xmin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xmax",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["ymin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ymax",
  FontSlant->"Italic"],
 "}}, and returns True if they overlap. Options are:\n\tIntersectionTolerance \
\[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", give a tolerance on the intersection tests."
}], "Text",
 CellChangeTimes->{{3.628861721002245*^9, 3.628861785734264*^9}, 
   3.6288618420010443`*^9, {3.67646532481848*^9, 
   3.6764653578646317`*^9}},ExpressionUUID->"b444a0fd-59ed-4e09-8af4-\
24a92cc221d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IntersectionTolerance", "::", "usage"}], 
   "=", "\"\<IntersectionTolerance is an option to BoundingBoxesIntersectQ \
(and others) that specifies a distance tolerance for intersections.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.676465367498519*^9, 3.676465406622861*^9}},
 CellLabel->
  "In[478]:=",ExpressionUUID->"5bb6c0df-b4e9-48ac-943b-fcd0c1025bc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "BoundingBoxesIntersectQ", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"IntersectionTolerance", " ", "\[Rule]", " ", "0"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.676465409415991*^9, 3.676465427002825*^9}, 
   3.708342926559053*^9},
 CellLabel->
  "In[479]:=",ExpressionUUID->"827e2599-1df0-441a-9521-11bf98912355"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BoundingBoxesIntersectQ", "[", 
   RowBox[{"pbox_List", ",", " ", "qbox_List", ",", "opts___"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "itol", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"itol", "=", 
      RowBox[{
       RowBox[{"IntersectionTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "BoundingBoxesIntersectQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"!", 
      RowBox[{"Or", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pbox", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "<", 
         RowBox[{
          RowBox[{"qbox", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
          "itol"}]}], ",", 
        RowBox[{
         RowBox[{"qbox", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "<", 
         RowBox[{
          RowBox[{"pbox", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
          "itol"}]}], ",", 
        RowBox[{
         RowBox[{"pbox", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "<", 
         RowBox[{
          RowBox[{"qbox", "\[LeftDoubleBracket]", 
           RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
          "itol"}]}], ",", 
        RowBox[{
         RowBox[{"qbox", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "<", 
         RowBox[{
          RowBox[{"pbox", "\[LeftDoubleBracket]", 
           RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
          "itol"}]}]}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.628861807325257*^9, 3.628861829832786*^9}, 
   3.6288621166918507`*^9, {3.676465363320751*^9, 3.676465364832816*^9}, {
   3.676465431717678*^9, 3.676465505220185*^9}, {3.676465921055354*^9, 
   3.67646592873524*^9}, {3.676465990555143*^9, 3.676465997562161*^9}, 
   3.676472760930364*^9},
 CellLabel->
  "In[480]:=",ExpressionUUID->"613e575c-dcff-4d21-a639-4db47145c5ad"],

Cell["Example", "Text",
 CellChangeTimes->{{3.628861850833759*^9, 3.628861851575933*^9}, {
  3.628861921101089*^9, 
  3.6288619219805803`*^9}},ExpressionUUID->"552edd48-d38e-4b7d-aa83-\
782364ccd4e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pbox", ",", "qbox", ",", "pverts", ",", "qverts", ",", "int"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pbox", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qbox", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{".5", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", "1.5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", "pbox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qverts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", "qbox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"int", "=", 
      RowBox[{"BoundingBoxesIntersectQ", "[", 
       RowBox[{"pbox", ",", "qbox"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pverts", "]"}], "]"}], ",", "Red"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "qverts", "]"}], "]"}], ",", 
           "Green"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"If", "[", 
         RowBox[{
         "int", ",", "\"\<intersects\>\"", ",", "\"\<no intersection\>\""}], 
         "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.628861923452605*^9, 3.628862102949738*^9}, {
  3.6288629749582*^9, 3.628862979186285*^9}, {3.676465636752681*^9, 
  3.676465683959589*^9}},
 CellLabel->
  "In[481]:=",ExpressionUUID->"f09ba979-59b6-4565-a7bb-66541aa8bee5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pbox", ",", "qbox", ",", "pverts", ",", "qverts", ",", "int"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pbox", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qbox", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", ".2"}], ",", "1.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".2", ",", ".8"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", "pbox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qverts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", "qbox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"int", "=", 
      RowBox[{"BoundingBoxesIntersectQ", "[", 
       RowBox[{"pbox", ",", "qbox"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
