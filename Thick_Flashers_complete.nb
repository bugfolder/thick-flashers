               "\[RightDoubleBracket]"}], "-", 
              RowBox[{"idata", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{
                "pdata", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}], ",", "2"}], 
               "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{"2", "\[Pi]"}], ",", 
             RowBox[{"-", "\[Pi]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"newverts", "\[LeftDoubleBracket]", 
            RowBox[{
            "bverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], "=", 
           RowBox[{"ctr", "+", 
            RowBox[{"r", " ", 
             RowBox[{"U", "[", 
              RowBox[{
               RowBox[{"idata", "\[LeftDoubleBracket]", 
                RowBox[{
                 RowBox[{
                 "pdata", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}], ",", "2"}], 
                "\[RightDoubleBracket]"}], "+", 
               RowBox[{
                FractionBox["di", "dn"], "da"}]}], "]"}]}]}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nb"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "newverts"}]}], "]"}]}]], "Input",
