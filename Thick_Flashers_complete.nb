Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherPanelNumbers[",
 StyleBox["panels",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.934145129252491*^9, 
  3.9341451640376453`*^9}},ExpressionUUID->"d7bf694c-f7f8-4d52-b994-\
7e778a713c85"],

Cell[TextData[{
 "ThickFlasherPanelNumbers[",
 StyleBox["panels",
  FontSlant->"Italic"],
 "] returns a list of Graphics3D elements that puts numbers on top of the \
panels, which you can use to create an image of the numbered panels for \
further manipulation. This works best with deployed-form panels."
}], "Text",
 CellChangeTimes->{{3.9341451670530157`*^9, 
  3.934145239708961*^9}},ExpressionUUID->"bea4be9b-80b0-4132-b55d-\
1cbe54511456"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["panels",
  FontSlant->"Italic"],
 " \[LongDash] a list of panels, such as are produced by \
MakeThickFlasherPanels."
}], "Text",
 CellChangeTimes->{{3.934145586034223*^9, 
  3.934145603628998*^9}},ExpressionUUID->"393809ab-1e96-4fe3-97fb-\
2368145d7842"],

Cell["\<\
Returns: a list of Graphics3D elements of the indices of each panel in \
panels, located on top of the panel above its centroid.\
\>", "Text",
 CellChangeTimes->{{3.934145606778413*^9, 3.9341456444230347`*^9}, 
   3.934145711699334*^9},ExpressionUUID->"57e71cdc-09cc-4355-830e-\
0114ed0faaa0"],

Cell["\<\
This is useful when we want to pick out selected panels from a list, for \
example, to build a single sector that can be replicated.\
\>", "Text",
 CellChangeTimes->{{3.934145647212051*^9, 
  3.9341457023843107`*^9}},ExpressionUUID->"558e4c0e-9e68-4538-bb9d-\
7d3f06f6c87f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherPanelNumbers", "[", "panels_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ctrd", ",", "zmax"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ctrd", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Plus", "@@", 
           RowBox[{"panels", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}]}], ")"}], "/", 
         
         RowBox[{"Length", "[", 
          RowBox[{"panels", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "]"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"zmax", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"Last", "/@", 
          RowBox[{"panels", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"ToString", "[", "i", "]"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "zmax"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "0"}], "}"}], "ctrd"}]}]}], "]"}]}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "panels", "]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.934145341487359*^9, 3.9341455067674723`*^9}},
 CellLabel->
  "In[4527]:=",ExpressionUUID->"c398b001-ad4e-46e5-9a2b-96e52ab2dfdd"],

