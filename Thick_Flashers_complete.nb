68682bafa7a4"],

Cell[TextData[{
 "MakeTDegree4Vertex3DFromTGraph3D",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i1",
  FontSlant->"Italic"],
 "] constructs a TDegree4Vertex3D for a single vertex of a TGraph3D, where ",
 StyleBox["i0",
  FontSlant->"Italic"],
 " is the index of the central vertex, and ",
 StyleBox["i1",
  FontSlant->"Italic"],
 " is the index of the adjacent vertex that will define fold direction vector \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],ExpressionUUID->
  "10a75b27-49f4-461d-89f0-80c78f7a47f7"],
 "."
}], "Text",
 CellChangeTimes->{{3.595276176936623*^9, 3.595276265354195*^9}, {
   3.595278353620092*^9, 3.595278373976825*^9}, 
   3.595279282284532*^9},ExpressionUUID->"4113138e-0cd3-4eda-a1b4-\
4e432304ed1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTDegree4Vertex3DFromTGraph3D", "::", "baddeg"}], 
   "=", "\"\<Vertex `1` of `2` is not degree 4.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5952763235224533`*^9, 3.595276356205989*^9}, 
   3.595279282314857*^9},
 CellLabel->
  "In[2242]:=",ExpressionUUID->"44fdd21e-2b1e-4af8-81a6-8192ae4cab31"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTDegree4Vertex3DFromTGraph3D", "::", "badadj"}], 
   "=", "\"\<Vertex `1` is not adjacent to vertex `2`.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.5952763235224533`*^9, 3.595276356205989*^9}, {
   3.595278772250638*^9, 3.595278784608114*^9}, 3.59527928256041*^9},
 CellLabel->
  "In[2243]:=",ExpressionUUID->"167c1df3-8409-4126-a793-9d30d224ec08"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTDegree4Vertex3DFromTGraph3D", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["i0_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["i1_",
     FontSlant->"Italic"]}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobj1", ",", "verts3d", ",", "vva", ",", "glist", ",", "tobj2"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", "tobj", ",", 
        RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "vva"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "VertexVertexAdjacency"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{
         "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], 
         "]"}], "\[NotEqual]", "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTDegree4Vertex3DFromTGraph3D", "::", "baddeg"}], ",", 
          "i0", ",", "tobj"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{
          "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
           "i1"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTDegree4Vertex3DFromTGraph3D", "::", "badadj"}], ",", 
          "i1", ",", "i0"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"glist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "-", 
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}],
         "&"}], "/@", 
       RowBox[{
       "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"glist", "=", 
      RowBox[{"RotateLeft", "[", 
       RowBox[{"glist", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
            "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
             "i1", ",", "1", ",", "1"}], "]"}], "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTDegree4Vertex3D", "[", "glist", "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5952763101089363`*^9, 3.595276318024272*^9}, {
   3.595276359798087*^9, 3.595276363662991*^9}, {3.595278427768565*^9, 
   3.5952787467030478`*^9}, {3.595278791946889*^9, 3.595278818020694*^9}, 
   3.59527894324346*^9, {3.595279282812804*^9, 3.595279283297084*^9}, 
   3.708400178160675*^9, 3.708603657282158*^9},
 CellLabel->
  "In[2244]:=",ExpressionUUID->"a08f9729-b915-4722-b0aa-82b7180c1369"],

