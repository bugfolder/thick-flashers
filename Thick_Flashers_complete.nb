   3.592465020709216*^9}, {3.592487420997506*^9, 3.592487458699068*^9}, {
   3.592661138908702*^9, 3.592661138975286*^9}, {3.592668608664851*^9, 
   3.592668608733944*^9}, {3.592828863978977*^9, 3.592828885628648*^9}, {
   3.592854602268087*^9, 3.592854616212887*^9}, {3.592854653672988*^9, 
   3.59285472701509*^9}, 3.594734516390349*^9, 3.594734556243181*^9},
 CellLabel->
  "In[1829]:=",ExpressionUUID->"be454336-54cd-45d6-8702-7b69b3d65247"],

Cell["Example: no faces or types.", "Text",
 CellChangeTimes->{{3.5924227554311953`*^9, 3.592422756173581*^9}, {
