c2428da44668"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pa", ",", "pb", ",", "pc", ",", "rm", ",", "of", ",", "pd"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"An", " ", "equilateral", " ", "triangle"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pa", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pc", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{
         SqrtBox["3"], "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TetrahedronVolumeSquared", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pa", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"pb", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"pc", ",", "1"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.768257671993744*^9, 3.768257676241584*^9}, {
  3.768257765250745*^9, 3.768257795125931*^9}, {3.768257885811385*^9, 
  3.768257989979898*^9}, {3.76825808642139*^9, 3.76825827202454*^9}, {
  3.768258606344486*^9, 3.768258692062169*^9}, {3.768658888016629*^9, 
  3.768658932771841*^9}, {3.768661289746488*^9, 3.768661307877692*^9}, {
  3.768661385049291*^9, 3.7686613932601027`*^9}},
 CellLabel->
  "In[651]:=",ExpressionUUID->"7e9adfda-2c89-487b-8887-60378156e151"],

Cell["\<\
Example. An impossible tetrahedron, which gives a negative value for the \
volume squared.\
\>", "Text",
