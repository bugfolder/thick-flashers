Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PolygonTile", ",", "verts_List"}], "}"}], ",", "Tiling", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tp", ",", "te", ",", "pt", ",", "et", ",", "ea", ",", "ci", ",", "vi", ",",
       "n", ",", "ctr", ",", "out", ",", "fill", ",", "edges"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tp", "=", 
      RowBox[{
       RowBox[{"TilePolys", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"te", "=", 
      RowBox[{
       RowBox[{"TileEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vi", "=", 
      RowBox[{
       RowBox[{"TileVertexIndices", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ea", "=", 
      RowBox[{
       RowBox[{"TileEdgeArrowStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pt", "=", 
      RowBox[{
       RowBox[{"TilePolyFill", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"et", "=", 
      RowBox[{
       RowBox[{"TileEdgeArrowDirs", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ci", "=", 
      RowBox[{
       RowBox[{"TileIndex", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolygonTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Plus", "@@", "verts"}], ")"}], "/", "n"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"verts", ",", 
         RowBox[{"RotateLeft", "[", "verts", "]"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"out", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "fill", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"tp", ",", "\[IndentingNewLine]", "True", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{"pt", "===", "None"}], ")"}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Polygon", "[", "verts", "]"}], ",", "pt"}], "]"}]}], 
          "]"}]}], "]"}], ",", "\[IndentingNewLine]", "False", ",", "Null", ",",
        "\[IndentingNewLine]", "_", ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"PolygonTile", "::", "badpolys"}], ",", "tp"}], "]"}], ";", 
        
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "lines", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"te", ",", "\[IndentingNewLine]", "True", ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"out", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", "#", "]"}], ",", "TilingLine"}], "]"}], 
           "&"}], "/@", "edges"}]}], "]"}], ",", "\[IndentingNewLine]", 
       "False", ",", "Null", ",", "\[IndentingNewLine]", "_", ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"PolygonTile", "::", "badedges"}], ",", "te"}], "]"}], ";", 
        
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "arrowheads", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ea", "===", "None"}], "||", 
          RowBox[{"et", "===", "None"}]}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "et", "]"}], "\[NotEqual]", 
           RowBox[{"Length", "[", "verts", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PolygonTile", "::", "badedgetypes"}], ",", 
             RowBox[{"Length", "[", "et", "]"}], ",", "et", ",", 
             RowBox[{"Length", "[", "verts", "]"}], ",", "verts"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "TileArrowDH", ",", "TileArrowCH", ",", "TileArrowDF", ",", 
               "TileArrowCF"}], "}"}], ",", "ea"}], "]"}], "\[Equal]", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PolygonTile", "::", "badedgearrows"}], ",", "ea"}], 
            "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"out", ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{"ea", ",", 
            RowBox[{"{", 
             RowBox[{"edges", ",", "et"}], "}"}]}], "]"}]}], "]"}]}]}], "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"tiling", " ", "index"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{"ci", "===", "None"}], ")"}]}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"out", ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"ToString", "[", "ci", "]"}], ",", "ctr"}], "]"}], ",", 
           "TilingText"}], "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"vertex", " ", "indices"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Switch", "[", 
      RowBox[{"vi", ",", "\[IndentingNewLine]", "True", ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"out", ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"ToString", "[", "j", "]"}], ",", 
               RowBox[{
                RowBox[{"0.8", " ", 
                 RowBox[{
                 "verts", "\[LeftDoubleBracket]", "j", 
                  "\[RightDoubleBracket]"}]}], "+", 
                RowBox[{"0.2", "ctr"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ",", "TilingText"}], 
          "]"}]}], "]"}], ",", "\[IndentingNewLine]", "False", ",", "Null", ",",
        "\[IndentingNewLine]", "_", ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"PolygonTile", "::", "badvertinds"}], ",", "vi"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "out"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.627579384777519*^9, 3.627579631633668*^9}, {
   3.627579680533101*^9, 3.627579725243022*^9}, {3.627580251758746*^9, 
   3.627580321681033*^9}, {3.627580360015982*^9, 3.627580381612289*^9}, {
   3.627580482176631*^9, 3.627580521669503*^9}, {3.627580571950482*^9, 
   3.627580583007924*^9}, {3.627580818074368*^9, 3.627580878311812*^9}, {
   3.627583054452585*^9, 3.627583121460037*^9}, {3.627583152738318*^9, 
   3.627583233460523*^9}, {3.627583488589439*^9, 3.627583589718841*^9}, {
   3.627583634301126*^9, 3.627583667565665*^9}, {3.627583728421949*^9, 
   3.627583819744194*^9}, {3.627583949926296*^9, 3.627584055507745*^9}, {
   3.627584106865614*^9, 3.627584109355378*^9}, {3.62758440250615*^9, 
   3.627584464265332*^9}, {3.627585615574963*^9, 3.627585668371848*^9}, {
   3.627587685161251*^9, 3.627587702564021*^9}, {3.627587960076891*^9, 
   3.62758796749794*^9}, {3.627588131054353*^9, 3.627588137264901*^9}, {
   3.6275881704237947`*^9, 3.627588209193858*^9}, {3.62758824714356*^9, 
   3.627588248910735*^9}, {3.62758836389203*^9, 3.627588387244619*^9}, {
   3.627588433508803*^9, 3.627588458496195*^9}, {3.627601265954591*^9, 
   3.627601280174436*^9}, {3.62765488153301*^9, 3.627654936676609*^9}, {
   3.629821021130869*^9, 3.629821034179411*^9}, {3.629822005829071*^9, 
   3.62982203628791*^9}, {3.62982219041642*^9, 3.629822207187111*^9}, 
   3.629822291775336*^9, 3.629823261483485*^9, {3.629823649313766*^9, 
   3.6298236744430027`*^9}, 3.629824058359066*^9, {3.629824121132962*^9, 
   3.629824156826989*^9}, {3.629824616478308*^9, 3.629824617749462*^9}, {
   3.629824728795181*^9, 3.62982491216109*^9}, {3.629824948447173*^9, 
   3.629825027219943*^9}, {3.629825308549834*^9, 3.629825315403901*^9}, 
   3.629839184964336*^9, 3.629839223151531*^9},
 CellLabel->
  "In[2858]:=",ExpressionUUID->"c6592874-9d0f-4b17-8715-f27aa03c3adb"],

Cell["Examples. Different fills.", "Text",
 CellChangeTimes->{{3.627579729029783*^9, 
  3.627579741573379*^9}},ExpressionUUID->"420dba34-3d21-4678-ad6d-\
e4921885a126"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
