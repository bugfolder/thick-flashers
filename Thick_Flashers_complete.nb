Cell[BoxData[
 RowBox[{
  RowBox[{"FacesAboveOld", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "md", ",", "sp", ",", "dedges", ",", "nf", ",", "apsp", ",", "fa", ",", 
      "aedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"md", "=", 
      RowBox[{
       RowBox[{"MaxDistance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FacesAboveOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FacesAboveOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dedges", "=", 
      RowBox[{"LocalFaceOrdering", "[", 
       RowBox[{"tobj", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "show", " ", "the", " ", "original", " ", "local", " ", "facet", " ", 
         "ordering", " ", "graph"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"GenericGraphGraphics", "[", 
            RowBox[{
             RowBox[{"FaceCentroids", "[", "tobj", "]"}], ",", "dedges", ",", 
             
             RowBox[{"{", "}"}], ",", 
             RowBox[{"DirectedEdges", "\[Rule]", "True"}], ",", 
             RowBox[{"EdgeColor", "\[Rule]", 
              RowBox[{"RGBColor", "[", 
               RowBox[{"0", ",", ".5", ",", "1"}], "]"}]}], ",", 
             RowBox[{"VertexLabels", "\[Rule]", "None"}]}], "]"}]}], "]"}], 
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nf", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Flatten", "[", "dedges", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"graph", " ", "distance", " ", "matrix"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"apsp", "=", 
      RowBox[{"GraphDistanceMatrix", "[", 
       RowBox[{"Graph", "[", "dedges", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"apsp", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "\[NotEqual]",
            "\[Infinity]"}], "&&", 
          RowBox[{
           RowBox[{"apsp", "\[LeftDoubleBracket]", 
            RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}], "\[NotEqual]",
            "\[Infinity]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"apsp", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "<", 
            RowBox[{"apsp", "\[LeftDoubleBracket]", 
             RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{
            RowBox[{"apsp", "\[LeftDoubleBracket]", 
             RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}], "=", 
            "\[Infinity]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"apsp", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], ">", 
            RowBox[{"apsp", "\[LeftDoubleBracket]", 
             RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{
            RowBox[{"apsp", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", 
            "\[Infinity]"}], ",", "\[IndentingNewLine]", "True", " ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"apsp", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             
             RowBox[{"apsp", "\[LeftDoubleBracket]", 
              RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}]}], " ", 
            "*)"}], ",", 
           RowBox[{
            RowBox[{"apsp", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", 
            RowBox[{
             RowBox[{"apsp", "\[LeftDoubleBracket]", 
              RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}], "=", 
             "\[Infinity]"}]}]}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{
          RowBox[{"Length", "[", "apsp", "]"}], "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"i", "+", "1"}], ",", 
         RowBox[{"Length", "[", "apsp", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"Flatten", "/@", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", "\[NotEqual]", "0"}], "&&", 
             RowBox[{"#1", "\[NotEqual]", "\[Infinity]"}], "&&", 
             RowBox[{"#1", "\[LessEqual]", "md"}]}], ",", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", "}"}]}], "]"}], "&"}], ",", 
         RowBox[{"Transpose", "[", "apsp", "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Show", " ", "a", " ", "sequence", " ", "of", " ", "graphs", " ", 
         "showing", " ", "which", " ", "faces", " ", "lie", " ", "above", " ",
          "each", " ", "face", " ", "in", " ", 
         RowBox[{"turn", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "aedges", " ", "are", " ", "edges", " ", "of", " ", "the", 
         " ", "\"\<above\>\"", " ", 
         RowBox[{"graph", ".", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "j"}], "}"}]}], " ", "means", " ", "i", " ", 
         "is", " ", "above", " ", 
         RowBox[{"j", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"aedges", "=", 
         RowBox[{"First", "/@", 
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#1", ",", 
               RowBox[{
               "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
               "}"}], "&"}], ",", "fa", ",", "2"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Show", " ", "which", " ", "facets", " ", "lie", " ", "above", " ", 
          "each", " ", "individual", " ", "facet", " ", "as", " ", "a", " ", 
          "series", " ", "of", " ", "graphs"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"GraphicsGrid", "[", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Show", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
                 RowBox[{"OrigamiStyle", "[", "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"GenericGraphGraphics", "[", 
                 RowBox[{
                  RowBox[{"FaceCentroids", "[", "tobj", "]"}], ",", "#", ",", 
                  
                  RowBox[{"{", "}"}], ",", 
                  RowBox[{"DirectedEdges", "\[Rule]", "True"}], ",", 
                  RowBox[{"EdgeColor", "\[Rule]", "Red"}]}], "]"}]}], "]"}], 
              "&"}], "/@", "aedges"}], ",", "3"}], "]"}], "]"}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "fa"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.484786326253853*^9, 3.484786342748155*^9}, {
   3.484786406528233*^9, 3.48478644563048*^9}, {3.48478648474772*^9, 
   3.484786507177395*^9}, {3.484786795412678*^9, 3.484786842686633*^9}, {
   3.4847869221606817`*^9, 3.484786927671123*^9}, {3.484786958680599*^9, 
   3.484786989285892*^9}, {3.484787091537936*^9, 3.484787205361479*^9}, {
   3.484787252102021*^9, 3.484787259022457*^9}, {3.484787299566062*^9, 
