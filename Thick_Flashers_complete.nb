Cell[CellGroupData[{

Cell[TextData[{
 "MakeTriangleGraphReciprocalDiagram[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) ",
 "TPrimalDualGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.465946966758595*^9, 3.465947022162807*^9}, {
   3.5917357931378603`*^9, 3.59173580262549*^9}, 3.5917358487571583`*^9, {
   3.591736060097122*^9, 3.59173606047604*^9}, 3.592208598698492*^9, {
   3.592239600845504*^9, 3.592239604282207*^9}, 3.592402536374793*^9, {
   3.592433143086439*^9, 3.592433143820228*^9}, 
   3.5928288066704197`*^9},ExpressionUUID->"32198a5b-977c-4904-8234-\
419749cd4612"],

Cell[TextData[{
 "MakeTriangleGraphReciprocalDiagram[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TPrimalDualGraph that is a triangle graph and returns a modified ",
 "TPrimalDualGraph",
 " with a new DualVertices embedding that is a reciprocal diagram where the \
dual vertices are the circumcenters (intersection of perpendicular bisectors \
of the three sides) of each triangle."
}], "Text",
 CellChangeTimes->{{3.465947026618877*^9, 3.465947062079723*^9}, {
   3.465947192272917*^9, 3.4659471946313*^9}, {3.46594730700132*^9, 
   3.465947323358424*^9}, {3.485220624264331*^9, 3.485220624992423*^9}, {
   3.591736074756412*^9, 3.591736129099133*^9}, 3.592208598792857*^9, {
   3.592403428075536*^9, 3.5924034588701353`*^9}, {3.592403583774121*^9, 
   3.592403588162422*^9}, {3.592828806770274*^9, 
   3.5928288068620663`*^9}},ExpressionUUID->"d5b5e539-4d1d-4aec-ae33-\
0547304fc9bb"],

Cell["\<\
Note that this guarantees orthogonality of the dual edges but does not \
guarantee non-crossing edges/strict positivity of dual edge signed lengths. \
See the examples for a graph with 2 embeddings where one gives rise to a \
crossing dual and the other doesn't.\
\>", "Text",
 CellChangeTimes->{{3.466094925075738*^9, 3.46609497016055*^9}, {
   3.466095029276586*^9, 3.466095075481483*^9}, {3.466096672232215*^9, 
   3.4660966991247177`*^9}, {3.466098369277372*^9, 3.46609838682753*^9}, 
   3.591736145577949*^9, {3.592403466029759*^9, 
   3.592403488669141*^9}},ExpressionUUID->"c9da0b7d-c070-4a9d-9e86-\
b0450d93e2da"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTriangleGraphReciprocalDiagram", "::", "nottg"}], 
   "=", "\"\<Graph `1` with faces `2` does not consist entirely of triangles.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.465947811690912*^9, 3.4659478404541273`*^9}, {
   3.48406560505621*^9, 3.4840656069826603`*^9}, {3.59178959598629*^9, 
   3.591789609336409*^9}, 3.592208598813068*^9},
 CellLabel->
  "In[1516]:=",ExpressionUUID->"5a1d4e7d-f6fb-41ba-a0f9-6677b8bd2ae8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTriangleGraphReciprocalDiagram", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj1", ",", "dverts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{
      "tobj", ",", "TPrimalDualGraph", ",", 
       "MakeTriangleGraphReciprocalDiagram"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"TriangleGraphQ", "[", "tobj", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTriangleGraphReciprocalDiagram", "::", "nottg"}], ",", 
          "tobj", ",", 
          RowBox[{"GetValues", "[", 
           RowBox[{"tobj", ",", "Faces"}], "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{"FaceCircumcenters", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"DualVertices", "\[Rule]", "dverts"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.465947769283518*^9, 3.465947804035229*^9}, {
