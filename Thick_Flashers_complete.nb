        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "12"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "12"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
