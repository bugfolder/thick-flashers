   3.673176147670927*^9}, {3.673176204189081*^9, 3.673176233836879*^9}, {
   3.673176349639629*^9, 3.673176450257625*^9}, 3.673176621862266*^9, {
   3.67317667025585*^9, 3.673176678021984*^9}, {3.673176737648309*^9, 
   3.673176759644425*^9}, {3.673176797088446*^9, 3.673176809769655*^9}, {
   3.673176872468493*^9, 3.673176970172101*^9}, {3.673186273548567*^9, 
   3.673186307518785*^9}, {3.701092747214242*^9, 3.701092748067473*^9}},
