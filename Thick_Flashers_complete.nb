 CellChangeTimes->{{3.701204909153995*^9, 3.701204916681572*^9}, {
   3.701281246734653*^9, 3.701281254735346*^9}, {3.701282276976362*^9, 
   3.7012823004487*^9}, {3.701282479288782*^9, 3.701282485057735*^9}, 
   3.701294713820203*^9, {3.70129478040493*^9, 3.701294798405452*^9}, {
   3.701470175946821*^9, 3.7014701985231733`*^9}, {3.702587549442687*^9, 
   3.702587553249831*^9}},ExpressionUUID->"55b1681a-4f02-49f7-8e9e-\
bc1b1198ea94"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nx", ",", "ny", ",", "tobj", ",", "verts3d"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nx", "=", "5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ny", "=", "5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tobj", "=", 
       RowBox[{"MakeWaterbombTessellation", "[", 
        RowBox[{"nx", ",", "ny", ",", "0.95"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verts3d", "=", 
       RowBox[{"GetValue", "[", 
        RowBox[{"tobj", ",", "Vertices3D"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
           RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}], "//", 
       "Print"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tobj", "=", 
       RowBox[{"StrainTQMesh", "[", 
        RowBox[{"tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"(*", " ", 
           RowBox[{
           "constrain", " ", "two", " ", "vertices", " ", "to", " ", "their", 
            " ", "original", " ", "position"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"VertexPointEqualityConstraints", "[", 
            RowBox[{"9", ",", 
             RowBox[{
             "verts3d", "\[LeftDoubleBracket]", "9", 
              "\[RightDoubleBracket]"}]}], "]"}], ",", "\[IndentingNewLine]", 
           
           RowBox[{"VertexPointEqualityConstraints", "[", 
            RowBox[{"13", ",", 
             RowBox[{
             "verts3d", "\[LeftDoubleBracket]", "13", 
              "\[RightDoubleBracket]"}]}], "]"}], ",", "\[IndentingNewLine]", 
           
           RowBox[{"(*", " ", 
            RowBox[{
            "stretch", " ", "two", " ", "vertices", " ", "away", " ", "from", 
             " ", "their", " ", "original", " ", "position"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"VertexPointEqualityConstraints", "[", 
            RowBox[{"84", ",", 
             RowBox[{
              RowBox[{
              "verts3d", "\[LeftDoubleBracket]", "84", 
               "\[RightDoubleBracket]"}], "-", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"VertexPointEqualityConstraints", "[", 
            RowBox[{"87", ",", 
             RowBox[{
              RowBox[{
              "verts3d", "\[LeftDoubleBracket]", "87", 
               "\[RightDoubleBracket]"}], "-", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "]"}]}], "}"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"QuadBendStiffness", "\[Rule]", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FlatFoldStiffness", "\[Rule]", "1"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SplitBentFaces", "\[Rule]", "False"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MatrixTransform", "[", 
           RowBox[{
            RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], ",", 
            RowBox[{"RotationXMatrix3D", "[", "\[Pi]", "]"}]}], "]"}]}], 
         "}"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
    "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.70118845662135*^9, 3.701188487230049*^9}, {
   3.701188874594217*^9, 3.701188904770884*^9}, 3.70118919961233*^9, {
   3.70120359295788*^9, 3.701203603904728*^9}, {3.701204800376079*^9, 
   3.701204823049901*^9}, {3.701204853233423*^9, 3.701204862881791*^9}, {
   3.701204983610344*^9, 3.701205157549301*^9}, 3.701209124073041*^9, {
   3.701209166224297*^9, 3.701209255943691*^9}, {3.70128067460015*^9, 
   3.701280680715117*^9}, {3.701280848420452*^9, 3.701280934293941*^9}, {
   3.70128105785424*^9, 3.701281058206202*^9}, {3.70128111567236*^9, 
   3.701281118751049*^9}, {3.701281271937332*^9, 3.70128127340278*^9}, {
   3.701281578617796*^9, 3.701281578645871*^9}, {3.701281928812323*^9, 
   3.701281943584133*^9}, {3.701282309617336*^9, 3.701282392617448*^9}, {
   3.701282444194674*^9, 3.701282464738982*^9}, 3.701282532555393*^9, {
   3.701282657629785*^9, 3.701282660437454*^9}, 3.701282791765935*^9, {
   3.701294589932279*^9, 3.701294617124204*^9}, {3.70129466507721*^9, 
   3.701294683590665*^9}, {3.701294755029557*^9, 3.701294755429169*^9}, {
   3.701383879533505*^9, 3.701383915842657*^9}, {3.701469679058064*^9, 
   3.701469839635796*^9}, {3.701469883404063*^9, 3.701469949379121*^9}, {
   3.701470124005989*^9, 3.701470171531683*^9}, {3.701470204980834*^9, 
   3.701470205411903*^9}, {3.701470338433177*^9, 3.701470378644132*^9}, {
   3.701639733042961*^9, 3.701639734865341*^9}, {3.702586382686511*^9, 
   3.702586413597061*^9}, {3.70258723742435*^9, 3.702587261521475*^9}},
 CellLabel->
