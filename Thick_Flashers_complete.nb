Cell[TextData[{
 "FaceCircumcenters[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a ",
 "TGraph",
 " and returns a list of the circumcenters for all of the faces of the plane \
graph."
}], "Text",
