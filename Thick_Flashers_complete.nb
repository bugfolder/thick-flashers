 CellLabel->
  "In[579]:=",ExpressionUUID->"dca9649c-23d2-47a1-a58b-8d86087503cf"],

Cell["\<\
Here\[CloseCurlyQuote]s the example used in the book, which shows the linear \
equation satisfied by the 4th point.\
\>", "Text",
 CellChangeTimes->{{3.5337509282075*^9, 
  3.533750956723648*^9}},ExpressionUUID->"1873ab62-b32e-4d30-b25d-\
