     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "vva", ",", "vfi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices2D", ",", "VertexVertexAdjacency", ",", 
          "VertexFaceIncidence"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{
          "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
           "i1"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"SingleVertexEdgeAngles2D", "::", "badedge"}], ",", "i1", ",",
           "i0"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"va", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"AbsoluteAngle", "[", 
         RowBox[{
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}], 
         "]"}], "&"}], "/@", 
       RowBox[{
       "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vfa", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"Subtract", "@@", "#"}], ",", 
           RowBox[{"2", "\[Pi]"}], ",", 
           RowBox[{"-", "\[Pi]"}]}], "]"}], "]"}], "&"}], "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RotateLeft", "[", "va", "]"}], ",", "va"}], "}"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vfa", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#1", "\[Equal]", "0"}], ",", "Null", ",", "#2"}], "]"}], 
         "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "vfi", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
           "vfa"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"RotateLeft", "[", 
      RowBox[{"vfa", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{
           "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
            "i1", ",", "1", ",", "1"}], "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5952692332514553`*^9, 3.595269274081085*^9}, {
   3.59526936909868*^9, 3.595269442720821*^9}, {3.595269487191053*^9, 
