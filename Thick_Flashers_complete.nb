  3.594686593387146*^9}},ExpressionUUID->"a78a1603-4a76-4ae0-abc9-\
78450ae60840"],

Cell["\<\
Vertices2D is a property that gives a 2D embedding of the vertices of a \
TGraph.\
\>", "Text",
 CellChangeTimes->{{3.5946866048105917`*^9, 
  3.5946866196656437`*^9}},ExpressionUUID->"09c3a416-0dc5-4889-bb62-\
cbdcf4d13310"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Vertices2D", "::", "usage"}], 
   "=", "\"\<Vertices2D is a TObj property that specifies a 2D embedding of \
the vertices of a graph.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59237727961279*^9, 3.592377307622538*^9}, 
   3.592435744246968*^9, 3.594229125361625*^9, {3.594686631310248*^9, 
