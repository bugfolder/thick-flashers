              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"b", ",", "d", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
