                   RowBox[{
                   "verts", "\[LeftDoubleBracket]", "#2", 
                    "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], "/", 
               "\[Degree]"}]}], "}"}], "&"}], ",", 
           RowBox[{"{", 
