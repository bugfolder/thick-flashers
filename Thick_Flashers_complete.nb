  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TwistFoldedFormLines", "[", "tobj", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Darker", "[", "Red", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"StdVertexLabels", "[", "verts", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"StdEdgeLabels", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}]}]}], "}"}]}]}], 
   "]"}]}]], "Input",
