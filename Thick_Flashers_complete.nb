Cell[TextData[{
 "Example -- 3D solid arrow using built-in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " primitives."
}], "Text",
 CellChangeTimes->{{3.591799088597356*^9, 3.5917991013321447`*^9}, {
