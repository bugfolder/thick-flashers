      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts2", ",", "edges2", ",", "faces2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mgdata", "=", 
      RowBox[{"MergeGraphsData", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tobj1", ",", "tobj2"}], "}"}], ",", 
        RowBox[{"KillMergedEdges", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<vlist = \>\"", ",", 
       RowBox[{
       "mgdata", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
