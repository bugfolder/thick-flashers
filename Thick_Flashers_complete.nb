Cell[TextData[{
 "RenderTile[{PolygonTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, Tiling, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]",
 " returns a rendering of the tiling polygon with no additional decoration."
}], "Text",
 CellChangeTimes->{{3.62982656442409*^9, 3.6298265729637203`*^9}, {
   3.629839528252887*^9, 3.629839551026307*^9}, {3.6300183713449717`*^9, 
