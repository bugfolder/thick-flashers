Cell[CellGroupData[{

Cell[TextData[{
 "MakeRectangularPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Rho], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) SamePtTolerance, TypeMinimumAngle, PotGapHalfAngle, \
PotFlatFlangeInset, PotFlangeExcess, PotPanels"
}], "Subsubsection",
 CellChangeTimes->{{3.594664866675481*^9, 3.594664877002656*^9}, 
   3.594665129820487*^9, 3.6152448059487543`*^9, 3.617903689960415*^9, {
   3.650062135301036*^9, 3.650062158116104*^9}, {3.650111572084089*^9, 
   3.650111603745524*^9}, {3.6503056776284647`*^9, 3.650305688035038*^9}, {
   3.651516849122143*^9, 3.651516875502687*^9}, {3.651516948244865*^9, 
   3.651516957001947*^9}, {3.651517007094436*^9, 
   3.651517008638268*^9}},ExpressionUUID->"fe0ee3cd-ee9b-4ab6-80f1-\
7c8f61efe616"],

Cell[TextData[{
 "MakeRadialPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Rho]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " defining a cross-section of a rotational pot with ",
 StyleBox["m",
  FontSlant->"Italic"],
 "-fold rotational symmetry and asymmetry factor ",
 StyleBox["\[Rho]",
  FontSlant->"Italic"],
 " and returns a TGraph3D+TAssigned containing graphs and graphics of the \
full pot, both crease pattern and folded form. Options are:\n\t\
SamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is passed through to JoinGraph3DAssigneds.\n\tTypeMinimumAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "min"], TraditionalForm]],ExpressionUUID->
  "0f55a0fd-d49f-47db-991b-320dd0836948"],
 ", specifies the minimum fold angle that is assigned M or V. This is useful \
when we have very shallow angles going up the gores. This options is passed \
through to FoldAngleToType.\n\tPotGapHalfAngle \[Rule] \[Delta], specifies \
the half-angle of the gap between the seams along the inner edges of the pot. \
Note that if the gap angle is nonzero, there may not be a solution for \
asymmetric \[Rho]. In particular, for flat-bottomed cases, there is no \
solution except for \[Rho] \[Rule] 0.\n\tPotFlatFlangeInset \[Rule] \
\[Epsilon], specifies a fractional inset toward the z-axis to be applied to \
the vertices on the inside of a flat flange version (\[Rho] = -1 or 1). This \
makes the renderer happy when rendering the 3D version, because it avoids \
coplanar facets.\n\tPotFlangeExcess \[Rule] ",
 StyleBox["fe",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["fe",
  FontSlant->"Italic"],
 " is the proportional increase in flange width relative to the widest part \
of the gore.\n\tPotPanels \[Rule] Automatic | ",
 StyleBox["m0",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["m0",
  FontSlant->"Italic"],
 " is the number of panels to create and Automatic creates ",
 StyleBox["m",
  FontSlant->"Italic"],
 " panels."
}], "Text",
 CellChangeTimes->{{3.594665135527061*^9, 3.594665206055439*^9}, 
   3.594734831653553*^9, 3.5947401785068274`*^9, 3.594741497940013*^9, 
   3.5952005312697883`*^9, 3.5952008342465*^9, {3.615244789283941*^9, 
   3.615244810594271*^9}, {3.650062139404431*^9, 3.6500621461885777`*^9}, {
   3.650063594127289*^9, 3.650063612950471*^9}, {3.650111606953057*^9, 
   3.650111673954608*^9}, {3.650305709579714*^9, 3.650305715480356*^9}, 
   3.651516937609424*^9, {3.651516990176169*^9, 3.65151701254073*^9}, {
   3.65151704616477*^9, 
   3.6515170695879717`*^9}},ExpressionUUID->"88a3455f-270f-4aae-821d-\
30f44aef36dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PotPanels", "::", "usage"}], 
   "=", "\"\<PotPanels is an option to MakeRectangularPot that specifies the \
number of panel to use when creating a partial pot.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.65151701446344*^9, 3.651517038518651*^9}},
 CellLabel->
