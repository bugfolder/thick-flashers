Cell["Same example, but now kill doubled edges.", "Text",
 CellChangeTimes->{{3.594663884595607*^9, 3.594663890738531*^9}, {
  3.70778258306671*^9, 
  3.707782598042613*^9}},ExpressionUUID->"d92949e6-d31e-4691-9fe1-\
d85f6bd325f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts1", ",", "edges1", ",", "faces1", ",", "tobj1", ",", "verts2", ",",
       "edges2", ",", "faces2", ",", "tobj2", ",", "vlist", ",", "elist", ",",
       "tobj", ",", "tglist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{".1", ",", ".1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".9", ",", ".1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".2", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces1", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts1", ",", "edges1", ",", "faces1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{".1", ",", ".2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".9", ",", ".2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces2", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts2", ",", "edges2", ",", "faces2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"JoinGraphs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tobj1", ",", 
            RowBox[{"{", "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"tobj2", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3"}], "}"}]}], "}"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"KillMergedEdges", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj1", ",", 
          RowBox[{"Axes", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj2", ",", 
          RowBox[{"Axes", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"Axes", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Joined\>\""}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594663894798616*^9, 3.594664130749181*^9}, {
   3.594664326661407*^9, 3.5946643368284073`*^9}, {3.594664401025264*^9, 
   3.594664414552273*^9}, 3.594664465127211*^9, {3.594664571710458*^9, 
   3.594664584367658*^9}, {3.594734253872629*^9, 3.594734253936652*^9}, 
   3.594928983200805*^9, {3.594929553011519*^9, 3.59492957052628*^9}, 
   3.594929639244863*^9, {3.594930803983424*^9, 3.594930810447532*^9}, {
   3.649947777172954*^9, 3.6499479128268013`*^9}, {3.6499479746955748`*^9, 
   3.649948020555382*^9}, {3.649950019220883*^9, 3.649950110454463*^9}, {
   3.649950486624154*^9, 3.649950496532032*^9}, 3.649950584899262*^9, {
   3.649950626055945*^9, 3.6499506592912207`*^9}, {3.649950761257044*^9, 
   3.649950768989776*^9}, {3.649963904556161*^9, 3.649963914603196*^9}, {
   3.6764771829686823`*^9, 3.676477201799047*^9}, {3.707782603146025*^9, 
   3.707782627742523*^9}, 3.70782380403118*^9, 3.7078247699035*^9, 
   3.707905239875286*^9},
 CellLabel->
  "In[1240]:=",ExpressionUUID->"15f4d753-b752-4741-899f-2af8dfd83d8f"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["TGraph collinear cleanup", "Subsection",
 CellChangeTimes->{{3.70784320221085*^9, 3.70784322162711*^9}, {
  3.707912002687207*^9, 3.707912005310281*^9}, {3.7079127473263507`*^9, 
  3.707912751893696*^9}},ExpressionUUID->"c7669c46-82a0-4106-8450-\
fe15ddd5cd20"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.707843519260584*^9, 
  3.707843520141758*^9}},ExpressionUUID->"7fafc33e-8810-4c65-b763-\
795d325bd56e"],

Cell["\<\
Merging graphs with KillMergedEdges \[Rule] True can leave degree-2 vertices \
between collinear line segments, which can cause problems with routines that \
require strict convexity of faces. The functions here reduce the graph by \
eliminating degree-2 vertices whose incident edges are collinear. \
\>", "Text",
 CellChangeTimes->{{3.707843238729054*^9, 3.707843320443677*^9}, {
  3.707843471220401*^9, 3.707843514981573*^9}, {3.707861812737171*^9, 
  3.707861814700119*^9}},ExpressionUUID->"93b58ea2-c88a-4500-a833-\
102c4e3bf963"],

Cell["\<\
The functions ApplyCollinearCleanup[To] are helper functions that you will \
not usually call. Instead, you should call CollinearCleanupGraph or the \
analogous calls for subclasses.\
\>", "Text",
 CellChangeTimes->{{3.707859197570978*^9, 3.7078592726099997`*^9}, {
  3.707861826089618*^9, 3.707861827113546*^9}, {3.707912686412857*^9, 
  3.707912707605459*^9}},ExpressionUUID->"f90d2c58-cd13-4d66-9d75-\
3d7d27eedd8b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "CollinearCleanupData[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph\n\t(options) CollinearTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.7078433683642883`*^9, 3.707843453580133*^9}, {
   3.7078435240772667`*^9, 3.707843535974097*^9}, {3.70785230881281*^9, 
   3.70785230985244*^9}, {3.707852495061372*^9, 3.7078524955748177`*^9}, 
   3.707859288278899*^9},ExpressionUUID->"858b6cb2-4fae-4663-bc63-\
87d5c50b4b4f"],

Cell[TextData[{
 "CollinearCleanupData[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a list of data that describes how a new TGraph \
should be constructed from the old TGraph with all collinear degree-2 \
vertices removed. "
}], "Text",
 CellChangeTimes->{{3.707843669233399*^9, 3.707843705887328*^9}, {
   3.707852311418717*^9, 3.707852384677359*^9}, 3.707852499570457*^9, 
   3.707859288330082*^9, 
   3.707859327170901*^9},ExpressionUUID->"5939cf2c-5be3-41c0-82e7-\
6c705404f310"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph being reduced."
}], "Text",
 CellChangeTimes->{{3.707843707838018*^9, 
  3.707843755815661*^9}},ExpressionUUID->"7f08ee28-7bb9-44fb-ab38-\
7fba01a113c8"],

Cell[TextData[{
 "Options:\n\tCollinearTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", specifies the angle below which two edges at a degree-2 vertex will be \
considered to be collinear."
}], "Text",
 CellChangeTimes->{{3.707843759583011*^9, 
  3.707843797007491*^9}},ExpressionUUID->"093fb2da-7548-4bb6-9615-\
af4e480ea772"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["vlist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["elist",
  FontSlant->"Italic"],
 "} where\n\t",
 StyleBox["vlist",
  FontSlant->"Italic"],
 " is a list of indices, where ",
 StyleBox["vlist",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[RightDoubleBracket] \[Equal]",
 StyleBox["j",
  FontSlant->"Italic"],
 " means that vertex ",
 StyleBox["i",
  FontSlant->"Italic"],
 " in the new graph should be vertex ",
 StyleBox["j",
  FontSlant->"Italic"],
 " in the old graph.\n\t",
 StyleBox["elist",
  FontSlant->"Italic"],
 " is list of lists, where ",
 StyleBox["elist",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[RightDoubleBracket]\[Equal]{",
 StyleBox["j}",
  FontSlant->"Italic"],
 " or {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "} means that edge ",
 StyleBox["i",
  FontSlant->"Italic"],
 " in the new graph should be composed of edge ",
 StyleBox["j",
  FontSlant->"Italic"],
 " or the collapse of edges {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "} in the old graph."
}], "Text",
 CellChangeTimes->{{3.707843802951194*^9, 3.7078438436892643`*^9}, {
  3.707844019089117*^9, 3.707844065666017*^9}, {3.707844112594449*^9, 
  3.707844319501901*^9}, {3.707852388653431*^9, 3.7078523987820067`*^9}, {
  3.707852437693622*^9, 3.707852460062568*^9}, {3.707852553775464*^9, 
  3.707852555998111*^9}, {3.707852592966948*^9, 
  3.707852633710973*^9}},ExpressionUUID->"d949399c-5824-4858-9028-\
5f2fdcf2d3d4"],

Cell[TextData[{
 "While the return list could potentially handle collapsing multiple \
collinear segments into a single segment, we don\[CloseCurlyQuote]t implement \
that functionality yet. So only use this on patterns with at most two \
collinear segment, so that the lists in ",
 StyleBox["elist",
  FontSlant->"Italic"],
 " will be of length 1 or 2."
}], "Text",
 CellChangeTimes->{{3.707844327452297*^9, 3.707844377909257*^9}, {
  3.707844422316729*^9, 
  3.707844437557071*^9}},ExpressionUUID->"458c9075-23d9-4bb0-b86e-\
0a35c4324953"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CollinearTolerance", "::", "usage"}], 
   "=", "\"\<CollinearTolerance is an option to CollinearCleanupData that \
specifies the angle between two lines below which they are taken to be \
collinear.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.707843546549214*^9, 3.707843593104017*^9}, {
   3.707852481566777*^9, 3.707852491999198*^9}, 3.707859288349992*^9},
 CellLabel->
  "In[1241]:=",ExpressionUUID->"ca012329-fbc1-4966-8735-2fec75baaba4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CollinearCleanupData", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"CollinearTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.707843596217825*^9, 3.707843621854526*^9}, 
   3.707859288376176*^9, {3.707865898983961*^9, 3.707865906712545*^9}},
 CellLabel->
  "In[1242]:=",ExpressionUUID->"64fbbd9d-877f-41e2-a49d-befe6f586bf5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CollinearCleanupData", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ct", ",", "sct", ",", "verts", ",", "edges", ",", "fe", ",", "d2vs", ",",
       "epair", ",", "rpair", ",", "vr", ",", "j1", ",", "j2", ",", "erep", ",",
       "iedges", ",", "nverts", ",", "vlist", ",", "vm", ",", "elist", ",", 
      "nedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "CollinearCleanupData"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ct", "=", 
      RowBox[{
       RowBox[{"CollinearTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CollinearCleanupData", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sct", "=", 
      RowBox[{"Sin", "[", "ct", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"get", " ", "indices", " ", "of", " ", "all", " ", "degree"}], 
       "-", 
       RowBox[{"2", " ", "vertices"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fe", "=", 
      RowBox[{"Flatten", "[", "edges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d2vs", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Count", "[", 
              RowBox[{"fe", ",", "i"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]",
            "2"}], "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "which", " ", "vertices", " ", "to", " ", "absorb", " ",
        "and", " ", "their", " ", "incident", " ", "edges"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"iedges", "=", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", 
           RowBox[{
           "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "}"}], "&"}], ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"epair", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"iedges", ",", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
              RowBox[{
              "d2vs", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}]}], "]"}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rpair", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Normalize", "[", 
            RowBox[{"Subtract", "@@", 
             RowBox[{"verts", "\[LeftDoubleBracket]", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}]}], "]"}], "&"}], "/@", "epair"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
             "rpair", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             ".", 
             RowBox[{"Rotate90", "[", 
              RowBox[{
              "rpair", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
               "]"}]}], "]"}], "<", "sct"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"vr", "=", 
            RowBox[{
            "d2vs", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
           ";", 
           RowBox[{"(*", " ", 
            RowBox[{"vertex", " ", "to", " ", "remove"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"j1", "=", 
            RowBox[{"epair", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"edge", " ", "to", " ", "replace"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"j2", "=", 
            RowBox[{"epair", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"edge", " ", "to", " ", "remove"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"erep", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{"First", "/@", "epair"}], "]"}], ",", 
              RowBox[{
               RowBox[{"#", "\[NotEqual]", "vr"}], "&"}]}], "]"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"replacement", " ", "edge"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "verts", "\[LeftDoubleBracket]", "vr", "\[RightDoubleBracket]"}], 
            "=", "Null"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "edges", "\[LeftDoubleBracket]", "j1", "\[RightDoubleBracket]"}], 
            "=", 
            RowBox[{"{", 
             RowBox[{"Null", ",", "True", ",", 
              RowBox[{"{", 
               RowBox[{"j1", ",", "j2"}], "}"}], ",", "erep"}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "edges", "\[LeftDoubleBracket]", "j2", "\[RightDoubleBracket]"}], 
            "=", 
            RowBox[{"{", 
             RowBox[{"Null", ",", "False"}], "}"}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "d2vs", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"build", " ", "new", " ", "list", " ", "of", " ", "vertices"}],
        ",", " ", 
       RowBox[{"vlist", " ", 
        RowBox[{"(", 
         RowBox[{"new", "\[Rule]", "old"}], ")"}], " ", "and", " ", "vm", " ", 
        RowBox[{"(", 
         RowBox[{"old", "\[Rule]", "new"}], ")"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{"vlist", "=", 
       RowBox[{"{", "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{
           RowBox[{
           "verts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "===",
            "Null"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"nverts", ",", 
            RowBox[{
            "verts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"vlist", ",", "i"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"vm", "[", "i", "]"}], "=", 
           RowBox[{"Length", "[", "nverts", "]"}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "new", " ", "list", " ", "of", " ", "edges", " ", "and", " ",
        "elist"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"elist", "=", 
       RowBox[{"{", "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{
           RowBox[{"edges", "\[LeftDoubleBracket]", 
            RowBox[{"j", ",", "1"}], "\[RightDoubleBracket]"}], "===", 
           "Null"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"nedges", ",", 
            RowBox[{
            "edges", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}],
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"elist", ",", 
            RowBox[{"{", "j", "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"edges", "\[LeftDoubleBracket]", 
            RowBox[{"j", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"elist", ",", 
              RowBox[{"edges", "\[LeftDoubleBracket]", 
               RowBox[{"j", ",", "3"}], "\[RightDoubleBracket]"}]}], "]"}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"nedges", ",", 
              RowBox[{"edges", "\[LeftDoubleBracket]", 
               RowBox[{"j", ",", "4"}], "\[RightDoubleBracket]"}]}], 
             "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"re", "-", 
       RowBox[{
       "map", " ", "new", " ", "edges", " ", "to", " ", "new", " ", 
        "vertices"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"vm", ",", "nedges", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"vlist", ",", "elist"}], "}"}]}]}], "]"}]}]], "Input",
