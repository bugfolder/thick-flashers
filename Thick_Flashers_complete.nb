Cell["Example. Match two circles of differing radii.", "Text",
 CellChangeTimes->{{3.691581530314789*^9, 3.691581531264145*^9}, {
  3.691593014090735*^9, 
  3.6915930211024446`*^9}},ExpressionUUID->"10a17e4e-6c98-4035-9609-\
7ece07df2601"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "u0", ",", "u1", ",", "s", ",", "c1", ",", "sd1", ",", "c2", ",", "sd2", 
      ",", "c3", ",", "sd3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c1", "=", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd1", "=", 
      RowBox[{"CurveSpeed", "[", "c1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c1 = \>\"", ",", "c1"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c2", "=", 
      RowBox[{
       RowBox[{"3", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd2", "=", 
      RowBox[{"CurveSpeed", "[", "c2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c2 = \>\"", ",", "c2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c3", "=", 
      RowBox[{"NMatchCurveSpeed", "[", 
       RowBox[{"c1", ",", "c2", ",", "0", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd3", "=", 
      RowBox[{"NCurveSpeed", "[", 
       RowBox[{"c3", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c3 = \>\"", ",", "c3"}], "]"}], ";", "\[IndentingNewLine]", 
