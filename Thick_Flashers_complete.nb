Cell[CellGroupData[{

Cell[TextData[{
 "UnitTriangleOffsetTwistAngle[",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "]\nUnitTriangleOffsetTwistOffset[",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha]]"
}], "Subsubsection",
 CellChangeTimes->{{3.45774623147645*^9, 3.457746235273218*^9}, {
   3.6273396760708933`*^9, 3.62733967617743*^9}, 3.627345724948496*^9, 
   3.6273457967319326`*^9, 3.627385975970557*^9, {3.6274035573887377`*^9, 
   3.627403557497066*^9}, {3.62740359863769*^9, 3.627403598779957*^9}, {
   3.627403805254112*^9, 3.627403811543359*^9}, 3.627405248049011*^9, 
   3.627405392863117*^9},ExpressionUUID->"90d23b07-c544-48aa-ac85-\
1414c37fa32a"],

Cell[TextData[{
 "UnitTriangleOffsetTwistAngle[",
 StyleBox["angles, w, d",
  FontSlant->"Italic"],
 "] returns the twist angle \[Alpha] for a unit polygon offset twist triangle \
with angles ",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", pleat width ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", and offset ",
 StyleBox["d",
  FontSlant->"Italic"],
 ". This is only valid for positive ",
 StyleBox["w",
  FontSlant->"Italic"],
 " (i.e., parameters of the crease form)."
}], "Text",
 CellChangeTimes->{{3.457746247244007*^9, 3.457746248393016*^9}, 
   3.627339676290949*^9, 3.627345725077775*^9, 3.627345796828601*^9, 
   3.627385975971027*^9, 3.627403557599204*^9, {3.6274035989176707`*^9, 
   3.62740359905608*^9}, {3.627403706732779*^9, 
   3.627403709507372*^9}},ExpressionUUID->"132fed7e-7b78-4ab2-9c46-\
fad3bb38e54a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTriangleOffsetTwistAngle", "[", 
   RowBox[{"angles_", ",", "w_", ",", "d_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "}"}], "=", 
      "angles"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ArcTan", "[", 
      RowBox[{
       FractionBox["w", 
        RowBox[{"2", "d"}]], 
       FractionBox[
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]1", "]"}], 
         RowBox[{"Sin", "[", "\[Theta]2", "]"}], 
         RowBox[{"Sin", "[", "\[Theta]3", "]"}]}], 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]1", "]"}], 
          RowBox[{"Cos", "[", "\[Theta]2", "]"}], 
          RowBox[{"Cos", "[", "\[Theta]3", "]"}]}]}]]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.627339676322954*^9, 3.627345725124464*^9, 3.627345796856303*^9, 
   3.627385975971443*^9, 3.627403557632167*^9, {3.627403599127737*^9, 
   3.6274035991582336`*^9}, {3.627403802046723*^9, 3.627403802552112*^9}, {
   3.627404232883273*^9, 3.627404238235505*^9}, {3.627404295320256*^9, 
   3.627404295793174*^9}, 3.6274052392127666`*^9, {3.627405300984668*^9, 
   3.627405321351832*^9}, {3.627406286218417*^9, 3.627406287410798*^9}, {
   3.6286298368895*^9, 3.6286298863635883`*^9}},
 CellLabel->
  "In[3028]:=",ExpressionUUID->"227d85dd-45da-49b0-bafb-cada14958851"],

Cell["Example", "Text",
 CellChangeTimes->{{3.628629896610076*^9, 
  3.62862989732752*^9}},ExpressionUUID->"946a2b3d-1fbe-4b51-9799-\
0b85cb311a2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTriangleOffsetTwistAngle", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"50", "\[Degree]"}], ",", 
      RowBox[{"60", "\[Degree]"}], ",", 
      RowBox[{"70", "\[Degree]"}]}], "}"}], ",", ".09", ",", ".06"}], "]"}], "/",
   "\[Degree]"}]], "Input",
 CellChangeTimes->{{3.628629150961452*^9, 3.6286292240282383`*^9}, {
  3.6286299045883617`*^9, 3.628629928088257*^9}},
 CellLabel->
  "In[3029]:=",ExpressionUUID->"429b7924-0b19-4e07-9c4b-8ffd51d6af34"],

Cell[TextData[{
 "UnitTriangleOffsetTwistOffset[angles,",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha]] returns the offset parameter ",
 StyleBox["d",
  FontSlant->"Italic"],
 " for a unit polygon offset twist of order ",
 "angles",
 ", pleat width ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", and twist angle \[Alpha]."
}], "Text",
 CellChangeTimes->{
  3.6273396764109926`*^9, 3.6273859759717917`*^9, 3.6274035577266407`*^9, {
   3.6274035992897053`*^9, 3.627403599434111*^9}, 
   3.628629976238572*^9},ExpressionUUID->"154574f6-941c-41ef-b108-\
fcbee3496fd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTriangleOffsetTwistOffset", "[", 
   RowBox[{"angles_", ",", "w_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "}"}], "=", 
      "angles"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      FractionBox[
       RowBox[{"w", " "}], 
       RowBox[{"2", " "}]], 
      FractionBox[
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]1", "]"}], 
        RowBox[{"Sin", "[", "\[Theta]2", "]"}], 
        RowBox[{"Sin", "[", "\[Theta]3", "]"}]}], 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]1", "]"}], 
         RowBox[{"Cos", "[", "\[Theta]2", "]"}], 
         RowBox[{"Cos", "[", "\[Theta]3", "]"}]}]}]], 
      RowBox[{"Cot", "[", "\[Alpha]", "]"}]}]}]}], "]"}]}]], "Input",
