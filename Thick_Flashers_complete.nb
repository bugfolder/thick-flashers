Cell[CellGroupData[{

Cell[TextData[{
 "RotateGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Phi]]\n\t(checked class) TGraph2D"
}], "Subsubsection",
 CellChangeTimes->{{3.706822837587078*^9, 3.70682288396387*^9}, {
  3.706822939116528*^9, 
  3.7068229396121387`*^9}},ExpressionUUID->"cb03b6cd-c167-4fc3-a154-\
868e9b4d9632"],

Cell[TextData[{
 "RotateGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Phi]] rotates the folded form of a graph through angle \[Phi] about its \
centroid."
}], "Text",
 CellChangeTimes->{{3.706822926349248*^9, 3.706822954403977*^9}, {
  3.706823035766759*^9, 
  3.706823037180987*^9}},ExpressionUUID->"03072a5d-9d64-4924-b456-\
ae23462fa1ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotateGraph2D", "[", 
   RowBox[{
    StyleBox["tobj_",
     FontSlant->"Italic"], ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts2d", ",", "ctr", ",", "rr"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph2D", ",", "RotateGraph2D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices2D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#1", "]"}], "+", 
             RowBox[{"Min", "[", "#1", "]"}]}], ")"}], "/", "2"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#2", "]"}], "+", 
             RowBox[{"Min", "[", "#2", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "&"}], "@@", 
       RowBox[{"Transpose", "[", "verts2d", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rr", "=", 
      RowBox[{"RotationMatrix2D", "[", "\[Phi]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"rr", ".", 
          RowBox[{"(", 
           RowBox[{"#", "-", "ctr"}], ")"}]}]}], "&"}], "/@", "verts2d"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices2D", "\[Rule]", "verts2d"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627767928398541*^9, 3.627768044131306*^9}, {
  3.627768136345787*^9, 3.627768244068619*^9}, {3.627768277187147*^9, 
