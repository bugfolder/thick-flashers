Cell[TextData[{
 "CircularPolygonTwistFoldedFormGraphics[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list verts of vertices, a twist angle \[Alpha], an optional list \
of crease types around the central polygon, and options, and returns a list \
of Graphics elements that produce the folded form. Options are:\n\t\
CircleDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is passed through to CircularlyCompletePoly to specify the quantization of \
the circle.\n\tStationaryFace \[Rule] 1 | ",
 StyleBox["i",
  FontSlant->"Italic"],
 " | Automatic. Specifies the stationary face of the folded form. If 1, the \
central polygon is stationary. If Automatic, the wedges maintain their \
orientation. If ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", the specified face is held fixed."
}], "Text",
 CellChangeTimes->{{3.457918858370187*^9, 3.457918869016727*^9}, {
   3.457919034888073*^9, 3.457919063302609*^9}, {3.457919158584325*^9, 
