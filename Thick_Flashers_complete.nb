     RowBox[{"types", "=", 
      RowBox[{"{", "M", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", 
