Cell[CellGroupData[{

Cell["Quad strain energies", "Subsection",
 CellChangeTimes->{{3.701258045847004*^9, 3.7012580487269926`*^9}, {
  3.70258150308486*^9, 
  3.702581505140871*^9}},ExpressionUUID->"12a5ecab-9684-42d9-8dce-\
b35b66bf1c8f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.701265297553594*^9, 
  3.7012652980743856`*^9}},ExpressionUUID->"aaa30a92-a389-4a6b-bfaf-\
01c33475db40"],

Cell["\<\
Strain energies are functions that act like springs. They go into a figure of \
merit to be minimized to find the equilibrium state of an underconstrained \
system of vertices.\
\>", "Text",
 CellChangeTimes->{{3.7012653027930117`*^9, 
  3.701265365697461*^9}},ExpressionUUID->"8de3096e-a257-4988-91dd-\
2ddec83e4819"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "QuadBendEnergy13[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "]\nQuadBendEnergy[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.701174528369567*^9, 3.701174550156069*^9}, {
  3.70117495399788*^9, 3.701174955637967*^9}, {3.701175032382718*^9, 
  3.701175032847498*^9}, {3.701267269482234*^9, 
  3.701267296290174*^9}},ExpressionUUID->"6445e15f-da48-4c96-a4f6-\
c2642145b987"],

Cell[TextData[{
 "QuadBendEnergy13[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "] returns the bend energy of a quad (or two paired triangles) along the ",
 StyleBox["p1",
  FontSlant->"Italic"],
 "-",
 StyleBox["p3",
  FontSlant->"Italic"],
 " diagonal."
}], "Text",
 CellChangeTimes->{{3.701174555001946*^9, 3.701174584780357*^9}, 
   3.701174959850958*^9, {3.701175035119615*^9, 3.701175035606922*^9}, {
   3.701175705451652*^9, 3.701175719908973*^9}, {3.7012673262498903`*^9, 
   3.701267326466492*^9}},ExpressionUUID->"33963480-9acd-4a74-bd5e-\
ac494595a297"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 " \[LongDash] the vertices of the quadrilateral in cyclic order."
}], "Text",
 CellChangeTimes->{{3.701174591769831*^9, 3.701174610404399*^9}, {
  3.701174645515561*^9, 
  3.701174648251914*^9}},ExpressionUUID->"c735c8c9-98db-423e-8a64-\
60981183741c"],

Cell["\<\
Returns:
\tAn algebraic expression for the bend energy.\
\>", "Text",
 CellChangeTimes->{{3.70117471389885*^9, 3.70117480283702*^9}, {
  3.701174865480242*^9, 3.701174923573873*^9}, {3.701175299277088*^9, 
  3.701175300018186*^9}, {3.701267277377306*^9, 
  3.701267279769152*^9}},ExpressionUUID->"7eb57f8f-b134-491c-ab69-\
99680ae48b26"],

Cell[TextData[{
 "The bend energy formula is equivalent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "/", "2"}]}], 
   TraditionalForm]],ExpressionUUID->"7c89e69f-a16e-437c-a62e-baf214a02055"],
 ", where ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the length of the diagonal and \[Theta] is the fold angle along the \
diagonal. It has the value zero for unfolded and reaches a peak value for \
flat-folded, varies quadratically near the minima, and scales linearly with \
the length of the fold. It\[CloseCurlyQuote]s a relatively simple FOM useful \
for small distortions of unfolded quads (e.g., bent quads) and/or small \
distortions of flat-folded forms."
}], "Text",
 CellChangeTimes->{{3.701175304363242*^9, 3.701175335690102*^9}, {
  3.701175437409848*^9, 3.701175530242811*^9}, {3.701175614380753*^9, 
  3.701175686870004*^9}, {3.701179709893148*^9, 3.701179750509868*^9}, {
  3.701265664652014*^9, 3.701265665125104*^9}, {3.701280045869591*^9, 
  3.701280096412566*^9}},ExpressionUUID->"8ceccf21-69b9-48f8-baac-\
e6cbee07cf4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuadBendEnergy13", "[", 
   RowBox[{"p_List", ",", "q_List", ",", "r_List", ",", "s_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
