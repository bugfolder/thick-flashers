Cell[TextData[{
 "StyledRuledPatch[",
 StyleBox["b, d",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] does the same thing where ",
 StyleBox["b",
  FontSlant->"Italic"],
 " is the directrix and ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the director of the surface. This or the next version is what is \
usually called, rather than supplying the surface function directly."
}], "Text",
 CellChangeTimes->{{3.689855594374747*^9, 3.689855623410319*^9}, {
  3.691408966767799*^9, 3.691408971415119*^9}, {3.800013996853381*^9, 
  3.80001402128735*^9}, {3.800014053756606*^9, 3.8000140660853667`*^9}, {
  3.803562223556883*^9, 
  3.803562238932804*^9}},ExpressionUUID->"12c01110-ee19-46ba-953b-\
26702ba538b6"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] directrix of the ruled surface.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] director of the ruled surface.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] domain of the plot, with ruling lines along lines of constant \
u.\n\t{",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "} \[LongDash] parameter along the ruling lines. Can be either constants or \
functions."
}], "Text",
 CellChangeTimes->{{3.803562291012355*^9, 
  3.803562350373666*^9}},ExpressionUUID->"879d4fe0-9925-4a96-a1da-\
5a645993ee2e"],

Cell[TextData[{
 "If you want the ruling lines to vary in length along the patch, ",
 StyleBox["d",
  FontSlant->"Italic"],
 " does not have to be a unit vector. You can make {v0, v1} = {0, 1}, and put \
all the length variation in the varying magnitude of ",
 StyleBox["d",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.691497710879227*^9, 3.691497770072877*^9}, {
   3.800014053776002*^9, 3.800014066104572*^9}, 
   3.80356187743727*^9},ExpressionUUID->"7eb692fb-1e18-41c9-862d-\
8353c2880d1a"],

Cell[TextData[{
 "Or you can provide functions for ",
 StyleBox["v0",
  FontSlant->"Italic"],
 " and/or ",
 StyleBox["v1",
  FontSlant->"Italic"],
 ", as  in StyledPatch."
}], "Text",
 CellChangeTimes->{{3.782511533464156*^9, 3.782511544822288*^9}, {
  3.785591567581647*^9, 3.785591606029485*^9}, {3.785591648485712*^9, 
  3.785591654358141*^9}, {3.800014053793282*^9, 
  3.800014066122427*^9}},ExpressionUUID->"be4e1c73-b80e-4c52-8c0e-\
b0c6e5102e2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledRuledPatch", "[", 
   RowBox[{
    RowBox[{"bb_Function", "|", "bb_InterpolatingFunction"}], ",", 
    RowBox[{"dd_Function", "|", "dd_InterpolatingFunction"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", " ", "u1_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", " ", "v1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ss", ",", "u", ",", "v"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{
         RowBox[{"bb", "[", "u", "]"}], "+", 
         RowBox[{"v", " ", 
          RowBox[{"dd", "[", "u", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"StyledRuledPatch", "[", 
      RowBox[{"ss", ",", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v0", ",", "v1"}], "}"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.689855652844683*^9, 3.689855709435807*^9}, {
   3.787501288856935*^9, 3.787501353814824*^9}, 3.798622844198553*^9, {
   3.8000139968710003`*^9, 3.800014021300651*^9}, {3.8000140538041277`*^9, 
   3.800014066136277*^9}, {3.801763918694767*^9, 3.801763926933051*^9}},
 CellLabel->
  "In[1740]:=",ExpressionUUID->"dbd4f02f-a6cf-482b-8dae-4fd2c9731ac2"],

Cell[TextData[{
 "StyledRuledPatch[",
 StyleBox["{b0, b1}",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] does the same thing where . This or the next version is what is usually \
called, rather than supplying the surface function directly."
}], "Text",
 CellChangeTimes->{{3.689855594374747*^9, 3.689855623410319*^9}, {
  3.691408966767799*^9, 3.691408971415119*^9}, {3.800013996853381*^9, 
  3.80001402128735*^9}, {3.800014053756606*^9, 3.8000140660853667`*^9}, {
  3.803562223556883*^9, 
  3.803562283749569*^9}},ExpressionUUID->"83688fee-3847-44fa-a373-\
2d1c4cdd7ba4"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b0",
  FontSlant->"Italic"],
 " \[LongDash] directrix of one end of the ruled surface.\n\t",
 StyleBox["b1",
  FontSlant->"Italic"],
 " \[LongDash] directrix of the other end of the ruled surface.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] domain of the plot, with ruling lines along lines of constant \
u."
}], "Text",
 CellChangeTimes->{{3.803562291012355*^9, 
  3.803562407958234*^9}},ExpressionUUID->"c8342742-f0cf-4942-839d-\
98cf148c5c4e"],

Cell[TextData[{
 "Note that there is no ",
 StyleBox["v",
  FontSlant->"Italic"],
 "-domain, as the two curves ",
 StyleBox["b0",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b1",
  FontSlant->"Italic"],
 " fully determine the extent of the patch."
}], "Text",
 CellChangeTimes->{{3.803562410046032*^9, 
  3.803562433701863*^9}},ExpressionUUID->"e741566f-d701-47df-9ece-\
f783a92bfcc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledRuledPatch", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"bb0_Function", "|", "bb0_InterpolatingFunction"}], ",", 
      RowBox[{"bb1_Function", "|", "dd1_InterpolatingFunction"}]}], "}"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", " ", "u1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ss", ",", "u", ",", "v"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{
         RowBox[{"bb0", "[", "u", "]"}], "+", 
         RowBox[{"v", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"bb1", "[", "u", "]"}], "-", 
            RowBox[{"bb0", "[", "u", "]"}]}], ")"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"StyledRuledPatch", "[", 
      RowBox[{"ss", ",", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", "opts"}], "]"}]}]}], 
