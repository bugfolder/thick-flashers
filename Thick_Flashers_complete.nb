f02eb4c907b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InsetPoly", "::", "badlist"}], 
   "=", "\"\<Vertex list `1` and inset list `2` must have the same \
length.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.721814829162096*^9, 3.721814865039721*^9}},
 CellLabel->
  "In[930]:=",ExpressionUUID->"0b6e918f-5bf4-4f99-a9e9-4530c1feb4bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsetPoly", "[", 
   RowBox[{"verts_List", ",", "hlist_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"elines", ",", "insets", ",", "ilines"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "verts", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "hlist", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"InsetPoly", "::", "badlist"}], ",", "verts", ",", 
          "hlist"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"elines", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"verts", ",", 
         RowBox[{"RotateLeft", "[", "verts", "]"}]}], "}"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "lines", " ", "for", " ", "each", " ", "of", " ", "the", " ", "edges"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"insets", "=", 
      RowBox[{
       RowBox[{"-", "hlist"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Rotate90", "[", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{"Subtract", "@@", "#"}], "]"}], "]"}], "&"}], "/@", 
         "elines"}], ")"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"inset", " ", "vectors", " ", "for", " ", "each", " ", "line"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ilines", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#1", "+", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{"#1", "+", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
          "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"insets", ",", "elines"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"LineInt2D1", "[", 
         RowBox[{
          RowBox[{"First", "[", "#1", "]"}], ",", 
          RowBox[{"Last", "[", "#1", "]"}], ",", 
          RowBox[{"First", "[", "#2", "]"}], ",", 
          RowBox[{"Last", "[", "#2", "]"}]}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"ilines", ",", 
         RowBox[{"RotateRight", "[", "ilines", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.462432119557285*^9, 3.462432151285241*^9}, {
   3.46243218308988*^9, 3.462432216328992*^9}, {3.4624322474712*^9, 
