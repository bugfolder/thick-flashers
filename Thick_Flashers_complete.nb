       "Options", "[", "Degree4Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"stv", "=", 
      RowBox[{
       RowBox[{"ShowTangentVector", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sop", "=", 
      RowBox[{
       RowBox[{"ShowOsculatingPlane", "/.", 
