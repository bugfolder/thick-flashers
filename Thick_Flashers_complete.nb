}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "OrientedAngle3D",
 "[",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.496237897157911*^9, 3.496237905084763*^9}, 
   3.5919788312995157`*^9, 
   3.628786331992944*^9},ExpressionUUID->"b25f09e6-deb0-4c25-86c2-\
18657403f661"],

Cell[TextData[{
 "OrientedAngle3D",
 "[",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "] does the same thing as DirectedAngle3D, but now the vector ",
 StyleBox["c",
  FontSlant->"Italic"],
 " need only be a vector that specifies the orientation of the plane of \
rotation, i.e., it doesn't need to be perpendicular to either a or b."
}], "Text",
 CellChangeTimes->{{3.496237908195431*^9, 3.496237940267658*^9}, {
  3.496237973819924*^9, 3.496237993590981*^9}, {3.591978820127262*^9, 
  3.591978831398644*^9}, {3.628786320071064*^9, 
  3.628786332073964*^9}},ExpressionUUID->"cdd1a41f-900f-416b-997e-\
f6f32478765d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrientedAngle3D", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"d", "=", 
      RowBox[{"a", "\[Cross]", "b"}]}], "}"}], ",", 
    RowBox[{"DirectedAngle3D", "[", 
     RowBox[{"a", ",", "b", ",", 
      RowBox[{"d", " ", 
       RowBox[{"Sign", "[", 
        RowBox[{"c", ".", "d"}], "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.4962379968581467`*^9, 3.496238051062928*^9}, {
  3.591978820158904*^9, 3.591978831422802*^9}, {3.62878632010398*^9, 
  3.628786332096891*^9}},
 CellLabel->
  "In[723]:=",ExpressionUUID->"ecd7431c-f63d-4f91-b9f0-18b084ed5870"],

Cell["\<\
Examples: three properly perpendicular vectors and c not perpendicular to a \
or b.\
\>", "Text",
 CellChangeTimes->{{3.4418370223301897`*^9, 3.441837023023528*^9}, {
   3.496237827751759*^9, 3.496237834020002*^9}, {3.4962380890985603`*^9, 
