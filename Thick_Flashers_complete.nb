Cell[CellGroupData[{

Cell["Clipping of segments", "Subsection",
 CellChangeTimes->{{3.6288625459418297`*^9, 3.628862594017994*^9}, 
   3.70840095924036*^9},ExpressionUUID->"ba7b10e0-9584-4ac6-acdb-\
544cf78d2996"],

Cell[CellGroupData[{

Cell[TextData[{
 "ClipSegmentToHalfPlane[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}]\nClipSegmentToHalfPlane[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}]\nClipSegmentToConvexPolygon[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]\nClipSegmentToSegmentExterior[{q1, ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}]\nClipSegmentToConvexPolygonExterior[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.46290014282024*^9, 3.462900153419701*^9}, {
  3.4629229898958592`*^9, 3.46292302661261*^9}, {3.462926538145959*^9, 
  3.462926538163291*^9}, {3.466795075093176*^9, 3.466795077484658*^9}, {
  3.800014092102147*^9, 
  3.800014107545437*^9}},ExpressionUUID->"a8872543-cfff-40de-9e1a-\
22d1b12f1093"],

Cell[TextData[{
 "This section contains functions for clipping a segment by various geometric \
objects. They are used in the rendering of twist folded forms. A line segment \
can be specified by a 4-list {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1}, where the segment is parameterized by the function (1-",
 StyleBox["t",
  FontSlant->"Italic"],
 ")",
 StyleBox["q1",
  FontSlant->"Italic"],
 "+",
 StyleBox["t",
  FontSlant->"Italic"],
 " ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", with ",
 StyleBox["t",
  FontSlant->"Italic"],
 "\[Element][t0, t1]."
}], "Text",
 CellChangeTimes->{{3.484775692600329*^9, 3.48477584411061*^9}, {
  3.80001409213398*^9, 
  3.800014107595726*^9}},ExpressionUUID->"f1665cc1-aaf9-4776-ae56-\
c060a4ce20b9"],

Cell[TextData[{
 "ClipSegmentToHalfPlane[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}] takes the segment {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1}, which represents a segment of a line through ",
 StyleBox["q1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", parameterized on a variable ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", where the segment is the portion of the line from t0 to t1. It returns a \
segment {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tmin1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tmax1",
  FontSlant->"Italic"],
 "} that has been clipped to lie within the given half-plane, which is the \
half-plane defined by the line from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " in which point ",
 StyleBox["p3",
  FontSlant->"Italic"],
 " resides. If the segment lies wholly outside of the half-plane, its length \
is set to zero, i.e., ",
 StyleBox["tmin1",
  FontSlant->"Italic"],
 "=",
 StyleBox["tmax1.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.462923322436412*^9, 3.462923346079815*^9}, {
  3.46679536988973*^9, 3.466795398285615*^9}, {3.800014092203672*^9, 
  3.800014107756118*^9}},ExpressionUUID->"0fade0ff-f498-4280-9386-\
15edde0aa6b1"],

Cell[TextData[{
 "Note that if ",
 StyleBox["q1\[Equal]",
  FontSlant->"Italic"],
 "q2, we return the 4-element record (",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1} unchanged."
}], "Text",
 CellChangeTimes->{{3.4667961843683977`*^9, 3.466796236333789*^9}, {
  3.80001409228952*^9, 
  3.800014107779403*^9}},ExpressionUUID->"aee67a72-dfa1-4987-9e80-\
484ef2c56192"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentToHalfPlane", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_", ",", "t0_", ",", "t1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"detq", ",", "rp", ",", "t"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"q2", "-", "q1"}], "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "t0", ",", "t1"}], "}"}], "]"}]}], 
      "]"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"q1", "\[Equal]", "q2"}], ",", " ", 
       RowBox[{
        RowBox[{
        "so", " ", "return", " ", "what", " ", "was", " ", "passed", " ", 
         "in"}], ";", " ", 
        RowBox[{
         RowBox[{"it", "'"}], "s", " ", "already", " ", "clipped"}]}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"detq", "=", 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q2", "-", "q1"}], ",", 
         RowBox[{"p2", "-", "p1"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"detq", "\[Equal]", "0"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{"p", "-", 
         RowBox[{"line", " ", "and", " ", "q"}], "-", 
         RowBox[{"line", " ", "are", " ", "parallel"}]}], " ", "*)"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rp", "=", 
         RowBox[{"Rotate90", "[", 
          RowBox[{"p2", "-", "p1"}], "]"}]}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "rp", " ", "is", " ", "perpendicular", " ", "to", " ", "both", " ", 
          "lines"}], " ", "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sign", "[", 
            RowBox[{"rp", ".", 
             RowBox[{"(", 
              RowBox[{"p3", "-", "p1"}], ")"}]}], "]"}], "\[Equal]", 
           RowBox[{"Sign", "[", 
            RowBox[{"rp", ".", 
             RowBox[{"(", 
              RowBox[{"q1", "-", "p1"}], ")"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2", ",", "t0", ",", "t1"}], "}"}], " ", 
          RowBox[{"(*", " ", 
           RowBox[{"q", "-", 
            RowBox[{
            "line", " ", "is", " ", "on", " ", "the", " ", "p3", " ", "side", 
             " ", "of", " ", "p"}], "-", "line"}], " ", "*)"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2", ",", "t0", ",", "t0"}], "}"}]}], 
         RowBox[{"(*", " ", 
          RowBox[{"q", "-", 
           RowBox[{
           "line", " ", "is", " ", "NOT", " ", "on", " ", "the", " ", "p3", " ",
             "side", " ", "of", " ", "p"}], "-", "line"}], " ", "*)"}], 
         "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"p", "-", "line"}], ",", " ", 
         RowBox[{"q", "-", 
          RowBox[{"line", " ", "are", " ", "not", " ", "parallel"}]}], ",", 
         " ", 
         RowBox[{
         "so", " ", "compute", " ", "their", " ", "intersection", " ", 
          "parameter", " ", "t"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"t", "=", " ", 
         FractionBox[
          RowBox[{"Det", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"p1", "-", "q1"}], ",", 
             RowBox[{"p2", "-", "p1"}]}], "}"}], "]"}], "detq"]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"PtInHalfPlaneQ", "[", 
           RowBox[{"q1", ",", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}], " ", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"q1", " ", "is", " ", "in", " ", "halfplane"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"PtInHalfPlaneQ", "[", 
             RowBox[{"q2", ",", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2", ",", "t0", ",", "t1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2", ",", "t0", ",", 
              RowBox[{"Min", "[", 
               RowBox[{"t", ",", "t1"}], "]"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"q1", " ", "is", " ", "not", " ", "in", " ", "halfplane"}],
            " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"PtInHalfPlaneQ", "[", 
             RowBox[{"q2", ",", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2", ",", 
              RowBox[{"Max", "[", 
               RowBox[{"t0", ",", "t"}], "]"}], ",", "t1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2", ",", "t1", ",", "t1"}], "}"}]}], 
           "]"}]}], "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.462925045330529*^9, 3.462925099567471*^9}, {
   3.466794182356591*^9, 3.466794219727393*^9}, {3.466794260079138*^9, 
   3.466794262709564*^9}, {3.466794426420683*^9, 3.466794435868237*^9}, {
   3.466796072540753*^9, 3.466796138825013*^9}, {3.466796242818476*^9, 
   3.466796283306551*^9}, {3.466796367876024*^9, 3.466796383672453*^9}, {
   3.46679655284744*^9, 3.466796601302582*^9}, {3.466796814423804*^9, 
   3.466797165951751*^9}, {3.466797307284775*^9, 3.466797322452673*^9}, {
   3.466797391352631*^9, 3.466797602302918*^9}, 3.466797757465757*^9, {
   3.800014092307619*^9, 3.800014107823215*^9}},
 CellLabel->
  "In[528]:=",ExpressionUUID->"a605430e-b7ac-4c60-9c8d-6aa9d7de0219"],

Cell["Example", "Text",ExpressionUUID->"272fbf7d-5746-4d04-a56a-09d9f2de0cdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"halfplane", ",", "randsegs", ",", "allsegs", ",", "clipsegs"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"halfplane", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", ".5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"randsegs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "-", 
              RowBox[{"3", 
               RowBox[{"Random", "[", "]"}]}]}], ",", 
             RowBox[{"1", "-", 
              RowBox[{"2", 
               RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
           RowBox[{"{", "30", "}"}]}], "]"}], ",", "2"}], "]"}]}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"random", " ", "ones", " ", "for", " ", "testing"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"allsegs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"1", "/", "4"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"1", "/", "4"}]}], "}"}], ",", "0", ",", "1"}], "}"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{
               RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{
               RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", "0", ",", "1"}], 
           "}"}]}], "\[IndentingNewLine]", "}"}], ",", "randsegs"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"clipsegs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ClipSegmentToHalfPlane", "[", 
         RowBox[{"#", ",", "halfplane"}], "]"}], "&"}], "/@", "allsegs"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"Green", ",", 
        RowBox[{"Thickness", "[", "0.003", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"halfplane", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Darker", "[", "Green", "]"}], ",", 
        RowBox[{"PointSize", "[", ".02", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{
         "halfplane", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
         "]"}], ",", "\[IndentingNewLine]", "Gray", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"Take", "[", 
            RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], "/@", "allsegs"}], ",",
         "\[IndentingNewLine]", "Red", ",", 
        RowBox[{"Thickness", "[", ".008", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 "-", 
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], ")"}]}]}], ",", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 "-", 
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], ")"}]}]}]}], "}"}], "]"}], 
          "&"}], "/@", "clipsegs"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462923116278006*^9, 3.462923118612887*^9}, {
   3.462923190512519*^9, 3.4629231915829*^9}, {3.462923396534946*^9, 
   3.46292351770378*^9}, 3.466795507034219*^9, {3.466795563269538*^9, 
   3.466795571052647*^9}, {3.466795642793695*^9, 3.466795661640684*^9}, {
   3.466795703621945*^9, 3.466795889946801*^9}, {3.466795922113287*^9, 
   3.4667959714055023`*^9}, {3.466797255832166*^9, 3.466797273114646*^9}, {
   3.466797641355331*^9, 3.466797686086358*^9}, 3.466797729369057*^9, {
   3.466797766412709*^9, 3.466797768176956*^9}, 3.484770786852195*^9},
 CellLabel->
  "In[529]:=",ExpressionUUID->"9d0a6330-70bf-46c2-9063-b165aeeeaa43"],

Cell[TextData[{
 "ClipSegmentToHalfPlane[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}] takes the segment {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} and returns a segment {",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2a",
  FontSlant->"Italic"],
 "} that has been clipped to lie within the half-plane containing ",
 StyleBox["p3",
  FontSlant->"Italic"],
 " that is defined by the line through ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2.",
  FontSlant->"Italic"],
 " If the segment lies wholly outside of the half-plane, its length is set to \
zero, i.e., ",
 StyleBox["q1a",
  FontSlant->"Italic"],
 "\[Equal]",
 StyleBox["q2a",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.462923031717201*^9, 3.4629230350926037`*^9}, {
  3.462923071570395*^9, 3.462923075946251*^9}, {3.466794886451858*^9, 
  3.466794891409046*^9}},ExpressionUUID->"fe144ce6-0726-46a3-9fbd-\
5db400562a29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentToHalfPlane", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1a", ",", "q2a", ",", "t0", ",", "t1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q1a", ",", "q2a", ",", "t0", ",", "t1"}], "}"}], "=", 
      RowBox[{"ClipSegmentToHalfPlane", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q1", "+", 
        RowBox[{"t0", 
         RowBox[{"(", 
          RowBox[{"q2", "-", "q1"}], ")"}]}]}], ",", 
       RowBox[{"q1", "+", 
        RowBox[{"t1", 
         RowBox[{"(", 
          RowBox[{"q2", "-", "q1"}], ")"}]}]}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.466795117573898*^9, 3.466795220551995*^9}, {
  3.800014092334559*^9, 3.800014107832852*^9}},
