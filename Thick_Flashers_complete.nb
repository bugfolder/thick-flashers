Cell[TextData[{
 "MergeGraphAssigneds[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of GraphAssigned that have vertices in common and returns a \
single TGraphAssigned in which the individual TGraphs are merged into a \
single TGraph."
}], "Text",
 CellChangeTimes->{{3.649888922203361*^9, 3.649888943356659*^9}, {
