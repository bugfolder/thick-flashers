Cell[TextData[{
 "NCurve3DSystem[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs the differential geometry functions of a regular space curve, \
including the Frenet frame, as InterpolatingFunction objects."
}], "Text",
 CellChangeTimes->{{3.668947828478882*^9, 3.668947977055999*^9}, {
   3.668948036710371*^9, 3.668948054819468*^9}, 3.668951330975006*^9, {
