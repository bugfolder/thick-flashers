74f96c87020c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "w", ",", "\[Alpha]", ",", "name", ",", "verts", ",", "tiling", ",", 
      "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", "0.18"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"name", "=", "PolygonCenteredTwistAltTile"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"UnitRegularPolygonVertices", "[", "4", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"name", ",", "verts", ",", "w", ",", "\[Alpha]", ",", 
            RowBox[{"{", 
             RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], "}"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"name", ",", "verts", ",", "w", ",", "\[Alpha]", ",", 
             RowBox[{"{", 
              RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "1"}], "}"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"name", ",", "verts", ",", "w", ",", "\[Alpha]", ",", 
             RowBox[{"{", 
              RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"name", ",", "verts", ",", "w", ",", "\[Alpha]", ",", 
             RowBox[{"{", 
              RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"tiling", ",", "MonolithicTGraph2D", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "3"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsGrid", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Graphics", "[", 
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"tiling", ",", "Tiling", ",", 
               RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowCF"}]}], 
              "]"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Graphics", "[", 
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Graphics", "[", 
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], "}"}], 
          ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Graphics", "[", 
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"tiling", ",", "MonolithicCreasePattern"}], "]"}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Graphics", "[", 
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"tiling", ",", "MonolithicFoldedForm", ",", 
               RowBox[{"StationaryFace", "\[Rule]", "3"}], ",", 
               RowBox[{"FaceupFace", "\[Rule]", "3"}]}], "]"}], "]"}]}], 
           "}"}]}], "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.627646848774387*^9, 3.627646859774793*^9}, {
