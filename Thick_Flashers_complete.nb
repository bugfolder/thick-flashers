Cell["\<\
ArcHav[x] returns the first-quadrant (between 0 and \[Pi]) inverse haversine.\
\
\>", "Text",
 CellChangeTimes->{{3.636736747149167*^9, 3.636736792419359*^9}, {
  3.6367368780845613`*^9, 
