Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PotBorder", "::", "usage"}], " ", "=", 
   " ", "\"\<PotBorder is an option to MakeRadialPotWedge that specifies what \
type of border to put on the polygon.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.650288966648882*^9, 3.650288987665288*^9}, {
  3.650289059804191*^9, 3.6502890771959*^9}},
 CellLabel->
