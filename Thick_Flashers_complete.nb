Cell[TextData[{
 "ThreeCycleCriticalTwistAngleCW",
 "[",
 StyleBox["{q1a,q1b},{q2a,a2b},{q3a,q3b}",
  FontSlant->"Italic"],
 "] takes the endpoints of three edges and returns the critical twist angle \
for those three edges for a clockwise (\[Alpha]\[GreaterEqual]\[Pi]/2) \
twist."
}], "Text",
 CellChangeTimes->{
  3.627501303868414*^9},ExpressionUUID->"425fa785-bcdc-46f5-b72b-\
03649b531138"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThreeCycleCriticalTwistAngleCW", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1a_", ",", "q1b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q2a_", ",", "q2b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q3a_", ",", "q3b_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"\[Pi]", "+", 
   RowBox[{"ThreeCycleCriticalTwistAngleCCW", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q1b", ",", "q1a"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q2b", ",", "q2a"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q3b", ",", "q3a"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.627501293720267*^9, 3.627501303938051*^9}},
 CellLabel->
  "In[2696]:=",ExpressionUUID->"33742d4d-a1e1-4f5f-b8f3-640ed10e2740"],

