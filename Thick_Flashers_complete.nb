 CellLabel->
  "In[2782]:=",ExpressionUUID->"b5ab9763-c1c5-4cba-a6ea-adf8c112fa28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TilingStyle", "[", "opts___", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "ttc", ",", "tlc", ",", "tfc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ttc", "=", 
      RowBox[{
       RowBox[{"TilingTextColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TilingStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tlc", "=", 
      RowBox[{
       RowBox[{"TilingLineColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TilingStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tfc", "=", 
      RowBox[{
       RowBox[{"TilingFillColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TilingStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"x_", ",", "TilingText"}], "]"}], "\[Rule]", 
        RowBox[{"Style", "[", 
         RowBox[{"x", ",", "ttc"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"x_", ",", "TilingLine"}], "]"}], "\[Rule]", 
        RowBox[{"Style", "[", 
         RowBox[{"x", ",", "tlc", ",", 
          RowBox[{"AbsoluteThickness", "[", "1.0", "]"}], ",", 
          RowBox[{"AbsoluteDashing", "[", 
           RowBox[{"{", "}"}], "]"}], ",", 
          RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}], ",", 
          RowBox[{"JoinForm", "[", "\"\<Round\>\"", "]"}]}], "]"}]}], ",", 
