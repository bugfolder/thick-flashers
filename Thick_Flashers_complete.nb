  RowBox[{"Rotate3Du", "[", 
   RowBox[{"p_List", ",", "\[Phi]_", ",", "w_List", ",", "q_List"}], "]"}], ":=", 
  RowBox[{"q", "+", 
   RowBox[{"Rotate3Du", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", "q"}], ")"}], ",", "\[Phi]", ",", "w"}], 
