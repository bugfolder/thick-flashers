Cell[CellGroupData[{

Cell[TextData[{
 "MakeSimpleFlutedCone",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ConePhaseShift"
}], "Subsubsection",
 CellChangeTimes->{{3.592154247803595*^9, 3.592154298334251*^9}, {
   3.5921543355456123`*^9, 3.592154347292865*^9}, 3.592154693602759*^9, 
   3.592155187507006*^9, {3.592156231725477*^9, 3.592156231795051*^9}, 
   3.592156412896799*^9, 3.592829339358677*^9, {3.5930396276549053`*^9, 
   3.593039634484714*^9}, {3.615247455354221*^9, 3.615247467625296*^9}, 
   3.615249124428244*^9},ExpressionUUID->"e4f2709a-1f9b-4a77-8168-\
c6980ba79900"],

Cell[TextData[{
 "MakeSimpleFlutedCone[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Alpha]] constructs a simply pleated cone of order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " with interior angle \[Alpha] whose vertex is at the origin and returns a \
TGraph3D+TAssigned. The vertex of the cone is the last point in its vertex \
list.\nOptions are:\n\tPhaseShift\[Rule]\[Phi], where \[Phi] is the \
rotational phase shift of the crease pattern and folded form relative to the \
x-axis."
}], "Text",
 CellChangeTimes->{{3.592154552062509*^9, 3.592154588597419*^9}, 
   3.592154693637805*^9, {3.592156231864304*^9, 3.592156231935063*^9}, 
   3.592435759417929*^9, 3.592829339457142*^9, {3.595017977928737*^9, 
   3.595017979862679*^9}, {3.6152465157344437`*^9, 3.615246534764119*^9}, {
   3.615247423345771*^9, 3.6152474554195623`*^9}, 3.615249124500952*^9, {
   3.6152853130504723`*^9, 
   3.615285313418154*^9}},ExpressionUUID->"497deb5c-5e98-431a-b807-\
4e51b5a5a80d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConePhaseShift", "::", "usage"}], 
   "=", "\"\<ConePhaseShift is an option to MakeSimpleFlutedCone that \
specifies the rotational phase shift of the crease pattern and folded form \
relative to the x-axis.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592155134435145*^9, 3.592155187264975*^9}, 
   3.592829339514028*^9, 3.6152474554441*^9, 3.61524912453111*^9},
 CellLabel->
  "In[2588]:=",ExpressionUUID->"0f7fc78b-2f4a-4933-8bbb-626a1b36f42a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeSimpleFlutedCone", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"ConePhaseShift", "\[Rule]", "0"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{3.5921551872956533`*^9, 3.5928293395634723`*^9, 
  3.61524745566609*^9, 3.6152491247566967`*^9},
 CellLabel->
  "In[2589]:=",ExpressionUUID->"7f1ce95e-933f-44aa-a805-a80093ca4954"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSimpleFlutedCone", "[", 
   RowBox[{"m_", ",", "\[Alpha]_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ps", ",", 
      RowBox[{"\[Phi]", "=", 
       RowBox[{"\[Pi]", "/", "m"}]}], ",", "bt", ",", "verts", ",", "verts3d",
       ",", "edges", ",", "types", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ps", "=", 
      RowBox[{
       RowBox[{"ConePhaseShift", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleFlutedCone", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bt", "=", 
      RowBox[{"ArcCos", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Pi]", "/", "m"}], "]"}], " ", 
         RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Pi]", "/", "m"}], "]"}], " ", 
          RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}]], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"2", " ", "i", " ", "\[Phi]"}], "+", "ps"}], "]"}], 
                ",", 
                RowBox[{"Sin", "[", 
                 RowBox[{
                  RowBox[{"2", " ", "i", " ", "\[Phi]"}], "+", "ps"}], 
                 "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", "i"}], "+", "1"}], " ", ")"}], "\[Phi]"}], "+",
                   "ps"}], "]"}], ",", 
                RowBox[{"Sin", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", "i"}], "+", "1"}], ")"}], " ", "\[Phi]"}], "+",
                   "ps"}], "]"}]}], "}"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Sin", "[", "bt", "]"}], 
                 RowBox[{"Cos", "[", 
                  RowBox[{
                   RowBox[{"2", "i", " ", "\[Phi]"}], "+", "ps"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{"Sin", "[", "bt", "]"}], 
                 RowBox[{"Sin", "[", 
                  RowBox[{
                   RowBox[{"2", "i", " ", "\[Phi]"}], "+", "ps"}], "]"}]}], ",", 
                RowBox[{"Cos", "[", "bt", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
                 RowBox[{"Cos", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", "i"}], "+", "1"}], " ", ")"}], "\[Phi]"}], "+",
                    "ps"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
                 RowBox[{"Sin", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", "i"}], "+", "1"}], ")"}], " ", "\[Phi]"}], "+",
                    "ps"}], "]"}]}], ",", 
                RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], "}"}]}], "}"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"2", "m"}], "+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"2", "m"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", 
              RowBox[{"2", "m"}], ",", "1"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"2", "m"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OddQ", "[", "i", "]"}], ",", "M", ",", "V"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"2", "m"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"B", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"2", "m"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"MakeTPlaneGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", 
       RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}], "//", 
      RowBox[{"AddTAssigned", "[", "types", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.592154247842312*^9, 3.592154298381511*^9}, {
   3.592154335508774*^9, 3.592154347318262*^9}, 3.5921546936711073`*^9, {
