Cell[CellGroupData[{

Cell["CraneGraph2D", "Subsubsection",
 CellChangeTimes->{{3.706832123317965*^9, 3.706832125724622*^9}, {
   3.833025188529085*^9, 3.833025192807782*^9}, 
   3.962634666763612*^9},ExpressionUUID->"1ed6d6be-3a66-4f25-a090-\
f930eeeb0e9d"],

Cell["\<\
CraneGraph2D gives the fold pattern for an origami crane, constructed via \
sequential folding from a Bird BaseGraph2D.\
\>", "Text",
 CellChangeTimes->{{3.7068321286127853`*^9, 3.7068321763969607`*^9}, {
  3.706873833040443*^9, 
  3.706873834374124*^9}},ExpressionUUID->"22dd6d4f-65e3-4c8f-b732-\
b1bb71521654"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "CraneGraph2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"CraneGraph2D", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj", ",", "stobj"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tobj", "=", "BirdBaseGraph2D"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "fold", " ", "left", " ", "edge", " ", "in", " ", "to", " ", "the", " ",
          "center"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"U", "[", 
             RowBox[{"101.25", "\[Degree]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "6"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "fold", " ", "right", " ", "edge", " ", "in", " ", "to", " ", "the", " ",
          "center"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"U", "[", 
             RowBox[{"78.75", "\[Degree]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "10"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"fold", " ", "up", " ", "left", " ", "flap"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", ".5"}], "}"}], ",", 
            RowBox[{".3", 
             RowBox[{"U", "[", 
              RowBox[{"202.5", "\[Degree]"}], "]"}]}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"fold", " ", "up", " ", "right", " ", "flap"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", ".5"}], "}"}], ",", 
            RowBox[{".3", 
             RowBox[{"U", "[", 
              RowBox[{
               RowBox[{"-", "22.5"}], "\[Degree]"}], "]"}]}]}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", "13", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"fold", " ", "down", " ", 
         RowBox[{"head", ".", " ", "Note"}], " ", "that", " ", "we", " ", 
         "have", " ", "filter", " ", "the", " ", "split", " ", "to", " ", 
         "fold", " ", "head", " ", "but", " ", "not", " ", 
         RowBox[{"wings", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", ".73"}], "}"}], ",", 
            RowBox[{".5", 
             RowBox[{"U", "[", 
              RowBox[{"0", "\[Degree]"}], "]"}]}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GraphicsRow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"SplitGraphGraphics", "[", "stobj", "]"}], ",", 
           RowBox[{"SplitGraph2DGraphics", "[", 
            RowBox[{"stobj", ",", 
             RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}], "}"}], "]"}], "//",
         "Hold"}], ";", "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"FilterSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "22", ",", "91", ",", "56", ",", "96", ",", "29", ",", "92", ",", 
            "58", ",", "95"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"SplitAndFoldSplitGraph2D", "[", 
        RowBox[{"stobj", ",", 
         RowBox[{"{", "13", "}"}]}], "]"}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.706873838684315*^9, 3.706873968167823*^9}, {
   3.706874683175474*^9, 3.706874718527313*^9}, {3.706874760537738*^9, 
   3.7068748205118113`*^9}, {3.7068750869158707`*^9, 3.706875261275897*^9}, {
   3.706875308263983*^9, 3.706875310398712*^9}, {3.70687538435856*^9, 
   3.706875465541795*^9}, {3.7068755222078867`*^9, 3.706875548237924*^9}, {
