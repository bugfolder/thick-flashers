Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "a", ",", "b", ",", "c", ",", "\[Phi]", ",", "\[Theta]", ",", 
      "dx", ",", "dy", ",", "dz", ",", "botpts2d", ",", "toppts2d"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "16"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"rotational", " ", "order"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", "GoldenRatio"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["a", "2"], "-", 
        SuperscriptBox["b", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{"DiscreteEllipseEquilateral", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"toppts2d", "=", 
      RowBox[{"RotateLeft", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"RotationMatrix2D", "[", 
            RowBox[{"90", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
         "botpts2d"}], ",", 
        RowBox[{
         RowBox[{"m", "/", "4"}], "-", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TwistJoinedTubeGraphics", "[", 
      RowBox[{"botpts2d", ",", "toppts2d", ",", 
       RowBox[{"TwistDirection", "\[Rule]", "CW"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6711793832328787`*^9, 3.671179568554941*^9}, {
   3.671179608644779*^9, 3.671179632783592*^9}, {3.671180537675157*^9, 
