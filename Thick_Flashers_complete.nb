Cell[TextData[{
 "TwoCycleCriticalTwistAngles[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "}] returns the angular range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "min"], ",", 
     SubscriptBox["\[Alpha]", "max"]}]}], TraditionalForm]],ExpressionUUID->
  "3166d038-9493-42f1-98f1-d462baf74223"],
 "} between which there is a 2-cycle overlap between edges {",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "} and {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "} of a polygon."
}], "Text",
 CellChangeTimes->{{3.627497752764758*^9, 3.627497828169616*^9}, {
   3.62749786772199*^9, 3.627497900509591*^9}, {3.627499256686692*^9, 
   3.627499268997582*^9}, {3.627499301931741*^9, 3.627499336770604*^9}, {
