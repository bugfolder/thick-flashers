Cell[CellGroupData[{

Cell[TextData[{
 "MakeTVertex3DFromAngles[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", foldangles, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) OffsetAngle3D, CheckConsistency, \
Options[MakeTVertexFromAngles]"
}], "Subsubsection",
 CellChangeTimes->{{3.6161714774801207`*^9, 3.616171482590018*^9}, {
   3.616171515653742*^9, 3.616171530147044*^9}, {3.616171674002174*^9, 
   3.6161716746662397`*^9}, {3.616173314171591*^9, 3.616173319088639*^9}, {
   3.6161738754057198`*^9, 3.616173890220059*^9}, {3.616194588956502*^9, 
   3.616194591897353*^9}, 
   3.704570859466955*^9},ExpressionUUID->"0ab84f92-f181-4b8f-8e17-\
6f8cfef78fa8"],

Cell[TextData[{
 "MakeTVertex3DFromAngles[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", foldangles, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a set of sector angles and dihedral angles and returns a TVertex3D \
that describes the vertex. The vertex does not need to be developable, but if \
the sectors and dihedrals aren\[CloseCurlyQuote]t Kawasaki-consistent, the \
last sector angle will be altered to make it Kawasaki-consistent and a \
warning will be issued. Options are:\n\tOffsetAngle3D \[Rule] \[Theta], \
specifies the rotation angle in the x-y plane of the first fold in 3D.\n\t\
CheckConsistency \[Rule] True | False, specifies whether to check consistency \
of the angles. Set to False for symbolic constructions.\n\t\
Options[MakeTVertexFromAngles] (OffsetAngle, which specifies the same thing \
in 2D) are passed through."
}], "Text",
 CellChangeTimes->{{3.616171534632948*^9, 3.616171641532009*^9}, {
   3.616171680777483*^9, 3.61617170979138*^9}, 3.616173787190775*^9, {
   3.616173820009518*^9, 3.616173822528995*^9}, {3.616174101614827*^9, 
   3.6161741418207417`*^9}, {3.616174857766733*^9, 3.616174874597665*^9}, {
   3.616194378343967*^9, 3.616194411533021*^9}, {3.616194602330601*^9, 
   3.616194633782757*^9}, 
   3.704570859573351*^9},ExpressionUUID->"993f74e3-4080-4d14-b6f8-\
982869883264"],

Cell["\<\
First crease runs along the x-axis. First sector lies in the x-y plane.\
\>", "Text",
 CellChangeTimes->{{3.616172257876902*^9, 3.616172268019863*^9}, {
  3.616174817624878*^9, 
  3.616174878356844*^9}},ExpressionUUID->"30a341fe-32b2-4615-be36-\
aaf04ecf87b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OffsetAngle3D", "::", "usage"}], 
   "=", "\"\<OffsetAngle3D is an option to MakeTVertex3DFromAngles that \
specifies the rotation angle in the x-y plane of the first fold.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.616173913558353*^9, 3.616173953546494*^9}},
 CellLabel->
  "In[2158]:=",ExpressionUUID->"5a9f8d2d-0ce9-4d19-8f3e-53fdf81a0bf5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CheckConsistency", "::", "usage"}], 
   "=", "\"\<CheckConsistency is an option to MakeTVertex3DFromAngles that \
specifies whether to check the consistency of the sector and dihedral angles.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.6161946536857557`*^9, 3.616194679427754*^9}},
 CellLabel->
  "In[2159]:=",ExpressionUUID->"da3856c1-5ae9-4469-a898-04a0722a01ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeTVertex3DFromAngles", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"OffsetAngle3D", "\[Rule]", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"CheckConsistency", "\[Rule]", "True"}]}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.6161738946988163`*^9, 3.61617390891934*^9}, {
  3.616194594250911*^9, 3.61619459949546*^9}},
 CellLabel->
  "In[2160]:=",ExpressionUUID->"3820b1bf-671c-4087-93af-41151937bfb1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTVertex3DFromAngles", "::", "badangles"}], 
   "=", "\"\<Sector angles `1` and dihedral angles `2` must have the same \
length.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.616172338738336*^9, 3.616172360544159*^9}},
 CellLabel->
  "In[2161]:=",ExpressionUUID->"f33e327f-dc36-469c-bc71-9ef766dd6c9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTVertex3DFromAngles", "::", "inconsist"}], 
   "=", "\"\<Sector angles `1` and dihedral angles `2` are not \
Kawasaki-consistent, giving a residual consistency matrix of `3`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.616194426159986*^9, 3.616194457820052*^9}, {
  3.616194821204543*^9, 3.616194830467782*^9}},
 CellLabel->
  "In[2162]:=",ExpressionUUID->"a881913e-3631-4669-bcfa-d0f8085577f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTVertex3DFromAngles", "[", 
   RowBox[{"sectorangles_List", ",", " ", "foldangles_List", ",", "opts___"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"oa", ",", "cc", ",", "n", ",", "mm", ",", "gg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "sectorangles", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "foldangles", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTVertex3DFromAngles", "::", "badangles"}], ",", 
          "sectorangles", ",", "foldangles"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"oa", "=", 
      RowBox[{
       RowBox[{"OffsetAngle3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTVertex3DFromAngles", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"CheckConsistency", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTVertex3DFromAngles", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"cc", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mm", "=", 
         RowBox[{"VertexConsistencyMatrix3D", "[", 
          RowBox[{"foldangles", ",", "sectorangles"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Chop", "[", 
            RowBox[{"mm", "-", 
             RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "\[NotEqual]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"MakeTVertex3DFromAngles", "::", "inconsist"}], ",", 
             "sectorangles", ",", "foldangles", ",", "mm"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "sectorangles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mm", "=", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], ".", 
       RowBox[{"RotationMatrix3Du", "[", 
        RowBox[{"oa", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"gg", ",", 
          RowBox[{
           RowBox[{"Transpose", "[", "mm", "]"}], "\[LeftDoubleBracket]", "1",
            "\[RightDoubleBracket]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "\[NotEqual]", "1"}], ",", 
          RowBox[{"mm", "=", 
           RowBox[{"mm", ".", 
            RowBox[{"RotationMatrix3Du", "[", 
             RowBox[{
              RowBox[{
              "foldangles", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}]}]}], "]"}],
         ";", "\[IndentingNewLine]", 
