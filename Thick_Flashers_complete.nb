Cell[CellGroupData[{

Cell[TextData[{
 "VeneerScoringGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TPlaneGraph, TAssigned\n\t(options) ImageWidth, \
ImageHeight, VeneerThickness, MultilineSpacing, InvertFolds, FoldAngles, \
ScoreLineThickness"
}], "Subsubsection",
 CellChangeTimes->{{3.624891363393293*^9, 3.624891383390296*^9}, {
   3.624892057628418*^9, 3.62489206397192*^9}, {3.624894762023148*^9, 
   3.6248947652311716`*^9}, {3.624895690502103*^9, 3.624895693435894*^9}, {
   3.624895764032812*^9, 3.624895767670678*^9}, 3.6249139679142*^9, {
   3.6249149429251766`*^9, 3.624914943507565*^9}, {3.624990475400147*^9, 
   3.624990477187171*^9}, 3.625164196070669*^9, {3.625165210397538*^9, 
   3.625165211468761*^9}, 3.626360866396604*^9, {3.626452711768731*^9, 
   3.626452713907891*^9}, {3.626456448383153*^9, 3.626456458365259*^9}, {
   3.626479941939645*^9, 3.626479943072747*^9}, {3.6279047989431477`*^9, 
   3.627904849672766*^9}, {3.6279048850070276`*^9, 3.627904896502105*^9}, {
   3.627904961393368*^9, 3.627904974650334*^9}, {3.627905005590524*^9, 
   3.627905026359472*^9}, {3.627905183459193*^9, 3.62790519194252*^9}, 
   3.627913724266478*^9},ExpressionUUID->"0e2e65e5-2a1a-4f30-8b81-\
802e5f16e8d2"],

Cell[TextData[{
 "VeneerScoringGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TPlaneGraph+TAssigned ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " representing the crease pattern and generates a Graphics object that \
represents a veneer scoring pattern. Border and mountain folds are rendered \
as hairlines; valley folds are assigned a thickness that specifies the kerf; \
the kerf is created by making a VeneerMultiline (a group of closely spaced \
lines). Ends of multilines are angled to avoid overlaps and minimize \
burn-through at vertices. Options are:\n\tImageWidth \[Rule] ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the desired image width.\n\tImageHeight \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["h",
  FontSlant->"Italic"],
 " is the desired image height. You must supply either width or height (if \
you specify both, ImageWidth wins out).\n\tVeneerThickness \[Rule] ",
 StyleBox["vt",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["vt",
  FontSlant->"Italic"],
 " is the veneer thickness, also given in points (for unit consistency).\n\t\
MultilineSpacing \[Rule] ",
 StyleBox["ls",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["ls",
  FontSlant->"Italic"],
 " is the spacing to use in the VeneerMultiline function.\n\tInvertFolds \
\[Rule] True | False inverts the crease assignment in the pattern.\n\t\
FoldAngles \[Rule] ",
 StyleBox["angle | anglelist",
  FontSlant->"Italic"],
 " | Automatic, where:\n\t\t",
 StyleBox["angle",
  FontSlant->"Italic"],
 " is a single angle used for all valley folds;\n\t\t ",
 StyleBox["anglelist",
  FontSlant->"Italic"],
 " is a list of specified angles, one for each edge of the graph;\n\t\t \
Automatic uses the angles in the FoldAngles property, if it exists, and if \
not, makes all valley folds 180\[Degree].\n\t\t See further note below about \
how FoldAngles is interpreted.\n\tOptions[Graphics] are passed through to \
Graphics."
}], "Text",
 CellChangeTimes->{{3.624889911255558*^9, 3.624889929508737*^9}, {
   3.62488996334678*^9, 3.624890164533807*^9}, {3.624890203483369*^9, 
   3.6248902196181297`*^9}, 3.624891358509203*^9, {3.6248946868523912`*^9, 
   3.624894752743634*^9}, {3.624895696508016*^9, 3.6248957587535973`*^9}, 
   3.624913968169517*^9, {3.624914964291065*^9, 3.624915087995212*^9}, {
   3.624990486878362*^9, 3.624990549282596*^9}, 3.62516419753089*^9, {
   3.62516446315088*^9, 3.625164494308079*^9}, {3.625164551327553*^9, 
   3.625164661225672*^9}, {3.626360976525869*^9, 3.62636098190401*^9}, 
   3.626452422487101*^9, {3.626456460493579*^9, 3.626456461340842*^9}, {
   3.62645653272077*^9, 3.626456580805533*^9}, {3.6264585607771273`*^9, 
   3.626458561821927*^9}, {3.626458594518961*^9, 3.6264586143240767`*^9}, 
   3.627904955784503*^9, {3.62790499448929*^9, 3.627904999087381*^9}, 
   3.627905029559965*^9, 3.627905137621961*^9, 3.627906345441826*^9, {
   3.62791155083206*^9, 3.627911557007145*^9}, {3.627911589013835*^9, 
