Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ds", ",", "sd\[Kappa]n", ",", "sd\[Kappa]g", ",", "sd\[Tau]g", ",", 
      "ui", ",", "cci", ",", "tti", ",", "lli", ",", "uui", ",", "cc", ",", 
      "tt", ",", "ll", ",", "uu", ",", "u0", ",", "u1", ",", "u2"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ds", ",", "sd\[Kappa]n", ",", "sd\[Kappa]g", ",", "sd\[Tau]g"}], 
       "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "&"}], ",", 
        RowBox[{"1", "&"}], ",", 
        RowBox[{"0", "&"}], ",", 
        RowBox[{"0", "&"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "cci", ",", "tti", ",", "lli", ",", "uui"}], "}"}], 
      "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cc", ",", "tt", ",", "ll", ",", "uu"}], "}"}], "=", 
      RowBox[{"RecoverDarboux3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ds", ",", "sd\[Kappa]n", ",", "sd\[Kappa]g", ",", "sd\[Tau]g"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "cci", ",", "tti", ",", "lli", ",", "uui"}], 
         "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<cc = \>\"", ",", 
       RowBox[{"cc", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<tt = \>\"", ",", 
       RowBox[{"tt", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ll = \>\"", ",", 
       RowBox[{"ll", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u2", "=", 
      RowBox[{"\[Pi]", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"StyledCurve", "[", 
           RowBox[{"cc", ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"StyledDarbouxTrihedron", "[", 
           RowBox[{
            RowBox[{"cc", "[", "u2", "]"}], ",", 
            RowBox[{"tt", "[", "u2", "]"}], ",", 
            RowBox[{"ll", "[", "u2", "]"}], ",", 
            RowBox[{"uu", "[", "u2", "]"}], ",", 
            RowBox[{"DarbouxVectorLength", "\[Rule]", ".5"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], ",", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
