Cell[TextData[{
 "WindingNumber[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["face",
  FontSlant->"Italic"],
 "] returns the intrinsic winding number of the face, i.e., how many CCW \
turns it makes before it closes, where ",
 StyleBox["face",
  FontSlant->"Italic"],
 " is given as a list of indices into ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.458174423006332*^9, 3.458174447308517*^9}, {
   3.458174554317867*^9, 3.45817457202006*^9}, {3.458213578152179*^9, 
   3.458213621075598*^9}, 3.484829044319221*^9, {3.5953391947080913`*^9, 
   3.5953392087375727`*^9}, {3.595341803778609*^9, 3.595341815977005*^9}, {
   3.6289588399264936`*^9, 
   3.628958840360491*^9}},ExpressionUUID->"5ebe5208-2956-4f12-817e-\
4b150ee253eb"],

