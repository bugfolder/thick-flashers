 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "LocalFaceOrdering", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"FaceupFace", "\[Rule]", "1"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.484781807989344*^9, 3.484781827128224*^9}, 
   3.484781902077381*^9, 3.484785636639722*^9, 3.484820034363487*^9, 
   3.628786903420834*^9, 3.628863672259514*^9},
