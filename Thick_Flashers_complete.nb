       RowBox[{"p", ",", "q"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ai", ",", "t", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
