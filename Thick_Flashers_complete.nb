Cell[TextData[{
 "Note that we can identify vertex position (top or bottom) by its incidence \
with either a ",
 StyleBox["bt",
  FontSlant->"Italic"],
 " or ",
 StyleBox["tp",
  FontSlant->"Italic"],
 " fold (ignoring the ",
 StyleBox["cn",
  FontSlant->"Italic"],
 " folds)."
}], "Text",
 CellChangeTimes->{{3.911815405283017*^9, 
  3.911815454445475*^9}},ExpressionUUID->"5cb3eeb8-14f4-48fc-aecd-\
65a070aaa4c9"],

Cell["Show a table of sectors with different r and h-values.", "Text",
 CellChangeTimes->{{3.913479320276263*^9, 
  3.91347934325137*^9}},ExpressionUUID->"36277623-7386-4c53-bfdb-\
2b8ca6a6f9df"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", "r", ",", "h", ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"k", "=", "0"}], ",", "table", ",", "lines", ",", "verts"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"table", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"lines", "=", 
         RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
          RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"verts", "=", 
         RowBox[{"Union", "[", 
          RowBox[{"Cases", "[", 
           RowBox[{"lines", ",", 
            SubscriptBox["p", 
             RowBox[{"_", ",", "_", ",", "_"}]], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"Line", "[", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}], ",", 
                  RowBox[{"FlasherBTCStyle", "[", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "4", 
                    "\[RightDoubleBracket]"}], "]"}], ",", 
                  RowBox[{"AbsoluteThickness", "[", "3", "]"}]}], "]"}], 
                "&"}], "/@", "lines"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"FlasherVertexLabel", "[", 
                 RowBox[{"\"\<p\>\"", ",", "#"}], "]"}], "&"}], "/@", 
               "verts"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], "/.", 
            RowBox[{"FlasherDefaultCPRules", "[", 
             RowBox[{"p", ",", "m"}], "]"}]}], "/.", 
           RowBox[{"OrigamiStyle", "[", "]"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"\"\<r = \>\"", "<>", 
            RowBox[{"ToString", "[", "r", "]"}], "<>", "\"\<, h = \>\"", "<>", 
            RowBox[{"ToString", "[", "h", "]"}]}]}]}], "]"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"GraphicsGrid", "[", "table", "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
