Cell[TextData[{
 "FlasherFirstSectorVertices[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 "] returns just those vertices whose third index is zero."
}], "Text",
