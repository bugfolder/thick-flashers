Cell[TextData[{
 "CreasePatternPolys[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph+TAssigned and returns a list of Graphics elements that \
gives a set of polygons for the crease pattern, using PaperWhiteSideFill."
}], "Text",
