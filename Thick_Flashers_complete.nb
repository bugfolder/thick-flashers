         RowBox[{".5", ",", "1.2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"info", "=", 
      RowBox[{"QuasiConvexPolygonIntersectionInfo", "[", "poly", "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"AppendFirst", "[", "poly", "]"}], "]"}], ",", 
            "LightGray", ",", 
            RowBox[{"AbsoluteThickness", "[", "10", "]"}]}], "]"}], ",", 
          RowBox[{"(*", " ", "polygon", " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"AppendFirst", "[", 
              RowBox[{"RectVertices", "@@", 
               RowBox[{"Transpose", "[", 
                RowBox[{
                "info", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}], "]"}]}], "]"}], "]"}], ",", 
            "Green"}], "]"}], ",", 
          RowBox[{"(*", " ", 
           RowBox[{"bounding", " ", "box"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"AppendFirst", "[", "#", "]"}], "]"}], ",", "Red"}], 
             "]"}], "&"}], "/@", 
           RowBox[{
           "info", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}]}],
          "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
           "info", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
           ",", "\"\<convex\>\"", ",", "\"\<nonconvex\>\""}], "]"}]}]}], 
       "]"}], "]"}]}]}], 
   RowBox[{"(*", " ", "triangulation", " ", "*)"}], "\[IndentingNewLine]", 
