Cell[TextData[{
 "MakeCCW[",
 StyleBox["verts",
  FontSlant->"Italic"],
 "] takes a list of vertices that describes a closed path and gives it a \
nonnegative winding number."
}], "Text",
 CellChangeTimes->{{3.55191801205171*^9, 
  3.551918071711515*^9}},ExpressionUUID->"4c3a6c8c-a190-4638-a398-\
cd8212c9ad52"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeCCW", "[", "verts_List", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"WindingNumber", "[", 
      RowBox[{"verts", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "verts", "]"}], "]"}]}], "]"}], "\[GreaterEqual]",
      "0"}], ",", "verts", ",", 
    RowBox[{"Reverse", "[", "verts", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.551918096722212*^9, 3.551918140856982*^9}, 
   3.627328599346993*^9},
 CellLabel->
  "In[1172]:=",ExpressionUUID->"0beaa256-19f9-4fa2-9a15-2ac623f1a85d"],

