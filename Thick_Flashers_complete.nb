Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Polygon3DPlanarAndConvexQ", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PlanarTolerance", "\[Rule]", 
      SuperscriptBox["10.", 
       RowBox[{"-", "6"}]]}], ",", "\[IndentingNewLine]", 
     RowBox[{"ConvexTolerance", "\[Rule]", 
      SuperscriptBox["10.", 
       RowBox[{"-", "6"}]]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.459035187305804*^9, 3.459035207527016*^9}, 
