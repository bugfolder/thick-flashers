}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlatFoldableAnglesQ[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FlatFoldableTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.617305521137784*^9, 3.617305523470916*^9}, 
   3.708342446977486*^9},ExpressionUUID->"8437a359-9061-4cdd-b94e-\
73543db1e2ca"],

Cell[TextData[{
 "FlatFoldableAnglesQ[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns True if the given list of sector angles satisfies the \
Kawasaki-Justin condition that alternating angle sums are equal. Options are:\
\n\tFlatFoldableTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the tolerance in angular error."
}], "Text",
 CellChangeTimes->{{3.457896704326672*^9, 3.457896758076642*^9}, 
   3.594898772402351*^9, {3.708342952840048*^9, 
   3.708342957431674*^9}},ExpressionUUID->"18e100ab-ad43-4be0-ab94-\
1b86c472fb50"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlatFoldableTolerance", "::", "usage"}], 
   "=", "\"\<FlatFoldableTolerance is an option used in FlatFoldableAnglesQ \
to determine whether a vertex is flat-foldable.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.708342774570535*^9, 3.708342797321063*^9}},
 CellLabel->
  "In[602]:=",ExpressionUUID->"69e3cfcd-7370-4c97-b8c5-191a0f01c664"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FlatFoldableAnglesQ", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"FlatFoldableTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.457896361860256*^9, 3.457896378673753*^9}, 
   3.457896777353316*^9, 3.594898772436661*^9, 3.708342447921362*^9},
 CellLabel->
  "In[603]:=",ExpressionUUID->"2913d390-8ed7-4d3f-a2a4-8fe18ceab406"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlatFoldableAnglesQ", "::", "oddsecs"}], 
   "=", "\"\<Sector angles `1` do not have an even number of entries.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.484065731095915*^9, 3.484065731245717*^9}, {
   3.484065765197748*^9, 3.4840657912896223`*^9}, 3.594898772685294*^9},
 CellLabel->
  "In[604]:=",ExpressionUUID->"b2fc0df1-a893-4b51-b4cf-5ab4a2be0a0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlatFoldableAnglesQ", "[", 
   RowBox[{"sectorangles_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tol", ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"FlatFoldableTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FlatFoldableAnglesQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "sectorangles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"n", ",", "2"}], "]"}], "\[Equal]", "1"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"FlatFoldableAnglesQ", "::", "oddsecs"}], ",", 
          "sectorangles"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"FlatFoldabilityExcess", "[", "sectorangles", "]"}], "//", 
        "N"}], "]"}], "\[LessEqual]", "tol"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.45789678120051*^9, 3.457896910263212*^9}, {
   3.457896951811858*^9, 3.457897019051096*^9}, {3.4578970860741158`*^9, 
   3.457897114823284*^9}, {3.484065796045854*^9, 3.484065819432704*^9}, {
   3.594898772936324*^9, 3.594898773420299*^9}, {3.5949409099059362`*^9, 
