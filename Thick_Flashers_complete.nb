  RowBox[{
   RowBox[{"DihedralTypes", "::", "usage"}], 
   "=", "\"\<DihedralTypes is a TObj property that specifies the dihedral \
fold types around a vertex.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592075703941037*^9, 3.59207575104498*^9}, {
   3.592075800988728*^9, 3.592075805571813*^9}, 3.592435753005577*^9, {
