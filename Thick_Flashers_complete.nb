 CellChangeTimes->{{3.804529255360052*^9, 3.804529259672828*^9}, {
  3.804530302016011*^9, 3.804530363145432*^9}, {3.804530491327867*^9, 
  3.8045305088728456`*^9}, {3.804530898234567*^9, 3.804530901498275*^9}, {
  3.804786140957287*^9, 
  3.804786141233781*^9}},ExpressionUUID->"fb19b2b9-34f7-433a-ae92-\
f011ecfe0e04"],

Cell[TextData[{
 "NLinkedFoldsFirst3D[",
 StyleBox["f0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ffi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["uui",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] take a pair of 2D folds and a specification of the equivalent fold angle \
of the first fold and returns the 3D form of the first fold along with its \
right-side Darboux frame."
}], "Text",
 CellChangeTimes->{{3.804520344065229*^9, 3.804520407646842*^9}, 
   3.804521478960495*^9, {3.804524856762217*^9, 3.804524888632165*^9}, {
   3.804530599850801*^9, 3.80453067446478*^9}, 
   3.804532265229114*^9},ExpressionUUID->"aee1a2a8-9a28-46ed-9f35-\
d305b7ef09b6"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f0",
  FontSlant->"Italic"],
 " \[LongDash] first 2D fold as a pure function, parameterized on the common \
parameter.\n\t",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 "0 \[LongDash] equivalent fold angle of the first fold, parameterized on the \
common parameter.\n\t",
 StyleBox["f1",
  FontSlant->"Italic"],
 " \[LongDash] second 2D fold, parameterized on the common parameter.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] parameter of the initial condition.\n\t",
 StyleBox["ffi",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the fold line in 3D.\n\t",
 StyleBox["tti",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the tangent vector in 3D.\n\t",
 StyleBox["uui",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the surface normal vector in 3D.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interest."
}], "Text",
 CellChangeTimes->{{3.6941075557750607`*^9, 3.6941076220877542`*^9}, {
  3.804520437112335*^9, 3.804520560967535*^9}, {3.804530910546935*^9, 
  3.804530927379313*^9}, {3.804534243587432*^9, 3.804534294587122*^9}, {
  3.804786142406918*^9, 3.804786142575596*^9}, {3.804786378041048*^9, 
  3.804786395449966*^9}},ExpressionUUID->"ab355c38-8605-4f57-bb6e-\
a6fe98b0ce26"],

Cell[TextData[{
 "Options:\n\tOptions[FunctionInterpolation] are passed through to \
NCurve2DSystem (if needed) and NRecoverDarboux3D.\n\tCurve2DSystems \[Rule] \
Automatic | ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", lets you provide a precomputed Curve2DSystem for the fold line. Note that \
even though you\[CloseCurlyQuote]re only providing a system for a single fold \
line, it should be wrapped in {} to be consistent with other usages of this \
option."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691935258654289*^9, 
   3.691935301197094*^9}, 3.694107675753793*^9, {3.80452826964774*^9, 
   3.804528357632792*^9}, {3.804531617975843*^9, 3.804531651616992*^9}, {
   3.804534169914857*^9, 
   3.804534226011401*^9}},ExpressionUUID->"365f9175-5592-46bb-9047-\
36a87759d26a"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["ff0,tt0,llR0, uuR0",
  FontSlant->"Italic"],
 "} of the 3D fold and its right Darboux frame components (which are needed \
to propagate to the next fold)."
}], "Text",
 CellChangeTimes->{{3.69410782343384*^9, 3.694107846737583*^9}, {
  3.804520569784155*^9, 3.804520595488785*^9}, {3.804522537342538*^9, 
  3.804522570693509*^9}, {3.804531665303877*^9, 3.804531714880105*^9}, {
  3.804532238860955*^9, 
  3.804532249060708*^9}},ExpressionUUID->"90cc1333-1352-4227-acb8-\
ee67fcdf013f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "NLinkedFoldsFirst3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Curve2DSystems", "\[Rule]", "Automatic"}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.804530848990838*^9, 3.804530879610387*^9}},
 CellLabel->
  "In[4076]:=",ExpressionUUID->"9586c0be-473b-4446-a333-f077670a4469"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NLinkedFoldsFirst3D", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.804533968540135*^9, 3.804533978822441*^9}},
 CellLabel->
  "In[4077]:=",ExpressionUUID->"a36f7e81-164e-42fc-9733-3783884879a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NLinkedFoldsFirst3D", "[", 
   RowBox[{
    RowBox[{"f0_Function", "|", "f0_InterpolatingFunction"}], ",", 
    RowBox[{"\[Gamma]0_Function", "|", "\[Gamma]0_InterpolatingFunction"}], ",", 
    RowBox[{"f1_Function", "|", "f1_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "ffi_List", ",", "tti_List", ",", "uui_List"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cs", ",", "c2dsys", ",", "s", ",", "ds0", ",", "t0", ",", "l0", ",", 
      "\[Kappa]g0", ",", "ds\[Kappa]g0", ",", "ds\[Kappa]n0", ",", 
      "ds\[Tau]g0", ",", "lli", ",", "ff", ",", "tt", ",", "ll", ",", "uu"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cs", "=", 
      RowBox[{
       RowBox[{"Curve2DSystems", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NLinkedFoldsFirst3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c2dsys", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cs", "===", "Automatic"}], ",", 
        RowBox[{"NCurve2DSystem", "[", 
         RowBox[{"f0", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}], ",", 
        RowBox[{
        "cs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds0", ",", "t0", ",", "l0", ",", "\[Kappa]g0"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed2D", ",", "TangentVector2D", ",", "LeftNormalVector2D", ",", 
         "LeftCurvature2D"}], "}"}], "/.", "c2dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds\[Kappa]g0", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ds0", "[", "s", "]"}], 
         RowBox[{"\[Kappa]g0", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds\[Kappa]n0", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ds\[Kappa]g0", "[", "s", "]"}], 
         RowBox[{"Tan", "[", 
          FractionBox[
           RowBox[{"\[Gamma]0", "[", "s", "]"}], "2"], "]"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ds\[Tau]g0", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"ds\[Kappa]n0", "[", "s", "]"}]}], 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f1", "[", "s", "]"}], "-", 
             RowBox[{"f0", "[", "s", "]"}]}], ")"}], ".", 
           RowBox[{"t0", "[", "s", "]"}]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f1", "[", "s", "]"}], "-", 
             RowBox[{"f0", "[", "s", "]"}]}], ")"}], ".", 
           RowBox[{"l0", "[", "s", "]"}]}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lli", "=", 
      RowBox[{"uui", "\[Cross]", "tti"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"NRecoverDarboux3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ds0", ",", "ds\[Kappa]g0", ",", "ds\[Kappa]n0", ",", "ds\[Tau]g0"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ui", ",", "ffi", ",", "tti", ",", "lli", ",", "uui"}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.804530468102902*^9, 3.804530571337131*^9}, {
  3.804530883555043*^9, 3.804530891682899*^9}, {3.8045314576738653`*^9, 
  3.804531506703065*^9}, {3.804531572722105*^9, 3.804531612808575*^9}, {
  3.804531733353096*^9, 3.804531989596025*^9}, {3.804532059463458*^9, 
  3.804532233356983*^9}, {3.804532930133456*^9, 3.804532932426887*^9}, {
  3.804786150210682*^9, 3.804786155456631*^9}},
 CellLabel->
  "In[4078]:=",ExpressionUUID->"faab9d24-c39e-46b2-8e1c-dcbbe4326840"],

Cell["Example. Concentric circles.", "Text",
 CellChangeTimes->{{3.8045328134887533`*^9, 
  3.804532817856969*^9}},ExpressionUUID->"518dd3d0-b33f-4149-a686-\
1f8c92c5bb79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "w", ",", "e", ",", "u0", ",", "u1", ",", "s", ",", "tf", ",", "q", ",", 
      "\[Gamma]", ",", "f", ",", "ff", ",", "tt", ",", "ll", ",", "uu", ",", 
      "flist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tf", "[", "i_", "]"}], ":=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"i", " ", "w"}]}], ")"}], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "s", "]"}], ",", 
           RowBox[{"Sin", "[", "s", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"f", "[", "i", "]"}], "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{"tf", "[", "i", "]"}], "[", 
          RowBox[{
           RowBox[{"q", "[", "i", "]"}], "[", "s", "]"}], "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "0", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "1", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"s", "+", 
         RowBox[{"e", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", "s"}], "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "0", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"120.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ff", "[", "0", "]"}], ",", 
        RowBox[{"tt", "[", "0", "]"}], ",", 
        RowBox[{"ll", "[", "0", "]"}], ",", 
        RowBox[{"uu", "[", "0", "]"}]}], "}"}], "=", 
      RowBox[{"NLinkedFoldsFirst3D", "[", 
       RowBox[{
        RowBox[{"f", "[", "0", "]"}], ",", 
        RowBox[{"\[Gamma]", "[", "0", "]"}], ",", 
        RowBox[{"f", "[", "1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"StyledCurve", "[", 
            RowBox[{
             RowBox[{"ff", "[", "0", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"StyledDarbouxTrihedron", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ff", "[", "0", "]"}], "[", "u", "]"}], ",", 
               RowBox[{
                RowBox[{"tt", "[", "0", "]"}], "[", "u", "]"}], ",", 
               RowBox[{
                RowBox[{"ll", "[", "0", "]"}], "[", "u", "]"}], ",", 
               RowBox[{
                RowBox[{"uu", "[", "0", "]"}], "[", "u", "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"DarbouxVectorLength", "\[Rule]", "0.2"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"u", ",", "u0", ",", "u1", ",", 
               FractionBox[
                RowBox[{"u1", "-", "u0"}], "10"]}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", "}"}]}], "}"}], ",", 
         RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "/.", "CurveVectorStyle"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.804525806550187*^9, 3.804526052815617*^9}, {
   3.804526113834241*^9, 3.804526125059143*^9}, 3.8045261954296913`*^9, {
   3.804527269499494*^9, 3.804527533379818*^9}, {3.804527571943935*^9, 
   3.804527572783236*^9}, {3.804528900759533*^9, 3.804528904188818*^9}, {
   3.804532851285297*^9, 3.804533180012892*^9}, {3.804533258280259*^9, 
   3.804533260179249*^9}, 3.804613089206986*^9, {3.804613159437495*^9, 
   3.804613169403595*^9}, {3.804613340157676*^9, 3.804613343035552*^9}, 
   3.804615404555579*^9},
 CellLabel->
  "In[4079]:=",ExpressionUUID->"47d4e8da-a356-4abb-8fe4-9aa8d3bc17b0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "NLinkedFoldsNext3D[",
 StyleBox["f0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ff0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tt0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ll0",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[FunctionInterpolation], Curve2DSystems"
}], "Subsubsection",
 CellChangeTimes->{{3.804533271387804*^9, 3.804533276211629*^9}, {
   3.8045337720157557`*^9, 3.804533802831626*^9}, {3.804534084786318*^9, 
   3.804534092001712*^9}, 3.804534144381172*^9, {3.804536562066574*^9, 
   3.804536563715212*^9}},ExpressionUUID->"be361f49-1178-48d3-bed1-\
f7e4fa9d1eda"],

Cell[TextData[{
 "NLinkedFoldsNext3D[",
 StyleBox["f0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", \[Gamma]",
 StyleBox["1, ff0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tt0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ll0",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a pair of 2D folds, the fold angle of the second fold, and the \
first fold in 3D with its 3D Darboux frame components and computes the 3D \
form of the second fold along with its Darboux frame components."
}], "Text",
 CellChangeTimes->{{3.804520344065229*^9, 3.804520407646842*^9}, 
   3.804521478960495*^9, {3.804524856762217*^9, 3.804524888632165*^9}, {
   3.804530599850801*^9, 3.80453067446478*^9}, 3.804532265229114*^9, {
   3.804534008562969*^9, 3.804534055481596*^9}, {3.8045340991053557`*^9, 
   3.8045341162426786`*^9}, {3.804536592507966*^9, 
   3.804536626059284*^9}},ExpressionUUID->"81a0fae3-0110-4810-b824-\
dc3fe50fde2e"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f0",
  FontSlant->"Italic"],
 " \[LongDash] first 2D fold as a pure function.\n\t",
 StyleBox["f1",
  FontSlant->"Italic"],
 " \[LongDash] second 2D fold, parameterized on its own parameter.\n\t",
 StyleBox["\[Gamma]1",
  FontSlant->"Italic"],
 " \[LongDash] the fold angle at the second fold.\n\t",
 StyleBox["ff0",
  FontSlant->"Italic"],
 " \[LongDash] first fold in 3D.\n\t",
 StyleBox["tt0",
  FontSlant->"Italic"],
 " \[LongDash] tangent vector of the first fold in 3D.\n\t",
 StyleBox["ll0",
  FontSlant->"Italic"],
 " \[LongDash] left normal vector of the first fold in 3D.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interest."
}], "Text",
 CellChangeTimes->{{3.6941075557750607`*^9, 3.6941076220877542`*^9}, {
   3.804520437112335*^9, 3.804520560967535*^9}, {3.804530910546935*^9, 
   3.804530927379313*^9}, 3.804534313155135*^9, {3.804534359460514*^9, 
   3.804534406035472*^9}, {3.80453657011433*^9, 
   3.8045365798353987`*^9}},ExpressionUUID->"7c9e062a-07b4-4c4c-944e-\
dae864844b33"],

Cell[TextData[{
 "Options:\n\tOptions[FunctionInterpolation] are passed through to \
NCurve2DSystem (if needed) and FunctionInterpolation.\n\tCurve2DSystems \
\[Rule] Automatic | ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", lets you provide precomputed Curve2DSystems for the fold lines."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691935258654289*^9, 
   3.691935301197094*^9}, 3.694107675753793*^9, {3.80452826964774*^9, 
   3.804528357632792*^9}, {3.804531617975843*^9, 3.804531651616992*^9}, 
   3.804534346228791*^9, {3.804534810126616*^9, 
   3.8045348278619843`*^9}},ExpressionUUID->"a2ba1959-556a-4a65-a714-\
2b083c235386"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["ff0,tt0,llR0, uuR0",
  FontSlant->"Italic"],
 "} of the 3D fold and its right Darboux frame components (which are needed \
to propagate to the next fold)."
}], "Text",
 CellChangeTimes->{{3.69410782343384*^9, 3.694107846737583*^9}, {
