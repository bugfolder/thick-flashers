       RowBox[{"sf", "===", "Automatic"}], ",", 
       RowBox[{"sf", "=", 
        RowBox[{"Length", "[", "newfaces", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph2D", "[", 
       RowBox[{"tobj", ",", "foldangles", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "sf"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fverts", "=", 
      RowBox[{"tobj", "[", "Vertices2D", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"fverts", "=", 
      RowBox[{"CircularlyExtendEdges", "[", 
       RowBox[{"fverts", ",", "newedges", ",", 
        RowBox[{"tobj", "[", "BoundaryVertices", "]"}], ",", 
