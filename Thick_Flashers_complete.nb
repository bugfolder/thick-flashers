Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NFoldSurfaceToCone", "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.79944345788535*^9, 3.7994434660770397`*^9}, 
   3.799449160594543*^9, 3.799497642549408*^9, 3.799697145106863*^9, 
   3.8004652044028993`*^9, 3.801174701267898*^9, 3.801503413343178*^9, 
   3.801590629199876*^9, 3.8016588777471647`*^9},
 CellLabel->
  "In[4045]:=",ExpressionUUID->"95afeb5c-9c1f-49c1-925a-c761470cb76b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NFoldSurfaceToCone", "[", 
   RowBox[{
   "b1_Function", ",", "d1_Function", ",", "bb1_Function", ",", 
    "dd1_Function", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "b2i_List", ",", "bb2i_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "vi", ",", "fi", ",", "ffi", ",", "d2i", ",", "dd2i", ",", 
      "\[Psi]", ",", "d23", ",", "b2", ",", "bb2", ",", "d2", ",", "dd2", ",",
       "f", ",", "ff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vi", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"Mag2", "[", 
         RowBox[{"b2i", "-", 
          RowBox[{"b1", "[", "ui", "]"}]}], "]"}], "-", 
        RowBox[{"Mag2", "[", 
         RowBox[{"bb2i", "-", 
          RowBox[{"bb1", "[", "ui", "]"}]}], "]"}]}], 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b2i", "-", 
             RowBox[{"b1", "[", "ui", "]"}]}], ")"}], ".", 
           RowBox[{"d1", "[", "ui", "]"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"bb2i", "-", 
             RowBox[{"bb1", "[", "ui", "]"}]}], ")"}], ".", 
           RowBox[{"dd1", "[", "ui", "]"}]}]}], ")"}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fi", "=", 
      RowBox[{
       RowBox[{"b1", "[", "ui", "]"}], "+", 
       RowBox[{"vi", " ", 
        RowBox[{"d1", "[", "ui", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ffi", "=", 
      RowBox[{
       RowBox[{"bb1", "[", "ui", "]"}], "+", 
       RowBox[{"vi", " ", 
        RowBox[{"dd1", "[", "ui", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d2i", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"b2i", "-", "fi"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd2i", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"bb2i", "-", "ffi"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"Sign", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"d1", "[", "ui", "]"}], ".", "d2i"}], "-", 
        RowBox[{
         RowBox[{"dd1", "[", "ui", "]"}], ".", "dd2i"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d23", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", ",", "fp", ",", "ffp"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"v", "=", 
            FractionBox[
             RowBox[{
              RowBox[{"Mag2", "[", 
               RowBox[{"b2i", "-", 
                RowBox[{"b1", "[", "s", "]"}]}], "]"}], "-", 
              RowBox[{"Mag2", "[", 
               RowBox[{"bb2i", "-", 
                RowBox[{"bb1", "[", "s", "]"}]}], "]"}]}], 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"b2i", "-", 
                   RowBox[{"b1", "[", "s", "]"}]}], ")"}], ".", 
                 RowBox[{"d1", "[", "s", "]"}]}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"bb2i", "-", 
                   RowBox[{"bb1", "[", "s", "]"}]}], ")"}], ".", 
                 RowBox[{"dd1", "[", "s", "]"}]}]}], ")"}]}]]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"fp", "=", 
            RowBox[{
             RowBox[{"b1", "[", "s", "]"}], "+", 
             RowBox[{"v", " ", 
              RowBox[{"d1", "[", "s", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"ffp", "=", 
            RowBox[{
             RowBox[{"bb1", "[", "s", "]"}], "+", 
             RowBox[{"v", " ", 
              RowBox[{"dd1", "[", "s", "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", " ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"\[Psi]", 
              RowBox[{"(", 
               RowBox[{"b2i", "-", "fp"}], ")"}]}], ",", 
             RowBox[{"\[Psi]", 
              RowBox[{"(", 
               RowBox[{"bb2i", "-", "ffp"}], ")"}]}], ",", "fp", ",", "ffp"}],
             "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "b2i"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "bb2i"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"d23", "[", "s", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"d23", "[", "s", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4", ",", "5"}], "}"}], 
         "\[RightDoubleBracket]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
