Cell[TextData[{
 "Options:\n\tMinimumPleatSize \[Rule] ",
 StyleBox["dmin",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["dmin",
  FontSlant->"Italic"],
 " is the minimum pleat width relative to the inset distance. Default value \
is equal to the inset distance, i.e., 1.\n\tMinimumBorderPleatSize \[Rule]",
 StyleBox["dbmin",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["dbmin",
  FontSlant->"Italic"],
 " is the minimum width of border pleats for diverging pleats, also relative \
to the inset distance. Default value is 0.01.\n\tWovenParity \[Rule]\
\[PlusMinus]1, which lets you switch the direction of the overlaps.\n\t\
StationaryFace \[Rule]",
 StyleBox["k",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is the index of the face of the original graph to hold stationary; this \
gives a preferred orientation to the crease pattern.\n\t\
ShowProgress\[Rule]True | False, if True, displays intermediate results. Very \
useful if you need to debug things."
}], "Text",
 CellChangeTimes->{{3.721846091165162*^9, 
  3.7218460935844173`*^9}},ExpressionUUID->"e3e51aef-fa64-411c-815f-\
fa5d205805b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeSimpleWovenTessellationOld", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MinimumPleatSize", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"MinimumBorderPleatSize", "\[Rule]", "0.01"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"WovenParity", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"StationaryFace", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.462808837367454*^9, 3.46280888118054*^9}, 
   3.462899289199026*^9, 3.46334998392667*^9, {3.463350142076664*^9, 
   3.463350148635154*^9}, 3.533604274502256*^9, 3.592562067168296*^9, 
