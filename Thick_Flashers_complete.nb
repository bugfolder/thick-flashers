Cell["Derivation.", "Text",
 CellChangeTimes->{{3.799748647747933*^9, 
  3.799748649379026*^9}},ExpressionUUID->"7156c93e-58b9-41a4-a60a-\
8b32f5e3e6b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r", ",", "\[Theta]", ",", "\[Gamma]", ",", "\[Gamma]fn", ",", "as", ",",
        "ff", ",", "rrL", ",", "rrR", ",", "s"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ff", "=", 
       RowBox[{
        RowBox[{"r", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "#", "]"}], ",", 
           RowBox[{"Sin", "[", "#", "]"}], ",", 
           RowBox[{
            RowBox[{"Tan", "[", "\[Theta]", "]"}], "#"}]}], "}"}]}], "&"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"\[Gamma]fn", "=", 
       RowBox[{
        RowBox[{"\[Gamma]", "[", "#", "]"}], "&"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"as", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", ">", "0"}], ",", 
         RowBox[{"\[Theta]", "\[Element]", "Reals"}], ",", 
         RowBox[{
          RowBox[{"Sec", "[", "\[Theta]", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], ">", "0"}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
       RowBox[{"FoldSpaceCurve3D", "[", 
        RowBox[{"ff", ",", "\[Gamma]fn", ",", 
         RowBox[{"+", "1"}], ",", 
         RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
         RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<ff = \>\"", ",", 
        RowBox[{"ff", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrL = \>\"", ",", 
        RowBox[{"rrL", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrR = \>\"", ",", 
        RowBox[{"rrR", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Some", " ", "additional", " ", "simplification"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"rrL", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"rrL", "[", "s", "]"}], ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rrR", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"rrR", "[", "s", "]"}], ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<after FullSimplify\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrL = \>\"", ",", 
        RowBox[{"rrL", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrR = \>\"", ",", 
        RowBox[{"rrR", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"and", " ", "one", " ", "more", " ", "round"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"rrL", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rrL", "[", "s", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               SuperscriptBox[
                RowBox[{"Sin", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}], ",", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"Cos", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}]}], "}"}]}], ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rrR", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rrR", "[", "s", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               SuperscriptBox[
                RowBox[{"Sin", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}], ",", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"Cos", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}]}], "}"}]}], ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<after another round\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrL = \>\"", ",", 
        RowBox[{"rrL", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrR = \>\"", ",", 
        RowBox[{"rrR", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "Hold"}], ";"}]], "Input",
