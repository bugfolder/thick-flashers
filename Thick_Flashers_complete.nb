Cell["\<\
Example. This shows that if one property is itself a TObj, the inner TObj is \
left unaffected.\
\>", "Text",
 CellChangeTimes->{{3.592406233032224*^9, 3.5924062337110147`*^9}, {
  3.592679877823332*^9, 3.5926798929173803`*^9}, {3.592680560937481*^9, 
  3.592680580336442*^9}, {3.592682938616647*^9, 
  3.592682944815054*^9}},ExpressionUUID->"28bac2ad-be78-4b2d-ad0a-\
1e6ecfed124a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "tobj1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"TObj", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"A", "\[Rule]", "1"}], ",", 
         RowBox[{"B", "\[Rule]", "2"}], ",", 
         RowBox[{"C", "\[Rule]", "3"}], ",", 
         RowBox[{"D", "\[Rule]", 
          RowBox[{"TObj", "[", 
           RowBox[{"{", 
            RowBox[{"A", "\[Rule]", "1"}], "}"}], "]"}]}]}], "}"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"ReplacePropertyIn", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"A", "\[Rule]", "4"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"InputForm", "[", "tobj1", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.591380649270615*^9, 3.59138075708683*^9}, {
   3.591639909719424*^9, 3.591639944590732*^9}, {3.591640568949381*^9, 
