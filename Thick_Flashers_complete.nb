Cell[TextData[{
 "GenericGraphGraphics[",
 StyleBox["verts, edges, faces, opts",
  FontSlant->"Italic"],
 "] takes lists of 2D vertices, edges, and (optionally) faces, and displays \
them as a graph with labels as a Graphics object. The faces, if present, are \
outlined with inset polygons. "
}], "Text",
 CellChangeTimes->{{3.455897664154768*^9, 3.455897679891059*^9}, {
   3.4558992977778797`*^9, 3.455899342784955*^9}, {3.455905103069544*^9, 
   3.455905103508683*^9}, {3.457619187939378*^9, 3.457619200337386*^9}, {
   3.457619567181074*^9, 3.457619572868032*^9}, {3.458214769423289*^9, 
   3.458214770846797*^9}, 3.458214846784185*^9, {3.45821488857386*^9, 
   3.4582149009014072`*^9}, {3.4582612744064217`*^9, 3.458261278167647*^9}, {
   3.466090441534921*^9, 3.466090452702976*^9}, {3.483851828785248*^9, 
   3.483851839219041*^9}, {3.484780614676151*^9, 3.484780662144481*^9}, {
   3.484780717749148*^9, 3.484780754818267*^9}, 3.484832612511293*^9, {
   3.591635496048814*^9, 3.591635511702992*^9}, {3.591635581589568*^9, 
   3.591635672988778*^9}, {3.5916438757117577`*^9, 3.591643882524689*^9}, {
   3.591972868350522*^9, 3.5919728688283653`*^9}, {3.591972906409906*^9, 
   3.591972963078294*^9}, 3.592344301855607*^9, 3.592345815124137*^9, 
   3.592435845261342*^9, {3.593007132361692*^9, 3.593007157143457*^9}, {
   3.593007206886189*^9, 3.593007290311271*^9}, {3.594203830378222*^9, 
   3.594203877045233*^9}, {3.59420391495486*^9, 3.594203995085675*^9}, 
   3.594205731028701*^9, {3.594205828331354*^9, 3.594206006029976*^9}, 
   3.5942060923807707`*^9, {3.594206442819364*^9, 3.594206443323384*^9}, {
   3.5942065064814377`*^9, 3.594206572762784*^9}, {3.594211224410583*^9, 
   3.594211239682662*^9}, {3.594211351593902*^9, 3.594211361025877*^9}, {
   3.5942114712349453`*^9, 3.594211484289915*^9}, {3.594734263715417*^9, 
   3.594734263852935*^9}, {3.595336968476759*^9, 3.595337029150654*^9}, {
   3.595337239978411*^9, 3.595337272551249*^9}, {3.595337775303211*^9, 
   3.595337776094305*^9}, {3.615141211552507*^9, 3.615141260211809*^9}, {
   3.6278443426306477`*^9, 3.627844343789419*^9}, {3.70888760081394*^9, 
   3.708887631086184*^9}, 
   3.722091370031196*^9},ExpressionUUID->"650c4ec3-41e8-4059-8ae2-\
5bc40a51a726"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["verts",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D vertices.\n\t",
 StyleBox["edges",
  FontSlant->"Italic"],
 " \[LongDash] a list of index pairs into ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ".\n\t",
 StyleBox["faces",
  FontSlant->"Italic"],
 " \[LongDash] a list of index sets specifying the faces in CCW order."
}], "Text",
 CellChangeTimes->{{3.755703543564297*^9, 
  3.755703592605679*^9}},ExpressionUUID->"3c6e362b-ed7d-4490-b4b5-\
c373d6e04f20"],

Cell[TextData[{
 "Options:\n\tVertexLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"9fb9638f-6313-47c9-9465-e298f59ed0f9"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "f60b9a1f-c23d-4164-8d22-33adc75b8438"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th vertex.\n\tEdgeLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"b5ae1fc8-7832-40d9-ae1a-f2aa32f88af3"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "3bf6a9f9-68e5-42f8-9e36-a250365d832e"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th edge.\n\tFaceLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"04928a69-8059-4c9f-b976-c97f7b416ef3"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "db6e16a4-a96e-43eb-a133-6d3749825502"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th face.\n\tDirectedEdges \[Rule] True | False, specifies whether to show \
direction arrows on the edges\n\tFaces \[Rule] True | False, specifies \
whether to display faces. (If there are no faces, this setting doesn\
\[CloseCurlyQuote]t matter.)\n\tVertexColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 " | ",
 StyleBox["colors",
  FontSlant->"Italic"],
 ", specifies the base color to use for vertices and their labels.\n\t\
EdgeColor \[Rule] ",
 StyleBox["color | colors",
  FontSlant->"Italic"],
 ", specifies the base color to use for edges and their labels.\n\tFaceColor \
\[Rule] ",
 StyleBox["color | colors",
  FontSlant->"Italic"],
 ", specifies the base color to use for faces and their labels.\n\t\
FaceColoring\[Rule]None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["f", "1"], ",", " ", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"f838ca34-7965-4263-944f-3a5c8e6fe847"],
 ", where each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "i"], TraditionalForm]],ExpressionUUID->
  "3d304e64-e2f0-48a6-aa02-784658b2e9f0"],
 " can be -1, 0, or +1 and specifies that the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th face should be colored light, medium, or dark.\n\tOptions[Graphics] are \
passed through to Graphics."
}], "Text",
 CellChangeTimes->{{3.7088876038220186`*^9, 3.708887610170799*^9}, {
  3.755703602062256*^9, 3.755703602566702*^9}, {3.755705589035598*^9, 
  3.755705605002121*^9}},ExpressionUUID->"108fe504-e767-4117-aff8-\
8df907b2bc54"],

Cell["\<\
Returns: a Graphics object containing the desired representation.\
\>", "Text",
 CellChangeTimes->{{3.75570360766092*^9, 
  3.755703619244629*^9}},ExpressionUUID->"56b99892-af01-46de-98d0-\
6e409d46960c"],

Cell["\<\
Note that VertexLabels and EdgeLabels are symbols that are already defined as \
options to Graph, but the format of the specification is different for this \
function. For GenericGraphGraphics, each specification is a list of the \
graphical objects that represent the labels in the same order as the object \
that they label and each label includes its position information.\
\>", "Text",
 CellChangeTimes->{
  3.7088876123098087`*^9},ExpressionUUID->"3ddfe2a7-b6a1-45da-b343-\
07f27f58218f"],

Cell["\<\
This function is useful for doing a quick visualization of a graph and \
checking whether it is well-formed; overlapping vertex or edge labels imply \
duplicate vertices; improperly drawn faces imply improper parsing into face \
lists.\
\>", "Text",
 CellChangeTimes->{
  3.708887588126531*^9},ExpressionUUID->"8d10c5e4-4b97-4cdd-ae01-\
fa9f29e216e7"],

Cell["\<\
GenericGraphGraphics actually works if we pass 3D vertices and you change the \
wrapper from Graphics to Graphics3D. We use this in the definition of \
GenericGraphGraphics3D, below.\
\>", "Text",
 CellChangeTimes->{{3.708887514490863*^9, 
  3.708887543594572*^9}},ExpressionUUID->"fcefd085-6a8c-4934-96b1-\
18b84e74050c"],

