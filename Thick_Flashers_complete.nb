  RowBox[{
   RowBox[{"NormalCurvature3D", "::", "usage"}], 
   "=", "\"\<NormalCurvature3D is a key to the rules returned by \
CurveInSurface3DSystem that gives the normal curvature for a parameterized \
space curve embedded in a surface.\>\""}], ";"}]], "Input",
