    RowBox[{
     RowBox[{"elist", "=", 
      RowBox[{
       RowBox[{"MakeGoldbergTiling", "[", 
        RowBox[{"m", ",", "n"}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"elist", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"verts", ",", "edges"}], "]"}]}]}], "]"}]}]], "Input",
