 RowBox[{
  RowBox[{"HCwCPairGraphics", "[", 
   RowBox[{"hcwc_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gg", ",", "p0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gg", "=", 
      RowBox[{"HCwCGraphics", "[", 
       RowBox[{"hcwc", ",", " ", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p0", "=", 
      RowBox[{
       RowBox[{"hcwc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
        "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{"gg", ",", 
       RowBox[{"1", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "gg", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
