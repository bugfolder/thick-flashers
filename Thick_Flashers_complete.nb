Cell[BoxData[
 RowBox[{
  RowBox[{"PrimalDualGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "spe", ",", "sde", ",", "pde", ",", "dde", ",", "spv", ",", "sdv", ",", 
      "pvl", ",", "dvl", ",", "pvt", ",", "dvt", ",", "psbs", ",", "verts", ",",
       "edges", ",", "dverts", ",", "dedges", ",", "iedges", ",", "bedges", ",",
       "primalcolor", ",", "dualcolor", ",", "pg", ",", "dg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPrimalDualGraph", ",", "PrimalDualGraphics"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "dverts", ",", "dedges", ",", "iedges", ",",
         "bedges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "DualVertices", ",", "DualEdges", ",",
           "InteriorEdges", ",", "BoundaryEdges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"spe", "=", 
      RowBox[{
       RowBox[{"ShowPrimalEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sde", "=", 
      RowBox[{
       RowBox[{"ShowDualEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pde", "=", 
      RowBox[{
       RowBox[{"PrimalDirectedEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dde", "=", 
      RowBox[{
       RowBox[{"DualDirectedEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"spv", "=", 
      RowBox[{
       RowBox[{"ShowPrimalVertices", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sdv", "=", 
      RowBox[{
       RowBox[{"ShowDualVertices", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pvl", "=", 
      RowBox[{
       RowBox[{"PrimalVertexLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dvl", "=", 
      RowBox[{
       RowBox[{"DualVertexLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pvt", "=", 
      RowBox[{
       RowBox[{"PrimalVertexLetter", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dvt", "=", 
      RowBox[{
       RowBox[{"DualVertexLetter", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"psbs", "=", 
      RowBox[{
       RowBox[{"PlaceSideBySide", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PrimalDualGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"primalcolor", "=", 
      RowBox[{"ColorConvert", "[", 
       RowBox[{
        RowBox[{"Darker", "[", 
         RowBox[{"Orange", ",", "0.15"}], "]"}], ",", "\"\<CMYK\>\""}], 
       "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "darkening", " ", "slightly", " ", "gives", " ", "better", " ", 
       "contrast", " ", "in", " ", "projected", " ", "images"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dualcolor", "=", 
      RowBox[{"ColorConvert", "[", 
       RowBox[{
        RowBox[{"Darker", "[", 
         RowBox[{"Green", ",", "0.15"}], "]"}], ",", "\"\<CMYK\>\""}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pg", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{"spe", ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"EdgeLines", "[", 
               RowBox[{"verts", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                  "edges", "\[LeftDoubleBracket]", "#", 
                   "\[RightDoubleBracket]"}], "&"}], "/@", "bedges"}]}], 
               "]"}], ",", 
              RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
              "primalcolor"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{"pde", ",", "DirectedEdgeLines", ",", "EdgeLines"}], 
                "]"}], "[", 
               RowBox[{"verts", ",", "iedges", ",", "opts"}], "]"}], ",", 
              RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
              "primalcolor"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"spv", ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "/@", "verts"}], ",", 
              RowBox[{"Darker", "[", "primalcolor", "]"}], ",", 
              RowBox[{"AbsolutePointSize", "[", "4", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Switch", "[", 
               RowBox[{"pvl", ",", "None", ",", 
                RowBox[{"{", "}"}], ",", "Automatic", ",", 
                RowBox[{"StdVertexLabels", "[", 
                 RowBox[{"verts", ",", 
                  RowBox[{"VertexLetter", "\[Rule]", "pvt"}]}], "]"}], ",", 
                "_", ",", "pvl"}], "]"}], ",", 
              RowBox[{"Darker", "[", "primalcolor", "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"dg", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{"sde", ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{"dde", ",", "DirectedEdgeLines", ",", "EdgeLines"}], 
                "]"}], "[", 
               RowBox[{"dverts", ",", "dedges", ",", "opts"}], "]"}], ",", 
              RowBox[{"AbsoluteThickness", "[", "1.2", "]"}], ",", 
              "dualcolor"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Switch", "[", 
               RowBox[{"dvl", ",", "None", ",", 
                RowBox[{"{", "}"}], ",", "Automatic", ",", 
                RowBox[{"StdVertexLabels", "[", 
                 RowBox[{"dverts", ",", 
                  RowBox[{"VertexLetter", "\[Rule]", "dvt"}]}], "]"}], ",", 
                "_", ",", "dvl"}], "]"}], ",", 
              RowBox[{"Darker", "[", "dualcolor", "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"sdv", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "/@", "dverts"}], ",", 
              RowBox[{"Darker", "[", "dualcolor", "]"}], ",", 
              RowBox[{"AbsolutePointSize", "[", "4", "]"}]}], "]"}], ","}], 
           "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{"psbs", ",", 
         RowBox[{"PlaceInRowGraphics", "[", 
          RowBox[{"{", 
           RowBox[{"pg", ",", "dg"}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"pg", ",", "dg"}], "}"}]}], "]"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.461730007995272*^9, 3.461730057060281*^9}, {
   3.465987758941328*^9, 3.465987882074671*^9}, {3.465988759661803*^9, 
