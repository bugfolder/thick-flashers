Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "VeneerScoringCarveGraphics", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ImageSize", "\[Rule]", "360"}], ",", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"=", " ", 
        RowBox[{"5", " ", "in"}]}], ",", " ", 
       RowBox[{"12.7", " ", "cm"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ScoreLineThickness", "\[Rule]", "0.216"}], ",", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "hairline", " ", "width", " ", "in", " ", "Corel", " ", "Draw"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"VeneerThickness", "\[Rule]", "2.3"}], " ", ",", 
     RowBox[{"(*", " ", 
      RowBox[{"=", " ", 
       RowBox[{"32", " ", "mil"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"InvertFolds", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.624891090877987*^9, 3.624891100452592*^9}, {
   3.624891154930671*^9, 3.624891252761989*^9}, 3.6248913552856092`*^9, {
   3.62489187827492*^9, 3.624891917006983*^9}, {3.624894795896439*^9, 
   3.624894813662223*^9}, {3.6248958117117176`*^9, 3.624895818039281*^9}, 
   3.624913969121614*^9, 3.625164209203428*^9, 3.626360974784964*^9},
 CellLabel->
