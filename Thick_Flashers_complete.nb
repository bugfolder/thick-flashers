Cell[BoxData[
 RowBox[{
  RowBox[{"Graph2DGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vl", ",", "el", ",", "fl", ",", "de", ",", "fd", ",", "fc", ",", 
      "verts2d", ",", " ", "edges", ",", " ", "faces", ",", "hf", ",", "gg"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "GraphGraphics"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph2D", ",", "GraphGraphics"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", " ", "edges", ",", " ", "faces"}], "}"}], " ", 
      "=", " ", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices2D", ",", " ", "Edges", ",", " ", "Faces"}], "}"}], 
        ",", 
        RowBox[{"AssertProperties", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GenericGraphGraphics", "[", 
      RowBox[{"verts2d", ",", "edges", ",", "faces", ",", 
       RowBox[{"EdgeColor", "\[Rule]", 
        RowBox[{"Darker", "[", "Magenta", "]"}]}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
