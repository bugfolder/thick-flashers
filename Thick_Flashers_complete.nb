   3.62812202909027*^9}, {3.628624183786361*^9, 3.628624198406247*^9}, {
   3.628637077331156*^9, 3.628637077465581*^9}, {3.629822307590102*^9, 
   3.629822308392089*^9}, 3.629823265831152*^9, {3.6299126017999372`*^9, 
   3.62991267925194*^9}, {3.629912710777976*^9, 3.6299127114492598`*^9}, {
