Cell[TextData[{
 "IntervalSetIntersect[",
 StyleBox["is",
  FontSlant->"Italic"],
 ", {",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "}] returns the intersection of interval set ",
 StyleBox["is",
  FontSlant->"Italic"],
 " with the interval {",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.484750300637013*^9, 3.48475036607255*^9}, 
   3.484751066490375*^9},ExpressionUUID->"f289ccdd-cc4d-438b-89a7-\
070b0ffd96c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntervalSetIntersect", "[", 
   RowBox[{"is_", ",", 
    RowBox[{"{", "}"}]}], "]"}], ":=", 
  RowBox[{"{", "}"}]}]], "Input",
 CellChangeTimes->{{3.484768951352403*^9, 3.484768966708065*^9}},
 CellLabel->
  "In[542]:=",ExpressionUUID->"ee64e79f-87d8-4af5-902d-32c251acc876"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntervalSetIntersect", "[", 
   RowBox[{"is_", ",", 
    RowBox[{"{", 
     RowBox[{"s_", ",", "t_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ret", "=", 
        RowBox[{"{", "}"}]}], ",", "ss", ",", "tt"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ListEmptyQ", "[", "is", "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"iss", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ss", "=", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
              "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tt", "=", 
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
              "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"tt", ">", "ss"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"ret", ",", 
              RowBox[{"{", 
               RowBox[{"ss", ",", "tt"}], "}"}]}], "]"}]}], "]"}]}]}], "]"}], 
       "/@", "is"}], ";", "\[IndentingNewLine]", 
      RowBox[{"IntervalSetCleanup", "[", "ret", "]"}]}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"Dimensions", "[", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t"}], "}"}], "]"}], "]"}], "\[Equal]", 
    "1"}]}]}]], "Input",
 CellChangeTimes->{{3.484750510249744*^9, 3.484750551570957*^9}, {
   3.484751135927469*^9, 3.484751181845726*^9}, {3.484751223787915*^9, 
   3.48475126564055*^9}, {3.4847513107488737`*^9, 3.484751532275859*^9}, {
   3.484751644988803*^9, 3.48475165805412*^9}, {3.484751752322248*^9, 
   3.484751790952914*^9}, {3.484756318502372*^9, 3.484756354624653*^9}, 
   3.484768976042266*^9, {3.48478410090205*^9, 3.484784101276221*^9}, {
   3.628987711411845*^9, 3.628987719378396*^9}},
 CellLabel->
  "In[543]:=",ExpressionUUID->"5b99aade-2733-458d-a6a8-fff352b4733d"],

