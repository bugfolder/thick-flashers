Cell[CellGroupData[{

Cell[TextData[{
 "FlasherVertexRules[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["srules",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.555784881986583*^9, 3.555784890618537*^9}, {
   3.555784990986976*^9, 3.555784992964294*^9}, 3.719866941354796*^9, 
   3.719866972363563*^9, 3.719867319662884*^9, {3.7198684957263927`*^9, 
   3.7198684959731283`*^9}, 3.719925892034642*^9, 
   3.719925980031941*^9},ExpressionUUID->"ac27beab-23e6-467c-9878-\
a41f0c8addaf"],

Cell[TextData[{
 "FlasherVertexRules[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["srules",
  FontSlant->"Italic"],
 "] takes a rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and a set of scalar-value rules ",
 StyleBox["srules",
  FontSlant->"Italic"],
 " (like the output of FlasherDefaultScalarRules) and returns a set of rules \
that apply those scalar values to vector vertex coordinates. It\
\[CloseCurlyQuote]s a way of applying values to un-Scalarized objects, like \
the graphical representations."
}], "Text",
 CellChangeTimes->{{3.555784893005125*^9, 3.555784912208316*^9}, {
   3.555784962109132*^9, 3.555784988101329*^9}, {3.55578506638206*^9, 
   3.555785088548916*^9}, 3.555788856845254*^9, {3.5559550847401853`*^9, 
   3.555955085674701*^9}, 3.7198667060739326`*^9, {3.719866941365508*^9, 
   3.719866941375538*^9}, 3.719866972375852*^9, {3.7198673486856217`*^9, 
   3.719867350012434*^9}, {3.719925892057863*^9, 3.7199258920799093`*^9}, {
   3.719935792326622*^9, 3.7199357930194397`*^9}, {3.719936101932827*^9, 
   3.719936103548389*^9}},ExpressionUUID->"65fe7dec-e4a3-400d-b332-\
36d7e5c2615e"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}], TraditionalForm]],ExpressionUUID->
  "a83ea2c6-5c12-4a89-89a4-9e39198daafd"],
 " of symbols to use for vector and scalar variables.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order.\n\t",
 StyleBox["srules",
  FontSlant->"Italic"],
 " \[LongDash] a set of default scalar rules, such as those returned by \
FlasherDefaultScalarRules."
}], "Text",
 CellChangeTimes->{{3.913543697760539*^9, 3.913543745801195*^9}, {
  3.913543776446087*^9, 3.9135437769189243`*^9}, {3.913543826194417*^9, 
  3.913543869643005*^9}, {3.913543961333653*^9, 3.913543989591729*^9}, {
  3.913544290267782*^9, 3.913544295261955*^9}, {3.913544326654612*^9, 
  3.9135443303627977`*^9}, {3.913544532489201*^9, 
  3.913544546933029*^9}},ExpressionUUID->"ba304b2f-cb34-463a-9578-\
15deacd89cde"],

Cell[TextData[{
 "Returns: a set of rules that apply the values from ",
 StyleBox["srules",
  FontSlant->"Italic"],
 " to all vector variables."
}], "Text",
 CellChangeTimes->{{3.913544557032968*^9, 
  3.913544571343606*^9}},ExpressionUUID->"7ae03a7f-6b92-4ed0-9fe0-\
31af43462303"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherVertexRules", "[", 
   RowBox[{"vars_", ",", "m_", ",", "srules_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
      "ppz"}], "}"}], ",", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
          "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        SubscriptBox["p", 
         RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"FlasherRotation2D", "[", 
            RowBox[{"k", ",", "m"}], "]"}], ".", 
           RowBox[{"{", 
            RowBox[{
             SubscriptBox["px", 
              RowBox[{"i", ",", "j"}]], ",", 
             SubscriptBox["py", 
              RowBox[{"i", ",", "j"}]]}], "}"}]}], "/.", "srules"}], 
         ")"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       SubscriptBox["pp", 
        RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FlasherRotation3D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["ppx", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppy", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppz", 
             RowBox[{"i", ",", "j"}]]}], "}"}]}], "/.", "srules"}], ")"}]}]}],
      "\[IndentingNewLine]", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555784767959429*^9, 3.555784795299416*^9}, {
   3.5557848638732023`*^9, 3.555784874397983*^9}, {3.55578494482899*^9, 
   3.555784957433799*^9}, {3.555785015246384*^9, 3.555785023424417*^9}, {
   3.71986694128336*^9, 3.7198669412948833`*^9}, 3.719866972383183*^9, 
   3.719867331895104*^9, {3.719868503733794*^9, 3.719868529623519*^9}, {
   3.719925891845898*^9, 3.719925891869394*^9}, {3.71992598003998*^9, 
   3.7199259800456343`*^9}, 3.719926067380199*^9, 3.71994321938382*^9, {
   3.7199432857383013`*^9, 3.719943299404669*^9}},
 CellLabel->
  "In[4164]:=",ExpressionUUID->"3d649672-1c1a-4593-96e8-e73c252d2262"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ParaboloidalFlasherVertexRules[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["srules",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.555784881986583*^9, 3.555784890618537*^9}, {
   3.555784990986976*^9, 3.555784992964294*^9}, 3.719866941354796*^9, 
   3.719866972363563*^9, 3.719867319662884*^9, {3.7198684957263927`*^9, 
   3.7198684959731283`*^9}, 3.719925892034642*^9, 3.719925980031941*^9, {
   3.825606902767407*^9, 3.825606910975653*^9}, {3.82560699337619*^9, 
   3.825606999304267*^9}, 3.825675885134855*^9, 3.9118282287164497`*^9, 
   3.91188107477781*^9},ExpressionUUID->"61d21b97-8f50-407f-ad19-\
42aa0a99876e"],

Cell[TextData[{
 "ParaboloidalFlasherVertexRules[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["srules",
  FontSlant->"Italic"],
 "] takes a rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and a set of scalar-value rules ",
 StyleBox["srules",
  FontSlant->"Italic"],
 " (like the output of FlasherDefaultScalarRules) and returns a set of rules \
that apply those scalar values to vector vertex coordinates. It\
\[CloseCurlyQuote]s a way of applying values to un-Scalarized objects, like \
the graphical representations."
}], "Text",
 CellChangeTimes->{{3.555784893005125*^9, 3.555784912208316*^9}, {
   3.555784962109132*^9, 3.555784988101329*^9}, {3.55578506638206*^9, 
   3.555785088548916*^9}, 3.555788856845254*^9, {3.5559550847401853`*^9, 
   3.555955085674701*^9}, 3.7198667060739326`*^9, {3.719866941365508*^9, 
   3.719866941375538*^9}, 3.719866972375852*^9, {3.7198673486856217`*^9, 
   3.719867350012434*^9}, {3.719925892057863*^9, 3.7199258920799093`*^9}, {
   3.719935792326622*^9, 3.7199357930194397`*^9}, {3.719936101932827*^9, 
   3.719936103548389*^9}, {3.825606917881778*^9, 3.825606923823037*^9}, 
   3.911828228750169*^9, 
   3.911881074809074*^9},ExpressionUUID->"b911c9f9-1488-4890-a0a8-\
264643707faa"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}], TraditionalForm]],ExpressionUUID->
  "e89cb995-d4af-4b41-b64f-69d59891f265"],
 " of symbols to use for vector and scalar variables.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order.\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the desired focal length of the paraboloidal flasher.\n\t",
 StyleBox["srules",
  FontSlant->"Italic"],
 " \[LongDash] a set of default scalar rules, such as those returned by \
FlasherDefaultScalarRules."
}], "Text",
 CellChangeTimes->{{3.913543697760539*^9, 3.913543745801195*^9}, {
  3.913543776446087*^9, 3.9135437769189243`*^9}, {3.913543826194417*^9, 
  3.913543869643005*^9}, {3.913543961333653*^9, 3.913543989591729*^9}, {
  3.913544290267782*^9, 3.913544295261955*^9}, {3.913544326654612*^9, 
  3.9135443303627977`*^9}, {3.913544532489201*^9, 3.913544546933029*^9}, {
  3.913544597873297*^9, 
  3.9135446074359293`*^9}},ExpressionUUID->"650fb142-c1f7-4366-a79d-\
9c69f9e250b1"],

Cell[TextData[{
 "Returns: a set of rules that apply the values from ",
 StyleBox["srules",
  FontSlant->"Italic"],
 " to all vector variables."
}], "Text",
 CellChangeTimes->{{3.913544557032968*^9, 
  3.913544571343606*^9}},ExpressionUUID->"fad17294-3b54-44de-8cd2-\
e038efc34109"],

Cell["This is the version to use with paraboloidal flashers.", "Text",
 CellChangeTimes->{{3.825675896214468*^9, 
  3.825675905454684*^9}},ExpressionUUID->"2459d191-5e07-477d-a0ec-\
cf67cee3312a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ParaboloidalFlasherVertexRules", "[", 
   RowBox[{"vars_", ",", "m_", ",", "f_", ",", "srules_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
      "ppz"}], "}"}], ",", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
          "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        SubscriptBox["p", 
         RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"FlasherRotation3D", "[", 
            RowBox[{"k", ",", "m"}], "]"}], ".", 
           RowBox[{"{", 
            RowBox[{
             SubscriptBox["px", 
              RowBox[{"i", ",", "j"}]], ",", 
             SubscriptBox["py", 
              RowBox[{"i", ",", "j"}]], ",", 
             FractionBox[
              RowBox[{
               SuperscriptBox[
                SubscriptBox["px", 
                 RowBox[{"i", ",", "j"}]], "2"], "+", 
               SuperscriptBox[
                SubscriptBox["py", 
                 RowBox[{"i", ",", "j"}]], "2"]}], 
              RowBox[{"4", "f"}]]}], "}"}]}], "/.", "srules"}], ")"}]}]}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       SubscriptBox["pp", 
        RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FlasherRotation3D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["ppx", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppy", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppz", 
             RowBox[{"i", ",", "j"}]]}], "}"}]}], "/.", "srules"}], ")"}]}]}],
      "\[IndentingNewLine]", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555784767959429*^9, 3.555784795299416*^9}, {
   3.5557848638732023`*^9, 3.555784874397983*^9}, {3.55578494482899*^9, 
   3.555784957433799*^9}, {3.555785015246384*^9, 3.555785023424417*^9}, {
   3.71986694128336*^9, 3.7198669412948833`*^9}, 3.719866972383183*^9, 
   3.719867331895104*^9, {3.719868503733794*^9, 3.719868529623519*^9}, {
   3.719925891845898*^9, 3.719925891869394*^9}, {3.71992598003998*^9, 
   3.7199259800456343`*^9}, 3.719926067380199*^9, 3.71994321938382*^9, {
   3.7199432857383013`*^9, 3.719943299404669*^9}, {3.825606930049187*^9, 
   3.8256069884503613`*^9}, 3.91182822876452*^9, 3.911881074825261*^9},
 CellLabel->
  "In[4165]:=",ExpressionUUID->"68e6dcc8-a918-49ec-826b-45323380f073"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Analysis and constraints", "Subsection",
 CellChangeTimes->{
  3.719868090318173*^9},ExpressionUUID->"2e003272-3c4f-42c1-a599-\
99af332c62e2"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.719932898469047*^9, 
  3.719932899411323*^9}},ExpressionUUID->"db960414-ac4d-42b6-baff-\
ae6b6f987491"],

Cell[TextData[{
 "The functions in this section generate the equations that we solve to find \
the CP and FF of a flasher. All equations are given in terms of subscripted \
scalar variables, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "7489f25c-a5c6-4d0f-89e5-0ed27c798fa4"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "872f06fc-7942-4372-bf42-a1d53bb2c406"],
 "."
}], "Text",
 CellChangeTimes->{{3.7199329013959107`*^9, 3.719932959953071*^9}, {
  3.719933442308381*^9, 
  3.719933442764176*^9}},ExpressionUUID->"d39c7fe2-7e5d-4bf0-a780-\
4b97ecc13bac"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherCPRotationFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.55583739810966*^9, 3.55583740223689*^9}, 
   3.555837642445231*^9, {3.555837937985425*^9, 3.555837939273135*^9}, {
   3.71986859780099*^9, 3.719868609988699*^9}, 3.719925980058071*^9, 
   3.913476902406378*^9},ExpressionUUID->"1a53709f-d226-4dbd-9afe-\
2ed04dc94bb2"],

Cell[TextData[{
 "FlasherCPRotationFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "] returns a list containing a single function that pins the rotational \
orientation of the crease pattern to that of the default CP. Specifically, it \
constrains the vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0"}]], TraditionalForm]],
  ExpressionUUID->"f553b196-f59d-4ac1-bdf8-31d1f45e5128"],
 " to lie on a line through the origin that passes through the initial point \
position. "
}], "Text",
 CellChangeTimes->{{3.555837405460771*^9, 3.555837459065177*^9}, 
   3.555837643285048*^9, {3.555837843704507*^9, 3.555837977591068*^9}, {
   3.555955138903808*^9, 3.555955161221336*^9}, {3.719868597813288*^9, 
   3.719868616141415*^9}, 3.7199259800806*^9, 3.719932988220418*^9, 
   3.719933409972278*^9, {3.719945463778043*^9, 3.719945465527671*^9}, 
   3.913476902445447*^9, {3.913476972851435*^9, 
   3.913476973633483*^9}},ExpressionUUID->"e49c1966-2d0d-4345-8aaf-\
4c94acc9a1e1"],

Cell["\<\
Note that only a single function is returned, but we wrap it in a list to be \
parallel with the other functions that return lists of multiple elements.\
\>", "Text",
 CellChangeTimes->{
  3.7199334123821797`*^9},ExpressionUUID->"8bb94ed8-c507-46ce-9520-\
94a12954520d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherCPRotationFns", "[", 
   RowBox[{"vars_", ",", " ", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
      "ppz"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FlasherScalarize", "[", 
        RowBox[{"vars", ",", 
         SubscriptBox["p", 
          RowBox[{"0", ",", "0", ",", "0"}]], ",", "m"}], "]"}], ".", 
       RowBox[{"RotationMatrix2D", "[", 
        FractionBox["\[Pi]", "2"], "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"0", ",", "0", ",", "0"}]], "/.", 
         RowBox[{"FlasherDefaultCPRules", "[", 
          RowBox[{"p", ",", "m"}], "]"}]}], ")"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.555837340672162*^9, 3.5558373623291483`*^9}, {
   3.555837467690639*^9, 3.555837530304244*^9}, {3.5558375752440853`*^9, 
   3.555837601595133*^9}, 3.555837644552094*^9, {3.555837686521089*^9, 
   3.5558377240505257`*^9}, {3.555837781376607*^9, 3.5558378335168743`*^9}, {
   3.555837943460808*^9, 3.555837944404172*^9}, {3.719848622862851*^9, 
   3.719848622866489*^9}, {3.719848673800667*^9, 3.719848673803996*^9}, {
   3.719854079908853*^9, 3.719854079912421*^9}, {3.719866536714497*^9, 
   3.719866536718799*^9}, {3.7198685978206987`*^9, 3.719868657525449*^9}, {
   3.719925980087951*^9, 3.719925980100626*^9}, 3.719926067389493*^9, {
   3.719933022901022*^9, 3.719933029108747*^9}, {3.719933072581463*^9, 
   3.7199331750607433`*^9}, {3.719933221438003*^9, 3.719933228414203*^9}, 
   3.71993330020566*^9, {3.719933341471145*^9, 3.719933350996817*^9}, {
   3.719933395509845*^9, 3.719933399284717*^9}, 3.719933567942018*^9, 
   3.719936124469333*^9, 3.71994321939497*^9, 3.719943285746667*^9, 
   3.911829535119671*^9, 3.911829637313008*^9, {3.911829668377947*^9, 
   3.91182968136693*^9}, 3.913476902465226*^9},
 CellLabel->
  "In[4166]:=",ExpressionUUID->"4f791431-4ce1-4872-8aec-3a4db6086c0a"],

Cell["\<\
Example. Return the function list and show the value with the default rules.\
\>", "Text",
 CellChangeTimes->{{3.555768985847327*^9, 3.5557689895465117`*^9}, {
  3.555779451021374*^9, 3.5557794620849953`*^9}, {3.555837620135831*^9, 
  3.55583762079832*^9}, {3.825607070618093*^9, 3.8256070842969513`*^9}, {
  3.9118296210753403`*^9, 
  3.911829628638266*^9}},ExpressionUUID->"128d9c6c-4d4d-421e-ac2d-\
5bb1ded26fa5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"vars", "=", 
       RowBox[{"FlasherVars", "[", "]"}]}], ",", 
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "1"}], ",", 
      RowBox[{"m", "=", "4"}], ",", 
      RowBox[{"dr", "=", ".01"}], ",", "cpfns"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cpfns", "=", 
      RowBox[{"FlasherCPRotationFns", "[", 
       RowBox[{"vars", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", "cpfns", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cpfns", "/.", 
      RowBox[{"FlasherDefaultScalarRules", "[", 
       RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "dr"}], "]"}]}]}]}],
    "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.555778121200094*^9, 3.555778164365786*^9}, {
   3.555779429250181*^9, 3.55577943372198*^9}, {3.555837626537483*^9, 
   3.555837659446853*^9}, {3.555837946996125*^9, 3.555837947475706*^9}, {
   3.555854316090809*^9, 3.555854316225066*^9}, {3.555854352960341*^9, 
   3.555854353026211*^9}, 3.7198568969903097`*^9, 3.719866706081142*^9, 
   3.719868597826045*^9, {3.719868669446295*^9, 3.7198686719654007`*^9}, {
   3.719868704591453*^9, 3.719868720062471*^9}, {3.719925969416768*^9, 
   3.719925980119417*^9}, {3.719933238852283*^9, 3.719933243077519*^9}, {
   3.719933422053825*^9, 3.719933429451579*^9}, 3.719935824196114*^9, {
   3.719935867878948*^9, 3.719935894285367*^9}, 3.7199463375962133`*^9, {
   3.825678845684993*^9, 3.825678846220096*^9}, 3.911829586785357*^9, 
   3.911829632471753*^9, {3.9118296913789177`*^9, 3.911829710817306*^9}, 
   3.9134769024704947`*^9},
 CellLabel->
  "In[4167]:=",ExpressionUUID->"ac68c5bd-3c18-4cd3-9b25-98ce2a738c5a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherIsometryFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FlasherSectorDiagFoldLines"
}], "Subsubsection",
 CellChangeTimes->{{3.555780275359147*^9, 3.555780277529156*^9}, 
   3.555838016515161*^9, 3.555854316300352*^9, 3.555854353118908*^9, {
   3.719868815331238*^9, 3.719868819997046*^9}, 3.719925980131103*^9, {
   3.7199315688942633`*^9, 
   3.719931571052328*^9}},ExpressionUUID->"0a87634b-be9a-4c71-936c-\
9ae699b968b5"],

Cell[TextData[{
 "FlasherIsometryFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "] returns a list of functions whose value must be zero when isometry is \
satisfied: CP length = FF length for each segment."
}], "Text",
 CellChangeTimes->{{3.555768370803039*^9, 3.555768426711442*^9}, {
   3.5557722685242*^9, 3.555772285818809*^9}, {3.555780306024274*^9, 
   3.5557803433232727`*^9}, {3.555789132797584*^9, 3.555789140328512*^9}, 
   3.555838016549026*^9, 3.555854316394964*^9, 3.555854353220299*^9, {
   3.719868815343635*^9, 3.719868824853323*^9}, 3.7199259801487627`*^9, {
   3.719932081478602*^9, 
   3.71993208263758*^9}},ExpressionUUID->"8972bc64-4034-4604-bc3c-\
b69803c6a5f9"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] A list of the symbolic variables of the form {",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["px",
  FontSlant->"Italic"],
 ", ",
 StyleBox["py",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppy",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppz",
  FontSlant->"Italic"],
 "} where\n\t\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " is the symbol for points in the CP, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "746d5edc-3aab-4d18-b1bc-52a4a56fc68d"],
 ".\n\t\t",
 StyleBox["px",
  FontSlant->"Italic"],
 ", ",
 StyleBox["py",
  FontSlant->"Italic"],
 " are the scalar variables used for coordinates of the CP, .e.g, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["px",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "6d7a3e07-655d-4cef-960a-4c8a86eb81c8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["py",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "4f38db23-24f9-4913-89ac-fb1b002b5527"],
 ". Note, no k-dependence due to rotational symmetry.\n\t\t",
 StyleBox["pp",
  FontSlant->"Italic"],
 " is the symbol for points in the FF, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["pp",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "33f49374-287c-4d2b-9989-ba9143ab65cc"],
 ".\n\t\t",
 StyleBox["ppx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppy",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppz",
  FontSlant->"Italic"],
 " are the scalar variables used for coordinates of the FF, e.g., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["ppx",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "179573e6-fd2d-49ea-8930-5e11a9e64a3e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["ppy",
     FontSlant->"Italic"], 
