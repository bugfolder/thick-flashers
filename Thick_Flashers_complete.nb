Cell[CellGroupData[{

Cell["\<\
STL model, stowed form, central/outer hinge thickness specified\
\>", "Subsubsection",
 CellChangeTimes->{{3.922629180707329*^9, 3.92262918259593*^9}, {
  3.923907644368205*^9, 3.923907646392908*^9}, {3.9357766260296297`*^9, 
  3.935776636146057*^9}, {3.9357782191697083`*^9, 
  3.935778224298468*^9}},ExpressionUUID->"f2525124-c017-42d8-98c5-\
53afe70f027a"],

Cell["\<\
An example, showing how we size it so that the finished size is a given \
value, and then exporting as an STL model.\
\>", "Text",
 CellChangeTimes->{{3.9148574336478434`*^9, 3.9148574597289667`*^9}, {
  3.9226949240114927`*^9, 
  3.922694924739471*^9}},ExpressionUUID->"8955b899-1f2f-4424-8c56-\
15b4cacfb3f5"],

Cell["\<\
Tweak the dimensions to result in:
\[LongDash]Circumcircle diameter of 100 mm
\[LongDash]Panel thickness (before inset) of 2.5 mm
\[LongDash]Panel clearance (gap width) of 0.5 mm
\[LongDash]Central hinge thickness of 1.0 mm
\[LongDash]Default hinge thickness of 0.5 mm
\[LongDash]Extra clearance around central polygon of 0.5 mm\
\>", "Text",
 CellChangeTimes->{{3.920484670468161*^9, 3.920484716052226*^9}, {
  3.924251507350963*^9, 3.924251530165325*^9}, {3.935776672836434*^9, 
  3.935776685827695*^9}, {3.935778233010182*^9, 3.9357782339545*^9}, {
  3.9374867866783047`*^9, 
  3.9374867915397053`*^9}},ExpressionUUID->"87835f30-0542-43cb-9c23-\
b5c1c8714fd2"],

Cell[TextData[{
 "The value of ",
 StyleBox["t",
  FontSlant->"Italic"],
 " at the beginning is the dimensionless panel thickness, which we don\
\[CloseCurlyQuote]t initially know. To set its value, we make a guess, \
compute the flasher and its scale, then see what the descaled panel thickness \
turns out to be; that gives a corrected value to replace the original ",
 StyleBox["t",
  FontSlant->"Italic"],
 "-value, then re-run the computation and Iterate until the resulting panel \
thickness is \[OpenCurlyDoubleQuote]close enough\[CloseCurlyDoubleQuote] to \
our desired value."
}], "Text",
 CellChangeTimes->{{3.9226125875842123`*^9, 3.922612666249649*^9}, {
  3.922612749260137*^9, 3.922612764756348*^9}, {3.922613019280229*^9, 
  3.922613041449222*^9}, {3.922698035771553*^9, 
  3.9226980657637043`*^9}},ExpressionUUID->"c8b95180-1965-49ff-b2aa-\
ad625e38b8c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", "1"}], ",", 
       RowBox[{"h", "=", "2"}], ",", 
       RowBox[{"m", "=", "6"}], ",", "t", ",", "pt", ",", "pmt", ",", "sfd", ",",
        "ffcdia", ",", "fs", ",", "pc", ",", "fc", ",", "ht", ",", "cht", ",",
        "tobj", ",", "tobjdp", ",", "panels", ",", "panelinfo", ",", 
       "joinedpanels", ",", "filename"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"descaled", " ", "panel", " ", "thickness"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"t", "=", "0.0386913"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"desired", " ", "panel", " ", "thickness"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pt", "=", "2.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"panel", " ", "minimum", " ", "thickness"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pmt", "=", "0.2"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"desired", " ", "stowed", " ", "form", " ", "diameter"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"sfd", "=", "100.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Construct", " ", "the", " ", "EZT", " ", "surface", " ", "of", " ", 
        "a", " ", "flasher", " ", "with", " ", "the", " ", "specified", " ", 
        RowBox[{"parameters", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"tobj", "=", 
       RowBox[{"MakeThickFlasher", "[", 
        RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", "\[IndentingNewLine]", 
         RowBox[{"TypeMinimumAngle", "\[Rule]", 
          RowBox[{"10.", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
         "FlasherSectorDiagFoldLines", "->", 
          "FlasherSectorDiagFoldLinesY"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Show", " ", "the", " ", "EZT", " ", "surface", " ", "and", " ", 
        "some", " ", "of", " ", "its", " ", "details"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"tobjdp", "=", 
       RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<Embedded zero-thickness surface (deployed and \
stowed)\>\"", "]"}], ";", " ", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"GraphicsRow", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}], ",", 
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
         
         RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Flasher details (dimensionless):\>\"", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"tobj", "[", "FlasherDetails", "]"}], "//", "ColumnForm"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Figure", " ", "out", " ", "the", " ", "scale", " ", "factor", " ", 
        "that", " ", "will", " ", "give", " ", "a", " ", "folded", " ", 
        "form", " ", "circumcircle", " ", "of", " ", "100", " ", 
        RowBox[{"mm", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ffcdia", "=", 
       RowBox[{"\"\<folded form circumcircle diameter\>\"", "/.", 
        RowBox[{"tobj", "[", "FlasherDetails", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fs", "=", 
       RowBox[{"sfd", "/", "ffcdia"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Flasher details (scaled):\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<Stowed form diameter\>\"", "->", "sfd"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<FlasherScale\>\"", "->", "fs"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<Resulting panel thickness\>\"", "->", 
           RowBox[{"t", "*", "fs"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Updated descaled panel thickness\>\"", "->", 
           RowBox[{"pt", "/", "fs"}]}]}], "}"}], "//", "ColumnForm"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Create", " ", "the", " ", "panels"}], ",", " ", 
        RowBox[{
        "scaling", " ", "the", " ", "flasher", " ", "appropriately"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Panel", " ", "clearance"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pc", "=", "0.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Extra", " ", "clearance", " ", "around", " ", "centeral", " ", 
        "polygon"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"fc", "=", "0.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
       RowBox[{"MakeThickFlasherPanels", "[", 
        RowBox[{"tobj", ",", "\[IndentingNewLine]", 
