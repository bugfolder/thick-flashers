Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], "#"}], "&"}], "/@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"MoselyBudCrossSectionPt", "[", "r", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "0", ",", "1", ",", 
            RowBox[{"1", "/", "20"}]}], "}"}]}], "]"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRadialPot", "[", 
       RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"30", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", 
          RowBox[{"CreaseColor", "\[Rule]", "LightGray"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", 
          RowBox[{"ShowUnfolded", "\[Rule]", "False"}], "]"}]}]}], "}"}], 
