Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"glist", ",", "alist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
