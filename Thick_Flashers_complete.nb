Cell[BoxData[
 RowBox[{
  RowBox[{"MergeGraphsData", "[", 
   RowBox[{"tglist_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "kde", ",", "verts", ",", "vlist", ",", "edges", ",", "elist", ",", 
      "tedges", ",", "telist", ",", "tedge", ",", "tpos", ",", "emul", ",", 
      "nedges", ",", "emap", ",", "vmul", ",", "nverts", ",", "vm", ",", 
      "vmap", ",", "faces"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AssertClass", "[", 
        RowBox[{"#", ",", "TGraph", ",", "MergeGraphsData"}], "]"}], "&"}], "/@",
       "tglist"}], ";", "\[IndentingNewLine]", 
     RowBox[{"kde", "=", 
      RowBox[{
       RowBox[{"KillMergedEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MergeGraphsData", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "vlist"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GetValue", "[", 
           RowBox[{"#", ",", "Vertices"}], "]"}], "&"}], "/@", "tglist"}], ",",
         "2", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"elist", "=", 
       RowBox[{"{", "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"tedges", "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "[",
           "Edges", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"telist", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"tedge", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vlist", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", 
                RowBox[{"tedges", "\[LeftDoubleBracket]", 
                 RowBox[{"j", ",", "1"}], "\[RightDoubleBracket]"}]}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"vlist", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", 
                RowBox[{"tedges", "\[LeftDoubleBracket]", 
                 RowBox[{"j", ",", "2"}], "\[RightDoubleBracket]"}]}], 
               "\[RightDoubleBracket]"}]}], "}"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"edge", ",", " ", 
             RowBox[{"now", " ", "indexed", " ", "on", " ", "verts"}]}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"tpos", "=", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{"edges", ",", "tedge"}], "]"}], ",", 
              RowBox[{"Position", "[", 
               RowBox[{"edges", ",", 
                RowBox[{"Reverse", "[", "tedge", "]"}]}], "]"}]}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"tpos", "\[Equal]", 
              RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"edges", ",", "tedge"}], "]"}], ";", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"telist", ",", 
                RowBox[{"Length", "[", "edges", "]"}]}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"telist", ",", 
               RowBox[{"tpos", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}],
             "]"}]}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "tedges", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"elist", ",", "telist"}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"kde", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "look", " ", "for", " ", "doubled", " ", "edges", " ", "and", " ", 
         "drop", " ", "them"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"emul", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "edges", "]"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"multiplicity", " ", "of", " ", "edges"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "emul", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
            "++"}], "&"}], ",", "elist", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"nedges", "=", 
         RowBox[{"{", "}"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"new", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"emap", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "edges", "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"maps", " ", "edges", " ", "to", " ", "nedges"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "emul", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[NotEqual]",
              "2"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"nedges", ",", 
               RowBox[{
               "edges", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}], "]"}], ";", 
             RowBox[{
              RowBox[{
              "emap", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              "=", 
              RowBox[{"Length", "[", "nedges", "]"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"edges", "=", "nedges"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"elist", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", 
           RowBox[{"emap", "\[LeftDoubleBracket]", 
            RowBox[{"elist", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "elist", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "elist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "look", " ", "for", " ", "orphan", " ", "vertices", " ", "and", " ", 
          "drop", " ", "them"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"vmul", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "verts", "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"multiplicity", " ", "of", " ", "vertices"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "vmul", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
            "++"}], "&"}], ",", "nedges", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"nverts", "=", 
         RowBox[{"{", "}"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"new", " ", "verts"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"vmap", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "verts", "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"maps", " ", "verts", " ", "to", " ", "nverts"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "vmul", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ">",
              "0"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"nverts", ",", 
               RowBox[{
               "verts", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}], "]"}], ";", 
             RowBox[{
              RowBox[{
              "vmap", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              "=", 
              RowBox[{"Length", "[", "nverts", "]"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vlist", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", 
           RowBox[{"vmap", "\[LeftDoubleBracket]", 
            RowBox[{"vlist", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "vlist", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "vlist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"vlist", ",", "elist"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5949293609652643`*^9, 3.5949294000078897`*^9}, {
   3.594929437845168*^9, 3.594929445346257*^9}, {3.594929482996669*^9, 
