Cell[TextData[{
 "MatchCurvesPair[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cc",
  FontSlant->"Italic"],
 ", \[Psi], \[Sigma]",
 StyleBox[", opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
