Cell[CellGroupData[{

Cell[TextData[{
 "StyledFoldLine",
 "[",
 StyleBox["rlist",
  FontSlant->"Italic"],
 ", \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MinimumAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.440256131542633*^9, 3.440256155727273*^9}, {
   3.440256321461653*^9, 3.440256325652547*^9}, {3.4413782417373137`*^9, 
   3.4413782437206593`*^9}, 
   3.668985865868931*^9},ExpressionUUID->"ad4a02de-b980-441b-b4ab-\
b41f88a4809d"],

Cell[TextData[{
 "StyledFoldLine",
 "[",
 StyleBox["rlist",
  FontSlant->"Italic"],
 ", \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a styled Line with Style options that represent the specified \
dihedral angle \[Gamma], i.e., a mountain, valley, or crease line, depending \
on the angle. Note that this works with both 2D and 3D lines. Options are:\n\t\
MinimumAngle\[Rule]",
 StyleBox["gmin",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["gmin",
  FontSlant->"Italic"],
 " is the magnitude of the dihedral angle below which the line will be \
represented as a crease (unfolded) line."
}], "Text",
 CellChangeTimes->{{3.440256139751239*^9, 3.440256272322796*^9}, {
   3.4404473378235607`*^9, 3.4404473689319*^9}, {3.45651194563244*^9, 
   3.456511950104035*^9}, {3.591799453461398*^9, 3.591799458421722*^9}, 
   3.668985865932839*^9},ExpressionUUID->"c96dec6c-28dc-40e1-806e-\
9a3f9eb4209e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MinimumAngle", "::", "usage"}], 
   "=", "\"\<MinimumAngle is an option to StyledFoldLine that specifies the \
minimum angle at which to render a mountain or valley line (as opposed to an \
unfolded crease line).\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5918014038974743`*^9, 3.591801446343296*^9}, 
   3.668985865954325*^9},
 CellLabel->
  "In[1689]:=",ExpressionUUID->"ae061d8c-afc5-4dee-aaf1-f56fd335bbe5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledFoldLine", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"MinimumAngle", "\[Rule]", 
     RowBox[{"1", "\[Degree]"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.440256351842156*^9, 3.440256370710278*^9}, 
   3.668985865977805*^9},
 CellLabel->
  "In[1690]:=",ExpressionUUID->"b899b06b-2564-42c6-9439-a00b2df94c05"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledFoldLine", "[", 
   RowBox[{"rlist_List", ",", "gg_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gmin", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gmin", "=", 
      RowBox[{
       RowBox[{"MinimumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledFoldLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
