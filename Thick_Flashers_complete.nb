Cell[TextData[{
 "MakeChordStarGraph[",
 StyleBox["specs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m, opts",
  FontSlant->"Italic"],
 "]\nMakeChordStarGraph[",
 StyleBox["specs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["boundary, opts",
  FontSlant->"Italic"],
 "]\n\t(options) ",
 "SamePtTolerance",
 " (same as Indexify)"
}], "Subsubsection",
 CellChangeTimes->{{3.462899703365302*^9, 3.462899753159853*^9}, {
   3.462924674624844*^9, 3.46292468142136*^9}, {3.46292477540917*^9, 
