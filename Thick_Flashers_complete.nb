   RowBox[{"TileVertexIndices", "::", "usage"}], 
   "=", "\"\<TileVertexIndices is an option to RenderTile[{PolygonTile, \
verts}, Tiling, opts] that specifies whether to label the indices of the \
vertices of the tile.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627584145475473*^9, 3.627584209046955*^9}, {
   3.627584281176516*^9, 3.627584287159095*^9}, 3.629823106015876*^9},
