   3.798576424235794*^9}, {3.798577373339306*^9, 3.798577385050105*^9}, 
   3.798580221935326*^9, {3.798585768428021*^9, 3.798585788971246*^9}, {
   3.79862375195747*^9, 3.798623834285494*^9}, {3.798624595503516*^9, 
   3.79862459564469*^9}, {3.799324628949504*^9, 3.799324655539156*^9}, {
   3.799326315869487*^9, 3.799326317479808*^9}, {3.799326351127546*^9, 
   3.799326557804386*^9}, 3.799326627412599*^9, {3.799328070030538*^9, 
   3.799328076469309*^9}, {3.799332596790984*^9, 3.79933266934858*^9}, {
   3.799332705600664*^9, 3.799332744085985*^9}, {3.799332806085873*^9, 
   3.799332921599268*^9}, {3.79933295532703*^9, 3.799333552739687*^9}, 
   3.799333709958712*^9, {3.79933374312449*^9, 3.799333832624227*^9}, 
   3.799333872640012*^9, {3.799333932408027*^9, 3.799334091394101*^9}, {
   3.799334340498762*^9, 3.799334354465514*^9}, {3.799334553209665*^9, 
   3.799334600153583*^9}, {3.799334808000133*^9, 3.799334856879634*^9}, {
   3.799334888736844*^9, 3.799334963820875*^9}, {3.79933501647792*^9, 
   3.799335149575284*^9}, {3.79933575712487*^9, 3.79933600119823*^9}, {
   3.7993362731141443`*^9, 3.799336362915174*^9}, {3.799336678292664*^9, 
   3.799336691041738*^9}, {3.799336916692972*^9, 3.799336917322643*^9}, {
   3.799343112800624*^9, 3.799343222686695*^9}, {3.79934325643333*^9, 
   3.799343256918428*^9}, {3.79934370413209*^9, 3.799343710553973*^9}, {
   3.799353865265284*^9, 3.799353865274554*^9}, {3.799354046629603*^9, 
   3.799354055078723*^9}, 3.799364002545156*^9, 3.799364047932609*^9, {
   3.799398323713058*^9, 3.799398326573027*^9}, {3.799501291996314*^9, 
   3.799501292959771*^9}, 3.7998347334055634`*^9, 3.800224150417357*^9, 
   3.80046681563976*^9, 3.800466866947529*^9, {3.800467905439279*^9, 
