Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BorderlessCreasePatternToPlaneGraphAssigned", "::", "nostyle"}], 
   "=", "\"\<The input pattern had no lines with style MountainLine or \
ValleyLine.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.533671112237163*^9, 3.5336711756252403`*^9}, 
   3.5336815216957006`*^9, 3.592468181548617*^9, 3.592828730961268*^9, 
   3.59282895952009*^9, 3.594739232663255*^9, 3.594739478021956*^9},
