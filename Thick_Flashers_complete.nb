Cell["Example. Two regular tetrahedra, pointing up and down.", "Text",
 CellChangeTimes->{{3.768667678422149*^9, 
  3.768667693858943*^9}},ExpressionUUID->"7b840274-39c3-4d6b-bbe2-\
600b1d70bcd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pa", ",", "pb", ",", "pc", ",", "gg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"An", " ", "equilateral", " ", "triangle"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pa", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pc", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{
         SqrtBox["3"], "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "the", " ", "4", "th", " ", "point"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"show", " ", "the", " ", "full", " ", "tetrahedron"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gg", "[", "dir_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "pd", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pd", "=", 
          RowBox[{"TetrahedronVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"pa", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"pb", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"pc", ",", "1"}], "}"}], ",", "dir"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"\"\<A\>\"", ",", "pa", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<B\>\"", ",", "pb", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<C\>\"", ",", "pc", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<D\>\"", ",", "pd", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pa", ",", "pb", ",", "pc"}], "}"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pa", ",", "pb", ",", "pd"}], "}"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pb", ",", "pc", ",", "pd"}], "}"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"pc", ",", "pa", ",", "pd"}], "}"}], "]"}]}], "}"}], ",", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gg", "[", 
         RowBox[{"+", "1"}], "]"}], ",", 
        RowBox[{"gg", "[", 
         RowBox[{"-", "1"}], "]"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.768257671993744*^9, 3.768257676241584*^9}, {
  3.768257765250745*^9, 3.768257795125931*^9}, {3.768257885811385*^9, 
  3.768257989979898*^9}, {3.76825808642139*^9, 3.76825827202454*^9}, {
  3.768258606344486*^9, 3.768258692062169*^9}, {3.768658888016629*^9, 
  3.768658932771841*^9}, {3.7686677111775*^9, 3.768667855265863*^9}},
 CellLabel->
  "In[657]:=",ExpressionUUID->"66975ae6-0e6a-4d08-a990-8c863a9c47d2"],

Cell["Example. Regular tetrahedron with a rotation and offset.", "Text",
 CellChangeTimes->{{3.76825766378582*^9, 3.768257669444715*^9}, {
  3.768258060459039*^9, 3.768258081802534*^9}, {3.768658953257174*^9, 
  3.7686589566689863`*^9}, {3.7686678751656327`*^9, 
  3.76866788612468*^9}},ExpressionUUID->"a50ea87d-f46b-4ce7-99b5-\
25f74e029312"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pa", ",", "pb", ",", "pc", ",", "rm", ",", "of", ",", "pd"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"An", " ", "equilateral", " ", "triangle"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pa", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pc", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{
         SqrtBox["3"], "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rotate", " ", "and", " ", "offset", " ", "it", " ", "by", " ", "some", 
       " ", "amounts"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rm", "=", 
      RowBox[{"RotationMatrix3Du", "[", 
       RowBox[{
        RowBox[{"20.", "\[Degree]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"30.", "\[Degree]"}], "]"}], ",", 
          RowBox[{"Sin", "[", 
           RowBox[{"30.", "\[Degree]"}], "]"}], ",", "0"}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"of", "=", 
      RowBox[{"{", 
       RowBox[{".1", ",", ".2", ",", ".3"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pa", "=", 
      RowBox[{"of", "+", 
       RowBox[{"rm", ".", "pa"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{"of", "+", 
       RowBox[{"rm", ".", "pb"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pc", "=", 
      RowBox[{"of", "+", 
       RowBox[{"rm", ".", "pc"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "the", " ", "4", "th", " ", "point"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pd", "=", 
      RowBox[{"TetrahedronVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pa", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"pb", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"pc", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"show", " ", "the", " ", "full", " ", "tetrahedron"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{"\"\<A\>\"", ",", "pa", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<B\>\"", ",", "pb", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<C\>\"", ",", "pc", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<D\>\"", ",", "pd", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Polygon", "[", 
          RowBox[{"{", 
           RowBox[{"pa", ",", "pb", ",", "pc"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Polygon", "[", 
          RowBox[{"{", 
           RowBox[{"pa", ",", "pb", ",", "pd"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Polygon", "[", 
          RowBox[{"{", 
           RowBox[{"pb", ",", "pc", ",", "pd"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Polygon", "[", 
          RowBox[{"{", 
           RowBox[{"pc", ",", "pa", ",", "pd"}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.768257671993744*^9, 3.768257676241584*^9}, {
  3.768257765250745*^9, 3.768257795125931*^9}, {3.768257885811385*^9, 
  3.768257989979898*^9}, {3.76825808642139*^9, 3.76825827202454*^9}, {
  3.768258606344486*^9, 3.768258692062169*^9}, {3.768658888016629*^9, 
  3.768658932771841*^9}},
 CellLabel->
  "In[658]:=",ExpressionUUID->"8e90bca2-08f3-4c17-a142-7e4b30ec5bac"]
