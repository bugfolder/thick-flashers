  3.731191571806126*^9}},ExpressionUUID->"ee2c579b-701a-43cf-a579-\
82f62629dd7f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "MiuraOriFullyFoldedGraph3DAssigned", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"MiuraOriFullyFoldedGraph3DAssigned", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]", ",", "dh", ",", "dv", ",", "nh", ",", "nv", ",", 
        "\[Gamma]", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Alpha]", "=", 
        RowBox[{"60.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dh", ",", "dv"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"nh", ",", "nv"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"6", ",", "6"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Gamma]", "=", 
        RowBox[{
         RowBox[{"-", "179"}], "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"MakeMiuraOri", "[", 
         RowBox[{"\[Alpha]", ",", 
          RowBox[{"{", 
           RowBox[{"dh", ",", "dv"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"nh", ",", "nv"}], "}"}], ",", 
          RowBox[{"MajorFoldAngle", "\[Rule]", "\[Gamma]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"VertexRotateGraph3D", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"tobj", "[", "CornerIndices", "]"}], "]"}], ",", "3"}], 
          "]"}]}], "]"}]}]}], "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.731190293945926*^9, 3.73119035228908*^9}, {
