          RowBox[{"{", 
           RowBox[{"v", ",", "v0", ",", "v1"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Plot3D", "[", 
         RowBox[{
          RowBox[{"f1", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "u0", ",", "u1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "v0", ",", "v1"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Plot3D", "[", 
         RowBox[{
          RowBox[{"f2", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"{", 
