Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bb", ",", "dd", ",", "\[Sigma]", ",", "\[Tau]", ",", "ui", ",", "bbi", ",",
       "uui", ",", "ddi", ",", "b", ",", "d", ",", "u0", ",", "u1", ",", "v0",
       ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], " ", 
             SqrtBox["3"], " ", 
             RowBox[{"Cos", "[", "#", "]"}]}], ",", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             SqrtBox["3"], " ", 
             RowBox[{"Sin", "[", "#", "]"}]}], ",", 
            FractionBox["#", "2"]}], "}"}], "&"}], "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
