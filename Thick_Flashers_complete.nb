                  RowBox[{".5", "p1"}], "+", 
                  RowBox[{".5", "p2"}]}]}], "]"}], ",", 
               RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "fsinfo", "]"}]}], "}"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
