Cell[CellGroupData[{

Cell[TextData[{
 "VeneerScoringCarveGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] (obsolete)\n\t(checked classes) TGraph, TAssigned\n\t(options) ImageSize, \
ScoreLineThickness, VeneerThickness, InvertFolds"
}], "Subsubsection",
 CellChangeTimes->{{3.624891363393293*^9, 3.624891383390296*^9}, {
   3.624892057628418*^9, 3.62489206397192*^9}, {3.624894762023148*^9, 
   3.6248947652311716`*^9}, {3.624895690502103*^9, 3.624895693435894*^9}, {
   3.624895764032812*^9, 3.624895767670678*^9}, 3.6249139679142*^9, 
   3.625164206915563*^9, 3.6263609746850357`*^9, {3.626479946732328*^9, 
   3.626479948416081*^9}, {3.627913585428926*^9, 3.627913588793408*^9}, {
