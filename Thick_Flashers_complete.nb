Cell[CellGroupData[{

Cell[TextData[{
 "StyledVector[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nStyledVector[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) VectorThickness2D, VectorThickness3D, VectorColor, \
VectorLabel, VectorLabelPosition"
}], "Subsubsection",
 CellChangeTimes->{{3.688995463196385*^9, 3.688995511398142*^9}, 
   3.688995604373551*^9, {3.6889957721026187`*^9, 3.688995774207686*^9}, {
   3.6889958503229437`*^9, 3.6889958504970837`*^9}, {3.688996139128734*^9, 
   3.6889961420364656`*^9}, {3.688996755950286*^9, 3.688996757526153*^9}, 
   3.68900181510398*^9, {3.69149746490674*^9, 3.69149747309389*^9}, {
   3.798133583968191*^9, 3.798133584740758*^9}, 3.799956144038877*^9, {
   3.799956178106923*^9, 3.799956181217024*^9}, {3.801001400059746*^9, 
   3.801001400969489*^9}},ExpressionUUID->"f8f47cdb-b86f-4eef-abf2-\
131fcebe5ab4"],

Cell[TextData[{
 "StyledVector[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a list of Graphics or Graphics3D primitives that render an arrow \
that represents a vector from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " with an optional label at the arrow tip."
}], "Text",
 CellChangeTimes->{{3.688995549181015*^9, 3.688995591154135*^9}, {
   3.688995762432127*^9, 3.6889957825474863`*^9}, {3.688995848390069*^9, 
   3.688995848553122*^9}, {3.688996653008554*^9, 3.688996751798667*^9}, 
   3.68900181513794*^9, {3.691497439925517*^9, 
   3.691497460463018*^9}},ExpressionUUID->"503551eb-5330-40fb-b8ec-\
6c3b991dcce7"],

Cell[TextData[{
 "Options:\n \tVectorThickness2D \[Rule] ",
 StyleBox["th",
  FontSlant->"Italic"],
 ", specifies the thickness of a 2D vector as a proportion of the total image \
size.\n\tVectorThickness3D \[Rule] ",
 StyleBox["th",
  FontSlant->"Italic"],
 ", specifies the thickness of a 3D vector in local units of the Graphics3D.\n\
\tVectorColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of the vector.\n\tVectorLabel \[Rule] {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z",
  FontSlant->"Italic"],
 "}, labels to put at the end of the vector.\n\tVectorLabelPosition \[Rule] {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 "}, argument to Text[] that positions the label text relative to its target \
position."
}], "Text",
 CellChangeTimes->{{3.691497442772478*^9, 3.69149744499443*^9}, {
   3.798133524514636*^9, 3.798133554570746*^9}, {3.799956144067344*^9, 
   3.799956231872326*^9}, 
   3.801001397198131*^9},ExpressionUUID->"43317656-d8d4-411f-a33b-\
e55ef81c4348"],

Cell[TextData[{
 "Returns a list of Graphics or Graphics3D elements, depending on the \
dimensionality of ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.691497450766833*^9, 
  3.691497453279578*^9}},ExpressionUUID->"d3ddbdd4-ddcd-4878-86fc-\
045987a69f70"],

Cell["3D vectors are Implemented as Tube with Arrow.", "Text",
 CellChangeTimes->{{3.801001549442327*^9, 
  3.801001575636621*^9}},ExpressionUUID->"b9bf8395-3f6a-4d78-9888-\
9ac9ac7165a8"],

Cell["\<\
The separate thickness specifications for 2D and 3D are because Mathematica \
implements dimensions differently for 2D and 3D arrows. 2D line thickness is \
specified as an absolute line weight. 3D line thickness is specified in local \
units.\
\>", "Text",
 CellChangeTimes->{{3.799956268737076*^9, 3.799956323976363*^9}, {
  3.801001522110462*^9, 3.801001546192056*^9}, {3.80100158124128*^9, 
  3.801001582287547*^9}},ExpressionUUID->"a56e2ccd-7efc-4f30-bb24-\
d7e2b3d18d68"],

Cell["\<\
We choose default values that give the default Styled2DAxes and Styled3DAxes \
a similar appearance.\
\>", "Text",
 CellChangeTimes->{{3.799956326368552*^9, 
  3.799956346145051*^9}},ExpressionUUID->"b40da5c8-5f54-4717-a1a5-\
18e8bf8d4265"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VectorThickness2D", "::", "usage"}], 
   "=", "\"\<VectorThickness2D is an option to StyledVector that specifies \
the thickness of a 2D vector.\>\""}], ";"}]], "Input",
