Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sa1", ",", "sa2", ",", "sa3", ",", "\[Gamma]", ",", "gfn"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"65", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}], ",", 
        RowBox[{"115", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{"45.", "\[Degree]"}], ",", 
        RowBox[{"135.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"sa3", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"91.", "\[Degree]"}], ",", 
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{"45.", "\[Degree]"}], ",", 
        RowBox[{"134.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"88.99", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gfn", "[", 
       RowBox[{"sa_", ",", "\[Gamma]1_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"da1", ",", "da2"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"da1", "=", 
          RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "[", 
           RowBox[{"sa", ",", "\[Gamma]1"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"da2", "=", 
          RowBox[{"RotateRight", "[", 
           RowBox[{
            RowBox[{"MakeDihedralsFromSectorsAndMajorDihedral", "[", 
             RowBox[{
              RowBox[{"RotateLeft", "[", 
               RowBox[{"sa", ",", "1"}], "]"}], ",", 
              RowBox[{
              "da1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
              "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<(dihedrals from minor)/\[Degree] = \>\"", ",", 
           RowBox[{"da1", "/", "\[Degree]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<(dihedrals from major)/\[Degree] = \>\"", ",", 
           RowBox[{"da2", "/", "\[Degree]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"sa1", ",", "\[Gamma]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"sa2", ",", "\[Gamma]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"sa3", ",", "\[Gamma]"}], "]"}], ";"}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
