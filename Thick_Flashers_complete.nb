Cell[TextData[{
 "NRecoverDarboux3D[{ds, ",
 StyleBox["sd\[Kappa]g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sd\[Kappa]n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sd\[Tau]g",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lli",
  FontSlant->"Italic"],
 ", ",
 StyleBox["uui",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}] constructs the curve and Darboux frame for a specified set of \
speed-curvature products and initial values as numerical interpolating \
functions."
}], "Text",
 CellChangeTimes->{{3.7993398176843786`*^9, 3.799339876803041*^9}, {
   3.799339914115159*^9, 3.799339941764666*^9}, {3.7993404924872627`*^9, 
   3.799340492975128*^9}, {3.799340907659059*^9, 3.7993409353860807`*^9}, {
   3.7993421973714657`*^9, 3.799342219955901*^9}, {3.799353510260405*^9, 
   3.799353524351719*^9}, 3.799353585102398*^9, 3.799353929030072*^9, 
   3.799364002521168*^9, 3.799364047911591*^9, {3.7993999484760456`*^9, 
   3.7993999702831783`*^9}, 3.799834733297138*^9, 3.8002241503350897`*^9, 
   3.800466850815792*^9, 
   3.80131732937851*^9},ExpressionUUID->"405995e3-c0ca-4535-b305-\
be95b176b375"],

Cell[TextData[{
 "Arguments:\n\tds \[LongDash] a pure function giving the curve speed.\n\t",
 StyleBox["sd\[Kappa]g",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the product of the curve speed and \
geodesic curvature.\n\t",
 StyleBox["sd\[Kappa]n",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the product of the curve speed and \
normal curvature.\n\t",
 StyleBox["sd\[Tau]g",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the product of the curve speed and \
geodesic torsion.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the curve parameter.\n\t",
 StyleBox["cci",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the curve position.\n\t",
 StyleBox["tti",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the tangent vector.\n\t",
 StyleBox["lli",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the tangent normal vector.\n\t",
 StyleBox["uui",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the surface normal vector.\n\t{",
 StyleBox["u0, u1}",
  FontSlant->"Italic"],
 " \[LongDash] domain of the interpolation."
}], "Text",
 CellChangeTimes->{{3.799339977563547*^9, 3.799340073083741*^9}, 
   3.799340369941988*^9, {3.799340496927218*^9, 3.799340508559649*^9}, {
