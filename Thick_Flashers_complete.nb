   3.592437090688765*^9, 3.592437090757722*^9}, {3.592670438412034*^9, 
   3.592670438481417*^9}, {3.592670633617818*^9, 3.592670633681244*^9}, {
   3.592671072893545*^9, 3.592671072964433*^9}, 3.5928293239144*^9, 
   3.592829661093444*^9, 3.592868168731082*^9, {3.5930389098387327`*^9, 
   3.593038920683972*^9}, 3.594806398008588*^9, 3.5949870893434887`*^9, {
   3.594995557638277*^9, 3.5949956155390587`*^9}, {3.594995668620631*^9, 
   3.594995673277981*^9}, {3.595002346639139*^9, 3.595002349973431*^9}, {
   3.595002474080761*^9, 3.595002526587354*^9}, {3.595002655004575*^9, 
   3.595002691929289*^9}, {3.595002755988552*^9, 3.595002759812665*^9}, 
   3.595002814723511*^9, {3.595002868165728*^9, 3.595002905379309*^9}, {
   3.595003412722149*^9, 3.595003456112677*^9}, {3.595004071237439*^9, 
   3.595004082312269*^9}, {3.59500414571661*^9, 3.5950041503407393`*^9}, {
   3.595004291315728*^9, 3.595004308928961*^9}, 3.59500463249966*^9, 
