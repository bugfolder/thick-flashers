3ea2a01ed682"],

Cell["\<\
Same as FlasherDefaultCPRules, but incorporates the sag function and the rule \
returns a 3D point.\
\>", "Text",
 CellChangeTimes->{{3.825671005274274*^9, 3.825671016006604*^9}, {
  3.825671048182493*^9, 
  3.82567107444035*^9}},ExpressionUUID->"33b9f295-f914-4194-ae4b-\
9c908bffbb18"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ParaboloidalFlasherDefaultDPRules", "[", 
   RowBox[{"p_", ",", "m_", ",", "f_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["p", 
     RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
    RowBox[{
     RowBox[{"FlasherRotation3D", "[", 
      RowBox[{"k", ",", "m"}], "]"}], ".", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "z"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{
          RowBox[{"Tan", "[", 
           FractionBox["\[Pi]", "m"], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Pi]", "m"], "]"}], ",", "1"}], "}"}]}], "+", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"i", "+", "1"}], "\[GreaterEqual]", "j"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", "+", "1"}], ")"}], " ", 
                RowBox[{"U", "[", 
                 RowBox[{
                  FractionBox["\[Pi]", "2"], "+", 
                  FractionBox[
                   RowBox[{"2", "\[Pi]"}], "m"]}], "]"}]}], "+", 
               RowBox[{
                RowBox[{"Tan", "[", 
                 FractionBox["\[Pi]", "m"], "]"}], "j", " ", 
                RowBox[{"U", "[", 
                 FractionBox[
                  RowBox[{"2", "\[Pi]"}], "m"], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"j", " ", 
                RowBox[{"U", "[", 
                 FractionBox["\[Pi]", "2"], "]"}]}], "-", 
               RowBox[{
                RowBox[{"Tan", "[", 
                 FractionBox["\[Pi]", "m"], "]"}], 
                RowBox[{"(", 
                 RowBox[{"i", "+", "1"}], ")"}], 
                RowBox[{"U", "[", "0", "]"}]}]}]}], "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z", "=", 
         FractionBox[
          RowBox[{"r", ".", "r"}], 
          RowBox[{"4", "f"}]]}], ";", "\[IndentingNewLine]", 
        RowBox[{"N", "[", 
         RowBox[{"Append", "[", 
          RowBox[{"r", ",", "z"}], "]"}], "]"}]}]}], "]"}]}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.5557504815133343`*^9, 3.555750540411933*^9}, 
   3.555758452927258*^9, {3.55585029280422*^9, 3.555850294009338*^9}, {
   3.719848622675411*^9, 3.719848673655019*^9}, 3.719854079717201*^9, 
   3.719936124563055*^9, 3.719943219316766*^9, 3.719943285707497*^9, {
