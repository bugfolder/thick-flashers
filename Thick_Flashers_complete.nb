 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FoldCurvedFold3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.690971199004568*^9, 3.690971217037642*^9}, 
   3.690988493844738*^9, 3.691182773297948*^9, 3.6912356848331137`*^9, 
   3.691235885131102*^9, 3.691252613445842*^9, {3.691696403881215*^9, 
   3.691696426117591*^9}, {3.6916975142902403`*^9, 3.691697528291098*^9}, 
   3.691697988392797*^9, 3.691698253177126*^9, 3.691921636647003*^9, 
   3.691921671373208*^9, {3.799443479083849*^9, 3.799443481179179*^9}, 
   3.799512815455125*^9, 3.799530296603806*^9, 3.8016582439035*^9},
 CellLabel->
  "In[3966]:=",ExpressionUUID->"c2855955-51a1-4cbe-bc9e-88f5ab46f330"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FoldCurvedFold3D", "::", "nosoln"}], 
   "=", "\"\<DSolve couldn't integrate the fold angle equation.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.7994871182869396`*^9, 
   3.79948714206791*^9}, 3.7994882597419653`*^9, 3.799490874181484*^9, {
   3.799515096517729*^9, 3.7995151031861362`*^9}, {3.799525679166483*^9, 
   3.79952567990024*^9}, 3.799530296606353*^9, 3.801658243910611*^9},
 CellLabel->
