   3.911883002005395*^9},ExpressionUUID->"470440b2-01f7-4f2d-a504-\
5791f867de6e"],

Cell[TextData[{
 "ThickFlasherVertexRules[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["srules",
  FontSlant->"Italic"],
 "] takes the parameters specifying a thick flasher and a set of scalar-value \
rules ",
 StyleBox["srules",
  FontSlant->"Italic"],
 " (like the output of FlasherDefaultScalarRules) and returns a set of rules \
that apply those scalar values to vector vertex coordinates. It\
\[CloseCurlyQuote]s a way of applying solution values to un-Scalarized \
objects, like the graphical representations."
}], "Text",
 CellChangeTimes->{{3.555784893005125*^9, 3.555784912208316*^9}, {
   3.555784962109132*^9, 3.555784988101329*^9}, {3.55578506638206*^9, 
   3.555785088548916*^9}, 3.555788856845254*^9, {3.5559550847401853`*^9, 
   3.555955085674701*^9}, 3.7198667060739326`*^9, {3.719866941365508*^9, 
   3.719866941375538*^9}, 3.719866972375852*^9, {3.7198673486856217`*^9, 
   3.719867350012434*^9}, {3.719925892057863*^9, 3.7199258920799093`*^9}, {
   3.719935792326622*^9, 3.7199357930194397`*^9}, {3.719936101932827*^9, 
   3.719936103548389*^9}, {3.825606917881778*^9, 3.825606923823037*^9}, 
   3.911828228750169*^9, 3.911881074809074*^9, 3.911881162084809*^9, {
   3.9118814447103043`*^9, 3.911881446259144*^9}, {3.911899212269598*^9, 
   3.911899222085455*^9}, {3.9135441298612967`*^9, 
   3.9135441367459583`*^9}},ExpressionUUID->"d630b072-c2d1-472a-b505-\
7a181550e1dc"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}], TraditionalForm]],ExpressionUUID->
  "2ad701e1-6f15-4ac1-b3b5-80417d04560b"],
 " of symbols to use for vector and scalar variables.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the ring number.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the desired panel thickness.\n\t",
 StyleBox["srules",
  FontSlant->"Italic"],
 " \[LongDash] a set of default scalar rules, such as those returned by \
FlasherDefaultScalarRules."
}], "Text",
 CellChangeTimes->{{3.913543697760539*^9, 3.913543745801195*^9}, {
  3.913543776446087*^9, 3.9135437769189243`*^9}, {3.913543826194417*^9, 
  3.913543869643005*^9}, {3.913543961333653*^9, 3.913543989591729*^9}, {
  3.91354439910258*^9, 
  3.9135444442166653`*^9}},ExpressionUUID->"459392a6-d975-411d-b2f4-\
abd34c0190e0"],

Cell[TextData[{
 "Returns: a set of rules that apply the values from ",
 StyleBox["srules",
  FontSlant->"Italic"],
 " to all vector variables."
}], "Text",
 CellChangeTimes->{{3.9135444502692347`*^9, 
  3.913544494729706*^9}},ExpressionUUID->"958c1db1-e4e3-40e0-bc5c-\
04b12100baff"],

Cell["\<\
This is the version to use with thick flashers. It is similar to \
FlasherVertexRules (for zero-thickness flashers) and \
ParaboloicalFlasherVertexRules (for paraboloidal flashers).\
\>", "Text",
 CellChangeTimes->{{3.825675896214468*^9, 3.825675905454684*^9}, {
  3.911881283806347*^9, 3.9118812845956793`*^9}, {3.913544092646106*^9, 
  3.913544118159959*^9}},ExpressionUUID->"0b6cfbff-699b-4947-8c10-\
3e5e0c944912"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherVertexRules", "[", 
   RowBox[{
   "vars_", ",", "r_", ",", "h_", ",", "m_", ",", "t_", ",", "srules_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "verts", ",", "vals"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"FlasherVertices", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "m"}], "]"}], ",", 
        RowBox[{"FlasherVertices", "[", 
         RowBox[{"pp", ",", "r", ",", "h", ",", "m"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vals", "=", 
      RowBox[{"ThickFlasherScalarize", "[", 
       RowBox[{"vars", ",", "verts", ",", "r", ",", "h", ",", "m", ",", "t"}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{"Rule", ",", 
       RowBox[{"{", 
        RowBox[{"verts", ",", 
         RowBox[{"vals", "/.", "srules"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.555784767959429*^9, 3.555784795299416*^9}, {
   3.5557848638732023`*^9, 3.555784874397983*^9}, {3.55578494482899*^9, 
   3.555784957433799*^9}, {3.555785015246384*^9, 3.555785023424417*^9}, {
   3.71986694128336*^9, 3.7198669412948833`*^9}, 3.719866972383183*^9, 
   3.719867331895104*^9, {3.719868503733794*^9, 3.719868529623519*^9}, {
   3.719925891845898*^9, 3.719925891869394*^9}, {3.71992598003998*^9, 
   3.7199259800456343`*^9}, 3.719926067380199*^9, 3.71994321938382*^9, {
   3.7199432857383013`*^9, 3.719943299404669*^9}, {3.825606930049187*^9, 
   3.8256069884503613`*^9}, 3.91182822876452*^9, 3.911881074825261*^9, {
   3.9118814159364443`*^9, 3.911881423899013*^9}, {3.911881507309711*^9, 
   3.911881507780338*^9}, {3.911881647370377*^9, 3.9118816477533917`*^9}, {
   3.911881704050858*^9, 3.911881769915181*^9}, {3.911881813288068*^9, 
   3.911881863315651*^9}, {3.911881903358096*^9, 3.91188196635024*^9}, {
   3.911882270208203*^9, 3.911882270608858*^9}, {3.911882649245929*^9, 
   3.911882732631775*^9}, {3.911882774076859*^9, 3.9118827773842363`*^9}, {
   3.9118829228115788`*^9, 3.911882949966603*^9}},
 CellLabel->
  "In[4480]:=",ExpressionUUID->"de5bcba4-9350-4647-af16-b94586124c0d"],

Cell["Example", "Text",
 CellChangeTimes->{{3.91188160978964*^9, 
  3.9118816109877033`*^9}},ExpressionUUID->"539bf772-ab9a-4976-9cf4-\
8f13d647abb3"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "p", ",", "px", ",", "py", ",", "pp", ",",
      "ppx", ",", "ppy", ",", "ppz", ",", "vars", ",", "srules"}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"{", 
      RowBox[{
      "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
       "ppz"}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"srules", "=", 
     RowBox[{"FlasherDefaultScalarRules", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ThickFlasherVertexRules", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "t", ",", "srules"}],
       "]"}], "//", "N"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.911882408948876*^9, 3.911882459411023*^9}, {
   3.911882493598916*^9, 3.911882625378605*^9}, {3.911882882305608*^9, 
