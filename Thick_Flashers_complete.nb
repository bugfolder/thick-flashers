Cell[CellGroupData[{

Cell["Rotation angles", "Subsection",
 CellChangeTimes->{{3.595973047123577*^9, 3.5959730502264147`*^9}, {
   3.595974463160424*^9, 3.5959744633109694`*^9}, 
   3.70840092622194*^9},ExpressionUUID->"280707f3-8d3f-4d48-bc2c-\
c35c2d257aeb"],

Cell[CellGroupData[{

Cell[TextData[{
 "DirectedAngle3D",
 "[",
 StyleBox["a, b, c",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.441836879723411*^9, 3.4418368872108707`*^9}, {
   3.496236949199965*^9, 3.496236954830084*^9}, 3.496237017695085*^9, 
   3.591978819739583*^9, 
   3.62878631972472*^9},ExpressionUUID->"4311647d-a7f6-475b-960b-\
bc5ff66bc2be"],

Cell[TextData[{
 "DirectedAngle3D",
 "[",
 StyleBox["a, b, c",
  FontSlant->"Italic"],
 "] takes two vectors ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 " perpendicular to a third vector ",
 StyleBox["c",
  FontSlant->"Italic"],
 " and returns the angle of rotation about ",
 StyleBox["c",
  FontSlant->"Italic"],
 " that takes ",
 StyleBox["a",
  FontSlant->"Italic"],
 " into ",
 StyleBox["b",
  FontSlant->"Italic"],
 ". Note that none of the three vectors needs to be normalized, but ",
 StyleBox["c",
  FontSlant->"Italic"],
 " should be nonzero and truly perpendicular to both ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 ". That's fairly restrictive; one should use this in a situation when \
there's a definite orientation of the plane containing ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 ". Result lies in the range of built-in function ArcTan, i.e., \
(-\[Pi],\[Pi]]."
}], "Text",
 CellChangeTimes->{{3.4418368893633347`*^9, 3.441836936684742*^9}, {
   3.441837051368936*^9, 3.4418370604249372`*^9}, {3.457611738764127*^9, 
   3.457611740739593*^9}, {3.496236737850747*^9, 3.496236825780751*^9}, {
   3.496236887592274*^9, 3.496236929356805*^9}, 3.5919788199195538`*^9, 
   3.62878631988805*^9},ExpressionUUID->"0c2805c5-a9d3-4b09-b37a-\
d73373cc22b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DirectedAngle3D", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{"ArcTan", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", ".", "b"}], " ", 
     RowBox[{"Mag", "[", "c", "]"}]}], ",", 
    RowBox[{"a", ".", 
     RowBox[{"(", 
      RowBox[{"b", "\[Cross]", "c"}], ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.441836982436759*^9, 3.441837009451874*^9}, {
   3.4590370059829206`*^9, 3.459037008571572*^9}, {3.459037077581739*^9, 
   3.459037125824142*^9}, 3.591978819943596*^9, 3.628786319911237*^9},
 CellLabel->
  "In[720]:=",ExpressionUUID->"00c23ebf-d951-40fc-9721-0e339ff56d04"],

