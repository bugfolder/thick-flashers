Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "fo"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTPlaneGraph", "[", 
        RowBox[{"pgvertscp", ",", "pgedges", ",", "pgfaces"}], "]"}], "//", 
       RowBox[{"AddTAssigned", "[", "pgtypes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"TypeToFlatFoldAngle", "[", "pgtypes", "]"}], ",", 
        RowBox[{"StationaryFace", "\[Rule]", "4"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fo", "=", 
      RowBox[{"FaceOverlaps2D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "fo", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"GraphGraphics", "[", 
           RowBox[{"tobj", ",", 
            RowBox[{"FaceColoring", "\[Rule]", 
             RowBox[{"TwoColorGraph", "[", 
              RowBox[{"tobj", ",", 
               RowBox[{"StartFace", "\[Rule]", "1"}]}], "]"}]}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
           RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graph2DGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Show", "[", 
           RowBox[{
