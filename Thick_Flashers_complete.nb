      SubscriptBox["v", "a"], ",", " ", 
      SubscriptBox["v", "b"], ",", " ", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"f464d882-71a8-4db8-94da-1ade2236a900"],
 " is a TObj property that specifies the vertices by index around the \
boundary of the ",
 "plane graph",
 " in CCW order."
}], "Text",
 CellChangeTimes->{{3.591694799647542*^9, 3.591694912369738*^9}, {
   3.591694944022522*^9, 3.591695006802704*^9}, {3.591695135524397*^9, 
   3.591695188654469*^9}, {3.591896246433169*^9, 3.591896249121705*^9}, 
   3.5920707871311617`*^9, {3.59222436871375*^9, 3.592224368713854*^9}, 
   3.59243574036229*^9, 
   3.594303646725634*^9},ExpressionUUID->"de9de241-7add-4e21-a75b-\
723d65c686fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BoundaryVertices", "::", "usage"}], 
   "=", "\"\<BoundaryVertices is a TObj property that specifies the vertices \
by index around the boundary of the plane graph in CCW order.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.591694929956902*^9, 3.592070787227914*^9, {3.59222436872279*^9, 
   3.592224368730158*^9}, {3.59222522115749*^9, 3.5922252313957987`*^9}, {
   3.5922252894467907`*^9, 3.592225291728307*^9}, 3.592435740439401*^9, {
   3.5943036288152447`*^9, 3.5943036299185963`*^9}},
 CellLabel->
  "In[1265]:=",ExpressionUUID->"7f45658f-04f5-4fe5-aa37-08d7e2c02f0d"],

Cell[TextData[{
 "BoundaryEdges \[Rule] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["e", "i"], ",", 
     SubscriptBox["e", "j"], ",", " ", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"5c38c0a5-9473-48b9-831f-f3dc6e4aa6e9"],
 " is a TObj property that specifies the edges by index around the boundary \
of the ",
 "plane graph",
 " in CCW order."
}], "Text",
 CellChangeTimes->{{3.591694799647542*^9, 3.591694912369738*^9}, {
   3.591694944022522*^9, 3.591695006802704*^9}, {3.591695135524397*^9, 
   3.591695188654469*^9}, {3.591896246433169*^9, 3.591896249121705*^9}, 
   3.5920707871311617`*^9, {3.59222436871375*^9, 3.592224368713854*^9}, {
   3.592225175769657*^9, 3.592225184595629*^9}, {3.592225296607121*^9, 
   3.592225298520072*^9}, {3.592240585580855*^9, 3.59224062720883*^9}, 
   3.592435740520818*^9, {3.593211552802328*^9, 3.593211638320834*^9}, 
   3.59430365500216*^9},ExpressionUUID->"942d0f5f-1a35-4c04-a405-\
be572759ef30"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BoundaryEdges", "::", "usage"}], 
   "=", "\"\<BoundaryEdges is a TObj property that specifies the edges as by \
index around the boundary of the plane graph in CCW order.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.591694929956902*^9, 3.592070787227914*^9, {3.59222436872279*^9, 
   3.592224368730158*^9}, {3.592225190039182*^9, 3.592225204991122*^9}, {
   3.592225301661154*^9, 3.59222530321932*^9}, {3.59224057515018*^9, 
   3.59224057945261*^9}, 3.5924357405892067`*^9, {3.593212246611852*^9, 
   3.59321224734018*^9}, 3.594303641782979*^9},
 CellLabel->
  "In[1266]:=",ExpressionUUID->"ced35623-3ff4-47a3-8917-c83310dba008"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"BoundaryFaces", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["f", "a"], ",", " ", 
      SubscriptBox["f", "b"], ",", " ", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"39943689-8c83-4917-9863-3ee7c88141a5"],
 " is a TObj property that specifies the incident faces by index around the \
boundary of the ",
 "plane graph",
 " in CCW order."
}], "Text",
 CellChangeTimes->{{3.591694799647542*^9, 3.591694912369738*^9}, {
   3.591694944022522*^9, 3.591695006802704*^9}, {3.591695135524397*^9, 
   3.591695188654469*^9}, {3.591896246433169*^9, 3.591896249121705*^9}, 
   3.5920707871311617`*^9, {3.59222436871375*^9, 3.592224368713854*^9}, {
   3.59222524104097*^9, 3.592225267998118*^9}, 3.592435740666*^9, {
   3.594303659898226*^9, 
   3.594303660321483*^9}},ExpressionUUID->"b23bbb2b-1994-4c00-b2b9-\
e76b5cdceedd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BoundaryFaces", "::", "usage"}], 
   "=", "\"\<BoundaryFaces is a TObj property that specifies the incident \
faces by index around the boundary of the plane graph in CCW order.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.591694929956902*^9, 3.592070787227914*^9, {3.59222436872279*^9, 
   3.592224368730158*^9}, {3.59222527121754*^9, 3.59222527764268*^9}, {
   3.592225310714452*^9, 3.592225314767119*^9}, 3.5924357407413*^9, 
   3.594303664974823*^9},
 CellLabel->
  "In[1267]:=",ExpressionUUID->"3e465ccc-f28a-43b7-906c-152238912d6e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"VertexVertexAdjacency", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["v", "i"], ",", " ", 
        SubscriptBox["v", "j"], ",", " ", "..."}], "}"}], ",", " ", "..."}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "1b5df8e6-0b58-4d69-884e-3ca1fd5cb425"],
 " is a ",
 "TObj",
 " property that specifies the vertices by index around each vertex in CCW \
order. Each entry is a list of the vertex indices around the corresponding \
vertex in Vertices."
}], "Text",
 CellChangeTimes->{{3.591694799647542*^9, 3.591694912369738*^9}, {
   3.591694944022522*^9, 3.591695006802704*^9}, {3.591895912381662*^9, 
   3.591895912381741*^9}, {3.591897042745317*^9, 3.5918970746048183`*^9}, {
   3.591897422518556*^9, 3.591897424526492*^9}, 3.59207078737309*^9, 
   3.592435740834416*^9},ExpressionUUID->"73047ae7-9f66-4bac-8acb-\
17fea7ab28eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VertexVertexAdjacency", "::", "usage"}], 
   "=", "\"\<VertexVertexAdjacency is a TObj property that specifies the \
adjacent vertices around a vertex in CCW order.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591691266018976*^9, 3.591691352152869*^9}, {
   3.59169151502154*^9, 3.59169161782491*^9}, 3.591694926675729*^9, {
   3.591895912613155*^9, 3.591895912861209*^9}, {3.591896229358638*^9, 
   3.591896234846403*^9}, {3.591897176458572*^9, 3.5918971867595253`*^9}, {
   3.591899164097361*^9, 3.591899168707452*^9}, 3.5920707874609632`*^9, 
   3.5924357409234447`*^9},
 CellLabel->
  "In[1268]:=",ExpressionUUID->"4bfbfc52-a860-4ae0-98d4-a76d8d9f818a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"VertexEdgeIncidence", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["e", "i"], ",", " ", 
        SubscriptBox["e", "j"], ",", " ", "..."}], "}"}], ",", " ", "..."}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "6e22b1e8-35fd-4f56-882a-f8350a064881"],
 " is a ",
 "TObj",
 " property that specifies the edges by index that are incident to each \
vertex in CCW order. Each entry is a list of the edges incident to the \
corresponding vertex in Vertices."
}], "Text",
 CellChangeTimes->{{3.591897461599214*^9, 3.59189753451074*^9}, 
   3.592070787610442*^9, 
   3.592435741005208*^9},ExpressionUUID->"329d0ff9-bfac-4e20-829d-\
30a096c7a9d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VertexEdgeIncidence", "::", "usage"}], " ", "=", 
   " ", "\"\<VertexEdgeIncidence is a TObj property that specifies the edges \
incident around a vertex in CCW order.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591897539222103*^9, 3.591897568885123*^9}, 
   3.5918976385411453`*^9, 3.592070787695225*^9, 3.5924357410738993`*^9},
 CellLabel->
  "In[1269]:=",ExpressionUUID->"85e0537a-bb82-4573-9534-3a1c5b49053c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"VertexFaceIncidence", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["f", "i"], ",", " ", 
        SubscriptBox["f", "j"], ",", " ", "..."}], "}"}], ",", "..."}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "73ea5e6f-7b32-4521-bc14-fc14f914f327"],
 " is a ",
 "TObj",
 " property that specifies the faces by index around each vertex in CCW \
order. Each entry is a list of the face indices around the corresponding \
vertex. We use 0 as the index of the exterior of the graph. Each entry is a \
list of the vertices adjacent to the corresponding vertex in Vertices."
}], "Text",
 CellChangeTimes->{{3.591896879178784*^9, 3.591896969155197*^9}, {
   3.5918970292325077`*^9, 3.591897037940322*^9}, {3.591897078668027*^9, 
   3.591897092547433*^9}, {3.5918974057354383`*^9, 3.591897420150809*^9}, 
   3.592070787855623*^9, 
   3.59243574116113*^9},ExpressionUUID->"d884083d-2b18-46c0-a61a-\
c02fd8ae9640"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VertexFaceIncidence", "::", "usage"}], 
   "=", "\"\<VertexFaceIncidence is a TObj property that specifies the faces \
around a vertex in CCW order.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591897102031711*^9, 3.591897169145527*^9}, 
   3.592070787927866*^9, 3.592435741223447*^9},
 CellLabel->
  "In[1270]:=",ExpressionUUID->"2da383ad-d2ea-4e7a-abb2-cc4b78e92788"],

Cell[TextData[{
 "There are ordering relationships between the three vertex incidence lists: \
for a given vertex, the adjacent vertex and its corresponding edge occupy the \
same position in their respective lists, and the edges in VertexEdgeIncidence \
and faces in VertexFaceIncidence alternate, with the ith edge preceding the \
ith face in CCW order (in the same way that in the book TTT, dihedral angle \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "i"], TraditionalForm]],ExpressionUUID->
  "d56aa509-9b84-4b6a-b7af-95c088ea7834"],
 "precedes sector angle ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],ExpressionUUID->
  "d2d88749-b2be-4a71-912a-9810e9fc6e56"],
 ")."
}], "Text",
 CellChangeTimes->{{3.591897666454562*^9, 3.5918976833490963`*^9}, {
   3.59189925057911*^9, 3.59189939336088*^9}, 
   3.643725937910427*^9},ExpressionUUID->"6a83b235-d2db-4d14-aa52-\
f0e68ddcc4d6"],

Cell[TextData[{
 "EdgeEdgeAdjacency \[Rule] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["e", 
          RowBox[{"i", ",", "1"}]], ",", 
         SubscriptBox["e", 
          RowBox[{"i", ",", "2"}]], ",", "\[Ellipsis]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["e", 
          RowBox[{"j", ",", "1"}]], ",", 
         SubscriptBox["e", 
          RowBox[{"j", ",", "2"}]], ",", "\[Ellipsis]"}], "}"}]}], "}"}], ",",
      "\[Ellipsis]"}], "}"}], TraditionalForm]],ExpressionUUID->
  "b8180666-e632-4174-9adc-12f933471795"],
 " is a TObj property that specifies the edges by index around the vertices \
at either end of each edge. That is, for edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["v", "i"], ",", 
     SubscriptBox["v", "j"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "7829188d-a936-4f51-9ea9-95a5a7a11114"],
 ", list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["e", 
      RowBox[{"i", ",", "1"}]], ",", 
     SubscriptBox["e", 
      RowBox[{"i", ",", "2"}]], ",", "\[Ellipsis]"}], "}"}], 
   TraditionalForm]],ExpressionUUID->"9d6a1a78-9d1c-48c2-b27e-3163643b93b6"],
 " are the other edges incident to vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "078775cb-0e6c-411b-8eb0-e20380381d5b"],
 " and list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["e", 
      RowBox[{"j", ",", "1"}]], ",", 
     SubscriptBox["e", 
      RowBox[{"j", ",", "2"}]], ",", "\[Ellipsis]"}], "}"}], 
   TraditionalForm]],ExpressionUUID->"0a7761c3-8b50-43f9-89a5-c2ce42a12ddb"],
 " are the other edges incident to vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "j"], TraditionalForm]],ExpressionUUID->
  "ee219fa0-044f-4881-b494-b426b99e31bf"],
 "."
}], "Text",
 CellChangeTimes->{{3.626464421492836*^9, 3.626464700410012*^9}, {
  3.626464735439784*^9, 
  3.62646475114233*^9}},ExpressionUUID->"719cc82e-75b8-45b4-b9d2-\
59f906f816b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EdgeEdgeAdjacency", "::", "usage"}], 
   "=", "\"\<EdgeEdgeAdjacency is a TObj property that specifies the edges \
around the vertices at each end of each edge, in CCW order.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.626464758312316*^9, 3.626464785294835*^9}},
 CellLabel->
  "In[1271]:=",ExpressionUUID->"309b2c4f-c8ff-4c54-9a87-848b8580afa2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"EdgeFaceIncidence", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["f", "i"], ",", " ", 
        SubscriptBox["f", "j"]}], "}"}], ",", " ", "..."}], "}"}]}], 
   TraditionalForm]],ExpressionUUID->"94c9b221-e232-47cd-80a4-29c704ad36cb"],
 " is a TObj property that specifies the faces by index on either side of an \
edge of a plane graph. We use 0 as the index of the exterior of the graph. \
Each entry is a list of the two faces incident to the corresponding edge in \
Edges, in the order {right, left} relative to the direction of the edge."
}], "Text",
 CellChangeTimes->{{3.591897232209256*^9, 3.591897272455635*^9}, {
   3.591897309781906*^9, 3.591897325868823*^9}, {3.591897380497154*^9, 
   3.591897395056039*^9}, {3.591897427837521*^9, 3.5918974439652*^9}, 
   3.592070788077816*^9, 3.5924357413060293`*^9, {3.702660138123664*^9, 
   3.702660176729267*^9}},ExpressionUUID->"f88d27ac-2acd-4375-981a-\
c1a053b5b143"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EdgeFaceIncidence", "::", "usage"}], 
   "=", "\"\<EdgeFaceIncidence is a TObj property that specifies the faces to \
right and left of each edge in a plane graph.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591897330358979*^9, 3.591897374432698*^9}, 
   3.592070788160892*^9, 3.5924357413748217`*^9, {3.702660125234508*^9, 
   3.702660146704989*^9}},
 CellLabel->
  "In[1272]:=",ExpressionUUID->"2ca795cc-5c7f-4f9b-9b3e-8b7ab3fdd64c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"FaceEdgeIncidence", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["e", "i"], ",", " ", 
        SubscriptBox["e", "j"], ",", " ", "..."}], "}"}], ",", " ", "..."}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "fc1cbdf0-9b19-427c-bf28-fca4e0330376"],
 " is a ",
 "TObj",
 " property that specifies the edge by index around each face in CCW order in \
a plane graph. Each entry is a list of the edges incident to the \
corresponding face in Faces."
}], "Text",
 CellChangeTimes->{{3.591897232209256*^9, 3.591897272455635*^9}, {
   3.591897309781906*^9, 3.591897325868823*^9}, {3.591897380497154*^9, 
   3.591897395056039*^9}, {3.591897427837521*^9, 3.5918974439652*^9}, {
   3.591900298366583*^9, 3.591900359809922*^9}, 3.5920707883099627`*^9, 
   3.592435741468155*^9},ExpressionUUID->"bf967443-8c76-4cdd-9b4c-\
0889de2fada4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FaceEdgeIncidence", "::", "usage"}], 
   "=", "\"\<FaceEdgeIncidence is a TObj property that specifies the edges \
around a face in a plane graph.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591900366461876*^9, 3.591900390193083*^9}, 
   3.592070788394909*^9, 3.592435741543776*^9},
 CellLabel->
  "In[1273]:=",ExpressionUUID->"69df2de3-c5bc-4ba1-a2cb-1fca6357b46c"],

Cell["\<\
In the same way as for VertexEdgeIncidence and VertexFaceIncidence, the edges \
in FaceEdgeIncidence alternate with the vertices in Faces, with the ith edge \
in FaceEdgeIncidence following the ith vertex in Faces.\
\>", "Text",
 CellChangeTimes->{{3.591900409735531*^9, 3.59190046256253*^9}, {
  3.706726369509865*^9, 
  3.706726410250143*^9}},ExpressionUUID->"92e0d35d-b0d7-4453-949c-\
b3297698913d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "AddTPlaneGraphTo[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) ExistingFacesWarning\n\
AddTPlaneGraph\nRebuildPlaneGraph\nMakeTPlaneGraph[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 "]\nMakeTPlaneGraph[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges, faces",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.458171805316916*^9, 3.458171832978745*^9}, {
   3.4581721168724422`*^9, 3.458172119312291*^9}, {3.4582142686004486`*^9, 
   3.458214273120064*^9}, {3.458215096888581*^9, 3.458215129141988*^9}, {
   3.458215494911352*^9, 3.4582155040846777`*^9}, {3.462345995933643*^9, 
   3.4623460144955473`*^9}, {3.462972118025418*^9, 3.462972145031386*^9}, {
   3.4659250859277887`*^9, 3.46592508977245*^9}, {3.551876016708628*^9, 
   3.551876030051983*^9}, {3.551876171537257*^9, 3.551876185532549*^9}, {
   3.551876654092889*^9, 3.551876655260977*^9}, {3.5916912305511727`*^9, 
   3.591691238020237*^9}, 3.591691301888402*^9, {3.591694659194291*^9, 
   3.591694700587169*^9}, {3.591697124887364*^9, 3.5916971536288753`*^9}, 
   3.5916971847794228`*^9, 3.59172860936448*^9, {3.5917370102869186`*^9, 
   3.59173702044958*^9}, 3.5917951570618978`*^9, 3.591895912338667*^9, 
   3.591896296368455*^9, {3.591896497372656*^9, 3.59189653365083*^9}, 
   3.592039959136863*^9, 3.592208503478457*^9, {3.592351245051843*^9, 
   3.592351248722554*^9}, {3.592351343316778*^9, 3.592351347211669*^9}, {
   3.592378269499652*^9, 3.592378280513976*^9}, {3.5924323494732423`*^9, 
   3.592432350223324*^9}, 3.592435741628995*^9, 3.5924358529820976`*^9, {
   3.592435947177927*^9, 3.592435947713149*^9}, 3.592441376270249*^9, {
   3.592441587872004*^9, 3.592441589031666*^9}, {3.592489322950781*^9, 
   3.5924893290232153`*^9}, 3.5926476457637377`*^9, {3.59264770457097*^9, 
   3.592647726906637*^9}, {3.592648194219254*^9, 3.592648230687715*^9}, {
   3.592648377247548*^9, 3.592648406795745*^9}, 3.5927849402656717`*^9, {
   3.592828714397078*^9, 3.592828714894909*^9}, 3.595009023053841*^9, 
   3.708400177205805*^9, 
   3.708603655796078*^9},ExpressionUUID->"3460f847-8566-4657-a6f1-\
aa93aa5000f2"],

Cell[TextData[{
 "AddTPlaneGraphTo[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph and adds to it the properties that make it a TPlaneGraph. \
Note that the graph must be well-formed, having all vertices of degree 2 or \
more and no crossing edges, and must be connected."
}], "Text",
 CellChangeTimes->{{3.458171812788463*^9, 3.458171983977013*^9}, {
   3.458214256419151*^9, 3.458214329804515*^9}, {3.465924922841784*^9, 
   3.46592496260552*^9}, 3.465925208941907*^9, 3.484829044401004*^9, {
   3.591694730332711*^9, 3.591694766394113*^9}, {3.591695567663389*^9, 
   3.591695568839128*^9}, 3.591737010455001*^9, 3.591895913137076*^9, {
   3.591907598568223*^9, 3.591907626142375*^9}, 3.592039959246785*^9, 
   3.592208503581052*^9, 3.592224368800632*^9, {3.59235149330636*^9, 
   3.5923515041847267`*^9}, 3.59243585319029*^9, {3.59244159313553*^9, 
   3.592441593768409*^9}, {3.592441690578247*^9, 3.592441732615045*^9}, 
   3.592647645848027*^9, 3.592784940420999*^9, {3.592828715013625*^9, 
   3.592828715117198*^9}, {3.7031665262986197`*^9, 
   3.703166527336769*^9}},ExpressionUUID->"98791746-a110-4d5e-b132-\
b92d24b8cfd0"],

Cell["\<\
Options:
\tExistingFacesWarning \[Rule] True | False. If True, then a warning will be \
issued if the TGraph already contains Faces data.\
\>", "Text",
 CellChangeTimes->{{3.703166529696738*^9, 
  3.703166531592062*^9}},ExpressionUUID->"40eb50ad-c585-4b1e-8ee6-\
8044374bac6f"],

Cell[TextData[{
 "Note that if ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " already contains Faces, they will be overwritten by new Faces with a \
possibly different ordering. A warning will be issued unless you explicitly \
suppress it using using the ExistingFacesWarning \[Rule] False option."
}], "Text",
 CellChangeTimes->{{3.5917377506954546`*^9, 3.591737817121077*^9}, {
  3.591794241288314*^9, 3.591794253748551*^9}, {3.5924415782838173`*^9, 
  3.592441583048638*^9}, {3.592784892741276*^9, 3.592784923987528*^9}, {
  3.592784961522285*^9, 
  3.592784963760748*^9}},ExpressionUUID->"ad51df23-5a7a-42b6-83e3-\
a5ec5e2ac017"],

Cell["\<\
Note, too, that AddTPlaneGraph and functions like it that take a TObj as a \
single argument permit a nice chaining idiom that allow you to build up a \
complex object in a single line. You can see this in some of the examples \
later on.\
\>", "Text",
 CellChangeTimes->{{3.592403933527437*^9, 3.592404018745104*^9}, {
   3.592404064046357*^9, 3.592404082221224*^9}, 3.592647645918559*^9, 
   3.592828715227416*^9, {3.625689928149088*^9, 3.62568992848347*^9}, {
   3.643723451518277*^9, 
   3.643723461474803*^9}},ExpressionUUID->"93b9e4f2-2ad7-4eec-b5e9-\
9fd37e1aa8d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExistingFacesWarning", "::", "usage"}], 
   "=", "\"\<ExistingFacesWarning is an options to AddTPlaneGraphTo that \
specifies whether to issue a warning if existing Faces data is overwritten.\>\
\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592441655657262*^9, 3.592441687236023*^9}, 
   3.5926476459399357`*^9, {3.592784940444892*^9, 3.59278494069178*^9}, 
   3.592828715331289*^9},
 CellLabel->
  "In[1274]:=",ExpressionUUID->"31d258f1-7142-4e0d-8e8b-f90fa939c6fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "AddTPlaneGraphTo", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"ExistingFacesWarning", "\[Rule]", "True"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.592441613107742*^9, 3.5924416528222647`*^9}, 
   3.592647645963045*^9, 3.592784940927565*^9, 3.592828715432426*^9},
 CellLabel->
  "In[1275]:=",ExpressionUUID->"031e835b-827f-4ae7-85fe-39fa275c7653"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddTPlaneGraphTo", "::", "hasfaces"}], 
   "=", "\"\<Warning: TObj `1` already has Faces data. It will be \
overwritten.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591794256238616*^9, 3.591794277541749*^9}, 
   3.592039959272829*^9, 3.592208503603325*^9, 3.592435741873501*^9, 
   3.592647646009334*^9, 3.5928287155318108`*^9},
 CellLabel->
  "In[1276]:=",ExpressionUUID->"81ab9c99-6214-4d42-8494-e81c47f5c963"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddTPlaneGraphTo", "::", "badwinding"}], 
   "=", "\"\<TObj `1` does not have a face cycle with a winding number of -1. \
Cycles are `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.643731994690328*^9, 3.64373208268592*^9}},
 CellLabel->
  "In[1277]:=",ExpressionUUID->"bf09fa25-71cd-4125-bfff-70ecaf9079fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTPlaneGraphTo", "[", 
   RowBox[{"tobj_TObj", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "efw", ",", "verts", ",", " ", "edges", ",", "vva", ",", "vei", ",", 
      "emap", ",", "nhefn", ",", "cycles", ",", "halfedges", ",", "curedge", ",",
       "curcycle", ",", "cycwin", ",", "wnos", ",", "nplus", ",", "nminus", ",",
       "faces", ",", "iverts", ",", "bverts", ",", "bedges", ",", "bfaces", ",",
       "ib", ",", "allfaces", ",", "starpp", ",", "facepp", ",", "edgepp", ",",
       "efifn", ",", "vfifn", ",", "vfi", ",", "efi", ",", "fei", ",", ",", 
      "va", ",", "vb", ",", "eea"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "AddTPlaneGraphTo"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"efw", "=", 
      RowBox[{
       RowBox[{"ExistingFacesWarning", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "AddTPlaneGraphTo", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"efw", " ", "&&", " ", 
        RowBox[{"HasFacesQ", "[", "tobj", "]"}]}], ",", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"AddTPlaneGraphTo", "::", "hasfaces"}], ",", "tobj"}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "VertexVertexAdjacency"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vva", "=", 
      RowBox[{"VertexVertexAdjacencyFromVerticesAndEdges", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "a", " ", "lookup", " ", "function", " ", "that", " ", 
       "returns", " ", "edge", " ", "index", " ", "for", " ", "either", " ", 
       "order", " ", "of", " ", "the", " ", "edge"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"emap", "[", 
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         "]"}], "=", "i"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"emap", "[", 
         RowBox[{"Reverse", "[", 
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          "]"}], "]"}], "=", "i"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "VertexEdgeAdjacency"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vei", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"emap", "[", 
           RowBox[{"{", 
            RowBox[{"i", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
         RowBox[{
         "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "vva", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "compute", " ", "cycles", " ", "of", " ", "vertex", " ", "adjacency", " ",
         "and", " ", "from", " ", "that"}], ",", " ", 
       RowBox[{
       "extract", " ", "Faces", " ", "and", " ", "BoundaryVertices"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nhefn", "[", 
       RowBox[{"{", 
        RowBox[{"i_", ",", "j_"}], "}"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"vva", "\[LeftDoubleBracket]", 
         RowBox[{"j", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{
                RowBox[{
                "vva", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}],
                 ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}], 
            ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "vva", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
             "]"}], ",", "1"}], "]"}]}], "\[RightDoubleBracket]"}]}], "}"}]}],
      ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"nhefn", " ", "returns", " ", "next", " ", "half"}], "-", 
       RowBox[{"edge", " ", "in", " ", "a", " ", "cycle"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"build", " ", "all", " ", "CCW", " ", 
        RowBox[{"cycles", ".", " ", "Note"}], " ", "that", " ", "one", " ", 
        "will", " ", "be", " ", "retrograde"}], ",", " ", 
       RowBox[{"which", " ", "is", " ", "the", " ", 
        RowBox[{"boundary", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"curedge", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"curcycle", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cycles", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"halfedges", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"edges", ",", 
        RowBox[{"Reverse", "/@", "edges"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "halfedges", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"curedge", "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "start", " ", "a", " ", "new", " ", "cycle", " ", "from", " ", "a", 
           " ", "halfedge"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"curedge", "=", 
           RowBox[{
           "halfedges", "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"halfedges", "=", 
           RowBox[{"DropFirst", "[", "halfedges", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"curcycle", "=", 
           RowBox[{"{", "curedge", "}"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"continue", " ", "the", " ", "existing", " ", "cycle"}], 
          " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"curedge", "=", 
           RowBox[{"nhefn", "[", "curedge", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"halfedges", ",", "curedge"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "add", " ", "this", " ", "edge", " ", "to", " ", "the", " ", 
              "cycle", " ", "and", " ", "continue"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"curcycle", ",", "curedge"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"halfedges", "=", 
              RowBox[{"DeleteItem", "[", 
               RowBox[{"halfedges", ",", "curedge"}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"else", " ", "close", " ", "the", " ", "cycle"}], " ", 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"cycles", ",", 
               RowBox[{
                RowBox[{"Transpose", "[", "curcycle", "]"}], "\[LeftDoubleBracket]",
                 "1", "\[RightDoubleBracket]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"curcycle", "=", 
              RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"curedge", "=", 
              RowBox[{"{", "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}]}],
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"cycles", ",", 
       RowBox[{
        RowBox[{"Transpose", "[", "curcycle", "]"}], "\[LeftDoubleBracket]", 
        "1", "\[RightDoubleBracket]"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"last", " ", "one"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "now", " ", "sort", " ", "by", " ", "winding", " ", "number", " ", 
        "to", " ", "get", " ", "faces"}], ",", " ", "boundary", ",", " ", 
       RowBox[{"and", " ", "interior", " ", "vertices"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cycwin", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"WindingNumber", "[", 
           RowBox[{"verts", ",", "#"}], "]"}]}], "}"}], "&"}], "/@", 
       "cycles"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"wnos", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "cycwin"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"just", " ", "winding", " ", "numbers"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nplus", "=", 
      RowBox[{"Count", "[", 
       RowBox[{"wnos", ",", "1"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"number", " ", "of"}], " ", "+", "1"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nminus", "=", 
      RowBox[{"Count", "[", 
       RowBox[{"wnos", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"number", " ", "of"}], " ", "-", "1"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"nminus", "\[NotEqual]", "1"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"AddTPlaneGraphTo", "::", "badwinding"}], ",", "tobj", ",", 
          "cycwin"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{"cycwin", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]",
            "1"}], "&"}]}], "]"}]}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"faces", " ", "have", " ", "winding", " ", "#"}], " ", "=", 
       " ", "1"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bverts", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"First", "[", 
        RowBox[{"First", "/@", 
         RowBox[{"Select", "[", 
          RowBox[{"cycwin", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]", 
             RowBox[{"-", "1"}]}], "&"}]}], "]"}]}], "]"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"reverse", " ", "boundary", " ", "so", " ", 
       RowBox[{"it", "'"}], "s", " ", "also", " ", "CCW"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"iverts", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "verts", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"bverts", ",", "#"}], "]"}]}], "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"interior", " ", "vertices"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "BoundaryEdges"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"bedges", "=", 
      RowBox[{"emap", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"bverts", ",", 
          RowBox[{"RotateLeft", "[", "bverts", "]"}]}], "}"}], "]"}]}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "VertexFaceIncidence"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"allfaces", "=", 
      RowBox[{"Append", "[", 
       RowBox[{"faces", ",", 
        RowBox[{"Reverse", "[", "bverts", "]"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"in", " ", "this", " ", "list"}], ",", " ", 
       RowBox[{
       "boundary", " ", "is", " ", "the", " ", "last", " ", "face"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ib", "=", 
      RowBox[{"1", "+", 
       RowBox[{"Length", "[", "faces", "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"starpp", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{"i", ",", 
             RowBox[{"{", 
              RowBox[{"Length", "[", 
               RowBox[{
               "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
               "]"}], "}"}]}], "]"}], ",", 
           RowBox[{"RotateRight", "[", 
            RowBox[{
            "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "]"}]}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "vva", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"facepp", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", "i"}], "}"}], "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"RotateRight", "[", 
               RowBox[{
               "allfaces", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "]"}], ",", 
              RowBox[{
              "allfaces", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"RotateLeft", "[", 
               RowBox[{
               "allfaces", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "]"}]}], "}"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "allfaces", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"vfifn", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}], "=", 
         RowBox[{"#", "\[LeftDoubleBracket]", 
          RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ")"}], "&"}], "/@",
       "facepp"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vfi", " ", "=", 
      RowBox[{
       RowBox[{"RotateLeft", "/@", 
        RowBox[{"Map", "[", 
         RowBox[{"vfifn", ",", "starpp", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], "/.", 
       RowBox[{"ib", "\[Rule]", "0"}]}]}], ";", " ", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "EdgeFaceIncidence"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"edgepp", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", "i"}], "}"}], "&"}], "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "allfaces", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"RotateRight", "[", 
               RowBox[{
               "allfaces", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "]"}]}], "}"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "allfaces", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"efifn", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}], "=", 
         RowBox[{
         "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ")"}],
        "&"}], "/@", "edgepp"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "gives", " ", "face", " ", "to", " ", "the", " ", "right", " ", "of", " ",
        "an", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"efi", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"efifn", "[", "#", "]"}], ",", 
           RowBox[{"efifn", "[", 
            RowBox[{"Reverse", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
        "edges"}], "/.", 
       RowBox[{"ib", "\[Rule]", "0"}]}]}], ";", " ", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "BoundaryFaces"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"bfaces", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]",
             "0"}], ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "]"}], "&"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
          "efi", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
          "&"}], "/@", "bedges"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Compute", " ", "FaceEdgeIncidence"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fei", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"emap", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "/@",
          "faces"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Compute", " ", "EdgeEdgeAdjacency"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"eea", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"va", ",", "vb"}], "}"}], "=", 
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{"RotateLeft", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "va", "\[RightDoubleBracket]"}],
                ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Position", "[", 
                  RowBox[{
                   RowBox[{
                   "vei", "\[LeftDoubleBracket]", "va", 
                    "\[RightDoubleBracket]"}], ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
                 RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
                "1"}]}], "]"}], ",", "1"}], "]"}], ",", 
           RowBox[{"Drop", "[", 
            RowBox[{
             RowBox[{"RotateLeft", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "vb", "\[RightDoubleBracket]"}],
                ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Position", "[", 
                  RowBox[{
                   RowBox[{
                   "vei", "\[LeftDoubleBracket]", "vb", 
                    "\[RightDoubleBracket]"}], ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
                 RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
                "1"}]}], "]"}], ",", "1"}], "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"AddClassTo", "[", 
      RowBox[{"tobj", ",", "TPlaneGraph", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Faces", "\[Rule]", "faces"}], ",", 
         RowBox[{"InteriorVertices", "\[Rule]", "iverts"}], ",", 
         RowBox[{"BoundaryVertices", "\[Rule]", "bverts"}], ",", 
         RowBox[{"BoundaryEdges", "\[Rule]", "bedges"}], ",", 
         RowBox[{"BoundaryFaces", "\[Rule]", "bfaces"}], ",", 
         RowBox[{"VertexVertexAdjacency", "\[Rule]", "vva"}], ",", 
         RowBox[{"VertexEdgeIncidence", "\[Rule]", "vei"}], ",", 
         RowBox[{"VertexFaceIncidence", "\[Rule]", "vfi"}], ",", 
         RowBox[{"EdgeEdgeAdjacency", "\[Rule]", "eea"}], ",", 
         RowBox[{"EdgeFaceIncidence", "\[Rule]", "efi"}], ",", 
         RowBox[{"FaceEdgeIncidence", "\[Rule]", "fei"}]}], "}"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
