           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"cx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"cy", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"cz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"v", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "t", "]"}], ",", 
               RowBox[{"ty", "[", "t", "]"}], ",", 
               RowBox[{"tz", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
