Cell[CellGroupData[{

Cell[TextData[{
 "FlasherBTCStyle[",
 StyleBox["str",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.923939121118616*^9, 
  3.923939126454946*^9}},ExpressionUUID->"59611853-0fa4-4bb9-a863-\
82a80fb858e1"],

Cell[TextData[{
 "FlasherBTCStyle[",
 StyleBox["str",
  FontSlant->"Italic"],
 "] returns styles for Bottom, Top, or Connector style, based on str, which \
should be one of \[OpenCurlyDoubleQuote]bt\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]cn\[CloseCurlyDoubleQuote], or \
\[OpenCurlyDoubleQuote]tp\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.923939135951378*^9, 
  3.923939179231784*^9}},ExpressionUUID->"59a32a6c-15e0-4a38-bbaa-\
114bd292b056"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherBTCStyle", "[", "str_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Switch", "[", 
     RowBox[{"str", ",", "\"\<tp\>\"", ",", 
      RowBox[{"Lighter", "[", 
       RowBox[{"Blue", ",", "0.6"}], "]"}], ",", "\"\<bt\>\"", ",", "Yellow", 
      ",", "\"\<cn\>\"", ",", 
      RowBox[{"Lighter", "[", 
       RowBox[{"Green", ",", "0.5"}], "]"}], ",", "_", ",", "Gray"}], "]"}], ",", 
    RowBox[{"AbsoluteThickness", "[", "5", "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.923939185489057*^9, 3.923939232675118*^9}, 
   3.923939266472842*^9, {3.923939332122992*^9, 3.923939372930344*^9}, {
   3.923942852453136*^9, 3.923942855488113*^9}},
 CellLabel->
  "In[4455]:=",ExpressionUUID->"90d8c57d-9f44-4287-9c56-4e433a6ec320"],

