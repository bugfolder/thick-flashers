       RowBox[{"U", "[", 
        RowBox[{"90", "\[Degree]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p15", "=", 
      RowBox[{"p5", "+", 
       RowBox[{"U", "[", 
        RowBox[{"90", "\[Degree]"}], "]"}]}]}], ";", 
     RowBox[{"p16", "=", 
      RowBox[{"p5", "+", 
       RowBox[{"U", "[", 
        RowBox[{"150", "\[Degree]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p17", "=", 
      RowBox[{"p6", "+", 
       RowBox[{"U", "[", 
        RowBox[{"150", "\[Degree]"}], "]"}]}]}], ";", 
     RowBox[{"p18", "=", 
      RowBox[{"p6", "+", 
       RowBox[{"U", "[", 
        RowBox[{"210", "\[Degree]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
       "p1", ",", "p2", ",", "p3", ",", "p4", ",", "p5", ",", "p6", ",", "p7",
         ",", "p8", ",", "p9", ",", "p10", ",", "p11", ",", "p12", ",", "p13",
         ",", "p14", ",", "p15", ",", "p16", ",", "p17", ",", "p18"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
