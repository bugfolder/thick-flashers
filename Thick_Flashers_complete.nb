Cell["\<\
A DynamicModule version that lets us move the cut line back and forth.\
\>", "Text",
 CellChangeTimes->{{3.924626572041092*^9, 
  3.924626586747368*^9}},ExpressionUUID->"a896803a-f945-4381-b7d5-\
e5fae9455067"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", "1"}], ",", 
       RowBox[{"h", "=", "2"}], ",", 
       RowBox[{"m", "=", "6"}], ",", 
       RowBox[{"t", "=", "0.15"}], ",", "fs", ",", "pc", ",", "pmt", ",", 
       "cht", ",", "rad", ",", "tobj", ",", "panels", ",", "panelinfo", ",", 
       "joinedpanels", ",", "bbox"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "=", 
       RowBox[{"MakeThickFlasher", "[", 
        RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", "\[IndentingNewLine]", 
         RowBox[{"TypeMinimumAngle", "\[Rule]", 
          RowBox[{"10.", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
         "FlasherSectorDiagFoldLines", "->", 
          "FlasherSectorDiagFoldLinesY"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rad", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{"Take", "[", 
            RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], "/@", 
         RowBox[{"tobj", "[", "Vertices3D", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fs", "=", "2.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pc", "=", "0.05"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pmt", "=", "0.05"}], ";", "\[IndentingNewLine]", 
      RowBox[{"cht", "=", "0.05"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
       RowBox[{"MakeThickFlasherPanels", "[", 
        RowBox[{"tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherScale", "->", "fs"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PanelClearance", "->", "pc"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"joinedpanels", "=", 
       RowBox[{"ThickFlasherStowedHingeJoinPanels", "[", 
        RowBox[{
        "panels", ",", "panelinfo", ",", "tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"PanelClearance", "->", "pc"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PanelMinThickness", "->", "pmt"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CentralHingeThickness", "->", "cht"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"HingeShiftTolerance", "->", 
          RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bbox", "=", 
       RowBox[{"BoundingBoxGC", "[", "joinedpanels", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
              "joinedpanels", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}], ",", "SolidStyle", ",", 
              RowBox[{"Opacity", "[", "0.75", "]"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
              "joinedpanels", "\[LeftDoubleBracket]", "2", 
               "\[RightDoubleBracket]"}], ",", "SolidStyle", ",", 
              RowBox[{"Opacity", "[", "1", "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{"All", ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "All"}], "}"}], ",", "All"}], "}"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"y", ",", "0"}], "}"}], ",", 
          RowBox[{"bbox", "\[LeftDoubleBracket]", 
           RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"bbox", "\[LeftDoubleBracket]", 
           RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "Hold"}], 
  ";"}]], "Input",
