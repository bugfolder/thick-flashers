Cell[CellGroupData[{

Cell[TextData[{
 "PlaceInRowGraphics",
 "[",
 StyleBox["glist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Spacing"
}], "Subsubsection",
 CellChangeTimes->{{3.5345154268633947`*^9, 3.534515446189904*^9}, {
   3.534515535513707*^9, 3.534515539696197*^9}, {3.5345155748772287`*^9, 
   3.534515580973055*^9}, {3.5345160089137497`*^9, 3.5345160091842327`*^9}, {
   3.534517373798131*^9, 3.534517375182107*^9}, 3.59199416516543*^9, 
   3.591994211391139*^9, 3.591994325439146*^9, 
   3.5922097455954657`*^9},ExpressionUUID->"775defff-dab3-433c-bfd2-\
d1553a478a5f"],

Cell[TextData[{
 "PlaceInRowGraphics[",
 StyleBox["glist",
  FontSlant->"Italic"],
 "] takes a list of Graphics objects (which may be wrapped in Graphics or \
given as individual lists of Graphics elements) and places them in a single \
horizontal row inside a single Graphics object. You can accomplish something \
similar by using a GraphicsRow, but this function preserves the relative \
scale of the objects, so, for example, you can show a crease pattern and \
folded form side-by-side to the same scale. Options are:\n\tSpacing\[Rule]",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is a fraction of the average width of all the elements"
}], "Text",
 CellChangeTimes->{{3.5345154482698936`*^9, 3.534515455021204*^9}, {
   3.53451554433731*^9, 3.534515572093487*^9}, {3.534515617722479*^9, 
   3.534515686061903*^9}, {3.534515732370951*^9, 3.534515776240017*^9}, {
   3.534516047016571*^9, 3.534516061804722*^9}, 3.591994165249513*^9, 
   3.5922097456591997`*^9, {3.5922097824500628`*^9, 
   3.592209805816581*^9}},ExpressionUUID->"8cce3596-2d4a-4bee-b8c8-\
69cf1b3cc341"],

Cell["\<\
Note: you cannot use Graphics3D elements; everything must be 2D Graphics \
objects or elements.\
\>", "Text",
 CellChangeTimes->{{3.592645734293851*^9, 
  3.592645759459739*^9}},ExpressionUUID->"51c63829-1cc5-43e9-9221-\
96b7cdaef0de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Spacing", "::", "usage"}], 
   "=", "\"\<Spacing is an option to PlaceInRowGraphics that specifies the \
spacing to use between graphical objects.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591994046638342*^9, 3.5919941045415916`*^9}, 
   3.591994165280068*^9, 3.592209745696437*^9},
 CellLabel->
  "In[823]:=",ExpressionUUID->"bc3204da-93d7-4f20-8823-8d4730d90c9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PlaceInRowGraphics", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Spacing", "\[Rule]", "0.1"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.4849294137591743`*^9, 3.484929436734957*^9}, {
   3.484929533288809*^9, 3.48492953597733*^9}, {3.484929640201503*^9, 
   3.484929652385001*^9}, 3.4849301305533752`*^9, {3.4850944445480227`*^9, 
   3.485094452215688*^9}, 3.485194051941195*^9, 3.534515824507202*^9, 
   3.53451601853406*^9, 3.5919941652985888`*^9, 3.592209745936178*^9},
 CellLabel->
  "In[824]:=",ExpressionUUID->"7d3ecc96-08f8-4aaf-a144-09493d31aa61"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PlaceInRowGraphics", "[", 
   RowBox[{"glist_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sp", ",", "glist1", ",", "bbs", ",", "ctrs", ",", "wids", ",", "offs"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"Spacing", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PlaceInRowGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"glist1", "=", 
      RowBox[{"glist", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"obj_", ",", "___"}], "]"}], "\[RuleDelayed]", "obj"}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bbs", "=", 
      RowBox[{"GraphicsBoundingBox", "/@", "glist1"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"bounding", " ", "boxes"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"ctrs", "=", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"bb", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Plus", "@@", "#"}], "/", "2"}], "&"}], "/@", "bb"}]}], 
        "]"}], "/@", "bbs"}]}], ";", 
     RowBox[{"(*", " ", "centers", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"wids", "=", 
      RowBox[{"First", "/@", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"bb", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Subtract", "@@", "#"}]}], "&"}], "/@", "bb"}]}], "]"}], 
        "/@", "bbs"}]}]}], ";", " ", 
     RowBox[{"(*", " ", "widths", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{"sp", "*", 
       RowBox[{
        RowBox[{"Plus", "@@", "wids"}], "/", 
        RowBox[{"Length", "[", "wids", "]"}]}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"spacing", " ", "in", " ", "local", " ", "units"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"offs", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"FoldList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "+", "#2", "+", "sp"}], "&"}], ",", "0", ",", 
          "wids"}], "]"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"offsets", " ", "to", " ", "each", " ", "center"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FunctionTransform", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"Function", "[", 
            RowBox[{"pt", ",", 
             RowBox[{"pt", "-", "#2", "+", 
              RowBox[{"{", 
               RowBox[{"#3", ",", "0"}], "}"}]}]}], "]"}]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"glist1", ",", "ctrs", ",", "offs"}], "}"}]}], "]"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.534516065549587*^9, 3.534516099744178*^9}, {
   3.534516132030349*^9, 3.534516306274255*^9}, {3.534516346160188*^9, 
   3.534516501494499*^9}, {3.534516626478036*^9, 3.534516773127386*^9}, {
   3.534516885160182*^9, 3.534517035909047*^9}, {3.534517072480283*^9, 
   3.53451725867864*^9}, {3.591994165339012*^9, 3.5919941653692617`*^9}, {
   3.59220974618864*^9, 3.592209746438097*^9}, {3.592209858795396*^9, 
   3.592209923424494*^9}, 3.592213916147518*^9, {3.592434151655392*^9, 
   3.592434158284629*^9}, {3.592434216774793*^9, 3.592434218198203*^9}, {
   3.592434399582301*^9, 3.592434403438157*^9}, 3.62878644155018*^9, {
   3.631806488303191*^9, 3.631806500876788*^9}, {3.631806877761651*^9, 
   3.631806879645052*^9}},
 CellLabel->
  "In[825]:=",ExpressionUUID->"e88d9b0c-3e9a-49ca-b416-6e4179cfe4d5"],

Cell["Example", "Text",
 CellChangeTimes->{{3.485106911105983*^9, 
  3.485106911825919*^9}},ExpressionUUID->"1776570c-c67d-43e8-b5d5-\
48a3cfbc282c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tverts", ",", "g1", ",", "g2", ",", "g3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"3", " ", "different", " ", "sized", " ", "triangles"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tverts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g1", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", "tverts", "]"}], ",", "Red"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"g2", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "0"}], "}"}], "+", "#"}], "&"}], "/@", 
           RowBox[{"(", 
            RowBox[{"0.5", " ", "tverts"}], ")"}]}], "]"}], ",", "Green"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g3", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "+", "#"}], "&"}], "/@", 
           RowBox[{"(", 
            RowBox[{"0.2", " ", "tverts"}], ")"}]}], "]"}], ",", "Blue"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Here", "'"}], "s", " ", "what", " ", "GraphicsRow", " ", 
        "would", " ", "produce"}], ",", " ", 
       RowBox[{"rescaling", " ", "each", " ", "image"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{"g1", ",", "g2", ",", "g3"}], "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Here", "'"}], "s", " ", "the", " ", "result", " ", "of", " ", 
       "PlaceInRowGraphics"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"PlaceInRowGraphics", "[", 
      RowBox[{"{", 
       RowBox[{"g1", ",", "g2", ",", "g3"}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4851069132711773`*^9, 3.485107092347707*^9}, 
   3.485194052031032*^9, {3.485197368268456*^9, 3.485197378613424*^9}, 
   3.533505179116877*^9, {3.533505541869119*^9, 3.533505543991603*^9}, 
   3.533947251236811*^9, {3.533947298464287*^9, 3.533947472910818*^9}, {
   3.533947534684826*^9, 3.533947553985379*^9}, 3.534514784340925*^9, {
   3.53451495453787*^9, 3.534514985479548*^9}, {3.534515027618569*^9, 
   3.534515089705357*^9}, {3.534515135759632*^9, 3.534515190059135*^9}, {
   3.534515865255019*^9, 3.534516040117976*^9}, {3.53451726796632*^9, 
   3.534517342537771*^9}, {3.591994165408195*^9, 3.591994165435574*^9}, {
   3.592209746678428*^9, 3.5922097471557207`*^9}, {3.6318063164996777`*^9, 
   3.631806346683661*^9}, {3.631806444219968*^9, 3.631806477317902*^9}, {
   3.6318065368659143`*^9, 3.631806539609954*^9}},
 CellLabel->
  "In[826]:=",ExpressionUUID->"756e1398-ecb8-4493-8ecd-18716f7555fb"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Scaling, DashedLine and GapLine functions", "Subsection",
 CellChangeTimes->{{3.456529350882859*^9, 3.456529354082916*^9}, {
  3.457532449682225*^9, 
  3.4575324540951633`*^9}},ExpressionUUID->"7d374c53-13dc-46e1-8bab-\
e816035be918"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457532402253047*^9, 
  3.457532402715119*^9}},ExpressionUUID->"d4c73d69-a147-4b92-911b-\
c017938e81f3"],

Cell["\<\
These functions are used for modifying a crease pattern for exporting. \
GraphicsExtent[] (see above) and ScaleLines[] are used to scale a pattern to \
an absolute size. Then DashedLine[] and GapLine[] and related functions are \
used to convert the lines to dashes and/or to put gaps at their ends to \
prevent punch-through.\
\>", "Text",
 CellChangeTimes->{{3.457532405210868*^9, 3.45753243202496*^9}, {
   3.457532467694993*^9, 3.457532529993711*^9}, 3.59221393656832*^9, 
   3.628786495482065*^9, {3.643207834776606*^9, 
   3.643207838816262*^9}},ExpressionUUID->"4b26db2f-e382-457f-9452-\
c92006c84f5d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ScaleLines[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.457529801962467*^9, 
  3.457529803704363*^9}},ExpressionUUID->"957ebf6b-f288-4164-bb01-\
eed1e16fbe39"],

Cell[TextData[{
 "ScaleLines[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] takes the object ",
 StyleBox["exprt",
  FontSlant->"Italic"],
 " and replaces the coordinates of any points appearing within Line[] objects \
by the same coordinates scaled by a factor ",
 StyleBox["r",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.457529806825258*^9, 
  3.457529824095415*^9}},ExpressionUUID->"2a6ce27e-fd44-4107-ac7d-\
ca1593664b14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ScaleLines", "[", 
   RowBox[{"expr_", ",", "r_"}], "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{
    RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", 
    RowBox[{"Line", "[", 
     RowBox[{"x", " ", "r"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.457529813602468*^9, 3.457529817065616*^9}},
 CellLabel->
  "In[827]:=",ExpressionUUID->"d517bcb6-4698-4bfb-88e6-cd9de8c5efcb"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "LineLength[",
 StyleBox["pts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",ExpressionUUID->"9ff79de4-bfec-4a9e-97a5-f6ac8b0e6fec"],

Cell["\<\
LineLength[pts] takes a list of points and returns the length of the line \
obtained by joining all of the points.\
\>", "Text",ExpressionUUID->"a54151bc-c62b-438e-90bd-1048f5a8a7b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LineLength", "[", "pts_List", "]"}], ":=", 
   RowBox[{"0", "/;", 
    RowBox[{
     RowBox[{"Length", "[", "pts", "]"}], "<", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LineLength", "[", "pts_List", "]"}], ":=", 
  RowBox[{"Plus", "@@", 
   RowBox[{"(", 
    RowBox[{"Mag", "/@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{"pts", ",", "1"}], "]"}], "-", 
       RowBox[{"Drop", "[", 
        RowBox[{"pts", ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ")"}]}], ")"}]}]}]}], "Input",
 CellLabel->
  "In[828]:=",ExpressionUUID->"376e8cae-c59f-414f-aad1-8427b77d5e04"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DashedLine[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) DashPattern,  JustifyDashing, MinimumDashLength, \
DashCorners"
}], "Subsubsection",
 CellChangeTimes->{{3.456527584609322*^9, 3.456527602407752*^9}, {
  3.694201892444812*^9, 
  3.69420189619728*^9}},ExpressionUUID->"94354469-3fb2-43e5-b98b-\
63e203904623"],

Cell[TextData[{
 "DashedLine[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a true dashed line (i.e., a list of discrete Line objects. This \
is used when the pattern is to be exported to a format that doesn't support \
the PostScript dashing commands."
}], "Text",
 CellChangeTimes->{{3.438523515194536*^9, 3.438523542411409*^9}, {
  3.4565273398494873`*^9, 3.456527340210602*^9}, {3.456527381545959*^9, 
  3.4565274481306357`*^9}, {3.456527624470669*^9, 3.456527627558229*^9}, {
  3.694200956448545*^9, 
  3.694200977861615*^9}},ExpressionUUID->"e0e08adf-ca8f-437f-bafc-\
c42976302014"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["pts",
  FontSlant->"Italic"],
 " \[LongDash] a list of point coordinates, typically 2D, that define a \
polygonal line."
}], "Text",
 CellChangeTimes->{{3.694200982141055*^9, 3.694201000229398*^9}, {
  3.694201052949504*^9, 
  3.694201057246491*^9}},ExpressionUUID->"446dc656-ad73-4d60-8fd8-\
82cf26dc9bf7"],

Cell[TextData[{
 "Options:\n\tDashPattern \[Rule] ",
 StyleBox["pat",
  FontSlant->"Italic"],
 " where ",
 StyleBox["pat",
  FontSlant->"Italic"],
 " is a set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "1"], ",", 
       SubscriptBox["f", "1"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "2"], ",", 
       SubscriptBox["f", "2"]}], "}"}], ",", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"d76a109b-8b40-4f1f-bea1-68120ddd8a6e"],
 " giving the lengths of marks and spaces where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "i"], TraditionalForm]],ExpressionUUID->
  "c070449f-c802-4503-b576-8f33a5eb5ad5"],
 " is a distance and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "i"], TraditionalForm]],ExpressionUUID->
  "94b7343f-e2bb-4caa-88dd-24ebcb4a783f"],
 " is a flag specifying whether this is a mark (True) or space (False). The \
default value is a dashed line that is 1/3 space, 2/3 mark, and that starts \
on a space.\n\tJustifyDashing \[Rule] True | False, specifies whether to \
slightly adjust the pattern so that the pattern starts and stops on the first \
element in the pattern.\n\tMinimumDashLength \[Rule] ",
 StyleBox["len",
  FontSlant->"Italic"],
 ", sets a length ",
 StyleBox["len",
  FontSlant->"Italic"],
 " below which final dashes are dropped. Thus suppresses artifacts created by \
roundoff issues in justified dash patterns.\n\tDashCorners \[Rule] True | \
False, if True, dashes may have internal corners (giving segments below the \
minimum length). If False, all dashes are 2-point pairs and rigorously \
respect MinimumDashLength."
}], "Text",
 CellChangeTimes->{{3.694200960536295*^9, 3.6942009690776863`*^9}, 
   3.694201670405859*^9, {3.694201745595888*^9, 
   3.694201840053185*^9}},ExpressionUUID->"9c0fb9d4-8e1b-415e-b54d-\
22c44a1bb4d8"],

Cell["\<\
Returns a list of Line objects that give a dashed version of the desired line.\
\>", "Text",
 CellChangeTimes->{{3.694201016341677*^9, 
  3.694201036941761*^9}},ExpressionUUID->"c71a2af0-9aca-4c99-9673-\
472650aeffa2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DashPattern", "::", "usage"}], 
   "=", "\"\<DashPattern is an option to DashedLine that specifies the \
pattern to use for dashed lines.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5920413923500557`*^9, 3.592041421953208*^9}},
 CellLabel->
  "In[830]:=",ExpressionUUID->"95c08718-f536-43fc-a46e-b73def073398"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"JustifyDashing", "::", "usage"}], 
   "=", "\"\<JustifyDashing is an option to DashedLine that specifies whether \
to justify the dashes so that the pattern starts and stops on a full element \
of the pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5920414252253*^9, 3.592041461545753*^9}},
 CellLabel->
  "In[831]:=",ExpressionUUID->"4454535b-7fd5-40d8-a671-8acb6408fac5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MinimumDashLength", "::", "usage"}], 
   "=", "\"\<MinimumDashLength is an options to DashedLine that specifies a \
minimum dash length for final dashes.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5920414646059303`*^9, 3.592041512283939*^9}},
 CellLabel->
  "In[832]:=",ExpressionUUID->"794c9597-2a5b-4470-92e4-d7ad4cf6c6cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DashCorners", "::", "usage"}], 
   "=", "\"\<DashCorners is an option to DashedLine that specifies whether to \
include internal corners within dashes.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5920413923500557`*^9, 3.592041421953208*^9}, {
  3.694201866216011*^9, 3.694201884284852*^9}},
 CellLabel->
  "In[833]:=",ExpressionUUID->"ac398886-dbd9-4596-b8bc-276363289806"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "DashedLine", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DashPattern", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.0667", ",", "False"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.1333", ",", "True"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"JustifyDashing", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MinimumDashLength", "\[Rule]", "0.001"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DashCorners", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456527450254642*^9, 3.456527465820222*^9}, {
  3.694201843933498*^9, 3.694201852767822*^9}},
 CellLabel->
  "In[834]:=",ExpressionUUID->"a2a03ee5-9bfe-40fa-9d06-fca5dc21a453"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DashedLine", "[", 
   RowBox[{"pts_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dp", ",", "jd", ",", "mdl", ",", "dc", ",", "d1", ",", "d2", ",", "ll", 
      ",", "nd", ",", "\[Alpha]", ",", "curLinePt", ",", "pendingLinePts", ",",
       "dashPts", ",", "curDashPat", ",", "curDashNeeded", ",", "ret", ",", 
      "idash", ",", "tryadd", ",", "seg", ",", "seglen"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dp", "=", 
      RowBox[{
       RowBox[{"DashPattern", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DashedLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"jd", "=", 
      RowBox[{
       RowBox[{"JustifyDashing", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DashedLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mdl", "=", 
      RowBox[{
       RowBox[{"MinimumDashLength", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DashedLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dc", "=", 
      RowBox[{
       RowBox[{"DashCorners", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DashedLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"jd", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Adjust", " ", "the", " ", "lengths", " ", "of", " ", "the", " ", 
         "pattern"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ll", "=", 
         RowBox[{"LineLength", "[", "pts", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d1", "=", 
         RowBox[{"dp", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d2", "=", 
         RowBox[{"Plus", "@@", 
          RowBox[{"(", 
           RowBox[{"First", "/@", 
            RowBox[{"Drop", "[", 
             RowBox[{"dp", ",", "1"}], "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nd", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"ll", "-", "d1"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"d1", "+", "d2"}], ")"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"ll", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"nd", 
             RowBox[{"(", 
              RowBox[{"d1", "+", "d2"}], ")"}]}], "+", "d1"}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"dp", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Alpha]", " ", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
            "}"}], "&"}], "/@", "dp"}]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"curLinePt", "=", 
      RowBox[{"First", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pendingLinePts", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{"pts", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dashPts", "=", 
      RowBox[{"{", "curLinePt", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"curDashPat", "=", 
      RowBox[{"dp", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"curDashNeeded", "=", 
      RowBox[{
      "curDashPat", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"ret", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"idash", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "add", " ", "a", " ", "dash", " ", "to", " ", "the", " ", "collection", 
       " ", "if", " ", "long", " ", "enough"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tryadd", "[", "dpts_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{"First", "[", "dpts", "]"}], "-", 
           RowBox[{"Last", "[", "dpts", "]"}]}], "]"}], ">", "mdl"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{"dc", ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ret", ",", 
            RowBox[{"Line", "[", "dpts", "]"}]}], "]"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ret", ",", 
            RowBox[{"Line", "[", 
             RowBox[{"dpts", "\[LeftDoubleBracket]", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}], "\[RightDoubleBracket]"}], 
             "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "pendingLinePts", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"seg", "=", 
         RowBox[{
          RowBox[{"First", "[", "pendingLinePts", "]"}], "-", "curLinePt"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"seglen", "=", 
         RowBox[{"Mag", "[", "seg", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"seglen", ">", "curDashNeeded"}], ",", 
          "\[IndentingNewLine]", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "we", " ", "have", " ", "enough", " ", "to", " ", "complete", " ", 
            "the", " ", "current", " ", "dash"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"dashPts", ",", 
             RowBox[{
              RowBox[{"Last", "[", "dashPts", "]"}], "+", 
              RowBox[{"curDashNeeded", " ", "*", " ", 
               RowBox[{"seg", "/", "seglen"}]}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
             "curDashPat", "\[LeftDoubleBracket]", "2", 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{"tryadd", "[", "dashPts", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"curLinePt", "=", 
            RowBox[{"Last", "[", "dashPts", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"dashPts", "=", 
            RowBox[{"{", "curLinePt", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"idash", "+=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"curDashPat", "=", 
            RowBox[{"dp", "\[LeftDoubleBracket]", 
             RowBox[{"Mod", "[", 
              RowBox[{"idash", ",", 
               RowBox[{"Length", "[", "dp", "]"}], ",", "1"}], "]"}], 
             "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"curDashNeeded", "=", 
            RowBox[{
            "curDashPat", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"we", " ", 
            RowBox[{"don", "'"}], "t", " ", "have", " ", "enough", " ", "to", 
            " ", "complete", " ", "the", " ", "current", " ", "dash"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"curLinePt", "=", 
            RowBox[{
            "pendingLinePts", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"pendingLinePts", "=", 
            RowBox[{"Drop", "[", 
             RowBox[{"pendingLinePts", ",", "1"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"dashPts", ",", "curLinePt"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"curDashNeeded", " ", "-=", " ", "seglen"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"if", " ", 
              RowBox[{"we", "'"}], "re", " ", "out", " ", "of", " ", 
              "points"}], ",", " ", 
             RowBox[{
             "try", " ", "writing", " ", "whatever", " ", "we", " ", 
              "have"}]}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "pendingLinePts", "]"}], "\[Equal]", 
              "0"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
               "curDashPat", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}], ",", 
               RowBox[{"tryadd", "[", "dashPts", "]"}]}], "]"}]}], "]"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "ret"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.438523227944619*^9, 3.438523286429986*^9}, {
  3.438523327773205*^9, 3.438523342182094*^9}, {3.456527477304256*^9, 
  3.456527524839741*^9}, {3.594984923606982*^9, 3.5949849237388163`*^9}, {
