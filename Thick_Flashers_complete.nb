32d90b9d5223"],

Cell[CellGroupData[{

Cell["Curved fold rendering", "Subsection",
 CellChangeTimes->{{3.7994850584379396`*^9, 3.799485062896638*^9}, {
  3.799525094784444*^9, 3.799525096615571*^9}, {3.799525222472355*^9, 
