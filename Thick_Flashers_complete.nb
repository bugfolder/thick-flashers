   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "\[Infinity]"}], ",", 
     RowBox[{"-", "1"}], ",", "0", ",", "1", ",", "\[Infinity]"}], "}"}], 
   "]"}], "//", "ShowExample"}]], "Input",
