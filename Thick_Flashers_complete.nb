 RowBox[{
  RowBox[{"UnitTrapezoidOffsetTwistOffset", "[", 
   RowBox[{
    RowBox[{"70", "\[Degree]"}], ",", ".2", ",", 
    RowBox[{"138", "\[Degree]"}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629402145811607*^9, 3.6294021886558237`*^9}},
 CellLabel->
  "In[3054]:=",ExpressionUUID->"ce88b060-563c-425b-863f-8960257df740"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "UnitTrapezoidOffsetShrinkage[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "]\nUnitTrapezoidOffsetRotation[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629401753941127*^9, 3.629401758906954*^9}, {
  3.6294018353324337`*^9, 
  3.629401842363809*^9}},ExpressionUUID->"6ee39d03-7277-4aab-b6f0-\
d43caf0f3dd1"],

Cell[TextData[{
 "UnitTrapezoidOffsetShrinkage[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "] returns the shrinkage factor for the central polygon."
}], "Text",
 CellChangeTimes->{{3.629401765983986*^9, 
  3.629401780903846*^9}},ExpressionUUID->"37bdb322-0158-4556-91d7-\
dd8a82c49aeb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTrapezoidOffsetShrinkage", "[", 
   RowBox[{"\[Delta]_", ",", " ", "w_", ",", " ", "d_"}], "]"}], ":=", 
  FractionBox[
   SqrtBox[
    RowBox[{
     SuperscriptBox["w", "2"], "+", 
     RowBox[{"2", " ", 
      SuperscriptBox["d", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Delta]"}], "]"}]}], ")"}], " "}]}]], 
   RowBox[{"Sin", "[", "\[Delta]", "]"}]]}]], "Input",
 CellChangeTimes->{{3.629401783021425*^9, 3.629401817207175*^9}},
 CellLabel->
  "In[3055]:=",ExpressionUUID->"13ac1275-2b29-47ea-bfa3-f994752d9719"],

Cell[TextData[{
 "UnitTrapezoidOffsetRotation[\[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 "] returns the angle through which the central polygon is rotated relative \
to the original polygon."
}], "Text",
 CellChangeTimes->{{3.629401862225402*^9, 3.62940188498506*^9}, {
  3.629978744038599*^9, 
  3.6299787446184196`*^9}},ExpressionUUID->"23d5fef7-7f3f-48e7-b26a-\
6ec80ebd5870"],

Cell["\<\
Although the rotation angle is given by the twist angle, there\
\[CloseCurlyQuote]s no discontuity in this one, owing to the different \
definitions of twist angle \[Alpha]\[Element](0,\[Pi]) and rotation angle \
\[Beta]\[Element](-\[Pi]/2,\[Pi]/2).\
\>", "Text",
 CellChangeTimes->{{3.629402581654072*^9, 3.629402620778078*^9}, {
  3.629978761633406*^9, 3.629978771513084*^9}, {3.6299788032551928`*^9, 
  3.629978843020236*^9}},ExpressionUUID->"f5e79fa2-6ff1-4881-bf38-\
08f9dbd2d654"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnitTrapezoidOffsetRotation", "[", 
   RowBox[{"\[Delta]_", ",", " ", 
    StyleBox["w_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["d_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"ArcCot", "[", 
   FractionBox[
    RowBox[{
     SqrtBox["2"], " ", "d", " ", 
     SqrtBox[
      RowBox[{"3", "+", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Delta]"}], "]"}]}]], " ", 
     RowBox[{"Csc", "[", "\[Delta]", "]"}]}], "w"], "]"}]}]], "Input",
 CellChangeTimes->{{3.629401859040119*^9, 3.629401859057659*^9}, {
   3.629401896713874*^9, 3.629401939660687*^9}, 3.6294025155440187`*^9},
 CellLabel->
  "In[3056]:=",ExpressionUUID->"f7213d94-b687-4d97-8132-48337a51b891"],

Cell["Example, a CCW twist.", "Text",
 CellChangeTimes->{{3.6294019533982067`*^9, 3.629401954124824*^9}, {
  3.629402099859791*^9, 
  3.629402102019241*^9}},ExpressionUUID->"35a8b20c-4298-4f80-be81-\
b86ec68e7ae7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitTrapezoidOffsetRotation", "[", 
    RowBox[{
     RowBox[{"70", "\[Degree]"}], ",", ".2", ",", ".1"}], "]"}], "/", 
   "\[Degree]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629401958518027*^9, 3.629402006647528*^9}, 
   3.629402575217642*^9},
 CellLabel->
  "In[3057]:=",ExpressionUUID->"fbf06ca2-8f2e-424c-b3ff-09601d2eaec2"],

Cell["Example, a CW twist.", "Text",
 CellChangeTimes->{{3.6294021046005373`*^9, 
  3.629402109650685*^9}},ExpressionUUID->"0314ec3d-6a8b-4629-9a54-\
258d948bd223"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitTrapezoidOffsetRotation", "[", 
    RowBox[{
     RowBox[{"70", "\[Degree]"}], ",", ".2", ",", 
     RowBox[{"-", ".1"}]}], "]"}], "/", "\[Degree]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629401958518027*^9, 3.629402014594428*^9}, 
   3.629402576121311*^9},
 CellLabel->
  "In[3058]:=",ExpressionUUID->"6dd1da62-eda4-4e4f-bbef-decbf07b9891"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Unit symmetric trapezoid offset twist tiles [deprecated]", "Subsection",
 CellChangeTimes->{{3.629851164571972*^9, 3.629851169457413*^9}, 
   3.629910864895643*^9, {3.629910973499425*^9, 3.629910974620001*^9}, {
   3.633537675436609*^9, 
   3.633537679028025*^9}},ExpressionUUID->"d34f7785-a041-4eb0-94b7-\
b47d44b32b63"],

Cell[CellGroupData[{

Cell[TextData[{
 "{",
 "UnitSymmetricTrapezoidOffsetTwistTile",
 ", \[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.62985117450616*^9, 3.6298511830649033`*^9}, 
   3.629898769262853*^9, 3.629898804164159*^9, 3.629910890767619*^9, 
   3.629910926678442*^9, 
   3.629910986303048*^9},ExpressionUUID->"1f7b72ba-e21c-4d2f-981d-\
86418427836e"],

Cell[TextData[{
 "{UnitSymmetricTrapezoidOffsetTwistTile, \[Delta], ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} represents an offset twist in a symmetric unit trapezoid with base angle \
\[Delta] where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of the pleat where it subtends the edge, ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the offset, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley. The diagonal side length is set to be the \
unique value that gives a flat-foldable offset twist tile."
}], "Text",
