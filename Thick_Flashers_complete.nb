              RowBox[{"EdgeColor", "\[Rule]", "Blue"}], ",", 
              RowBox[{"VertexLabels", "\[Rule]", "None"}]}], "]"}]}], "]"}]}],
          "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
