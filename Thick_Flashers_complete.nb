Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakePlanarRoundedPlateGC", "::", "badpoly"}], 
   "=", "\"\<Polygon `1` is not a planar convex polygon.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.459038705087113*^9, 3.459038736843808*^9}, 
   3.70840120208436*^9, 3.708411616819068*^9, 3.708570157072053*^9, 
   3.708570254287504*^9, 3.708601722162296*^9},
 CellLabel->
  "In[4263]:=",ExpressionUUID->"4e7e2b78-f61e-4897-815b-ccc9bfa2bd9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePlanarRoundedPlateGC", "[", 
   RowBox[{"poly_", ",", " ", "r_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nd", ",", "np", ",", "z", ",", "verts", ",", "faces", ",", "cfn", ",", 
      "bfn", ",", "xp", ",", "xn", ",", "wp", ",", "wn", ",", "ba", ",", 
      "strt", ",", "na", ",", "da", ",", "vi"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"Polygon3DPlanarAndConvexQ", "[", "poly", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakePlanarRoundedPlateGC", "::", "badpoly"}], ",", 
          "poly"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nd", "=", 
      RowBox[{
       RowBox[{"RoundingDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakePlanarRoundedPlateGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"np", "=", 
      RowBox[{"Length", "[", "poly", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"np", "<", "3"}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
          RowBox[{"poly", "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ")"}], "\[Cross]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"faces", "=", 
       RowBox[{"{", "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"cylindrical", " ", "position", " ", "function"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cfn", "[", 
       RowBox[{"w_", ",", "i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"poly", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
        "+", 
       RowBox[{"r", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"z", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"j", " ", 
             RowBox[{"\[Pi]", "/", "nd"}]}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"w", "[", "i", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"j", " ", 
             RowBox[{"\[Pi]", "/", "nd"}]}], "]"}]}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"bend", " ", "position", " ", "function"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bfn", "[", 
       RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]", "=", 
           RowBox[{"j", " ", 
            RowBox[{"\[Pi]", "/", "nd"}]}]}], ",", 
          RowBox[{"\[Phi]", "=", 
           RowBox[{"k", " ", 
            RowBox[{"da", "[", "i", "]"}]}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
