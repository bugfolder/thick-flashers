Cell[TextData[{
 "SingleVertexEdgeAngles2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "] returns the sector angles around the vertex whose index is ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", rotated so that the first face angle returned lies between edge {",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i1",
  FontSlant->"Italic"],
 "} and the next CCW edge. Same as SingleVertexEdgeAngles, but calculated \
from the Vertices2D data."
}], "Text",
