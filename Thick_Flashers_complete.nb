Cell["\<\
Example. A polyhedron with two improperly oriented faces, and then the \
properly oriented version.\
\>", "Text",
 CellChangeTimes->{{3.911976654518157*^9, 3.911976655520856*^9}, {
  3.911976878886866*^9, 3.911976887928025*^9}, {3.914837523179264*^9, 
  3.914837529094658*^9}},ExpressionUUID->"8f53614a-1a53-4610-85c0-\
c75164f40340"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "gc", ",", "gc1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc", "=", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{"pts", ",", 
        RowBox[{"Polygon", "/@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "4", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "4"}], "}"}]}], "}"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"gc1", "=", 
      RowBox[{"OrientPolygonsSimpleGC", "[", "gc", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"Style", "[", 
          RowBox[{"gc", ",", "SolidStyle"}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"Style", "[", 
          RowBox[{"gc1", ",", "SolidStyle"}], "]"}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.911976656907834*^9, 3.911976870890567*^9}, {
   3.911976954942535*^9, 3.911976961735987*^9}, {3.911978865650931*^9, 
