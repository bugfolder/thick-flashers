  3.701716854328504*^9}, {3.701716896680756*^9, 3.701716900031999*^9}, {
  3.701717064665735*^9, 3.701717069497434*^9}},
 CellLabel->
  "In[2371]:=",ExpressionUUID->"af248577-cf3d-41f3-801d-227799a561c2"],

Cell[TextData[{
 "MakeFlatFoldedStrip[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a TGraph2D+TAssigned that represents a flat-folded rectangular \
strip that follows a specified path in the x-y plane."
}], "Text",
 CellChangeTimes->{{3.701643887661404*^9, 3.701643938165881*^9}, {
  3.701648237621085*^9, 3.701648238099622*^9}, {3.7017159184069977`*^9, 
  3.70171592493563*^9}, {3.701717134059268*^9, 
  3.701717186610353*^9}},ExpressionUUID->"cd7e5796-fccd-40bc-b331-\
24e185247284"],

Cell["\<\
That is, you can get a rectangular strip by just passing the width directly, \
rather than the list pair {w, \[Phi]}.\
\>", "Text",
 CellChangeTimes->{{3.701717220747117*^9, 
  3.701717246171183*^9}},ExpressionUUID->"93106645-020a-4d9f-bfc7-\
c6ec2808c02c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFlatFoldedStrip", "[", 
   RowBox[{"pts_List", ",", "w_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"MakeFlatFoldedStrip", "[", 
   RowBox[{"pts", ",", 
    RowBox[{"{", 
     RowBox[{"w", ",", "0"}], "}"}], ",", "opts"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.701717189453358*^9, 3.701717214498417*^9}},
 CellLabel->
  "In[2372]:=",ExpressionUUID->"ed29edb6-9d52-495b-9a8a-64a261b9d6ab"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeTroublewitStrip[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dists",
  FontSlant->"Italic"],
 ", ",
 StyleBox["angles",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.701857062835368*^9, 3.701857083872559*^9}, 
   3.70185729826406*^9, {3.70185750622196*^9, 3.701857573032309*^9}, {
   3.701874973307516*^9, 
   3.701874995348407*^9}},ExpressionUUID->"574f6719-3b7d-4b0b-be1a-\
5aa33aa23d22"],

Cell[TextData[{
 "MakeTroublewitStrip[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dists",
  FontSlant->"Italic"],
 ", ",
 StyleBox["angles",
  FontSlant->"Italic"],
 "] creates a flat-folded rectangular strip such as that used in the magic \
routine \[OpenCurlyDoubleQuote]Troublewit.\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.701857091222335*^9, 3.701857098286357*^9}, {
   3.701857157731808*^9, 3.701857177964398*^9}, {3.701857282283324*^9, 
   3.7018572892288923`*^9}, 3.701857411419504*^9, 3.701857576091017*^9, {
   3.7018749999747353`*^9, 3.7018750190217333`*^9}, 
   3.7018751122055798`*^9},ExpressionUUID->"c317a347-4167-4219-bf93-\
f313b2671eee"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the initial point in the x-y plane.\n\t",
 StyleBox["dists",
  FontSlant->"Italic"],
 " \[LongDash] a list of lengths for each of the pleated segments.\n\t",
 StyleBox["angles",
  FontSlant->"Italic"],
 " \[LongDash] a list of angles that defines the shape; each angle is the \
absolute direction angle for its corresponding segment."
}], "Text",
 CellChangeTimes->{{3.701857291079889*^9, 3.7018573441599617`*^9}, {
  3.701857578349253*^9, 3.701857602763411*^9}, {3.701857977824358*^9, 
  3.701858001881587*^9}, {3.701875021964164*^9, 
  3.7018750342654133`*^9}},ExpressionUUID->"ae84cb1d-4afb-4679-93a5-\
5ecd15e215a5"],

Cell["Returns: A flat-folded strip with that shape.", "Text",
 CellChangeTimes->{{3.701857353386432*^9, 3.701857406099894*^9}, 
   3.701860207356653*^9, {3.701875046007665*^9, 
   3.70187504629646*^9}},ExpressionUUID->"eac76327-47ad-4e0b-bec3-\
4c78b8ecff62"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTroublewitStrip", "::", "badlists"}], 
   "=", "\"\<The distances `1` and angles `2` must have the sam number of \
entries.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701857628028825*^9, 3.701857659663146*^9}, 
   3.7018579743154287`*^9, 3.701874973321504*^9, {3.701875057427494*^9, 
   3.70187508026243*^9}},
 CellLabel->
  "In[2373]:=",ExpressionUUID->"59da6b2f-f6aa-44a5-b009-887e2fd94ab9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTroublewitStrip", "[", 
   RowBox[{"p_List", ",", "dists_List", ",", "angles_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rr", ",", "pts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "dists", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "angles", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTroublewitStrip", "::", "badlists"}], ",", "dists", ",",
           "angles"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"rr", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", 
          RowBox[{"U", "[", "#2", "]"}]}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"dists", ",", "angles"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "p", ",", "rr"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeFlatFoldedStrip", "[", 
      RowBox[{"pts", ",", "1"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.701857425605654*^9, 3.701857463431346*^9}, {
   3.701857609456036*^9, 3.701857610052944*^9}, {3.701857666458133*^9, 
   3.7018578174054*^9}, {3.701857960332904*^9, 3.70185796111094*^9}, {
   3.701858051021806*^9, 3.701858075230483*^9}, {3.701866436558881*^9, 
   3.701866439907541*^9}, 3.701866693447228*^9, {3.701874973341934*^9, 
   3.701874973357949*^9}, {3.701875081514084*^9, 3.70187509996222*^9}, {
   3.70187531929033*^9, 3.701875329030745*^9}},
 CellLabel->
  "In[2374]:=",ExpressionUUID->"1f3d93ee-47bb-480f-9c39-4262f5a5c1e4"],

