Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]", ",", "dh", ",", "dv", ",", "nh", ",", "nv", ",", "\[Gamma]", 
      ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"60.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dh", ",", "dv"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nh", ",", "nv"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"6", ",", "4"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{
       RowBox[{"-", "90"}], "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeMiuraOri", "[", 
       RowBox[{"\[Alpha]", ",", 
        RowBox[{"{", 
         RowBox[{"dh", ",", "dv"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"nh", ",", "nv"}], "}"}], ",", 
        RowBox[{"MajorFoldAngle", "\[Rule]", "\[Gamma]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"VertexRotateGraph3D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"tobj", "[", "CornerIndices", "]"}], "]"}], ",", "3"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.703599210319433*^9, 3.703599260671163*^9}, {
   3.703599809715828*^9, 3.703599812795555*^9}, {3.703599847685956*^9, 
   3.703599879099533*^9}, {3.703600812654066*^9, 3.703600817716402*^9}, {
   3.70360088563017*^9, 3.703600916982089*^9}, {3.7036010205598297`*^9, 
   3.703601021894918*^9}, {3.703601089257295*^9, 3.703601106983637*^9}, {
   3.703601148473628*^9, 3.703601167136632*^9}, {3.703601230650001*^9, 
   3.703601232576211*^9}, 3.7036065391290693`*^9, 3.703606650817651*^9},
 CellLabel->
