     RowBox[{"ArrowPosition", "\[Rule]", "0.5"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"ArrowheadStyle", "\[Rule]", 
      RowBox[{"Arrowheads", "[", "Automatic", "]"}]}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
