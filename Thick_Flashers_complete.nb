Cell[TextData[{
 "StyledSurfaceNormalGrid[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
