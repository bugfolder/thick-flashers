Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "q", ",", "r", ",", "s", ",", "qt", ",", "rt", ",",
       "st", ",", "t"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", ".1", ",", ".1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"{", 
       RowBox[{".9", ",", ".8", ",", ".2"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{".7", ",", ".2", ",", ".6"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{".5", ",", ".2", ",", 
        RowBox[{"-", ".6"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qt", ",", "rt", ",", "st"}], "}"}], "=", 
      RowBox[{"BarycentricIntersection3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "r", ",", "s"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Barycentric coordinates: \>\"", ",", 
       RowBox[{"{", 
        RowBox[{"qt", ",", "rt", ",", "st"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{
       RowBox[{"qt", " ", "q"}], " ", "+", " ", 
       RowBox[{"rt", " ", "r"}], " ", "+", " ", 
       RowBox[{"st", " ", "s"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{"q", ",", "r", ",", "s"}], "}"}], "]"}], ",", 
           RowBox[{"Opacity", "[", ".25", "]"}], ",", "Gray"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "q", "]"}], ",", "Red", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "r", "]"}], ",", "Green", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "s", "]"}], ",", "Blue", ",", 
           RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Point", "[", "p1", "]"}], ",", 
             RowBox[{"Point", "[", "p2", "]"}]}], "}"}], ",", "Black", ",", 
           RowBox[{"PointSize", "[", ".015", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", "LightGray"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "t", "]"}], ",", "Orange", ",", 
           RowBox[{"PointSize", "[", ".025", "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.726093867413413*^9, 3.72609412707271*^9}, {
   3.72609421713961*^9, 3.726094271249908*^9}, {3.726094658829914*^9, 
