   3.800226117349154*^9}},ExpressionUUID->"9215e75c-4244-4d2d-85c1-\
7183b18d251c"],

Cell["\<\
Note that if the desired curves do not have the same curve speed, you should \
reparametrize one of them so that they do.\
\>", "Text",
 CellChangeTimes->{{3.799416909773591*^9, 3.799416935509875*^9}, {
  3.800227049582425*^9, 
  3.800227050725853*^9}},ExpressionUUID->"cbadda5c-948b-4cba-b2db-\
1e28154c7aa3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NMatchCurvesPair", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.799417799304605*^9, 3.799417808846001*^9}, 
   3.799418917097124*^9, 3.800226894638526*^9, 3.800227067182946*^9, 
