Cell[TextData[{
 "TwoUniformName",
 "[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns a string version of the name of the tiling, based on its vertex \
type."
}], "Text",
 CellChangeTimes->{{3.631272414329866*^9, 3.631272435992108*^9}, {
   3.631282286075777*^9, 3.6312822900880423`*^9}, 
   3.631309902190813*^9},ExpressionUUID->"7a75a84a-dfcb-450a-958a-\
40ce986cf346"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoUniformName", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "vnames", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vnames", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"StringJoin", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{
           RowBox[{"ToString", "/@", "#"}], ",", "\"\<.\>\""}], "]"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"TwoUniformVertexTypes", "[", "n", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<(\>\"", ",", 
       RowBox[{"Riffle", "[", 
        RowBox[{
         RowBox[{"ToString", "/@", "vnames"}], ",", "\"\<; \>\""}], "]"}], 
       ",", "\"\<)\>\""}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.631272620059282*^9, 3.631272667017975*^9}, {
   3.631272700400528*^9, 3.631272715049034*^9}, {3.631272764507691*^9, 
