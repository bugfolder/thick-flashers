Cell[CellGroupData[{

Cell[TextData[{
 "StyledCurvedFoldOptical[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", {",
 StyleBox["cl, cr",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["bl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["br",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FoldLineStyle, DirectrixLeftStyle, DirectrixRightStyle, \
DirectrixLeftPointStyle, DirectrixRightPointStyle, CrossCurveLeftStyle, \
CrossCurveRightStyle, RulingLineLeftStyle, RulingLineRightStyle, \
VirtualLineLeftStyle, VirtualLineRightStyle, CurveDivisions, \
RulingLineDivisions, FillStyle, SurfaceOrientation"
}], "Subsubsection",
 CellChangeTimes->{{3.597676015766321*^9, 3.597676063106683*^9}, {
