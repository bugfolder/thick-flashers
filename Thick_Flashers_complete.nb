Cell[CellGroupData[{

Cell[TextData[{
 "QuadFlatFoldEnergy[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.70127889098813*^9, 3.701278904931203*^9}, 
   3.702581521389673*^9, 3.702665279296454*^9, 
   3.702666954063758*^9},ExpressionUUID->"8ed022e2-b9b4-43b4-ae41-\
87b253289b8f"],

Cell[TextData[{
 "QuadFlatFoldEnergy[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "] returns a function that gives a fold energy for a quad that is ideally \
flat-folded along the ",
 StyleBox["p1",
  FontSlant->"Italic"],
 "-",
 StyleBox["p3",
  FontSlant->"Italic"],
 " diagonal. It is a minimum at flat-folded and maximum at unfolded. Note, \
though, that it does not distinguish between mountain- and \
valley-flat-folded. Use a quad fold angle constraint (above) to force one or \
the other."
}], "Text",
 CellChangeTimes->{{3.70127952692877*^9, 3.701279583465103*^9}, {
  3.701279623952551*^9, 3.7012796563859587`*^9}, {3.702581521409163*^9, 
  3.702581598062126*^9}, {3.702582086604574*^9, 
  3.702582104773093*^9}},ExpressionUUID->"3ea4bb9c-8302-4b52-9609-\
7f25844bb042"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 " \[LongDash] the coordinates of the vertices, in CCW order. ",
 StyleBox["p1",
  FontSlant->"Italic"],
 "-",
 StyleBox["p3",
  FontSlant->"Italic"],
 " is the folded edge."
}], "Text",
 CellChangeTimes->{{3.702666960046235*^9, 
  3.702666990518209*^9}},ExpressionUUID->"5f2c1662-7d32-4264-b766-\
cff3ac7706fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuadFlatFoldEnergy", "[", 
   RowBox[{"p_List", ",", "q_List", ",", "r_List", ",", "s_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qp", ",", "rp", ",", "sp", ",", "cos"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qp", ",", "rp", ",", "sp"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"q", "-", "p"}], ",", 
        RowBox[{"r", "-", "p"}], ",", 
        RowBox[{"s", "-", "p"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cos", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qp", "\[Cross]", "rp"}], ")"}], ".", 
        RowBox[{"(", 
         RowBox[{"rp", "\[Cross]", "sp"}], ")"}]}], 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"(", 
          RowBox[{"qp", "\[Cross]", "rp"}], ")"}], "]"}], 
        RowBox[{"Mag", "[", 
         RowBox[{"(", 
          RowBox[{"rp", "\[Cross]", "sp"}], ")"}], "]"}]}]]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"cosine", " ", "of", " ", "fold", " ", "angle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Mag", "[", "rp", "]"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "cos"}], ")"}], "/", "2"}]}]}]}], "]"}]}]], "Input",\

