Cell[TextData[{
 "Returns a list {b, ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 "} giving the ruled parameterization in 2D and 3D."
}], "Text",
 CellChangeTimes->{{3.691254178053851*^9, 3.691254193095383*^9}, {
