       RowBox[{"tobj", ",", 
        RowBox[{"TypeToFlatFoldAngle", "[", "pgtypes", "]"}], ",", 
        RowBox[{"StationaryFace", "\[Rule]", "4"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eo", "=", 
      RowBox[{"EdgeOverlaps2D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "eo", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", 
