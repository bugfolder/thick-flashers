Cell[CellGroupData[{

Cell["3D spherical vertices", "Section",
 CellChangeTimes->{{3.5336521043006263`*^9, 3.533652106350292*^9}, 
   3.533655072016509*^9, {3.533658354984626*^9, 3.533658362007992*^9}, {
