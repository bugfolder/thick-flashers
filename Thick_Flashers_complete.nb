Cell[BoxData[
 RowBox[{
  RowBox[{"NReshapeCone3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b_Function", "|", "b_InterpolatingFunction"}], ",", 
      RowBox[{"d_Function", "|", "d_InterpolatingFunction"}], ",", 
      "\[Sigma]_"}], "}"}], ",", "\[Beta]_Function", ",", "\[Psi]_", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bbi_List", ",", "ddi_List", ",", "uui_List"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "fiopts", ",", "\[IndentingNewLine]", "s", ",", "ds", ",",
       "t", ",", "l", ",", "u", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", 
      "sd\[Tau]g", ",", "lli", ",", "tti", ",", "tt", ",", "ll", ",", "uu", ",",
       "bb", ",", "dd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fiopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"curve", " ", "speed"}], ",", " ", 
       RowBox[{
        RowBox[{"can", " ", "be", " ", "unit"}], "-", "speed"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", "\[Sigma]"}], " ", "\[Psi]", " ", 
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{"d", "'"}], "[", "s", "]"}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n", "=", "\[Beta]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "remaining", " ", "initial", " ", "conditions", " ", "of", " ", 
       "Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"lli", "=", 
      RowBox[{"\[Sigma]", " ", "ddi"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tti", "=", 
      RowBox[{"lli", "\[Cross]", "uui"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "the", " ", "new", " ", "Darboux", " ", "frame"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "tt", ",", "ll", ",", "uu"}], "}"}], "=", 
      RowBox[{"NRecoverDarboux3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ds", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", "sd\[Tau]g"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "tti", ",", "lli", ",", "uui"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rotate", " ", "to", " ", "get", " ", "the", " ", "new", " ", 
       "director"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", " ", 
         RowBox[{"ll", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "discard", " ", "the", " ", "cross", " ", "curve", " ", "we", " ", 
       "calculated", " ", "and", " ", "replace", " ", "with", " ", "cone", " ",
        "point"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"bbi", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "return", " ", "the", " ", "new", " ", "cone", " ", 
       "parameterization"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}]}]}], "]"}]}]], "Input",\

