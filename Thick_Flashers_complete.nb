442880fe8f7a"],

Cell[BoxData[
 RowBox[{"IntervalSetCleanup", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", ".4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{".5", ",", ".5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{".6", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "]"}]], "Input",
