Cell[CellGroupData[{

Cell["Example plots", "Subsubsection",
 CellChangeTimes->{{3.917280047274761*^9, 
  3.917280049266526*^9}},ExpressionUUID->"b093f60a-0551-4865-9dd5-\
7ed95c6db03e"],

Cell["\<\
Create a 3D plot of the developability excess by superimposing cylinders on a \
projection of the DP where the cylinder height (depth) is proportional to the \
excess (deficit). Green is an excess (hyperbolic vertex); red is deficiency \
(conical vertex). Adjust the x-y scaling and cylinder size for best \
aesthetics.\
\>", "Text",
 CellChangeTimes->{{3.913481026553933*^9, 3.913481071982993*^9}, {
  3.913482510419845*^9, 3.913482529837948*^9}, {3.91355259625963*^9, 
  3.913552613762529*^9}, {3.913552699772176*^9, 
  3.913552725373136*^9}},ExpressionUUID->"10fa8690-053b-4e59-b5f1-\
ed4e01e4ca21"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "tobj", ",", "tobjdp", ",", "ffg", ",", 
     "scale", ",", "cdir", ",", "bkgnd", ",", "devex", ",", "vertsdp"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ffg", "=", 
     RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "scaling", " ", "factor", " ", "for", " ", "horizontal", " ", 
      "distances"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"scale", "=", 
     RowBox[{"3.0", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"cylinder", " ", "diameter"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"cdir", "=", "0.1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Background", " ", 
      RowBox[{"image", ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "z"}], "-", 
        RowBox[{
        "projection", " ", "of", " ", "the", " ", "deployed", " ", 
         "form"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"bkgnd", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"ffg", ",", "_Line", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "/.", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", 
           RowBox[{"Line", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"scale", "#"}], "&"}], "/@", "pts"}], "]"}]}]}], ",", 
         "Gray"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"ffg", ",", "_Polygon", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "/.", 
          RowBox[{
           RowBox[{"Polygon", "[", "pts_", "]"}], ":>", 
           RowBox[{"Polygon", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"scale", "#"}], "&"}], "/@", "pts"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"Black", ",", 
           RowBox[{"Opacity", "[", "0.05", "]"}]}], "}"}]}], "]"}]}], "}"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Developability", " ", "excess", " ", "in", " ", "degrees", " ", "for", " ",
       "each", " ", "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"devex", "=", 
     RowBox[{
      RowBox[{"ThickFlasherDevelopabilityExcess", "[", "tobjdp", "]"}], "/", 
      "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"vertsdp", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"scale", "#"}], "&"}], "/@", 
      RowBox[{"tobjdp", "[", "Vertices3D", "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"bkgnd", ",", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Cylinder", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "vertsdp", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "+", "#"}], "&"}], "/@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "0", ",", 
                    RowBox[{
                    "devex", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}]}], "}"}]}], "}"}]}], ",", 
                "cdir"}], "]"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "devex", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}], ">", "0"}], ",", "Green", ",", 
                "Red"}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Sphere", "[", 
               RowBox[{
                RowBox[{
                "vertsdp", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}], ",", "cdir"}], "]"}], ",", 
              "Black"}], "]"}]}], "}"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "devex", "]"}]}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}], ",", 
      RowBox[{"Axes", "->", "True"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.555852580447597*^9, 3.555852714790588*^9}, {
   3.555853087345189*^9, 3.555853147524287*^9}, {3.555853182193297*^9, 
   3.555853235661175*^9}, {3.555853435496076*^9, 3.555853458285693*^9}, {
