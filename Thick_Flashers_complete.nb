Cell[TextData[{
 "ReplaceProperties[",
 StyleBox["rules",
  FontSlant->"Italic"],
 "] returns a pure function that replaces the properties in its argument with \
",
 StyleBox["rules",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.592708157085576*^9, 
  3.592708183499865*^9}},ExpressionUUID->"003ad372-1f68-4349-baac-\
31c81446132d"],

