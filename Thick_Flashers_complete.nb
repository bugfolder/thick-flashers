   3.643238129633553*^9},ExpressionUUID->"25669cd5-a24c-4252-9109-\
c027af6c2b25"],

Cell["\<\
TCornerIndices is a TObj that represents a graph with a crease assignment on \
its edges.\
\>", "Text",
 CellChangeTimes->{{3.592421860184583*^9, 3.592421900990152*^9}, 
   3.592435749830248*^9, 3.592435861196151*^9, {3.592486829314992*^9, 
   3.592486903062065*^9}, {3.592487192017849*^9, 3.592487199304877*^9}, 
   3.5928288620759706`*^9, 
   3.643238129665086*^9},ExpressionUUID->"8c2ea647-ff48-4e2c-a65f-\
535f6ca1e51d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TCornerIndices", "::", "usage"}], 
   "=", "\"\<TCornerIndices is a TObj class that specifies a mesh of vertices \
that is arranged roughly rectangularly.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592438990875565*^9, 3.592438997072279*^9}, {
  3.592829322730996*^9, 3.5928293227554483`*^9}, {3.594987088152017*^9, 
  3.594987088175023*^9}, {3.594991766471226*^9, 3.594991785387409*^9}, {
