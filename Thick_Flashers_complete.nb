Cell["\<\
Example. Superimpose the original function and our extrapolation.\
\>", "Text",
 CellChangeTimes->{{3.805918003382187*^9, 3.80591804111045*^9}, {
  3.806001934485141*^9, 3.806001948188779*^9}, {3.806002079517931*^9, 
