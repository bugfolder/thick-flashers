138f3da2beb0"],

Cell[TextData[{
 "NMatchCurvesPair[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cc",
  FontSlant->"Italic"],
 ", \[Psi], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 2D curve and a space curve and creates a description of the 2D \
and 3D forms of one of the two developable surface that matches both curves (\
\[OpenCurlyDoubleQuote]gluing a 2D curve to a space curve\
\[CloseCurlyDoubleQuote])."
}], "Text",
 CellChangeTimes->{{3.688069465358034*^9, 3.688069498336182*^9}, {
   3.688069714287931*^9, 3.688069718383215*^9}, {3.688069856154915*^9, 
   3.688069942784526*^9}, {3.688070263196209*^9, 3.688070272075012*^9}, {
   3.688073205014867*^9, 3.688073275522066*^9}, {3.688138768032097*^9, 
