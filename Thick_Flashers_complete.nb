  3.689250954260515*^9}},ExpressionUUID->"36c85ea9-1ea9-434e-8023-\
99a32a4950be"],

Cell[TextData[{
 "Rotate3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "] rotates the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " through angle \[Phi] about an axis emanating from the origin in direction ",
 StyleBox["w",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{
  3.689250674501274*^9, {3.68925072588398*^9, 3.6892507813912687`*^9}, {
   3.689250835653847*^9, 3.689250837209165*^9}, {3.689250918209992*^9, 
   3.689250957619546*^9}, {3.689251017256605*^9, 
   3.689251028966391*^9}},ExpressionUUID->"9a884d34-8736-483e-9072-\
644124a0a710"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rotate3D", "[", 
   RowBox[{"p_List", ",", "\[Phi]_", ",", "w_List"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"RotationMatrix3D", "[", 
    RowBox[{"\[Phi]", ",", "w"}], "]"}], ".", 
   RowBox[{"(", "p", ")"}]}]}]], "Input",
 CellChangeTimes->{{3.689250785451035*^9, 3.689250801396055*^9}, {
  3.6892509399240303`*^9, 3.68925094880774*^9}, {3.689250985395392*^9, 
