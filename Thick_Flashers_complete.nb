      ".5", ",", "1.0", ",", "5.0", ",", ".5", ",", "1.0", ",", "2.2"}], 
      "}"}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.775841915850443*^9, 3.775841976072956*^9}},
 CellLabel->
