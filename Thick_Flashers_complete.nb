Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]", ",", "bb", ",", "dd", ",", "pm", ",", "pcf3ds", ",", 
      "cclist", ",", "b", ",", "d", ",", "t", ",", "clist", ",", "u0", ",", 
      "u1", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pm", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
          RowBox[{
           RowBox[{"RotationXMatrix3D", "[", 
            RowBox[{"10.", "\[Degree]"}], "]"}], ".", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "3"}], "}"}], ",", 
          RowBox[{
           RowBox[{"RotationYMatrix3D", "[", 
            RowBox[{"10.", "\[Degree]"}], "]"}], ".", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pcf3ds", "=", 
      RowBox[{"PlanarCurvedFold3DSequence", "[", 
       RowBox[{"bb", ",", "dd", ",", "pm", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cclist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "pcf3ds"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "we", " ", "know", " ", "what", " ", "the", " ", "2", "D", " ", 
        "ruled", " ", "parameterization", " ", "is"}], ",", " ", 
       RowBox[{"so", " ", "can", " ", "build", " ", "the", " ", "CP"}], ",", 
       " ", "too"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"#", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}], ",", 
         RowBox[{"Sin", "[", 
          RowBox[{"#", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], "}"}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"clist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Functionize", "[", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"b", "[", "t", "]"}], "+", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "[",
              "t", "]"}], 
            RowBox[{"d", "[", "t", "]"}]}]}]}], "]"}], "&"}], "/@", 
       "pcf3ds"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "\[Pi]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v1", "=", 
      RowBox[{"4", 
       RowBox[{"Sec", "[", "\[Theta]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"bb", ",", "dd", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "v1"}], "}"}]}], "]"}], "//", 
              "ReverseFillStyle"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Styled3DDisk", "[", 
                RowBox[{
                 RowBox[{"pm", "\[LeftDoubleBracket]", 
                  RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"pm", "\[LeftDoubleBracket]", 
                  RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
                 "2.5", ",", 
                 RowBox[{"FillStyle", "\[Rule]", 
                  RowBox[{"{", 
                   RowBox[{"LightGray", ",", 
                    RowBox[{"Opacity", "[", ".2", "]"}]}], "}"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "pm", "]"}]}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], ",", 
           RowBox[{"Lighting", "\[Rule]", 
            RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"StyledRuledPatchSequence", "[", 
              RowBox[{"cclist", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], ",", 
           RowBox[{"Lighting", "\[Rule]", 
            RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatchSequence", "[", 
             RowBox[{"clist", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"TransverseLineStyle", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                "BorderLine", ",", "MountainLine", ",", "ValleyLine", ",", 
                 "MountainLine", ",", "BorderLine"}], "}"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"RulingLineStyle", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                "ValleyRulingLine", ",", "MountainRulingLine", ",", 
                 "ValleyRulingLine", ",", "MountainRulingLine"}], "}"}]}]}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
