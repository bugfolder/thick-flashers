       ",", "spl", ",", "vpl"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{".1", "#"}], ",", 
         RowBox[{".1", 
          SuperscriptBox["#", "2"]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"NormalizeReal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{".1", "s"}], ",", 
            RowBox[{".1", 
             SuperscriptBox["s", "2"]}], ",", "1"}], "}"}], "]"}], "//", 
         "Simplify"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsys", "=", 
      RowBox[{"Darboux3DSystem", "[", 
       RowBox[{"cc", ",", "uu"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nds", "=", 
      RowBox[{"NDarboux3DSystem", "[", 
       RowBox[{"cc", ",", "uu", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"spl", "[", "var_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"ToString", "[", "var", "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"var", "/.", "dsys"}], ")"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"var", "/.", "dsys"}], ")"}], "[", "s", "]"}]}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"PlotStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "Red", "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"Green", ",", "Dashed"}], "}"}]}], "}"}]}]}], "]"}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"spl", "[", "Speed3D", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"spl", "[", "GeodesicCurvature3D", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"spl", "[", "NormalCurvature3D", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"spl", "[", "GeodesicTorsion3D", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vpl", "[", "var_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"ToString", "[", "var", "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"ParametricPlot3D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"var", "/.", "dsys"}], ")"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"var", "/.", "dsys"}], ")"}], "[", "s", "]"}]}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"PlotStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "Red", "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"Green", ",", "Dashed"}], "}"}]}], "}"}]}]}], "]"}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vpl", "[", "TangentVector3D", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vpl", "[", "TangentNormalVector3D", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vpl", "[", "SurfaceNormalVector3D", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
