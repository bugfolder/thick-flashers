Cell[CellGroupData[{

Cell[TextData[{
 "JoinGraphs[",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) KillMergedEdges, SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.649946250721564*^9, 3.649946267888624*^9}, 
   3.649946317058064*^9, {3.649947274058954*^9, 3.649947274448381*^9}, {
   3.649947381490167*^9, 3.649947382033183*^9}, 3.649963881117096*^9, {
   3.707782533442273*^9, 3.707782550821323*^9}, {3.70782290770821*^9, 
   3.7078229083965206`*^9}, 3.707823803973403*^9, 
   3.707824769826189*^9},ExpressionUUID->"a47f8385-af97-460b-91d8-\
7341b5ffa766"],

Cell[TextData[{
 "JoinGraphs[",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 " that describe a list of TGraphs and joins them according to the \
information in each ",
 StyleBox["graphspec",
  FontSlant->"Italic"],
 ", returning the merged TGraph. "
}], "Text",
 CellChangeTimes->{{3.649946270416518*^9, 3.649946446293384*^9}, {
   3.649946508786581*^9, 3.649946509572444*^9}, {3.649946548878963*^9, 
   3.6499467952642508`*^9}, {3.64994729248547*^9, 3.649947335900647*^9}, {
   3.649947403937332*^9, 3.649947413160188*^9}, {3.649947641850954*^9, 
   3.649947642611747*^9}, 3.6499638959227757`*^9, 
   3.707782410186534*^9},ExpressionUUID->"a918d3cd-edfe-4e3b-9a41-\
f6252df98254"],

Cell[TextData[{
 "Options:\n\tKillMergedEdges \[Rule] True | False, specify whether to remove \
merged edges\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", tolerance on whether two vertices are distinct."
}], "Text",
 CellChangeTimes->{{3.707777850542234*^9, 3.707777853581541*^9}, {
   3.707778293920401*^9, 3.70777842795789*^9}, {3.707781820295705*^9, 
   3.707781862978016*^9}, 3.707822911523885*^9, 3.707823804006452*^9, 
   3.7078247698716393`*^9, 
   3.7078249690574913`*^9},ExpressionUUID->"6c741c91-818e-42ee-859c-\
de0c1d0f2321"],

Cell["Returns the merged TGraph.", "Text",
 CellChangeTimes->{{3.707822921875576*^9, 
  3.707822925805193*^9}},ExpressionUUID->"c9e32b4a-9f08-4198-bd66-\
e2df9c430a28"],

Cell[TextData[{
 "Each ",
 StyleBox["graphspec",
  FontSlant->"Italic"],
 " is of the form {",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}}}, where ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is a TGraph and {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}} specify how that graph is to be joined to one of its predecessors in the \
list. The TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is to be offset, rotated, and scaled so that the vertex pair {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "} of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th TGraph will be the position of the {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "} vertex pair of the transformed ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". The first {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}} can be an empty list, because it is ignored. "
}], "Text",
 CellChangeTimes->{{3.707782412836965*^9, 3.707782418740293*^9}, {
  3.7078229351162663`*^9, 
  3.707822935685523*^9}},ExpressionUUID->"4a8cbca0-10de-48c9-bf23-\
ed7bd0120193"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JoinGraphs", "[", 
   RowBox[{"graphspecs_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tglist", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tglist", "=", 
      RowBox[{"JoinGraphsData", "[", "graphspecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MergeGraphs", "[", 
      RowBox[{"tglist", ",", "opts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.6499475135845623`*^9, 3.649947560119976*^9}, {
  3.649950709594823*^9, 3.649950709767599*^9}, {3.707782539297411*^9, 
  3.7077825400333*^9}, {3.707905233653102*^9, 3.707905235531308*^9}},
 CellLabel->
