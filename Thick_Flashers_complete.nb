              "dedge", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
               ",", "j"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], "=", 
           RowBox[{"xfrm", "/@", 
            RowBox[{"efaces", "\[LeftDoubleBracket]", 
             RowBox[{"kids", "\[LeftDoubleBracket]", 
              RowBox[{
