     RowBox[{
      RowBox[{"AssertClasses", "::", "nottobj"}], ",", "tobj"}], "]"}], ";", 
    RowBox[{"Abort", "[", "]"}], ";"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.627948582226314*^9, 3.627948680326489*^9}, {
  3.627948870020001*^9, 3.6279488896665487`*^9}},
 CellLabel->
