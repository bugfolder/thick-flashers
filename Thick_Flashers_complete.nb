Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"al", ",", "gm", ",", "tobj", ",", "gg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"al", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"45.", "\[Degree]"}], ",", 
        RowBox[{"45.", "\[Degree]"}], ",", 
        RowBox[{"45.", "\[Degree]"}], ",", 
        RowBox[{"45.", "\[Degree]"}], ",", 
        RowBox[{"45.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gm", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"30.", "\[Degree]"}], ",", 
        RowBox[{"30.", "\[Degree]"}], ",", 
        RowBox[{"30.", "\[Degree]"}], ",", 
        RowBox[{"30.", "\[Degree]"}], ",", 
        RowBox[{"30.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromAngles", "[", 
       RowBox[{"al", ",", "gm", ",", 
        RowBox[{"OffsetAngle", "\[Rule]", 
         RowBox[{"5.", "\[Degree]"}]}], ",", 
        RowBox[{"OffsetAngle3D", "\[Rule]", 
         RowBox[{"5.", "\[Degree]"}]}], ",", 
        RowBox[{"CheckConsistency", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "FoldVectors"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"VertexCreasePatternGraphics", "[", "tobj", "]"}], "/.", 
          RowBox[{"OrigamiStyle", "[", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Red", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "#"}], 
                 "}"}], "]"}], "&"}], "/@", "gg"}], ",", "Black", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{"i", ",", 
                 RowBox[{
                 "gg", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "gg", "]"}]}], "}"}]}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "//", "GetAllRules"}], "//", "ColumnForm"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
