Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"TestTile", ",", "n_"}], "}"}], ",", "Tiling", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ti", ",", "verts", ",", "ctr"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ti", "=", 
      RowBox[{
       RowBox[{"TileIndex", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{"TileIndex", "\[Rule]", "None"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"UnitRegularPolygonVertices", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{"UnitRegularPolygonCenter", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ti", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"ToString", "[", "ti", "]"}], ",", "ctr"}], "]"}], ",", 
           "Black"}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"ToString", "[", "j", "]"}], ",", 
             RowBox[{
              RowBox[{"0.8", " ", 
               RowBox[{
               "verts", "\[LeftDoubleBracket]", "j", 
                "\[RightDoubleBracket]"}]}], "+", 
              RowBox[{"0.2", "ctr"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ",", "TilingText"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"AppendFirst", "[", "verts", "]"}], "]"}], ",", 
         "TilingLine"}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629763365617183*^9, 3.629763387869692*^9}, 
   3.629764252899835*^9, {3.629765448451061*^9, 3.629765454747088*^9}, {
