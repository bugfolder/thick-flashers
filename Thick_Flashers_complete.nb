fa8a551566b8"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph to be folded.\n\t",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " \[LongDash] the fold angles."
}], "Text",
 CellChangeTimes->{{3.722250421556538*^9, 
  3.72225043896382*^9}},ExpressionUUID->"7913aea5-1b68-448a-b45a-\
0624ab86af34"],

Cell[TextData[{
 "Options:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 ", the index of the face whose position remains unchanged.\n\tShowProgress \
\[Rule] True | False, whether to show progress and internal structures. \
Useful for debugging."
}], "Text",
 CellChangeTimes->{
  3.722248539983442*^9, {3.722248727638082*^9, 3.722248741877592*^9}, 
   3.7222488281772833`*^9},ExpressionUUID->"a0f34bfc-5bb6-4c2f-b921-\
c91f3ab7efac"],

Cell["Returns a TGraph3D with the 3D folded form.", "Text",
 CellChangeTimes->{{3.722250450179427*^9, 
  3.722250462868353*^9}},ExpressionUUID->"00106a1e-0a99-4053-b7b8-\
750ac521fd71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldGraph3D", "[", 
   RowBox[{"tobj_TObj", ",", "foldangles_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts3d", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "FoldGraph3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"FoldEmbedding", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"tobj", "[", "Vertices", "]"}], ",", "foldangles", ",", 
        "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj", ",", "TGraph3D"}], "]"}], ",", 
       RowBox[{"tobj", "//", 
        RowBox[{"ReplaceProperties", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Vertices3D", "\[Rule]", "verts3d"}], ",", 
           RowBox[{"FoldAngles", "\[Rule]", "foldangles"}]}], "}"}], "]"}]}], 
       ",", 
       RowBox[{"tobj", "//", 
        RowBox[{"AddTGraph3D", "[", 
         RowBox[{"verts3d", ",", "foldangles"}], "]"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.722245240540701*^9, 3.722245456951421*^9}, {
   3.722246832163128*^9, 3.7222468598346043`*^9}, {3.722247047853934*^9, 
   3.722247130589158*^9}, {3.722250475843747*^9, 3.72225047628423*^9}, 
   3.726081480113709*^9},
 CellLabel->
  "In[1458]:=",ExpressionUUID->"49c35c41-ec77-474f-941f-e13183ffdec3"],

