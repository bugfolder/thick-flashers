Cell[TextData[{
 "NDarboux3DSystem[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["uu",
  FontSlant->"Italic"],
 ", {u0, u1}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
