   3.801684626421474*^9}, {3.8019099046319637`*^9, 
   3.801909942374593*^9}},ExpressionUUID->"9da30e22-b444-453c-9aac-\
bf201cc8afcc"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b1",
  FontSlant->"Italic"],
 " \[LongDash] 2D directrix of the first surface.\n\t",
 StyleBox["d1",
  FontSlant->"Italic"],
 " \[LongDash] 2D director of the first surface.\n\t",
 StyleBox["bb1",
  FontSlant->"Italic"],
 " \[LongDash] 3D directrix of the first surface.\n\t",
 StyleBox["dd1",
  FontSlant->"Italic"],
 " \[LongDash] 3D director of the first surface.\n\tp2i \[LongDash] a point \
on the 2D directrix\n\t",
 StyleBox["d2i",
  FontSlant->"Italic"],
 " \[LongDash] the 2D constant director\n\t",
 StyleBox["pp2i",
  FontSlant->"Italic"],
 " \[LongDash] a point in the plane of the 3D directrix\n\t",
 StyleBox["dd2i",
  FontSlant->"Italic"],
 " \[LongDash] the 3D constant director\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.801503207744983*^9, 3.801503296475118*^9}, {
