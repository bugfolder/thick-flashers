Cell[CellGroupData[{

Cell["RandlettBirdGraph3DAssigned", "Subsubsection",
 CellChangeTimes->{{3.592757086915485*^9, 3.592757095947053*^9}, 
   3.594301356207716*^9, 3.595278198417265*^9, {3.70682716401763*^9, 
   3.706827165192891*^9}, {3.706965309003859*^9, 
   3.706965309501361*^9}},ExpressionUUID->"d3120c18-8513-49c0-9a24-\
7bb53b7c2f74"],

Cell["\<\
This is a partially folded 3D version of the Randlett bird. Takes several \
seconds to compute.\
\>", "Text",
 CellChangeTimes->{{3.594305759000898*^9, 3.594305773239353*^9}, {
  3.594307472485512*^9, 3.594307477512693*^9}, {3.594309202667678*^9, 
  3.594309210417714*^9}, {3.7069654777836237`*^9, 3.70696550083896*^9}, {
  3.7069655463348703`*^9, 
  3.70696555263151*^9}},ExpressionUUID->"0adc0541-b41e-4fb0-8c9a-\
e43faacf8611"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "RandlettBirdGraph3DAssigned", "]"}], ";", 
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"RandlettBirdGraph3DAssigned", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj", ",", "faspecs", ",", "foldangles"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tobj", "=", "RandlettBirdGraphAssigned"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"faspecs", "=", 
        RowBox[{"MakeStdFoldAngleSpecs", "[", "tobj", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"mostly", " ", "folded"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"faspecs", "=", 
        RowBox[{"faspecs", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"90", "\[Degree]"}]}], "}"}], "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"170", "\[Degree]"}]}], "}"}]}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{
               RowBox[{"-", "90"}], "\[Degree]"}]}], "}"}], "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{
               RowBox[{"-", "170"}], "\[Degree]"}]}], "}"}]}]}], "}"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "this", " ", "is", " ", "the", " ", "\"\<controlling\>\"", " ", 
         "crease"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "faspecs", "\[LeftDoubleBracket]", "13", "\[RightDoubleBracket]"}], "=", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", 
          RowBox[{
           RowBox[{"-", "90"}], "\[Degree]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"foldangles", "=", 
        RowBox[{"MakeGraphFoldAngles", "[", 
         RowBox[{"tobj", ",", "faspecs"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"FoldGraph3D", "[", 
         RowBox[{"tobj", ",", "foldangles", ",", 
          RowBox[{"StationaryFace", "\[Rule]", "13"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ReassignGraphAssigned", "[", 
        RowBox[{"tobj", ",", "foldangles"}], "]"}]}]}], "]"}]}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594305775525539*^9, 3.5943059002498627`*^9}, {
   3.59430593156884*^9, 3.594306070895854*^9}, {3.59430642787109*^9, 
   3.594306440439615*^9}, {3.594306511803613*^9, 3.594306582046924*^9}, {
   3.594306685340129*^9, 3.594306720493787*^9}, {3.594306870735796*^9, 
