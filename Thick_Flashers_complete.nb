Cell[TextData[{
 "CollinearCleanupGraphAssigned[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraphAssigned and returns a revised version with collinear \
degree-2 vertices removed."
}], "Text",
 CellChangeTimes->{{3.707843669233399*^9, 3.707843705887328*^9}, {
   3.707852955658692*^9, 3.707852972206331*^9}, 3.707857268745355*^9, 
