 RowBox[{
  RowBox[{"StrictArguments", "[", "NSpaceCurveFold3D", "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.79944345788535*^9, 3.7994434660770397`*^9}, 
   3.799447867940923*^9, 3.7995255666796293`*^9, 3.801657953804482*^9},
 CellLabel->
