Cell[CellGroupData[{

Cell[TextData[{
 "Vertex3DStyle[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[OrigamiStyle], TraceColor, OsculatingColor, \
RulingColor, MidfoldNormalColor, ",
 "Midfold",
 "Color"
}], "Subsubsection",
 CellChangeTimes->{{3.442605180944417*^9, 3.442605187408441*^9}, {
   3.442605252147149*^9, 3.442605285140089*^9}, {3.442605525149303*^9, 
   3.442605534139636*^9}, {3.442605564397704*^9, 3.4426055661647663`*^9}, {
   3.442607683194464*^9, 3.442607713996737*^9}, {3.4426235403940372`*^9, 
   3.44262355705539*^9}, {3.443204329596594*^9, 3.443204337105536*^9}, {
   3.4432050657233768`*^9, 3.443205067689061*^9}, 3.533652283603097*^9, {
   3.533654453506989*^9, 3.533654501388288*^9}, 3.592437088021806*^9, {
   3.593021944367901*^9, 3.593021955020657*^9}, 3.594806395624039*^9, 
   3.59767231752608*^9, 
   3.597672353012718*^9},ExpressionUUID->"4ef9c52a-4971-415b-8de3-\
9c01c234b86a"],

Cell[TextData[{
 "Vertex3DStyle[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a set of rules that change the abstract style types given above \
into proper style directives for rendering 2D crease patterns, 3D folded \
forms, and 3D vertices. It is a superset of the rules returned by \
OrigamiStyle. The rules transform Style[",
 StyleBox["elems",
  FontSlant->"Italic"],
 ", ",
 StyleBox["origamistyle",
  FontSlant->"Italic"],
 "] into the appropriately styled graphics elements where ",
 StyleBox["origamistyle",
  FontSlant->"Italic"],
 " is one of the line or fill specifications above. In addition to the \
OrigamiStyle options, new options are:\n\tOsculatingColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of lines and points that define the osculating vector \
and plane.\n\tRulingColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of lines and points that define the ruling vector and \
plane.\n\tTangentColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of lines and points that define the tangent line and \
plane.\n\tMidfoldColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of points, lines, and midarc plane.\n\tOpacity2D\
\[Rule]",
 StyleBox["opacity",
  FontSlant->"Italic"],
 ", specifies how opaque to make the polygon faces in the folded form in 2D \
graphics (PaperWhiteSideFill, PaperColoredSideFill)\n\tOpacity3D\[Rule]",
 StyleBox["opacity",
  FontSlant->"Italic"],
 ", specifies how opaque to make the polygon faces in the folded form in 3D \
graphics (",
 "Paper3DFill",
 ")\nThe three colors OsculatingColor, RulingColor, MidfoldNormalColor are \
used to identify features unique to degree-4 vertices and their traces, and \
we different shades of them: points are done Darker; planes are done Lighter; \
lines are done in the specified color."
}], "Text",
 CellChangeTimes->{{3.442605189640786*^9, 3.4426052420742407`*^9}, {
   3.44260541305866*^9, 3.442605511418973*^9}, {3.4426055694953823`*^9, 
   3.442605593493712*^9}, {3.442607714027358*^9, 3.44260772853197*^9}, {
   3.442608488985815*^9, 3.442608541765217*^9}, {3.442622525902917*^9, 
