Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTMiuraMarsOri", "::", "badminor"}], 
   "=", "\"\<The first dihedral of TVertex `1` must be minor; its dihedrals \
are `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595005148978063*^9, 3.5950051820813847`*^9}, 
