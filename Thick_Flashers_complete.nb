5ed8734c9641"],

Cell[TextData[{
 "UnitRegular",
 "PolygonCenteredTwist",
 "SelfContainedTypes[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau]] returns a list of all MV-assigments that produce valid \
self-contained unit polygon twist tiles for the given parameters."
}], "Text",
 CellChangeTimes->{{3.457743743978447*^9, 3.457743749356789*^9}, {
   3.457744108198436*^9, 3.45774410913358*^9}, 3.627339667110395*^9, 
