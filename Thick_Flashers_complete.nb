             RowBox[{"p", ",", "r"}], "}"}], "]"}], ",", "Green"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "s"}], "}"}], "]"}], ",", "Blue"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
