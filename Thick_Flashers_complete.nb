   3.456518058317943*^9, 
   3.668985879717838*^9},ExpressionUUID->"4a930440-4ca7-400d-a2e1-\
71644342786b"],

Cell[TextData[{
 "StyledGenericFoldLine",
 "[",
 StyleBox["rlist",
  FontSlant->"Italic"],
 ",\[Gamma],",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] is similar to StyledFoldLine, but simply returns a FoldedLine or empty \
list, depending on the angle. Note that this works with both 2D and 3D lines. \
Options are:\n\tMinimumAngle\[Rule]",
 StyleBox["gmin",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["gmin",
  FontSlant->"Italic"],
 " is the magnitude of the dihedral angle below which the line will not be \
represented."
}], "Text",
 CellChangeTimes->{{3.440256139751239*^9, 3.440256272322796*^9}, {
   3.4404473378235607`*^9, 3.4404473689319*^9}, {3.456360400068309*^9, 
   3.456360430144524*^9}, 3.456518058372527*^9, {3.456518136897629*^9, 
   3.45651813932684*^9}, {3.591799487595721*^9, 3.591799489106947*^9}, {
   3.668985866134905*^9, 
   3.668985879772877*^9}},ExpressionUUID->"9afd7eac-3027-40b0-a907-\
66433eacfece"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledGenericFoldLine", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"MinimumAngle", "\[Rule]", 
     RowBox[{"1", "\[Degree]"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.440256351842156*^9, 3.440256370710278*^9}, 
   3.456360437365051*^9, 3.456518058389076*^9, 3.66898587979631*^9},
