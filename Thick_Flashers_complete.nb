5c91acadd600"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeOffsetGoldbergTilingPrimalDualGraph", "[", 
   RowBox[{"m_", ",", "n_", ",", 
    RowBox[{"o_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"tobj", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"MakeOffsetGoldbergTilingGraph", "[", 
         RowBox[{"m", ",", "n"}], "]"}], "//", "AddTPlaneGraphTo"}], "//", 
       "AddTPrimalDualGraphTo"}], "//", 
      "MakeTriangleGraphReciprocalDiagram"}]}]}], "]"}]}]], "Input",
