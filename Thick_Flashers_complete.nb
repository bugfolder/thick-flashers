}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "GoldbergOffsetTiling[",
 StyleBox["m, n, o, opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.631645214662734*^9, 3.631645223620704*^9}, {
  3.631645256556113*^9, 
  3.6316452580993032`*^9}},ExpressionUUID->"1a018552-69b9-4b33-af9e-\
2c0758358ef2"],

Cell[TextData[{
 "GoldbergOffsetTiling[",
 StyleBox["m, n, o, opts",
  FontSlant->"Italic"],
 "] returns an offset Goldberg tiling for even m where o specifies the \
relative offset of the bottom half of the tiling."
}], "Text",
 CellChangeTimes->{{3.631645241196063*^9, 
  3.631645286616789*^9}},ExpressionUUID->"2ee61726-5fd2-4e2b-81dc-\
8b7d61fde36d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GoldbergOffsetTiling", "[", 
   RowBox[{
    StyleBox["m_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["n_",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["o_",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"patch", ",", "top", ",", "bottom"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"patch", "=", 
      RowBox[{"GoldbergPatch", "[", 
       RowBox[{"m", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"top", "=", 
      RowBox[{"JoinTilingPatches", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"patch", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ",", "1", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"m", "/", "2"}]}], "}"}]}], "]"}], ",", "opts"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"bottom", "=", 
      RowBox[{"top", "/.", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"UnitTriangleTile", ",", "angles_"}], "}"}], ",", "off_", ",",
           "rot_", ",", "s_"}], "}"}], "\[RuleDelayed]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"UnitTriangleTile", ",", "angles"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"RotationMatrix2D", "[", "\[Pi]", "]"}], ".", "off"}], "+", 
           RowBox[{"{", 
            RowBox[{"o", ",", "0"}], "}"}]}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"rot", "+", "\[Pi]"}], ",", 
            RowBox[{"2", "\[Pi]"}], ",", 
            RowBox[{"-", "\[Pi]"}]}], "]"}], ",", "s"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"top", ",", "bottom"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.631645208787518*^9, 3.631645211511156*^9}, {
   3.631645264757497*^9, 3.6316453749272*^9}, {3.631645845495866*^9, 
   3.631645937194202*^9}, {3.631645969073367*^9, 3.631645989046844*^9}, {
   3.631646052519261*^9, 3.631646080594748*^9}, 3.631646153710837*^9, {
   3.631646183883645*^9, 3.631646199706897*^9}, {3.631646233873847*^9, 
   3.631646279495379*^9}, 3.688166837333625*^9},
 CellLabel->
  "In[3324]:=",ExpressionUUID->"bce7fd46-b58b-43b2-ae54-19eda1f7b778"],

