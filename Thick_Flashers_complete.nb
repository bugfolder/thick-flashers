   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.676407206560045*^9, 3.676407384100723*^9}, 
   3.676407519722129*^9, {3.6764077906434097`*^9, 3.6764078217271433`*^9}},
 CellLabel->
