Cell[TextData[{
 "ClipSegmentSetToQuasiConvexPolygonExterior[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] takes the segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, is",
  FontSlant->"Italic"],
 "} and returns a segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, isa",
  FontSlant->"Italic"],
 "} that lies outside of the \[OpenCurlyDoubleQuote]quasi-convex\
\[CloseCurlyDoubleQuote] polygon ",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", which is given as a list of vertices. Note that this works properly no \
matter where the segment set is relative to the polygon. Polygon can be \
either CW or CCW."
}], "Text",
 CellChangeTimes->{{3.484758552449597*^9, 3.484758653747197*^9}, {
  3.628117525660402*^9, 3.628117538204996*^9}, {3.628120841068108*^9, 
  3.628120847633684*^9}},ExpressionUUID->"38baba2f-99ed-46f8-9699-\
71128b4c532b"],

Cell[TextData[{
 "A \[OpenCurlyDoubleQuote]quasi-convex\[CloseCurlyDoubleQuote] polygon is \
one that has at most ",
 StyleBox["one",
  FontSlant->"Italic"],
 " reflex vertex\[LongDash]a situation that can arise when we\
\[CloseCurlyQuote]re computing VisibleFoldedFormLines for a polygon made up \
of joined tiles. This particular function is a stopgap. Ultimately we\
\[CloseCurlyQuote]ll want a version that works for arbitrary polygons. We can \
implement that using a constrained Delaunay triangulation of the polygon, \
then applying our algorithm to all of the triangles in the set. For now, if \
we know that there\[CloseCurlyQuote]s only one reflex vertex, we can do our \
own triangulation."
}], "Text",
 CellChangeTimes->{{3.628117542708531*^9, 3.628117644150523*^9}, {
  3.628117690083473*^9, 3.62811775632699*^9}, {3.6281191762763033`*^9, 
  3.628119192915097*^9}},ExpressionUUID->"1c5aa164-5c9d-4940-9510-\
ca56c79638d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentSetToQuasiConvexPolygonExterior", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1_",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["q2_",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["is_",
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["poly_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"iinfo", ",", "ss"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"iinfo", "=", 
      RowBox[{"QuasiConvexPolygonIntersectionInfo", "[", "poly", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"{", 
       RowBox[{
       "verts", ",", " ", "bbox", ",", " ", "convex", ",", " ", "triangles"}],
        " "}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
       "iinfo", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"is", " ", "convex"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ss", "=", 
         RowBox[{"ClipSegmentSetToConvexPolygon", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"q1", ",", "q2", ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], 
              "}"}]}], "}"}], ",", "poly"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", 
          RowBox[{"IntervalSetMinus", "[", 
           RowBox[{"is", ",", 
            RowBox[{
            "ss", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
           "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"has", " ", "a", " ", "reflex", " ", "vertex"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Fold", "[", 
        RowBox[{"ClipSegmentSetToConvexPolygonExterior", ",", 
         RowBox[{"{", 
          RowBox[{"q1", ",", "q2", ",", "is"}], "}"}], ",", 
         RowBox[{
         "iinfo", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
        "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.484755034791026*^9, 3.484755041507921*^9}, {
   3.484770312059771*^9, 3.484770404176836*^9}, {3.484770475097972*^9, 
