Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "u0", ",", "u1", ",", "v0", ",", "v1", ",", "scf"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "30"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"scf", "=", 
      RowBox[{"RainbowSurfaceColorFunction", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}], "]"}], ",", 
          RowBox[{"scf", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"PointSize", "[", ".03", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "u0", ",", "u1", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"u1", "-", "u0"}], ")"}], "/", "n"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "v0", ",", "v1", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", "-", "v0"}], ")"}], "/", "n"}]}], "}"}]}], "]"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.8000036448336077`*^9, 3.800003879719616*^9}, {
