   3.631144592121434*^9, 3.631144592296405*^9}, {3.631144991967017*^9, 
   3.631145078649907*^9}, {3.6311451455400953`*^9, 3.631145210725637*^9}, {
   3.631145275523251*^9, 3.63114528630266*^9}, {3.631180610448594*^9, 
   3.631180711399358*^9}, {3.631294529064133*^9, 3.63129456952133*^9}, {
   3.631294697155598*^9, 3.631294699588307*^9}, {3.643226526128948*^9, 
   3.643226604386302*^9}, 3.643226692598311*^9, {3.643226819622285*^9, 
   3.643226819855482*^9}, {3.643227375690352*^9, 3.643227375882509*^9}, 
   3.643227866604095*^9, {3.6432286431151953`*^9, 3.64322864349946*^9}, {
   3.64322880723599*^9, 3.64322880740854*^9}, 3.643235117439215*^9, 
   3.643235366926517*^9, 3.643235625725147*^9},
 CellLabel->
