   3.7078601504914517`*^9}},ExpressionUUID->"05001bb0-0e75-40e2-9b9c-\
aaed2c73bf24"],

Cell[TextData[{
 "ApplyCollinearCleanupTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 "] takes a TGraph and CollinearCleanupData and returns a revised version of \
the TGraph with collinear degree-2 vertices removed."
}], "Text",
 CellChangeTimes->{{3.707843669233399*^9, 3.707843705887328*^9}, {
   3.707852955658692*^9, 3.707852972206331*^9}, {3.707853184365459*^9, 
   3.70785318497332*^9}, 3.707857991715622*^9, {3.707858029425789*^9, 
   3.7078580720004396`*^9}, 3.707858154668639*^9, {3.70785928850688*^9, 
   3.707859309504117*^9}, 
   3.707859370076945*^9},ExpressionUUID->"5e664f86-01cb-498f-b261-\
372b84c27988"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph being reduced.\n\t",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 " \[LongDash] a list from CollinearCleanupData that descries the reduction."
}], "Text",
 CellChangeTimes->{{3.707843707838018*^9, 3.707843755815661*^9}, {
  3.707853111188617*^9, 3.707853141196183*^9}, {3.7078592885437803`*^9, 
  3.707859309546343*^9}},ExpressionUUID->"838f000a-c47d-45d0-9368-\
2489d638cb43"],

Cell["\<\
Returns: the revised TGraph. Vertices, Edges, and Faces are changed, but \
everything else remains.\
\>", "Text",
 CellChangeTimes->{{3.707843802951194*^9, 3.7078438436892643`*^9}, {
  3.707844019089117*^9, 3.707844065666017*^9}, {3.707844112594449*^9, 
  3.707844319501901*^9}, {3.7078532054296007`*^9, 3.7078532104929953`*^9}, {
  3.707859843127778*^9, 
  3.707859852784124*^9}},ExpressionUUID->"33783497-98e1-44fe-93bc-\
838efa863819"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyCollinearCleanupTo", "[", 
   RowBox[{"tobj_TObj", ",", "ccdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vlist", ",", "elist", ",", "verts", ",", "edges", ",", "vm", ",", 
      "nverts", ",", "nedges", ",", "evs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vlist", ",", "elist"}], "}"}], "=", "ccdata"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "vlist"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "vm", " ", "maps", " ", "old", " ", "vertex", " ", "index", " ", "to", " ",
        "new", " ", "vertex", " ", "index"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vm", "[", "#1", "]"}], "=", 
          RowBox[{
          "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         ")"}], "&"}], ",", "vlist"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "new", " ", "edges", " ", "in", " ", "terms", " ", "of", " ", "old", " ",
        "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{
           "elist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "]"}], "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"nedges", ",", 
           RowBox[{"edges", "\[LeftDoubleBracket]", 
            RowBox[{"elist", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"evs", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"edges", "\[LeftDoubleBracket]", 
             RowBox[{
             "elist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"nedges", ",", 
            RowBox[{"First", "/@", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"#", ",", 
                   RowBox[{"Count", "[", 
                    RowBox[{"evs", ",", "#"}], "]"}]}], "}"}], "&"}], "/@", 
                "evs"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 "\[Equal]", "1"}], "&"}]}], "]"}]}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "elist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "put", " ", "new", " ", "edges", " ", "in", " ", "terms", " ", "of", " ",
        "new", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"vm", ",", "nedges", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"replace", " ", "verts"}], ",", " ", "edges", ",", " ", 
       RowBox[{"and", " ", "faces"}], ",", " ", 
       RowBox[{"keep", " ", "everything", " ", "else"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperties", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", "nverts"}], ",", 
         RowBox[{"Edges", "\[Rule]", "nedges"}], ",", 
         RowBox[{"Faces", "\[Rule]", 
          RowBox[{"{", "}"}]}]}], "}"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.70785325678085*^9, 3.707853274893779*^9}, {
   3.707853344174758*^9, 3.707853478791606*^9}, {3.707853631937539*^9, 
   3.707853734497572*^9}, {3.707853785433038*^9, 3.707853925131936*^9}, {
   3.7078539741833553`*^9, 3.707854217863253*^9}, {3.707854253968371*^9, 
   3.70785425640793*^9}, {3.707854338272795*^9, 3.707854338448312*^9}, {
