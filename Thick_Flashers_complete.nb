   3.713635247016404*^9}},ExpressionUUID->"ab9486b1-8edb-422b-95cc-\
e056f212c6a7"],

Cell[TextData[{
 "PrimalDualGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TPrimalDualGraph, and returns a Graphics object that displays the \
primal graph in orange and the dual graph in green. Both graphs can be shown \
directed, since their orientation can be used for the MV-assignment of things \
made from it (like primal-dual twist tessellations)."
}], "Text",
 CellChangeTimes->{{3.461729917785959*^9, 3.461729949740717*^9}, {
   3.465988793111248*^9, 3.46598880791695*^9}, {3.465988919862132*^9, 
   3.465988972481702*^9}, {3.48510741267302*^9, 3.485107451926033*^9}, {
   3.4851079382150187`*^9, 3.4851079619798613`*^9}, {3.591733523994143*^9, 
   3.591733539224906*^9}, {3.592402076571229*^9, 3.592402078418655*^9}, {
   3.592788374942995*^9, 3.592788396475378*^9}, {3.592789107846992*^9, 
   3.5927891195900383`*^9}, {3.59282880331746*^9, 3.592828803409964*^9}, {
   3.59285303580859*^9, 3.59285303947882*^9}, {3.593010206403342*^9, 
   3.5930102264074717`*^9}, 3.594205731747613*^9, {3.594207297007262*^9, 
   3.594207320419612*^9}, {3.594207505499338*^9, 3.594207519510521*^9}, {
   3.5942075826467338`*^9, 3.5942076016374893`*^9}, 3.594207791543898*^9, 
   3.5942078767587347`*^9, {3.594208173323161*^9, 3.594208186987916*^9}, {
   3.594208246303963*^9, 3.594208306683842*^9}, {3.594208592209195*^9, 
   3.59420866809268*^9}, 3.59520037644024*^9, 3.61514343019215*^9, {
   3.703155382769614*^9, 
   3.703155384073419*^9}},ExpressionUUID->"4c312e5b-5609-4149-ae7f-\
ae53a5a9552b"],

Cell[TextData[{
 "Options: \n\tShowPrimalEdges \[Rule] True | False, whether to show the \
primal graph edges.\n\tShowDualEdges \[Rule] True | False, whether to show \
the dual graph edges.\n\tPrimalDirectedEdges \[Rule] True | False, which \
specifies whether the interior edges of the primal graph should be drawn with \
directed edges.\n\tDualDirectedEdges \[Rule] True | False, which specifies \
whether the dual graph should be drawn with directed edges.\n\t\n\t\
ShowPrimalVertices \[Rule] True | False, whether to show the primal graph \
vertices.\n\tShowDualVertices \[Rule] True | False, whether to show the dual \
graph vertices.\n\tPrimalVertexLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"a6c7ee26-0698-4f28-a4d0-034b968aff33"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "753e4366-d691-4c22-81ce-6d7ce01cd917"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th primal vertex.\n\tDualVertexLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"33737ca1-1e47-44ea-8bea-bd610a5739ed"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "4e8ad022-0705-42f0-8ea7-3d57647a5f0b"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th dual vertex.\n\tPrimalVertexLetter \[Rule] ",
 StyleBox["p",
  FontSlant->"Italic"],
 " where ",
 StyleBox["p",
  FontSlant->"Italic"],
 " is the letter used to label each primal vertex.\n\tDualVertexLetter \
\[Rule] ",
 StyleBox["d",
  FontSlant->"Italic"],
 " where ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the letter used to label each dual vertex.\n\tPlaceSideBySide \[Rule] \
True | False, with True shifting the locations so that they are displayed \
side-by-side.\n\tArrowPosition \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies the position of orientation arrows along their edges.\n\t\
ArrowheadStyle \[Rule] ",
 StyleBox["ah",
  FontSlant->"Italic"],
 ", specifies stylistic aspects of the arrowheads.\n\tOptions[Graphics] are \
passed through."
}], "Text",
 CellChangeTimes->{{3.7031553861550717`*^9, 3.703155421213388*^9}, {
  3.703155492950281*^9, 3.703155498941721*^9}, {3.7031622974143763`*^9, 
  3.703162323253007*^9}, {3.713635252529029*^9, 
  3.713635328777534*^9}},ExpressionUUID->"379bda81-e584-43a2-9b50-\
f8bd4944d420"],

Cell["\<\
Note that this function does not label edges or faces by their indices. \
However, you can infer the face indices; they are the vertex indices of the \
corresponding dual vertex.\
\>", "Text",
 CellChangeTimes->{{3.703155423178342*^9, 
  3.703155426737938*^9}},ExpressionUUID->"27d08ebc-139e-4259-925f-\
0a518edb2845"],

