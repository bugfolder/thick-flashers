Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "dists", ",", "angles", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1.1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dists", "=", 
      RowBox[{"{", 
       RowBox[{"3", ",", "3", ",", "7", ",", "3", ",", "3"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"179", "\[Degree]"}], ",", 
        RowBox[{"0", "\[Degree]"}], ",", 
        RowBox[{"80", "\[Degree]"}], ",", 
        RowBox[{"170", "\[Degree]"}], ",", 
        RowBox[{"50", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTroublewitStrip", "[", 
       RowBox[{"p", ",", "dists", ",", "angles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", "tobj", "]"}]}], "}"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.701857826541432*^9, 3.701857944781556*^9}, {
   3.701858017305581*^9, 3.701858030058176*^9}, 3.701874973385984*^9, {
   3.701875124116082*^9, 3.70187514092679*^9}, {3.70792665131426*^9, 
   3.707926651986389*^9}},
 CellLabel->
  "In[2375]:=",ExpressionUUID->"c1e782d4-f0cc-48d7-899e-3c85c218da4e"]
}, Closed]],

