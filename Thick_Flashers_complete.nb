Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonAngles", "[", "verts_List", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Pi]", "-", "#"}], "&"}], "/@", 
   RowBox[{"RotationAngles", "[", "verts", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.628529113967903*^9, 3.628529132755188*^9}, 
