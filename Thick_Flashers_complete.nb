af47d3655798"],

Cell[TextData[{
 "DevelopabilityExcess[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 "] returns the excess angle beyond 2\[Pi] radians for the given list of \
sector angles. If this is zero, the vertex is developable."
}], "Text",
 CellChangeTimes->{{3.594757073729291*^9, 3.594757100317546*^9}, {
  3.594757137972292*^9, 
  3.594757144146987*^9}},ExpressionUUID->"e329076e-e238-4045-ad7a-\
783f8b5088d9"],

