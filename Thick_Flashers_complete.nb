Cell[CellGroupData[{

Cell["DoubleCairoPatch[\[Delta]]", "Subsubsection",
 CellChangeTimes->{{3.631215687069709*^9, 
  3.631215692162703*^9}},ExpressionUUID->"ec83a6c4-3135-40ab-8602-\
3cfc9a62fda1"],

Cell["\<\
DoubleCairoPatch[\[Delta]] returns a lattice patch of a second form of the \
Cairo tiling that uses twice as many tiles. It\[CloseCurlyQuote]s basically a \
combination of the CairoPatch[\[Delta]] with its mirror image.\
\>", "Text",
 CellChangeTimes->{{3.631215704489802*^9, 3.631215731671465*^9}, {
  3.63122485613209*^9, 
  3.631224870857897*^9}},ExpressionUUID->"96494921-ae0b-4585-a59c-\
74ecea88b9df"],

Cell["\<\
Note, though, that the double Cairo tiling reduces to the Cairo tiling for \
the two mirror-symmetric tiles, \[Delta]=90\[Degree] and \
\[Delta]=CairoSymmetricPentagonBaseAngle.\
\>", "Text",
 CellChangeTimes->{{3.631217042818966*^9, 3.6312170937051067`*^9}, 
   3.6312174276389303`*^9},ExpressionUUID->"8e6517e8-c191-487a-b640-\
ffed46dcd40b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DoubleCairoPatch", "[", "\[Delta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JoinTiling", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"UnitCairoPentagonTile", ",", " ", "\[Delta]"}], "}"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", " ", 
           RowBox[{"\[Pi]", "-", "\[Delta]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "4", ",", "4"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", " ", "\[Delta]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "1"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", " ", 
           RowBox[{"\[Pi]", "-", "\[Delta]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4", ",", "4"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", 
           RowBox[{"\[Pi]", "-", " ", "\[Delta]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "5", ",", "2"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", " ", "\[Delta]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "4", ",", "4"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", "  ", 
           RowBox[{"\[Pi]", "-", "\[Delta]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "1", ",", "1"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", "\[Delta]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "1", ",", "1"}], "}"}]}], "}"}]}], 
      "\[IndentingNewLine]", "}"}], "]"}], "//", "Chop"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.631122755669158*^9, 3.631122899049856*^9}, {
  3.631128638817532*^9, 3.631128660148101*^9}, {3.631138052700929*^9, 
