Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z", ",", "ahf", ",", "ar"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ahf", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ar", "=", "0.04"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Arrow", "[", 
           RowBox[{"Tube", "[", 
            RowBox[{"x", ",", "ar"}], "]"}], "]"}], ",", 
          RowBox[{"Arrowheads", "[", "ahf", "]"}], ",", " ", "Red"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Arrow", "[", 
           RowBox[{"Tube", "[", 
            RowBox[{"y", ",", "ar"}], "]"}], "]"}], ",", 
          RowBox[{"Arrowheads", "[", "ahf", "]"}], ",", " ", "Green"}], "]"}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Arrow", "[", 
           RowBox[{"Tube", "[", 
            RowBox[{"z", ",", "ar"}], "]"}], "]"}], ",", 
          RowBox[{"Arrowheads", "[", "ahf", "]"}], ",", " ", "Blue"}], 
         "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
