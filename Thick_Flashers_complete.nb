Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeTDegree4Vertex3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", 
       SubscriptBox["g", "2"], ",", 
       SubscriptBox["g", "3"], ",", 
       SubscriptBox["g", "4"]}], "}"}], ",", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "23eed69e-3e56-4d4e-b2ff-4bc076ac0597"],
 " constructs a TDegree4Vertex3D with the same outputs and options as \
MakeTVertex3DFromFoldVectors from exactly four dihedral vectors. If the \
directions give a self-intersecting arrangement (a crease assignment that \
fails Maekawa\[CloseCurlyQuote]s Theorem), an error is thrown."
}], "Text",
 CellChangeTimes->{{3.440444961733636*^9, 3.440445007254919*^9}, {
   3.4404450425601254`*^9, 3.440445087608881*^9}, {3.440448233511372*^9, 
   3.440448234145357*^9}, {3.44061177707707*^9, 3.440611838789625*^9}, {
   3.440613493870306*^9, 3.4406135373326817`*^9}, {3.4406136907360897`*^9, 
