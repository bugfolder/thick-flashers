4ed07884832d"],

Cell[TextData[{
 "Options:\n\tShowGaussianSphere \[Rule] True | False, include a gray \
Gaussian sphere in the display.\n\tGaussianSphereRadius \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specify the radius to use for the Gaussian sphere."
}], "Text",
 CellChangeTimes->{{3.703968050818184*^9, 3.703968091322544*^9}, {
   3.8000023503026037`*^9, 3.800002385934812*^9}, 
   3.800002483949645*^9},ExpressionUUID->"3332baa7-b40f-4aa7-a3ce-\
