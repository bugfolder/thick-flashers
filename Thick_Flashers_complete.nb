          RowBox[{
           RowBox[{"\[Gamma]", "[", "2", "]"}], ",", 
           RowBox[{"q", "[", "3", "]"}]}], "}"}], "=", 
         RowBox[{"NLinkedFoldsNext2D", "[", 
          RowBox[{
           RowBox[{"tf", "[", "1", "]"}], ",", 
           RowBox[{"q", "[", "1", "]"}], ",", 
           RowBox[{"\[Gamma]", "[", "1", "]"}], ",", 
