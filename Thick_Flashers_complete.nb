Cell["Polygon centered twist alternate form tiles", "Subsection",
 CellChangeTimes->{{3.4577387678564267`*^9, 3.457738783935132*^9}, 
   3.627340099177766*^9, 3.627385975830926*^9, {3.62755739476739*^9, 
