Cell[BoxData[
 RowBox[{
  RowBox[{"CreasePatternToPlaneGraphAssigned", "[", 
   RowBox[{"cp_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tol", ",", "bo", ",", "llist", ",", "styles", ",", "elist", ",", 
      "edgetypes", ",", "verts", ",", "edges", ",", "tobj", ",", "faces", ",",
       "boundary", ",", "bedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"SamePtTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CreasePatternToPlaneGraphAssigned", "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"bo", "=", 
      RowBox[{
       RowBox[{"BorderOverride", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CreasePatternToPlaneGraphAssigned", "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"llist", "=", 
      RowBox[{"ExtractFracturedStyledLines", "[", "cp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styles", "=", 
      RowBox[{"ExtractStyleArgs", "[", "llist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Union", "[", 
          RowBox[{"styles", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "MountainLine", "}"}], ",", 
             RowBox[{"{", "ValleyLine", "}"}], ",", 
             RowBox[{"{", "UnfoldedLine", "}"}], ",", 
             RowBox[{"{", "BorderLine", "}"}]}], "}"}]}], "]"}], "]"}], ">", 
        "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"CreasePatternToPlaneGraphAssigned", "::", "badstyles"}], ",",
           "styles"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"elist", ",", "edgetypes"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"llist", "/.", 
        RowBox[{"Style", "\[Rule]", "List"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edgetypes", "=", 
      RowBox[{"edgetypes", "/.", "CreasePatternStyleToEdgeTypeRules"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{
        RowBox[{"First", "/@", "elist"}], ",", "2", ",", 
        RowBox[{"SamePtTolerance", "\[Rule]", "tol"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"Length", "/@", 
           RowBox[{"Union", "/@", "edges"}]}], "]"}], "===", 
         RowBox[{"{", "2", "}"}]}]}], ",", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"CreasePatternToPlaneGraphAssigned", "::", "dupvert"}], ",", 
         "edges", ",", "verts"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraphTo"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"faces", ",", "boundary"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Faces", ",", "BoundaryVertices"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"bo", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bedges", "=", 
         RowBox[{"Join", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"Reverse", "/@", "#"}]}], "}"}], "&"}], "@", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"boundary", ",", 
               RowBox[{"RotateLeft", "[", "boundary", "]"}]}], "}"}], "]"}]}],
            ")"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"all", " ", "possible", " ", "border", " ", "edges"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"edgetypes", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"bedges", ",", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
              "]"}], ",", "B", ",", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
            "]"}], "&"}], "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"edges", ",", "edgetypes"}], "}"}], "]"}]}]}]}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"AddTAssigned", "[", "edgetypes", "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.484864301976472*^9, 3.48486435413818*^9}, {
   3.484864486249325*^9, 3.484864488385647*^9}, {3.484864898022651*^9, 
