Cell[CellGroupData[{

Cell[TextData[{
 "MakeGraphFoldAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faspecs, opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph\n\t(options) ConstrainFoldDirection"
}], "Subsubsection",
 CellChangeTimes->{{3.594165777491572*^9, 3.59416577857066*^9}, {
   3.594165821626295*^9, 3.594165873723833*^9}, {3.59416590732174*^9, 
   3.594165910465527*^9}, {3.594165960734711*^9, 3.594165961512889*^9}, 
   3.594213524359387*^9, 3.594219292052612*^9, {3.59421977548695*^9, 
   3.594219776300324*^9}, 3.59422072537976*^9, {3.594228025623349*^9, 
   3.594228026333199*^9}, {3.594857302790655*^9, 3.594857308950197*^9}, 
   3.594857356072095*^9, {3.59528654972503*^9, 3.595286550861063*^9}, {
   3.595286804276491*^9, 
   3.595286805444561*^9}},ExpressionUUID->"fc450e29-9186-4afe-ba95-\
7aca5a3e914c"],

Cell[TextData[{
 "MakeGraphFoldAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faspecs, opts",
  FontSlant->"Italic"],
 "] takes a TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " and a set of fold angle specifications ",
 StyleBox["faspecs",
  FontSlant->"Italic"],
 " and solves for a self-consistent set of edge angles that satisfies the \
generalized Kawasaki loop consistency condition at each interior vertex. ",
 StyleBox["faspecs",
  FontSlant->"Italic"],
 " is a list of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["w", "1"], ",", 
       SubscriptBox["\[Alpha]", "1"]}], "}"}], ",", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"91ee14af-9ebc-4e4e-b2fe-47220fc11b45"],
 " with an entry for each edge of the graph. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "i"], TraditionalForm]],ExpressionUUID->
  "7759ee9c-b170-4b01-b2d2-eb71de0a84ed"],
 " is a weight that determines the type of constraint on the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th angle and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],ExpressionUUID->
  "c1a272ae-bcd9-414b-8209-a2bcee77fff9"],
 " is a target value for that angle. The behavior varies according to the \
weight:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "f9d2fc87-6090-45fc-bd94-45424583c787"],
 " specifies a free angle (can take on any value to satisify GKC, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],ExpressionUUID->
  "ee6f9d47-122c-46bb-8281-72d318b96f40"],
 " is taken as the initial value in the search.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "\[Infinity]"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"b7748ed3-6d64-458b-bcfd-4318d272e8d7"],
 " specifies a goal angle, for which we minimize the RMS deviation from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],ExpressionUUID->
  "85cabe7b-9315-4164-b846-f0bccd5c1a3c"],
 " and use weighting value ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "i"], TraditionalForm]],ExpressionUUID->
  "c8f9bc47-c462-493a-adcf-ef47fc81dccd"],
 " in the sum-of-squared-error.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "i"], "=", "\[Infinity]"}], TraditionalForm]],
  ExpressionUUID->"47e85d0c-1802-4f4d-b922-36de7834f75c"],
 " specifies a fixed constraint, where we set the angle to this value.\nThere \
must be an entry for each edge in the pattern, but B edges will have their \
edge angles set to zero no matter what the spec said.\nThe return value is a \
list ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", which can be fed to FoldGraph3D to generate a 3D folded form. Note that \
for this function, ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " does not need to be a TGraph3D, but FoldGraph3D requires it. Options are:\n\
\tConstrainFoldDirection \[Rule] True | False. If True, the fold angles with \
finite weight are forced to have their mountain-valley status match the angle \
sign in the spec. If the spec angle is 0 but the angle is free or goal, then \
there is no constraint placed on the angle."
}], "Text",
 CellChangeTimes->{{3.5941659192402*^9, 3.594165930160431*^9}, {
   3.594165962861911*^9, 3.594166396946951*^9}, {3.594166444831197*^9, 
   3.594166445360264*^9}, {3.594166477637907*^9, 3.594166496860825*^9}, {
   3.594199886020678*^9, 3.5941999330702667`*^9}, 3.594217887650573*^9, {
   3.594219292097724*^9, 3.594219347839738*^9}, {3.59421977864507*^9, 
   3.594219794267902*^9}, 3.594220725476224*^9, {3.594228029917027*^9, 
   3.594228030524835*^9}, {3.594228066515036*^9, 3.594228069233982*^9}, {
   3.594228110113274*^9, 3.594228177587451*^9}, {3.594228582491535*^9, 
   3.594228604952704*^9}, {3.594857269548424*^9, 3.594857288114412*^9}, {
   3.5948573561623797`*^9, 
   3.594857392096099*^9}},ExpressionUUID->"92cbd18b-8a7d-4ada-9ead-\
9696944626b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstrainFoldDirection", "::", "usage"}], 
   "=", "\"\<ConstrainFoldDirection is an option to MakeGraphFoldAngles that \
specifies whether to bound the direction of the creases.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594228224155171*^9, 3.594228280863221*^9}, {
  3.5948573562039213`*^9, 3.594857356447773*^9}},
 CellLabel->
  "In[1435]:=",ExpressionUUID->"ed703b5d-ecf4-4609-a6e0-2089bddc5b67"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeGraphFoldAngles", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"ConstrainFoldDirection", "\[Rule]", "True"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.5942282833049383`*^9, 3.594228298725975*^9}, 
   3.594857356682366*^9},
 CellLabel->
  "In[1436]:=",ExpressionUUID->"d3965cc2-cdcd-4b8d-8842-66a9a3d18583"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeGraphFoldAngles", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["faspecs_List",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bfd", ",", "tobj1", ",", "faspecs1", ",", "iverts", ",", "bedges", ",", 
      "vei", ",", "vars", ",", "angles", ",", "a", ",", "vea", ",", "vfa", ",",
       "krms", ",", "fom", ",", "kcons", ",", "bcons", ",", "val", ",", 
      "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bfd", "=", 
      RowBox[{
       RowBox[{"ConstrainFoldDirection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeGraphFoldAngles", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", "tobj"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "make", " ", "a", " ", "copy", " ", "to", " ", "work", " ", "on"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj1", ",", "TPlaneGraph"}], "]"}]}], ",", 
       RowBox[{"tobj1", "=", 
        RowBox[{"tobj1", "//", "RebuildPlaneGraph"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faspecs1", "=", "faspecs"}], ";", " ", 
     RowBox[{"(*", " ", "ditto", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"iverts", ",", "bedges", ",", "vei"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{
         "InteriorVertices", ",", "BoundaryEdges", ",", 
          "VertexEdgeIncidence"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "groom", " ", "the", " ", "specs", " ", "by", " ", "setting", " ", 
       "all", " ", "boundary", " ", "edges", " ", "to", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "faspecs1", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "=", 
         RowBox[{"{", 
          RowBox[{"\[Infinity]", ",", "0"}], "}"}]}], ")"}], "&"}], "/@", 
      "bedges"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "make", " ", "lists", " ", "of", " ", "variables", " ", "and", " ", 
       "angles", " ", 
       RowBox[{"(", 
        RowBox[{"either", " ", "as", " ", "variable", " ", 
         RowBox[{"a", "[", "i", "]"}], " ", "or", " ", "value"}], ")"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"faspecs1", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]", 
           "\[Infinity]"}], ",", 
          RowBox[{"faspecs1", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"vars", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a", "[", "i", "]"}], ",", 
               RowBox[{"faspecs1", "\[LeftDoubleBracket]", 
                RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}]}],
             "]"}], ";", 
           RowBox[{"a", "[", "i", "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "faspecs1", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vea", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "angles", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "vei"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "dihedral", " ", "angles", " ", "around", " ", "each", " ", "vertex"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vfa", "=", 
      RowBox[{"VertexEdgeAngles", "[", "tobj1", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "sector", " ", "angles", " ", "around", " ", "each", " ", "vertex"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "generalized", " ", "Kawasaki", " ", "condition", " ", "matrices", " ", 
       "on", " ", "each", " ", "interior", " ", "vertex"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"krms", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"VertexConsistencyMatrix3D", "[", 
         RowBox[{
          RowBox[{"vea", "\[LeftDoubleBracket]", 
           RowBox[{
           "iverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], ",", 
          RowBox[{"vfa", "\[LeftDoubleBracket]", 
           RowBox[{
           "iverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "iverts", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kcons", "=", 
      RowBox[{"And", "@@", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             "0"}], ",", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             "0"}], ",", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             "0"}], ",", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ">", "0"}], 
            ",", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], ">", "0"}], 
            ",", 
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}], ">", 
             "0"}]}], "}"}], "&"}], "/@", "krms"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "figure", " ", "of", " ", "merit", " ", "on", " ", "goal", " ", 
       "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fom", "=", 
      RowBox[{"Plus", "@@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"faspecs1", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", "0", ",",
            "0", ",", "\[Infinity]", ",", "0", ",", "_", ",", 
           RowBox[{
            RowBox[{"faspecs1", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "i", "]"}], "-", 
               RowBox[{"faspecs1", "\[LeftDoubleBracket]", 
                RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], ")"}], 
             "2"]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "faspecs1", "]"}]}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"bounds", " ", "on", " ", "angle", " ", "variables"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bcons", "=", 
      RowBox[{"And", "@@", 
       RowBox[{"If", "[", 
        RowBox[{"bfd", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LessEqual]", 
             RowBox[{"(", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 "<", "0"}], ",", "0", ",", "\[Pi]"}], "]"}], ")"}]}], "&&", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[GreaterEqual]", 
             RowBox[{"(", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 ">", "0"}], ",", "0", ",", 
                RowBox[{"-", "\[Pi]"}]}], "]"}], ")"}]}]}], "&"}], "/@", 
          "vars"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LessEqual]",
              "\[Pi]"}], "&&", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[GreaterEqual]", 
             RowBox[{"-", "\[Pi]"}]}]}], "&"}], "/@", "vars"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "solve", " ", "for", " ", "all", " ", "unknown", " ", "angles"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"val", ",", "soln"}], "}"}], "=", 
      RowBox[{"FindMinimum", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fom", ",", 
          RowBox[{"kcons", "&&", "bcons"}]}], "}"}], ",", "vars"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"angles", "/.", "soln"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594166504827429*^9, 3.594166522263494*^9}, {
   3.594213509036315*^9, 3.594213582506916*^9}, {3.594213613973609*^9, 
   3.59421367788879*^9}, 3.594219292144576*^9, {3.594219359386114*^9, 
   3.594219384905662*^9}, {3.594219512010447*^9, 3.594219536480199*^9}, {
   3.594219619262066*^9, 3.5942196507710047`*^9}, {3.594220542190084*^9, 
   3.59422064138447*^9}, 3.594220724743958*^9, {3.594220933077259*^9, 
   3.594221002811234*^9}, {3.594221059607385*^9, 3.59422107893524*^9}, {
   3.594221152519281*^9, 3.594221266512619*^9}, {3.5942231102251577`*^9, 
   3.594223458834558*^9}, {3.594223495338255*^9, 3.594223516352933*^9}, 
   3.594223699685849*^9, {3.594223745779313*^9, 3.5942237502566032`*^9}, {
   3.594223840521133*^9, 3.594223878032714*^9}, {3.594224082640031*^9, 
   3.59422412233297*^9}, {3.594224306758841*^9, 3.5942244025988197`*^9}, {
   3.594225121741149*^9, 3.594225159922507*^9}, {3.5942251974679832`*^9, 
   3.594225424897064*^9}, {3.594225478028179*^9, 3.594225493845566*^9}, {
   3.59422552714634*^9, 3.594225529617701*^9}, {3.594225570775505*^9, 
   3.594225688005159*^9}, {3.594225719768549*^9, 3.594225764026833*^9}, {
   3.594225821406042*^9, 3.594225961017916*^9}, {3.594225993260285*^9, 
   3.594225997141374*^9}, 3.594226034055582*^9, {3.594226075880003*^9, 
   3.594226087638615*^9}, {3.594226714252437*^9, 3.594226761435913*^9}, {
   3.594226873542024*^9, 3.594226891290152*^9}, {3.594226924858087*^9, 
   3.594226928240445*^9}, {3.594227103007304*^9, 3.594227105313487*^9}, {
   3.59422716070134*^9, 3.594227174887269*^9}, {3.594227221847235*^9, 
   3.594227262086753*^9}, {3.594227387424219*^9, 3.594227428859672*^9}, {
   3.59422818583595*^9, 3.5942282174767647`*^9}, {3.5942283142436333`*^9, 
   3.594228314853009*^9}, {3.5942283847343807`*^9, 3.59422856080562*^9}, 
   3.594303353929591*^9, 3.594857356937538*^9, 3.59598295039937*^9, 
   3.626460380498494*^9, 3.708400177905612*^9, 3.708603656884179*^9},
 CellLabel->
  "In[1437]:=",ExpressionUUID->"039ba5a3-5ce9-4fec-a84c-a2e89b046a6d"],

Cell["Example", "Text",
 CellChangeTimes->{{3.594166531242134*^9, 
  3.594166531897684*^9}},ExpressionUUID->"26ba744c-ab2d-43ef-a6bf-\
98c5aae77f85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "tobj", ",", "faspecs", ",", "gmj", ",", 
      "gmn", ",", "foldangles", ",", "tobj1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"faspecs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"90", " ", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"-", "90"}], " ", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"90", " ", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"90", " ", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"90", " ", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"-", "90"}], " ", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"90", " ", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "faspecs", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "=", 
      
      RowBox[{"{", 
       RowBox[{"\[Infinity]", ",", 
        RowBox[{"100.", "\[Degree]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"fix", " ", "one", " ", "angle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"MakeGraphFoldAngles", "[", 
       RowBox[{"tobj", ",", "faspecs"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"solve", " ", "for", " ", "remaining", " ", "angles"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"FoldAngleSpecGraphics", "[", 
       RowBox[{"tobj", ",", "faspecs"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "/", "\[Degree]"}]}]}], "\[IndentingNewLine]", 
