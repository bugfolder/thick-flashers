Cell[CellGroupData[{

Cell[TextData[{
 "SkewQuadrilateralAngleAlt[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.701270612596148*^9, 3.701270671861908*^9}, {
  3.80633311400272*^9, 
  3.806333114317691*^9}},ExpressionUUID->"7a70ffdd-f618-4318-a8ae-\
d30c750bd7a2"],

Cell[TextData[{
 "SkewQuadrilateralAngleAlt[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "] takes the vertices of a skew quadrilateral in cyclic form and returns the \
fold angle along the ",
 StyleBox["p",
  FontSlant->"Italic"],
 "-",
 StyleBox["r",
  FontSlant->"Italic"],
 " diagonal, but it uses ArcTanAlt so as to avoid the 4-quadrant ArcTan \
function. Useful if you\[CloseCurlyQuote]re going to be doing further \
algebraic simplifications."
}], "Text",
 CellChangeTimes->{{3.701270650150475*^9, 3.70127072932717*^9}, {
  3.806333119028405*^9, 
  3.8063331610190697`*^9}},ExpressionUUID->"6e145071-9b1a-45a0-9bfd-\
a2bde78a0a4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SkewQuadrilateralAngleAlt", "[", 
   RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qp", ",", "rp", ",", "sp"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qp", ",", "rp", ",", "sp"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"q", "-", "p"}], ",", 
        RowBox[{"r", "-", "p"}], ",", 
        RowBox[{"s", "-", "p"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ArcTanAlt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qp", "\[Cross]", "rp"}], ")"}], ".", 
        RowBox[{"(", 
         RowBox[{"rp", "\[Cross]", "sp"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"qp", "\[Cross]", "rp"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{"rp", "\[Cross]", "sp"}], ")"}]}], ".", "rp"}], "/", 
        RowBox[{"Mag", "[", "rp", "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.701270558302025*^9, 3.701270624165368*^9}, {
  3.701271848854939*^9, 3.701271992488556*^9}, {3.8063331663035297`*^9, 
  3.806333171516401*^9}},
 CellLabel->
  "In[671]:=",ExpressionUUID->"a989ec4c-df40-4e4a-b5c0-e868b8d1999e"],

