       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v4", "-", "v1"}], ")"}], "\[Cross]", "u1"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v1", "-", "v4"}], ")"}], "\[Cross]", "u2"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v2", "-", "v3"}], ")"}], "\[Cross]", "u3"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v3", "-", "v2"}], ")"}], "\[Cross]", "u4"}]}], "}"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Vertices", " ", "of", " ", "the", " ", "hinge", " ", "polyhedron"}], 
