Cell[TextData[{
 "Polygon3DPlanarQ[",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PlanarTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.4590350231838264`*^9, 3.459035065405244*^9}, {
   3.45903530143064*^9, 3.459035314868665*^9}, {3.459037782715069*^9, 
   3.459037792184366*^9}, {3.708342228707155*^9, 3.708342229771671*^9}, 
   3.708401077726989*^9, 
   3.708602707682036*^9},ExpressionUUID->"4de33936-e08b-432b-91dc-\
aab926287bd1"],

Cell[TextData[{
 "Polygon3DPlanarQ[",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns true if a 3D polygon is planar, by which we mean that all of the \
vertices lie within a specified distance of the plane defined by the first \
three vertices. "
}], "Text",
 CellChangeTimes->{{3.4590350577417994`*^9, 3.459035133912177*^9}, {
   3.708343100966356*^9, 3.70834310615126*^9}, {3.708401585328558*^9, 
   3.708401586404725*^9}, {3.708598756351305*^9, 3.7085987685577927`*^9}, 
   3.708602707742065*^9},ExpressionUUID->"208b53d9-e3aa-40d4-a11c-\
67edb2cd9556"],

Cell[TextData[{
 "Options:\n\tPlanarTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the allowed distance of any point from the plane defined by the first \
three."
}], "Text",
 CellChangeTimes->{{3.708598758560638*^9, 3.708598761005827*^9}, {
  3.708598932643406*^9, 
  3.708598939387362*^9}},ExpressionUUID->"19723763-4d3f-45df-bb7d-\
118e435b97d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlanarTolerance", "::", "usage"}], 
   "=", "\"\<PlanarTolerance is an option used in Polygon3DPlanarQ to specify \
the tolerance on whether the points in a polygon are planar\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.708343255706184*^9, 3.708343296131734*^9}, 
   3.708602707768463*^9},
 CellLabel->
  "In[673]:=",ExpressionUUID->"97ab1df6-a617-4831-8459-4d1ddaab0687"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Polygon3DPlanarQ", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PlanarTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.459035187305804*^9, 3.459035207527016*^9}, 
   3.70834223068509*^9, 3.708602707795007*^9},
 CellLabel->
  "In[674]:=",ExpressionUUID->"28307b3f-0993-4638-a66a-a4ec7620119b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Polygon3DPlanarQ", "[", 
   RowBox[{"poly_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ptol", ",", "p", ",", "z"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"ptol", "=", 
      RowBox[{
       RowBox[{"PlanarTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Polygon3DPlanarQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "poly", "]"}], "<", "3"}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "poly", "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{"Return", "[", "True", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
          RowBox[{"poly", "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ")"}], "\[Cross]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{
      "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"And", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "-", "p"}], ")"}], ".", "z"}], "]"}], "\[LessEqual]",
            "ptol"}], "&"}], "/@", 
         RowBox[{"Drop", "[", 
          RowBox[{"poly", ",", "1"}], "]"}]}], ")"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.459035144583585*^9, 3.459035174489834*^9}, {
   3.459035227414954*^9, 3.459035279380089*^9}, {3.459035330848859*^9, 
   3.459035491619948*^9}, {3.459035550806983*^9, 3.459035561249974*^9}, {
   3.459035664281507*^9, 3.459035668225129*^9}, {3.45903757594617*^9, 
   3.45903757721624*^9}, 3.708342231571127*^9, {3.708408154085499*^9, 
   3.708408158255297*^9}, {3.708598784826506*^9, 3.708598809803492*^9}, {
   3.708602707822481*^9, 3.708602707843188*^9}},
 CellLabel->
  "In[675]:=",ExpressionUUID->"f821f872-b0b9-4b5c-ad77-2adef7f4bffd"],

