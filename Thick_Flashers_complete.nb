Cell[CellGroupData[{

Cell["CP/FF equivalence", "Subsubsection",
 CellChangeTimes->{{3.6300224059901443`*^9, 3.630022406474575*^9}, {
  3.707773226674821*^9, 
  3.707773232402279*^9}},ExpressionUUID->"ff6cd72f-04c5-43b9-9978-\
0e9e327baf4e"],

Cell[TextData[{
 "In this section we generate TGraphAssigned and TGraph2DAssigned tiles for \
the crease pattern and (ostensible) folded form tile of general simple flat \
twist tiles. If the crease pattern is flat-foldable (not necessarily the case \
for all parameters), then the folded form tile is geometrically similar to a \
crease pattern tile with different {",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau]} parameters, and we can use that fact to compute an equivalent \
tile for the folded form."
}], "Text",
 CellChangeTimes->{{3.630022424612855*^9, 3.630022514254292*^9}, {
  3.630109521138479*^9, 3.630109547968986*^9}, {3.707838183219657*^9, 
  3.7078381852012997`*^9}},ExpressionUUID->"e1e2545c-4d46-4329-ab55-\
23d4cce0bb74"],

Cell[TextData[{
 "Here we compute equivalent {",
 StyleBox["w",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote], ",
 StyleBox["d",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote], \[Tau]\[CloseCurlyQuote]} parameters for a folded form \
tile. Line OABP is the original tile edge. Line OACP\[CloseCurlyQuote] is the \
folded image of the edge. Line OP\[CloseCurlyQuote] is the folded form tile \
edge; distances and angles are computed relative to it."
}], "Text",
 CellChangeTimes->{{3.630020406334034*^9, 3.6300204218039722`*^9}, {
  3.630021352087652*^9, 3.630021377341976*^9}, {3.630024755382943*^9, 
  3.630024816931074*^9}, {3.6301095578712606`*^9, 
  3.630109560046626*^9}},ExpressionUUID->"6fd94e95-e2ad-4eff-be2d-\
cfe95925c875"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "O", ",", "A", ",", "B", ",", "C", ",", "P", ",", "Pp", ",", "Ap", ",", 
      "Bp", ",", "\[Tau]p", ",", "soln", ",", "ex"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"O", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"1", "-", "w"}], "2"], "+", "d"}], ",", "0"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"B", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"1", "+", "w"}], "2"], "+", "d"}], ",", "0"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"P", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"C", "=", 
      RowBox[{"B", "+", 
       RowBox[{"2", " ", "w", " ", 
        RowBox[{"Sin", "[", "\[Tau]", "]"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Tau]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Pp", "=", 
      RowBox[{"P", "+", 
       RowBox[{"2", " ", "w", " ", 
        RowBox[{"Sin", "[", "\[Tau]", "]"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Tau]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Ap", "=", 
      RowBox[{"LineInt2D", "[", 
       RowBox[{"O", ",", 
        RowBox[{"Pp", "-", "O"}], ",", "A", ",", 
        RowBox[{"U", "[", "\[Tau]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Bp", "=", 
      RowBox[{"LineInt2D", "[", 
       RowBox[{"O", ",", 
        RowBox[{"Pp", "-", "O"}], ",", "C", ",", 
        RowBox[{"U", "[", "\[Tau]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "equivalent", " ", "tilt", " ", "angle", " ", "for", " ", "folded", " ",
        "form"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Tau]p", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{
          RowBox[{"U", "[", 
           RowBox[{"\[Tau]", "-", 
            FractionBox["\[Pi]", "2"]}], "]"}], ".", 
          RowBox[{"(", 
           RowBox[{"Pp", "-", "O"}], ")"}]}], 
         RowBox[{
          RowBox[{"U", "[", "\[Tau]", "]"}], ".", 
          RowBox[{"(", 
           RowBox[{"Pp", "-", "O"}], ")"}]}]], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[Tau]' = \>\"", ",", "\[Tau]p"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"1", "-", "wp"}], "2"], "+", "dp"}], "\[Equal]", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Ap", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Pp", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]]}], ",", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"1", "+", "wp"}], "2"], "+", "dp"}], "\[Equal]", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Bp", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Pp", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"wp", ",", "dp"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<w' = \>\"", ",", 
       RowBox[{"wp", "/.", 
        RowBox[{
        "soln", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
       ",", "\"\<, d' = \>\"", ",", 
       RowBox[{"dp", "/.", 
        RowBox[{
        "soln", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "and", " ", "show", " ", "a", " ", "plot", " ", "of", " ", "the", " ", 
       "geometry"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ex", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", "\[Rule]", "0.15"}], ",", 
        RowBox[{"d", "\[Rule]", 
         RowBox[{"-", "0.08"}]}], ",", 
        RowBox[{"\[Tau]", "\[Rule]", 
         RowBox[{"70", "\[Degree]"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"Black", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"O", ",", "P"}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         "Gray", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"A", ",", 
            RowBox[{"A", "+", 
             RowBox[{".5", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}]}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"B", ",", 
            RowBox[{"B", "+", 
             RowBox[{".5", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}]}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"C", ",", 
            RowBox[{"C", "+", 
             RowBox[{".5", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "Orange", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"O", ",", "Pp"}], "}"}], "]"}], ",", "\[IndentingNewLine]",
          "Green", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"A", ",", "C", ",", "Pp"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "LightGray", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"B", ",", "C"}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"P", ",", "Pp"}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"C", "-", 
             RowBox[{".1", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}], ",", "C"}], "}"}], "]"}],
          ",", "\[IndentingNewLine]", "Black", ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "O", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<O\>\"", ",", "O", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "A", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<A\>\"", ",", "A", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "B", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<B\>\"", ",", "B", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "C", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<C\>\"", ",", "C", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "P", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<P\>\"", ",", "P", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "Pp", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<P'\>\"", ",", "Pp", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "Ap", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<A'\>\"", ",", "Ap", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "Bp", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<B'\>\"", ",", "Bp", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", "ex"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.630020424958363*^9, 3.630020540038734*^9}, {
  3.63002059188645*^9, 3.630020628065912*^9}, {3.630020669721859*^9, 
  3.630020799971037*^9}, {3.63002087382824*^9, 3.630021159997768*^9}, {
  3.630021218817221*^9, 3.630021343337463*^9}, {3.630021388400156*^9, 
  3.630021653690465*^9}, {3.630021690570806*^9, 3.6300218282901897`*^9}, {
  3.630021862761198*^9, 3.630021895884468*^9}, {3.6300220704277782`*^9, 
  3.630022074265605*^9}, {3.630024769700156*^9, 3.630024770320522*^9}, {
  3.630024844131455*^9, 3.63002487503756*^9}, {3.630024943368085*^9, 
  3.630024968495821*^9}},
 CellLabel->
  "In[2869]:=",ExpressionUUID->"5bf6b838-4bbe-4615-a2f9-cff33e05d862"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RenderTile[{PolygonTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629826786712953*^9, 3.629826826093027*^9}, 
   3.629846604563611*^9, 3.630018824387566*^9, 3.630018928902079*^9, 
   3.630019023812483*^9, 
   3.70783820012084*^9},ExpressionUUID->"ad39db9f-3286-4f17-a0ae-\
f909cbd951f9"],

Cell[TextData[{
 "RenderTile[{PolygonTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraphAssigned+TTwistGraph that describes the creases for a \
twist in polygon specified by its vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \[Tau] \
is the pleat angle, defined as the rotation angle of the pleat measured with \
respect to the edge, d is the offset from the center of the edge, ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 " is a flag indicating whether the pleat crease assignment should assume a \
CCW twist, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
   3.457740055563382*^9}, {3.457899240889505*^9, 3.457899262921368*^9}, {
