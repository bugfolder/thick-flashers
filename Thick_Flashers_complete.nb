Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTachiMiuraPolyhedronGraphics3D", "[", 
   RowBox[{"\[Beta]0_", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]0_", ",", " ", "\[Gamma]_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"d1_", ",", "d2_", ",", "d3_"}], "}"}], ",", " ", "w_", ",", 
    "nw_", ",", " ", "opts___"}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sg", ",", "pts", ",", "tobj1", ",", "tobj2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sg", "=", 
      RowBox[{
       RowBox[{"StackGap", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "MakeTachiMiuraPolyhedronGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"d1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"pts", ",", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"d2", " ", 
         RowBox[{"U", "[", 
          RowBox[{"-", "\[Beta]0"}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"pts", ",", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"{", 
         RowBox[{"d3", ",", "0"}], "}"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"pts", ",", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"d2", " ", 
         RowBox[{"U", "[", "\[Beta]0", "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"pts", ",", 
       RowBox[{
        RowBox[{"pts", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"{", 
         RowBox[{"d1", ",", "0"}], "}"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"Line", "[", "pts", "]"}], ",", 
         RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "]"}], "//", "Hold"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"MakeSemigeneralizedMiuraOriP", "[", 
       RowBox[{"pts", ",", "w", ",", "nw", ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]0", ",", "\[Gamma]"}], "}"}], ",", "opts"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"bottom", " ", "layer"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"VertexRotateGraph3D", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"tobj1", "[", "CornerIndices", "]"}], "]"}], ",", "3"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"MakeSemigeneralizedMiuraOriP", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}], "#"}], "&"}], "/@", "pts"}], ",", 
        "w", ",", "nw", ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]0", ",", "\[Gamma]"}], "}"}], ",", "opts"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"top", " ", "layer"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"TranslateGraph3D", "[", 
       RowBox[{
        RowBox[{"VertexRotateGraph3D", "[", 
         RowBox[{"tobj2", ",", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"tobj2", "[", "CornerIndices", "]"}], "]"}], ",", "3"}], 
           "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{"sg", " ", "d1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj1", "]"}], "\[LeftDoubleBracket]",
          "1", "\[RightDoubleBracket]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj2", "]"}], "\[LeftDoubleBracket]",
          "1", "\[RightDoubleBracket]"}]}], "}"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.643293495901162*^9, 3.643293499593188*^9}, {
  3.643293695201282*^9, 3.643293783323121*^9}, {3.643293814482531*^9, 
  3.643293970119419*^9}, {3.64329400300572*^9, 3.643294141918645*^9}, {
  3.643294177234329*^9, 3.643294310334565*^9}, {3.643294395437025*^9, 
  3.64329439619811*^9}, {3.643294446441383*^9, 3.643294450769844*^9}, {
  3.64329454054713*^9, 3.643294543778994*^9}},
 CellLabel->
  "In[2559]:=",ExpressionUUID->"8dfb705e-5bdf-4acd-9fb9-59389e8f7194"],

