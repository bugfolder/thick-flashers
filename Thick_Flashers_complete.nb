Cell[TextData[{
 "BoundingBoxGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] returns the bounding box of all the points in any GraphicsComplexes in \
the list."
}], "Text",
 CellChangeTimes->{{3.713170720331253*^9, 3.713170725005186*^9}, {
  3.713170890751145*^9, 
  3.713170910899473*^9}},ExpressionUUID->"49483a09-c205-456a-afdf-\
182d7b59d9ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BoundingBoxGC", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gcs", ",", "pts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gcs", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"expr", ",", "_GraphicsComplex", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Join", "@@", 
       RowBox[{"(", 
        RowBox[{"First", "/@", "gcs"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"BoundingBox", "[", "pts", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.713170991153635*^9, 3.713171064012686*^9}, {
  3.713171157890274*^9, 3.713171204259004*^9}, {3.71382661961779*^9, 
