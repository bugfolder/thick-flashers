Cell[TextData[{
 "RotationAnglePositive[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 "] does the same thing as RotationAngle[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 "], but maps the angle to the range [0, 2\[Pi]]."
}], "Text",
