   3.694202548125844*^9},ExpressionUUID->"ea3132a2-3a9c-4002-8a12-\
370dc6b3ccac"],

Cell[TextData[{
 "Dashify[",
 StyleBox["expr, opts",
  FontSlant->"Italic"],
 "] takes an object and replaces all  Lines with DashedLine structures."
}], "Text",
 CellChangeTimes->{{3.456002677202252*^9, 3.456002701794362*^9}, {
  3.456529236092882*^9, 3.456529237082835*^9}, {3.694200788718495*^9, 
  3.694200796708979*^9}},ExpressionUUID->"07f3f9ad-e33b-4752-a3bd-\
0b26fa9e9a74"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any collection of Graphics elements.\n\t",
 StyleBox["styles",
  FontSlant->"Italic"],
 " \[LongDash] a list of styles to receive dashification."
}], "Text",
 CellChangeTimes->{{3.6942007345158777`*^9, 
  3.694200791422954*^9}},ExpressionUUID->"3095453f-86dc-4ee7-ba84-\
326eef2cbff0"],

Cell["\<\
Options:
\tDashPattern, JustifyDashing, MinimumDashLength are passed through to \
DashedLine.\
\>", "Text",
 CellChangeTimes->{{3.694200799539528*^9, 
  3.694200820755873*^9}},ExpressionUUID->"133c941d-115f-435e-97a4-\
82e3a6578cc9"],

Cell["\<\
Returns expr with all Lines replaced by dashed lines, composed of discrete \
Lines for the dashes.\
\>", "Text",
 CellChangeTimes->{{3.6942008252915497`*^9, 3.694200862108131*^9}, {
  3.694200918908128*^9, 
  3.694200931964349*^9}},ExpressionUUID->"d9c77cf1-9ae4-49f8-b90a-\
3b6ba8fbdbdd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Dashify", "[", 
   RowBox[{"obj_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"obj", "/.", 
   RowBox[{
    RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", 
    RowBox[{"DashedLine", "[", 
     RowBox[{"x", ",", "opts"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.456002735512948*^9, 3.4560027730022163`*^9}},
 CellLabel->
  "In[842]:=",ExpressionUUID->"4251891b-3991-459f-92cc-6ce987cf4e0a"],

Cell[TextData[{
 "DashifyByStyle[",
 StyleBox["expr, styles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes an object and Dashifies all lines of the given style (typically a \
style name)."
}], "Text",
 CellChangeTimes->{{3.4560842142316847`*^9, 3.456084241262004*^9}, {
  3.694200879197687*^9, 
  3.694200881172484*^9}},ExpressionUUID->"5fe706af-4f8f-48e3-bfd6-\
cb86f57df4b4"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any collection of Graphics elements.\n\t",
 StyleBox["styles",
  FontSlant->"Italic"],
 " \[LongDash] a list of styles to receive dashification."
}], "Text",
 CellChangeTimes->{{3.6942007345158777`*^9, 
  3.694200791422954*^9}},ExpressionUUID->"ab72c8b7-c3d6-4fdb-bba0-\
5ab96d63e52f"],

Cell["\<\
Options:
\tDashPattern, JustifyDashing, MinimumDashLength are passed through to \
DashedLine.\
\>", "Text",
 CellChangeTimes->{{3.694200799539528*^9, 
  3.694200820755873*^9}},ExpressionUUID->"152250cb-a8a8-4109-811f-\
3273a11b7d9d"],

Cell[TextData[{
 "Returns ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " with all Lines of the specified styles replaced by dashed lines, composed \
of discrete Lines for the dashes."
}], "Text",
 CellChangeTimes->{{3.6942008252915497`*^9, 3.6942008928443613`*^9}, 
   3.694200941280168*^9},ExpressionUUID->"dbbf3487-9cd2-4458-9869-\
375905d92d7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DashifyByStyle", "[", 
   RowBox[{"obj_", ",", "styles_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"obj", "/.", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"x_", ",", "#"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"x", "/.", 
          RowBox[{
           RowBox[{"Line", "[", "y_", "]"}], "\[RuleDelayed]", 
           RowBox[{"DashedLine", "[", 
            RowBox[{"y", ",", "opts"}], "]"}]}]}], ",", "#"}], "]"}]}], "&"}],
      "/@", "styles"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.456067800761035*^9, 3.456067802117969*^9}, {
  3.456084251694978*^9, 3.456084289629756*^9}, {3.456181654036677*^9, 
  3.456181681869851*^9}},
 CellLabel->
  "In[843]:=",ExpressionUUID->"8b59a9e5-f4d9-464f-a638-39e84977f64d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "GapLine[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) GapLength, GapPosition"
}], "Subsubsection",
 CellChangeTimes->{{3.456527541051968*^9, 3.456527547803153*^9}, {
  3.456527640797475*^9, 3.456527700744907*^9}, {3.456527750549804*^9, 
  3.456527751069665*^9}, {3.467046384399312*^9, 
  3.467046386102584*^9}},ExpressionUUID->"74a81afd-51d6-4561-a5fb-\
b422702aaeac"],

Cell[TextData[{
 "GapLine[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points that defines a segmented line and removes a \
specified amount from the end of the first and/or last segment of the line. \
This is useful in scored patterns to prevent score lines from converging at a \
point and weakening it unnecessarily. Options are:\n\tGapLength\[Rule]",
 StyleBox["len",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["len",
  FontSlant->"Italic"],
 " is the length of the gap in current coordinates.\n\t\
GapLocation\[Rule]Front | Back | Both, which specifies which end of the line \
to place the gap at.\nNote that if the first or last segment is shorter than \
the specified gap, it is simply eliminated {we return an empty list}. We \
don't extend the gap across multiple segments."
}], "Text",
 CellChangeTimes->{{3.4565275494448557`*^9, 3.45652757058571*^9}, {
  3.456527651612399*^9, 3.456527673963109*^9}, {3.456527706600576*^9, 
  3.456527739838408*^9}, {3.45652777033335*^9, 3.45652787794888*^9}, {
  3.456531321947044*^9, 
  3.456531327809061*^9}},ExpressionUUID->"2528ea5a-9ed6-4bc9-9aff-\
6ce72d299b1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GapLength", "::", "usage"}], 
   "=", "\"\<GapLength is an options to GapLine that specifies the gap length \
to leave at the beginning and/or end of a line.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592041533509756*^9, 3.592041559195731*^9}},
 CellLabel->
  "In[844]:=",ExpressionUUID->"073ee696-2d9d-438c-9724-fbfa83c7a981"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GapPosition", "::", "usage"}], 
   "=", "\"\<GaphPosition is an option to GapLine that specifies which end of \
the line a gap should be placed at.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592041562181788*^9, 3.592041604014306*^9}},
 CellLabel->
  "In[845]:=",ExpressionUUID->"52b7138a-bc2c-4053-b25c-0b34aff3bc09"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Both", "::", "usage"}], 
   "=", "\"\<Both is a value for option GapPosition that specifies to leave \
gaps at both ends of the line.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592041606632502*^9, 3.59204162834929*^9}},
 CellLabel->
  "In[846]:=",ExpressionUUID->"de25b686-8b6a-447b-8413-c8f56d4bce71"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GapLine", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GapLength", "\[Rule]", "0.05"}], ",", "\[IndentingNewLine]", 
     RowBox[{"GapPosition", "\[Rule]", "Both"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456527743974792*^9, 3.456527794615901*^9}, {
  3.456527906077941*^9, 3.456527906782002*^9}},
 CellLabel->
  "In[847]:=",ExpressionUUID->"caf74ea7-7d3c-4aee-bc78-c933d099c621"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GapLine", "[", 
   RowBox[{"pts_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gl", ",", "gp", ",", 
      RowBox[{"p", "=", "pts"}], ",", "sl"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gl", "=", 
      RowBox[{
       RowBox[{"GapLength", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GapLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gp", "=", 
      RowBox[{
       RowBox[{"GapPosition", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GapLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gp", "===", "Front"}], "||", 
        RowBox[{"gp", "===", "Both"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"sl", "=", 
             RowBox[{"Mag", "[", 
              RowBox[{
               RowBox[{
               "p", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
               RowBox[{
               "p", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
              "]"}]}], ")"}], "<", "gl"}], ",", 
          RowBox[{"p", "=", 
           RowBox[{"DropFirst", "[", "p", "]"}]}], ",", 
          RowBox[{"p", "=", 
           RowBox[{"ReplacePart", "[", 
            RowBox[{"p", ",", 
             RowBox[{"1", "\[Rule]", 
              RowBox[{
               RowBox[{
               "p", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "+", 
               RowBox[{
                FractionBox[
                 RowBox[{"sl", "-", "gl"}], "sl"], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                  "p", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
                   "-", 
                  RowBox[{
                  "p", "\[LeftDoubleBracket]", "2", 
                   "\[RightDoubleBracket]"}]}], ")"}]}]}]}]}], "]"}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "p", "]"}], "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gp", "===", "Back"}], "||", 
        RowBox[{"gp", "===", "Both"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"sl", "=", 
             RowBox[{"Mag", "[", 
              RowBox[{
               RowBox[{"p", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "-", 
               RowBox[{"p", "\[LeftDoubleBracket]", 
                RowBox[{"-", "2"}], "\[RightDoubleBracket]"}]}], "]"}]}], 
            ")"}], "<", "gl"}], ",", 
          RowBox[{"p", "=", 
           RowBox[{"DropLast", "[", "p", "]"}]}], ",", 
          RowBox[{"p", "=", 
           RowBox[{"ReplacePart", "[", 
            RowBox[{"p", ",", 
             RowBox[{
              RowBox[{"-", "1"}], "\[Rule]", 
              RowBox[{
               RowBox[{"p", "\[LeftDoubleBracket]", 
                RowBox[{"-", "2"}], "\[RightDoubleBracket]"}], "+", 
               RowBox[{
                FractionBox[
                 RowBox[{"sl", "-", "gl"}], "sl"], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"p", "\[LeftDoubleBracket]", 
                   RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "-", 
                  RowBox[{"p", "\[LeftDoubleBracket]", 
                   RowBox[{"-", "2"}], "\[RightDoubleBracket]"}]}], 
                 ")"}]}]}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "p", "]"}], "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"Line", "[", "p", "]"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.456527885478247*^9, 3.456528353643981*^9}, {
  3.456528599470046*^9, 3.45652871028633*^9}, {3.456528795091497*^9, 
  3.456528813134943*^9}, {3.456528875676887*^9, 3.456528948783337*^9}, {
  3.456528979120106*^9, 3.456529016111904*^9}, {3.4565290472736197`*^9, 
  3.4565290543900948`*^9}, {3.456531277505749*^9, 3.456531281040646*^9}},
 CellLabel->
  "In[848]:=",ExpressionUUID->"ecbf7c01-31b6-42b6-931d-7231a71e7939"],

Cell["\<\
Example, showing default, gaps and front and back, and what happens if the \
segment is too short.\
\>", "Text",
 CellChangeTimes->{{3.45652836966953*^9, 3.4565283703080387`*^9}, {
  3.456529131803153*^9, 
  3.4565291440806713`*^9}},ExpressionUUID->"c9e661fd-bf4d-4821-8bdd-\
c55c329054c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"AbsoluteThickness", "[", "5", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GapLine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", ".2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{".5", ",", ".2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", ".2"}], "}"}]}], "}"}], ",", 
         RowBox[{"GapLength", "\[Rule]", "0.2"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GapLine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", ".4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{".5", ",", ".4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", ".4"}], "}"}]}], "}"}], ",", 
         RowBox[{"GapLength", "\[Rule]", "0.3"}], ",", 
         RowBox[{"GapPosition", "\[Rule]", "Front"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GapLine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", ".6"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{".5", ",", ".6"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", ".6"}], "}"}]}], "}"}], ",", 
         RowBox[{"GapLength", "\[Rule]", "0.3"}], ",", 
         RowBox[{"GapPosition", "\[Rule]", "Back"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GapLine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0.45", ",", ".8"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.55", ",", ".8"}], "}"}]}], "}"}], ",", 
         RowBox[{"GapLength", "\[Rule]", "0.2"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "]"}]}], 
      "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], "//", "ShowExample"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.456528376008757*^9, 3.456528469129681*^9}, {
  3.456528738019787*^9, 3.456528787039119*^9}, {3.456529026857665*^9, 
  3.456529111146655*^9}, {3.45653129791682*^9, 3.456531334586025*^9}},
 CellLabel->
  "In[849]:=",ExpressionUUID->"c73aa3e4-b2e6-4c38-ab6a-2bf8d70e7ad7"]
}, Closed]],

