Cell[TextData[{
 "Curve2DSystemPlots[",
 StyleBox["sys",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", u",
 StyleBox["1",
  FontSlant->"Italic"],
 "}] returns a list of plots of all of the functions returned by \
Curve2DSystem (and related functions below) over the range {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.6911973127637253`*^9, 3.691197373210198*^9}, {
