Cell[CellGroupData[{

Cell["Fold angles from assignment and reassignment", "Subsection",
 CellChangeTimes->{{3.594305732971164*^9, 3.594305738193214*^9}, {
   3.594309850234253*^9, 3.5943098523272*^9}, {3.594568172606215*^9, 
   3.594568178028151*^9}, 3.594598630515073*^9, {3.5946624452749987`*^9, 
   3.594662446902216*^9}},ExpressionUUID->"1aca3c5c-bcb4-4c03-9359-\
19a464719ccc"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.594726197613497*^9, 
  3.59472619813192*^9}},ExpressionUUID->"7d83d366-47f7-48d2-b671-\
b9b93c9243a7"],

Cell["\<\
For 2D folded forms, the crease assignment is the only specifier of fold \
direction. For 3D folded forms, though, we have the FoldAngles property, \
which is also a form of crease assignment. Functions in this section provide \
different ways of creating coherence between the EdgeTypes and FoldAngles \
properties.\
\>", "Text",
 CellChangeTimes->{{3.594726200100003*^9, 3.594726294869416*^9}, {
  3.594726414319572*^9, 
  3.594726438780659*^9}},ExpressionUUID->"132cf6ba-d18e-4437-bd84-\
96361b70edf9"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeStdFoldAngleSpecs[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph, TAssigned"
}], "Subsubsection",
 CellChangeTimes->{{3.594218233583758*^9, 3.594218256804689*^9}, {
   3.5942182947946577`*^9, 3.594218303362104*^9}, {3.594218432163856*^9, 
   3.594218439321296*^9}, {3.701379325403753*^9, 3.701379332266963*^9}, 
   3.701379447485374*^9},ExpressionUUID->"ac20f171-220c-4ee8-858e-\
6c8dd1dc84bd"],

Cell[TextData[{
 "MakeStdFoldAngleSpecs[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph+TAssigned and returns a \[OpenCurlyDoubleQuote]standard\
\[CloseCurlyDoubleQuote] list of fold angle specs that tries to set all \
valley folds to 90\[Degree], all mountain folds to -90\[Degree], all unfolded \
creases to 0\[Degree], and gives them all equal weights. All Border creases \
are set to 0\[Degree] and are given infinite weight. If you use this as the \
input to MakeGraphFoldAngles, the solution, if it exists, should be a \
consistent (developable) partially folded 3D form."
}], "Text",
 CellChangeTimes->{{3.594218262709598*^9, 3.594218407139525*^9}, 
   3.5942192924926*^9, 3.59422072532231*^9, {3.594223649561451*^9, 
   3.594223670045418*^9}, {3.594302747011823*^9, 
   3.594302747323675*^9}},ExpressionUUID->"1685eb83-9b3b-492a-8786-\
3d921705d34e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeStdFoldAngleSpecs", "::", "badtype"}], 
   "=", "\"\<`1` is not a valid fold type.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.594218990961645*^9, 3.594219012982449*^9}},
 CellLabel->
  "In[1818]:=",ExpressionUUID->"e8a5420e-53ce-4aff-97bc-e56824004755"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeStdFoldAngleSpecs", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj1", ",", "types", ",", "faspecs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph", ",", "TAssigned"}], "}"}], ",", 
       "MakeStdFoldAngleSpecs"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "EdgeTypes"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Switch", "[", 
        RowBox[{"#", ",", "B", ",", 
         RowBox[{"{", 
          RowBox[{"\[Infinity]", ",", "0"}], "}"}], ",", "M", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{
            RowBox[{"-", "90"}], "\[Degree]"}]}], "}"}], ",", "V", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"90", "\[Degree]"}]}], "}"}], ",", "U", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", "_", ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{"MakeStdFoldAngleSpecs", "::", "badtype"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], "&"}], "/@", "types"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.594218418997037*^9, 3.594218466755975*^9}, {
   3.594218531633148*^9, 3.594218540143319*^9}, {3.5942186498505*^9, 
   3.5942186644809113`*^9}, {3.594218724987124*^9, 3.594218755942108*^9}, {
   3.594218847358993*^9, 3.594218985972691*^9}, {3.594219019292331*^9, 
   3.594219114905589*^9}, 3.594223680019874*^9},
 CellLabel->
  "In[1819]:=",ExpressionUUID->"6aa91ecc-4cab-49fe-a191-b3a32777c500"],

