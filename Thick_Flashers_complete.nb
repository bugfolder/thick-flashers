Cell["Example. A circle.", "Text",
 CellChangeTimes->{{3.691197462986072*^9, 3.691197472516904*^9}, {
  3.7999172586503363`*^9, 
  3.799917259698487*^9}},ExpressionUUID->"01746fae-e424-4f11-a1d9-\
