Cell[TextData[{
 "StackYGC[",
 StyleBox["objs",
  FontSlant->"Italic"],
 "] takes a list of GraphicsComplex objects and stacks them in the \
y-direction so their bounding boxes are in contact."
}], "Text",
 CellChangeTimes->{{3.713828243362237*^9, 3.713828261921181*^9}, {
  3.713828309896644*^9, 
  3.7138283118882637`*^9}},ExpressionUUID->"9effed2e-2279-4388-a2e8-\
283c0621f30f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StackYGC", "[", "objs_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"yex", ",", "wids", ",", "objs1", ",", "offs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"yex", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        "&"}], "/@", 
       RowBox[{"BoundingBoxGC", "/@", "objs"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"y", "-", "extents"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"wids", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "-", 
         RowBox[{
         "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "&"}],
        "/@", "yex"}]}], ";", 
     RowBox[{"(*", " ", "widths", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"offs", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", "wids"}], "]"}]}], ";", 
     RowBox[{"(*", " ", "offsets", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "move", " ", "objects", " ", "to", " ", "all", " ", "start", " ", "at",
         " ", "y"}], "=", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FunctionTransform", "[", 
        RowBox[{
         RowBox[{
         "objs", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{
          RowBox[{"#", "+", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{
              "offs", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              "-", 
              RowBox[{"yex", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "+", 
              RowBox[{"yex", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ",", 
             "0"}], "}"}]}], "&"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "objs", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.713827023670388*^9, 3.713827082725931*^9}, {
