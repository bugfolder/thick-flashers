Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRadialPotWedge", "[", 
   RowBox[{"pts_List", ",", " ", "m_Integer", ",", " ", 
    RowBox[{"\[Rho]_", ":", "0"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Delta]", ",", "\[Epsilon]", ",", "pb", ",", "\[Phi]", ",", "cdt", ",",
       "fb", ",", "x", ",", "z", ",", "r", ",", "w", ",", "s", ",", "t", ",", 
      "v", ",", "u", ",", "n", ",", "a", ",", "b", ",", "c", ",", "d", ",", 
      "e", ",", "f", ",", "pts1", ",", "aa", ",", "bb", ",", "cc", ",", "dd", 
      ",", "ee", ",", "ff", ",", "soln", ",", "vv", ",", "vi", ",", "verts", ",",
       "verts3d", ",", "edges", ",", "types", ",", "addv", ",", "adde", ",", 
      "arcify", ",", "tobj", ",", "foldangles"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Delta]", "=", 
      RowBox[{
       RowBox[{"PotGapHalfAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRadialPotWedge", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]", "=", 
      RowBox[{
       RowBox[{"PotFlatFlangeInset", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRadialPotWedge", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{
       RowBox[{"PotBorder", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRadialPotWedge", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{
         "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        "&"}], "/@", "pts"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "z"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "pts1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cdt", "=", 
      RowBox[{"FoldAngleToType", "[", 
       RowBox[{"z", "\[LeftDoubleBracket]", 
        RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "fold", " ", "angle", " ", "of", " ", "c", " ", "and", " ", "d", " ", 
       "folds"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fb", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"z", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]", 
        RowBox[{"z", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
        ")"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"True", " ", "=", " ", 
       RowBox[{"flat", "-", 
        RowBox[{"bottom", " ", "condition"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"test", " ", "for", " ", "strict", " ", "monotonicity"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"zinc", " ", "=", " ", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RotateLeft", "[", "z", "]"}], "-", "z"}], ",", 
           RowBox[{"-", "1"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "zinc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]",
            "0"}], ",", 
          RowBox[{"zinc", "=", 
           RowBox[{"Drop", "[", 
            RowBox[{"zinc", ",", "1"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Union", "[", 
             RowBox[{"Sign", "/@", "zinc"}], "]"}], "]"}], ">", "1"}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"MakeRadialPotWedge", "::", "badpts"}], ",", "pts"}], 
            "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "r", " ", "is", " ", "distance", " ", "along", " ", "ctr", " ", "of", " ",
        "gore"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Accumulate", "[", 
         RowBox[{"Mag", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"pts", ",", "1"}], "]"}], "-", 
            RowBox[{"Drop", "[", 
             RowBox[{"pts", ",", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}]}], "]"}], ",", "0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"w", " ", "is", " ", "gore", " ", "half"}], "-", "width"}], ",",
        " ", 
       RowBox[{"accounting", " ", "for", " ", "gap", " ", "\[Delta]"}]}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"w", "=", 
      RowBox[{
       RowBox[{"Tan", "[", 
        RowBox[{"\[Phi]", "-", "\[Delta]"}], "]"}], "x"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"crease", " ", "pattern", " ", "points"}], ",", " ", 
       RowBox[{
        RowBox[{"lettered", " ", "starting", " ", "from", " ", "x"}], "-", 
        "axis"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", "0"}], "}"}], "&"}], "/@", "r"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"a", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"U", "[", 
            RowBox[{"\[Pi]", "/", "2"}], "]"}], "#"}], "&"}], "/@", "w"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"b", "+", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "[", "i", "]"}], 
          RowBox[{"U", "[", 
           RowBox[{"\[Pi]", "/", "2"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"U", "[", 
          RowBox[{"2", "\[Phi]"}], "]"}], "#"}], "&"}], "/@", "r"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"e", "=", 
      RowBox[{"f", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"U", "[", 
            RowBox[{
             RowBox[{"2", "\[Phi]"}], "-", 
             RowBox[{"\[Pi]", "/", "2"}]}], "]"}], "#"}], "&"}], "/@", "w"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"e", "+", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", "i", "]"}], 
          RowBox[{"U", "[", 
           RowBox[{
            RowBox[{"2", "\[Phi]"}], "-", 
            RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"folded", " ", "form", " ", "points"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"aa", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", "0", ",", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "}"}], "&"}], "/@", "pts1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"aa", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"U3D", "[", 
            RowBox[{"\[Pi]", "/", "2"}], "]"}], "#"}], "&"}], "/@", "w"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"bb", "+", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "[", "i", "]"}], 
          RowBox[{"U3D", "[", 
           RowBox[{
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{"\[Phi]", "-", "\[Delta]"}], ")"}]}], "-", 
            RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"U3D", "[", 
           RowBox[{"2", "\[Phi]"}], "]"}], "#"}], "&"}], "/@", "x"}], "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "#"}], "}"}], "&"}], "/@", "z"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ee", "=", 
      RowBox[{"ff", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"U3D", "[", 
            RowBox[{
             RowBox[{"2", "\[Phi]"}], "-", 
             RowBox[{"\[Pi]", "/", "2"}]}], "]"}], "#"}], "&"}], "/@", "w"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"ee", "+", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", "i", "]"}], 
          RowBox[{"U3D", "[", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], "+", 
            RowBox[{"2", "\[Delta]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Solve", " ", "for", " ", 
       RowBox[{"u", "[", "i", "]"}], " ", "for", " ", "all", " ", "i"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s", "[", "1", "]"}], "=", 
      RowBox[{
       RowBox[{"t", "[", "1", "]"}], "=", 
       RowBox[{
        RowBox[{"u", "[", "1", "]"}], "=", "0"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"x", " ", 
       RowBox[{"Sec", "[", 
        RowBox[{"\[Phi]", "-", "\[Delta]"}], "]"}], 
       RowBox[{"Sin", "[", "\[Delta]", "]"}], 
       RowBox[{"Sec", "[", 
        RowBox[{"\[Phi]", "-", 
         RowBox[{"2", "\[Delta]"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"s", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
              "r", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              RowBox[{"Tan", "[", "\[Phi]", "]"}]}], "-", 
             RowBox[{
             "w", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
            ")"}], 
           RowBox[{"u", "[", "i", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Rho]"}], ")"}], "/", "2"}], ")"}]}], "-", 
          RowBox[{
          "v", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"t", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
              "r", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              RowBox[{"Tan", "[", "\[Phi]", "]"}]}], "-", 
             RowBox[{
             "w", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
            ")"}], 
           RowBox[{"u", "[", "i", "]"}], 
           RowBox[{"(", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Rho]"}], ")"}], "/", "2"}], ")"}]}], "-", 
          RowBox[{
          "v", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Solve", " ", "for", " ", 
          RowBox[{
           RowBox[{"u", "[", "i", "]"}], ".", " ", "Some"}], " ", "special", " ",
           "cases", " ", "are", " ", 
          RowBox[{"known", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Which", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Delta]", "\[Equal]", "0"}], " ", ",", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"no", " ", "gap"}], ",", " ", 
            RowBox[{"solution", " ", "is", " ", "simple"}]}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"u", "[", "i", "]"}], "=", "1"}], ",", 
          "\[IndentingNewLine]", "True", ",", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"but", " ", "with", " ", "gap"}], ",", " ", 
            RowBox[{"need", " ", "to", " ", "solve", " ", "numerically"}]}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"soln", "=", 
            RowBox[{"Solve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Mag2", "[", 
                 RowBox[{
                  RowBox[{
                  "d", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
                   "-", 
                  RowBox[{
                  "c", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}]}], "]"}], "\[Equal]", 
                RowBox[{"Mag2", "[", 
                 RowBox[{
                  RowBox[{
                  "dd", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "-", 
                  RowBox[{
                  "cc", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"u", "[", "i", "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Print", "[", 
             
             RowBox[{"\"\<i = \>\"", ",", "i", ",", "\"\<, soln = \>\"", ",", 
              "soln"}], "]"}], "//", "Hold"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "desired", " ", "solution", " ", "is", " ", "smallest", " ", 
             "positive", " ", "solution"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"u", "[", "i", "]"}], "=", 
            RowBox[{"Min", "[", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"u", "[", "i", "]"}], "/.", "soln"}], ",", 
               RowBox[{
                RowBox[{"#", "\[GreaterEqual]", "0"}], "&"}]}], "]"}], 
             "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Tweak", " ", "folded", " ", "form", " ", "points", " ", "if", " ", 
       "necessary"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "\[Equal]", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"bb", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "-", "\[Epsilon]"}], ",", 
             RowBox[{"1", "-", "\[Epsilon]"}], ",", "1"}], "}"}], "#"}], 
          "&"}], "/@", "bb"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "\[Equal]", "1"}], ",", 
       RowBox[{"ee", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "-", "\[Epsilon]"}], ",", 
             RowBox[{"1", "-", "\[Epsilon]"}], ",", "1"}], "}"}], "#"}], 
          "&"}], "/@", "ee"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Check", " ", "for", " ", "negative", " ", "values"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"s", "[", "i", "]"}], "<", "0"}], "||", 
          RowBox[{
           RowBox[{"t", "[", "i", "]"}], "<", "0"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"MakeRadialPotWedge", "::", "badgap"}], ",", "\[Delta]", ",",
             "\[Rho]", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"s", "[", "j", "]"}], ",", 
              RowBox[{"{", 
