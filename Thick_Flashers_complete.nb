Cell[BoxData[
 RowBox[{
  RowBox[{"EmbedTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tiletype_List", ",", 
      RowBox[{"offset_", ":", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"rotation_", ":", "0"}], ",", 
      RowBox[{"scale_", ":", "1"}]}], "}"}], ",", "TGraph3DAssigned", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nm", ",", "dtile", ",", "verts", ",", "verts3d", ",", "f2d", ",", 
      "f3d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nm", "=", 
      RowBox[{
       RowBox[{"Numeric", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "EmbedTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dtile", "=", 
      RowBox[{"RenderTileCache", "[", 
       RowBox[{"tiletype", ",", "TGraph3DAssigned", ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"f2d", "=", 
      RowBox[{"If", "[", 
       RowBox[{"nm", ",", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"offset", "+", 
           RowBox[{
            RowBox[{"RotationMatrix2D", "[", "rotation", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{"scale", "*", "#"}], ")"}]}]}], "]"}], "&"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"offset", "+", 
           RowBox[{
            RowBox[{"RotationMatrix2D", "[", "rotation", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{"scale", "*", "#"}], ")"}]}]}], ")"}], "&"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"f3d", "=", 
      RowBox[{"If", "[", 
       RowBox[{"nm", ",", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{"offset", ",", "0"}], "]"}], "+", 
           RowBox[{
            RowBox[{"RotationZMatrix3D", "[", "rotation", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{"scale", "*", "#"}], ")"}]}]}], "]"}], "&"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{"offset", ",", "0"}], "]"}], "+", 
           RowBox[{
            RowBox[{"RotationZMatrix3D", "[", "rotation", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{"scale", "*", "#"}], ")"}]}]}], ")"}], "&"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"f2d", "/@", 
       RowBox[{"dtile", "[", "Vertices", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"f2d", "/@", 
       RowBox[{"dtile", "[", "Vertices3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dtile", "//", 
      RowBox[{"ReplaceProperties", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", "verts"}], ",", 
         RowBox[{"Vertices3D", "\[Rule]", "verts3d"}]}], "}"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
