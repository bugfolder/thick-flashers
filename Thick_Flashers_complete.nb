          RowBox[{"expr2", ",", "SolidStyle", ",", 
           RowBox[{"Opacity", "[", "1", "]"}]}], "]"}], "]"}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.922912694687593*^9, 3.9229128485456676`*^9}},
