}, Closed]],

Cell[CellGroupData[{

Cell["Lattices of patches", "Subsection",
 CellChangeTimes->{{3.627601955212701*^9, 
  3.627601958403485*^9}},ExpressionUUID->"e5a6c2cf-517d-416c-a61e-\
e42a2bcae441"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.627602953782799*^9, 
  3.627602954372895*^9}},ExpressionUUID->"f1085000-def2-418a-93bd-\
36116d190b2b"],

Cell["\<\
Once we have a patch, we can replicate that patch on a lattice to generate an \
arbitrarily large tiling.\
\>", "Text",
 CellChangeTimes->{{3.62760295708482*^9, 3.627602992170759*^9}, {
  3.62765770424389*^9, 3.627657786253897*^9}, {3.631140132239709*^9, 
  3.631140133591446*^9}, {3.631144927290763*^9, 
  3.631144933377018*^9}},ExpressionUUID->"835135b3-6a8d-4c51-80d2-\
6f3a0938befb"],

Cell["\<\
Since the periodicity of lattices is, in general, a skewed parallelogram, we \
will typically want to prune the resulting tiling using PruneTiling to get it \
to a nicer shape.\
\>", "Text",
 CellChangeTimes->{
  3.631144935471408*^9},ExpressionUUID->"acfbb632-425e-40ee-b68b-\
de67f4ec1ae4"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeLatticeTiling[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", {",
 StyleBox["l1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["l2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["j1min",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1max",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["j2min",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2max",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.457720347959859*^9, 3.457720356949991*^9}, 
   3.627385975612341*^9, {3.6299228040295677`*^9, 
   3.6299228046154213`*^9}},ExpressionUUID->"b42d9342-abea-47fc-8108-\
fdfd50d6266a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeLatticeTiling", "[", 
    RowBox[{
     StyleBox["patch",
      FontSlant->"Italic"], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["l1",
        FontSlant->"Italic"], ",", 
       StyleBox["l2",
        FontSlant->"Italic"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["j1min",
        FontSlant->"Italic"], ",", 
       StyleBox["j1max",
        FontSlant->"Italic"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["j2min",
        FontSlant->"Italic"], ",", 
       StyleBox["j2max",
        FontSlant->"Italic"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"6a61a9b0-f860-4917-bd86-1fbdc005df1b"],
 " creates an expanded tiling by placing copies of the patch ",
 StyleBox["patch",
  FontSlant->"Italic"],
 " on a 2D lattice where {",
 StyleBox["l1, l2",
  FontSlant->"Italic"],
 "} are the lattice vectors, {",
 StyleBox["j1min",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1max",
  FontSlant->"Italic"],
 "} specifies the range of indices for lattice vector ",
 StyleBox["l1",
  FontSlant->"Italic"],
 ", and {",
 StyleBox["j2min",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2max",
  FontSlant->"Italic"],
 "} specifies the range of indices for lattice vector ",
 StyleBox["l2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.592170554261946*^9, 3.592170590045155*^9}, {
   3.592170620456338*^9, 3.59217062540793*^9}, 3.627385975615483*^9, {
   3.627603003714051*^9, 3.627603004352982*^9}, {3.629922810207333*^9, 
   3.62992281246149*^9}},ExpressionUUID->"e68ef369-3d55-46a0-8355-\
b9fd6457249e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeLatticeTiling", "[", 
   RowBox[{"patch_", ",", 
    RowBox[{"{", 
     RowBox[{"l1_", ",", "l2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j1min_", ",", "j1max_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j2min_", ",", "j2max_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ReplacePart", "[", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "+", 
           RowBox[{"j1", " ", "l1"}], "+", 
           RowBox[{"j2", " ", "l2"}]}], ",", "2"}], "]"}], "&"}], "/@", 
       RowBox[{"RegularizePatch", "[", "patch", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j2", ",", "j2min", ",", "j2max"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j1", ",", "j1min", ",", "j1max"}], "}"}]}], "]"}], ",", "2"}],
    "]"}]}]], "Input",
 CellChangeTimes->{
  3.627385975616678*^9, {3.629922816818987*^9, 3.629922827034886*^9}, {
   3.631128542034723*^9, 3.631128547332855*^9}, {3.631140909729972*^9, 
   3.63114094034405*^9}},
 CellLabel->
  "In[3094]:=",ExpressionUUID->"9e7e68d7-1c4a-4483-bcf8-4b6362e47b3a"],

Cell["Example. Overlapping copies of tiles.", "Text",
 CellChangeTimes->{{3.5924828572823977`*^9, 3.592482872840953*^9}, 
   3.627385975617873*^9},ExpressionUUID->"59ee8e5c-4031-404a-b5d4-\
b14918c79293"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"patch", ",", "tiling"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"patch", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"TestTile", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"TestTile", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"22.5", "\[Degree]"}], ",", ".5"}], "}"}]}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"MakeLatticeTiling", "[", 
       RowBox[{"patch", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1.2", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1.2"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"ColumnForm", "[", "tiling", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"EmbedTiling", "[", 
        RowBox[{"tiling", ",", "Tiling", ",", 
         RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.457720784778895*^9, 3.457720805509512*^9}, {
   3.457720843100539*^9, 3.457720952209278*^9}, 3.4577209844051538`*^9, {
   3.457721017461952*^9, 3.457721029242627*^9}, {3.457721255643161*^9, 
   3.457721257014052*^9}, {3.457721334468279*^9, 3.457721334945985*^9}, {
   3.457721366126638*^9, 3.457721376704255*^9}, 3.457721466604932*^9, {
   3.457721515200592*^9, 3.457721527216636*^9}, {3.592169306408281*^9, 
   3.592169306472414*^9}, {3.592482803155034*^9, 3.592482806834477*^9}, 
   3.627385975618439*^9, {3.627522957094438*^9, 3.627522957157022*^9}, 
   3.627565906903862*^9, {3.627603051467235*^9, 3.627603061880962*^9}, 
   3.627603120062679*^9, {3.629922852793383*^9, 3.629922885260676*^9}, {
   3.631140956991787*^9, 3.631140960379704*^9}},
 CellLabel->
  "In[3095]:=",ExpressionUUID->"2b45b36d-4579-42ff-ba63-9a40d25c07ee"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Archimedean tiling patches", "Subsection",
 CellChangeTimes->{{3.631139763647298*^9, 3.631139779773294*^9}, {
  3.6312944278498583`*^9, 
  3.6312944285519857`*^9}},ExpressionUUID->"d048c26a-94d4-4229-9148-\
9a992d73d078"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457719347298704*^9, 3.457719347698023*^9}, 
   3.627385975531545*^9},ExpressionUUID->"e64529aa-f4f5-48de-a957-\
db5f32071cf2"],

Cell[TextData[{
 "This section contains functions that define Archimedean tilings. Each \
tiling patch is composed of {UnitRegularPolygonTile, ",
 StyleBox["n",
  FontSlant->"Italic"],
 "} tiletypes."
}], "Text",
 CellChangeTimes->{
  3.627385975531855*^9, {3.6275933082910566`*^9, 3.627593310659321*^9}, 
   3.631294447185464*^9},ExpressionUUID->"4ca3ac35-17b3-415a-a404-\
3121708e75b8"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeArchimedeanVertexFigure[",
 StyleBox["vtype",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{3.627385975532113*^9, 
  3.6311398574658537`*^9},ExpressionUUID->"ae2679d2-d300-4037-84be-\
5911d16c2491"],

Cell[TextData[{
 "MakeArchimedeanVertexFigure[",
 StyleBox["vtype",
  FontSlant->"Italic"],
 "] creates a list of Graphics elements for the vertex figure of the given \
vertex type. The ",
 StyleBox["type",
  FontSlant->"Italic"],
 " should be a list of the regular polygons around the vertex by number of \
sides, e.g., {3,3,3,4,4}."
}], "Text",
 CellChangeTimes->{{3.592482361426182*^9, 3.5924824090948668`*^9}, 
   3.6273859755324383`*^9, 
   3.631139866722884*^9},ExpressionUUID->"8abdfc72-ba47-4bca-9126-\
36eafaf013af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeArchimedeanVertexFigure", "[", "vtype_List", "]"}], " ", ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"polys", ",", " ", "rots"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"polys", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"RenderTile", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"UnitRegularPolygonTile", ",", "#"}], "}"}], ",", 
          "Tiling"}], "]"}], "&"}], "/@", "vtype"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rots", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"FoldList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "+", "\[Pi]", "-", 
            FractionBox[
             RowBox[{"2", "\[Pi]"}], "#2"]}], "&"}], ",", "0", ",", "vtype"}],
          "]"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{"Rotate2D", ",", 
         RowBox[{"{", 
          RowBox[{"polys", ",", "rots"}], "}"}]}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], "]"}], ",", 
         RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.457713831730144*^9, {3.457719479923007*^9, 3.457719573002697*^9}, {
   3.457719622141735*^9, 3.457719733246072*^9}, 3.62733966337575*^9, 
   3.627385975534098*^9, 3.627524098714965*^9, 3.627589078407125*^9, 
   3.629840278985007*^9, {3.629979083621372*^9, 3.629979137956769*^9}, {
   3.631139868909051*^9, 3.631139874410294*^9}},
 CellLabel->
  "In[3096]:=",ExpressionUUID->"a3d2e1f5-996c-4055-9eb1-2992d172f933"],

