Cell[BoxData[
 RowBox[{
  RowBox[{"FoldSpaceCurve3D", "[", 
   RowBox[{
   "ff_Function", ",", "\[Gamma]_Function", ",", "\[FinalSigma]_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "csys", ",", "ds", ",", "tt",
       ",", "nn", ",", "bb", ",", "llL", ",", "uuL", ",", "duuL", ",", 
      "mduuL", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "rrL", ",", "llR", ",", 
      "uuR", ",", "duuR", ",", "mduuR", ",", "c\[Rho]R", ",", "s\[Rho]R", ",",
       "rrR"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldSpaceCurve3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldSpaceCurve3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "the", " ", "Frenet", " ", "frame", " ", "of", " ", "the", " ",
        "curve"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"ff", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
         "BinormalVector3D"}], "}"}], "/.", "csys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"llL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[FinalSigma]", " ", 
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "+", 
          RowBox[{"\[FinalSigma]", " ", 
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[FinalSigma]"}], " ", 
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "+", 
          RowBox[{"\[FinalSigma]", " ", 
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuL", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mduuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"duuL", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"duuL", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
         FractionBox[
          RowBox[{
           RowBox[{"duuL", "[", "s", "]"}], ".", 
           RowBox[{"llL", "[", "s", "]"}]}], 
          RowBox[{"mduuL", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"duuL", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         RowBox[{"mduuL", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"c\[Rho]L", "[", "s", "]"}], 
           RowBox[{"tt", "[", "s", "]"}]}], "+", 
          RowBox[{
           RowBox[{"s\[Rho]L", "[", "s", "]"}], " ", 
           RowBox[{"llL", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"llR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[FinalSigma]", " ", 
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "-", 
          RowBox[{"\[FinalSigma]", " ", 
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[FinalSigma]", " ", 
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "+", 
          RowBox[{"\[FinalSigma]", " ", 
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuR", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mduuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"duuR", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"+", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"duuR", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
         FractionBox[
          RowBox[{
           RowBox[{"duuR", "[", "s", "]"}], ".", 
           RowBox[{"llR", "[", "s", "]"}]}], 
          RowBox[{"mduuR", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"duuR", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         RowBox[{"mduuR", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"c\[Rho]R", "[", "s", "]"}], 
           RowBox[{"tt", "[", "s", "]"}]}], "-", 
          RowBox[{
           RowBox[{"s\[Rho]R", "[", "s", "]"}], " ", 
           RowBox[{"llR", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.799443499854664*^9, 3.799443551389594*^9}, {
   3.799443585070655*^9, 3.79944359558757*^9}, {3.799444382156259*^9, 
   3.799444414060215*^9}, {3.799444444397007*^9, 3.7994445444380083`*^9}, {
   3.799444596477281*^9, 3.7994446783855057`*^9}, {3.799444860234083*^9, 
