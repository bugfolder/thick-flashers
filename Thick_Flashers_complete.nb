     RowBox[{"er", "=", 
      RowBox[{"cr", "+", 
       RowBox[{"vhr", " ", "dr"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cl", "+", 
