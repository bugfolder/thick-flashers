 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629825804047363*^9, 3.629825806142675*^9}, {
   3.630018332922172*^9, 3.630018335057712*^9}, {3.630018414750152*^9, 
   3.630018418486266*^9}, 
   3.707757435842831*^9},ExpressionUUID->"3a8ee6d5-2d28-4a2a-9b78-\
16bf1645e0ff"],

Cell[TextData[{
 "RenderTile[{PolygonTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TileVertices, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the vertices of the tiling polygon."
}], "Text",
 CellChangeTimes->{{3.629826543752584*^9, 3.629826558268348*^9}, 
   3.63001835571412*^9, 3.630072966605493*^9, 
   3.707757437641955*^9},ExpressionUUID->"e704a583-b86a-4b82-afaa-\
7dd386d648b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "PolygonTwistTile", ",", "verts_List", ",", "w_", ",", "d_", ",", 
      "\[Tau]_", ",", "ccw_", ",", "types_List"}], "}"}], ",", "TileVertices",
     ",", "opts___"}], "]"}], ":=", "verts"}]], "Input",
