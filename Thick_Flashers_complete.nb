       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{
          RowBox[{"a", " ", 
           SuperscriptBox["#1", "2"]}], "+", 
          RowBox[{"b", " ", 
           SuperscriptBox["#2", "2"]}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", "a", " ", "#1"}], 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["#1", "2"]}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["b", "2"], " ", 
              SuperscriptBox["#2", "2"]}]}]]]}], ",", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", "b", " ", "#2"}], 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["#1", "2"]}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["b", "2"], " ", 
              SuperscriptBox["#2", "2"]}]}]]]}], ",", 
         FractionBox["1", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["a", "2"], " ", 
             SuperscriptBox["#1", "2"]}], "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["b", "2"], " ", 
             SuperscriptBox["#2", "2"]}]}]]]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".4"}], ",", 
        RowBox[{"-", ".6"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sng", "=", 
      RowBox[{"StyledSurfaceNormalGrid", "[", 
       RowBox[{"ss", ",", "uu", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
