Cell["\<\
TileVertices and Tiling are two forms of decoration that every type of tile \
should support.\
\>", "Text",
 CellChangeTimes->{{3.629764421170407*^9, 3.6297644340731893`*^9}, 
   3.707757295845688*^9},ExpressionUUID->"60066f90-262e-4caa-87e4-\
559e57162d7d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TileVertices", "::", "usage"}], 
   "=", "\"\<TileVertices is a type of tile decoration that returns a list of \
vertices of the tiling polygon.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.707758280180931*^9, 3.707758309907859*^9}},
 CellLabel->
  "In[2785]:=",ExpressionUUID->"4574aed4-1907-4d57-9d6d-cec8ea0458fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Tiling", "::", "usage"}], " ", "=", 
   " ", "\"\<Tiling is a type of tile decoration that renders the underlying \
tiling.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.62976421255527*^9, 3.629764245759856*^9}, {
  3.629818399509694*^9, 3.629818399677547*^9}},
 CellLabel->
  "In[2786]:=",ExpressionUUID->"246c7ff7-3406-4398-961a-dd8f1cbc62b1"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RenderTile[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nRenderTile[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decorations",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.62981766402067*^9, 3.6298176869708776`*^9}, {
  3.6299379417580156`*^9, 
  3.629937955523398*^9}},ExpressionUUID->"e03d0e24-4a7d-4f1c-a290-\
5e4d0eba831a"],

Cell[TextData[{
 "RenderTile[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] renders a specific tile type with the specified decoration."
}], "Text",
 CellChangeTimes->{{3.707754228337458*^9, 
  3.707754256279106*^9}},ExpressionUUID->"b8a864f7-130e-4c70-8444-\
5a20d5f6c937"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 " \[LongDash] a list of the form {",
 StyleBox["tilename",
  FontSlant->"Italic"],
 ", ",
 StyleBox["parms",
  FontSlant->"Italic"],
 "} that specifies the tile together with its parameters.\n\t",
 StyleBox["decoration",
  FontSlant->"Italic"],
 " \[LongDash] specifies how the tile is to be rendered."
}], "Text",
 CellChangeTimes->{{3.707754258046*^9, 
  3.707754322464016*^9}},ExpressionUUID->"1a617ae2-54ae-4b81-9772-\
463a288d43db"],

Cell["\<\
Returns: depends on the decoration. Could be Graphics, Graphics3D, or a TObj.\
\
\>", "Text",
 CellChangeTimes->{{3.707754389977055*^9, 
  3.7077544089048853`*^9}},ExpressionUUID->"27af15d6-61bb-4250-971b-\
b747b73464c2"],

Cell[TextData[{
 "RenderTile[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] must be defined for each combination of ",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 " and ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ". The default behavior created here throws an error. Individual tiles will \
override this behavior for their particular combinations of ",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 " and ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.629817695184983*^9, 3.629817713711137*^9}, 
   3.629817748749419*^9, {3.629818414210367*^9, 3.629818424329933*^9}, {
   3.6299751662428927`*^9, 3.629975182546226*^9}, {3.707754442306037*^9, 
   3.707754454281784*^9}},ExpressionUUID->"34ea7775-4c16-45dc-b66e-\
f7592d7ae7b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RenderTile", "::", "nodef"}], 
   "=", "\"\<There is no applicable definition for `1`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.629817750186243*^9, 3.6298177844856586`*^9}},
 CellLabel->
  "In[2787]:=",ExpressionUUID->"d1b450db-835d-49c2-89d1-b4aed26aadd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{"tiletype_", ",", "decoration_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "args", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"args", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"Riffle", "[", 
        RowBox[{
         RowBox[{"ToString", "/@", 
          RowBox[{"InputForm", "/@", 
           RowBox[{"{", 
            RowBox[{"tiletype", ",", "decoration", ",", "opts"}], "}"}]}]}], 
         ",", "\"\<, \>\""}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Message", "[", 
      RowBox[{
       RowBox[{"RenderTile", "::", "nodef"}], ",", 
       RowBox[{"\"\<RenderTile[\>\"", "<>", "args", "<>", "\"\<]\>\""}]}], 
      "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629817786247888*^9, 3.629817898608972*^9}, {
  3.629817956100519*^9, 3.629817976602337*^9}, {3.629818145848547*^9, 
  3.629818346923896*^9}},
 CellLabel->
