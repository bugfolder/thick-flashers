Cell[CellGroupData[{

Cell["Vertices as vectors and scalars", "Subsection",
 CellChangeTimes->{{3.555767376886252*^9, 3.55576738029088*^9}, {
  3.555854664761066*^9, 3.555854665701095*^9}, {3.719868108397689*^9, 
  3.719868116108049*^9}},ExpressionUUID->"0db15cbe-bb6d-487c-8d04-\
c3cf2753a38d"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.5557673833561373`*^9, 
  3.555767383788406*^9}},ExpressionUUID->"e39064cf-2c97-414a-b3ec-\
7651516cd747"],

Cell["\<\
In this section, we set up the constraint functions needed to solve for \
specific flashers that are isometric to a flat CP. Note that because of \
rotational symmetry, we only need to consider conditions on vertices in the \
first sector.\
\>", "Text",
 CellChangeTimes->{{3.555767385436235*^9, 3.555767404706979*^9}, {
  3.555767570687909*^9, 3.555767588742283*^9}, {3.555767643755076*^9, 
  3.555767645954234*^9}, {3.555837116185506*^9, 3.555837118128092*^9}, {
  3.555954969273966*^9, 3.555954975393592*^9}, {3.719945256999112*^9, 
  3.7199452591671*^9}},ExpressionUUID->"10c7bd1b-3c78-49c2-a8dd-02f7d697063d"],

Cell[TextData[{
 "One of the key notions of this section is to distinguish between ",
 StyleBox["vertices",
  FontSlant->"Italic"],
 " and ",
 StyleBox["scalar variables",
  FontSlant->"Italic"],
 ". The vertices are vector quantities, parameterized as two- and \
three-subscript expressions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"5797690d-6b4b-4fc6-a146-931f69e9db52"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"fc0762e8-c464-4eb8-b710-38921d4cfe82"],
 ". When we get around to solving for coordinates, we will transform these \
into scalar variables, which are also subscripted expressions (see \
FlasherScalarize, next section), but each of these subscripted variables \
represents a scalar value."
}], "Text",
 CellChangeTimes->{{3.55583712327192*^9, 3.5558372769340777`*^9}, {
  3.555954989113028*^9, 3.555955003432477*^9}, {3.71986613126259*^9, 
  3.719866165709767*^9}, {3.719925856545258*^9, 
  3.719925877013483*^9}},ExpressionUUID->"4232d525-0a08-401f-a615-\
8ca0a37e486b"],

Cell["\<\
For paraboloidal flashers, we follow the same general approach, but we we \
enforce isometry between the 3D folded form and the 3D deployed paraboloid.\
\>", "Text",
 CellChangeTimes->{{3.555767385436235*^9, 3.555767404706979*^9}, {
  3.555767570687909*^9, 3.555767588742283*^9}, {3.555767643755076*^9, 
  3.555767645954234*^9}, {3.555837116185506*^9, 3.555837118128092*^9}, {
  3.555954969273966*^9, 3.555954975393592*^9}, {3.719945256999112*^9, 
  3.7199452591671*^9}, {3.825606388477355*^9, 3.825606390683757*^9}, {
  3.825675185857432*^9, 
  3.825675216961691*^9}},ExpressionUUID->"30820221-3ade-44c7-bcd3-\
51f77f5921c8"]
}, Closed]],

Cell[CellGroupData[{

Cell["FlasherVars[]", "Subsubsection",
 CellChangeTimes->{{3.719868132732882*^9, 3.7198681430283527`*^9}, 
   3.7199259693719*^9},ExpressionUUID->"b1ffb018-116a-4513-9a0b-c56172544e29"],

Cell["\<\
FlasherVars[] gives a list of of symbolic variables used for vectors and \
scalars. We use this only to generate examples. When we set up and solve \
equations, we\[CloseCurlyQuote]ll use a bespoke list made up of local \
variables to avoid unintentional collisions in case someone has created other \
definitions for p, pp, etc.\
\>", "Text",
 CellChangeTimes->{{3.719868144868653*^9, 3.719868175827773*^9}, {
  3.719868205844063*^9, 3.719868217996298*^9}, {3.719868368636717*^9, 
  3.719868418212515*^9}, {3.719925969390016*^9, 3.719926018980034*^9}, {
  3.719945282568019*^9, 
  3.719945300199342*^9}},ExpressionUUID->"efb87b7f-c9a9-40e3-9720-\
2983356d8941"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherVars", "[", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.719868191889473*^9, 3.719868229878149*^9}, 
   3.719925969396093*^9, {3.719926032565082*^9, 3.719926040412964*^9}},
 CellLabel->
  "In[4155]:=",ExpressionUUID->"64240aee-05ec-4e9b-9c8b-4a8e67956ae5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherScalarize[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.719867069526457*^9, 3.7198670834218197`*^9}, {
   3.719868237117741*^9, 3.719868237404257*^9}, 3.719925980335895*^9, {
   3.913543760855495*^9, 
   3.913543761393549*^9}},ExpressionUUID->"f04e2cc9-4407-4f7e-826b-\
064bfdba4bbc"],

Cell[TextData[{
 "FlasherScalarize[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "] takes an expression that contains ",
 StyleBox["p",
  FontSlant->"Italic"],
 " or ",
 StyleBox["pp",
  FontSlant->"Italic"],
 " points and converts three-subscript vertices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"10bca31c-da09-41fe-823d-790851360aae"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"59ddef5d-dfa4-46ff-a94f-a283a761e7ff"],
 " into vectors of components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", 
     RowBox[{"i", ",", "j", ",", "0"}]], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["px", 
       RowBox[{"i", ",", " ", "j"}]], ",", " ", 
      SubscriptBox["py", 
       RowBox[{"i", ",", "j"}]]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "8d07287f-1573-4361-b381-cebfbf22fe2a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["pp", 
     RowBox[{"i", ",", "j", ",", "0"}]], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["ppx", 
       RowBox[{"i", ",", "j"}]], ",", " ", 
      SubscriptBox["ppy", 
       RowBox[{"i", ",", "j"}]], ",", " ", 
      SubscriptBox["ppz", 
       RowBox[{"i", ",", "j"}]]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "8b428a54-7d02-4fa8-9947-34b52f429693"],
 ", respectively. It also applies rotation based on the rotational subscript ",
 StyleBox["k",
  FontSlant->"Italic"],
 " for rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " (thereby removing subscript ",
 StyleBox["k",
  FontSlant->"Italic"],
 " from ",
 StyleBox["obj",
  FontSlant->"Italic"],
 ")."
}], "Text",
 CellChangeTimes->{{3.55574892375367*^9, 3.5557489969319983`*^9}, {
   3.5557490732244463`*^9, 3.555749085982279*^9}, {3.555749308291521*^9, 
   3.555749394354454*^9}, {3.555750639818749*^9, 3.555750656767137*^9}, {
   3.555759846359387*^9, 3.555759846459425*^9}, {3.555765151624693*^9, 
   3.55576517054405*^9}, {3.555765216012394*^9, 3.555765231917538*^9}, 
   3.555788856636939*^9, {3.555837080438752*^9, 3.555837091393918*^9}, 
   3.719857926361224*^9, {3.719858026617935*^9, 3.719858057975539*^9}, {
   3.719865741320323*^9, 3.71986574246982*^9}, {3.7198682655013638`*^9, 
   3.719868265780978*^9}, 3.719925980350588*^9, {3.913543766977532*^9, 
   3.913543770281897*^9}},ExpressionUUID->"e719fef1-2ef4-4e03-b048-\
2dcaa02dba2d"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}], TraditionalForm]],ExpressionUUID->
  "21cc30a1-ed7a-47fa-aea5-6d0721195143"],
 " of symbols to use for vector and scalar variables.\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any expression contain subscripted vector points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "e451d415-06a9-45e6-9971-fdbbc4f89465"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "b62e1794-c9cb-49c3-83b4-eb730767de3e"],
 ".\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order."
}], "Text",
 CellChangeTimes->{{3.913543697760539*^9, 3.913543745801195*^9}, {
  3.913543776446087*^9, 3.9135437769189243`*^9}, {3.913543826194417*^9, 
  3.913543869643005*^9}},ExpressionUUID->"373cf27a-673c-4b23-af27-\
eb75b1672e17"],

Cell["\<\
Returns: the same expression with vector points converted to scalar variables.\
\>", "Text",
 CellChangeTimes->{{3.91354389455794*^9, 
  3.91354391034676*^9}},ExpressionUUID->"8dc5d9a1-a6f0-4d50-bba2-\
e871cf959121"],

Cell["Note that we implement wrap-around indexing.", "Text",
 CellChangeTimes->{{3.719869443685957*^9, 
  3.719869458309357*^9}},ExpressionUUID->"fe08f683-dc45-4d10-a74e-\
924a51517d0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherScalarize", "[", 
   RowBox[{"vars_", ",", "expr_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
      "ppz"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"expr", "/.", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FlasherWrapRules", "[", "p", "]"}], ",", 
          RowBox[{"FlasherWrapRules", "[", "pp", "]"}]}], "}"}], "]"}]}], "/.", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"FlasherRotation2D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["px", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["py", 
             RowBox[{"i", ",", "j"}]]}], "}"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         SubscriptBox["pp", 
          RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"FlasherRotation3D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["ppx", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppy", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppz", 
             RowBox[{"i", ",", "j"}]]}], "}"}]}]}]}], "}"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.555748998987959*^9, 3.555749297183679*^9}, 
   3.555749843067773*^9, {3.55574988727124*^9, 3.555749900740972*^9}, 
   3.5557888566584663`*^9, {3.719858085665025*^9, 3.719858126082836*^9}, {
   3.719868272197376*^9, 3.719868326428454*^9}, {3.719869247710218*^9, 
   3.719869309335931*^9}, {3.719869420655345*^9, 3.719869432927297*^9}, {
   3.7199259799733953`*^9, 3.719925979979645*^9}, {3.719926048721291*^9, 
   3.719926067367735*^9}, 3.719926118246494*^9, 3.719943219372053*^9, {
   3.719943285728991*^9, 3.719943299397039*^9}, {3.911863231046047*^9, 
   3.911863236787065*^9}, {3.913543781802514*^9, 3.913543786708466*^9}},
 CellLabel->
  "In[4156]:=",ExpressionUUID->"529348ba-1d34-435f-8f70-96124be50be5"],

