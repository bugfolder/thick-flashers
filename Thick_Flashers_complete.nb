Cell[CellGroupData[{

Cell["Reciprocal diagrams", "Subsection",
 CellChangeTimes->{{3.592395050594726*^9, 3.592395053488871*^9}, 
   3.592407210414175*^9},ExpressionUUID->"0b34de4f-1a50-4d92-9284-\
9fb867a3c075"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.59240255643185*^9, 
  3.5924025568512583`*^9}},ExpressionUUID->"aeb104b9-a613-40b5-8ea6-\
5833c70ca74a"],

Cell["\<\
The \"reciprocal diagram\" (formerly \"orthogonal dual\") is a particular \
embedding of the dual graph whose edges are perpendicular to the edges of the \
primal graph. It shows up when constructing shrink-rotate tessellations and \
flagstone tessellations (and probably others).\
\>", "Text",
 CellChangeTimes->{{3.4576248888939967`*^9, 3.4576248942700157`*^9}, {
  3.457625298902813*^9, 3.457625364642964*^9}, {3.484575953576226*^9, 
  3.484575963084697*^9}, {3.484834726911437*^9, 3.4848347360205812`*^9}, {
  3.5924024029822197`*^9, 3.592402413956071*^9}, {3.592402564082389*^9, 
  3.592402564666374*^9}},ExpressionUUID->"78678f28-18ab-4f55-9b59-\
23d1f78a6eab"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DualEdgeRatio[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t",
 "(unchecked class",
 ") TPrimalDualGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.455923960159878*^9, 3.455923976599571*^9}, 
   3.455924029617399*^9, 3.461741183444605*^9, 3.465924640851563*^9, 
   3.591645643916021*^9, {3.591733602477419*^9, 3.591733618445893*^9}, {
   3.5917371164408283`*^9, 3.591737117280512*^9}, {3.5917372719039183`*^9, 
   3.59173728433489*^9}, 3.592158986871752*^9, {3.592402481684022*^9, 
   3.59240248708774*^9}, 3.59282880595628*^9, 
   3.594732493004044*^9},ExpressionUUID->"a30bbf93-48da-4efe-aeec-\
066153bb2bbf"],

Cell[TextData[{
 "DualEdgeRatio[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a ",
 "TPrimalDualGraph",
 ", and returns the ratio of the largest to smallest edge lengths from primal \
to dual, comparing each pair of edges. This is, effectively, a measure of how \
\"well-formed\" the system is because we would like the pleats of a \
shrink-rotate tessellation (whose widths are proportional to this ratio) to \
be not very different in aspect ratio. Smaller is better."
}], "Text",
 CellChangeTimes->{{3.455924161197736*^9, 3.45592424995257*^9}, {
   3.455928772483404*^9, 3.455928775203309*^9}, 3.46174118348453*^9, {
   3.591733624038769*^9, 3.591733688635762*^9}, {3.591734577947967*^9, 
   3.591734606035475*^9}, {3.5917890410795*^9, 3.591789041747416*^9}, 
   3.592158986972575*^9, {3.5924025736738024`*^9, 3.592402575531064*^9}, 
   3.592828806062647*^9},ExpressionUUID->"0daf373b-565d-4531-ab3e-\
006c245cd01d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DualEdgeRatio", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "iedges", ",", "dverts", ",", "dedges", ",", "dplens"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPrimalDualGraph", ",", "DualEdgeRatio"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "iedges", ",", "dverts", ",", "dedges"}], "}"}], 
      "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "InteriorEdges", ",", "DualVertices", ",", 
          "DualEdges"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dplens", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Dot", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Subtract", "@@", 
             RowBox[{"dverts", "[", 
              RowBox[{"[", "#", "]"}], "]"}]}], "&"}], "/@", "dedges"}], ",", 
          
          RowBox[{
           RowBox[{
            RowBox[{"NormalizeReal", "[", 
             RowBox[{"Rotate90", "[", 
              RowBox[{"Subtract", "@@", 
               RowBox[{"verts", "[", 
                RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "]"}], "&"}], "/@", 
           "iedges"}]}], "}"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dplens", "=", 
      RowBox[{"dplens", "*", 
       RowBox[{"(", 
        RowBox[{"Sign", "/@", "dplens"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"Max", "[", "#", "]"}], 
        RowBox[{"Min", "[", "#", "]"}]], "&"}], "[", "dplens", "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.455924140467669*^9, 3.455924155500388*^9}, 
   3.455928631352027*^9, {3.455928663552086*^9, 3.455928674213242*^9}, {
