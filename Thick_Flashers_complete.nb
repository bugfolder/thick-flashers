Cell["And we can use our own variables, if we wish.", "Text",
 CellChangeTimes->{{3.802169106062741*^9, 
  3.8021691113511553`*^9}},ExpressionUUID->"c48ee775-c926-4483-894f-\
8f0a563371df"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#2", ",", "#3", ",", 
      RowBox[{
       SuperscriptBox["#2", "2"], 
