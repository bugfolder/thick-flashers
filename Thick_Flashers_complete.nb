Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mspc", ",", "verts3d", ",", "pts", ",", "vrtx", ",", "pts1", ",", 
      "vrtx1", ",", 
      RowBox[{"n", "=", "15"}], ",", "sp", ",", "re", ",", "tobj"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"start", " ", "with", " ", "a", " ", "generic", " ", "cone"}], 
     " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mspc", "=", 
      RowBox[{"MakeSimpleFlutedCone", "[", 
       RowBox[{"24", ",", 
        RowBox[{"30.", "\[Degree]"}], ",", 
        RowBox[{"ConePhaseShift", "\[Rule]", 
         RowBox[{"0", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"verts3d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"mspc", ",", "Vertices3D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vrtx", "=", 
      RowBox[{"verts3d", "\[LeftDoubleBracket]", 
       RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{"verts3d", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "slice", " ", "off", " ", "the", " ", "top", " ", "and", " ", "invert", 
       " ", "it", " ", "so", " ", "that", " ", 
       RowBox[{"it", "'"}], "s", " ", "flat", " ", "with", " ", "the", " ", 
       "peak", " ", "on", " ", "top"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vrtx1", ",", "pts1"}], "}"}], "=", 
      RowBox[{"SliceCone", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vrtx", ",", "pts"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "and", " ", "now", " ", "make", " ", "it", " ", "into", " ", "a", " ", 
        "multi"}], "-", 
       RowBox[{"sliced", " ", "object"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", "#", "]"}], ",", "0", ",", 
          RowBox[{"Cos", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"10", "\[Degree]", "*", "i"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"re", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "0.83", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"0.98", ",", 
          RowBox[{"{", 
           RowBox[{"n", "-", "1"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeMultiSlicedCone", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vrtx1", ",", "pts1"}], "}"}], ",", "n", ",", 
        RowBox[{"ConeSlicePlanes", "\[Rule]", "sp"}], ",", 
        RowBox[{"ConeReductions", "\[Rule]", "re"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"PaperOrientation", "\[Rule]", "ColorUp"}]}], "]"}]}], 
        "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
