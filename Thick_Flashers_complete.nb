Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "w", ",", "\[Tau]", ",", "types"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"UnitRegularPolygonVertices", "[", "4", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"70", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RenderTile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "PolygonCenteredTwistTile", ",", "verts", ",", "w", ",", "\[Tau]", ",",
          "types"}], "}"}], ",", "TileVertices"}], "]"}]}]}], 
