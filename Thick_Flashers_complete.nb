            RowBox[{"verts3d", ",", "edges"}], "]"}], ",", "ec"}], "]"}]}], 
        "]"}], ",", "\[IndentingNewLine]", "True", ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"EdgeLines", "[", 
            RowBox[{"verts3d", ",", "edges"}], "]"}], ",", "ec"}], "]"}]}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"hf", ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Switch", "[", 
            RowBox[{"fl", ",", "None", ",", 
