            RowBox[{"0", ",", "nv"}], "]"}], ",", 
           RowBox[{"vifn", "[", 
            RowBox[{"nh", ",", "nv"}], "]"}]}], "}"}]}], "}"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
