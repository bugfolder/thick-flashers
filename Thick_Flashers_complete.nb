Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NFlattenGeneric2D", "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.7994156045521584`*^9, 3.799415613399033*^9}, 
   3.800467905429975*^9, 3.800471568355492*^9, 3.80177097820088*^9, 
   3.801771898485895*^9, {3.801783373448492*^9, 3.801783374430425*^9}, {
   3.801783564376219*^9, 3.801783567399559*^9}},
 CellLabel->
  "In[3881]:=",ExpressionUUID->"6072cc63-462e-4d8c-ad03-1a8dda68ce56"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NFlattenGeneric2D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bb_Function", ",", "dd_Function", ",", "\[Sigma]_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bi_List", ",", "ti_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "uu", ",", "cc", ",", "tt", ",", "ll", ",", "d3dsys", ",", 
      "ds", ",", "\[Kappa]g", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "c2dsys",
       ",", "b", ",", "t", ",", "l", ",", "d"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"txd", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"bb", "'"}], "[", "s", "]"}], "\[Cross]", 
             RowBox[{"dd", "[", "s", "]"}]}]}], "}"}], ",", 
          RowBox[{"\[Sigma]", " ", 
           RowBox[{"NormalizeReal", "[", "txd", "]"}]}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"d3dsys", "=", 
      RowBox[{"NDarboux3DSystem", "[", 
       RowBox[{"bb", ",", "uu", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "ll", ",", "ds", ",", "\[Kappa]g"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector3D", ",", "TangentNormalVector3D", ",", "Speed3D", ",", 
         "GeodesicCurvature3D"}], "}"}], "/.", "d3dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"\[Sigma]", " ", 
         RowBox[{
          RowBox[{"tt", "[", "s", "]"}], ".", 
          RowBox[{"dd", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"\[Sigma]", " ", 
         RowBox[{
          RowBox[{"ll", "[", "s", "]"}], ".", 
          RowBox[{"dd", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c2dsys", "=", 
      RowBox[{"NRecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]g", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bi", ",", "ti"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Curve2D", ",", "TangentVector2D", ",", "LeftNormalVector2D"}], "}"}],
        "/.", "c2dsys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
            RowBox[{"t", "[", "s", "]"}]}], "+", 
           RowBox[{
            RowBox[{"s\[Rho]L", "[", "s", "]"}], 
            RowBox[{"l", "[", "s", "]"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.798572927592586*^9, 3.798572964094378*^9}, {
   3.7985731122007017`*^9, 3.798573136774859*^9}, {3.798573175864064*^9, 
