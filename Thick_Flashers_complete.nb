Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p0", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"p1", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"p2", "=", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", "0.6"}], "}"}]}], ",", 
      RowBox[{"p3", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.8"}], ",", "0.3"}], "}"}]}], ",", "p4", ",", "x4", ",",
       "y4", ",", "ke", ",", "soln", ",", "gg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p4", "=", 
      RowBox[{"{", 
       RowBox[{"x4", ",", "y4"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ke", "=", 
      RowBox[{"UnnormalizedFlatFoldabilityCondition", "[", 
       RowBox[{"p0", ",", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Simplify", "[", 
       RowBox[{"ke", "\[Equal]", "0"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ke", "\[Equal]", "0"}], ",", 
           RowBox[{"y4", "\[Equal]", 
            RowBox[{"-", ".8"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x4", ",", "y4"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Gray", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p0", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], ",", "Red", ",", 
         " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"p0", ",", "p4"}], "}"}], "]"}], ",", "Black", ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p0\>\"", ",", "p0"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p1\>\"", ",", "p1"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p2\>\"", ",", "p2"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p3\>\"", ",", "p3"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p4\>\"", ",", "p4"}], "]"}]}], "}"}], "/.", "soln"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"gg", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4640170950827*^9, 3.464017147180792*^9}, {
   3.53360148269774*^9, 3.5336014922097597`*^9}, {3.5336016144915657`*^9, 
   3.533601638785798*^9}, 3.533601720355587*^9, 3.53360177269076*^9, {
   3.533601921992151*^9, 3.533601968065227*^9}, {3.533601999576757*^9, 
   3.533602005532362*^9}, {3.533602062765842*^9, 3.533602120212617*^9}, {
   3.533602222311076*^9, 3.533602263599299*^9}, {3.533602305452319*^9, 
   3.533602307846622*^9}, {3.533602348703611*^9, 3.533602496908576*^9}, {
   3.533749730001995*^9, 3.533749792148282*^9}, {3.533750885053211*^9, 
   3.533750904136215*^9}, {3.533750941769702*^9, 3.53375096022436*^9}, 
   3.595805834454577*^9, 3.595982676951227*^9},
