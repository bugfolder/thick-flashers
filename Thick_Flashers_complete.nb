Cell[TextData[{
 "RenderTile[{UnitRegularPolygonTile, ",
 StyleBox["n",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] renders the tile as a PolygonTile for any decoration."
}], "Text",
 CellChangeTimes->{{3.629848267057731*^9, 
  3.6298482853062563`*^9}},ExpressionUUID->"656217a9-457b-4438-8855-\
a1807b29abe5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"UnitRegularPolygonTile", ",", " ", "n_"}], "}"}], ",", 
    "decoration_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PolygonTile", ",", 
      RowBox[{"UnitRegularPolygonVertices", "[", "n", "]"}]}], "}"}], ",", 
    "decoration", ",", "opts"}], "]"}]}]], "Input",
