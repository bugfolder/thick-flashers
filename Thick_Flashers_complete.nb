Cell["Example. A single fold.", "Text",
 CellChangeTimes->{{3.592858845707741*^9, 3.592858846473383*^9}, {
  3.59285925564608*^9, 3.592859257287081*^9}, {3.592859772120158*^9, 
  3.592859782852243*^9}},ExpressionUUID->"fd0f1cec-ab45-4f43-8ebe-\
8b1c9ea4bd42"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "vertscp", ",", "vertsff", ",", "edges", ",", "faces", ",", "types", ",", 
     "tobjcp", ",", "tobjff"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vertscp", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"vertsff", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"edges", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "5"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"types", "=", 
     RowBox[{"{", 
      RowBox[{
      "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "V"}], 
      "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"faces", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "5", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tobjcp", "=", 
     RowBox[{"MakeTGraphAssigned", "[", 
      RowBox[{"vertscp", ",", "edges", ",", "faces", ",", "types"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"tobjff", "=", 
     RowBox[{"tobjcp", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices", "\[Rule]", "vertsff"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobjcp", "]"}], ",", 
        RowBox[{"GraphGraphics", "[", "tobjff", "]"}]}], "}"}], "]"}], "]"}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"LocalFaceOrdering", "[", "tobjcp", "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.592858847860308*^9, 3.592859013022902*^9}, {
   3.5928590622111273`*^9, 3.592859248479473*^9}, {3.594734255918497*^9, 
   3.594734255980878*^9}, 3.594734556713977*^9, 3.628786903545535*^9, 
   3.62886367235072*^9},
 CellLabel->
  "In[1868]:=",ExpressionUUID->"0d32b338-700b-4694-852b-1690d9e7e3fa"],

Cell["\<\
Example. Make a plane graph, assign it, then calculate the local facet \
ordering. We\[CloseCurlyQuote]ll visualize the ordering by using \
GenericGraphGraphics on the face centroids and local facet ordering.\
\>", "Text",
 CellChangeTimes->{{3.484782986399082*^9, 3.484782987087127*^9}, {
  3.592429752095305*^9, 3.592429768811831*^9}, {3.592789774700807*^9, 
  3.592789809560026*^9}, {3.627842790469287*^9, 3.62784281554298*^9}, {
  3.627843952552438*^9, 3.627843968469698*^9}, {3.627844229079468*^9, 
  3.6278442540585*^9}},ExpressionUUID->"37582979-33dd-4891-a19e-7f6c0e895f22"],

Cell[TextData[{
 "Note: the ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " functions ShowGraph could, in principle, show the ordered graph, but if we \
want to superimpose the ordering graph on the original graph, we have to do \
it this way with GenericGraphGraphics because ShowGraph renormalizes the \
embedding coordinates."
}], "Text",
 CellChangeTimes->{{3.627843978590079*^9, 3.627844050424575*^9}, {
  3.628864595337632*^9, 
  3.628864604020433*^9}},ExpressionUUID->"82572ddb-fc23-4e31-affb-\
f8703d23ef9f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobj", ",", "fc", ",", "fverts", ",", "dverts", ",", "lfo", ",", 
      "fgraph"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTPlaneGraph", "[", 
        RowBox[{"pgvertscp", ",", "pgedges", ",", "pgfaces"}], "]"}], "//", 
       RowBox[{"AddTAssigned", "[", "pgtypes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"TypeToFlatFoldAngle", "[", "pgtypes", "]"}], ",", 
        RowBox[{"StationaryFace", "\[Rule]", "4"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lfo", "=", 
      RowBox[{"LocalFaceOrdering", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"FaceupFace", "\[Rule]", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"GraphGraphics", "[", 
           RowBox[{"tobj", ",", 
            RowBox[{"FaceColoring", "\[Rule]", 
             RowBox[{"TwoColorGraph", "[", 
              RowBox[{"tobj", ",", 
               RowBox[{"StartFace", "\[Rule]", "1"}]}], "]"}]}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
           RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graph2DGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Show", "[", 
           RowBox[{
            RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"GenericGraphGraphics", "[", 
             RowBox[{
              RowBox[{"FaceCentroids", "[", "tobj", "]"}], ",", "lfo", ",", 
              RowBox[{"{", "}"}], ",", 
              RowBox[{"DirectedEdges", "\[Rule]", "True"}], ",", 
              RowBox[{"EdgeColor", "\[Rule]", "Blue"}], ",", 
              RowBox[{"VertexLabels", "\[Rule]", "None"}]}], "]"}]}], "]"}]}],
          "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
