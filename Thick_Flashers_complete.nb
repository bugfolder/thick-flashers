                  "cliprect", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", 
               RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", "Red"}], 
              "]"}]}], "}"}], ",", 
           RowBox[{"PlotLabel", "\[Rule]", "\"\<unpruned\>\""}]}], "]"}], ",",
          "\[IndentingNewLine]", 
