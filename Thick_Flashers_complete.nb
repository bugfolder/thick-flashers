     RowBox[{"tt", "=", 
      RowBox[{"{", 
       RowBox[{"V", ",", "V", ",", "V"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTLinearChain", "[", 
       RowBox[{"aa", ",", "dd", ",", "tt", ",", "0.33"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.617385278783525*^9, 3.6173852929269*^9}, {
   3.617385358041325*^9, 3.617385366122154*^9}, {3.617385427975624*^9, 
