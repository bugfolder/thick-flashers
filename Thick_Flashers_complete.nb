Cell[TextData[{
 "CurvedFoldHelix3D[",
 StyleBox["r",
  FontSlant->"Italic"],
 ", \[Theta], ",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.799744662252729*^9, 3.799744671434774*^9}, {
