Cell[BoxData[
 RowBox[{
  RowBox[{"MergeGraph3DAssigneds", "[", 
   RowBox[{"tglist_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mgdata", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AssertClasses", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"TGraph", ",", "TGraph3D", ",", "TAssigned"}], "}"}], ",", 
         "MergeGraph3DAssigneds"}], "]"}], "&"}], "/@", "tglist"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mgdata", "=", 
      RowBox[{"MergeGraphsData", "[", 
       RowBox[{"tglist", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"ApplyMergeTo", "[", 
       RowBox[{"tglist", ",", "mgdata"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "//", 
       RowBox[{"ApplyMerge3D", "[", 
        RowBox[{"tglist", ",", "mgdata"}], "]"}]}], "//", 
      RowBox[{"ApplyMergeAssigned", "[", 
       RowBox[{"tglist", ",", "mgdata"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707783701125811*^9, 3.707783712677651*^9}, {
