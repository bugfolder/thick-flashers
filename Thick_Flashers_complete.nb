      RowBox[{"{", 
       RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"UnitQuadrilateralCenteredSplitTwistTile", ",", 
            RowBox[{"{", 
             RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",",
             "\[Tau]", ",", "ip", ",", "ctype1", ",", "types1"}], "}"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"UnitQuadrilateralCenteredSplitTwistTile", ",", 
             RowBox[{"{", 
              RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",",
              "\[Tau]", ",", "ip", ",", "ctype2", ",", "types2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
