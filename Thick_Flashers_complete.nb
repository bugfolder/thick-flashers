Cell[TextData[{
 "HatRotationMatrix3D[",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 "] gives the 3D rotation matrix for a counterclockwise rotation about the 3D \
vector ",
 StyleBox["w",
  FontSlant->"Italic"],
 " by the angle whose hat transformation is ",
 StyleBox["h",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.5955272666538887`*^9, 
  3.595527346282289*^9}},ExpressionUUID->"52b887ff-8cd2-4bd0-ab20-\
90586d291f12"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatRotationMatrix3D", "[", 
   RowBox[{"h_", ",", "w_List"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"HatRotationMatrix3DNumerator", "[", 
    RowBox[{"h", ",", "w"}], "]"}], "/", 
   RowBox[{"HatRotationDenominator", "[", "h", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.595527754361866*^9, 3.595527821575969*^9}, {
   3.595527861855826*^9, 3.5955280118846817`*^9}, 3.595529192718957*^9, {
   3.5956116546386423`*^9, 3.5956116765997477`*^9}},
 CellLabel->
  "In[791]:=",ExpressionUUID->"90cbdaf2-9f73-4af0-85e7-cc8c10414dfe"],

Cell["Examples: rotation matrices about x, y, and z axes.", "Text",
 CellChangeTimes->{{3.595528052062542*^9, 3.595528053861111*^9}, {
  3.595528105568737*^9, 3.595528119080076*^9}, {3.595529450499825*^9, 
