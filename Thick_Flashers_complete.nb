Cell[TextData[{
 "GraphicsToTGraph[",
 StyleBox["obj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ",
 "SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.4850916863873796`*^9, 3.485091720224348*^9}, {
   3.485092309913229*^9, 3.485092312663928*^9}, 3.485098210034174*^9, {
