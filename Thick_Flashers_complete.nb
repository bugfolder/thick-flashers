Cell["\<\
Example. A sinusoid wrapped onto a cylinder. This example chosen because the \
analytic expressions are still tractable. It happens to have zero torsion, \
which we can see.\
\>", "Text",
 CellChangeTimes->{{3.672064180385754*^9, 3.672064188559647*^9}, {
   3.6720651047737484`*^9, 3.672065118108904*^9}, {3.672065335088128*^9, 
   3.672065367517261*^9}, 
   3.672093842461871*^9},ExpressionUUID->"ee2cf7fe-2322-44ac-8cc5-\
47f4bcf81218"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ss", ",", "t", ",", "ff", ",", "uu", ",", "csys", ",", "dsys", ",", 
      "tt", ",", "nn", ",", "bb", ",", "ll", ",", "du", ",", "dv", ",", "dt", 
      ",", "t0", ",", "dr", ",", "\[Kappa]g", ",", "\[Kappa]n", ",", "\[Eta]",
       ",", "gg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"du", "=", 
      RowBox[{"1", "/", "10"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dv", "=", 
      RowBox[{"1", "/", "10"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{"1", "/", "10"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dr", "=", "0.3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"t0", "=", "0.5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"curved", " ", "surface"}], ",", " ", 
       RowBox[{
       "which", " ", "happens", " ", "to", " ", "be", " ", "an", " ", 
        "isometric", " ", "mapping"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Cos", "[", "#2", "]"}]}], ")"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"curved", " ", "function"}], ",", " ", 
       RowBox[{"sinusoid", " ", "in", " ", "original", " ", "paper"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"ss", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], "-", "1"}], ",", "t"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ff = \>\"", ",", 
       RowBox[{"ff", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"SurfaceNormalFromSurface", "[", "ss", "]"}], "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], "-", "1"}], ",", "t"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"ff", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"csys", "//", "PrettyParameters"}], "//", "ColumnForm"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsys", "=", 
      RowBox[{"Darboux3DSystem", "[", 
       RowBox[{"ff", ",", "uu", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"dsys", "//", "PrettyParameters"}], "//", "ColumnForm"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Frenet", "-", 
       RowBox[{"Darboux", " ", "angle"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Kappa]g", ",", "\[Kappa]n"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"GeodesicCurvature3D", ",", "NormalCurvature3D"}], "}"}], "/.",
        "dsys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{"\[Kappa]g", "[", "t0", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{"\[Kappa]n", "[", "t0", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Frenet", " ", "and", " ", "Darboux", " ", "frame", " ", "components"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector3D", ",", "NormalVector3D", ",", "BinormalVector3D"}], 
        "}"}], "/.", "csys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ll", "=", 
      RowBox[{"TangentNormalVector3D", "/.", "dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Plot", " ", "the", " ", "Frenet", " ", "and", " ", "Darboux", " ", 
       "frames", " ", "at", " ", "a", " ", "specified", " ", "point"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gg", "=", "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"StyledPatch", "[", 
            RowBox[{"ss", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", ".5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
             RowBox[{"OutlineStyle", "\[Rule]", "BorderLine"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StyledCurve", "[", 
            RowBox[{"ff", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
             RowBox[{"LineStyle", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Thickness", "[", "0.005", "]"}], ",", "DarkGray"}], 
               "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Sphere", "[", 
              RowBox[{
               RowBox[{"ff", "[", "t0", "]"}], ",", ".05"}], "]"}], ",", 
             "Black"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}], ",", 
        RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
        RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Show", "[", 
            RowBox[{"gg", ",", 
             RowBox[{"Graphics3D", "[", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"StyledFrenetTrihedron", "[", 
                 RowBox[{
                  RowBox[{"ff", "[", "t0", "]"}], ",", 
                  RowBox[{"tt", "[", "t0", "]"}], ",", 
                  RowBox[{"nn", "[", "t0", "]"}], ",", 
                  RowBox[{"bb", "[", "t0", "]"}], ",", 
                  RowBox[{"FrenetVectorLength", "\[Rule]", "dr"}]}], "]"}], ",",
                 "\[IndentingNewLine]", 
                RowBox[{"{", "}"}]}], "}"}], "]"}], ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Frenet frame\>\""}]}], 
            "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Show", "[", 
            RowBox[{"gg", ",", 
             RowBox[{"Graphics3D", "[", 
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"StyledDarbouxTrihedron", "[", 
                 RowBox[{
                  RowBox[{"ff", "[", "t0", "]"}], ",", 
                  RowBox[{"tt", "[", "t0", "]"}], ",", 
                  RowBox[{"ll", "[", "t0", "]"}], ",", 
                  RowBox[{"uu", "[", "t0", "]"}], ",", 
                  RowBox[{"DarbouxVectorLength", "\[Rule]", "dr"}]}], "]"}], ",",
                 "\[IndentingNewLine]", 
                RowBox[{"{", "}"}]}], "}"}], "]"}], ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Darboux frame\>\""}]}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], "/.", 
       "CurveVectorStyle"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.672059453839222*^9, 3.6720594572303333`*^9}, {
