        RowBox[{"{", 
         RowBox[{"4", ",", "13"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "14"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "15"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "16"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "17"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "18"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"11", ",", "12"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"12", ",", "13"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"13", ",", "14"}], "}"}], ",", 
        RowBox[{"{", 
