       RowBox[{"Options", "[", "CircularAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "creasevectors", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sal", "===", "Automatic"}], ",", 
