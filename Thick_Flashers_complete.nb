Cell[CellGroupData[{

Cell[TextData[{
 "TwoColorGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) StartFace"
}], "Subsubsection",
 CellChangeTimes->{{3.7079379321959476`*^9, 
  3.707937934150941*^9}},ExpressionUUID->"24a813bd-e94d-4ec3-b082-\
7c0d93ce8803"],

Cell[TextData[{
 "TwoColorGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a list of values \[PlusMinus]1, one for each \
face, that specifies a two-coloring of the given graph (whose interior \
vertices must be of even degree)."
}], "Text",
 CellChangeTimes->{{3.484777382320342*^9, 3.484777427941508*^9}, {
   3.484777463652091*^9, 3.484777493121403*^9}, {3.484782008354083*^9, 
   3.484782044245271*^9}, {3.4847843936997423`*^9, 3.484784394083666*^9}, {
   3.48481993265482*^9, 3.484819964411074*^9}, 3.484829074922187*^9, {
   3.5917291062480707`*^9, 3.59172917688231*^9}, {3.5920496270829277`*^9, 
   3.592049627481853*^9}, {3.592432981756138*^9, 3.5924329824304047`*^9}, 
   3.59243585684242*^9, {3.592576858748838*^9, 3.592576906772936*^9}, {
   3.5928287121827183`*^9, 3.592828712286468*^9}, 3.592859456369315*^9, {
   3.707935154602563*^9, 
   3.707935169592345*^9}},ExpressionUUID->"7b3b902a-87e1-481c-8baf-\
a3a57d408652"],

Cell[TextData[{
 "Options:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"StartFace", "\[Rule]", "i"}], TraditionalForm]],ExpressionUUID->
  "5394f873-ea3f-4cd3-908a-c5905112e30b"],
 ", where ",
 StyleBox["i",
  FontSlant->"Italic"],
 " is the index of some face that will get the color +1. Pass ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "i"}], TraditionalForm]],ExpressionUUID->
  "6dc30aaa-b12e-4379-b7e5-3f33bf5d04e0"],
 " to start with that face and give it the color -1."
}], "Text",
 CellChangeTimes->{{3.707935156777823*^9, 
  3.707935160310979*^9}},ExpressionUUID->"18a37c09-4cc6-4d90-9304-\
7c96d8895aff"],

Cell["\<\
This can be supplied as the FaceColoring option to TPlaneGraphGraphic.\
\>", "Text",
 CellChangeTimes->{
  3.7079351723195486`*^9},ExpressionUUID->"f71bb545-1f74-4232-b8ef-\
eddeb9de2da5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StartFace", "::", "usage"}], 
   "=", "\"\<StartFace is an option to TwoColorGraph that specifies a face to \
get colored \[PlusMinus]1.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5917288296839733`*^9, 3.591728863557472*^9}, {
   3.592576878576507*^9, 3.592576880877364*^9}, 3.592828712373762*^9, 
   3.592859456459419*^9},
 CellLabel->
  "In[1200]:=",ExpressionUUID->"f9b02ddd-b1b7-4253-9a1a-fcd507af914c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "TwoColorGraph", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"StartFace", "\[Rule]", "1"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.484781969671968*^9, 3.48478199253918*^9}, {
   3.484782057137042*^9, 3.48478206404984*^9}, {3.484819968085973*^9, 
   3.484819970237999*^9}, 3.484829075049303*^9, 3.592828712477281*^9, 
