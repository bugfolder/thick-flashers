Cell[CellGroupData[{

Cell["Skew quadrilateral properties from four vertices ", "Subsection",
 CellChangeTimes->{{3.701270523260274*^9, 3.701270550213381*^9}, {
  3.701270587275729*^9, 3.701270589229204*^9}, {3.701272163555564*^9, 
  3.7012721639388857`*^9}, {3.768663406907855*^9, 
  3.768663407398829*^9}},ExpressionUUID->"9f991e2e-df3d-446f-bbbc-\
6431ca5d3323"],

Cell[CellGroupData[{

Cell[TextData[{
 "SkewQuadrilateralAngle[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.701270612596148*^9, 
  3.701270671861908*^9}},ExpressionUUID->"18259437-26a4-416d-94b3-\
eaa26ccc92a0"],

Cell[TextData[{
 "SkewQuadrilateralAngle[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "] takes the vertices of a skew quadrilateral in cyclic form and returns the \
fold angle along the ",
 StyleBox["p",
  FontSlant->"Italic"],
 "-",
 StyleBox["r",
  FontSlant->"Italic"],
 " diagonal."
}], "Text",
 CellChangeTimes->{{3.701270650150475*^9, 
  3.70127072932717*^9}},ExpressionUUID->"e6cac658-d908-4555-8351-\
54b0c328e4f1"],

Cell["\<\
Note that if one of the vertices is the origin and you\[CloseCurlyQuote]re \
doing symbolic analysis, the expressions will be simpler if p is the vertex \
at the origin.\
\>", "Text",
 CellChangeTimes->{{3.806333615445293*^9, 
  3.80633366379792*^9}},ExpressionUUID->"e448f475-10c8-4c17-bf26-\
5f363604b166"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SkewQuadrilateralAngle", "[", 
   RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qp", ",", "rp", ",", "sp"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qp", ",", "rp", ",", "sp"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"q", "-", "p"}], ",", 
        RowBox[{"r", "-", "p"}], ",", 
        RowBox[{"s", "-", "p"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ArcTan", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qp", "\[Cross]", "rp"}], ")"}], ".", 
        RowBox[{"(", 
         RowBox[{"rp", "\[Cross]", "sp"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"qp", "\[Cross]", "rp"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{"rp", "\[Cross]", "sp"}], ")"}]}], ".", "rp"}], "/", 
        RowBox[{"Mag", "[", "rp", "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.701270558302025*^9, 3.701270624165368*^9}, {
  3.701271848854939*^9, 3.701271992488556*^9}},
 CellLabel->
  "In[669]:=",ExpressionUUID->"3a8a616b-5642-424c-8652-7cfc79f9af8e"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.701270751840283*^9, 
  3.701270752751957*^9}},ExpressionUUID->"7276f757-293b-4866-8d9e-\
f2bbaf93bb69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"{", 
       RowBox[{".5", ",", ".5", ",", ".707"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Polygon", "[", 
          RowBox[{"{", 
           RowBox[{"p", ",", "q", ",", "r"}], "}"}], "]"}], ",", 
         RowBox[{"Polygon", "[", 
          RowBox[{"{", 
           RowBox[{"p", ",", "r", ",", "s"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "q", ",", "r", ",", "s", ",", "p"}], "}"}], 
            "]"}], ",", "Black"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "r"}], "}"}], "]"}], ",", "Red"}], "]"}]}], 
        "}"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SkewQuadrilateralAngle", "[", 
       RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "]"}], "/", 
      "\[Degree]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.701270754205342*^9, 3.701270919502741*^9}, {
  3.701272021099339*^9, 3.7012720214837003`*^9}, {3.701272064834062*^9, 
