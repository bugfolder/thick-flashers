Cell[CellGroupData[{

Cell[TextData[{
 "EdgeVertexAngles3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph3D, TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.626460049615485*^9, 3.6264600541786957`*^9}, {
   3.626460154166882*^9, 3.62646015486858*^9}, 3.626461241200854*^9, {
   3.626462833962691*^9, 3.626462846257021*^9}, {3.626463181436912*^9, 
   3.626463184794899*^9}},ExpressionUUID->"a38958e5-aea3-488d-8b9a-\
4c3bc70cb9de"],

Cell[TextData[{
 "EdgeVertexAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of the four sector angles around both vertices of all of \
the edges, of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{"i", ",", "r"}]], ",", " ", 
         SubscriptBox["\[Alpha]", 
          RowBox[{"i", ",", "l"}]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{"j", ",", "r"}]], ",", 
         SubscriptBox["\[Alpha]", 
          RowBox[{"j", ",", "l"}]]}], "}"}]}], "}"}], ",", " ", 
     "\[Ellipsis]"}], "}"}], TraditionalForm]],ExpressionUUID->
  "0988971b-2ba9-49c9-a779-3d07dceb5da5"],
 ", where each list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", 
        RowBox[{"i", ",", "r"}]], ",", " ", 
       SubscriptBox["\[Alpha]", 
        RowBox[{"i", ",", "l"}]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", 
        RowBox[{"j", ",", "r"}]], ",", 
       SubscriptBox["\[Alpha]", 
        RowBox[{"j", ",", "l"}]]}], "}"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"87c93c6f-0ef2-41ab-b648-6dbeea50dcda"],
 " applies to edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], TraditionalForm]],ExpressionUUID->
  "285204ce-efae-49c4-b46d-91d037cd6ae4"],
 " of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", and angle ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{"i", ",", "r"}]], TraditionalForm]],ExpressionUUID->
  "6027056b-9cbe-4180-8f1e-4eb85d3906d1"],
 " lies to the right of vertex ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", as viewed from the edge, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{"i", ",", "l"}]], TraditionalForm]],ExpressionUUID->
  "70380c68-5c4e-4bf9-a4db-588fcc6cfa64"],
 " lies to its left, and similarly for the other two angles. Or, \
equivalently, for each edge, the first angle lies CCW of the first vertex, \
and then the angles circulate CCW about the edge. Same as EdgeVertexAngles, \
but computed from the Vertices3D data."
}], "Text",
 CellChangeTimes->{{3.626460113028257*^9, 3.6264601145375557`*^9}, {
   3.6264601585835247`*^9, 3.626460191214245*^9}, {3.626460715385646*^9, 
   3.626460738303229*^9}, {3.626460872049326*^9, 3.626461114959526*^9}, {
   3.626462684428374*^9, 3.6264627168507757`*^9}, {3.626462906214664*^9, 
   3.626462918011832*^9}, 
   3.626463189051402*^9},ExpressionUUID->"de34e4a8-0025-4465-bdaf-\
b7202473dae6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeVertexAngles3D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "edges", ",", "vei", ",", "vea", ",", "ia", ",", "ib", ",", "veaa", ",", 
      "veab"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "vei"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "VertexEdgeIncidence"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vea", "=", 
      RowBox[{"VertexEdgeAngles3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ia", ",", "ib"}], "}"}], "=", 
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"veaa", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{
           "vea", "\[LeftDoubleBracket]", "ia", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "ia", "\[RightDoubleBracket]"}],
                ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}],
           "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "edge", " ", "angles", " ", "around", " ", "vertex", " ", "ia"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"veab", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{
           "vea", "\[LeftDoubleBracket]", "ib", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "ib", "\[RightDoubleBracket]"}],
                ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}],
           "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "edge", " ", "angles", " ", "around", " ", "vertex", " ", "ib"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "veaa", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"veaa", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "veab", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"veab", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
         "}"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.626461149608427*^9, 3.626461235540138*^9}, {
  3.626461280984852*^9, 3.626461303775401*^9}, {3.626461505608955*^9, 
  3.626461762220671*^9}, {3.626461828222152*^9, 3.6264618793646517`*^9}, {
  3.626461917273978*^9, 3.626461925521267*^9}, {3.626462204248561*^9, 
  3.626462329867334*^9}, {3.626462375478526*^9, 3.626462378446527*^9}, {
  3.626462417618225*^9, 3.626462421201359*^9}, {3.6264624669353228`*^9, 
  3.626462530971641*^9}, {3.626462575240577*^9, 3.626462590750762*^9}, {
  3.626462894315613*^9, 3.6264628997563057`*^9}, {3.626463194480596*^9, 
  3.626463197008563*^9}},
 CellLabel->
  "In[1454]:=",ExpressionUUID->"0565abb9-094a-410c-bc98-846af4415646"],

Cell["Example: 3D valley fold.", "Text",
 CellChangeTimes->{{3.591978218453109*^9, 3.591978223855441*^9}, {
  3.591982666067238*^9, 
  3.591982666791353*^9}},ExpressionUUID->"984dfa1e-996d-4679-a1bf-\
296402553d93"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "tobj", ",", "verts3d"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], "//", 
       RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"Graph3DGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "edges", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"EdgeVertexAngles", "[", "tobj", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.591974170837859*^9, 3.591974176116444*^9}, {
   3.5919742361806097`*^9, 3.591974451425126*^9}, {3.591976035779126*^9, 
   3.591976151356385*^9}, {3.591977610446155*^9, 3.591977613127735*^9}, {
   3.591977724784133*^9, 3.591977739878626*^9}, {3.591978291050632*^9, 
   3.591978359980044*^9}, {3.591978405920819*^9, 3.591978409896835*^9}, {
   3.591978508395367*^9, 3.591978517857187*^9}, {3.591980061319284*^9, 
   3.591980069392005*^9}, {3.591981326358119*^9, 3.591981326529645*^9}, {
   3.591982434854384*^9, 3.5919824601317387`*^9}, {3.5919825180547113`*^9, 
   3.591982528888126*^9}, {3.591982684268839*^9, 3.591982689331465*^9}, 
   3.592039962146874*^9, {3.592042620474176*^9, 3.592042621128052*^9}, {
   3.592049886914302*^9, 3.592049919072343*^9}, 3.59220850699616*^9, 
   3.592377766876912*^9, {3.592381208862566*^9, 3.592381282658032*^9}, 
   3.59243585878459*^9, 3.592647647082858*^9, 3.592648918745235*^9, 
   3.592828718665669*^9, {3.5928287735403976`*^9, 3.592828773608406*^9}, {
   3.59285243926063*^9, 3.592852442212222*^9}, 3.5947344372057858`*^9, {
   3.595273623541722*^9, 3.595273624131946*^9}, {3.595273739277217*^9, 
   3.595273744115782*^9}, 3.626459817400302*^9, 3.626460410649758*^9, {
   3.62646326617348*^9, 3.626463326906069*^9}},
 CellLabel->
