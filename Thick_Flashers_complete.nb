       "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"Join", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"sov", ",", 
           RowBox[{"{", 
            RowBox[{"StyledPoint", "[", 
             RowBox[{"q", ",", 
              RowBox[{"PointStyle", "\[Rule]", "OsculatingPoint"}]}], "]"}], 
            "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"osculating", " ", "vector"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"srv", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"StyledPoint", "[", 
