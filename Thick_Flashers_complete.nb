  FontSlant->"Italic"],
 "]\n\t(options) CircleDivisions, Options[Graphics]\n\
CircularRegularPolygonTwistFoldedFormGraphics[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 ", ",
