Cell[TextData[{
 "PolygonNormal3DRobust[",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.72220758622668*^9, 3.7222075954819617`*^9}, {
