Cell[CellGroupData[{

Cell["Importing/exporting and file formats", "Section",
 CellChangeTimes->{{3.6758422588642807`*^9, 3.675842265051105*^9}, {
  3.675880402489813*^9, 
  3.675880412990919*^9}},ExpressionUUID->"4895f06b-797f-48f6-858c-\
60eb5db8fe22"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.675952887021521*^9, 
  3.675952887461548*^9}},ExpressionUUID->"de81d2bf-ffc4-45e3-9b22-\
12c75ca68e14"],

Cell["\<\
The functions in this section are used for file importing/exporting. The \
import examples need an example file to import (obviously). So if you have \
$ShowExample turned on, the example code will write some test files to the \
$ExamplesDir directory, which will then be used to demonstrate importing.\
\>", "Text",
 CellChangeTimes->{{3.675952883614647*^9, 3.67595293786651*^9}, {
  3.675952990174717*^9, 3.675953028307871*^9}, {3.675953238818501*^9, 
  3.675953255524396*^9}, {3.675956105961752*^9, 3.675956108110694*^9}, {
  3.676035937022984*^9, 
  3.676035939821912*^9}},ExpressionUUID->"b6440e35-986a-4c2e-a602-\
46daa2a481db"]
}, Closed]],

Cell[CellGroupData[{

Cell["File utilities", "Subsection",
 CellChangeTimes->{{3.676031881943561*^9, 
  3.676031885029916*^9}},ExpressionUUID->"edf3d9d7-139c-4487-8d1a-\
478de9854c24"],

Cell[CellGroupData[{

Cell[TextData[{
 "AssertFileExtension[",
 StyleBox["filepath",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ext",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.676031886829174*^9, 
  3.6760319262830048`*^9}},ExpressionUUID->"728f48e2-e06b-47a2-a102-\
ead65dbbfb84"],

Cell[TextData[{
 "AssertFileExtension[",
 StyleBox["filepath",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ext",
  FontSlant->"Italic"],
 "] verifies that the file has the given extension (case-insensitive) and \
throws a fatal error if it doesn\[CloseCurlyQuote]t. It returns the filepath \
if successful."
}], "Text",
 CellChangeTimes->{{3.6760319010498333`*^9, 3.67603194523035*^9}, {
  3.676032070759398*^9, 3.676032084659305*^9}, {3.676032396935305*^9, 
  3.676032400366542*^9}},ExpressionUUID->"1612b3ff-0f87-4683-b45e-\
4235d1b24d19"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AssertFileExtension", "::", "badext"}], 
   "=", "\"\<The file path `1` does not end in extension `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.676032002306019*^9, 3.676032015772245*^9}},
 CellLabel->
  "In[4410]:=",ExpressionUUID->"2b7ffe17-00cc-413a-8c2b-28917bd4dddd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AssertFileExtension", "[", 
   RowBox[{"filepath_String", ",", "ext_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pos", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{"StringPosition", "[", 
       RowBox[{
        RowBox[{"ToLowerCase", "[", "filepath", "]"}], ",", 
        RowBox[{"ToLowerCase", "[", "ext", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ListEmptyQ", "[", "pos", "]"}], "||", 
        RowBox[{
         RowBox[{"StringLength", "[", "filepath", "]"}], "\[NotEqual]", 
         RowBox[{"pos", "\[LeftDoubleBracket]", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"AssertFileExtension", "::", "badext"}], ",", "filepath", ",",
           "ext"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "filepath"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.676031953499284*^9, 3.676031973344574*^9}, {
  3.676032184139797*^9, 3.676032211819126*^9}, {3.6760322424731083`*^9, 
  3.6760322954461193`*^9}, {3.676032415527198*^9, 3.676032426137487*^9}, {
  3.676035527351694*^9, 3.676035541928823*^9}, {3.676035572579884*^9, 
  3.67603563384098*^9}},
 CellLabel->
  "In[4411]:=",ExpressionUUID->"337ab036-ea31-4d0b-977c-219e067b45a5"],

Cell["Examples.", "Text",
 CellChangeTimes->{{3.676032022859931*^9, 3.67603202362593*^9}, {
  3.6760320926255903`*^9, 
  3.676032092858387*^9}},ExpressionUUID->"c247296b-f97c-4744-a88e-\
1e581f2c0f65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"filepath", ",", "ext"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"filepath", "=", "\"\<foo.bar\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"AssertFileExtension", "[", 
      RowBox[{"filepath", ",", "\"\<bar\>\""}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6760320251341467`*^9, 3.676032058194824*^9}, {
