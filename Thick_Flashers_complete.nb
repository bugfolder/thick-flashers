Cell[CellGroupData[{

Cell["2D and 3D styled curves and patches", "Subsection",
 CellChangeTimes->{{3.672142749963125*^9, 3.672142779503036*^9}, {
  3.688080383542964*^9, 3.688080384495218*^9}, {3.688997775819347*^9, 
  3.688997796383377*^9}, {3.689075245312876*^9, 3.689075246021864*^9}, {
  3.689275056573909*^9, 
  3.6892750571459107`*^9}},ExpressionUUID->"6e7ce18d-fafb-4771-b81b-\
9942c9022b0b"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.6721427821355457`*^9, 
  3.672142782567596*^9}},ExpressionUUID->"63791972-abff-47ef-8978-\
f5584f587235"],

Cell["\<\
These styled elements are used primarily in renderings of curved  surfaces \
and folds. They take pure functions that represent smooth curves and surfaces \
and render space curves and surfaces, respectively.\
\>", "Text",
 CellChangeTimes->{{3.672142784520309*^9, 3.672142810027957*^9}, {
  3.688080102842071*^9, 3.688080124383259*^9}, {3.688080392182578*^9, 
  3.688080394014057*^9}, {3.689247764303082*^9, 3.689247794159317*^9}, {
  3.689266111677742*^9, 
  3.689266118786217*^9}},ExpressionUUID->"b3987231-007c-4c88-9af5-\
02431350e778"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "StyledCurve[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", {",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) CurveDivisions, CurveDirected, CurveTube, \
CurveTubeThickness, LineStyle"
}], "Subsubsection",
 CellChangeTimes->{{3.6721430796250067`*^9, 3.6721431367678347`*^9}, 
   3.689075223217648*^9, 3.689075255613833*^9, 3.689247644195215*^9, {
   3.689267741853495*^9, 3.689267753409579*^9}, 3.68927509627598*^9, 
   3.689854538199619*^9, 3.6914075018002253`*^9, {3.691520694828116*^9, 
   3.691520697062622*^9}, {3.691522099269063*^9, 3.69152210070308*^9}, {
   3.786547887772749*^9, 3.786547893307666*^9}, {3.80001409236662*^9, 
   3.800014107862977*^9}, {3.800575674688905*^9, 3.800575677878839*^9}, {
   3.800654674306858*^9, 3.80065467687885*^9}, 3.803404752487708*^9, 
   3.803895409943344*^9},ExpressionUUID->"7fa9484f-cbe8-45d7-95d8-\
6f9d882ed0ca"],

Cell[TextData[{
 "StyledCurve[c, {",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces Graphics or Graphics3D elements for a styled line that \
represents a curved line specified by a parametric function. "
}], "Text",
 CellChangeTimes->{{3.672143169383984*^9, 3.672143339352504*^9}, {
   3.672144219767548*^9, 3.672144230415071*^9}, 3.6721442637651997`*^9, {
   3.67214453245947*^9, 3.672144533115139*^9}, {3.672146222041729*^9, 
   3.672146226106443*^9}, {3.688080409981945*^9, 3.688080413141083*^9}, {
   3.689075223244791*^9, 3.689075255641069*^9}, 3.689247644240466*^9, {
   3.689247687756878*^9, 3.689247690202518*^9}, {3.68926630604784*^9, 
   3.689266314236938*^9}, {3.689275096298068*^9, 3.68927509632127*^9}, {
   3.691522072233109*^9, 3.6915220862338443`*^9}, {3.6915223485189133`*^9, 
   3.691522369937422*^9}, {3.691522626287939*^9, 3.691522644891123*^9}, {
   3.8000140923885393`*^9, 
   3.800014107886795*^9}},ExpressionUUID->"0a5640ce-bf86-45fb-8262-\
ea0eb8decb20"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives the 2D or 3D trajectory of the \
line.\n\t{",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t1",
  FontSlant->"Italic"],
 "} \[LongDash] start and end values of the parameter."
}], "Text",
 CellChangeTimes->{{3.691522647301373*^9, 3.6915226512818203`*^9}, {
  3.800014092407786*^9, 
  3.8000141079053597`*^9}},ExpressionUUID->"67ec66c6-d25c-4abd-8009-\
cbf30c2d99a9"],

Cell[TextData[{
 "Options:\n\tCurveDivisions \[Rule] ",
 StyleBox["nt",
  FontSlant->"Italic"],
 ", the number of segments to use in the discretization of the curve.\n\t\
CurveDirected \[Rule] True | False, whether to add an arrowhead to the end of \
the curve.\n\tCurveTube \[Rule] True | False, whether to use Tube for the \
curve in 3D. Ignored for 2D.\n\tCurveTubeThickness \[Rule] ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", the diameter to use for 3D renderings with the curve as a tube.\n\t\
LineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " | None, a named symbolic style to use for the curve, or a list of style \
directives."
}], "Text",
 CellChangeTimes->{{3.6915226393822517`*^9, 3.691522641820896*^9}, {
   3.6940093131093283`*^9, 3.694009314461556*^9}, {3.786547923468226*^9, 
   3.786547941083632*^9}, {3.800575680547048*^9, 3.800575717628791*^9}, {
   3.8006546927104597`*^9, 3.800654721324409*^9}, 3.8034047525198607`*^9, 
   3.803860465712076*^9, 3.80389510961838*^9, {3.803895389479423*^9, 
   3.80389540632085*^9}},ExpressionUUID->"add189ac-3b51-4862-a861-\
3d4d05686fb6"],

Cell["Returns a list of elements describing the object.", "Text",
 CellChangeTimes->{{3.691522628266175*^9, 
  3.691522630888516*^9}},ExpressionUUID->"ae2803c7-e08c-4de8-b177-\
3750f0779791"],

Cell["\<\
LineStyle \[Rule] None will not generate any elements. This option is also \
used by  patch-drawing routines to specify whether to draw edges on the patch.\
\>", "Text",
 CellChangeTimes->{{3.694009322078421*^9, 3.694009392861888*^9}, {
  3.800990654541108*^9, 
  3.800990669915931*^9}},ExpressionUUID->"84db431c-7118-4e2f-959f-\
0011cb0adcf2"],

Cell["\<\
The options CurveDirected, CurveTube and CurveTubeThickness mirror those of \
LineTube and LineTubeThickness. We give them separate names to make it easier \
to combine StyledCurve with other StyledLine objects.\
\>", "Text",
 CellChangeTimes->{{3.786548671912098*^9, 3.786548714201073*^9}, {
  3.786549746343337*^9, 3.786549826016776*^9}, {3.800654756169044*^9, 
  3.800654762941669*^9}, {3.801043295695621*^9, 
  3.80104339047196*^9}},ExpressionUUID->"f27407e5-a26a-4a7d-847b-\
6207eaf15045"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CurveDivisions", "::", "usage"}], 
   "=", "\"\<CurveDivisions is an option to StyledCurve and other functions \
that specifies the number of segments to use in drawing a curved line or \
surface.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.672143415419869*^9, 3.672143436393153*^9}, {
   3.689075223260303*^9, 3.6890752232774076`*^9}, 3.689075255655223*^9, 
   3.689247644261607*^9, {3.694007328215257*^9, 3.694007340885914*^9}},
 CellLabel->
  "In[1706]:=",ExpressionUUID->"c1ba3e72-ee7d-4c76-a4d4-49da5276b24c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CurveDirected", "::", "usage"}], 
   "=", "\"\<CurveDirected is an option to StyledCurve and other functions \
that specifies whether to add an arrowhead to the end of the curve.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.672143415419869*^9, 3.672143436393153*^9}, {
   3.689075223260303*^9, 3.6890752232774076`*^9}, 3.689075255655223*^9, 
   3.689247644261607*^9, {3.694007328215257*^9, 3.694007340885914*^9}, {
   3.786547966933613*^9, 3.786547988347494*^9}},
 CellLabel->
  "In[1707]:=",ExpressionUUID->"dd6b0ff7-f154-443e-98b1-b8b198743384"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CurveTube", "::", "usage"}], 
   "=", "\"\<CurveTube is an option to StyledCurve and other functions that \
