           RowBox[{"Point", "[", "o", "]"}], ",", "Black", ",", 
           RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"o", ",", "p1"}], "}"}], "]"}], ",", "Red"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "]"}], ",", "Red", ",", 
           RowBox[{"Opacity", "[", ".25", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "p2", "]"}], ",", 
           RowBox[{"Darker", "[", "Red", "]"}], ",", 
           RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"o", ",", "q1"}], "}"}], "]"}], ",", "Blue"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], "]"}], ",", "Blue", 
           ",", 
           RowBox[{"Opacity", "[", ".25", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", 
            RowBox[{"offset", "+", 
             RowBox[{"rm", ".", "p2"}]}], "]"}], ",", 
           RowBox[{"Darker", "[", "Blue", "]"}], ",", 
           RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"\"\<p1\>\"", ",", "p1", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<p2\>\"", ",", "p2", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<p3\>\"", ",", "p3", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}]}], "}"}], ",",
            "Red"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
