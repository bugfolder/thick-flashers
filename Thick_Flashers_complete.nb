Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "fc", ",", "lfo", ",", "gfa"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"crease", " ", "pattern"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTPlaneGraph", "[", 
        RowBox[{"pgvertscp", ",", "pgedges", ",", "pgfaces"}], "]"}], "//", 
       RowBox[{"AddTAssigned", "[", "pgtypes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"primal", "-", 
       RowBox[{"dual", " ", "showing", " ", "ordering"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tobj", "//", "AddTPrimalDualGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lfo", "=", 
      RowBox[{"LocalFaceOrdering", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"FaceupFace", "\[Rule]", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"ReplaceProperty", "[", 
        RowBox[{"DualEdges", "\[Rule]", "lfo"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"two", "-", 
       RowBox[{"colored", " ", "graph"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{"TwoColorGraph", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"StartFace", "\[Rule]", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"folded", " ", "form"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"AddTGraph2D", "[", "pgvertsff", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "output", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<edge/type pairs = \>\"", ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", 
            RowBox[{"tobj", "[", "Edges", "]"}], "]"}], "]"}], ",", 
          RowBox[{"tobj", "[", "EdgeTypes", "]"}]}], "}"}], "]"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"FaceColoring", "\[Rule]", "fc"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PrimalDualGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"DualDirectedEdges", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"StdVertexLabels", "[", "pgvertsff", "]"}], ",", 
            RowBox[{"VisibleFoldedFormLines", "[", "tobj", "]"}]}], "}"}], 
          "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
