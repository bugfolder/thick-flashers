Cell[BoxData[
 RowBox[{
  RowBox[{"Darboux3DSystem", "[", 
   RowBox[{"c_Function", ",", "u_Function", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "dc", ",", "ds", ",", "t", ",",
       "l", ",", "dt", ",", "\[Kappa]g", ",", "\[Kappa]n", ",", "\[Tau]g"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Darboux3DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Darboux3DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"curve", " ", "speed"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"dc", "[", "s", "]"}], "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"dc", "[", "s", "]"}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"geodesic", " ", "curvature"}], ",", " ", 
       RowBox[{"normal", " ", "curvature"}], ",", " ", 
       RowBox[{"geodesic", " ", "torsion"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"l", "[", "s", "]"}], ".", 
           RowBox[{"dt", "[", "s", "]"}]}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "s", "]"}], ".", 
           RowBox[{"dt", "[", "s", "]"}]}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Tau]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"l", "[", "s", "]"}], ".", 
            RowBox[{
             RowBox[{"u", "'"}], "[", "s", "]"}]}]}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Speed3D", "\[Rule]", "ds"}], ",", "\[IndentingNewLine]", 
       RowBox[{"GeodesicCurvature3D", "\[Rule]", "\[Kappa]g"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalCurvature3D", "\[Rule]", "\[Kappa]n"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GeodesicTorsion3D", "\[Rule]", "\[Tau]g"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", "t"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TangentNormalVector3D", "\[Rule]", "l"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"SurfaceNormalVector3D", "\[Rule]", "u"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.67206383722228*^9, 3.672063873339328*^9}, {
