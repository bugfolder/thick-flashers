  "In[3588]:=",ExpressionUUID->"0800e5a2-a332-46c7-af17-43983bbbf359"],

Cell["Example. A cylinder with top tube tilted.", "Text",
 CellChangeTimes->{{3.67611055830855*^9, 3.67611057131264*^9}, {
  3.676111621902995*^9, 
  3.67611162595861*^9}},ExpressionUUID->"86600cc0-2f4f-4ab1-b074-\
cffbff8f4eeb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "\[Phi]", ",", "dx", ",", "dy", ",", "dz", ",", "tf", ",", 
      "tt", ",", "botpts2d", ",", "toppts2d", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "12"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"rotational", " ", "order"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"90.", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"amount", " ", "of", " ", "twist", " ", "of", " ", "top"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dx", ",", "dy"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0.0", ",", "0.0"}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"lateral", " ", "offset", " ", "of", " ", "top"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dz", "=", "0.8"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "separation", " ", "between", " ", "top", " ", "and", " ", "bottom", " ",
        "surfaces"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tf", "=", 
      RowBox[{"90.", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rotation", " ", "of", " ", "axis", " ", "of", " ", "top", " ", 
       "tilt"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tt", "=", 
      RowBox[{"15.", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"azimuthal", " ", "tilt", " ", "of", " ", "top"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{"DiscreteCircle", "[", 
       RowBox[{"m", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"toppts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dx", ",", "dy"}], "}"}], "+", "#"}], "&"}], "/@", 
       RowBox[{"DiscreteCircle", "[", 
        RowBox[{"m", ",", "1", ",", "\[Phi]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"TwistJoinedTubeGraphics", "[", 
        RowBox[{"botpts2d", ",", "toppts2d"}], "]"}], "]"}], "//", "Hold"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"TwistJoinedTubes", "[", 
       RowBox[{
       "botpts2d", ",", "toppts2d", ",", "dz", ",", "\[IndentingNewLine]", 
        RowBox[{"TwistDirection", "\[Rule]", "CCW"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"TiltAxialAngle", "\[Rule]", "tf"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"TiltAzimuthalAngle", "\[Rule]", "tt"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PanelOverlap", "\[Rule]", "True"}], ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"30", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}], ",", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6711793832328787`*^9, 3.671179568554941*^9}, {
   3.671179608644779*^9, 3.671179632783592*^9}, {3.671180537675157*^9, 
   3.671180595760953*^9}, {3.671180721215306*^9, 3.671180721486787*^9}, {
   3.671181434010552*^9, 3.6711814347886133`*^9}, {3.671181587664304*^9, 
   3.67118158821384*^9}, 3.671181746672982*^9, {3.671182046157445*^9, 
   3.671182048382059*^9}, 3.671182127130238*^9, 3.671182163011779*^9, 
   3.671182251838939*^9, {3.671182577554877*^9, 3.671182617337886*^9}, {
   3.67120710574034*^9, 3.671207158854443*^9}, {3.671207352855898*^9, 
   3.671207368995403*^9}, {3.6712466429254932`*^9, 3.671246670416904*^9}, {
   3.671247132277554*^9, 3.671247146196192*^9}, {3.671247179677291*^9, 
   3.6712471798051977`*^9}, {3.671247332996438*^9, 3.671247333014287*^9}, {
   3.671251246622725*^9, 3.671251283104899*^9}, {3.671290541625345*^9, 
   3.671290554830566*^9}, {3.6712909479987917`*^9, 3.671290970042039*^9}, {
   3.671359372697695*^9, 3.671359381876006*^9}, {3.671361504891985*^9, 
   3.6713615276252413`*^9}, 3.671361610134247*^9, {3.6713616823515472`*^9, 
   3.671361690039837*^9}, {3.67136183109759*^9, 3.671361860798465*^9}, 
   3.6713618992408037`*^9, {3.671528224082247*^9, 3.671528234933083*^9}, {
   3.671528397472945*^9, 3.6715284044169617`*^9}, {3.671528609635127*^9, 
   3.6715286098326063`*^9}, {3.671528667120429*^9, 3.671528690731887*^9}, {
   3.67152872298779*^9, 3.67152878882143*^9}, {3.6715290644767447`*^9, 
   3.671529068233974*^9}, {3.673101662190151*^9, 3.673101674507875*^9}, {
   3.675324338198845*^9, 3.675324356788396*^9}, {3.676110580174958*^9, 
   3.676110714048634*^9}, {3.676110880958331*^9, 3.676111092747436*^9}, {
   3.676111126003817*^9, 3.676111219398273*^9}, 3.676116513822466*^9},
 CellLabel->
