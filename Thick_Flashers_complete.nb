Cell[CellGroupData[{

Cell["Woven tessellations", "Section",
 CellChangeTimes->{{3.46280075270017*^9, 
  3.462800759168696*^9}},ExpressionUUID->"a4e9ce50-0751-4b67-aeb5-\
bbe4a82d535b"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.462800768679837*^9, 
  3.462800769151659*^9}},ExpressionUUID->"6f11cb66-950a-4001-b20d-\
1bcc733df6b0"],

Cell["\<\
This section includes functions for constructing a woven tessellation from an \
arbitrary graph (that must still satisfy a few conditions). The user provides \
an embedding of a graph consisting of degree-4 vertices in which all interior \
edges form straight lines. It constructs a graph-theoretic description of the \
crease pattern and folded form of a tessellation that is a woven pattern of \
strips that follow the lines of the graph. Additional functions are provided \
for rendering the crease pattern and folded form.\
\>", "Text",
 CellChangeTimes->{{3.462800761264333*^9, 3.462800774151316*^9}, {
  3.462800818814398*^9, 3.4628008888954372`*^9}, {3.462800933196375*^9, 
  3.46280100267746*^9}},ExpressionUUID->"320ade1d-3c17-484d-809c-\
39545a853aa3"]
}, Closed]],

Cell[CellGroupData[{

Cell["Woven tessellation line sets", "Subsection",
 CellChangeTimes->{{3.462813777659947*^9, 3.462813787483376*^9}, {
   3.46281394884274*^9, 3.462813956010192*^9}, 3.462927389266211*^9, {
   3.627770219058032*^9, 
   3.627770220009747*^9}},ExpressionUUID->"1af960f3-450f-4513-b364-\
4d118e59c813"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.462813795579254*^9, 
  3.462813795994793*^9}},ExpressionUUID->"6728919d-a72d-4714-ad16-\
2322fbb7dc46"],

Cell["\<\
An interesting type of woven tessellation is one with rotational symmetry and \
roughly circular shape. I call this a \"chord star\", since each of the lines \
is a chord of the bounding circle (although options are provided to use a \
different boundary polygon). These functions create chord stars with crossing \
lines. Once you've found an aesthetically nice chord star, you can \
Intersectify it to create a graph suitable for conversion to a woven \
tessellation.\
\>", "Text",
 CellChangeTimes->{{3.462813797540423*^9, 3.462813822513556*^9}, {
   3.462814078082148*^9, 3.462814106711737*^9}, {3.462968784346751*^9, 
   3.462968912905945*^9}, 3.591896139868081*^9, {3.592613605036594*^9, 
   3.592613605236601*^9}, {3.703791102098377*^9, 
   3.703791102817943*^9}},ExpressionUUID->"d9b9fb6e-c184-4787-8cd9-\
7ef507f853d5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeChordStarLines[",
 StyleBox["specs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]\n",
 "MakeChordStarLines",
 "[",
 StyleBox["specs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["boundary",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.462899703365302*^9, 3.462899753159853*^9}, {
  3.462924674624844*^9, 3.46292468142136*^9}, {3.46292477540917*^9, 
  3.462924785661811*^9}, {3.462927152114174*^9, 3.462927157513409*^9}, {
  3.592559362777544*^9, 
  3.5925593628431587`*^9}},ExpressionUUID->"be709a2e-7bca-41c7-9794-\
5696a675dc34"],

Cell[TextData[{
 "MakeChordStarLines[",
 StyleBox["specs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "] creates a pattern of lines clipped to a unit circle in which each line is \
a chord of the circle and the overall pattern has ",
 StyleBox["m",
  FontSlant->"Italic"],
 "-fold rotational symmetry from duplication/rotation. Use ",
 StyleBox["m",
  FontSlant->"Italic"],
 "=1 for no duplication/rotation. The bounding polygon is the convex hull of \
all of the lines. Since we clip to a unit circle, the distances must be \
nonzero and of magnitude less than 1. Distances may be negative. Output is a \
list of point pairs defining the lines plus the boundary."
}], "Text",
 CellChangeTimes->{{3.46289973365767*^9, 3.462899742552899*^9}, {
   3.462924686925159*^9, 3.462924742840806*^9}, {3.462924796565377*^9, 
   3.4629249491951513`*^9}, 3.46292535330037*^9, {3.4629271185725408`*^9, 
   3.462927165020329*^9}, {3.466798649562957*^9, 3.466798684815953*^9}, {
   3.466798921776284*^9, 3.466798945854658*^9}, 3.592559362917264*^9, {
   3.627770300900184*^9, 
   3.627770351209099*^9}},ExpressionUUID->"1340e1e5-1bbd-49c4-a52b-\
767863f0bf78"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeChordStarLines", "::", "distzero"}], 
   "=", "\"\<The distances in the list `1` cannot contain zero values.\>\""}],
   ";"}]], "Input",
 CellChangeTimes->{{3.466798537954761*^9, 3.466798607502256*^9}, {
   3.466798699280767*^9, 3.466798730364871*^9}, 3.592559362945569*^9},
 CellLabel->
  "In[3392]:=",ExpressionUUID->"751c0050-8f47-4fa2-97d3-f05e1605760b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeChordStarLines", "::", "distmag"}], 
   "=", "\"\<The distances in the list `1` must have magnitude less than 1.\>\
\""}], ";"}]], "Input",
 CellChangeTimes->{{3.466798537954761*^9, 3.466798607502256*^9}, {
   3.466798699280767*^9, 3.466798712379719*^9}, 3.592559363171521*^9},
 CellLabel->
  "In[3393]:=",ExpressionUUID->"c1ae6230-a7d2-43a9-8edb-4a0d4c53ec6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeChordStarLines", "[", 
   RowBox[{"specs_List", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dists", ",", "lines", ",", "alllines", ",", "bverts"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dists", "=", 
      RowBox[{"Last", "/@", "specs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Or", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "dists"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeChordStarLines", "::", "distzero"}], ",", "specs"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Or", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "#", "]"}], "\[GreaterEqual]", "1"}], "&"}], "/@",
           "dists"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeChordStarLines", "::", "distmag"}], ",", "specs"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"U", "[", 
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
            
            RowBox[{"ArcCos", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}]}], "]"}], ",", 
          RowBox[{"U", "[", 
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
            
            RowBox[{"ArcCos", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}]}], "]"}]}], "}"}], "&"}], "/@", "specs"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alllines", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"RotationMatrix2D", "[", 
               RowBox[{"2", "\[Pi]", " ", 
                RowBox[{"i", "/", "m"}]}], "]"}], ".", "#"}], "&"}], ",", 
            "lines", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"bverts", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"alllines", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"ArcTan", "@@", "#1"}], "<", 
          RowBox[{"ArcTan", "@@", "#2"}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"alllines", ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"bverts", ",", 
          RowBox[{"RotateLeft", "[", "bverts", "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.462925377675631*^9, 3.462925392062943*^9}, {
   3.462925439292143*^9, 3.462925462730301*^9}, {3.462925509087701*^9, 
   3.462925667489337*^9}, {3.462925706912261*^9, 3.4629258261362*^9}, 
   3.462927166833529*^9, 3.462927355712874*^9, {3.466798610636712*^9, 
   3.46679863205831*^9}, {3.466798736938506*^9, 3.466798843388392*^9}, {
   3.592559363408845*^9, 3.592559363873407*^9}, 3.688166971655235*^9, {
   3.7057839591951942`*^9, 3.705783970983597*^9}},
 CellLabel->
  "In[3394]:=",ExpressionUUID->"51fa7446-22c7-4a65-9350-d59f991d0091"],

