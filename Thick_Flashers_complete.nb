Cell[TextData[{
 "UnitRegularPolygonOffsetTwistPatch[",
 StyleBox["patchspecs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["parity",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] creates a tiling (a list of tilespecs) of UnitRegular",
 "Polygon",
 "OffsetTwistTile with parameters {w, d} and edge types ",
 StyleBox["types",
  FontSlant->"Italic"],
 ". parity is a vector of \[PlusMinus]1 values that is multiplied against the \
values of ",
 StyleBox["d",
  FontSlant->"Italic"],
 " for each tile to specify the individual twist directions."
}], "Text",
 CellChangeTimes->{{3.629920051453157*^9, 3.629920117404588*^9}, {
  3.629920286715608*^9, 3.6299203613822002`*^9}, {3.629921406579729*^9, 
