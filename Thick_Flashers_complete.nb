  3.911992713772133*^9}},ExpressionUUID->"265f8005-9f6b-4f7d-b1c2-\
765e2fcbb052"],

Cell["\<\
ScaleGCs scales the coordinates all of the GraphicsComplex objects in an \
expression by the same factor.\
\>", "Text",
 CellChangeTimes->{{3.9119909533133783`*^9, 3.911990977344364*^9}, {
  3.911992688926539*^9, 3.911992706753528*^9}, {3.913541048738568*^9, 
  3.913541052700798*^9}},ExpressionUUID->"0e2f3cb0-46df-4934-840e-\
c07bde537e60"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] an expression containing GraphicsComplex objects.\n\t",
 StyleBox["amt",
  FontSlant->"Italic"],
 " \[LongDash] a factor to multiply all vertex coordinates by."
}], "Text",
 CellChangeTimes->{{3.9119915980129247`*^9, 3.911991630908865*^9}, {
  3.911992716687826*^9, 
  3.911992729193685*^9}},ExpressionUUID->"a4c21edc-f1b6-4e47-87f4-\
037bbf2faba8"],

Cell["Returns: the modified expression.", "Text",
 CellChangeTimes->{{3.9119916343660393`*^9, 3.911991656398713*^9}, {
  3.911992738400283*^9, 
  3.9119927424834146`*^9}},ExpressionUUID->"72852c64-bcea-40aa-931d-\
586e4ab94b11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ScaleGCs", "[", 
   RowBox[{"expr_", ",", "amt_"}], "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{
    RowBox[{"GraphicsComplex", "[", 
     RowBox[{"pts_", ",", "more___"}], "]"}], ":>", 
    RowBox[{"GraphicsComplex", "[", 
     RowBox[{
      RowBox[{"pts", "*", "amt"}], ",", "more"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.911991727383892*^9, 3.911991744784897*^9}, {
   3.911991818254894*^9, 3.911991885977803*^9}, 3.9119926889363213`*^9, {
   3.911992745589183*^9, 3.9119927548462353`*^9}},
 CellLabel->
  "In[4324]:=",ExpressionUUID->"52d35c71-7d64-437a-95aa-a40807a7b0ee"],

