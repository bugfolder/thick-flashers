}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronExistsQ[{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.768663119370329*^9, 
  3.768663125117056*^9}},ExpressionUUID->"6a544523-72fc-4b53-9eae-\
160d62aaaeb3"],

Cell[TextData[{
 "TetrahedronExistsQ[{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}] returns true if the points and side lengths are compatible with a valid \
tetrahedron, which includes degenerate tetrahedron where all four vertices \
are coplanar."
}], "Text",
 CellChangeTimes->{{3.768663191687757*^9, 
  3.768663236591824*^9}},ExpressionUUID->"947cb613-074a-45f3-96b6-\
3c32ce204898"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "} \[LongDash] first point and distance from that point.\n\t{",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "} \[LongDash] second point and distance from that point.\n\t{",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "} \[LongDash] third point and distance from that point."
}], "Text",
 CellChangeTimes->{{3.768658537716063*^9, 3.768658627603674*^9}, 
   3.768662832207377*^9},ExpressionUUID->"9943911b-d3c4-4ca8-8615-\
6f42350a7222"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronExistsQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pa_List", ",", "a_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pb_List", ",", "b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pc_List", ",", "c_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"TetrahedronVolumeSquared", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pa", ",", "a"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"pb", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"pc", ",", "c"}], "}"}]}], "]"}], "\[GreaterEqual]", 
   "0"}]}]], "Input",
 CellChangeTimes->{{3.7686616398258057`*^9, 3.7686616841891117`*^9}, {
  3.768663127506661*^9, 3.768663128802978*^9}},
 CellLabel->
  "In[653]:=",ExpressionUUID->"54b9dbfe-0d59-4880-b926-2137535c05df"]
}, Closed]],

Cell[CellGroupData[{

Cell["Analysis", "Subsubsection",
 CellChangeTimes->{{3.76825279577036*^9, 3.768252796392931*^9}, 
   3.768258298951626*^9},ExpressionUUID->"bebb2267-986b-4aa1-8b67-\
9b68099bed37"],

Cell["\<\
Solve for the 4th point of a general tetrahedron given 3 points and the \
lengths of the 3 edges connecting it to the three points. \
We\[CloseCurlyQuote]ll first solve for the 3 points in a standard position in \
order to get the simplest possible expressions, which will permit sequential \
analytic construction of the apex of an arbitrary tetrahedron.\
\>", "Text",
 CellChangeTimes->{{3.768252966871861*^9, 3.768253022561722*^9}, {
  3.768258308413365*^9, 
  3.768258346345535*^9}},ExpressionUUID->"27bfb65d-d61d-4730-9d85-\
9a251b35963e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pa", ",", "pb", ",", "pc", ",", "pd", ",", "eqns", ",", "soln"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pa", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{"{", 
       RowBox[{"bx", ",", "0", ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pc", "=", 
      RowBox[{"{", 
       RowBox[{"cx", ",", "cy", ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pd", "=", 
      RowBox[{"{", 
       RowBox[{"dx", ",", "dy", ",", "dz"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Mag2", "[", 
          RowBox[{"pd", "-", "pa"}], "]"}], "\[Equal]", 
         SuperscriptBox["a", "2"]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Mag2", "[", 
          RowBox[{"pd", "-", "pb"}], "]"}], "\[Equal]", 
         SuperscriptBox["b", "2"]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Mag2", "[", 
          RowBox[{"pd", "-", "pc"}], "]"}], "\[Equal]", 
         SuperscriptBox["c", "2"]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"eqns", ",", "pd"}], "]"}], "//", "FullSimplify"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Show", " ", "our", " ", "algebraic", " ", "solution"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "soln", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"example", ":", " ", 
       RowBox[{"a", " ", "regular", " ", "tetrahedron"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bx", "\[Rule]", "1"}], ",", 
        RowBox[{"cx", "\[Rule]", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"cy", "\[Rule]", 
         RowBox[{
          SqrtBox["3"], "/", "2"}]}], ",", 
        RowBox[{"a", "\[Rule]", "1"}], ",", 
        RowBox[{"b", "\[Rule]", "1"}], ",", 
        RowBox[{"c", "\[Rule]", "1"}]}], "}"}]}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.768252797654063*^9, 3.768252912802523*^9}, {
   3.768252948050926*^9, 3.768252950323132*^9}, {3.768258351379376*^9, 
   3.768258440384926*^9}, 3.768269903332122*^9, {3.768662743959078*^9, 
   3.768662745872116*^9}},
 CellLabel->
  "In[654]:=",ExpressionUUID->"43f9a81c-13d1-4706-abb6-18b34c6fec0f"],

Cell["\<\
So that tells us that the second solution is the one that points \
\[OpenCurlyDoubleQuote]up\[CloseCurlyDoubleQuote] for CCW orientation of pa, \
pb, pc.\
\>", "Text",
 CellChangeTimes->{{3.768253156722061*^9, 
  3.768253193769224*^9}},ExpressionUUID->"55c834e3-f8b7-48f7-86b9-\
20de5061c03c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronVertex[{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.768248253215271*^9, 3.768248260732588*^9}, {
  3.768249237236604*^9, 3.768249243854083*^9}, {3.76825848816763*^9, 
  3.76825851039132*^9}, {3.76865851162232*^9, 
  3.768658515355745*^9}},ExpressionUUID->"6184e799-72c9-43be-8863-\
662e2cac323c"],

Cell[TextData[{
 "TetrahedronVertex[{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "] computes the fourth point of a tetrahedron given three points and the \
distances of the 4th point from those three points."
}], "Text",
 CellChangeTimes->{{3.7682573451972446`*^9, 3.768257373772627*^9}, 
   3.768258538407748*^9, {3.76865852446581*^9, 
   3.768658525160558*^9}},ExpressionUUID->"f03d5ed3-c878-4218-8905-\
cf42ea9669eb"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["pa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a",
  FontSlant->"Italic"],
 "} \[LongDash] first point and distance from that point.\n\t{",
 StyleBox["pb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "} \[LongDash] second point and distance from that point.\n\t{",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "} \[LongDash] third point and distance from that point.\n\t",
 StyleBox["dir",
  FontSlant->"Italic"],
 " \[LongDash] +1 to put point above plane of CCW triangle, \[Dash]1 for \
below."
}], "Text",
 CellChangeTimes->{{3.768658537716063*^9, 
  3.768658627603674*^9}},ExpressionUUID->"2bb38790-9b38-431e-9bba-\
a16bc38628b1"],

Cell[TextData[{
 "For ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "\[Equal]+1, we choose the solution that puts the point above the triangle \
plane for CCW orientation of the 3 points. Use ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "\[Equal]\[Dash]1 (or reverse the order of the 3 points) to get the other \
solution."
}], "Text",
 CellChangeTimes->{{3.768257378189132*^9, 3.7682573862141*^9}, {
  3.768257483149485*^9, 3.7682575223328*^9}, {3.768258545616127*^9, 
  3.7682585636978703`*^9}, {3.768658661617219*^9, 3.76865869222513*^9}, {
  3.768663357163578*^9, 
  3.7686633573886976`*^9}},ExpressionUUID->"8652073f-6eb5-4bbf-9b6a-\
6b62143ca743"],

Cell["\<\
Note that there are distances for which there is no real solution. This \
function will return a point in such a case, but it will have complex-valued \
coordinates. Use TetrahedronExistsQ to check for existence.\
\>", "Text",
 CellChangeTimes->{{3.768658704531478*^9, 3.76865875220754*^9}, {
  3.768663368161721*^9, 
  3.768663378734012*^9}},ExpressionUUID->"4e7156de-34cd-493c-85be-\
f8f9f6cd5bee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TetrahedronVertex", "::", "baddir"}], 
   "=", "\"\<`1` must be \[PlusMinus]1.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.768658774256166*^9, 3.768658793686314*^9}},
 CellLabel->
  "In[655]:=",ExpressionUUID->"4c06d784-0b3e-4bb6-828b-83c50b13673e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronVertex", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pa_List", ",", "a_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pb_List", ",", "b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"pc_List", ",", "c_"}], "}"}], ",", 
    RowBox[{"dir_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xx", ",", "yy", ",", "zz", ",", "bx", ",", "cx", ",", "cy", ",", "dx", ",",
       "dy", ",", "dz"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dir", "\[NotEqual]", "1"}], "&&", 
        RowBox[{"dir", "\[NotEqual]", 
         RowBox[{"-", "1"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"TetrahedronVertex", "::", "baddir"}], ",", "dir"}], "]"}], 
        ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Build", " ", "a", " ", "local", " ", "coordinate", " ", "system"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"xx", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"pb", "-", "pa"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"zz", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"pb", "-", "pa"}], ")"}], "\[Cross]", 
        RowBox[{"(", 
         RowBox[{"pc", "-", "pa"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yy", "=", 
      RowBox[{"zz", "\[Cross]", "xx"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Compute", " ", "local", " ", "parameters", " ", "of", " ", "the", " ", 
       "triangle"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bx", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pb", "-", "pa"}], ")"}], ".", "xx"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cx", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pc", "-", "pa"}], ")"}], ".", "xx"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cy", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pc", "-", "pa"}], ")"}], ".", "yy"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Construct", " ", "4", "th", " ", "point", " ", "in", " ", "local", " ",
        "coordinate", " ", "system"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dx", "=", 
      FractionBox[
       RowBox[{
        SuperscriptBox["a", "2"], "-", 
        SuperscriptBox["b", "2"], "+", 
        SuperscriptBox["bx", "2"]}], 
       RowBox[{"2", " ", "bx"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dy", "=", 
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"bx", "-", "cx"}], ")"}]}], "+", 
        RowBox[{
         SuperscriptBox["b", "2"], " ", "cx"}], "+", 
        RowBox[{"bx", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["c", "2"]}], "-", 
           RowBox[{"bx", " ", "cx"}], "+", 
           SuperscriptBox["cx", "2"], "+", 
           SuperscriptBox["cy", "2"]}], ")"}]}]}], 
       RowBox[{"2", " ", "bx", " ", "cy"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dz", "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", " ", "bx", " ", "cy"}]], 
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               SuperscriptBox["a", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"bx", "-", "cx"}], ")"}]}], "+", 
              RowBox[{
               SuperscriptBox["b", "2"], " ", "cx"}], "-", 
              RowBox[{"bx", " ", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["c", "2"], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"bx", "-", "cx"}], ")"}], " ", "cx"}]}], ")"}]}]}],
              ")"}], "2"]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["a", "4"], "+", 
             SuperscriptBox["b", "4"], "+", 
             RowBox[{"2", " ", 
              SuperscriptBox["b", "2"], " ", "bx", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "bx"}], "+", "cx"}], ")"}]}], "-", 
             RowBox[{"2", " ", 
              SuperscriptBox["a", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["b", "2"], "+", 
                RowBox[{"bx", " ", "cx"}]}], ")"}]}], "+", 
             RowBox[{
              SuperscriptBox["bx", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["bx", "2"], "-", 
                RowBox[{"2", " ", 
                 SuperscriptBox["c", "2"]}], "-", 
                RowBox[{"2", " ", "bx", " ", "cx"}], "+", 
                RowBox[{"2", " ", 
                 SuperscriptBox["cx", "2"]}]}], ")"}]}]}], ")"}], " ", 
           SuperscriptBox["cy", "2"]}], "-", 
          RowBox[{
           SuperscriptBox["bx", "2"], " ", 
           SuperscriptBox["cy", "4"]}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "the", " ", "point", " ", "in", " ", "original", " ", 
       "coordinate", " ", "system"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pa", "+", 
      RowBox[{"dx", " ", "xx"}], " ", "+", " ", 
      RowBox[{"dy", " ", "yy"}], " ", "+", 
      RowBox[{"dir", " ", "dz", " ", "zz"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.768256877217068*^9, 3.7682568933176126`*^9}, {
  3.768256965215238*^9, 3.768257256324463*^9}, {3.7682572936686497`*^9, 
