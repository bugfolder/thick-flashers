         "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"re", "-", 
        RowBox[{
        "fold", " ", "it", " ", "to", " ", "the", " ", "new", " ", 
         "angle"}]}], ",", " ", 
       RowBox[{"keeping", " ", "original", " ", "orientation"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
