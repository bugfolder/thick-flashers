  3.595004979130218*^9}},ExpressionUUID->"00e930b6-d06c-4b5a-b970-\
ea26da4e814e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DynamicModule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vtobj", ",", "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", 
      "\[Gamma]4", ",", "tobj", ",", "da", ",", "vrules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"vtobj", "=", 
        RowBox[{"MakeTDegree4Vertex3DFromSectorsAndMinorDihedral", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"60.", "\[Degree]"}], ",", 
            RowBox[{"120.", "\[Degree]"}], ",", 
            RowBox[{"120", "\[Degree]"}], ",", 
            RowBox[{"60.", "\[Degree]"}]}], "}"}], ",", "gm"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"MakeTMiuraMarsOri", "[", 
         RowBox[{"vtobj", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "6"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FoldedFormGraphics3D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"PlotRange", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "6"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}]}], "]"}], "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"gm", ",", 
        RowBox[{"1.", "\[Degree]"}], ",", 
        RowBox[{"179.", "\[Degree]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.703598471377063*^9, 3.703598515432567*^9}},
 CellLabel->
  "In[2489]:=",ExpressionUUID->"06730cdc-f0b3-4d94-8eea-72e31f463ab0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeGeneralTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 "}]\nMakeGeneralTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}]\n\t(checked classes) TVertex"
}], "Subsubsection",
 CellChangeTimes->{{3.6424602778582907`*^9, 3.642460284648408*^9}, {
  3.642460368274674*^9, 3.642460369907177*^9}, {3.64253540454832*^9, 
  3.642535404924642*^9}, {3.642537207285253*^9, 3.642537219710685*^9}, {
  3.642542511519812*^9, 3.6425425115652437`*^9}, {3.643277061765666*^9, 
  3.643277062857545*^9}},ExpressionUUID->"81f908da-aeea-426f-b4d5-\
c81bcb0324e1"],

Cell["\<\
A general TMiuraMarsOri uses a non-mirror-symmetric flat-foldable vertex as \
the generating vertex. The pattern is similar to that of the TMiuraMarsOri, \
but doesn\[CloseCurlyQuote]t have quite the same periodic properties as the \
mirror-symmetric versions, and as the edge distances propagate inward, it is \
possible to get negative edge lengths.\
\>", "Text",
 CellChangeTimes->{{3.642460373293042*^9, 3.642460394746051*^9}, {
  3.6425425228031397`*^9, 3.64254258752883*^9}, {3.6426069021520233`*^9, 
  3.6426069096586533`*^9}},ExpressionUUID->"66c5a31e-ebb8-41ec-b37f-\
ea47eb4df8b3"],

Cell[TextData[{
 "MakeGeneralTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 "}] takes a degree-4 TVertex representing a vertex and two lists of \
distances ",
 StyleBox["dilst1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 ", and creates a TMiuraMarsOri representing a Miura-ori or Barreto \
\[OpenCurlyQuote]Mars\[CloseCurlyQuote] with distances ",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 " along the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], "-", 
    SubscriptBox["\[Gamma]", "3"]}], TraditionalForm]],ExpressionUUID->
  "0c6c5d00-e667-4ee0-9410-7f89435138b5"],
 " chain and distances ",
 StyleBox["dlst2",
  FontSlant->"Italic"],
 " along the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "2"], "-", 
    SubscriptBox["\[Gamma]", "4"]}], TraditionalForm]],ExpressionUUID->
  "ef4a0f1c-c29e-4398-9852-32e99a6e8658"],
 " chain. The TVertex vtobj  needs to be in standard position (i.e., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "99d0f727-03e3-4a6c-aa01-f909e480a115"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "3"], TraditionalForm]],ExpressionUUID->
  "e7d830c0-b763-492b-8a1b-6df587c58804"],
 " are minor); its sector and dihedral angles need to be consistent; it needs \
to be flat-foldable. It doesn\[CloseCurlyQuote]t need to be mirror-symmetric. \
(It will work for a mirror-symmetric vertex, but MakeTMiuraMarsOri is more \
efficient.)"
}], "Text",
 CellChangeTimes->{{3.442882672893553*^9, 3.4428828116669903`*^9}, {
   3.4429714489772468`*^9, 3.4429714526062803`*^9}, {3.443015737240294*^9, 
   3.443015886482121*^9}, {3.4430175708891*^9, 3.4430176693597517`*^9}, 
   3.443220653198539*^9, {3.443220689660924*^9, 3.4432207392757607`*^9}, {
   3.443221309867934*^9, 3.4432213362789187`*^9}, {3.59208444067141*^9, 
   3.592084496129277*^9}, 3.592435758332773*^9, {3.592439012815792*^9, 
   3.592439014181987*^9}, {3.592829323117475*^9, 3.592829323211237*^9}, {
   3.594987088587085*^9, 3.594987088719049*^9}, {3.594992190044483*^9, 
   3.5949922535738363`*^9}, 3.594992334376874*^9, {3.594992446832039*^9, 
   3.594992469842762*^9}, {3.594996716624131*^9, 3.594996723550061*^9}, {
   3.5949969594661407`*^9, 3.594996962447666*^9}, {3.595003494121017*^9, 
   3.595003561541481*^9}, 3.595003819112583*^9, {3.595005058118781*^9, 
   3.595005139568651*^9}, {3.595006633881788*^9, 3.595006634455713*^9}, {
   3.595010922648111*^9, 3.595010922782803*^9}, {3.595011077923333*^9, 
   3.595011079354453*^9}, {3.595011787039667*^9, 3.5950118204500093`*^9}, {
   3.59501242532395*^9, 3.59501247179536*^9}, 3.616161104999427*^9, {
   3.616179087656835*^9, 3.616179089984578*^9}, {3.64243175484579*^9, 
   3.642431786326721*^9}, {3.642431831747204*^9, 3.642431936890329*^9}, {
   3.642433020728579*^9, 3.6424330207786217`*^9}, {3.642433272903133*^9, 
   3.642433274550108*^9}, {3.642459760809576*^9, 3.642459770488118*^9}, {
   3.642459824388206*^9, 3.642459930864226*^9}, 3.642535361612852*^9, {
   3.642535643222897*^9, 3.642535667767808*^9}, 3.64254251160732*^9, {
   3.643277064376484*^9, 
   3.643277065312572*^9}},ExpressionUUID->"8d946644-8686-4df5-8c8f-\
8db7534c5518"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeGeneralTMiuraMarsOri", "::", "badsize"}], 
   "=", "\"\<TVertex `1` must be degree-4; its degree is `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.595005148978063*^9, 3.5950051820813847`*^9}, 
   3.595010922831157*^9, 3.642433020943276*^9, 3.6425353695277576`*^9, 
   3.642542511627205*^9},
 CellLabel->
  "In[2490]:=",ExpressionUUID->"18104081-fed5-495e-87af-ad5c8aaa6ace"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeGeneralTMiuraMarsOri", "::", "badminor"}], 
   "=", "\"\<The first dihedral of TVertex `1` must be minor; its dihedrals \
are `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595005148978063*^9, 3.5950051820813847`*^9}, 
   3.595010922831157*^9, {3.59501674426369*^9, 3.595016783252136*^9}, 
   3.64243302097587*^9, 3.642535370611388*^9, 3.642542511643861*^9},
 CellLabel->
  "In[2491]:=",ExpressionUUID->"8f574c76-e73f-4be8-9dcd-33135647356f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeGeneralTMiuraMarsOri", "::", "notflatf"}], 
   "=", "\"\<TVertex `1` is not flat-foldable.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595005148978063*^9, 3.5950051820813847`*^9}, 
   3.595010922831157*^9, {3.59501674426369*^9, 3.595016783252136*^9}, 
   3.64243302097587*^9, {3.642459940954186*^9, 3.642459959600108*^9}, 
   3.64253537160328*^9, 3.642542511660049*^9},
 CellLabel->
  "In[2492]:=",ExpressionUUID->"f7203272-0125-4519-8a90-8f70732d9078"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeGeneralTMiuraMarsOri", "[", 
   RowBox[{"vtobj_TObj", ",", 
    RowBox[{"{", 
     RowBox[{"dlist1_List", ",", "dlist2_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sa", ",", "da", ",", "dt", ",", "cv", ",", "nh", ",", "nv", ",", "vfn", 
      ",", "gtobj", ",", "types", ",", "foldangles", ",", "ei"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"vtobj", ",", "TVertex", ",", "MakeGeneralTMiuraMarsOri"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sa", ",", "da", ",", "dt", ",", "cv"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"vtobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "SectorAngles", ",", "DihedralAngles", ",", "DihedralTypes", ",", 
          "CreaseVectors"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "da", "]"}], "\[NotEqual]", "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeGeneralTMiuraMarsOri", "::", "badsize"}], ",", "vtobj",
           ",", 
          RowBox[{"Length", "[", "da", "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sign", "[", 
         RowBox[{"da", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "]"}], "\[Equal]", 
        RowBox[{"Sign", "[", 
         RowBox[{"da", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
          "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeGeneralTMiuraMarsOri", "::", "badminor"}], ",", 
          "vtobj", ",", "da"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sa", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
          "+", 
         RowBox[{
         "sa", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], "\[NotEqual]",
         "\[Pi]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeGeneralTMiuraMarsOri", "::", "notflatf"}], ",", 
          "vtobj"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nh", "=", 
      RowBox[{"Length", "[", "dlist1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"Length", "[", "dlist2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"0", ",", "0"}], "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "0"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vfn", "[", 
        RowBox[{"i", ",", "0"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vfn", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", "0"}], "]"}], "+", 
        RowBox[{
         RowBox[{
         "dlist1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "i", "]"}], ",", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{"-", 
            RowBox[{
            "cv", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}]}], 
          "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"0", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vfn", "[", 
        RowBox[{"0", ",", "j"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vfn", "[", 
         RowBox[{"0", ",", 
          RowBox[{"j", "-", "1"}]}], "]"}], "+", 
        RowBox[{
         RowBox[{
         "dlist2", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "j", "]"}], ",", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{"-", 
            RowBox[{
            "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}]}], 
          "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"vfn", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "=", 
       RowBox[{"LineInt2D", "[", 
        RowBox[{
         RowBox[{"vfn", "[", 
          RowBox[{
           RowBox[{"i", "-", "1"}], ",", "j"}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", 
            RowBox[{"i", "+", "j"}], "]"}], ",", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "]"}], ",", 
         RowBox[{"vfn", "[", 
          RowBox[{"i", ",", 
           RowBox[{"j", "-", "1"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OddQ", "[", "j", "]"}], ",", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
          "]"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gtobj", "=", 
      RowBox[{"MakeRectangularQuadMesh", "[", 
       RowBox[{"nh", ",", "nv", ",", "vfn", ",", 
        RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Go", " ", "back", " ", "and", " ", "assign", " ", "edge", " ", "types",
        " ", "and", " ", "fold", " ", "angles"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"gtobj", "[", "EdgeTypes", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"mostly", " ", "U"}], ",", " ", 
       RowBox[{"but", " ", "borders", " ", "are", " ", "B"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "types", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"\"\<horizontal\>\"", " ", "folds"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ei", "=", 
           RowBox[{"i", "+", 
            RowBox[{"j", " ", "nh"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "===", "B"}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", "i", "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"EvenQ", "[", "j", "]"}], ",", "1", ",", 
                    RowBox[{"-", "1"}]}], "]"}], 
                  RowBox[{
                  "da", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}]}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"EvenQ", "[", "j", "]"}], ",", "1", ",", 
                    RowBox[{"-", "1"}]}], "]"}], 
                  RowBox[{
                  "da", "\[LeftDoubleBracket]", "3", 
                   "\[RightDoubleBracket]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}],
          "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nh"}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nv"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"\"\<vertical\>\"", " ", "folds"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ei", "=", 
           RowBox[{
            RowBox[{"nh", 
             RowBox[{"(", 
