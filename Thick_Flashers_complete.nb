Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.592472600475027*^9, 
  3.592472601210442*^9}},ExpressionUUID->"e664c32d-2afc-4dc3-86c6-\
a4a6613f9fcd"],

Cell["\<\
Class TPlaneGraphAssigned is a convenience class useful for adding an \
assignment to a TPlaneGraph when we don\[CloseCurlyQuote]t need an embedding \
of the folded form.\
\>", "Text",
 CellChangeTimes->{{3.595336316741353*^9, 3.595336366281907*^9}, {
  3.6153005802633057`*^9, 
  3.615300623982978*^9}},ExpressionUUID->"efca9ce8-f7e0-4e63-9f4e-\
ba0beeb7b07b"],

Cell["\<\
This class is provided as a convenience since the combination of TPlaneGraph \
and TAssigned happens regularly.\
\>", "Text",
 CellChangeTimes->{{3.592472455167609*^9, 3.592472504601246*^9}, 
   3.592828725063705*^9, 3.592828891993451*^9, {3.5928581694484663`*^9, 
   3.5928581714220324`*^9}},ExpressionUUID->"9083ff58-a31f-41f4-a702-\
420d3163c355"],

Cell["\<\
Note that functions that require both assignment and plane graphs will check \
for the individual classes TPlaneGraph and TGraphAssigned; they\
\[CloseCurlyQuote]ll work if both subclasses are present, even if the passed \
object isn\[CloseCurlyQuote]t specifically an TPlaneGraphAssigned.\
\>", "Text",
 CellChangeTimes->{{3.5924725063459797`*^9, 3.592472589683567*^9}, {
   3.592828725188201*^9, 3.592828725293399*^9}, 3.592828892119114*^9, 
   3.592828955852171*^9, 3.59473451686834*^9, 
   3.594739038899955*^9},ExpressionUUID->"334f49f5-febb-4f60-bd66-\
99586298a7ba"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TObj class: TPlaneGraphAssigned
\tInherits from: TPlaneGraph, TAssigned\
\>", "Subsubsection",
 CellChangeTimes->{{3.592471939233495*^9, 3.592471962078898*^9}, {
   3.592519506847341*^9, 3.59251950933432*^9}, {3.592828725391835*^9, 
   3.59282872549174*^9}, 3.592828864312448*^9, 3.592828955937896*^9, 
   3.59473903896387*^9},ExpressionUUID->"0b438f5c-97f1-42bb-9bb8-\
1f0a627ed48a"],

Cell["\<\
TPlaneGraphAssigned is a TObj class that represents a full plane graph with \
crease assignment on its edges.\
\>", "Text",
 CellChangeTimes->{{3.592471966584065*^9, 3.592471990005175*^9}, 
   3.592828725592718*^9, 3.592828956027431*^9, 
   3.5947390390230637`*^9},ExpressionUUID->"c8dd99d6-d541-4d8f-93c0-\
85f74cb1eb0e"],

