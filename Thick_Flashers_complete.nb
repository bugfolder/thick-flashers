   3.8004679053854313`*^9, 
   3.80047156832125*^9},ExpressionUUID->"a111ec9e-9540-4396-b016-\
5e35735c4ee1"],

Cell[TextData[{
 "ReshapeGeneric3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Kappa]n, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti, ddi",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D oriented developable surface specified by an oriented ruled \
parameterization and returns a different oriented developable surface with \
the specified normal curvature along the directrix."
}], "Text",
 CellChangeTimes->{{3.798572847292226*^9, 3.798572899717365*^9}, {
   3.7985731966001863`*^9, 3.798573197766917*^9}, {3.798574876085689*^9, 
   3.798574885212594*^9}, {3.798624528951817*^9, 3.798624530092536*^9}, {
   3.799324637560071*^9, 3.799324655520765*^9}, {3.799332469887213*^9, 
   3.799332506695383*^9}, {3.799335590716183*^9, 3.799335626092291*^9}, 
   3.799344116522127*^9, 3.800467905409665*^9, 
   3.800471568339971*^9},ExpressionUUID->"bda5667e-9522-4e6f-a5f8-\
2b410f9ae911"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the 3D directrix, as a pure function. It should be \
well-behaved.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] the 3D director, as a pure function. It should be \
well-behaved.\n\t\[Sigma] \[LongDash] the orientation, which should be \
\[PlusMinus]1.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter.\n\t",
 StyleBox["bbi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position of the new directrix.\n\t",
 StyleBox["ddi",
  FontSlant->"Italic"],
 " \[LongDash] the initial director of the new surface.\n\t",
 StyleBox["tti",
  FontSlant->"Italic"],
 " \[LongDash] the initial tangent vector of the new directrix."
}], "Text",
 CellChangeTimes->{{3.798572971597745*^9, 3.798573067343102*^9}, {
  3.799324637570926*^9, 3.799324655529855*^9}, {3.799332511270781*^9, 
  3.799332544247019*^9}, {3.7993355394999647`*^9, 3.7993355691326942`*^9}, {
  3.799398413591544*^9, 
  3.799398414782297*^9}},ExpressionUUID->"fa14f8a4-6479-4c70-9045-\
d5c322f7e8f2"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify.\n\t\
Options[DSolve] are passed through."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
   3.6912356648227*^9}, {3.691241735558269*^9, 3.691241736473103*^9}, {
   3.694215733040501*^9, 3.69421576583174*^9}, {3.694217281461211*^9, 
   3.694217296724212*^9}, {3.6942183546369*^9, 3.694218359821371*^9}, {
   3.694218471807096*^9, 3.6942184743823833`*^9}, {3.797958405540965*^9, 
   3.797958426213867*^9}, 3.79857320891115*^9, {3.798576234758256*^9, 
   3.798576244797916*^9}, 
   3.7986245590458803`*^9},ExpressionUUID->"2200283d-89cf-435f-86b8-\
124c06bace28"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", \[Sigma]} for the new surface."
}], "Text",
 CellChangeTimes->{{3.799324786467416*^9, 3.799324817160604*^9}, {
  3.79933255056643*^9, 
  3.799332563159402*^9}},ExpressionUUID->"77de894a-699f-4346-b8b8-\
5be9935da6f5"],

Cell["\<\
This works for generic developables and cylinders, but not if b is a cone \
point or EOR.\
\>", "Text",
 CellChangeTimes->{{3.799332569079427*^9, 
  3.799332588295621*^9}},ExpressionUUID->"3c7ea33f-e055-4486-b646-\
7fdf97eb8d48"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ReshapeGeneric3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.6720634557909117`*^9, 3.672063470735709*^9}, 
   3.687478751238752*^9, 3.688138426340748*^9, 3.690988494045664*^9, 
   3.691184531857682*^9, 3.691252835831396*^9, {3.691575226485341*^9, 
   3.6915752317232523`*^9}, 3.694218523635254*^9, {3.797960355116918*^9, 
   3.7979603627371616`*^9}, {3.798573222723791*^9, 3.798573226871975*^9}, 
   3.7993325945236893`*^9, 3.800467905421857*^9, 3.8004715683502617`*^9},
 CellLabel->
  "In[3884]:=",ExpressionUUID->"9f97f0ec-14d6-4438-a4e2-3a2f16f4b19c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReshapeGeneric3D", "::", "nosoln"}], 
   "=", "\"\<DSolve couldn't integrate the Darboux frame equations.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.798576024152359*^9, 
   3.7985760302138777`*^9}, 3.799332595748368*^9, 3.800467905425898*^9, 
   3.800471568352975*^9},
 CellLabel->
  "In[3885]:=",ExpressionUUID->"c51ee16b-8a08-4855-89da-8288e5a77687"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "ReshapeGeneric3D", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.7994156045521584`*^9, 3.799415613399033*^9}, 
   3.800467905429975*^9, 3.800471568355492*^9},
 CellLabel->
  "In[3886]:=",ExpressionUUID->"1dae2cbf-492a-4f41-862d-a4be8789e982"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReshapeGeneric3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"b_Function", ",", "d_Function", ",", "\[Sigma]_"}], "}"}], ",", 
    "\[Kappa]n_Function", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bbi_List", ",", "ddi_List", ",", "tti_List"}], 
     "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sim", ",", "as", ",", "sfn", ",", "dsopts", ",", "\[IndentingNewLine]", 
      "s", ",", "ds", ",", "t", ",", "l", ",", "u", ",", 
      "\[IndentingNewLine]", "c\[Rho]L", ",", "s\[Rho]L", ",", "sd\[Kappa]g", 
      ",", "sd\[Kappa]n", ",", "sd\[Tau]g", ",", "sd\[Kappa]n1", ",", 
      "sd\[Tau]g1", ",", "\[IndentingNewLine]", "lli", ",", "uui", ",", 
      "soln", ",", "ttx", ",", "tty", ",", "ttz", ",", "llx", ",", "lly", ",",
       "llz", ",", "uux", ",", "uuy", ",", "uuz", ",", "bbx", ",", "bby", ",",
       "bbz", ",", "\[IndentingNewLine]", "tt", ",", "ll", ",", "uu", ",", 
      "bb", ",", "dd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sim", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ReshapeGeneric3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", 
        RowBox[{
         RowBox[{"Assumptions", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "ReshapeGeneric3D", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sim", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"sim", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"curve", " ", "speed"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"b", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"db", "=", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"b", "[", "s", "]"}], ",", "s"}], "]"}]}], "}"}], ",", 
           
           RowBox[{"NormalizeReal", "[", "db", "]"}]}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"txd", "=", 
             RowBox[{
              RowBox[{"t", "[", "s", "]"}], "\[Cross]", 
              RowBox[{"d", "[", "s", "]"}]}]}], "}"}], ",", 
           RowBox[{"\[Sigma]", " ", 
            RowBox[{"NormalizeReal", "[", "txd", "]"}]}]}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "left", " ", "ruling", " ", "angle", " ", "trig", " ", "functions"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", " ", 
          RowBox[{
           RowBox[{"t", "[", "s", "]"}], ".", 
           RowBox[{"d", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", " ", 
          RowBox[{
           RowBox[{"l", "[", "s", "]"}], ".", 
           RowBox[{"d", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "compute", " ", "curve", " ", "speed", " ", "*", " ", "geodesic", " ", 
        "curvature"}], ",", " ", 
       RowBox[{"normal", " ", "curvature"}], ",", " ", 
       RowBox[{"geodesic", " ", "torsion"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{
           RowBox[{"t", "'"}], "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "s", "]"}], ".", 
          RowBox[{
           RowBox[{"t", "'"}], "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"l", "[", "s", "]"}], ".", 
           RowBox[{
            RowBox[{"u", "'"}], "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "New", " ", "normal", " ", "curvature", " ", "and", " ", "geodesic", " ",
        "torsion", " ", "products"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"ds", "[", "s", "]"}], 
          RowBox[{"\[Kappa]n", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"ds", "[", "s", "]"}]}], " ", 
          RowBox[{"\[Kappa]n", "[", "s", "]"}], 
          FractionBox[
           RowBox[{
            RowBox[{"t", "[", "s", "]"}], ".", 
            RowBox[{"d", "[", "s", "]"}]}], 
           RowBox[{
            RowBox[{"l", "[", "s", "]"}], ".", 
            RowBox[{"d", "[", "s", "]"}]}]]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "remaining", " ", "initial", " ", "conditions", " ", "of", " ", 
       "Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uui", "=", 
      RowBox[{
       RowBox[{"NormalizeReal", "[", 
        RowBox[{"\[Sigma]", " ", 
         RowBox[{"tti", "\[Cross]", "ddi"}]}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lli", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"RotationMatrix3Du", "[", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "uui"}], "]"}], ".", "tti"}], "//",
        "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "the", " ", "new", " ", "Darboux", " ", "frame"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "tt", ",", "ll", ",", "uu"}], "}"}], "=", 
      RowBox[{"RecoverDarboux3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ds", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n1", ",", "sd\[Tau]g1"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "tti", ",", "lli", ",", "uui"}], 
         "}"}], ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rotate", " ", "to", " ", "get", " ", "the", " ", "new", " ", 
       "director"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], 
             RowBox[{"tt", "[", "s", "]"}]}], "+", 
            RowBox[{
             RowBox[{"s\[Rho]L", " ", "[", "s", "]"}], 
             RowBox[{"ll", "[", "s", "]"}]}]}], ")"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.798572927592586*^9, 3.798572964094378*^9}, {
   3.7985731122007017`*^9, 3.798573136774859*^9}, {3.798573175864064*^9, 
