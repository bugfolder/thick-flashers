Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "\[Phi]", ",", "dx", ",", "dy", ",", "dz", ",", "botpts2d", ",",
       "toppts2d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "12"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"rotational", " ", "order"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"135.", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "amount", " ", "of", " ", "twist", " ", "from", " ", "bottom", " ", 
       "to", " ", "top"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dx", ",", "dy"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", "0.4"}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "lateral", " ", "offset", " ", "from", " ", "bottom", " ", "to", " ", 
       "top"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dz", "=", "0.32"}], ";", "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{
       RowBox[{"DiscreteCircle", "[", 
        RowBox[{"m", ",", "1"}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"toppts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dx", ",", "dy"}], "}"}], "+", "#"}], "&"}], "/@", 
        RowBox[{"DiscreteCircle", "[", 
         RowBox[{"m", ",", "1", ",", "\[Phi]"}], "]"}]}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TwistJoinedTubeGraphics", "[", 
      RowBox[{"botpts2d", ",", "toppts2d"}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
