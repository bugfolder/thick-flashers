9a1827e12513"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "g", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"g", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", ".7"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0", ",", 
               RowBox[{"-", ".1"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", ".7"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".1", ",", ".1", ",", "1"}], "}"}]}], "}"}], "]"}], ",",
           "ValleyLine"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Arrow", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
          RowBox[{"Thickness", "[", ".02", "]"}], ",", "Black"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Polygon", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{".25", ",", ".25", ",", ".3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".75", ",", ".25", ",", ".3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".75", ",", ".75", ",", ".3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".25", ",", ".75", ",", ".3"}], "}"}]}], "}"}], "]"}], ",",
           "PaperWhiteSideFill"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Polygon", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{".2", ",", ".2", ",", ".5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".5", ",", ".2", ",", ".5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".5", ",", ".5", ",", ".5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".2", ",", ".5", ",", ".5"}], "}"}]}], "}"}], "]"}], ",",
           "PaperColoredSideFill"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"AddShadow", "[", 
         RowBox[{"g", ",", 
          RowBox[{"ShadowHeight", "\[Rule]", 
           RowBox[{"-", ".5"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".5", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ViewPoint", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"10", ",", 
           RowBox[{"-", "8"}], ",", "5"}], "}"}]}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.68926697935979*^9, 3.689267006540203*^9}, {
   3.6892670730791388`*^9, 3.6892672196942577`*^9}, {3.68926730320019*^9, 
   3.689267303478112*^9}, {3.689267620153936*^9, 3.6892676203157988`*^9}, {
   3.689267865111297*^9, 3.689267976571247*^9}, {3.68926813087117*^9, 
   3.689268184036405*^9}, {3.6892706236942983`*^9, 3.689270625573899*^9}, {
   3.689270681010593*^9, 3.689270695217715*^9}, 3.689555710388319*^9, {
   3.691521306714629*^9, 3.691521341054334*^9}, {3.691522284024617*^9, 
   3.691522284399724*^9}, {3.8017438563466*^9, 3.801743887075363*^9}, {
   3.803405366836112*^9, 3.803405367323414*^9}, 3.803860465638796*^9, 
   3.80389510959984*^9, {3.803895343851358*^9, 3.8038953521281433`*^9}, {
   3.803897256077648*^9, 3.803897299683629*^9}},
 CellLabel->
