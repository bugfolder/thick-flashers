Cell[BoxData[
 RowBox[{
  RowBox[{"GaussMapGraphics3D", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sgs", ",", "gsr", ",", "angles", ",", "verts3d", ",", "dverts3d", ",", 
      "iedges", ",", "dedges", ",", "p1s", ",", "p2s", ",", "ras", ",", 
      "dirs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TPrimalDualGraph", ",", "TGraph3D"}], "}"}], ",", 
       "GaussMapGraphics3D"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sgs", "=", 
      RowBox[{
       RowBox[{"ShowGaussianSphere", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GaussMapGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gsr", "=", 
      RowBox[{
       RowBox[{"GaussianSphereRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GaussMapGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"angles", ",", "verts3d", ",", "iedges", ",", "dedges"}], 
       "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "FoldAngles", ",", "Vertices3D", ",", "InteriorEdges", ",", 
          "DualEdges"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"face", " ", "normals"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dverts3d", "=", 
      RowBox[{"FaceNormals3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"face", " ", "normal", " ", "pairs"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1s", ",", "p2s"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "dverts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
         "&"}], "/@", "dedges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"rotation", " ", "axes"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ras", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{"-", 
          RowBox[{"Subtract", "@@", 
           RowBox[{
           "verts3d", "\[LeftDoubleBracket]", "#", 
            "\[RightDoubleBracket]"}]}]}], "]"}], "&"}], "/@", "iedges"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"rotation", " ", "directions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#", "\[GreaterEqual]", "0"}], ",", "CCW", ",", "CW"}], 
         "]"}], "&"}], "/@", 
       RowBox[{"angles", "\[LeftDoubleBracket]", 
        RowBox[{"InteriorEdgeMap", "[", "tobj", "]"}], 
        "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"sgs", ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Sphere", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "gsr"}], "]"}],
              ",", 
             RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Styled3DArc", "[", 
             RowBox[{"#1", ",", "#2", ",", 
              RowBox[{"RotationAxis", "\[Rule]", "#3"}], ",", 
              RowBox[{"ArcDirection", "\[Rule]", "#4"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", "TraceLine"}], ",", 
              RowBox[{"FillStyle", "\[Rule]", "None"}], ",", "opts"}], "]"}], 
            "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"p1s", ",", "p2s", ",", "ras", ",", "dirs"}], "}"}]}], 
          "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.70396718701544*^9, 3.703967222170767*^9}, {
   3.703967431013796*^9, 3.7039675155732603`*^9}, {3.703967561710331*^9, 
   3.703967595526414*^9}, {3.703968618619586*^9, 3.703968623015046*^9}, {
   3.703968657472236*^9, 3.70396873132052*^9}, {3.703972549108446*^9, 
   3.703972584244819*^9}, {3.703972634940325*^9, 3.703972652446446*^9}, {
   3.703972700468096*^9, 3.703972780973443*^9}, {3.703972813046823*^9, 
   3.703972832260843*^9}, {3.703972871678939*^9, 3.703972970495573*^9}, 
   3.703973064057534*^9, {3.703973108592617*^9, 3.703973199051249*^9}, {
   3.70397324435521*^9, 3.703973346355253*^9}, {3.7039736331275*^9, 
   3.703973644558091*^9}, {3.703975290093418*^9, 3.703975509664444*^9}, {
   3.703975565127997*^9, 3.703975604358925*^9}, {3.703976075605966*^9, 
   3.7039761210367603`*^9}, {3.703976530529454*^9, 3.703976531677614*^9}, 
   3.703977965832001*^9, 3.707919793331147*^9},
 CellLabel->
  "In[2609]:=",ExpressionUUID->"718e9b94-cb6a-4658-9eae-b7c934497ea6"],

Cell["Example. A single folded vertex. ", "Text",
 CellChangeTimes->{
  3.703967087826095*^9, {3.703968154188598*^9, 
   3.703968154986407*^9}},ExpressionUUID->"a9e3b8e4-d8f8-4957-aa12-\
79b98b11c258"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"verts", ",", "edges", ",", "foldangles", ",", "tobj"}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"verts", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"Tan", "[", 
          RowBox[{"30", "\[Degree]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Tan", "[", 
           RowBox[{"30", "\[Degree]"}], "]"}]}], ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"edges", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "7"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"7", ",", "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"8", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"9", ",", "2"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"foldangles", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"ArcTan", "[", 
          RowBox[{"1", "+", 
           FractionBox["2", 
            SqrtBox["3"]]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"-", "60"}], " ", "\[Degree]"}], ",", 
        RowBox[{"2", " ", 
         RowBox[{"ArcTan", "[", 
          RowBox[{"1", "+", 
           FractionBox["2", 
            SqrtBox["3"]]}], "]"}]}], ",", 
        RowBox[{"60", " ", "\[Degree]"}], ",", "0", ",", "0", ",", "0", ",", 
        "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], "//", "N"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"foldangles", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"ArcTan", "[", 
         RowBox[{"0.3", 
          RowBox[{"Tan", "[", 
           RowBox[{"#", "/", "2"}], "]"}]}], "]"}]}], "&"}], "/@", 
      "foldangles"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobj", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"MakeTGraph", "[", 
          RowBox[{"verts", ",", "edges"}], "]"}], "//", 
         RowBox[{"AddTAssigned", "[", 
          RowBox[{"FoldAngleToType", "[", "foldangles", "]"}], "]"}]}], "//", 
        "AddTPlaneGraph"}], "//", 
       RowBox[{"AddTGraph3D", "[", "]"}]}], "//", "AddTPrimalDualGraph"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"tobj", "=", 
     RowBox[{"FoldGraph3D", "[", 
      RowBox[{"tobj", ",", "foldangles"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tobj", "=", 
     RowBox[{"RotateGraph3D", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"70", "\[Degree]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GaussMapGraphics3D", "[", "tobj", "]"}]}], "}"}]}], "}"}], 
      "]"}], "/.", 
     RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.703967156876196*^9, 3.703967157930367*^9}, {
   3.703967292278316*^9, 3.703967387429102*^9}, {3.703968171332645*^9, 
   3.703968199885578*^9}, {3.703968232542375*^9, 3.703968281837466*^9}, {
   3.703972600741426*^9, 3.703972612285682*^9}, {3.703972838751326*^9, 
