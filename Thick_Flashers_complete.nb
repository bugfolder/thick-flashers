       RowBox[{"3", " ", 
        RowBox[{"otherwise", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"kn1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", 
