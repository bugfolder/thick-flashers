Cell[BoxData[
 RowBox[{
  RowBox[{"HingePlateGC", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ht", ",", "hc", ",", "hth", ",", "v1", ",", "v2", ",", "v3", ",", "v4", 
      ",", "u1", ",", "u2", ",", "u3", ",", "u4", ",", "e1", ",", "e2", ",", 
      "e3", ",", "e4", ",", "s1", ",", "s2", ",", "s3", ",", "s4", ",", "s5", 
      ",", "s6", ",", "s7", ",", "s8"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ht", ",", "hc"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"HingeThickness", ",", "HingeEndsClipped"}], "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HingePlateGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hth", "=", 
      RowBox[{"ht", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Get", " ", "the", " ", "points"}], ",", " ", 
       RowBox[{"possibly", " ", "clipped"}], ",", " ", 
       RowBox[{"and", " ", "in", " ", "a", " ", "different", " ", "order"}]}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"hc", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"v1", ",", "v4", ",", "v2", ",", "v3"}], "}"}], "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"HingeEndsClip", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"v1", ",", "v2", ",", "v3", ",", "v4"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "q1", ",", "q2", ",", "p2"}], "}"}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "normal", " ", "vectors", " ", "at", " ", "all", " ", "four", " ", 
       "corners"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u1", ",", "u2", ",", "u3", ",", "u4"}], "}"}], "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v2", "-", "v1"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{"v1", "-", "v4"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v3", "-", "v2"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{"v2", "-", "v1"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v4", "-", "v3"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{"v3", "-", "v2"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v1", "-", "v4"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{"v4", "-", "v3"}], ")"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListEmptyQ", "[", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "s1", ",", "s2", ",", "s3", ",", "s4", ",", "s5", ",", "s6", ",", 
             "s7", ",", "s8"}], "}"}], ",", "ComplexInfinity"}], "]"}], 
         "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"HingePlateGC", "::", "badpts"}], ",", 
          RowBox[{"{", 
           RowBox[{"p1", ",", "p2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"extension", " ", "vectors"}], ",", " ", 
       RowBox[{
