         RowBox[{"0", ",", "0.9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0.9"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1.5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sgedges", "=", 
