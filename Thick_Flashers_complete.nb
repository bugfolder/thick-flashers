   3.689075047381904*^9, 3.6890750801435337`*^9}, {3.689075614566798*^9, 
   3.689075642996764*^9}, {3.689075684815227*^9, 3.689075686191689*^9}, {
   3.689075716984846*^9, 3.689075721213077*^9}, {3.689077380797475*^9, 
