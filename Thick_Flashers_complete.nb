   3.691494892235054*^9, 3.6915054716690197`*^9, 3.799400666129835*^9, {
   3.7994046516957283`*^9, 3.799404655139966*^9}, 
   3.800461065240706*^9},ExpressionUUID->"91d98ef9-c169-47b2-99f5-\
8811f99aef16"],

Cell[TextData[{
 "Darboux3DSystemOld[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a parametric curve embedded in a surface and augments the \
ParametricCurveSystems3D with additional vector fields that define the \
Darboux frame of the curve. "
}], "Text",
 CellChangeTimes->{{3.67206297700732*^9, 3.6720629884601293`*^9}, {
   3.672063048247298*^9, 3.672063153265608*^9}, {3.672063184564661*^9, 
   3.672063214741748*^9}, {3.672063381214768*^9, 3.672063385819169*^9}, {
   3.67206352324258*^9, 3.672063577783233*^9}, 3.6909894049352713`*^9, 
   3.690990056809654*^9, 3.6909905069141707`*^9, {3.691245581904008*^9, 
   3.691245624297329*^9}, {3.691245727443105*^9, 3.691245727595532*^9}, 
   3.691252771804954*^9, {3.691260522722745*^9, 3.691260523754431*^9}, 
   3.691505471706353*^9, 3.691505683593731*^9, 3.799400666152013*^9, 
   3.800461065258978*^9},ExpressionUUID->"033346ad-b704-40bc-b61c-\
f5a761000d26"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives the arbitrary-speed 3D space curve.\
\n\t",
 StyleBox["u",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives the 3D surface normal vector along \
the curve."
}], "Text",
 CellChangeTimes->{{3.691245584336808*^9, 3.691245586673559*^9}, {
  3.691245728829136*^9, 3.691245739554501*^9}, {3.691260518554152*^9, 
  3.691260519845446*^9}},ExpressionUUID->"8bdbc1d1-fbd4-4057-89a4-\
1ecc319aa9db"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
  3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
  3.6912356648227*^9}, {3.691241735558269*^9, 
  3.691241736473103*^9}},ExpressionUUID->"0401dc43-6250-4cc0-9d4a-\
6b1b7ca6fdd4"],

Cell["\<\
Returns: the list of rules from Curve3DSystem, augmented with the Darboux \
frame vectors SurfaceNormalVector3D (which you provided as input) and \
TangentNormalVector3D.  \
\>", "Text",
 CellChangeTimes->{{3.691245600068708*^9, 3.691245605520103*^9}, 
   3.691252690914592*^9, 3.691505296962094*^9, 
   3.691505686039682*^9},ExpressionUUID->"e3b26ae0-7a1d-437a-86a9-\
e93106c6771a"],

Cell[TextData[{
 "So, why require the parameterized surface normal vector ",
 StyleBox["u",
  FontSlant->"Italic"],
 "[",
 StyleBox["t",
  FontSlant->"Italic"],
 "], rather than providing the surface function ",
 StyleBox["ss",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 ",",
 StyleBox["v",
  FontSlant->"Italic"],
 "] and computing it directly? It\[CloseCurlyQuote]s because the input \
functions are parameterized on one variable, ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", while a surface is generally parameterized on two variables, ",
 StyleBox["u",
  FontSlant->"Italic"],
 " and ",
 StyleBox["v",
  FontSlant->"Italic"],
 ". Even though the curve is embedded in the surface, finding the {",
 StyleBox["u",
  FontSlant->"Italic"],
 ",",
 StyleBox["v",
  FontSlant->"Italic"],
 "} that corresponds to a given ",
 StyleBox["t",
  FontSlant->"Italic"],
 " involves solving an equation ",
 StyleBox["ff",
  FontSlant->"Italic"],
 "[",
 StyleBox["t",
  FontSlant->"Italic"],
 "]\[Equal]",
 StyleBox["ss",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 ",",
 StyleBox["v",
  FontSlant->"Italic"],
 "], which is not guaranteed to be readily solvable (especially with numeric \
functions)."
}], "Text",
 CellChangeTimes->{{3.6720636083247967`*^9, 3.672063812221664*^9}, {
   3.687477865373732*^9, 3.687477876429194*^9}, {3.6912456728352423`*^9, 
   3.6912456974452*^9}, 
   3.797259176711663*^9},ExpressionUUID->"44b9c372-f0b7-47c6-b54f-\
fa47a755630e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Darboux3DSystemOld", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.6720634557909117`*^9, 3.672063470735709*^9}, 
   3.690988493914489*^9, 3.691245750278811*^9, 3.691252771820338*^9, 
   3.691505471719763*^9, 3.799400666163618*^9, 3.800461065271575*^9},
 CellLabel->
  "In[3798]:=",ExpressionUUID->"f4932752-c5f3-48de-a464-148d9ad4ca80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Darboux3DSystemOld", "[", 
   RowBox[{"ccf_Function", ",", "uuf_Function", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "t", ",", "sfn", ",", "cc", ",", "uu", ",", "c3s", 
      ",", "tt", ",", "ds", ",", "kp", ",", "ta", ",", "dcc", ",", "ddcc", ",",
       "ll", ",", "sd2", ",", "kn", ",", "ndf3", ",", "uuxdcc", ",", "kg", ",",
       "fda", ",", "dfda", ",", "tg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Darboux3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Darboux3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"ccf", "[", "t", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "curve", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"uuf", "[", "t", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"surface", " ", "normal"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"c3s", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"ccf", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "ds", ",", "kp", ",", "ta"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "t", "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{
         "TangentVector3D", ",", "Speed3D", ",", "Curvature3D", ",", 
          "Torsion3D"}], "}"}]}], "/.", "c3s"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dcc", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"cc", ",", "t"}], "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "velocity", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ddcc", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"dcc", ",", "t"}], "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "acceleration", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ll", "=", 
      RowBox[{
       RowBox[{"uu", "\[Cross]", "tt"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"tangent", " ", "normal"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"sd2", "=", 
      RowBox[{
       SuperscriptBox["ds", "2"], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"kn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ddcc", ".", "uu"}], "/", "sd2"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"normal", " ", "curvature"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ndf3", "=", 
      RowBox[{
       SuperscriptBox["ds", "3"], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"uuxdcc", "=", 
      RowBox[{
       RowBox[{"uu", "\[Cross]", "dcc"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kg", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ddcc", ".", "uuxdcc"}], "/", "ndf3"}], "//", "sfn"}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{"geodesic", " ", "curvature"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fda", "=", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        RowBox[{"kg", ",", "kn"}], "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"Frenet", "-", 
       RowBox[{"Darboux", " ", "angle"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dfda", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kg", " ", 
           RowBox[{"D", "[", 
            RowBox[{"kn", ",", "t"}], "]"}]}], "-", 
          RowBox[{"kn", " ", 
           RowBox[{"D", "[", 
            RowBox[{"kg", ",", "t"}], "]"}]}]}], ")"}], "/", 
        SuperscriptBox["kp", "2"]}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tg", "=", 
      RowBox[{
       RowBox[{"ta", "-", 
        RowBox[{"dfda", "/", "ds"}]}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"geodesic", " ", "torsion"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"(*", " ", 
       RowBox[{"3", "D", " ", "scalars"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Speed3D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"Speed3D", "/.", "c3s"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Curvature3D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"Curvature3D", "/.", "c3s"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Torsion3D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"Torsion3D", "/.", "c3s"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalCurvature3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"kn", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"GeodesicCurvature3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"kg", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"FrenetDarbouxAngle", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"fda", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"GeodesicTorsion3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"tg", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"3", "D", " ", "vectors"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Curve3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"cc", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"TangentVector3D", "/.", "c3s"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalVector3D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"NormalVector3D", "/.", "c3s"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BinormalVector3D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"BinormalVector3D", "/.", "c3s"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"SurfaceNormalVector3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"uu", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentNormalVector3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"ll", ",", "t"}], "]"}]}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.67206383722228*^9, 3.672063873339328*^9}, {
   3.672063907587716*^9, 3.672064091000374*^9}, {3.672064933155322*^9, 
