   RowBox[{"TileEdgeArrowDirs", "::", "usage"}], 
   "=", "\"\<TileEdgeArrowDirs is an option to RenderTile[{PolygonTile, \
verts}, Tiling, opts] that specifies a list of directions (\[PlusMinus]1) for \
each edge of the tile.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627584145475473*^9, 3.627584238473308*^9}, 
   3.629823110176096*^9, {3.629839073966508*^9, 3.629839092347411*^9}, {
