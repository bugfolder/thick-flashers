Cell[CellGroupData[{

Cell["Flopping, rotation", "Subsection",
 CellChangeTimes->{{3.706877528915208*^9, 
  3.7068775326808662`*^9}},ExpressionUUID->"8c5197aa-ebaf-4db2-bbc3-\
0953886284ab"],

Cell[CellGroupData[{

Cell[TextData[{
 "FlopGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph2D\n\t(options) FlopDirection"
}], "Subsubsection",
 CellChangeTimes->{{3.6277676529263363`*^9, 
  3.627767695299454*^9}},ExpressionUUID->"2718b317-f690-43a2-9476-\
c38e4d8c50ce"],

Cell[TextData[{
 "FlopGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] flops the Vertices2D of the given TGraph2D, as if you had turned over the \
folded form."
}], "Text",
 CellChangeTimes->{{3.627767712997183*^9, 3.627767736098975*^9}, {
  3.627767770510756*^9, 3.627767778757546*^9}, {3.627767831181095*^9, 
  3.6277678561047783`*^9}, {3.722101997082707*^9, 
  3.7221019979041862`*^9}},ExpressionUUID->"24a2d3a4-a4bd-4ed7-9a33-\
e6ef83565271"],

Cell["\<\
Options:
\tFlopDirection \[Rule] Horizontal | Vertical, specifies the direction (not \
axis) of flopping.\
\>", "Text",
 CellChangeTimes->{{3.7221020007684197`*^9, 
  3.722102002615162*^9}},ExpressionUUID->"e2a4a937-5285-4b47-ae16-\
7c6bd3ae282c"],

Cell["\<\
Note that this ONLY applies to the folded form; if you want to turn over the \
CP, use FlopGraph.\
\>", "Text",
 CellChangeTimes->{{3.722102010390823*^9, 
  3.722102053015326*^9}},ExpressionUUID->"d215ea74-08c6-4c74-be94-\
b0127498d4d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FlopGraph2D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"FlopDirection", "\[Rule]", "Horizontal"}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.627767875691601*^9, 3.627767894200099*^9}},
 CellLabel->
  "In[1351]:=",ExpressionUUID->"8d72f43f-8a51-40e3-87b9-a68f940ac2a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlopGraph2D", "[", 
   RowBox[{
    StyleBox["tobj_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fd", ",", "verts2d", ",", "ctr"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph2D", ",", "FlopGraph2D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fd", "=", 
      RowBox[{
       RowBox[{"FlopDirection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FlopGraph2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hori", "=", 
      RowBox[{"(", 
       RowBox[{"fd", "===", "Horizontal"}], ")"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices2D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#1", "]"}], "+", 
             RowBox[{"Min", "[", "#1", "]"}]}], ")"}], "/", "2"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#2", "]"}], "+", 
             RowBox[{"Min", "[", "#2", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "&"}], "@@", 
       RowBox[{"Transpose", "[", "verts2d", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"fd", "===", "Horizontal"}], ",", "\[IndentingNewLine]", 
       RowBox[{"verts2d", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ctr", "+", 
           RowBox[{"ReflectionYMatrix2D", ".", 
            RowBox[{"(", 
             RowBox[{"#", "-", "ctr"}], ")"}]}]}], "&"}], "/@", "verts2d"}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"verts2d", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ctr", "+", 
           RowBox[{"ReflectionXMatrix2D", ".", 
            RowBox[{"(", 
             RowBox[{"#", "-", "ctr"}], ")"}]}]}], "&"}], "/@", 
         "verts2d"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices2D", "\[Rule]", "verts2d"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627767928398541*^9, 3.627768044131306*^9}, {
  3.627768136345787*^9, 3.627768244068619*^9}, {3.627768277187147*^9, 
  3.627768413555297*^9}, {3.627768581504996*^9, 3.627768585344734*^9}},
 CellLabel->
  "In[1352]:=",ExpressionUUID->"e7caa04f-1aea-42c7-b962-ee8b49ef5ddf"],

Cell["\<\
Example. A folded vertex. Fold it up, then flop vertically and horizontally \
and show all results.\
\>", "Text",
 CellChangeTimes->{{3.595271012675541*^9, 3.595271016273655*^9}, {
  3.595355816628304*^9, 3.595355821104931*^9}, {3.595357804801234*^9, 
