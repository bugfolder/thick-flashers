        RowBox[{"Boxed", "\[Rule]", "True"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "1"}], "}"}], ",", "0", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"y", ",", "1"}], "}"}], ",", "0", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"z", ",", "1"}], "}"}], ",", "0", ",", "2"}], "}"}]}], 
     "]"}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
