b66c59689588"],

Cell[TextData[{
 "Arguments:\n\tc \[LongDash] the curve as a vector-valued pure function, \
could be 2D or 3D.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain over which to compute the speed."
}], "Text",
 CellChangeTimes->{{3.691580289272049*^9, 3.69158032759784*^9}, {
  3.6915813570112767`*^9, 3.691581366544193*^9}, {3.691581441891892*^9, 
