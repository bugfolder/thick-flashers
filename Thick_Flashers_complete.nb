   3.802096834961625*^9}, {3.8020968891722913`*^9, 3.802096893258452*^9}, {
   3.802097095900874*^9, 3.8020971064945707`*^9}, {3.803404531983986*^9, 
   3.803404567453846*^9}, {3.803405701725856*^9, 3.803405747628787*^9}, {
   3.803405782558136*^9, 3.803405847456951*^9}, {3.803405903190281*^9, 
   3.803405920534857*^9}, {3.803458830487481*^9, 3.803458902924029*^9}, {
   3.803459025542877*^9, 3.803459037048957*^9}, {3.803459113001259*^9, 
   3.803459133231074*^9}, 3.803459166914669*^9, {3.803461508572062*^9, 
   3.803461541017757*^9}, {3.803461689594326*^9, 3.803461689906336*^9}, {
   3.803461730754464*^9, 3.803461745929942*^9}, 3.803860465829819*^9, 
