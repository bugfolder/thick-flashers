Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "patch", ",", "lattice", ",", "tiling"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "12"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<tiling = \>\"", ",", 
       RowBox[{"TwoUniformName", "[", "n", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"patch", "=", 
      RowBox[{"TwoUniformPatch", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"EmbedTiling", "[", 
          RowBox[{"patch", ",", "Tiling", ",", 
           RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
           RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "\"\<patch\>\""}]}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lattice", "=", 
      RowBox[{"TwoUniformPatchLatticeVectors", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"MakeLatticeTiling", "[", 
       RowBox[{"patch", ",", "lattice", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
