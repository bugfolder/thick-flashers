       "each", " ", 
       RowBox[{"panel", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ho1", "=", 
      RowBox[{"{", 
       RowBox[{"cyl", "[", 
        RowBox[{
         RowBox[{"lb", "+", "le"}], ",", 
         RowBox[{"lpq", "-", "lb", "-", "le"}], ",", "dh"}], "]"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ho2", "=", 
