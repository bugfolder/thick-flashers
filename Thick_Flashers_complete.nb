Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts1", ",", "edges1", ",", "types1", ",", "verts3d1", ",", "angles1", 
      ",", "tobj1", ",", "verts2", ",", "edges2", ",", "types2", ",", 
      "verts3d2", ",", "angles2", ",", "tobj2", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts1", "=", 
      RowBox[{"verts2", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges1", "=", 
      RowBox[{"edges2", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "6"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "6"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types1", "=", 
      RowBox[{"types2", "=", 
       RowBox[{"{", 
        RowBox[{
        "B", ",", "B", ",", "B", ",", "V", ",", "B", ",", "B", ",", "B"}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d1", "=", 
      RowBox[{"verts3d2", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"RotationYMatrix3D", "[", 
           RowBox[{"45", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angles1", "=", 
      RowBox[{"angles2", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", 
         RowBox[{"90", "\[Degree]"}], ",", "0", ",", "0", ",", "0"}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"To", " ", "make", " ", "life", " ", "interesting"}], ",", " ", 
       RowBox[{
        RowBox[{"we", "'"}], "ll", " ", "offset", " ", "and", " ", "rotate", " ",
         "Graph", " ", "2."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"verts3d2", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{".1", ",", ".2", ",", ".3"}], "}"}], "+", 
         RowBox[{
          RowBox[{"RotationZMatrix3D", "[", 
           RowBox[{"30.", "\[Degree]"}], "]"}], ".", "#"}]}], "&"}], "/@", 
       "verts3d2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"MakeTGraph3DAssigned", "[", 
        RowBox[{"verts1", ",", "edges1", ",", 
         RowBox[{"{", "}"}], ",", "verts3d1", ",", "angles1", ",", "types1"}],
         "]"}], "//", "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{
       RowBox[{"MakeTGraph3DAssigned", "[", 
        RowBox[{"verts2", ",", "edges2", ",", 
         RowBox[{"{", "}"}], ",", "verts3d2", ",", "angles2", ",", "types2"}],
         "]"}], "//", "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Join", " ", "graph", " ", "2", " ", "to", " ", "graph", " ", "1", " ", 
       "by", " ", "aligning", " ", "three", " ", "pairs", " ", "of", " ", 
       "points"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"JoinGraph3DAssigneds", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tobj1", ",", 
            RowBox[{"{", "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"tobj2", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]}], "}"}]}], 
         "}"}], "]"}], "//", "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Joined\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"FoldAngleCreasePatternGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1 CP\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"FoldAngleCreasePatternGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2 CP\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"FoldAngleCreasePatternGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Joined CP\>\""}]}], "]"}]}],
           "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1 FF\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"FoldedFormGraphics3D", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2 FF\>\""}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"FoldedFormGraphics3D", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Joined FF\>\""}]}], "]"}]}],
           "\[IndentingNewLine]", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
