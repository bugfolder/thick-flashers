Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"UnitCyclicBrocardPolygonOffsetTwistTile", ",", 
      RowBox[{"{", 
       RowBox[{"n_", ",", "angle1_", ",", "angle2_", ",", "i1_", ",", "i2_"}],
        "}"}], ",", "w_", ",", "d_", ",", "types_List"}], "}"}], ",", 
    "decoration_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "cctr", ",", "cr", ",", "\[Theta]", ",", "bctr", ",", 
      "\[Alpha]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "cctr", ",", "cr", ",", "\[Theta]", ",", "bctr", ",", 
        "\[Alpha]"}], "}"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sign", "[", "w", "]"}], "\[Equal]", 
         RowBox[{"Sign", "[", "d", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"UnitCyclicBrocardPolygonInfoCCW", "[", 
         StyleBox[
          RowBox[{
          "n", ",", " ", "angle1", ",", " ", "angle2", ",", " ", "i1", ",", 
           " ", "i2"}],
          FontSlant->"Italic"], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"UnitCyclicBrocardPolygonInfoCW", "[", 
         StyleBox[
          RowBox[{
          "n", ",", " ", "angle1", ",", " ", "angle2", ",", " ", "i1", ",", 
           " ", "i2"}],
          FontSlant->"Italic"], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"RenderTile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "PolygonOffsetTwistTile", ",", "verts", ",", "w", ",", "d", ",", 
         "types"}], "}"}], ",", "decoration", ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.629848399972303*^9, 3.629848426890907*^9}, {
   3.629848667124596*^9, 3.629848744918406*^9}, {3.62984930933378*^9, 
