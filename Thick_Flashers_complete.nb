Cell[TextData[{
 "MakeOffsetGoldbergTilingPrimalDualGraph",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n, o",
  FontSlant->"Italic"],
 "] returns a TPrimalDualGraph representing a primal-dual graph pair for an \
offset Goldberg tiling. As above, the DualVertices are chosen to make the \
dual graph a reciprocal diagram, and thus the shrink-rotate algorithm will \
produce a valid tessellation."
}], "Text",
 CellChangeTimes->{{3.485221137879643*^9, 3.4852211801595993`*^9}, {
   3.48522134872078*^9, 3.4852213540733213`*^9}, 3.592298010222992*^9, {
