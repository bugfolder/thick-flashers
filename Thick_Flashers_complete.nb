            RowBox[{"{", 
             RowBox[{"d2", ",", "d4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Ceiling", "[", 
              RowBox[{"nv", "/", "2"}], "]"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}], ",", "nv"}], "]"}]}], "}"}]}], "]"}]}]], "Input",
