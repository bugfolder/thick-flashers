                RowBox[{"tg", "[", "t0", "]"}], 
                RowBox[{"ll", "[", "t0", "]"}]}], "+", 
               RowBox[{"0", 
                RowBox[{"uu", "[", "t0", "]"}]}]}], ")"}]}]}], "//", 
           "Chop"}]}], "]"}], ";", "\[IndentingNewLine]", 
