Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.485198306370379*^9, 
  3.485198306865889*^9}},ExpressionUUID->"2cdaee18-2c58-45d6-a220-\
1afd7aecb575"],

Cell["\<\
This section addresses simple flat twists. In addition to providing functions \
for visualizing single twists directly, it also includes utility functions \
that are used in higher-level assemblies of twists.\
\>", "Text",
 CellChangeTimes->{{3.485198308569951*^9, 
  3.485198343666133*^9}},ExpressionUUID->"96caf903-85dc-4571-b7cd-\
4ad205e63d67"]
}, Closed]],

Cell[CellGroupData[{

Cell["Twist properties", "Subsection",
 CellChangeTimes->{{3.457734042412027*^9, 3.457734044403528*^9}, {
   3.457738697202518*^9, 3.457738712896046*^9}, 3.457918626538047*^9, {
   3.485197699501267*^9, 3.48519771077285*^9}, {3.485198002595774*^9, 
   3.48519800397186*^9}, 
   3.485198295466259*^9},ExpressionUUID->"4f120c15-4792-4521-9195-\
5ccc693ce53f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457733535709699*^9, 
  3.457733536141463*^9}},ExpressionUUID->"a1baa35b-6c37-4af8-b54b-\
00eaf8401948"],

Cell["\<\
These functions create and analyze networks for simple flat polygonal twists \
for general polygons. In rendering, the polygon are clipped to a bounding \
circle of specified radius.\
\>", "Text",
 CellChangeTimes->{{3.457733539879495*^9, 3.457733544205559*^9}, {
  3.457897612333787*^9, 3.457897637801186*^9}, {3.457897735071471*^9, 
  3.457897738263319*^9}, {3.6275012182771*^9, 
  3.6275012202581267`*^9}},ExpressionUUID->"31892a70-d47e-4646-8507-\
48c5004a4a2b"],

Cell["\<\
This first group of functions solves for the point at which a cyclic crease \
assignment around the center polygon (with anto pleats) results in a \
transivity impossibility.\
\>", "Text",
 CellChangeTimes->{{3.627501223457649*^9, 
  3.627501263351649*^9}},ExpressionUUID->"6e9c4523-306a-47a3-9031-\
150883908d6b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TestPleat[{",
 StyleBox["qa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qb",
  FontSlant->"Italic"],
 "}, \[Alpha]]"
}], "Subsubsection",
 CellChangeTimes->{{3.627502443332759*^9, 3.6275025246318417`*^9}, {
  3.6314862686409698`*^9, 
  3.631486270038406*^9}},ExpressionUUID->"fb157edc-7c08-4947-8c9c-\
32e4cfc20257"],

Cell[TextData[{
 "TestPleat[{",
 StyleBox["qa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qb",
  FontSlant->"Italic"],
 "}] returns graphical elements showing a folded form pleat running from ",
 StyleBox["qa",
  FontSlant->"Italic"],
 " to ",
 StyleBox["qb",
  FontSlant->"Italic"],
 " with a pleat angle of \[Alpha]. It is used only in the examples in this \
section."
}], "Text",
 CellChangeTimes->{{3.6275024760034328`*^9, 3.627502512391958*^9}, {
  3.627502575779676*^9, 
  3.627502595650487*^9}},ExpressionUUID->"fd504065-8fd0-4bbb-ab78-\
ea3fc52db3f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TestPleat", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["qa_",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["qb_",
       FontSlant->"Italic"]}], "}"}], ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dir", ",", "dab", ",", "len", ",", "pa", ",", "pb"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dir", "=", 
      RowBox[{
       RowBox[{"RotationMatrix2D", "[", 
        RowBox[{"-", "\[Alpha]"}], "]"}], ".", 
       RowBox[{"NormalizeReal", "[", 
        RowBox[{"qa", "-", "qb"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dab", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qa", "-", "qb"}], ")"}], ".", "dir"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"len", "=", 
      RowBox[{"1.8", " ", 
       RowBox[{"Mag", "[", 
        RowBox[{"qa", "-", "qb"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pa", "=", 
      RowBox[{"qa", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"len", "-", "dab"}], ")"}], "dir"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pb", "=", 
      RowBox[{"qb", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"len", "+", "dab"}], ")"}], "dir"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Polygon", "[", 
          RowBox[{"{", 
           RowBox[{"pa", ",", "pb", ",", "qb", ",", "qa"}], "}"}], "]"}], ",", 
         RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"qa", ",", "qb"}], "}"}], "]"}], ",", "Black"}], "]"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"qa", ",", "pa"}], "}"}], "]"}], ",", "Red"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"qb", ",", "pb"}], "}"}], "]"}], ",", "Blue"}], "]"}]}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.627502486654985*^9, 3.627502486677009*^9}, {
   3.627502600531502*^9, 3.627502617422138*^9}, {3.627502697351153*^9, 
   3.627502723535569*^9}, {3.627502782170388*^9, 3.62750280220112*^9}, {
   3.627502881678406*^9, 3.62750301921345*^9}, {3.627503069205219*^9, 
   3.627503086102213*^9}, 3.627503661374823*^9, 3.68816683690415*^9, 
   3.701092855304425*^9},
 CellLabel->
  "In[2682]:=",ExpressionUUID->"9f0cfcd3-7c62-4385-9893-72dbd54440d6"],

