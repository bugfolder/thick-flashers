Cell[TextData[{
 "Graph3DGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] draws the graph in the same way as GraphGraphics, but ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " should be a TGraph3D, and it returns a Graphics3D object. Options are:\n\t\
VertexLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"aba848cf-6f53-4542-b469-c1a1c303a749"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "942e6417-37d8-4b78-8c3c-44ef7bb5e8b9"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th vertex.\n\tEdgeLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"3de67d21-fbfd-47cb-8906-a7893021011b"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "405015fc-fcf4-4829-8dea-62383e5d52f6"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th edge.\n\tFaceLabels \[Rule] Automatic | None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["lbl",
       FontSlant->"Italic"], "1"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"e089d3ba-d5f3-4049-9ecb-aabee899aa5a"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["lbl",
     FontSlant->"Italic"], "i"], TraditionalForm]],ExpressionUUID->
  "d890d63c-52d1-4663-aeb0-63dccbdeffc9"],
 " is the placed label (text+position) for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th face.\n\tDirectedEdges \[Rule] True | False, display edges as directed \
edges.\n\tDirectedEdges3D \[Rule] True | False, display edges as directed \
edges using 3D arrows and tubes for lines.\n\tVertexColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specify the base color for vertices.\n\tEdgeColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specify the base color for edges.\n\tFaceColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specify the base color for faces.\n\tFaceColoring \[Rule] None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["fc",
       FontSlant->"Italic"], "1"], ",", " ", 
     SubscriptBox[
      StyleBox["fc",
       FontSlant->"Italic"], "2"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"cb0f5945-89e7-4648-9bbe-695a2994f6f2"],
 ", color the faces, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["fc", "i"], TraditionalForm]],ExpressionUUID->
  "b05fdfd9-f30a-42c8-aa57-21d374baaa76"],
 " is \[PlusMinus]1. None implies no face coloring.\n\tOptions[Graphics3D]"
}], "Text",
 CellChangeTimes->{{3.5919604869592743`*^9, 3.591960519067037*^9}, {
   3.591960570385655*^9, 3.5919606003342443`*^9}, 3.592344303926483*^9, 
   3.5923458174721003`*^9, 3.592377766678539*^9, 3.592435857797578*^9, 
   3.592828771494879*^9, {3.592852014132388*^9, 3.592852019177129*^9}, {
   3.593008181638932*^9, 3.593008355736909*^9}, {3.593009259865172*^9, 
