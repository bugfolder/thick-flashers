   3.703603645837082*^9}, {3.703603787201537*^9, 3.7036038338004913`*^9}, {
   3.703603909851898*^9, 3.703604044665286*^9}, {3.703604150509682*^9, 
   3.703604152589527*^9}, {3.703604246759736*^9, 3.703604492330623*^9}, {
   3.703604525457876*^9, 3.7036045390330257`*^9}, {3.703604570090279*^9, 
   3.703604570651748*^9}, {3.703605048245687*^9, 3.703605183680332*^9}, {
