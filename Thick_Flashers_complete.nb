Cell[CellGroupData[{

Cell[TextData[{
 "ShortestAngle3D[",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "] [deprecated]"
}], "Subsubsection",
 CellChangeTimes->{{3.483703494288868*^9, 3.483703500624413*^9}, {
   3.496237066529303*^9, 3.496237072826506*^9}, 3.591978848529223*^9, 
   3.628786344413597*^9, {3.731921235257848*^9, 
   3.731921238359441*^9}},ExpressionUUID->"9505c7bc-1ed1-49f7-9da6-\
5472d3d3a83b"],

Cell[TextData[{
 "ShortestAngle3D",
 "[",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "] returns the angle between ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 " via the shortest route. Result lies in the range of built-in function \
ArcCos, ie.,  [0,\[Pi]]. Neither vector should be zero-length."
}], "Text",
 CellChangeTimes->{{3.483703502848235*^9, 3.483703519742947*^9}, {
   3.483704440057274*^9, 3.483704442990102*^9}, {3.483705138036894*^9, 
   3.483705183928196*^9}, {3.496237066546876*^9, 3.496237072858491*^9}, 
   3.496237120583181*^9, {3.496237355408513*^9, 3.496237382111553*^9}, 
   3.591978848628744*^9, 
   3.62878634449605*^9},ExpressionUUID->"eb4ada4b-9ce4-4972-bd39-\
4d630ca2764e"],

Cell["\<\
The function ShortestAngle works in any dimension, so we \
don\[CloseCurlyQuote]t need a 3D-specific version, but keep the definition \
here for backwards compatibility.\
\>", "Text",
 CellChangeTimes->{{3.731921217580154*^9, 
  3.731921275915287*^9}},ExpressionUUID->"73644e70-5cdb-4865-8e01-\
288b7ef0f41b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShortestAngle3D", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"ShortestAngle", "[", 
    RowBox[{"a", ",", "b"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.483704454339412*^9, 3.483704608566489*^9}, {
   3.483705018280308*^9, 3.483705123031788*^9}, 3.483705191308157*^9, {
   3.4962370666006*^9, 3.496237072929892*^9}, {3.496237191146319*^9, 
   3.4962372112622766`*^9}, {3.496237296433427*^9, 3.496237309587647*^9}, 
   3.591978848654351*^9, 3.628786344519286*^9, {3.731921208151441*^9, 
   3.731921212888448*^9}},
 CellLabel->
  "In[726]:=",ExpressionUUID->"11e435e5-18cf-4408-a60d-afbf3baf927b"],

Cell["Example", "Text",
 CellChangeTimes->{{3.483705194191435*^9, 
  3.483705194807159*^9}},ExpressionUUID->"a6d9b0c6-e60c-4aca-8edf-\
c1cf9f63b236"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "p", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p", "=", 
     RowBox[{"{", 
      RowBox[{"2", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ShortestAngle3D", "[", 
        RowBox[{"p", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ShortestAngle3D", "[", 
        RowBox[{"p", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ShortestAngle3D", "[", 
        RowBox[{"p", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ShortestAngle3D", "[", 
        RowBox[{"p", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", ".1", ",", ".1"}], "}"}]}], "]"}]}], "}"}], "//", 
     "ShowExample"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.483705196245737*^9, 3.483705285283189*^9}, {
  3.496237066702495*^9, 3.496237090769497*^9}, {3.496237396708674*^9, 
  3.496237411352479*^9}, {3.591978848663704*^9, 3.591978848711415*^9}, {
  3.628786344531215*^9, 3.628786344576857*^9}},
 CellLabel->
  "In[727]:=",ExpressionUUID->"3c9ce0ea-4a63-4624-901f-d8ff293c3403"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Reflection/rotation/translation of expressions", "Subsection",
 CellChangeTimes->{{3.5959736966645517`*^9, 3.595973702627806*^9}, {
  3.643207261933107*^9, 3.6432072670853567`*^9}, {3.708400919989191*^9, 
  3.708400922546379*^9}, {3.708603058749838*^9, 
  3.708603095651609*^9}},ExpressionUUID->"6913e028-5038-4b9e-9ee7-\
137cb0afb10f"],

Cell[CellGroupData[{

Cell[TextData[{
 "RotateZ3D",
 "[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", \[Phi]]"
}], "Subsubsection",
 CellChangeTimes->{3.441505252096524*^9, 
  3.5955269760792627`*^9},ExpressionUUID->"054c2a3a-42ae-4c10-a698-\
3619fdf0b3a9"],

Cell[TextData[{
 "RotateZ3D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", \[Phi]] rotates the graphic object g by the angle \[Phi] about the z axis."
}], "Text",
 CellChangeTimes->{{3.595526976169894*^9, 
  3.5955269861053658`*^9}},ExpressionUUID->"8d4ddaef-dba0-4e7e-9e0b-\
103dcdcc7037"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotateZ3D", "[", 
   RowBox[{"g_", ",", "\[Phi]_"}], "]"}], ":=", 
  RowBox[{"MatrixTransform", "[", 
   RowBox[{"g", ",", 
    RowBox[{"RotationZMatrix3D", "[", "\[Phi]", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.441499806537521*^9, 3.595526834351686*^9, 
  3.595526976212785*^9},
 CellLabel->
  "In[728]:=",ExpressionUUID->"886cbc41-1c9f-4788-bf54-67a362466c2f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Translate3D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.526834533966827*^9, 
  3.526834536110681*^9}},ExpressionUUID->"84a8f857-ae3e-4863-8bf1-\
62c99a7de824"],

Cell[TextData[{
 "Translate3D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "] translates the graphics object ",
 StyleBox["g",
  FontSlant->"Italic"],
 " by the vector ",
 StyleBox["v",
  FontSlant->"Italic"],
 ". Yes, this is exactly the same as Translate2D; we just provide the second \
name for completeness/readability."
}], "Text",
 CellChangeTimes->{{3.526834475144257*^9, 3.526834499731064*^9}, {
  3.526834543407052*^9, 3.526834545134155*^9}, {3.526834616568911*^9, 
  3.526834634472978*^9}},ExpressionUUID->"76628ee0-1c7e-4bf3-ae0a-\
fa7a59a5a9c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Translate3D", "[", 
   RowBox[{"g_", ",", "v_"}], "]"}], ":=", 
  RowBox[{"FunctionTransform", "[", 
   RowBox[{"g", ",", 
    RowBox[{
     RowBox[{"#", "+", "v"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.526834547708643*^9, 3.526834595500267*^9}},
 CellLabel->
  "In[729]:=",ExpressionUUID->"97178fb5-a5bf-454d-8030-40f7949aac16"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DupReflect3D[",
 StyleBox["g",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",ExpressionUUID->"3ef1bbe0-9271-4748-b96c-e2446ab34f15"],

Cell["\<\
DupReflect2D[g] takes the graphic components g and returns a list consisting \
of g plus its reflection in the x-x plane.\
\>", "Text",ExpressionUUID->"89c3e3e1-c323-49ef-9f1f-cd2c516c7920"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DupReflect3D", "[", "g_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"g", ",", 
    RowBox[{"MatrixTransform", "[", 
     RowBox[{"g", ",", "ReflectionXZMatrix3D"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{3.4414998066218576`*^9},
 CellLabel->
  "In[730]:=",ExpressionUUID->"eec086af-1395-4492-8b64-8e4943b1d44e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DupRotate3D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.44150523798643*^9},ExpressionUUID->"e349a631-25ca-48a3-853f-aa918a51decf"],

Cell["\<\
DupRotate3D[g,m] takes the graphics components g and returns a list \
consisting of g plus the m-1 rotated duplicates.\
\>", "Text",ExpressionUUID->"457eb300-7140-4a7d-9edf-7f3e39a9555e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DupRotate3D", "[", 
   RowBox[{"g_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"MatrixTransform", "[", 
     RowBox[{"g", ",", 
      RowBox[{"RotationZMatrix3D", "[", 
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"i", "/", "m"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.4414998066869802`*^9, 3.595526834392908*^9},
 CellLabel->
  "In[731]:=",ExpressionUUID->"38fd750d-0b1f-4da6-a6a4-0b4f06d41201"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DupReflectAndRotate3D[",
 StyleBox["g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.441505243127863*^9},ExpressionUUID->"ecb7e754-d0da-42f7-8235-\
1b303fd0bc50"],

Cell["\<\
DupReflectAndRotate3D[g,m] takes the graphics components g and returns a list \
consisting of the reflection plus the m-1 rotated duplicates of both.\
\>", "Text",ExpressionUUID->"56cfba44-34bb-4cd0-9842-f47c2e66805a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DupReflectAndRotate3D", "[", 
   RowBox[{"g_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gg", "=", 
      RowBox[{"{", 
       RowBox[{"g", ",", 
        RowBox[{"MatrixTransform", "[", 
         RowBox[{"g", ",", "ReflectionXZMatrix3D"}], "]"}]}], "}"}]}], "}"}], 
    ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"MatrixTransform", "[", 
       RowBox[{"gg", ",", 
        RowBox[{"RotationZMatrix3D", "[", 
         RowBox[{"2", "\[Pi]", " ", 
          RowBox[{"i", "/", "m"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.441499806805807*^9, 3.441499806823013*^9}, 
   3.595526834443124*^9},
 CellLabel->
  "In[732]:=",ExpressionUUID->"10b53285-d7aa-4509-9019-8230e9d74e2e"]
}, Closed]]
}, Closed]],

