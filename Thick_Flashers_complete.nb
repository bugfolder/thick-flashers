Cell[TextData[{
 "GetValues[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["properties",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a list of the values of the specified properties in the same \
order as the properties. It\[CloseCurlyQuote]s an easy way to extract a set \
of multiple properties from a ",
 "TObj",
 ". Default behavior checks for existence and throws an error if one is \
missing, but you can override this by supplying the option CheckProperties\
\[Rule]False, e.g., if some of the properties are optional."
}], "Text",
 CellChangeTimes->{{3.59163577035105*^9, 3.591635791220846*^9}, {
   3.591635856616534*^9, 3.591635944930749*^9}, {3.591636913573777*^9, 
   3.591636972360277*^9}, 3.5916402734445863`*^9, 
   3.592435732652192*^9},ExpressionUUID->"f7b120e5-0f5a-4846-aca3-\
9856fb1faa10"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GetValues", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"AssertProperties", "\[Rule]", "True"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.5916358061157303`*^9, 3.591635850740243*^9}, 
   3.591636920011276*^9, 3.593006082656413*^9},
 CellLabel->
