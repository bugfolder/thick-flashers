Cell[TextData[{
 "FaceCentroids[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a ",
 "TGraph",
 " and returns a list of coordinate pairs for the centers of the dual to the \
graph with vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where ",
 StyleBox["faces",
  FontSlant->"Italic"],
 " is a list of counterclockwise vertices for each face in the graph. It is \
useful for constructing a topological dual of a given plane graph."
}], "Text",
 CellChangeTimes->{
  3.455922971999592*^9, {3.457623813614851*^9, 3.457623814044601*^9}, {
   3.457625276647163*^9, 3.4576252921339707`*^9}, {3.458215797434677*^9, 
   3.458215798222682*^9}, 3.458215906994207*^9, 3.4848290447617807`*^9, {
   3.591718588400851*^9, 3.591718588734085*^9}, {3.5917186465710588`*^9, 
   3.591718652215438*^9}, {3.592350927048822*^9, 3.5923509276961193`*^9}, {
   3.592381719349625*^9, 3.592381728676734*^9}, 
   3.592435851444804*^9},ExpressionUUID->"79a10b3b-a838-4b8a-b4d7-\
35b84df01795"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceCentroids", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "faces"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"FaceCentroid", "[", 
        RowBox[{"verts", ",", "#"}], "]"}], "&"}], "/@", "faces"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.458215799172323*^9, 3.458215799849135*^9}, 
   3.4582159070124598`*^9, {3.591718544463296*^9, 3.5917185766251087`*^9}, {
   3.591718623534087*^9, 3.591718623928728*^9}, {3.591983175538931*^9, 
   3.591983217683868*^9}, {3.592350982522072*^9, 3.592351007605691*^9}, 
   3.592435739677374*^9},
 CellLabel->
  "In[1185]:=",ExpressionUUID->"e82035ad-c76f-4fcf-af12-a85599f37a03"],

Cell[TextData[{
 "FaceCircumcenterInfo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a list of records of the form {",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["flag, dlist",
  FontSlant->"Italic"],
 "} for each face where ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 " is the circumcenter of the face, ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the radius of the circumscribing circle,  ",
 StyleBox["flag",
  FontSlant->"Italic"],
 " is True iff every point in the face lies on the circumcircle, and ",
 StyleBox["dlist",
  FontSlant->"Italic"],
 " is the distance from the circumcenter to each vertex in the face. Options \
are:\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the distance tolerance on deciding whether a vertex lies on the \
circumcircle."
}], "Text",
 CellChangeTimes->{{3.485210392790865*^9, 3.485210573461028*^9}, {
   3.485211311753084*^9, 3.48521133303148*^9}, {3.5917186405645514`*^9, 
   3.591718662443331*^9}, {3.592351168160788*^9, 3.5923511688243732`*^9}, 
   3.592381724085664*^9, 3.592435851571048*^9, 3.594654039227228*^9, 
   3.708343018336807*^9},ExpressionUUID->"530af974-6871-4810-831d-\
d330d95cb5e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FaceCircumcenterInfo", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"SamePtTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.485210609226746*^9, 3.4852106280828547`*^9}, 
   3.594654040470412*^9},
 CellLabel->
  "In[1186]:=",ExpressionUUID->"5ebcd721-2ee8-4953-a7eb-49d18c85b922"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceCircumcenterInfo", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "faces"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ConcyclicInfo", "[", 
        RowBox[{
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], ",",
          "opts"}], "]"}], "&"}], "/@", "faces"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4852105929387703`*^9, 3.485210647040806*^9}, {
   3.485211349666786*^9, 3.48521137244991*^9}, {3.485213158593454*^9, 
   3.485213194343625*^9}, {3.591718613229228*^9, 3.591718629693174*^9}, 
   3.592435739775269*^9, 3.628531117290232*^9},
 CellLabel->
  "In[1187]:=",ExpressionUUID->"249aa949-3177-48b1-a2e8-45e12dce9949"],

Cell[TextData[{
 "FaceCircumscribableQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph and returns True if all of the faces are individually \
circumscribable. Options are:\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the distance tolerance on deciding whether a vertex lies on the \
circumcircle."
}], "Text",
