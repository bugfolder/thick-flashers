Cell[BoxData[
 RowBox[{
  RowBox[{"CircularlyAddEdges", "[", 
   RowBox[{"tobj_TObj", ",", "bverts_", ",", "ctr_List", ",", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", " ", "edges", ",", "nverts", ",", "nedges"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "CircularlyAddEdges"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"r", "*", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{"#", "-", "ctr"}], "]"}]}]}], "&"}], "/@", 
       RowBox[{
       "verts", "\[LeftDoubleBracket]", "bverts", 
        "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "bverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", "verts", "]"}], "+", "i"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "nverts", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", 
          RowBox[{"Join", "[", 
           RowBox[{"verts", ",", "nverts"}], "]"}]}], ",", 
         RowBox[{"Edges", "\[Rule]", 
          RowBox[{"Join", "[", 
           RowBox[{"edges", ",", "nedges"}], "]"}]}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
