 "]\n\t(options) StationaryFace, ShowProgress"
}], "Subsubsection",
 CellChangeTimes->{{3.7222474180106087`*^9, 3.722247439760581*^9}, 
   3.722247472712229*^9},ExpressionUUID->"00dd850f-1975-47d8-a7a9-\
114cdcb969bf"],

Cell[TextData[{
 "FoldEmbedding[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["everts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] folds a specified embedding of a TGraph."
}], "Text",
 CellChangeTimes->{{3.722234936113016*^9, 
  3.722234974352535*^9}},ExpressionUUID->"b2e89a8f-e856-4fa0-b026-\
3d8f4bdf2318"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph to be folded.\n\t",
 StyleBox["everts",
  FontSlant->"Italic"],
 " \[LongDash] the embedding vertices, could be 2D or 3D.\n\t",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " \[LongDash] the angles on the edges."
}], "Text",
 CellChangeTimes->{{3.722234979480654*^9, 
  3.7222350210177593`*^9}},ExpressionUUID->"14a27c2c-4f22-4ecc-b611-\
d4d493169bd4"],

Cell[TextData[{
 "Options:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 ", the face that remains fixed.\n\tShowProgress \[Rule] True | False, \
whether to show progress and internal structures. Useful for debugging."
}], "Text",
 CellChangeTimes->{{3.722235024617007*^9, 3.72223504002565*^9}, {
  3.72223632833956*^9, 3.722236352043619*^9}, {3.722244365985203*^9, 
  3.722244384800256*^9}, {3.722248395787295*^9, 
  3.722248413915446*^9}},ExpressionUUID->"b8fa07e0-4586-4b80-ab88-\
3950da17ab77"],

Cell["\<\
Returns a new list of 3D vertices that represents the new embedding. Returned \
vertices are always 3D, whether or not original vertices were 2D or 3D.\
\>", "Text",
 CellChangeTimes->{{3.72223504192863*^9, 3.722235059297715*^9}, {
  3.722244144221142*^9, 3.722244145069646*^9}, {3.7222501707474627`*^9, 
  3.722250171522666*^9}},ExpressionUUID->"c61bf494-c1c1-4778-8ea7-\
00fbbe7347e4"],

Cell[TextData[{
 "Note that ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " entries for border edges are ignored. This is made use of in \
FoldGraph2DAll."
}], "Text",
 CellChangeTimes->{{3.722244151295023*^9, 3.722244166533974*^9}, {
  3.722250169662232*^9, 
  3.722250208097714*^9}},ExpressionUUID->"260bcd6b-ad82-477d-9865-\
19e7fb68e510"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StationaryFace", "::", "usage"}], 
   "=", "\"\<StationaryFace is an option to FoldEmbedding that specifies \
which face remains stationary.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591726399134268*^9, 3.591726426584786*^9}, 
   3.59279126764576*^9, 3.595200245864203*^9, 3.7222487860336237`*^9},
 CellLabel->
  "In[1333]:=",ExpressionUUID->"3f2d2cc3-3fc6-4daf-9628-499ec371191c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowProgress", "::", "usage"}], 
   "=", "\"\<ShowProgress is an option to FoldEmbedding (and other complex \
functions) that specifies to show intermediate results and internal data \
structures.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591726399134268*^9, 3.591726426584786*^9}, 
   3.59279126764576*^9, 3.595200245864203*^9, 3.7222487860336237`*^9, {
   3.7222617969528646`*^9, 3.722261829351791*^9}},
 CellLabel->
  "In[1334]:=",ExpressionUUID->"1b837f2f-1705-4381-9eaa-1e6257f4bf42"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FoldEmbedding", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"StationaryFace", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.722235064823824*^9, 3.7222350791220217`*^9}, {
  3.72224439466649*^9, 3.722244398752755*^9}},
 CellLabel->
  "In[1335]:=",ExpressionUUID->"46fd35c3-5f1d-448d-89f8-4577925f8bcd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldEmbedding", "[", 
   RowBox[{
   "tobj_TObj", ",", "everts_List", ",", "foldangles_List", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sface", ",", "sp", ",", "dim", ",", "verts3d", ",", "tobj1", ",", 
      "edges", ",", "faces", ",", "vei", ",", "vfi", ",", "efi", ",", "fei", ",",
       "ei", ",", "nf", ",", "efaces", ",", "emap", ",", "efn", ",", "dedges",
       ",", "vstree", ",", "bfte", ",", "kids", ",", "face", ",", "ffn", ",", 
      "dedge", ",", "if", ",", "redge", ",", "fedge", ",", "\[Phi]", ",", 
      "eface", ",", "w", ",", "q", ",", "rm", ",", "xfrm"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sface", "=", 
      RowBox[{
       RowBox[{"StationaryFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldEmbedding", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldEmbedding", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", "tobj", ",", 
        RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"GraphGraphics", "[", "tobj1", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "edges", ",", "faces", ",", "vei", ",", "vfi", ",", "efi", ",", 
        "fei"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{
         "Edges", ",", "Faces", ",", "VertexEdgeIncidence", ",", 
          "VertexFaceIncidence", ",", "EdgeFaceIncidence", ",", 
          "FaceEdgeIncidence"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"ei", "[", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "]"}], " ", "returns", " ", "the", " ",
        "index", " ", "into", " ", "edges", " ", "of", " ", "edge", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "."}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ei", "[", 
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          "]"}], "=", "i"}], ";", 
        RowBox[{
         RowBox[{"ei", "[", 
          RowBox[{"Reverse", "[", 
           RowBox[{
           "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "]"}], "]"}], "=", "i"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nf", "=", 
      RowBox[{"Length", "[", "faces", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{
       RowBox[{"Dimensions", "[", "everts", "]"}], "\[LeftDoubleBracket]", 
       "2", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dim", "\[Equal]", "3"}], ",", "everts", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", "everts"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"efaces", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "faces"}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{"embedded", " ", "faces"}], " ", "*)"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "map", " ", "pairing", " ", "original", " ", "edge", " ", "with", " ", 
       "dual", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"emap", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"edges", ",", "efi"}], "}"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "\[NotEqual]",
            "0"}], "&&", 
          RowBox[{
           RowBox[{"#", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "\[NotEqual]",
            "0"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<emap = \>\"", ",", "emap"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{" ", 
        RowBox[{
        "efn", " ", "takes", " ", "a", " ", "dual", " ", "edge", " ", 
         RowBox[{"(", 
          RowBox[{"fi", ",", "fj"}]}]}], "}"}], " ", "and", " ", "returns", " ",
        "the", " ", "corresponding", " ", "original", " ", "edge", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"efn", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}],
           "=", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
         
         RowBox[{
          RowBox[{"efn", "[", 
           RowBox[{"Reverse", "[", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "]"}], "]"}], "=", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], 
        ")"}], "&"}], "/@", "emap"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"internal", " ", "dual", " ", "edges"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dedges", "=", 
      RowBox[{"Last", "/@", "emap"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<internal dual edges = \>\"", ",", "dedges"}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"breadth", "-", 
        RowBox[{
        "first", " ", "traversal", " ", "edges", " ", "from", " ", "the", " ",
          "spanning", " ", "tree"}]}], ",", " ", 
       RowBox[{"in", " ", "reverse", " ", "order"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vstree", "=", 
      RowBox[{"FindSpanningTree", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"Range", "[", "nf", "]"}], ",", "dedges"}], "]"}], ",", 
         "sface"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bfte", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{"BreadthFirstScan", "[", 
          RowBox[{"vstree", ",", "sface", ",", 
           RowBox[{"{", 
            RowBox[{"\"\<FrontierEdge\>\"", "\[Rule]", "Sow"}], "}"}]}], 
          "]"}], "]"}], "\[LeftDoubleBracket]", 
        RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "/.", 
       RowBox[{"UndirectedEdge", "\[Rule]", "List"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bfte", "=", 
      RowBox[{"Reverse", "[", "bfte", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<traversal edges = \>\"", ",", "bfte"}], "]"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"show", " ", "the", " ", "spanning", " ", "tree"}], ",", " ", 
       RowBox[{
       "this", " ", "time", " ", "with", " ", "vertices", " ", "for", " ", 
        "rendering"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"Graph", "[", 
         RowBox[{"vstree", ",", 
          RowBox[{"VertexCoordinates", "\[Rule]", 
           RowBox[{"FaceCentroids", "[", "tobj1", "]"}]}], ",", 
          RowBox[{"VertexLabels", "\[Rule]", "\"\<Index\>\""}], ",", 
          RowBox[{"EdgeLabels", "\[Rule]", "\"\<Index\>\""}], ",", 
          RowBox[{"EdgeLabelStyle", "\[Rule]", "Red"}]}], "]"}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "children", " ", "of", " ", "each", " ", "node", " ", "of", " ", 
       "spanning", " ", "tree"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"kids", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "i", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nf"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"kids", "\[LeftDoubleBracket]", 
         RowBox[{"bfte", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
         "\[RightDoubleBracket]"}], "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"kids", "\[LeftDoubleBracket]", 
            RowBox[{"bfte", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{"kids", "\[LeftDoubleBracket]", 
            RowBox[{"bfte", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}], "}"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"nf", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<kids = \>\"", ",", "kids"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"ffn", "[", 
        RowBox[{"i", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "k"}], "}"}]}], "]"}], " ", "takes", " ", "an", " ",
        "undirected", " ", "edge", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", "k"}], "}"}], " ", "in", " ", "face", " ", "i", " ",
        "and", " ", "returns", " ", "the", " ", "index", " ", "pair", " ", 
       "into", " ", "the", " ", "ith", " ", "face", " ", "of", " ", "the", " ",
        "vertices", " ", "of", " ", "the", " ", "corresponding", " ", 
       "directed", " ", 
       RowBox[{"edge", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"face", "=", 
         RowBox[{
         "faces", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n", "=", 
            RowBox[{"Length", "[", "face", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"ffn", "[", 
               RowBox[{"i", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                  "face", "\[LeftDoubleBracket]", "j", 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"face", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "1"}], ",", "n", ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], "=", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"j", "+", "1"}], ",", "n", ",", "1"}], "]"}]}], 
               "}"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ffn", "[", 
               RowBox[{"i", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"face", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "1"}], ",", "n", ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{
                  "face", "\[LeftDoubleBracket]", "j", 
                   "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], "=", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"j", "+", "1"}], ",", "n", ",", "1"}], "]"}]}], 
               "}"}]}], ";"}], "\[IndentingNewLine]", ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"Length", "[", "face", "]"}]}], "}"}]}], "]"}]}], 
         "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nf"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"for", " ", "each", " ", "traversal", " ", "edge"}], ",", " ", 
       
       RowBox[{
       "apply", " ", "rotation", " ", "to", " ", "embedded", " ", "face", " ",
         "and", " ", "its", " ", "children"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"dedge", "=", 
         RowBox[{
         "bfte", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"directed", " ", "dual", " ", "edge"}], " ", "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"if", "=", 
         RowBox[{
         "dedge", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"index", " ", "of", " ", "source", " ", "face"}], " ", 
         "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"face", "=", 
         RowBox[{
         "faces", "\[LeftDoubleBracket]", "if", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"redge", "=", 
         RowBox[{"efn", "[", "dedge", "]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"undirected", " ", "rotation", " ", "edge", " ", 
          RowBox[{"(", 
           RowBox[{
           "as", " ", "pair", " ", "of", " ", "vertex", " ", "indices"}], 
           ")"}]}], " ", "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"fedge", "=", 
         RowBox[{"ffn", "[", 
          RowBox[{"if", ",", "redge"}], "]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{
         "index", " ", "pair", " ", "into", " ", "embedded", " ", "face", " ",
           "of", " ", "rotation", " ", "edge"}], " ", "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Phi]", "=", 
         RowBox[{"foldangles", "\[LeftDoubleBracket]", 
          RowBox[{"ei", "[", "redge", "]"}], "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"desired", " ", "fold", " ", "angle"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"eface", "=", 
         RowBox[{
         "efaces", "\[LeftDoubleBracket]", "if", "\[RightDoubleBracket]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"w", "=", 
         RowBox[{"NormalizeReal", "[", 
          RowBox[{"Subtract", "@@", 
           RowBox[{
           "eface", "\[LeftDoubleBracket]", "fedge", 
            "\[RightDoubleBracket]"}]}], "]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"rotation", " ", "axis"}], " ", "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"q", "=", 
         RowBox[{"efaces", "\[LeftDoubleBracket]", 
          RowBox[{"if", ",", 
           RowBox[{
           "fedge", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "\[RightDoubleBracket]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{
         "initial", " ", "point", " ", "of", " ", "rotation", " ", "axis"}], 
         " ", "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rm", "=", 
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{"\[Phi]", ",", "w"}], "]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"fully", " ", "evaluate", " ", "rotation", " ", "matrix"}], 
         " ", "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"xfrm", "=", 
         RowBox[{
          RowBox[{"q", "+", 
           RowBox[{"rm", ".", 
            RowBox[{"(", 
             RowBox[{"#", "-", "q"}], ")"}]}]}], "&"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"sp", ",", 
          RowBox[{"Print", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<dedge\>\"", "\[Rule]", "dedge"}], ",", 
             RowBox[{"\"\<if\>\"", "\[Rule]", "if"}], ",", 
             RowBox[{"\"\<face\>\"", "\[Rule]", "face"}], ",", 
             RowBox[{"\"\<redge\>\"", "\[Rule]", "redge"}], ",", 
             RowBox[{"\"\<fedge\>\"", "\[Rule]", "fedge"}], ",", 
             RowBox[{"\"\<eface\>\"", "\[Rule]", "eface"}], ",", 
             RowBox[{"\"\<\[Phi]\>\"", "\[Rule]", "\[Phi]"}], ",", 
             RowBox[{"\"\<w\>\"", "\[Rule]", "w"}], ",", 
             RowBox[{"\"\<q\>\"", "\[Rule]", "q"}]}], "}"}], "]"}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
