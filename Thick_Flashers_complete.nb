Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "m", ",", "n", ",", "o", ",", "tobjpd", ",", "\[Gamma]", ",", "\[Alpha]",
       ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "8"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"o", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"MakeOffsetGoldbergTilingPrimalDualGraph", "[", 
       RowBox[{"m", ",", "n", ",", "o"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"OrientEdgePairs", "[", 
       RowBox[{"tobjpd", ",", 
        RowBox[{"RadialAxialOrderingFn", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"RadialMajor", "\[Rule]", "False"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", "1.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"22.0", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
