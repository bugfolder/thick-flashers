      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Gray", ",", 
        RowBox[{"Point", "/@", 
         RowBox[{"{", 
          RowBox[{"p0", ",", "p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}],
         ",", "Black", ",", "\[IndentingNewLine]", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p0\>\"", ",", "p0"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p1\>\"", ",", "p1"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p2\>\"", ",", "p2"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p3\>\"", ",", "p3"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p4\>\"", ",", "p4"}], "]"}]}], "}"}], "]"}]}]}], "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.457613296629635*^9, 3.457613455369594*^9}, 
   3.471290137179636*^9, {3.471290339534869*^9, 3.4712903432957153`*^9}, {
   3.471290698363265*^9, 3.471290722476707*^9}, {3.589466020303685*^9, 
   3.589466024432211*^9}, {3.591974631463048*^9, 3.591974666723818*^9}},
