Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeTSpaceCurve", "[", 
    RowBox[{
     StyleBox["plist",
      FontSlant->"Italic"], ",", "  ", "w", ",", " ", "\[Sigma]", ",", " ", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "bff49814-921d-4622-a25a-cb0e1cd9f40c"],
 "\nMakeTSpaceCurve[",
 StyleBox["plist",
  FontSlant->"Italic"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "L"], ",", 
     SubscriptBox["w", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "70f8a0ac-83eb-4464-9b79-a1809829f1d1"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Sigma]", "L"], ",", 
     SubscriptBox["\[Sigma]", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "fa3dd069-0598-44b9-8e9d-28554a9f87b5"],
 "},  ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) SpaceCurveFirstCreaseAngle, OsculatingVectorNear"
}], "Subsubsection",
 CellChangeTimes->{{3.440971799721715*^9, 3.440971819250101*^9}, 
   3.440971856739349*^9, {3.441495621197334*^9, 3.4414956266284933`*^9}, {
   3.442058899213077*^9, 3.4420589197035*^9}, {3.442058963275785*^9, 
   3.442058975785384*^9}, {3.442090502599329*^9, 3.442090554024899*^9}, 
   3.442523603679687*^9, {3.443219695429266*^9, 3.443219698490542*^9}, {
   3.443219799088*^9, 3.443219800911708*^9}, 3.44322067133175*^9, 
   3.592082501297474*^9, {3.5920826079699717`*^9, 3.592082610634016*^9}, {
   3.592083053620599*^9, 3.5920830591332393`*^9}, {3.592438297830014*^9, 
   3.592438305930562*^9}, 3.592466149777515*^9, {3.592868687791631*^9, 
   3.592868687843349*^9}, {3.59494557451252*^9, 3.594945576863584*^9}, 
   3.594945732832672*^9, 3.5949856925032463`*^9, {3.688166836723304*^9, 
   3.688166836746873*^9}, {3.70108882689396*^9, 3.701088826894108*^9}, {
   3.806853839250326*^9, 
   3.806853839250418*^9}},ExpressionUUID->"4d73b329-13cd-4977-96a2-\
216227816209"],

Cell[TextData[{
 "MakeTSpaceCurve[",
 StyleBox["plist",
  FontSlant->"Italic"],
 ",  ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Sigma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] or MakeTSpaceCurve[",
 StyleBox["plist",
  FontSlant->"Italic"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "L"], ",", 
     SubscriptBox["w", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "744dae99-938f-4ae2-9696-d0b4e7c84fb4"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Sigma]", "L"], ",", 
     SubscriptBox["\[Sigma]", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "3097a9aa-7a02-41a6-a070-5741aee029dc"],
 "},  ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["plist",
  FontSlant->"Italic"],
 ",  a scalar width ",
 StyleBox["w",
  FontSlant->"Italic"],
 " or width pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "L"], ",", 
     SubscriptBox["w", "R"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "97804b85-816d-4ffa-91fa-21fc42880a5a"],
 ", and a scalar subarc angle \[Sigma] or angle pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Sigma]", "L"], ",", 
     SubscriptBox["\[Sigma]", "R"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "46fde88e-38f4-4a96-a138-9d77b0703e69"],
 " and constructs a TSpaceCurve that describes a strip of paper, folded along \
its length in such a way that it follows the prescribed curve in 3D. Options \
are:\n\tSpaceCurveFirstCreaseAngle \[Rule] \[Phi], where \[Phi] is the angle \
of the first crease in the crease pattern with respect to the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " axis.\n\tOsculatingVectorNear \[Rule] None | ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["q", "x"], ",", 
     SubscriptBox["q", "y"], ",", 
     SubscriptBox["q", "z"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "f1ad1dbd-d3b5-4f19-937c-cb39f3be1461"],
 ", where, if a vector is given, we choose the sign of the initial osculating \
vector that points into the same half-space as the given option."
}], "Text",
 CellChangeTimes->{{3.440971826961887*^9, 3.440972132965646*^9}, {
   3.441378068589965*^9, 3.441378082916198*^9}, {3.441495482226988*^9, 
   3.441495587284625*^9}, {3.441495623858542*^9, 3.441495629925971*^9}, {
   3.441883374977094*^9, 3.441883375192493*^9}, {3.441965713996366*^9, 
   3.441965774051331*^9}, {3.441972411290449*^9, 3.441972437194905*^9}, {
   3.442062633730782*^9, 3.442062683922268*^9}, {3.442090576410127*^9, 
   3.442090666971335*^9}, {3.4420907054129357`*^9, 3.442090714124048*^9}, 
