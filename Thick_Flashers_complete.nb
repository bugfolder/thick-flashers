Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kp", ",", "v", ",", "rcs", ",", "c"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kp", "=", 
      RowBox[{"2", "&"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"constant", " ", "curvature"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"#", "&"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"linearly", " ", "increasing", " ", "speed"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rcs", "=", 
      RowBox[{"RecoverCurve2DSystemOld", "[", 
       RowBox[{"kp", ",", "v", ",", 
        RowBox[{"InitialPosition2D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], ",", 
        RowBox[{"InitialTangentVector2D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rcs", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//", 
      "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Curve2D", "/.", "rcs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"c", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.69097154200583*^9, 3.690971745596602*^9}, {
   3.690971788658461*^9, 3.690971792111229*^9}, {3.690972128266711*^9, 
