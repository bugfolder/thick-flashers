Cell[TextData[{
 "Vertex3DCreasePatternGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex3D and produces a graphical rendering of the crease \
pattern as a circular vertex. Options are:\n\tOptions[",
 "CircularAngleLabels",
 "] are passed through.\n\tOptions[Graphics] are passed through."
}], "Text",
