Cell[CellGroupData[{

Cell["LineArtImportRules", "Subsubsection",
 CellChangeTimes->{{3.7216309043288*^9, 
  3.721630907771861*^9}},ExpressionUUID->"2943f24d-bbdf-4a15-80e7-\
45f00a9e5b09"],

Cell["LineArtImportRules is the most current set of import rules. ", "Text",
 CellChangeTimes->{{3.721630910720952*^9, 
  3.721630981471305*^9}},ExpressionUUID->"b002ca6e-d188-4f8c-99a9-\
d33e5050e655"],

Cell["\<\
If you build your import notebook using LineArtImportRules, then it will \
(probably) work in future versions of Tessellatica and future versions of \
Mathematica.\
\>", "Text",
 CellChangeTimes->{{3.721630983400597*^9, 
  3.721631012772464*^9}},ExpressionUUID->"368b6381-d034-46c3-94c3-\
0b61f3359d34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LineArtImportRules", "=", "Ma12ImportRules"}], ";"}]], "Input",
 CellChangeTimes->{{3.721630956111906*^9, 3.721630962625822*^9}, 
   3.765047032100324*^9},
 CellLabel->
  "In[858]:=",ExpressionUUID->"b7b766ca-3b85-4c0a-b508-fd93f161f28a"],

Cell["Example. Import a PDF 1.3 test file.", "Text",
 CellChangeTimes->{{3.589465352883995*^9, 
  3.589465360514811*^9}},ExpressionUUID->"d66d11e7-eace-46f5-a42d-\
3b5d68318dac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pdf", ",", "converted"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pdf", "=", 
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"ExamplesDir", "[", "]"}], "<>", "\"\<test_import.pdf\>\""}],
         "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "pdf", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<original pdf = \>\"", ",", 
       RowBox[{"InputForm", "[", "pdf", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"converted", "=", 
      RowBox[{"pdf", "/.", "LineArtImportRules"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "converted", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<converted pdf = \>\"", ",", 
       RowBox[{"InputForm", "[", "converted", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.5894653628242073`*^9, 3.589465432140319*^9}, {
   3.589465562373304*^9, 3.589465620985618*^9}, {3.589465733301235*^9, 
   3.589465737602113*^9}, {3.675963451716163*^9, 3.6759634670151453`*^9}, {
   3.675963537261525*^9, 3.675963648299053*^9}, 3.676034178359521*^9, 
   3.708014916007257*^9, 3.765047037746754*^9},
 CellLabel->
  "In[859]:=",ExpressionUUID->"52d3dc7a-f437-4e9e-8376-c01ca89d68bd"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Import-related Style utilities", "Subsection",
 CellChangeTimes->{{3.456529527008811*^9, 3.456529537222524*^9}, {
  3.456530593802252*^9, 
  3.456530611626815*^9}},ExpressionUUID->"08a9e8bd-55db-4707-87f8-\
33f7bca1ed82"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457532653620243*^9, 
  3.45753265401807*^9}},ExpressionUUID->"605297d0-a857-4fcd-8343-\
3010ec5620fb"],

Cell[TextData[{
 "These functions are utilities for when we import a crease pattern (or, in \
general, a graphical object) and then use that as the basis for a \
tessellation. They're based on the new Style usage in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 7, which uses the structure Style[",
 StyleBox["obj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["styleargs",
  FontSlant->"Italic"],
 ",...] to apply graphical styles to a structure object ",
 StyleBox["obj",
  FontSlant->"Italic"],
 ". Typically when a drawing is imported, it will be imported as a set of \
Graphics primitives wrapped in Style directives. These functions simplify the \
process of extracting sets of simple styled line segments."
}], "Text",
 CellChangeTimes->{{3.45753265724209*^9, 3.457532838470335*^9}, {
   3.484862998780245*^9, 3.484862999891821*^9}, {3.484863227550047*^9, 
   3.484863279856647*^9}, {3.534429386365983*^9, 3.534429386757885*^9}, 
   3.693872238190267*^9},ExpressionUUID->"011de87f-8f8d-46c1-a4ab-\
394ac31d41b0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FractureLines[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "]\n",
 "ExtractFracturedLines",
 "[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.45589448326105*^9, 3.4558944892584043`*^9}, {
   3.48509319982818*^9, 3.485093220538249*^9}, 3.485093271071701*^9, 
   3.534555156260414*^9, 
   3.628786540386931*^9},ExpressionUUID->"f5d13082-208f-490e-85ff-\
b5a22569ffd8"],

Cell[TextData[{
 "FractureLines[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] breaks up any Line[] objects with more than one pt in the path into \
2-vertex line segments."
}], "Text",
 CellChangeTimes->{{3.455894608233062*^9, 
  3.455894634471293*^9}},ExpressionUUID->"9230953a-9793-4926-b966-\
ea5a85727412"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FractureLines", "[", "obj_", "]"}], ":=", 
  RowBox[{"obj", "/.", 
   RowBox[{
    RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", 
    RowBox[{"Line", "/@", 
     RowBox[{"Drop", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"RotateLeft", "[", "x", "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"-", "1"}]}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.455894503390191*^9, 3.4558945743245697`*^9}, {
  3.48502821460911*^9, 3.4850282345500793`*^9}, {3.485028264688208*^9, 
  3.48502829679788*^9}, {3.485028327631947*^9, 3.485028331229734*^9}, {
  3.485028387071311*^9, 3.485028392493146*^9}},
 CellLabel->
  "In[860]:=",ExpressionUUID->"ca71be37-9214-4d2c-a19b-adef6f08a74c"],

Cell["Example", "Text",
 CellChangeTimes->{{3.4850282488313737`*^9, 
  3.4850282495754976`*^9}},ExpressionUUID->"aa8bec3f-fe68-481c-bd1f-\
f9b079873f65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FractureLines", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{"d", ",", "e", ",", "f", ",", "d"}], "}"}], "]"}]}], "}"}], 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.485028299785399*^9, 3.485028320621409*^9}, {
  3.485028408940329*^9, 3.485028410847539*^9}, {3.48509316516965*^9, 
  3.485093191086625*^9}},
 CellLabel->
  "In[861]:=",ExpressionUUID->"3672fd6f-66a7-41ec-9a14-325b2ed1e7e7"],

Cell[TextData[{
 "ExtractFracturedLines",
 "[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] extracts all lines (whether styled or unstyled), fractures them into \
individual line segments, and returns a flattened list of the line segments. \
All style information is lost."
}], "Text",
 CellChangeTimes->{{3.485092839252769*^9, 3.485092908455399*^9}, {
   3.48509304727487*^9, 3.48509305978066*^9}, 3.485093271090236*^9, 
   3.534555156312239*^9, 
   3.628786540463681*^9},ExpressionUUID->"6bb93afc-1da7-43e6-8bc6-\
ce18430f807a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtractFracturedLines", "[", "obj_", "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{"FractureLines", "[", "obj", "]"}], ",", "_Line", ",", 
     "\[Infinity]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.485093061320099*^9, 3.485093082854973*^9}, 
   3.485093271105686*^9, 3.534555156349593*^9, 3.62878654049822*^9},
 CellLabel->
  "In[862]:=",ExpressionUUID->"d92edc33-313a-4a47-93c1-faae66ef6db7"],

Cell["Example", "Text",
 CellChangeTimes->{{3.4850282488313737`*^9, 
  3.4850282495754976`*^9}},ExpressionUUID->"48e2efee-617b-4ee5-bff9-\
75a5f6458d51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtractFracturedLines", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "]"}], ",", "Red"}], "]"}],
      ",", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{"d", ",", "e", ",", "f", ",", "d"}], "}"}], "]"}], ",", 
       "Green"}], "]"}]}], "}"}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.485028299785399*^9, 3.485028320621409*^9}, {
   3.485028408940329*^9, 3.485028410847539*^9}, {3.48509309439986*^9, 
   3.485093109509707*^9}, {3.485093140828061*^9, 3.485093143114161*^9}, {
   3.485093182913359*^9, 3.485093196390778*^9}, 3.4850932711139297`*^9, 
   3.5345551563824253`*^9, 3.628786540725235*^9},
 CellLabel->
  "In[863]:=",ExpressionUUID->"c0cb35f7-65d8-4a74-bc6b-730ffea6499a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FractureStyles[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "]\nFractureLinesAndStyles[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "]\n",
 "ExtractFracturedStyledLines",
 "[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.484862609765644*^9, 3.484862623268612*^9}, {
   3.484862875651722*^9, 3.484862876211623*^9}, {3.484863748369473*^9, 
   3.48486375574601*^9}, 3.485093307403269*^9, 3.534555179095791*^9, 
   3.628786571028754*^9},ExpressionUUID->"8a3597c2-2734-4984-876b-\
193f3067d35f"],

Cell[TextData[{
 "FractureStyles[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] takes a set of styled objects (which might have been imported) and for \
any styled lists of items, it applies the style to each item in the list \
individually."
}], "Text",
 CellChangeTimes->{{3.4848626252608*^9, 3.484862694583967*^9}, {
  3.484862775210774*^9, 3.48486279068982*^9}, {3.484862871828526*^9, 
  3.484862872340359*^9}},ExpressionUUID->"683e3bdb-7a8d-4d5b-91e5-\
665876a26d19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FractureStyles", "[", "obj_", "]"}], ":=", 
  RowBox[{"obj", "/.", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"x_List", ",", "y___"}], "]"}], "\[RuleDelayed]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "y"}], "]"}], "&"}], "/@", 
      RowBox[{"Flatten", "[", "x", "]"}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.484862808450924*^9, 3.48486286987171*^9}},
 CellLabel->
  "In[864]:=",ExpressionUUID->"afa92687-a2a6-46de-a3ce-948fb2aaa101"],

Cell["Example", "Text",
 CellChangeTimes->{{3.4848629025796824`*^9, 
  3.484862903369895*^9}},ExpressionUUID->"eea86bcf-abb9-41d5-b332-\
2f3b92fe5691"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FractureStyles", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}]}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
       "Red"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
       "Green"}], "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.484862908745374*^9, 3.484862985095179*^9}, 
   3.485093329334548*^9},
 CellLabel->
  "In[865]:=",ExpressionUUID->"d4b6682e-82e7-44a0-8a8f-aa4a92e4eeec"],

Cell[TextData[{
 "FractureLinesAndStyles[",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] fractures all lines into individual segments, then applies the style of \
the original line to each segment individually. Typically used if one imports \
a hand-drawn plane graph to break it into discrete styled line segments."
}], "Text",
 CellChangeTimes->{{3.484863060151351*^9, 3.484863097205133*^9}, {
  3.484863134153973*^9, 3.484863196462573*^9}, {3.485093343068132*^9, 
