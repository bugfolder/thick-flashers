Cell["\<\
These functions are used to create tubes that are discretizations of smoothly \
curved cross sections. See TwistJoinedTubes and related functions for \
examples of their usage.\
\>", "Text",
 CellChangeTimes->{{3.671362115309487*^9, 3.67136216569562*^9}, {
  3.671363271540462*^9, 
  3.6713632761648207`*^9}},ExpressionUUID->"7d4d6da2-19e7-4303-8bb9-\
fc25ceebe686"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DiscreteCircle[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", \[Phi]]\nDiscreteCircle[",
 StyleBox["m, r",
  FontSlant->"Italic"],
 "]\nDiscreteCircle[",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.67120677810851*^9, 3.671206798262274*^9}, {
  3.671247332790125*^9, 3.671247365905121*^9}, {3.671250154136013*^9, 
  3.671250180237561*^9}},ExpressionUUID->"242376a5-bb63-4716-b2db-\
5acffad0e83d"],

Cell[TextData[{
 "DiscreteCircle[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", \[Phi]] returns a list of points giving vertices on a circle, equally \
space in angle around the origin. The circle has unit radius and passes \
through {1,0}. Arguments are:\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the number of points.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of the circle.\n\t\[Phi] \[LongDash] the phase \
offset to the first point, as a rotaiton angle counterclockwise from the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " axis.\nIt returns a list of length ",
 StyleBox["m",
  FontSlant->"Italic"],
 " of the 2D points."
}], "Text",
 CellChangeTimes->{{3.671206826064193*^9, 3.671206979669395*^9}, 
   3.67124733288958*^9, {3.671247394325535*^9, 3.671247394549221*^9}, {
   3.671250184884259*^9, 
   3.6712502070132427`*^9}},ExpressionUUID->"79dcef92-a129-4a8e-8e0c-\
2fca7e55654d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiscreteCircle", "[", 
   RowBox[{"m_", ",", 
    RowBox[{"r_", ":", "1"}], ",", " ", 
    RowBox[{"\[Phi]_", ":", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{"Cos", "[", "\[Psi]", "]"}]}], ",", 
      RowBox[{"r", " ", 
       RowBox[{"Sin", "[", "\[Psi]", "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Psi]", ",", "\[Phi]", ",", 
      RowBox[{"\[Phi]", "+", 
       RowBox[{"2", "\[Pi]"}], "-", 
       RowBox[{"2", 
        RowBox[{"\[Pi]", "/", "m"}]}]}], ",", 
      RowBox[{"2", 
       RowBox[{"\[Pi]", "/", "m"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.671205748584141*^9, 3.671205796422399*^9}, {
   3.671206316165433*^9, 3.671206399107493*^9}, {3.671207001952362*^9, 
