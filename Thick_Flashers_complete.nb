Cell[CellGroupData[{

Cell["GraphicsComplex objects", "Section",
 CellChangeTimes->{{3.708603518194127*^9, 3.708603522827447*^9}, {
  3.936461617848518*^9, 
  3.936461621313505*^9}},ExpressionUUID->"3b25ae3d-b78c-4357-938f-\
8c1b6184e37d"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.91483733064425*^9, 
  3.91483733109367*^9}},ExpressionUUID->"cd7176df-5bfc-44f8-885b-\
dffa3e0070de"],

Cell["\<\
For 3D printing, we create polyhedra as GraphicsComplex objects containing \
lists of Polygon faces. Each distinct polyhedron should be its own \
GraphicsComplex object.\
\>", "Text",
 CellChangeTimes->{{3.914837336539748*^9, 3.91483736065889*^9}, {
  3.91483765536801*^9, 
  3.9148377230708427`*^9}},ExpressionUUID->"cfe801fd-8aa9-4621-a5f6-\
76f0c44b2314"],

Cell["\<\
Note that for historical reasons, Polygon is wrapped around each individual \
polygon, rather than wrapping the list of lists. Maybe someday we\
\[CloseCurlyQuote]ll change everything to the more concise notation.\
\>", "Text",
 CellChangeTimes->{{3.922206527181014*^9, 
  3.922206572780057*^9}},ExpressionUUID->"517f2390-d973-4dbb-982d-\
7d591ed610bb"]
}, Closed]],

