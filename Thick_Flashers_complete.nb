c72fe3de9b82"],

Cell[TextData[{
 "NCurvedFoldHelix3D[",
 StyleBox["r",
  FontSlant->"Italic"],
 ", \[Theta], ",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces numeric functions that describe a fold along a helix with a \
given radius and helicity angle and specified fold angle function."
}], "Text",
 CellChangeTimes->{{3.799744730965797*^9, 3.799744763128796*^9}, 
   3.799748782213584*^9, {3.799750949322859*^9, 3.799750956281792*^9}, {
