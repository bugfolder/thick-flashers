Cell[TextData[{
 "FoldGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph and a set of fold angles ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " for each edge, and returns a TGraph3D with a new set of 3D Vertices that \
specifies the new 3D form according to those fold angles. "
}], "Text",
 CellChangeTimes->{{3.591645445064088*^9, 3.591645445376114*^9}, {
   3.591819345104248*^9, 3.591819413139563*^9}, 3.591981352311344*^9, {
