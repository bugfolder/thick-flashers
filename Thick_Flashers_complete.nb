Cell[TextData[{
 "FlasherDefaultCPRules[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.5557504413095713`*^9, 3.555750467627557*^9}, {
   3.555750552830645*^9, 3.555750556661257*^9}, {3.555758437688859*^9, 
