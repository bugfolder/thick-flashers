Cell[CellGroupData[{

Cell[TextData[{
 "MoselyBudCrossSectionPt[",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.651865305205954*^9, 3.651865321413595*^9}, {
  3.651865441229385*^9, 
  3.651865446214348*^9}},ExpressionUUID->"e792da39-5764-458f-be3a-\
f68077cc3577"],

Cell[TextData[{
 "MoselyBudCrossSectionPt[",
 StyleBox["r",
  FontSlant->"Italic"],
 "] returns the cross section point {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z",
  FontSlant->"Italic"],
 "} for a distance ",
 StyleBox["r",
  FontSlant->"Italic"],
 " along the surface, where ",
 StyleBox["r",
  FontSlant->"Italic"],
 "\[Element][0, 1]."
}], "Text",
 CellChangeTimes->{{3.651865268904314*^9, 3.651865339388589*^9}, {
  3.651865452347281*^9, 3.651865496131926*^9}, {3.651866349430581*^9, 
  3.651866356395671*^9}},ExpressionUUID->"59de41c7-b207-44d3-aa6a-\
5fb98037a45e"],

Cell["\<\
This is used to recreate the Mosely Bud rotational solid from a set of cross \
section points. This comes from analytic analysis of the Bud crease pattern \
where we assume perfectly circular arcs for the gores.\
\>", "Text",
 CellChangeTimes->{{3.651865497768113*^9, 3.651865512617599*^9}, {
  3.651866263051237*^9, 
  3.651866280865467*^9}},ExpressionUUID->"516e5c43-0abc-4ec1-a1b5-\
583b4a84589f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MoselyBudCrossSectionPt", "[", "r_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{"r", "\[Equal]", "0"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"r", "\[Equal]", "1"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"EllipticK", "[", 
           RowBox[{
            RowBox[{"-", "4"}], " ", 
            RowBox[{"(", 
             RowBox[{"4", "+", 
              RowBox[{"3", " ", 
               SqrtBox["2"]}]}], ")"}]}], "]"}]}], "+", 
         RowBox[{"Im", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              SqrtBox["2"]}], ")"}]}], " ", 
           RowBox[{"EllipticE", "[", 
            RowBox[{"17", "+", 
             RowBox[{"12", " ", 
              SqrtBox["2"]}]}], "]"}]}], "]"}]}], 
        SqrtBox["2"]]}]}], "}"}], ",", "\[IndentingNewLine]", "True", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"4", " ", "r"}], "-", 
           RowBox[{"4", " ", 
            SuperscriptBox["r", "2"]}]}]]}], ")"}]}], ",", 
      RowBox[{"Re", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "r"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SqrtBox["2"]}], ")"}], " ", 
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "r"}], 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           RowBox[{"8", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "r"}]}]]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SqrtBox["2"]}], ")"}], " ", "r", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"4", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "r"}], ")"}], " ", "r"}]}], ")"}]}], 
          "-", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "r"}], ")"}], "2"], " ", 
           SqrtBox[
            FractionBox[
             RowBox[{"r", "+", 
              RowBox[{"4", " ", 
               SuperscriptBox["r", "2"]}], "-", 
              RowBox[{"4", " ", 
               SuperscriptBox["r", "3"]}]}], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "r"}], ")"}], "3"]]], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"EllipticE", "[", 
              RowBox[{
               RowBox[{"ArcSin", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", 
                   SqrtBox["2"]}], ")"}], " ", 
                 SqrtBox[
                  FractionBox["r", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", "r"}]]]}], "]"}], ",", 
               RowBox[{"17", "+", 
                RowBox[{"12", " ", 
                 SqrtBox["2"]}]}]}], "]"}], "+", 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                SqrtBox["2"]}], ")"}], " ", 
              RowBox[{"EllipticF", "[", 
               RowBox[{
                RowBox[{"ArcSin", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    SqrtBox["2"]}], ")"}], " ", 
                  SqrtBox[
                   FractionBox["r", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "r"}]]]}], "]"}], ",", 
                RowBox[{"17", "+", 
                 RowBox[{"12", " ", 
                  SqrtBox["2"]}]}]}], "]"}]}]}], ")"}]}]}], ")"}]}], "]"}]}], 
     "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.651865518736114*^9, 3.651865602152368*^9}, {
   3.651865739032193*^9, 3.651865759799393*^9}, 3.6518661510831337`*^9, {
   3.65186651448606*^9, 3.651866520179919*^9}},
 CellLabel->
  "In[3453]:=",ExpressionUUID->"f126106d-f518-4940-a455-cdb286e35f11"],

Cell["Example", "Text",
 CellChangeTimes->{{3.651865615714481*^9, 
  3.651865616451474*^9}},ExpressionUUID->"5b3dac81-6849-41ca-8088-\
052953aaf905"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MoselyBudCrossSectionPt", "[", "r", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "1", ",", 
          RowBox[{"1", "/", "50"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Line", "[", "pts", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Line", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], "#"}], "&"}], "/@", 
           "pts"}], "]"}]}], "}"}], ",", 
