Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledRuledPatch", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"RulingLineDivisions", "\[Rule]", "10"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"RulingLineOffset", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"RulingLineStyle", "\[Rule]", "UndefinedRulingLine"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"EndLineStyle", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"CurveDivisions", "\[Rule]", "100"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.688080727393713*^9, 3.688080775001614*^9}, {
   3.68808103490412*^9, 3.68808106222935*^9}, {3.688081094246439*^9, 
   3.688081098994981*^9}, {3.688081322848273*^9, 3.68808134028588*^9}, {
   3.688082195150844*^9, 3.688082195646844*^9}, 3.689247677495178*^9, 
   3.689274355329221*^9, {3.689278291702242*^9, 3.689278293351124*^9}, {
   3.689278933849518*^9, 3.68927894175558*^9}, 3.68985458563757*^9, {
