Cell["\<\
These functions take a TObj containing primal-dual graph data and turn that \
into a pair of edge-labeled plane graphs that correspond to the crease \
pattern and folded form.\
\>", "Text",
 CellChangeTimes->{{3.533599385162688*^9, 3.533599463421978*^9}, {
   3.5922426280853863`*^9, 3.592242637082288*^9}, 
   3.5924357627016897`*^9},ExpressionUUID->"aba09685-4b30-459a-b4d7-\
ef220e752dc2"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ScaleAndTwistPoint[",
 StyleBox["pt, ctr",
  FontSlant->"Italic"],
 ", \[Rho], \[Beta]]"
}], "Subsubsection",
 CellChangeTimes->{
  3.456327997593176*^9, {3.456328499726954*^9, 3.4563285092796283`*^9}, 
   3.456328544404461*^9, {3.461759813838145*^9, 3.461759829106896*^9}, 
   3.461761277862843*^9, {3.46591187706226*^9, 3.465911880996838*^9}, 
   3.465915315942519*^9, {3.4659153615268593`*^9, 3.465915382716785*^9}, {
   3.465915507749318*^9, 3.46591551062934*^9}, {3.465915616493277*^9, 
   3.465915616996868*^9}, {3.46591573029563*^9, 3.465915732660185*^9}, 
   3.465923436845531*^9},ExpressionUUID->"9b04c293-ba0e-405a-a30c-\
c9375039e5f2"],

Cell[TextData[{
 "ScaleAndTwistPoint",
 "[",
 StyleBox["pt",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ", \[Rho], \[Beta]] takes the point ",
 StyleBox["pt",
  FontSlant->"Italic"],
 ", scales it toward/away from ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 " by a factor \[Rho], and rotates it about ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 " through the CCW angle \[Beta]."
}], "Text",
 CellChangeTimes->{{3.465915562912426*^9, 3.4659156318999853`*^9}, 
   3.465915740366823*^9},ExpressionUUID->"5e5decdd-7f79-4116-bb1d-\
58e248f9e17a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ScaleAndTwistPoint", "[", 
   RowBox[{"pt_", ",", "ctr_", ",", "\[Rho]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"ctr", "+", 
   RowBox[{"\[Rho]", " ", 
    RowBox[{
     RowBox[{"RotationMatrix2D", "[", "\[Beta]", "]"}], ".", 
     RowBox[{"(", 
      RowBox[{"pt", "-", "ctr"}], ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.461759746286322*^9, 3.461759779029521*^9}, {
   3.46591188440821*^9, 3.465911899239706*^9}, 3.4659153159698467`*^9, {
   3.46591545465313*^9, 3.465915465852618*^9}, 3.465915650969449*^9, 
   3.68816696311071*^9},
 CellLabel->
  "In[3338]:=",ExpressionUUID->"64dbf2c2-54d2-43b3-aa91-eafadcffff5f"],

