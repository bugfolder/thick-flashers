2ebfbfe7e457"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NCurveSpeed", "[", 
   RowBox[{
    RowBox[{"c_Function", "|", "c_InterpolatingFunction"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", " ", "u1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "dc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FunctionInterpolationAlt", "[", 
      RowBox[{
       RowBox[{"Mag", "[", 
        RowBox[{"dc", "[", "s", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.6915986842087727`*^9, 3.691598695677492*^9}, {
   3.691598790376235*^9, 3.691598825908568*^9}, {3.799522882417832*^9, 
