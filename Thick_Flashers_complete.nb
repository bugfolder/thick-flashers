Cell[CellGroupData[{

Cell[TextData[{
 "MakeTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 "}]\nMakeTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}]\nMakeTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2, d3, d4",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}]\n\t(checked classes) TVertex"
}], "Subsubsection",
 CellChangeTimes->{{3.642431796579179*^9, 3.642431812560408*^9}, 
   3.6424330206914887`*^9, {3.642434711085169*^9, 3.642434721937063*^9}, {
   3.64253521746945*^9, 3.642535218086331*^9}, {3.643241191178537*^9, 
   3.643241192551291*^9}, {3.701379368476501*^9, 3.70137936916439*^9}, 
   3.701379485549728*^9},ExpressionUUID->"a006e683-41e3-4c31-ae39-\
851085e974c2"],

Cell[TextData[{
 "MakeTMiuraMarsOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 "}] takes a degree-4 TVertex representing a vertex and two lists of \
distances ",
 StyleBox["dilst1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 ", and creates a TMiuraMarsOri representing a Miura-ori or Barreto \
\[OpenCurlyQuote]Mars\[CloseCurlyQuote] with distances ",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 " along the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], "-", 
    SubscriptBox["\[Gamma]", "3"]}], TraditionalForm]],ExpressionUUID->
  "59ab4a7d-7553-4076-b488-6464c8c2cb99"],
 " chain and distances ",
 StyleBox["dlst2",
  FontSlant->"Italic"],
 " along the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "2"], "-", 
    SubscriptBox["\[Gamma]", "4"]}], TraditionalForm]],ExpressionUUID->
  "8b2cb1a4-1494-4dd5-b498-604659e9f71c"],
 " chain. The TVertex ",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 " needs to be in standard position (i.e., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "2bad1340-4e77-4503-bd73-6c344d28b686"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "3"], TraditionalForm]],ExpressionUUID->
  "b71ea09a-606b-4259-ab59-b6a21973fd27"],
 " are minor); its sector and dihedral angles need to be consistent; it needs \
to be flat-foldable; and it needs to have mirror-symmetry, so that one of the \
following is true: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], "\[Equal]", 
    SubscriptBox["\[Alpha]", "4"]}], TraditionalForm]],ExpressionUUID->
  "a514504f-9e4e-472a-b79d-d370f65aed8a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], "\[Equal]", 
    SubscriptBox["\[Alpha]", "3"], "\[Equal]", 
    RowBox[{"90", "\[Degree]"}]}], TraditionalForm]],ExpressionUUID->
  "af67e0db-4f10-4ed7-840c-fb6033bd3a14"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "2"], "\[Equal]", 
    SubscriptBox["\[Alpha]", "4"], "\[Equal]", 
    RowBox[{"90", "\[Degree]"}]}], TraditionalForm]],ExpressionUUID->
  "12edb947-5edc-480f-9ec1-7c0bf6fe8453"],
 "."
}], "Text",
 CellChangeTimes->{{3.442882672893553*^9, 3.4428828116669903`*^9}, {
   3.4429714489772468`*^9, 3.4429714526062803`*^9}, {3.443015737240294*^9, 
   3.443015886482121*^9}, {3.4430175708891*^9, 3.4430176693597517`*^9}, 
   3.443220653198539*^9, {3.443220689660924*^9, 3.4432207392757607`*^9}, {
   3.443221309867934*^9, 3.4432213362789187`*^9}, {3.59208444067141*^9, 
   3.592084496129277*^9}, 3.592435758332773*^9, {3.592439012815792*^9, 
