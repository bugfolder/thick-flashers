Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherDefaultFFProjectionRules[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.911583270300634*^9, 3.911583312197386*^9}, {
   3.911583343562877*^9, 3.911583344732511*^9}, {3.9115834672259417`*^9, 
   3.911583490907662*^9}, 3.9115843382444887`*^9, 
   3.911902749995224*^9},ExpressionUUID->"398ebef2-944b-4150-819b-\
d6481626b455"],

Cell[TextData[{
 "ThickFlasherDefaultFFProjectionRules[",
 StyleBox["p, r, h, m, t",
  FontSlant->"Italic"],
 "] returns a rule that maps any vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"751ff4d9-6a88-45b1-bd87-a4e397100f9b"],
 " to its theoretically ideal position in the Folded Form Projection (FFP) \
for rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.911583299555171*^9, 3.9115833089150457`*^9}, {
   3.911583353677216*^9, 3.91158335510524*^9}, {3.911583484371084*^9, 
   3.91158352507426*^9}, {3.91158434104525*^9, 3.911584361193976*^9}, {
   3.911815862106382*^9, 3.911815880782441*^9}, 
   3.9119027500200853`*^9},ExpressionUUID->"ba543cce-6ea2-4532-8855-\
d49c3ce17fcb"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the variable to use.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the number of rings.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational index.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the desired panel thickness."
}], "Text",
 CellChangeTimes->{{3.91158331950962*^9, 3.911583328331612*^9}, {
   3.911583370203165*^9, 3.911583430988226*^9}, 3.9115835161208963`*^9, 
   3.91158434246274*^9},ExpressionUUID->"c11697a4-9ca7-4b60-a563-\
b3bddc01134e"],

Cell["\<\
Returns: a list of rules that gives the vertex positions in the folded form \
projection (view from the top of the folded form) for the default \
configuration.\
\>", "Text",
 CellChangeTimes->{{3.911583432765998*^9, 3.911583438582089*^9}, {
  3.9115835306550813`*^9, 3.911583603218736*^9}, {3.911646365443915*^9, 
  3.911646366634304*^9}},ExpressionUUID->"ea810ad0-3f95-4a02-84bf-\
fdc70758b93b"],

Cell["\<\
Note that the default here is not exactly uniform-thickness, but is close and \
will be used as the starting point when we calculate the exact positions with \
small corrections.\
\>", "Text",
 CellChangeTimes->{{3.9116463693952904`*^9, 3.911646384426009*^9}, {
  3.913542753461098*^9, 
  3.913542760210747*^9}},ExpressionUUID->"18065622-d540-4d03-8e65-\
61a61bc396b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherDefaultFFProjectionRules", "[", 
   RowBox[{"p_", ",", 
    StyleBox["r_",
     FontSlant->"Italic"], ",", 
    StyleBox["h_",
     FontSlant->"Italic"], ",", 
    StyleBox["m_",
     FontSlant->"Italic"], ",", 
    StyleBox["t_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fssro", ",", "fssrof", ",", "radfn", ",", "rotfn", ",", "rules", ",", 
      "q"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Get", " ", "the", " ", "structure", " ", "of", " ", "the", " ", "first",
       " ", "sector"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fssro", "=", 
      RowBox[{"FlasherSectorVerticesRadiallyOrdered", "[", 
       RowBox[{"p", ",", "r", ",", "h"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Flatten", " ", "to", " ", "get", " ", "a", " ", "radially", " ", 
       "ordered", " ", "list", " ", "of", " ", "the", " ", 
       RowBox[{"vertices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fssrof", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"fssro", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rotfn", " ", "takes", " ", "a", " ", "subscripted", " ", "variable", " ",
        "and", " ", "returns", " ", "its", " ", "rotational", " ", 
       RowBox[{"increment", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rotfn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"fssro", ",", "#"}], "]"}], "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "radfn", " ", "takes", " ", "a", " ", "subscripted", " ", "variable", " ",
        "and", " ", "returns", " ", "its", " ", "discrete", " ", "radial", " ",
        "distance"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"radfn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"fssrof", ",", "#"}], "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}], 
       "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "rules", " ", "that", " ", "define", " ", "the", " ", 
       "vertices", " ", "of", " ", "the", " ", "first", " ", 
       RowBox[{"sector", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rules", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "->", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", 
             RowBox[{"t", " ", 
              RowBox[{"radfn", "[", "#", "]"}]}]}], ")"}], 
           RowBox[{
            RowBox[{"FlasherRotation2D", "[", " ", 
             RowBox[{
              RowBox[{"rotfn", "[", "#", "]"}], ",", "m"}], "]"}], ".", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"Tan", "[", 
               FractionBox["\[Pi]", "m"], "]"}]}], "}"}]}]}]}], ")"}], "&"}], 
       "/@", "fssrof"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"From", " ", "these"}], ",", " ", 
       RowBox[{
       "construct", " ", "rules", " ", "for", " ", "the", " ", "remaining", " ", 
        RowBox[{"sectors", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"rules", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["p", 
              RowBox[{"i_", ",", "j_", ",", "k_"}]], "->", "q_"}], ")"}], "->", 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["p", 
              RowBox[{"i", ",", "j", ",", 
               RowBox[{"k", "+", "l"}]}]], "->", 
             RowBox[{
              RowBox[{"FlasherRotation2D", "[", " ", 
               RowBox[{"l", ",", "m"}], "]"}], ".", "q"}]}], ")"}]}], "}"}]}],
         ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "//", "Flatten"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.911583610518064*^9, 3.911583668819497*^9}, {
   3.91158371018696*^9, 3.9115837814341593`*^9}, 3.9115843308230553`*^9, {
   3.911584379510818*^9, 3.911584423915197*^9}, {3.911584463933051*^9, 
   3.9115845703597097`*^9}, {3.911585050549712*^9, 3.911585183702668*^9}, {
   3.911585219349104*^9, 3.911585230812052*^9}, {3.91158648515888*^9, 
   3.911586545225703*^9}, {3.9115866035696774`*^9, 3.911586613716531*^9}, {
   3.911586773156148*^9, 3.911586871682073*^9}, {3.9115978787542887`*^9, 
   3.911597922640194*^9}, {3.911598288103033*^9, 3.911598350782412*^9}, {
   3.9115984225379677`*^9, 3.911598422964205*^9}, 3.9115984552786627`*^9, {
   3.9115985238124027`*^9, 3.911598535446001*^9}, {3.911598577994092*^9, 
   3.911598615525719*^9}, {3.911643549481812*^9, 3.911643569377105*^9}, {
   3.9116436270253363`*^9, 3.911643767116366*^9}, {3.911643841214734*^9, 
   3.911643864341762*^9}, {3.911644229277009*^9, 3.911644273011176*^9}, {
