a7e0f6b66d62"],

Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherTrimTrianglePanels[",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PanelMinThickness"
}], "Subsubsection",
 CellChangeTimes->{{3.922557628219519*^9, 3.92255764678004*^9}, {
   3.922557850229174*^9, 3.9225578511407824`*^9}, {3.923907318519951*^9, 
   3.923907340209713*^9}, {3.926582389237252*^9, 3.926582392402144*^9}, {
   3.933444159936247*^9, 3.933444211437934*^9}, {3.933511991708323*^9, 
   3.933511993014159*^9}, {3.933512890845071*^9, 3.933512902555705*^9}, 
   3.933517595475647*^9, {3.933598874541741*^9, 3.933598887064516*^9}, 
   3.933598996182753*^9, 
   3.933609272091156*^9},ExpressionUUID->"30489140-bca4-4c6e-9882-\
06a198206833"],

Cell[TextData[{
 "ThickFlasherTrimTrianglePanels[",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] trims off the tips of the triangle panels of a flasher (produced by \
MakeThickFlasherPanels) so that the remaining panel respects a specified \
minimum thickness."
}], "Text",
 CellChangeTimes->{{3.922557662542322*^9, 3.92255769705266*^9}, {
   3.9225577296773*^9, 3.922557741515873*^9}, 3.9225581771060038`*^9, {
   3.9334441890583153`*^9, 3.93344424495977*^9}, {3.933512586189475*^9, 
   3.933512601806058*^9}, 
   3.933517595480914*^9},ExpressionUUID->"9009660d-38e5-4306-9252-\
9b4720d5d9fa"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["panels",
  FontSlant->"Italic"],
 " \[LongDash] the list of panels typically scaled to real-world dimensions;\n\
\t",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " \[LongDash] a structured list of index information described below.\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TGraph3DAssigned that describes the embedded zero-thickness \
surface."
}], "Text",
 CellChangeTimes->{{3.911994124360935*^9, 3.911994261392596*^9}, {
  3.912005424921616*^9, 3.912005481584758*^9}, {3.913296349143371*^9, 
