Cell[CellGroupData[{

Cell["Ribbon pair functions", "Subsection",
 CellChangeTimes->{{3.799406556356549*^9, 3.799406561679494*^9}, 
   3.799415810474408*^9, {3.801769977374895*^9, 
   3.801769977909938*^9}},ExpressionUUID->"1cdcc8b7-0698-4db8-b803-\
1571f2dabf29"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.799420838121582*^9, 
  3.799420838674292*^9}},ExpressionUUID->"86c210af-bcdf-4e88-9f7a-\
11cedbba87f6"],

Cell["\<\
These functions return descriptions of ribbons as unoriented ruled \
parameterizations {b, d}. We don\[CloseCurlyQuote]t include explicit \
orientation because (a) these are just used as illustrative examples, and (b) \
that allows us to avoid the Abs and Sign that would be needed to be included \
to compute the right ruling and and give the corresponding sign of the \
director.\
\>", "Text",
 CellChangeTimes->{{3.799420840385542*^9, 
  3.799420928339141*^9}},ExpressionUUID->"13cd9f0d-b28a-41fe-962c-\
60e40fc2027f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RibbonPair[c",
 StyleBox["c",
  FontSlant->"Italic"],
 ", \[Eta], \[Sigma], {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{{3.799406714691597*^9, 3.79940676044363*^9}, {
   3.799406976095245*^9, 3.799406977181387*^9}, 3.799411190316635*^9, 
   3.800224775378436*^9, 3.800224883772409*^9, {3.8002259651854753`*^9, 
   3.800225966275325*^9}, 
   3.800461240311284*^9},ExpressionUUID->"2058af04-c044-457c-b8f2-\
351e6ca846f3"],

Cell[TextData[{
 "RibbonPair[",
 StyleBox["cc",
  FontSlant->"Italic"],
 ", \[Eta], \[Sigma], {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a space curve and a Frenet-Darboux angle and constructs a \
description of the ribbon in 2D and 3D as ruled parameterizations."
}], "Text",
 CellChangeTimes->{{3.6911793385151*^9, 3.691179369234579*^9}, {
   3.6911794065779657`*^9, 3.6911794118180437`*^9}, 3.69118396000724*^9, {
   3.691254096384046*^9, 3.691254102719228*^9}, {3.691254134826373*^9, 
   3.6912541756164293`*^9}, {3.691264560467979*^9, 3.69126456409388*^9}, 
   3.691494661333639*^9, 3.691574316295662*^9, {3.7994067937046423`*^9, 
   3.799406795976451*^9}, {3.799406972604635*^9, 3.7994069731945133`*^9}, 
   3.799411190328796*^9, 3.800224775400592*^9, 3.8002248837857327`*^9, {
   3.800226000512266*^9, 3.800226001611884*^9}, 
   3.8004611694428463`*^9},ExpressionUUID->"8490b0fc-4e68-413a-b9f3-\
3db403cb36f7"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["cc",
  FontSlant->"Italic"],
 " \[LongDash] a vector-valued pure function that specifies the \
arbitrary-speed (3D) space curve.\n\t\[Eta] \[LongDash] a pure function that \
specifies the desired Frenet-Darboux angle along the curve.\n\t\[Sigma] \
\[LongDash] the desired orientation of the resulting ruled parameterization.\n\
\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial parameter value of the curve.\n\t",
 StyleBox["ci",
  FontSlant->"Italic"],
 " \[LongDash] the initial position of the 2D curve.\n\t",
 StyleBox["ti",
  FontSlant->"Italic"],
 " \[LongDash] the initial tangent vector ofthe 2D curve."
}], "Text",
 CellChangeTimes->{{3.691240898992137*^9, 3.6912409026451073`*^9}, {
   3.691254200787434*^9, 3.69125422357312*^9}, {3.691264654532205*^9, 
   3.691264656498825*^9}, 3.691574318940676*^9, {3.799406845784048*^9, 
   3.799406878001278*^9}, {3.799406981617875*^9, 3.7994069906323*^9}, {
   3.800226008244812*^9, 
   3.800226021418859*^9}},ExpressionUUID->"b438af10-00f1-48fd-97f5-\
2c9ba46e3e19"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify.\n\t\
Options[DSolve] are passed through."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.6919201694518843`*^9, 
   3.691920213331407*^9}, {3.691920316765493*^9, 3.691920317853144*^9}, 
   3.691921637527274*^9, 3.691921671866543*^9, {3.799413152668096*^9, 
   3.799413164443265*^9}},ExpressionUUID->"f6cecda3-199a-4873-9f32-\
7fd0105a2076"],

Cell[TextData[{
 "Returns a list {b, ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 "} giving the ruled parameterization in 2D and 3D."
}], "Text",
 CellChangeTimes->{{3.691254178053851*^9, 3.691254193095383*^9}, {
   3.7994068892774076`*^9, 3.799406929450653*^9}, 3.7994102136795588`*^9, {
   3.799411054421214*^9, 3.799411147733104*^9}, {3.799413205291456*^9, 
   3.7994132070275183`*^9}, {3.800226065051693*^9, 
   3.800226117349154*^9}},ExpressionUUID->"e822463d-2eee-44ca-ba2a-\
ad80a166f1f3"],

Cell["\<\
Note, too, that since the Frenet frame is undefined at inflection points \
(zero curvature), this function will not return a meaningful result at an \
inflection point.\
\>", "Text",
 CellChangeTimes->{{3.799411231098589*^9, 3.7994112914696918`*^9}, {
  3.800226142234764*^9, 
  3.800226142356126*^9}},ExpressionUUID->"8e4cfb3b-4108-4855-907e-\
e27aca80566a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RibbonPair", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.68980816965057*^9, 3.689808183674678*^9}, 
   3.689848577039259*^9, 3.690988493972368*^9, 3.691179503122077*^9, 
   3.691183960021525*^9, 3.691254300095761*^9, 3.799411190336383*^9, 
   3.800224775416438*^9, 3.80022488378999*^9, 3.800461169454628*^9},
 CellLabel->
  "In[3849]:=",ExpressionUUID->"d9039ddf-f990-4e2e-a186-cfe34e1c6945"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "RibbonPair", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.8002260245215397`*^9, 3.800226033017886*^9}, 
   3.800461169460833*^9},
 CellLabel->
  "In[3850]:=",ExpressionUUID->"acb42437-4eaf-4bd7-84d4-f4c5262be918"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RibbonPair", "[", 
   RowBox[{"cc_Function", ",", "\[Eta]_Function", ",", "\[Sigma]_", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "ci_List", ",", "ti_List"}], "}"}], ",", "opts___"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "csys3d", ",", "ds", ",", 
      "tt", ",", "nn", ",", "bb", ",", "ll", ",", "uu", ",", "duu", ",", "c", 
      ",", "t", ",", "l", ",", "u", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", 
      "dd", ",", "\[Kappa]l", ",", "csys2d", ",", "d"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RibbonPair", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RibbonPair", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"csys3d", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"cc", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
         "BinormalVector3D"}], "}"}], "/.", "csys3d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ll", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "-", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "+", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"uu", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"duu", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
          RowBox[{"Mag", "[", 
           RowBox[{"duu", "[", "s", "]"}], "]"}]], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sign", "[", 
            RowBox[{
             RowBox[{"duu", "[", "s", "]"}], ".", 
             RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
          FractionBox[
           RowBox[{
            RowBox[{"duu", "[", "s", "]"}], ".", 
            RowBox[{"ll", "[", "s", "]"}]}], 
           RowBox[{"Mag", "[", 
            RowBox[{"duu", "[", "s", "]"}], "]"}]]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
             RowBox[{"tt", "[", "s", "]"}]}], "+", 
            RowBox[{
             RowBox[{"s\[Rho]L", " ", "[", "s", "]"}], 
             RowBox[{"ll", "[", "s", "]"}]}]}], ")"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ll", "[", "s", "]"}], ".", 
           RowBox[{
            RowBox[{"tt", "'"}], "[", "s", "]"}]}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csys2d", "=", 
      RowBox[{"RecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "ci", ",", "ti"}], "}"}], ",", "opts"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Curve2D", ",", "TangentVector2D", ",", "LeftNormalVector2D"}], "}"}],
        "/.", "csys2d"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
             RowBox[{"t", "[", "s", "]"}]}], "+", 
            RowBox[{
             RowBox[{"s\[Rho]L", "[", "s", "]"}], " ", 
             RowBox[{"l", "[", "s", "]"}]}]}], ")"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d", ",", "cc", ",", "dd"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.691179465021373*^9, 3.691179485529024*^9}, {
   3.691179657092484*^9, 3.691179841718819*^9}, {3.691179888015651*^9, 
   3.69118021296799*^9}, {3.691181155643717*^9, 3.691181165941036*^9}, {
   3.691181574098461*^9, 3.691181796934353*^9}, {3.691181948917424*^9, 
   3.691181976198375*^9}, {3.691182006799476*^9, 3.691182088146709*^9}, 
   3.691182773737981*^9, {3.691183960039689*^9, 3.691183960050613*^9}, {
   3.691184001089801*^9, 3.691184047970283*^9}, {3.691184384617652*^9, 
   3.691184389790749*^9}, 3.691184467327611*^9, {3.691234450611058*^9, 
   3.691234470345407*^9}, 3.69125261363089*^9, 3.691252690956533*^9, {
   3.691254329611453*^9, 3.691254344256206*^9}, {3.691254458421863*^9, 
   3.691254665607929*^9}, {3.691254700927834*^9, 3.691254712714005*^9}, {
   3.691255029302941*^9, 3.691255108548916*^9}, {3.69125515295372*^9, 
   3.69125517773921*^9}, {3.691255390660026*^9, 3.691255391508385*^9}, {
   3.691258824318758*^9, 3.691258854054582*^9}, {3.691495205443649*^9, 
   3.691495213329231*^9}, {3.69149532090209*^9, 3.691495330336244*^9}, 
   3.691505297008376*^9, {3.691542009349243*^9, 3.69154200936982*^9}, 
   3.691574344209778*^9, {3.691574391386071*^9, 3.691574418840687*^9}, {
   3.691574464628807*^9, 3.691574487543885*^9}, {3.691578266127338*^9, 
   3.691578266505195*^9}, {3.6915788545760603`*^9, 3.691578910480173*^9}, {
   3.692445623190518*^9, 3.692445724355478*^9}, {3.692445784836545*^9, 
