Cell["Convenience classes only have Make constructors.", "Text",
 CellChangeTimes->{{3.592854477521141*^9, 
  3.592854496744073*^9}},ExpressionUUID->"b1c310b3-7a2a-4514-81e9-\
fa9294390d37"],

Cell[TextData[{
 "MakeTGraph2DAssigned[",
 StyleBox["verts, edges, faces, verts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] takes a TGraph and returns an TGraph2DAssigned with Vertices2D defined by \
",
 StyleBox["verts2d and ",
  FontSlant->"Italic"],
 "EdgeTypes given by ",
 StyleBox["types",
  FontSlant->"Italic"],
 ". If no ",
 StyleBox["verts2d",
  FontSlant->"Italic"],
 " are given, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " is used. If no ",
 StyleBox["types",
  FontSlant->"Italic"],
 " are given, U is assumed."
}], "Text",
 CellChangeTimes->{{3.592422276207472*^9, 3.592422281420859*^9}, {
   3.592422323898386*^9, 3.592422352423834*^9}, {3.592422473536278*^9, 
