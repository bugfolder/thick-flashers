   RowBox[{"FoldVectors", "::", "usage"}], 
   "=", "\"\<FoldVectors is a TObj property that specifies the 3D vectors \
along the folds around a vertex in the folded form.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592075703941037*^9, 3.592075759060974*^9}, {
