   3.688080670639664*^9}},ExpressionUUID->"299a2d04-f89e-4f3c-8160-\
ee48d0bd6399"],

Cell["\<\
Changes for version 2.5d2 (ma10)
Add haversine functions Hav, ArcHav.
Add some trig identity checking.\
\>", "Text",
 CellChangeTimes->{{3.636743054393755*^9, 3.636743059033929*^9}, {
   3.636743090599424*^9, 3.636743117974497*^9}, 3.64236138113542*^9, {
