   3.719941460855174*^9}, {3.719941714920814*^9, 3.719941787046275*^9}, 
   3.7199421415348063`*^9, 3.719946418452291*^9, {3.8256114436889067`*^9, 
   3.825611459744749*^9}, {3.8256128139638*^9, 3.825612868306691*^9}, {
   3.825613119149046*^9, 3.825613122779771*^9}, {3.825613577305903*^9, 
