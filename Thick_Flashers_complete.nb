             RowBox[{"StyledGenericFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropLast", "/@", 
             RowBox[{"{", 
              RowBox[{"d3", ",", "e3", ",", 
               RowBox[{"-", "an"}]}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledGenericFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropLast", "/@", 
             RowBox[{"{", 
              RowBox[{"e3", ",", "g3", ",", "an"}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"c3", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"d3", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"e3", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"g3", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], "]"}],
             ",", "BorderLine"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
        
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RotateZ3D", "[", 
           RowBox[{
            RowBox[{
            "ffw", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"2", "i", " ", "\[Phi]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MakeTDisplayPair", "[", 
       RowBox[{"cp", ",", "ff"}], "]"}], "//", 
      RowBox[{"AddClass", "[", 
       RowBox[{"TRotationalPot", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CrossSection", "\[Rule]", "cs"}], ",", 
          RowBox[{"CreasePatternWedge", "\[Rule]", "cpw"}], ",", 
          RowBox[{"CreasePatternSplitWedge", "\[Rule]", "cpsw"}], ",", 
          RowBox[{"FoldedFormWedge", "\[Rule]", "ffw"}], ",", 
          RowBox[{"FoldedFormSplitWedge", "\[Rule]", "ffsw"}]}], "}"}]}], 
       "]"}]}]}]}], "]"}]}]], "Input",
