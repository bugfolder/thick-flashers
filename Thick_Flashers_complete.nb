  FontSlant->"Italic"],
 "]\n\t(options) NormalVectorLength, GridDivisions, SurfaceColorFunction, \
Options[StyledVector]"
}], "Subsubsection",
 CellChangeTimes->{{3.69128243259626*^9, 3.69128249555287*^9}, {
