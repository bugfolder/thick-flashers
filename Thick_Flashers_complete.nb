Cell[CellGroupData[{

Cell["Penrose rhomb tilings", "Subsection",
 CellChangeTimes->{{3.551726616134742*^9, 3.551726629915523*^9}, 
   3.551745604483778*^9, {3.551747545545938*^9, 
   3.5517475457302628`*^9}},ExpressionUUID->"592a99a6-cc8a-41ac-ac89-\
480ef4558580"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.5517361250533113`*^9, 
  3.55173612548337*^9}},ExpressionUUID->"e77e3af9-799f-44f3-9fd6-\
bded98ca53a6"],

Cell["\<\
Penrose rhomb tilings lend themselves to primal-dual tessellations because \
they possess a reciprocal diagram whose vertices can be readily calculated. \
Penrose rhomb tilings can be constructed by an operation called deflation \
that acts on triangles, pairs of which make the rhombs. When you deflate an \
initial set, you will typically be left with some half-rhombs on the border \
of the pattern. In our case, we will keep those triangles (which have their \
own dual vertices) so that the resulting tiling has a smooth border. You can, \
if you like, prune them away.\
\>", "Text",
 CellChangeTimes->{{3.55174543862304*^9, 
  3.551745594931888*^9}},ExpressionUUID->"84659b0f-8a6c-4a8a-9336-\
fc0a9726c513"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakePenroseRhombTilingPrimalDualGraph[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t",
 "(options)",
 " PenroseBorderTriangles"
}], "Subsubsection",
 CellChangeTimes->{{3.5517361294349737`*^9, 3.55173621243134*^9}, {
   3.551736253253764*^9, 3.5517362552607803`*^9}, 3.551739460713511*^9, {
   3.5517453803812323`*^9, 3.55174538209864*^9}, 3.592522796556589*^9, 
   3.592522837726104*^9, 3.592522902022711*^9, 3.59282881147149*^9, 
   3.594072175301152*^9, 
   3.594732525532043*^9},ExpressionUUID->"e4f73b17-72eb-4dbf-a265-\
06ce22684c3d"],

Cell[TextData[{
 "MakePenroseRhombTilingPrimalDualGraph",
 "[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the plane graph data describing a Penrose rhomb tiling that is \
created by deflating either a Sun or Star (thereby always giving a rhomb, \
rather than a kite-dart, tiling). ",
 StyleBox["n",
  FontSlant->"Italic"],
 "=0 starts with a Star; ",
 StyleBox["n",
  FontSlant->"Italic"],
 "=1 starts with a Sun. Options are:\n\tBorderTriangles\[Rule]True | False, \
specifies whether to include half-rhombs on the border (gives a smoother \
outline)."
}], "Text",
 CellChangeTimes->{{3.551736261684518*^9, 3.551736286650482*^9}, {
   3.551736319396452*^9, 3.551736431161668*^9}, {3.5517371448605013`*^9, 
   3.551737174577607*^9}, {3.551739474353897*^9, 3.551739496983365*^9}, {
   3.551739900885045*^9, 3.551739903955727*^9}, {3.551741114347384*^9, 
   3.551741131078636*^9}, {3.551741181685878*^9, 3.551741182715818*^9}, 
   3.592522837772727*^9, 3.59282881157482*^9, 
   3.594072175401357*^9},ExpressionUUID->"1ffae3b3-5f61-4d01-af5d-\
92b1db9fe09d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PenroseBorderTriangles", "::", "usage"}], 
   "=", "\"\<PenroseBorderTriangles is an option to \
MakePenroseRhombTilingPrimalDualGraph that specifies whether to include \
half-rhombs on the border of the pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592522850638745*^9, 3.59252290119556*^9}, 
   3.592828811642883*^9, 3.5940721754212933`*^9},
 CellLabel->
  "In[3378]:=",ExpressionUUID->"f414c3b0-f76a-4d64-a9f9-eae48390365f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakePenroseRhombTilingPrimalDualGraph", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PenroseBorderTriangles", "\[Rule]", "True"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.551736216122525*^9, 3.551736258012125*^9}, 
   3.55173684878944*^9, {3.551739880642947*^9, 3.551739888600555*^9}, 
   3.551741174950693*^9, {3.551741206175686*^9, 3.551741207852013*^9}, 
   3.592522837803169*^9, 3.592522901430315*^9, 3.5928288117128673`*^9, 
