   3.801770638789494*^9},ExpressionUUID->"6fe61096-ccd7-494b-b458-\
8a9adfe22e4f"],

Cell[TextData[{
 "FoldSpaceCurve3D[",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 ", \[FinalSigma]",
 StyleBox[", opts",
  FontSlant->"Italic"],
 "] takes a 3D space curve for a fold and its fold angle function and creates \
the 3D ruled neighborhood of the fold."
}], "Text",
 CellChangeTimes->{{3.799443008826833*^9, 3.799443031243249*^9}, 
   3.799525566621662*^9, {3.79993839993931*^9, 3.799938401531022*^9}, 
