Cell[CellGroupData[{

Cell["Class TLinearChain", "Subsection",
 CellChangeTimes->{{3.616611751730987*^9, 3.616611753714292*^9}, {
   3.6166117885191097`*^9, 3.6166117937179832`*^9}, 3.6172499047144957`*^9, {
   3.617379074255066*^9, 
   3.617379077597825*^9}},ExpressionUUID->"5d8c65bc-b094-47b1-874b-\
21daf0a5aa72"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.616611768385488*^9, 
  3.6166117687846613`*^9}},ExpressionUUID->"06a0d051-889d-4608-a51f-\
048d96966898"],

Cell["\<\
A linear chain is a folded strip that can follow an arbitrary path in 3-space \
when folded; it can be major- or minor-connected along the spine, or a mix of \
the two.\
\>", "Text",
 CellChangeTimes->{{3.616611770232781*^9, 3.6166117859352827`*^9}, 
   3.616611826819008*^9, {3.616611894628385*^9, 3.616611895103456*^9}, {
   3.61737910604191*^9, 3.617379114476679*^9}, {3.617379151214247*^9, 
   3.617379201184678*^9}, {3.617396826941451*^9, 
   3.6173968419876833`*^9}},ExpressionUUID->"a5d93d23-31d4-470d-91ae-\
2f5eb6299a86"],

Cell["\<\
Class TLinearChain creates the crease pattern for such a pattern. You can use \
FoldLinearChain to give it a 3D form by specifying the  dihedral angle on the \
first fold, which will determine all of the other fold angles in the \
structure.\
\>", "Text",
 CellChangeTimes->{{3.617396888155016*^9, 3.617396917042901*^9}, {
  3.617396968369031*^9, 3.617396974170973*^9}, {3.617439813292941*^9, 
  3.617439832507547*^9}},ExpressionUUID->"96b346c5-988a-4a0a-b15e-\
d8d4bebad66f"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TObj class: TLinearChain
\tInherits from: TGraph, TAssigned\
\>", "Subsubsection",
 CellChangeTimes->{{3.617379210272155*^9, 3.617379223666229*^9}, {
  3.6173805113657727`*^9, 
  3.617380511613628*^9}},ExpressionUUID->"33ee766f-8b11-4152-b3e9-\
ce45efc344aa"],

Cell["\<\
TLinearChain is a TObj class that describes a 2xN quad mesh. Since it has a \
single DOF, every fold angle can be set by choosing one of the fold angles.\
\>", "Text",
 CellChangeTimes->{{3.617379226990833*^9, 3.617379284787607*^9}, 
   3.617379329566167*^9, {3.617379626809053*^9, 3.617379646785619*^9}, {
   3.617379677117893*^9, 
   3.617379679230517*^9}},ExpressionUUID->"3e41a7eb-092a-4fdc-9069-\
6de405f038f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TLinearChain", "::", "usage"}], 
   "=", "\"\<TLinearChain is a TObj class that describes a 2xN quad \
mesh.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.617379333905542*^9, 3.617379370204294*^9}},
 CellLabel->
  "In[2408]:=",ExpressionUUID->"19f9eca4-0a8c-4dcf-8fa0-51896a62be01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegisterTClass", "[", 
   RowBox[{"TLinearChain", ",", 
    RowBox[{"{", 
     RowBox[{"TGraph", ",", "TAssigned"}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.5949453237728567`*^9, 3.59494536111106*^9}, {
   3.594945409596053*^9, 3.594945409812021*^9}, {3.594945524766604*^9, 
   3.594945526534008*^9}, 3.617379382482723*^9, {3.617439854294545*^9, 
   3.617439854550686*^9}},
 CellLabel->
  "In[2409]:=",ExpressionUUID->"979b3c34-d2b4-4dc1-9bc7-744e6937d282"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TLinearChain properties:
\tVerticesSectorAngles\
\>", "Subsubsection",
 CellChangeTimes->{{3.617379389937911*^9, 3.617379394961103*^9}, {
   3.617379699871178*^9, 3.617379709522845*^9}, {3.617379854919395*^9, 
   3.61737989475141*^9}, {3.617380083501655*^9, 3.617380106927463*^9}, 
   3.617387194677185*^9, {3.617387315767413*^9, 3.617387318007297*^9}, 
   3.617396764484456*^9},ExpressionUUID->"bd405324-6450-48b5-ad05-\
3cb1a13192b2"],

Cell["\<\
VerticesSectorAngles is a TObj property that specifies the four sector angles \
at each vertex along the spine of the TLinearChain. It is used when we \
calculate all of the fold angles in the structure. Note that two sector \
angles for the first and last vertices will be ignored.\
\>", "Text",
 CellChangeTimes->{{3.61737989973759*^9, 3.6173799664535093`*^9}, 
   3.617380078646093*^9, {3.61738011094965*^9, 3.617380141742255*^9}, {
   3.617380689505701*^9, 
   3.617380691144264*^9}},ExpressionUUID->"72e26dc1-3adf-4e6d-91c1-\
b82e7f276c2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VerticesSectorAngles", "::", "usage"}], 
   "=", "\"\<VerticesSectorAngles is a TLinearChain property that describes \
the four sector angles at each of the vertices along the spine of the linear \
chain.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.617380161492383*^9, 3.617380208092018*^9}},
 CellLabel->
  "In[2410]:=",ExpressionUUID->"787fa2f7-8b2d-4d26-bf7c-914be8d9ff87"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeTLinearChain[",
 StyleBox["vertsectors",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lengths",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["w", "R"]}], TraditionalForm]],ExpressionUUID->
  "cfc912e5-66e8-484f-9de0-3ffe755c5f69"],
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "L"], TraditionalForm]],ExpressionUUID->
  "10358592-7b5a-46a4-a8e5-5b9ccb4c11b1"],
 StyleBox["}",
  FontSlant->"Italic"],
 "]\nMakeTLinearChain[",
 StyleBox["vertsectors",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lengths",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types, w",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.617380228499546*^9, 3.617380258008176*^9}, {
  3.6173803761193743`*^9, 3.617380426408774*^9}, {3.617381409059931*^9, 
  3.617381453749288*^9}, {3.688166836478674*^9, 3.688166836478774*^9}, {
  3.701088769701108*^9, 
  3.701088769701297*^9}},ExpressionUUID->"01319b82-fc91-4d24-bba1-\
7793429655d8"],

Cell[TextData[{
 "MakeTLinearChain[",
 StyleBox["vertsectors",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lengths",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["w", "R"]}], TraditionalForm]],ExpressionUUID->
  "7d5b638e-667f-4f77-af81-c35d36411b86"],
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "L"], TraditionalForm]],ExpressionUUID->
  "23fa3f71-202b-4f03-a98b-966928ee8ab2"],
 StyleBox["}",
  FontSlant->"Italic"],
 "] takes a list of vertex sector angles ",
 StyleBox["vertsectors",
  FontSlant->"Italic"],
 ", fold lengths along the spine ",
 StyleBox["lengths",
  FontSlant->"Italic"],
 ", fold types (M or V) along the spine ",
 StyleBox["types",
  FontSlant->"Italic"],
 ", and desired widths ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["w", "R"]}], TraditionalForm]],ExpressionUUID->
  "967385de-c000-4f18-bc52-ea1aa34ce31c"],
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "L"], TraditionalForm]],ExpressionUUID->
  "4733c109-a025-4bef-af03-5ae60311959d"],
 StyleBox["}",
  FontSlant->"Italic"],
 ", and constructs a TLinearChain in the form of a 2xN quad mesh. ",
 StyleBox["vertssectors",
  FontSlant->"Italic"],
 " are the vertex sector angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     RowBox[{
      SubscriptBox["\[Alpha]", 
       RowBox[{"2", ","}]], 
      SubscriptBox["\[Alpha]", "3"], Cell[
      "",ExpressionUUID->"dbbb2ee3-04a6-44ee-bc93-2142209dd04f"]}], ",", 
     SubscriptBox["\[Alpha]", "4"]}]}], TraditionalForm]],ExpressionUUID->
  "b223bbab-01ed-4ada-a9b5-5170a3f5ef46"],
 "} at each vertex down the \[OpenCurlyDoubleQuote]spine\
\[CloseCurlyDoubleQuote] (down the middle). In the first vertex, only ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "83d94ccd-d945-42e7-8218-8d06cf0d2f41"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "4"], TraditionalForm]],ExpressionUUID->
  "72b8af13-3ee2-4c77-86b9-e00a5d3ccb24"],
 " are used; in the last, only ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "7096fd58-7ee1-4115-8927-f25ba1760b6e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "3"], TraditionalForm]],ExpressionUUID->
  "afd4fec1-6549-4b58-a1a9-4d7ef12b727f"],
 " are used. The spine runs from left to right; the first vertex is at {0,0}, \
and the second lies on the positive x-axis."
}], "Text",
 CellChangeTimes->{{3.617380265598817*^9, 3.617380319487616*^9}, {
   3.617380366723054*^9, 3.6173803733580837`*^9}, {3.617380431566437*^9, 
   3.617380454543578*^9}, {3.617381424314397*^9, 3.617381431836742*^9}, {
   3.617382039381732*^9, 3.617382267878214*^9}, {3.617383234749756*^9, 
   3.617383237702084*^9}, 3.617396718037271*^9, {3.688166836503151*^9, 
   3.688166836527632*^9}, {3.70108877372694*^9, 3.701088773727186*^9}, {
   3.701088841245061*^9, 
   3.701088841245269*^9}},ExpressionUUID->"70dd06b0-0bde-4557-9602-\
ae6eb8b5b361"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTLinearChain", "::", "badsecs"}], 
   "=", "\"\<Vertex sectors list `1` should be a non-empty list of length-4 \
lists of sector angles.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.617382735488225*^9, 3.617382798217739*^9}, {
  3.617402453673355*^9, 3.617402505767218*^9}},
 CellLabel->
