Cell[TextData[{
 "Options:\n\tArcLabel \[Rule] ",
 StyleBox["label",
  FontSlant->"Italic"],
 " specifies that the middle of the arc should be labeled with the graphics \
primitive ",
 StyleBox["label",
  FontSlant->"Italic"],
 ".\n\tLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " | None, specifies the style to use for the arc line.\n\tFillStyle \[Rule] ",
 StyleBox["style | ",
  FontSlant->"Italic"],
 "None, specifies the style to use for the polygonal wedge.\n\t\
Options[PolygonalEllipseArc3D] are passed through."
}], "Text",
