Cell[CellGroupData[{

Cell["Thick flasher edge functions", "Subsection",
 CellChangeTimes->{{3.9369592255852127`*^9, 
  3.936959230006789*^9}},ExpressionUUID->"0170b47c-980e-490c-9220-\
b0516106ef9d"],

Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherCylindricallyInsetEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] [DEPRECATED]"
}], "Subsubsection",
 CellChangeTimes->{{3.933677536743046*^9, 3.93367755716045*^9}, {
  3.93405942462964*^9, 
  3.934059428026382*^9}},ExpressionUUID->"2731aeea-95dc-44d2-a3e8-\
1389cd3ce0b6"],

Cell[TextData[{
 "ThickFlasherCylindricallyInsetEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] returns a list of all edges with their ends inset to such a distance that \
cylinders of radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 " placed on the inset edges of any face may touch but do not overlap \
cylinders on the other edges of that face."
}], "Text",
 CellChangeTimes->{{3.933677636284141*^9, 3.933677732776669*^9}, {
  3.934047716171544*^9, 
  3.934047747403491*^9}},ExpressionUUID->"71ad10b9-3222-44f6-9163-\
1444e4867a49"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a flasher whose folded form (3D form) will be used to \
construct the inset edges.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the desired cylindrical radius."
}], "Text",
 CellChangeTimes->{{3.933681269102754*^9, 
  3.93368133063056*^9}},ExpressionUUID->"c4965d8c-abba-47ff-97ef-\
fefbf4db5a8d"],

Cell[TextData[{
 "Return: a list of edge point pairs for the inset edges, in the same order \
as the Edges property of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.9336813520901947`*^9, 
  3.933681376606018*^9}},ExpressionUUID->"662fa5da-1cd7-4d14-9796-\
b7b26d634860"],

Cell["\<\
This works for both the stowed form and deployed form of a flasher; just make \
sure you pass the desired TObj in as the argument.\
\>", "Text",
 CellChangeTimes->{{3.9340475314506187`*^9, 
  3.9340475558350058`*^9}},ExpressionUUID->"0f0e390d-1cb9-4e80-94e1-\
51b3c5625bd9"],

Cell["\<\
Note, though, that this does not check for collisions between cylinders in \
separate faces, which can happen in the stowed form.\
\>", "Text",
 CellChangeTimes->{{3.934047753452338*^9, 
  3.934047796299142*^9}},ExpressionUUID->"fa643de4-1255-4be1-921e-\
75a250d8eeaf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherCylindricallyInsetEdges", "[", 
   RowBox[{"tobj", ",", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts3d", ",", "edges", ",", "eva", ",", "edists", ",", "edirs", ",", 
      "eins"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eva", "=", 
      RowBox[{"EdgeVertexAngles3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Inset", " ", "distances"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"edists", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"r", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}], ",", 
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}]}], "]"}], ",", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}], ",", 
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}]}], "]"}]}], "}"}]}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{"eva", "/.", 
         RowBox[{"Null", "->", "\[Pi]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Original", " ", "edges", " ", "before", " ", "insetting"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"eins", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edge", " ", "direction", " ", "vectors"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"edirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{"-", 
          RowBox[{"Subtract", "@@", "#"}]}], "]"}], "&"}], "/@", "eins"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
           
           RowBox[{
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ",
             "#3"}]}], ",", 
          RowBox[{
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
           
           RowBox[{
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], " ",
             "#3"}]}]}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"eins", ",", "edists", ",", "edirs"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.933678514937114*^9, 3.933678525056176*^9}, {
   3.933678602680969*^9, 3.933678716698039*^9}, {3.933679308475087*^9, 
   3.933679312851313*^9}, {3.933679578465733*^9, 3.933679663133288*^9}, {
   3.933679728847678*^9, 3.9336797320703087`*^9}, {3.933679863133925*^9, 
   3.933679881887155*^9}, {3.933679919647066*^9, 3.9336801010019293`*^9}, {
   3.93368013368286*^9, 3.933680157527185*^9}, {3.933680316129435*^9, 
   3.933680457917445*^9}, {3.933680504954093*^9, 3.933680523074263*^9}, 
   3.93368062706849*^9, {3.933680657972278*^9, 3.933680661619858*^9}, {
   3.9336807140824213`*^9, 3.93368088952773*^9}, {3.933680919569067*^9, 
   3.933680979275342*^9}, {3.9336810139160557`*^9, 3.933681023594076*^9}, 
   3.9336811087535477`*^9, {3.934059367253848*^9, 3.934059368243219*^9}, {
   3.934059420920632*^9, 3.934059421817027*^9}},
 CellLabel->
  "In[4504]:=",ExpressionUUID->"9308954f-65e5-4803-a3ac-5376ebefd3af"],

Cell["\<\
Example. Note that in this example, in the stowed form, there are collisions \
between cylinders on different faces of the pattern.\
\>", "Text",
 CellChangeTimes->{{3.933677611668398*^9, 3.933677613036549*^9}, {
  3.9340476996098423`*^9, 3.934047708250917*^9}, {3.93404779903148*^9, 
  3.934047821076922*^9}},ExpressionUUID->"dcfb61dc-7405-4935-9957-\
efd82f8ef91e"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "tobj", ",", "tobjdp", ",", "cr", ",", 
     "eins", ",", "einsdp", ",", "cyls", ",", "cylsdp"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"cr", "=", "0.05"}], ";", "\[IndentingNewLine]", 
    RowBox[{"einsdp", "=", 
     RowBox[{"ThickFlasherCylindricallyInsetEdges", "[", 
      RowBox[{"tobjdp", ",", "cr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cylsdp", "=", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Cylinder", "[", 
          RowBox[{"#", ",", "cr"}], "]"}], "&"}], "/@", "einsdp"}], ",", 
       "Orange"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"eins", "=", 
     RowBox[{"ThickFlasherCylindricallyInsetEdges", "[", 
      RowBox[{"tobj", ",", "cr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cyls", "=", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Cylinder", "[", 
          RowBox[{"#", ",", "cr"}], "]"}], "&"}], "/@", "eins"}], ",", 
       "Orange"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], ",", 
           RowBox[{"Graphics3D", "[", "cyls", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}], ",", 
           RowBox[{"Graphics3D", "[", "cylsdp", "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Print"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.555852580447597*^9, 3.555852714790588*^9}, {
   3.555853087345189*^9, 3.555853147524287*^9}, {3.555853182193297*^9, 
   3.555853235661175*^9}, {3.555853435496076*^9, 3.555853458285693*^9}, {
   3.555853491197418*^9, 3.555853517058701*^9}, {3.555871177648246*^9, 
   3.555871199341531*^9}, {3.55587300234549*^9, 3.555873006248283*^9}, {
   3.555873658463595*^9, 3.555873684162862*^9}, {3.555877807629677*^9, 
   3.555877824310541*^9}, {3.555952968833061*^9, 3.555952971591174*^9}, {
   3.555953006534617*^9, 3.555953025477289*^9}, {3.555953212137144*^9, 
   3.555953213486215*^9}, {3.55595324942822*^9, 3.555953249653328*^9}, 
   3.555953297081149*^9, 3.719931029040756*^9, {3.719938702046335*^9, 
   3.719938702229306*^9}, 3.71994062574399*^9, {3.719940930038356*^9, 
   3.719941002567113*^9}, {3.719941258824275*^9, 3.719941259087162*^9}, {
   3.719941386239593*^9, 3.719941392909786*^9}, {3.719941452895154*^9, 
   3.719941460855174*^9}, {3.719941714920814*^9, 3.719941787046275*^9}, 
   3.7199421415348063`*^9, 3.719946418452291*^9, {3.8256114436889067`*^9, 
   3.825611459744749*^9}, {3.8256128139638*^9, 3.825612868306691*^9}, {
   3.825613119149046*^9, 3.825613122779771*^9}, {3.825613577305903*^9, 
   3.82561361168158*^9}, {3.8256136544971943`*^9, 3.825613658242022*^9}, 
   3.9118300750100937`*^9, {3.911894817287808*^9, 3.911894833432099*^9}, {
   3.91189489390606*^9, 3.911894903198819*^9}, 3.911894951081051*^9, {
   3.9118950859968367`*^9, 3.911895087216463*^9}, 3.911895118305929*^9, {
   3.911898065845737*^9, 3.91189806712845*^9}, {3.911898527666877*^9, 
   3.91189853302488*^9}, {3.912452549027753*^9, 3.912452575476074*^9}, {
   3.912452960105671*^9, 3.912453014560603*^9}, 3.912453050808255*^9, {
   3.913480998411521*^9, 3.913481008959054*^9}, {3.917280082077497*^9, 
   3.91728010122183*^9}, {3.917280614686429*^9, 3.917280614868555*^9}, {
   3.933677605524646*^9, 3.933677616233099*^9}, {3.933679223091131*^9, 
   3.9336793541279573`*^9}, {3.933679521958707*^9, 3.933679565852137*^9}, {
   3.933680064442927*^9, 3.9336800695112877`*^9}, {3.933680219717986*^9, 
   3.9336802951344433`*^9}, {3.933680550745408*^9, 3.933680608895091*^9}, {
   3.933681036857635*^9, 3.9336810777955313`*^9}, {3.933681134755967*^9, 
   3.933681207129306*^9}, {3.934047276796227*^9, 3.934047365562401*^9}, {
   3.934047457055002*^9, 3.934047503726204*^9}},
