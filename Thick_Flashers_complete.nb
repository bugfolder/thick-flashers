   3.803895691682297*^9, 
   3.803895701377936*^9}},ExpressionUUID->"942a3e43-868d-44ca-bc56-\
2fccde286eff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GraphicsExtent", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bbox", ",", "xmin", ",", "xmax", ",", "ymin", ",", "ymax"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bbox", "=", 
      RowBox[{"GraphicsBoundingBox", "[", "expr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "bbox", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xmin", ",", "xmax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ymin", ",", "ymax"}], "}"}]}], "}"}], "=", 
         RowBox[{"GraphicsBoundingBox", "[", "expr", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xmax", "-", "xmin"}], ",", 
          RowBox[{"ymax", "-", "ymin"}]}], "}"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.457529852227374*^9, 3.4575298562981253`*^9}, {
