   3.650070597646573*^9}, {3.650071992869676*^9, 3.650072188145229*^9}, {
   3.650072466504151*^9, 3.650072477202855*^9}, {3.650072512238518*^9, 
   3.650072512452052*^9}, {3.6500725868647633`*^9, 3.650072651579714*^9}, {
   3.650112268543181*^9, 3.650112269720778*^9}, {3.651517081837748*^9, 
   3.6515171669516706`*^9}, 3.676474810849609*^9, {3.707922436222577*^9, 
   3.707922439997245*^9}},
 CellLabel->
  "In[3499]:=",ExpressionUUID->"797e4db2-a5bb-419d-a6eb-a6193d188c74"],

Cell["\<\
Example: standard upward-facing pot, symmetric Mosely flanges. Lighten the \
creases in the CP, don\[CloseCurlyQuote]t show them in the FF.\
\>", "Text",
