         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces2", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts2", ",", "edges2", ",", "faces2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tglist", "=", 
      RowBox[{"{", 
       RowBox[{"tobj1", ",", "tobj2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mgdata", "=", 
      RowBox[{"MergeGraphsData", "[", "tglist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<vlist = \>\"", ",", 
       RowBox[{
       "mgdata", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<elist = \>\"", ",", 
       RowBox[{
       "mgdata", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<merged edges = \>\"", ",", 
       RowBox[{"GetMergedEdges", "[", 
        RowBox[{
        "mgdata", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tglist", "//", 
       RowBox[{"ApplyMerge", "[", "mgdata", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pr", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj1", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "pr"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj2", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "pr"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "pr"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594663894798616*^9, 3.594664130749181*^9}, {
