Cell[TextData[{
 "MakeTPlaneGraph[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faces",
  FontSlant->"Italic"],
 "] builds up a ",
 "TPlaneGraph",
 " directly from ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", and (optionally) ",
 StyleBox["faces",
  FontSlant->"Italic"],
 "."
}], "Text",
