    RowBox[{"AllowSelfIntersection", "\[Rule]", "True"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.617319788032916*^9, 3.617319814609992*^9}, 
