        RowBox[{"-", ".2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.4"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"f1", ",", 
          RowBox[{"f2", "-", "f1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SplitGraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SplitGraph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sinfo", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "SplitInfo"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sinfo", "//", "ColumnForm"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
