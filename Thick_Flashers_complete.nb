Cell[BoxData[
 RowBox[{
  RowBox[{"Degree4Vertex3DGaussianSphereGraphics3D", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sov", ",", "srv", ",", "stv", ",", "sop", ",", "srp", ",", "stp", ",", 
      "srgc", ",", "q", ",", "z", ",", "t", ",", "gg", ",", "aa", ",", "mji", 
      ",", "mni", ",", "glist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{
      "tobj", ",", "TDegree4Vertex3D", ",", 
       "Degree4Vertex3DGaussianSphereGraphics3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sov", "=", 
      RowBox[{
       RowBox[{"ShowOsculatingVector", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DGaussianSphereGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"srv", "=", 
      RowBox[{
       RowBox[{"ShowRulingVector", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DGaussianSphereGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"stv", "=", 
      RowBox[{
       RowBox[{"ShowTangentVector", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DGaussianSphereGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sop", "=", 
      RowBox[{
       RowBox[{"ShowOsculatingPlane", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DGaussianSphereGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"srp", "=", 
      RowBox[{
       RowBox[{"ShowRulingPlane", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DGaussianSphereGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"stp", "=", 
      RowBox[{
       RowBox[{"ShowTangentPlane", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DGaussianSphereGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"srgc", "=", 
