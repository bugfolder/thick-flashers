           "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"cyl", "[", 
          RowBox[{
           RowBox[{"lb", "+", "le", "+", "dc"}], ",", 
           RowBox[{"lpq", "-", "lb", "-", "le", "-", "dc"}], ",", "do"}], 
          "]"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kn2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cyl", "[", 
         RowBox[{"lb", ",", 
          RowBox[{"lb", "+", "le"}], ",", "do"}], "]"}], ",", 
