Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pp", ",", "u0", ",", "u1", ",", "dt"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pp", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{
          RowBox[{"+", "0.4"}], "#"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1", ",", "dt"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "\[Pi]", ",", 
         RowBox[{"\[Pi]", "/", "32"}]}], "}"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{"Styled3DUnitDiskFromNormal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
             RowBox[{"FillStyle", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"GrayLevel", "[", "0.7", "]"}], ",", 
                RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}]}], "]"}], 
           "]"}], ",", 
          RowBox[{"FrenetTrihedronPlot3D", "[", 
           RowBox[{"pp", ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"FrenetVectorLength", "\[Rule]", "0.5"}], ",", 
            RowBox[{"FrenetTrihedrons", "\[Rule]", "7"}], ",", 
            RowBox[{"VectorThickness2D", "\[Rule]", ".05"}], ",", 
            RowBox[{"FrenetDrop", "\[Rule]", 
             RowBox[{"-", "1"}]}]}], "]"}]}], "}"}], ",", 
        RowBox[{"Axes", "\[Rule]", "True"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", ".5"}], ",", "1.8"}], "}"}]}], "}"}]}]}], "]"}], "/.",
       "CurveVectorStyle"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
