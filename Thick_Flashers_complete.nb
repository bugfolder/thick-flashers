Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "t", ",", "sq", ",", "r1", ",", "r2", ",", "ai", ",",
       "p", ",", "q", ",", "r1a", ",", "r2a", ",", "cu1", ",", "kn1", ",", 
      "ho1", ",", "cu2", ",", "kn2", ",", "ho2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", "20."}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"panel", " ", 
       RowBox[{"(", 
        RowBox[{"and", " ", "hinge"}], ")"}], " ", "length"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", "5."}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"panel", " ", "height"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", "=", "2."}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"panel", " ", "thickness"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"r1", "=", 
      RowBox[{"r2", "=", 
       RowBox[{"MakeCubeGC", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Two", " ", "vertical", " ", "panels"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "t", ",", "b"}], "}"}], "#"}], "&"}], "/@", 
       RowBox[{
       "r1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "t", ",", "0"}], "}"}], "+", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "t", ",", "b"}], "}"}], "#"}]}], "&"}], "/@", 
       RowBox[{
       "r2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ai", "=", "2."}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"axis", " ", "of", " ", "the", " ", "hinge"}], ",", " ", 
