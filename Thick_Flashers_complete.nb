  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", "2"}], ")"}], 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"Cos", "[", "\[Xi]", "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.636736720492048*^9, 3.636736732247995*^9}, {
