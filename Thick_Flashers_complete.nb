   3.593089295754508*^9},ExpressionUUID->"08b2b69e-5775-4965-8f58-\
291fe9becff6"],

Cell[TextData[{
 "MakeRectUniPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of 2D points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " and a rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and creates a crease pattern and folded form of a rotational flanged pot \
starting from a rectangle. It returns a ",
 "TObj",
 ". Options are:\n\tMinimumAngle\[Rule]",
 StyleBox["mb",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["mb",
  FontSlant->"Italic"],
 " is the minimum bend angle at which we add a horizontal crease along the \
side.\n\tFlangeExcess\[Rule]",
 StyleBox["fe",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["fe",
  FontSlant->"Italic"],
 " is the proportional increase in flange width relative to the widest panel.\
\n\tGapSize\[Rule]",
 StyleBox["gap",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["gap",
  FontSlant->"Italic"],
 " is the proportional reduction in panel width that introduces a gap into \
the flanges in the folded form. This is only a tweak for rendering of the \
folded form; the crease pattern is not affected by this parameter."
}], "Text",
 CellChangeTimes->{{3.456356366824768*^9, 3.456356480780696*^9}, {
   3.456357875049625*^9, 3.456357882948633*^9}, {3.456358004628619*^9, 
   3.456358052075944*^9}, 3.4563605796995564`*^9, 3.456397776557507*^9, {
   3.4563979444478283`*^9, 3.456397951693556*^9}, {3.456398499828661*^9, 
   3.456398591723905*^9}, {3.526730747665512*^9, 3.526730756161202*^9}, {
   3.526747256793701*^9, 3.526747273936509*^9}, {3.526762488678666*^9, 
   3.52676253322808*^9}, {3.52676266598024*^9, 3.526762713350894*^9}, {
   3.5921285050241833`*^9, 3.592128508198254*^9}, 3.592170590380365*^9, 
   3.5924357661894007`*^9},ExpressionUUID->"c4522a44-4e64-44f5-8762-\
64a895e38cdd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlangeExcess", "::", "usage"}], 
   "=", "\"\<FlangeExcess is an option to MakeRectUniPot that specifies the \
extra flange width to add relative to the widest panel.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592128512835625*^9, 3.592128544790277*^9}},
 CellLabel->
  "In[3545]:=",ExpressionUUID->"33ce6b5c-0bdc-46ab-86e5-8fa7ca59f307"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRectUniPot", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MinimumAngle", "\[Rule]", 
      RowBox[{"10.", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FlangeExcess", "\[Rule]", "0.05"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"FoldedFormGapSize", "\[Rule]", "0.05"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456356554910956*^9, 3.456356573084632*^9}, {
   3.45635731355683*^9, 3.456357357633705*^9}, {3.4563578217357187`*^9, 
   3.456357823509667*^9}, {3.45635799031857*^9, 3.456358001126463*^9}, 
   3.456397767646634*^9, {3.456398579295109*^9, 3.456398585397861*^9}, 
   3.456399284681927*^9, 3.456399373620479*^9, {3.456400123025455*^9, 
   3.456400123887846*^9}, {3.5267620784341993`*^9, 3.52676208513019*^9}, 
   3.526762358898555*^9, {3.526762570964872*^9, 3.526762593301297*^9}, {
   3.526823301261126*^9, 3.526823305964265*^9}, 3.592127768221519*^9},
 CellLabel->
  "In[3546]:=",ExpressionUUID->"096f04bc-a756-4dc7-8084-8a48146efb5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRectUniPot", "[", 
   RowBox[{"pts_", ",", "m_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mb", ",", "fe", ",", "gs", ",", "\[Phi]", ",", "sf", ",", "cf", ",", 
      "tf", ",", "nn", ",", "ps", ",", "cs", ",", "xt", ",", "\[Zeta]", ",", 
      "wt", ",", "wr", ",", "rt", ",", "hw", ",", "vt", ",", "st", ",", "dl", 
      ",", "an", ",", " ", "a2", ",", "b2", ",", "c2", ",", "d2", ",", "e2", ",",
       "f2", ",", "g2", ",", "cpw", ",", "cpsw", ",", "cp", ",", "a3", ",", 
      "b3", ",", "c3", ",", "d3", ",", "e3", ",", "f3", ",", "g3", ",", "pfn",
       ",", "ffw", ",", "ffsw", ",", "ff"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mb", "=", 
      RowBox[{
       RowBox[{"MinimumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectUniPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fe", "=", 
      RowBox[{
       RowBox[{"FlangeExcess", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectUniPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs", " ", "=", " ", 
      RowBox[{
       RowBox[{"FoldedFormGapSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectUniPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "setup", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"N", "[", 
       RowBox[{"\[Pi]", "/", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sf", "=", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ";", 
     RowBox[{"cf", "=", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ";", 
     RowBox[{"tf", "=", 
      RowBox[{"sf", "/", "cf"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ps", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{
         "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        "&"}], "/@", "pts"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"shift", " ", "points", " ", "to", " ", "origin"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xt", ",", "\[Zeta]"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "ps", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "x", " ", "and", " ", "z", " ", "coordinates", " ", "of", " ", "cross", 
       " ", "section"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"wt", "=", 
      RowBox[{"tf", " ", "xt"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"half", "-", 
       RowBox[{"width", " ", "of", " ", "each", " ", "panel"}]}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"wr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "gs"}], ")"}], "wt"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"reduced", " ", "half"}], "-", 
       RowBox[{"width", " ", "of", " ", "each", " ", "panel"}]}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"rt", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"Mag", "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"RotateLeft", "[", "ps", "]"}], "-", "ps"}], ")"}]}], ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "x", " ", "coord", " ", "of", " ", "panel", " ", "in", " ", "CP"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"hw", "=", 
      RowBox[{
       RowBox[{"Max", "[", "wt", "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", "fe"}], ")"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"half", "-", 
       RowBox[{"width", " ", "of", " ", "rectangle"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vt", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"hw", ",", 
        RowBox[{"{", "nn", "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"full", " ", "half"}], "-", 
       RowBox[{"width", " ", "of", " ", 
        RowBox[{"(", "rectangular", ")"}], " ", "wedge", " ", "in", " ", 
        "CP"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"st", "=", 
      RowBox[{"vt", "-", "wt"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"width", " ", "of", " ", "flange"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dl", "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"N", "[", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RotateLeft", "[", "ps", "]"}], "-", "ps"}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"directions", " ", "of", " ", "each", " ", "panel"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"an", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "0", "}"}], ",", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ArcTan", "[", 
              RowBox[{
               RowBox[{"#1", ".", "#2"}], ",", 
               RowBox[{
                RowBox[{"Cross", "[", "#1", "]"}], ".", "#2"}]}], "]"}], 
             "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"dl", ",", 
              RowBox[{"RotateLeft", "[", "dl", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}], ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"fold", " ", "angle"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"CROSS", " ", "SECTION"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cs", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Line", "[", "ps", "]"}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}], "*", "#"}], "&"}], "/@",
             "ps"}], "]"}]}], "}"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"CREASE", " ", "PATTERN"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"a2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"-", "vt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"-", "wt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", "0"}], "}"}], "&"}], "/@", "rt"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"+", "wt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"e2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"+", "vt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "hw"}]}], "}"}], "+", "#"}], "&"}], "/@", "b2"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"g2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "hw"}]}], "}"}], "+", "#"}], "&"}], "/@", "c2"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"cpw", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "a2", "]"}], ",", "ValleyLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "d2", "]"}], ",", "MountainLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"a2", ",", "d2", ",", "an"}], "}"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"d2", ",", "e2", ",", 
                RowBox[{"-", "an"}]}], "}"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a2", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"e2", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], "]"}],
             ",", "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
               "a2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "e2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
               "}"}], "]"}], ",", "BorderLine"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cpsw", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "e2", "]"}], ",", "ValleyLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "d2", "]"}], ",", "MountainLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"c2", ",", "d2", ",", "an"}], "}"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"d2", ",", "e2", ",", 
                RowBox[{"-", "an"}]}], "}"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"e2", ",", "g2", ",", "an"}], "}"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"c2", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"g2", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], "]"}],
             ",", "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
               "c2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "g2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
               "}"}], "]"}], ",", "BorderLine"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Translate2D", "[", 
           RowBox[{
            RowBox[{
            "cpw", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"2", "hw", " ", "i"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"FOLDED", " ", "FORM"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"a3", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"xt", ",", 
         RowBox[{"-", "vt"}], ",", "\[Zeta]"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b3", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"xt", ",", 
         RowBox[{"-", "wt"}], ",", "\[Zeta]"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", "0", ",", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "}"}], "&"}], "/@", "ps"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d3", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"xt", ",", "wr", ",", "\[Zeta]"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"e3", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"xt", ",", "wt", ",", "\[Zeta]"}], "}"}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"U3D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "\[Pi]"}], "/", "2"}], "+", 
             RowBox[{"2", "\[Phi]"}]}], "]"}], "*", "#"}], "&"}], ")"}], "/@",
         "st"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"2", " ", "\[Phi]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ".", "#"}], 
        "&"}], "/@", "b3"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"2", " ", "\[Phi]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ".", "#"}], 
        "&"}], "/@", "c3"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pfn", "=", 
      RowBox[{
       RowBox[{"Style", "[", 
