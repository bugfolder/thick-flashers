Cell[CellGroupData[{

Cell["Unit polygon tiles", "Section",
 CellChangeTimes->{{3.6293331044732943`*^9, 
  3.629333106690714*^9}},ExpressionUUID->"0c10d0c1-eb34-4e4b-a015-\
e9bfb77465e1"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.62933314091367*^9, 
  3.629333142488109*^9}},ExpressionUUID->"406af4e2-9e0b-460e-be0a-\
bd2fabbdc154"],

Cell["\<\
All of the tiles in this section are unit polygons, polygons whose first \
vertex is at {0,0}, second at {1,0}, and the tile lies in the upper half \
plane. Instead of being specified by their tile vertices, they are specified \
by a smaller number of parameters, which are different for each type of tile. \
This permits a very concise description of tilings composed of regular \
polygons.\
\>", "Text",
 CellChangeTimes->{{3.629333144536161*^9, 3.629333233194838*^9}, {
  3.629376825501342*^9, 3.6293768306482277`*^9}, {3.629847862238451*^9, 
  3.629847862830011*^9}, {3.629978046194514*^9, 3.629978046848268*^9}, {
  3.707760789745943*^9, 
  3.707760790186122*^9}},ExpressionUUID->"9af91d72-45bf-4e6c-8e0d-\
f09ba75d7903"]
}, Closed]],

