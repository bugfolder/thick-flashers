Cell[TextData[{
 "VertexEdgeAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TPlaneGraph and returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", " ", 
       SubscriptBox["\[Alpha]", "2"], ",", " ", "..."}], "}"}], ",", " ", 
     "..."}], "}"}], TraditionalForm]],ExpressionUUID->
  "e42c0640-67bf-4e5d-8b97-1beacb5554c8"],
 " of the angles between consecutive edges (i.e., sector angles) around each \
vertex using the Vertices data. The angles for boundary faces are set to Null."
}], "Text",
 CellChangeTimes->{{3.5919085628987103`*^9, 3.591908751070115*^9}, {
   3.591908784651951*^9, 3.5919087951727743`*^9}, {3.591958207068511*^9, 
