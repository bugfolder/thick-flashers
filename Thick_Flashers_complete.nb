Cell[BoxData[
 RowBox[{
  RowBox[{"NCurvedFoldHelix3D", "[", 
   RowBox[{"r_", ",", "\[Theta]_", ",", 
    RowBox[{"\[Gamma]_Function", "|", "\[Gamma]_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]1"}], "}"}], "=", 
      RowBox[{"CurvedFoldHelix3D", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Gamma]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"ff", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"rrL", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"rrR", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"InterpolatingFunctionCount", "[", "\[Gamma]", "]"}], "\[NotEqual]",
         "3"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Gamma]1", "=", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"\[Gamma]", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], 
         "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]1"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.79974476769153*^9, 3.799744784857356*^9}, {
   3.799744832905467*^9, 3.799745002231144*^9}, {3.799747243819375*^9, 
