   3.80190913637281*^9}},ExpressionUUID->"d8747bcc-f41d-44f1-b6de-\
0326b7fc67d9"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b1",
  FontSlant->"Italic"],
 " \[LongDash] 2D directrix of the first surface.\n\t",
 StyleBox["d1",
  FontSlant->"Italic"],
 " \[LongDash] 2D director of the first surface.\n\t",
 StyleBox["bb1",
  FontSlant->"Italic"],
 " \[LongDash] 3D directrix of the first surface.\n\t",
 StyleBox["dd1",
  FontSlant->"Italic"],
 " \[LongDash] 3D director of the first surface.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter at which the two surfaces are properly oriented.\n\t",
 StyleBox["b2i",
  FontSlant->"Italic"],
 " \[LongDash] 2D cone point of the second surface.\n\t",
 StyleBox["bb2i",
  FontSlant->"Italic"],
 " \[LongDash] 3D cone point of the second surface.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.801503207744983*^9, 3.801503296475118*^9}, {
