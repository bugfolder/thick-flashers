           RowBox[{"q", "[", "1", "]"}], ",", 
           RowBox[{"tf", "[", "2", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", 
           RowBox[{"Curve2DSystems", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"cs", "[", "0", "]"}], ",", 
              RowBox[{"cs", "[", "1", "]"}], ",", 
              RowBox[{"cs", "[", "2", "]"}]}], "}"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
