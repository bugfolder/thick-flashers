Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlapAngle", "::", "usage"}], 
   "=", "\"\<FlapAngle is an option to MakeFlapCubeBox that specifies the \
bevel angle to be used on the box flaps.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.719838933233181*^9, 3.719838964899496*^9}},
 CellLabel->
  "In[2387]:=",ExpressionUUID->"503cab59-2205-4dc8-afb6-e78afe1a5ae9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlapWidth", "::", "usage"}], 
   "=", "\"\<FlapWidth is an option to MakeFlapCubeBox that specifies the \
