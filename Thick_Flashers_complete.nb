   3.707860399828964*^9}},ExpressionUUID->"9d742a6a-5734-45ac-828e-\
5d2d1a2a5668"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraphAssigned being reduced."
}], "Text",
 CellChangeTimes->{{3.707843707838018*^9, 3.707843755815661*^9}, {
   3.707853111188617*^9, 3.707853141196183*^9}, {3.707853225923746*^9, 
