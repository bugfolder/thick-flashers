   3.719943896687235*^9, 3.719943904982719*^9}, 
   3.719943986272289*^9},ExpressionUUID->"7790e1fc-2c58-4dd5-a63a-\
476c01795994"],

Cell["\<\
This is the original arrangement of the diagonal folds that I used in my \
initial analysis for LLNL. Note that the way I construct this pattern relies \
on the order that the quads were built.\
\>", "Text",
 CellChangeTimes->{{3.719850879828931*^9, 
  3.719850881338765*^9}},ExpressionUUID->"b27695e0-75b7-42c5-b930-\
c16dcd6b59a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherSectorDiagFoldLinesX", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fsq", ",", "nmajor", ",", "nminor", ",", "qmajor", ",", "qminor", ",", 
      "qrmajor", ",", "qrminor", ",", "n"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fsq", "=", 
      RowBox[{"FlasherSectorQuads", "[", 
       RowBox[{"v", ",", "r", ",", "h", ",", "k"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nmajor", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Length", "[", "fsq", "]"}], "+", "r"}], ")"}], "/", "2"}]}],
      ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "number", " ", "in", " ", "first", " ", "row", " ", "of", " ", "major", 
       " ", "region"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nminor", "=", 
      RowBox[{"nmajor", "-", "r"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "number", " ", "in", " ", "first", " ", "row", " ", "of", " ", "minor", 
       " ", "region"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"qmajor", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"fsq", ",", "nmajor"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "major", " ", "quads"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"qminor", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"fsq", ",", 
        RowBox[{"-", "nminor"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "minor", " ", "quads"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "now", " ", "partition", " ", "into", " ", "individual", " ", "rows"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"qrmajor", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"r", "*", "h"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "number", " ", "of", " ", "elements", " ", "in", " ", "major", " ", 
       "row"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"n", ">", "0"}], ",", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"qrmajor", ",", 
          RowBox[{"Take", "[", 
           RowBox[{"qmajor", ",", "n"}], "]"}]}], "]"}], ";", 
        RowBox[{"qmajor", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{"qmajor", ",", "n"}], "]"}]}], ";", 
        RowBox[{"n", "-=", "h"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"qrminor", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{
       RowBox[{"r", "*", "h"}], "-", "1"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "number", " ", "of", " ", "elements", " ", "in", " ", "1", "st", " ", 
       "minor", " ", "row"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"n", ">", "0"}], ",", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"qrminor", ",", 
          RowBox[{"Take", "[", 
           RowBox[{"qminor", ",", "n"}], "]"}]}], "]"}], ";", 
        RowBox[{"qminor", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{"qminor", ",", "n"}], "]"}]}], ";", 
        RowBox[{"n", "-=", "h"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    "#2", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"h", "-", "1"}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "-", "1"}], ")"}]}], "+", 
                    "1"}], ",", "2"}], "]"}], "\[Equal]", "0"}], ",", 
                 RowBox[{"#1", "\[LeftDoubleBracket]", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
                 ",", 
                 RowBox[{"#1", "\[LeftDoubleBracket]", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "4"}], "}"}], 
                  "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", 
              "FlasherLightFold"}], "]"}], "&"}], ",", "qrminor", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    "#2", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"h", "-", "1"}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "-", "1"}], ")"}]}], "+", 
                    "1"}], ",", "2"}], "]"}], "\[Equal]", "0"}], ",", 
                 RowBox[{"#1", "\[LeftDoubleBracket]", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], 
                 ",", 
                 RowBox[{"#1", "\[LeftDoubleBracket]", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "4"}], "}"}], 
                  "\[RightDoubleBracket]"}]}], "]"}], "]"}], ",", 
              "FlasherLightFold"}], "]"}], "&"}], ",", "qrmajor", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "]"}], "/.", 
      RowBox[{"FlasherWrapRules", "[", "v", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555798801341606*^9, 3.555798831006456*^9}, {
   3.5557989877636*^9, 3.555799030010644*^9}, 3.555799537040923*^9, {
   3.555799633140215*^9, 3.555799721485155*^9}, {3.555799751955808*^9, 
