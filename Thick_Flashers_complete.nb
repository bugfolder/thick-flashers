Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "patch", ",", "lattice", ",", "tiling"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<tiling = \>\"", ",", 
       RowBox[{"ArchimedeanName", "[", "n", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"patch", "=", 
      RowBox[{"ArchimedeanPatch", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"EmbedTiling", "[", 
          RowBox[{"patch", ",", "Tiling", ",", 
           RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
           RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "\"\<patch\>\""}]}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lattice", "=", 
      RowBox[{"ArchimedeanPatchLatticeVectors", "[", "n", "]"}]}], ";", 
