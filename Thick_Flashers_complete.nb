Cell["Flat-folding, unfolding", "Subsection",
 CellChangeTimes->{{3.533946178815993*^9, 3.533946183813893*^9}, {
   3.591808494186588*^9, 3.591808496551849*^9}, 3.591972131133795*^9, {
