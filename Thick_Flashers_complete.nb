Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", "t", ",", "a", ",", "b", ",", "c", ",", "panels", ",", 
       "panelinfo", ",", "shifts", ",", "axes", ",", "panelparts", ",", 
       "ppopts", ",", "ib", ",", "kd", ",", "hd", ",", "filename"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", "t"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"20", ",", "2"}], "}"}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"dimensions", " ", "of", " ", "the", " ", "panels"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"b", "=", 
        RowBox[{"c", "=", 
         RowBox[{"MakeCubeGC", "[", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "a", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"d", ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "b", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "d"}], ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"panels", "=", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"axes", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "1", ",", "t"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", 
             RowBox[{"d", "-", "1"}], ",", "t"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "d"}], ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "d"}], ",", 
             RowBox[{"d", "-", "1"}], ",", "0"}], "}"}]}], "}"}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"panelinfo", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "7"}], "}"}]}], "}"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"{", 
              RowBox[{"5", ",", "8"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", 
             RowBox[{"{", 
              RowBox[{"6", ",", "7"}], "}"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"{", 
             RowBox[{"5", ",", "8"}], "}"}]}], "}"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"shifts", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Show", " ", "the", " ", "panels", " ", "and", " ", "the", " ", "axes",
         " ", "where", " ", "the", " ", "pin", " ", "hinges", " ", "should", " ", 
        RowBox[{"go", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "SolidStyle", ",", 
            RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Cylinder", "[", 
               RowBox[{"#", ",", 
                RowBox[{"t", "/", "2"}]}], "]"}], ",", "Orange"}], "]"}], 
            "&"}], "/@", "axes"}]}], "}"}], "]"}], "//", "Print"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Inset", " ", "the", " ", "bottoms", " ", "of", " ", "the", " ", 
        "panels", " ", "by", " ", "0.3", " ", "mm"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ib", "=", "0.3"}], ";", "\[IndentingNewLine]", 
      RowBox[{"panels", "=", 
       RowBox[{"InsetBottomFaceUpwardGC", "[", 
        RowBox[{"panels", ",", "ib"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Create", " ", "pin"}], "-", 
        RowBox[{
        "hinged", " ", "panel", " ", "parts", " ", "and", " ", "the", " ", 
         "files", " ", "needed", " ", "to", " ", "create", " ", "the", " ", 
         "3", "D", " ", "model"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"hd", "=", "1.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"kd", "=", "2.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ppopts", "=", 
       RowBox[{"Sequence", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PinHingeHoleDia", "->", "hd"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"PinHingeOuterDia", "->", "kd"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PinHingeClearance", "->", "0.2"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PinHingeEndLength", "->", "3.0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PinHingeAccessLength", "->", "20.0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PinHingeMinGapLength", "->", "3.0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"RoundingDivisions", "->", "16"}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"panelparts", "=", 
       RowBox[{"MakePinHingedPanelParts", "[", 
        RowBox[{"panels", ",", "panelinfo", ",", "axes", ",", "ppopts"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Show", " ", "the", " ", "structure", " ", "of", " ", "the", " ", 
        "array"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"panelparts", "/.", 
        RowBox[{
         RowBox[{"GraphicsComplex", "[", "___", "]"}], ":>", "\"\<GC\>\""}]}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Generate", " ", "MeshLab", " ", "files", " ", "and", " ", "script"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"filename", "=", 
       RowBox[{"\"\<Panel-trio\>\"", "<>", 
        "\[IndentingNewLine]", "\"\<-hd\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"hd", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}], "<>", 
        "\[IndentingNewLine]", "\"\<-kd\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"kd", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}], "<>", 
        "\[IndentingNewLine]", "\"\<-ib\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"ib", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"MakeMeshLabPinHingedPanels", "[", 
       RowBox[{
        RowBox[{"\"\<~/Desktop/\>\"", "<>", "filename"}], ",", "panelparts", ",",
         "\[IndentingNewLine]", 
        RowBox[{"MeshLabPinHingedPanelShifts", "->", "shifts"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "ShowExample"}], ";"}]], "Input",
 CellChangeTimes->{{3.9338434666037188`*^9, 3.933843753165881*^9}, {
   3.933843810464285*^9, 3.933843941364746*^9}, {3.933844161890683*^9, 
