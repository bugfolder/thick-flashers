Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "eo"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTPlaneGraph", "[", 
        RowBox[{"pgvertscp", ",", "pgedges", ",", "pgfaces"}], "]"}], "//", 
       RowBox[{"AddTAssigned", "[", "pgtypes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
