Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "tobj", ",", "tobjdp", ",", "ffg", ",", 
     "scale", ",", "cdir", ",", "bkgnd", ",", "devex", ",", "vertsdp"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ffg", "=", 
     RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "scaling", " ", "factor", " ", "for", " ", "horizontal", " ", 
      "distances"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"scale", "=", 
     RowBox[{"1.0", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"cylinder", " ", "diameter"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"cdir", "=", "0.08"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Background", " ", 
      RowBox[{"image", ":", " ", 
       RowBox[{
        RowBox[{"the", " ", "z"}], "-", 
        RowBox[{
        "projection", " ", "of", " ", "the", " ", "deployed", " ", 
         "form"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"bkgnd", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"ffg", ",", "_Line", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "/.", 
          RowBox[{
           RowBox[{"Line", "[", "pts_", "]"}], ":>", 
           RowBox[{"Line", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"scale", "#"}], "&"}], "/@", "pts"}], "]"}]}]}], ",", 
