Cell["\<\
Options:
\tOptions[GenericGraphGraphics] are passed through to GenericGraphGraphics.
\tOptions[Graphics] are passed through to Graphics.\
\>", "Text",
 CellChangeTimes->{{3.706823662541222*^9, 
  3.7068236655384293`*^9}},ExpressionUUID->"4abc4c10-80f0-406d-b488-\
35ae10562b8d"],

Cell["\<\
This function is useful for doing a quick visualization of a graph and \
checking whether it is well-formed; overlapping vertex or edge labels imply \
duplicate vertices; improperly drawn faces imply improper parsing into face \
lists.\
\>", "Text",
 CellChangeTimes->{{3.45761921144835*^9, 3.457619285715283*^9}, {
   3.458261267976077*^9, 3.4582612730478573`*^9}, {3.466090439004662*^9, 
   3.466090440238179*^9}, {3.466090486454001*^9, 3.466090487483924*^9}, 
   3.484829046455018*^9, {3.5916354615956583`*^9, 3.5916354630585003`*^9}, {
   3.592345788623102*^9, 
   3.592345789111329*^9}},ExpressionUUID->"8487f92f-44cc-4c7d-b628-\
6ff02546b269"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GraphGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vl", ",", "el", ",", "fl", ",", "de", ",", "fd", ",", "fc", ",", 
      "verts", ",", " ", "edges", ",", " ", "faces", ",", "hf", ",", "gg"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "GraphGraphics"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", " ", "edges", ",", " ", "faces"}], "}"}], " ", "=",
       " ", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", " ", "Edges", ",", " ", "Faces"}], "}"}], ",", 
        RowBox[{"AssertProperties", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GenericGraphGraphics", "[", 
      RowBox[{"verts", ",", "edges", ",", "faces", ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.455897388549263*^9, 3.455897388993318*^9}, {
   3.455897687077399*^9, 3.4558977349980164`*^9}, {3.455898637235851*^9, 
