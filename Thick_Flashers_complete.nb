  3.71994598756772*^9},ExpressionUUID->"aa928ec1-55c9-4d8a-9182-d087182a96cf"],

Cell["\<\
These aren\[CloseCurlyQuote]t accurate, of course; they\[CloseCurlyQuote]re \
drawings that are close to the proper vertex positions. The goal of this \
notebook is to solve for what those vertex positions actually are.\
\>", "Text",
 CellChangeTimes->{{3.555715954279203*^9, 3.555716001188056*^9}, {
  3.555748748485472*^9, 
  3.555748750309078*^9}},ExpressionUUID->"ec706e3a-8a44-42d4-84dd-\
f037e947b179"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherWrapRules[",
 StyleBox["v",
  FontSlant->"Italic"],
 "]\nFlasherWrapRules[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
