Cell[CellGroupData[{

Cell["Goldberg central tessellations", "Subsection",
 CellChangeTimes->{{3.631636842655842*^9, 
  3.631636854578997*^9}},ExpressionUUID->"fb4ef5b9-db48-415d-91ca-\
dcd0d9a21959"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.631645062089764*^9, 
  3.631645062527533*^9}},ExpressionUUID->"1ddcfa53-75fb-46d0-a57b-\
bcb1e50a3b81"],

Cell["\<\
We create patches for raw tilings, but not for twist patches. It is \
relatively straightforward to transforma a tiling patch into a twist \
tessellation patch using a substitution rule, and then you can pick up the \
oriented version of the tiling from the M/V assignment.\
\>", "Text",
 CellChangeTimes->{{3.631645064799914*^9, 3.631645090277585*^9}, {
  3.631645145713808*^9, 
  3.631645184271837*^9}},ExpressionUUID->"d9799f07-a838-42bc-9977-\
42cfad2a4746"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "GoldbergPatch[",
 StyleBox["m, n",
  FontSlant->"Italic"],
 "]\nGoldbergTiling[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n, opts",
  FontSlant->"Italic"],
 "]\n\t",
 "(options) Simplification",
 ", Numeric"
}], "Subsubsection",
 CellChangeTimes->{{3.631636896200726*^9, 3.631636928110293*^9}, {
   3.631638322204822*^9, 3.631638329666914*^9}, {3.6316391539513807`*^9, 
   3.631639167612344*^9}, 
   3.690988444369961*^9},ExpressionUUID->"2ce18a19-6938-4625-8528-\
188bb29da800"],

Cell[TextData[{
 "GoldbergPatch[",
 StyleBox["m, n",
  FontSlant->"Italic"],
 "] returns a tiling patch of a Goldberg central tessellation with rotational \
order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and ",
 StyleBox["n",
  FontSlant->"Italic"],
 " rings, so it contains ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "84d2465b-55ad-4cc5-aea5-9ac6cde0a687"],
 " tiles. The first triangle is a unit triangle."
}], "Text",
 CellChangeTimes->{{3.631636930504414*^9, 3.6316369923807383`*^9}, {
  3.631638364369021*^9, 3.631638380279574*^9}, {3.6316391699403977`*^9, 
  3.631639174019957*^9}},ExpressionUUID->"590716be-94fa-4e40-bbad-\
675053e8be44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GoldbergPatch", "[", 
   RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[Phi]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"UnitTriangleTile", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"2", "\[Phi]"}], ",", 
                  RowBox[{
                   FractionBox["\[Pi]", "2"], "-", "\[Phi]"}], ",", 
                  RowBox[{
                   FractionBox["\[Pi]", "2"], "-", "\[Phi]"}]}], "}"}]}], 
               "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}], 
                RowBox[{"U", "[", "0", "]"}]}], "+", 
               RowBox[{"2", 
                RowBox[{"Sin", "[", "\[Phi]", "]"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}], 
                RowBox[{"U", "[", 
                 RowBox[{
                  FractionBox["\[Pi]", "2"], "+", "\[Phi]"}], "]"}]}]}], ",", 
              "0", ",", "1"}], "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", "\[NotEqual]", "j"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"UnitTriangleTile", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    FractionBox["\[Pi]", "2"], "-", "\[Phi]"}], ",", 
                    RowBox[{"2", "\[Phi]"}], ",", 
                    RowBox[{
                    FractionBox["\[Pi]", "2"], "-", "\[Phi]"}]}], "}"}]}], 
                 "}"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}], 
                  RowBox[{"U", "[", "0", "]"}]}], "+", 
                 RowBox[{"2", 
                  RowBox[{"Sin", "[", "\[Phi]", "]"}], 
                  RowBox[{"(", 
                   RowBox[{"j", "-", "1"}], ")"}], 
                  RowBox[{"U", "[", 
                   RowBox[{
                    FractionBox["\[Pi]", "2"], "+", "\[Phi]"}], "]"}]}]}], ",", 
                RowBox[{"2", "\[Phi]"}], ",", "1"}], "}"}], ",", "Null"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "i"}], "}"}]}], "]"}], ",", "2"}], "]"}], "/.", 
      RowBox[{"Null", "\[Rule]", 
       RowBox[{"Sequence", "[", "]"}]}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.631637006298383*^9, 3.631637024285719*^9}, {
  3.631637112931712*^9, 3.631637323473228*^9}, {3.631637391885516*^9, 
  3.631637535759861*^9}, {3.631637569729216*^9, 3.631637581162566*^9}, {
  3.631637622812368*^9, 3.631637625422478*^9}, {3.63163766291064*^9, 
  3.6316376863267717`*^9}, {3.631637718124002*^9, 3.631637778991724*^9}, {
  3.631638120231217*^9, 3.631638161388494*^9}},
 CellLabel->
  "In[3320]:=",ExpressionUUID->"4cf43aef-3f71-4d8d-a8e9-bd3642d6a0bd"],

Cell["Example", "Text",
 CellChangeTimes->{{3.631637794496359*^9, 
  3.631637795293923*^9}},ExpressionUUID->"6400d052-b472-4709-9f27-\
51d653ccbab4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "patch", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"patch", "=", 
      RowBox[{"GoldbergPatch", "[", 
       RowBox[{"7", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<patch = \>\"", ",", 
       RowBox[{"ColumnForm", "[", "patch", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"EmbedTiling", "[", 
        RowBox[{"patch", ",", "Tiling", ",", 
         RowBox[{"TileIndices", "\[Rule]", "True"}], ",", 
         RowBox[{"TileVertexIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.631638020316904*^9, 3.6316380708122463`*^9}, {
   3.631638169755094*^9, 3.631638195952936*^9}, {3.631638996923338*^9, 
   3.63163899914526*^9}, 3.631639086100863*^9},
 CellLabel->
  "In[3321]:=",ExpressionUUID->"9937a099-3629-49a3-ac3f-9950cceac07a"],

Cell[TextData[{
 "GoldbergTiling[",
 StyleBox["m, n",
  FontSlant->"Italic"],
 "] returns the full rotationally symmetric Goldberg tiling, i.e., ",
 StyleBox["m",
  FontSlant->"Italic"],
 " copies of the patch. Options are:\n\tSimplify, Numeric are passed through \
to JoinTilingPatches."
}], "Text",
 CellChangeTimes->{{3.631638338562528*^9, 3.631638355585402*^9}, {
  3.631638502830258*^9, 3.6316385088315372`*^9}, {3.631639179987857*^9, 
  3.631639194298994*^9}},ExpressionUUID->"83c90e88-1684-4af1-a688-\
f1c75cea9f6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GoldbergTiling", "[", 
   RowBox[{"m_", ",", "n_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "patch", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"patch", "=", 
      RowBox[{"GoldbergPatch", "[", 
       RowBox[{"m", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"JoinTilingPatches", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"patch", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "-", "1"}], ",", "1", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "m"}], "}"}]}], "]"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.631638553685767*^9, 3.631638585520419*^9}, {
  3.631638838836226*^9, 3.631638940376773*^9}, {3.631639124828227*^9, 
  3.631639128475544*^9}, {3.631639197266073*^9, 3.631639204665434*^9}, {
  3.6316393235749197`*^9, 3.631639345091316*^9}},
 CellLabel->
  "In[3322]:=",ExpressionUUID->"3616d123-fa71-4cc8-ae50-8d143c8fdd53"],

Cell["Example", "Text",
 CellChangeTimes->{{3.631638944204752*^9, 
  3.631638944955076*^9}},ExpressionUUID->"fd607cfb-b713-4d83-b0ad-\
c80e4640a0b6"],

Cell[BoxData[
 RowBox[{
