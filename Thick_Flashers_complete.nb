      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuu", "=", 
      RowBox[{"SurfaceNormalFromSurface", "[", 
       RowBox[{"ss1", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uuu = \>\"", ",", 
       RowBox[{"uuu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "curve", " ", "function", " ", "and", " ", "surface", " ", "normal", " ",
        "on", " ", "one", " ", "variable"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ff = \>\"", ",", 
