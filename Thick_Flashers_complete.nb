  3.799345075334005*^9}},ExpressionUUID->"9aac24a8-67f0-429c-834f-\
3f6e80c78c31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Sigma]", ",", "\[Theta]", ",", "bb", ",", "dd", ",", "ui", ",", "bi", 
      ",", "uui", ",", "di", ",", "\[Beta]", ",", "b", ",", "d", ",", "s", ",",
       "u0", ",", "u1", ",", "v0", ",", "v1", ",", "cc", ",", "c"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"a", " ", "cone"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "#", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "initial", " ", "conditions", " ", "that", " ", "put", " ", "the", " ",
         "surface", " ", "in", " ", "the", " ", "x"}], "-", 
       RowBox[{"y", " ", "plane"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "bi", ",", "di", ",", "uui"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "desired", " ", "normal", " ", "curvature", " ", "to", " ", "achieve", " ",
        "flatness"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"interpolation", " ", "range"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], "=", 
      RowBox[{"NReshapeCone3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}], ",", "\[Beta]", ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bi", ",", "di", ",", "uui"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"plot", " ", "range"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"pick", " ", "a", " ", "value", " ", "of", " ", "\[Theta]"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "a", " ", "directed", " ", "cross", " ", "curve"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"bb", "[", "s", "]"}], "+", " ", 
         RowBox[{"dd", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"b", "[", "s", "]"}], "+", " ", 
         RowBox[{"d", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"bb", ",", "dd", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"StyledCurve", "[", 
               RowBox[{"cc", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"b", ",", "d", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"StyledCurve", "[", 
               RowBox[{"c", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Styled2DAxes", "[", 
              RowBox[{"2", ",", "2"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"StyledRuledPatch", "[", 
              RowBox[{
               RowBox[{"Planarize", "[", "b", "]"}], ",", 
               RowBox[{"Planarize", "[", "d", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"StyledCurve", "[", 
              RowBox[{
               RowBox[{"Planarize", "[", "c", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", 
               RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], "]"}]}], "}"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
