          RowBox[{"cr", "+", 
           RowBox[{"vr", " ", "dr"}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"vl", "+", "vr"}], "\[Equal]", "v0"}]}], "}"}]}], ";", 
