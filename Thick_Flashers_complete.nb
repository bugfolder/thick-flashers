Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bb", ",", "dd", ",", "\[Sigma]", ",", "\[Tau]", ",", "ui", ",", "bbi", ",",
       "uui", ",", "ddi", ",", "b", ",", "d", ",", "u0", ",", "u1", ",", "v0",
       ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         FractionBox["#", "2"]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         FractionBox["1", "2"]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"\[Sigma]", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"torsion", " ", "for", " ", "flat", " ", "shape"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "initial", " ", "conditions", " ", "in", " ", "the", " ", "flat", " ", 
       "state"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "bbi", ",", "ddi", ",", "uui"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], "=", 
      RowBox[{"ReshapeTandev3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}], ",", "\[Tau]", ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "ddi", ",", "uui"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<b = \>\"", ",", 
       RowBox[{"b", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<d = \>\"", ",", 
       RowBox[{"d", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"plot", " ", "range"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
