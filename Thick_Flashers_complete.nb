     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sov", ",", "srv", ",", "stv", ",", "sop", ",", "srp", ",", "stp", ",", 
      "odi", ",", "q", ",", "z", ",", "t", ",", "gg", ",", "mm", ",", "mji", ",",
       "mni", ",", "glist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{
      "tobj", ",", "TDegree4Vertex3D", ",", 
       "Degree4Vertex3DFoldedFormGraphics3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sov", "=", 
      RowBox[{
       RowBox[{"ShowOsculatingVector", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"srv", "=", 
      RowBox[{
       RowBox[{"ShowRulingVector", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
