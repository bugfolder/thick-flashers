Cell[TextData[{
 "TranslateGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph3D"
}], "Subsubsection",
 CellChangeTimes->{{3.64311470316569*^9, 3.643114714121904*^9}, 
   3.6431152414981947`*^9},ExpressionUUID->"3bb684a6-b833-4f23-8fd2-\
7ff5bd428e94"],

Cell[TextData[{
 "TranslateGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] takes a TGraph3D tobj and translates the folded form by the vector ",
 StyleBox["r",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.6431152728318787`*^9, 
  3.643115296132723*^9}},ExpressionUUID->"a4f1eb8d-1bd0-45f4-a309-\
a1d2bee1f3c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TranslateGraph3D", "[", 
   RowBox[{"tobj_TObj", ",", " ", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts3d", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "TranslateGraph3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices3D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "+", "r"}], "&"}], "/@", "verts3d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices3D", "\[Rule]", "verts3d"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.643114793507264*^9, 3.643114793511322*^9}, {
