Cell[CellGroupData[{

Cell[TextData[{
 "GaussianSphericalAngleLabels[",
 StyleBox["sectorvectors",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[CircularAngleLabels], Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{{3.5975203684482937`*^9, 3.597520389428972*^9}, {
   3.5975204905436172`*^9, 3.597520499501436*^9}, {3.597522786795901*^9, 
   3.597522839415637*^9}, 3.597525578132352*^9, 3.597525626405541*^9, {
   3.597676434213431*^9, 
   3.597676444273759*^9}},ExpressionUUID->"d9bf0d40-a8d7-48de-b4cc-\
4555764f0432"],

Cell[TextData[{
 "GaussianSphericalAngleLabels[",
 StyleBox["foldvectors",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of sector vectors and returns a list of Graphics3D elements \
that place the specified label text (from options) along circular arcs of the \
dihedrals and outside of the sector vectors. Works for ",
 StyleBox["sectorvectors",
  FontSlant->"Italic"],
 " in any order (e.g., folded form), but it is assumed that the angle between \
consecutive vectors is acute and if two consective vectors are collinear, a \
numerical error will occur. Options are:\n\tOptions[CircularAngleLabels] are \
passed through\n\tOptions[Graphics] are passed through"
}], "Text",
 CellChangeTimes->{{3.597508031667361*^9, 3.597508112830171*^9}, {
   3.597508144123841*^9, 3.597508222174515*^9}, {3.597508256718464*^9, 
   3.597508313128911*^9}, {3.597508496438937*^9, 3.5975084967094297`*^9}, {
