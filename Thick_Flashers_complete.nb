                RowBox[{"-", "t"}], ",", "t"}], "}"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", "MidfoldNormalLine"}]}], "]"}], 
            "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"tangent", " ", "vector"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"sop", ",", 
           RowBox[{"{", 
            RowBox[{"Styled3DUnitDiskFromInPlaneVectors", "[", 
             RowBox[{
              RowBox[{"gg", "\[LeftDoubleBracket]", 
               RowBox[{
               "mji", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"gg", "\[LeftDoubleBracket]", 
