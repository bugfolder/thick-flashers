Cell[TextData[{
 "IntervalSetMinus[",
 StyleBox["is",
  FontSlant->"Italic"],
 ", {",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "}] returns the interval set ",
 StyleBox["is",
  FontSlant->"Italic"],
 " with interval {",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "} removed."
}], "Text",
 CellChangeTimes->{{3.4847518707729187`*^9, 3.484751881092127*^9}, {
  3.484751933144925*^9, 
  3.484751979653833*^9}},ExpressionUUID->"3cc75da7-2c0c-4e96-b594-\
3bc714ac0a4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntervalSetMinus", "[", 
   RowBox[{"is_", ",", 
    RowBox[{"{", "}"}]}], "]"}], ":=", "is"}]], "Input",
 CellChangeTimes->{{3.484767543946035*^9, 3.484767556721394*^9}},
 CellLabel->
  "In[545]:=",ExpressionUUID->"3716655f-78a6-46a5-b5b6-079348b3279f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntervalSetMinus", "[", 
   RowBox[{"is_", ",", 
    RowBox[{"{", 
     RowBox[{"s_", ",", "t_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ret", "=", 
       RowBox[{"{", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"iss", ",", "\[IndentingNewLine]", 
         RowBox[{"Which", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"s", ">", 
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
            "&&", 
            RowBox[{"t", "<", 
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "2", 
              "\[RightDoubleBracket]"}]}]}], ",", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"ret", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "iss", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
                 ",", "s"}], "}"}]}], "]"}], ";", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"ret", ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{
                "iss", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ",", 
           RowBox[{"(*", " ", 
            RowBox[{"within", " ", "this", " ", "interval"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"s", ">", 
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
            "||", 
            RowBox[{"t", "<", 
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"ret", ",", "iss"}], "]"}], ",", 
           RowBox[{"(*", " ", 
            RowBox[{"entirely", " ", "outside", " ", "the", " ", "interval"}],
             " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"s", "\[LessEqual]", 
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
            "&&", 
            RowBox[{"t", "\[GreaterEqual]", 
             RowBox[{
             "iss", "\[LeftDoubleBracket]", "2", 
              "\[RightDoubleBracket]"}]}]}], ",", "Null", ",", 
           RowBox[{"(*", " ", 
            RowBox[{"covers", " ", "the", " ", "interval"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"s", "\[LessEqual]", 
            RowBox[{
            "iss", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"ret", ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", 
               RowBox[{
               "iss", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"(*", " ", 
            RowBox[{"overlap", " ", "at", " ", "beginning"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"t", "\[GreaterEqual]", 
            RowBox[{
            "iss", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"ret", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
               "iss", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               ",", "s"}], "}"}]}], "]"}]}], " ", 
          RowBox[{"(*", " ", 
           RowBox[{"overlap", " ", "at", " ", "end"}], " ", "*)"}], 
          "\[IndentingNewLine]", "]"}]}], "]"}], "/@", "is"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"IntervalSetCleanup", "[", "ret", "]"}]}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"Dimensions", "[", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t"}], "}"}], "]"}], "]"}], "\[Equal]", 
    "1"}]}]}]], "Input",
 CellChangeTimes->{{3.484751998225936*^9, 3.484752022195515*^9}, {
   3.4847520658756313`*^9, 3.484752116479073*^9}, {3.484752177763136*^9, 
