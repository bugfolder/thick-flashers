Cell[TextData[{
 "MakeAlternatingMinorConnectedUnitChain[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "L"], ",", 
     SubscriptBox["w", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "f856b2e4-f65b-4541-8a6b-9b6b482f5719"],
 StyleBox["}, opts",
  FontSlant->"Italic"],
 "] takes a list of four sector angles and returns a TLinearChain that is a \
chain of ",
 StyleBox["n+1",
  FontSlant->"Italic"],
 " of these vertices spaced unit distance apart and connected along their ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "56b834a9-b08e-4807-a91b-f9cfead5b868"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "3"], TraditionalForm]],ExpressionUUID->
  "ed6c94e9-89db-4da3-be39-9656744f0e9c"],
 " folds, assumed to be minor-connected so that the creases alternate along \
the spine; ",
 StyleBox["type",
  FontSlant->"Italic"],
 " specifies the first vertex. We alternate the orientation of consecutive \
vertices, so that the resulting crease pattern is always periodic."
}], "Text",
