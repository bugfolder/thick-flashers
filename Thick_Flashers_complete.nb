 RowBox[{
  RowBox[{"ReplaceProperties", "[", "rules_List", "]"}], ":=", 
  RowBox[{
   RowBox[{"ReplacePropertiesIn", "[", 
    RowBox[{"#", ",", "rules"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.592707800368073*^9, 3.592707818367946*^9}, {
