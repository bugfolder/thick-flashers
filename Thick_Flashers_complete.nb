Cell[BoxData[
 RowBox[{
  RowBox[{"MakePinHingeParts", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "q_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dh", ",", "da", ",", "do", ",", "dc", ",", "le", ",", "la", ",", "lg", ",",
       "lh", ",", "sk", ",", "m", ",", "pq", ",", "lpq", ",", "lmin", ",", 
      "lb", ",", "x", ",", "y", ",", "z", ",", "\[Phi]", ",", "cir", ",", 
      "cyl", ",", "cu1", ",", "cu2", ",", "kn1", ",", "kn2", ",", "ho1", ",", 
      "ho2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "dh", ",", "do", ",", "dc", ",", "le", ",", "la", ",", "lg", ",", "lh",
         ",", "sk", ",", "m"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "PinHingeHoleDia", ",", "PinHingeOuterDia", ",", "PinHingeClearance",
           ",", "PinHingeEndLength", ",", "PinHingeAccessLength", ",", 
          "PinHingeMinGapLength", ",", "PinHingeMaxHingeLength", ",", 
          "PinHingeScaleKnuckles", ",", "RoundingDivisions"}], "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakePinHingeParts", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "la", "]"}], "=!=", "List"}], ",", 
       RowBox[{"la", "=", 
        RowBox[{"{", 
         RowBox[{"la", ",", "la"}], "}"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"lh", " ", "<", " ", 
        RowBox[{
         RowBox[{"3", "le"}], "+", 
         RowBox[{"2", "dc"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakePinHingeParts", "::", "badmax"}], ",", "lh", ",", 
          RowBox[{
           RowBox[{"3", "le"}], "+", 
           RowBox[{"2", "dc"}]}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pq", "=", 
      RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lpq", "=", 
      RowBox[{"Mag", "[", "pq", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Check", " ", "distances", " ", "to", " ", "make", " ", "sure", " ", 
       RowBox[{"we", "'"}], "ve", " ", "got", " ", "enough", " ", "room", " ",
        "for", " ", "all", " ", "the", " ", "parts"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"lmin", "=", 
      RowBox[{
       RowBox[{"3", "le"}], "+", 
       RowBox[{"2", "dc"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"lpq", " ", "<", " ", "lmin"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"le", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"lpq", "-", 
             RowBox[{"2", "dc"}]}], ")"}], "/", "3"}], "-", "0.01"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Compute", " ", "a", " ", "value", " ", "of", " ", "le", " ", "that",
           " ", "will", " ", 
          RowBox[{"work", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", "sk"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"MakePinHingeParts", "::", "badlen"}], ",", "lpq", ",", 
             "lmin", ",", "le"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "buffer", " ", "if", " ", "needed", " ", "to", " ", 
       "keep", " ", "total", " ", "length", " ", "under", " ", "lh"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"lb", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"0", ",", 
        RowBox[{"0.5", 
         RowBox[{"(", 
          RowBox[{"lpq", "-", "lh"}], ")"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"local", " ", "coordinate", " ", "system"}], ",", " ", 
       RowBox[{"x", " ", "is", " ", "along", " ", "the", " ", "axis"}], ",", 
       " ", 
       RowBox[{"y", " ", "and", " ", "z", " ", "are", " ", "transverse"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{"pq", "/", "lpq"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "\[Cross]", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", 
            RowBox[{"x", "\[Cross]", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
            RowBox[{"x", "\[Cross]", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Mag", "[", "#1", "]"}], ">", 
            RowBox[{"Mag", "[", "#2", "]"}]}], "&"}]}], "]"}], "\[LeftDoubleBracket]",
         "1", "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"z", "=", 
      RowBox[{"x", "\[Cross]", "y"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"A", " ", "2", "D", " ", "CW", " ", "circle"}], ",", " ", 
       RowBox[{
       "used", " ", "for", " ", "computation", " ", "of", " ", "cylinders"}], 
       ",", " ", 
       RowBox[{"scaled", " ", "to", " ", "have", " ", "unit", " ", 
        RowBox[{"diameter", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cir", "=", 
      RowBox[{"0.5", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "=", 
           RowBox[{"N", "[", 
            FractionBox[
             RowBox[{"2", "\[Pi]", " ", "k"}], "m"], "]"}]}], ";", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"cyl", "[", "]"}], " ", "creates", " ", "a", " ", "cylinder", " ",
        "of", " ", "diameter", " ", "d", " ", "between", " ", "distances", " ",
        "l1", " ", "and", " ", "l2", " ", "along", " ", "the", " ", "axis"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cyl", "[", 
       RowBox[{"l1_", ",", "l2_", ",", "d_"}], "]"}], ":=", 
      RowBox[{"GraphicsComplex", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"p", "+", 
             RowBox[{"l1", " ", "x"}], "+", 
             RowBox[{"d", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "y"}], "+", 
             RowBox[{"d", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "z"}]}], "&"}], "/@", "cir"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "+", 
             RowBox[{"l2", " ", "x"}], "+", 
             RowBox[{"d", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "y"}], "+", 
             RowBox[{"d", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "z"}]}], "&"}], "/@", "cir"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"Range", "[", "m", "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Polygon", "/@", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"1", ",", "m"}], "]"}], ",", "\[IndentingNewLine]", 
               RowBox[{"m", "+", 
                RowBox[{"Range", "[", 
                 RowBox[{"1", ",", "m"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"m", "+", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"Range", "[", 
                   RowBox[{"2", ",", 
                    RowBox[{"m", "+", "1"}]}], "]"}], ",", "m", ",", "1"}], 
                 "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"2", ",", 
                   RowBox[{"m", "+", "1"}]}], "]"}], ",", "m", ",", "1"}], 
                "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"Polygon", "[", 
            RowBox[{"Reverse", "[", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"m", "+", "1"}], ",", 
               RowBox[{"2", "m"}]}], "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Create", " ", "our", " ", "lists"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cu1", "=", 
      RowBox[{"cu2", "=", 
       RowBox[{"kn1", "=", 
        RowBox[{"kn2", "=", 
         RowBox[{"{", "}"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "cutouts", " ", "for", " ", "both", " ", "parts"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cu1", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cyl", "[", 
         RowBox[{
          RowBox[{"lb", "-", 
           RowBox[{
           "la", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"lb", "+", "le", "+", 
           RowBox[{"2", "dc"}]}], ",", 
          RowBox[{"do", "+", "dc"}]}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
         "end", " ", "access", " ", "and", " ", "an", " ", "outer", " ", 
          "knuckle"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"cyl", "[", 
         RowBox[{
          RowBox[{"lb", "+", "le", "+", "dc"}], ",", 
          RowBox[{"lpq", "-", "lb", "-", "le", "-", "dc"}], ",", 
          RowBox[{"do", "-", "dc"}]}], "]"}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "attachment", " ", "for", " ", "the", " ", "middle", " ", "knuckle", 
          
          RowBox[{"(", "s", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"cyl", "[", 
         RowBox[{
          RowBox[{"lpq", "-", "lb", "-", "le", "-", 
           RowBox[{"2", "dc"}]}], ",", 
          RowBox[{"lpq", "-", "lb", "+", 
           RowBox[{
           "la", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"do", "+", "dc"}]}], "]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "end", " ", "access", " ", "and", " ", "an", " ", "outer", " ", 
       "knuckle"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cu2", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cyl", "[", 
