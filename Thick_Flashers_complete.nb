Cell[TextData[{
 "Example. Two panels joined by a single hinge. Show the ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", the panels (with indices), and the panels after joining with a single \
hinge along edge 4. We set HingeShift to True, so that the hinge ends up \
coplanar with the tops of the panels."
}], "Text",
 CellChangeTimes->{{3.91579765322408*^9, 3.915797672063515*^9}, {
  3.9157996674351807`*^9, 3.9157996701481667`*^9}, {3.915799827753884*^9, 
  3.915799851505288*^9}, {3.922548835200149*^9, 
  3.9225488818864803`*^9}},ExpressionUUID->"e8c6fbc8-955c-4ba7-88c7-\
ba71d54a2da2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "tobj", ",", "panel1", ",", 
      "panel2", ",", "panels", ",", "panelinfo", ",", "joinedpanels"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTPlaneGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphGraphics", "[", "tobj", "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"panel1", "=", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "5", ",", "4"}], "}"}], 
            "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", 
              RowBox[{"-", "0.5"}]}], "]"}], "&"}], "/@", 
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "5", ",", "4"}], "}"}], 
            "\[RightDoubleBracket]"}]}]}], "]"}], ",", 
        RowBox[{"Polygon", "/@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "8", ",", "7", ",", "6"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "5", ",", "6", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "6", ",", "7", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "7", ",", "8", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "8", ",", "5", ",", "1"}], "}"}]}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"panel2", "=", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3", ",", "6", ",", "5"}], "}"}], 
            "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{"#", ",", 
              RowBox[{"-", "0.5"}]}], "]"}], "&"}], "/@", 
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3", ",", "6", ",", "5"}], "}"}], 
            "\[RightDoubleBracket]"}]}]}], "]"}], ",", 
        RowBox[{"Polygon", "/@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "8", ",", "7", ",", "6"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "5", ",", "6", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "6", ",", "7", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "7", ",", "8", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "8", ",", "5", ",", "1"}], "}"}]}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"panels", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"InsetGC", "[", 
         RowBox[{"#", ",", "0.05"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"panel1", ",", "panel2"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"panels", ",", "SolidStyle"}], "]"}], ",", 
         RowBox[{"AllLabelsGC", "/@", "panels"}]}], "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"panelinfo", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"4", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"4", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "4"}], "}"}]}], "}"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"joinedpanels", "=", 
      RowBox[{"HingeJoinPanels", "[", 
       RowBox[{
       "panels", ",", "panelinfo", ",", "tobj", ",", "\[IndentingNewLine]", 
        RowBox[{"HingeThickness", "->", "0.1"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeShift", "->", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"Style", "[", 
       RowBox[{"joinedpanels", ",", "SolidStyle"}], "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.915797682007189*^9, 3.915797827925229*^9}, {
   3.91579789005168*^9, 3.915797917609844*^9}, {3.915797959756599*^9, 
