   3.799446814241265*^9, 3.799446818717243*^9}, {3.799447005893299*^9, 
   3.799447039941052*^9}, {3.799447357683578*^9, 3.799447374342366*^9}, {
   3.7994474194792767`*^9, 3.799447424140409*^9}, {3.799447502390861*^9, 
   3.799447513082161*^9}, {3.799500422193101*^9, 3.799500503855503*^9}, {
   3.799525566633803*^9, 3.799525566642178*^9}, {3.799710350596022*^9, 
   3.799710544333111*^9}, {3.799710587705365*^9, 3.7997106048289003`*^9}, {
   3.799710638887745*^9, 3.799710724212298*^9}, {3.799747354403435*^9, 
   3.799747580289886*^9}, 3.799747827418819*^9, {3.799748231585887*^9, 
   3.799748377826348*^9}, {3.799748629780873*^9, 3.799748635693487*^9}, {
   3.7999384299195147`*^9, 3.7999384401982183`*^9}, {3.799938495030693*^9, 
