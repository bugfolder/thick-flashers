     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"elist", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"verts", ",", "edges"}], "]"}]}]}], "]"}]}]], "Input",
