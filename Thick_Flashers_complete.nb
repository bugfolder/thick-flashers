            RowBox[{"TilePolys", "\[Rule]", "True"}], ",", " ", 
            RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowDF"}]}], "]"}],
           "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6298263240615673`*^9, 3.629826442238137*^9}, {
