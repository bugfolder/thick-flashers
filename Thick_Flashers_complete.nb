Cell[TextData[{
 "ConvexHullifyEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{
  3.455897938655779*^9, 3.462972309253223*^9, {3.591651034708015*^9, 
   3.591651044231863*^9}, 3.591728608748377*^9, 3.592431910364458*^9, 
