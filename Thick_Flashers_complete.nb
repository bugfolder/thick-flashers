   3.592648918587875*^9}, 3.592668608266013*^9, {3.5928287704471493`*^9, 
   3.592828770580637*^9}, 3.5930061018369417`*^9, {3.594229267515623*^9, 
   3.594229270291891*^9}, {3.594229384442715*^9, 3.594229461085399*^9}, {
   3.594229542129318*^9, 3.594229556738537*^9}, {3.594230156555396*^9, 
   3.594230160237366*^9}, {3.594230205874853*^9, 3.594230321592283*^9}, {
   3.594230455328843*^9, 3.594230466833043*^9}, {3.594231962651958*^9, 
