Cell["Example", "Text",
 CellChangeTimes->{{3.484779572481299*^9, 
  3.484779573184021*^9}},ExpressionUUID->"a27351e2-73d5-4446-b756-\
bad1ddacc5ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "faces", ",", "tobj", ",", "fc"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"i", "-", "1", "+", 
             RowBox[{"0.1", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "i"]}]}], ",", 
            RowBox[{"j", "-", "1", "+", 
             RowBox[{"0.1", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "j"]}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{"4", 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", "1", "+", 
               RowBox[{"4", 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{"4", 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", 
               RowBox[{"4", 
                RowBox[{"(", "j", ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "6", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "7", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4", ",", "8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6", ",", "10", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7", ",", "11", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8", ",", "12", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "10", ",", "14", ",", "13"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "11", ",", "15", ",", "14"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"11", ",", "12", ",", "16", ",", "15"}], "}"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{"TwoColorGraph", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"StartFace", "\[Rule]", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"FaceColoring", "\[Rule]", "fc"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<2-coloring = \>\"", " ", "<>", " ", 
      RowBox[{"ToString", "[", "fc", "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.458257163865542*^9, 3.458257166549923*^9}, {
   3.4582607853270273`*^9, 3.4582609556404057`*^9}, 3.462733423003314*^9, {
   3.4627396782930813`*^9, 3.462739679976206*^9}, 3.484777342036934*^9, {
   3.484779589274334*^9, 3.48477962024759*^9}, {3.4847796549486647`*^9, 
   3.4847796651400833`*^9}, {3.484779951466679*^9, 3.48478003520364*^9}, {
   3.484780109213048*^9, 3.484780124222905*^9}, {3.484781115728162*^9, 
   3.484781147522542*^9}, {3.484782110435093*^9, 3.484782114057201*^9}, {
   3.484784356609557*^9, 3.484784357117566*^9}, 3.4848199769982347`*^9, 
   3.48482907562849*^9, 3.484832614935932*^9, {3.591729278698822*^9, 
   3.591729332764187*^9}, 3.5917370118508883`*^9, 3.592039961764346*^9, {
   3.592049656478064*^9, 3.592049693422278*^9}, 3.592208506598251*^9, 
   3.59234430385511*^9, 3.592345817386104*^9, 3.592352146658889*^9, {
