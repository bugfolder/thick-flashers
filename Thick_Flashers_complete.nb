Cell[TextData[{
 "VisibleFoldedFormGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a rendering of both lines and \
polygons in the folded form in which visible and covered lines are rendered \
so that visible folded lines are rendered with style FoldedLine, visible \
border lines are rendered with style BorderLine,  and hidden folded and \
border lines are rendered with style HiddenFoldedLine."
}], "Text",
 CellChangeTimes->{{3.484787748006262*^9, 3.484787891652704*^9}, {
   3.48478794161732*^9, 3.484788037106747*^9}, {3.48478810061495*^9, 
   3.484788163154502*^9}, {3.4848275401639156`*^9, 3.484827578601107*^9}, {
   3.485097492326007*^9, 3.485097496591601*^9}, {3.485098008741965*^9, 
   3.485098010372506*^9}, 3.485099458611467*^9, {3.59180677457073*^9, 
   3.5918067955757227`*^9}, 3.592179960472309*^9, 3.592208054709587*^9, 
   3.592433636610697*^9, 3.592435751364004*^9, 3.592828894333891*^9, 
   3.592871225216904*^9, {3.59301882614636*^9, 3.593018841282997*^9}, 
   3.5947352680982*^9, {3.594735775059046*^9, 3.594735798728131*^9}, 
   3.595200709655954*^9, {3.627769179069948*^9, 3.627769179972609*^9}, 
   3.6288916086467133`*^9, 3.6289485270784073`*^9, 3.628949765174724*^9, 
   3.628950648352256*^9, {3.628961163489501*^9, 3.6289612452601*^9}, {
   3.6289671906516957`*^9, 3.628967191275285*^9}, {3.62896736686715*^9, 
   3.628967372431443*^9}, {3.707923549431055*^9, 
   3.707923550895327*^9}},ExpressionUUID->"3273db23-dd4a-4463-908f-\
3f42f34f8a56"],

Cell[TextData[{
 "Options:\n\tPaperFill \[Rule] PaperWhiteSideFill | PaperColoredSideFill, \
specifies the color of the paper that will be used to render all polygons.\t\n\
\tFacesAbove \[Rule] ",
 StyleBox["fa",
  FontSlant->"Italic"],
 " | Automatic, where ",
 StyleBox["fa",
  FontSlant->"Italic"],
 " is a list of of the face indices that lie above each face. Automatic means \
we calculate it using our own algorithm, which will make use of FaceupFace, \
see next.\n\tFaceupFace \[Rule] ",
 StyleBox["fuface",
  FontSlant->"Italic"],
 " specifies a face-up face if we have to calculate our own facet ordering.\n\
\tShowProgress \[Rule] True | False, if true, display some graphs showing the \
relationships that are used along the way.\n\tReportInconsistentOrdering \
\[Rule] True | False, if true, post a Message if an inconsistent ordering was \
detected; passed through to FacesAboveAutomatic (if used).\n\t\
Options[Graphics] are passed through."
}], "Text",
 CellChangeTimes->{{3.707923553063154*^9, 
  3.707923582360969*^9}},ExpressionUUID->"20f4404d-71fd-495f-84b6-\
2d2bf343b6ad"],

Cell["\<\
Note that by switching the FaceupFace to a face of the opposite parity and \
flopping the folded form using FlopGraph2D, you can effectively \
\[OpenCurlyDoubleQuote]turn over\[CloseCurlyDoubleQuote] the folded form.\
\>", "Text",
 CellChangeTimes->{{3.627769187748349*^9, 
  3.627769233352668*^9}},ExpressionUUID->"44dfcb0c-0d83-4205-80d9-\
dbd12e69cdf2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VisibleFoldedFormGraphics", "[", 
   RowBox[{"tobj_TObj", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph2D", ",", "TAssigned"}], "}"}], ",", 
       "VisibleFoldedFormGraphics"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FoldedFormPolys", "[", 
          RowBox[{"tobj", ",", "opts"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormLines", "[", 
          RowBox[{"tobj", ",", "opts"}], "]"}]}], "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
