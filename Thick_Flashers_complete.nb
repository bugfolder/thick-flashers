Cell[BoxData[
 RowBox[{
  RowBox[{"MatchCurvesPair", "[", 
   RowBox[{
   "c_Function", ",", "cc_Function", ",", "\[Psi]_", ",", "\[Sigma]_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "c2dsys", ",", "ds", ",", 
      "\[Kappa]l", ",", "t", ",", "l", ",", "c3dsys", ",", "tt", ",", "nn", ",",
       "bb", ",", "\[Kappa]", ",", "c\[Eta]", ",", "s\[Eta]", ",", "ll", ",", 
      "uu", ",", "duu", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "dd", ",", 
      "d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MatchCurvesPair", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MatchCurvesPair", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c2dsys", "=", 
      RowBox[{"Curve2DSystem", "[", 
       RowBox[{"c", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed2D", ",", "LeftCurvature2D", ",", "TangentVector2D", ",", 
         "LeftNormalVector2D"}], "}"}], "/.", "c2dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c3dsys", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"cc", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "nn", ",", "bb", ",", "\[Kappa]"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector3D", ",", "NormalVector3D", ",", "BinormalVector3D", ",",
          "Curvature3D"}], "}"}], "/.", "c3dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Eta]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{"\[Kappa]l", "[", "s", "]"}], 
          RowBox[{"\[Kappa]", "[", "s", "]"}]], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"s\[Eta]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Psi]", 
          FractionBox[
           SqrtBox[
            RowBox[{
             SuperscriptBox[
              RowBox[{"\[Kappa]", "[", "s", "]"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"\[Kappa]l", "[", "s", "]"}], "2"]}]], 
           RowBox[{"\[Kappa]", "[", "s", "]"}]]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ll", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"c\[Eta]", "[", "s", "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "-", 
          RowBox[{
           RowBox[{"s\[Eta]", "[", "s", "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"s\[Eta]", "[", "s", "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "+", 
          RowBox[{
           RowBox[{"c\[Eta]", "[", "s", "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"uu", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"duu", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
          RowBox[{"Mag", "[", 
           RowBox[{"duu", "[", "s", "]"}], "]"}]], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sign", "[", 
            RowBox[{
             RowBox[{"duu", "[", "s", "]"}], ".", 
             RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
          FractionBox[
           RowBox[{
            RowBox[{"duu", "[", "s", "]"}], ".", 
            RowBox[{"ll", "[", "s", "]"}]}], 
           RowBox[{"Mag", "[", 
            RowBox[{"duu", "[", "s", "]"}], "]"}]]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
             RowBox[{"tt", "[", "s", "]"}]}], "+", 
            RowBox[{
             RowBox[{"s\[Rho]L", " ", "[", "s", "]"}], 
             RowBox[{"ll", "[", "s", "]"}]}]}], ")"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
             RowBox[{"t", "[", "s", "]"}]}], "+", 
            RowBox[{
             RowBox[{"s\[Rho]L", "[", "s", "]"}], " ", 
             RowBox[{"l", "[", "s", "]"}]}]}], ")"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d", ",", "cc", ",", "dd"}], "}"}]}]}], 
   "]"}]}]], "Input",
