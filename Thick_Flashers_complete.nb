     RowBox[{
     "bb", ",", "dd", ",", "\[Sigma]", ",", "\[Tau]", ",", "ui", ",", "bbi", ",",
       "uui", ",", "ddi", ",", "b", ",", "d", ",", "u0", ",", "u1", ",", "v0",
       ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"b", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          FractionBox[
           RowBox[{"4", " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", 
              FractionBox[
               RowBox[{
                SqrtBox["3"], " ", "#"}], "4"], "]"}], "2"]}], 
           SqrtBox["3"]]}], ",", 
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{
              SqrtBox["3"], " ", "#"}], "2"], "]"}]}], 
          SqrtBox["3"]], ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", 
          FractionBox[
           RowBox[{
            SqrtBox["3"], " ", "#"}], "2"], "]"}], ",", 
         RowBox[{"Cos", "[", 
