Cell["Example", "Text",
 CellChangeTimes->{{3.442789586636066*^9, 
  3.4427895873529*^9}},ExpressionUUID->"25e2728f-8d0e-4e68-b107-89e94177a8e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gg", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gg", "=", 
      RowBox[{"MakeFlutedConeCreaseVectors", "[", 
       RowBox[{"4", ",", "3", ",", 
        RowBox[{"20.", "\[Degree]"}], ",", 
        RowBox[{"60.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Max Angle/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"gg", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"gg", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "/", 
        "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", "gg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Vertex3DGraphicsTrio", "[", "tobj", "]"}], "/.", 
      RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.442789588823144*^9, 3.442789642060728*^9}, {
   3.442789824081085*^9, 3.442789840498063*^9}, {3.442789939525285*^9, 
   3.4427899548106747`*^9}, {3.442789994240307*^9, 3.442790018727726*^9}, {
   3.442790062169926*^9, 3.442790066220835*^9}, {3.4427908315862703`*^9, 
   3.442790835278627*^9}, {3.442790913789002*^9, 3.442790946682885*^9}, {
   3.442791235097349*^9, 3.442791237218915*^9}, 3.533652375060907*^9, 
   3.533655037689882*^9, 3.533655684315387*^9, {3.533657026460974*^9, 
   3.533657043204387*^9}, 3.592082004602453*^9, {3.592153344698601*^9, 
   3.592153358665293*^9}, 3.5924370909894657`*^9, 3.5924371317425823`*^9, 
   3.5924371656208067`*^9, 3.592670438747651*^9, 3.592670633952137*^9, 
   3.592671073228701*^9, 3.592829170106765*^9, {3.5942325980667458`*^9, 
   3.594232679174009*^9}, 3.594806398211039*^9, {3.595017215899585*^9, 
   3.595017232425951*^9}, 3.616173724088966*^9},
 CellLabel->
  "In[2579]:=",ExpressionUUID->"0a60fc13-416d-4395-9587-a4f25b7e47f1"],

Cell[TextData[{
 "MakeFlutedConeCreaseVectors[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qmin",
  FontSlant->"Italic"],
 "] constructs the crease vectors for a fluted cone that has a total vertex \
angle of 2\[Pi], i.e., that can unfold flat. It works by solving numerically \
for the maximum angle that gives a flat-unfoldable vertex."
}], "Text",
 CellChangeTimes->{{3.4427892314855843`*^9, 3.442789273598959*^9}, {
  3.442790104090117*^9, 3.442790127042841*^9}, {3.533657104646612*^9, 
  3.533657105838388*^9}},ExpressionUUID->"d557f510-b553-4aa3-bd7a-\
c5618bbc37b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFlutedConeCreaseVectors", "[", 
   RowBox[{"m_", ",", "k_", ",", "qmin_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qmax", ",", "gg", ",", "gg0", ",", "alt"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gg", "=", 
      RowBox[{"MakeFlutedConeCreaseVectors", "[", 
       RowBox[{"m", ",", "k", ",", "qmin", ",", "qmax"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "the", " ", "full", " ", "vertex", " ", "with", " ", "symbolic", " ", 
       "qmax"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gg0", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"gg", ",", 
        RowBox[{"k", "+", "1"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "just", " ", "one", " ", "section", " ", "of", " ", "the", " ", 
       "fluting"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"alt", "=", 
      RowBox[{"2", " ", "m", " ", 
       RowBox[{"Plus", "@@", 
        RowBox[{"ArcSin", "/@", 
         RowBox[{"Mag", "/@", 
          RowBox[{"MapThread", "[", 
           RowBox[{"Cross", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Drop", "[", 
               RowBox[{"gg0", ",", "1"}], "]"}], ",", 
              RowBox[{"Drop", "[", 
               RowBox[{"gg0", ",", 
                RowBox[{"-", "1"}]}], "]"}]}], "}"}], ",", "1"}], 
           "]"}]}]}]}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"total", " ", "vertex", " ", "angle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gg", "/.", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"alt", "-", 
         RowBox[{"2", "\[Pi]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"qmax", ",", 
          RowBox[{"90", "\[Degree]"}]}], "}"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.442789282049184*^9, 3.442789472836125*^9}, {
  3.442790161142717*^9, 3.442790163386079*^9}, {3.442790236760575*^9, 
  3.442790258191686*^9}, {3.4427903135235558`*^9, 3.442790344856308*^9}, {
  3.442790375510637*^9, 3.4427903799431477`*^9}, {3.442790442327899*^9, 
  3.442790455116068*^9}, {3.4427904869689417`*^9, 3.44279061909898*^9}, {
  3.442790661463731*^9, 3.442790698573704*^9}, {3.442792519185255*^9, 
  3.442792526080368*^9}, {3.533657112484006*^9, 3.533657127090486*^9}, {
  3.592153410200303*^9, 3.592153433110931*^9}},
 CellLabel->
  "In[2580]:=",ExpressionUUID->"e9c2e94f-43d7-47f9-b9ad-756e000cbafd"],

Cell["\<\
Example. Note that from the first vector it's easy to pull out the maximum \
angle of the vertex, as shown.\
\>", "Text",
 CellChangeTimes->{{3.442790717117857*^9, 3.442790717853523*^9}, {
  3.442791126319145*^9, 3.4427911374991093`*^9}, {3.4427912008319697`*^9, 
  3.442791213533633*^9}},ExpressionUUID->"f0feba31-1129-4276-9b47-\
366ea02a978e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gg", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gg", "=", 
      RowBox[{"MakeFlutedConeCreaseVectors", "[", 
       RowBox[{"6", ",", "3", ",", 
        RowBox[{"20.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Max Angle/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"gg", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"gg", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "/", 
        "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", "gg", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"Vertex3DGraphicsTrio", "[", "tobj", "]"}], "/.", 
      RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.442789588823144*^9, 3.442789642060728*^9}, {
   3.442789824081085*^9, 3.442789840498063*^9}, {3.442789939525285*^9, 
   3.4427899548106747`*^9}, {3.442789994240307*^9, 3.442790018727726*^9}, {
   3.442790062169926*^9, 3.442790066220835*^9}, {3.44279063675593*^9, 
   3.4427906434489594`*^9}, {3.4427907253641233`*^9, 3.4427907390198307`*^9}, 
   3.442790779496457*^9, {3.4427909715909*^9, 3.44279104662335*^9}, {
   3.442791088100479*^9, 3.442791149867106*^9}, {3.442791311496521*^9, 
   3.442791312694378*^9}, 3.533652376836156*^9, 3.5336550391247*^9, 
   3.533655684383605*^9, {3.533657204299864*^9, 3.533657225769202*^9}, 
   3.592082004703113*^9, {3.592153441172254*^9, 3.592153466147147*^9}, 
   3.5924370910710917`*^9, 3.592437131842288*^9, 3.592437165720105*^9, 
   3.592670438845475*^9, 3.592670634045566*^9, 3.592671073329167*^9, 
   3.5928291702571*^9, {3.593039159496327*^9, 3.593039194831546*^9}, 
