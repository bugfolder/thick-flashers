}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "SameHalfPlaneQ[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r3",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.627507651471983*^9, 3.6275076617286386`*^9}, 
   3.627507743147135*^9},ExpressionUUID->"db3c9063-dc34-4f7c-b246-\
a9927f068f2e"],

Cell[TextData[{
 "SameHalfPlaneQ[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r3",
  FontSlant->"Italic"],
 "] returns True when all three direction vectors ",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["r3",
  FontSlant->"Italic"],
 " lie in the same half-plane. It will return True if any two of them are \
parallel or zero-length."
}], "Text",
 CellChangeTimes->{{3.627507663352675*^9, 3.627507691462282*^9}, {
  3.627507800498053*^9, 3.6275078374775257`*^9}, {3.627507879132371*^9, 
  3.627507881306563*^9}},ExpressionUUID->"f9c55c49-839f-4006-b93c-\
bbbd54f29f74"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SameHalfPlaneQ", "[", 
   RowBox[{"r1_", ",", "r2_", ",", "r3_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "r", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Mag2", "[", "r1", "]"}], "\[Equal]", "0"}], "||", 
     RowBox[{
      RowBox[{"Mag2", "[", "r2", "]"}], "\[Equal]", "0"}], "||", 
     RowBox[{
      RowBox[{"Mag2", "[", "r3", "]"}], "\[Equal]", "0"}], "||", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", "r1"}]}], ";", 
       RowBox[{
        RowBox[{"Sign", "[", 
         RowBox[{"r", ".", "r2"}], "]"}], "\[Equal]", 
        RowBox[{"Sign", "[", 
         RowBox[{"r", ".", "r3"}], "]"}]}]}], ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.627507761252094*^9, 3.627507776463311*^9}, {
   3.627507841838923*^9, 3.627507952887558*^9}, 3.688166836963388*^9},
 CellLabel->
  "In[2691]:=",ExpressionUUID->"fab400cd-74e0-456b-9f12-ba07ab7b69a4"],

