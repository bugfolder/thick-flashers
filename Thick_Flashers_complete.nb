Cell["\<\
Example. A nearly triangular wedge that when inset gets more trapezoidal \
faces. Left side: without sticky faces. Right side: with sticky top and \
bottom surfaces. Note that we do have to have two distinct vertices at the \
point in order to have sticky bottom and top faces.\
\>", "Text",
 CellChangeTimes->{{3.922190455907482*^9, 3.922190476066673*^9}, {
  3.922199752868509*^9, 3.922199753724042*^9}, {3.922204762676628*^9, 
  3.922204781868487*^9}, {3.9222084456805*^9, 3.92220844592972*^9}, {
  3.922208510474491*^9, 
  3.922208545817449*^9}},ExpressionUUID->"4843c438-f762-4bba-be21-\
32c2630215b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "gc", ",", "igc", ",", "isgc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".2", ",", ".5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", ".4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".2", ",", ".50001"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", ".4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc", "=", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{"pts", ",", 
        RowBox[{"Polygon", "/@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "5", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "5", ",", "6"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "5", ",", "2", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "6", ",", "4"}], "}"}]}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"igc", "=", 
      RowBox[{"InsetGC", "[", 
       RowBox[{"gc", ",", "0.05", ",", 
        RowBox[{"InsetFaceSubset", "->", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"isgc", "=", 
      RowBox[{"InsetGC", "[", 
       RowBox[{"gc", ",", "0.05", ",", 
        RowBox[{"InsetFaceSubset", "->", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], ",", 
        RowBox[{"StickyFaceSubset", "->", 
         RowBox[{"{", 
          RowBox[{"2", ",", "4"}], "}"}]}]}], "]"}]}], ";", 
