Cell[CellGroupData[{

Cell["Circular polygon twist graphs", "Subsection",
 CellChangeTimes->{{3.59246930206446*^9, 3.592469306143282*^9}, {
   3.595189930484343*^9, 3.5951899321629257`*^9}, 3.595975550365892*^9, 
   3.5975033505929217`*^9, {3.597503955657114*^9, 
   3.597503962336623*^9}},ExpressionUUID->"978f3140-70ab-4245-a19e-\
8b30b4250390"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.595019752652601*^9, 
  3.595019753202587*^9}},ExpressionUUID->"78d3827e-4b40-47db-9a5e-\
3c15101c8430"],

Cell["\<\
In general, we represent the crease pattern and folded form by a single \
TGraph2D+TAssigned (for flat folds) or TGraph3D+TAssigned (for 3D folds) in \
which the folded form is literally the folded image of the crease pattern. \
When we\[CloseCurlyQuote]re looking at single circular twists that we \
represent as a circular \[OpenCurlyDoubleQuote]punchout,\
\[CloseCurlyDoubleQuote] the circular border of the folded form isn\
\[CloseCurlyQuote]t a simple mapping of the circular border of the crease \
pattern. So for circular twist polygons, the border of the folded form graph \
isn\[CloseCurlyQuote]t the folded image of the border of the crease pattern \
graph.\
\>", "Text",
 CellChangeTimes->{{3.595019757665984*^9, 3.59501991549551*^9}, {
  3.597503295331064*^9, 
  3.5975033459934278`*^9}},ExpressionUUID->"c2dec149-907e-4f1b-b83b-\
b200888abee2"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "CircularPolygonTwistGraph2D[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types, opts",
  FontSlant->"Italic"],
 "]\n\t(options) CircleDivisions, StationaryFace"
}], "Subsubsection",
 CellChangeTimes->{{3.5974538457036257`*^9, 3.597453863907383*^9}, 
   3.597491829144047*^9, 3.628637049883984*^9, 3.628637171779903*^9, {
   3.629198279936108*^9, 
   3.629198285311284*^9}},ExpressionUUID->"be7ee7c7-07ca-463e-9f68-\
aa0382fb931e"],

Cell[TextData[{
 "CircularPolygonTwistGraph2D[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types, opts",
  FontSlant->"Italic"],
 "] returns a TGraph2D that describes the crease pattern and folded form for \
a circular polygon twist, i.e., a polygonal twist that is clipped to a \
circular boundary of radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", centered in each case on the centroid of the central polygon. Both the \
crease pattern and folded form graphs are clipped to a circle. Options are:\n\
\tCircleDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is passed through to CircularlyCompletePoly to specify the quantization of \
the circle.\n\tStationaryFace \[Rule] 1 | ",
 StyleBox["i",
  FontSlant->"Italic"],
 " | Automatic. Specifies the stationary face of the folded form. If 1, the \
central polygon is stationary. If Automatic, the wedges maintain their \
orientation. If ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", the specified face is held fixed."
}], "Text",
 CellChangeTimes->{{3.5974538703425293`*^9, 3.59745397099442*^9}, {
   3.597503362625819*^9, 3.597503389355493*^9}, 3.628637050048546*^9, 
   3.628637171871482*^9, {3.629198104670084*^9, 
   3.629198276551991*^9}},ExpressionUUID->"7058cf3c-c80e-49af-aff9-\
6122a05f4538"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CircularPolygonTwistGraph2D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"StationaryFace", "\[Rule]", "Automatic"}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.629198311172168*^9, 3.629198332440102*^9}},
 CellLabel->
  "In[2724]:=",ExpressionUUID->"9b532b0f-3378-483e-a410-0e099c58a410"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CircularPolygonTwistGraph2D", "::", "badtypes"}], 
   "=", "\"\<List `1` of fold types is not of length `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.628971135480157*^9, 3.628971152743082*^9}},
 CellLabel->
  "In[2725]:=",ExpressionUUID->"54917454-8c03-4bbd-acba-9f87e93dbd37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CircularPolygonTwistGraph2D", "[", 
   RowBox[{"verts_List", ",", "\[Alpha]_", ",", "r_", ",", 
    RowBox[{"types_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sf", ",", "newverts", ",", "nv", ",", "ctr", ",", "edges", ",", 
      "newedges", ",", "oldtypes", ",", "newtypes", ",", "ccw", ",", "f", ",",
       "pe", ",", "rr", ",", "newfaces", ",", "tobj", ",", "foldangles", ",", 
      "fverts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sf", "=", 
      RowBox[{
       RowBox[{"StationaryFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CircularPolygonTwistGraph2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newverts", "=", 
      RowBox[{"N", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"Length", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", "verts"}], "/", "nv"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newedges", "=", 
      RowBox[{"edges", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "[", 
        RowBox[{"Range", "[", "nv", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "types", "]"}], "\[NotEqual]", "0"}], "&&", 
        RowBox[{
         RowBox[{"Length", "[", "types", "]"}], "\[NotEqual]", "nv"}]}], ",", 
       
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"CircularPolygonTwistGraph2D", "::", "badtypes"}], ",", 
          "types", ",", "nv"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"oldtypes", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ListEmptyQ", "[", "types", "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"U", ",", 
          RowBox[{"{", "nv", "}"}]}], "]"}], ",", "types"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newtypes", "=", "oldtypes"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccw", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", "\[Alpha]", "]"}], "<", 
        RowBox[{"\[Pi]", "/", "2"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"edge", ",", "type"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pe", "=", 
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "edge", 
           "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"rr", "=", " ", 
          RowBox[{
           RowBox[{"RotationMatrix2D", "[", "\[Alpha]", "]"}], ".", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{"Subtract", "@@", "pe"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"newverts", ",", 
           RowBox[{"RayCircleInt2D", "[", 
            RowBox[{
             RowBox[{
             "pe", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
              "rr", ",", "ctr", ",", "r"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"newedges", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "edge", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
             RowBox[{"Length", "[", "newverts", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"newverts", ",", 
           RowBox[{"RayCircleInt2D", "[", 
            RowBox[{
             RowBox[{
             "pe", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
              "rr", ",", "ctr", ",", "r"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"newedges", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "edge", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
             RowBox[{"Length", "[", "newverts", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"newtypes", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"newtypes", ",", 
            RowBox[{"If", "[", 
             RowBox[{"ccw", ",", 
              RowBox[{"{", 
               RowBox[{"type", ",", 
                RowBox[{"InvertFoldType", "[", "type", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"InvertFoldType", "[", "type", "]"}], ",", "type"}], 
               "}"}]}], "]"}]}], "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{"f", ",", 
       RowBox[{"{", 
        RowBox[{"edges", ",", "oldtypes"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newfaces", "=", 
      RowBox[{"{", 
       RowBox[{"Range", "[", "nv", "]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"pleat", " ", "polygons"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"CircularlyCompletePoly", "[", 
        RowBox[{"newverts", ",", "newedges", ",", "newfaces", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"nv", "+", 
            RowBox[{"2", "i"}]}], ",", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "nv", ",", "1"}], "]"}], ",", "i", 
           ",", 
           RowBox[{"nv", "+", 
            RowBox[{"2", "i"}], "-", "1"}]}], "}"}], ",", "ctr", ",", "r", ",",
          "opts"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nv"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{"wedge", " ", "polygons"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"CircularlyCompletePoly", "[", 
        RowBox[{"newverts", ",", "newedges", ",", "newfaces", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"nv", "+", 
            RowBox[{"2", "i"}], "-", "1"}], ",", "i", ",", 
           RowBox[{"nv", "+", 
            RowBox[{"2", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"i", "-", "1"}], ",", "nv", ",", "1"}], "]"}]}]}]}], 
          "}"}], ",", "ctr", ",", "r", ",", "opts"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nv"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"JoinTo", "[", 
      RowBox[{"newtypes", ",", 
       RowBox[{"Table", "[", 
        RowBox[{"B", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "newedges", "]"}], "-", 
           RowBox[{"Length", "[", "newtypes", "]"}]}], "}"}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTPlaneGraphAssigned", "[", 
        RowBox[{
        "newverts", ",", "newedges", ",", "newfaces", ",", "newtypes"}], 
        "]"}], "//", 
       RowBox[{"AddTTwistGraph", "[", 
        RowBox[{"{", "1", "}"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"create", " ", "clipped", " ", "folded", " ", "form"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"newtypes", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"M", "\[Rule]", 
          RowBox[{"-", "\[Pi]"}]}], ",", 
         RowBox[{"V", "\[Rule]", "\[Pi]"}], ",", 
         RowBox[{"U", "\[Rule]", "\[Pi]"}], ",", 
         RowBox[{"B", "\[Rule]", "0"}]}], "}"}]}]}], ";", 
