Cell["\<\
Example. Two hinges, comparing two different orderings of the point pairs.\
\>", "Text",
 CellChangeTimes->{{3.922569145600569*^9, 3.922569152350147*^9}, {
  3.922609213216793*^9, 
  3.9226092312076893`*^9}},ExpressionUUID->"2097810a-3d0e-493a-ac0e-\
27494c4ae8e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2", ",", "h1", ",", "h2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", ".3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".3", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"h1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"HingePlateGC", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2"}], "}"}], ",", 
            RowBox[{"HingeThickness", "->", "0.2"}]}], "]"}], ",", 
          "SolidStyle", ",", 
          RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"q1", ",", "q2"}], "}"}], "]"}]}], "}"}], ",", "Black", 
          ",", 
          RowBox[{"AbsoluteThickness", "[", "3", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "/@", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}]}], ",", 
          "Black", ",", 
          RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"#1", ",", "#2", ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "0"}], "}"}]}], "]"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<p1\>\"", ",", "\"\<p2\>\"", ",", "\"\<q1\>\"", 
                ",", "\"\<q2\>\""}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}]}], 
             "}"}]}], "]"}], ",", "Black"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", ".3", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".3", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"h2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"HingePlateGC", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2"}], "}"}], ",", 
            RowBox[{"HingeThickness", "->", "0.2"}]}], "]"}], ",", 
          "SolidStyle", ",", 
          RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"q1", ",", "q2"}], "}"}], "]"}]}], "}"}], ",", "Black", 
          ",", 
          RowBox[{"AbsoluteThickness", "[", "3", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "/@", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}]}], ",", 
          "Black", ",", 
          RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"#1", ",", "#2", ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "0"}], "}"}]}], "]"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<p1\>\"", ",", "\"\<p2\>\"", ",", "\"\<q1\>\"", 
                ",", "\"\<q2\>\""}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}]}], 
             "}"}]}], "]"}], ",", "Black"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{"h1", ",", "h2"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.9225691537071323`*^9, 3.922569169496262*^9}, {
   3.922569211346727*^9, 3.922569250026125*^9}, 3.922569967577394*^9, {
   3.9226065769556637`*^9, 3.922606609309173*^9}, {3.922608370684443*^9, 
