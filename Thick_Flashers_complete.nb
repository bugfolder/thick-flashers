Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pbox", ",", "qbox", ",", "itol", ",", "pverts", ",", "qverts", ",", 
      "p1verts", ",", "q1verts", ",", "int"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pbox", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qbox", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1.05", ",", "2.05"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", "1.5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"itol", "=", "0.07"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", "pbox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qverts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", "qbox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"int", "=", 
      RowBox[{"BoundingBoxesIntersectQ", "[", 
       RowBox[{"pbox", ",", "qbox", ",", 
        RowBox[{"IntersectionTolerance", "\[Rule]", "itol"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p1verts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"pbox", "+", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "itol"}], ",", "itol"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "itol"}], ",", "itol"}], "}"}]}], "}"}], "/", 
          "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q1verts", "=", 
      RowBox[{"RectVertices", "@@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"qbox", "+", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "itol"}], ",", "itol"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "itol"}], ",", "itol"}], "}"}]}], "}"}], "/", 
          "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pverts", "]"}], "]"}], ",", "Red"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "qverts", "]"}], "]"}], ",", 
           "Green"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "p1verts", "]"}], "]"}], ",", 
           RowBox[{"Lighter", "[", "Red", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "q1verts", "]"}], "]"}], ",", 
           RowBox[{"Lighter", "[", "Green", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", 
        RowBox[{"If", "[", 
         RowBox[{
         "int", ",", "\"\<intersects\>\"", ",", "\"\<no intersection\>\""}], 
