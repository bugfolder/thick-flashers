Cell[BoxData[
 RowBox[{
  RowBox[{"PruneUnivalentEdges", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "edges", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "PruneUnivalentEdges"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"FixedPoint", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"ll", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "#", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#", ",", 
                  RowBox[{"Count", "[", 
                   RowBox[{
                    RowBox[{"Flatten", "[", "ll", "]"}], ",", "#"}], "]"}]}], 
                 "}"}], "&"}], ",", "ll", ",", 
               RowBox[{"{", "2", "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}], ">", "1"}], "&&", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "2"}], "]"}], "]"}], ">", "1"}]}], 
              "&"}]}], "]"}]}]}], "]"}], ",", 
        RowBox[{"tobj", "[", "Edges", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"Edges", "\[Rule]", "edges"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.591645963132636*^9, 3.591645990516683*^9}, {
   3.591646451820608*^9, 3.591646532986073*^9}, 3.591646574445662*^9, {
   3.591648528578473*^9, 3.591648542037324*^9}, {3.592349374565598*^9, 
