Cell[TextData[{
 "MakePrimalDualTwistTessellation",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Gamma], \[Alpha], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(check class) TPrimalDualGraph\n\t(options) PostRotation, \
TwistDirection"
}], "Subsubsection",
 CellChangeTimes->{
  3.485256475778479*^9, {3.485264052118383*^9, 3.485264071093058*^9}, 
   3.533598443621199*^9, 3.551746786639997*^9, 3.55175437898342*^9, 
