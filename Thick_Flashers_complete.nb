Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "EmbeddedIntersectify", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"IntersectionTolerance", "\[Rule]", "0"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.676469649236177*^9, 3.676469668047914*^9}},
 CellLabel->
  "In[1116]:=",ExpressionUUID->"e0a1500c-3a7f-46b2-927c-3f63e3aba9bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbeddedIntersectify", "[", 
   RowBox[{"verts_List", ",", " ", "edges_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "itol", ",", "eptsall", ",", "p1", ",", "p2", ",", "q1", ",", "q2", ",", 
      "r", ",", "d", ",", "tpair", ",", "accum", ",", "epts"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"itol", "=", 
      RowBox[{
       RowBox[{"IntersectionTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "EmbeddedIntersectify", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eptsall", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Find", " ", "all", " ", "pairwise", " ", "intersections"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2"}], "}"}], "=", 
         RowBox[{"verts", "\[LeftDoubleBracket]", 
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q1", ",", "q2"}], "}"}], "=", 
         RowBox[{"verts", "\[LeftDoubleBracket]", 
          RowBox[{
          "edges", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"BoundingBoxesIntersectQ", "[", 
            RowBox[{
             RowBox[{"BoundingBox", "[", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", 
             RowBox[{"BoundingBox", "[", 
              RowBox[{"{", 
               RowBox[{"q1", ",", "q2"}], "}"}], "]"}], ",", "opts"}], 
            "]"}]}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", "d", ",", "tpair"}], "}"}], "=", 
         RowBox[{"SegmentSegmentMedialInfo", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"If", " ", "within", " ", "tolerance", " ", "and", " ", 
           RowBox[{"it", "'"}], "s", " ", "not", " ", "an", " ", "endpoint"}],
           ",", " ", 
          RowBox[{"record", " ", "the", " ", "intersection"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Chop", "[", "d", "]"}], "\[LessEqual]", 
           RowBox[{"itol", "/", "2"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Chop", "[", 
                RowBox[{
                "tpair", "\[LeftDoubleBracket]", "1", 
                 "\[RightDoubleBracket]"}], "]"}], "\[NotEqual]", "0"}], "&&", 
              RowBox[{
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{
                 "tpair", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "-", "1"}], "]"}], "\[NotEqual]",
                "0"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{
               RowBox[{
               "eptsall", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", 
                 RowBox[{
                 "tpair", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Chop", "[", 
                RowBox[{
                "tpair", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}], "]"}], "\[NotEqual]", "0"}], "&&", 
              RowBox[{
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{
                 "tpair", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}], "-", "1"}], "]"}], "\[NotEqual]",
                "0"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{
               RowBox[{
               "eptsall", "\[LeftDoubleBracket]", "j", 
                "\[RightDoubleBracket]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", 
                 RowBox[{
                 "tpair", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], "]"}]}]}], 
         "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"i", "+", "1"}], ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"accum", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
         "Sort", " ", "all", " ", "points", " ", "of", " ", "each", " ", 
          "edge", " ", "in", " ", "order", " ", "of", " ", "t"}], "-", 
         RowBox[{"parameter", " ", "along", " ", "edge"}]}], ",", " ", 
        RowBox[{
         RowBox[{"then", " ", "drop", " ", "t"}], "-", "parameter"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"epts", "=", 
         RowBox[{"First", "/@", 
          RowBox[{"Sort", "[", 
           RowBox[{
            RowBox[{
            "eptsall", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
             ",", 
            RowBox[{
             RowBox[{
              RowBox[{
              "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<", 
              RowBox[{
              "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
             "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "construct", " ", "individual", " ", "edges", " ", "and", " ", 
          "index", " ", "of", " ", "where", " ", "it", " ", "came", " ", 
          "from"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"JoinTo", "[", 
         RowBox[{"accum", ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "i"}], "}"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Drop", "[", 
               RowBox[{"epts", ",", 
                RowBox[{"-", "1"}]}], "]"}], ",", 
              RowBox[{"Drop", "[", 
               RowBox[{"epts", ",", "1"}], "]"}]}], "}"}]}], "]"}]}], "]"}], 
        ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", "accum", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.676469625124911*^9, 3.676469644814343*^9}, {
   3.676469894876544*^9, 3.676470232939831*^9}, {3.676470290651443*^9, 
   3.676470308456888*^9}, {3.6764703679087753`*^9, 3.6764705849684553`*^9}, {
   3.6764706264384727`*^9, 3.676470700413383*^9}, {3.676470753712014*^9, 
   3.676470763133772*^9}, {3.676470819507411*^9, 3.676471002854744*^9}, {
   3.67647105368635*^9, 3.676471202113946*^9}, {3.676471255983159*^9, 
   3.6764712576324496`*^9}, 3.676471307916365*^9, {3.676471360149691*^9, 
   3.676471382495385*^9}, {3.676471461679716*^9, 3.6764714683667097`*^9}, {
   3.676471722875588*^9, 3.676471757695729*^9}, {3.676479788037566*^9, 
   3.6764798305315127`*^9}, {3.676480025742897*^9, 3.676480073487458*^9}, {
   3.676480106986884*^9, 3.676480180380112*^9}},
 CellLabel->
  "In[1117]:=",ExpressionUUID->"fdf093cb-410f-47df-9a6d-fffd724b4866"],

Cell["\<\
Example. Two crossed lines. Gray points and lines show the embedded edges and \
their vertices.\
\>", "Text",
 CellChangeTimes->{{3.591652195478114*^9, 3.591652196206684*^9}, {
  3.592784152958202*^9, 3.592784156404889*^9}, {3.676472025563172*^9, 
