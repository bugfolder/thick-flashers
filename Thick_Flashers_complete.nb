Cell[CellGroupData[{

Cell[TextData[{
 "RigidlyScaleFoldAngles[",
 StyleBox["glist",
  FontSlant->"Italic"],
 ", \[Mu]]\nRigidlyScaleFoldAngles[",
 StyleBox["glist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["grule",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.693513893952489*^9, {3.695231439815207*^9, 
   3.695231448375412*^9}},ExpressionUUID->"9059c11d-4e8b-4c4e-b3f3-\
f14697bf96cb"],

Cell[TextData[{
 "RigidlyScaleFoldAngles[",
 StyleBox["glist",
  FontSlant->"Italic"],
 ", \[Mu]] scales a list of angles so that the fold angle multiplier between \
any pair is preserved."
}], "Text",
 CellChangeTimes->{{3.693511244113511*^9, 3.693511282792955*^9}, 
   3.693511410990114*^9, {3.695231493015562*^9, 
   3.695231493320059*^9}},ExpressionUUID->"cca73e82-71b5-460b-8880-\
6f9ee5129f66"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["glist",
  FontSlant->"Italic"],
 " \[LongDash] a list of fold angles.\n\t\[Mu] \[LongDash] a fold angle \
multiplier that is used to transform all fold angles. Can be any real \
number."
}], "Text",
 CellChangeTimes->{{3.693511413754986*^9, 3.6935114523870783`*^9}, {
  3.695231507801155*^9, 
  3.695231537048131*^9}},ExpressionUUID->"ff15825f-e7cc-45ff-8fd6-\
c3e4c86b62b3"],

Cell["\<\
This comes in useful if you\[CloseCurlyQuote]ve developed a nice \
RigidlyFoldableQuadMesh and want to see what it looks like with the same \
crease pattern but a different state of foldedness.\
\>", "Text",
 CellChangeTimes->{{3.693513924518982*^9, 
  3.693513961966256*^9}},ExpressionUUID->"a75ba8c7-2ed3-4419-a3e1-\
8db887505dc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RigidlyScaleFoldAngles", "[", 
   RowBox[{"glist_List", ",", "mu_"}], "]"}], ":=", 
  RowBox[{"2", " ", 
   RowBox[{"ArcTan", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"mu", " ", 
       RowBox[{"Tan", "[", 
        RowBox[{"#", "/", "2"}], "]"}]}], "&"}], "/@", "glist"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.693511212415983*^9, 3.693511240617878*^9}, {
  3.6935113104014*^9, 3.693511404716475*^9}, {3.693513682381596*^9, 
  3.693513692156512*^9}, {3.695231577306682*^9, 3.695231596555346*^9}},
 CellLabel->
  "In[2116]:=",ExpressionUUID->"69c41d0f-a0b1-449a-b4b4-a3ba3910c7f4"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.693513695707601*^9, 3.693513696460746*^9}, 
   3.69351377135655*^9},ExpressionUUID->"a6c04c0d-cf5f-4e68-9542-\
1a1a84ee2ca7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "glist", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"glist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{"120.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"RigidlyScaleFoldAngles", "[", 
       RowBox[{"glist", ",", 
        RowBox[{"1", "/", 
         SqrtBox["3"]}]}], "]"}], "/", "\[Degree]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.69351370038032*^9, 3.69351376716569*^9}, {
   3.693513905463172*^9, 3.693513912383133*^9}, {3.695231562899328*^9, 
