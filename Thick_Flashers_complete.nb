Cell[CellGroupData[{

Cell["BirdBaseGraph2D", "Subsubsection",
 CellChangeTimes->{{3.706832180837207*^9, 
  3.706832183549294*^9}},ExpressionUUID->"9c990f9d-672f-49dd-947e-\
1c9c3f75bba1"],

Cell["\<\
BirdBaseGraph2D gives the folded form of an origami Bird Base. Because \
folding it involves petal folds, we have to construct it in the \
already-folded state. (OK, yes, it\[CloseCurlyQuote]s technically possible to \
create a Bird Base using just mountains, valleys, and reverse folds, but this \
is still probably easier.)\
\>", "Text",
 CellChangeTimes->{{3.706832187285084*^9, 3.706832241733744*^9}, {
  3.7068683523735228`*^9, 
  3.706868383379254*^9}},ExpressionUUID->"933f77ff-6fd0-4da3-ae89-\
0cde9b766a95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "BirdBaseGraph2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"BirdBaseGraph2D", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "h", ",", "verts", ",", "edges", ",", "a", ",", "b", ",", "c", ",", 
        "d", ",", "e", ",", "f", ",", "verts2d"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{".5", 
         RowBox[{"(", 
          RowBox[{
           SqrtBox["2"], "-", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"verts", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{".5", ",", "h"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"0", ",", ".5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"h", ",", ".5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", ".5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "-", "h"}], ",", ".5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", ".5"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{".5", ",", 
            RowBox[{"1", "-", "h"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{".5", "-", 
             RowBox[{"h", "/", 
              SqrtBox["2"]}]}], ",", 
            RowBox[{".5", "-", 
             RowBox[{"h", "/", 
              SqrtBox["2"]}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{".5", "+", 
             RowBox[{"h", "/", 
              SqrtBox["2"]}]}], ",", 
            RowBox[{".5", "+", 
             RowBox[{"h", "/", 
              SqrtBox["2"]}]}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "8"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "9"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"4", ",", "14"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"14", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "8"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"5", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"7", ",", "8"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "9"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"5", ",", "11"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "11"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "10"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"7", ",", "10"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "15"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"15", ",", "10"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "13"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"9", ",", "13"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"10", ",", "11"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"10", ",", "12"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"10", ",", "13"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"11", ",", "12"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"12", ",", "13"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"1", ",", "14"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"14", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"7", ",", "15"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"15", ",", "13"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"folded", " ", "form", " ", "vertices"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"a", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], ";", 
       RowBox[{"b", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "h"}], ",", ".5"}], "}"}]}], ";", 
       RowBox[{"c", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", ".5"}], "}"}]}], ";", 
       RowBox[{"d", "=", 
        RowBox[{"{", 
         RowBox[{"h", ",", ".5"}], "}"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{".5", "+", "h"}]}], "}"}]}], ";", 
       RowBox[{"f", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"verts2d", "=", 
        RowBox[{"{", 
         RowBox[{
         "a", ",", "c", ",", "f", ",", "b", ",", "c", ",", 
          "\[IndentingNewLine]", "b", ",", "e", ",", "d", ",", "c", ",", "d", 
          ",", "\[IndentingNewLine]", "f", ",", "c", ",", "a", ",", "c", ",", 
          "c"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"MakeTGraph", "[", 
          RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], "//", 
        RowBox[{"AddTGraph2D", "[", "verts2d", "]"}]}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.706832253361471*^9, 3.706832291679514*^9}, {
  3.706832400871244*^9, 3.706832470848105*^9}, {3.7068683955954113`*^9, 
  3.706868407603349*^9}, {3.706868459907943*^9, 3.706868680406238*^9}, {
  3.706868712822172*^9, 3.7068688079292*^9}, {3.706868949185835*^9, 
  3.706868952209463*^9}, {3.706869005562031*^9, 3.706869044082265*^9}, {
  3.706869074890758*^9, 3.7068691455906487`*^9}, {3.706869207613736*^9, 
  3.706869323429414*^9}, {3.706869388621341*^9, 3.706869475926749*^9}, {
