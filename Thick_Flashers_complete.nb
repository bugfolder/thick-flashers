 CellLabel->
  "In[1124]:=",ExpressionUUID->"cf841203-4abf-45f7-8728-e1d8f0c826f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RadialMajor", "::", "usage"}], 
   "=", "\"\<RadialMajor is an option to RadialAxialOrderingFn that specifies \
radial priority.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RadialDirection", "::", "usage"}], 
   "=", "\"\<RadialDirection is a option to RadialAxialOrderingFn that \
specials the radial orientation.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AxialDirection", "::", "usage"}], 
   "=", "\"\<AxialDirection is an option to RadialAxialOrderingFn that \
specifies the axial orientation.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Inward", "::", "usage"}], 
   "=", "\"\<Inward is a value for the option RadialDirection.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Outward", "::", "usage"}], " ", "=", 
   " ", "\"\<Outward is a value for the option RadialDirection.\>\""}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.5916536682723293`*^9, 3.591653866676469*^9}, {
  3.593989882454769*^9, 3.593989889469205*^9}},
 CellLabel->
  "In[1125]:=",ExpressionUUID->"77aad9a7-2213-498a-927f-467037787bf3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RadialAxialOrderingFn", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"RadialAxialTolerance", "\[Rule]", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]]}], ",", "\[IndentingNewLine]", 
     RowBox[{"RadialMajor", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"RadialDirection", "\[Rule]", "Outward"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"AxialDirection", "\[Rule]", "CCW"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.465991447157143*^9, 3.465991472027657*^9}, 
   3.4852653435763807`*^9, {3.485265793199489*^9, 3.4852658432061043`*^9}, {
   3.485265890004155*^9, 3.485265893876726*^9}, 3.708342502983905*^9},
