    "types_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PatchCheckTypes", "[", 
      RowBox[{"patch", ",", "types"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"PatchCheckParity", "[", 
      RowBox[{"patch", ",", "parity"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"UnitRegularPolygonOffsetTwistTile", ",", 
            RowBox[{"#1", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", "w", ",", 
            RowBox[{"#3", " ", "d"}], ",", "#2"}], "}"}], ",", 
