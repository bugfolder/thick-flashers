Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "plist", ",", "tobj", ",", "tobj1", ",", 
      RowBox[{"\[Sigma]", "=", 
       RowBox[{"60", "\[Degree]"}]}], ",", 
      RowBox[{"\[Tau]", "=", 
       RowBox[{"5.2", "\[Degree]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{
          RowBox[{"-", "0.3"}], "#"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plist", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"f", "[", "\[Phi]", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", "0", ",", 
           RowBox[{"4", "\[Pi]"}], ",", 
           RowBox[{"\[Pi]", "/", "10"}]}], "}"}]}], "]"}], "//", "N"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "break", " ", "the", " ", "first", " ", "segment", " ", "in", " ", 
       "the", " ", "middle", " ", "so", " ", 
       RowBox[{"there", "'"}], "s", " ", "no", " ", "bend", " ", "or", " ", 
       "torsion", " ", "at", " ", "the", " ", 
       RowBox[{"endpoints", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTSpaceCurve", "[", 
       RowBox[{"plist", ",", "0.75", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Sigma]", "+", 
           RowBox[{"\[Tau]", "/", "2"}]}], ",", 
          RowBox[{"\[Sigma]", "-", 
           RowBox[{"\[Tau]", "/", "2"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"tobj", "[", "SpaceCurveInteriorVertices", "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<BendAngleFF/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"tobj1", "[", "BendAngleFF", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<BendAngleCP/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"tobj1", "[", "BendAngleCP", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SubarcAngles/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"tobj1", "[", "SubarcAngles", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SpaceCurveMaximumWidth\>\"", "\[Rule]", 
       RowBox[{"tobj", "[", "SpaceCurveMaximumWidth", "]"}]}], "]"}], ";", 
     " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", "plist", "]"}], ",", 
             RowBox[{"Point", "[", 
              RowBox[{
              "plist", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
               "]"}]}], "}"}], ",", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
