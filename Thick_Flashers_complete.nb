 RowBox[{
  RowBox[{"TypeToCreasePatternStyleRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"M", "\[Rule]", "MountainLine"}], ",", "\[IndentingNewLine]", 
     RowBox[{"V", "\[Rule]", "ValleyLine"}], ",", "\[IndentingNewLine]", 
     RowBox[{"U", "\[Rule]", "UnfoldedLine"}], ",", "\[IndentingNewLine]", 
     RowBox[{"B", "\[Rule]", "BorderLine"}]}], "\[IndentingNewLine]", "}"}]}],
   ";"}]], "Input",
