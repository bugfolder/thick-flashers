Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"r", "=", "3"}], ",", 
      RowBox[{"h", "=", "2"}], ",", 
      RowBox[{"m", "=", "5"}], ",", "fsq", ",", "fspolys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fsq", "=", 
      RowBox[{"FlasherSectorTriangles", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fspolys", "=", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ctr", "=", 
             RowBox[{
              RowBox[{"Plus", "@@", "#1"}], "/", "3"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Polygon", "[", 
                RowBox[{"ctr", "+", 
                 RowBox[{"0.8", 
                  RowBox[{"(", 
                   RowBox[{"#1", "-", "ctr"}], ")"}]}]}], "]"}], ",", 
               "LightGray"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"\"\<q\>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{
                   "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}]}], ",", "ctr"}], "]"}], ",", 
               RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}]}], 
          "]"}], "&"}], ",", "fsq"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fspolys", ",", 
         RowBox[{"FlasherFirstSectorAllPossibleVerticesLabels", "[", 
          RowBox[{"\"\<p\>\"", ",", "p", ",", 
           RowBox[{"r", "*", "h"}]}], "]"}]}], "}"}], "/.", 
       RowBox[{"FlasherDefaultCPRules", "[", 
        RowBox[{"p", ",", "m"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
