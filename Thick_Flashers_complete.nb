Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronSkewDistance[",
 StyleBox["p, q, r, s",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595714733200908*^9, 3.595714741101797*^9}, {
  3.5957150627449102`*^9, 3.595715074078739*^9}, {3.595983030620796*^9, 
