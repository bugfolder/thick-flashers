Cell[TextData[{
 "BrocardTriangleInfo",
 "[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TwistDirection"
}], "Subsubsection",
 CellChangeTimes->{{3.62878051976374*^9, 3.62878054932134*^9}, {
   3.6287805797596416`*^9, 3.628780588086643*^9}, {3.628780776434309*^9, 
