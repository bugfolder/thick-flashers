Cell[CellGroupData[{

Cell["Triangulated graphs", "Section",
 CellChangeTimes->{{3.706915608563809*^9, 3.7069156126836863`*^9}, {
  3.70691661247586*^9, 
  3.7069166130520887`*^9}},ExpressionUUID->"b7996b1e-c7c5-4876-8224-\
e6c16babccab"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.706915618754442*^9, 
  3.706915619298858*^9}},ExpressionUUID->"665bc0cd-05a3-4f3d-8f70-\
66d0dbc52877"],

Cell["\<\
For analyzing fold patterns using a truss model, it is desirable to \
triangulate all higher-order polygons with additional edges and keep track of \
the newly-added triangulated edges so that non-bending constraints may be \
added.\
\>", "Text",
 CellChangeTimes->{{3.7069156223939*^9, 3.706915685674592*^9}, {
  3.706952231266693*^9, 
  3.706952254211298*^9}},ExpressionUUID->"d5dad895-67c5-4895-b47d-\
dd5b83e760b7"]
}, Closed]],

