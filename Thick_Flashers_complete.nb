   3.6152480555323553`*^9}, {3.615248127615486*^9, 3.615248234075381*^9}, {
   3.6152482872571573`*^9, 3.615248288022992*^9}, {3.61524833406332*^9, 
   3.615248350832849*^9}, {3.615248419129331*^9, 3.61524845322493*^9}, {
   3.6152484835757*^9, 3.6152485093329153`*^9}, {3.6152485493027287`*^9, 
   3.615248562643277*^9}, {3.615248947346315*^9, 3.6152490168176928`*^9}, {
   3.615249125012253*^9, 3.615249125261842*^9}, {3.615285320897522*^9, 
   3.615285440934217*^9}, {3.61528547686436*^9, 3.615285503037803*^9}},
