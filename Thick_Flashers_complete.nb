Cell[CellGroupData[{

Cell[TextData[{
 "ConicSection2DSystem[{",
 StyleBox["fl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fr",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["hl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hr",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions"
}], "Subsubsection",
 CellChangeTimes->{{3.597676015766321*^9, 3.597676063106683*^9}, {
   3.5976760981905622`*^9, 3.59767617783908*^9}, {3.59767996210434*^9, 
   3.597679968124084*^9}, {3.597697483151031*^9, 3.5976974872358727`*^9}, 
   3.597697579398617*^9, {3.689420860620694*^9, 3.689420889837113*^9}, {
   3.689420933614629*^9, 3.689420954753885*^9}, {3.689421007165503*^9, 
   3.689421008074469*^9}, {3.689421080101044*^9, 3.689421082853136*^9}, {
   3.689421159537033*^9, 3.689421161699399*^9}, 3.689428402856428*^9, {
   3.689428729537239*^9, 3.689428731830556*^9}, 3.69152410189802*^9, {
   3.6921980185767603`*^9, 3.692198018580607*^9}, 3.692198193724805*^9, {
   3.692198350259455*^9, 3.6921983590411263`*^9}, {3.692200267233563*^9, 
   3.692200285782971*^9}},ExpressionUUID->"05d49e8f-c1c9-41b0-aeca-\
61ff1b5ce2bf"],

Cell[TextData[{
 "ConicSection2DSystem[{",
 StyleBox["fl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fr",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["hl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hr",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a description of a 2D conic section fold line. The optical axis \
is taken to be the ",
 StyleBox["x",
  FontSlant->"Italic"],
 "-axis with propagation from left to right (in positive x-direction); the \
fold line runs vertically through the origin."
}], "Text",
 CellChangeTimes->{{3.692198244713037*^9, 3.6921982991267147`*^9}, {
  3.69394869734898*^9, 
  3.693948701618709*^9}},ExpressionUUID->"aee05257-884b-4f0b-afe7-\
12428315f1b0"],

Cell[TextData[{
 "Arguments: \n\t",
 StyleBox["fl",
  FontSlant->"Italic"],
 " \[LongDash] the position of the left-surface focal point on the x-axis. \
Can be positive or negative or \[Dash]\[Infinity] for a collimated input.\n\t",
 StyleBox["fr",
  FontSlant->"Italic"],
 " \[LongDash] the position of the right-surface focal point on the x-axis. \
Can be positive or negative or +\[Infinity] for a collimated output.\n\t",
 StyleBox["hl",
  FontSlant->"Italic"],
 " \[LongDash] the position behind the origin of the left cross curve (phase \
front). Must be negative.\n\t",
 StyleBox["hr",
  FontSlant->"Italic"],
 " \[LongDash] the position beyond the origin of the right cross curve (phase \
front). Must be positive."
}], "Text",
 CellChangeTimes->{{3.692184623987392*^9, 3.692184644064939*^9}, {
  3.692198018596112*^9, 3.692198018600329*^9}, {3.692198143104441*^9, 
  3.692198168336187*^9}, {3.6921983081335697`*^9, 3.692198332569468*^9}, {
  3.6921985537498837`*^9, 
  3.692198605333272*^9}},ExpressionUUID->"f4192f74-44dc-425a-81af-\
766c09eecebb"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
