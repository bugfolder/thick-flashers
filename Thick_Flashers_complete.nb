Cell["\<\
Since polygons with >3 sides could be skew, we use the centroid of each face \
to measure fold angle.\
\>", "Text",
 CellChangeTimes->{{3.702662402332014*^9, 3.702662441868724*^9}, {
  3.702665314430744*^9, 
  3.702665314854344*^9}},ExpressionUUID->"a1e16a45-2364-4b16-9a1f-\
c64dd8f57469"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeFlatFoldEnergy", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i1_", ",", "f1_", ",", "i2_", ",", "f2_"}], "}"}], ",", 
    "verts_List"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "p3", ",", "p4", ",", "u2", ",", "u4", ",", 
      "r13"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p1", "=", 
      RowBox[{
      "verts", "\[LeftDoubleBracket]", "i1", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "f1", "\[RightDoubleBracket]"}]}], "/", 
       RowBox[{"Length", "[", "f1", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p3", "=", 
      RowBox[{
      "verts", "\[LeftDoubleBracket]", "i2", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p4", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "f2", "\[RightDoubleBracket]"}]}], "/", 
       RowBox[{"Length", "[", "f2", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"QuadFlatFoldEnergy", "[", 
      RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.70258200662281*^9, 3.7025820268818417`*^9}, {
