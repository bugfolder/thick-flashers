Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NRibbonPair", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.798576024152359*^9, 
