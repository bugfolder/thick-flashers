Cell[TextData[{
 "ClipSegmentSetToConvexPolygonExterior[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] takes the segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, is",
  FontSlant->"Italic"],
 "} and returns a segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, isa",
  FontSlant->"Italic"],
 "} that lies outside of the convex polygon ",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", which is given as a list of vertices. Note that this works properly no \
matter where the segment set is relative to the polygon. Polygon can be \
either CCW or CW."
}], "Text",
 CellChangeTimes->{{3.484758552449597*^9, 3.484758653747197*^9}, {
  3.628120821571696*^9, 
  3.62812082749092*^9}},ExpressionUUID->"c8c062e2-99b2-492e-9888-\
a4e70a36603e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentSetToConvexPolygonExterior", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1_",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["q2_",
       FontSlant->"Italic"], ",", " ", 
      StyleBox["is_",
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    StyleBox["poly_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ss", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{"ClipSegmentSetToConvexPolygon", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], 
           "}"}]}], "}"}], ",", "poly"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"q1", ",", "q2", ",", 
       RowBox[{"IntervalSetMinus", "[", 
        RowBox[{"is", ",", 
         RowBox[{
         "ss", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
        "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.484755034791026*^9, 3.484755041507921*^9}, {
  3.484770312059771*^9, 3.484770404176836*^9}, {3.484770475097972*^9, 
  3.484770478070475*^9}, {3.484770538985756*^9, 3.484770552839819*^9}},
 CellLabel->
  "In[565]:=",ExpressionUUID->"4695d204-94d4-469b-b8fd-c1905feb9d49"],

Cell["Example", "Text",
 CellChangeTimes->{{3.484770407772337*^9, 
  3.4847704084426947`*^9}},ExpressionUUID->"2dad3d97-2994-495b-8a57-\
46890029efa9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"poly", ",", "segments", ",", "csegments"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"poly", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
