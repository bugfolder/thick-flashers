Cell[BoxData[
 RowBox[{
  RowBox[{"NCurvedFoldUniformHelix3D", "[", 
   RowBox[{"r_", ",", "\[Theta]_", ",", "\[Gamma]0_", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}], "=", 
      RowBox[{"CurvedFoldUniformHelix3D", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Gamma]0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"ff", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"rrL", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
