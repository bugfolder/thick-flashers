   3.6909884939471073`*^9, {3.690988939398822*^9, 3.690988939433842*^9}, {
   3.6909892231901827`*^9, 3.690989223222538*^9}, 3.690992971856447*^9, {
   3.691234394210944*^9, 3.691234404904478*^9}, 3.691235445299875*^9, {
   3.691248734396118*^9, 3.691248786795871*^9}, 3.691252772116118*^9, 
   3.691407950654418*^9, 3.691505397022343*^9, {3.691505452356375*^9, 
   3.691505471851548*^9}, 3.69150593420151*^9, 3.69150683266384*^9, {
   3.692455859561324*^9, 3.6924558638773937`*^9}, {3.7972651371590147`*^9, 
