Cell[CellGroupData[{

Cell[TextData[{
 "Dashify[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox[" opts",
  FontSlant->"Italic"],
 "]\nDashifyByStyle[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["styles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) DashPattern,  JustifyDashing, MinimumDashLength, \
DashCorners"
}], "Subsubsection",
 CellChangeTimes->{{3.456002654844728*^9, 3.456002658888827*^9}, {
   3.456002724965486*^9, 3.456002725338838*^9}, {3.456084294083345*^9, 
