Cell["\<\
Example. Scalar-valued function: show original, not sampled, and sampled.\
\>", "Text",
 CellChangeTimes->{{3.801702084004071*^9, 3.801702111452245*^9}, {
  3.801702434889121*^9, 3.8017024384710627`*^9}, {3.801731005396798*^9, 
