 CellChangeTimes->{{3.79944345788535*^9, 3.7994434660770397`*^9}, 
   3.799449160594543*^9, 3.799497642549408*^9, 3.799501723095245*^9, 
   3.799697161396288*^9, 3.799706922374165*^9, 3.80165497397624*^9},
