  3.913543989591729*^9}},ExpressionUUID->"834103a2-8457-4548-826c-\
f0f7a5a46cb4"],

Cell["\<\
Returns: the same expression with vector points converted to scalar variables.\
\>", "Text",
 CellChangeTimes->{{3.91354389455794*^9, 
  3.91354391034676*^9}},ExpressionUUID->"713b6ca9-ec54-4b65-8704-\
4bd6b9fb5235"],

Cell["Note that we implement wrap-around indexing.", "Text",
 CellChangeTimes->{{3.719869443685957*^9, 
  3.719869458309357*^9}},ExpressionUUID->"d3996b6a-ccf1-411e-99f5-\
24b9b7b0ddb4"],

Cell["\<\
See also ParaboloidalFlasherScalarize, which this is similar to.\
\>", "Text",
 CellChangeTimes->{{3.911834740139676*^9, 3.911834746751529*^9}, 
   3.9135440302298737`*^9},ExpressionUUID->"f01c1e15-f386-4d57-9a80-\
8e4a456612d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherScalarize", "[", 
   RowBox[{
   "vars_", ",", "expr_", ",", "r_", ",", "h_", ",", "m_", ",", "t_"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "tfrules"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Get", " ", "default", " ", "deployed", " ", "form", " ", "rules", " ",
         "to", " ", "get", " ", "the", " ", "vertex"}], "-", 
       RowBox[{"specific", " ", "sag", " ", "values"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tfrules", "=", 
      RowBox[{"ThickFlasherDefaultDPRules", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Convert", " ", "symbolic", " ", "DP", " ", "and", " ", "FF", " ", 
       "points", " ", "to", " ", "their", " ", "scalarized", " ", 
       RowBox[{"forms", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"expr", "/.", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FlasherWrapRules", "[", "p", "]"}], ",", 
          RowBox[{"FlasherWrapRules", "[", "pp", "]"}]}], "}"}], "]"}]}], "/.", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"FlasherRotation3D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["px", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["py", 
             RowBox[{"i", ",", "j"}]], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SubscriptBox["p", 
                RowBox[{"i", ",", "j", ",", "k"}]], "/.", "tfrules"}], ")"}], 
             "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
           "}"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         SubscriptBox["pp", 
          RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"FlasherRotation3D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["ppx", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppy", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppz", 
             RowBox[{"i", ",", "j"}]]}], "}"}]}]}]}], "}"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.555748998987959*^9, 3.555749297183679*^9}, 
   3.555749843067773*^9, {3.55574988727124*^9, 3.555749900740972*^9}, 
   3.5557888566584663`*^9, {3.719858085665025*^9, 3.719858126082836*^9}, {
   3.719868272197376*^9, 3.719868326428454*^9}, {3.719869247710218*^9, 
   3.719869309335931*^9}, {3.719869420655345*^9, 3.719869432927297*^9}, {
   3.7199259799733953`*^9, 3.719925979979645*^9}, {3.719926048721291*^9, 
   3.719926067367735*^9}, 3.719926118246494*^9, 3.719943219372053*^9, {
   3.719943285728991*^9, 3.719943299397039*^9}, {3.825606622294828*^9, 
