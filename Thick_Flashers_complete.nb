   RowBox[{"Options", "[", "CircularAngleLabels", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SectorAngleLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DihedralAngleLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SectorAngleRadius", "\[Rule]", "0.25"}], ",", 
