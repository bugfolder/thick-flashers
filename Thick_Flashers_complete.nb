Cell[CellGroupData[{

Cell["TGraph index utilities", "Subsection",
 CellChangeTimes->{{3.591645778316106*^9, 3.591645783090271*^9}, 
   3.592344273700377*^9, {3.592345880642949*^9, 3.59234588397686*^9}, 
   3.592435846684801*^9, {3.64372506791051*^9, 
   3.643725068692646*^9}},ExpressionUUID->"632b14c7-659e-4729-99bc-\
f831f49f5ab8"],

Cell[CellGroupData[{

Cell[TextData[{
 "SamePtQ[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] [deprecated]\n\t(options) ",
 "SamePtTolerance [deprecated]",
 "\nSameEdgeQ[",
 StyleBox["e1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["e2",
  FontSlant->"Italic"],
 "]\nSameFaceQ[",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f2",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.4558951111355133`*^9, 3.45589512463133*^9}, 
   3.455923037993132*^9, 3.45653454787149*^9, {3.456534766424591*^9, 
   3.456534767614299*^9}, {3.466090248588176*^9, 3.466090257469524*^9}, 
   3.5946539879674883`*^9, {3.706719227426028*^9, 3.706719231049495*^9}, {
   3.7067193242669787`*^9, 
   3.706719326550005*^9}},ExpressionUUID->"ae2d8ff8-3109-492b-b6c3-\
1c25f3d5a9db"],

Cell[TextData[{
 "SamePtQ[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns true if the two points lie within a specified tolerance of each \
other.\nOptions are:\n\t",
 "SamePtTolerance ",
 "\[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the separation distance below which the two points are considered the \
same."
}], "Text",
 CellChangeTimes->{{3.455895216389133*^9, 3.455895261668165*^9}, 
   3.594653989413974*^9, {3.70671470333142*^9, 
   3.706714705317891*^9}},ExpressionUUID->"69a70290-7a34-461b-87a7-\
ca22a504d890"],

Cell["\<\
2017-06-17. Redefine SamePtQ and SamePtTolerance to make use of the more \
general functions PtOnPtQ and PtOnLineQ and their associated tolerances. You \
can still use SamePtQ, but it\[CloseCurlyQuote]s no longer the preferred \
calling form.\
\>", "Text",
 CellChangeTimes->{{3.7067192201936398`*^9, 3.706719278719871*^9}, {
  3.706719377594275*^9, 
  3.706719410647959*^9}},ExpressionUUID->"71fe4233-29ad-48f3-8b89-\
6e7e38806b03"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SamePtQ", "=", "PtOnPtQ"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SamePtTolerance", "=", "PtOnPtTolerance"}], ";"}]}], "Input",
 CellChangeTimes->{{3.706719282006671*^9, 3.7067193139439898`*^9}, {
  3.7068256545255957`*^9, 3.7068256547332363`*^9}},
 CellLabel->
  "In[1076]:=",ExpressionUUID->"733c7145-8e53-49bd-bc34-d981b6f149f2"],

Cell[TextData[{
 "SameEdgeQ[",
 StyleBox["e1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["e2",
  FontSlant->"Italic"],
 "] returns true if the two edges, which are given as index pairs, are equal \
in either order."
}], "Text",
 CellChangeTimes->{
  3.456534758808711*^9},ExpressionUUID->"16fe2d44-4449-4339-aef9-\
f22b781a9491"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SameEdgeQ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#1", "\[Equal]", "#2"}], "||", 
     RowBox[{"#1", "\[Equal]", 
      RowBox[{"Reverse", "[", "#2", "]"}]}]}], "&"}]}], ";"}]], "Input",
 CellLabel->
  "In[1078]:=",ExpressionUUID->"20d11eb3-05f2-4af3-8154-a8d37499ea46"],

Cell["Examples", "Text",
 CellChangeTimes->{{3.46609026963456*^9, 3.466090270322581*^9}, 
   3.466090319063322*^9},ExpressionUUID->"c595b2c2-c02e-4831-9609-\
afcb53898377"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SameEdgeQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.466090271884021*^9, 3.4660902964037237`*^9}},
 CellLabel->
  "In[1079]:=",ExpressionUUID->"27b0e6ff-a49c-478a-9a0e-08e9a0980b16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SameEdgeQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.466090281321188*^9, 3.466090302819134*^9}},
 CellLabel->
  "In[1080]:=",ExpressionUUID->"b36346f8-1636-4eaf-91c5-2d4ab8f78d9d"],

Cell[TextData[{
 "SameFaceQ[",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f2",
  FontSlant->"Italic"],
 "] returns True if the two faces ",
 StyleBox["f1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["f2",
  FontSlant->"Italic"],
 " are the same, where ",
 StyleBox["f1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["f2",
  FontSlant->"Italic"],
 " are lists of vertex indices, and the test for same-ness is that one is a \
cylic permutation of the other."
}], "Text",
 CellChangeTimes->{{3.4660900358186603`*^9, 
  3.466090084407015*^9}},ExpressionUUID->"cc423509-e853-4aa9-afb9-\
5aa5dd6e0dc2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SameFaceQ", "[", 
   RowBox[{"f1_", ",", "f2_"}], "]"}], ":=", 
  RowBox[{"Or", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"f1", "\[Equal]", "#"}], "&"}], "/@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RotateLeft", "[", 
        RowBox[{"f2", ",", "i"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "f2", "]"}]}], "}"}]}], "]"}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.466090087097999*^9, 3.466090160081534*^9}},
 CellLabel->
  "In[1081]:=",ExpressionUUID->"6fa6d769-60ce-4c37-853a-0a60696c759b"],

Cell["Examples", "Text",
 CellChangeTimes->{{3.4660901699467077`*^9, 3.466090170592857*^9}, 
   3.466090320119141*^9},ExpressionUUID->"25b9c640-636a-4c49-ab4d-\
6e42164074bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SameFaceQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4660901736271353`*^9, 3.4660902014348917`*^9}},
 CellLabel->
  "In[1082]:=",ExpressionUUID->"1eb26d4e-e96f-436d-a879-c2e367aa5326"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SameFaceQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4660901736271353`*^9, 3.466090205410409*^9}},
 CellLabel->
