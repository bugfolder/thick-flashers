Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "F", ",", "pfn", ",", "rfn", ",", "m", ",", "n", ",", "\[Alpha]", ",", 
      "\[Phi]0", ",", "efg", ",", "tobj", ",", "cp", ",", "ff"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"x_", ",", "i_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"Sign", "[", "x", "]"}], 
       SuperscriptBox[
        RowBox[{"Abs", "[", "x", "]"}], 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", "i"}], ")"}]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"0", ",", "i_"}], "]"}], ":=", "0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"F", "[", 
       RowBox[{"x_", ",", "0"}], "]"}], ":=", "x"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"pfn", "[", "i_", "]"}], "[", "\[Phi]_", "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"0.75", "+", "i"}], ")"}], 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"F", "[", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "i"}], "]"}], ",", 
         RowBox[{"F", "[", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", "i"}], "]"}]}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rfn", "[", "i_", "]"}], "[", "\[Phi]_", "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1.0", "+", "i"}], ")"}], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"F", "[", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "i"}], "]"}], ",", 
         RowBox[{"F", "[", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", "i"}], "]"}]}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m", "=", "20"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"45.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]0", "=", 
      RowBox[{"6.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"efg", "=", 
      RowBox[{"RingFunctionGraphics", "[", 
       RowBox[{"pfn", ",", "rfn", ",", "n"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRingTessellation", "[", 
       RowBox[{"m", ",", "n", ",", "\[Alpha]", ",", "pfn", ",", "rfn", ",", 
        RowBox[{"RingOffsetAngle", "\[Rule]", "\[Phi]0"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"GenericFoldedFormGraphics", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"efg", ",", "cp", ",", "ff"}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
