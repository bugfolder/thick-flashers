   3.708400956220796*^9},ExpressionUUID->"e57eaf42-37d9-444d-91ec-\
836374b04327"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.5959744295867367`*^9, 
  3.595974430037037*^9}},ExpressionUUID->"725ba6f2-fb12-472c-b528-\
d4e11c45b313"],

Cell["\<\
Note: we can improve this by using the hat-based flat-foldability condition. \
Note, too, that the unqualified function name used to be the unnormalized \
one; now FlatFoldabilityCondition is normalized.\
\>", "Text",
 CellChangeTimes->{{3.595711138419415*^9, 3.5957111621443577`*^9}, {
   3.595805872389135*^9, 3.595805912162293*^9}, 
   3.595982680258008*^9},ExpressionUUID->"5e0f036e-a95a-4e2e-9a26-\
331b0028b46c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "UnnormalizedFlatFoldabilityCondition[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qlist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.469131257949369*^9, {3.5958058321741*^9, 3.5958058557691174`*^9}, {
   3.595982674483384*^9, 3.595982674577668*^9}, 
   3.705784229592783*^9},ExpressionUUID->"695d627d-e626-475a-b325-\
40024f03d995"],

Cell[TextData[{
 "UnnormalizedFlatFoldabilityCondition[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qlist",
  FontSlant->"Italic"],
 "] takes a list of vertices ",
 StyleBox["qlist",
  FontSlant->"Italic"],
 " about the vertex ",
 StyleBox["p",
  FontSlant->"Italic"],
 " and returns a quantity that is equal to zero if the Kawasaki-Justin \
Condition is satisfied OR any of the ",
 StyleBox["q",
  FontSlant->"Italic"],
 "-points is coincident with ",
 StyleBox["p",
  FontSlant->"Italic"],
 " (which would be a spurious solution). It is entirely algebraic; no trig \
functions. However, if you are using it to solve for a set of vertices via \
some sort of optimization/root-finding, this function possesses a gradient \
toward the degenerate case, so you should not use it if a degenerate \
configuration (coincident vertices) is possible. If degenerate vertices are \
possible, then you should use the normalized version, ",
 "FlatFoldabilityCondition",
 ", below."
}], "Text",
 CellChangeTimes->{{3.469130225515993*^9, 3.469130417905787*^9}, {
  3.469131182734432*^9, 3.469131192982777*^9}, {3.533504232924219*^9, 
  3.5335042354874573`*^9}, {3.595805832223304*^9, 3.595805855838206*^9}, {
  3.595982674653816*^9, 
  3.595982674743198*^9}},ExpressionUUID->"dc2e5e61-ed93-409f-8d2e-\
c99c8b7343e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnnormalizedFlatFoldabilityCondition", "::", "oddverts"}], 
   "=", "\"\<The list of vertices `1` fed to \
UnnormalizedFlatFoldabilityCondition has an odd number of entries.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.469130473161424*^9, 3.469130501179653*^9}, 
   3.484065563619534*^9, {3.595805832257795*^9, 3.595805832496195*^9}, {
   3.5959826747814074`*^9, 3.59598267503148*^9}},
 CellLabel->
  "In[572]:=",ExpressionUUID->"f1ef7651-f196-4ec3-b82f-284ce3d6bacf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnnormalizedFlatFoldabilityCondition", "[", 
   RowBox[{"p_", ",", "qlist_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Length", "[", "qlist", "]"}], ",", "2"}], "]"}], "\[NotEqual]",
         "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"UnnormalizedFlatFoldabilityCondition", "::", "oddverts"}], 
          ",", "qlist"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Dot", "@@", 
        RowBox[{"MapThread", "[", 
         RowBox[{"UnnormalizedRotationMatrix2D", ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{"#", ",", "p"}], "]"}], "&"}], "/@", 
            RowBox[{"Partition", "[", 
             RowBox[{"qlist", ",", "2"}], "]"}]}], "]"}]}], "]"}]}], ")"}], "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.469129719609066*^9, 3.469129729526387*^9}, {
   3.469130421539913*^9, 3.46913046188865*^9}, {3.469130507894815*^9, 
   3.469130559402398*^9}, {3.469130597767445*^9, 3.46913066670321*^9}, {
   3.469130697343327*^9, 3.4691306997436438`*^9}, {3.469130798263954*^9, 
   3.469130845253001*^9}, {3.469130881986837*^9, 3.46913089308332*^9}, {
   3.469130928159906*^9, 3.469130972172232*^9}, {3.469131022434264*^9, 
   3.469131075887677*^9}, 3.595805507408243*^9, {3.595805832732235*^9, 
   3.595805832964065*^9}, {3.595982675277275*^9, 3.595982675524171*^9}},
 CellLabel->
  "In[573]:=",ExpressionUUID->"661a1d45-3160-4f87-938d-d62387f546bc"],

