Cell["A sequential folding example", "Subsubsection",
 CellChangeTimes->{{3.706821985844657*^9, 3.706821988395944*^9}, {
  3.706823479224852*^9, 3.706823479865717*^9}, {3.7068302039800878`*^9, 
  3.706830204547711*^9}},ExpressionUUID->"a19d0f58-67bd-44ff-a62a-\
f5bf2c5822d2"],

Cell["\<\
Here is an example, showing the sequential construction of a crease pattern \
for a simple duck.\
\>", "Text",
 CellChangeTimes->{{3.706819773024054*^9, 
  3.706819792056653*^9}},ExpressionUUID->"42f5da03-2a60-4c2a-bcb8-\
7d2db7e2ae8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foo", "=", 
      RowBox[{
       RowBox[{"MakeTGraph2D", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "foo", "]"}], ",", 
        RowBox[{"Graph2DGraphics", "[", "foo", "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.706819806423596*^9, 3.706819927641467*^9}, {
  3.70682173033225*^9, 3.706821730882041*^9}},
 CellLabel->
  "In[1391]:=",ExpressionUUID->"1f125813-220a-4861-b391-4faa70946ac7"],

