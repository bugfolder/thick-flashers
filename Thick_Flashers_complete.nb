Cell[BoxData[
 RowBox[{
  RowBox[{"Polygon3DPlanarAndConvexQ", "[", 
   RowBox[{"poly_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ptol", ",", "ctol", ",", "prev", ",", "next", ",", "z", ",", "prevout", 
      ",", "angles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"Polygon3DPlanarQ", "[", "poly", "]"}]}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ptol", "=", 
      RowBox[{
       RowBox[{"PlanarTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Polygon3DPlanarAndConvexQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ctol", "=", 
      RowBox[{
       RowBox[{"ConvexTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Polygon3DPlanarAndConvexQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "poly", "]"}], "<", "3"}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"prev", "=", 
      RowBox[{"Normalize", "/@", 
       RowBox[{"(", 
        RowBox[{"poly", "-", 
         RowBox[{"RotateRight", "[", "poly", "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"next", "=", 
      RowBox[{"RotateLeft", "[", "prev", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"z", "=", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
          RowBox[{"poly", "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ")"}], "\[Cross]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mag", "[", "z", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DirectedAngle3D", "[", 
          RowBox[{"#1", ",", "#2", ",", "z"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"prev", ",", "next"}], "}"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "\[GreaterEqual]", 
               RowBox[{"-", "ctol"}]}], ")"}], "&"}], "/@", "angles"}], 
           ")"}]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "\[LessEqual]", 
               RowBox[{"\[Pi]", "+", "ctol"}]}], ")"}], "&"}], "/@", 
            "angles"}], ")"}]}], ")"}]}], ")"}], "||", "\[IndentingNewLine]", 
      
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "\[LessEqual]", "ctol"}], ")"}], "&"}], "/@", 
            "angles"}], ")"}]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "\[GreaterEqual]", 
               RowBox[{
                RowBox[{"-", "\[Pi]"}], "-", "ctol"}]}], ")"}], "&"}], "/@", 
            "angles"}], ")"}]}], ")"}]}], ")"}]}]}]}], "]"}]}]], "Input",
