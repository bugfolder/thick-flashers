         RowBox[{
         "V", ",", "M", ",", "V", ",", "V", ",", "V", ",", "M", ",", "V", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"tobjcp", "=", 
