Cell[TextData[{
 "PointLineDistance[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}]\nPointSegmentDistance[",
 StyleBox["p, ",
  FontSlant->"Italic"],
 "{",
 StyleBox["q1, q2",
  FontSlant->"Italic"],
 "}]\nPointTriangleDistance[",
 StyleBox["p, ",
  FontSlant->"Italic"],
 "{",
