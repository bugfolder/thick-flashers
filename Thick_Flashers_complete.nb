Cell[CellGroupData[{

Cell[TextData[{
 "MakeRadialPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Rho], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) SamePtTolerance, TypeMinimumAngle, PotGapHalfAngle, \
PotFlatFlangeInset, PotBorder, Options[PolygonalEllipse2D]"
}], "Subsubsection",
 CellChangeTimes->{{3.594664866675481*^9, 3.594664877002656*^9}, 
   3.594665129820487*^9, 3.6152448059487543`*^9, 3.617903689960415*^9, {
   3.650062135301036*^9, 3.650062158116104*^9}, {3.650111572084089*^9, 
   3.650111603745524*^9}, {3.6503056776284647`*^9, 
   3.650305688035038*^9}},ExpressionUUID->"20fb41cd-7bf8-4e29-be30-\
aa1db927a100"],

Cell[TextData[{
 "MakeRadialPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Rho]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " defining a cross-section of a rotational pot with ",
 StyleBox["m",
  FontSlant->"Italic"],
 "-fold rotational symmetry and asymmetry factor ",
 StyleBox["\[Rho]",
  FontSlant->"Italic"],
 " and returns a TGraph3D+TAssigned containing graphs and graphics of the \
full pot, both crease pattern and folded form. Options are:\n\t\
SamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is passed through to JoinGraph3DAssigneds.\n\tTypeMinimumAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "min"], TraditionalForm]],ExpressionUUID->
  "94d0901c-3df0-4c7b-ad1d-caf4fccabbad"],
 ", specifies the minimum fold angle that is assigned M or V. This is useful \
when we have very shallow angles going up the gores. This options is passed \
through to FoldAngleToType.\n\tPotGapHalfAngle \[Rule] \[Delta], specifies \
the half-angle of the gap between the seams along the inner edges of the pot.\
\n\tPotFlatFlangeInset \[Rule] \[Epsilon], specifies a fractional inset \
toward the z-axis to be applied to the vertices on the inside of a flat \
flange version (\[Rho] = -1 or 1). This makes the renderer happy when \
rendering the 3D version, because it avoids coplanar facets.\n\tPotBorder \
\[Rule] PotPlanar | PotPolygon | PotCircular, specifies the crease pattern \
polygon shape. PotPlanar puts the boundary into a single plane in the folded \
form. PotPolygon makes the polygon a regular m-gon. PotCircular makes it a \
segment of a circle. \n\tOptions[PolygonalEllipse2D] are passed through to \
PolygonalEllipse2D and are used to specify the border quantization."
}], "Text",
 CellChangeTimes->{{3.594665135527061*^9, 3.594665206055439*^9}, 
   3.594734831653553*^9, 3.5947401785068274`*^9, 3.594741497940013*^9, 
   3.5952005312697883`*^9, 3.5952008342465*^9, {3.615244789283941*^9, 
   3.615244810594271*^9}, {3.650062139404431*^9, 3.6500621461885777`*^9}, {
   3.650063594127289*^9, 3.650063612950471*^9}, {3.650111606953057*^9, 
   3.650111673954608*^9}, {3.650305709579714*^9, 
   3.650305715480356*^9}},ExpressionUUID->"2d07eeba-5642-41fd-b41c-\
b78a45273bf8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRadialPot", "[", 
   RowBox[{"pts_List", ",", " ", "m_", ",", "\[Rho]_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobjw", ",", "verts3d", ",", "pwjv", ",", "tbl", ",", "di", ",", "gs", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobjw", "=", 
      RowBox[{"MakeRadialPotWedge", "[", 
       RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "pwjv"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobjw", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "PotWedgeJoinVertices"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "we", " ", "need", " ", "3", " ", "points", " ", "along", " ", "each", 
        " ", "edge", " ", "to", " ", "match", " ", "up"}], ",", " ", 
       RowBox[{"and", " ", "for", " ", "best", " ", "accuracy"}], ",", " ", 
       RowBox[{
       "the", " ", "third", " ", "point", " ", "should", " ", "be", " ", "as",
         " ", "far", " ", "off", " ", "of", " ", "the", " ", "line", " ", 
        "between", " ", "the", " ", "first", " ", "two", " ", "as", " ", 
        RowBox[{"possible", ".", " ", "So"}]}], ",", " ", 
       RowBox[{
       "we", " ", "make", " ", "a", " ", "table", " ", "of", " ", "all", " ", 
        "of", " ", "the", " ", "points", " ", "along", " ", "the", " ", 
        "bottom", " ", "edge", " ", "and", " ", "sort", " ", "them", " ", 
        "by", " ", "distance", " ", "from", " ", "the", " ", "line", " ", 
        "between", " ", "the", " ", "two", " ", 
        RowBox[{"corners", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tbl", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"di", ",", 
          RowBox[{"PointLineDistance", "[", 
           RowBox[{
            RowBox[{"verts3d", "\[LeftDoubleBracket]", 
             RowBox[{"pwjv", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "di"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"verts3d", "\[LeftDoubleBracket]", 
               RowBox[{"pwjv", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"verts3d", "\[LeftDoubleBracket]", 
               RowBox[{"pwjv", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", 
                 RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"di", ",", "1", ",", 
          RowBox[{"Length", "[", 
           RowBox[{
           "pwjv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"di", "=", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"tbl", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<", 
           
           RowBox[{
           "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "&"}]}], "]"}], "\[LeftDoubleBracket]", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Now", " ", "build", " ", "the", " ", "list", " ", "of", " ", 
       "graphspecs", " ", "for", " ", "joining", " ", "sequentially"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tobjw", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"i", "-", "1"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", 
                RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", "di"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "di"}], "\[RightDoubleBracket]"}]}], "}"}]}],
            "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"JoinGraph3DAssigneds", "[", 
       RowBox[{"gs", ",", "opts"}], "]"}], "//", "AddTPlaneGraph"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.650062212370223*^9, 3.650062323762513*^9}, {
   3.650062357167031*^9, 3.650062473504459*^9}, {3.650062656564355*^9, 
