Cell[TextData[{
 "Returns: a list {",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["l",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 "} of the curve and Darboux frame from the specified coefficients and \
initial conditions, all given as vector-valued functions."
}], "Text",
