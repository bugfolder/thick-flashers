 CellLabel->
  "In[2850]:=",ExpressionUUID->"360c14e5-d4cc-4620-91fd-4b98523f7e63"],

Cell["\<\
Note that the default options only draw the outline of the tile. For \
everything else, you must turn on the option explicitly.\
\>", "Text",
 CellChangeTimes->{{3.627585523445816*^9, 3.627585603664319*^9}, {
  3.627586521054184*^9, 3.627586536221035*^9}, {3.629820931970758*^9, 
  3.629820932863431*^9}},ExpressionUUID->"00e7c8bc-01d3-40e5-8617-\
15589bb4174c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PolygonTile", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TilePolys", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     RowBox[{"TileEdges", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"TileVertexIndices", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"TileEdgeArrowStyle", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"TilePolyFill", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"TileEdgeArrowDirs", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"TileIndex", "\[Rule]", "None"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.627579242589376*^9, 3.627579298565969*^9}, {
   3.627583949851658*^9, 3.62758405152479*^9}, 3.627584104529475*^9, {
   3.627584317980817*^9, 3.627584318539253*^9}, {3.6275854549332*^9, 
