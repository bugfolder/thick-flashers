a3104d5dce18"],

Cell["\<\
Example. Show a cross section with pretty big gaps and slightly thicker \
central polygon hinges. Zooming in, we can see that the central panel hinges \
are horizontal and have their surfaces flush with the edges of the panels \
that they connect to, thanks to the tweaking that happens in \
ThickFlasherStowedHingeJoinPanels.\
\>", "Text",
 CellChangeTimes->{{3.912005706338274*^9, 3.912005707144905*^9}, 
   3.9123243848281107`*^9, {3.922567257842595*^9, 3.922567267855829*^9}, {
   3.922568462380372*^9, 3.922568476239668*^9}, {3.9226107659378777`*^9, 
   3.922610815632957*^9}},ExpressionUUID->"1457fef6-f0eb-44b1-9ea1-\
b32ec986fdc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", "1"}], ",", 
       RowBox[{"h", "=", "2"}], ",", 
       RowBox[{"m", "=", "6"}], ",", 
       RowBox[{"t", "=", "0.15"}], ",", "tobj", ",", "panels", ",", 
       "panelinfo", ",", "joinedpanels"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"tobj", "=", 
       RowBox[{"MakeThickFlasher", "[", 
        RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
         RowBox[{"TypeMinimumAngle", "\[Rule]", 
          RowBox[{"10.", "\[Degree]"}]}], ",", 
         RowBox[{
         "FlasherSectorDiagFoldLines", "->", 
          "FlasherSectorDiagFoldLinesY"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
       RowBox[{"MakeThickFlasherPanels", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"FlasherScale", "->", "2.0"}], ",", 
         RowBox[{"PanelClearance", "->", "0.1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"joinedpanels", "=", 
       RowBox[{"ThickFlasherStowedHingeJoinPanels", "[", 
        RowBox[{
        "panels", ",", "panelinfo", ",", "tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"PanelClearance", "->", "0.1"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"CentralHingeThickness", "->", "0.05"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"OuterHingeThickness", "->", "0.03"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"HingeShiftTolerance", "->", 
          RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
            "joinedpanels", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}], ",", "SolidStyle", ",", 
            RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
            "joinedpanels", "\[LeftDoubleBracket]", "2", 
             "\[RightDoubleBracket]"}], ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"All", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "All"}], "}"}], ",", "All"}], "}"}]}]}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "Hold"}], 
  ";"}]], "Input",
