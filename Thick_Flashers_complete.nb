 CellChangeTimes->{{3.4629254519036503`*^9, 3.462925499408076*^9}, {
   3.462925676894085*^9, 3.46292568997992*^9}, {3.462925834833702*^9, 
   3.462925903028626*^9}, 3.462926107953025*^9, 3.462927171760098*^9, 
   3.592559364339998*^9, {3.627818700445024*^9, 3.627818705245915*^9}},
 CellLabel->
  "In[3396]:=",ExpressionUUID->"14c08565-922e-4b70-b3a5-1a4222b40270"],

Cell[TextData[{
 "MakeChordStarLines",
 "[",
 StyleBox["specs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["boundary",
  FontSlant->"Italic"],
 "] takes a set of points that define the boundary polygon and extends/clips \
the lines to this polygon. Note that all points on the boundary are \
duplicated/rotated with the same rotational order, so you only need to give a \
single point for a regular ",
 StyleBox["m",
  FontSlant->"Italic"],
 "-gon. Note, too, that if the generated polygon is nonconvex, then an \
incorrect result may be returned."
}], "Text",
 CellChangeTimes->{{3.4629259638114*^9, 3.462926006310923*^9}, {
   3.462926124470881*^9, 3.46292615513275*^9}, {3.4629268820939407`*^9, 
   3.462926912097761*^9}, 3.462927173436082*^9, 
   3.592559364606587*^9},ExpressionUUID->"4b222658-3b3f-4665-9a53-\
479d32ff72a2"],

Cell["\<\
This is a bit more generous than the boundary-less version, because we do \
allow specs for lines that lie wholly outside the boundary as input; but \
these won't end up making any contribution to the pattern.\
\>", "Text",
 CellChangeTimes->{{3.46679935394119*^9, 3.466799410318904*^9}, {
  3.466799468596003*^9, 
  3.466799475522878*^9}},ExpressionUUID->"76a9004e-61c8-4d43-b3fc-\
a4b8dd1a8e97"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeChordStarLines", "[", 
   RowBox[{"specs_List", ",", "m_", ",", "boundary_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bmax", ",", "fspecs", ",", "lines", ",", "alllines", ",", "bverts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bmax", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Mag", "/@", "boundary"}], "]"}]}], 
     RowBox[{"(*", " ", 
      RowBox[{
      "get", " ", "circumradius", " ", "of", " ", "the", " ", "boundary"}], 
      " ", "*)"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fspecs", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"specs", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}],
           "<", "bmax"}], "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "filter", " ", "specs", " ", "to", " ", "drop", " ", "any", " ", "that",
        " ", "lie", " ", "outside", " ", "the", " ", "circumcircle", " ", 
       "of", " ", "boundary"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"bmax", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"U", "[", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
             RowBox[{"ArcCos", "[", 
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "/",
                "bmax"}], "]"}]}], "]"}], ",", 
           RowBox[{"U", "[", 
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
             RowBox[{"ArcCos", "[", 
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "/",
                "bmax"}], "]"}]}], "]"}]}], "}"}]}], "&"}], "/@", 
       "fspecs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"alllines", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"RotationMatrix2D", "[", 
               RowBox[{"2", "\[Pi]", " ", 
                RowBox[{"i", "/", "m"}]}], "]"}], ".", "#"}], "&"}], ",", 
            "lines", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"bverts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"RotationMatrix2D", "[", 
               RowBox[{"2", "\[Pi]", " ", 
                RowBox[{"i", "/", "m"}]}], "]"}], ".", "#"}], "&"}], ",", 
            "boundary"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"bverts", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"bverts", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"ArcTan", "@@", "#1"}], "<", 
          RowBox[{"ArcTan", "@@", "#2"}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alllines", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ClipSegmentToConvexPolygon", "[", 
         RowBox[{"#", ",", "bverts"}], "]"}], "&"}], "/@", "alllines"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"alllines", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"alllines", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{"Subtract", "@@", "#"}], "]"}], ">", "0"}], "&"}]}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"filter", " ", "lines", " ", "to", " ", "drop", " ", "zero"}], 
       "-", 
       RowBox[{"length", " ", "ones"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Join", "[", 
      RowBox[{"alllines", ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"bverts", ",", 
          RowBox[{"RotateLeft", "[", "bverts", "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.462925377675631*^9, 3.462925392062943*^9}, {
   3.462925439292143*^9, 3.462925462730301*^9}, {3.462925509087701*^9, 
   3.462925667489337*^9}, {3.462925706912261*^9, 3.4629258261362*^9}, {
   3.462926210889461*^9, 3.4629263862142353`*^9}, {3.462926422959728*^9, 
   3.462926449312672*^9}, 3.462926539096349*^9, {3.462926655363264*^9, 
   3.462926655617315*^9}, {3.4629267035989*^9, 3.462926751954622*^9}, 
   3.462927175153977*^9, {3.462927353768126*^9, 3.462927357572482*^9}, {
   3.466793439026913*^9, 3.46679344328961*^9}, 3.466793511021104*^9, {
   3.466798202757843*^9, 3.466798211298377*^9}, {3.466798272875331*^9, 
   3.466798282106928*^9}, {3.466798337297594*^9, 3.46679834475733*^9}, {
   3.466798412208529*^9, 3.466798531192787*^9}, {3.466799479247843*^9, 
   3.466799571937908*^9}, {3.4667996026758413`*^9, 3.46679965555587*^9}, 
   3.592559364635763*^9, {3.6881669733779*^9, 3.688166975059419*^9}, {
   3.70578396599242*^9, 3.705783968233293*^9}},
 CellLabel->
