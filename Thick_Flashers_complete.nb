    RowBox[{"{", 
     RowBox[{
     "fn", ",", "hcwc", ",", "val", ",", "soln", ",", "ti1", ",", "ti2", ",", 
      "\[Gamma]1i", ",", "\[Gamma]2i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"fn", "[", 
       RowBox[{
        RowBox[{"ti1a_", "?", "NumericQ"}], ",", 
        RowBox[{"ti2a_", "?", "NumericQ"}], ",", 
        RowBox[{"\[Gamma]1i_", "?", "NumericQ"}], ",", 
        RowBox[{"\[Gamma]2i_", "?", "NumericQ"}]}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", "ff1", ",", 
          "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", "yR", ",", 
          "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", "ff1", ",",
             "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", "yR", ",",
             "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2"}], 
           "}"}], "=", "\[IndentingNewLine]", 
          RowBox[{"hcwc", "=", 
           RowBox[{"HCwCCircle4", "[", 
            RowBox[{
            "ti1a", ",", "ti2a", ",", "\[Gamma]1i", ",", "\[Gamma]2i"}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"q", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", 
            RowBox[{"\[Pi]", "/", "3"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"yL", ".", "yR"}], "-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Pi]", "/", "6"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"RotationMatrix3D", "[", 
               RowBox[{"\[Pi]", ",", "pv"}], "]"}], ".", "yL"}], ")"}], ".", 
            "z"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"RotationMatrix3D", "[", 
               RowBox[{"\[Pi]", ",", "pv"}], "]"}], ".", "yL"}], ")"}], ".", 
            "xR"}]}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"val", "=", 
      RowBox[{"fn", "[", 
       RowBox[{
        RowBox[{"33.", "\[Degree]"}], ",", 
        RowBox[{"87.", "\[Degree]"}], ",", 
        RowBox[{"60.", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "52."}], "\[Degree]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"fn", "[", 
         RowBox[{"ti1", ",", "ti2", ",", "\[Gamma]1i", ",", "\[Gamma]2i"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ti1", ",", 
          RowBox[{"33.", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ti2", ",", 
          RowBox[{"87.", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]1i", ",", 
          RowBox[{"60.", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]2i", ",", 
          RowBox[{
           RowBox[{"-", "52."}], "\[Degree]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti1", ",", "ti2", ",", "\[Gamma]1i", ",", "\[Gamma]2i"}], 
       "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ti1", ",", "ti2", ",", "\[Gamma]1i", ",", "\[Gamma]2i"}], 
        "}"}], "/.", "soln"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"HCwCCircle4Parms", "=", 
      RowBox[{"{", 
       RowBox[{"ti1", ",", "ti2", ",", "\[Gamma]1i", ",", "\[Gamma]2i"}], 
       "}"}]}]}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.803567565301915*^9, 3.803567667948245*^9}, {
   3.803567814958103*^9, 3.80356790581448*^9}, {3.803567953727151*^9, 
   3.803567989759932*^9}, {3.803568052951454*^9, 3.803568104976071*^9}, {
   3.803568229204255*^9, 3.803568368641814*^9}, {3.803568407292774*^9, 
