Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"glist", ",", "amax", ",", "rslice"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"glist", "=", 
      RowBox[{"MakeFlutedConeCreaseVectors", "[", 
       RowBox[{"16", ",", "5", ",", 
        RowBox[{"30.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"amax", "=", 
      RowBox[{"MaxSliceAngle", "[", "glist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<amax/\[Degree]=\>\"", ",", 
       RowBox[{"amax", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rslice", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", "amax", "]"}]}], ",", "0", ",", 
        RowBox[{"Cos", "[", "amax", "]"}]}], "}"}]}], ";", 
