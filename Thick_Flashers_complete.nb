Cell[CellGroupData[{

Cell[TextData[{
 "MakeReciprocalDiagram[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TPrimalDualGraph\n\t(options) Method, \
OrthogonalityTolerance, PleatLengthWeight\n\t(Method values) \"MaxMinPleat\", \
\"MinTotalPleat\", \"MinPleatRange\", \"Tolerant\", \"Robust\""
}], "Subsubsection",
 CellChangeTimes->{
  3.461740612771103*^9, {3.461743096218454*^9, 3.4617431111500587`*^9}, {
   3.4617591507678633`*^9, 3.461759151224167*^9}, 3.4659246493867702`*^9, {
   3.465949011358971*^9, 3.465949073120145*^9}, {3.465989231873021*^9, 
   3.465989239647595*^9}, {3.465989743789423*^9, 3.465989745652463*^9}, {
   3.485197453017054*^9, 3.485197465941636*^9}, {3.591738697409278*^9, 
   3.591738722961526*^9}, {3.591739338104188*^9, 3.591739344710312*^9}, {
   3.5917393870093813`*^9, 3.591739387376348*^9}, 3.591781518188282*^9, {
   3.591781552260526*^9, 3.591781554699251*^9}, 3.592208673838876*^9, 
   3.592402541743029*^9, {3.592433159811523*^9, 3.5924331605716553`*^9}, 
   3.592828807358418*^9, {3.595286582490795*^9, 3.595286589858396*^9}, {
   3.595286876981887*^9, 
   3.595286877549987*^9}},ExpressionUUID->"32e9c0a0-cf82-498d-b567-\
54d07bc67b3f"],

Cell[TextData[{
 "MakeReciprocalDiagram[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TPrimalDualGraph and returns a revised TPrimalDualGraph \
containing revised DualVertices, which are the vertex coordinates for the \
reciprocal diagram. On input, DualVertices",
 StyleBox[" ",
  FontSlant->"Italic"],
 "is the initial set of dual coordinates to be used in the search, which \
should be close to the solution (typically the centroids). Options are:\n\t\
Method\[Rule]\"MaxMinPleat\" | \"MinTotalPleat\" | \"MinPleatRange\" | \
\"Tolerant\" | \"Robust\", specifying the algorithm to use to find the \
solution. \"MaxMinPleat\" seems to be the best algorithm, because it always \
finds a solution and shows explicitly if the minimum pleat width is negative \
(no solution).\n\tOrthogonalityTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where if ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is nonzero, the orthogonality clamps the orthogonality between \
\[PlusMinus]",
 StyleBox["tol",
  FontSlant->"Italic"],
 " rather than forcing it equal to zero in the \"Tolerant\" algorithm.\n\t\
PleatLengthWeight\[Rule]",
 StyleBox["weight",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["weight",
  FontSlant->"Italic"],
 " is a factor that mixes in some total pleat length into the optimization \
objective function."
}], "Text",
 CellChangeTimes->{{3.455922758337665*^9, 3.4559227722016706`*^9}, {
   3.455922925197754*^9, 3.455922959502782*^9}, {3.455924083616248*^9, 
   3.455924107996847*^9}, {3.455994731955532*^9, 3.455994790959179*^9}, {
   3.461724513123178*^9, 3.461724554736927*^9}, {3.461724599653871*^9, 
   3.461724602156648*^9}, {3.461724697838536*^9, 3.4617247583055162`*^9}, {
   3.46173708482376*^9, 3.46173711200461*^9}, {3.461754825685886*^9, 
   3.461754854888859*^9}, {3.461755682261284*^9, 3.461755739360614*^9}, 
   3.461756759996653*^9, {3.461756791021126*^9, 3.461756806698029*^9}, {
   3.461759161871138*^9, 3.461759194749065*^9}, {3.465989245465854*^9, 
   3.465989300131326*^9}, {3.591739394306511*^9, 3.591739470718264*^9}, 
   3.592208674018465*^9, {3.592404151762332*^9, 3.592404186205718*^9}, {
   3.592828807503442*^9, 3.592828807622283*^9}, {3.595286884661394*^9, 
   3.595286885213079*^9}, 
   3.7083430512334642`*^9},ExpressionUUID->"26b10e12-5fa5-4f87-aa22-\
d7921081294e"],

Cell["\<\
The different algorithms work as follows:
\"MaxMinPleat\" -- is linear. It fixes the sum of the total pleat width (this \
prevents the dual graph from collapsing to a point), then maximizes the \
minimum pleat width. If this minimum pleat width comes out to be negative, \
then there is no solution and the original graph is not a spiderweb.
\"MinTotalPleat\" -- is linear. It sets a minimum size on the pleat width, \
then tries to minimize the sum of all pleat widths.
\"MinPleatRange\" -- is linear. It sets a minimum size on the pleat width, \
then introduces a slack variable lmax that all pleats are constrained to lie \
below; it then minimizes lmax. This minimizes the ratio between the minimum \
and maximum pleat width.
\"Tolerant\" -- is linear. It's similar to \"MinPleatRange\", but instead of \
enforcing rigid orthogonality, it merely clamps the orthogonality to lie \
within a narrow range.
\"Robust\" -- is nonlinear. We minimize an RMS sum of the orthogonality \
deviation with a little bit of the sum of the pleat widths mixed in. So this \
is approximate.
\"Test\" -- nonlinear, and is just something I'm playing around with.\
\>", "Text",
 CellChangeTimes->{{3.465949330936764*^9, 3.465949554528081*^9}, {
  3.4659495958448267`*^9, 3.465949663632349*^9}, {3.46598930360675*^9, 
  3.46598935605545*^9}},ExpressionUUID->"1eeeed1d-406b-48d1-ad4b-\
ece5452373b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OrthogonalityTolerance", "::", "usage"}], 
   "=", "\"\<OrthogonalityTolerance is an option to MakeReciprocalDiagram \
that establishes a nonzero tolerance on the primal-dual orthogonality \
condition.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591738766863454*^9, 3.5917388104418917`*^9}, 
   3.592208674038353*^9},
 CellLabel->
  "In[1521]:=",ExpressionUUID->"6f5ce8c3-572e-4aff-b36e-b28cb2f96bbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PleatLengthWeight", "::", "usage"}], 
   "=", "\"\<PleatLengthWeight is a option to MakeReciprocalDiagram that lets \
you mix some total pleat length into the optimization objective \
function.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591738815323806*^9, 3.5917388647189293`*^9}, 
   3.592208674045043*^9},
 CellLabel->
  "In[1522]:=",ExpressionUUID->"88416ea5-e860-4285-95a8-ccbfd81a09d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeReciprocalDiagram", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Method", "\[Rule]", "\"\<MaxMinPleat\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"OrthogonalityTolerance", "\[Rule]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PleatLengthWeight", "\[Rule]", "1.0"}]}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.461724667440961*^9, 3.461724687977838*^9}, {
   3.461754752611536*^9, 3.461754758921314*^9}, {3.461754808632674*^9, 
   3.461754821453203*^9}, {3.46175566622635*^9, 3.461755678199677*^9}, 
   3.461756761011957*^9, {3.465989363633681*^9, 3.465989365705422*^9}, 
   3.592208674057251*^9},
 CellLabel->
  "In[1523]:=",ExpressionUUID->"cafcb551-8668-49c5-b752-616452e53553"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MakeReciprocalDiagram", "::", "nosoln"}], 
   "=", "\"\<BuildReciprocalDiagrams was unable to find a solution.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeReciprocalDiagram", "::", "unsup"}], 
   "=", "\"\<`1` is an unsupported method of MakeReciprocalDiagram.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeReciprocalDiagram", "::", "notweb"}], 
   "=", "\"\<MakeReciprocalDiagram found a negative minimum pleat width and \
so this graph is not a spiderweb.\>\""}], ";"}]}], "Input",
 CellChangeTimes->{{3.461729248878737*^9, 3.461729296694051*^9}, 
   3.46174091407474*^9, {3.484576110807555*^9, 3.484576117816773*^9}, {
   3.592208674105184*^9, 3.592208674239202*^9}},
 CellLabel->
  "In[1524]:=",ExpressionUUID->"001043df-5f77-4346-a4c8-29e65ed177d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeReciprocalDiagram", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "faces", ",", "me", ",", "tol", ",", "plw", ",", "iedges", 
      ",", "dverts", ",", "dedges", ",", "v", ",", "vars", ",", "vars0", ",", 
      "dcoords", ",", "lmax", ",", "lmin", ",", "pairsv", ",", "dpairsv", ",",
       "dplens", ",", "drules", ",", "orthofn", ",", "ortho", ",", "eqns", ",",
       "ineqns", ",", "obj", ",", "pineqns", ",", "soln", ",", "dverts1", ",",
       "ro", ",", "xo", ",", "yo", ",", "rms", ",", "soln1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPrimalDualGraph", ",", "MakeReciprocalDiagram"}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"me", "=", 
      RowBox[{
       RowBox[{"Method", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeReciprocalDiagram", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"OrthogonalityTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeReciprocalDiagram", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plw", "=", 
      RowBox[{
       RowBox[{"PleatLengthWeight", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeReciprocalDiagram", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Build", " ", "the", " ", "plane", " ", "graph", " ", "parts", " ", 
       "for", " ", "a", " ", "false", " ", "reciprocal", " ", "diagram"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "iedges", ",", "dverts", ",", "dedges"}], "}"}], 
      "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "InteriorEdges", ",", "DualVertices", ",", 
          "DualEdges"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Set", " ", "up", " ", "to", " ", "solve", " ", "for", " ", "the", " ", 
       "new", " ", "dverts"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Unique", "[", "v", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", " ", 
          RowBox[{"Length", "[", "dverts", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vars0", "=", 
      RowBox[{"Flatten", "[", "dverts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dcoords", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{"vars", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"drules", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Rule", ",", 
        RowBox[{"{", 
         RowBox[{"vars", ",", "vars0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pairsv", "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Subtract", "@@", 
           RowBox[{
           "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
          "&"}], "/@", "iedges"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dpairsv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Subtract", "@@", 
           RowBox[{
           "dcoords", "\[LeftDoubleBracket]", "#", 
            "\[RightDoubleBracket]"}]}], "&"}], "/@", "dedges"}]}], ";", " ", 
       
       RowBox[{"(*", " ", 
        RowBox[{"dpairsv", " ", "are", " ", "not"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dplens", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Dot", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Rotate90", "/@", "pairsv"}], ",", "dpairsv"}], "}"}]}], 
         "]"}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{
        "gives", " ", "length", " ", "of", " ", "dual", " ", "edge", " ", 
         "when", " ", "ortho", " ", "holds"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"dplens", "=", 
        RowBox[{"dplens", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sign", "/@", "dplens"}], "/.", "drules"}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"ortho", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Dot", ",", 
          RowBox[{"{", 
           RowBox[{"pairsv", ",", 
            RowBox[{"dpairsv", "/", 
             RowBox[{"(", 
              RowBox[{"Mag", "/@", 
               RowBox[{"(", 
                RowBox[{"dpairsv", "/.", "drules"}], ")"}]}], ")"}]}]}], 
           "}"}]}], "]"}]}], ";"}], 
      RowBox[{"(*", " ", 
       RowBox[{"approximately", " ", "normalized", " ", "ortho"}], " ", 
       "*)"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dpairsv", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Subtract", "@@", 
         RowBox[{
         "dcoords", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
        "&"}], "/@", "dedges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dplens", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Dot", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Rotate90", "/@", "pairsv"}], ",", "dpairsv"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dplens", "=", 
      RowBox[{"dplens", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sign", "/@", "dplens"}], "/.", "drules"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ortho", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Dot", ",", 
        RowBox[{"{", 
         RowBox[{"pairsv", ",", "dpairsv"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pineqns", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
           "vars", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]", 
           RowBox[{
           "vars0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          ",", 
          RowBox[{
           RowBox[{
           "vars", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]", 
           RowBox[{
           "vars0", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
               "vars0", "\[LeftDoubleBracket]", "3", 
                "\[RightDoubleBracket]"}], "-", 
               RowBox[{
               "vars0", "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}]}], "]"}], ">", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
               "vars0", "\[LeftDoubleBracket]", "4", 
                "\[RightDoubleBracket]"}], "-", 
               RowBox[{
               "vars0", "\[LeftDoubleBracket]", "2", 
                "\[RightDoubleBracket]"}]}], "]"}]}], ",", 
            RowBox[{
             RowBox[{
             "vars", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[Equal]", 
             RowBox[{
             "vars0", "\[LeftDoubleBracket]", "3", 
              "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{
             RowBox[{
             "vars", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "\[Equal]", 
             RowBox[{
             "vars0", "\[LeftDoubleBracket]", "4", 
              "\[RightDoubleBracket]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
         "}"}]}], ";"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"me", "\[Equal]", "\"\<MaxMinPleat\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars", ",", "lmin"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars0", ",", 
          RowBox[{"-", "1.0"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"eqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Plus", "@@", "dplens"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Plus", "@@", "dplens"}], "/.", "drules"}], ")"}]}], 
            "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "ortho"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ineqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[GreaterEqual]", "lmin"}], "&"}], "/@", "dplens"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"obj", "=", 
         RowBox[{"-", "lmin"}]}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"me", "\[Equal]", "\"\<MinTotalPleat\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[Equal]", "0"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "ortho"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ineqns", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[GreaterEqual]", "1"}], "&"}], "/@", "dplens"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"obj", "=", 
         RowBox[{"Plus", "@@", "dplens"}]}], ";"}], "\[IndentingNewLine]", ",",
        "\[IndentingNewLine]", 
       RowBox[{"me", "\[Equal]", "\"\<MinPleatRange\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars", ",", "lmax"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars0", ",", "2"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"eqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[Equal]", "0"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "ortho"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ineqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[GreaterEqual]", "1"}], "&"}], "/@", "dplens"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[LessEqual]", "lmax"}], "&"}], "/@", "dplens"}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"obj", "=", "lmax"}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"me", "\[Equal]", "\"\<Tolerant\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars", ",", "lmax"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars0", ",", "2"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"eqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[Equal]", "0"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "ortho"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ineqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[GreaterEqual]", "1"}], "&"}], "/@", "dplens"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[LessEqual]", "lmax"}], "&"}], "/@", "dplens"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[GreaterEqual]", 
              RowBox[{"-", "tol"}]}], "&"}], "/@", "ortho"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[LessEqual]", "tol"}], "&"}], "/@", "ortho"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"obj", "=", "lmax"}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"me", "\[Equal]", "\"\<Robust\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eqns", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ineqns", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[GreaterEqual]", "1"}], "&"}], "/@", "dplens"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"obj", "=", 
         RowBox[{
          RowBox[{"plw", 
           RowBox[{"(", 
            RowBox[{"Plus", "@@", "dplens"}], ")"}]}], "+", 
          RowBox[{"(", 
           RowBox[{"Plus", "@@", 
            SuperscriptBox["ortho", "2"]}], ")"}]}]}], ";"}], 
       "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
       RowBox[{"me", "\[Equal]", "\"\<Test\>\""}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars", ",", "lmin"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"vars0", ",", "0.0"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"eqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[Equal]", 
              RowBox[{
              "vars0", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{
              RowBox[{
              "vars", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[Equal]", 
              RowBox[{
              "vars0", "\[LeftDoubleBracket]", "2", 
               "\[RightDoubleBracket]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Plus", "@@", "dplens"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Plus", "@@", "dplens"}], "/.", "drules"}], ")"}]}], 
            "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "ortho"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ineqns", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[GreaterEqual]", "lmin"}], "&"}], "/@", "dplens"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"obj", "=", 
         RowBox[{"-", "lmin"}]}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeReciprocalDiagram", "::", "unsup"}], ",", "me"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"PrintThis", "[", "obj", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"PrintThis", "[", "eqns", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"PrintThis", "[", "ineqns", "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"PrintThis", "[", "vars", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"PrintThis", "[", "vars0", "]"}], ";"}], "\[IndentingNewLine]",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindMinimum", "@@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", "obj", "}"}], ",", "eqns", ",", "ineqns"}], "]"}], 
          "}"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"vars", ",", "vars0"}], "}"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "FindMinimum"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"MakeReciprocalDiagram", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"me", "\[Equal]", "\"\<MaxMinPleat\>\""}], "&&", 
        RowBox[{
         RowBox[{
         "soln", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ">", 
         "0"}]}], ",", 
       RowBox[{"Message", "[", 
        RowBox[{"MakeReciprocalDiagram", "::", "notweb"}], "]"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Now", " ", "find", " ", "the", " ", 
       RowBox[{"translated", "/", "scaled"}], " ", "version", " ", "with", " ",
        "min", " ", "rms", " ", "deviation", " ", "from", " ", "original", " ",
        "dverts"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dverts1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ro", " ", "#"}], "+", 
         RowBox[{"{", 
          RowBox[{"xo", ",", "yo"}], "}"}]}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{"dcoords", "/.", 
         RowBox[{
         "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rms", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Plus", "@@", 
        RowBox[{"Mag2", "/@", 
         RowBox[{"(", 
          RowBox[{"dverts1", "-", "dverts"}], ")"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln1", "=", 
      RowBox[{"FindMinimum", "[", 
       RowBox[{"rms", ",", 
        RowBox[{"{", 
         RowBox[{"ro", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"xo", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"yo", ",", "0"}], "}"}], ",", 
        RowBox[{"AccuracyGoal", "\[Rule]", "6"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"don", "'"}], "t", " ", "need", " ", "a", " ", "ton", " ", 
       "of", " ", "accuracy", " ", "here"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{"dverts1", "/.", 
       RowBox[{
       "soln1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"DualVertices", "\[Rule]", "dverts"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
