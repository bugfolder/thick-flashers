Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives the arbitrary-speed 3D space curve.\
\n\t",
 StyleBox["uu",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives the 3D surface normal vector along \
the curve.\n\t{u0, u1} \[LongDash] the domain of interpolation."
}], "Text",
