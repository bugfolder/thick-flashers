Cell["\<\
An algebraic example, to check expressions for the normal and geodesic \
curvature in terms of the principal curvatures.\
\>", "Text",
 CellChangeTimes->{{3.687999680570673*^9, 
  3.6879997284455643`*^9}},ExpressionUUID->"5c1150d8-71f7-46bc-a630-\
0ac722507928"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "as", ",", "k1", ",", "k2", ",", "ss", ",", "u", ",", "v", ",", "t", ",",
       "ssu", ",", "ssv", ",", "soln", ",", "uuu", ",", "\[Alpha]", ",", "qq",
       ",", "ff", ",", "uu", ",", "csys", ",", "dsys", ",", "tt", ",", "nn", ",",
       "bb", ",", "ll", ",", "fda", ",", "kn", ",", "kg", ",", "tg", ",", 
      "r"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"as", "=", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", "\[Element]", "Reals"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
