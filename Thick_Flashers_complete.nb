Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r", ",", "\[Theta]", ",", "\[Gamma]0", ",", "as", ",", "ff", ",", 
       "rrL", ",", "rrR", ",", "\[Gamma]", ",", "s"}], "}"}], ",", 
