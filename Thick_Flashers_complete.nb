Cell[TextData[{
 "PotCrossSectionGraphics[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " and returns a Graphics object that displays the pot cross section. The \
first point should be {0,0}, but if it isn\[CloseCurlyQuote]t, we\
\[CloseCurlyQuote]ll translate it. Options are:\n\tOptions[Graphics]"
}], "Text",
 CellChangeTimes->{{3.594584511008427*^9, 3.594584575116143*^9}, {
  3.594584832621318*^9, 
  3.594584834948792*^9}},ExpressionUUID->"07861c14-412a-42e4-aa56-\
d62fb1d753e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PotCrossSectionGraphics", "[", 
   RowBox[{
    StyleBox["pts_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pts1", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{
         "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        "&"}], "/@", "pts"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Line", "[", "pts1", "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], "#"}], "&"}], "/@", 
           "pts1"}], "]"}]}], "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594584582324759*^9, 3.594584661595763*^9}, {
  3.594584837349984*^9, 3.594584873661078*^9}},
 CellLabel->
  "In[3455]:=",ExpressionUUID->"e700b243-7cde-4e31-a906-f438417b75fd"],

