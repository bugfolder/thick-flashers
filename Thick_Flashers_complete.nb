     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"TwoUniformVertexTypes", "[", "n", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "20"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"list", ",", 
       RowBox[{
        RowBox[{"And", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"EvenQ", "[", 
             RowBox[{"Length", "[", "#", "]"}], "]"}], "&"}], "/@", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          ")"}]}], "&"}]}], "]"}], "//", "ColumnForm"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.6313084379567547`*^9, 3.6313085341070833`*^9}, {
  3.631308571842259*^9, 3.63130865418946*^9}},
 CellLabel->
  "In[3274]:=",ExpressionUUID->"408ce49c-8e92-493b-941b-2bfa58d42f52"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Periodic equilateral pentagon tilings", "Subsection",
 CellChangeTimes->{{3.631100984664033*^9, 3.6311009872717447`*^9}, {
  3.631270170227447*^9, 
  3.631270184814458*^9}},ExpressionUUID->"eb778de3-64e1-442c-92c1-\
30f093fb2f55"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.631101028020976*^9, 
  3.631101028460688*^9}},ExpressionUUID->"52ea514b-c195-4797-aa6e-\
d38c399fa259"],

Cell["\<\
There are five families of equilateral pentagons that tile the plane. Most of \
them are nonconvex, but there are five that are convex. Most of the five are \
neither cyclic (suitable for centered twists) or closed-back-twist (suitable \
for offset twist tilings), but if we subdivide a pentagon into a triangle and \
a quad, we can (sometimes) get a twist-tilable tiling.\
\>", "Text",
 CellChangeTimes->{{3.631101030261366*^9, 3.63110109081734*^9}, {
  3.631101137439641*^9, 3.631101202122396*^9}, {3.631101244447372*^9, 
  3.631101279452661*^9}},ExpressionUUID->"ae6ca444-9b8d-4b16-add8-\
0d567872c2e6"],

Cell["\<\
This section constructs some of the pentagon tiles that tile periodically.\
\>", "Text",
 CellChangeTimes->{{3.631211803827739*^9, 
  3.631211815785605*^9}},ExpressionUUID->"6402acee-9f26-43f8-9831-\
326820440ed4"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
CairoPentagonAngles[\[Delta]]
CairoSymmetricPentagonBaseAngle\
\>", "Subsubsection",
 CellChangeTimes->{{3.631121465309336*^9, 3.631121496153972*^9}, {
   3.631217136606164*^9, 3.631217141734177*^9}, 3.631217238656299*^9, {
   3.631217312566591*^9, 
   3.6312173178421288`*^9}},ExpressionUUID->"471ce000-7d18-4eed-8569-\
49774b3e115f"],

Cell["\<\
CairoPentagonAngles[\[Delta]] returns the generic equilateral pentagon that \
tiles the plane using the Cairo tiling with first base angle \[Delta].\
\>", "Text",
 CellChangeTimes->{{3.631121773226185*^9, 
  3.631121810975518*^9}},ExpressionUUID->"f93ead28-3c8a-4201-a180-\
e1ee27fb48c8"],

Cell["\<\
Note that the tile with base angle \[Pi]\[Dash]\[Delta] is a rotated version \
of the mirror image tile.\
\>", "Text",
 CellChangeTimes->{{3.631138307164649*^9, 
  3.631138343073694*^9}},ExpressionUUID->"4d806d3b-352a-409d-b9cd-\
2bd20dafccf1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CairoPentagonAngles", "[", "\[Delta]1_", "]"}], ":=", 
  RowBox[{
   RowBox[{"CairoPentagonAngles", "[", "\[Delta]1", "]"}], "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"angles", ",", "\[Delta]2", ",", "\[Delta]3"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"angles", "=", 
       RowBox[{"CompletePolygonAngles", "[", 
        RowBox[{"{", 
         RowBox[{"\[Delta]1", ",", "\[Delta]2", ",", "\[Delta]3", ",", 
          RowBox[{"\[Pi]", "-", "\[Delta]1"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"angles", "/.", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"Cos", "[", "\[Delta]1", "]"}], "-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]3"}], "]"}], "+", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]2", "-", "\[Delta]3"}], "]"}],
             "-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Delta]2", "+", "\[Delta]3"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sin", "[", "\[Delta]1", "]"}]}], "+", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]3"}], "]"}], "-", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]2", "-", "\[Delta]3"}], "]"}],
             "-", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Delta]2", "+", "\[Delta]3"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]2", ",", 
           RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]3", ",", 
           RowBox[{"90", "\[Degree]"}]}], "}"}]}], "]"}]}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.631121573321856*^9, 3.631121681266245*^9}, {
  3.631121826348506*^9, 3.631121882523178*^9}},
 CellLabel->
  "In[3275]:=",ExpressionUUID->"780954d4-2703-459d-8b09-c7e893dc07e3"],

Cell["Example. the symmetric 90\[Degree] tile.", "Text",
 CellChangeTimes->{{3.631121699588484*^9, 3.631121700312768*^9}, 
   3.631121766860812*^9, {3.631121901578037*^9, 3.6311219060242243`*^9}, {
   3.631217249015955*^9, 
   3.631217250606777*^9}},ExpressionUUID->"8750626c-dfec-473d-b882-\
a8cfd5fe4b0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "angles", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angles", "=", 
      RowBox[{"CairoPentagonAngles", "[", 
       RowBox[{"90.", "\[Degree]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"angles", "/", "\[Degree]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.631121696032439*^9, 3.631121747611099*^9}, {
  3.63112190939357*^9, 3.631121920204133*^9}},
 CellLabel->
  "In[3276]:=",ExpressionUUID->"5d3f0bd4-bf58-4506-b9fc-6af580874806"],

Cell["\<\
CairoSymmetricPentagonBaseAngle returns the base angle for the other \
mirror-symmetric equilateral pentagon that tiles the plane using the Cairo \
tiling.\
\>", "Text",
 CellChangeTimes->{{3.631121506065336*^9, 3.631121548389268*^9}, {
   3.6311216886016088`*^9, 3.6311216892978787`*^9}, {3.631217261365727*^9, 
   3.6312172750130787`*^9}, 
   3.631217322539798*^9},ExpressionUUID->"b19b79f5-6096-403b-a7b0-\
2265bec85e08"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CairoSymmetricPentagonBaseAngle", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "angles", ",", "\[Delta]1", ",", "\[Delta]2", ",", "\[Delta]3"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"angles", "=", 
       RowBox[{"CompletePolygonAngles", "[", 
        RowBox[{"{", 
         RowBox[{"\[Delta]1", ",", "\[Delta]2", ",", "\[Delta]3", ",", 
          RowBox[{"\[Pi]", "-", "\[Delta]1"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Delta]1", "/.", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Delta]2", "-", "\[Delta]1"}], ",", 
           RowBox[{"1", "+", 
            RowBox[{"Cos", "[", "\[Delta]1", "]"}], "-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]3"}], "]"}], "+", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]2", "-", "\[Delta]3"}], "]"}],
             "-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Delta]2", "+", "\[Delta]3"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sin", "[", "\[Delta]1", "]"}]}], "+", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]3"}], "]"}], "-", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Delta]1", "-", "\[Delta]2", "-", "\[Delta]3"}], "]"}],
             "-", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Delta]2", "+", "\[Delta]3"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]1", ",", 
           RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]2", ",", 
           RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]3", ",", 
           RowBox[{"90", "\[Degree]"}]}], "}"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.6312171749506197`*^9, 3.631217216671283*^9}, 
   3.631217323656972*^9, 3.6316141547607307`*^9},
 CellLabel->
  "In[3277]:=",ExpressionUUID->"60b66614-2454-432f-a9e8-b404bec8d016"],

