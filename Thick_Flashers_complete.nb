Cell[CellGroupData[{

Cell["EdgeLabelsGC[gc]", "Subsubsection",
 CellChangeTimes->{{3.9222051443062882`*^9, 
  3.922205157654099*^9}},ExpressionUUID->"3fe6b024-7756-48f0-8d58-\
c2e3fe376dbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeLabelsGC", "[", "gc_GraphicsComplex", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "epts", ",", "polys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"gc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{"First", "/@", 
       RowBox[{
       "gc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Sort", "/@", 
        RowBox[{"Join", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "/@",
            "polys"}], ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"epts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Plus", "@@", 
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], "/",
          "2"}], "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"\"\<e\>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}]}], ",", 
           RowBox[{
           "epts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "epts", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.922205212987506*^9, 3.92220532696803*^9}, {
  3.922205651859359*^9, 3.9222056551370983`*^9}, {3.92220570772204*^9, 
  3.922205811882732*^9}, {3.922205851026517*^9, 3.922205978828074*^9}, {
  3.9222062059262733`*^9, 3.922206288332193*^9}},
 CellLabel->
