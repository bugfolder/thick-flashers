Cell[CellGroupData[{

Cell["TVertex3D fold vectors", "Subsection",
 CellChangeTimes->{{3.594754203247691*^9, 3.594754212711355*^9}, {
   3.594810614467311*^9, 3.594810614768938*^9}, 
