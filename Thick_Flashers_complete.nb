              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
           "Paper3DFill"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", ".25"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", ".25"}], "}"}]}], "}"}], "]"}], ",", 
           "MountainLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", ".5"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", ".5"}], "}"}]}], "}"}], "]"}], ",", 
           "CreaseLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", ".75"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", ".75"}], "}"}]}], "}"}], "]"}], ",", 
           "ValleyLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
