Cell[TextData[{
 "Styled3DUnitDiskFromInPlaneVectors[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] [DEPRECATED]\n\t(options) ArcDivisions, LineStyle, FillStyle"
}], "Subsubsection",
 CellChangeTimes->{{3.693872823389653*^9, 3.693872846585743*^9}, 
   3.693873260744088*^9, 
   3.80099322726484*^9},ExpressionUUID->"4d448d7e-8166-426f-8855-\
870609cf07de"],

Cell[TextData[{
 "Styled3DUnitDiskFromInPlaneVectors[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the graphics primitives for a unit disk (i.e., a filled circle) \
in the plane spanned by two vectors."
}], "Text",
 CellChangeTimes->{{3.440612627429846*^9, 3.440612642095929*^9}, {
  3.440612674913216*^9, 3.440612736762813*^9}, {3.440612795966018*^9, 
  3.440612799380759*^9}, {3.440612871697193*^9, 3.44061292711265*^9}, {
  3.44150161049352*^9, 3.441501610493575*^9}, {3.441501683566943*^9, 
  3.4415016887942457`*^9}, {3.442793479404379*^9, 3.442793479404415*^9}, {
  3.443206654494309*^9, 3.443206680596644*^9}, {3.443211405169218*^9, 
  3.4432114221257057`*^9}, {3.668985731788232*^9, 3.668985731788544*^9}, {
  3.693872225211314*^9, 3.693872225251699*^9}, {3.693872868474125*^9, 
  3.69387287915478*^9}, {3.6938729844379*^9, 
  3.693872985067481*^9}},ExpressionUUID->"bc62c32d-5f51-4ca7-9cee-\
bb5e188104d4"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 " \[LongDash] direction vectors that define the plane of the disk. They don\
\[CloseCurlyQuote]t have to be normalized or orthogonal."
}], "Text",
 CellChangeTimes->{{3.693765906990356*^9, 3.693765934759681*^9}, {
  3.693872080890895*^9, 3.693872107267523*^9}, {3.693873123276869*^9, 
  3.693873131459243*^9}},ExpressionUUID->"1b1afddd-d00f-4660-92ab-\
baa4ecb86a7f"],

Cell[TextData[{
 "Options are:\n\tArcDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", specifies the number of points to use in drawing the circle.\n\tLineStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " | None, specifies the Style directive to use in outlining the disk or None \
for no outline.\n\tFillStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " | None, specifies the Style directive to use in drawing the disk or None \
for no fill."
}], "Text",
 CellChangeTimes->{{3.693872881715335*^9, 
  3.6938729166733637`*^9}},ExpressionUUID->"abd2b8d8-7a34-4813-a844-\
fa633c0c2d79"],

