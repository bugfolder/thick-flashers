                 RowBox[{"bb2", "[", "s", "]"}], "-", 
                 RowBox[{"ff", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"SurfaceOrientation", "\[Rule]", 
