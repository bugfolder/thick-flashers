Cell[BoxData[
 RowBox[{
  RowBox[{"NFoldAcrossRight3D", "[", 
   RowBox[{
    RowBox[{"ff_Function", "|", "ff_InterpolatingFunction"}], ",", 
    RowBox[{"rrL_Function", "|", "rrL_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "csys", ",", "dff", ",", "ds", ",", "tt", ",", "nn", ",", "bb",
       ",", "uuL", ",", "llL", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", 
      "c\[Eta]L", ",", "s\[Eta]L", ",", "c\[Eta]R", ",", "s\[Eta]R", ",", 
      "uuR", ",", "llR", ",", "duuR", ",", "mduuR", ",", "\[Kappa]g", ",", 
      "\[Kappa]n", ",", "\[Tau]g", ",", "c\[Rho]R", ",", "s\[Rho]R", ",", 
      "rrR"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "curve", " ", "fold", " ", "system", " ", "and", " ", "Frenet", " ", 
      "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"csys", "=", 
      RowBox[{"NCurve3DSystem", "[", 
       RowBox[{"ff", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
         "BinormalVector3D"}], "}"}], "/.", "csys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"txr", "=", 
            RowBox[{
             RowBox[{"tt", "[", "s", "]"}], "\[Cross]", 
             RowBox[{"rrL", "[", "s", "]"}]}]}], "}"}], ",", 
          RowBox[{"NormalizeReal", "[", "txr", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"llL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuL", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"tt", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"rrL", "[", "s", "]"}], ".", 
         RowBox[{"tt", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"rrL", "[", "s", "]"}], ".", 
         RowBox[{"llL", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Eta]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"llL", "[", "s", "]"}], ".", 
         RowBox[{"nn", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Eta]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuL", "[", "s", "]"}], ".", 
         RowBox[{"nn", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"s\[Eta]L", "[", "s", "]"}]}], 
          RowBox[{"nn", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"c\[Eta]L", "[", "s", "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"llR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c\[Eta]L", "[", "s", "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"s\[Eta]L", "[", "s", "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"duuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuR", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mduuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"duuR", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"duuR", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         FractionBox[
          RowBox[{
           RowBox[{"duuR", "[", "s", "]"}], ".", 
           RowBox[{"llR", "[", "s", "]"}]}], 
          RowBox[{"mduuR", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"duuR", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         RowBox[{"mduuR", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c\[Rho]R", "[", "s", "]"}], 
          RowBox[{"tt", "[", "s", "]"}]}], "-", 
         RowBox[{
          RowBox[{"s\[Rho]R", "[", "s", "]"}], 
          RowBox[{"llR", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}]}]}], "]"}]}]], "Input",
