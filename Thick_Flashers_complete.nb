   3.719925980228366*^9, 3.719925980238082*^9}, 3.719926067407049*^9, {
   3.71993390890337*^9, 3.7199339346461678`*^9}, {3.719933979990059*^9, 
   3.719933986076962*^9}, 3.719934119989794*^9, 3.719936134084817*^9, {
   3.911850422052598*^9, 3.911850426261135*^9}, {3.9118504608171377`*^9, 
   3.911850537362969*^9}, 3.911850568680056*^9, 3.911850611049265*^9, {
   3.911850804587482*^9, 3.9118508486355953`*^9}, {3.9118570807297564`*^9, 
   3.9118570811094837`*^9}, {3.911857123424044*^9, 3.91185715801626*^9}, 
   3.911861340711053*^9, 3.911878094228853*^9, {3.911878149674077*^9, 
   3.911878154847198*^9}, {3.911878325559716*^9, 3.911878350772194*^9}, 
   3.911878381158279*^9, 3.911878442519504*^9, {3.911878519345257*^9, 
   3.911878753418348*^9}, 3.911878822169005*^9, 3.911902750157958*^9, 
   3.911988247965103*^9, 3.9135429273774633`*^9},
 CellLabel->
