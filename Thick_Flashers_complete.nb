  RowBox[{"TwistCreasePatternLabeledLines", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "types"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "types"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "EdgeTypes"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{"Style", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}],
               "]"}], "&"}], "/@", "edges"}], ",", 
           RowBox[{"types", "/.", "TypeToCreasePatternStyleRules"}]}], 
          "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Darker", "[", "Red", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"StdVertexLabels", "[", "verts", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"StdEdgeLabels", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}]}]}], "}"}]}]}], 
   "]"}]}]], "Input",
