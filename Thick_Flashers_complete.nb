           RowBox[{
            RowBox[{
            "gg", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{"p0", "+", 
              RowBox[{
               RowBox[{"RotationMatrix2D", "[", "\[Pi]", "]"}], ".", 
               RowBox[{"(", 
                RowBox[{"#", "-", "p0"}], ")"}]}]}], "&"}]}], "]"}]}], 
