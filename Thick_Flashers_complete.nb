Cell[TextData[{
 "EdgeLengths2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns the lengths of the edges of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", but calculated from the Vertices2D embedding."
}], "Text",
 CellChangeTimes->{{3.595335711908537*^9, 
  3.595335731730635*^9}},ExpressionUUID->"53402004-e416-4199-ad58-\
f977719fe46e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeLengths2D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts2d", ",", "edges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices2D", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Mag", "[", 
        RowBox[{"Subtract", "@@", 
         RowBox[{
         "verts2d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
        "]"}], "&"}], "/@", "edges"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.592003989347389*^9, 3.5920040605028143`*^9}, 
