Cell[CellGroupData[{

Cell[TextData[{
 "UnfoldGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph2D\n\t(options) StationaryFace, ShowProgress"
}], "Subsubsection",
 CellChangeTimes->{{3.595355159023863*^9, 3.595355162037426*^9}, {
   3.595356453610297*^9, 3.595356457536974*^9}, 3.595357802250082*^9, 
   3.722249099307366*^9},ExpressionUUID->"ddd63c2b-da54-4f20-a25c-\
0cd91abf22c5"],

Cell[TextData[{
 "UnfoldGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] unfolds a TGraph2D from the Vertices2D embedding in the same way that \
FoldGraph2D folded it from the Vertices embedding. The stationary face \
position and orientation is taken from the 2D embedding."
}], "Text",
 CellChangeTimes->{{3.591808412614337*^9, 3.5918084452922*^9}, {
  3.592791268204608*^9, 3.592791291462787*^9}, {3.594727481114224*^9, 
  3.594727482681447*^9}, {3.594727526694013*^9, 3.594727527102046*^9}, {
  3.595355484401123*^9, 3.595355501637361*^9}, {3.595355539109183*^9, 
  3.595355551917657*^9}, {3.595361167970252*^9, 3.595361194119289*^9}, {
  3.722249105473033*^9, 
  3.7222491056412773`*^9}},ExpressionUUID->"a923e249-c3e0-4033-aed9-\
bf24e20ace35"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph2D to be unfolded."
}], "Text",
 CellChangeTimes->{{3.7222498841664057`*^9, 
  3.722249900136773*^9}},ExpressionUUID->"dfdd35ee-0c62-4df8-b9b0-\
2c92b4cb8d19"],

Cell[TextData[{
 "Options:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 ", the index of the face whose position remains unchanged.\n\tShowProgress \
\[Rule] True | False, whether to show progress and internal structures. \
Useful for debugging."
}], "Text",
 CellChangeTimes->{
  3.722248539983442*^9, {3.722248727638082*^9, 3.722248741877592*^9}, 
   3.7222488281772833`*^9},ExpressionUUID->"9100806f-dd09-4a64-9d0a-\
9fdedad13f4a"],

Cell["\<\
Returns a TGraph2D with the new embedding in property Vertices. Any existing \
Vertices data is replaced.\
\>", "Text",
 CellChangeTimes->{{3.722248636363839*^9, 3.722248645972193*^9}, {
  3.722248960721542*^9, 3.722248970663919*^9}, {3.722249935063541*^9, 
  3.722249937648386*^9}},ExpressionUUID->"b3535d6a-9e9a-4796-b3fa-\
8c6784c380e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "UnfoldGraph2D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"StationaryFace", "\[Rule]", "1"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.484828799316506*^9, 3.484828811909363*^9}, 
   3.484829074387739*^9, 3.484927941083176*^9, {3.484928084298373*^9, 
   3.484928084659789*^9}, 3.592791267910019*^9, 3.5952002459112453`*^9, 
   3.595355519909628*^9},
 CellLabel->
  "In[1344]:=",ExpressionUUID->"05cee266-6ab2-430f-9ca7-a3d8bd9c511e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnfoldGraph2D", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"foldangles", ",", "verts"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph2D", ",", "UnfoldGraph2D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"EdgeFaceAngles2D", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"HasClassQ", "[", 
          RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", "tobj", ",", 
         RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"#", ",", 
          RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", 
       RowBox[{"FoldEmbedding", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"tobj", "[", "Vertices2D", "]"}], ",", "foldangles", ",", 
         "opts"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices", "\[Rule]", "verts"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.722249277717012*^9, 3.722249396195025*^9}, {
  3.722249480724955*^9, 3.722249591086377*^9}, {3.72224963830954*^9, 
  3.72224968847849*^9}},
 CellLabel->
  "In[1345]:=",ExpressionUUID->"8c672a52-8289-4ac0-b51f-875bf21991e5"],

