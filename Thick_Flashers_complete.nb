   3.629837261525204*^9, 3.629837285263013*^9}, 
   3.707758129452868*^9},ExpressionUUID->"d6f1e97c-f7ec-405a-be3e-\
db452824ecc7"],

Cell[TextData[{
 "RenderTile[{PolygonOffsetTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TileVertices, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the vertices of the tiling polygon."
}], "Text",
 CellChangeTimes->{{3.629826543752584*^9, 3.629826558268348*^9}, {
