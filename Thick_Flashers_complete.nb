Cell[CellGroupData[{

Cell[TextData[{
 "StyledLine[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) LineStyle, LineTube, LineTubeThickness, LineDirected"
}], "Subsubsection",
 CellChangeTimes->{{3.443210373249226*^9, 3.443210383683861*^9}, 
   3.668985650579996*^9, {3.8009959909313087`*^9, 3.800996000444607*^9}, {
   3.801001042861981*^9, 
   3.801001043070091*^9}},ExpressionUUID->"12916aa3-7daa-43f3-9fd4-\
6f41d4cd3629"],

Cell[TextData[{
 "StyledLine[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points and produces a styled line with the given Style \
directive."
}], "Text",
 CellChangeTimes->{{3.443210392476426*^9, 3.443210464535097*^9}, {
   3.592854149132865*^9, 3.592854149302491*^9}, 3.668985650629431*^9, 
   3.693872239309149*^9, {3.800996008270566*^9, 3.800996035798803*^9}, {
   3.8009961356707907`*^9, 3.8009962253707237`*^9}, 
   3.8010010575108433`*^9},ExpressionUUID->"d35dab63-5a91-4df6-a6db-\
b39474d21608"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["pts",
  FontSlant->"Italic"],
 " \[LongDash] a list of points in 2D or 3D."
}], "Text",
 CellChangeTimes->{{3.800996210041087*^9, 3.800996222173221*^9}, 
   3.80100105814867*^9},ExpressionUUID->"cc0472e7-21df-4e2e-afaa-\
883906f68c61"],

Cell[TextData[{
 "Options:\n\tLineStyle \[Rule] ",
 StyleBox["style ",
  FontSlant->"Italic"],
 "| None, specifies the styling in the Style directive to use for the line or \
None to wipe it out.\n\tLineTube \[Rule] True | False, whether to use Tube in \
3D (no effect in 2D).\n\tLineTubeThickness \[Rule] r, tube radius to use if \
LineTube \[Rule] True.\n\tLineDirected \[Rule] True | False, whether to add \
an arrowhead to the end of the line."
}], "Text",
 CellChangeTimes->{{3.800996201692788*^9, 3.800996203733333*^9}, {
  3.800997101123653*^9, 
  3.800997113873999*^9}},ExpressionUUID->"78f7ef26-dead-4dbb-82ca-\
842bd5682e60"],

Cell["\<\
Returns: a Line wrapped in Style with the specified style directives.\
\>", "Text",
 CellChangeTimes->{{3.800996244637735*^9, 3.800996301125679*^9}, {
  3.800996388485729*^9, 
  3.800996419963869*^9}},ExpressionUUID->"e01dc72e-c3e0-418b-a37c-\
061817e4c468"],

Cell["\<\
If LineTube \[Rule] True and we\[CloseCurlyQuote]re in 3D, then instead of \
Line it will be a Tube. Any Thickness or AbsoluteThickness directives in \
LineStyle will be ignored; instead, LineTubeThickness will specify the \
thickness.\
\>", "Text",
 CellChangeTimes->{{3.800996422129861*^9, 
  3.800996433015619*^9}},ExpressionUUID->"132d0a17-29b6-435d-84a1-\
61647d43042d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LineTube", "::", "usage"}], 
   "=", "\"\<LineTube is an option to StyledLine that specifies whether to \
use Tube in 3D.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.800996369031951*^9, 3.800996385591365*^9}, {
  3.800996441962694*^9, 3.8009964533093233`*^9}},
 CellLabel->
  "In[1604]:=",ExpressionUUID->"9161d339-6535-4d63-9129-e8f6daae680a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LineTubeThickness", "::", "usage"}], 
   "=", "\"\<LineTubeThickness is an option to StyledLine that specifies the \
thickness to use for Tube in 3D.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.800996460185244*^9, 3.800996483503949*^9}},
 CellLabel->
  "In[1605]:=",ExpressionUUID->"dd651b03-0a29-4f08-bc09-e6b1ba6b7dc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LineDirected", "::", "usage"}], 
   "=", "\"\<LineDirected is an option to StyledLine that specifies whether \
to put an arrowhead at the end of the line.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.8009964918721447`*^9, 3.800996513214063*^9}},
 CellLabel->
  "In[1606]:=",ExpressionUUID->"ce26b76b-bb43-472b-9650-3fe93f8f919d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledLine", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"LineStyle", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"LineTube", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     RowBox[{"LineTubeThickness", "\[Rule]", "0.005"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"LineDirected", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.443210469928384*^9, 3.443210478800576*^9}, 
   3.668985650650788*^9, {3.800996315151058*^9, 3.800996337454096*^9}, {
   3.801000783235075*^9, 3.8010007987281227`*^9}},
 CellLabel->
  "In[1607]:=",ExpressionUUID->"f7577143-8fab-480e-8caa-f32f03714726"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StyledLine", "::", "mixdims"}], 
   "=", "\"\<List `1` is not all 2D or all 3D points.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.800996669073792*^9, 3.800996708139721*^9}},
 CellLabel->
  "In[1608]:=",ExpressionUUID->"5ae2e09e-3fde-4186-859d-f661bde5adcf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledLine", "[", 
   RowBox[{"pts_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ls", ",", "lt", ",", "ltt", ",", "ld", ",", "dim"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ls", "=", 
      RowBox[{
       RowBox[{"LineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lt", "=", 
      RowBox[{
       RowBox[{"LineTube", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ltt", "=", 
      RowBox[{
       RowBox[{"LineTubeThickness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ld", "=", 
      RowBox[{
       RowBox[{"LineDirected", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ls", "===", "None"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Length", "/@", "pts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "dim", "]"}], "\[NotEqual]", "1"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"StyledLine", "::", "mixdims"}], ",", "pts"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{"First", "[", "dim", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ld", ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dim", "\[Equal]", "2"}], "||", 
          RowBox[{"!", "lt"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", "pts", "]"}], ",", "ls", ",", 
           RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"Tube", "[", 
             RowBox[{"pts", ",", "ltt"}], "]"}], "]"}], ",", "ls", ",", 
           RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}]}], "]"}], ","}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dim", "\[Equal]", "2"}], "||", 
          RowBox[{"!", "lt"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", "pts", "]"}], ",", "ls", ",", 
           RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Tube", "[", 
            RowBox[{"pts", ",", "ltt"}], "]"}], ",", "ls", ",", 
           RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}]}], "]"}]}], "]"}]}],
       "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.44321048085176*^9, 3.443210521580881*^9}, {
   3.443210712735341*^9, 3.44321071517972*^9}, 3.443210808216604*^9, {
   3.668985650671799*^9, 3.668985650686874*^9}, {3.800996569700486*^9, 
   3.80099666349168*^9}, {3.8009967140261106`*^9, 3.800996778386917*^9}, {
   3.800997024641397*^9, 3.800997059459787*^9}, 3.800997136150364*^9, {
   3.800997192321124*^9, 3.800997315866932*^9}, {3.80100047381562*^9, 
   3.801000510711608*^9}, {3.8010005682710657`*^9, 3.801000568412667*^9}, {
   3.801000608786725*^9, 3.801000616180998*^9}, {3.801000671654845*^9, 
   3.801000673935212*^9}, {3.8010007120194483`*^9, 3.801000748248924*^9}, 
   3.8010008108249493`*^9, {3.801001059486413*^9, 3.801001066435206*^9}, {
