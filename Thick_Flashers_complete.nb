Cell["\<\
Example of a primal-dual tessellation (3x3 square grid), oriented so that the \
central polygon is cyclic, and fully rendered.\
\>", "Text",
 CellChangeTimes->{{3.592294787825736*^9, 3.592294791672097*^9}, {
  3.592505564868187*^9, 
  3.5925055735744343`*^9}},ExpressionUUID->"6a34457a-4584-4d28-88d2-\
59c759b69085"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "\[Gamma]", ",", "\[Alpha]", ",", "dir", ",", "\[Rho]", ",", 
      "\[Beta]", ",", "pverts", ",", "pedges", ",", " ", "tobjpd", ",", "ctr",
       ",", "tobjtt"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "-", "1"}], ",", 
             RowBox[{"j", "-", "1"}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", "1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"n", "+", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", "j", ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"pverts", ",", "pedges"}], "]"}], "//", "AddTPlaneGraphTo"}],
        "//", "AddTPrimalDualGraphTo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dverts", "=", 
          RowBox[{"GetValue", "[", 
           RowBox[{"tobjpd", ",", "DualVertices"}], "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"Plus", "@@", "dverts"}], "/", 
         RowBox[{"Length", "[", "dverts", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"OrientEdgePairs", "[", 
       RowBox[{"tobjpd", ",", 
        RowBox[{"RadialAxialOrderingFn", "[", "ctr", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", "2.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"30.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CCW"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjtt", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"TwistDirection", "\[Rule]", "dir"}], ",", 
        RowBox[{"PostRotation", "\[Rule]", "PrimalRotation"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PartitionedGraphicsGrid", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"PrimalDualGraphics", "[", 
           RowBox[{"tobjpd", ",", 
            RowBox[{"DualDirectedEdges", "\[Rule]", "True"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GraphGraphics", "[", "tobjtt", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"CreasePatternGraphics", "[", "tobjtt", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"VisibleFoldedFormGraphics", "[", 
           RowBox[{"tobjtt", ",", 
            RowBox[{"FaceupFace", "\[Rule]", "1"}]}], "]"}]}], "}"}], ",", 
        "2"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.456533180310354*^9, 3.4565331963374653`*^9}, {
   3.456533350551143*^9, 3.456533521385223*^9}, {3.456533594451507*^9, 
