      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"-", "1"}]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], "&"}]}], ";", 
