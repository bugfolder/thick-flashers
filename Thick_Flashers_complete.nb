Cell[CellGroupData[{

Cell[TextData[{
 "RainbowSurfaceColorFunction[{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.800004588488957*^9, 3.800004598092625*^9}, 
   3.800016331443933*^9},ExpressionUUID->"25ef9238-4191-41ec-822a-\
6d80242781ab"],

Cell[TextData[{
 "RainbowSurfaceColorFunction[{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}] returns a surface color function that maps {",
 StyleBox["u",
  FontSlant->"Italic"],
 ",",
 StyleBox["v",
  FontSlant->"Italic"],
 "} values in the the given rectangular interval to a rainbow of colors \
centered on the rectangle."
}], "Text",
 CellChangeTimes->{{3.8000058830406833`*^9, 3.80000591523177*^9}, {
  3.800016331462479*^9, 3.800016339088112*^9}, {3.8000179206763887`*^9, 
  3.800017922260098*^9}, {3.80001795655645*^9, 
  3.800017962163953*^9}},ExpressionUUID->"aa154712-d0de-4076-ad7d-\
7f1aeb1e0c82"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of u values.\n\t{",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of v values."
}], "Text",
 CellChangeTimes->{{3.80000632720312*^9, 
  3.800006351298978*^9}},ExpressionUUID->"7ac40b77-797f-4e06-825e-\
68b77d6445ff"],

Cell["\<\
Returns: a function of two variables that maps points within the range to a \
continuous rainbow of colors.\
\>", "Text",
 CellChangeTimes->{{3.800006354594944*^9, 
  3.8000063762907877`*^9}},ExpressionUUID->"6ae52975-4505-446c-b4cd-\
0a329fe3ca9b"],

Cell["\<\
Note that if the argument of the surface color function extends outside its \
defined range, the color Black is returned.\
\>", "Text",
 CellChangeTimes->{{3.8000160507098217`*^9, 3.8000160919259653`*^9}, 
   3.800017944796734*^9},ExpressionUUID->"5b32f874-8423-45ac-9dab-\
638030dc7e23"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RainbowSurfaceColorFunction", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", "v1_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"un", "=", 
        RowBox[{
         RowBox[{"2", 
          FractionBox[
           RowBox[{"#1", "-", "u0"}], 
           RowBox[{"u1", "-", "u0"}]]}], "-", "1"}]}], ",", 
       RowBox[{"vn", "=", 
        RowBox[{
         RowBox[{"2", 
          FractionBox[
           RowBox[{"#2", "-", "v0"}], 
           RowBox[{"v1", "-", "v0"}]]}], "-", "1"}]}], ",", "\[Theta]", ",", 
       "r"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"un", "\[Equal]", "0"}], "&&", 
          RowBox[{"vn", "\[Equal]", "0"}]}], ",", "0", ",", 
         RowBox[{"ArcTan", "[", 
          RowBox[{"un", ",", "vn"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "]"}], ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "]"}]}], "]"}], 
        SqrtBox[
         RowBox[{
          SuperscriptBox["un", "2"], "+", 
          SuperscriptBox["vn", "2"]}]]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"r", ">", "1"}], ",", "Black", ",", 
        RowBox[{"Hue", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], "+", 
           FractionBox["\[Theta]", 
            RowBox[{"2", "\[Pi]"}]]}], ",", "r", ",", 
          RowBox[{".7", "+", 
           RowBox[{".3", "r"}]}]}], "]"}]}], "]"}]}]}], "]"}], 
   "&"}]}]], "Input",
 CellChangeTimes->{{3.800004192770443*^9, 3.800004497677905*^9}, {
   3.800004632561182*^9, 3.8000046899519253`*^9}, {3.800004755386639*^9, 
   3.800004804977059*^9}, {3.800004838708438*^9, 3.800004887065414*^9}, {
   3.800004921753436*^9, 3.800004938236507*^9}, {3.800004985909185*^9, 
