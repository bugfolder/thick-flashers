        RowBox[{"PointSize", "[", ".03", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{
         "halfplane", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
         "]"}], ",", "Gray", ",", 
        RowBox[{"Line", "/@", "segments"}], ",", "Red", ",", 
        RowBox[{"Thickness", "[", ".01", "]"}], ",", 
        RowBox[{"Line", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ClipSegmentToHalfPlane", "[", 
             RowBox[{"#", ",", "halfplane"}], "]"}], "&"}], "/@", 
           "segments"}], ")"}]}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
