  3.627662651945675*^9}},ExpressionUUID->"1d64d177-c7ef-4a11-b529-\
fd8adcd27eec"],

Cell["\<\
Here we define four different styles for drawing edge arrows on tilings. \
Arrows could be Directed (D, along the edge) or Crossing (C, transverse to \
the edge), and Half (H) or Full (F).\
\>", "Text",
 CellChangeTimes->{{3.627654962050943*^9, 3.627655010975766*^9}, {
  3.6276550426470633`*^9, 
  3.627655046757312*^9}},ExpressionUUID->"e7df1ce7-cc16-4827-a9ca-\
7631b593bc3d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TileArrowDH[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "]\nTileArrowCH[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "]\nTileArrowDF[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "]\nTileArrowCF[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.62758061084571*^9, 3.627580659626481*^9}, {
  3.627580712311561*^9, 3.6275807155582952`*^9}, {3.627580971088579*^9, 
  3.627580979662018*^9}, {3.6275816438284698`*^9, 3.627581649275071*^9}, {
  3.627582695625877*^9, 3.62758270320829*^9}, {3.627654881090353*^9, 
  3.627654936397711*^9}, {3.629838824926843*^9, 
  3.629838825203191*^9}},ExpressionUUID->"ad90b94f-3a53-4624-b8d2-\
cf89826f26f6"],

Cell[TextData[{
 "TileArrowDH[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "] returns a directed half-arrowhead on the CCW side of the line from ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q. ",
  FontSlant->"Italic"],
 "If dir>0, then ",
 StyleBox["p",
  FontSlant->"Italic"],
 " is the tail; otherwise ",
 StyleBox["q",
  FontSlant->"Italic"],
 " is the tail."
}], "Text",
 CellChangeTimes->{{3.6275806886248307`*^9, 3.627580723023911*^9}, {
   3.627580922866042*^9, 3.627580960953753*^9}, 3.6275816550933876`*^9, 
   3.62765488121188*^9, {3.627654943949526*^9, 3.627654958003408*^9}, {
   3.629838825294322*^9, 3.629838847479482*^9}, {3.629838907851352*^9, 
   3.629838908747038*^9}},ExpressionUUID->"33a0c7c3-4c0f-4272-8f40-\
6e720dc01f30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TileArrowDH", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "q_"}], "}"}], ",", " ", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "s", ",", "ctr", ",", "sz", ",", "w", ",", "pts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"Rotate90", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sz", "=", "0.15"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.58"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"sz", "#"}]}], "&"}], "/@", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dir", ">", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", ".5"}], " ", "r"}], ",", 
           RowBox[{
            RowBox[{"+", ".5"}], " ", "r"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", ".5"}], " ", "r"}], "+", 
            RowBox[{"w", " ", "s"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"+", ".5"}], " ", "r"}], ",", 
           RowBox[{
            RowBox[{"-", ".5"}], " ", "r"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"+", ".5"}], " ", "r"}], "+", 
            RowBox[{"w", " ", "s"}]}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Polygon", "[", "pts", "]"}], ",", "TilingLine"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627580968539734*^9, 3.627581201475292*^9}, {
   3.627581359073287*^9, 3.627581435702797*^9}, 3.62758188230826*^9, {
   3.627582158135088*^9, 3.627582272056535*^9}, {3.627582338360945*^9, 
   3.627582507579101*^9}, {3.627582831652519*^9, 3.627582874451714*^9}, {
   3.627588531202167*^9, 3.627588542801034*^9}, 3.627654881239429*^9, {
   3.629838825527653*^9, 3.629838825555287*^9}, {3.629838866121656*^9, 
   3.629838866418185*^9}},
 CellLabel->
  "In[2834]:=",ExpressionUUID->"ee608a3f-851e-4de3-a11a-289d3f484f9b"],

Cell["Example", "Text",
 CellChangeTimes->{{3.627581221289845*^9, 
  3.6275812229026837`*^9}},ExpressionUUID->"f31c051a-5fb8-4f61-a2c8-\
7dbcad3bf0bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts1", ",", "pts2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0.7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Line", "[", "pts1", "]"}], ",", 
           RowBox[{"TileArrowDH", "[", 
            RowBox[{"pts1", ",", 
             RowBox[{"+", "1"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Line", "[", "pts2", "]"}], ",", 
           RowBox[{"TileArrowDH", "[", 
            RowBox[{"pts2", ",", 
             RowBox[{"-", "1"}]}], "]"}]}], "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.627581224373039*^9, 3.627581333563998*^9}, {
  3.627581450107465*^9, 3.627581458847628*^9}, {3.627581842036198*^9, 
  3.627581848746291*^9}, {3.627581883479537*^9, 3.627581884460702*^9}, {
  3.627581993906425*^9, 3.62758205533518*^9}, {3.62765488128018*^9, 
  3.627654881313608*^9}, {3.62983887446436*^9, 3.629838877176054*^9}},
 CellLabel->
  "In[2835]:=",ExpressionUUID->"005829a0-9348-4e81-970b-d080ce48e5c4"],

Cell[TextData[{
 "TileArrowCH[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "] returns a crossing arrowhead entirely on the CCW side of the line from ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q",
  FontSlant->"Italic"],
 ". If dir>0, then the arrow points to the right (relative to the line from \
",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q",
  FontSlant->"Italic"],
 "); otherwise it points to the left."
}], "Text",
 CellChangeTimes->{{3.62758148299821*^9, 3.627581539290063*^9}, {
   3.627581661765328*^9, 3.6275816744975567`*^9}, {3.627582938105649*^9, 
   3.6275829390332937`*^9}, 3.627654919810454*^9, {3.629838825631349*^9, 
   3.629838825726128*^9}, {3.629838887972225*^9, 
   3.6298389161707783`*^9}},ExpressionUUID->"1ef158a9-71dc-4b70-be26-\
ae156f948aad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TileArrowCH", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "q_"}], "}"}], ",", " ", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "s", ",", "ctr", ",", "sz", ",", "w", ",", "pts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"Rotate90", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sz", "=", "0.15"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", " ", "=", " ", "0.3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"sz", "#"}]}], "&"}], "/@", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dir", ">", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"s", "+", 
            RowBox[{"w", " ", "r"}]}], ",", 
           RowBox[{"s", "-", 
            RowBox[{"w", " ", "r"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "w"}], " ", "r"}], ",", 
           RowBox[{"w", " ", "r"}], ",", "s"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Polygon", "[", "pts", "]"}], ",", "TilingLine"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627580968539734*^9, 3.627581201475292*^9}, {
   3.627581359073287*^9, 3.627581435702797*^9}, {3.627581878492167*^9, 
   3.627581988699036*^9}, {3.627582294229835*^9, 3.627582324243881*^9}, {
   3.62758251232253*^9, 3.627582587444302*^9}, {3.627582622370611*^9, 
   3.6275826756481*^9}, {3.627588495813351*^9, 3.627588520315744*^9}, 
   3.627588694370085*^9, 3.627654919836851*^9, {3.62983882575945*^9, 
