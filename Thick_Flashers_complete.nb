Cell[BoxData[
 RowBox[{
  RowBox[{"NDarboux3DSystem", "[", 
   RowBox[{
    RowBox[{"c_Function", "|", "c_InterpolatingFunction"}], ",", 
    RowBox[{"u_Function", "|", "u_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fiopts", ",", "s", ",", "dc", ",", "ds", ",", "t", ",", "l", ",", "dt", 
      ",", "\[Kappa]g", ",", "\[Kappa]n", ",", "\[Tau]g"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fiopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"curve", " ", "speed"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"dc", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"dc", "[", "s", "]"}], "/", 
         RowBox[{"ds", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"u", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"t", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"geodesic", " ", "curvature"}], ",", " ", 
       RowBox[{"normal", " ", "curvature"}], ",", " ", 
       RowBox[{"geodesic", " ", "torsion"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"t", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{"dt", "[", "s", "]"}]}], "/", 
         RowBox[{"ds", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "s", "]"}], ".", 
          RowBox[{"dt", "[", "s", "]"}]}], "/", 
         RowBox[{"ds", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Tau]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"l", "[", "s", "]"}], ".", 
           RowBox[{
            RowBox[{"u", "'"}], "[", "s", "]"}]}]}], "/", 
         RowBox[{"ds", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Speed3D", "\[Rule]", 
        RowBox[{"FunctionInterpolation", "[", 
         RowBox[{
          RowBox[{"ds", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GeodesicCurvature3D", "\[Rule]", 
        RowBox[{"FunctionInterpolation", "[", 
         RowBox[{
          RowBox[{"\[Kappa]g", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalCurvature3D", "\[Rule]", 
        RowBox[{"FunctionInterpolation", "[", 
         RowBox[{
          RowBox[{"\[Kappa]n", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GeodesicTorsion3D", "\[Rule]", 
        RowBox[{"FunctionInterpolation", "[", 
         RowBox[{
          RowBox[{"\[Tau]g", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"t", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentNormalVector3D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"SurfaceNormalVector3D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"u", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], 
         "]"}]}]}], "}"}]}]}], "]"}]}]], "Input",
