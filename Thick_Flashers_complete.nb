 CellChangeTimes->{{3.594663884595607*^9, 
  3.594663890738531*^9}},ExpressionUUID->"713e2b9c-3076-4b30-96ad-\
9c3274b85dcb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts1", ",", "edges1", ",", "faces1", ",", "tobj1", ",", "verts2", ",",
       "edges2", ",", "faces2", ",", "tobj2", ",", "vlist", ",", "elist", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces1", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts1", ",", "edges1", ",", "faces1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces2", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts2", ",", "edges2", ",", "faces2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MergeGraphs", "[", 
       RowBox[{"{", 
        RowBox[{"tobj1", ",", "tobj2"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj1", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj2", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594663894798616*^9, 3.594664130749181*^9}, {
   3.594664326661407*^9, 3.5946643368284073`*^9}, {3.594664401025264*^9, 
   3.594664414552273*^9}, 3.594664465127211*^9, {3.594664571710458*^9, 
   3.594664584367658*^9}, {3.594734253872629*^9, 3.594734253936652*^9}, 
   3.594928983200805*^9, {3.594929553011519*^9, 3.59492957052628*^9}, 
   3.594929639244863*^9, {3.594930803983424*^9, 3.594930810447532*^9}, {
   3.6499626845218487`*^9, 3.6499626960104847`*^9}, {3.649963611232014*^9, 
   3.649963625944646*^9}, {3.649963805426497*^9, 3.649963805783976*^9}, {
   3.675956557175607*^9, 3.675956573563302*^9}, {3.675956677102452*^9, 
