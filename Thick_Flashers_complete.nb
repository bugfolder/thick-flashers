      RowBox[{"verts", ",", "edges", ",", 
       RowBox[{"{", "}"}], ",", 
       RowBox[{"DirectedEdges", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotLabel", "\[Rule]", "\"\<GenericGraphGraphics\>\""}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

