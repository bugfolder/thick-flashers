Cell[CellGroupData[{

Cell["GC modifications", "Subsection",
 CellChangeTimes->{{3.911979366899351*^9, 3.9119793716091337`*^9}, {
  3.914837181199224*^9, 3.914837182709646*^9}, {3.9148383688861523`*^9, 
  3.914838402971263*^9}},ExpressionUUID->"a5faeaa0-4558-4389-ac30-\
97b295476003"],

Cell[CellGroupData[{

Cell["\<\
InsetFaceSubset
StickyFaceSubset\
\>", "Subsubsection",
 CellChangeTimes->{{3.9222044649500237`*^9, 
  3.922204472866761*^9}},ExpressionUUID->"d1473c72-252f-4165-87ef-\
11f25cfe5586"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InsetFaceSubset", "::", "usage"}], 
   "=", "\"\<InsetFaceSubset is an option to InsetGC that specifies that only \
a subset of the faces should be inset.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9184933643146143`*^9, 3.918493386773817*^9}},
 CellLabel->
  "In[4292]:=",ExpressionUUID->"32e24468-57b0-4e45-815a-701111bee1c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StickyFaceSubset", "::", "usage"}], 
   "=", "\"\<StickyFaceSubset is an option to InsetGC that specifies that a \
subset of faces that vertices should be stuck to.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9184933643146143`*^9, 3.918493386773817*^9}, {
  3.922204295548593*^9, 3.922204310354226*^9}},
 CellLabel->
  "In[4293]:=",ExpressionUUID->"8b0c80c1-cf45-4013-8c72-d9ac509b44ce"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "InsetGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) InsetFaceSubset, StickyFaceSubset"
}], "Subsubsection",
 CellChangeTimes->{{3.91198870758108*^9, 3.911988720912927*^9}, {
   3.918493246701103*^9, 3.9184932653340807`*^9}, {3.922204196493731*^9, 
   3.922204199985395*^9}, 
   3.922204460567218*^9},ExpressionUUID->"23854e96-f6d3-4da1-bf09-\
b3aef6eff9da"],

Cell[TextData[{
 StyleBox["InsetGCgc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates an inset version of a GraphicsComplex polyhedron, shifting all \
vertices inward so that its faces all end up shifted inward by a minimum \
specified amount."
}], "Text",
 CellChangeTimes->{{3.9119887331939173`*^9, 3.911988792193458*^9}, {
  3.913540648648739*^9, 3.913540653272292*^9}, {3.918493278806534*^9, 
  3.918493281790248*^9}},ExpressionUUID->"6c18a1c4-ac6b-4f58-a251-\
320ac3bbf2ec"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["gc",
  FontSlant->"Italic"],
 " \[LongDash] a GraphicsComplex polyhedron, i.e., a collection of points and \
polygons.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the minimum positive distance that the faces should be shifted \
inward."
}], "Text",
 CellChangeTimes->{{3.911988794369862*^9, 3.911988832013087*^9}, {
  3.911989305815507*^9, 
  3.911989307143387*^9}},ExpressionUUID->"db200dcc-6330-40d5-9a29-\
bae80aa27c4b"],

Cell[TextData[{
 "Options:\n\tInsetFaceSubset \[Rule] ",
 StyleBox["flist",
  FontSlant->"Italic"],
 " | Automatic, where ",
 StyleBox["flist",
  FontSlant->"Italic"],
 " is a list of the indices of the faces that should be inset (others will \
not). If Automatic, all faces are inset.\n\tStickyFaceSubset \[Rule] ",
 StyleBox["flist",
  FontSlant->"Italic"],
 " | None, where flist is a list of the indices of the faces that vertices \
incident to those faces should be \[OpenCurlyDoubleQuote]stuck to.\
\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.9184932950134487`*^9, 3.91849335414966*^9}, {
  3.922204205665752*^9, 
  3.922204287145275*^9}},ExpressionUUID->"847f0906-4581-4db4-b8c6-\
e22e31a6b074"],

Cell["\<\
Returns: a GraphicsComplex with the same structure but with new vertices.\
\>", "Text",
 CellChangeTimes->{{3.911988835986696*^9, 
  3.911988848507156*^9}},ExpressionUUID->"125bdf1b-a4e8-4d80-9002-\
17351f16e82d"],

Cell["\<\
Note some limitations. The GC should have properly oriented faces. For \
polyhedra with one or more vertices of degree greater than 3, an ideal \
parallel-faced inset could result in vertices splitting into a complex \
containing new lines and/or faces. To preserve the topological structure of \
the original shape, we inset the vertices so that each inset face is \
preserved and lies within the equivalent parallel-faced inset. This could \
result in new faces that are not precisely parallel to the old faces or even \
nonplanar for faces of degree 4 or higher. If that is a problem, you should \
only apply this to fully triangulated polyhedra, because it could result in \
non-planar faces for higher-degree faces; alternatively, you could fully \
triangulate the polyhedron after insetting.\
\>", "Text",
 CellChangeTimes->{{3.911988854886076*^9, 3.911989047522278*^9}, {
  3.913540677270458*^9, 3.913540739709294*^9}, {3.914837430570243*^9, 
  3.914837504300153*^9}, {3.922204349553864*^9, 
  3.922204384809078*^9}},ExpressionUUID->"7829f744-1c43-4881-a621-\
d01eda5f4782"],

Cell["\<\
The option StickyFaceSubset should be used carefully, because it is possible \
to create overconstrained scenarios (if, for example, a vertex is incident to \
four or more such faces). See the last example for a situation where it might \
be useful.\
\>", "Text",
 CellChangeTimes->{{3.922204390385662*^9, 3.922204450297913*^9}, {
  3.922204486731317*^9, 
  3.922204506738758*^9}},ExpressionUUID->"ac8f97db-7ee6-44b4-96c1-\
dc7977e373de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "InsetGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"InsetFaceSubset", "->", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"StickyFaceSubset", "->", "None"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.918493391458311*^9, 3.918493414709714*^9}, {
  3.92220431393032*^9, 3.922204320393505*^9}},
 CellLabel->
  "In[4294]:=",ExpressionUUID->"45c228e6-aea3-454e-8666-fd952b7e6609"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsetGC", "[", 
   RowBox[{"gc_GraphicsComplex", ",", "t_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ifs", ",", "sfs", ",", "pts", ",", "polys", ",", "epolys", ",", 
      "fnorms", ",", "vfi", ",", "vfii", ",", "pts1", ",", "vx", ",", "vy", ",",
       "vz", ",", "tc", ",", "icons", ",", "econs", ",", "fom", ",", "soln", ",",
       "ret"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ifs", ",", "sfs"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"InsetFaceSubset", ",", "StickyFaceSubset"}], "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "InsetGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"gc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"gc", ",", "_Polygon", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"epolys", "=", 
      RowBox[{"Embed", "[", 
       RowBox[{"pts", ",", "polys", ",", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "the", " ", "faces", " ", "to", " ", "be", " ", "inset"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ifs", "===", "Automatic"}], ",", 
       RowBox[{"ifs", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "polys", "]"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sfs", "===", "None"}], ",", 
       RowBox[{"sfs", "=", 
        RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Get", " ", "their", " ", "corresponding", " ", "coefficients", " ", 
        "of", " ", "the", " ", "inset", " ", 
        RowBox[{"distance", ":", " ", 
         RowBox[{"1", " ", "if", " ", "inset"}]}]}], ",", " ", 
       RowBox[{"0", " ", "if", " ", 
        RowBox[{"not", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tc", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"ifs", ",", "i"}], "]"}], ",", "1", ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "polys", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"get", " ", "face", " ", "normals"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fnorms", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
            
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "-", 
            
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           ")"}]}], "]"}], "&"}], "/@", "epolys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"For", " ", "each", " ", "vertex"}], ",", " ", 
       RowBox[{
       "make", " ", "a", " ", "list", " ", "of", " ", "the", " ", "indices", " ",
         "of", " ", "the", " ", "faces", " ", "that", " ", "contain", " ", 
        RowBox[{"it", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vfi", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"First", "/@", 
         RowBox[{"Position", "[", 
          RowBox[{"polys", ",", "i"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "pts", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "faces", " ", "incident", " ", "to", " ", "the", " ", "ith", " ", 
         "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"vfii", "=", 
          RowBox[{
          "vfi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Inequality", " ", "constraints"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"icons", "=", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                  "pts", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "-", 
                  RowBox[{"{", 
                   RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}]}], ")"}], ".", 
                "#1"}], "-", 
               RowBox[{"#2", " ", "t"}]}], ">=", "0"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "fnorms", "\[LeftDoubleBracket]", "vfii", 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{
              "tc", "\[LeftDoubleBracket]", "vfii", 
               "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Equality", " ", "constraints", " ", "from", " ", "sticky", " ", 
           "faces"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"econs", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"vred", "=", 
              RowBox[{"Intersection", "[", 
               RowBox[{"vfii", ",", "sfs"}], "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    "pts", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "-", 
                    RowBox[{"{", 
                    RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}]}], ")"}], ".",
                   "#1"}], "-", 
                 RowBox[{"#2", " ", "t"}]}], "==", "0"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "fnorms", "\[LeftDoubleBracket]", "vred", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{
                "tc", "\[LeftDoubleBracket]", "vred", 
                 "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Figure", " ", "of", " ", "merit"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"fom", "=", 
          RowBox[{"Mag", "[", 
           RowBox[{
            RowBox[{
            "pts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "-", 
            RowBox[{"{", 
             RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"soln", "=", 
          RowBox[{"FindMinimum", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"fom", ",", 
              RowBox[{"Join", "[", 
               RowBox[{"icons", ",", "econs"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"vx", ",", 
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"vy", ",", 
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"vz", ",", 
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}], "/.", 
          RowBox[{
          "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "pts", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsComplex", "[", 
      RowBox[{"pts1", ",", 
       RowBox[{"Polygon", "/@", "polys"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 CellChangeTimes->{{3.911989274798457*^9, 3.911989381917541*^9}, {
   3.911989486901396*^9, 3.911989544997102*^9}, {3.911989578353105*^9, 
   3.911989665291975*^9}, {3.911989711147567*^9, 3.911989800004909*^9}, {
   3.911989833644108*^9, 3.911989939899851*^9}, {3.911989973545122*^9, 
   3.911990004988534*^9}, {3.911990037507535*^9, 3.911990246472616*^9}, {
   3.9119903244105577`*^9, 3.911990616829935*^9}, {3.911990709111059*^9, 
   3.9119907135435*^9}, {3.913458172109215*^9, 3.913458247361532*^9}, {
   3.913458307461627*^9, 3.913458325505727*^9}, {3.913458443292822*^9, 
   3.913458448260562*^9}, {3.913458767822686*^9, 3.913458773506948*^9}, {
   3.917204628078833*^9, 3.91720462982642*^9}, {3.917204671060185*^9, 
   3.917204675985944*^9}, {3.917204768821068*^9, 3.91720484008309*^9}, {
   3.917204889577757*^9, 3.9172048904368057`*^9}, {3.917205044297627*^9, 
   3.9172051494523897`*^9}, {3.917205374817725*^9, 3.917205409183545*^9}, {
   3.917205535737816*^9, 3.9172056183671913`*^9}, {3.917205896258183*^9, 
   3.9172060286592703`*^9}, {3.917212719910308*^9, 3.917212787777817*^9}, {
   3.9172128892569437`*^9, 3.917213041444139*^9}, {3.917213114964159*^9, 
   3.917213138181377*^9}, {3.9172131881349487`*^9, 3.917213199752714*^9}, {
   3.918493422392417*^9, 3.918493449937315*^9}, {3.918493782823971*^9, 
   3.918493834592198*^9}, {3.918493875174398*^9, 3.918494002294454*^9}, 
