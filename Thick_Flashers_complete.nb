ada8ee6ccd38"],

Cell[TextData[{
 "{TestTile, ",
 StyleBox["n",
  FontSlant->"Italic"],
 "} is a ",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 " fthat draws regular unit ",
 StyleBox["n",
  FontSlant->"Italic"],
 "-gons, which we use for testing. TileVertices are numbered. Options are:\n\t\
TilingIndex \[Rule] None | ",
 StyleBox["i",
  FontSlant->"Italic"],
 " , if specified, draws the index ",
 StyleBox["i",
  FontSlant->"Italic"],
 " in the center of the tile."
}], "Text",
 CellChangeTimes->{{3.629763123549937*^9, 3.629763179009622*^9}, {
   3.6297637411955*^9, 3.629763741725757*^9}, {3.6297653912453814`*^9, 
