Cell[BoxData[
 RowBox[{
  RowBox[{"MergeGraphAssigneds", "[", 
   RowBox[{"tglist_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mgdata", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AssertClasses", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"TGraph", ",", "TAssigned"}], "}"}], ",", 
         "MergeGraphAssigneds"}], "]"}], "&"}], "/@", "tglist"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mgdata", "=", 
