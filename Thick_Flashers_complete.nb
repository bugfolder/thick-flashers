            RowBox[{"verts3d", ",", "edges"}], "]"}], ",", "ec"}], "]"}]}], 
        "]"}], ",", "\[IndentingNewLine]", "de3d", ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"Style", "[", 
