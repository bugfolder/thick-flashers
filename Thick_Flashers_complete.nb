3522ef8151cc"],

Cell[TextData[{
 "PolygonTwistTwistAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraphAssigned of a polygon twist tile and returns a list of the \
twist angles at the central polygon."
}], "Text",
 CellChangeTimes->{{3.630022670671951*^9, 3.630022699770502*^9}, {
   3.630022807563052*^9, 3.630022814889738*^9}, 3.630070096379689*^9, {
   3.6300702268192987`*^9, 3.630070231978281*^9}, 
   3.707838333456801*^9},ExpressionUUID->"1d90116d-67bf-495d-9808-\
d45478ff50e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonTwistTwistAngles", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "v", ",", "p", ",", "q", ",", "r"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", 
       RowBox[{
        RowBox[{"tobj", "[", "Faces", "]"}], "\[LeftDoubleBracket]", "1", 
        "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"tobj", "[", "Vertices", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "q", ",", "r"}], "}"}], "=", 
         RowBox[{"v", "\[LeftDoubleBracket]", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"4", "i"}], "+", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "4", ",", "0"}], "}"}]}], ",", 
            RowBox[{"Length", "[", "v", "]"}], ",", "1"}], "]"}], 
          "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "triples", " ", "that", " ", "define", " ", "each", " ", "twist", " ",
           "angle"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p", "-", "q"}], ")"}], ".", 
           RowBox[{"(", 
            RowBox[{"r", "-", "q"}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p", "-", "q"}], ")"}], ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"RotationMatrix2D", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", 
             RowBox[{"(", 
              RowBox[{"r", "-", "q"}], ")"}]}], ")"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629217347456615*^9, 3.629217376824725*^9}, {
   3.629217453890737*^9, 3.6292174928008957`*^9}, {3.629217585940378*^9, 
   3.629217611499044*^9}, {3.629217664643754*^9, 3.629217857075459*^9}, {
   3.629217893841208*^9, 3.629217967732396*^9}, {3.629218063176713*^9, 
   3.629218141866789*^9}, 3.629218185370295*^9, 3.629219610300554*^9, {
   3.62983811190277*^9, 3.6298381215949917`*^9}, {3.630022716197731*^9, 
   3.630022768705046*^9}, {3.630022823326906*^9, 3.630022827759451*^9}, 
   3.630022887652934*^9, {3.630070242168396*^9, 3.630070259567103*^9}, 
   3.688166837132835*^9},
 CellLabel->
  "In[2877]:=",ExpressionUUID->"15ee083e-872d-484c-bf54-13edf7ae0942"],

