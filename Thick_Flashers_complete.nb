Cell["\<\
And if we make the focal length huge, then we should end up with the planar \
values (and we do).\
\>", "Text",
 CellChangeTimes->{{3.8256072986576447`*^9, 
  3.825607329346389*^9}},ExpressionUUID->"c1b18095-616d-40d1-8d43-\
12489177139c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "1"}], ",", 
      RowBox[{"m", "=", "4"}], ",", 
      RowBox[{"f", "=", 
       SuperscriptBox["10", "6"]}], ",", 
      RowBox[{"dr", "=", ".01"}], ",", "vars", ",", "ifns", ",", "srules"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vars", "=", 
      RowBox[{"FlasherVars", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ifns", "=", 
      RowBox[{"ParaboloidalFlasherIsometryFns", "[", 
       RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "f"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"srules", "=", 
