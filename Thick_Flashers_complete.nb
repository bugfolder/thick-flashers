Cell["\<\
Example. Paraboloid, different principal curvatures, line at angle \[Alpha] \
to principal curvatures. Show values at a point along the curve and plot both \
Frenet and Darboux frames at that point.\
\>", "Text",
 CellChangeTimes->{{3.6879869581570263`*^9, 3.687986987546091*^9}, {
  3.687987096884499*^9, 3.687987110562695*^9}, {3.6879941091374073`*^9, 
  3.6879941092799478`*^9}, {3.687998314224334*^9, 3.687998320798333*^9}, {
  3.688000256670855*^9, 3.688000261980619*^9}, {3.688135466401993*^9, 
  3.688135474153824*^9}},ExpressionUUID->"f5c077af-d673-4df4-aaff-\
c8fb2f1030a3"],

Cell["\<\
Also compare the time derivatives of the Darboux frame vectors to their \
values on the RHS of the differential equation, as a consistency check on our \
coefficients \[Kappa]n, \[Kappa]g, \[Tau]g.\
\>", "Text",
 CellChangeTimes->{{3.797263866488914*^9, 
  3.797263923505185*^9}},ExpressionUUID->"5c538375-95e5-4767-afda-\
b7d081b1888e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ss", ",", "u", ",", "v", ",", "t", ",", "ssu", ",", "ssv", ",", "soln", 
      ",", "uuu", ",", "\[Alpha]", ",", "qq", ",", "cc", ",", "uu", ",", 
      "cs3s"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{
          SuperscriptBox["#1", "2"], "+", 
          RowBox[{"3", 
           SuperscriptBox["#2", "2"]}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss[u,v] = \>\"", ",", 
       RowBox[{"ss", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "two", " ", "principle", " ", "lines", " ", "of", " ", "curvature"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ssu", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"ss", "[", 
         RowBox[{"u", ",", "0"}], "]"}], ",", "u"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ssv", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"ss", "[", 
         RowBox[{"0", ",", "v"}], "]"}], ",", "v"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"surface", " ", "normal"}], ",", " ", 
       RowBox[{"parameterized", " ", "on", " ", "two", " ", "variables"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuu", "=", 
      RowBox[{"SurfaceNormalFromSurface", "[", 
       RowBox[{"ss", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uuu[u,v] = \>\"", ",", 
       RowBox[{"uuu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "line", " ", "of", " ", "curve", " ", "in", " ", "parameterized", " ", 
        "space"}], ",", " ", 
       RowBox[{"rotated", " ", "at", " ", "angle", " ", "\[Alpha]"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"qq", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", " ", 
          RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], ",", 
         RowBox[{"#", " ", 
          RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<qq[t] = \>\"", ",", 
       RowBox[{"qq", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "curve", " ", "function", " ", "on", " ", "one", " ", "variable"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"ss", "@@", 
         RowBox[{"qq", "[", "t", "]"}]}], ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<cc[t] = \>\"", ",", 
       RowBox[{"cc", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "surface", " ", "normal", " ", "on", " ", "one", " ", "variable"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"uuu", "@@", 
         RowBox[{"qq", "[", "t", "]"}]}], ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu[t] = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "the", " ", "system"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cs3s", "=", 
      RowBox[{"Darboux3DSystemOld", "[", 
       RowBox[{"cc", ",", "uu", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", "\[Element]", "Reals"}], "}"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"cs3s", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r", ",", "dr", ",", "t0", ",", "fda", ",", "kn", ",", "kg", ",", 
         "tg", ",", "kp", ",", "ta", ",", "ds", ",", "tt", ",", "nn", ",", 
         "bb", ",", "ll"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"r", "=", "0.3"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"lateral", " ", "size", " ", "of", " ", "plot"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"dr", "=", "0.1"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"vector", " ", "lengths"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"t0", "=", "0.15"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"point", " ", "to", " ", "plot"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"30", "\[Degree]"}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{"rotation", " ", "angle"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<*** NUMERICAL ***\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"cs3s", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//",
          "Print"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "ds", ",", "tt", ",", "nn", ",", "bb", ",", "ll", ",", "uu", ",", 
           "fda", ",", "kn", ",", "kg", ",", "tg", ",", "kp", ",", "ta"}], 
          "}"}], "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
            "BinormalVector3D", ",", "TangentNormalVector3D", ",", 
            "SurfaceNormalVector3D", ",", "FrenetDarbouxAngle", ",", 
            "NormalCurvature3D", ",", "GeodesicCurvature3D", ",", 
            "GeodesicTorsion3D", ",", "Curvature3D", ",", "Torsion3D"}], 
           "}"}], "/.", "cs3s"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Alpha] = \>\"", ",", 
          RowBox[{"\[Alpha]", "/", "\[Degree]"}], ",", "\"\<\[Degree]\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Eta][t0] = \>\"", ",", 
          RowBox[{
           RowBox[{"fda", "[", "t0", "]"}], "/", "\[Degree]"}], 
          ",", "\"\<\[Degree]\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Kappa]\), \(n\)]\)[t0] = \>\"", ",", 
          RowBox[{"kn", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Kappa]\), \(g\)]\)[t0] = \>\"", ",", 
          RowBox[{"kg", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Tau]\), \(g\)]\)[t0] = \>\"", ",", 
          RowBox[{"tg", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Kappa][t0] = \>\"", ",", 
          RowBox[{"kp", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Tau][t0] = \>\"", ",", 
          RowBox[{"ta", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Check", " ", "consistency", " ", "with", " ", "the", " ", "Darboux",
           " ", "frame", " ", "differential", " ", 
          RowBox[{"equation", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[CapitalDelta]dt = \>\"", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"tt", "'"}], "[", "t0", "]"}], "-", 
            RowBox[{
             RowBox[{"ds", "[", "t0", "]"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"0", " ", 
                RowBox[{"tt", "[", "t0", "]"}]}], "+", 
               RowBox[{
                RowBox[{"kg", "[", "t0", "]"}], 
                RowBox[{"ll", "[", "t0", "]"}]}], "+", 
               RowBox[{
                RowBox[{"kn", "[", "t0", "]"}], 
                RowBox[{"uu", "[", "t0", "]"}]}]}], ")"}]}]}], "//", 
           "Chop"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[CapitalDelta]dl = \>\"", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ll", "'"}], "[", "t0", "]"}], "-", 
            RowBox[{
             RowBox[{"ds", "[", "t0", "]"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"kg", "[", "t0", "]"}]}], 
                RowBox[{"tt", "[", "t0", "]"}]}], "+", 
               RowBox[{"0", " ", 
                RowBox[{"ll", "[", "t0", "]"}]}], "+", 
               RowBox[{
                RowBox[{"tg", "[", "t0", "]"}], 
                RowBox[{"uu", "[", "t0", "]"}]}]}], ")"}]}]}], "//", 
           "Chop"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
