Cell[BoxData[
 RowBox[{
  RowBox[{"RecoverCurve2DSystemOld", "[", 
   RowBox[{"lkpf_Function", ",", "vf_Function", ",", " ", "opts___"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ip", ",", "it", ",", "si", ",", "as", ",", "t", ",", "sfn", ",", "lkp", 
      ",", "ds", ",", "ph", ",", "ph0", ",", "tt", ",", "ln", ",", "nn", ",", 
      "kp", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ip", "=", 
      RowBox[{
       RowBox[{"InitialPosition2D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve2DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"it", "=", 
      RowBox[{
       RowBox[{"InitialTangentVector2D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve2DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve2DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve2DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lkp", "=", 
      RowBox[{"lkpf", "[", "t", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"left", " ", "curvature"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"ds", "=", 
      RowBox[{"vf", "[", "t", "]"}]}], ";", 
     RowBox[{"(*", " ", "speed", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ph0", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"ArcTan", "@@", "it"}], ")"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ph", "=", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"ds", " ", "lkp"}], ",", "t"}], "]"}], "//", "sfn"}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{"turning", " ", "angle"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"ph", ",", "_Integrate", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "\[Equal]", 
        "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ph", "=", 
        RowBox[{
         RowBox[{"ph0", "+", 
          RowBox[{"(", 
           RowBox[{"ph", "-", 
            RowBox[{"(", 
             RowBox[{"ph", "/.", 
              RowBox[{"t", "\[Rule]", "0"}]}], ")"}]}], ")"}]}], "//", 
         "sfn"}]}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{"initial", " ", "condition"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"ph", "=", 
        RowBox[{
         RowBox[{"ph0", "+", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"ds", " ", "lkp"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "t"}], "}"}]}], "]"}]}], "//", 
         "sfn"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tt", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "ph", "]"}], ",", 
         RowBox[{"Sin", "[", "ph", "]"}]}], "}"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "tangent", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ln", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", "tt"}], "//", 
       "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"left", " ", "normal"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sign", "[", "lkp", "]"}], "ln"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "normal", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"kp", "=", 
      RowBox[{"Abs", "[", "lkp", "]"}]}], ";", 
     RowBox[{"(*", " ", "curvature", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"ds", " ", "tt"}], ",", "t"}], "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"Recovered", " ", "curve"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"c", ",", "_Integrate", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "\[Equal]", 
        "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"c", "=", 
        RowBox[{
         RowBox[{"ip", "+", 
          RowBox[{"(", 
           RowBox[{"c", "-", 
            RowBox[{"(", 
             RowBox[{"c", "/.", 
              RowBox[{"t", "\[Rule]", "0"}]}], ")"}]}], ")"}]}], "//", 
         "sfn"}]}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{"initial", " ", "condition"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"c", "=", 
        RowBox[{
         RowBox[{"ip", "+", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"ds", " ", "tt"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "t"}], "}"}]}], "]"}]}], "//", 
         "sfn"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve2D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"c", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed2D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"ds", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"LeftCurvature2D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"lkp", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Curvature2D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"kp", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector2D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"tt", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"LeftNormalVector2D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"ln", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"NormalVector2D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"nn", ",", "t"}], "]"}]}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.690971176125634*^9, 3.690971195191115*^9}, {
   3.690971230186028*^9, 3.690971239460518*^9}, {3.690971290074708*^9, 
   3.690971519676852*^9}, {3.690971874256171*^9, 3.690971902707679*^9}, {
   3.690971968042737*^9, 3.690971992639925*^9}, {3.6909720755933332`*^9, 
   3.690972097994493*^9}, {3.69097217855984*^9, 3.690972312963029*^9}, {
   3.690972349622345*^9, 3.690972356104524*^9}, {3.6909744208988533`*^9, 
   3.6909744596087933`*^9}, 3.690975250115992*^9, 3.690989197485897*^9, 
   3.690990129113268*^9, {3.690992768963159*^9, 3.690992777379264*^9}, {
   3.691182331954825*^9, 3.691182341638891*^9}, {3.691182773316822*^9, 
   3.691182773331517*^9}, {3.691182825385354*^9, 3.691182954817407*^9}, {
   3.69119589686692*^9, 3.691196153298438*^9}, {3.6911961898628798`*^9, 
