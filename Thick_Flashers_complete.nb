   3.798622845195428*^9}, {3.799407003076523*^9, 3.799407240033228*^9}, {
   3.799407282882568*^9, 3.799407380356785*^9}, {3.7994088560503287`*^9, 
   3.799408918521673*^9}, {3.799408976360251*^9, 3.799408987612198*^9}, {
   3.799409022190872*^9, 3.799409054237548*^9}, {3.799409646479546*^9, 
   3.799409679630574*^9}, {3.7994099189378233`*^9, 3.799409992648667*^9}, {
   3.799410026570464*^9, 3.79941003184965*^9}, {3.7994101934274817`*^9, 
   3.799410201938039*^9}, {3.79941033624172*^9, 3.799410406532833*^9}, {
   3.799410461020634*^9, 3.799410517436735*^9}, {3.79941055474384*^9, 
