Cell[CellGroupData[{

Cell[TextData[{
 "MinimumBoundingBoxRotationAngle[",
 StyleBox["verts, opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.62903248514706*^9, 3.6290324951540728`*^9}, {
  3.62905740214134*^9, 
  3.629057403470727*^9}},ExpressionUUID->"33ff5bb8-cc50-4da7-bb67-\
6301599d540b"],

Cell[TextData[{
 "MinimumBoundingBoxRotationAngle[",
 StyleBox["verts",
  FontSlant->"Italic"],
 "] returns the rotation angle within the range (-\[Pi]/4, \[Pi]/4] that \
minimizes the area of the bounding box of the set of vertices. It is useful \
for optimally fitting an irregular crease pattern onto a rectangular sheet of \
paper. Options are:\n\tOrientation \[Rule] Horizontal | Vertical | Automatic. \
Horizontal makes it wider than tall, Vertical makes it taller than wide, \
Automatic chooses the least magnitude angle."
}], "Text",
 CellChangeTimes->{{3.6290325033457747`*^9, 3.629032590628124*^9}, {
  3.62905745619596*^9, 
  3.629057507151324*^9}},ExpressionUUID->"fa8eb063-7568-4cd4-bbd3-\
b7e584d7603c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Orientation", "::", "usage"}], 
   "=", "\"\<Orientation is an option to MinimumBoundingBoxRotationAngle that \
specifies the desired orientation of the rotated bounding box.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.629057534715025*^9, 3.629057567414064*^9}},
 CellLabel->
  "In[485]:=",ExpressionUUID->"a3d93894-6edf-4e12-9e3b-ee8ef0451d82"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MinimumBoundingBoxRotationAngle", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Orientation", "\[Rule]", "Automatic"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.629057570284469*^9, 3.629057588708737*^9}},
 CellLabel->
  "In[486]:=",ExpressionUUID->"98e7636b-27f7-430d-90d1-c82c188a4ee0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MinimumBoundingBoxRotationAngle", "::", "badorien"}], 
   "=", "\"\<`1` is an invalid option for Orientation.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.629057782766196*^9, 3.629057796167057*^9}},
 CellLabel->
  "In[487]:=",ExpressionUUID->"8a01f04a-89ee-40c2-a601-fa174eca10ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MinimumBoundingBoxRotationAngle", "[", 
   RowBox[{"verts_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "or", ",", "rverts", ",", "\[Alpha]", ",", "w", ",", "h", ",", "eqns", ",",
       "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"or", "=", 
      RowBox[{
       RowBox[{"Orientation", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MinimumBoundingBoxRotationAngle", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"rverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", "\[Alpha]", "]"}], ".", "#"}], 
        "&"}], "/@", "verts"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"w", ",", "h"}], "}"}], "=", 
      RowBox[{"BoundingBoxExtent", "[", "rverts", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"w", " ", "h"}], "}"}], ",", 
        RowBox[{"Switch", "[", 
         RowBox[{"or", ",", "Horizontal", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Alpha]", ">", 
             RowBox[{
              RowBox[{"-", "\[Pi]"}], "/", "2"}]}], ",", 
            RowBox[{"\[Alpha]", "\[LessEqual]", 
             RowBox[{"\[Pi]", "/", "2"}]}], ",", 
            RowBox[{"w", "\[GreaterEqual]", "h"}]}], "}"}], ",", "Vertical", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Alpha]", ">", 
             RowBox[{
              RowBox[{"-", "\[Pi]"}], "/", "2"}]}], ",", 
            RowBox[{"\[Alpha]", "\[LessEqual]", 
             RowBox[{"\[Pi]", "/", "2"}]}], ",", 
            RowBox[{"w", "\[LessEqual]", "h"}]}], "}"}], ",", "Automatic", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Alpha]", ">", 
             RowBox[{
              RowBox[{"-", "\[Pi]"}], "/", "4"}]}], ",", 
            RowBox[{"\[Alpha]", "\[LessEqual]", 
             RowBox[{"\[Pi]", "/", "4"}]}]}], "}"}], ",", "_", ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"MinimumBoundingBoxRotationAngle", "::", "badorien"}], 
            "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"NMinimize", "[", 
       RowBox[{"eqns", ",", 
        RowBox[{"{", "\[Alpha]", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "/.", 
      RowBox[{
      "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.62903250505619*^9, 3.629032505072003*^9}, {
   3.629032600629654*^9, 3.629032642699644*^9}, {3.629032709183181*^9, 
   3.629032791897839*^9}, {3.629033106355217*^9, 3.629033126947611*^9}, {
   3.629033576480996*^9, 3.62903358518431*^9}, {3.629057518291842*^9, 
   3.629057527057233*^9}, {3.629057593881914*^9, 3.629057808626953*^9}, {
   3.629057843314177*^9, 3.629057843703697*^9}, 3.68816683606586*^9},
 CellLabel->
  "In[488]:=",ExpressionUUID->"d7cc2c35-4056-4535-8c4c-df225e687668"],

Cell["Example", "Text",
 CellChangeTimes->{{3.629033165529078*^9, 
  3.629033166254569*^9}},ExpressionUUID->"0ad381d4-c57a-438e-8f08-\
d21a2bc6813e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "bbox", ",", "\[Alpha]", ",", "rverts", ",", "gfn"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "0", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2.", 
          RowBox[{"Random", "[", "]"}], 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}], "+", 
         RowBox[{"3.", " ", 
          RowBox[{"Random", "[", "]"}], 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}]}], ",", 
        RowBox[{"{", "20", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"MinimumBoundingBoxRotationAngle", "[", 
       RowBox[{"verts", ",", 
        RowBox[{"Orientation", "\[Rule]", "Automatic"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[Alpha]/\[Degree] = \>\"", ",", 
       RowBox[{"\[Alpha]", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", "\[Alpha]", "]"}], ".", "#"}], 
        "&"}], "/@", "verts"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gfn", "[", "pts_", "]"}], ":=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Point", "/@", "pts"}], ",", 
            RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"AppendFirst", "[", 
              RowBox[{"RectVertices", "@@", 
               RowBox[{"Transpose", "[", 
                RowBox[{"BoundingBox", "[", "pts", "]"}], "]"}]}], "]"}], 
             "]"}], ",", "Red"}], "]"}]}], "}"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gfn", "[", "verts", "]"}], ",", 
        RowBox[{"gfn", "[", "rverts", "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629033167645947*^9, 3.629033376437756*^9}, {
   3.629033436544959*^9, 3.629033461376798*^9}, {3.629033493495586*^9, 
   3.629033564116918*^9}, {3.629033607377387*^9, 3.629033607584454*^9}, {
   3.6290578223134403`*^9, 3.629057889010816*^9}, 3.688166836095937*^9},
 CellLabel->
  "In[489]:=",ExpressionUUID->"371f3aeb-ecf7-44a8-90b6-42ca443a94b8"]
}, Closed]]
}, Closed]],

