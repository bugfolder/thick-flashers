   3.650054735887619*^9}, {3.650064213416821*^9, 3.650064247814357*^9}, {
   3.650064359858013*^9, 3.650064407484576*^9}, 3.650064759558208*^9, {
   3.650071802708168*^9, 3.650071816455894*^9}, {3.650112425468735*^9, 
