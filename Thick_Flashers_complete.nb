Cell[CellGroupData[{

Cell[TextData[{
 "VertexVertexAdjacencyFromVerticesAndEdges",
 "[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{3.592610479503201*^9, 
  3.592648559055455*^9},ExpressionUUID->"3f2e2d65-432b-4c65-a1b7-\
0f4683b986e3"],

Cell[TextData[{
 "VertexVertexAdjacencyFromVerticesAndEdges[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " of vertex coordinates and a list ",
 StyleBox["edges",
  FontSlant->"Italic"],
 " of edge pairs and constructs lists of the adjacent vertices around each \
vertex in CCW order. This is a helper function use by AddTPlaneGraphTo \
(below), but can also be used as a utility to find vertex-vertex adjacency \
even in crossing graphs (as we do for the folded form graph in \
MakeSimpleWovenTessellation",
 "TPlaneGraph",
 "Pair)."
}], "Text",
 CellChangeTimes->{{3.592610329755518*^9, 3.592610429215166*^9}, {
   3.592610470926794*^9, 3.592610472204522*^9}, {3.592610611884139*^9, 
   3.592610614380187*^9}, 3.5926476497209673`*^9, {3.592648437769466*^9, 
   3.592648438977125*^9}, 3.592648559176301*^9, {3.5928287106174297`*^9, 
   3.592828710735313*^9}},ExpressionUUID->"cb2a14c5-026d-4881-b79e-\
529e6fad03ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexVertexAdjacencyFromVerticesAndEdges", "[", 
   RowBox[{"verts_List", ",", "edges_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "halfedges", ",", "heangles", ",", "hevtable", ",", "hesvtable"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"halfedges", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"edges", ",", 
        RowBox[{"Reverse", "/@", "edges"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"heangles", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"ArcTan", "@@", 
           RowBox[{"-", 
            RowBox[{"Subtract", "@@", 
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "#", 
              "\[RightDoubleBracket]"}]}]}]}]}], "}"}], "&"}], "/@", 
       "halfedges"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "append", " ", "angle", " ", "to", " ", "each", " ", "halfedge"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"hevtable", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"heangles", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]", 
            "i"}], "&"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"group", " ", "by", " ", "vertex"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"hesvtable", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
           "&"}]}], "]"}], "&"}], "/@", "hevtable"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sort", " ", "each", " ", "list", " ", "by", " ", "angle"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "&"}], ",", 
       "hesvtable", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}]}], 
   RowBox[{"(*", " ", 
    RowBox[{
    "return", " ", "just", " ", "the", " ", "vertex", " ", "index", " ", "of",
      " ", "each", " ", "halfedge"}], " ", "*)"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.592610494140971*^9, 3.592610581230007*^9}, 
   3.592648559195842*^9},
 CellLabel->
  "In[1137]:=",ExpressionUUID->"9a833010-04d7-44fa-91be-8136940328c3"],

Cell["Example", "Text",
 CellChangeTimes->{{3.592610661554625*^9, 
  3.592610662208545*^9}},ExpressionUUID->"3912c466-9d96-4837-bb1f-\
8de6b53da7b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", "CrossedSquareGraph"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", "tobj", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"VertexVertexAdjacencyFromVerticesAndEdges", "[", 
      RowBox[{"verts", ",", "edges"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462343199059805*^9, 3.4623432929492598`*^9}, {
   3.462343351071533*^9, 3.4623433537919083`*^9}, {3.462345683251084*^9, 
   3.4623456862369947`*^9}, {3.462346043555668*^9, 3.462346045015026*^9}, {
   3.465925095895727*^9, 3.465925137809402*^9}, {3.465925351695536*^9, 
   3.465925354835655*^9}, 3.465936135694316*^9, {3.465937716644853*^9, 
   3.465937721699175*^9}, {3.484832614388371*^9, 3.484832614439713*^9}, {
   3.591696748758929*^9, 3.591696905579487*^9}, 3.591696949537405*^9, 
   3.591737010578936*^9, 3.591895913542755*^9, {3.59189613668829*^9, 
   3.591896136786602*^9}, 3.5919006832664957`*^9, 3.592039959439977*^9, {
   3.592049061101669*^9, 3.59204906848836*^9}, 3.592208503775913*^9, {
   3.592239067960415*^9, 3.592239071059351*^9}, {3.5923443028886433`*^9, 
   3.592344302934092*^9}, {3.592345815701703*^9, 3.592345815770464*^9}, 
   3.592351654944474*^9, {3.5924358535817757`*^9, 3.592435853713109*^9}, {
   3.592610686096971*^9, 3.592610705197871*^9}, 3.59264855924304*^9, 
   3.5947342531047*^9, {3.7068257195414953`*^9, 3.706825760460605*^9}},
 CellLabel->
  "In[1138]:=",ExpressionUUID->"7d0952cf-b19f-4bea-9c36-4caf3dd7409f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "VertexDegreeFromEdges[",
 StyleBox["edges",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.484778031015572*^9, 
  3.484778037133395*^9}},ExpressionUUID->"c95095aa-aeca-4031-ba24-\
28a296c709d0"],

Cell["\<\
VertexDegreeFromEdges[edges] returns a list of the degree of each vertex, in \
order.\
\>", "Text",
 CellChangeTimes->{{3.4847780421173697`*^9, 
  3.484778067931432*^9}},ExpressionUUID->"b9a70d98-8007-4109-9785-\
0511aec11673"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexDegreeFromEdges", "[", "edges_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "vv", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vv", "=", 
      RowBox[{"Flatten", "[", "edges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{"vv", ",", "i"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Max", "[", "vv", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.48477773671659*^9, 3.484777765059216*^9}, {
   3.484777811576155*^9, 3.4847778318298473`*^9}, 3.627328639069917*^9},
 CellLabel->
  "In[1139]:=",ExpressionUUID->"ded2114d-7bb3-4291-84ff-3ba0d76ee8b9"],

Cell["Example", "Text",
 CellChangeTimes->{{3.484777835500436*^9, 
  3.484777836378592*^9}},ExpressionUUID->"28a9a465-e131-46b3-9230-\
9f2bc4dcab1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"+", "1"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", "tobj", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"VertexDegreeFromEdges", "[", "edges", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.484777853915503*^9, 3.484777988313435*^9}, {
   3.484778072576021*^9, 3.484778074188525*^9}, 3.484832614605116*^9, {
   3.591718248187838*^9, 3.591718275489353*^9}, {3.592048961275022*^9, 
   3.592048978106495*^9}, 3.592344302671034*^9, 3.592345815478191*^9, {
   3.592350784544109*^9, 3.592350794229692*^9}, {3.592435850581461*^9, 
   3.592435850644273*^9}, 3.594734253052553*^9},
 CellLabel->
  "In[1140]:=",ExpressionUUID->"9b6f2562-4e20-4a7a-a22e-6c406da505ea"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["TGraph extension and clipping", "Subsection",
 CellChangeTimes->{{3.594941868680393*^9, 3.594941875207205*^9}, {
   3.595190115935633*^9, 3.595190117821397*^9}, 3.59597555053086*^9, 
   3.597510765410653*^9},ExpressionUUID->"26ba3726-c8b7-423e-b100-\
becfbf295d31"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.595294261374678*^9, 
  3.595294261884562*^9}},ExpressionUUID->"eed2e3da-1778-4752-9753-\
42986869bb21"],

Cell["\<\
These functions provide various ways of clipping and/or extending a TGraph to \
redefine the shape of its boundary.\
\>", "Text",
 CellChangeTimes->{{3.595294264213264*^9, 3.595294313369566*^9}, {
  3.595294386917122*^9, 3.595294455504588*^9}, {3.595298785519924*^9, 
  3.595298785776037*^9}},ExpressionUUID->"50845bd3-d8b1-4965-a5f2-\
9a401fd0211d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "CircularlyExtendEdges[",
 StyleBox["verts, edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts, ctr, r",
  FontSlant->"Italic"],
 "]\nCircularlyExtendEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts, ctr, r",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.59519014267706*^9, 3.59519016141074*^9}, {
  3.595190259620027*^9, 3.59519027077623*^9}, {3.595190428954462*^9, 
  3.595190430705889*^9}, {3.595190539962499*^9, 3.595190541073708*^9}, {
  3.595294478727185*^9, 3.595294498301525*^9}, {3.597494553080015*^9, 
  3.597494558189458*^9}},ExpressionUUID->"c88ac989-af6a-40e1-a238-\
97cd7a34283a"],

Cell[TextData[{
 "CircularlyExtendEdges[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts, ctr, r",
  FontSlant->"Italic"],
 "] takes lists ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " of vertices and ",
 StyleBox["edges",
  FontSlant->"Italic"],
 " of edges of a graph and an ordered list ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 " of the indices of the boundary vertices and radially extends/contracts \
those vertices whose indices are in the list ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 " according to this algorithm:\n\tIf there is a single interior edge \
extending to the vertex, that edge is lengthened or contracted until the \
vertex lies on the specified circle.\n\tAll boundary vertices between \
interior-connected vertices are evenly spaced around the circle between the \
points where the interior-connected vertices hit the circle.\nIt returns a \
list of the modified vertices."
}], "Text",
 CellChangeTimes->{{3.595190302730116*^9, 3.595190375334119*^9}, {
   3.5951904174424276`*^9, 3.595190536490121*^9}, {3.595294508158423*^9, 
   3.5952945971436653`*^9}, {3.597453595268194*^9, 3.59745359612214*^9}, {
   3.5974945775328712`*^9, 3.597494582779615*^9}, {3.597494655022821*^9, 
   3.597494664910365*^9}, {3.628640810303445*^9, 3.6286410091771297`*^9}, 
   3.628683120764708*^9},ExpressionUUID->"42c59fe2-c819-4705-8bc9-\
7c2bb697e563"],

Cell[TextData[{
 "Note: ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 " must be an ordered list of vertices. There may be retrograde edges in ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 ".\nNote: if there are two interior edges connected to a vertex in ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 ", the vertex cannot be extended and an error is thrown."
}], "Text",
 CellChangeTimes->{{3.6286831240043783`*^9, 
  3.628683191536711*^9}},ExpressionUUID->"405903e1-8e85-4f25-a705-\
dfa7115d71fd"],

Cell["This is used in CircularPolygonTwistGraph2D, below.", "Text",
 CellChangeTimes->{{3.628683274315425*^9, 
  3.628683294361313*^9}},ExpressionUUID->"91e6d15c-ae2e-42df-960c-\
d2d1675b90bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CircularlyExtendEdges", "::", "badvert"}], 
   "=", "\"\<Vertex `1` must have 0 or 1 interior edge but has `2` interior \
edges.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595295570780003*^9, 3.5952956109576473`*^9}},
 CellLabel->
  "In[1141]:=",ExpressionUUID->"90885cd3-091d-4a85-8912-46d5d421691d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CircularlyExtendEdges", "[", 
   RowBox[{
    StyleBox["verts_List",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox["edges_List",
     FontSlant->"Italic"], ",", 
    StyleBox["bverts_List",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["ctr_List",
     FontSlant->"Italic"], 
    StyleBox[",",
     FontSlant->"Italic"], 
    StyleBox[" ",
     FontSlant->"Italic"], 
    StyleBox["r_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nb", ",", "idata", ",", "bv", ",", "be", ",", "ie", ",", "ni", ",", 
      "ee", ",", "nv", ",", "na", ",", "ip", ",", "in", ",", "pdata", ",", 
      "ndata", ",", "newverts", ",", "dn", ",", "di", ",", "da"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nb", "=", 
      RowBox[{"Length", "[", "bverts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"First", " ", 
        RowBox[{"pass", ":", " ", 
         RowBox[{
          RowBox[{"make", " ", "a", " ", "list", " ", "of", " ", 
           RowBox[{"{", 
            RowBox[{"nv", ",", " ", "na"}], "}"}], " ", "for", " ", 
           "interior"}], "-", 
          RowBox[{"connected", " ", "edges"}]}]}]}], ",", " ", 
       RowBox[{"Null", " ", "for", " ", "others"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"idata", "=", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"bv", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"be", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"edges", ",", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"#", ",", "bv"}], "]"}], "&"}]}], "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{"all", " ", "edges", " ", "containing", " ", "bv"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"ie", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"be", ",", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"bverts", ",", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}], "]"}], "&&", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"bverts", ",", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], "]"}]}], ")"}]}], "&"}]}], 
            "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{"all", " ", "edges", " ", "of", " ", "form", " ", 
            RowBox[{"{", 
             RowBox[{"bv", ",", " ", "iv"}], "}"}]}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"ni", "=", 
           RowBox[{"Length", "[", "ie", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Which", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ni", "\[Equal]", "0"}], ",", "Null", ",", 
            RowBox[{"(*", " ", 
             RowBox[{"no", " ", "interior", " ", "edge"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"ni", "\[Equal]", "1"}], ",", 
            RowBox[{
             RowBox[{"ee", "=", 
              RowBox[{
              "ie", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
             ";", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                "ee", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                "\[Equal]", "bv"}], ",", 
               RowBox[{"ee", "=", 
                RowBox[{"Reverse", "[", "ee", "]"}]}]}], "]"}], ";", 
             RowBox[{"nv", "=", 
              RowBox[{"RayCircleInt2D", "[", 
               RowBox[{
                RowBox[{"verts", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "ee", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
                  "\[RightDoubleBracket]"}], ",", 
                RowBox[{
                 RowBox[{
                 "verts", "\[LeftDoubleBracket]", "bv", 
                  "\[RightDoubleBracket]"}], "-", 
                 RowBox[{"verts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "ee", "\[LeftDoubleBracket]", "2", 
                   "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], ",",
                 "ctr", ",", "r"}], "]"}]}], ";", 
             RowBox[{"(*", " ", 
              RowBox[{"new", " ", "vertex", " ", "position"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"na", "=", 
              RowBox[{"AbsoluteAngle", "[", 
               RowBox[{"nv", "-", "ctr"}], "]"}]}], ";", 
             RowBox[{"(*", " ", 
              RowBox[{"radial", " ", "angle", " ", "around", "  ", "circle"}],
               " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"nv", ",", "na"}], "}"}]}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"ni", ">", "1"}], ",", 
            RowBox[{
             RowBox[{"Message", "[", 
              RowBox[{
               RowBox[{"CircularlyExtendEdges", "::", "badvert"}], ",", "bv", 
               ",", "ni"}], "]"}], ";", 
             RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], "/@", "bverts"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"For", " ", "all", " ", "non"}], "-", "interior", "-", 
        RowBox[{"connected", " ", "vertices"}]}], ",", " ", 
