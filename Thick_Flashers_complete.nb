             FractionBox["1", "2"], " ", 
             SqrtBox["3"], " ", 
             RowBox[{"Cos", "[", "#", "]"}]}], ",", 
            FractionBox["1", "2"]}], "}"}], "&"}], "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"torsion", " ", "for", " ", "flat", " ", "shape"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "initial", " ", "conditions", " ", "in", " ", "the", " ", "flat", " ", 
       "state"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
