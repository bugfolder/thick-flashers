   3.466096314936574*^9, 3.466096424337121*^9}, {3.46609648173431*^9, 
   3.466096617296139*^9}, 3.466097536065874*^9, {3.466098189378167*^9, 
   3.466098347024954*^9}, {3.466098784669175*^9, 3.466098786610458*^9}, {
   3.485220718434375*^9, 3.4852207340921497`*^9}, 3.533505179175487*^9, {
   3.533510650394506*^9, 3.53351065302423*^9}, {3.591738378779432*^9, 
   3.591738516130439*^9}, {3.591789549705251*^9, 3.591789553240455*^9}, {
   3.592050342897224*^9, 3.592050347555132*^9}, 3.5922085989304533`*^9, {
   3.592403607505537*^9, 3.592403750840944*^9}, {3.592403814302074*^9, 
   3.592403848040778*^9}, 3.592435860251137*^9, 3.592647647647376*^9, 
   3.59265984475161*^9, 3.592670434761699*^9, 3.592670630099612*^9, 
   3.5926710689941683`*^9, 3.592828723588257*^9, {3.592828807241694*^9, 
