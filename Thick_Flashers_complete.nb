}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PatchVector[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}]\nPatchVectors[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["i3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j3",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.631123300757238*^9, 3.631123337210011*^9}, {
  3.631123608619907*^9, 3.6311236291228933`*^9}, {3.631123715739192*^9, 
  3.631123722090925*^9}, {3.631123923034399*^9, 
  3.6311239379532547`*^9}},ExpressionUUID->"8ff43de8-8bab-4e58-8fb1-\
718256e89682"],

Cell[TextData[{
 "PatchVector[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}] returns a vector from the j1th vertex of the i1th tile of patch patch to \
the j2th vertex of the i2th tile. This can be used to efficiently construct \
the lattice vectors for a patch from the vertex data for the patch."
}], "Text",
 CellChangeTimes->{{3.63112354326286*^9, 3.631123770279256*^9}, {
  3.631123878814612*^9, 
  3.631123889253131*^9}},ExpressionUUID->"24ba6010-88cb-495f-ba9d-\
005c18347dd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PatchVector", "[", 
   RowBox[{"patch_List", ",", " ", 
    RowBox[{"{", 
     RowBox[{"i1_", ",", " ", "j1_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i2_", ",", " ", "j2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"patch", ",", "TileVertices"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"verts", "\[LeftDoubleBracket]", 
       RowBox[{"i2", ",", "j2"}], "\[RightDoubleBracket]"}], "-", 
      RowBox[{"verts", "\[LeftDoubleBracket]", 
       RowBox[{"i1", ",", "j1"}], "\[RightDoubleBracket]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.631123515274983*^9, 3.631123527542492*^9}, {
   3.631123897839604*^9, 3.631123908606664*^9}, {3.631123973727985*^9, 
   3.631124027023016*^9}, 3.707758217811451*^9},
 CellLabel->
  "In[3090]:=",ExpressionUUID->"bcbe4007-ff9a-4b8a-9b3f-c6c263c8177d"],

Cell["Example", "Text",
 CellChangeTimes->{{3.631124047490436*^9, 
  3.63112404825701*^9}},ExpressionUUID->"5554c3f4-454b-4bb4-9c6a-\
a1b3a0282d65"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "patch", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"patch", "=", 
       RowBox[{"JoinTiling", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "1"}], "}"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"3", ",", "4", ",", "3"}], "}"}]}], "}"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"EmbedTiling", "[", 
          RowBox[{"patch", ",", "Tiling", ",", 
           RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
           RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
        RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"PatchVector", "[", 
       RowBox[{"patch", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], "//", "ShowExample"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.631124049548348*^9, 3.631124235278098*^9}},
 CellLabel->
  "In[3091]:=",ExpressionUUID->"7207ce2a-b91a-4954-92e2-1e789a06004c"],

Cell[TextData[{
 "PatchVectors[",
 StyleBox["patch",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["i3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j3",
  FontSlant->"Italic"],
 "}] does the same thing but returns a pair of vectors, one from {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1",
  FontSlant->"Italic"],
 "} to {",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, the second from {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1",
  FontSlant->"Italic"],
 "} to {",
 StyleBox["i3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j3",
  FontSlant->"Italic"],
 "}. It\[CloseCurlyQuote]s useful for specifying the lattice vectors in a \
single command."
}], "Text",
 CellChangeTimes->{{3.63112354326286*^9, 3.631123770279256*^9}, {
  3.631123878814612*^9, 3.631123889253131*^9}, {3.631124261873748*^9, 
  3.631124321802692*^9}},ExpressionUUID->"199b0e66-c906-4f65-b371-\
48f9b417447c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PatchVectors", "[", 
   RowBox[{"patch_List", ",", " ", 
    RowBox[{"{", 
     RowBox[{"i1_", ",", " ", "j1_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i2_", ",", " ", "j2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i3_", ",", "j3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"patch", ",", "TileVertices"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"verts", "\[LeftDoubleBracket]", 
         RowBox[{"i2", ",", "j2"}], "\[RightDoubleBracket]"}], "-", 
        RowBox[{"verts", "\[LeftDoubleBracket]", 
         RowBox[{"i1", ",", "j1"}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
        RowBox[{"verts", "\[LeftDoubleBracket]", 
         RowBox[{"i3", ",", "j3"}], "\[RightDoubleBracket]"}], "-", 
        RowBox[{"verts", "\[LeftDoubleBracket]", 
         RowBox[{"i1", ",", "j1"}], "\[RightDoubleBracket]"}]}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.631123515274983*^9, 3.631123527542492*^9}, {
   3.631123897839604*^9, 3.631123908606664*^9}, {3.631123973727985*^9, 
   3.631124027023016*^9}, {3.631127453363099*^9, 3.631127477836182*^9}, 
