   3.800210564330031*^9, 
   3.800211638696392*^9},ExpressionUUID->"4b108515-7719-4aa1-92ff-\
8e472bed7d29"],

Cell[TextData[{
 "MatchCurveSpeed[",
 StyleBox["c1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes two curves and reparameterizes the second one so that it has the \
same curve speed as the first and the old and new reparameterized curves \
match at a specified point."
}], "Text",
 CellChangeTimes->{{3.691580240584978*^9, 3.6915802790773783`*^9}, {
   3.691580451784436*^9, 3.691580452377629*^9}, {3.6915813455875597`*^9, 
   3.691581350650943*^9}, {3.691581429459126*^9, 3.69158143739536*^9}, 
   3.8002093023496637`*^9, {3.80021043166966*^9, 3.800210432292573*^9}, {
   3.800210513870318*^9, 3.800210515149268*^9}, 3.800210564339299*^9, 
   3.800211638706832*^9},ExpressionUUID->"6bdd2cbc-f87b-4246-ba45-\
9d29ed5387b8"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c1",
  FontSlant->"Italic"],
 " \[LongDash] the first curve as a vector-valued pure function, could be 2D \
or 3D.\n\t",
 StyleBox["c2",
  FontSlant->"Italic"],
 " \[LongDash] the second curve as a vector-valued pure function, could be 2D \
or 3D.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the parameter at which the old and new curves should match."
}], "Text",
 CellChangeTimes->{{3.691580289272049*^9, 3.69158032759784*^9}, {
   3.6915813570112767`*^9, 3.691581366544193*^9}, {3.691581441891892*^9, 
   3.691581445413598*^9}, 3.8002104223299017`*^9, 
   3.800210564348299*^9},ExpressionUUID->"c1c2fc5d-6048-4e34-8c8e-\
75f8fd4941c0"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
  3.691235123137779*^9, 
  3.691235148876122*^9}},ExpressionUUID->"cd401f4a-8869-4d0f-93c0-\
a242bbb5c856"],

Cell["Returns: the reparameterized second curve.", "Text",
 CellChangeTimes->{{3.691580464686341*^9, 
  3.6915804751913853`*^9}},ExpressionUUID->"765d6fd4-d4d5-4ac0-bf46-\
976a637c166a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatchCurveSpeed", "::", "nosoln"}], 
   "=", "\"\<DSolve couldn's solve for the reparameterization.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691590034772623*^9, 3.691590064838083*^9}, 
   3.800209302355802*^9, {3.8002096275363693`*^9, 3.800209640862933*^9}, 
