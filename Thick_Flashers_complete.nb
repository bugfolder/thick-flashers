4d233b0e98c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AssertProperty", "::", "missing"}], " ", "=", 
   " ", "\"\<`1` is missing required property `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59163879771511*^9, 3.59163882232399*^9}, 
   3.593006069387916*^9},
 CellLabel->
  "In[976]:=",ExpressionUUID->"ae9ca8c2-e193-42b7-be19-87ee8aca88a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AssertProperty", "[", 
   RowBox[{"tobj_TObj", ",", " ", "property_Symbol"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"GetAllProperties", "[", "tobj", "]"}], ",", "property"}], 
      "]"}]}], ",", 
    RowBox[{
     RowBox[{"Message", "[", 
      RowBox[{
       RowBox[{"AssertProperty", "::", "missing"}], ",", "tobj", ",", 
       "property"}], "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.591380163483273*^9, 3.591380240365049*^9}, {
   3.591380807702289*^9, 3.591380814171938*^9}, {3.591636626347725*^9, 
