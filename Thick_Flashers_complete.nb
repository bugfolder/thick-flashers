  RowBox[{"Mod", "[", 
   RowBox[{
    RowBox[{"RotationAngle", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}], ",", 
