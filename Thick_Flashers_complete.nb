   3.44205599132306*^9, 3.442056002611651*^9}, {3.442875526525609*^9, 
   3.4428755265256767`*^9}, {3.443018407606316*^9, 3.443018408329867*^9}, {
   3.443020462372183*^9, 3.443020476650337*^9}, {3.592829655173485*^9, 
   3.5928296551735983`*^9}, {3.5928297362245603`*^9, 3.592829736224657*^9}, {
   3.592829843074402*^9, 3.59282984603288*^9}, {3.594772015901845*^9, 
   3.594772031170241*^9}, {3.594772369659766*^9, 3.5947723700569*^9}, {
