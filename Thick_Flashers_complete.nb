Cell[BoxData[
 RowBox[{
  RowBox[{"JoinGraph2DAssigneds", "[", 
   RowBox[{"graphspecs_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tglist", ",", "i", ",", "j1", ",", "j2", ",", "k1", ",", "k2", ",", 
      "vertsj", ",", "vertsk", ",", "rm", ",", "offset"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tglist", "=", 
      RowBox[{"JoinGraphsData", "[", "graphspecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Find", " ", "the", " ", "transformed", " ", "Vertex2D", " ", 
       "coordinates", " ", "for", " ", "each", " ", "subgraph"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", "j1", ",", "j2", ",", "k1", ",", "k2"}], "}"}], "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"graphspecs", "\[LeftDoubleBracket]", 
           RowBox[{"l", ",", "2"}], "\[RightDoubleBracket]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vertsj", "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "[",
           "Vertices2D", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vertsk", "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "[",
           "Vertices2D", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rm", ",", "offset"}], "}"}], "=", 
         RowBox[{"SimilarityPair2D", "[", 
          RowBox[{
           RowBox[{"vertsk", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"k1", ",", "k2"}], "}"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"vertsj", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"j1", ",", "j2"}], "}"}], "\[RightDoubleBracket]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vertsk", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"offset", "+", 
             RowBox[{"rm", ".", "#"}]}], ")"}], "&"}], "/@", "vertsk"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"Vertices2D", "\[Rule]", "vertsk"}], "]"}]}]}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MergeGraph2DAssigneds", "[", 
      RowBox[{"tglist", ",", "opts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.649951491309664*^9, 3.649951519996139*^9}, {
   3.6499515860093*^9, 3.649951683506267*^9}, 3.649953554970544*^9, {
   3.649953814034854*^9, 3.649953839807665*^9}, {3.649953909939651*^9, 
   3.649954015572988*^9}, {3.64995405168834*^9, 3.64995412302378*^9}, {
   3.649954305479694*^9, 3.649954305755933*^9}, {3.6499576896847973`*^9, 
   3.649957693060836*^9}, 3.649957725176662*^9, 3.649957930901078*^9, {
   3.707825753607398*^9, 3.707825773703351*^9}, {3.707905274054201*^9, 
   3.707905279542807*^9}},
 CellLabel->
