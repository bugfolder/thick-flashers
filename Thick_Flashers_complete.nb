Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Sigma]", ",", "bb", ",", "dd", ",", "ui", ",", "bi", ",", "ti", ",", 
      "di", ",", "\[Kappa]n", ",", "b", ",", "d", ",", "u0", ",", "u1", ",", 
      "v0", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "a", " ", "flattened", " ", "cylinder", " ", "in", " ", "3", "D"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{"Unplanarize", "[", 
       RowBox[{"Function", "[", 
        RowBox[{"u", ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "0"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"Unplanarize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], "&"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "initial", " ", "conditions", " ", "for", " ", "the", " ", "curled", " ",
        "cylinder"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "bi", ",", "di", ",", "ti"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"interpolation", " ", "range"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "desired", " ", "normal", " ", "curvature", " ", "with", " ", "radius", 
       " ", "1"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]n", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], "=", 
      RowBox[{"NReshapeGeneric3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}], ",", "\[Kappa]n", 
        ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bi", ",", "di", ",", "ti"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"plot", " ", "range"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"4", ",", "2.5", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"bb", ",", "dd", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"StyledCurve", "[", 
               RowBox[{"bb", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
