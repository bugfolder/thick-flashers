Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledPatch", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PatchDivisions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"50", ",", "50"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FillStyle", "\[Rule]", "Paper3DFill"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"OutlineStyle", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"SurfaceOrientation", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
