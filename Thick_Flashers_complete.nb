Cell["\<\
These are older functions that have been deprecated. You should use \
MakeQuadMesh instead.\
\>", "Text",
 CellChangeTimes->{{3.642607852092132*^9, 3.642607871726519*^9}, {
  3.693415050390031*^9, 3.693415058371752*^9}, {3.6934154682871118`*^9, 
  3.69341547071909*^9}, {3.693416415366561*^9, 
  3.69341643234261*^9}},ExpressionUUID->"3db22b1d-313f-468e-8a66-\
0e8097a4e6a4"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeRectangularQuadMesh",
 "[",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vfn, opts",
  FontSlant->"Italic"],
 "]\n\t(options) HorizontalEdgeTypeFn, VerticalEdgeTypeFn, BorderOverride"
}], "Subsubsection",
 CellChangeTimes->{
  3.5940575348482733`*^9, {3.594057742206872*^9, 3.594057745436277*^9}, {
   3.594059028251216*^9, 3.594059032449527*^9}, 3.594060037155455*^9, {
   3.594069541051014*^9, 3.594069543135684*^9}, 3.594069749281166*^9, 
   3.594070397922306*^9, {3.59407112802334*^9, 3.594071141196706*^9}, {
   3.595000209294532*^9, 3.595000233053433*^9}, 3.595286114990668*^9, 
   3.617444138681975*^9},ExpressionUUID->"49ade07a-a551-4935-a803-\
1896a8675050"],

Cell[TextData[{
 "MakeRectangularQuadMesh[",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vfn, opts",
  FontSlant->"Italic"],
 "] creates a TGraphAssigned+TCornerIndices that represents a quad mesh, \
where\n\t",
 StyleBox["nh",
  FontSlant->"Italic"],
 " is the number of facets in the horizontal direction\n\t",
 StyleBox["nv",
  FontSlant->"Italic"],
 " is the number of facets in the vertical direction.\n\t",
 StyleBox["vfn",
  FontSlant->"Italic"],
 " is a function that returns the coordinates of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}th vertex as the value of ",
 StyleBox["vfn[i,j]",
  FontSlant->"Italic"],
 " with ",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[Element][0, ",
 StyleBox["nh",
  FontSlant->"Italic"],
 "] and ",
 StyleBox["j",
  FontSlant->"Italic"],
 "\[Element][0, ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "]. Typically {",
 StyleBox["i",
  FontSlant->"Italic"],
 "=0, ",
 StyleBox["j",
  FontSlant->"Italic"],
 "=0} will be in the lower left corner of the pattern.\nThis function returns \
a TGraphAssigned+TCornerIndices of Vertices, Edges, and EdgeTypes (but no \
Faces). Options are:\n\tHorizontalEdgeTypeFn \[Rule] ",
 StyleBox["hetfn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["hetfn[i,j]",
  FontSlant->"Italic"],
 " returns the type of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}th horizontal edge. Default is unassigned (U).\n\tVerticalEdgeTypeFn \
\[Rule] ",
 StyleBox["vetfn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["vetfn[i,j]",
  FontSlant->"Italic"],
 " returns the type of the {i,j}th vertical edge. Default is unassigned (U).\n\
\tBorderOverride \[Rule] True | False, where True overrides ",
 StyleBox["hetfn",
  FontSlant->"Italic"],
 " and ",
 StyleBox["vetfn",
  FontSlant->"Italic"],
 " and makes all border lines of type B."
}], "Text",
 CellChangeTimes->{{3.594057330456885*^9, 3.594057530001993*^9}, {
   3.5940577493961577`*^9, 3.594057837246922*^9}, {3.594058669922537*^9, 
   3.594058702031582*^9}, {3.594058863590161*^9, 3.594058875059916*^9}, 
   3.594059039588849*^9, {3.594059172426364*^9, 3.594059189175597*^9}, 
   3.594060037310161*^9, {3.594060125396596*^9, 3.594060126803766*^9}, 
   3.594060262067026*^9, {3.594069548519369*^9, 3.594069613531061*^9}, 
   3.5940697493389072`*^9, {3.594070403737878*^9, 3.594070498515996*^9}, {
   3.594070539187318*^9, 3.594070551775152*^9}, 3.59473451738591*^9, {
   3.594985000219185*^9, 3.594985000524775*^9}, {3.594996850114584*^9, 
   3.594996854789044*^9}, {3.595000209396063*^9, 3.595000233168411*^9}, 
   3.595286115055192*^9, {3.617444047556446*^9, 3.617444071468205*^9}, 
   3.6174441387577767`*^9, {3.61744422638087*^9, 3.617444286750292*^9}, {
   3.6424328424323683`*^9, 3.642432936820815*^9}, {3.642630573557827*^9, 
   3.642630598717555*^9}, {3.643238627590968*^9, 3.643238633526675*^9}, {
   3.643291028482912*^9, 3.6432910777922697`*^9}, {3.643291142565658*^9, 
   3.64329122124889*^9}},ExpressionUUID->"2e02757a-baa8-41ff-89f7-\
11045b053d6c"],

Cell[TextData[{
 "Note that if you are folding a shape in 3D using FoldGraph3D, you will need \
to compute a ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " array whose ordering matches that of Edges and EdgeTypes. It may be \
helpful to do this by using the same Do loops as in MakeRectangularQuadMesh \
with indices {",
 StyleBox["i",
  FontSlant->"Italic"],
 ",",
 StyleBox["j",
  FontSlant->"Italic"],
 "} and then sequentially appending the computed values to the ",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " list."
}], "Text",
 CellChangeTimes->{{3.642632447054883*^9, 
  3.642632575818008*^9}},ExpressionUUID->"b7e284e2-ce8e-489a-a579-\
f4c8ac552515"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HorizontalEdgeTypeFn", "::", "usage"}], 
   "=", "\"\<HorizontalEdgeTypeFn is a option to MakeRectangularQuadMesh that \
returns the type to be assigned to the {i,j}\[Theta] horizontal edge.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594070558714256*^9, 3.594070596229224*^9}, 
   3.5949850005733232`*^9, {3.595000209446702*^9, 3.595000209665313*^9}, 
   3.595286115082981*^9, 3.617444138787571*^9},
 CellLabel->
  "In[2077]:=",ExpressionUUID->"136573de-58c6-427d-8ba0-a76170e9dcfa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VerticalEdgeTypeFn", "::", "usage"}], 
   "=", "\"\<HorizontalEdgeTypeFn is a option to MakeRectangularQuadMesh that \
returns the type to be assigned to the {i,j}\[Theta] vertical edge.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594070558714256*^9, 3.594070608325261*^9}, 
   3.594985000681862*^9, {3.595000209917008*^9, 3.595000233206265*^9}, 
   3.595286115319106*^9, 3.617444139026917*^9},
 CellLabel->
  "In[2078]:=",ExpressionUUID->"c7c30a49-acb8-4f30-ab24-2e85f2a9a239"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRectangularQuadMesh", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HorizontalEdgeTypeFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"U", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"VerticalEdgeTypeFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"U", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"BorderOverride", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.59405784098194*^9, 3.594057861550724*^9}, {
   3.594058559826043*^9, 3.594058560353491*^9}, 3.5940600373287573`*^9, 
   3.594069749367968*^9, {3.594070511395748*^9, 3.594070531491131*^9}, {
   3.595000210149231*^9, 3.595000233436822*^9}, 3.595286115569757*^9, 
   3.617444139277069*^9},
 CellLabel->
  "In[2079]:=",ExpressionUUID->"1f1bdd82-f2df-4230-9638-afca02753cbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRectangularQuadMesh", "[", 
   RowBox[{
    StyleBox["nh_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["nv_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["vfn_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hetfn", ",", "vetfn", ",", "bo", ",", "verts", ",", "edges", ",", 
      "types", ",", "vifn"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hetfn", "=", 
      RowBox[{
       RowBox[{"HorizontalEdgeTypeFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectangularQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vetfn", "=", 
      RowBox[{
       RowBox[{"VerticalEdgeTypeFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectangularQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bo", "=", 
      RowBox[{
       RowBox[{"BorderOverride", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectangularQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"edges", "=", 
       RowBox[{"types", "=", 
        RowBox[{"{", "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"verts", ",", 
          RowBox[{"vfn", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ";", 
        RowBox[{
         RowBox[{"vifn", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "=", 
         RowBox[{"Length", "[", "verts", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nv"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"horizontal", " ", "edges"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"vifn", "[", 
             RowBox[{"i", ",", "j"}], "]"}], ",", 
            RowBox[{"vifn", "[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "j"}], "]"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"bo", "&&", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"j", "\[Equal]", "0"}], "||", 
               RowBox[{"j", "\[Equal]", "nv"}]}], ")"}]}], ",", "B", ",", 
            RowBox[{"hetfn", "[", 
             RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nv"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"nh", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"vertical", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"vifn", "[", 
             RowBox[{"i", ",", "j"}], "]"}], ",", 
            RowBox[{"vifn", "[", 
             RowBox[{"i", ",", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"j", "+", "1"}], ",", "nv", ",", "1"}], "]"}]}], 
             "]"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"bo", "&&", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"i", "\[Equal]", "0"}], "||", 
               RowBox[{"i", "\[Equal]", "nh"}]}], ")"}]}], ",", "B", ",", 
            RowBox[{"vetfn", "[", 
             RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", 
         RowBox[{"nv", "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MakeTGraphAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", 
        RowBox[{"{", "}"}], ",", "types"}], "]"}], "//", 
      RowBox[{"AddTCornerIndices", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"nh", "+", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nh", "+", "1"}], ")"}], "nv"}], "+", "1"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nh", "+", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"nv", "+", "1"}], ")"}]}]}], "}"}]}], "}"}], "]"}]}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.594057570959494*^9, 3.59405763957716*^9}, {
   3.5940578645850153`*^9, 3.594057897900075*^9}, {3.594058030357136*^9, 
   3.59405813645634*^9}, {3.594058168402792*^9, 3.594058198622306*^9}, {
   3.594058249806251*^9, 3.594058253933957*^9}, {3.594058503604554*^9, 
   3.594058510932124*^9}, {3.594058569639977*^9, 3.594058572462834*^9}, {
   3.594058807065598*^9, 3.594058848702935*^9}, {3.594059208423353*^9, 
   3.594059214477545*^9}, {3.59406003736835*^9, 3.594060037402227*^9}, {
   3.594069188166717*^9, 3.594069416159663*^9}, {3.594069458143087*^9, 
   3.594069458572603*^9}, {3.594069494427846*^9, 3.594069518344779*^9}, {
   3.594069749613182*^9, 3.594069749862395*^9}, {3.594070618002618*^9, 
   3.594070640467496*^9}, {3.594070998449938*^9, 3.594071014672524*^9}, 
   3.594734558416119*^9, {3.595000210386815*^9, 3.595000233672861*^9}, {
   3.5952861158247023`*^9, 3.595286116541821*^9}, {3.617444139531149*^9, 
   3.617444140248548*^9}, {3.642630442497879*^9, 3.642630456340852*^9}, {
   3.6426305736674232`*^9, 3.642630649996305*^9}, {3.643238642360104*^9, 
   3.643238663510659*^9}, 3.643238707831291*^9},
 CellLabel->
  "In[2080]:=",ExpressionUUID->"3eadd218-1049-4f98-8a2e-71cfb45fa2cd"],

Cell["\<\
Example. A simple square grid. This illustrates the numbering scheme for \
vertices (across the bottom, then upward by row).\
\>", "Text",
 CellChangeTimes->{{3.594070703996522*^9, 3.594070708963851*^9}, {
  3.642432517925735*^9, 
  3.6424325424078097`*^9}},ExpressionUUID->"50d410dd-e2d1-42b4-9da0-\
f1b5b011df84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nw", ",", "nh", ",", "vfn", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nw", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nh", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRectangularQuadMesh", "[", 
       RowBox[{"nw", ",", "nh", ",", "vfn"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CornerIndices = \>\"", ",", 
       RowBox[{"tobj", "[", "CornerIndices", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594057643412326*^9, 3.5940577370554457`*^9}, {
   3.5940579825602827`*^9, 3.594057989712686*^9}, {3.59405826556793*^9, 
   3.59405844221087*^9}, {3.594058525206237*^9, 3.594058527919942*^9}, {
   3.59405871575379*^9, 3.594058752216541*^9}, {3.594058900101481*^9, 
   3.594058922692294*^9}, {3.594058982187069*^9, 3.594059011272228*^9}, {
   3.594059196995329*^9, 3.5940592280087233`*^9}, 3.594060037453629*^9, 
   3.594069750100237*^9, {3.5940706748526587`*^9, 3.594070688243482*^9}, {
   3.59407071962505*^9, 3.594070745612624*^9}, 3.59473425733654*^9, 
   3.594734827619817*^9, 3.595200527216234*^9, 3.595286116779802*^9, 
   3.61744414048659*^9, {3.642432564010691*^9, 3.642432566982622*^9}, {
   3.642432649879652*^9, 3.642432651335468*^9}, {3.64323873599263*^9, 
   3.643238756344458*^9}},
 CellLabel->
  "In[2081]:=",ExpressionUUID->"006b25bf-1368-423c-9676-bfaba2668756"],

Cell["\<\
Example: a vertical Miura-ori, vertically major, with border override.\
\>", "Text",
 CellChangeTimes->{{3.5940575978062353`*^9, 3.5940575985016336`*^9}, {
  3.594058948417242*^9, 3.594058958710631*^9}, {3.594070749992847*^9, 
  3.594070753752893*^9}},ExpressionUUID->"2e37032a-eb03-47e8-ae56-\
9683673fa544"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nw", ",", "nh", ",", "vfn", ",", "hetfn", ",", "vetfn", ",", "tobj"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nw", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nh", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2.", " ", "i"}], "+", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", "j", "]"}], ",", 
           RowBox[{"-", "0.3"}], ",", "0"}], "]"}]}], ",", " ", 
        RowBox[{"3.", " ", "j"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", 
         RowBox[{"i", "+", "j"}], "]"}], ",", "M", ",", "V"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "i", "]"}], ",", "V", ",", "M"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRectangularQuadMesh", "[", 
       RowBox[{"nw", ",", "nh", ",", "vfn", ",", 
        RowBox[{"HorizontalEdgeTypeFn", "\[Rule]", "hetfn"}], ",", 
        RowBox[{"VerticalEdgeTypeFn", "\[Rule]", "vetfn"}], ",", 
        RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CornerIndices = \>\"", ",", 
       RowBox[{"tobj", "[", "CornerIndices", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594057643412326*^9, 3.5940577370554457`*^9}, {
