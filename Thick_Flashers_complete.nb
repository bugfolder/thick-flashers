   3.801654973937304*^9},ExpressionUUID->"ebb341bb-ccf2-4843-8512-\
f13700347c3a"],

Cell[TextData[{
 "NFoldAcrossRight2D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", \[Gamma], {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 2D fold, the left ruling vector, and fold angle, and constructs \
the full 2D ruled neighborhood by adding the right ruling vector."
}], "Text",
 CellChangeTimes->{{3.799443094830909*^9, 3.799443137697144*^9}, {
   3.799497627768349*^9, 3.799497628201466*^9}, 3.799697145086274*^9, {
   3.799697279811439*^9, 3.7996973393718967`*^9}, {3.799704446379794*^9, 
   3.799704471460856*^9}, 3.799704504715414*^9, 3.799705337270319*^9, {
   3.799706557011366*^9, 3.799706562222432*^9}, 3.799706920424056*^9, 
   3.801654973960494*^9},ExpressionUUID->"39724a47-eb3f-4f81-9e87-\
f26d45832ce3"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the 2D curve of the fold, as a vector-valued function.\n\t",
 StyleBox["rL",
  FontSlant->"Italic"],
 " \[LongDash] the left ruling vector in 2D as a vector-valued function.\n\t\
\[Gamma] \[LongDash] the fold angle function.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.7994432330333567`*^9, 3.799443249729931*^9}, {
