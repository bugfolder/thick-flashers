Cell[CellGroupData[{

Cell["Crease-assigned graphs", "Section",
 CellChangeTimes->{{3.592660573973252*^9, 
  3.592660577538451*^9}},ExpressionUUID->"f2310db1-e675-4d13-93e5-\
e50891b29b9a"],

Cell[CellGroupData[{

Cell["Class TAssigned", "Subsection",
 CellChangeTimes->{{3.457626126793686*^9, 3.457626137951227*^9}, 
   3.457748300260912*^9, {3.484780428903769*^9, 3.4847804299036427`*^9}, {
   3.533679695254013*^9, 3.5336796989817047`*^9}, {3.533680490818307*^9, 
   3.533680495088798*^9}, {3.533682700408101*^9, 3.533682700719997*^9}, {
   3.592421741611268*^9, 3.592421746856297*^9}, 3.592471907894451*^9, {
   3.592489932641145*^9, 3.592489934696615*^9}, {3.592490033361484*^9, 
   3.592490037377114*^9}, {3.592644843741893*^9, 3.5926448578114038`*^9}, {
   3.592660550278584*^9, 3.592660551315735*^9}, 3.5928288618952723`*^9, {
   3.594685354939475*^9, 
   3.594685355875361*^9}},ExpressionUUID->"c6f44c12-31bb-46ae-8c87-\
2a6d8780b3ec"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457626158317848*^9, 
  3.457626158821782*^9}},ExpressionUUID->"74e9ccb1-f267-4008-b886-\
e1231824502c"],

Cell["\<\
We can treat a crease pattern as a plane graph, in which case we need a way \
of specifying the crease assignment. We introduce the letters {M, V, U} to \
denote a mountain, valley, or unfolded crease, and B to denote a border line. \
Note that U can also do double-duty to denote \
\[OpenCurlyDoubleQuote]unspecified\[CloseCurlyDoubleQuote]. It should be used \
as a default value when the true assignment isn\[CloseCurlyQuote]t known.\
\>", "Text",
 CellChangeTimes->{{3.457626168021202*^9, 3.4576262257933073`*^9}, {
   3.45763429760319*^9, 3.457634337264288*^9}, {3.484780438951619*^9, 
   3.484780439535494*^9}, {3.533682579320916*^9, 3.53368260074244*^9}, {
   3.533682644267407*^9, 3.5336826907132792`*^9}, {3.591801960364895*^9, 
   3.591802042623064*^9}, {3.592421801173379*^9, 3.592421804652664*^9}, 
   3.592435861016115*^9, 3.592486786724564*^9, {3.594726346762225*^9, 
   3.594726404942833*^9}},ExpressionUUID->"cecc6b0e-c594-49e9-9c53-\
d7eb1739d879"],

Cell["\<\
Note that M, V, U, B are symbols that apply to a plane graph, while \
MountainLine, ValleyLine, UnfoldedLine are symbolic styles that only show up \
inside of Style objects within a Graphics or Graphics3D expression.\
\>", "Text",
 CellChangeTimes->{{3.4576262411323857`*^9, 3.457626290369049*^9}, {
   3.457634348572035*^9, 3.457634383697837*^9}, {3.457634929146585*^9, 
   3.457634930993872*^9}, {3.484780448078706*^9, 3.484780458358362*^9}, {
   3.591802050422505*^9, 3.591802052086071*^9}, {3.5924218209394407`*^9, 
   3.592421833034218*^9}, 
   3.628948773150107*^9},ExpressionUUID->"002d9a86-b997-453f-8321-\
5f7008148d68"],

Cell[TextData[{
 "A crease pattern is described by a TGraph with the additional property \
EdgeTypes, where EdgeTypes is a list of crease types (M=mountain, V=valley, \
U=undefined or, equivalently, unfolded; B=border line). The EdgeTypes are \
said to be the ",
 StyleBox["assignment",
  FontSlant->"Italic"],
 " of the crease pattern."
}], "Text",
 CellChangeTimes->{
  3.5924867984459968`*^9, {3.594725997337157*^9, 
   3.59472601773618*^9}},ExpressionUUID->"3f5ebcf8-6b12-4be0-b848-\
466c3fd51a54"],

Cell["\<\
We can use different combinations of classes to represent origami objects:
TGraph+TAssigned for a crease-assigned crease pattern;
TGraph+TGraph2D+TAssigned for a crease-assigned crease pattern and its 2D \
(flat) folded form;
TGraph+TGraph3D+TAssigned for a crease-assigned crease pattern and its 3D \
folded form.\
\>", "Text",
 CellChangeTimes->{{3.594726071724272*^9, 
  3.594726164189803*^9}},ExpressionUUID->"8cd80f59-ccb3-4a29-850d-\
f793d2fdf3a8"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TObj class: TAssigned
\tMixin with: TGraph or any subclass\
\>", "Subsubsection",
 CellChangeTimes->{{3.5924679148960323`*^9, 3.592467936783182*^9}, 
   3.592486866349741*^9, {3.592486897902196*^9, 3.592486898475609*^9}, 
   3.5928288619847307`*^9},ExpressionUUID->"3371ca96-e2ce-401e-9ea5-\
6e2e09d6b8f7"],

Cell["\<\
TAssigned is a TObj that represents a graph with a crease assignment on its \
edges.\
\>", "Text",
 CellChangeTimes->{{3.592421860184583*^9, 3.592421900990152*^9}, 
   3.592435749830248*^9, 3.592435861196151*^9, {3.592486829314992*^9, 
   3.592486903062065*^9}, {3.592487192017849*^9, 3.592487199304877*^9}, 
   3.5928288620759706`*^9},ExpressionUUID->"d615b386-725f-459b-95f4-\
7e48d230c7b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TAssigned", "::", "usage"}], 
   "=", "\"\<TAssigned is a TObj class that represents a graph with a crease \
assignment on its edges.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5924871564537363`*^9, 3.59248718678743*^9}, {
  3.592828862160602*^9, 3.592828862223587*^9}},
 CellLabel->
  "In[1790]:=",ExpressionUUID->"88c1be66-b1a6-416d-828b-6869ceaf6564"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegisterTClass", "[", "TAssigned", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.5925190851323442`*^9, 3.59251908921311*^9}, {
   3.592519273305931*^9, 3.592519280007385*^9}, {3.592519455165958*^9, 
   3.592519456909395*^9}, 3.592641791318708*^9, 3.592828862327673*^9},
 CellLabel->
  "In[1791]:=",ExpressionUUID->"20068935-1f71-49c7-bd2a-ae24c268be8f"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TAssigned properties:
\tEdgeTypes: M, V, U, B\
\>", "Subsubsection",
 CellChangeTimes->{{3.592075597546689*^9, 3.592075605816036*^9}, 
   3.5920762598362713`*^9, 3.5922610332710543`*^9, 3.592435749460292*^9, 
   3.592660588748197*^9, 3.592828862415704*^9, {3.592854278230301*^9, 
   3.592854281557948*^9}, 3.595009437044928*^9, 
   3.595013532542611*^9},ExpressionUUID->"31ce2127-2650-4f00-8963-\
16f2c0060d09"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"EdgeTypes", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["t", "1"], ",", " ", 
      SubscriptBox["t", "2"], ",", " ", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"f266e525-701d-49fc-aeda-13c3984043ab"],
 " is a TObj property that specifies a list of origami line types that \
correspond to the edges of a TGraph or subclass."
}], "Text",
 CellChangeTimes->{{3.591801832260812*^9, 3.591801888448909*^9}, 
   3.592075630902672*^9, {3.592435749561477*^9, 3.592435749648769*^9}, {
   3.592486925075485*^9, 
   3.592486931418895*^9}},ExpressionUUID->"3ba15265-d286-4c47-bece-\
942eb4a63814"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EdgeTypes", "::", "usage"}], 
   "=", "\"\<EdgeTypes is a TObj property that specifies a list of origami \
types that apply to the edges of a plane graph.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5918017747007847`*^9, 3.591801807793724*^9}, 
   3.592070788830671*^9, 3.5924357497340317`*^9},
 CellLabel->
  "In[1792]:=",ExpressionUUID->"93f185e2-db9e-4da3-b857-48b3cfdf2858"],

Cell["EdgeTypes can be any of M, V, U, or B.", "Text",
 CellChangeTimes->{{3.59180158922948*^9, 3.591801606059123*^9}, {
   3.591801816910858*^9, 3.5918018278685713`*^9}, {3.591801911775553*^9, 
   3.591801944997083*^9}, {3.707942700219434*^9, 3.70794270283399*^9}, 
   3.707942829027803*^9},ExpressionUUID->"e7ab6eed-a509-494f-82ac-\
73963d16be03"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"V", "::", "usage"}], 
   "=", "\"\<V is a symbolic type label for an edge of a plane graph to \
indicate that it is a valley fold.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.707942707813332*^9, 3.707942739995396*^9}},
 CellLabel->
  "In[1793]:=",ExpressionUUID->"4d28d94b-8e2c-488f-b057-4a97be0f5664"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"M", "::", "usage"}], 
   "=", "\"\<M is a symbolic type label for an edge of a plane graph to \
indicate that it is a mountain fold.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.707942707813332*^9, 3.707942726513904*^9}},
 CellLabel->
  "In[1794]:=",ExpressionUUID->"0d2620ca-ef49-44a6-ae5b-e1c364588a68"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"U", "::", "usage"}], 
   "=", "\"\<U is a symbolic type label for an edge of a plane graph to \
indicate that it is an unfolded fold. (It is also a 2D unit vector function.)\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.707942707813332*^9, 3.707942726513904*^9}, {
  3.707942781476482*^9, 3.707942819211692*^9}},
 CellLabel->
  "In[1795]:=",ExpressionUUID->"06bdd4e4-414b-4bb1-8914-84f5d7eb120b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"B", "::", "usage"}], 
   "=", "\"\<B is a symbolic type label for an edge of a plane graph to \
indicate that it is a border edge.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591801608055388*^9, 3.5918016326193027`*^9}},
 CellLabel->
  "In[1796]:=",ExpressionUUID->"83252e68-337b-4218-b3ca-5248eac23067"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "AddTAssignedTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\nAddTAssigned[",
 StyleBox["types",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.592487129205171*^9, 3.5924871418445807`*^9}, {
   3.592660592812047*^9, 3.592660600826001*^9}, {3.592660642912607*^9, 
   3.592660665005446*^9}, {3.592828862511888*^9, 3.592828862715623*^9}, 
   3.5950094410670013`*^9},ExpressionUUID->"1f692f54-274b-4f19-bc13-\
285fedf7aa2f"],

Cell[TextData[{
 "AddTAssignedTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] takes a TObj of type TGraph (or any subclass) and gives it the ",
 "TAssigned",
 " class using the assignment ",
 StyleBox["types",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.592487059458061*^9, 3.59248712367784*^9}, {
   3.5924872169291687`*^9, 3.592487217552133*^9}, {3.592487345679679*^9, 
   3.592487370757642*^9}, 3.592660642967874*^9, {3.592828862817247*^9, 
   3.592828862915722*^9}},ExpressionUUID->"a283d829-1c77-4d7a-8a4b-\
16a91bab34e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddTAssignedTo", "::", "badtypes"}], 
   "=", "\"\<Length `1` of EdgeTypes `2` does not match length `3` of Edges \
`4`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.706962169711194*^9, 3.706962221790944*^9}, {
  3.706962292152609*^9, 3.70696229381487*^9}},
 CellLabel->
  "In[1797]:=",ExpressionUUID->"012af50d-54e7-4398-9234-16b9fe9b6a45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTAssignedTo", "[", 
   RowBox[{"tobj_TObj", ",", "types_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"edges", ",", "ne", ",", "nt"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "AddTAssignedTo"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ne", "=", 
      RowBox[{"Length", "[", "edges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nt", "=", 
      RowBox[{"Length", "[", "types", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ne", "\[NotEqual]", "nt"}], "&&", 
        RowBox[{"nt", "\[NotEqual]", "0"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"AddTAssignedTo", "::", "badtypes"}], ",", "nt", ",", 
          "types", ",", "ne", ",", "edges"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AddClassTo", "[", 
      RowBox[{"tobj", ",", "TAssigned", ",", 
       RowBox[{"{", 
        RowBox[{"EdgeTypes", "\[Rule]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ListEmptyQ", "[", "types", "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{"U", ",", 
             RowBox[{"{", 
              RowBox[{"Length", "[", 
               RowBox[{"tobj", "[", "Edges", "]"}], "]"}], "}"}]}], "]"}], ",",
            "types"}], "]"}]}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5924869772150383`*^9, 3.59248705554143*^9}, {
   3.5924873270427513`*^9, 3.592487333651678*^9}, {3.592487366330113*^9, 
