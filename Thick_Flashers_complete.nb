Cell[CellGroupData[{

Cell[TextData[{
 "MakeMoselyPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MinimumAngle, CreasePatternBoundary, CircleDivisions, \
FoldedFormGapSize, Options[Graphics], Options[Graphics3D]\n\t(option values) \
Default, Circle, Closed"
}], "Subsubsection",
 CellChangeTimes->{{3.456360555899096*^9, 3.456360578210458*^9}, {
   3.456362306961009*^9, 3.456362307519025*^9}, {3.456511256905506*^9, 
   3.456511294786961*^9}, {3.526762557961286*^9, 3.526762559313137*^9}, 
   3.592127767820526*^9, {3.593088734185228*^9, 
   3.59308873494473*^9}},ExpressionUUID->"e62df562-289a-4725-8c02-\
1b7bae6dab06"],

Cell[TextData[{
 "MakeMoselyPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of 2D points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " and a rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and creates a crease pattern and folded form of a rotational pot using \
Jeannine Mosely's solid-flange construction. It returns a ",
 "TObj",
 ". Options are:\n\tMinimumAngle\[Rule]",
 StyleBox["mb",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["mb",
  FontSlant->"Italic"],
 " is the minimum bend angle at which we add a horizontal crease along the \
side.\n\tCreasePatternBoundary\[Rule]Default | Circle | Closed, specifying \
whether to use the regular polygonal cut line, a circular cut line or add a \
triangular tab that closes the flange.\n\tCircleDivisions\[Rule]",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the numbe of divisions to use within a single wedge of the pattern."
}], "Text",
 CellChangeTimes->{{3.456356366824768*^9, 3.456356480780696*^9}, {
   3.456357875049625*^9, 3.456357882948633*^9}, {3.456358004628619*^9, 
   3.456358052075944*^9}, 3.4563605796995564`*^9, {3.4563623134869537`*^9, 
   3.456362327293576*^9}, {3.456397223211234*^9, 3.456397236205503*^9}, {
   3.4564003055877643`*^9, 3.456400340079489*^9}, {3.526730724180833*^9, 
   3.526730726364172*^9}, {3.592128182126314*^9, 3.592128184395167*^9}, 
   3.5921705902744617`*^9, 
   3.592435765968667*^9},ExpressionUUID->"f8a088ae-64c2-4384-b075-\
9923d93a18df"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeMoselyPot", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MinimumAngle", "\[Rule]", 
      RowBox[{"10.", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"CreasePatternBoundary", "\[Rule]", "Default"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"CircleDivisions", "\[Rule]", "10"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FoldedFormGapSize", "\[Rule]", "0.05"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456356554910956*^9, 3.456356573084632*^9}, {
   3.45635731355683*^9, 3.456357357633705*^9}, {3.4563578217357187`*^9, 
   3.456357823509667*^9}, {3.45635799031857*^9, 3.456358001126463*^9}, 
   3.456362364440445*^9, {3.456397207804387*^9, 3.45639721839271*^9}, 
   3.4563999008940287`*^9, {3.526823313405148*^9, 3.5268233141490383`*^9}, 
   3.592127767918556*^9},
 CellLabel->
  "In[3542]:=",ExpressionUUID->"ab50fb2f-3f4e-471c-9d60-936f7f5a8e68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeMoselyPot", "[", 
   RowBox[{"pts_", ",", "m_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mb", ",", "cb", ",", "cd", ",", "gs", ",", "\[Phi]", ",", "sf", ",", 
      "cf", ",", "tf", ",", "sh", ",", "ps", ",", "fb", ",", "cs", ",", "xt", 
