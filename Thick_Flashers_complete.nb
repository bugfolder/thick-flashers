  "],ExpressionUUID->"338c7953-b64c-441e-b329-e7d23cbcdc36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeMinorConnectedUnitChain", "[", 
   RowBox[{"sectorangles_List", ",", " ", "type_", ",", "n_", ",", " ", 
    RowBox[{"{", 
     RowBox[{"wr_", ",", "wl_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"MakeTLinearChain", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{"sectorangles", ",", 
      RowBox[{"{", 
       RowBox[{"n", "+", "1"}], "}"}]}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{"1", ",", 
      RowBox[{"{", "n", "}"}]}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"i", ",", "2"}], "]"}], "\[Equal]", "1"}], ",", "type", ",", 
        RowBox[{"InvertFoldType", "[", "type", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"wr", ",", "wl"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.617404737314915*^9, 3.617404749631256*^9}, {
  3.617404823454975*^9, 3.617404876957756*^9}, {3.6174331961663446`*^9, 
