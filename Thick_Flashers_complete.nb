            RowBox[{"Style", "[", 
             RowBox[{"isgc", ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
          RowBox[{"Axes", "->", "True"}]}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
