Cell[TextData[{
 "TwistFoldedFormLabeledLines",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] adds vertex and edge labels to the folded form lines."
}], "Text",
 CellChangeTimes->{{3.4577413331913643`*^9, 3.457741364237286*^9}, 
