299ff8d0ad91"],

Cell[TextData[{
 "CurvedFoldHelix3D[",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Theta]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 "] produces analytic functions that describe a fold along a helix with a \
given radius and helicity angle and a specified fold angle function with fold \
orientation \[FinalSigma] = +1."
}], "Text",
 CellChangeTimes->{{3.799744730965797*^9, 3.799744763128796*^9}, {
   3.799749647177718*^9, 3.799749659535693*^9}, {3.799750818618812*^9, 
   3.799750822503708*^9}, 3.799750900355201*^9, 3.799751923470971*^9, {
   3.799775202379889*^9, 3.799775219847876*^9}, {3.799775642958688*^9, 
   3.799775643766795*^9}, 3.799776255682177*^9, {3.799776294068275*^9, 
   3.7997763084836693`*^9}, {3.799942473847578*^9, 
   3.799942488040024*^9}},ExpressionUUID->"37295655-1d4b-4ed9-9552-\
4c1c577a407c"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of the curve.\n\t",
 StyleBox["\[Theta]",
  FontSlant->"Italic"],
 " \[LongDash] the helicity angle.\n\t\[Gamma] \[LongDash] the fold angle \
function, must be positive."
}], "Text",
 CellChangeTimes->{{3.799748099776724*^9, 3.799748125937078*^9}, {
   3.79975079647245*^9, 3.799750799523525*^9}, 3.799750902998814*^9, {
   3.799775226951771*^9, 3.799775232334509*^9}, {3.799942465318523*^9, 
   3.799942468390864*^9}},ExpressionUUID->"e76fbd08-a860-4fa2-90d7-\
bd45263c8abc"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrR",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 "} of the ruled neighborhood and its fold angle."
}], "Text",
 CellChangeTimes->{{3.799744788080272*^9, 3.799744829476794*^9}, {
  3.799775248867564*^9, 3.799775249539476*^9}, {3.799775653039049*^9, 
  3.79977566425529*^9}},ExpressionUUID->"d0b735c7-2db4-4d01-a6a4-\
369f03fc261c"],

Cell["\<\
Note that \[Gamma] can be a Function of InterpolatingFunctions, which is not \
so useful if you want an analytic expression, but allows this to be used in \
NCurvedFoldHelix3D with numerical function inputs.\
\>", "Text",
 CellChangeTimes->{{3.7997758019904222`*^9, 3.799775888056695*^9}, 
   3.799776266122398*^9},ExpressionUUID->"907c13ca-8a2e-401e-a448-\
99590d249372"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CurvedFoldHelix3D", "[", 
   RowBox[{"r_", ",", "\[Theta]_", ",", 
    RowBox[{"\[Gamma]_Function", "|", "\[Gamma]_InterpolatingFunction"}]}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"r", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{"Tan", "[", "\[Theta]", "]"}], "#"}]}], "}"}]}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "#1", "]"}], ",", 
           RowBox[{"Sin", "[", "#1", "]"}], ",", 
           RowBox[{
            RowBox[{"Tan", "[", "\[Theta]", "]"}], " ", "#1"}]}], "}"}]}], 
        "&"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
             RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], ")"}], " ", 
                
                RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
                RowBox[{"Sin", "[", "#1", "]"}]}], "+", 
               RowBox[{
                RowBox[{"Cos", "[", "#1", "]"}], " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "+", 
               RowBox[{
                RowBox[{"Sin", "[", "#1", "]"}], " ", 
                RowBox[{
                 SuperscriptBox["\[Gamma]", "\[Prime]",
                  MultilineFunction->None], "[", "#1", "]"}]}]}], ")"}]}], 
            SqrtBox[
             RowBox[{"3", "-", 
              RowBox[{"Cos", "[", 
               RowBox[{"2", " ", "\[Theta]"}], "]"}], "-", 
              RowBox[{"2", " ", 
               SuperscriptBox[
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "+", 
              RowBox[{"4", " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{
                SuperscriptBox["\[Gamma]", "\[Prime]",
                 MultilineFunction->None], "[", "#1", "]"}]}], "+", 
              SuperscriptBox[
               RowBox[{
                SuperscriptBox["\[Gamma]", "\[Prime]",
                 MultilineFunction->None], "[", "#1", "]"}], "2"]}]]]}], ",", 
          
          FractionBox[
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], ")"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Sin", "[", "#1", "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{
                SuperscriptBox["\[Gamma]", "\[Prime]",
                 MultilineFunction->None], "[", "#1", "]"}]}]}], ")"}]}], 
           SqrtBox[
            RowBox[{"3", "-", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", " ", "\[Theta]"}], "]"}], "-", 
             RowBox[{"2", " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "+", 
             RowBox[{"4", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}]}], "+", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}], "2"]}]]], ",", 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], ")"}]}], "+", 
            RowBox[{"2", " ", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", 
            RowBox[{
             RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
             RowBox[{
              SuperscriptBox["\[Gamma]", "\[Prime]",
               MultilineFunction->None], "[", "#1", "]"}]}]}], 
           SqrtBox[
            RowBox[{"3", "-", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", " ", "\[Theta]"}], "]"}], "-", 
             RowBox[{"2", " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "+", 
             RowBox[{"4", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}]}], "+", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}], "2"]}]]]}], "}"}],
         "&"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], ")"}]}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Sin", "[", "#1", "]"}]}], "+", 
              RowBox[{
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"Sin", "[", "#1", "]"}], " ", 
               RowBox[{
                SuperscriptBox["\[Gamma]", "\[Prime]",
                 MultilineFunction->None], "[", "#1", "]"}]}]}], ")"}]}], 
           SqrtBox[
            RowBox[{"3", "-", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", " ", "\[Theta]"}], "]"}], "-", 
             RowBox[{"2", " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "-", 
             RowBox[{"4", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}]}], "+", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}], "2"]}]]], ",", 
          FractionBox[
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], ")"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
              RowBox[{
               RowBox[{"Sin", "[", "#1", "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{
                SuperscriptBox["\[Gamma]", "\[Prime]",
                 MultilineFunction->None], "[", "#1", "]"}]}]}], ")"}]}], 
           SqrtBox[
            RowBox[{"3", "-", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", " ", "\[Theta]"}], "]"}], "-", 
             RowBox[{"2", " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "-", 
             RowBox[{"4", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}]}], "+", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["\[Gamma]", "\[Prime]",
                MultilineFunction->None], "[", "#1", "]"}], "2"]}]]], ",", 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], ")"}]}], "+", 
            RowBox[{"2", " ", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "-", 
            RowBox[{
             RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
