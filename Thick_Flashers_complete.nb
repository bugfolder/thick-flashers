Cell[TextData[{
 "{",
 "UnitTriangleOffsetTwistTile",
 ", ",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.62985117450616*^9, 3.6298511830649033`*^9}, 
   3.629898769262853*^9, 
   3.629898804164159*^9},ExpressionUUID->"38dbb876-87a7-4317-b524-\
cbd846ea8c8a"],

Cell[TextData[{
 "{UnitTriangleOffsetTwistTile, ",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} represents an edge-centered simple flat twist in a unit triangle with \
corner angles ",
 StyleBox["angles",
  FontSlant->"Italic"],
 " where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of the pleat where it subtends the edge, d is the pleat \
angle, defined as the rotation angle measured with respect to the edge, and \
",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form ",
 "{M, V...}",
 " that specifies whether the central polygon creases are mountain or \
valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
