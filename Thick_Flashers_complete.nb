Cell["Pictorial example. Red shows the shifted bevel.", "Text",
 CellChangeTimes->{{3.917198771615369*^9, 
  3.917198784031869*^9}},ExpressionUUID->"128774e8-4f50-4396-bcd7-\
2839346d1962"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4", ",", "p5"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", ".3", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"p5", "=", 
     RowBox[{"FlasherPanelCrossQuadBevel", "[", 
      RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4", ",", 
       RowBox[{"30", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Text", "[", 
        RowBox[{"\"\<p1\>\"", ",", "p1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Text", "[", 
        RowBox[{"\"\<p2\>\"", ",", "p2", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Text", "[", 
        RowBox[{"\"\<p3\>\"", ",", "p3", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Text", "[", 
        RowBox[{"\"\<p4\>\"", ",", "p4", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Text", "[", 
        RowBox[{"\"\<p5\>\"", ",", "p5", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Point", "/@", 
          RowBox[{"{", 
           RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4", ",", "p5"}], 
           "}"}]}], ",", 
         RowBox[{"AbsolutePointSize", "[", "3", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p2", ",", "p3"}], "}"}]}], "}"}]}], ",", "Gray"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"p2", ",", "p5", ",", "p3"}], "}"}], "]"}], ",", "Red"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.917197911353738*^9, 3.917198193409183*^9}, 
   3.917198281365149*^9, {3.917198362789464*^9, 3.917198375534512*^9}, 
   3.9171984276811132`*^9, {3.91719854412678*^9, 3.917198614412575*^9}, 
   3.917282063869763*^9},
 CellLabel->
  "In[4514]:=",ExpressionUUID->"b04163e4-4eb6-4860-a708-8e519e905291"]
}, Closed]],

