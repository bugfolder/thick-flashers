Cell[TextData[{
 "MidArrow[",
 StyleBox["start, finish",
  FontSlant->"Italic"],
 "] is the same thing as Arrow but puts the arrowhead in the middle of the \
line."
}], "Text",
 CellChangeTimes->{{3.457614465584907*^9, 3.457614471975998*^9}, {
  3.457614785372107*^9, 
  3.457614786147936*^9}},ExpressionUUID->"027fd141-9c8c-43f1-98bd-\
9e8ff8b86d87"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MidArrow", "[", 
   RowBox[{"start_", ",", "finish_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mid", "=", 
      RowBox[{
       RowBox[{".45", " ", "start"}], " ", "+", " ", 
       RowBox[{".55", " ", "finish"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Arrowheads", "[", "Medium", "]"}], ",", 
      RowBox[{"Arrow", "[", 
       RowBox[{"{", 
        RowBox[{"start", ",", "mid"}], "}"}], "]"}], ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{"mid", ",", "finish"}], "}"}], "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.457614789430089*^9, 3.457614800548434*^9}, {
  3.45761483067736*^9, 3.457614847562351*^9}},
 CellLabel->
  "In[889]:=",ExpressionUUID->"e7f91537-1972-4f94-a4b6-0e2d5bedb32f"],

Cell["Example", "Text",
 CellChangeTimes->{{3.457614545522763*^9, 
  3.457614546264435*^9}},ExpressionUUID->"bb78f813-697e-47fb-ae7a-\
fc3f1238ca00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics", "[", 
   RowBox[{"{", 
    RowBox[{"MidArrow", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], "]"}], "}"}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.45761454939962*^9, 3.45761458858595*^9}, {
  3.457614731817446*^9, 3.457614739471842*^9}, {3.457614821656644*^9, 
  3.457614822906233*^9}},
 CellLabel->
  "In[890]:=",ExpressionUUID->"997cea6a-bbc8-46e7-8bfc-290f1c355520"],

Cell[TextData[{
 "TextArrow[",
 StyleBox["text, start, finish, offset",
  FontSlant->"Italic"],
 "] places ",
 StyleBox["text",
  FontSlant->"Italic"],
 " at location ",
 StyleBox["start",
  FontSlant->"Italic"],
 ", then draws an arrow from ",
 StyleBox["start",
  FontSlant->"Italic"],
 " to ",
 StyleBox["finish",
  FontSlant->"Italic"],
 ". It's used to add a text label to a figure."
}], "Text",
 CellChangeTimes->{{3.4576144884708233`*^9, 
  3.457614498054541*^9}},ExpressionUUID->"1bfad640-cfdb-47de-9d40-\
d05f6cbf385b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TextArrow", "[", 
   RowBox[{"text_", ",", "start_", ",", "finish_", ",", "offset___"}], "]"}], 
  ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Text", "[", 
     RowBox[{"text", ",", "start", ",", "offset"}], "]"}], ",", 
    RowBox[{"Arrowheads", "[", "Medium", "]"}], ",", 
    RowBox[{"Arrow", "[", 
     RowBox[{"{", 
      RowBox[{"start", ",", "finish"}], "}"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.4576138037781067`*^9, 3.457613822972685*^9}, {
  3.457614098418082*^9, 3.457614100777656*^9}},
 CellLabel->
  "In[891]:=",ExpressionUUID->"f2bd7921-89ac-4cf0-8f36-2b09a32ad9b5"],

Cell["Example", "Text",
 CellChangeTimes->{{3.457614143878784*^9, 
  3.4576141445568447`*^9}},ExpressionUUID->"d04906ab-2f3a-4c88-98ad-\
e04758f34109"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics", "[", 
   RowBox[{"{", 
    RowBox[{"TextArrow", "[", 
     RowBox[{"\"\<foo\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], "]"}], "}"}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.457614146851258*^9, 3.4576141899090548`*^9}, {
  3.457614267293308*^9, 3.457614291273285*^9}},
 CellLabel->
  "In[892]:=",ExpressionUUID->"f9bd28dc-a778-4cf0-8ad4-2f307dab18a3"],

Cell[TextData[{
 "ArcArrow[",
 StyleBox["ctr,r,{q1,q2",
  FontSlant->"Italic"],
 "}] draws an arrow along a circular arc centered on ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 " with radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", starting at absolute angle ",
 StyleBox["q1",
  FontSlant->"Italic"],
 " and extending to absolute angle ",
 StyleBox["q2.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"6be13ae2-b4dd-4df8-ab07-ba0a27639c14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ArcArrow", "[", 
   RowBox[{"ctr_", ",", "r_", ",", 
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}]}], "]"}], " ", ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Circle", "[", 
     RowBox[{"ctr", ",", "r", ",", 
      RowBox[{"{", 
       RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}], ",", 
    RowBox[{"Arrow", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"r", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "#", "]"}], ",", 
            RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}]}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q2", "-", 
          RowBox[{".01", 
           RowBox[{"(", 
            RowBox[{"q2", "-", "q1"}], ")"}]}]}], ",", "q2"}], "}"}]}], "]"}],
      "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.45761386144192*^9, 3.457613862551661*^9}, {
  3.457614392291459*^9, 3.457614395041676*^9}},
 CellLabel->
  "In[893]:=",ExpressionUUID->"2e265a5f-5498-4378-8ef8-569fd4d391dd"],

Cell["Example", "Text",ExpressionUUID->"de3c4cff-077d-4f5b-b9c9-97a964c3e0a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Point", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], "]"}], ",", 
     RowBox[{"ArcArrow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", ".9", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"45", "\[Degree]"}]}], "}"}]}], "]"}]}], "}"}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.457613883050206*^9, 3.4576139121314487`*^9}, {
  3.457614003652609*^9, 3.457614009961371*^9}, {3.457614371184271*^9, 
  3.457614447572901*^9}},
