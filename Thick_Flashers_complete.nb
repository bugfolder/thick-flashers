Cell[CellGroupData[{

Cell[TextData[{
 "Oval[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.735211025116297*^9, 3.735211025604599*^9}, {
  3.735220881898334*^9, 
  3.735220886722756*^9}},ExpressionUUID->"01fe0228-22c4-40f0-803e-\
48e746ffbcdb"],

Cell[TextData[{
 "Oval[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] draws an oval from point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to point ",
 StyleBox["q",
  FontSlant->"Italic"],
 " with radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.735211097317026*^9, 
  3.735211143690028*^9}},ExpressionUUID->"77ceca03-5fe4-473a-8aa4-\
d438116be813"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Oval", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_List", ",", "q_List"}], "}"}], ",", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", "pq", ",", "dr"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"p", "\[Equal]", "q"}], ",", 
      RowBox[{"Circle", "[", 
       RowBox[{"p", ",", "r"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pq", "=", 
        RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Phi]", "=", 
        RowBox[{"ArcTan", "@@", "pq"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dr", "=", 
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", 
         RowBox[{"Normalize", "[", "pq", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Circle", "[", 
          RowBox[{"p", ",", "r", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Phi]", "+", 
              RowBox[{"\[Pi]", "/", "2"}]}], ",", 
             RowBox[{"\[Phi]", "+", 
              RowBox[{"3", 
               RowBox[{"\[Pi]", "/", "2"}]}]}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "+", 
             RowBox[{"r", " ", "dr"}]}], ",", 
            RowBox[{"q", "+", 
             RowBox[{"r", " ", "dr"}]}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "-", 
             RowBox[{"r", " ", "dr"}]}], ",", 
            RowBox[{"q", "-", 
             RowBox[{"r", " ", "dr"}]}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Circle", "[", 
          RowBox[{"q", ",", "r", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Phi]", "-", 
              RowBox[{"\[Pi]", "/", "2"}]}], ",", 
             RowBox[{"\[Phi]", "+", 
              RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}]}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.735211027058908*^9, 3.735211091752386*^9}, {
  3.735211278759076*^9, 3.735211553990677*^9}},
 CellLabel->
  "In[804]:=",ExpressionUUID->"9c333098-04fa-4cac-a08f-9cf76228cbcd"],

