        RowBox[{"GraphicsRow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}],
         "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"qq", ",", "0"}], "}"}], ",", 
        RowBox[{"-", "90"}], ",", "90"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.719619136437985*^9, 3.719619142108522*^9}, {
  3.7196191922679043`*^9, 3.719619234140979*^9}, {3.719619378469594*^9, 
  3.719619460189662*^9}, {3.719619541878778*^9, 3.719619547053687*^9}},
 CellLabel->
  "In[2380]:=",ExpressionUUID->"fbb904de-1516-44d4-98fe-4cd8480d5416"]
}, Closed]]
