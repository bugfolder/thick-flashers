        RowBox[{"{", 
         RowBox[{"5", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "B", ",", "V", ",", "B", ",", "V", ",", "M", ",", "B", ",", 
        "V", ",", "B", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"90", "\[Degree]"}], ",", "0", ",", 
        RowBox[{"45", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "45"}], "\[Degree]"}], ",", "0", ",", 
        RowBox[{"90", "\[Degree]"}], ",", "0", ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
