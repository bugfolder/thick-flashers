Cell["TAssigned utilities", "Subsection",
 CellChangeTimes->{{3.595013539596453*^9, 
  3.595013545355608*^9}},ExpressionUUID->"e4dde05b-d646-4e6f-bfb5-\
b71eef63102a"],

Cell[CellGroupData[{

Cell[TextData[{
 "TypeFoldedQ[",
 StyleBox["type",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.617397370128667*^9, 
  3.617397376642788*^9}},ExpressionUUID->"85160cc7-5eb4-4ebc-bd91-\
2365c748a8b5"],

Cell[TextData[{
 "TypeFoldedQ[",
 StyleBox["type",
  FontSlant->"Italic"],
 "] returns True if the passed type is either M or V and False if it\
\[CloseCurlyQuote]s anything else (i.e., U or V)."
}], "Text",
 CellChangeTimes->{{3.61739738358832*^9, 
  3.617397406839601*^9}},ExpressionUUID->"e3b618ac-afa8-4531-a187-\
f714061f8cf1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TypeFoldedQ", "[", "type_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"type", "===", "M"}], "||", 
     RowBox[{"type", "===", "V"}]}], ")"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.617397331020136*^9, 3.61739736343188*^9}},
 CellLabel->
  "In[1802]:=",ExpressionUUID->"949fc074-fb7e-4fab-80da-4c6811ab6c0a"],

Cell["Example", "Text",
 CellChangeTimes->{{3.617397416132986*^9, 
  3.6173974167874546`*^9}},ExpressionUUID->"29cd9220-f882-495a-b177-\
7b8efdf8b92d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TypeFoldedQ", "/@", 
   RowBox[{"{", 
    RowBox[{"M", ",", "V", ",", "U", ",", "B", ",", "A"}], "}"}]}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.617397418324489*^9, 3.617397441045553*^9}},
 CellLabel->
  "In[1803]:=",ExpressionUUID->"fd95a957-02a8-431b-a9df-2e745a0c2213"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "InvertTypeRules\n",
 "InvertFoldType",
 "[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595013551386688*^9, 3.595013555063373*^9}, {
   3.595013600261704*^9, 3.595013601713236*^9}, 
   3.5952526680105963`*^9},ExpressionUUID->"a5340a92-5ca1-4ed7-9bb5-\
ef69cbfa72e1"],

Cell["\<\
InvertTypeRules swaps mountain and valley folds in a typed plane graph (or \
any other expression).\
\>", "Text",
 CellChangeTimes->{{3.457634912686069*^9, 3.457634948120389*^9}, 
   3.484829044905521*^9, {3.591801661509194*^9, 
   3.591801665383104*^9}},ExpressionUUID->"4274dd27-2605-47ba-aa52-\
15ad14e34325"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InvertTypeRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"M", "\[Rule]", "V"}], ",", 
     RowBox[{"V", "\[Rule]", "M"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.45763494967599*^9, 3.45763496300168*^9}},
 CellLabel->
  "In[1804]:=",ExpressionUUID->"6cd34765-17dc-4921-9df0-d09f6ed484d0"],

Cell[TextData[{
 "InvertFoldType",
 "[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] inverts the type of any type symbols in ",
 StyleBox["expr",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.4576392946065683`*^9, 3.457639306789153*^9}, {
   3.595013629531077*^9, 3.5950136302468767`*^9}, 
   3.595252668096156*^9},ExpressionUUID->"212829b4-6e08-4d48-97cc-\
0e3f437345b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InvertFoldType", "[", "expr_", "]"}], ":=", 
  RowBox[{"expr", "/.", "InvertTypeRules"}]}]], "Input",
 CellChangeTimes->{{3.457639308231146*^9, 3.4576393198065557`*^9}, 
   3.595252668173181*^9},
 CellLabel->
  "In[1805]:=",ExpressionUUID->"c77c025a-1778-471e-b101-5410b681b7a8"],

Cell["Example", "Text",
 CellChangeTimes->{{3.457639343354846*^9, 
  3.457639345378621*^9}},ExpressionUUID->"1095b5d6-bcf6-4f3b-b96f-\
f801cfbe6df2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InvertFoldType", "[", 
   RowBox[{"{", 
    RowBox[{"M", ",", "M", ",", "V", ",", "U", ",", "U", ",", "V"}], "}"}], 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.45763934814478*^9, 3.457639366675956*^9}, 
   3.59525266827661*^9},
 CellLabel->
  "In[1806]:=",ExpressionUUID->"7f4d0781-1415-445e-baeb-d2b248f5bc4d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FoldAngleToType[\[Alpha], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TypeMinimumAngle\nFoldAngleToType[",
 StyleBox["alist, opts",
  FontSlant->"Italic"],
 "]\n\t(options) TypeMinimumAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.5950140012781487`*^9, 3.595014007660288*^9}, {
   3.597515389178699*^9, 3.59751542264734*^9}, {3.597515519034047*^9, 
   3.59751552644881*^9}, {3.597515579070469*^9, 3.597515581532336*^9}, {
   3.650063751199887*^9, 3.650063879607747*^9}, 
   3.650064044462561*^9},ExpressionUUID->"edf5a3ea-3a7f-46ad-a287-\
d36e638adc6f"],

Cell[TextData[{
 "FoldAngleToType[\[Alpha], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the edge type for a given fold angle. Options are:\n\t\
TypeMinimumAngle \[Rule] \[Epsilon], where if the absolute value of the angle \
is less than \[Epsilon], it is assigned U (unfolded)."
}], "Text",
 CellChangeTimes->{{3.595014011135821*^9, 3.5950140480341177`*^9}, {
  3.595018910378506*^9, 3.595018916704121*^9}, {3.650063822768898*^9, 
  3.650063823457251*^9}, {3.6500638917730017`*^9, 
  3.6500639330038414`*^9}},ExpressionUUID->"d5dd59a5-6eed-46fe-a696-\
60bd1518515c"],

Cell["See also ReassignGraphAssigned below.", "Text",
 CellChangeTimes->{3.6500638946385937`*^9, 
  3.673096600180119*^9},ExpressionUUID->"aa1fd035-a5da-464f-adbc-\
8349d132094b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TypeMinimumAngle", "::", "usage"}], " ", "=", 
   " ", "\"\<TypeMinimumAngle is an option to FoldAngleToType that specifies \
the minimum value of a fold angle that should be assigned a folded type (M or \
V).\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.650063972482976*^9, 3.6500639988885193`*^9}},
 CellLabel->
  "In[1807]:=",ExpressionUUID->"615f9018-ebfd-4d57-9275-7b18f324a009"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FoldAngleToType", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"TypeMinimumAngle", "\[Rule]", 
     RowBox[{"0.5", "\[Degree]"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.650063947872417*^9, 3.650063967377213*^9}},
 CellLabel->
  "In[1808]:=",ExpressionUUID->"746a6301-ce38-45cf-8637-97427644e405"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAngleToType", "[", 
   RowBox[{"\[Alpha]_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", "=", 
      RowBox[{
       RowBox[{"TypeMinimumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAngleToType", "]"}]}]}], "}"}], ",", 
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"\[Alpha]", ">", "\[Epsilon]"}], ",", "V", ",", 
      RowBox[{"\[Alpha]", "<", 
       RowBox[{"-", "\[Epsilon]"}]}], ",", "M", ",", "True", ",", "U"}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595014055583146*^9, 3.595014082315803*^9}, {
  3.650063940538936*^9, 3.650063943530678*^9}, {3.650064085388149*^9, 
  3.650064142752306*^9}},
 CellLabel->
  "In[1809]:=",ExpressionUUID->"78dd4cd3-de4f-4cc5-9eda-bc57d86a1a59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"FoldAngleToType", ",", "Listable"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.597515585541463*^9, 3.597515600037532*^9}},
 CellLabel->
  "In[1810]:=",ExpressionUUID->"359741aa-2003-4790-8039-838e38c7a9ed"],

