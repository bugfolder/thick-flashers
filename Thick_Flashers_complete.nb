3ffba9a5e96a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexEdgeAngles", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "vva", ",", "vfi", ",", "ra", ",", "vfa"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "vva", ",", "vfi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "VertexVertexAdjacency", ",", 
          "VertexFaceIncidence"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ra", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
             "-", 
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}]}], ")"}], "&"}], "/@", 
          RowBox[{
          "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"vfa", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{"RotationAngle", ",", 
           RowBox[{"{", 
            RowBox[{"ra", ",", 
             RowBox[{"RotateLeft", "[", "ra", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#1", "\[Equal]", "0"}], ",", "Null", ",", "#2"}], "]"}],
            "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "vfi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
             "vfa"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "vva", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.59190881949539*^9, 3.591908873049375*^9}, {
