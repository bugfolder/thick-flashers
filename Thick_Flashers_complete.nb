Cell[CellGroupData[{

Cell["Tessellatica graphs", "Section",
 CellChangeTimes->{{3.462972646773587*^9, 3.462972661628625*^9}, {
   3.483852023899741*^9, 3.48385203714659*^9}, 3.484829028911623*^9, {
   3.534466940211071*^9, 3.534466941540455*^9}, {3.592344136671535*^9, 
   3.592344136869285*^9}, {3.592344259869808*^9, 3.5923442626611*^9}, {
   3.592352345899721*^9, 3.592352348641445*^9}, 3.59243584365879*^9, {
   3.5926446616020317`*^9, 3.592644661840869*^9}, 
   3.592794113956442*^9},ExpressionUUID->"33deea1d-bf01-4aba-947a-\
f7ff76fc8b7f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.484829128594592*^9, 
  3.484829130089432*^9}},ExpressionUUID->"15a28dc5-cbbf-4fe3-bbb4-\
7e5ca889b69d"],

Cell[TextData[{
 "A ",
 StyleBox["planar graph",
  FontSlant->"Italic"],
 " is one that can be drawn in the plane with no crossing edges. A ",
 StyleBox["plane graph",
  FontSlant->"Italic"],
 " is a planar graph together with a non-crossing embedding. This section \
contains functions for manipulating and drawing planar and plane graphs, \
which, for obvious reasons, are highly relevant in origami design, since \
crease patterns are all plane graphs and flat folded forms are all planar \
graphs. This section makes use of two ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " packages: the ",
 StyleBox["ComputationalGeometry",
  FontSlant->"Italic"],
 " package and the ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " package. The latter contains functions for manipulating graphs and has its \
own native representation for graphs\[LongDash]which we \
don\[CloseCurlyQuote]t use (most of the time). We will represent graphs by \
lists of vertices, edges, and other properties that are particular to plane \
graphs: faces, vertex adjacency lists, and the like, as well as decorations \
of both the edges and faces with crease type, face coloring, and so forth."
}], "Text",
 CellChangeTimes->{{3.484829132360919*^9, 3.4848291730624247`*^9}, {
  3.4848292156452827`*^9, 3.484829438532785*^9}, {3.591895970973819*^9, 
  3.591895983164322*^9}, {3.591898001268856*^9, 3.591898002729375*^9}, {
  3.5923454092116323`*^9, 3.592345410960043*^9}, {3.594211591260758*^9, 
  3.594211630664501*^9}},ExpressionUUID->"5e6aac6e-2f15-434d-a1e3-\
c1001fddc2ba"],

Cell["\<\
This is the first place we introduce TObj (Tessellatica object) to represent \
complex objects with multiple related properties. We introduce the first \
class, TGraph, and the first properties: Vertices, Edges, and Faces. \
Additional properties will be introduced as their need arises.\
\>", "Text",
 CellChangeTimes->{{3.591634910655107*^9, 3.591634961202321*^9}, 
   3.591640273545625*^9, {3.591696643028626*^9, 3.591696680800695*^9}, {
   3.592345424175939*^9, 3.592345430807297*^9}, 3.59243573648205*^9, 
   3.5924358437564783`*^9},ExpressionUUID->"d94a3d5e-2a13-48eb-bce5-\
3e5dccb7d1c6"],

Cell[TextData[{
 "As a general rule, functions that take only a single list and/or low-level \
functions used internally will take lists and/or parameters as arguments and \
will return TObj\[CloseCurlyQuote]s. Functions whose input requires two or \
more related lists will generally take TObj\[CloseCurlyQuote]s as arguments. \
If an input list is \[OpenCurlyDoubleQuote]consumed in processing\
\[CloseCurlyDoubleQuote] (like ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 " in ",
 "CircularlyAddEdges",
 "), it will be passed as an additional function argument, rather than as a \
TObj property."
}], "Text",
 CellChangeTimes->{{3.591697474480072*^9, 3.591697663331115*^9}, 
   3.592435736624585*^9, {3.594211657806892*^9, 3.5942116863531103`*^9}, 
   3.595297015339382*^9, 3.595297597479145*^9, 
   3.595297659635427*^9},ExpressionUUID->"d57d2177-63df-4699-a04c-\
55102481a5f4"]
}, Closed]],

Cell[CellGroupData[{

Cell["Class TGraph", "Subsection",
 CellChangeTimes->{{3.462972630622694*^9, 3.46297264226184*^9}, {
   3.483851623366929*^9, 3.483851628405078*^9}, {3.483852027195741*^9, 
   3.483852034370821*^9}, 3.484065953869076*^9, 3.484829029009062*^9, {
   3.592344205961592*^9, 3.592344206105*^9}, {3.592442051458583*^9, 
   3.592442063921798*^9}, {3.592648715367162*^9, 3.592648715774252*^9}, {
   3.592659649051538*^9, 3.592659650003776*^9}, {3.594685258505929*^9, 
   3.594685259193618*^9}},ExpressionUUID->"0d6e102e-08d4-499f-b675-\
8f42f28d074b"],

Cell[CellGroupData[{

Cell["\<\
TObj class: TGraph
\tInherits from: none\
\>", "Subsubsection",
 CellChangeTimes->{{3.59234460214283*^9, 3.592344617061437*^9}, 
   3.592345550177439*^9, {3.592351317674039*^9, 3.592351320917557*^9}, {
   3.592378132318344*^9, 3.5923781369479313`*^9}, 3.592378220638405*^9, 
   3.592435737297309*^9, {3.592435843839242*^9, 3.592435844023407*^9}, {
   3.5924359295979137`*^9, 3.59243593066603*^9}, {3.592440751038992*^9, 
   3.592440757782655*^9}, {3.592467275255644*^9, 
   3.592467288980541*^9}},ExpressionUUID->"bd8da859-1ae1-4489-ae78-\
b7c73d68748d"],

Cell["\<\
TGraph is a TObj class that represents a graph, containing {Vertices, Edges, \
Faces} properties. It represents a general graph object using our own \
preferred representation. Faces can be empty.\
\>", "Text",
 CellChangeTimes->{{3.592344414747666*^9, 3.592344452440134*^9}, {
   3.592344536866925*^9, 3.592344589031244*^9}, {3.592377967714188*^9, 
   3.592377985814105*^9}, {3.592435737396982*^9, 3.592435737487393*^9}, 
   3.5924358441304073`*^9, {3.592440771406088*^9, 
   3.592440778779613*^9}},ExpressionUUID->"41f2e4fb-546e-42e8-ad3d-\
b3ac6d582346"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TGraph", "::", "usage"}], 
   "=", "\"\<TGraph is a TObj class that represents a graph.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592344338286132*^9, 3.592344339912696*^9}, {
   3.592344402998242*^9, 3.592344409102283*^9}, {3.592344473202457*^9, 
   3.592344484976874*^9}, {3.592344541717126*^9, 3.592344554900955*^9}, {
   3.592377980713805*^9, 3.592377981055777*^9}, {3.5924357375565434`*^9, 
   3.592435737621561*^9}, {3.5924358442070293`*^9, 3.592435844272615*^9}, {
   3.592440817372813*^9, 3.592440818500216*^9}, 3.795554471510126*^9},
 CellLabel->
  "In[1035]:=",ExpressionUUID->"15f667c1-2677-4704-abb0-33d1a660ad7c"],

Cell[TextData[{
 "I\[CloseCurlyQuote]d really like to make this just plain Graph, but ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " had already adopted that symbol for its own nefarious purposes. And then \
Mathematica 11 introduced a native Graph symbol, so it was probably just as \
well."
}], "Text",
 CellChangeTimes->{{3.592344490926023*^9, 3.592344516148489*^9}, {
  3.708426249006414*^9, 
  3.708426288575183*^9}},ExpressionUUID->"42e4e6f4-b5ea-4715-b81e-\
0f34f278486f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegisterTClass", "[", "TGraph", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.5925190851323442`*^9, 3.59251908921311*^9}, {
   3.592519273305931*^9, 3.592519280007385*^9}, 3.5926417910795507`*^9},
 CellLabel->
  "In[1036]:=",ExpressionUUID->"7d55a849-7fae-4705-aa80-04b029305cb5"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TGraph properties:
\tVertices
\tEdges
\tFaces\
\>", "Subsubsection",
 CellChangeTimes->{{3.591634980284658*^9, 3.591634983760848*^9}, {
   3.591728738555191*^9, 3.591728768603909*^9}, {3.59207538652503*^9, 
   3.592075392269883*^9}, {3.592344330211388*^9, 3.592344331056538*^9}, 
   3.592344397414426*^9, 3.592344527739128*^9, 3.592345548113221*^9, 
   3.592435736706203*^9, {3.5926486074470463`*^9, 3.592648621508199*^9}, {
   3.595008963738245*^9, 
   3.595008964985704*^9}},ExpressionUUID->"99b7a6b4-7bef-43de-91b6-\
18b8e07194b3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Vertices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["v", "1"], ",", 
      SubscriptBox["v", "2"], ",", " ", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"56fe2079-e063-43ee-8152-6f69958a4b57"],
 " is a ",
 "TObj",
 " property that specifies the list of vertices in a plane graph, where each \
of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "8d414b64-8b93-4406-834b-4c57a9919d66"],
 " is a 2D point."
}], "Text",
 CellChangeTimes->{{3.591695220686213*^9, 3.591695284985227*^9}, {
   3.591695391961586*^9, 3.591695401849621*^9}, {3.591695458229889*^9, 
   3.5916954596779003`*^9}, 3.59207078672644*^9, {3.592344462634843*^9, 
   3.592344467234542*^9}, 
   3.5924357368117113`*^9},ExpressionUUID->"3e9ea70a-10d2-4087-bcf0-\
a4115fa3f84b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Vertices", "::", "usage"}], " ", "=", 
   " ", "\"\<Vertices is a TObj property that specifies a list of vertex \
coordinates.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5917275057402687`*^9, 3.591727505745173*^9}, 
   3.592070827708985*^9, 3.592435736888589*^9},
 CellLabel->
  "In[1037]:=",ExpressionUUID->"b51afd0d-1ee9-4dec-8df5-3bd07e1a38de"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Edges", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["v", 
         RowBox[{"1", ",", "a", ","}]], 
        SubscriptBox["v", 
         RowBox[{"1", ",", "b"}]]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["v", 
         RowBox[{"2", ",", "a"}]], ",", " ", 
        SubscriptBox["v", 
         RowBox[{"2", ",", "b"}]]}], "}"}], ",", " ", "..."}], "}"}]}], 
   TraditionalForm]],ExpressionUUID->"7a909818-3ff7-48ad-be59-d3c60d03c89d"],
 " is a ",
 "TObj",
 " property that specifies a set of directed or undirected edges in a plane \
graph as a list of vertex index pairs."
}], "Text",
 CellChangeTimes->{{3.591695291183981*^9, 3.591695385336782*^9}, {
   3.591695462537595*^9, 3.591695463938282*^9}, 3.592070844536336*^9, 
   3.5924357369806747`*^9},ExpressionUUID->"5ebf8b55-c9ad-4ff6-9e38-\
a7852e39d254"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Edges", "::", "usage"}], " ", "=", 
   " ", "\"\<Edges is a TObj property that specifies a list of edges as index \
pairs on a list of vertices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591727511515598*^9, 3.591727511520127*^9}, 
   3.592070827807005*^9, 3.592435737050755*^9},
 CellLabel->
  "In[1038]:=",ExpressionUUID->"d636dcf7-aa20-46a6-8afe-26470f3f53ef"],

Cell[TextData[{
 "Faces\[Rule]",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["v", 
         RowBox[{"1", ",", "a", ","}]], 
        SubscriptBox["v", 
         RowBox[{"1", ",", "b"}]]}], ",", " ", "..."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", 
        RowBox[{"2", ",", "a"}]], ",", " ", 
       SubscriptBox["v", 
        RowBox[{"2", ",", "b"}]], ",", " ", "..."}], "}"}], ",", " ", "..."}],
     "}"}], TraditionalForm]],ExpressionUUID->
  "3d50e77a-edd0-4d61-9f89-203deb06aee6"],
 " is a ",
 "TObj",
 " property that specifies a list of faces in a plane graph as a list of \
vertex indices in CCW order around the face."
}], "Text",
 CellChangeTimes->{{3.591695409848906*^9, 3.591695486571293*^9}, 
   3.592070786881852*^9, 
   3.592435737134617*^9},ExpressionUUID->"923d3840-2bc6-4983-b7f2-\
18b48307e0c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Faces", "::", "usage"}], 
   "=", "\"\<Faces is a TObj property that specifies a list of faces, each \
face being a list of indices on a list of vertex coordinates.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{3.592070827913471*^9, 3.592435737206232*^9},
 CellLabel->
  "In[1039]:=",ExpressionUUID->"b23c44b5-5813-4026-ac50-3699bf1d63eb"]
}, Closed]],

