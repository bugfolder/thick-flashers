Cell["\<\
Returns a Graphics object that displays the crease pattern graph, all folded \
edges, and all face-splitting lines.\
\>", "Text",
 CellChangeTimes->{{3.706727940209631*^9, 3.7067279957440643`*^9}, 
   3.706728542252192*^9, {3.7067288254308777`*^9, 3.706728842456513*^9}, {
   3.7067925585323977`*^9, 3.706792564164638*^9}, {3.70682036393356*^9, 
   3.70682036573378*^9}},ExpressionUUID->"2e21c1b0-6bab-4073-ad88-\
81e89c6cea44"],

Cell["\<\
Note that while the splitting folds (of course) overlap in the folded form, \
they will be distinct in the crease pattern, allowing us to visually identify \
the subset that we would like to actually fold on.\
\>", "Text",
 CellChangeTimes->{{3.706729969236315*^9, 
  3.7067300306242113`*^9}},ExpressionUUID->"8a86d870-7f44-4787-8d37-\
f1edac878835"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitGraphGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "sinfo", ",", "vfinfo", ",", "efinfo", ",", 
      "esinfo", ",", "fsinfo", ",", "et", ",", "elems", ",", "fj", ",", "j", ",",
       "p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TSplitGraph2D", ",", "SplitGraphGraphics"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "sinfo"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "SplitInfo"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo"}], "}"}],
       "=", "sinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "make", " ", "a", " ", "lookup", " ", "table", " ", "from", " ", 
       "split", " ", "edge", " ", "index", " ", "to", " ", "its", " ", 
       "split", " ", "parameter"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"et", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}], "=", 
         RowBox[{
         "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ")"}],
        "&"}], "/@", "esinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"elems", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"folded", " ", "edges"}], ",", " ", 
         RowBox[{"no", " ", "labels", " ", "needed"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], "=", 
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{
              "efinfo", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", "Blue"}], 
            "]"}]}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "efinfo", "]"}]}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"face", "-", 
           RowBox[{"splitting", " ", "edges"}]}], ",", " ", 
          RowBox[{"label", " ", "with", " ", "face", " ", "index"}]}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"fj", ",", "j"}], "}"}], "=", 
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"p1", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fj", "\[Equal]", "0"}], ",", 
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}],
               ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"q1", ",", "q2"}], "}"}], "=", 
                RowBox[{"verts", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "edges", "\[LeftDoubleBracket]", "j", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"q1", "+", 
                RowBox[{
                 RowBox[{"et", "[", "j", "]"}], 
                 RowBox[{"(", 
                  RowBox[{"q2", "-", "q1"}], ")"}]}]}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"fj", ",", "j"}], "}"}], "=", 
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"p2", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fj", "\[Equal]", "0"}], ",", 
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}],
               ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
