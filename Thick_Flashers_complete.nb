Cell[CellGroupData[{

Cell[TextData[{
 "GenericGraphGraphics3D[",
 StyleBox["verts, edges, faces, opts",
  FontSlant->"Italic"],
 "]\n\t(options) VertexLabels, EdgeLabels, FaceLabels, DirectedEdges, \
VertexColor, EdgeColor, FaceColor, FaceColoring, Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{{3.70888766991207*^9, 
  3.708887704872454*^9}},ExpressionUUID->"071019c9-b3d0-49b2-89e2-\
189b4a2bd843"],

Cell[TextData[{
 "GenericGraphGraphics3D[",
 StyleBox["verts, edges, faces, opts",
  FontSlant->"Italic"],
 "] takes lists of 3D vertices, edges, and (optionally) faces, and displays \
them as a graph with labels as a Graphics3D object. The faces, if present, \
are outlined with inset polygons. "
}], "Text",
 CellChangeTimes->{{3.455897664154768*^9, 3.455897679891059*^9}, {
