Cell[CellGroupData[{

Cell[TextData[{
 "FrenetTrihedronPlot3D[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", {u0, u1}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FrenetTrihedrons, FrenetVectorLength, CurveDivisions, \
Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{{3.668982808633419*^9, 3.668982846868602*^9}, {
   3.668983548647709*^9, 3.6689835538325787`*^9}, {3.668986508510049*^9, 
   3.668986511622415*^9}, {3.668986557330912*^9, 3.668986565362192*^9}, {
   3.66906350383947*^9, 3.669063505869398*^9}, {3.689075011772623*^9, 
   3.689075021923967*^9}, {3.689075575698146*^9, 3.689075604777353*^9}, {
   3.6890756882080917`*^9, 3.689075688804092*^9}, {3.689076107287202*^9, 
   3.68907612801196*^9}, 3.691254057331523*^9, {3.799523095421014*^9, 
   3.799523107283704*^9}, {3.799834684237567*^9, 
   3.7998346842612147`*^9}},ExpressionUUID->"cf5e186e-324e-475c-aaf5-\
86e659fc49d1"],

Cell[TextData[{
 "FrenetTrihedronPlot3D[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", {u0, u1}, opts} plots a discretized space curve with superimposed Frenet \
frame vectors at discrete points. Arguments are:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] a vector-valued pure function of the space curve.\n\tu0 \
\[LongDash] minimum value of the parameter ",
 StyleBox["t",
  FontSlant->"Italic"],
 ".\n\tu1 \[LongDash] maximum value of the parameter ",
 StyleBox["t",
  FontSlant->"Italic"],
 ".\nOptions are:\n\tSimplification \[Rule] None | Automatic | fn, specifies \
whether to simplify the Frenet frame functions.\n\tFrenetTrihedrons \[Rule] \
",
 StyleBox["n",
  FontSlant->"Italic"],
 ", the number of Frenet Frames to place along the curve.\n\tFrenetDrop \
\[Rule] 0 | 1 | -1, specify whether to drop the first or last frame.\n\t\
FrenetVectorLength \[Rule] ",
 StyleBox["flen",
  FontSlant->"Italic"],
 ", specifies the lengths of the vectors. Passed through to \
StyledFrenetTrihedron.\n\tCurveDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", passed through to StyledCurve.\n\tOptions[Graphics3D] are passed through.\
\nIt returns a Graphics3D of the plot. This is useful for visualizing space \
curves and their associated Frenet frames. Note that you should apply \
CurveVectorStyle (or equivalent rules) to get the colors to render."
}], "Text",
 CellChangeTimes->{{3.668982827908934*^9, 3.668983028682231*^9}, {
   3.668983248626912*^9, 3.668983268666646*^9}, {3.668983323352161*^9, 
   3.668983332494169*^9}, {3.668983457246973*^9, 3.668983502924233*^9}, {
   3.669063508261194*^9, 3.669063535715503*^9}, {3.672101868037386*^9, 
   3.672101888001581*^9}, {3.688132358514482*^9, 3.688132372902039*^9}, 
