Cell["Examples. Default rules.", "Text",
 CellChangeTimes->{{3.628955585123827*^9, 3.6289555858180847`*^9}, {
  3.628955716497686*^9, 
  3.6289557224253697`*^9}},ExpressionUUID->"4c35f1f6-ea86-4df5-afa2-\
795e437d68c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ShowOrigamiSamples", "[", 
   RowBox[{"OrigamiStyle", "[", "]"}], "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.628955536114049*^9, 3.628955545005381*^9}, {
   3.62895559424305*^9, 3.6289556112707777`*^9}, 3.629057970173026*^9},
 CellLabel->
  "In[1580]:=",ExpressionUUID->"415eda04-7ba3-4ae1-a1ab-532b71c20cc6"],

Cell["\<\
Default styling shows everything, but is unrealistic in 2D because with \
transparency, the two-color paper does somewhat weird things.\
\>", "Text",
 CellChangeTimes->{{3.45798976661465*^9, 3.457989767413385*^9}, {
  3.533944259359624*^9, 3.533944272142269*^9}, {3.533945713278172*^9, 
  3.533945720069051*^9}, {3.533945782937336*^9, 3.533945794512191*^9}, {
  3.628955785541226*^9, 
  3.62895579638152*^9}},ExpressionUUID->"50c72c2f-0942-4482-8e3e-\
cc5474fbdf1e"],

Cell["\<\
Normally you\[CloseCurlyQuote]ll use either (two-color paper+opaque) or \
(single-color paper+transparency).\
\>", "Text",
 CellChangeTimes->{{3.533945728068474*^9, 3.533945776249508*^9}, 
   3.628955823434936*^9, {3.629057949732024*^9, 
   3.62905794995431*^9}},ExpressionUUID->"8053ba93-ea90-4e5b-b36f-\
252e7cca7035"],

Cell["\<\
To display true two-color images, set WhiteSideColor and ColoreSideColor to \
two different values and set both opacities to 1, and turn off hidden line \
display.\
\>", "Text",
 CellChangeTimes->{{3.533944304108254*^9, 3.5339443299623137`*^9}, {
  3.533945161830179*^9, 3.5339451928006883`*^9}, {3.5339458071519203`*^9, 
  3.5339458153026237`*^9}},ExpressionUUID->"d983b455-4a99-4238-9565-\
15e85ec6cc8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ShowOrigamiSamples", "[", 
   RowBox[{"OrigamiStyle", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WhiteSideColor", "\[Rule]", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.8", ",", "0.8", ",", "1"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ColoredSideColor", "\[Rule]", 
      RowBox[{"RGBColor", "[", 
       RowBox[{".3", ",", ".3", ",", "1"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Opacity2D", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Opacity3D", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ShowHidden", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "]"}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.628955848855171*^9, 3.628955855092341*^9}, {
  3.629057955221013*^9, 3.629057957081476*^9}},
 CellLabel->
  "In[1581]:=",ExpressionUUID->"77e353a2-683b-4161-9ec1-f061aa105929"],

Cell["\<\
To display overlapping layers in tessellations, set both sides to the same \
lightish color and turn down the opacity. You\[CloseCurlyQuote]ll probably \
want to leave hidden lines displaying to add emphasis to the \
transparent/overlapping layers.\
\>", "Text",
 CellChangeTimes->{{3.53394440208613*^9, 3.533944449042352*^9}, {
   3.5339445324373097`*^9, 3.533944537268464*^9}, 3.533945201673344*^9, {
   3.533945881973515*^9, 3.53394589408185*^9}, {3.533945930215831*^9, 
   3.533945951989273*^9}, 
   3.629057989033428*^9},ExpressionUUID->"1d475b45-e97f-4188-9477-\
7e03f77921b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ShowOrigamiSamples", "[", 
   RowBox[{"OrigamiStyle", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"WhiteSideColor", "\[Rule]", 
      RowBox[{"RGBColor", "[", 
       RowBox[{".6", ",", "1", ",", ".6"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ColoredSideColor", "\[Rule]", 
      RowBox[{"RGBColor", "[", 
       RowBox[{".6", ",", "1", ",", ".6"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Opacity2D", "\[Rule]", ".25"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Opacity3D", "\[Rule]", ".85"}]}], "\[IndentingNewLine]", "]"}], 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.628955875740777*^9, 3.628955885961998*^9}, 
   3.629057974108247*^9},
 CellLabel->
  "In[1582]:=",ExpressionUUID->"fc941fe5-b7f1-4b18-bec9-bf3d31f6f684"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ScoringStyle[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MountainColor, ValleyColor, BorderColor, ScoreLineThickness"
}], "Subsubsection",
 CellChangeTimes->{{3.456513123465816*^9, 3.4565131491998577`*^9}, {
  3.625060703604955*^9, 3.625060707972623*^9}, {3.625063215744182*^9, 
  3.625063219174611*^9}},ExpressionUUID->"f0fc340b-8765-419c-9c6e-\
b5801b6b5e72"],

Cell[TextData[{
 "ScoringStyle[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a list of styles that assigns colors for laser-scored patterns: \
blue for mountain, red for valley, black for the border, and all hairline \
thickness. Any remaining CreaseLine, HiddenBorderLine, HiddenFoldedLine, \
HiddenUnfoldedLine, UnfoldedLine, or NoLine lines are wiped out because they \
shouldn't be scored (although the Hidden* lines are not used in crease \
patterns anyhow). Options are:\n\tMountainColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of mountain fold lines.\n\tValleyColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of mountain fold lines.\n\tBorderColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of mountain fold lines.\n\tScoreLineThickness \[Rule] \
",
 StyleBox["th",
  FontSlant->"Italic"],
 ", specifies the absolute thickness in points of all lines."
}], "Text",
 CellChangeTimes->{{3.456513156847336*^9, 3.456513179373735*^9}, {
   3.456513402615525*^9, 3.456513421230126*^9}, {3.4565358382651243`*^9, 
   3.456535839694555*^9}, {3.457612391615456*^9, 3.457612395198999*^9}, {
   3.625060692305889*^9, 3.625060696141562*^9}, {3.625063226150144*^9, 
   3.625063288914235*^9}, 3.628948526052741*^9, 3.628948738415386*^9, 
   3.628948772844248*^9, {3.628956022801241*^9, 
   3.628956070986992*^9}},ExpressionUUID->"c785466a-664a-40df-b294-\
1099db80a670"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScoreLineThickness", "::", "usage"}], 
   "=", "\"\<ScoreLineThickness is an option to ScoringStyle that sets the \
thickness, in points, of scoring lines.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.6250607116192093`*^9, 3.625060743396859*^9}, {
  3.625063299086215*^9, 3.625063304378462*^9}},
 CellLabel->
  "In[1583]:=",ExpressionUUID->"0af41e10-ec25-461d-859f-553732962aff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ScoringStyle", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MountainColor", "\[Rule]", "Blue"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ValleyColor", "\[Rule]", "Red"}], ",", "\[IndentingNewLine]", 
     RowBox[{"BorderColor", "\[Rule]", "Black"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"ScoreLineThickness", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456513187037857*^9, 3.456513221191698*^9}, {
  3.457612384082869*^9, 3.457612387073648*^9}, {3.62506074629172*^9, 
  3.62506075293808*^9}, {3.6250632932180758`*^9, 3.625063297922086*^9}},
 CellLabel->
  "In[1584]:=",ExpressionUUID->"f806a50f-6956-496d-b7fe-94b3220f1d6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ScoringStyle", "[", "opts___", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mc", ",", "vc", ",", "bc", ",", "st", ",", "x"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mc", "=", 
      RowBox[{
       RowBox[{"MountainColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ScoringStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vc", "=", 
