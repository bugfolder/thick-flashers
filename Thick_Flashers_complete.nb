            RowBox[{"Length", "[", 
             RowBox[{"GetValue", "[", 
              RowBox[{"tobjw", ",", "Faces"}], "]"}], "]"}]}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
