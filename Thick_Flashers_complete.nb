f084f8abc192"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AbsoluteAngles", "[", 
   RowBox[{"p_List", ",", "plist_List"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"AbsoluteAngle", "[", 
     RowBox[{"#", "-", "p"}], "]"}], "&"}], "/@", "plist"}]}]], "Input",
 CellChangeTimes->{{3.677077609383117*^9, 3.677077649789316*^9}},
