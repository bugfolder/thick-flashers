 CellLabel->
  "In[4335]:=",ExpressionUUID->"eba7aa37-473d-4c29-91b7-ad8f076caa63"],

Cell["\<\
Example. Two polygons with slightly skew edges and the hinge that joins them.\
\
\>", "Text",
 CellChangeTimes->{{3.9122525565224733`*^9, 3.912252558654389*^9}, {
  3.912575224927684*^9, 3.912575234182829*^9}, {3.920736171783286*^9, 
  3.920736175175708*^9}},ExpressionUUID->"14b7f117-8c1a-4621-b052-\
8294b178b5a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "q1", ",", "q2", ",", "r1", ",", "r2", ",", 
      "polys", ",", "gc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", ".4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2.5", ",", ".4", ",", "0.1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1", ",", "r2"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1.4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "r1"}], "}"}], "]"}], ",", 
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{"q1", ",", "q2", ",", "r2"}], "}"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc", "=", 
      RowBox[{"HingePlateGC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", "polys", "}"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", 
          RowBox[{"polys", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"gc", ",", "SolidStyle"}], "]"}]}], "}"}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.912252560619796*^9, 3.912252698393826*^9}, {
   3.912252765309927*^9, 3.912252766589542*^9}, {3.912252808456509*^9, 
