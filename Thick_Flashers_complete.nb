Cell[CellGroupData[{

Cell[TextData[{
 "ParaboloidalFlasherScalarize[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m, f",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.719867069526457*^9, 3.7198670834218197`*^9}, {
   3.719868237117741*^9, 3.719868237404257*^9}, 3.719925980335895*^9, {
   3.825606494524758*^9, 3.825606497900666*^9}, {3.825606741766476*^9, 
   3.825606743158532*^9}, 3.825675647964883*^9, 3.911828158118345*^9, 
   3.911880808415739*^9, {3.913544191358526*^9, 
   3.913544191873219*^9}},ExpressionUUID->"dd458a87-ecd8-4fb6-a0d6-\
15f18c49b437"],

Cell[TextData[{
 "ParaboloidalFlasherScalarize[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m, f",
  FontSlant->"Italic"],
 "] takes an object that contains ",
 StyleBox["p",
  FontSlant->"Italic"],
 " or ",
 StyleBox["pp",
  FontSlant->"Italic"],
 " points and converts three-subscript vertices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"561138bd-64e3-49ed-a114-6da76defed2e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"6fc1025b-4123-4b53-935e-40e09a9ec7f8"],
 " into vectors of components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", 
     RowBox[{"i", ",", "j", ",", "0"}]], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["px", 
       RowBox[{"i", ",", " ", "j"}]], ",", " ", 
      SubscriptBox["py", 
       RowBox[{"i", ",", "j"}]], ",", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         SubscriptBox["px", 
          RowBox[{"i", ",", " ", "j"}]], "2"], "+", 
        SuperscriptBox[
         SubscriptBox["pY", 
          RowBox[{"i", ",", " ", "j"}]], "2"]}], 
       RowBox[{"4", "f"}]]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "a26783b4-7b66-4131-b803-27380fc3d351"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["pp", 
     RowBox[{"i", ",", "j", ",", "0"}]], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["ppx", 
       RowBox[{"i", ",", "j"}]], ",", " ", 
      SubscriptBox["ppy", 
       RowBox[{"i", ",", "j"}]], ",", " ", 
      SubscriptBox["ppz", 
       RowBox[{"i", ",", "j"}]]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "61c62a83-e612-42e4-ab53-9d946d482065"],
 ", respectively. It also applies rotation based on the rotational subscript ",
 StyleBox["k",
  FontSlant->"Italic"],
 " for rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " (thereby removing subscript ",
 StyleBox["k",
  FontSlant->"Italic"],
 " from ",
 StyleBox["obj",
  FontSlant->"Italic"],
 ")."
}], "Text",
 CellChangeTimes->{{3.55574892375367*^9, 3.5557489969319983`*^9}, {
   3.5557490732244463`*^9, 3.555749085982279*^9}, {3.555749308291521*^9, 
   3.555749394354454*^9}, {3.555750639818749*^9, 3.555750656767137*^9}, {
   3.555759846359387*^9, 3.555759846459425*^9}, {3.555765151624693*^9, 
   3.55576517054405*^9}, {3.555765216012394*^9, 3.555765231917538*^9}, 
   3.555788856636939*^9, {3.555837080438752*^9, 3.555837091393918*^9}, 
   3.719857926361224*^9, {3.719858026617935*^9, 3.719858057975539*^9}, {
   3.719865741320323*^9, 3.71986574246982*^9}, {3.7198682655013638`*^9, 
   3.719868265780978*^9}, 3.719925980350588*^9, {3.825606503119826*^9, 
   3.825606599285439*^9}, 3.911828158154406*^9, 3.911880808455462*^9, {
   3.9135441950943403`*^9, 
   3.9135441954950852`*^9}},ExpressionUUID->"44629ab8-2007-4bee-a4ca-\
5c948e891f2a"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}], TraditionalForm]],ExpressionUUID->
  "f458dad7-0f17-422a-9092-77a4876f9b3b"],
 " of symbols to use for vector and scalar variables.\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any expression contain subscripted vector points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "c65fcd9e-8d53-4645-899d-2fe6ee4b2602"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "3041fedb-ac3a-43d6-af49-3b6f662c19b0"],
 ".\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order.\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the desired focal length of the paraboloidal flasher."
}], "Text",
 CellChangeTimes->{{3.913543697760539*^9, 3.913543745801195*^9}, {
  3.913543776446087*^9, 3.9135437769189243`*^9}, {3.913543826194417*^9, 
  3.913543869643005*^9}, {3.913544236018879*^9, 
  3.913544246572777*^9}},ExpressionUUID->"0b12f41b-f9b7-45cb-9011-\
57869f396901"],

Cell["\<\
Returns: the same expression with vector variables convertex to scalar \
variables.\
\>", "Text",
 CellChangeTimes->{{3.9135442534119377`*^9, 
  3.913544268059263*^9}},ExpressionUUID->"ff152a12-d708-49eb-a694-\
cef5f5ab1c93"],

Cell["Note that we implement wrap-around indexing.", "Text",
 CellChangeTimes->{{3.719869443685957*^9, 
  3.719869458309357*^9}},ExpressionUUID->"7388f1b8-baa3-4ab1-badf-\
acd5f359e5ff"],

Cell[TextData[{
 "For paraboloidal flashers, we will still represent the deployed pattern by \
two scalar variables ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["px", 
      RowBox[{"i", ",", " ", "j"}]], ",", " ", 
     SubscriptBox["py", 
      RowBox[{"i", ",", "j"}]]}], "}"}], TraditionalForm]],ExpressionUUID->
  "e1e32dce-8363-4542-b47c-158c7fbfae13"],
 "; the third component of the 3D vector will come from applying the sag \
function to the two scalar variables."
}], "Text",
 CellChangeTimes->{{3.825675514211935*^9, 3.825675608060205*^9}, {
  3.825675657340533*^9, 
  3.825675681276762*^9}},ExpressionUUID->"3e547a97-c174-49cd-bfe4-\
0ddcf1145dc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ParaboloidalFlasherScalarize", "[", 
   RowBox[{"vars_", ",", "expr_", ",", "m_", ",", "f_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
      "ppz"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"expr", "/.", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FlasherWrapRules", "[", "p", "]"}], ",", 
          RowBox[{"FlasherWrapRules", "[", "pp", "]"}]}], "}"}], "]"}]}], "/.", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"FlasherRotation3D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["px", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["py", 
             RowBox[{"i", ",", "j"}]], ",", 
            FractionBox[
             RowBox[{
              SuperscriptBox[
               SubscriptBox["px", 
                RowBox[{"i", ",", "j"}]], "2"], "+", 
              SuperscriptBox[
               SubscriptBox["py", 
                RowBox[{"i", ",", "j"}]], "2"]}], 
             RowBox[{"4", "f"}]]}], "}"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         SubscriptBox["pp", 
          RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"FlasherRotation3D", "[", 
           RowBox[{"k", ",", "m"}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["ppx", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppy", 
             RowBox[{"i", ",", "j"}]], ",", 
            SubscriptBox["ppz", 
             RowBox[{"i", ",", "j"}]]}], "}"}]}]}]}], "}"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.555748998987959*^9, 3.555749297183679*^9}, 
   3.555749843067773*^9, {3.55574988727124*^9, 3.555749900740972*^9}, 
