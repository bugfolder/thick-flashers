Cell[TextData[{
 "MakePlanarRoundedPlateGC[",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) RoundingDivisions"
}], "Subsubsection",
 CellChangeTimes->{{3.45903787816173*^9, 3.459037923367128*^9}, {
   3.459038613348992*^9, 3.459038622496421*^9}, {3.459090778189327*^9, 
