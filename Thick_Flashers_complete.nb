Cell[TextData[{
 "Curve3DSystemPlots[",
 StyleBox["sys",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}] returns a list of plots of all of the functions returned by \
Curve3DSystem (and related functions below) over the given range."
}], "Text",
 CellChangeTimes->{{3.6911973127637253`*^9, 3.691197373210198*^9}, {
   3.691199515975259*^9, 3.691199531244247*^9}, {3.691199785482542*^9, 
