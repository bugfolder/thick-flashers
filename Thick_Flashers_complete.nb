}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Unit cyclic polygon centered twist tiles", "Subsection",
 CellChangeTimes->{{3.627330102807736*^9, 3.627330111232534*^9}, 
   3.6273307622229457`*^9, 3.627331304322135*^9, {3.627331732512074*^9, 
   3.627331733502471*^9}, 3.627385976142358*^9, {3.6286937181919622`*^9, 
   3.62869371978103*^9}, {3.629851532917125*^9, 3.62985153580304*^9}, {
   3.629899098057985*^9, 
   3.629899101664625*^9}},ExpressionUUID->"6fdabcc3-616b-4996-8e63-\
5d5f2c404a29"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.627330279077072*^9, 3.627330279707837*^9}, 
   3.627385976142639*^9},ExpressionUUID->"53d10859-ff21-4c5d-bf51-\
5b2538cd375e"],

Cell["\<\
Unit cyclic polygons are unit polygons (first two vertices at {0,0} and \
{1,0}) whose vertices are concyclic, i.e., that all lie on a common circle. \
Any cyclic polygon may be used to realize a centered twist tile. Odd-order \
polygons are specified solely by their side angles; even-order polygons \
require an additional side specifier. For consistency, we\[CloseCurlyQuote]ll \
require the side specifier for all usage, but it will be ignored for \
odd-order polygons.\
\>", "Text",
 CellChangeTimes->{{3.627330288290827*^9, 3.627330351614819*^9}, {
   3.627331314977367*^9, 3.6273313466716013`*^9}, {3.6273317414780903`*^9, 
