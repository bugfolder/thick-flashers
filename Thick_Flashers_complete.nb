Cell[TextData[{
 "BoundingBoxExtentGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] returns the bounding box extent of all the points in any \
GraphicsComplexes in the list."
}], "Text",
 CellChangeTimes->{{3.713170720331253*^9, 3.713170725005186*^9}, {
  3.713170890751145*^9, 3.713170910899473*^9}, {3.71317129081846*^9, 
