 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gg", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gg", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphicsComplex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Polygon", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], ",", 
               RowBox[{"Lighter", "[", "Red", "]"}]}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2", ",", "3", ",", "1"}], "}"}], "]"}], ",", 
               RowBox[{"Darker", "[", "Red", "]"}]}], "]"}]}], "}"}]}], "]"}],
          ",", "\[IndentingNewLine]", 
         RowBox[{"GraphicsComplex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "1"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Polygon", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], ",", 
               RowBox[{"Lighter", "[", "Green", "]"}]}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2", ",", "3", ",", "1"}], "}"}], "]"}], ",", 
               RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}]}], 
          "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"gg", ",", "\[IndentingNewLine]", 
        RowBox[{"FuzzGCs", "[", 
         RowBox[{"gg", ",", ".2"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"FuzzGCs", "[", 
         RowBox[{"gg", ",", ".2", ",", 
          RowBox[{"FuzzMethod", "\[Rule]", "FuzzByGroup"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
