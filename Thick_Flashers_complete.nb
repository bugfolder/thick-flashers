Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeUniPot", "[", 
       RowBox[{"pts", ",", "8", ",", 
        RowBox[{"CreasePatternBoundary", "\[Rule]", "Default"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PartitionedGraphicsGrid", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "CrossSection", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"Axes", "\[Rule]", "True"}], ",", 
            RowBox[{"AxesLabel", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", "\"\<CrossSection\>\""}]}], "]"}],
           ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "CreasePatternWedge", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", "\"\<CreasePatternWedge\>\""}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "FoldedFormWedge", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", "\"\<FoldedFormWedge\>\""}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "CreasePatternSplitWedge", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "PlotLabel", "\[Rule]", "\"\<CreasePatternSplitWedge\>\""}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "FoldedFormSplitWedge", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "PlotLabel", "\[Rule]", "\"\<FoldedFormSplitWedge\>\""}]}], "]"}],
           ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "CreasePattern", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", "\"\<CreasePattern\>\""}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "FoldedForm2D", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"PlotLabel", "\[Rule]", "\"\<FoldedForm2D\>\""}]}], 
           "]"}]}], "}"}], ",", "5"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
