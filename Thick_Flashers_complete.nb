Cell[CellGroupData[{

Cell[TextData[{
 "BoundingBox[",
 StyleBox["plist",
  FontSlant->"Italic"],
 "]\nBoundingBoxExtent[",
 StyleBox["plist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.628872092009747*^9, 3.62887209597517*^9}, {
