Cell[TextData[{
 "NFoldAcrossRight3D[",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D fold and the left ruling vector and constructs the full 3D \
ruled neighborhood, i.e., it adds the right ruling vector, using \
interpolating functions."
}], "Text",
