Cell[CellGroupData[{

Cell[TextData[{
 "EmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", MonolithicFoldedForm, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) StationaryFace, FaceupFace"
}], "Subsubsection",
 CellChangeTimes->{{3.630162217046954*^9, 3.630162227822011*^9}, {
  3.630162274733392*^9, 
  3.630162277754923*^9}},ExpressionUUID->"7ecfcf95-5c9b-4bc6-916d-\
dca9292e2505"],

Cell[TextData[{
 "EmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", MonolithicFoldedForm, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] joins the individual tiles together into a single TGraph2D, then returns \
the VisibleFoldedFormGraphics. Options are:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 " is passed through to FoldGraph2D.\n\tFaceupFace \[Rule] ",
 StyleBox["fuface",
  FontSlant->"Italic"],
 " is passed through to VisibleFoldedFormGraphics."
}], "Text",
 CellChangeTimes->{{3.630162240210167*^9, 
  3.63016229278596*^9}},ExpressionUUID->"bc288ad5-5cb4-467c-a032-\
56b24007b52a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbedTiling", "[", 
   RowBox[{"tiling_List", ",", "MonolithicFoldedForm", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"VisibleFoldedFormGraphics", "[", 
   RowBox[{
    RowBox[{"EmbedTiling", "[", 
     RowBox[{"tiling", ",", "MonolithicTGraph2D", ",", "opts"}], "]"}], ",", 
    "opts"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.630162298948675*^9, 3.630162335562442*^9}},
 CellLabel->
  "In[2994]:=",ExpressionUUID->"dda40b98-b82a-4a45-add5-dc19153093a5"],

