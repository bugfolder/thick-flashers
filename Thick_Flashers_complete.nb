Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]", ",", "u", ",", "v", ",", "bb", ",", "ctds", ",", "ss", ",", 
      "cc", ",", "ccc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "#"}]}], "}"}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ctds", "=", 
      RowBox[{"CanonicalTangentDevelopableSystem", "[", 
       RowBox[{"bb", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ctds", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "ss", ",", "cc"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Directrix", ",", "DevelopableSurface", ",", "CrossCurveSurface"}], 
        "}"}], "/.", "ctds"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccc", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"u", "\[LessEqual]", "v"}], ",", 
          RowBox[{"cc", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"bb", "[", "u", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"StyledCrossRuledPatch", "[", 
            RowBox[{"ccc", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "\[Pi]"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "\[Pi]"}], "}"}], ",", 
             RowBox[{"CrossLineStyle", "\[Rule]", "Purple"}], ",", 
             RowBox[{"CurveDivisions", "\[Rule]", "50"}], ",", 
             RowBox[{"CurveDivisions", "\[Rule]", "50"}]}], "]"}], "//", 
           "ReverseFillStyle"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], ",", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
