Cell[TextData[{
 "RadialAxialOrderingFn[",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a function ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "] that returns True if the line from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " cycles CCW (or CW) around ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 " (according to the option value), or, if it's purely radial, if it's \
pointed outward or inward, with the choices determined by the options. Note \
that the cyclic assignment normally dominates. If the edge has zero length, \
an error will results. Options are:\n\tRadialAxialTolerance \[Rule]  ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the tolerance on angle sine at which we switch from axial to radial \
ordering.\n\tRadialMajor \[Rule] True | False, if True, then we check the \
radial direction first. Otherwise, we check the axial direction first.\n\t\
RadialDirection \[Rule] Inward | Outward, specifies whether we point inward \
or outward.\n\tAxialDirection \[Rule] CCW | CW, specifies whether we point \
CCW or CW."
}], "Text",
 CellChangeTimes->{{3.46598999322778*^9, 3.46599017702293*^9}, {
   3.465991295068291*^9, 3.465991383580013*^9}, {3.465991417258153*^9, 
   3.465991432233163*^9}, 3.465991602336752*^9, {3.4852648912964697`*^9, 
   3.485264891992013*^9}, {3.485264950288218*^9, 3.4852649541750717`*^9}, {
   3.485265251402924*^9, 3.485265343552813*^9}, {3.485265374362547*^9, 
   3.485265381736855*^9}, {3.4852657054757223`*^9, 3.485265769330402*^9}, 
   3.485265836963141*^9, 3.591653621260026*^9, {3.592784350025042*^9, 
   3.592784362583171*^9}, {3.708342829918248*^9, 3.708342835062243*^9}, {
   3.708342990247107*^9, 
   3.70834300608712*^9}},ExpressionUUID->"ae4f7c76-5cec-4275-bc17-\
a4bd20979acf"],

