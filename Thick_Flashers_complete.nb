  3.629816555570587*^9}},ExpressionUUID->"638396f7-6bff-4737-957b-\
e2db6c5c83a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbedTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"TestTile", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"0", "\[Degree]"}], ",", "1"}], "}"}], ",", "TileVertices", ",", 
    RowBox[{"Numeric", "\[Rule]", "True"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629764304143794*^9, 3.62976434165009*^9}, {
   3.629764481065709*^9, 3.62976448280142*^9}, {3.629816561493638*^9, 
   3.629816563950538*^9}, 3.70775734648398*^9},
 CellLabel->
  "In[2804]:=",ExpressionUUID->"ab506907-88ac-4a69-aa4f-f005eb6e162c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "EmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Numeric, TileIndices, TileIndex\nEmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decorations",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Numeric, TileIndices, TileIndex"
}], "Subsubsection",
 CellChangeTimes->{{3.629763463839828*^9, 3.629763474983088*^9}, 
   3.629763565507358*^9, {3.6297645392585697`*^9, 3.629764540834864*^9}, {
   3.629764645635982*^9, 3.629764674289607*^9}, {3.629764815340341*^9, 
   3.6297648211286287`*^9}, {3.629765997895677*^9, 3.629765999764701*^9}, {
   3.629816937906046*^9, 3.629816942313608*^9}, {3.629976434025241*^9, 
   3.629976437274054*^9}},ExpressionUUID->"0d04e6e4-b45d-4df8-8c75-\
b25d5a302169"],

Cell[TextData[{
 "EmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["tiling",
  FontSlant->"Italic"],
 " of ",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 " and renders a list consisting of each ",
 StyleBox["tilespec",
  FontSlant->"Italic"],
 " rendered according to the specified decoration and options. Options are:\n\
\tTileIndices \[Rule] True | False. If True, each EmbedTile call receives the \
option TileIndex \[Rule] ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["i",
  FontSlant->"Italic"],
 " is the index of the tile in the list ",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ".\n\tNumeric \[Rule] True | False is passed through to EmbedTile.\n\tOther \
options are passed through to RenderTile."
}], "Text",
 CellChangeTimes->{{3.629763478798649*^9, 3.629763548834054*^9}, 
   3.6297645445974216`*^9, 3.6297646499973297`*^9, {3.629764974407062*^9, 
   3.6297650707127857`*^9}, {3.6298169704878197`*^9, 
   3.629816994398363*^9}},ExpressionUUID->"5493a13a-a54b-4d9e-b563-\
c38adb84db29"],

Cell["\<\
TileIndices \[Rule] True is especially useful when constructing patches of \
tilespecs that are placed relative to earlier patches using JoinTiling, see \
next.\
\>", "Text",
 CellChangeTimes->{{3.629818554505649*^9, 
  3.629818621316573*^9}},ExpressionUUID->"1542b762-a1cb-4f88-bee0-\
d7cbccb7c1c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TileIndices", "::", "usage"}], 
   "=", "\"\<TileIndices is an option to EmbedTiling that specifies whether \
to pass a unique index to each tile when embedding.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629764722017158*^9, 3.629764764684773*^9}},
 CellLabel->
  "In[2805]:=",ExpressionUUID->"9f41db15-0b18-4eb0-a991-e14d6d979a35"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TileIndex", "::", "usage"}], 
   "=", "\"\<TileIndex is an option that EmbedTiling passes down the chain to \
RenderTile if TileIndices is set to True.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629764678967298*^9, 3.629764715750798*^9}, {
  3.629764774110677*^9, 3.629764807467251*^9}},
 CellLabel->
  "In[2806]:=",ExpressionUUID->"780830e0-ccda-4c84-8cda-ea14bd05211b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "EmbedTiling", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TileIndices", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"TileIndex", "\[Rule]", "None"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.629764824881049*^9, 3.629764841681918*^9}, {
  3.629765481130352*^9, 3.6297654863930407`*^9}},
 CellLabel->
  "In[2807]:=",ExpressionUUID->"dcfe8c12-b3fe-4ed4-ba1d-9eda06d8f959"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbedTiling", "[", 
   RowBox[{"tiling_List", ",", "decoration_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ti", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ti", "=", 
      RowBox[{
       RowBox[{"TileIndices", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "EmbedTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ti", ",", "\[IndentingNewLine]", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EmbedTile", "[", 
           RowBox[{"#1", ",", "decoration", ",", "opts", ",", 
            RowBox[{"TileIndex", "\[Rule]", 
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}],
            "]"}], "&"}], ",", "tiling"}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{
         RowBox[{"EmbedTile", "[", 
          RowBox[{"#", ",", "decoration", ",", "opts"}], "]"}], "&"}], "/@", 
        "tiling"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629763816681943*^9, 3.629763833301404*^9}, {
   3.629763928324553*^9, 3.629763958753248*^9}, {3.629764504105077*^9, 
   3.629764551412094*^9}, {3.629764654186075*^9, 3.629764660574735*^9}, {
   3.629764858321*^9, 3.629764958347574*^9}, 3.629765152874086*^9},
 CellLabel->
  "In[2808]:=",ExpressionUUID->"7d2dd748-7abf-4b79-ab0e-b53addfa6049"],

Cell["Example. A tiling of two side-by-side test tiles.", "Text",
 CellChangeTimes->{{3.629765162285522*^9, 3.629765163058441*^9}, {
  3.629817060354119*^9, 
  3.629817065984975*^9}},ExpressionUUID->"ce3d30bc-f88f-425f-878f-\
b12e53203955"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "tiling", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tiling", "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"TestTile", ",", "4"}], "}"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"TestTile", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
      "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"tiling", ",", "Tiling", ",", 
        RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
     RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.629765165110379*^9, 3.629765289616952*^9}, {
  3.6297659518917*^9, 3.629765955589492*^9}},
 CellLabel->
  "In[2809]:=",ExpressionUUID->"f8804587-2d6c-4c9f-a7cc-4be733a91d08"],

Cell[TextData[{
 "EmbedTiling[",
 StyleBox["tiling, decorations, opts",
  FontSlant->"Italic"],
 "] takes a ",
 StyleBox["tilespec",
  FontSlant->"Italic"],
 " and a list decorations, and returns a list of the embeddings applied to \
each decoration, in turn."
}], "Text",
 CellChangeTimes->{{3.629976079909769*^9, 3.62997613050034*^9}, {
   3.629976198977928*^9, 3.6299762221268*^9}, 3.6299763183073483`*^9, {
   3.629976351514503*^9, 
   3.629976351918633*^9}},ExpressionUUID->"56248e3d-51dd-45b2-baf5-\
ab05ee99bd70"],

Cell["\<\
This is typically used to overlay the Tiling decoration on top of a \
CreasePattern or FoldedForm2D decoration.\
\>", "Text",
 CellChangeTimes->{
  3.629976224833114*^9, {3.62997645460842*^9, 
   3.62997647558106*^9}},ExpressionUUID->"a1f4214b-61ce-4a98-a93c-\
a32efc1aa9b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbedTiling", "[", 
   RowBox[{"tiling_List", ",", "decorations_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"EmbedTiling", "[", 
     RowBox[{"tiling", ",", "#", ",", "opts"}], "]"}], "&"}], "/@", 
   "decorations"}]}]], "Input",
 CellChangeTimes->{{3.629976144046715*^9, 3.629976173672641*^9}, {
  3.629976366809259*^9, 3.629976387985539*^9}},
 CellLabel->
  "In[2810]:=",ExpressionUUID->"024ea12a-ed51-453b-9acf-eed98cd40e98"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "JoinTiling[",
 StyleBox["tilespecs, opts",
  FontSlant->"Italic"],
 "]\n\t",
 "(options) Simplification",
 ", Numeric"
}], "Subsubsection",
 CellChangeTimes->{{3.627561210824107*^9, 3.627561239309498*^9}, {
   3.6275613322315083`*^9, 3.6275613341914186`*^9}, {3.627561390787547*^9, 
   3.627561391131172*^9}, {3.627566281993054*^9, 3.627566283454064*^9}, 
   3.627652611778785*^9, {3.627656308892335*^9, 3.627656309596377*^9}, {
   3.627656718587104*^9, 3.627656722370847*^9}, {3.628381019294182*^9, 
   3.628381020645771*^9}, {3.628623818238792*^9, 3.628623833040371*^9}, 
   3.628626016702083*^9, 3.6298163042589607`*^9, 
   3.69098844413974*^9},ExpressionUUID->"d715ecd7-c6ed-4cd2-b588-\
93426804c7fd"],

Cell[TextData[{
 "JoinTiling[",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 "] takes an ordered list of ",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 " and returns a modified list where all but the first tile are placed \
relative to earlier tiles in the list according to the ",
 StyleBox["offset",
  FontSlant->"Italic"],
 " specification for each tile. In the list, the ",
 StyleBox["offset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["scale",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 " for the first tile are left as specified, but for each subsequent tile, \
the ",
 StyleBox["offset",
  FontSlant->"Italic"],
 " for each tile is interpreted as an index list {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", ",
 StyleBox["...",
  FontSlant->"Italic"],
 "} that determines the relative placement of that tile in the returned list \
of ",
 StyleBox["tilespecs",
  FontSlant->"Italic"],
 ". The {",
 StyleBox["offset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", ",
 StyleBox["scale",
  FontSlant->"Italic"],
 "} for the each depends on the format of the entries {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", ",
 StyleBox["...",
  FontSlant->"Italic"],
 "}, as follows:\n\t{",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "} \[LongDash] the tile is offset so that the ",
 StyleBox["j",
  FontSlant->"Italic"],
 "th vertex of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th tile is the position of the ",
 StyleBox["k",
  FontSlant->"Italic"],
 "th vertex of this tile AND rotate and scale the tile so that the (",
 StyleBox["k",
  FontSlant->"Italic"],
 "\[Dash]1)th vertex of the tile comes into alignment with the (",
 StyleBox["j",
  FontSlant->"Italic"],
 "+1)th vertex of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th tile, i.e., the edges mate.\n\t{",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", \[Dash]",
 StyleBox["k",
  FontSlant->"Italic"],
 "} \[LongDash] the tile is offset so that the ",
 StyleBox["j",
  FontSlant->"Italic"],
 "th vertex of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th tile is the position of the ",
 StyleBox["k",
  FontSlant->"Italic"],
 "th vertex of this tile, but leave rotation and scale as specified.\n\t{",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", \[PlusMinus]",
 StyleBox["k",
  FontSlant->"Italic"],
 ", {",
 StyleBox["x",
  FontSlant->"Italic"],
 ",",
 StyleBox["y",
  FontSlant->"Italic"],
 "}} \[LongDash] Same thing as {",
 StyleBox["i, j, ",
  FontSlant->"Italic"],
 "\[PlusMinus]",
 StyleBox["k",
  FontSlant->"Italic"],
 "}, but add an additional offset {",
 StyleBox["x,y",
  FontSlant->"Italic"],
 "} to the position. Good for making exploded tilings."
}], "Text",
 CellChangeTimes->{{3.627561274954767*^9, 3.627561339142659*^9}, 
   3.6275613947729692`*^9, {3.62756628712967*^9, 3.627566390031665*^9}, {
   3.627567900407968*^9, 3.627567928860618*^9}, {3.627567971218025*^9, 
   3.627568193707368*^9}, {3.627568225633314*^9, 3.627568248999845*^9}, {
   3.627568302324896*^9, 3.62756836664879*^9}, {3.6275685125120792`*^9, 
   3.627568512888406*^9}, {3.627574790163975*^9, 3.627574801379142*^9}, {
   3.627575081841015*^9, 3.627575268739954*^9}, 3.627652611902614*^9, {
   3.6276534315984373`*^9, 3.627653532015896*^9}, {3.627656321596479*^9, 
   3.6276564343803263`*^9}, {3.627656737377747*^9, 3.627656745729124*^9}, {
   3.628122529632021*^9, 3.628122604745545*^9}, {3.628372681954647*^9, 
   3.628372692321825*^9}, {3.628381711386862*^9, 3.628381730112138*^9}, {
   3.628621946395875*^9, 3.628621948308395*^9}, {3.628621982591522*^9, 
   3.62862198290335*^9}, {3.628622051580263*^9, 3.6286220540338*^9}, {
   3.628622099521534*^9, 3.62862211401295*^9}, {3.628622148146983*^9, 
   3.628622181609041*^9}, {3.6286222168809986`*^9, 3.6286222266458483`*^9}, {
   3.628622346078563*^9, 3.628622347957419*^9}, {3.628622492671843*^9, 
   3.628622509262207*^9}, {3.628623085310668*^9, 3.628623097013801*^9}, {
   3.629766051853268*^9, 3.629766137637011*^9}, {3.629816280494259*^9, 
   3.6298162817407846`*^9}, {3.629976499844656*^9, 3.629976502531547*^9}, {
   3.6299765514496746`*^9, 
   3.6299767377094607`*^9}},ExpressionUUID->"62a7be5e-a859-4d5b-969c-\
2a136992639e"],

Cell[TextData[{
 "Options are:\n\tSimplification \[Rule] Automatic | None, to Simplify the \
computed offset (and, if computed, scale and rotation) at each stage. This \
helps reduce the number of distinct tiletypes when embedding.\n\tNumeric \
\[Rule] True | False. If True, make the computed {",
 StyleBox["offset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", ",
 StyleBox["scale",
  FontSlant->"Italic"],
 "} numeric. This can speed things up a lot if the TileVertices returned by \
RenderTile are symbolic and complex."
}], "Text",
 CellChangeTimes->{
  3.628122538332938*^9, {3.628372619250341*^9, 3.628372658188099*^9}, {
   3.628372719705893*^9, 3.628372741558652*^9}, {3.629817106073375*^9, 
   3.6298171332689533`*^9}, 3.6909894045331173`*^9, {3.690989454418709*^9, 
   3.690989459034376*^9}, 
   3.707757351320619*^9},ExpressionUUID->"1bfd0350-de49-4622-b23f-\
9fb7b68a53ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "JoinTiling", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Numeric", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.627656451357592*^9, 3.6276564622376146`*^9}, {
   3.628372931085683*^9, 3.628372936916684*^9}, 3.69098893878979*^9, 
   3.69098922265291*^9},
 CellLabel->
  "In[2811]:=",ExpressionUUID->"a4a4bdf3-2b18-41d3-bdfe-45c98a994a0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"JoinTiling", "::", "badoffset"}], 
   "=", "\"\<The offset `1` in tilespec `2` is improperly formatted for \
JoinTiling.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627568937907183*^9, 3.6275689752589293`*^9}, {
  3.627652611975308*^9, 3.627652612047665*^9}},
 CellLabel->
  "In[2812]:=",ExpressionUUID->"9d7e761c-3ac5-404b-8b36-9899d7a2dd01"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"JoinTiling", "[", 
    RowBox[{"{", "}"}], "]"}], ":=", 
   RowBox[{"{", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.627570741836709*^9, 3.627570749592978*^9}, 
   3.627652612079784*^9},
 CellLabel->
  "In[2813]:=",ExpressionUUID->"0e8da75c-6b6d-4e64-a281-81e7c05f8388"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JoinTiling", "[", 
   RowBox[{"tilespecs_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "nm", ",", "sfn", ",", "out", ",", "tverts", ",", "tilespec", 
      ",", "tiletype", ",", "offset", ",", "rotation", ",", "scale", ",", 
      "verts", ",", "i", ",", "j", ",", "k", ",", "aoffset"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "JoinTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nm", "=", 
      RowBox[{
       RowBox[{"Numeric", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "JoinTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "Automatic"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{"nm", ",", "N", ",", 
          RowBox[{"#", "&"}]}], "]"}], ",", "Simplify"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"out", "=", 
      RowBox[{"{", 
       RowBox[{
       "tilespecs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tverts", "=", 
      RowBox[{"{", 
       RowBox[{"EmbedTile", "[", 
        RowBox[{
         RowBox[{
         "tilespecs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         ",", "TileVertices", ",", "opts"}], "]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"tilespec", "=", 
         RowBox[{
         "tilespecs", "\[LeftDoubleBracket]", "n", 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tiletype", "=", 
         RowBox[{
         "tilespec", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"offset", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "tilespec", "]"}], "\[GreaterEqual]", 
            "2"}], ",", 
           RowBox[{
           "tilespec", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
            ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rotation", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "tilespec", "]"}], "\[GreaterEqual]", 
            "3"}], ",", 
           RowBox[{
           "tilespec", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
            ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"scale", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "tilespec", "]"}], "\[GreaterEqual]", 
            "4"}], ",", 
           RowBox[{
           "tilespec", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}],
            ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"verts", "=", 
         RowBox[{"EmbedTile", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tiletype", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}], ",", "rotation", ",", "scale"}],
             "}"}], ",", "TileVertices", ",", "opts"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"aoffset", "=", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{
           "tilespec", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
            "]"}], ",", "\[IndentingNewLine]", "3", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", "j", ",", "k"}], "}"}], "=", 
           RowBox[{
           "tilespec", "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", "4", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i", ",", "j", ",", "k", ",", "aoffset"}], "}"}], "=", 
           RowBox[{
           "tilespec", "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", "_", ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"JoinTiling", "::", "badoffset"}], ",", 
             RowBox[{
             "tilespec", "\[LeftDoubleBracket]", "2", 
              "\[RightDoubleBracket]"}], ",", "tilespec"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"k", "<", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{"offset", "=", 
           RowBox[{
            RowBox[{"sfn", "[", 
             RowBox[{
              RowBox[{"tverts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "-", 
              RowBox[{"verts", "\[LeftDoubleBracket]", 
               RowBox[{"Abs", "[", "k", "]"}], "\[RightDoubleBracket]"}]}], 
             "]"}], "+", "aoffset"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"k", ">", "0"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"scale", ",", "rotation", ",", "offset"}], "}"}], "=", 
            RowBox[{"ScaleRotationOffset", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "verts", "\[LeftDoubleBracket]", "k", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"verts", "\[LeftDoubleBracket]", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"k", "-", "1"}], ",", 
                   RowBox[{"Length", "[", "verts", "]"}], ",", "1"}], "]"}], 
                 "\[RightDoubleBracket]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tverts", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], ",", 
                RowBox[{"tverts", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", 
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{"j", "+", "1"}], ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{
                    "tverts", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "]"}], ",", "1"}], "]"}]}], 
                 "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"offset", "+=", "aoffset"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"out", ",", 
          RowBox[{"{", 
           RowBox[{"tiletype", ",", 
            RowBox[{"sfn", "[", "offset", "]"}], ",", 
            RowBox[{"sfn", "[", "rotation", "]"}], ",", 
            RowBox[{"sfn", "[", "scale", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"tverts", ",", 
          RowBox[{"sfn", "[", 
           RowBox[{"EmbedTile", "[", 
            RowBox[{
             RowBox[{"out", "\[LeftDoubleBracket]", 
              RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
             "TileVertices", ",", "opts"}], "]"}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "2", ",", 
         RowBox[{"Length", "[", "tilespecs", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "out"}]}], "]"}]}]], "Input",
