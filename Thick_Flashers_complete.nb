Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeAltMoselyPot", "[", 
       RowBox[{"pts", ",", "8", ",", 
        RowBox[{"CreasePatternBoundary", "\[Rule]", "Default"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PartitionedGraphicsGrid", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"tobj", "[", "CrossSection", "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"Axes", "\[Rule]", "True"}], ",", 
            RowBox[{"AxesLabel", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "CreasePatternSplitWedge", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "FoldedFormSplitWedge", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "CreasePattern", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "FoldedForm2D", "]"}]}], "}"}], ",", "5"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.526746491449523*^9, 3.526746531912607*^9}, {
   3.526749511086644*^9, 3.5267495113918447`*^9}, {3.526762191116682*^9, 
   3.526762232269417*^9}, {3.526762316153195*^9, 3.52676233292628*^9}, {
