  "In[894]:=",ExpressionUUID->"12eb46c1-c221-4422-803c-bacd688813cc"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DirectedEdgeArrow[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ArrowPosition, ArrowheadStyle\nDirectedEdgeArrow3D[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ArrowPosition, ArrowheadStyle\nCrossedEdgeArrow[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ArrowPosition, ArrowheadStyle"
}], "Subsubsection",
 CellChangeTimes->{{3.457615029753969*^9, 3.457615044344077*^9}, {
   3.4576152279786797`*^9, 3.45761524546196*^9}, {3.457617884857147*^9, 
   3.457617905951521*^9}, 3.457618429778756*^9, {3.457619971923822*^9, 
   3.457619983008383*^9}, {3.45771530090893*^9, 3.457715331107288*^9}, {
   3.462346440066716*^9, 3.462346441283245*^9}, {3.4659880668566017`*^9, 
   3.465988135331533*^9}, {3.533504637884431*^9, 3.533504638883978*^9}, {
   3.533504716428402*^9, 3.533504747597046*^9}, 3.533504782875819*^9, {
   3.533504818853043*^9, 3.533504820770327*^9}, {3.5930087912938538`*^9, 
   3.593008803397973*^9}, 3.593009160485783*^9, {3.7136346002519836`*^9, 
   3.713634644581491*^9}, {3.713634723125867*^9, 3.71363472554251*^9}, {
   3.713634766776098*^9, 
   3.713634768686159*^9}},ExpressionUUID->"ffa87f8e-407a-4106-9088-\
af8019124568"],

Cell[TextData[{
 "DirectedEdgeArrow[{",
 StyleBox["p1, p2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes an ordered pair of points and produces a line with an arrowhead \
somewhere along the line. "
}], "Text",
 CellChangeTimes->{{3.457619817142303*^9, 3.45761983509831*^9}, {
   3.457619990896082*^9, 3.457620040741737*^9}, {3.457715321407559*^9, 
   3.45771532186334*^9}, {3.533504611423492*^9, 3.533504612733906*^9}, 
   3.533504719972381*^9, {3.592042085820292*^9, 3.5920421013471613`*^9}, {
   3.592042138337471*^9, 3.592042180526538*^9}, {3.592505634785802*^9, 
   3.592505652773393*^9}, {3.713634646724746*^9, 
   3.7136346589152937`*^9}},ExpressionUUID->"cec1f3af-b37f-4a5c-99ad-\
b065f6369fc3"],

Cell[TextData[{
 "Options:\n\tArrowPosition \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the fractional position along the line. Default is 2/3 of the way along \
the line (offset from center to lessen collisions with labels placed in the \
middle of the line).\n\tArrowheadStyle \[Rule] Arrowheads[",
 StyleBox["spec",
  FontSlant->"Italic"],
 "], to modify the appearance of arrowheads."
}], "Text",
 CellChangeTimes->{{3.713634660957219*^9, 3.713634719467697*^9}, 
   3.713634774270912*^9},ExpressionUUID->"b87aa2ab-ee83-441a-9ba3-\
c420c71e9b6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArrowPosition", "::", "usage"}], 
   "=", "\"\<ArrowPosition is an option to DirectedEdgeArrow that specifies \
where along the arrow the arrowhead should be placed.\>\""}], ";"}]], "Input",\

