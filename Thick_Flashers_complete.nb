 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sa", ",", "da", ",", "tobj", ",", "gobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}], ",", 
        RowBox[{"120", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"da", "=", 
      RowBox[{"{", 
       RowBox[{"\[Pi]", ",", "\[Pi]", ",", 
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertexFromAngles", "[", 
       RowBox[{"sa", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gobj", "=", 
      RowBox[{"MakeCircularVertexGraph", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"CircleRadius", "\[Rule]", "2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", 
       RowBox[{"gobj", ",", 
        RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gobj", "//", "GetAllRules"}], "//", "ColumnForm"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594942925277827*^9, 3.594942996431424*^9}, {
   3.597505270791439*^9, 3.597505341487801*^9}, 3.597507172941624*^9, 
