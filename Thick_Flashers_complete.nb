Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRotationalMesh", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"RadialEdgeFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"U", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AxialEdgeFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"U", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"BorderOverride", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"IncludeCenter", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.59405784098194*^9, 3.594057861550724*^9}, {
   3.594058559826043*^9, 3.594058560353491*^9}, 3.5940600373287573`*^9, 
   3.594060277256015*^9, {3.594060500238233*^9, 3.594060514732399*^9}, {
   3.594069024169704*^9, 3.594069024767197*^9}, 3.594069770137028*^9, 
   3.594070880368834*^9, {3.594070944270447*^9, 3.594070960367315*^9}, 
   3.595286134816149*^9, 3.617444346713683*^9, 3.617444405324708*^9},
 CellLabel->
  "In[2086]:=",ExpressionUUID->"7d4a67a7-aa06-47ad-9908-97208c218ef9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRotationalMesh", "[", 
   RowBox[{
    StyleBox["nr_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["na_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["vfn_",
     FontSlant->"Italic"], ",", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{
      StyleBox["erfn",
       FontSlant->"Italic"], 
      StyleBox[",",
       FontSlant->"Italic"], 
      StyleBox["eafn",
       FontSlant->"Italic"], 
      StyleBox[",",
       FontSlant->"Italic"], "bo", ",", "ic", ",", "verts", ",", "edges", ",",
       "types", ",", "vifn"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      StyleBox["erfn",
       FontSlant->"Italic"], "=", 
      RowBox[{
       RowBox[{"RadialEdgeFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRotationalMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      StyleBox["eafn",
       FontSlant->"Italic"], "=", 
      RowBox[{
       RowBox[{"AxialEdgeFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRotationalMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bo", "=", 
      RowBox[{
       RowBox[{"BorderOverride", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRotationalMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ic", "=", 
      RowBox[{
       RowBox[{"IncludeCenter", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRotationalMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"edges", "=", 
       RowBox[{"types", "=", 
        RowBox[{"{", "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "vifn", " ", "is", " ", "a", " ", "lookup", " ", "function", " ", 
       "that", " ", "maps", " ", "from", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], " ", "to", " ", "index", " ", 
       "within", " ", "verts"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ic", ",", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"verts", ",", 
          RowBox[{"vfn", "[", 
           RowBox[{"0", ",", "0"}], "]"}]}], "]"}], ";", 
        RowBox[{
         RowBox[{"vifn", "[", 
          RowBox[{"0", ",", "_"}], "]"}], "=", 
         RowBox[{"Length", "[", "verts", "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"verts", ",", 
          RowBox[{"vfn", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ";", 
        RowBox[{
         RowBox[{"vifn", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "=", 
         RowBox[{"Length", "[", "verts", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "na"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nr"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{"radial", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"vifn", "[", 
             RowBox[{"i", ",", "j"}], "]"}], ",", 
            RowBox[{"vifn", "[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "j"}], "]"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", 
          RowBox[{"erfn", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "na"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"If", "[", 
          RowBox[{"ic", ",", "0", ",", "1"}], "]"}], ",", 
         RowBox[{"nr", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"axial", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"vifn", "[", 
             RowBox[{"i", ",", "j"}], "]"}], ",", 
            RowBox[{"vifn", "[", 
             RowBox[{"i", ",", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"j", "+", "1"}], ",", "na", ",", "1"}], "]"}]}], 
             "]"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"i", "\[Equal]", "nr"}], "&&", "bo"}], ",", "B", ",", 
            RowBox[{"eafn", "[", 
             RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "na"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nr"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"MakeTGraphAssigned", "[", 
      RowBox[{"verts", ",", "edges", ",", 
       RowBox[{"{", "}"}], ",", "types"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594057570959494*^9, 3.59405763957716*^9}, {
   3.5940578645850153`*^9, 3.594057897900075*^9}, {3.594058030357136*^9, 
   3.59405813645634*^9}, {3.594058168402792*^9, 3.594058198622306*^9}, {
   3.594058249806251*^9, 3.594058253933957*^9}, {3.594058503604554*^9, 
   3.594058510932124*^9}, {3.594058569639977*^9, 3.594058572462834*^9}, {
   3.594058807065598*^9, 3.594058848702935*^9}, {3.594059208423353*^9, 
   3.594059214477545*^9}, {3.59406003736835*^9, 3.594060037402227*^9}, 
   3.594060278355173*^9, {3.594060561732745*^9, 3.594060594645953*^9}, {
   3.594060641131922*^9, 3.594060649815038*^9}, 3.5940606860514793`*^9, 
   3.594060859444244*^9, {3.594060903562313*^9, 3.5940609515854893`*^9}, {
   3.594061242158516*^9, 3.594061251331295*^9}, {3.594061527738914*^9, 
   3.594061578053875*^9}, {3.59406170845802*^9, 3.594061757234386*^9}, {
   3.594061812592503*^9, 3.594061847765159*^9}, {3.59406195899518*^9, 
   3.594061959279972*^9}, {3.594062003878045*^9, 3.5940620281237307`*^9}, {
   3.59406210132955*^9, 3.594062455369514*^9}, {3.5940625056783047`*^9, 
   3.5940625750466547`*^9}, {3.59406261207612*^9, 3.594062652937852*^9}, {
   3.594062694824216*^9, 3.594062780477483*^9}, {3.594062813792965*^9, 
   3.5940628290689707`*^9}, {3.594062884924213*^9, 3.594063084967505*^9}, {
   3.594067874901573*^9, 3.5940679925033493`*^9}, {3.594068034513093*^9, 
   3.594068101095314*^9}, {3.594068134182342*^9, 3.594068137407579*^9}, {
   3.594068180487454*^9, 3.594068402068212*^9}, {3.594068432258604*^9, 
   3.5940684614963503`*^9}, {3.594068498578582*^9, 3.5940686520548143`*^9}, {
   3.594068711649233*^9, 3.594068857907714*^9}, {3.594068895089642*^9, 
   3.594068953350709*^9}, {3.594069037013071*^9, 3.594069066170467*^9}, {
   3.594069770381727*^9, 3.59406977084534*^9}, 3.5940708803998423`*^9, {
   3.594070967348268*^9, 3.594070994018501*^9}, {3.594071026124893*^9, 
   3.594071027489981*^9}, {3.594072342399407*^9, 3.594072342503373*^9}, 
   3.594734558469129*^9, {3.595286134864878*^9, 3.595286134999291*^9}, {
   3.617444346969591*^9, 3.617444347974736*^9}, {3.617444405577856*^9, 
   3.617444406275735*^9}},
 CellLabel->
  "In[2087]:=",ExpressionUUID->"ddba5d4f-f8c6-4bd4-9299-b636fe973247"],

Cell["\<\
Example: no center, no border override, default (unassigned) creases.\
\>", "Text",
 CellChangeTimes->{{3.594069004888036*^9, 3.594069014478067*^9}, {
