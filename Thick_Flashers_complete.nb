Cell[BoxData[
 RowBox[{
  RowBox[{"ReassignGraphAssigned", "[", 
   RowBox[{"tobj_TObj", ",", "foldangles_List", ",", " ", "opts___"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mnfa", ",", "mxfa", ",", "types"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph", ",", "TAssigned"}], "}"}], ",", 
       "ReassignGraphAssigned"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mnfa", "=", 
      RowBox[{
       RowBox[{"TypeMinimumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAngleToType", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mxfa", "=", 
      RowBox[{
       RowBox[{"TypeMaximumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ReassignGraphAssigned", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"tobj", "[", "EdgeTypes", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "types", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "===",
             "B"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{
          "types", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
              "foldangles", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], "]"}], "<", "mnfa"}], ",", "U", ",", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
              "foldangles", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], "]"}], ">", "mxfa"}], ",", 
            RowBox[{
            "types", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{
             "foldangles", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}], ">", "0"}], ",", "V", ",", "True", ",",
             "M"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "types", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertyIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"EdgeTypes", "\[Rule]", "types"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.594310128823435*^9, 3.594310170096387*^9}, {
   3.594310351668508*^9, 3.59431056638522*^9}, {3.594311016763388*^9, 
