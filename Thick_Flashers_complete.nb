Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Sigma]", ",", "\[Psi]", ",", "\[Theta]", ",", "bb", ",", "dd", ",", 
      "ui", ",", "bi", ",", "uui", ",", "di", ",", "\[Beta]", ",", "b", ",", 
      "d", ",", "s", ",", "u0", ",", "u1", ",", "v0", ",", "v1", ",", "cc", ",",
       "c"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"a", " ", "cone"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "#", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "initial", " ", "conditions", " ", "that", " ", "put", " ", "the", " ",
         "surface", " ", "in", " ", "the", " ", "s"}], "-", 
       RowBox[{"y", " ", "plane"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "bi", ",", "di", ",", "uui"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "desired", " ", "normal", " ", "curvature", " ", "to", " ", "achieve", " ",
        "flatness"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], "=", 
      RowBox[{"ReshapeCone3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}], ",", "\[Beta]", ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bi", ",", "di", ",", "uui"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "FullSimplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Theta]", ">", "0"}], ",", 
           RowBox[{"\[Theta]", "<", 
            RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"print", " ", "the", " ", "functions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<b = \>\"", ",", 
       RowBox[{"b", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<d = \>\"", ",", 
       RowBox[{"d", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"plot", " ", "range"}], ",", " ", 
       RowBox[{"note", " ", "sign", " ", "of", " ", "v"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "\[Equal]", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"pick", " ", "a", " ", "value", " ", "of", " ", "\[Theta]"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "a", " ", "directed", " ", "cross", " ", "curve"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"bb", "[", "s", "]"}], "+", " ", 
         RowBox[{"dd", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"b", "[", "s", "]"}], "+", " ", 
         RowBox[{"d", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"bb", ",", "dd", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"StyledCurve", "[", 
               RowBox[{"cc", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"b", ",", "d", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"StyledCurve", "[", 
               RowBox[{"c", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
