Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"csys", ",", "plots", ",", "u0", ",", "u1"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"csys", "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Curve2D", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "#1", "]"}], ",", 
            RowBox[{"Sin", "[", "#1", "]"}]}], "}"}], "&"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Speed2D", "\[Rule]", 
