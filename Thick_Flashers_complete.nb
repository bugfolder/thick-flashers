Cell[CellGroupData[{

Cell["MakeHexagonVertex[\[Theta]]", "Subsubsection",
 CellChangeTimes->{{3.7196176516819572`*^9, 
  3.719617735339109*^9}},ExpressionUUID->"82792a80-dab5-4394-a0c7-\
e68545262396"],

Cell["\<\
MakeHexagonVertex[\[Theta]] creates a representation of a partially folded \
hexagon vertex with rotational symmetry about the z axis.\
\>", "Text",
 CellChangeTimes->{{3.71961772478694*^9, 
  3.719617865187341*^9}},ExpressionUUID->"af2df744-280f-42a2-b758-\
9f1ae24475a0"],

Cell["\<\
Arguments:
\t\[Theta] \[LongDash] the elevation angle of the first vertex of the \
hexagon, between -\[Pi]/2 and \[Pi]/2. \[Theta]=0 is unfolded flat.\
\>", "Text",
 CellChangeTimes->{{3.719617809345761*^9, 3.71961785006718*^9}, {
  3.71961805691591*^9, 3.7196180642436643`*^9}, {3.7196186351327333`*^9, 
  3.719618639924376*^9}},ExpressionUUID->"2ca99ea7-0893-49fc-9cfb-\
25a60822020b"],

Cell["Returns a TGraph3DAssigned of the vertex.", "Text",
 CellChangeTimes->{{3.719617852706065*^9, 
  3.71961788058715*^9}},ExpressionUUID->"cd3900c5-bc66-4360-acf3-\
e21da9477aec"],

Cell["\<\
The values arise from an analytic solution of the vertex coordinates and \
angles.\
\>", "Text",
 CellChangeTimes->{{3.719618916708534*^9, 
  3.719618955780693*^9}},ExpressionUUID->"0f9b1978-fa7c-4430-8ad1-\
245dd9910089"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeHexagonVertex", "[", "\[Theta]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "v1", ",", "\[Psi]", ",", "v2", ",", "rm", ",",
       "types", ",", "verts3d", ",", "foldangles", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"U", "[", 
           RowBox[{"i", " ", 
            RowBox[{"\[Pi]", "/", "3"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "5"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Theta]", ">", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "V", ",", "M", ",", "V", ",", "M", ",", "V", ",", "M", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Theta]", "<", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "M", ",", "V", ",", "M", ",", "V", ",", "M", ",", "V", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}], ",", 
        "\[IndentingNewLine]", "True", ",", 
        RowBox[{"{", 
         RowBox[{
         "U", ",", "U", ",", "U", ",", "U", ",", "U", ",", "U", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"v1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", "0", ",", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v2", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Psi]", "]"}], ",", "0", ",", 
         RowBox[{"Sin", "[", "\[Psi]", "]"}]}], "}"}], "/.", 
       RowBox[{"\[Psi]", "\[Rule]", 
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "-", 
             RowBox[{
              SqrtBox["3"], " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
          RowBox[{
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
           RowBox[{"2", " ", 
            SqrtBox["3"], " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}]], "]"}]}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rm", "[", "i_", "]"}], ":=", 
      RowBox[{"RotationZMatrix3D", "[", 
       RowBox[{"i", " ", 
        RowBox[{"\[Pi]", "/", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "v1", ",", 
        RowBox[{
         RowBox[{"rm", "[", "1", "]"}], ".", "v2"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "2", "]"}], ".", "v1"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "3", "]"}], ".", "v2"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "4", "]"}], ".", "v1"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "5", "]"}], ".", "v2"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"MakeTGraph", "[", 
            RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], 
          "//", 
          RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
         RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}], "//", 
        "RecalcFoldAngles"}], "//", 
       RowBox[{"TweakFoldAngles", "[", "types", "]"}]}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.719617885150926*^9, 3.71961804356772*^9}, {
   3.719618075362845*^9, 3.7196181855239573`*^9}, {3.7196186263833103`*^9, 
   3.719618683701773*^9}, {3.719618717100718*^9, 3.7196187975502*^9}, 
   3.719618971532102*^9, {3.719619015902115*^9, 3.719619115702297*^9}, {
   3.719619147942467*^9, 3.7196191845185137`*^9}, 3.719619372513517*^9},
 CellLabel->
  "In[2379]:=",ExpressionUUID->"82007e81-1f9d-4c91-a9ac-b2f9c61a93bd"],

