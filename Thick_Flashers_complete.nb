Cell["\<\
Example. A helix. Show one branch by using a clipped cross curve function.\
\>", "Text",
 CellChangeTimes->{{3.689808458803507*^9, 3.689808464104303*^9}, {
  3.689846296058254*^9, 3.689846300751584*^9}, {3.69049296894634*^9, 
