Cell["\<\
There is no 3D version of CrossedEdgeArrow because there is no preferred \
orientation in 3D for a side-directed arrow.\
\>", "Text",
 CellChangeTimes->{{3.593008911270054*^9, 
  3.5930089322997212`*^9}},ExpressionUUID->"7f2aa8cb-0703-4427-9383-\
c3f314b159e0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "StdVertexLabels[",
 StyleBox["verts, opts",
  FontSlant->"Italic"],
 "]\n\t(options) VertexLetter\nStdEdgeLabels[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges, opts",
  FontSlant->"Italic"],
 "]\n\t(options) EdgeLetter\nStdFaceLabels[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["polys, opts",
  FontSlant->"Italic"],
 "]\n\t(options) ",
 "FaceLetter"
}], "Subsubsection",
 CellChangeTimes->{
  3.533504830220548*^9, {3.533505043844378*^9, 3.53350509011469*^9}, {
   3.591824141628675*^9, 
   3.591824159447543*^9}},ExpressionUUID->"ddbe7414-af9e-4a68-a43a-\
8efc2c35f9a5"],

Cell[TextData[{
 "StdVertexLabels[",
 StyleBox["verts, opts",
  FontSlant->"Italic"],
 "] takes a list of coordinate values ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " and puts dots and labels of the form ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "9f9c10bb-bc1f-4014-a92e-5bbc53200122"],
 " where ",
 StyleBox["i",
  FontSlant->"Italic"],
 " is the index of the point in ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.465988289609704*^9, 3.4659883303820143`*^9}, 
   3.533505043896391*^9, 
   3.722262447718112*^9},ExpressionUUID->"a417bfd4-c60a-410e-89af-\
4fab9b119539"],

Cell[TextData[{
 "Options :\n\tVertexLetter \[Rule] ",
 StyleBox["vl",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["vl",
  FontSlant->"Italic"],
 " is a single letter that will be subscripted to denote the vertex."
}], "Text",
 CellChangeTimes->{{3.722262449655723*^9, 
  3.722262453570798*^9}},ExpressionUUID->"70b00ee0-5b4a-4412-a699-\
ad461db77883"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VertexLetter", "::", "usage"}], 
   "=", "\"\<VertexLetter is an option to StdVertexLabels that specifies the \
letter used to label vertices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591721110479809*^9, 3.5917211333918943`*^9}},
 CellLabel->
  "In[907]:=",ExpressionUUID->"e9cc452d-4549-40f3-9fba-7b5c2e866482"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StdVertexLabels", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"VertexLetter", "\[Rule]", "\"\<v\>\""}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
