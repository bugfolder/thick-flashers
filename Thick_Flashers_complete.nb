Cell[TextData[{
 "CollinearCleanupGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) CollinearTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.7078529020662317`*^9, 3.707852936685115*^9}, {
   3.707852967625194*^9, 3.7078529680667977`*^9}, {3.707853164339879*^9, 
