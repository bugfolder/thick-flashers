 CellChangeTimes->{{3.73119042139404*^9, 3.731190500486322*^9}, 
   3.731190579511966*^9, {3.7311909712087393`*^9, 3.731190976510544*^9}, {
   3.731191140966232*^9, 3.731191164808674*^9}, 3.731191285801035*^9, 
   3.731191555354146*^9, 3.731191589937533*^9, 3.731191715243465*^9, 
   3.731192012426035*^9},
 CellLabel->
  "In[2541]:=",ExpressionUUID->"03e7239f-f3e0-4aa6-b838-3be49dc4b8d5"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Semi-generalized Miura-ori", "Subsection",
 CellChangeTimes->{{3.642623712812799*^9, 
  3.642623717518673*^9}},ExpressionUUID->"7b492a43-33ee-4bf6-bd38-\
8d959c04a587"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.64262371979174*^9, 
  3.642623720264039*^9}},ExpressionUUID->"f1a04367-3923-4954-aaba-\
005bdc2c3723"],

Cell["\<\
A semi-generalized Miura-ori has an arbitrary pattern in one direction, but \
is periodic in the other direction.\
\>", "Text",
 CellChangeTimes->{{3.642623729725181*^9, 
  3.642623757442253*^9}},ExpressionUUID->"395c30af-ddd6-4d94-b7fa-\
0e0fbfe0a8a9"],

Cell["\<\
This is to be distinguished from Tachi\[CloseCurlyQuote]s (fully) generalized \
Miura-ori, which has no periodicity in either direction.\
\>", "Text",
 CellChangeTimes->{{3.642623762725019*^9, 
  3.642623781286355*^9}},ExpressionUUID->"6014cfce-67f0-45c1-8423-\
4d4007f822d5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeSemigeneralizedMiuraOriA[",
 StyleBox["alist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw",
  FontSlant->"Italic"],
 ", \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.642624398398085*^9, {3.642624621969589*^9, 3.642624622352464*^9}, 
   3.642684776997446*^9, 
   3.643289329471752*^9},ExpressionUUID->"77638d5c-c366-4caf-ab61-\
7d37ef19c745"],

Cell[TextData[{
 "MakeSemigeneralizedMiuraOriA[",
 StyleBox["alist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", nw, \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a TGraph3D+TAssigned that represents a semi-generalized Miura-ori \
(periodic in only one direction) where\n\t",
 StyleBox["alist",
  FontSlant->"Italic"],
 " is the list of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "1ad59e07-e234-4fcd-ace4-e974e60e0c87"],
 " sector angles at each of the vertices along a single strip. If the first \
and last values are 90\[Degree], the left and right edges of the crease \
pattern will be vertical lines.\n\t",
 StyleBox["dlist",
  FontSlant->"Italic"],
 " are the distances between vertices in odd-numbered rows.\n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of each strip, which is paired with its mirror image.\n\t",
 StyleBox["nw",
  FontSlant->"Italic"],
 " is the number of pair repetitions across the width.\n\t\[Gamma] is the \
initial minor fold angle at the bottom left. All horizontal fold angles are \
\[PlusMinus]\[Gamma].\nOptions are:\n\tOptions[FoldGraph3D] are passed \
through to FoldGraph."
}], "Text",
 CellChangeTimes->{{3.642623914001541*^9, 3.642624007455812*^9}, {
   3.642624048971643*^9, 3.64262432762982*^9}, {3.6426246264166813`*^9, 
   3.642624629528961*^9}, 3.642684777155979*^9, {3.642684901145855*^9, 
   3.642684903322782*^9}, {3.643289330174147*^9, 3.643289330912687*^9}, {
   3.643289401671894*^9, 3.64328941014102*^9}, {3.701641297384182*^9, 
   3.701641319335945*^9}, {3.701641389888349*^9, 
   3.7016414012727957`*^9}},ExpressionUUID->"08afaa80-8669-4fa8-9987-\
3c4b377a87f8"],

Cell["\<\
Returns: a TGraph3D+TAssigned that describes the crease pattern and folded \
form.\
\>", "Text",
 CellChangeTimes->{{3.9227293242980347`*^9, 
  3.922729342938485*^9}},ExpressionUUID->"4d4b536a-6670-4ddd-b3e6-\
3b470cb3a95f"],

Cell[TextData[{
 "Note that we must have Length[",
 StyleBox["alist",
  FontSlant->"Italic"],
 "] = 1 + Length[",
 StyleBox["dlist",
  FontSlant->"Italic"],
 "]."
}], "Text",
 CellChangeTimes->{{3.701641324944141*^9, 
  3.701641343639689*^9}},ExpressionUUID->"d8ad359f-f7d9-4e27-9674-\
a0c0e5651ad5"],

Cell[TextData[{
 "You can\[CloseCurlyQuote]t include any 90\[Degree] angles in ",
 StyleBox["alist",
  FontSlant->"Italic"],
 " other than first and last elements because that makes the crease \
assignment ambiguous."
}], "Text",
 CellChangeTimes->{{3.642624766957886*^9, 
  3.642624795491238*^9}},ExpressionUUID->"9397c648-a78a-4695-befa-\
345dd86ac86a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSemigeneralizedMiuraOriA", "::", "badangs"}], 
   "=", "\"\<Angle list `1` contains invalid angles.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.642624810883453*^9, 3.64262488242508*^9}, {
   3.642626306750924*^9, 3.642626308702286*^9}, 3.642684777184325*^9},
 CellLabel->
  "In[2542]:=",ExpressionUUID->"685c2d09-2b99-4389-b506-8218bee637f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSemigeneralizedMiuraOriA", "::", "badlens"}], 
   "=", "\"\<Angle list `1` of length `2` should be 1 element longer than \
distance list `3` of length `4`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.642624557394478*^9, 3.642624590297983*^9}, {
   3.642624638024995*^9, 3.642624638849588*^9}, 3.642684777206377*^9},
 CellLabel->
  "In[2543]:=",ExpressionUUID->"224ea470-d2bb-4a68-b746-0c17897c7af0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSemigeneralizedMiuraOriA", "[", 
   RowBox[{
   "alist_List", ",", "dlist_List", ",", "w_", ",", "nw_", ",", "\[Gamma]_", ",",
     "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "na", ",", "nd", ",", "rlist", ",", "vfn", ",", "hetfn", ",", "vetfn", ",",
       "tobj", ",", "foldangles", ",", "types", ",", "ei", ",", "gm"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"na", "=", 
      RowBox[{"Length", "[", "alist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nd", "=", 
      RowBox[{"Length", "[", "dlist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "alist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[LessEqual]",
            "0"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", "\[NotEqual]", "1"}], "&&", 
            RowBox[{"i", "\[NotEqual]", "na"}], "&&", 
            RowBox[{
             RowBox[{
             "alist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "\[Equal]", 
             RowBox[{"90", "\[Degree]"}]}]}], ")"}], "||", 
          RowBox[{
           RowBox[{
           "alist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ">", 
           RowBox[{"180", "\[Degree]"}]}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"MakeSemigeneralizedMiuraOriA", "::", "badangs"}], ",", 
            "alist"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "na"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "alist", "]"}], "\[NotEqual]", 
        RowBox[{
         RowBox[{"Length", "[", "dlist", "]"}], "+", "1"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeSemigeneralizedMiuraOriA", "::", "badlens"}], ",", 
          "alist", ",", "na", ",", "dlist", ",", "nd"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"rlist", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", "dlist"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "distances", " ", "down", " ", "middle", " ", "of", " ", "each", " ", 
       "strip"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rlist", "\[LeftDoubleBracket]", 
          RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"j", " ", "w"}]}], "}"}], " ", "+", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", "j", "]"}], ",", 
           RowBox[{"w", " ", 
            RowBox[{"Cot", "[", 
             RowBox[{"alist", "\[LeftDoubleBracket]", 
              RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "]"}]}], ",",
            "0"}], "]"}], ",", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Xor", "[", 
         RowBox[{
          RowBox[{"EvenQ", "[", 
           RowBox[{"i", "+", "j"}], "]"}], ",", 
          RowBox[{"\[Gamma]", ">", "0"}]}], "]"}], ",", "V", ",", "M"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Xor", "[", 
         RowBox[{
          RowBox[{"EvenQ", "[", "i", "]"}], ",", 
          RowBox[{
           RowBox[{"alist", "\[LeftDoubleBracket]", 
            RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], ">", 
           RowBox[{"90", "\[Degree]"}]}], ",", 
          RowBox[{"\[Gamma]", ">", "0"}]}], "]"}], ",", "V", ",", "M"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeRectangularQuadMesh", "[", 
        RowBox[{"nd", ",", 
         RowBox[{"2", "nw"}], ",", "vfn", ",", 
         RowBox[{"HorizontalEdgeTypeFn", "\[Rule]", "hetfn"}], ",", 
         RowBox[{"VerticalEdgeTypeFn", "\[Rule]", "vetfn"}], ",", 
         RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"tobj", "[", "EdgeTypes", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ei", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"horizontal", " ", "edges"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ei", "++"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"index", " ", "of", " ", "the", " ", "edge"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"j", "\[Equal]", "0"}], "||", 
             RowBox[{"j", "\[Equal]", 
              RowBox[{"2", " ", "nw"}]}]}], ",", "0", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"Xor", "[", 
               RowBox[{
                RowBox[{"EvenQ", "[", 
                 RowBox[{"i", "+", "j"}], "]"}], ",", 
                RowBox[{"\[Gamma]", ">", "0"}]}], "]"}], ",", 
              RowBox[{"Abs", "[", "\[Gamma]", "]"}], ",", 
              RowBox[{"-", 
               RowBox[{"Abs", "[", "\[Gamma]", "]"}]}]}], "]"}]}], "]"}]}], 
         "]"}], ";", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"ei", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], "//", "Hold"}], ")"}]}],
        "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", 
         RowBox[{"2", "nw"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"nd", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"vertical", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ei", "++"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"index", " ", "of", " ", "the", " ", "edge"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"gm", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"2", " ", 
           RowBox[{"ArcCot", "[", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"alist", "\[LeftDoubleBracket]", 
               RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "]"}], 
             RowBox[{"Cot", "[", 
              RowBox[{"\[Gamma]", "/", "2"}], "]"}]}], "]"}]}], "]"}]}], ";", 
        
        RowBox[{"(*", " ", 
         RowBox[{
         "magnitude", " ", "of", " ", "major", " ", "fold", " ", "angle"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"i", "\[Equal]", "0"}], "||", 
             RowBox[{"i", "\[Equal]", "nd"}]}], ",", "0", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"Xor", "[", 
               RowBox[{
                RowBox[{"EvenQ", "[", "i", "]"}], ",", 
                RowBox[{
                 RowBox[{"alist", "\[LeftDoubleBracket]", 
                  RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], ">", 
                 RowBox[{"90", "\[Degree]"}]}], ",", 
                RowBox[{"\[Gamma]", ">", "0"}]}], "]"}], ",", "gm", ",", 
              RowBox[{"-", "gm"}]}], "]"}]}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"ei", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], "//", "Hold"}], ")"}]}],
        "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", 
         RowBox[{
          RowBox[{"2", "nw"}], "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nd"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "we", " ", "implement", " ", "a", " ", "trick", " ", "here", " ", "to",
         " ", "take", " ", "advantage", " ", "of", " ", "the", " ", 
        RowBox[{"periodicity", ".", " ", "Instead"}], " ", "of", " ", 
        "folding", " ", "the", " ", "entire", " ", "structure"}], ",", " ", 
       RowBox[{
       "we", " ", "fold", " ", "a", " ", "single", " ", "strip", " ", "and", " ",
         "then", " ", "use", " ", "its", " ", "vertex", " ", "coordinates", " ",
         "to", " ", "assign", " ", "the", " ", "rest", " ", "of", " ", "the", 
        " ", 
        RowBox[{"vertices", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"nw", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FoldGraph3D", "[", 
        RowBox[{"tobj", ",", "foldangles", ",", "opts"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "tobj1", ",", "verts3d1", ",", "ci1", ",", "dv", ",", "verts3d"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tobj1", "=", 
           RowBox[{"MakeSemigeneralizedMiuraOriA", "[", 
            RowBox[{
            "alist", ",", "dlist", ",", "w", ",", "1", ",", "\[Gamma]", ",", 
             "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"verts3d1", ",", "ci1"}], "}"}], "=", 
           RowBox[{"GetValues", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"{", 
              RowBox[{"Vertices3D", ",", "CornerIndices"}], "}"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"dv", "=", 
           RowBox[{
            RowBox[{"verts3d1", "\[LeftDoubleBracket]", 
             RowBox[{"ci1", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{"verts3d1", "\[LeftDoubleBracket]", 
             RowBox[{"ci1", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{"periodicity", " ", "vector"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"verts3d", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"verts3d", ",", 
              RowBox[{
               RowBox[{"verts3d1", "\[LeftDoubleBracket]", 
                RowBox[{"1", "+", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"k", "-", "1"}], ")"}], ",", 
                   RowBox[{"2", "na"}]}], "]"}]}], "\[RightDoubleBracket]"}], 
               "+", 
               RowBox[{"dv", " ", 
                RowBox[{"Floor", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"k", "-", "1"}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"2", "na"}], ")"}]}], "]"}]}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"na", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", "nw"}], "+", "1"}], ")"}]}]}], "}"}]}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"tobj", "//", 
           RowBox[{"AddTGraph3D", "[", 
            RowBox[{"verts3d", ",", "foldangles"}], "]"}]}]}]}], 
        "\[IndentingNewLine]", "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.642624405410285*^9, 3.642624426469433*^9}, {
