Cell[CellGroupData[{

Cell["BLB vertex conditions", "Subsection",
 CellChangeTimes->{{3.594079714850933*^9, 3.594079721890139*^9}, {
  3.594300928733551*^9, 
  3.594300935040696*^9}},ExpressionUUID->"d5fce4c9-6d38-49ae-8de1-\
dd4cf4d3bae0"],

Cell[CellGroupData[{

Cell[TextData[{
 "CheckVertexAgainstAssignment[",
 StyleBox["v, p1, p2, p3, p4",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.5940797496811132`*^9, 
  3.594079754983488*^9}},ExpressionUUID->"ce5424bf-f01c-4d3b-8a41-\
64380303ede2"],

Cell[TextData[{
 "CheckVertexAgainstAssignment[",
 StyleBox["v, p1, p2, p3, p4",
  FontSlant->"Italic"],
 "] checks the fold angles around a vertex against its crease assignment, \
where v is the vertex in question; p1\[Dash]p4 are the adjacent vertices \
around v in CCW order; and p1 is the \"odd\" crease. It returns a list {",
 StyleBox["tf, a1, a2, a3, a4",
  FontSlant->"Italic"],
 "}, where ",
 StyleBox["tf",
  FontSlant->"Italic"],
 " is either True (if the vertex satisfies condition) or False if it doesn't, \
followed by the CCW angles from each vertex to the next vertex."
}], "Text",
 CellChangeTimes->{{3.594079763535037*^9, 
  3.594079782414337*^9}},ExpressionUUID->"8026137d-6a8b-4971-8f7c-\
4c7940a9fab1"],

Cell["This is a utility routine used in MakeRingTessellation.", "Text",
 CellChangeTimes->{{3.594301006364286*^9, 3.59430106311298*^9}, {
  3.594740790186428*^9, 
  3.594740801761611*^9}},ExpressionUUID->"1993103e-1199-468e-a8eb-\
2ff2f61224d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CheckVertexAgainstAssignment", "[", 
   RowBox[{"v_", ",", "p1_", ",", "p2_", ",", "p3_", ",", "p4_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a1", "=", 
        RowBox[{"Rangle", "[", 
         RowBox[{"v", ",", "p1", ",", "p2"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"a2", "=", 
        RowBox[{"Rangle", "[", 
         RowBox[{"v", ",", "p2", ",", "p3"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"a3", "=", 
        RowBox[{"Rangle", "[", 
         RowBox[{"v", ",", "p3", ",", "p4"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"a4", "=", 
        RowBox[{"Rangle", "[", 
         RowBox[{"v", ",", "p4", ",", "p1"}], "]"}]}]}], 
      "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a1", "=", 
       RowBox[{"RotationAngle", "[", 
        RowBox[{
         RowBox[{"p1", "-", "v"}], ",", 
         RowBox[{"p2", "-", "v"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"a2", "=", 
       RowBox[{"RotationAngle", "[", 
        RowBox[{
         RowBox[{"p2", "-", "v"}], ",", 
         RowBox[{"p3", "-", "v"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"a3", "=", 
       RowBox[{"RotationAngle", "[", 
        RowBox[{
         RowBox[{"p3", "-", "v"}], ",", 
         RowBox[{"p4", "-", "v"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"a4", "=", 
       RowBox[{"RotationAngle", "[", 
        RowBox[{
         RowBox[{"p4", "-", "v"}], ",", 
         RowBox[{"p1", "-", "v"}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"a1", ",", "a4"}], "]"}], "\[LessEqual]", 
       RowBox[{"Min", "[", 
        RowBox[{"a2", ",", "a3"}], "]"}]}], ",", "a1", ",", "a2", ",", "a3", ",",
       "a4"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.594079802242154*^9, 3.594079811040777*^9}, {
  3.594080010874159*^9, 3.594080070302676*^9}, {3.628786222264576*^9, 
  3.628786222368739*^9}, {3.778749050371813*^9, 3.778749050380185*^9}},
 CellLabel->
  "In[2038]:=",ExpressionUUID->"fdeb06e4-6a74-4314-9831-fd5bc46d1966"],

