Cell[CellGroupData[{

Cell[TextData[{
 "FlatFoldabilityCondition[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qlist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.705784239271662*^9, 
  3.705784241484488*^9}},ExpressionUUID->"c22134c8-feb1-442b-a8f1-\
7bfe4b129792"],

Cell[TextData[{
 "FlatFoldabilityCondition",
 "[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qlist",
  FontSlant->"Italic"],
 "] also returns a function that is zero if and only iff the Kawasaki-Justin \
Condition is satisfied but normalizes the vectors from ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to each of the points in ",
 StyleBox["qlist",
  FontSlant->"Italic"],
 ", so that there is no gradient towards the degenerate case. You should use \
this function in root-finding and/or optimization if degenerate \
configurations (",
 StyleBox["q",
  FontSlant->"Italic"],
 "-points coincident with ",
 StyleBox["p",
  FontSlant->"Italic"],
 ") are not forbidden by other means."
}], "Text",
 CellChangeTimes->{{3.469131118224055*^9, 3.4691312173093567`*^9}, {
   3.469131286407008*^9, 3.469131319553737*^9}, 3.59580585592951*^9, 
   3.5959826774712977`*^9},ExpressionUUID->"e7827376-5352-475f-9934-\
5b28dd57cc57"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlatFoldabilityCondition", "::", "oddverts"}], 
   "=", "\"\<The list of vertices `1` fed to \
UnnormalizedFlatFoldabilityCondition has an odd number of entries.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.469130473161424*^9, 3.469130501179653*^9}, 
   3.469131340224473*^9, {3.484065580474041*^9, 3.484065583761189*^9}, {
   3.5958058348874073`*^9, 3.595805856030374*^9}, {3.595982677614477*^9, 
   3.595982678053444*^9}},
 CellLabel->
  "In[582]:=",ExpressionUUID->"870c962b-60c9-4932-823c-ddcf1ca3ce0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlatFoldabilityCondition", "[", 
   RowBox[{"p_", ",", "qlist_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Length", "[", "qlist", "]"}], ",", "2"}], "]"}], "\[NotEqual]",
         "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"FlatFoldabilityCondition", "::", "oddverts"}], ",", 
          "qlist"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Dot", "@@", 
        RowBox[{"MapThread", "[", 
         RowBox[{"RotationMatrix2D", ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{"#", ",", "p"}], "]"}], "&"}], "/@", 
            RowBox[{"Partition", "[", 
             RowBox[{"qlist", ",", "2"}], "]"}]}], "]"}]}], "]"}]}], ")"}], "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.469129719609066*^9, 3.469129729526387*^9}, {
   3.469130421539913*^9, 3.46913046188865*^9}, {3.469130507894815*^9, 
   3.469130559402398*^9}, {3.469130597767445*^9, 3.46913066670321*^9}, {
   3.469130697343327*^9, 3.4691306997436438`*^9}, {3.469130798263954*^9, 
   3.469130845253001*^9}, {3.469130881986837*^9, 3.46913089308332*^9}, {
   3.469130928159906*^9, 3.469130972172232*^9}, {3.469131022434264*^9, 
   3.469131075887677*^9}, {3.469131341804943*^9, 3.469131355120947*^9}, 
   3.5958055384250107`*^9, {3.595805856467561*^9, 3.595805856862752*^9}, {
   3.595982678473488*^9, 3.595982678922532*^9}},
 CellLabel->
  "In[583]:=",ExpressionUUID->"351b358b-b7ce-426c-9bc1-6e111a3204ed"],

