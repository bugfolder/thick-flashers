Cell[CellGroupData[{

Cell[TextData[{
 "Degree4Vertex3DFoldedFormGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TDegree4Vertex3D\n\t(options) ShowOsculatingVector, \
ShowRulingVector, ShowTangentVector, ShowOsculatingPlane, ShowRulingPlane, \
ShowTangentPlane, Options[Vertex3DFoldedFormGraphics3D], Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{{3.594820798379216*^9, 3.594820861548514*^9}, 
   3.594820938033999*^9, {3.61529874087088*^9, 3.615298771506071*^9}, 
   3.704393645381662*^9},ExpressionUUID->"a7e449de-dc99-4d76-9bec-\
bab5c5452f0c"],

Cell[TextData[{
 "Degree4Vertex3DFoldedFormGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TDegree4Vertex3D and returns a Graphics3D rendering of the folded \
form in a unit sphere. Options are:\n\tShowOsculatingVector\[Rule]True | \
False, specifies whether to show the osculating vector..\n\tShowRulingVector\
\[Rule]True | False, specifies whether to show the ruling vector.\n\t\
ShowTangentVector\[Rule]True | False, specifies whether to show the tangent \
vector.\n\tShowOsculatingPlane\[Rule]True | False, specifies whether to add a \
representation of the osculating plane (which contains the two major creases) \
to the vertex.\n\tShowRulingPlane\[Rule]True | False, specifies whether to \
add a representation of the ruling plane (which contains the two minor \
creases) to the vertex.\n\tShowTangentPlane\[Rule]True | False, specifies \
whether to show the tangent plane to the vertex.\n\t\
Options[OptionsVertex3DFoldedFormGraphics3D] are passed through.\n\t\
Options[Graphics3D] are passed through."
}], "Text",
 CellChangeTimes->{{3.594820923778823*^9, 3.594820976055009*^9}, {
   3.594821329055019*^9, 3.594821349131409*^9}, {3.594821759034219*^9, 
   3.594821776532304*^9}, {3.5948226060841513`*^9, 3.594822616313862*^9}, {
   3.5948229788386493`*^9, 3.594823011152178*^9}, 
   3.6152986879710207`*^9},ExpressionUUID->"f7b6092a-780e-4cd1-9ef6-\
05f5f698fcdc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowOsculatingVector", "::", "usage"}], 
   "=", "\"\<ShowOsculatingVector is an option to \
Degree4Vertex3DFoldedFormGraphics3D that specifies whether to show the \
osculating normal on the Gaussian sphere.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592079868604634*^9, 3.592079893324048*^9}, {
   3.592079933123661*^9, 3.592079943894341*^9}, 3.5924378213886223`*^9, 
   3.592829562262116*^9, 3.5948211135251427`*^9, 3.594823505381633*^9},
 CellLabel->
  "In[2248]:=",ExpressionUUID->"d55a5468-d4be-4d56-81f0-7628d7379f8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowRulingVector", "::", "usage"}], 
