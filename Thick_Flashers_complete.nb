Cell[CellGroupData[{

Cell[TextData[{
 "Degree4LastFoldDirection[{",
 StyleBox["x1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["x2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["x3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y3",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.7977036752275276`*^9, 3.797703726267376*^9}, {
  3.797704215358876*^9, 3.797704216919034*^9}, {3.797704259623832*^9, 
  3.7977042622910433`*^9}},ExpressionUUID->"6bb84fbb-019c-4955-83dc-\
111ad283b464"],

Cell[TextData[{
 "Degree4LastFoldDirection[{",
 StyleBox["x1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["x2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["x3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y3",
  FontSlant->"Italic"],
 "}] takes three consecutive fold directions and returns the normalized \
direction of the last fold."
}], "Text",
 CellChangeTimes->{{3.797704221089571*^9, 
  3.7977042676710186`*^9}},ExpressionUUID->"22ba21b4-8c4c-4ba0-b9a7-\
64ed6addb5ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Degree4LastFoldDirection", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x1_", ",", "y1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x2_", ",", "y2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x3_", ",", "y3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"NormalizeReal", "[", 
   RowBox[{"-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x2", ",", "y2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "y2"}], ",", "x2"}], "}"}]}], "}"}], ".", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x3", ",", 
           RowBox[{"-", "y3"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y3", ",", "x3"}], "}"}]}], "}"}]}], ")"}], ".", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "y1"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.797703733079576*^9, 3.7977038162606916`*^9}, {
  3.797704024215947*^9, 3.797704029047672*^9}, {3.797704088272436*^9, 
  3.7977041165188713`*^9}, {3.797704169017993*^9, 3.7977041761590986`*^9}},
 CellLabel->
  "In[589]:=",ExpressionUUID->"a34532cc-551d-4bbb-8c74-9cf9eddb4186"],

