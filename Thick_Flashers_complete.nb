  3.707925797564691*^9}},ExpressionUUID->"929c7e1a-0d49-482c-a7d4-\
0e5f72e58b44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"o", ",", "p", ",", "q", ",", "r"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"o", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{
       RowBox[{"RotationMatrix3DTwixt", "[", 
        RowBox[{"p", ",", "q"}], "]"}], ".", "p"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", "p"}], "}"}], "]"}], ",", "Red", ",", 
          RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", "q"}], "}"}], "]"}], ",", "Green", ",", 
          RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{"o", ",", "r"}], "}"}], "]"}], ",", "Blue", ",", 
          RowBox[{"Thickness", "[", ".03", "]"}]}], "]"}]}], "}"}], "]"}]}]}],
    "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.707925628203824*^9, 3.707925765611171*^9}},
 CellLabel->
  "In[706]:=",ExpressionUUID->"c8ccfde4-1d44-45c5-9ca6-88a11652de8f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Rotate3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]\nRotate3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w, q",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.6892506488742*^9, 3.689250669025385*^9}, {
