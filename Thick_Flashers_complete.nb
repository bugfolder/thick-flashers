Cell[CellGroupData[{

Cell["PinHingePanelSortFunction", "Subsubsection",
 CellChangeTimes->{{3.9336926469664717`*^9, 3.933692649665039*^9}, 
   3.934306047693199*^9, 
   3.935493948314596*^9},ExpressionUUID->"ae085828-74fd-4d57-8990-\
ea5d4586db9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PinHingePanelSortFunction", "::", "usage"}], 
   "=", "\"\<PinHingePanelSortFunction is an option to \
MakePinHingedPanelRegions that specifies the sorting order on the panel \
indices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9335385713939457`*^9, 3.933538603099906*^9}, 
   3.933596859983739*^9, 3.933692613166873*^9, {3.9343060476950703`*^9, 
   3.934306047695346*^9}, {3.935493948316389*^9, 3.935493958916346*^9}},
 CellLabel->
  "In[4396]:=",ExpressionUUID->"21bc5878-0953-449f-96cf-c81e726b8ed7"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakePinHingedPanelParts[",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["axes",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) = PinHingePanelSortFunction, Options[MakePinHingeParts]"
}], "Subsubsection",
 CellChangeTimes->{{3.9335288480167294`*^9, 3.933528899375166*^9}, {
   3.9335289425172033`*^9, 3.9335289435016527`*^9}, {3.933538314357255*^9, 
   3.9335383229550457`*^9}, {3.9335967326482143`*^9, 3.9335967374039707`*^9}, 
   3.93369261315983*^9, {3.933800063267446*^9, 3.93380010885378*^9}, 
   3.934300121258473*^9, {3.93430537372932*^9, 3.934305374998129*^9}, 
   3.93430566359756*^9, 3.9343060476999207`*^9, 
   3.93549394832113*^9},ExpressionUUID->"89d16b1e-1247-4fa7-a3bf-\
07f497d8a610"],

Cell["\<\
MakePinHingedPanelParts takes a set of panels and supporting information and \
adds pin hinges along the edges of specified axes, returning a list of \
panels, cutouts,  knuckles, and holes that can be assembled into a set of \
pin-hinged panel regions.\
\>", "Text",
 CellChangeTimes->{{3.933529210902988*^9, 3.933529260255817*^9}, {
   3.933596753399283*^9, 3.9335967641063337`*^9}, 3.933692613165254*^9, {
   3.9338001136060333`*^9, 3.933800203155611*^9}, 3.934305089274633*^9, {
   3.934305710219051*^9, 3.934305713841855*^9}, {3.935493756678061*^9, 
   3.93549375703703*^9}},ExpressionUUID->"e99b5b5c-b592-4ccc-9018-\
fe6e7a9c83c4"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["panels",
  FontSlant->"Italic"],
 " \[LongDash] a list of panels, one per facet of the mechanism, each of \
which should be a convex GraphicsComplex polyhedron.\n\t",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " \[LongDash] a list of indices specifying the vertices of the panels that \
correspond to to the endpoints of the rotation axes.\n\t",
 StyleBox["axes",
  FontSlant->"Italic"],
 " \[LongDash] a list of points pairs that are the endpoints of rotation axes \
that may or may not be referenced by ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ". See note below."
}], "Text",
 CellChangeTimes->{{3.9335383460852947`*^9, 3.933538441311521*^9}, {
  3.933596767860505*^9, 3.933596847748382*^9}, {3.933597291341498*^9, 
  3.9335973068036413`*^9}, {3.933800266737627*^9, 3.9338002836591387`*^9}, {
  3.933843084574247*^9, 
  3.933843123301491*^9}},ExpressionUUID->"67261b61-684f-476f-9aea-\
4aa0c3cf4321"],

Cell[TextData[{
 "Options:\n\tPinHingePanelSortFunction\[Rule] ",
 StyleBox["fn",
  FontSlant->"Italic"],
 ", a sorting function that takes a pair of panel indices and returns the \
same list in the desired panel order, where the first panel receives the \
middle knuckle and the second panel receives the two end knuckles. Default \
sorts according to increasing panel index.\n\tOptions[MakePinHingeParts] are \
passed through."
}], "Text",
 CellChangeTimes->{{3.933538448873028*^9, 3.933538515363666*^9}, {
   3.933538614933666*^9, 3.933538628726739*^9}, {3.9335386667080193`*^9, 
   3.9335386921136007`*^9}, 3.934305385802994*^9, {3.9343057225382566`*^9, 
   3.934305723666589*^9}, 3.934306047704935*^9, 
   3.935493948326112*^9},ExpressionUUID->"e699e14a-0188-4eeb-b96d-\
7997f389cb25"],

Cell[TextData[{
 "Returns: a list ",
 StyleBox["panelparts",
  FontSlant->"Italic"],
 " = {{",
 StyleBox["panel1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cutouts1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["knuckles1, holes1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["panel2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cutouts2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["knuckles2, holes2",
  FontSlant->"Italic"],
 "}, ...}, a structured list of GraphicsComplex polyhedra where\n\t",
 StyleBox["panelN",
  FontSlant->"Italic"],
 " is the ",
 StyleBox["N",
  FontSlant->"Italic"],
 "th original panel;\n\t",
 StyleBox["cutoutsN",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex polyhedra containing the cutouts that should \
be applied to ",
 StyleBox["panelN",
  FontSlant->"Italic"],
 ";\n\t",
 StyleBox["knucklesN",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex polyhedra containing the cylindrical knuckles \
that should be attached to ",
 StyleBox["panelN",
  FontSlant->"Italic"],
 " after ",
 StyleBox["cutoutsN",
  FontSlant->"Italic"],
 " have been applied.\n\t",
 StyleBox["holesN",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex polyhedra, one per knuckle, containing the \
cylindrical hole that should be drilled through ",
 "that knuckle before it is attached to ",
 StyleBox["panelN",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.933538517612266*^9, 3.9335385639694033`*^9}, {
  3.9338002167683268`*^9, 3.933800261586255*^9}, {3.93380029266046*^9, 
  3.933800371457006*^9}, {3.933843135085382*^9, 3.9338431920977507`*^9}, {
  3.933843225861697*^9, 3.9338433519513063`*^9}, {3.933850204559312*^9, 
  3.93385020623145*^9}, {3.933943745542816*^9, 3.933943799536334*^9}, {
  3.934029645317603*^9, 3.934029662961277*^9}, {3.9343006923466053`*^9, 
  3.9343007145823097`*^9}, {3.934305736495122*^9, 
  3.934305777433975*^9}},ExpressionUUID->"11f7ac67-453d-44d7-8562-\
423b821c5a7e"],

Cell["\<\
The reason that this function returns parts, rather than performing the \
cutouts and unions with MeshRegions, is that Mathematica fails to perform the \
Boolean operations for even moderately complex configurations (like \
flashers). By giving access to the separate parts, we make it possible to use \
external tools (like MeshLab) to perform the Boolean mesh operations. And we \
return GraphicsComplex objects so we can easily manipulate and visualize them.\
\>", "Text",
 CellChangeTimes->{{3.933800375822728*^9, 3.933800457655102*^9}, {
  3.9340296748130713`*^9, 
  3.9340297028764687`*^9}},ExpressionUUID->"ebdcb072-acc3-47b8-9a51-\
cc30575635fe"],

Cell[TextData[{
 "The array ",
 StyleBox["axes",
  FontSlant->"Italic"],
 " is either a list of a point pair or an empty list, one for each edge of \
the EZTS. A pin-hinge will be created for all non-empty entries in ",
 StyleBox["axes",
  FontSlant->"Italic"],
 " that are referenced by two entries in ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ". Thus, lack of reference in ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " or an empty element of ",
 StyleBox["axes",
  FontSlant->"Italic"],
 " will result in no pin hinge; you need both to define the pin-hinge. The \
entry in axes defines the axis of rotation; the entries in ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " define how the hinge is attached to the two incident panels."
}], "Text",
 CellChangeTimes->{{3.933597315410717*^9, 3.9335973700027018`*^9}, {
  3.933843409928156*^9, 3.9338434333983927`*^9}, {3.9370377975595417`*^9, 
  3.9370380757594767`*^9}},ExpressionUUID->"cafddacd-c7d9-48d2-9ba3-\
5a11ea492e99"],

Cell[TextData[{
 "The lists ",
 StyleBox["knucklesN",
  FontSlant->"Italic"],
 " and ",
 StyleBox["holesN",
  FontSlant->"Italic"],
 " should have the same number of elements: one hole for each knuckle. In \
principle, one could attach the knuckles first to the panels and then drill \
holes, but I have found that both Mathematica and MeshLab work better if you \
first drill the holes through the knuckles, then attach them to the panels."
}], "Text",
 CellChangeTimes->{{3.934305807554757*^9, 3.934305892893358*^9}, {
  3.9343059681286373`*^9, 
  3.934305984484376*^9}},ExpressionUUID->"e0719fd4-327a-455b-88d5-\
7d6491cf61d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakePinHingedPanelParts", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PinHingePanelSortFunction", "->", "Sort"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.933538605709627*^9, 3.93353865633576*^9}, 
   3.933596732649825*^9, 3.9336926131674423`*^9, 3.933800520007215*^9, 
   3.934300725785413*^9, 3.934305663599337*^9, 3.934306047706327*^9, {
   3.9354939483277073`*^9, 3.9354939763561*^9}},
 CellLabel->
  "In[4397]:=",ExpressionUUID->"c7da4a6b-f3a1-4831-8f69-db454c5eee15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePinHingedPanelParts", "[", 
   RowBox[{"panels_", ",", " ", "panelinfo_", ",", "axes_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sfn", ",", "emap", ",", "pi", ",", "parts", ",", "p", ",", "q", ",", 
      "upq", ",", "lpq", ",", "p1a", ",", "p1b", ",", "x1a", ",", "x1b", ",", 
      "p2a", ",", "p2b", ",", "x2a", ",", "x2b", ",", "q1", ",", "q2", ",", 
      "i1", ",", "i2", ",", "cu1", ",", "kn1", ",", "ho1", ",", "cu2", ",", 
      "kn2", ",", "ho2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sfn", "=", 
      RowBox[{
       RowBox[{"PinHingePanelSortFunction", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakePinHingedPanelParts", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Build", " ", "a", " ", "look"}], "-", 
        RowBox[{
        "up", " ", "table", " ", "of", " ", "which", " ", "panels", " ", 
         "and", " ", "vertices", " ", "are", " ", "incident", " ", "on", " ", 
         "each", " ", 
         RowBox[{"axis", ".", " ", "The"}], " ", "ith", " ", "entry", " ", 
         "of", " ", "emap", " ", "contains", " ", "two", " ", "lists", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"{", 
            RowBox[{"k1", ",", " ", "k2"}], "}"}]}], "}"}]}]}], ",", " ", 
       RowBox[{
       "where", " ", "j", " ", "is", " ", "the", " ", "index", " ", "of", " ",
         "an", " ", "incident", " ", "panel", " ", "and", " ", 
        RowBox[{"{", 
         RowBox[{"k1", ",", " ", "k2"}], "}"}], " ", "are", " ", "the", " ", 
        "corresponding", " ", "vertices", " ", "of", " ", "that", " ", 
        RowBox[{"panel", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"emap", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "axes", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{
           RowBox[{"emap", "\[LeftDoubleBracket]", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
            "}"}]}], "]"}], "&"}], "/@", 
        RowBox[{
        "panelinfo", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
        ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "panelinfo", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Set", " ", "up", " ", "the", " ", "initial", " ", "output", " ", 
       RowBox[{"list", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"parts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}]}], "}"}], "&"}], "/@", "panels"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Construct", " ", "the", " ", "parts", " ", "of", " ", "pin", " ", 
       "hinges", " ", "as", " ", "specified", " ", "in", " ", "emap"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "emap", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "]"}], "!=", "2"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ListEmptyQ", "[", 
           RowBox[{
           "axes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "]"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "q"}], "}"}], "=", 
         RowBox[{
         "axes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "endpoints", " ", "of", " ", "the", " ", "hinge", " ", "axis"}], " ",
          "*)"}], "\[IndentingNewLine]", 
        RowBox[{"upq", "=", 
         RowBox[{"NormalizeReal", "[", 
          RowBox[{"q", "-", "p"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "unit", " ", "vector", " ", "along", " ", "the", " ", "edge"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"lpq", "=", 
         RowBox[{"Mag", "[", 
          RowBox[{"q", "-", "p"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"length", " ", "of", " ", "the", " ", "axis"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p1a", ",", "p1b"}], "}"}], "=", 
         RowBox[{
          RowBox[{"panels", "\[LeftDoubleBracket]", 
           RowBox[{"emap", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", 
           RowBox[{"emap", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
          "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
