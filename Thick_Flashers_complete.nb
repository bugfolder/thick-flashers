Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hcwc", ",", "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", 
      "ff1", ",", "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", 
      "yR", ",", "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", 
      "\[Gamma]2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hcwc", "=", 
      RowBox[{"HCwCParabola", "[", 
       RowBox[{
        RowBox[{"5.", "\[Degree]"}], ",", 
        RowBox[{"85.", "\[Degree]"}], ",", 
        RowBox[{"60.", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "90."}], "\[Degree]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", "ff1", ",", 
        "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", "yR", ",", 
        "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2"}], "}"}],
       "=", "hcwc"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HCwCGraphics3D", "[", 
       RowBox[{"hcwc", ",", "\[IndentingNewLine]", 
        RowBox[{"Axes", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ViewPoint", "\[Rule]", 
         RowBox[{"5", 
          RowBox[{"(", 
           RowBox[{"xL", "+", 
            RowBox[{".8", "yL"}], "+", 
            RowBox[{".4", "z"}]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"ViewVertical", "\[Rule]", "z"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", "0.8", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowHCwCPlanes", "\[Rule]", "True"}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
