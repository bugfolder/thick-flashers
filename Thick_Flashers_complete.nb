      RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", 
  RowBox[{
   RowBox[{"Short", "[", 
    RowBox[{"#", ",", "5"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.911825578957897*^9, 3.911825665734769*^9}, 
   3.911826594710863*^9, {3.911827045356098*^9, 3.911827069247779*^9}},
