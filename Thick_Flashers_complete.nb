Cell["\<\
For some unexplained reason, the hidden lines are getting lost when we wrap \
these objects in GraphicsRow[]. So a better rendition is obtained using \
ShowOrigamiSamples, next.\
\>", "Text",
 CellChangeTimes->{{3.628955669406226*^9, 
  3.628955704299404*^9}},ExpressionUUID->"b12a0729-3823-43aa-bf76-\
e41fbeb29413"],

Cell["\<\
Note: the bug only seems to be in the screen rendering. Exported images \
contain the dotted lines properly.\
\>", "Text",
 CellChangeTimes->{{3.628958068539491*^9, 3.628958076177007*^9}, {
  3.628958108887703*^9, 
  3.628958130573441*^9}},ExpressionUUID->"4e910802-edc3-4279-b8a2-\
e0caa92a18e6"]
}, Closed]],

Cell[CellGroupData[{

Cell["OrigamiSwatchGraphics", "Subsubsection",
 CellChangeTimes->{{3.6895128995217237`*^9, 
  3.689512908330377*^9}},ExpressionUUID->"12f38bd3-8d90-436c-b2e2-\
634728fdb87f"],

Cell["\<\
OrigamiSwatchGraphics is a Graphics object that is a simple swatch of fills \
and lines, useful for color-matching in other programs.\
\>", "Text",
 CellChangeTimes->{{3.689512914469648*^9, 
  3.689512936576871*^9}},ExpressionUUID->"414f105b-3fe4-4015-9e7c-\
14bd281a83b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrigamiSwatchGraphics", "=", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"EdgeForm", "[", "]"}], ",", "PaperWhiteSideFill"}], 
         "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1.5", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2.5", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2.5", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1.5", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"EdgeForm", "[", "]"}], ",", "PaperColoredSideFill"}], 
         "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1.5"}], "}"}]}], "}"}], "]"}], ",", 
        "ValleyLine"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1.5", ",", "1.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2.5", ",", "1.5"}], "}"}]}], "}"}], "]"}], ",", 
        "MountainLine"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", "}"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.689512940276285*^9, 3.689512996087499*^9}, {
  3.689513032605145*^9, 3.6895130541747093`*^9}, {3.68951313835299*^9, 
  3.68951327369088*^9}},
 CellLabel->
  "In[1576]:=",ExpressionUUID->"cc9f832f-127d-4e5a-a09b-ac030b84b0d5"],

