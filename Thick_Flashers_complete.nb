   3.643238228063019*^9}},ExpressionUUID->"f60aa4c6-e4a9-4284-81b9-\
eb012f24b6b1"],

Cell[TextData[{
 "AddTCornerIndicesTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 "] takes a TObj of type TGraph (or any subclass) and gives it the \
TCornerIndices class, setting its CornerIndices property to ",
 StyleBox["ci",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.592487059458061*^9, 3.59248712367784*^9}, {
   3.5924872169291687`*^9, 3.592487217552133*^9}, {3.592487345679679*^9, 
   3.592487370757642*^9}, 3.592660642967874*^9, {3.592828862817247*^9, 
   3.592828862915722*^9}, {3.6432381298012037`*^9, 3.643238129833291*^9}, {
   3.643238228967833*^9, 
   3.643238254429568*^9}},ExpressionUUID->"167fb562-3cf2-439f-8c7f-\
5d52727753ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddTCornerIndicesTo", "::", "badci"}], 
   "=", "\"\<The corner indices `1` do not have the proper format to be \
CornerIndices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.643238334083467*^9, 3.643238368537278*^9}},
 CellLabel->
  "In[2061]:=",ExpressionUUID->"e6fff2de-5ff9-4a0b-945e-2db33414d25d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTCornerIndicesTo", "[", 
   RowBox[{"tobj_TObj", ",", "ci_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "AddTCornerIndicesTo"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "ci", "]"}], "\[NotEqual]", "List"}], "||", 
        RowBox[{
         RowBox[{"Dimensions", "[", "ci", "]"}], "\[NotEqual]", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "||", 
        RowBox[{"!", 
         RowBox[{"(", 
          RowBox[{"And", "@@", 
           RowBox[{"(", 
            RowBox[{"IntegerQ", "/@", 
             RowBox[{"Flatten", "[", "ci", "]"}]}], ")"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"AddTCornerIndicesTo", "::", "badci"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AddClassTo", "[", 
      RowBox[{"tobj", ",", "TCornerIndices", ",", 
       RowBox[{"{", 
        RowBox[{"CornerIndices", "\[Rule]", "ci"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5924869772150383`*^9, 3.59248705554143*^9}, {
   3.5924873270427513`*^9, 3.592487333651678*^9}, {3.592487366330113*^9, 
   3.592487366673485*^9}, {3.5924892746651163`*^9, 3.592489275406543*^9}, {
   3.592660643009685*^9, 3.592660643261625*^9}, 3.592668608566631*^9, {
   3.592828863011652*^9, 3.592828863144417*^9}, {3.5928555960754*^9, 
   3.592855637955234*^9}, 3.5930061024019217`*^9, {3.643238129844997*^9, 
   3.643238129855659*^9}, {3.643238268589611*^9, 3.643238268733629*^9}, {
   3.643238302648428*^9, 3.643238307908017*^9}, {3.643238372710716*^9, 
   3.643238439616201*^9}, {3.643238475114168*^9, 3.64323848477529*^9}},
 CellLabel->
  "In[2062]:=",ExpressionUUID->"14a197b3-86c3-4b68-a6b0-ac66516f673b"],

Cell[TextData[{
 "AddTCornerIndices[",
 StyleBox["ci",
  FontSlant->"Italic"],
 "] returns a pure function that adds a TCornerIndices class to its argument \
with CornerIndices ",
 StyleBox["ci.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.592660673469639*^9, 3.5926607024597473`*^9}, {
  3.592828863235948*^9, 3.592828863329564*^9}, {3.62568457643357*^9, 
  3.625684590335121*^9}, {3.625684638980268*^9, 3.625684663938617*^9}, {
  3.643238129882478*^9, 3.643238129909902*^9}, {3.643238443682993*^9, 
  3.6432384534891987`*^9}},ExpressionUUID->"eb6384ae-8a85-4ee4-9152-\
1ec0249b0194"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTCornerIndices", "[", "ci_", "]"}], ":=", 
  RowBox[{
   RowBox[{"AddTCornerIndicesTo", "[", 
    RowBox[{"#", ",", "ci"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.592660712195681*^9, 3.592660726134669*^9}, {
  3.59282886342764*^9, 3.592828863494886*^9}, {3.592855544888287*^9, 
  3.592855545686268*^9}, {3.643238129921334*^9, 3.643238129928055*^9}, {
  3.643238456460455*^9, 3.643238467001147*^9}},
 CellLabel->
