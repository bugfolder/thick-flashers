              RowBox[{"cx", "[", "0", "]"}], ",", 
              RowBox[{"cy", "[", "0", "]"}], ",", 
              RowBox[{"cz", "[", "0", "]"}]}], "}"}], "\[Equal]", "ip"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tx", "[", "t", "]"}], ",", 
           RowBox[{"ty", "[", "t", "]"}], ",", 
           RowBox[{"tz", "[", "t", "]"}], ",", 
           RowBox[{"nx", "[", "t", "]"}], ",", 
           RowBox[{"ny", "[", "t", "]"}], ",", 
           RowBox[{"nz", "[", "t", "]"}], ",", 
           RowBox[{"bx", "[", "t", "]"}], ",", 
           RowBox[{"by", "[", "t", "]"}], ",", 
           RowBox[{"bz", "[", "t", "]"}], ",", 
           RowBox[{"cx", "[", "t", "]"}], ",", 
           RowBox[{"cy", "[", "t", "]"}], ",", 
           RowBox[{"cz", "[", "t", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", "ndopts"}], "]"}], 
       "//", "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cx", "[", "t", "]"}], ",", 
             RowBox[{"cy", "[", "t", "]"}], ",", 
             RowBox[{"cz", "[", "t", "]"}]}], "}"}], "/.", "soln"}], ",", 
          "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Curvature3D", "\[Rule]", "kp"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Torsion3D", "\[Rule]", "ta"}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
