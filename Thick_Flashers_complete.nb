Cell[TextData[{
 "ReplaceProperty[",
 StyleBox["rule",
  FontSlant->"Italic"],
 "] returns a pure function that replaces the property in its argument with \
",
 StyleBox["rule",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.592707774536282*^9, 
  3.592707798773678*^9}},ExpressionUUID->"dc952237-ee8f-466d-b1d2-\
78c2060afb44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceProperty", "[", "rule_Rule", "]"}], ":=", 
  RowBox[{
   RowBox[{"ReplacePropertyIn", "[", 
    RowBox[{"#", ",", "rule"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.592707800368073*^9, 3.592707818367946*^9}},
 CellLabel->
  "In[963]:=",ExpressionUUID->"a0b21ceb-8888-4dc2-ac17-1784deb6fa23"],

Cell[TextData[{
 "ReplacePropertiesIn",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rules",
  FontSlant->"Italic"],
 "] replaces any properties in ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " with the corresponding ones in ",
 StyleBox["rules",
  FontSlant->"Italic"],
 ". If ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " doesn\[CloseCurlyQuote]t contain one of the replacement rules, the rule is \
ignored."
}], "Text",
 CellChangeTimes->{{3.591654493466283*^9, 3.5916545370554647`*^9}, 
   3.592681720354978*^9, 
   3.592707735698634*^9},ExpressionUUID->"dcb3759f-3912-4ba5-9515-\
3772d25c4bc7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplacePropertiesIn", "[", 
   RowBox[{"tobj_TObj", ",", "rules_List"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj1", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj1", "=", "tobj"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"tobj1", "=", 
         RowBox[{"ReplacePropertyIn", "[", 
          RowBox[{"tobj1", ",", "#"}], "]"}]}], ")"}], "&"}], "/@", "rules"}],
      ";", "\[IndentingNewLine]", "tobj1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.591654539329827*^9, 3.591654558219009*^9}, {
   3.591654588831923*^9, 3.591654684025606*^9}, {3.591654779620411*^9, 
   3.591654807957844*^9}, {3.591654839577093*^9, 3.591654921922243*^9}, 
   3.592435730619333*^9, {3.592680629041278*^9, 3.5926806383610067`*^9}, {
