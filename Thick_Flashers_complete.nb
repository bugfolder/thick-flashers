Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CreasePatternToPlaneGraphAssigned", "::", "dupvert"}], 
   "=", "\"\<The extracted edges `1` contain at least one edge with duplicate \
vertices `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{3.533679551148519*^9, 3.592468074048597*^9, 
  3.592828729794779*^9, 3.592828958434273*^9, 3.594739162220359*^9},
