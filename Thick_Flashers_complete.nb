Cell[CellGroupData[{

Cell[TextData[{
 "Styled2DAxes[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nStyled2DAxes[",
 StyleBox["xmax",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ymax",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nStyled2DAxes[{",
