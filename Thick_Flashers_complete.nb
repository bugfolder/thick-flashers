   3.594659244493094*^9}},ExpressionUUID->"1009a54d-6d7d-45c3-b903-\
39851b4f8a10"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindEdge", "[", 
   RowBox[{"tobj_TObj", ",", " ", "e_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "edges", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"edges", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"SameEdgeQ", "[", 
           RowBox[{
            RowBox[{
            "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
             "e"}], "]"}], ",", 
          RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594658424110594*^9, 3.594658476416802*^9}, {
  3.594658633189801*^9, 3.59465871725809*^9}, {3.594658795473705*^9, 
