Cell[TextData[{
 "MakeThickFlasherFFProjectionRules[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "] sets up and solves for the FF projection design of a flasher composed of \
mostly constant-thickness panels (the triangular panels will have to be \
trimmed in thickness)."
}], "Text",
 CellChangeTimes->{{3.555852179920305*^9, 3.555852292385377*^9}, {
   3.55585233169029*^9, 3.555852439928059*^9}, {3.5558534052815933`*^9, 
