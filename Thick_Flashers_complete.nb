Cell[CellGroupData[{

Cell[TextData[{
 "EdgeMountainFoldConstraints[",
 StyleBox["{i1, f1, i2, f2}, verts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.702581735995819*^9, 3.702581754553783*^9}, {
   3.702581891673012*^9, 3.702581908360849*^9}, {3.702583972525899*^9, 
   3.702583973435993*^9}, 3.702662307941942*^9, 3.702664787178948*^9, {
   3.702668490036808*^9, 
   3.70266849084469*^9}},ExpressionUUID->"5208b7dd-85ba-4111-b069-\
acc656f3e5fb"],

Cell[TextData[{
 "EdgeMountainFoldConstraints[",
 StyleBox["{i1, f1, i2, f2}",
  FontSlant->"Italic"],
 "] creates constraints that force a fold to have a fold angle between 0\
\[Degree] and \[Dash]180\[Degree], i.e., to be a mountain fold."
}], "Text",
 CellChangeTimes->{{3.702581757784544*^9, 3.702581806303808*^9}, {
   3.702583978582734*^9, 3.70258398316429*^9}, 3.702662310382679*^9, 
   3.702664787210248*^9},ExpressionUUID->"2b7e0367-86cc-4a54-97af-\
61d69aec6ccf"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["i1, f1, i2, f2",
  FontSlant->"Italic"],
 "} \[LongDash] An edge vertex neighborhood, e.g., from \
InteriorEdgeVertexNeighborhoods.\n\tverts \[LongDash] the list of vertices \
that {",
 StyleBox["i1, f1, i2, f2",
  FontSlant->"Italic"],
 "} index into."
}], "Text",
 CellChangeTimes->{{3.702581808119735*^9, 3.702581841704116*^9}, {
  3.7025819181374006`*^9, 3.70258193781772*^9}, {3.702662316558084*^9, 
  3.7026623384115477`*^9}, {3.702668493484575*^9, 
  3.7026685183186703`*^9}},ExpressionUUID->"6ea2ff0f-8e17-42a3-a606-\
5968408ca661"],

Cell[TextData[{
 "Returns:\n\tA pure function f[",
 StyleBox["verts",
  FontSlant->"Italic"],
 "] that accepts a list ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " of vertices and returns a list of constraints equations."
}], "Text",
 CellChangeTimes->{{3.702581856616185*^9, 3.7025818789524617`*^9}, {
  3.7025819476972246`*^9, 
  3.702581948425012*^9}},ExpressionUUID->"5a12021d-a343-4e41-8f15-\
dd97ca31ea19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeMountainFoldConstraints", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i1_", ",", "f1_", ",", "i2_", ",", "f2_"}], "}"}], ",", 
    "verts_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "p3", ",", "p4", ",", "u2", ",", "u4", ",", 
      "r13"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p1", "=", 
      RowBox[{
      "verts", "\[LeftDoubleBracket]", "i1", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "f1", "\[RightDoubleBracket]"}]}], "/", 
       RowBox[{"Length", "[", "f1", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p3", "=", 
      RowBox[{
      "verts", "\[LeftDoubleBracket]", "i2", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p4", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "f2", "\[RightDoubleBracket]"}]}], "/", 
       RowBox[{"Length", "[", "f2", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p2", "-", "p1"}], ")"}], "\[Cross]", 
       RowBox[{"(", 
        RowBox[{"p3", "-", "p1"}], ")"}]}]}], ";", 
     RowBox[{"u2", "=", 
      RowBox[{"u2", "/", 
       RowBox[{"Mag", "[", "u2", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u4", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p3", "-", "p1"}], ")"}], "\[Cross]", 
       RowBox[{"(", 
        RowBox[{"p4", "-", "p1"}], ")"}]}]}], ";", 
     RowBox[{"u4", "=", 
      RowBox[{"u4", "/", 
       RowBox[{"Mag", "[", "u4", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r13", "=", 
      RowBox[{"p3", "-", "p1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"u2", "\[Cross]", "u4"}], ")"}], ".", "r13"}]}], "/", 
        RowBox[{"Mag", "[", "r13", "]"}]}], "\[GreaterEqual]", "0"}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.70258200662281*^9, 3.7025820268818417`*^9}, {
   3.702582537440918*^9, 3.702582677103499*^9}, {3.702582710441899*^9, 
   3.702582777729388*^9}, {3.702582955076584*^9, 3.702582956027372*^9}, 
   3.702583177053684*^9, {3.70258321570234*^9, 3.702583225525756*^9}, {
