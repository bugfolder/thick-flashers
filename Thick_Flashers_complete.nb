Cell[BoxData[
 RowBox[{
  RowBox[{"FlattenFold2D", "[", 
   RowBox[{"ff_Function", ",", "rrL_Function", ",", "rrR_Function", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "fi_List", ",", "ti_List"}], "}"}], ",", "opts___"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "dff", ",", "ds", ",", "tt", 
      ",", "uuL", ",", "llL", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "uuR", ",",
       "llR", ",", "c\[Rho]R", ",", "s\[Rho]R", ",", "\[Kappa]g", ",", "csys",
       ",", "f", ",", "t", ",", "rL", ",", "rR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FlattenFold2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FlattenFold2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"speed", " ", "and", " ", "tangent"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"ff", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"dff", "[", "s", "]"}], "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"dff", "[", "s", "]"}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"txr", "=", 
             RowBox[{
              RowBox[{"tt", "[", "s", "]"}], "\[Cross]", 
              RowBox[{"rrL", "[", "s", "]"}]}]}], "}"}], ",", 
           RowBox[{"NormalizeReal", "[", "txr", "]"}]}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"llL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"uuL", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"tt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"rrL", "[", "s", "]"}], ".", 
          RowBox[{"tt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"rrL", "[", "s", "]"}], ".", 
          RowBox[{"llL", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"txr", "=", 
             RowBox[{"-", 
              RowBox[{
               RowBox[{"tt", "[", "s", "]"}], "\[Cross]", 
               RowBox[{"rrR", "[", "s", "]"}]}]}]}], "}"}], ",", 
           RowBox[{"NormalizeReal", "[", "txr", "]"}]}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"llR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"uuR", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"tt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"rrR", "[", "s", "]"}], ".", 
          RowBox[{"tt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"rrR", "[", "s", "]"}], ".", 
           RowBox[{"llR", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Integrate", " ", "planar", " ", "Darboux", " ", "frame", " ", 
       "equation", " ", "for", " ", "the", " ", "2", "D", " ", "curved", " ", 
       "fold"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"llL", "[", "s", "]"}], ".", 
           RowBox[{
            RowBox[{"tt", "'"}], "[", "s", "]"}]}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "add", " ", "this", " ", "extra", " ", "simplification", " ", "step", " ",
         "if", " ", "we", " ", "are", " ", "FullSimplify"}], "-", 
       RowBox[{"ing", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"si", "\[Equal]", "FullSimplify"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Kappa]g", "=", 
        RowBox[{"Functionize", "[", 
         RowBox[{"s", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Kappa]g", "[", "s", "]"}], "//", 
            "CombineSquareRootsInProducts"}], "//", "sfn"}]}], "]"}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"RecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]g", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "fi", ",", "ti"}], "}"}], ",", "opts"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "t"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Curve2D", ",", "TangentVector2D"}], "}"}], "/.", "csys"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"rL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationMatrix2D", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], ",", 
             RowBox[{"s\[Rho]L", "[", "s", "]"}]}], "}"}], "]"}], ".", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationMatrix2D", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c\[Rho]R", "[", "s", "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"s\[Rho]R", "[", "s", "]"}]}]}], "}"}], "]"}], ".", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"f", ",", "rL", ",", "rR"}], "}"}]}]}], "]"}]}]], "Input",
