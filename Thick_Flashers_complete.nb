 CellLabel->
  "In[2799]:=",ExpressionUUID->"e10cf0e9-2112-4b99-90f7-28835b525c47"],

Cell["\<\
Default behavior works for all Graphics and Graphics2D elements.\
\>", "Text",
 CellChangeTimes->{{3.629816752870465*^9, 3.629816772364149*^9}, {
  3.630325824468485*^9, 3.630325859359124*^9}, {3.630326025764052*^9, 
  3.630326026644432*^9}},ExpressionUUID->"ebb80eaf-c981-45dc-a046-\
61fdaba64c4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbedTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tiletype_List", ",", 
      RowBox[{"offset_", ":", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"rotation_", ":", "0"}], ",", 
      RowBox[{"scale_", ":", "1"}]}], "}"}], ",", "decoration_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nm", ",", "dtile"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nm", "=", 
      RowBox[{
       RowBox[{"Numeric", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "EmbedTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dtile", "=", 
      RowBox[{"RenderTileCache", "[", 
       RowBox[{"tiletype", ",", "decoration", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FunctionTransform", "[", 
      RowBox[{"dtile", ",", 
       RowBox[{"If", "[", 
        RowBox[{"nm", ",", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"offset", "+", 
            RowBox[{
             RowBox[{"RotationMatrix2D", "[", "rotation", "]"}], ".", 
             RowBox[{"(", 
              RowBox[{"scale", "*", "#"}], ")"}]}]}], "]"}], "&"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"offset", "+", 
            RowBox[{
             RowBox[{"RotationMatrix2D", "[", "rotation", "]"}], ".", 
             RowBox[{"(", 
              RowBox[{"scale", "*", "#"}], ")"}]}]}], ")"}], "&"}]}], "]"}]}],
       "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629764025677956*^9, 3.62976410195436*^9}, {
   3.629816384374558*^9, 3.629816411247642*^9}, {3.629816485378214*^9, 
   3.629816535616368*^9}, {3.629816583415422*^9, 3.629816587837663*^9}, 
   3.629816844043873*^9, {3.630325866600899*^9, 3.630325897478697*^9}, {
   3.6303261342906637`*^9, 3.630326140995425*^9}, {3.688166837024711*^9, 
   3.688166837041036*^9}, {3.707769667610283*^9, 3.707769682057465*^9}},
 CellLabel->
  "In[2800]:=",ExpressionUUID->"37e89313-eb27-4072-ab27-90b538876544"],

Cell["\<\
TileVertices are handled differently since they are lists of bare points.\
\>", "Text",
 CellChangeTimes->{{3.629816745471735*^9, 3.629816778923834*^9}, 
   3.707757315488436*^9},ExpressionUUID->"34b96393-e1eb-4bc8-a0fc-\
c545f7596369"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EmbedTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tiletype_List", ",", 
      RowBox[{"offset_", ":", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"rotation_", ":", "0"}], ",", 
      RowBox[{"scale_", ":", "1"}]}], "}"}], ",", "TileVertices", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nm", ",", "dtile"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dtile", "=", 
      RowBox[{"RenderTileCache", "[", 
       RowBox[{"tiletype", ",", "TileVertices", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nm", "=", 
      RowBox[{
       RowBox[{"Numeric", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "EmbedTile", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{"nm", ",", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"offset", "+", 
           RowBox[{
            RowBox[{"RotationMatrix2D", "[", "rotation", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{"scale", "*", "#"}], ")"}]}]}], "]"}], "&"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"offset", "+", 
           RowBox[{
            RowBox[{"RotationMatrix2D", "[", "rotation", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{"scale", "*", "#"}], ")"}]}]}], ")"}], "&"}]}], "]"}], "/@",
       "dtile"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629764025677956*^9, 3.62976410195436*^9}, {
   3.629816384374558*^9, 3.629816411247642*^9}, {3.629816485378214*^9, 
