     RowBox[{
     "fa", ",", "ff", ",", "sp", ",", "verts", ",", "verts2d", ",", "edges", ",",
       "types", ",", "faces", ",", "fverts", ",", "dedges", ",", "aedges", ",",
       "tm", ",", "epfi", ",", "trules", ",", "emap", ",", "ss", ",", 
      "cpolys", ",", "ssl1", ",", "ssl2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fa", "=", 
      RowBox[{
       RowBox[{"FacesAbove", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "VisibleFoldedFormLines", "]"}]}]}], ";", 
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"FaceupFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "VisibleFoldedFormLines", "]"}]}]}], ";", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "VisibleFoldedFormLines", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "verts2d", ",", "edges", ",", "types", ",", "faces"}], 
       "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Vertices2D", ",", "Edges", ",", "EdgeTypes", ",", 
          "Faces"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"fverts", "=", 
        RowBox[{"FaceCentroids", "[", "tobj", "]"}]}]}], "]"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "need", " ", "these", " ", "for", " ", "various", " ", "progress", " ", 
       "graphs"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dedges", "=", 
      RowBox[{"LocalFaceOrdering", "[", 
       RowBox[{"tobj", ",", "opts"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"used", " ", "to", " ", "construct", " ", "emap"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"FacesAboveAutomatic", "[", 
       RowBox[{"tobj", ",", "opts"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"try", " ", "our", " ", "new", " ", 
       RowBox[{"version", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "trules", " ", "maps", " ", "an", " ", "edge", " ", "index", " ", 
       "pair", " ", 
       RowBox[{"(", 
        RowBox[{"either", " ", "order"}], ")"}], " ", "to", " ", "its", " ", 
       "type"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"trules", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", 
          RowBox[{"{", 
           RowBox[{"edges", ",", "types"}], "}"}]}], "]"}], ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Reverse", "/@", "edges"}], ",", "types"}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "epfi", " ", "is", " ", "a", " ", "list", " ", "of", " ", "the", " ", 
        "edge", " ", "pair", " ", "vertex", " ", "and", " ", "face", " ", 
        "incidences"}], ",", " ", 
       RowBox[{"i", ".", "e", "."}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vi", ",", " ", "vj"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"fk", ",", "fl"}], "}"}]}], "}"}], " ", "for", " ", "each",
         " ", 
        RowBox[{"edge", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tm", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sort", "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}]}], ")"}], 
        "&"}], "/@", "faces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"epfi", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"Position", "[", 
             RowBox[{"tm", ",", "#"}], "]"}], "]"}], "\[LeftDoubleBracket]", 
           "1", "\[RightDoubleBracket]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Union", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"tm", ",", "1"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "emap", " ", "will", " ", "be", " ", "a", " ", "table", " ", "listing",
         " ", "each", " ", "edge"}], ",", " ", 
       RowBox[{
       "a", " ", "list", " ", "of", " ", "all", " ", "faces", " ", "that", " ",
         "lie", " ", "above", " ", "it"}], ",", " ", 
       RowBox[{"and", " ", "its", " ", "type"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"emap", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"(*", " ", 
           RowBox[{"the", " ", "edge", " ", "itself"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "]"}], "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
            RowBox[{"fa", "\[LeftDoubleBracket]", 
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"(*", " ", 
             RowBox[{
             "face", " ", "incident", " ", "to", " ", "a", " ", "border", " ",
               "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"fa", "\[LeftDoubleBracket]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"MemberQ", "[", 
                RowBox[{"dedges", ",", 
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}]}], "]"}], ",", 
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}], 
             "\[RightDoubleBracket]"}]}], " ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "use", " ", "the", " ", "upper", " ", "face", " ", "incident", " ",
              "to", " ", "this", " ", "edge"}], " ", "*)"}], 
           "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "/.", 
           "trules"}]}], " ", 
         RowBox[{"(*", " ", 
          RowBox[{"the", " ", "type", " ", "of", " ", "this", " ", "edge"}], 
          " ", "*)"}], "\[IndentingNewLine]", "}"}], "&"}], "/@", "epfi"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"delete", " ", "any", " ", "edges", " ", "that", " ", "we", " ", 
        RowBox[{"couldn", "'"}], "t", " ", "assign", " ", "a", " ", "type", " ",
         "to"}], ",", " ", 
       RowBox[{
       "which", " ", "would", " ", "typically", " ", "arise", " ", "if", " ", 
        "the", " ", "tobj", " ", "was", " ", "missing", " ", "edges", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"e", ".", "g", "."}], ",", " ", 
           RowBox[{"is", " ", "borderless"}]}], ")"}], "."}]}]}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"emap", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"emap", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "]"}],
           "\[NotEqual]", "2"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "convert", " ", "each", " ", "entry", " ", "in", " ", "this", " ", 
       "map", " ", "to", " ", "a", " ", "list", " ", "of", " ", "segment", " ",
        "sets", " ", "and", " ", "then", " ", "to", " ", "styled", " ", 
       "lines"}], " ", "*)"}], "\n", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"ee", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ss", "=", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"verts2d", "\[LeftDoubleBracket]", 
              RowBox[{
              "ee", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"cpolys", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"verts2d", "\[LeftDoubleBracket]", 
              RowBox[{
              "faces", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}],
               "\[RightDoubleBracket]"}], "&"}], "/@", 
            RowBox[{
            "ee", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"ss", "=", 
           RowBox[{"Chop", "[", 
            RowBox[{"Fold", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ClipSegmentSetToQuasiConvexPolygonExterior", "[", 
                RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", "ss", ",", 
              "cpolys"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ssl1", ",", "ssl2"}], "}"}], "=", 
           RowBox[{"SegmentSetLines", "[", "ss", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"ListEmptyQ", "[", "ssl1", "]"}], ",", 
              RowBox[{"{", "}"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"ssl1", ",", 
                RowBox[{
                 RowBox[{
                 "ee", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                  "/.", "TypeToVisibleFoldedFormStyleRules"}]}], "]"}]}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"ListEmptyQ", "[", "ssl2", "]"}], ",", 
              RowBox[{"{", "}"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"ssl2", ",", 
                RowBox[{
                 RowBox[{
                 "ee", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                  "/.", "TypeToHiddenFoldedFormStyleRules"}]}], "]"}]}], 
             "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}], "/@", "emap"}],
       "]"}]}]}], "]"}]}]], "Input",
