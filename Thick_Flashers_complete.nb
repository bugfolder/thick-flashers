  FontSlant->"Italic"],
 "]\n\t(options) TilingTextColor, TilingLineColor, TilingFillColor"
}], "Subsubsection",
 CellChangeTimes->{{3.442605180944417*^9, 3.442605187408441*^9}, {
   3.442605252147149*^9, 3.442605285140089*^9}, {3.442605525149303*^9, 
