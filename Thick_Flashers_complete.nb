Cell[TextData[{
 "VertexCreasePatternGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex and produces a graphical rendering of the crease pattern \
as a circular vertex. Options are:\n\tSectorAngleLabels \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 " | None, specifies a list of labels for each sector angle;\n\t\
DihedralAngleLabels \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 " | None, specifies a list of labels for each dihedral angle (the tips of \
the direction vectors);\n\tOptions[Graphics] are passed through."
}], "Text",
 CellChangeTimes->{
  3.594806479326036*^9, {3.594806570768551*^9, 3.594806601382454*^9}, {
   3.594806689560814*^9, 3.594806734453295*^9}, 3.594811939935762*^9, 
