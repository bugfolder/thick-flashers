  3.691704265023052*^9}},ExpressionUUID->"13bd1913-0a7c-4f57-a758-\
055127fea86b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RuledSurfaceNormal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bbf_Function", ",", "ddf_Function", ",", " ", "\[Sigma]_"}], 
     "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"si", ",", "as", ",", "sfn", ",", "u", ",", "v", ",", "ss"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RuledSurfaceNormal", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RuledSurfaceNormal", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "\[Element]", "Reals"}], ",", 
           RowBox[{"v", "\[Element]", "Reals"}]}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"bbf", "[", "u", "]"}], "+", 
          RowBox[{"v", " ", 
           RowBox[{"ddf", "[", "u", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"SurfaceNormalFromSurface", "[", 
      RowBox[{"ss", ",", 
       RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}], ",", "opts"}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.691703750592947*^9, 3.691703768023967*^9}, {
   3.691703809508624*^9, 3.6917038429413*^9}, {3.691703914917136*^9, 
   3.691704012550197*^9}, {3.691704045719263*^9, 3.691704049422954*^9}, {
   3.691704084928058*^9, 3.6917040948759604`*^9}, 3.691704244745244*^9, {
   3.691704934634874*^9, 3.6917050140816107`*^9}, {3.691958302243108*^9, 
   3.691958303072514*^9}, {3.797265358989881*^9, 3.797265380108624*^9}, {
   3.797265412296301*^9, 3.797265415060872*^9}, 3.798622844934659*^9, {
   3.798626861209869*^9, 3.798626921772955*^9}},
 CellLabel->
  "In[3814]:=",ExpressionUUID->"1f0f416d-46a5-4000-80c5-94f676321431"],

Cell["Example. A hyperboloid, both orientations.", "Text",
 CellChangeTimes->{{3.691704277089357*^9, 3.69170427782851*^9}, {
  3.797265496452589*^9, 3.797265501980446*^9}, {3.798626992633671*^9, 
