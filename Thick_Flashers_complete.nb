Cell[TextData[{
 "InsetPoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hlist",
  FontSlant->"Italic"],
 "] insets the vertices of the given polygon by a different inset distance \
for each edge."
}], "Text",
 CellChangeTimes->{{3.4624320861764803`*^9, 3.46243211398945*^9}, {
  3.4624321533630133`*^9, 3.46243215581846*^9}, {3.721814791645355*^9, 
