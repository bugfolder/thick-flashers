Cell[CellGroupData[{

Cell["Rotational trapezoid tilings", "Subsection",
 CellChangeTimes->{{3.594070131567718*^9, 
  3.594070138213172*^9}},ExpressionUUID->"697d6561-7487-4b7a-9d11-\
a03b1d54d319"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.5940701884252787`*^9, 
  3.594070188865427*^9}},ExpressionUUID->"7093a5a3-274e-4c95-a36b-\
a77ee12b4238"],

Cell["\<\
For a pattern composed of trapezoids and triangles, the trapezoids are \
circumscribable; the triangles are, too; so we\[CloseCurlyQuote]re guaranteed \
to have a primal-dual twist tessellation. So we can build a rotationally \
symmetric graph of trapezoids and use it for a tessellation.\
\>", "Text",
 CellChangeTimes->{{3.592922319512085*^9, 3.592922347654621*^9}, {
  3.594070201369501*^9, 3.594070277442823*^9}, {3.5940744043425083`*^9, 
  3.59407442405107*^9}},ExpressionUUID->"ee003741-2904-4a56-badb-\
8c90e90bc4d6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeRotationalTrapezoidPrimalDualGraph[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rvals",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t",
 "(options)",
 " IncludeCenter"
}], "Subsubsection",
 CellChangeTimes->{{3.594070353278615*^9, 3.59407035367699*^9}, {
   3.594071899057574*^9, 3.594071945499595*^9}, 
   3.594732526556129*^9},ExpressionUUID->"176a47a5-bfab-4cda-bcd7-\
318ff589f054"],

Cell[TextData[{
 "MakeRotationalTrapezoidPrimalDualGraph[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rvals",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs a TPrimalDualGraph where the primal graph is a rotational \
trapezoid graph and the dual is its reciprocal diagram. The rotational order \
is ",
 StyleBox["m",
  FontSlant->"Italic"],
 ". ",
 StyleBox["rvals",
  FontSlant->"Italic"],
 " is a list of radial values of strictly increasing magnitude that define \
the radial spacing from the center. Options are:\n\tIncludeCenter \[Rule] \
True | False, which specifies whether to include the center point in the \
primal graph."
}], "Text",
 CellChangeTimes->{{3.594071976026512*^9, 3.5940720338005*^9}, {
  3.594072192146837*^9, 
  3.594072281371393*^9}},ExpressionUUID->"9a05dcab-b4b9-4247-9fbf-\
f6edfef86db6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRotationalTrapezoidPrimalDualGraph", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"IncludeCenter", "\[Rule]", "False"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.594072298932389*^9, 3.594072316299487*^9}},
 CellLabel->
  "In[3382]:=",ExpressionUUID->"a3a3a417-059d-45a1-8afc-b336b92b95cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRotationalTrapezoidPrimalDualGraph", "[", 
   RowBox[{
    StyleBox["m_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["rvals_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ic", ",", "vfn", ",", "tobj", ",", "verts", ",", "faces", ",", 
      "dverts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ic", "=", 
      RowBox[{
       RowBox[{"IncludeCenter", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "MakeRotationalTrapezoidPrimalDualGraph", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "\[Equal]", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{
         RowBox[{
         "rvals", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         RowBox[{"U", "[", 
          RowBox[{"2", "\[Pi]", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"j", "-", "1"}], ")"}], "/", "m"}]}], "]"}]}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Off", "[", 
      RowBox[{"N", "::", "meprec"}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "to", " ", "prevent", " ", "annoying", " ", "and", " ", "unimportant", " ",
        "warning"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeRotationalMesh", "[", 
         RowBox[{
          RowBox[{"Length", "[", "rvals", "]"}], ",", "m", ",", "vfn", ",", 
          RowBox[{"IncludeCenter", "\[Rule]", "ic"}]}], "]"}], "//", 
        "AddTPlaneGraph"}], "//", "AddTPrimalDualGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "tweak", " ", "dual", " ", "vertices", " ", "to", " ", "be", " ", "the",
        " ", "circumcenters", " ", "of", " ", "their", " ", "respective", " ",
        "faces"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{"Circumcenter", "/@", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
          "&"}], "/@", "faces"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"On", "[", 
      RowBox[{"N", "::", "meprec"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"DualVertices", "\[Rule]", "dverts"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.594072282990552*^9, 3.59407254970091*^9}, {
   3.594072687835335*^9, 3.594072719464876*^9}, {3.594072799318479*^9, 
   3.594072807124865*^9}, {3.594073135835485*^9, 3.594073224086699*^9}, {
   3.594073277858919*^9, 3.594073307198673*^9}, {3.5940733389281597`*^9, 
   3.594073470988161*^9}, {3.594073512978662*^9, 3.594073558310398*^9}, {
   3.594073604898123*^9, 3.594073657296502*^9}, {3.594073711990638*^9, 
   3.594073726772204*^9}, 3.59528613515065*^9, 3.617444348641064*^9, 
   3.617444406890429*^9},
 CellLabel->
