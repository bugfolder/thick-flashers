   RowBox[{"\[Gamma]_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ffa", ",", "fa", ",", "fw", ",", "fi", ",", "verts", ",", "edges", ",", 
      "f", ",", "ff", ",", "types", ",", "foldangles", ",", "tobj"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ffa", "=", 
      RowBox[{
       RowBox[{"FlapFoldAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeFlapCubeBox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{
       RowBox[{"FlapAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeFlapCubeBox", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fw", "=", 
