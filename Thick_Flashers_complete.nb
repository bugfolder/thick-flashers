 RowBox[{
  RowBox[{
   RowBox[{"AssertProperties", "::", "missing"}], 
   "=", "\"\<`1` is missing required properties `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591380119485355*^9, 3.591380160773065*^9}, {
   3.591637311350597*^9, 3.5916373126452217`*^9}, {3.591638930494255*^9, 
