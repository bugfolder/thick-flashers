Cell[CellGroupData[{

Cell[TextData[{
 "BorderlessTGraphAssignedToPlaneGraphAssigned[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.627692471042678*^9, 3.62769253686759*^9}, 
   3.627692626464312*^9, 
   3.6283377244324517`*^9},ExpressionUUID->"507f1169-08b6-48d8-a08c-\
a90b32bd9c26"],

Cell[TextData[{
 "BorderlessTGraphAssignedToPlaneGraphAssigned",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes an TGraph+TAssigned representing a crease pattern with no border \
(e.g., a vertex or twist clipped to a near-circular polygon) and adds edges \
with BorderLine edge type, so that it becomes a TPlaneGraphAssigned, \
representing a full crease pattern. Note: the original object is completely \
replaced; all vertices are potentially renumbered."
}], "Text",
 CellChangeTimes->{{3.5345553112043333`*^9, 3.534555401781596*^9}, {
   3.534555785700489*^9, 3.53455578639594*^9}, 3.534555941956925*^9, {
   3.591810679612638*^9, 3.5918106830119247`*^9}, {3.59181073740838*^9, 
   3.591810737775856*^9}, {3.591810781591448*^9, 3.591810787519676*^9}, {
   3.592434967658725*^9, 3.592434972383754*^9}, {3.592435042786919*^9, 
   3.592435046114462*^9}, {3.592435141414214*^9, 3.592435141620376*^9}, 
   3.592435235073925*^9, 3.592435864692101*^9, {3.592478746485688*^9, 
   3.59247878560744*^9}, {3.5924788852813177`*^9, 3.592478886561014*^9}, 
   3.592828732075912*^9, 3.592828900158015*^9, 3.592828960475031*^9, {
   3.592860624456154*^9, 3.592860625317618*^9}, 3.594734516985206*^9, 
   3.5947390406162*^9, {3.594739294907026*^9, 3.594739295178853*^9}, 
   3.594739460858908*^9},ExpressionUUID->"ef8b9c24-c9ce-4bb1-9959-\
7fbcf93a41fb"],

