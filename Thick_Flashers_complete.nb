Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTVertex3DFromFoldVectors", "[", 
   RowBox[{
    StyleBox["foldvectors_List",
     FontSlant->"Italic"], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gg", ",", "aa", ",", "\[Gamma]", ",", "\[Alpha]", ",", "mm"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gg", "=", 
      RowBox[{"NormalizeReal", "/@", "foldvectors"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"properly", " ", "normalized", " ", "fold", " ", "vectors"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"aa", "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Cross", ",", 
         RowBox[{"{", 
          RowBox[{"gg", ",", 
           RowBox[{"RotateLeft", "[", "gg", "]"}]}], "}"}]}], "]"}]}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{"normals", " ", "to", " ", "facets"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"DirectedAngle3D", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RotateRight", "[", "aa", "]"}], ",", "aa", ",", "gg"}], 
         "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"dihedral", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"ArcCos", "/@", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Dot", ",", 
         RowBox[{"{", 
          RowBox[{"gg", ",", 
           RowBox[{"RotateLeft", "[", "gg", "]"}]}], "}"}]}], "]"}]}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"mm", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"RotationMatrix3D", "[", 
           RowBox[{
            RowBox[{"#1", "/", "2"}], ",", "#2"}], "]"}], ".", "#3"}], "&"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]", ",", "gg", ",", 
          RowBox[{"RotateRight", "[", "aa", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"midarc", " ", "vectors"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"MakeTVertexFromAngles", "[", 
       RowBox[{"\[Alpha]", ",", "\[Gamma]", ",", "opts"}], "]"}], "//", 
      RowBox[{"AddClass", "[", 
       RowBox[{"TVertex3D", ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"SectorVectors", "\[Rule]", "aa"}], ",", 
          RowBox[{"FoldVectors", "\[Rule]", "gg"}], ",", 
          RowBox[{"MidfoldVectors", "\[Rule]", "mm"}]}], "}"}]}], "]"}]}]}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.439841167721726*^9, 3.439841187739758*^9}, {
   3.439841311402877*^9, 3.439841330568778*^9}, {3.4398415244723673`*^9, 
