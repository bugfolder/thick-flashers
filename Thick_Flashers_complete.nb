Cell[TextData[{
 "NSpaceCurveFold3D[",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 ", \[FinalSigma], {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D space curve for a fold and its fold angle function and creates \
the 3D ruled neighborhood of the fold."
}], "Text",
 CellChangeTimes->{{3.799443008826833*^9, 3.799443031243249*^9}, {
