Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeQuadMesh", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"VerticesFn", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Vertices3DFn", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"HorizontalEdgeTypeFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"U", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"VerticalEdgeTypeFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"U", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"HorizontalEdgeAngleFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"0", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"VerticalEdgeAngleFn", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{"0", "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"BorderOverride", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SamePtTolerance", "\[Rule]", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.59405784098194*^9, 3.594057861550724*^9}, {
   3.594058559826043*^9, 3.594058560353491*^9}, 3.5940600373287573`*^9, 
   3.594069749367968*^9, {3.594070511395748*^9, 3.594070531491131*^9}, {
   3.595000210149231*^9, 3.595000233436822*^9}, 3.595286115569757*^9, 
   3.617444139277069*^9, {3.6934107952615156`*^9, 3.693410863548826*^9}, {
   3.693410901358573*^9, 3.693410930662509*^9}, {3.693411660100937*^9, 
   3.693411665642791*^9}, {3.693412078974142*^9, 3.6934120840390463`*^9}, {
   3.693416276999155*^9, 3.693416288149284*^9}},
 CellLabel->
  "In[2071]:=",ExpressionUUID->"364bc839-2e2b-4e83-ab47-7e78f52794eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeQuadMesh", "::", "badverts"}], 
   "=", "\"\<At least one of VerticesFn and Vertices3DFn must be non-None in \
`1`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.693412050870543*^9, 3.693412146686911*^9}},
 CellLabel->
  "In[2072]:=",ExpressionUUID->"1518c19b-d7f1-494a-b07a-9c70507f09b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeQuadMesh", "[", 
   RowBox[{
    StyleBox["nh_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["nv_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vfn", ",", "v3dfn", ",", "hetfn", ",", "vetfn", ",", "heafn", ",", 
      "veafn", ",", "bo", ",", "spt", ",", "ivfn", ",", "iverts", ",", "si", ",",
       "verts", ",", "vifn", ",", "ne", ",", "edges", ",", "types", ",", 
      "verts3d", ",", "angles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vfn", "=", 
      RowBox[{
       RowBox[{"VerticesFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v3dfn", "=", 
      RowBox[{
       RowBox[{"Vertices3DFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hetfn", "=", 
      RowBox[{
       RowBox[{"HorizontalEdgeTypeFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vetfn", "=", 
      RowBox[{
       RowBox[{"VerticalEdgeTypeFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"heafn", "=", 
      RowBox[{
       RowBox[{"HorizontalEdgeAngleFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"veafn", "=", 
      RowBox[{
       RowBox[{"VerticalEdgeAngleFn", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bo", "=", 
      RowBox[{
       RowBox[{"BorderOverride", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"spt", "=", 
      RowBox[{
       RowBox[{"SamePtTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeQuadMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"edges", "=", 
       RowBox[{"types", "=", 
        RowBox[{"verts3d", "=", 
         RowBox[{"angles", "=", 
          RowBox[{"{", "}"}]}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "which", " ", "vertex", " ", "function", " ", "will", " ", "be", " ", 
       "used", " ", "for", " ", "uniqueness", " ", "tests"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ivfn", "=", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"vfn", "===", "None"}]}], ",", "vfn", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"!", 
         RowBox[{"v3dfn", "===", "None"}]}], ",", "v3dfn", ",", 
        "\[IndentingNewLine]", "True", ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"MakeQuadMesh", "::", "badverts"}], ",", 
           RowBox[{"{", "opts", "}"}]}], "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"iverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "see", " ", "if", " ", "the", " ", "point", " ", "already", " ", 
        "exists"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"si", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"spt", "===", "None"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"Catch", "[", 
            RowBox[{
             RowBox[{"MapIndexed", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"SamePtQ", "[", 
                   RowBox[{
                    RowBox[{"ivfn", "[", 
                    RowBox[{"i", ",", "j"}], "]"}], ",", "#1", ",", 
                    RowBox[{"SamePtTolerance", "\[Rule]", "spt"}]}], "]"}], ",", 
                  RowBox[{"Throw", "[", 
                   RowBox[{
                   "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}]}], "]"}], "&"}], ",", 
               "iverts"}], "]"}], ";", 
             RowBox[{"Throw", "[", "0", "]"}]}], "]"}], ",", "0"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"si", "\[Equal]", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"it", "'"}], "s", " ", "a", " ", "new", " ", "point"}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"iverts", ",", 
             RowBox[{"ivfn", "[", 
              RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"vfn", "===", "None"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"verts", ",", 
               RowBox[{"vfn", "[", 
                RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"verts", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"v3dfn", "===", "None"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"verts3d", ",", 
               RowBox[{"v3dfn", "[", 
                RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"verts3d", ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j", ",", "0"}], "}"}]}], "]"}]}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"vifn", "[", 
             RowBox[{"i", ",", "j"}], "]"}], "=", 
            RowBox[{"Length", "[", "iverts", "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"it", "'"}], "s", " ", "a", " ", "duplicate"}], ",", " ", 
            RowBox[{
            "so", " ", "record", " ", "the", " ", "duplicate", " ", 
             "index"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"vifn", "[", 
            RowBox[{"i", ",", "j"}], "]"}], "=", "si"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nv"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"ne", "[", 
        RowBox[{"i", ",", "j"}], "]"}], " ", "returns", " ", "true", " ", 
       "if", " ", "we", " ", "should", " ", "make", " ", "a", " ", "new", " ",
        "edge", " ", "from", " ", "this", " ", "vertex", " ", "pair"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ne", "[", 
       RowBox[{"vi_", ",", "vj_"}], "]"}], ":=", 
      RowBox[{"!", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"vi", "\[Equal]", "vj"}], ")"}], "||", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"edges", ",", 
           RowBox[{"{", 
            RowBox[{"vi", ",", "vj"}], "}"}]}], "]"}], "||", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"edges", ",", 
           RowBox[{"{", 
            RowBox[{"vj", ",", "vi"}], "}"}]}], "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"horizontal", " ", "edges"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ne", "[", 
          RowBox[{
           RowBox[{"vifn", "[", 
            RowBox[{"i", ",", "j"}], "]"}], ",", 
           RowBox[{"vifn", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "j"}], "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"edges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vifn", "[", 
               RowBox[{"i", ",", "j"}], "]"}], ",", 
              RowBox[{"vifn", "[", 
               RowBox[{
                RowBox[{"i", "+", "1"}], ",", "j"}], "]"}]}], "}"}]}], "]"}], 
          ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"types", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"bo", "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"j", "\[Equal]", "0"}], "||", 
                 RowBox[{"j", "\[Equal]", "nv"}]}], ")"}]}], ",", "B", ",", 
              RowBox[{"hetfn", "[", 
               RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"angles", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"bo", "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"j", "\[Equal]", "0"}], "||", 
                 RowBox[{"j", "\[Equal]", "nv"}]}], ")"}]}], ",", "0", ",", 
              RowBox[{"heafn", "[", 
               RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nv"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"nh", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"vertical", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ne", "[", 
          RowBox[{
           RowBox[{"vifn", "[", 
            RowBox[{"i", ",", "j"}], "]"}], ",", 
           RowBox[{"vifn", "[", 
            RowBox[{"i", ",", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"j", "+", "1"}], ",", "nv", ",", "1"}], "]"}]}], 
            "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"edges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"vifn", "[", 
               RowBox[{"i", ",", "j"}], "]"}], ",", 
              RowBox[{"vifn", "[", 
               RowBox[{"i", ",", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"j", "+", "1"}], ",", "nv", ",", "1"}], "]"}]}], 
               "]"}]}], "}"}]}], "]"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"types", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"bo", "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"i", "\[Equal]", "0"}], "||", 
                 RowBox[{"i", "\[Equal]", "nh"}]}], ")"}]}], ",", "B", ",", 
              RowBox[{"vetfn", "[", 
               RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"angles", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"bo", "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"i", "\[Equal]", "0"}], "||", 
                 RowBox[{"i", "\[Equal]", "nh"}]}], ")"}]}], ",", "0", ",", 
              RowBox[{"veafn", "[", 
               RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", 
         RowBox[{"nv", "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MakeTGraph3DAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", 
        RowBox[{"{", "}"}], ",", "verts3d", ",", "angles", ",", "types"}], 
       "]"}], "//", 
      RowBox[{"AddTCornerIndices", "[", 
       RowBox[{"{", 
        RowBox[{
