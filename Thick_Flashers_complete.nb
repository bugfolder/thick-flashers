  3.484757958137181*^9, 3.484757966924577*^9}, {3.4847584772226667`*^9, 
  3.484758477674583*^9}, {3.484758537841238*^9, 3.4847585420444*^9}, {
  3.62833909710271*^9, 3.628339113740876*^9}},
 CellLabel->
  "In[553]:=",ExpressionUUID->"267a1426-e1b1-4fd1-9672-371835adb3f3"],

Cell[TextData[{
 "SegmentSetLines[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}] takes a segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "} and returns a list {",
 StyleBox["lines1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lines2",
  FontSlant->"Italic"],
 "}, where ",
 StyleBox["lines1",
  FontSlant->"Italic"],
 " is the segment set for the interval set ",
 StyleBox["is",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["lines2",
  FontSlant->"Italic"],
 " is the segment set for the complement of the interval set ",
 StyleBox["is",
  FontSlant->"Italic"],
 " relative to the interval {0, 1}. Thus, both sets of line segments \
completely fill the line segment from ",
 StyleBox["q1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.484757996734728*^9, 3.484758119574978*^9}, {
  3.628961830770138*^9, 
  3.6289618309738197`*^9}},ExpressionUUID->"92c64179-3e96-46d3-aa1e-\
afc7211f3617"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SegmentSetLines", "[", 
   RowBox[{"{", 
    RowBox[{"q1_", ",", "q2_", ",", "is_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "isc", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"isc", "=", 
      RowBox[{"IntervalSetMinus", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], "}"}], ",", "is"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"complement", " ", "interval", " ", "set"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SegmentSetLine", "[", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "is"}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"SegmentSetLine", "[", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "isc"}], "}"}], "]"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.484758129370638*^9, 3.484758211765561*^9}, {
   3.484758320038828*^9, 3.484758323594058*^9}, {3.484758372266711*^9, 
   3.484758403025756*^9}, 3.484758465991123*^9},
 CellLabel->
  "In[554]:=",ExpressionUUID->"2e4e70f2-8e45-4d27-8a6d-7a48a1f2077b"],

Cell["Example", "Text",
 CellChangeTimes->{{3.484758215288972*^9, 
  3.484758215999826*^9}},ExpressionUUID->"d087cf4a-b2ff-4dd4-8b87-\
7d9bb6290a83"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1", ",", "q2", ",", "is", ",", "ssl1", ",", "ssl2"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"q1", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q2", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", ".5"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"is", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{".2", ",", ".4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".6", ",", ".8"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ssl1", ",", "ssl2"}], "}"}], "=", 
      RowBox[{"SegmentSetLines", "[", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", "is"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"ssl1", ",", "Green", ",", 
           RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{"ssl2", ",", "Red", ",", 
           RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.484757761018468*^9, 3.484757826838207*^9}, {
   3.484757958137181*^9, 3.484757966924577*^9}, {3.484758232036414*^9, 
   3.484758304041696*^9}, 3.484758337391388*^9, {3.484758410676331*^9, 
   3.484758483437259*^9}, {3.484758545232508*^9, 3.484758546900254*^9}},
 CellLabel->
  "In[555]:=",ExpressionUUID->"fff93605-3f77-4e20-9982-bc6889fbd900"],

Cell[TextData[{
 "SegmentSetFromHalfPlane[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}] takes a pair of points {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} and a triplet of points {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "} and returns the segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "} that describes the fraction of the line through ",
 StyleBox["q1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["q2",
  FontSlant->"Italic"],
 " that lies in the half-plane defined by the line through ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " that contains ",
 StyleBox["p3.",
  FontSlant->"Italic"],
 " Note that both point pairs must be distinct and ",
 StyleBox["p3",
  FontSlant->"Italic"],
 " cannot lie on the ",
 StyleBox["p1",
  FontSlant->"Italic"],
 "-",
 StyleBox["p2",
  FontSlant->"Italic"],
 " line or an error will result. Note also that the segment set will consist \
of a single interval."
}], "Text",
 CellChangeTimes->{{3.484759994058354*^9, 3.484760050102446*^9}, {
  3.484760161463208*^9, 3.484760201620589*^9}, {3.484760249755893*^9, 
  3.484760262696354*^9}, {3.484762502702265*^9, 3.4847625138932853`*^9}, {
  3.484769153172748*^9, 
  3.484769166259978*^9}},ExpressionUUID->"ba740911-84d8-4ebc-887b-\
ad9a5fbdd370"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SegmentsFromHalfPlane", "::", "badsegs"}], 
   "=", "\"\<Segment set points `1` and `2` are not distinct.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SegmentsFromHalfPlane", "::", "badplane"}], 
   "=", "\"\<Half-plane points `1` and `2` are not distinct.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SegmentsFromHalfPlane", "::", "badp3"}], 
   "=", "\"\<The point `1` that should define the half-plane lies on the line \
through `2` and `3`.\>\""}], ";"}]}], "Input",
 CellChangeTimes->{{3.48476026456376*^9, 3.484760383011566*^9}, 
   3.484762215698885*^9},
 CellLabel->
  "In[556]:=",ExpressionUUID->"c50b7e52-71d4-4b0b-b8bb-2340b69da248"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SegmentSetFromHalfPlane", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"detq", ",", "rp", ",", "t", ",", "t0"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"q1", "-", "q2"}], "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"SegmentsFromHalfPlane", "::", "badsegs"}], ",", "q1", ",", 
          "q2"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"p1", "-", "p2"}], "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"SegmentsFromHalfPlane", "::", "badplane"}], ",", "p1", ",",
           "p2"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"rp", "=", 
      RowBox[{"Rotate90", "[", 
       RowBox[{"p2", "-", "p1"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "rp", " ", "is", " ", "perpendicular", " ", "to", " ", "the", " ", 
        "half"}], "-", 
       RowBox[{"plane", " ", "line"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"rp", ".", 
         RowBox[{"(", 
          RowBox[{"p3", "-", "p1"}], ")"}]}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"SegmentsFromHalfPlane", "::", "badp3"}], ",", "p3", ",", 
          "p1", ",", "p2"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"detq", "=", 
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q2", "-", "q1"}], ",", 
         RowBox[{"p2", "-", "p1"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Chop", "[", "detq", "]"}], "\[Equal]", "0"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"p", "-", 
         RowBox[{"line", " ", "and", " ", "q"}], "-", 
         RowBox[{"line", " ", "are", " ", "parallel"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"rp", ".", 
            RowBox[{"(", 
             RowBox[{"p3", "-", "p1"}], ")"}]}], "]"}], "\[Equal]", 
          RowBox[{"Sign", "[", 
           RowBox[{"rp", ".", 
            RowBox[{"(", 
             RowBox[{"q1", "-", "p1"}], ")"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2", ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], 
             "}"}]}], "}"}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"q", "-", 
           RowBox[{
           "line", " ", "is", " ", "on", " ", "the", " ", "p3", " ", "side", " ",
             "of", " ", "p"}], "-", "line"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2", ",", 
            RowBox[{"{", "}"}]}], "}"}], "]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"q", "-", 
          RowBox[{
          "line", " ", "is", " ", "NOT", " ", "on", " ", "the", " ", "p3", " ",
            "side", " ", "of", " ", "p"}], "-", 
          RowBox[{
          "line", " ", "or", " ", "lies", " ", "on", " ", "the", " ", 
           "half"}], "-", 
          RowBox[{"plane", " ", "boundary"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"p", "-", "line"}], ",", " ", 
       RowBox[{"q", "-", 
        RowBox[{"line", " ", "are", " ", "not", " ", "parallel"}]}], ",", " ", 
       RowBox[{
       "so", " ", "compute", " ", "their", " ", "intersection", " ", 
        "parameter", " ", "t"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", "=", " ", 
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p1", "-", "q1"}], ",", 
          RowBox[{"p2", "-", "p1"}]}], "}"}], "]"}], "/", "detq"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t0", "=", 
      RowBox[{"t", "-", "1"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"a", " ", "test", " ", "value"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PtInHalfPlaneQ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "t0"}], ")"}], "q1"}], "+", 
          RowBox[{"t0", " ", "q2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}], " ", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "\[Infinity]"}], ",", "t"}], "}"}], "}"}]}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"t", ",", "\[Infinity]"}], "}"}], "}"}]}], "}"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.484759167639487*^9, 3.4847592036187973`*^9}, {
   3.484759290184188*^9, 3.484759358285417*^9}, {3.484759439300983*^9, 
   3.484759475530484*^9}, 3.4847595195885077`*^9, {3.484759603134058*^9, 
   3.484759623585005*^9}, {3.4847596604981823`*^9, 3.484759663778775*^9}, {
   3.484759831405652*^9, 3.484759845434492*^9}, {3.484759984278195*^9, 
   3.484759991151816*^9}, {3.4847603866337023`*^9, 3.484760401103095*^9}, {
   3.484762172626385*^9, 3.484762218185147*^9}, {3.4847624222844553`*^9, 
   3.4847624733626337`*^9}, {3.484762528436314*^9, 3.4847625520192413`*^9}, {
   3.48476258511215*^9, 3.484762601478338*^9}, {3.4847628682932796`*^9, 
   3.4847629566851683`*^9}, {3.4847631722428217`*^9, 3.484763222519582*^9}, {
   3.484826963152969*^9, 3.484826973006914*^9}, {3.484827055137385*^9, 
   3.484827082032933*^9}, {3.484827115712219*^9, 3.484827148749999*^9}},
 CellLabel->
  "In[559]:=",ExpressionUUID->"7f25f2c0-46fe-4e00-ac0e-180fd98fe422"],

