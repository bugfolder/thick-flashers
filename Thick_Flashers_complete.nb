Cell[BoxData[
 RowBox[{
  RowBox[{"NFlattenFold2D", "[", 
   RowBox[{
    RowBox[{"ff_Function", "|", "ff_InterpolatingFunction"}], ",", 
    RowBox[{"rrL_Function", "|", "rrL_InterpolatingFunction"}], ",", 
    RowBox[{"rrR_Function", "|", "rrR_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "fi_List", ",", "ti_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "dff", ",", "ds", ",", "tt", ",", "uuL", ",", "llL", ",", 
      "c\[Rho]L", ",", "s\[Rho]L", ",", "uuR", ",", "llR", ",", "c\[Rho]R", ",",
       "s\[Rho]R", ",", "\[Kappa]g", ",", "csys", ",", "f", ",", "t", ",", 
      "\[Kappa]l", ",", "rL", ",", "rR"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"(*", " ", 
     RowBox[{"speed", " ", "and", " ", "tangent"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ff", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"dff", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"dff", "[", "s", "]"}], "/", 
         RowBox[{"ds", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"txr", "=", 
            RowBox[{
             RowBox[{"tt", "[", "s", "]"}], "\[Cross]", 
             RowBox[{"rrL", "[", "s", "]"}]}]}], "}"}], ",", 
          RowBox[{"NormalizeReal", "[", "txr", "]"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"llL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuL", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"tt", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"rrL", "[", "s", "]"}], ".", 
         RowBox[{"tt", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"rrL", "[", "s", "]"}], ".", 
         RowBox[{"llL", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"txr", "=", 
            RowBox[{"-", 
             RowBox[{
              RowBox[{"tt", "[", "s", "]"}], "\[Cross]", 
              RowBox[{"rrR", "[", "s", "]"}]}]}]}], "}"}], ",", 
          RowBox[{"NormalizeReal", "[", "txr", "]"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"llR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuR", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"tt", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"rrR", "[", "s", "]"}], ".", 
         RowBox[{"tt", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"-", 
         RowBox[{
          RowBox[{"rrR", "[", "s", "]"}], ".", 
          RowBox[{"llR", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Integrate", " ", "planar", " ", "Darboux", " ", "frame", " ", 
       "equation", " ", "for", " ", "the", " ", "2", "D", " ", "curved", " ", 
       "fold"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"llL", "[", "s", "]"}], ".", 
          RowBox[{
           RowBox[{"tt", "'"}], "[", "s", "]"}]}], "/", 
         RowBox[{"ds", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"NRecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]g", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "fi", ",", "ti"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "t", ",", "\[Kappa]l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Curve2D", ",", "TangentVector2D", ",", "LeftCurvature2D"}], 
        "}"}], "/.", "csys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c\[Rho]L", "[", "s", "]"}], ",", 
            RowBox[{"s\[Rho]L", "[", "s", "]"}]}], "}"}], "]"}], ".", 
         RowBox[{"t", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"rR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c\[Rho]R", "[", "s", "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"s\[Rho]R", "[", "s", "]"}]}]}], "}"}], "]"}], ".", 
         RowBox[{"t", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"f", ",", "rL", ",", "rR"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.799443499854664*^9, 3.799443551389594*^9}, {
