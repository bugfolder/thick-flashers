Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MonolithicTGraph", "::", "usage"}], 
   "=", "\"\<MonolithicTGraph is a type of tile decoration that renders the \
full tiling as a single TGraph.\>\""}], ";"}]], "Input",
