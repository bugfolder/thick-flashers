       RowBox[{"Options", "[", "Styled3DAxes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ac", "=", 
      RowBox[{
       RowBox[{"AxesColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
