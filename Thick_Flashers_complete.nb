Cell[TextData[{
 "PolygonAngles[",
 StyleBox["verts",
  FontSlant->"Italic"],
 "] returns the CCW interior angles of the closed polygon whose vertices are ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.628529083740372*^9, 3.628529105659264*^9}, {
