Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "h", ",", "\[Gamma]0", ",", "ff", ",", "\[Gamma]", ",", "as", ",", 
      "cfsys", ",", "rrL", ",", "rrR", ",", "u0", ",", "u1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"h", "#"}]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"\[Gamma]0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h", "\[Element]", "Reals"}], ",", 
        RowBox[{"\[Gamma]0", "\[Element]", "Reals"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
      RowBox[{"FoldSpaceCurve3D", "[", 
       RowBox[{"ff", ",", "\[Gamma]", ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrL = \>\"", ",", 
        RowBox[{"rrL", "//", "PrettyParameters"}]}], "]"}], "//", "Hold"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrR = \>\"", ",", 
        RowBox[{"rrR", "//", "PrettyParameters"}]}], "]"}], "//", "Hold"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"h", "=", "0.5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]0", "=", 
