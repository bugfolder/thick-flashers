Cell[TextData[{
 "Single",
 "VertexEdgeAngles",
 "3D[",
 StyleBox["tobj, i0, i1",
  FontSlant->"Italic"],
 "] returns the face angles around vertex i0 oriented so that the first angle \
is the face that follows edge {i0, i1}."
}], "Text",
