Cell[TextData[{
 "FoldAngleCreasePatternGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a rendering of the crease pattern but labels the fold angles with \
their values. See FoldAngleGraphics and related functions for the options."
}], "Text",
 CellChangeTimes->{
  3.617405654902039*^9, {3.617405834153528*^9, 
   3.617405879516108*^9}},ExpressionUUID->"f07965c1-9a1b-4f5d-b11f-\
017bc4947831"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAngleCreasePatternGraphics", "[", 
   RowBox[{"tobj_TObj", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cp", ",", "elabels"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph3D", ",", "TAssigned"}], "}"}], ",", 
       "FoldAngleCreasePatternGraphics"}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"cp", "=", 
      RowBox[{
       RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"elabels", "=", 
      RowBox[{"FoldAngleLabels", "[", 
       RowBox[{"tobj", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cp", ",", "elabels"}], "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
