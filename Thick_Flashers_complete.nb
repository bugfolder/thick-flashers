Cell[TextData[{
 "GraphicsExtent",
 "[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] returns the {",
 StyleBox["width",
  FontSlant->"Italic"],
 ", ",
 StyleBox["height",
  FontSlant->"Italic"],
 "} of the bounding box of all the Point, Line, and Polygon objects in ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ". If there are no objects, it returns {0,0}."
}], "Text",
 CellChangeTimes->{{3.457529845663796*^9, 3.457529849551164*^9}, {
   3.592213213922827*^9, 3.592213219752509*^9}, 3.592213936239807*^9, {
