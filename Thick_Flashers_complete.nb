Cell["Example. Tiling, crease pattern, and folded form.", "Text",
 CellChangeTimes->{{3.629848764316999*^9, 
  3.62984877231464*^9}},ExpressionUUID->"93421856-8e0d-407d-9a9b-\
dc27a879dd0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "angles", ",", "side", ",", "is", ",", "w", ",", "\[Tau]", ",", "types1",
       ",", "types2", ",", "tiling"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"75", "\[Degree]"}], ",", 
        RowBox[{"85", "\[Degree]"}], ",", 
        RowBox[{"95", "\[Degree]"}], ",", 
        RowBox[{"105", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"side", "=", "1.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"is", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"80", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types1", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types2", "=", 
      RowBox[{"{", 
       RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"UnitCyclicPolygonCenteredTwistTile", ",", 
            RowBox[{"{", 
             RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",",
             "\[Tau]", ",", "types1"}], "}"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"UnitCyclicPolygonCenteredTwistTile", ",", 
             RowBox[{"{", 
              RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",",
              "\[Tau]", ",", "types2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "Tiling", ",", 
             RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowDF"}]}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629828101472671*^9, 3.629828167961506*^9}, 
   3.629828494028514*^9, {3.629828599943145*^9, 3.629828738380302*^9}, 
