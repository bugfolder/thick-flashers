   3.6424328424323683`*^9, 3.642432936820815*^9}, {3.642630573557827*^9, 
   3.642630598717555*^9}, {3.643238627590968*^9, 3.643238633526675*^9}, {
   3.643291028482912*^9, 3.6432910777922697`*^9}, {3.643291142565658*^9, 
   3.64329122124889*^9}, {3.693409585700158*^9, 3.693409594356698*^9}, {
   3.693409628884544*^9, 3.693409641532194*^9}, {3.693409676676445*^9, 
   3.693409683683889*^9}, {3.693409721404892*^9, 3.693409824965036*^9}, {
   3.69340985566963*^9, 3.6934098575734386`*^9}, {3.693409903477821*^9, 
   3.6934100299431677`*^9}, {3.693410154671775*^9, 3.693410159983917*^9}, {
   3.693410382408949*^9, 3.693410431305779*^9}, {3.693410559403784*^9, 
   3.693410677035753*^9}, {3.693410874429264*^9, 3.693410884773408*^9}, {
   3.6934119405748*^9, 
   3.693411970236948*^9}},ExpressionUUID->"b65f0eb0-dcad-43f8-b41b-\
b5b4a5eb61de"],

Cell["\<\
Returns a TGraphAssigned+TCornerIndices of Vertices, Edges, and EdgeTypes \
(but no Faces). Call AddTPlaneGraph to add faces.\
\>", "Text",
 CellChangeTimes->{{3.693409645644493*^9, 3.6934096649156103`*^9}, {
   3.693409840252633*^9, 3.693409885148851*^9}, 
   3.693411448946349*^9},ExpressionUUID->"de05d42d-42f5-44b2-94b3-\
1706f6b20c39"],

Cell[TextData[{
 "Typically {",
 StyleBox["i",
  FontSlant->"Italic"],
 "=0, ",
 StyleBox["j",
  FontSlant->"Italic"],
 "=0} will be the lower left corner of the pattern with ",
 StyleBox["i",
  FontSlant->"Italic"],
 "\[Element][0, ",
 StyleBox["nh",
  FontSlant->"Italic"],
 "] and ",
 StyleBox["j",
  FontSlant->"Italic"],
 "\[Element][0, ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "]."
}], "Text",
 CellChangeTimes->{{3.693409775206149*^9, 3.693409778539623*^9}, {
  3.693411953836592*^9, 
  3.693411960707962*^9}},ExpressionUUID->"e947c72e-3ba6-4c13-8c3c-\
3224f6df94f2"],

Cell["\<\
This allows for \[OpenCurlyDoubleQuote]reduction\[CloseCurlyDoubleQuote] of a \
quad mesh: merging two or more vertices to a single point if they are within \
a specified tolerance of one another. Use SamePtTolerance \[Rule] None to \
never merge. This allows the generation of rotational patterns that \
\[OpenCurlyDoubleQuote]wrap around\[CloseCurlyDoubleQuote] and/or have a \
central point; see the example below.\
\>", "Text",
 CellChangeTimes->{{3.69341012356774*^9, 3.6934101435907717`*^9}, {
  3.693410681490802*^9, 3.693410735259198*^9}, {3.693415528991222*^9, 
  3.693415571815715*^9}},ExpressionUUID->"c24ca1b0-8334-466d-9b77-\
d9decac87204"],

Cell["\<\
If VerticesFn \[Rule] None or Vertices3DFn \[Rule] None, then the Vertices or \
Vertices3D (respectively) will be set to dummy values. You can overwrite them \
with valid values by using FoldGraph3D or UnfoldGraph3D, assuming that the \
fold angles were properly set. All of the edge types and fold angles will be \
set in either case.\
\>", "Text",
 CellChangeTimes->{{3.693411130518214*^9, 3.693411173038201*^9}, {
  3.693411735307158*^9, 3.693411781970866*^9}, {3.693414752665459*^9, 
  3.693414804713746*^9}, {3.693414840392639*^9, 3.6934148999462957`*^9}, {
  3.693415591607717*^9, 
  3.693415627008121*^9}},ExpressionUUID->"651fa374-65cc-4086-b405-\
4f3e8c1abc7f"],

