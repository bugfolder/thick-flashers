Cell["\<\
Example. The default flasher solution should be fairly close, so that our \
error values should be small.\
\>", "Text",
 CellChangeTimes->{{3.911850656416027*^9, 3.911850657985725*^9}, {
  3.9118791240121*^9, 
  3.911879174261628*^9}},ExpressionUUID->"abe77773-93d6-4e25-beca-\
0cc41879dbc4"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pp", ",", 
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "4"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "vars", ",", "xyfns", ",", "ffrules"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"FlasherVars", "[", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"xyfns", "=", 
     RowBox[{"ThickFlasherXYFns", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PrintThis", "[", "xyfns", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"ffrules", "=", 
     RowBox[{"ThickFlasherDefaultFFRules", "[", 
      RowBox[{"pp", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"xyfns", "/.", 
     RowBox[{"FlasherDefaultScalarRules", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}]}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9118506769971237`*^9, 3.91185068775434*^9}, 
   3.911878822172861*^9, {3.911879012693489*^9, 3.911879039254072*^9}, 
   3.911879085073278*^9, 3.911879139144905*^9},
 CellLabel->
  "In[4486]:=",ExpressionUUID->"05738819-61c9-4af4-86c7-5d129fd08d4d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Thick flasher construction", "Subsection",
 CellChangeTimes->{{3.911880948510447*^9, 
  3.9118809526282787`*^9}},ExpressionUUID->"d40e9708-e8e4-4ad5-acc8-\
c257e359bb1f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.91354511560742*^9, 
  3.913545117138323*^9}},ExpressionUUID->"f35032a1-7727-4c42-8f95-\
50e12fb8c1da"],

Cell["\<\
Just as we added the focal length and DP vertices and DP graphcs to the \
parabolic flasher TObj properties, we\[CloseCurlyQuote]ll add the thickness, \
DP vertices and DP graphics to the TObj of a thick flasher, after we\
\[CloseCurlyQuote]ve solved for it.\
\>", "Text",
 CellChangeTimes->{{3.913545120423615*^9, 
  3.913545191390806*^9}},ExpressionUUID->"088acad7-733e-45ce-9f3b-\
883488778eca"],

Cell["\<\
Remember, though, that we\[CloseCurlyQuote]re still solving for the \
zero-thickness surface of the thick flasher. Panelization comes later.\
\>", "Text",
 CellChangeTimes->{{3.913545193730078*^9, 
  3.913545211618359*^9}},ExpressionUUID->"89cefe04-f1ee-4215-bc77-\
b85abaae2045"]
}, Closed]],

