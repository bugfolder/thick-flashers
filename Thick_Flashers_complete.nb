              RowBox[{"NormalizeReal", "[", 
               RowBox[{"q", "\[Cross]", 
                RowBox[{"gg", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
               "]"}], ",", 
              RowBox[{"NormalizeReal", "[", 
               RowBox[{"q", "\[Cross]", 
                RowBox[{"gg", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
               "]"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", "OsculatingLine"}]}], "]"}], 
            "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"osculating", " ", "plane"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"srp", ",", 
           RowBox[{"{", 
            RowBox[{"Styled3DUnitCircleFromInPlaneVectors", "[", 
             RowBox[{
              RowBox[{"NormalizeReal", "[", 
               RowBox[{"z", "\[Cross]", 
                RowBox[{"gg", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
               "]"}], ",", 
              RowBox[{"NormalizeReal", "[", 
               RowBox[{"z", "\[Cross]", 
                RowBox[{"gg", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
               "]"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", "RulingLine"}]}], "]"}], "}"}], 
           ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"ruling", " ", "plane"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"stp", ",", 
           RowBox[{"{", 
            RowBox[{"Styled3DUnitCircleFromInPlaneVectors", "[", 
             RowBox[{
              RowBox[{"NormalizeReal", "[", 
               RowBox[{"t", "\[Cross]", 
                RowBox[{"gg", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
               "]"}], ",", 
              RowBox[{"NormalizeReal", "[", 
               RowBox[{"t", "\[Cross]", 
                RowBox[{"gg", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
               "]"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", "MidfoldNormalLine"}]}], "]"}], 
            "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"tangent", " ", "plane"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"srgc", ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Styled3DUnitCircleFromInPlaneVectors", "[", 
               RowBox[{
                RowBox[{"aa", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mni", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], ",", 
                RowBox[{"aa", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], ",", 
                RowBox[{"LineStyle", "\[Rule]", "CreaseLine"}]}], "]"}], ",", 
              
              RowBox[{"Styled3DUnitCircleFromInPlaneVectors", "[", 
               RowBox[{
                RowBox[{"aa", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mji", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], ",", 
                RowBox[{"aa", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "mni", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], ",", 
                RowBox[{"LineStyle", "\[Rule]", "CreaseLine"}]}], "]"}]}], 
             "}"}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"ruling", " ", "great", " ", "circles"}], " ", "*)"}], 
         "\[IndentingNewLine]", "glist"}], "]"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
