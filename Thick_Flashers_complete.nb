Cell["Example: vertex of the central polygon.", "Text",
 CellChangeTimes->{{3.555776321567411*^9, 3.5557763271667233`*^9}, 
   3.5557764366906147`*^9, {3.825605447389286*^9, 
   3.825605448813591*^9}},ExpressionUUID->"96640764-be2b-4915-9284-\
413e97d9c24e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "p", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     SubscriptBox["p", 
      RowBox[{"0", ",", "0", ",", "0"}]], "/.", 
     RowBox[{"ParaboloidalFlasherDefaultDPRules", "[", 
      RowBox[{"p", ",", "4", ",", "10"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.5557763321997747`*^9, 3.555776345018807*^9}, 
   3.555776409766185*^9, 3.719848622679955*^9, 3.719848673659417*^9, 
   3.7198487321219873`*^9, 3.719854079732885*^9, 3.719936124588297*^9, {
   3.7199460270657597`*^9, 3.719946059547052*^9}, {3.825604447496179*^9, 
   3.825604454798888*^9}, {3.825671175560085*^9, 3.825671178257182*^9}, {
   3.825672266780912*^9, 3.825672267318776*^9}, 3.911827950246296*^9},
 CellLabel->
  "In[4102]:=",ExpressionUUID->"60d536a2-831a-45bd-b5a5-59bf7927cff6"],

Cell["\<\
Example: the central polygon in 3D with an inscribed unit-diameter cylinder.\
\>", "Text",
 CellChangeTimes->{{3.854987857706443*^9, 3.8549878752638397`*^9}, {
  3.854988077642039*^9, 
  3.8549880820337343`*^9}},ExpressionUUID->"322efc96-968f-4fb4-9772-\
4ecb46205532"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"m", "=", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cylinder", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"-", ".1"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"1", "/", "2"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Line", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           SubscriptBox["p", 
            RowBox[{"0", ",", "0", ",", "k"}]], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "m"}], "}"}]}], "]"}], "]"}]}], "}"}],
       "]"}], "/.", 
     RowBox[{"ParaboloidalFlasherDefaultDPRules", "[", 
      RowBox[{"p", ",", "m", ",", "10"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.8549878934071817`*^9, 3.8549880127236557`*^9}, {
   3.854988051194578*^9, 3.854988055976958*^9}, {3.854988086250733*^9, 
   3.85498815785802*^9}, 3.911827950250244*^9},
