Cell["\<\
Example. Compare DiscreteEllipseEquiaxial (red), DiscreteEllipseEquilateral \
(green), DiscreteEllipseEquiangular (blue).\
\>", "Text",
 CellChangeTimes->{{3.671290655402719*^9, 3.671290676062862*^9}, {
   3.671290756665588*^9, 3.671290762144818*^9}, 3.673174061664602*^9, {
   3.673174715083139*^9, 
   3.673174734352689*^9}},ExpressionUUID->"889dd717-932b-4026-9039-\
85803f5cf817"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "a", ",", "b", ",", "\[Phi]", ",", "\[Theta]", ",", "pts1", ",",
       "pts2", ",", "pts3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "24"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", "GoldenRatio"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", "1."}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"0", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"0", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{"DiscreteEllipseEquiaxial", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", "\[Phi]", ",", "\[Theta]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts2", "=", 
      RowBox[{"DiscreteEllipseEquilateral", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", "\[Phi]", ",", "\[Theta]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts3", "=", 
      RowBox[{"DiscreteEllipseEquiangular", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", "\[Phi]", ",", "\[Theta]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pts1", "]"}], "]"}], ",", "Red"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pts2", "]"}], "]"}], ",", "Green"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pts3", "]"}], "]"}], ",", "Blue"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", "pts1"}], ",", 
           RowBox[{"PointSize", "[", ".025", "]"}], ",", 
           RowBox[{"Darker", "[", "Red", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", "pts2"}], ",", 
           RowBox[{"PointSize", "[", ".015", "]"}], ",", 
           RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", "pts3"}], ",", 
           RowBox[{"PointSize", "[", ".005", "]"}], ",", 
           RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
