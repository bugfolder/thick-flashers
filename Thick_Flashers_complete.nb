Cell[BoxData[
 RowBox[{
  RowBox[{"NReshapeTandev3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b_Function", "|", "b_InterpolatingFunction"}], ",", 
      RowBox[{"d_Function", "|", "d_InterpolatingFunction"}], ",", 
      "\[Sigma]_"}], "}"}], ",", "\[Tau]_Function", ",", "sv_", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bbi_List", ",", "ddi_List", ",", "uui_List"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "fiopts", ",", "s", ",", "ds", ",", "t", ",", "l", ",", 
      "u", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "sd\[Kappa]g", ",", 
      "sd\[Kappa]n", ",", "sd\[Tau]g", ",", "\[Zeta]", ",", "lli", ",", "tti",
       ",", "tt", ",", "ll", ",", "uu", ",", "bb", ",", "dd"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fiopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "algorithm", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"b", "[", "s", "]"}], ",", "s"}], "]"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"db", "=", 
            RowBox[{
             RowBox[{"b", "'"}], "[", "s", "]"}]}], "}"}], ",", 
          RowBox[{"NormalizeReal", "[", "db", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"u", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ddd", "=", 
            RowBox[{
             RowBox[{"d", "'"}], "[", "s", "]"}]}], "}"}], ",", 
          RowBox[{"\[Sigma]", " ", "sv", " ", 
           RowBox[{
            RowBox[{"NormalizeReal", "[", "ddd", "]"}], "\[Cross]", 
            RowBox[{"d", "[", "s", "]"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"t", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]g", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"l", "[", "s", "]"}], ".", 
         RowBox[{
          RowBox[{"t", "'"}], "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g", "=", "\[Tau]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Zeta]", "=", 
      RowBox[{
       RowBox[{"t", "[", "ui", "]"}], ".", 
       RowBox[{"d", "[", "ui", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tti", "=", 
      RowBox[{"\[Zeta]", " ", "ddi"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lli", " ", "=", " ", 
      RowBox[{"uui", " ", "\[Cross]", "tti"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "tt", ",", "ll", ",", "uu"}], "}"}], "=", 
      RowBox[{"NRecoverDarboux3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ds", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", "sd\[Tau]g"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "tti", ",", "lli", ",", "uui"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Zeta]", " ", 
         RowBox[{"tt", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
