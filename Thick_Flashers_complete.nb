Cell[CellGroupData[{

Cell["Thick Flashers", "Title",
 CellChangeTimes->{{3.911146263849428*^9, 3.9111462645843697`*^9}, {
   3.913538559704278*^9, 3.913538570235007*^9}, {3.913555977885318*^9, 
   3.9135559868052177`*^9}, 
   3.922122634687294*^9},ExpressionUUID->"a56c6b70-7bcc-42e8-ad24-\
83c495336311"],

Cell[CellGroupData[{

Cell["Thick flashers", "Section",
 CellChangeTimes->{{3.912575286917019*^9, 
  3.912575289447122*^9}},ExpressionUUID->"b411bdab-4b8a-410d-872a-\
2ba7848b136b"],

Cell[CellGroupData[{

Cell["General flasher support functions", "Subsection",
 CellChangeTimes->{{3.912574641951713*^9, 
  3.912574648246151*^9}},ExpressionUUID->"1cceb2f7-adb4-43df-bc79-\
90cbe4083a82"],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherSectorVerticesRadiallyOrdered[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "]\nFlasherSectorVerticesRadiallyOrdered[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.911477289528269*^9, 3.911477310072372*^9}, {
  3.911581675463614*^9, 3.911581709011921*^9}, {3.911581813470801*^9, 
  3.9115818342181783`*^9}, {3.911582304945364*^9, 3.911582304967359*^9}, {
  3.911583958276923*^9, 3.911583985930117*^9}, {3.911584051497227*^9, 
  3.911584052948562*^9}},ExpressionUUID->"a7155833-689a-4500-8bda-\
c90bfd6b38e0"],

Cell[TextData[{
 "FlasherSectorVerticesRadiallyOrdered[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "] creates a structured list of the vertices of a specified sector, grouped \
by axial and radial position in the stowed configuration."
}], "Text",
 CellChangeTimes->{{3.91147732013793*^9, 3.9114773592233562`*^9}, {
   3.911581678749557*^9, 3.911581693082488*^9}, 3.9115818355117407`*^9, 
   3.911582304990377*^9, 3.911583994695592*^9, {3.911584055974341*^9, 
   3.911584058370955*^9}, {3.911645990964457*^9, 3.911645991492549*^9}, {
   3.911752931285737*^9, 3.911752946237666*^9}, {3.913541114636345*^9, 
   3.913541139159179*^9}},ExpressionUUID->"40ef0ef2-ed61-43cd-832d-\
3a0e196733d1"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the symbol for each vertex, which will be subscripted, e.g., \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "11a86944-a96d-4b8a-a201-2535f547c27d"],
 "\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radial index (number of rings)\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index\n\t",
 StyleBox["k",
  FontSlant->"Italic"],
 " \[LongDash] the rotational sector. Default value is ",
 StyleBox["k",
  FontSlant->"Italic"],
 "=0."
}], "Text",
 CellChangeTimes->{{3.911581473735094*^9, 3.911581488866598*^9}, {
  3.911581732604206*^9, 3.911581750660321*^9}, {3.91158399730435*^9, 
  3.9115840179380283`*^9}, {3.911584064311276*^9, 
  3.911584068744628*^9}},ExpressionUUID->"b8ba0b4a-cebe-4abf-9fc7-\
207fef5e45c1"],

Cell[TextData[{
 "Returns: a nested list of the specified-sector vertices, i.e., vertices of \
the form ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "8e43fa9f-0837-4d88-94f1-51295374a693"],
 ". Each sub-group is a set of vertices at a particular radial position, \
ordered from innermost outward. Each successive group of vertices is rotated \
by one rotational increment from its predecessors."
}], "Text",
 CellChangeTimes->{{3.9115814927028637`*^9, 3.911581619055224*^9}, {
  3.911581765578697*^9, 3.911581778979059*^9}, {3.911584032293289*^9, 
  3.911584048920618*^9}},ExpressionUUID->"75be198f-543a-44dc-b3bd-\
0dc2d1395b08"],

Cell["\<\
Terminology:
\tMajor folds are the fully-folded creases that run along the bottom or top \
of the folded form, parallel to the x-y plane.
\tMinor folds are the partially-folded creases that wrap the layers around \
the central polygon. They run vertically in the folded form of an ideal \
flasher (zero thickness, flat-folded stacking of layers).
\tDiagonal folds are the diagonals (which are also fully-folded in an ideal \
flasher).\
\>", "Text",
 CellChangeTimes->{{3.911477382749571*^9, 3.911477468867482*^9}, {
  3.913541841448009*^9, 3.913541857309732*^9}, {3.914857153600687*^9, 
  3.914857221331293*^9}},ExpressionUUID->"6c761b73-5544-4896-881c-\
2927b327db3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherSectorVerticesRadiallyOrdered", "[", 
   RowBox[{"p_", ",", "r_", ",", "h_", ",", 
    RowBox[{"k_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "all", ",", "nh", ",", "nd", ",", "up", ",", "dg", ",", "dn", ",", 
      "pred"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Start", " ", "by", " ", "making", " ", "a", " ", "table", " ", "of", " ",
        "all", " ", "vertices"}], ",", " ", 
      RowBox[{"ordered", " ", "by", " ", "ring", " ", 
       RowBox[{"(", 
        RowBox[{"indexed", " ", "on", " ", "i"}], ")"}]}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"all", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "nh", " ", "is", " ", "the", " ", "number", " ", "of", " ", "full"}],
          "-", 
         RowBox[{
         "height", " ", "axial", " ", "bands", " ", "at", " ", "this", " ", 
          RowBox[{"index", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"nh", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "+", "1"}], ")"}], "/", "h"}], "]"}], ",", 
            RowBox[{"r", " ", "h"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "nd", " ", "is", " ", "the", " ", "height", " ", "of", " ", "the", " ",
            "partial", " ", "axial", " ", "band", " ", "above", " ", "the", " ",
            "highest", " ", "full", " ", "band", " ", 
           RowBox[{"reached", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"nd", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "+", "1"}], ")"}], ",", "h"}], "]"}], ",", 
            RowBox[{"h", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           
           RowBox[{"\"\<up\>\"", " ", "are", " ", "the", " ", "vertices", " ",
             "crossing", " ", "by", " ", "radial", " ", "folds"}], ",", " ", 
           RowBox[{
           "going", " ", "up", " ", "to", " ", "the", " ", "diagonal", " ", 
            RowBox[{"fold", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"up", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            SubscriptBox["p", 
             RowBox[{"i", ",", 
              RowBox[{"h", " ", "j"}], ",", " ", "k"}]], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "0", ",", "nh"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          
          RowBox[{"\"\<dg\>\"", " ", "is", " ", "the", " ", "diagonal", " ", 
           "vertex", " ", "if", " ", 
           RowBox[{"it", "'"}], "s", " ", "NOT", " ", "on", " ", "the", " ", 
           "ring", " ", 
           RowBox[{"fold", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"dg", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nd", "!=", "0"}], "&&", 
             RowBox[{"i", "<", 
              RowBox[{"r", " ", "h"}]}]}], ",", 
            RowBox[{"{", 
             SubscriptBox["p", 
              RowBox[{"i", ",", 
               RowBox[{
                RowBox[{"h", " ", "nh"}], "+", "nd"}], ",", "k"}]], "}"}], ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          
          RowBox[{"\"\<dn\>\"", " ", "are", " ", "the", " ", "vertices", " ", 
           "on", " ", "ring", " ", "folds", " ", "going", " ", 
           RowBox[{"down", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"dn", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "<", 
             RowBox[{"r", " ", "h"}]}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              SubscriptBox["p", 
               RowBox[{
                RowBox[{
                 RowBox[{"h", " ", "j"}], " ", "-", " ", "1"}], ",", 
                RowBox[{"i", "+", "1"}], ",", "k"}]], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"nd", "==", "0"}], ",", 
                  RowBox[{"nh", "-", "1"}], ",", "nh"}], "]"}], ",", "1", ",", 
                RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Join", "[", 
          RowBox[{"up", ",", "dg", ",", "dn"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"r", " ", "h"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "all"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.911477480042699*^9, 3.911477506459846*^9}, {
   3.911477931097645*^9, 3.911477974212715*^9}, {3.911478124309305*^9, 
   3.91147816979443*^9}, {3.911478208748355*^9, 3.911478327327816*^9}, {
   3.911478417532818*^9, 3.911478421307888*^9}, {3.911491316027583*^9, 
   3.911491440336359*^9}, {3.911491477147016*^9, 3.911491489855372*^9}, {
   3.9114916093561373`*^9, 3.911491652650366*^9}, {3.911501663377431*^9, 
   3.911501760283046*^9}, {3.91150180614072*^9, 3.9115018159277687`*^9}, {
   3.911502792364433*^9, 3.911502913124156*^9}, {3.911502968318774*^9, 
   3.911502976037159*^9}, {3.911503744572796*^9, 3.911503781262594*^9}, 
   3.911568114503365*^9, {3.911581726891743*^9, 3.911581729669211*^9}, {
   3.911581796147216*^9, 3.911581803425873*^9}, 3.911581837130499*^9, 
   3.911582304999648*^9, {3.911584080381919*^9, 3.911584154618221*^9}, {
   3.91158429774791*^9, 3.91158429900414*^9}, {3.911645249357415*^9, 
   3.91164529240313*^9}, {3.911645364125369*^9, 3.911645396943901*^9}, {
   3.911645500727689*^9, 3.911645540992851*^9}, {3.91164558008867*^9, 
   3.911645603671991*^9}, 3.911645662076186*^9, {3.91164572140274*^9, 
   3.9116457792103767`*^9}, {3.911749966932701*^9, 3.911750059766542*^9}, {
   3.911750108389771*^9, 3.911750122812109*^9}, {3.911750189342763*^9, 
   3.911750208500843*^9}, {3.911750289199399*^9, 3.911750291629919*^9}, {
   3.91175041612752*^9, 3.911750458544446*^9}, {3.911751263416696*^9, 
   3.911751285383073*^9}, {3.911751378297983*^9, 3.911751429010673*^9}, {
   3.911751521307105*^9, 3.911751526497339*^9}, {3.911751673188427*^9, 
   3.911751682619113*^9}, {3.911877656876791*^9, 3.9118776609711437`*^9}},
 CellLabel->
  "In[4447]:=",ExpressionUUID->"34f6abb3-92d9-41ba-8fbe-20ee089b59b8"],

Cell["\<\
Example. Show the first sector and the corresponding structured list.\
\>", "Text",
 CellChangeTimes->{{3.911477980366679*^9, 3.911477981086121*^9}, 
   3.9116460002365103`*^9, {3.911751537976712*^9, 3.911751583088361*^9}, {
   3.911849075264009*^9, 3.911849082715644*^9}, {3.9118498251605177`*^9, 
   3.911849825443896*^9}, {3.913541875603325*^9, 
   3.9135418770207853`*^9}},ExpressionUUID->"97b37433-2341-4bd8-b030-\
5f3acd641901"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", "fsvro"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fsvro", "=", 
     RowBox[{"FlasherSectorVerticesRadiallyOrdered", "[", 
      RowBox[{"p", ",", "r", ",", "h"}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FlasherSectorFoldLines", "[", 
          RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"FlasherVertexLabel", "[", 
             RowBox[{"\"\<p\>\"", ",", "#"}], "]"}], "&"}], "/@", 
           RowBox[{"Flatten", "[", "fsvro", "]"}]}], ")"}]}], 
        "\[IndentingNewLine]", "}"}], "/.", 
       RowBox[{"FlasherDefaultCPRules", "[", 
        RowBox[{"p", ",", "m"}], "]"}]}], "]"}], "//", "Print"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"fsvro", "//", "ColumnForm"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.91184917066782*^9, 3.911849359753267*^9}, {
   3.911849401898993*^9, 3.911849402733063*^9}, 3.9118495793093967`*^9, 
   3.911849615201459*^9, {3.911849660242204*^9, 3.91184973312186*^9}, {
   3.911849788069112*^9, 3.91184981107985*^9}},
 CellLabel->
  "In[4448]:=",ExpressionUUID->"db36c50b-ed08-45cb-a45c-b0a058c6942a"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Thick flasher support functions", "Subsection",
 CellChangeTimes->{{3.911834090981853*^9, 3.911834100418879*^9}, {
  3.912574650617967*^9, 
  3.912574650880174*^9}},ExpressionUUID->"ec71e236-9858-4bdd-acd2-\
01da85a3be83"],

Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherSectorFoldLinesStructure[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.911566104782852*^9, 3.911575906651126*^9, {3.911752990382128*^9, 
   3.911752993342021*^9}, 3.911760185586113*^9, {3.9118155111126833`*^9, 
   3.911815517198289*^9}, 
   3.912573977695005*^9},ExpressionUUID->"7a93db06-5384-4cf3-93f7-\
e73ad0f7f405"],

Cell[TextData[{
 "ThickFlasherSectorFoldLinesStructure[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "] produces a list of structural information about the folded lines in a \
single sector, used for constructing thick flashers."
}], "Text",
 CellChangeTimes->{{3.911566071727915*^9, 3.911566131826899*^9}, 
   3.9115662468746643`*^9, {3.9115668577601557`*^9, 3.911566861476284*^9}, 
   3.911575900135932*^9, 3.9117601872416487`*^9, 3.911815511138683*^9, {
   3.9118155647264433`*^9, 3.911815578146141*^9}, 
   3.912573977719082*^9},ExpressionUUID->"09fb420f-5c55-4bab-8c12-\
2cb0906e38c0"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] a symbol to use for symbolic points, which will be of the form \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "e60a9a0e-4421-45a8-b541-ff527059e332"],
 ".\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radial index.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["k",
  FontSlant->"Italic"],
 " \[LongDash] the rotational index."
}], "Text",
 CellChangeTimes->{{3.911566864479892*^9, 3.911566942465796*^9}, 
   3.911760189617978*^9, {3.913541907983127*^9, 
   3.913541907983213*^9}},ExpressionUUID->"d700c9a5-8b74-4cca-a683-\
afaffc83d0b0"],

Cell[TextData[{
 "Returns: a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["p", 
        RowBox[{"i1", ",", "j1", ",", "k1"}]], ",", 
       SubscriptBox["p", 
        RowBox[{"i2", ",", "j2", ",", "k2"}]]}], "}"}], ",", 
     StyleBox["type",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox[" ",
      FontSlant->"Italic"], 
     StyleBox["mvb",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox[" ",
      FontSlant->"Italic"], 
     StyleBox["btc",
      FontSlant->"Italic"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "b6aae3fe-0b79-4dac-935e-2cd62b5d2002"],
 " describing the lines, where \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["p", 
      RowBox[{"i1", ",", "j1", ",", "k1"}]], ",", 
     SubscriptBox["p", 
      RowBox[{"i2", ",", "j2", ",", "k2"}]]}], "}"}], TraditionalForm]],
  ExpressionUUID->"7a1277d2-0a54-49ca-8719-f47f9da627c7"],
 " are the vertices of the fold line segment; The point pair for each line \
segment is ordered so that\n\t\tmajor fold and diagonal fold lines point away \
from the center of the pattern;\n\t\tminor fold lines point away from the \
center in the folded form.\n\t",
 StyleBox["type",
  FontSlant->"Italic"],
 " is a text string, one of \
\[OpenCurlyDoubleQuote]mj\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]mn\
\[CloseCurlyDoubleQuote], or \
\[OpenCurlyDoubleQuote]dg\[CloseCurlyDoubleQuote], for major, minor, or \
diagonal folds. \n\t",
 StyleBox["mvb",
  FontSlant->"Italic"],
 " is a symbol, one of V, M, or B, for Valley, Mountain, or Boundary folds. \
(Note: these are previously defined symbols, not strings.)\n\t",
 StyleBox["btc",
  FontSlant->"Italic"],
 " is a text string, one of \
\[OpenCurlyDoubleQuote]bt\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]tp\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]cn\[CloseCurlyDoubleQuote] \
for bottom, top, or connector folds.\t"
}], "Text",
 CellChangeTimes->{{3.911566137058425*^9, 3.911566224630653*^9}, {
  3.911646052061429*^9, 3.911646109277882*^9}, {3.911662905892796*^9, 
  3.911662914194611*^9}, {3.911759455363248*^9, 3.9117594602665377`*^9}, {
  3.911760204122649*^9, 3.9117602099393473`*^9}, {3.911769634126633*^9, 
  3.911769751596203*^9}, {3.911769873684846*^9, 3.9117699277070503`*^9}, {
  3.9117699947813168`*^9, 3.9117700017557077`*^9}, {3.913541922631337*^9, 
  3.913541964165711*^9}},ExpressionUUID->"58617275-2679-4cf1-a18a-\
834bf4f20997"],

Cell[TextData[{
 "Note that no rotational subscript wrap-around is applied, so for ",
 StyleBox["k",
  FontSlant->"Italic"],
 " = 0, there will be points with subscript ",
 StyleBox["k",
  FontSlant->"Italic"],
 " = \[Dash]1."
}], "Text",
 CellChangeTimes->{{3.911566953243701*^9, 3.911566983022746*^9}, {
  3.911568037018324*^9, 3.91156806376134*^9}, {3.913541978700815*^9, 
  3.9135419822546797`*^9}},ExpressionUUID->"6fdd3e4b-3a2b-490f-afea-\
7b40104d7265"],

Cell["\<\
See FlasherSectorFoldedFoldLines for similar functionality, but with \
different vertex ordering, graphical styles applied, and no symbolic/string \
type annotations.\
\>", "Text",
 CellChangeTimes->{
  3.911567919673236*^9, {3.9115680068115664`*^9, 3.9115680127066*^9}, {
   3.911756015547221*^9, 3.911756030994275*^9}, {3.911760225113714*^9, 
   3.9117602478980517`*^9}, {3.9135420159162803`*^9, 
   3.9135420167944593`*^9}},ExpressionUUID->"fe90551c-b885-4355-94cf-\
0c387e06211c"],

Cell["\<\
We will use this function as a utility to compute the coordination/adjacency \
for vertices.\
\>", "Text",
 CellChangeTimes->{{3.911582226501335*^9, 3.911582249924354*^9}, {
  3.911770716392239*^9, 
  3.911770719991663*^9}},ExpressionUUID->"16f727b3-b801-4ca6-9edf-\
61a08af86134"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
   RowBox[{"p_", ",", "r_", ",", "h_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "i", ",", "j", ",", "S"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"r", " ", "h"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "total", " ", "number", " ", "of", " ", "radial", " ", "increments"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"major", " ", "region"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"j", "=", 
                RowBox[{"h", " ", "ig"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"S", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   SubscriptBox["p", 
                    RowBox[{
                    RowBox[{"i", "-", "1"}], ",", "j", ",", "k"}]], ",", 
                   SubscriptBox["p", 
                    RowBox[{"i", ",", "j", ",", "k"}]]}], "}"}], 
                 ",", "\"\<mj\>\"", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"EvenQ", "[", "ig", "]"}], ",", "V", ",", "M"}], 
                  "]"}], ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"EvenQ", "[", "ig", "]"}], ",", "\"\<tp\>\"", 
                   ",", "\"\<bt\>\""}], "]"}]}], "]"}]}], ",", 
              RowBox[{"(*", " ", 
               RowBox[{"bottom", " ", "of", " ", "quadrant"}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"S", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  SubscriptBox["p", 
                   RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["p", 
                   RowBox[{"i", ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "h"}], ",", 
                    RowBox[{"i", "+", "1"}]}], "]"}], ",", "k"}]]}], "}"}], 
                ",", "\"\<mn\>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"EvenQ", "[", "ig", "]"}], ",", "V", ",", "M"}], 
                 "]"}], ",", "\"\<cn\>\""}], "]"}]}], 
             RowBox[{"(*", " ", 
              RowBox[{"left", " ", "of", " ", "quadrant"}], " ", "*)"}], 
             "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ig", ",", "0", ",", 
              RowBox[{"r", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"h", " ", "ig"}], ",", "n"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"S", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              SubscriptBox["p", 
               RowBox[{
                RowBox[{"n", "-", "1"}], ",", "n", ",", "k"}]], ",", 
              SubscriptBox["p", 
               RowBox[{"n", ",", "n", ",", "k"}]]}], "}"}], ",", "\"\<mj\>\"",
             ",", "B", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"EvenQ", "[", "r", "]"}], ",", "\"\<tp\>\"", 
              ",", "\"\<bt\>\""}], "]"}]}], "]"}], ",", 
          RowBox[{"(*", " ", 
           RowBox[{
           "extra", " ", "segment", " ", "across", " ", "top", " ", "at", " ",
             "corner"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", "diagonal", " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{
                RowBox[{"h", " ", "ig"}], "+", "j"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"S", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  SubscriptBox["p", 
                   RowBox[{
                    RowBox[{"i", "-", "1"}], ",", "i", ",", "k"}]], ",", 
                  SubscriptBox["p", 
                   RowBox[{"i", ",", 
                    RowBox[{"i", "+", "1"}], ",", "k"}]]}], "}"}], 
                ",", "\"\<dg\>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"OddQ", "[", "ig", "]"}], ",", "V", ",", "M"}], 
                 "]"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "h"}], "]"}], "==", "1"}], "||", 
                   RowBox[{"h", "==", "1"}]}], ",", "\"\<cn\>\"", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"OddQ", "[", "ig", "]"}], ",", "\"\<tp\>\"", 
                    ",", "\"\<bt\>\""}], "]"}]}], "]"}]}], "]"}]}], 
             "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ig", ",", "0", ",", 
              RowBox[{"r", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "0", ",", 
              RowBox[{"h", "-", "1"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"minor", " ", "region"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"i", "=", 
                RowBox[{
                 RowBox[{"h", " ", "ig"}], "-", "1"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"ig", "\[NotEqual]", "0"}], ",", 
                 RowBox[{"S", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    SubscriptBox["p", 
                    RowBox[{"i", ",", 
                    RowBox[{"j", "-", "1"}], ",", "k"}]], ",", 
                    SubscriptBox["p", 
                    RowBox[{"i", ",", "j", ",", "k"}]]}], "}"}], 
                   ",", "\"\<mj\>\"", ",", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"EvenQ", "[", "ig", "]"}], ",", "V", ",", "M"}], 
                    "]"}], ",", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"EvenQ", "[", "ig", "]"}], ",", "\"\<tp\>\"", 
                    ",", "\"\<bt\>\""}], "]"}]}], "]"}], ",", 
                 RowBox[{"{", "}"}]}], "]"}]}], ",", 
              RowBox[{"(*", " ", 
               RowBox[{"bottom", " ", "of", " ", "quadrant"}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"S", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  SubscriptBox["p", 
                   RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"i", "+", "h"}], ",", 
                    RowBox[{"j", "-", "1"}]}], "]"}], ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["p", 
                   RowBox[{"i", ",", "j", ",", "k"}]]}], "}"}], 
                ",", "\"\<mn\>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"j", "\[Equal]", "n"}], ",", "B", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"OddQ", "[", "ig", "]"}], ",", "V", ",", "M"}], 
                   "]"}]}], "]"}], ",", "\"\<cn\>\""}], "]"}]}], 
             RowBox[{"(*", " ", 
              RowBox[{"left", " ", "of", " ", "quadrant"}], " ", "*)"}], 
             "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ig", ",", "0", ",", 
              RowBox[{"r", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{
               RowBox[{"h", " ", "ig"}], "+", "1"}], ",", "n"}], "}"}]}], 
           "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"FlasherWrapRules", "[", "p", "]"}]}], "/.", 
      RowBox[{"S", "->", "List"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.911769851320475*^9, 3.911769851358946*^9}, {
   3.911770268075429*^9, 3.911770301215859*^9}, {3.911770354341488*^9, 
   3.911770387438645*^9}, {3.911770417745935*^9, 3.911770431383187*^9}, {
   3.911814205905808*^9, 3.911814219197776*^9}, {3.9118142517156887`*^9, 
   3.911814284811148*^9}, {3.911814322521488*^9, 3.911814364932249*^9}, {
   3.911814427099675*^9, 3.911814506638797*^9}, {3.911814598752763*^9, 
   3.911814604016526*^9}, {3.911814643326016*^9, 3.911814687268093*^9}, {
   3.911814781767346*^9, 3.9118148444267807`*^9}, 3.911814884147141*^9, {
   3.91181491674516*^9, 3.911814938591559*^9}, {3.911814980531286*^9, 
   3.911815048031935*^9}, 3.911815511150414*^9, 3.912573977748095*^9, {
   3.9134787172217817`*^9, 3.913478775447996*^9}, {3.9134791625526953`*^9, 
   3.913479254085078*^9}, {3.913542035135641*^9, 3.9135420713125157`*^9}, {
   3.923939465836668*^9, 3.923939467252543*^9}},
 CellLabel->
  "In[4449]:=",ExpressionUUID->"e1d867f2-c8fd-4063-9d5e-daede3db3d0f"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.555752609903793*^9, 3.555752611790031*^9}, 
   3.71994385083105*^9},ExpressionUUID->"168f982e-b721-4e53-9f96-\
82cc23bb1393"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", "p", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
    RowBox[{"p", ",", "2", ",", "2", ",", "0"}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.91156645522916*^9, 3.911566456342745*^9}, 
   3.911575900149059*^9, {3.911753000941042*^9, 3.91175301455792*^9}, 
   3.911815511153879*^9, 3.912573977752348*^9},
 CellLabel->
  "In[4450]:=",ExpressionUUID->"76d2deb2-ea10-47f6-bcfd-f74b2945b262"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherMMDStyle[",
 StyleBox["str",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.923938763483148*^9, 
  3.923938780811198*^9}},ExpressionUUID->"a1099b71-2bf3-4186-b888-\
c0252626bc97"],

Cell[TextData[{
 "FlasherMMDStyle[",
 StyleBox["str",
  FontSlant->"Italic"],
 "] returns style symbols for Major/Minor/Diagonal style based on the text \
str, which should be one of \
\[OpenCurlyDoubleQuote]mj\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]mn\
\[CloseCurlyDoubleQuote], or \
\[OpenCurlyDoubleQuote]dg\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.923938783091412*^9, 
  3.923938831019549*^9}},ExpressionUUID->"40c460f4-907c-47b5-807d-\
6287de662ba9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherMMDStyle", "[", "str_", "]"}], ":=", 
  RowBox[{"Switch", "[", 
   RowBox[{"str", ",", "\"\<mj\>\"", ",", 
    RowBox[{"Lighter", "[", 
     RowBox[{"Red", ",", "0.75"}], "]"}], ",", "\"\<mn\>\"", ",", 
    RowBox[{"Lighter", "[", 
     RowBox[{"Blue", ",", "0.75"}], "]"}], ",", "\"\<dg\>\"", ",", "Green", ",",
     "_", ",", "Black"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.923938834285399*^9, 3.923938880499785*^9}},
 CellLabel->
  "In[4451]:=",ExpressionUUID->"312060d5-91cd-417e-b072-b2a90774f053"],

Cell["\<\
Example, a sector, colored by MMD (Major/Minor/Diagonal) style and using \
arrows to show the radial and axial ordering.\
\>", "Text",
 CellChangeTimes->{{3.911567714903842*^9, 3.911567722824141*^9}, {
  3.911646141830964*^9, 3.911646148094769*^9}, {3.911815370296523*^9, 
  3.911815377068076*^9}, {3.913542112647502*^9, 
  3.9135421182936373`*^9}},ExpressionUUID->"83c850f7-9f1d-48f3-89c0-\
a3ea7c124009"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"k", "=", "0"}], ",", "lines", ",", "verts"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lines", "=", 
     RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
      RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"verts", "=", 
     RowBox[{"Union", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{"lines", ",", 
        SubscriptBox["p", 
         RowBox[{"_", ",", "_", ",", "_"}]], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Arrow", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}], ",", 
            RowBox[{"FlasherMMDStyle", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}]}], "]"}], "&"}], "/@", "lines"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"FlasherVertexLabel", "[", 
           RowBox[{"\"\<p\>\"", ",", "#"}], "]"}], "&"}], "/@", "verts"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}], "/.", 
      RowBox[{"FlasherDefaultCPRules", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.555752770244678*^9, 3.555752822227908*^9}, {
   3.555752901500042*^9, 3.555752920876604*^9}, 3.555753748262662*^9, 
   3.5557556178209057`*^9, {3.555757059296912*^9, 3.5557570637320843`*^9}, {
   3.555758221266178*^9, 3.555758242224509*^9}, {3.555759011665655*^9, 
   3.555759029124157*^9}, {3.555760025922271*^9, 3.555760042730763*^9}, 
   3.555779003023103*^9, {3.555788731692772*^9, 3.555788732242729*^9}, {
   3.5557990414048243`*^9, 3.5557990455339212`*^9}, {3.555854306385243*^9, 
   3.5558543065196*^9}, {3.555854344619528*^9, 3.555854344753316*^9}, 
   3.555956432996884*^9, 3.719848622694833*^9, 3.719848673673449*^9, 
   3.719849091671462*^9, 3.719849143762691*^9, 3.719850658307976*^9, 
   3.719854079746311*^9, {3.719879476658288*^9, 3.7198794774756823`*^9}, 
   3.719936124645475*^9, 3.719944472310303*^9, {3.7199461237361937`*^9, 
   3.719946127032958*^9}, {3.825671856916189*^9, 3.825671859883203*^9}, {
   3.825674765425116*^9, 3.825674765926785*^9}, {3.911562933118458*^9, 
   3.911562935715321*^9}, {3.91156311157586*^9, 3.911563148744944*^9}, {
   3.911566439944127*^9, 3.911566441059541*^9}, {3.911566614167391*^9, 
   3.911566615267544*^9}, {3.91156765129643*^9, 3.911567727314378*^9}, {
   3.911567785758874*^9, 3.9115677872433643`*^9}, 3.911575900152144*^9, {
   3.91164621198477*^9, 3.911646284353704*^9}, {3.91175304063137*^9, 
   3.911753041207167*^9}, 3.911815511157374*^9, 3.912573977761643*^9, {
   3.923938890225338*^9, 3.923938896535589*^9}},
 CellLabel->
  "In[4452]:=",ExpressionUUID->"1d3e51f0-a830-4d19-a5ef-93d143f50f06"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherMVBStyle[",
 StyleBox["type",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.9239389205806627`*^9, 
  3.923938937637032*^9}},ExpressionUUID->"4730cc8f-c36c-4246-b9a2-\
fa8909952e6e"],

Cell[TextData[{
 "FlasherMVBStyle[",
 StyleBox["type",
  FontSlant->"Italic"],
 "] returns styles for Mountain, Valley, or Border lines, based on ",
 StyleBox["type",
  FontSlant->"Italic"],
 ", which should be one of M, V, or B (symbols, not strings). We use the \
default OrigamiStyle[] defined within Tessellatica for this one."
}], "Text",
 CellChangeTimes->{{3.923938950247278*^9, 3.923938986821554*^9}, {
  3.923939029205172*^9, 3.9239390500544233`*^9}, {3.9239390987342443`*^9, 
  3.92393914543918*^9}},ExpressionUUID->"caf282c9-f5a3-42a1-a235-\
eac3dccec767"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherMVBStyle", "[", "type_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Switch", "[", 
    RowBox[{
    "type", ",", "V", ",", "ValleyLine", ",", "M", ",", "MountainLine", ",", 
     "B", ",", "BorderLine", ",", "_", ",", "Gray"}], "]"}], "/.", 
   RowBox[{"OrigamiStyle", "[", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.923938991622952*^9, 3.923939021438055*^9}, {
  3.923939053382172*^9, 3.923939060566204*^9}},
