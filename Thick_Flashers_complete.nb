Cell[CellGroupData[{

Cell["Quadrilateral split twist tiles", "Subsection",
 CellChangeTimes->{{3.630010167470752*^9, 3.630010176542577*^9}, 
   3.630111556114538*^9, {3.630112945339415*^9, 
   3.630112962624064*^9}},ExpressionUUID->"f27b2a98-e1b0-4cd4-a275-\
eed92dbd6e26"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.630010181803502*^9, 
  3.630010186197962*^9}},ExpressionUUID->"f5ebc361-1fc4-4db4-a45b-\
22d10ad40ca1"],

Cell["\<\
We can create a \[OpenCurlyDoubleQuote]split-twist\[CloseCurlyDoubleQuote] \
tile from any quadrilateral, either CenteredTwist or OffsetTwist, as long as \
the original central polygon is properly ordered (not self-crossing or \
retrograde). The structure is called \[OpenCurlyDoubleQuote]split-twist\
\[CloseCurlyDoubleQuote] because the single quadrilateral twist is \
effectively split into two triangular twists with two different twist angles.\
\
\>", "Text",
 CellChangeTimes->{{3.630010187968629*^9, 3.630010218585251*^9}, {
  3.630010425044631*^9, 
  3.630010492570344*^9}},ExpressionUUID->"2290df14-6e68-4999-a123-\
3481d33e44b6"],

Cell["\<\
Note that it is possible that the two twist angles can have opposite \
rotational direction: one of them <90\[Degree], the other >90\[Degree].\
\>", "Text",
 CellChangeTimes->{{3.630244797967987*^9, 
  3.630244846583942*^9}},ExpressionUUID->"fb5e8edc-af51-4df5-afb2-\
d81d6eb7b66c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "{QuadrilateralSplitTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.630017996479157*^9, 3.630018033540922*^9}, {
  3.630072458697626*^9, 3.6300724628265944`*^9}, {3.630072837658767*^9, 
  3.6300728431697397`*^9}},ExpressionUUID->"1f82d7bb-42c2-4e4c-b20b-\
74f34e42bed6"],

Cell[TextData[{
 "{QuadrilateralSplitTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} is a tiletype that describes a split twist in a quadrilateral specified \
by its vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where \n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \n\t\
\[Tau] is the pleat angle, defined as the rotation angle of the pleat \
measured with respect to the edge, \n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the offset from the center of the edge, \n\t",
 StyleBox["ccw",
  FontSlant->"Italic"],
 " is a flag indicating whether the pleat crease assignment should assume a \
CCW twist, \n\t",
 StyleBox["ip",
  FontSlant->"Italic"],
 " is the index of the degree-6 vertex,\n\t",
 StyleBox["ctype",
  FontSlant->"Italic"],
 " is the fold type of the connecting fold (the crease between the split \
vertex pair),\n\t",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.630018057104121*^9, 3.630018098648444*^9}, {
  3.630018154303489*^9, 3.630018213928781*^9}, {3.630072470871564*^9, 
  3.630072485313397*^9}, {3.630072776004023*^9, 3.630072795365305*^9}, {
  3.6300728504501743`*^9, 3.630072885835011*^9}, {3.6302448567030354`*^9, 
  3.630244876502898*^9}, {3.630245098728339*^9, 
  3.630245100959203*^9}},ExpressionUUID->"206029df-c95b-452a-8b81-\
3d6214cf2e12"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuadrilateralSplitTwistTile", "::", "usage"}], 
   "=", "\"\<QuadrilateralSplitTwistTile is a tile type that produces a split \
twist in a quadrilateral.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629825639748377*^9, 3.629825695990987*^9}, 
   3.62982619453579*^9, {3.629827526832037*^9, 3.629827546351098*^9}, {
   3.630018227820609*^9, 3.630018234216425*^9}, {3.630018298190243*^9, 
