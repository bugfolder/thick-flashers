Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629826786712953*^9, 3.629826826093027*^9}, 
   3.629846604563611*^9, 3.630024083209087*^9, 
   3.707838517100274*^9},ExpressionUUID->"1f3203db-fab8-4618-8fbb-\
48d48a15938d"],

Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraphAssigned+TTwistGraph that describes the creases for a \
twist in a specified polygon where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \[Tau] \
is the pleat angle, defined as the rotation angle of the pleat measured with \
respect to the edge, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
