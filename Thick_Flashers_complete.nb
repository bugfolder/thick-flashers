  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", "ThreeFoldSquareGraph"}], ";", 
