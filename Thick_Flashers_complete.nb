2ce848aec325"],

Cell["\<\
As with all convenience classes, TPlaneGraphAssigned has only Make \
constructors.\
\>", "Text",
 CellChangeTimes->{{3.5928582171943603`*^9, 3.59285823638466*^9}, 
   3.594739039845152*^9},ExpressionUUID->"03ff0aee-a63f-4a80-ac5a-\
209721e22b37"],

Cell[TextData[{
 "MakeTPlaneGraphAssigned",
 "[",
 StyleBox["verts, edges, faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] creates a TPlaneGraphAssigned from its constitutent parts."
}], "Text",
 CellChangeTimes->{{3.592472148770667*^9, 3.592472177312665*^9}, 
   3.592472208440435*^9, {3.592472277049415*^9, 3.592472287457086*^9}, {
   3.5924791937386827`*^9, 3.5924792042343407`*^9}, {3.592828726329709*^9, 
   3.5928287265269136`*^9}, {3.592828956562684*^9, 3.592828956667198*^9}, {
   3.592858241577066*^9, 3.592858265559485*^9}, {3.594739039904207*^9, 
   3.594739069433827*^9}},ExpressionUUID->"dec8298d-b02b-4fd4-a567-\
0705d0880580"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTPlaneGraphAssigned", "[", 
   RowBox[{"verts_List", ",", " ", "edges_List", ",", " ", 
    RowBox[{"faces_List", ":", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"types_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"MakeTPlaneGraph", "[", 
     RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], "//", 
    RowBox[{"AddTAssigned", "[", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "types", "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"U", ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "edges", "]"}], "}"}]}], "]"}], ",", 
       "types"}], "]"}], "]"}]}], "//", 
   RowBox[{"AddClass", "[", "TPlaneGraphAssigned", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.592472186388488*^9, 3.592472190785997*^9}, {
   3.5924722324633303`*^9, 3.592472263239246*^9}, {3.592472300658466*^9, 
   3.592472364017255*^9}, {3.592479209008722*^9, 3.592479215350967*^9}, 
   3.592668608834049*^9, {3.592828726627442*^9, 3.592828726760535*^9}, {
   3.592828892218364*^9, 3.592828892286333*^9}, {3.592828956765915*^9, 
   3.5928289568323793`*^9}, {3.592858274466782*^9, 3.592858418679702*^9}, {
   3.592858534721541*^9, 3.5928585377768*^9}, {3.594739039936549*^9, 
   3.594739069464253*^9}},
 CellLabel->
  "In[1904]:=",ExpressionUUID->"a8a2ace8-63dc-42b4-be11-f840649ab502"],

Cell["Example", "Text",
 CellChangeTimes->{{3.592858424158951*^9, 
  3.592858424861084*^9}},ExpressionUUID->"0f0529c5-8565-409c-bb17-\
400a8299ff90"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "faces", ",", "types", ",", "tobj"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTPlaneGraphAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", "faces", ",", "types"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ColumnForm", "[", 
      RowBox[{"GetAllRules", "[", "tobj", "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592858425901235*^9, 3.592858524345935*^9}, 
   3.594739069703389*^9, {3.616192182585142*^9, 3.616192185895743*^9}, 
   3.628786728714126*^9, 3.628786796216029*^9},
 CellLabel->
  "In[1905]:=",ExpressionUUID->"644d84a1-ed58-4f03-b13a-25bf13285383"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Converting from crease pattern to TPlaneGraphAssigned", "Subsection",
 CellChangeTimes->{{3.484867556427211*^9, 3.484867560779252*^9}, {
   3.485095394950358*^9, 3.485095398645647*^9}, {3.485097046542171*^9, 
   3.485097047821866*^9}, {3.533681044957152*^9, 3.533681061652234*^9}, 
   3.533681318459326*^9, {3.592208157853482*^9, 3.592208164507035*^9}, {
   3.592436234061855*^9, 3.592436238758768*^9}, {3.592468217229436*^9, 
   3.592468218323175*^9}, 3.592472034480753*^9, 3.592828728890896*^9, 
   3.5928289575384398`*^9, {3.592860403029801*^9, 3.59286040342031*^9}, 
   3.594739040189913*^9},ExpressionUUID->"072d678a-59a6-4e31-8940-\
ccb4aa42971d"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.533681134535115*^9, 
  3.533681134975054*^9}},ExpressionUUID->"72ae84fa-0cec-4be1-9147-\
7db71eb6d355"],

Cell["\<\
These functions take symbolically styled crease patterns and convert them to \
crease-assigned plane graphs. The utility in doing this is that if we have \
the crease-assigned plane graph of a pattern, we can compute its folded form \
and (a good approximation of) its visible folded form, thus saving one from \
the trouble of having to compute both in the design phase.\
\>", "Text",
 CellChangeTimes->{{3.533681074771038*^9, 
  3.533681261830413*^9}},ExpressionUUID->"67f8e118-4c03-4510-8e3c-\
488f708c7d33"],

Cell["\<\
You can also use this to import a drawn crease pattern to subsequently \
compute its visible folded form (assuming the crease pattern is drawn \
accurately and satisfies Kawasaki-Justin).\
\>", "Text",
 CellChangeTimes->{{3.591809364185806*^9, 3.591809409237342*^9}, {
  3.592434567556569*^9, 3.592434572576735*^9}, {3.626362357538644*^9, 
  3.6263623592480183`*^9}},ExpressionUUID->"987e56f9-31ca-419f-aacc-\
7e1d3aecd10c"],

Cell["\<\
Note that if you have fold angle indicated by graphical style, you should use \
CreasePatternToGraph3DAssigned, see below.\
\>", "Text",
 CellChangeTimes->{{3.626363805389638*^9, 3.626363834312543*^9}, 
   3.649881943903577*^9, 
   3.649882096285089*^9},ExpressionUUID->"b155e48b-7c34-4e1a-bbd6-\
d5044f2512b3"],

Cell["\<\
If you have both 2D and 3D vertex information, you can add the 3D information \
using OrderMappingByVertices, see below.\
\>", "Text",
 CellChangeTimes->{{3.626363836568654*^9, 3.626363853295424*^9}, {
  3.626363886174294*^9, 
  3.626363892324973*^9}},ExpressionUUID->"6c2968a7-13a7-4376-87b7-\
b4ce7d28280d"]
}, Closed]],

Cell[CellGroupData[{

Cell["CreasePatternStyleToEdgeTypeRules", "Subsubsection",
 CellChangeTimes->{{3.48486568918381*^9, 
  3.484865696839162*^9}},ExpressionUUID->"d2b26265-43a4-4b19-b5e3-\
6600191b5b53"],

Cell["\<\
CreasePatternStyleToEdgeTypeRules provides the mapping from {MountainLine, \
ValleyLine, UnfoldedLine, BorderLine} back to edge type codes {M,V,U,B}.\
\>", "Text",
 CellChangeTimes->{{3.484865699286899*^9, 3.4848657457401247`*^9}, 
   3.628948773547373*^9},ExpressionUUID->"362affe3-b47d-4ed5-a987-\
64a0d1d6acd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreasePatternStyleToEdgeTypeRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MountainLine", "\[Rule]", "M"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ValleyLine", "\[Rule]", "V"}], ",", "\[IndentingNewLine]", 
     RowBox[{"UnfoldedLine", "\[Rule]", "U"}], ",", "\[IndentingNewLine]", 
     RowBox[{"BorderLine", "\[Rule]", "B"}]}], "\[IndentingNewLine]", "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.484865751494404*^9, 3.484865772552989*^9}, 
   3.628948773642124*^9},
 CellLabel->
  "In[1906]:=",ExpressionUUID->"2bd28915-891b-406f-9d71-ceb78795aaf3"]
}, Closed]],

