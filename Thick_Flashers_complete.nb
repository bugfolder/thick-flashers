   3.806428778095806*^9, 3.80642885010509*^9}, {3.806428954052241*^9, 
   3.806428983049179*^9}, 3.806429026772008*^9, {3.806429087675729*^9, 
   3.8064291012335587`*^9}, {3.8064291328857303`*^9, 3.806429200362546*^9}, 
   3.806429236980896*^9, 3.806429300300252*^9, {3.806429443317766*^9, 
