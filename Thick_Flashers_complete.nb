   3.592208038537903*^9, {3.592430103992105*^9, 3.592430109429919*^9}, 
   3.59243362347784*^9, 3.592472034296308*^9, 3.592828728080725*^9, 
   3.592828893424123*^9, 3.592828957204284*^9, {3.592865992029368*^9, 
