Cell[TextData[{
 "Both of these can be considered to be special cases of a general case in \
which the flange varies continuously from thin-CW to thin-CCW, with the \
thick-flange case the halfway point between them. We characterize the range \
of variation by a parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"d28c9304-06c3-4c0a-be22-eadbc741341c"],
 "."
}], "Text",
 CellChangeTimes->{{3.686681202244585*^9, 3.686681212412344*^9}, {
  3.6866812778641667`*^9, 
  3.6866813838711853`*^9}},ExpressionUUID->"2f5a2771-668a-4574-b237-\
2c97b160025b"],

