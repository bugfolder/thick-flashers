Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTwistTube", "[", 
       RowBox[{"4", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{".5", ",", ".5", ",", 
            RowBox[{"+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".2", ",", ".8", ",", 
            RowBox[{"+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".8", ",", ".2", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", ".5", ",", 
            RowBox[{"+", "1"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
           RowBox[{"FoldAngleGraphics", "[", "tobj", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}]}], 
        "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
