Cell[CellGroupData[{

Cell[TextData[{
 "SingleGoreData",
 "[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.650199215476871*^9, 3.650199225331366*^9}, 
   3.650199420356354*^9, {3.6502008575114946`*^9, 3.650200886591223*^9}, {
   3.650201003034644*^9, 3.650201006058307*^9}, 
   3.650201429110606*^9},ExpressionUUID->"9b6b1a61-a4b1-46ac-91e6-\
a5d7cb2bec26"],

Cell[TextData[{
 "SingleGoreData[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " of {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z",
  FontSlant->"Italic"],
 "} pairs defining a cross section and returns a list {",
 StyleBox["t3d, r3d, c3d, u2d",
  FontSlant->"Italic"],
 "} of Graphics3D or Graphics elements that describe a single gore of an ",
 StyleBox["m",
  FontSlant->"Italic"],
 "-fold rotational solid, where:\n\t",
 StyleBox["t3d",
  FontSlant->"Italic"],
 " is the gore curved in 3D as a Graphics3D Polygon\n\t",
 StyleBox["r3d",
  FontSlant->"Italic"],
 " is the gore flattened in the x-y plane, as a Graphics3D Polygon\n\t",
 StyleBox["c3d",
  FontSlant->"Italic"],
 " is the gore flattened vertically at the radial distance of the maximum \
x-value in ",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", as a Graphics3D Polygon\n\t",
 StyleBox["u2d",
  FontSlant->"Italic"],
 " is the gore flattened into 2D, as a Graphics2D Polygon"
}], "Text",
 CellChangeTimes->{{3.650199229586687*^9, 3.6501992698015018`*^9}, {
   3.650199317541161*^9, 3.650199328396922*^9}, {3.650199368715653*^9, 
   3.650199670055766*^9}, {3.650200023242189*^9, 3.650200066510179*^9}, 
   3.650200109989107*^9, {3.6502007474924192`*^9, 3.650200749387212*^9}, 
   3.650200886644436*^9, 3.650201429180848*^9, {3.650201476548527*^9, 
   3.6502014775647507`*^9}},ExpressionUUID->"9abcc9dc-4cf8-4dc1-90c4-\
d7cd45978b5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SingleGoreData", "[", 
   RowBox[{"pts_List", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Phi]", ",", "x", ",", "z", ",", "r", ",", "w", ",", "nr", ",", "a", ",",
       "b", ",", "c", ",", "t3d", ",", "r3d", ",", "c3d", ",", "u2d"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "z"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Accumulate", "[", 
         RowBox[{"Mag", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"pts", ",", "1"}], "]"}], "-", 
            RowBox[{"Drop", "[", 
             RowBox[{"pts", ",", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}]}], "]"}], ",", "0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nr", "=", 
      RowBox[{"Length", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", 
      RowBox[{
       RowBox[{"Tan", "[", "\[Phi]", "]"}], "x"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "folded", " ", "form", " ", "points", " ", "in", " ", "3", "D"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", "0", ",", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "}"}], "&"}], "/@", "pts"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"a", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"U3D", "[", 
            RowBox[{"\[Pi]", "/", "2"}], "]"}], "#"}], "&"}], "/@", "w"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t3d", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"b", "\[LeftDoubleBracket]", 
            RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "}"}], 
            RowBox[{"b", "\[LeftDoubleBracket]", 
             RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "}"}], 
            RowBox[{
            "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], 
          "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"nr", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "crease", " ", "pattern", " ", "points", " ", "in", " ", "3", "D"}], ",",
        " ", "radial"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", "0", ",", "0"}], "}"}], "&"}], "/@", "r"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"a", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"U3D", "[", 
            RowBox[{"\[Pi]", "/", "2"}], "]"}], "#"}], "&"}], "/@", "w"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r3d", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"b", "\[LeftDoubleBracket]", 
            RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "}"}], 
            RowBox[{"b", "\[LeftDoubleBracket]", 
             RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "}"}], 
            RowBox[{
            "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], 
          "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"nr", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "crease", " ", "pattern", " ", "points", " ", "in", " ", "3", "D"}], ",",
        " ", "cylindrical"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"First", "/@", "pts"}], "]"}], ",", "0", ",", 
          RowBox[{"#", "+", "1", "-", 
           RowBox[{
            RowBox[{"r", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "/", "2"}]}]}], 
         "}"}], "&"}], "/@", "r"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"a", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"U3D", "[", 
            RowBox[{"\[Pi]", "/", "2"}], "]"}], "#"}], "&"}], "/@", "w"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c3d", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"b", "\[LeftDoubleBracket]", 
            RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "}"}], 
            RowBox[{"b", "\[LeftDoubleBracket]", 
             RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "}"}], 
            RowBox[{
            "b", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], 
          "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"nr", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"flat", " ", "gore", " ", "in", " ", "2", "D"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"3", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], "&"}], "/@",
        "b"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{
         "c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "&"}],
        "/@", "c"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u2d", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Line", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"c", ",", 
           RowBox[{"Reverse", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"-", "1"}]}], "}"}], "#"}], "&"}], "/@", "c"}], 
            "]"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nr"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t3d", ",", "r3d", ",", "c3d", ",", "u2d"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.650134387686751*^9, 3.650134659521892*^9}, {
   3.650134731142123*^9, 3.650134941387586*^9}, {3.65013498717702*^9, 
   3.650135194953576*^9}, 3.650135343362024*^9, {3.650199684266237*^9, 
   3.650200011002825*^9}, {3.650200078661123*^9, 3.650200093023745*^9}, {
   3.6502003144902573`*^9, 3.650200399105359*^9}, {3.65020045375541*^9, 
   3.650200491591101*^9}, {3.6502005258959312`*^9, 3.650200540485475*^9}, {
   3.650200630193125*^9, 3.650200645750233*^9}, {3.65020069040478*^9, 
   3.650200803309778*^9}, 3.650200886664055*^9, {3.6502010097046413`*^9, 
   3.65020101004578*^9}, {3.650201240552557*^9, 3.65020125615839*^9}, 
   3.6502014292042923`*^9},
 CellLabel->
  "In[3445]:=",ExpressionUUID->"92fc2e94-be6b-4df0-bb81-35970dab00a0"],

Cell["Example", "Text",
 CellChangeTimes->{{3.6502001674887652`*^9, 
  3.6502001682158747`*^9}},ExpressionUUID->"18f54756-d3e4-4198-84d6-\
c4fea526f313"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "pts", ",", "m", ",", "t3d", ",", "r3d", ",", "c3d", ",", 
      "u2d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "8"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", 
           RowBox[{"1", "-", 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]", ",", 
           RowBox[{"\[Pi]", "/", "n"}]}], "}"}]}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", "8"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t3d", ",", "r3d", ",", "c3d", ",", "u2d"}], "}"}], "=", 
      RowBox[{"SingleGoreData", "[", 
       RowBox[{"pts", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{"t3d", ",", 
            RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"r3d", ",", 
            RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{"c3d", ",", 
            RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"u2d", ",", 
            RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], "}"}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.650200169674933*^9, 3.650200287129624*^9}, 
   3.650200886691622*^9, {3.650201260834592*^9, 3.65020128047703*^9}, {
