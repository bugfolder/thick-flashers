     "p1", ",", "p2", ",", "q1", ",", "q2", ",", "r", ",", "d", ",", "tpair", 
      ",", "tp", ",", "tq", ",", "rp", ",", "rq"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}], "=", 
