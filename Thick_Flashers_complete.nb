Cell[TextData[{
 "MakeDihedralsFromSectorsAndMajorDihedral",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", 
       SubscriptBox["\[Alpha]", "2"], ",", 
       SubscriptBox["\[Alpha]", "3"], ",", 
       SubscriptBox["\[Alpha]", "4"]}], "}"}], ",", 
     SubscriptBox["\[Gamma]", "1"], ",", " ", 
