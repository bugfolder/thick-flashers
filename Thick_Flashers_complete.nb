Cell[TextData[{
 "FlasherFFPointRadialOffset[",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "] gives the (dimensionless) desired radial displacement in the folded form. \
This will ultimately be scaled by ",
 StyleBox["dr",
  FontSlant->"Italic"],
 " (and some trig stuff)."
}], "Text",
 CellChangeTimes->{{3.555714919515016*^9, 3.55571494710506*^9}, 
   3.5557656828439903`*^9, 3.7199186837956743`*^9, {3.719945081223067*^9, 
   3.719945096574994*^9}},ExpressionUUID->"8514ba59-ac40-48c9-af6e-\
433279c4ec74"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherFFPointRadialOffset", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"j", "\[LessEqual]", 
     RowBox[{"i", "+", "1"}]}], ",", 
    RowBox[{
     RowBox[{"i", 
      RowBox[{"(", 
       RowBox[{"i", "+", "1"}], ")"}]}], "+", "j"}], ",", 
    RowBox[{
     RowBox[{"j", 
      RowBox[{"(", 
       RowBox[{"j", "+", "1"}], ")"}]}], "-", 
     RowBox[{"(", 
      RowBox[{"i", "+", "1"}], ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.7199186838090343`*^9},
 CellLabel->
  "In[4146]:=",ExpressionUUID->"4454e9b2-b1d8-4868-a0b2-ca051c3f0f11"],

