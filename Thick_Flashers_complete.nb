Cell[TextData[{
 "CurvedFoldGraphics[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rR",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a Graphics representation of a curved fold along with left and \
right ruling vectors at the beginning of the range."
}], "Text",
 CellChangeTimes->{{3.799939630189575*^9, 3.799939673867987*^9}, {
   3.799939989028119*^9, 3.799940011558477*^9}, 
   3.801648944980961*^9},ExpressionUUID->"bef97085-7d34-4fc1-80a4-\
95e031309247"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the curved fold function in 2D, can be analytic or numeric.\n\t\
",
 StyleBox["rL",
  FontSlant->"Italic"],
 " \[LongDash] the left ruling angle function.\n\t",
 StyleBox["rR",
  FontSlant->"Italic"],
 " \[LongDash] the right ruling angle function.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of plotting."
}], "Text",
 CellChangeTimes->{{3.799939689419408*^9, 3.79993972982012*^9}, {
  3.7999399982214828`*^9, 
  3.7999400316461678`*^9}},ExpressionUUID->"07a9c533-13fa-46ad-b286-\
0621508e40f3"],

Cell["\<\
Returns: a Graphics3D object that displays the fold with unit distance along \
the ruling vectors.\
\>", "Text",
