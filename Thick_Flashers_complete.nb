  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[NDSolve], Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{{3.799406714691597*^9, 3.79940676044363*^9}, {
   3.799406976095245*^9, 3.799406977181387*^9}, 3.799411190316635*^9, {
