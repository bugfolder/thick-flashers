 "TriangleArea2D",
 "[",
 StyleBox["p, q, r",
  FontSlant->"Italic"],
 "] returns the area of a triangle whose vertices are ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["r",
