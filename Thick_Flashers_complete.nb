Cell[CellGroupData[{

Cell[TextData[{
 "ClipSegmentSetToHalfPlane[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}]\nClipSegmentSetToConvexPolygon[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]\nClipSegmentSetToConvexPolygonExterior[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]\nClipSegmentSetToQuasiConvexPolygonExterior[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.4847589850056553`*^9, 3.484759012499998*^9}, {
   3.484759057864227*^9, 3.484759059576343*^9}, 3.484763552408486*^9, {
   3.48476788357306*^9, 3.484767898231624*^9}, {3.6281185018817887`*^9, 
   3.628118504703713*^9}},ExpressionUUID->"cbb7589e-3803-41ae-98b8-\
bdac2cce500e"],

Cell[TextData[{
 "ClipSegmentSetToHalfPlane[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}] takes a segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "} and returns a segment set {",
 StyleBox["q1, q2, isa",
  FontSlant->"Italic"],
 "} that is clipped to the half-plane defined by the line through ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " that contains the point ",
 StyleBox["p3.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.484759096087534*^9, 
  3.484759150553998*^9}},ExpressionUUID->"35c48d00-e676-4e4a-9177-\
144b81540c84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentSetToHalfPlane", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_", ",", "is_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ss", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "is", "]"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", 
          RowBox[{"{", "}"}]}], "}"}], "]"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"it", "'"}], "s", " ", "already", " ", "empty"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"SegmentSetFromHalfPlane", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"NotListEmptyQ", "[", 
        RowBox[{"ss", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", 
         RowBox[{"IntervalSetIntersect", "[", 
          RowBox[{"is", ",", 
           RowBox[{"ss", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", 
         RowBox[{"{", "}"}]}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.484759167639487*^9, 3.4847592036187973`*^9}, {
