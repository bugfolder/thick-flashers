Cell[BoxData[
 RowBox[{
  RowBox[{"MakePrimalDualTwistTessellationEdges", "[", 
   RowBox[{"tobj_TObj", ",", "\[Gamma]_", ",", "\[Alpha]_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pverts", ",", "pedges", ",", "dverts", ",", "dedges", ",", "iverts", ",",
       "bverts", ",", "iedges", ",", "bedges", ",", "bfaces", ",", "pr", ",", 
      "edgepairs", ",", "edgetypes", ",", "ep", ",", "ty", ",", "\[Rho]", ",",
       "\[Beta]", ",", "\[Rho]\[Rho]", ",", "\[Beta]\[Beta]", ",", "newverts",
       ",", "newedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "pverts", ",", "pedges", ",", "dverts", ",", "dedges", ",", "iverts", ",",
         "bverts", ",", "iedges", ",", "bedges", ",", "bfaces"}], "}"}], "=", 
      
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "DualVertices", ",", "DualEdges", ",",
           "InteriorVertices", ",", "BoundaryVertices", ",", "InteriorEdges", 
          ",", "BoundaryEdges", ",", "BoundaryFaces"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"pr", "=", 
      RowBox[{
       RowBox[{"PostRotation", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "MakePrimalDualTwistTessellationEdges", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "\[Beta]"}], "}"}], "=", 
      RowBox[{"ShrinkAndTwistParms", "[", 
       RowBox[{"\[Gamma]", ",", "\[Alpha]", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]\[Rho]", ",", "\[Beta]\[Beta]"}], "}"}], "=", 
      RowBox[{"DualShrinkAndTwistParms", "[", 
       RowBox[{"\[Rho]", ",", "\[Beta]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edgepairs", "=", 
      RowBox[{"edgetypes", "=", 
       RowBox[{"{", "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ep", ",", "ty"}], "}"}], "=", 
           RowBox[{"MakePrimalDualTwistTessellationInteriorEdges", "[", 
            RowBox[{
            "#1", ",", "#2", ",", "pverts", ",", "dverts", ",", "bverts", ",",
              "\[Rho]", ",", "\[Beta]"}], "]"}]}], ";", 
          RowBox[{"JoinTo", "[", 
           RowBox[{"edgepairs", ",", "ep"}], "]"}], ";", 
          RowBox[{"JoinTo", "[", 
           RowBox[{"edgetypes", ",", "ty"}], "]"}]}], ")"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"iedges", ",", "dedges"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ep", ",", "ty"}], "}"}], "=", 
           RowBox[{"MakePrimalDualTwistTessellationBoundaryEdge", "[", 
            RowBox[{
            "#1", ",", "#2", ",", "pverts", ",", "dverts", ",", "\[Rho]", ",",
              "\[Beta]"}], "]"}]}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"edgepairs", ",", "ep"}], "]"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"edgetypes", ",", "ty"}], "]"}]}], ")"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "pedges", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
           "&"}], "/@", "bedges"}], ",", "bfaces"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"pr", ",", "\[IndentingNewLine]", "PrimalRotation", ",", 
       RowBox[{"edgepairs", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RotationMatrix2D", "[", 
             RowBox[{"-", "\[Beta]"}], "]"}], ".", "#"}], "&"}], ",", 
          "edgepairs", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       "DualRotation", ",", 
       RowBox[{"edgepairs", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RotationMatrix2D", "[", 
             RowBox[{"-", "\[Beta]\[Beta]"}], "]"}], ".", "#"}], "&"}], ",", 
          "edgepairs", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"newverts", ",", "newedges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"edgepairs", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"newverts", ",", "newedges"}], "]"}], "//", 
      RowBox[{
       RowBox[{"AddTAssignedTo", "[", 
        RowBox[{"#", ",", "edgetypes"}], "]"}], "&"}]}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{
