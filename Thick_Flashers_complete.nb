   3.59520069747563*^9, {3.627768804500193*^9, 3.627768805431327*^9}, {
   3.6281101292573237`*^9, 3.628110157020866*^9}, {3.6288671423271933`*^9, 
   3.62886715153334*^9}, {3.628870217384714*^9, 3.628870271420255*^9}, 
