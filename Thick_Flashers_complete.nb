          RowBox[{"x", ",", "x0", ",", "x1"}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", "Cyan"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", 
