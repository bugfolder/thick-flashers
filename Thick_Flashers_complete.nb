Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "t", ",", "sq", ",", "r1", ",", "r2", ",", "ai", ",",
       "p", ",", "q", ",", "r1a", ",", "r2a", ",", "cu1", ",", "kn1", ",", 
      "ho1", ",", "cu2", ",", "kn2", ",", "ho2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", "20."}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"panel", " ", 
       RowBox[{"(", 
        RowBox[{"and", " ", "hinge"}], ")"}], " ", "length"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", "5."}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"panel", " ", "height"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", "=", "2."}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"panel", " ", "thickness"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"r1", "=", 
      RowBox[{"r2", "=", 
       RowBox[{"MakeCubeGC", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Two", " ", "vertical", " ", "panels"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "t", ",", "b"}], "}"}], "#"}], "&"}], "/@", 
       RowBox[{
       "r1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "t", ",", "0"}], "}"}], "+", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "t", ",", "b"}], "}"}], "#"}]}], "&"}], "/@", 
       RowBox[{
       "r2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ai", "=", "2."}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"axis", " ", "of", " ", "the", " ", "hinge"}], ",", " ", 
       RowBox[{
       "inset", " ", "from", " ", "the", " ", "ends", " ", "of", " ", "the", " ", 
        RowBox[{"panels", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ai", ",", "t", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "-", "ai"}], ",", "t", ",", "b"}], "}"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Get", " ", "all", " ", "the", " ", "parts"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "cu1", ",", "kn1", ",", "ho1", ",", "cu2", ",", "kn2", ",", "ho2"}], 
       "}"}], "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"MakePinHingeParts", "[", 
         RowBox[{"{", 
          RowBox[{"p", ",", "q"}], "}"}], "]"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r1", ",", "r2"}], "}"}], ",", 
            RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<Panels\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"r1", ",", "r2"}], "}"}], ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"cu1", ",", "cu2"}], "}"}], ",", "Pink", ",", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"kn1", ",", "kn2"}], "}"}], ",", "Orange"}], "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"ho1", ",", "ho2"}], "}"}], ",", "Gray", ",", 
              RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", ".1"}], ",", 
               RowBox[{"a", "+", ".1"}]}], "}"}], ",", "All", ",", "All"}], 
            "}"}]}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<Panels and knuckles\>\""}]}], "]"}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "r1", "}"}], ",", 
                RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "cu1", "}"}], ",", "Pink", ",", 
                RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "kn1", "}"}], ",", "Orange"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "ho1", "}"}], ",", "Gray", ",", 
                RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"TransformGC", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "r2", "}"}], ",", 
                  RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "cu2", "}"}], ",", "Pink", ",", 
                  RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "kn2", "}"}], ",", "Orange"}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "ho2", "}"}], ",", "Gray", ",", 
                  RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "3", ",", "0"}], "}"}], "+", "#"}], 
               "&"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", ".1"}], ",", 
               RowBox[{"a", "+", ".1"}]}], "}"}], ",", "All", ",", "All"}], 
            "}"}]}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{
          "PlotLabel", "->", "\"\<Panels and knuckles, separated\>\""}]}], 
         "]"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
