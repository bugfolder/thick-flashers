Cell[CellGroupData[{

Cell[TextData[{
 "AssemblePinHingedPanelParts[",
 StyleBox["panelparts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.9347340780157967`*^9, 3.934734088775743*^9}, {
  3.934734134256481*^9, 
  3.934734135223246*^9}},ExpressionUUID->"644a7dd3-ade3-4d60-a6f2-\
4541240965cd"],

Cell[TextData[{
 "AssemblePinHingedPanelParts[",
 StyleBox["panelparts",
  FontSlant->"Italic"],
 "] takes the output of MakePinHingedPanelParts and creates a set of panels \
as MeshRegion objects where each panel contains its cutouts, knuckles, and \
holes in the knuckles."
}], "Text",
 CellChangeTimes->{{3.9347341078922043`*^9, 
  3.9347341956081333`*^9}},ExpressionUUID->"34bbe460-b8e0-4a19-b1f2-\
3b10764024ea"],

Cell["\<\
Due to Mathematica\[CloseCurlyQuote]s limitations when performing Boolean \
operations, this will hardly work on any but the simplest structure, but I\
\[CloseCurlyQuote]m keeping it here for completeness and potential future use \
if Mathematica develops more robust Boolean region operations.\
\>", "Text",
 CellChangeTimes->{{3.9347355266590567`*^9, 
  3.934735585169619*^9}},ExpressionUUID->"2cd80d60-6336-4aba-99f2-\
7e2825f52927"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AssemblePinHingedPanelParts", "[", "panelparts_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"panel", ",", "cutouts", ",", "knuckles", ",", "holes"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"panel", ",", "cutouts", ",", "knuckles", ",", "holes"}], 
         "}"}], "=", 
        RowBox[{
        "panelparts", "\[LeftDoubleBracket]", "i", 
         "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Convert", " ", "all", " ", "of", " ", "the", " ", "GraphicsComplex", 
         " ", "objects", " ", "to", " ", "MeshRegions", " ", "by", " ", 
         "taking", " ", "the", " ", "convex", " ", "hull", " ", "of", " ", 
         "their", " ", 
         RowBox[{"vertices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"panel", "=", 
        RowBox[{"ConvexHullMesh", "[", 
         RowBox[{
         "panel", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cutouts", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ConvexHullMesh", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}],
           "&"}], "/@", "cutouts"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"knuckles", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ConvexHullMesh", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}],
           "&"}], "/@", "knuckles"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"holes", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ConvexHullMesh", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}],
           "&"}], "/@", "holes"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Remove", " ", "cutouts", " ", "from", " ", "the", " ", "panel"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"panel", "=", 
           RowBox[{"RegionDifference", "[", 
            RowBox[{"panel", ",", 
             RowBox[{
             "cutouts", "\[LeftDoubleBracket]", "j", 
              "\[RightDoubleBracket]"}]}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "cutouts", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Drill", " ", "holes", " ", "in", " ", "the", " ", 
         RowBox[{"knuckles", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "knuckles", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}],
            "=", 
           RowBox[{"RegionDifference", "[", 
            RowBox[{
             RowBox[{
             "knuckles", "\[LeftDoubleBracket]", "j", 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "holes", "\[LeftDoubleBracket]", "j", 
              "\[RightDoubleBracket]"}]}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "knuckles", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Attach", " ", "the", " ", "knuckles", " ", "to", " ", "the", " ", 
         RowBox[{"panel", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"panel", "=", 
           RowBox[{"RegionUnion", "[", 
            RowBox[{"panel", ",", 
             RowBox[{
             "knuckles", "\[LeftDoubleBracket]", "j", 
              "\[RightDoubleBracket]"}]}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "knuckles", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "panel"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "panelparts", "]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9347342037269487`*^9, 3.934734211665234*^9}, {
  3.9347343038095903`*^9, 3.934734424009798*^9}, {3.934734455529257*^9, 
  3.934734494845416*^9}, {3.934734529643971*^9, 3.9347347377095947`*^9}, {
  3.934734880683577*^9, 3.9347348930819483`*^9}, {3.9347349837871313`*^9, 
  3.934735069410049*^9}, {3.934735203657913*^9, 3.9347352341197233`*^9}, {
  3.934735369054922*^9, 3.934735398213675*^9}, {3.934735435946336*^9, 
  3.934735487298077*^9}, {3.934735661528302*^9, 3.9347356899428587`*^9}, {
  3.9347357333348417`*^9, 3.934735741236927*^9}},
 CellLabel->
  "In[4402]:=",ExpressionUUID->"721b002c-9cf9-4fdd-823d-ee150a35f172"],

Cell["\<\
Example. Three panels, two hinges between them, one on top, one on bottom. \
Even this simple structure stymies Mathematica, which fails to preserve \
watertightness when performing the Boolean operations.\
\>", "Text",
 CellChangeTimes->{{3.933843462700878*^9, 3.933843464966213*^9}, {
  3.933844061237239*^9, 3.933844067636639*^9}, {3.9339440448564568`*^9, 
  3.9339440539920397`*^9}, {3.934030013906102*^9, 3.934030041481729*^9}, {
  3.934734800018195*^9, 
  3.934734829498077*^9}},ExpressionUUID->"8f51dd9b-a9f0-4df6-a2cb-\
9b16ade0bcad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", "t", ",", "a", ",", "b", ",", "c", ",", "panels", ",", 
       "panelinfo", ",", "axes", ",", "panelparts", ",", "xfrm", ",", 
       "assy"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", "t"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"10", ",", "2"}], "}"}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"dimensions", " ", "of", " ", "the", " ", "panels"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"b", "=", 
        RowBox[{"c", "=", 
         RowBox[{"MakeCubeGC", "[", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "a", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"d", ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "b", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "d"}], ",", "0", ",", "0"}], "}"}], "+", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "d", ",", "t"}], "}"}], "#"}]}], "&"}], "/@", 
        RowBox[{
        "c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"panels", "=", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"axes", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "1", ",", "t"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", 
             RowBox[{"d", "-", "1"}], ",", "t"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "d"}], ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "d"}], ",", 
             RowBox[{"d", "-", "1"}], ",", "0"}], "}"}]}], "}"}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"panelinfo", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "7"}], "}"}]}], "}"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"{", 
              RowBox[{"5", ",", "8"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", 
             RowBox[{"{", 
              RowBox[{"6", ",", "7"}], "}"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"{", 
             RowBox[{"5", ",", "8"}], "}"}]}], "}"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Show", " ", "the", " ", "panels", " ", "and", " ", "the", " ", "axes",
         " ", "where", " ", "the", " ", "pin", " ", "hinges", " ", "should", " ", 
        RowBox[{"go", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "SolidStyle", ",", 
             RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Cylinder", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"t", "/", "2"}]}], "]"}], ",", "Orange"}], "]"}], 
             "&"}], "/@", "axes"}]}], "}"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Panels and hinge locations\>\""}]}], 
        "]"}], "//", "Print"}], ";", "\[IndentingNewLine]", 
      RowBox[{"panelparts", "=", 
       RowBox[{"MakePinHingedPanelParts", "[", 
        RowBox[{"panels", ",", "panelinfo", ",", "axes"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Show", " ", "the", " ", "individual", " ", "elements", " ", "in", " ", 
        RowBox[{"place", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "/@", 
       RowBox[{"PinHingedPanelPartsGraphics3D", "[", "panelparts", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Assemble", " ", 
        RowBox[{"everything", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"assy", "=", 
       RowBox[{"AssemblePinHingedPanelParts", "[", "panelparts", "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.9338434666037188`*^9, 3.933843753165881*^9}, {
   3.933843810464285*^9, 3.933843941364746*^9}, {3.933844161890683*^9, 
   3.933844180769278*^9}, 3.9338442251866007`*^9, {3.9338443529431887`*^9, 
   3.933844433231263*^9}, {3.933848767765184*^9, 3.933849124182384*^9}, {
   3.9338495696964273`*^9, 3.933849656842805*^9}, {3.933849716726035*^9, 
   3.9338497857210293`*^9}, {3.933849828419718*^9, 3.933849849128956*^9}, {
   3.933850178092819*^9, 3.933850178761903*^9}, {3.9339440143840733`*^9, 
   3.933944040619136*^9}, {3.933955411916813*^9, 3.933955413128628*^9}, {
   3.9340300714361486`*^9, 3.93403022053214*^9}, {3.934030281362485*^9, 
   3.93403028329956*^9}, {3.934030397085353*^9, 3.934030635941825*^9}, {
   3.9340311385114613`*^9, 3.9340312261873903`*^9}, {3.934031349291337*^9, 
   3.934031392957776*^9}, {3.934031441850502*^9, 3.9340315094592133`*^9}, {
   3.934034623587556*^9, 3.934034649915675*^9}, {3.934034680363757*^9, 
   3.934034771011818*^9}, {3.93430118804939*^9, 3.934301219494111*^9}, 
   3.934305663604453*^9, {3.934734254329529*^9, 3.934734288213408*^9}, {
   3.934734747485457*^9, 3.934734750285997*^9}, {3.934734790706295*^9, 
   3.934734794674474*^9}, {3.934735639755864*^9, 3.934735649203065*^9}, {
   3.934735748830997*^9, 3.934735752469862*^9}, 3.935059710022039*^9, {
   3.935059747293768*^9, 3.935059748589301*^9}, {3.935858718006556*^9, 
   3.935858742124116*^9}, 3.93585878947924*^9},
 CellLabel->
  "In[4403]:=",ExpressionUUID->"151792fa-5584-4969-b3b1-a3640f437767"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["MeshLab-assisted assembly", "Subsection",
 CellChangeTimes->{{3.9337859987251062`*^9, 3.933786004145598*^9}, {
  3.933887120002742*^9, 3.933887120721203*^9}, {3.934735764708165*^9, 
  3.934735765955399*^9}},ExpressionUUID->"d3e90d1c-bddd-4f9a-bd82-\
986910303470"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.933856210333042*^9, 
  3.9338562107968807`*^9}},ExpressionUUID->"586f3964-fcc4-4d0f-a6c2-\
2d2aef51612c"],

Cell["\<\
Creating pin hinges requires making cylindrical cutouts in panels to provide \
clearances for the hinge knuckles of their neighbors and then attaching \
knuckles to those panels in such a way that we can put a pin through coaxial \
knuckles to create the hinge. This requires performing Boolean difference and \
union functions on the panels. Although Mathematica has the functions \
RegionDifference and RegionUnion, I\[CloseCurlyQuote]ve found that with any \
but the simplest configurations, Mathematica fails to preserve watertightness \
of the relevant meshes, resulting in failure to generate the final shapes \
and/or actual crashing of the Mathematica kernel. In fact, even attempting to \
perform a simple translation on a bunch of these MeshRegions (using \
TransformRegion) can crash the Mathematica kernel. Which is annoying, to say \
the least.\
\>", "Text",
 CellChangeTimes->{{3.933856224197383*^9, 3.933856401958269*^9}, {
  3.933886541665069*^9, 3.933886627211585*^9}, {3.934031555247446*^9, 
  3.934031559310605*^9}},ExpressionUUID->"20e2f874-8fe7-4b85-b80f-\
7dd54952798b"],

Cell["\<\
So, we need to turn to an external tool to perform these Boolean functions on \
the meshes.\
\>", "Text",
 CellChangeTimes->{
  3.9338865833146544`*^9},ExpressionUUID->"cff22cef-7994-4b7f-b50c-\
1cee0694b974"],

Cell["\<\
The tool I\[CloseCurlyQuote]m using in this section is the program MeshLab, \
which provides Python bindings via the PyMeshLab library (which, however, \
only runs on Intel machines, thus not on the latest Apple Silicon Macs). The \
general approach will be that in Mathematica I will generate STL files for \
the relatively simple panels, cutouts,  knuckles, and holes, but then perform \
the Boolean operations using MeshLab, by creating a Python script that calls \
MeshLab via PyMeshLab to perform the Boolean operations and then put things \
all together into STL files.\
\>", "Text",
 CellChangeTimes->{{3.933856403927164*^9, 3.9338565362975197`*^9}, {
  3.933886659411224*^9, 3.933886667307474*^9}, {3.934031580182324*^9, 
  3.934031613156066*^9}, {3.934306191364843*^9, 3.9343062082595263`*^9}, {
  3.9370514006938877`*^9, 
  3.937051421876042*^9}},ExpressionUUID->"4f33c916-4445-4114-822b-\
b1c7a9670ac3"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
MeshLabPinHingedPanelShifts
MeshLabPinHingedPanelsPerScript
MeshLabPinHingedAssyScript\
\>", "Subsubsection",
 CellChangeTimes->{{3.933850353629106*^9, 3.9338503699962673`*^9}, {
   3.9338867335352716`*^9, 3.9338867550526047`*^9}, {3.933946774938888*^9, 
   3.9339467788167973`*^9}, 3.934204496269537*^9, {3.93420633920964*^9, 
   3.934206343387561*^9}, 3.934306241129342*^9, 3.934306273515664*^9, {
   3.934306384666553*^9, 3.934306414405983*^9}, 
   3.9350631352282763`*^9},ExpressionUUID->"8cc803c3-b1a1-4ade-b8fe-\
0592c49aef7c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MeshLabPinHingedPanelShifts", "::", "usage"}], 
   "=", "\"\<MeshLabPinHingedPanelShifts is an option to \
MakeMeshLabPinHingedParts that specifies translations to be applied to the \
panels from within MeshLab.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933850431707395*^9, 3.933850473012095*^9}, 
   3.933886717095207*^9, {3.933886755053681*^9, 3.933886755054043*^9}, {
   3.933946791792494*^9, 3.9339468119629097`*^9}, {3.93430624113113*^9, 
   3.934306241131402*^9}},
 CellLabel->
  "In[4404]:=",ExpressionUUID->"67699419-2b88-4154-badc-59ac8da59731"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MeshLabPinHingedPanelsPerScript", "::", "usage"}], 
   "=", "\"\<MeshLabPinHingedPanelsPerScript is an option to \
MakeMeshLabPinHingedParts that specifies the number of panels to build in \
each panel-building script.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.933850431707395*^9, 3.933850473012095*^9}, 
   3.933886717095207*^9, {3.933886755053681*^9, 3.933886755054043*^9}, {
   3.934206351570665*^9, 3.9342063717701197`*^9}, {3.934306273517496*^9, 
   3.9343062735177917`*^9}},
 CellLabel->
  "In[4405]:=",ExpressionUUID->"002bfabb-4032-4a30-8339-fc199a3d11fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MeshLabPinHingedAssyScript", "::", "usage"}], 
   "=", "\"\<MeshLabPinHingedAssyScript is an option to \
MakeMeshLabPinHingedPanels that specifies whether to generate an assembly \
script.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.934301863446039*^9, 3.934301922124889*^9}, 
   3.934306324382948*^9, 3.934306376869081*^9, {3.934306414407796*^9, 
   3.9343064144081993`*^9}},
 CellLabel->
  "In[4406]:=",ExpressionUUID->"68ab5d47-d125-416e-8f70-9b2ae269089e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeMeshLabPinHingedPanels[",
 StyleBox["dir",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelparts, opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.9337860085726423`*^9, 3.9337860251644077`*^9}, {
   3.933850192207657*^9, 3.933850194838825*^9}, {3.9338503351804953`*^9, 
   3.933850335901433*^9}, 3.933886717099165*^9, 3.9343013719083643`*^9, 
   3.9343063300835*^9, 
   3.934306376875504*^9},ExpressionUUID->"0ecdffae-5056-4cf3-8f58-\
726043fa4654"],

Cell[TextData[{
 "MakeMeshLabPinHingedParts[",
 StyleBox["dir",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelparts",
  FontSlant->"Italic"],
 "] takes a set of pin-hinged panel parts and exports a set of files and \
Python scripts that, when executed, interact with MeshLab via the PyMeshLab \
library to build a complete set of pin-hinged panels as STL files."
}], "Text",
 CellChangeTimes->{{3.933786035584469*^9, 3.933786178062088*^9}, {
   3.933850241592223*^9, 3.933850242101708*^9}, 3.933886717103088*^9, {
   3.934202611952161*^9, 3.934202619985715*^9}, {3.934306436515772*^9, 
   3.9343064589303627`*^9}},ExpressionUUID->"8abfc4f0-48af-42f1-aaf0-\
8943df4bc781"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["dir",
  FontSlant->"Italic"],
 " \[LongDash] the directory in which all the files and the script will be \
placed. If it doesn\[CloseCurlyQuote]t exist, it will be created. Example: \
\[OpenCurlyDoubleQuote]~/Desktop/foo\[CloseCurlyDoubleQuote].\n\t",
 StyleBox["panelparts",
  FontSlant->"Italic"],
 " \[LongDash] a structured list of the GraphicsComplex polyhedra that define \
the panels and hinge parts. It is of the form {{",
 StyleBox["panel1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cutouts1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["knuckles1, holes1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["panel2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cutouts2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["knuckles2, holes2",
  FontSlant->"Italic"],
 "}, ...}, where\n\t\t",
 StyleBox["panelN",
  FontSlant->"Italic"],
 " is the ",
 StyleBox["N",
  FontSlant->"Italic"],
 "th original panel (a GraphicsComplex polyhedron);\n\t\t",
 StyleBox["cutoutsN",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex polyhedra containing the cutouts that should \
be applied to ",
 StyleBox["panelN",
  FontSlant->"Italic"],
 ";\n\t\t",
 StyleBox["knucklesN",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex polyhedra containing the cylindrical knuckles \
that should be attached to ",
 StyleBox["panelN",
  FontSlant->"Italic"],
 " after ",
 StyleBox["cutoutsN",
  FontSlant->"Italic"],
 " have been applied;\n\t\t",
 StyleBox["holesN",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex polyhedra containing the holes that should be \
drilled through each of ",
 StyleBox["knuckleN",
  FontSlant->"Italic"],
 " before attaching it to the panel."
}], "Text",
 CellChangeTimes->{{3.933786230750423*^9, 3.933786355686945*^9}, {
  3.933786562449542*^9, 3.933786572426248*^9}, {3.933850255592366*^9, 
  3.933850327054968*^9}, {3.934031631079254*^9, 3.9340317220536203`*^9}, {
  3.934301631625411*^9, 3.934301642880704*^9}, {3.934306480424142*^9, 
  3.9343065069504747`*^9}},ExpressionUUID->"3cfe1b6f-8163-4c3e-89dc-\
c69405a892da"],

Cell[TextData[{
 "Options:\n\tMeshLabPinHingedPanelShifts \[Rule] ",
 StyleBox["shifts",
  FontSlant->"Italic"],
 " | None, specifies additional translations to be applied to the panels from \
within MeshLab (typically to separate parts from each other to provide \
clearances and/or so that overhangs can be supported).\n\t\
MeshLabPinHingedPanelsPerScript \[Rule] All | {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ... ",
 StyleBox["iN",
  FontSlant->"Italic"],
 "}, where the list can be a list of indices of specific panels to include in \
the script. This can be used if you only want to generate a subset of the \
panels as STL files and/or assembly.\n\tMeshLabPinHingedAssyScript \[Rule] \
True | False, whether to generate an assembly script that combines all of the \
panels into a single STL file, which will be titled panel_assy.stl."
}], "Text",
 CellChangeTimes->{{3.933788086356783*^9, 3.933788111222014*^9}, {
   3.933850484136503*^9, 3.933850526837171*^9}, {3.933886733539896*^9, 
   3.9338867550576267`*^9}, {3.9339467239386168`*^9, 3.933946750682982*^9}, {
   3.9339468184117737`*^9, 3.933946882202879*^9}, {3.934031736163796*^9, 
   3.934031752420857*^9}, 3.9342045020129137`*^9, {3.93430168940833*^9, 
   3.93430176169521*^9}, {3.934301824506043*^9, 3.934301853505117*^9}, 
   3.934306273522107*^9, 3.934306414412747*^9, {3.934306515473072*^9, 
   3.934306590226837*^9}, 3.935063141613241*^9, {3.935063235437743*^9, 
   3.935063242637814*^9}},ExpressionUUID->"2fc24fe4-5485-419e-b25c-\
f29bb56225a5"],

Cell["\<\
Returns: no return value, but will populate the directory with the files and \
the script needed to create the set of parts. There will be two scripts in \
the output directory:
\tmake_panels.py \[LongDash] which assembles all of the individual hinged \
panels and stores the individually assembled panels in the hinged_panel \
subdirectory;
\tmake_assy.py \[LongDash] which reads in all of the hinged panels and \
assembles them into a single STL file named panel_assy.stl.\
\>", "Text",
 CellChangeTimes->{{3.9337863731129017`*^9, 3.933786400071904*^9}, {
  3.933786456417809*^9, 3.933786459246224*^9}, {3.9337889865222282`*^9, 
  3.9337890000025597`*^9}, {3.9338505381647663`*^9, 3.933850542476984*^9}, {
  3.9342026066575403`*^9, 3.934202607209031*^9}, {3.9342042709101152`*^9, 
  3.9342043109753113`*^9}, {3.934204343366551*^9, 3.934204417388986*^9}, {
  3.934306615259083*^9, 3.9343066381839933`*^9}, {3.937051549629881*^9, 
  3.9370515522888937`*^9}},ExpressionUUID->"106ad642-1800-4f06-a91d-\
36ebf4d18486"],

Cell["\<\
For each PyMeshLab command that creates a new mesh, we add a Python comment \
to the end of the line that gives the index of the newly created mesh. This \
helps in seeing how the final assembly is built from previously created \
meshes in the MeshNet list of mesh layers.\
\>", "Text",
 CellChangeTimes->{{3.9338568475273037`*^9, 3.9338568983084993`*^9}, {
  3.934031764708405*^9, 
  3.934031823787032*^9}},ExpressionUUID->"e715a01a-8570-47d7-86e0-\
8057ab4a1b45"],

Cell[TextData[{
 "Once you have run MakeMeshLabPinHingedPanels from within Mathematica, do \
the following:\n\t\[LongDash]Open a command-line interface (e.g., Terminal on \
a Mac), and navigate to the directory you have just created.\n\t\
\[LongDash]Run the command ",
 StyleBox["python3 make_panels.py",
  FontWeight->"Bold"],
 " (assuming you have installed PyMeshLab and verified that it works). This \
will run the script and create separate STL files for each panel in the \
panels_hinged subdirectory.\n\t\[LongDash](Optional) Run the command ",
 StyleBox["python3 make_assy.py",
  FontWeight->"Bold"],
 ". This will assemble all of the individual panels into a single STL file, \
which will have the output name and will reside in the root of the working \
directory."
}], "Text",
 CellChangeTimes->{{3.934307010515195*^9, 3.934307226801057*^9}, {
  3.937051597435192*^9, 
  3.93705160232967*^9}},ExpressionUUID->"a4838238-9b3c-4291-9801-\
c7b6ebfc633b"],

Cell["\<\
Note that the various subdirectories will contain a large number of files. \
You can discard them if you wish, once you\[CloseCurlyQuote]ve created the \
desired hinged panels and/or their assembly.\
\>", "Text",
 CellChangeTimes->{{3.934307230455792*^9, 3.9343072434485598`*^9}, {
  3.9343072742249527`*^9, 3.934307291545126*^9}, {3.937051618446155*^9, 
  3.937051619006216*^9}, {3.937051686666401*^9, 
  3.937051687240144*^9}},ExpressionUUID->"f321f97a-390b-4338-ba2e-\
5c56fb903c04"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeMeshLabPinHingedPanels", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MeshLabPinHingedPanelShifts", "->", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MeshLabPinHingedPanelsPerScript", "\[Rule]", "All"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MeshLabPinHingedAssyScript", "->", "True"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.933850554078135*^9, 3.933850655018445*^9}, {
   3.9338867171046352`*^9, 3.933886755059038*^9}, {3.933946763436311*^9, 
   3.933946770891395*^9}, 3.9340353515393457`*^9, 3.934204511665144*^9, {
   3.93420632267447*^9, 3.934206335339746*^9}, 3.934301377125383*^9, {
   3.93430168597827*^9, 3.934301686350461*^9}, {3.934301807986755*^9, 
   3.934301820806518*^9}, {3.934304112424591*^9, 3.934304112910181*^9}, 
   3.934306241132255*^9, 3.934306273523789*^9, 3.934306324383655*^9, 
   3.934306376877306*^9, 3.934306414414283*^9, 3.9370515341586723`*^9},
 CellLabel->
  "In[4407]:=",ExpressionUUID->"694ced24-84ba-485b-a98e-4288a6507a0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeMeshLabPinHingedPanels", "[", 
   RowBox[{"dir_", ",", " ", "panelparts_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "outputname", ",", "shifts", ",", "pps", ",", "mas", ",", "script", ",", 
      "pname", ",", "cname", ",", "kname", ",", "hname", ",", "phname", ",", 
      "i", ",", "expfn", ",", "preamble", ",", "im", ",", "ip"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shifts", ",", "pps", ",", "mas"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "MeshLabPinHingedPanelShifts", ",", 
          "MeshLabPinHingedPanelsPerScript", ",", 
          "MeshLabPinHingedAssyScript"}], "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeMeshLabPinHingedPanels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "the", " ", "directories", " ", "if", " ", "they", " ", 
       RowBox[{"don", "'"}], "t", " ", "already", " ", 
       RowBox[{"exist", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
       RowBox[{"CreateDirectory", "[", "dir", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirparts", "=", 
         RowBox[{"dir", "<>", "\"\</parts\>\""}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "dirparts", "]"}]}], ",", 
         RowBox[{"CreateDirectory", "[", "dirparts", "]"}]}], "]"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirparts", "=", 
         RowBox[{"dir", "<>", "\"\</parts/panels\>\""}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "dirparts", "]"}]}], ",", 
         RowBox[{"CreateDirectory", "[", "dirparts", "]"}]}], "]"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirparts", "=", 
         RowBox[{"dir", "<>", "\"\</parts/cutouts\>\""}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "dirparts", "]"}]}], ",", 
         RowBox[{"CreateDirectory", "[", "dirparts", "]"}]}], "]"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirparts", "=", 
         RowBox[{"dir", "<>", "\"\</parts/knuckles\>\""}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "dirparts", "]"}]}], ",", 
         RowBox[{"CreateDirectory", "[", "dirparts", "]"}]}], "]"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirparts", "=", 
         RowBox[{"dir", "<>", "\"\</parts/holes\>\""}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "dirparts", "]"}]}], ",", 
         RowBox[{"CreateDirectory", "[", "dirparts", "]"}]}], "]"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirparts", "=", 
         RowBox[{"dir", "<>", "\"\</parts/panels_hinged\>\""}]}], "}"}], ",", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "dirparts", "]"}]}], ",", 
         RowBox[{"CreateDirectory", "[", "dirparts", "]"}]}], "]"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Functions", " ", "that", " ", "produce", " ", "filenames", " ", 
       "based", " ", "on", " ", "their", " ", "indices"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pname", "[", "i_", "]"}], ":=", 
      RowBox[{"\"\<parts/panels/panel_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.stl\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cname", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"\"\<parts/cutouts/cutout_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
       RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<.stl\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"kname", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"\"\<parts/knuckles/knuckle_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
       RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<.stl\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hname", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"\"\<parts/holes/hole_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
       RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<.stl\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phname", "[", "i_", "]"}], ":=", 
      RowBox[{"\"\<parts/panels_hinged/panel_hinged_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.stl\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Export", " ", "function", " ", "for", " ", "GraphicsComplex", " ", 
       "objects"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"expfn", "[", 
         RowBox[{"name_", ",", "obj_"}], "]"}], ":=", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"dir", "<>", "\"\</\>\"", "<>", "name"}], ",", 
          RowBox[{"ConvexHullMesh", "[", 
           RowBox[{
           "obj", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<STL\>\"", ",", 
            RowBox[{"\"\<BinaryFormat\>\"", "->", "False"}]}], "}"}]}], 
         "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"expfn", "[", 
       RowBox[{"name_", ",", "obj_"}], "]"}], ":=", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"dir", "<>", "\"\</\>\"", "<>", "name"}], ",", 
        RowBox[{"Graphics3D", "[", "obj", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<STL\>\"", ",", 
          RowBox[{"\"\<BinaryFormat\>\"", "->", "False"}]}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Preamble", " ", "to", " ", "all", " ", "scripts"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"preamble", "=", 
      RowBox[{"\"\<#!/usr/bin/env python3\\n\>\"", "<>", 
       "\[IndentingNewLine]", "\"\<import pymeshlab\\n\>\"", "<>", 
       "\[IndentingNewLine]", "\"\<ms = pymeshlab.MeshSet()\\n\\n\>\""}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Make", " ", "the", " ", "list", " ", "of", " ", "panels", " ", "to", " ",
        "include"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"pps", "===", "All"}], ",", 
       RowBox[{"pps", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "panelparts", "]"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "start", " ", "the", " ", "script", " ", "to", " ", "build", " ", "the",
        " ", "panels"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"script", "=", "preamble"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Build", " ", "the", " ", "script", " ", "and", " ", "export", " ", 
       "the", " ", "referenced", " ", "files", " ", "along", " ", "the", " ", 
       
       RowBox[{"way", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"for", " ", "each", " ", "panel"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"script", "=", 
         RowBox[{"script", "<>", "\"\<ms.clear()\\n\>\""}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"clear", " ", "any", " ", "previous", " ", "meshes"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"im", "=", 
         RowBox[{"-", "1"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "index", " ", "of", " ", "the", " ", "current", " ", "mesh", " ", 
          "after", " ", "an", " ", "action", " ", "that", " ", "creates", " ",
           "a", " ", "new", " ", 
          RowBox[{"mesh", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"i", "=", 
         RowBox[{
         "pps", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "panels", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"expfn", "[", 
         RowBox[{
          RowBox[{"pname", "[", "i", "]"}], ",", 
          RowBox[{"panelparts", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"script", "=", 
         RowBox[{"script", "<>", "\"\<ms.load_new_mesh(file_name = '\>\"", "<>", 
          RowBox[{"pname", "[", "i", "]"}], 
          "<>", "\"\<', unify_vertices = True) # \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"script", "=", 
         RowBox[{"script", "<>", "\"\<print('Loaded file \>\"", "<>", 
          RowBox[{"pname", "[", "i", "]"}], "<>", "\"\<')\\n\>\""}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "cutouts", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"expfn", "[", 
            RowBox[{
             RowBox[{"cname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ",", 
             RowBox[{"panelparts", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2", ",", "j"}], "\[RightDoubleBracket]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", "<>", "\"\<ms.load_new_mesh(file_name = '\>\"", "<>", 
             RowBox[{"cname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], 
             "<>", "\"\<', unify_vertices = True) # \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{"script", "<>", "\"\<print('Loaded file \>\"", "<>", 
             RowBox[{"cname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], "<>", "\"\<')\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", 
             "<>", "\"\<ms.generate_boolean_difference(first_mesh = \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"im", "-", "1"}], "]"}], 
             "<>", "\"\<, second_mesh = \>\"", "<>", 
             RowBox[{"ToString", "[", "im", "]"}], "<>", "\"\<) # \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", 
             "<>", "\"\<print('Generated Boolean difference (remove cutout \
from panel) [\>\"", "<>", 
             RowBox[{"ToString", "[", "im", "]"}], "<>", "\"\<]')\\n\>\""}]}],
            ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"panelparts", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "]"}]}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"ip", " ", "=", " ", "im"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"index", " ", "of", " ", "current", " ", "panel"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"knuckles", " ", "and", " ", "holes"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "export", " ", "and", " ", "load", " ", "the", " ", "knuckle"}], 
          " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"expfn", "[", 
            RowBox[{
             RowBox[{"kname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ",", 
             RowBox[{"panelparts", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "3", ",", "j"}], "\[RightDoubleBracket]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", "<>", "\"\<ms.load_new_mesh(file_name = '\>\"", "<>", 
             RowBox[{"kname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], 
             "<>", "\"\<', unify_vertices = True) # \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{"script", "<>", "\"\<print('Loaded file \>\"", "<>", 
             RowBox[{"kname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], "<>", "\"\<')\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "export", " ", "and", " ", "load", " ", "the", " ", "hole"}], " ",
             "*)"}], "\[IndentingNewLine]", 
           RowBox[{"expfn", "[", 
            RowBox[{
             RowBox[{"hname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ",", 
             RowBox[{"panelparts", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "4", ",", "j"}], "\[RightDoubleBracket]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", "<>", "\"\<ms.load_new_mesh(file_name = '\>\"", "<>", 
             RowBox[{"hname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], 
             "<>", "\"\<', unify_vertices = True) # \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{"script", "<>", "\"\<print('Loaded file \>\"", "<>", 
             RowBox[{"hname", "[", 
              RowBox[{"i", ",", "j"}], "]"}], "<>", "\"\<')\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "drill", " ", "the", " ", "hole", " ", "through", " ", "the", " ",
              "knuckle"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", 
             "<>", "\"\<ms.generate_boolean_difference(first_mesh = \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"im", "-", "1"}], "]"}], 
             "<>", "\"\<, second_mesh = \>\"", "<>", 
             RowBox[{"ToString", "[", "im", "]"}], "<>", "\"\<) # \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", 
             "<>", "\"\<print('Generated Boolean difference (drill hole \
through knuckle) [\>\"", "<>", 
             RowBox[{"ToString", "[", "im", "]"}], "<>", "\"\<]')\\n\>\""}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "attach", " ", "the", " ", "knuckle", " ", "to", " ", "the", " ", 
             "panel"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", "<>", "\"\<ms.generate_boolean_union(first_mesh = \>\"",
              "<>", 
             RowBox[{"ToString", "[", "ip", "]"}], 
             "<>", "\"\<, second_mesh = \>\"", "<>", 
             RowBox[{"ToString", "[", "im", "]"}], "<>", "\"\<) # \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", 
             "<>", "\"\<print('Generated Boolean union (attach knuckle to \
panel) [\>\"", "<>", 
             RowBox[{"ToString", "[", "im", "]"}], "<>", "\"\<]')\\n\>\""}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"ip", "=", "im"}], ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"panelparts", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}], "]"}]}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        
        RowBox[{"(*", " ", 
         RowBox[{
         "Shift", " ", "the", " ", "panel", " ", "if", " ", "shifts", " ", 
          "were", " ", 
          RowBox[{"requested", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"shifts", "=!=", "None"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"script", "=", 
            RowBox[{
            "script", 
             "<>", "\"\<ms.compute_matrix_from_translation(traslmethod = 0, \
axisx = \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"shifts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "]"}], 
