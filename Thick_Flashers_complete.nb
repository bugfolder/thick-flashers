Cell[TextData[{
 "NReshapeTandev3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Tau], ",
 StyleBox["sv",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, uui",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D oriented developable surface specified by an oriented ruled \
parameterization that is a tangent developable with ",
 StyleBox["b",
  FontSlant->"Italic"],
 " as the EOR and returns a different oriented developable surface with the \
specified torsion along the directrix."
}], "Text",
 CellChangeTimes->{{3.798572847292226*^9, 3.798572899717365*^9}, {
   3.7985731966001863`*^9, 3.798573197766917*^9}, {3.798574876085689*^9, 
   3.798574885212594*^9}, {3.798624528951817*^9, 3.798624530092536*^9}, {
   3.799324637560071*^9, 3.799324655520765*^9}, {3.799332469887213*^9, 
   3.799332506695383*^9}, {3.799335590716183*^9, 3.799335626092291*^9}, 
   3.799344116522127*^9, {3.799349274678602*^9, 3.799349302028771*^9}, {
   3.799356932600845*^9, 3.799356937388291*^9}, {3.79939925138929*^9, 
   3.799399257811124*^9}, 3.800480819415649*^9, 
   3.800480863814281*^9},ExpressionUUID->"61df1df5-9a6d-4c20-a748-\
c78e2477516d"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the 3D directrix, as a pure function. It should be \
well-behaved.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] the 3D director, as a pure function. It should be \
well-behaved. It should be the tangent vector of b.\n\t\[Sigma] \[LongDash] \
the orientation, which should be \[PlusMinus]1.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter.\n\t\[Tau] \[LongDash] the desired torsion of the new directrix.\
\n\t",
 StyleBox["sv",
  FontSlant->"Italic"],
 " \[LongDash] the sign of the branch we\[CloseCurlyQuote]re on, which should \
be \[PlusMinus]1.\n\t",
 StyleBox["bbi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position of the new directrix.\n\t",
 StyleBox["ddi",
  FontSlant->"Italic"],
 " \[LongDash] the initial director of the new surface.\n\t",
 StyleBox["uui",
  FontSlant->"Italic"],
 " \[LongDash] the initial tangent vector of the new directrix.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the interpolation domain."
}], "Text",
 CellChangeTimes->{{3.798572971597745*^9, 3.798573067343102*^9}, {
   3.799324637570926*^9, 3.799324655529855*^9}, {3.799332511270781*^9, 
   3.799332544247019*^9}, {3.7993355394999647`*^9, 3.7993355691326942`*^9}, {
   3.7993493068368053`*^9, 3.79934935909297*^9}, {3.799349390933577*^9, 
