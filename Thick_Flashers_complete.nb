Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherSectorPanelIndices[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.934831648585423*^9, 
  3.934831693128293*^9}},ExpressionUUID->"b3393bd8-c3fc-41aa-950e-\
a39271c61005"],

Cell[TextData[{
 "ThickFlasherSectorPanelIndices[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 "] creates a list of the indices into panels of the panels that make up a \
single sector of the pattern."
}], "Text",
 CellChangeTimes->{{3.934831669371292*^9, 
  3.934831719927383*^9}},ExpressionUUID->"6e21668d-f77d-414c-8757-\
12f05e2bc73c"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TObj returned by MakeThickFlasher.\n\t",
 StyleBox["panels",
  FontSlant->"Italic"],
 " \[LongDash] the list of panels returned by MakeThickFlasherPanels.\n\t",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " \[LongDash] the list of panel information returned by \
MakeThickFlasherPanels."
}], "Text",
 CellChangeTimes->{{3.934831726273048*^9, 
  3.9348317787003803`*^9}},ExpressionUUID->"fe1a0937-d6b5-41a8-880a-\
b33bd1edfa51"],

Cell["\<\
Returns: a list of the indices of the panels for a single sector of the \
flasher. This is useful if you want to print multiple copies of a single \
sector (along with a single copy of the central polygon), rather than \
printing the entire pattern in one job.\
\>", "Text",
 CellChangeTimes->{{3.93483178081668*^9, 3.93483182973341*^9}, {
  3.9348332677102203`*^9, 
  3.9348332802201777`*^9}},ExpressionUUID->"67756619-369f-4d0c-9276-\
5ecc7f90e6be"],

Cell[TextData[{
 "We can make use of the fact that the first sector faces are the first set \
of faces in ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.9348319208404007`*^9, 
  3.934831966340335*^9}},ExpressionUUID->"f888fb5d-33e7-427b-b7dd-\
ab795ad65b9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherSectorPanelIndices", "[", 
   RowBox[{"tobj_", ",", "panels_", ",", "panelinfo_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "faces", ",", "nf", ",", "sfaces", ",", "pvi", ",", "spi"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"FlasherM", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "The", " ", "number", " ", "of", " ", "faces", " ", "in", " ", "the", " ",
        "sector"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nf", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Length", "[", "faces", "]"}], "-", "1"}], ")"}], "/", 
       "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfaces", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"faces", ",", "nf"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "the", " ", "EZTS", " ", "vertices", " ", "by", " ", 
       "index", " ", "of", " ", "each", " ", "panel", " ", "from", " ", 
       RowBox[{"panelinfo", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pvi", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", " ", 
          RowBox[{
           RowBox[{"tobj", "[", "Edges", "]"}], "\[LeftDoubleBracket]", 
           RowBox[{"First", "/@", "#"}], "\[RightDoubleBracket]"}], "]"}], 
         "]"}], "&"}], "/@", "panelinfo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Any", " ", "panel", " ", "that", " ", "shares", " ", "3", " ", "or", " ",
         "more", " ", "vertices", " ", "with", " ", "a", " ", "first"}], "-", 
       
       RowBox[{"sector", " ", "face", " ", "is", " ", "a", " ", "first"}], "-", 
       RowBox[{"sector", " ", 
        RowBox[{"panel", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"spi", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"Intersection", "[", 
               RowBox[{
                RowBox[{
                "pvi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
                 ",", 
                RowBox[{
                "sfaces", "\[LeftDoubleBracket]", "j", 
                 "\[RightDoubleBracket]"}]}], "]"}], "]"}], ">=", "3"}], ",", 
            
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"spi", ",", "i"}], "]"}], ";", 
             RowBox[{"Break", "[", "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "sfaces", "]"}]}], "}"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "panels", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "spi"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.934831851849695*^9, 3.934831871857977*^9}, {
  3.9348319747537937`*^9, 3.9348320037811127`*^9}, {3.934832034246838*^9, 
  3.934832081297186*^9}, {3.934832143228283*^9, 3.934832212726882*^9}, {
  3.934832321429682*^9, 3.9348324307166853`*^9}, {3.934832704308392*^9, 
  3.934832958482682*^9}, {3.934833106539732*^9, 3.93483312237577*^9}},
 CellLabel->
  "In[4529]:=",ExpressionUUID->"fe1c57ab-c7c1-45b6-b1c0-7027cbabb9e7"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.934831891543964*^9, 
  3.934831892468995*^9}},ExpressionUUID->"90073dd3-a4f8-490c-a5cc-\
f611b720de55"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.2"}], ",", "tobj", ",", "tobjdp", ",", "panels", ",",
      "panelinfo", ",", "spi"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
     RowBox[{"MakeThickFlasherPanels", "[", 
      RowBox[{"tobj", ",", "\[IndentingNewLine]", 
       RowBox[{"PanelClearance", "->", "0.05"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FlasherDeployed", "->", "True"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"FlasherPanelSplit", "->", "Automatic"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"spi", "=", 
     RowBox[{"ThickFlasherSectorPanelIndices", "[", 
      RowBox[{"tobj", ",", "panels", ",", "panelinfo"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<First sector panels = \>\"", ",", "spi"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"panels", ",", 
        RowBox[{"ThickFlasherPanelNumbers", "[", "panels", "]"}]}], "}"}], ",", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "\[Infinity]"}], "}"}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.911902955986402*^9, 3.911902958738657*^9}, {
