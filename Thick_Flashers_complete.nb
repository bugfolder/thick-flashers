3769d45f62ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationXMatrix3D", "[", "\[Phi]_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
      RowBox[{"-", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.439844537754984*^9, 3.439844537988073*^9}, {
   3.439844582236408*^9, 3.4398446508864393`*^9}, {3.4398448580081863`*^9, 
