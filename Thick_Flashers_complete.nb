Cell[CellGroupData[{

Cell["Self-crossing vertex", "Subsubsection",
 CellChangeTimes->{{3.636737721894678*^9, 
  3.636737724215013*^9}},ExpressionUUID->"98ded967-79a4-47ef-a2b2-\
1d389b7b9d24"],

Cell["\<\
A self-crossing vertex, beyond the binding angle. We can calculate all of the \
dihedral angles, but since we\[CloseCurlyQuote]re beyond the binding angle, \
we\[CloseCurlyQuote]ll be unable to construct the full vertex.\
\>", "Text",
 CellChangeTimes->{{3.617432465051469*^9, 3.617432475902557*^9}, {
  3.617439084183007*^9, 3.6174390967794*^9}, {3.61743969543424*^9, 
  3.61743972415003*^9}},ExpressionUUID->"e24d8319-ecd4-4307-8884-\
0de36a36613d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sa", ",", "\[Gamma]", ",", "n", ",", "w", ",", "ma", ",", "ba", ",", 
      "da", ",", "vtobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"100.", "\[Degree]"}], ",", 
        RowBox[{"100.", "\[Degree]"}], ",", 
        RowBox[{"60.", "\[Degree]"}], ",", 
        RowBox[{"100.", "\[Degree]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"120", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ma", "=", 
      RowBox[{"MaximumDihedralAngles", "[", "sa", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<maximum angles/\[Degree] = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"ma", "/", "\[Degree]"}], "//", "N"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ba", "=", 
      RowBox[{"MinorFirstBindingDihedralAngles", "[", "sa", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<binding angles/\[Degree] = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"ba", "/", "\[Degree]"}], "//", "N"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"da", "=", 
      RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "[", 
       RowBox[{"sa", ",", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<dihedral angles/\[Degree] = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"da", "/", "\[Degree]"}], "//", "N"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vtobj", "=", 
      RowBox[{"MakeTDegree4Vertex3DFromSectorsAndDihedrals", "[", 
       RowBox[{"sa", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex3DCreasePatternGraphics", "[", "vtobj", "]"}], ",", 
         RowBox[{"Vertex3DFoldedFormGraphics3D", "[", "vtobj", "]"}]}], "}"}],
        "/.", 
       RowBox[{"Vertex3DStyle", "[", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowErrorExample"}]], "Input",
 CellChangeTimes->{{3.617432522655912*^9, 3.617432662402484*^9}, 
   3.61743441774417*^9, 3.617436348687064*^9, {3.617439726134233*^9, 
   3.617439729460207*^9}},
 CellLabel->
  "In[2359]:=",ExpressionUUID->"1e3c94dc-ae67-4eba-a995-9cff27ba6eab"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["2D folded shapes", "Section",
 CellChangeTimes->{{3.701553192598117*^9, 3.701553193868428*^9}, {
  3.703969026988364*^9, 
  3.703969027746264*^9}},ExpressionUUID->"a78c36dd-8641-4ce4-acc7-\
e384a81e0c31"],

Cell[CellGroupData[{

Cell["Flat folded strips", "Subsection",
 CellChangeTimes->{{3.701552928340054*^9, 3.701552930410359*^9}, {
  3.701553024267581*^9, 
  3.701553024930876*^9}},ExpressionUUID->"07a5480a-a161-4e2d-986c-\
082e0dc75eeb"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.701553107204673*^9, 
  3.701553107923699*^9}},ExpressionUUID->"aee2bba9-69c2-4eb9-9bf2-\
bf3da7da2df6"],

Cell["\<\
Flat-folded strips are, by themselves, not terribly interesting, but we use \
them to construct rotationally stretched pleated patterns.\
\>", "Text",
 CellChangeTimes->{{3.701553109797205*^9, 
  3.701553155644449*^9}},ExpressionUUID->"f52f14f9-c6fe-41f0-9b7f-\
86b3f7affb23"]
}, Closed]],

Cell[CellGroupData[{

Cell["BottomVertices, TopVertices", "Subsubsection",
 CellChangeTimes->{{3.701622110403596*^9, 3.701622111818758*^9}, {
  3.701648149178844*^9, 3.701648153434835*^9}, {3.701648221005889*^9, 
  3.70164822424351*^9}},ExpressionUUID->"9ac9d963-b35c-4de1-959e-\
d785304dd911"],

Cell["\<\
TopVertices and BottomVertices are properties of certain crease patterns \
where there are well-defined top and bottom rows of vertices in the pattern. \
It\[CloseCurlyQuote]s useful to know what those rows are when we use smaller \
patterns as building blocks for larger ones.\
\>", "Text",
 CellChangeTimes->{{3.701622114299747*^9, 3.701622233868767*^9}, {
  3.701648156427031*^9, 
  3.701648172811213*^9}},ExpressionUUID->"264b1d05-b6e0-4373-ab5b-\
69aa50484008"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BottomVertices", "::", "usage"}], 
   "=", "\"\<TopVertices is a property of some TGraphs that identifies the \
bottom row of vertices in the pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701622235299992*^9, 3.701622266252268*^9}, {
  3.701648186303467*^9, 3.70164822999895*^9}},
 CellLabel->
  "In[2360]:=",ExpressionUUID->"66f6b6b7-ba2f-41ea-aa41-3a80afddda72"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TopVertices", "::", "usage"}], 
   "=", "\"\<TopVertices is a property of some TGraphs that identifies the \
top row of vertices in the pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701622235299992*^9, 3.701622266252268*^9}, {
  3.701648186303467*^9, 3.701648204363739*^9}},
 CellLabel->
  "In[2361]:=",ExpressionUUID->"f9a024fd-4d20-4173-8be1-2217926f0ddc"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeFlatFoldedStrip[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", {",
 StyleBox["w, ",
  FontSlant->"Italic"],
 "\[Phi]}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) EdgeTypes, SamePtTolerance\nMakeFlatFoldedStrip[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) EdgeTypes, SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.70164383146214*^9, 3.701643882829502*^9}, {
  3.701645157362111*^9, 3.701645157696608*^9}, {3.701646295859964*^9, 
  3.70164629886674*^9}, {3.701715782911086*^9, 3.701715798525979*^9}, {
  3.701717122306981*^9, 
  3.701717123827347*^9}},ExpressionUUID->"b3418b6c-336f-40b8-ace6-\
bfd5c5b5cdad"],

Cell[TextData[{
 "MakeFlatFoldedStrip[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", {",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Phi]}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a TGraph2D+TAssigned that represents a flat-folded rectangular, \
triangular, or trapezoidal strip that follows a specified path in the x-y \
plane."
}], "Text",
 CellChangeTimes->{{3.701643887661404*^9, 3.701643938165881*^9}, {
  3.701648237621085*^9, 3.701648238099622*^9}, {3.7017159184069977`*^9, 
  3.70171592493563*^9}, {3.701717134059268*^9, 
  3.701717141866329*^9}},ExpressionUUID->"3ba66c76-77cd-4c54-a110-\
ed7e1367528a"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["pts",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that gives the path to be followed.\n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " \[LongDash] the initial width of the strip. Use 0 for a triangular strip \
and make \[Phi] > 0.\n\t\[Phi] \[LongDash] the spreading angle. Use \
0\[Degree] for a rectangular strip and make w > 0."
}], "Text",
 CellChangeTimes->{{3.701643943285944*^9, 3.7016439672542963`*^9}, 
   3.701645161979484*^9, {3.701715808830181*^9, 
   3.701715855623139*^9}},ExpressionUUID->"4ae6b635-7edc-412e-b59a-\
79d1c32202d2"],

Cell[TextData[{
 "Option:\n\tEdgeTypes \[Rule] Automatic | ",
 StyleBox["types",
  FontSlant->"Italic"],
 ", gives the crease assignment for all of the folds. Automatic alternates V \
and M."
}], "Text",
 CellChangeTimes->{{3.701643971054037*^9, 
  3.701644022382926*^9}},ExpressionUUID->"615e855a-60b5-41d0-9292-\
d741aa1ebd9e"],

Cell["\<\
Returns: a TGraph2D+TAssigned, adding the properties BottomVertices and \
TopVertices. The crease pattern has its left edge at the origin and is \
centered on the x-axis.\
\>", "Text",
 CellChangeTimes->{{3.701644030830473*^9, 3.701644037670903*^9}, {
  3.701648242603262*^9, 3.701648255596017*^9}, {3.7017170185688*^9, 
  3.701717038233106*^9}},ExpressionUUID->"7e2f7189-b98b-462f-9a68-\
5ef480dffb31"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeFlatFoldedStrip", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"EdgeTypes", "\[Rule]", "Automatic"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.701644091129628*^9, 3.70164410527914*^9}},
 CellLabel->
  "In[2362]:=",ExpressionUUID->"923bbfe2-65bc-4f31-ab9f-d5178440dae5"],

Cell["\<\
If the fold angles are too shallow relative to the point spacing, then the \
vertices along top and bottom of the strip are not properly ordered and an \
error will be generated. The error produces an image of the CP, so you can \
see where the crossing is and take appropriate action.\
\>", "Text",
 CellChangeTimes->{{3.701894990303741*^9, 
  3.701895044581158*^9}},ExpressionUUID->"5ba78665-6e0f-4d05-a622-\
efe8c0f5a995"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeFlatFoldedStrip", "::", "badbot"}], 
   "=", "\"\<Bottom vertex positions `1` must be nondecreasing.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.701557492330772*^9, 3.701557569210792*^9}, 
   3.701646278003871*^9},
 CellLabel->
  "In[2363]:=",ExpressionUUID->"31de265f-b095-47d3-ae99-77f7e810d024"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeFlatFoldedStrip", "::", "badtop"}], 
   "=", "\"\<Top vertex positions `1` must be nondecreasing.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.701557492330772*^9, 3.701557584098299*^9}, 
   3.701646279378039*^9},
 CellLabel->
  "In[2364]:=",ExpressionUUID->"43147a13-2597-4900-8172-e02628d11a82"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeFlatFoldedStrip", "::", "badtyp"}], 
   "=", "\"\<EdgeType list `1` must have exactly 2 fewer entries than the \
number of points `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701557492330772*^9, 3.701557584098299*^9}, 
   3.701646279378039*^9, {3.7016469012096767`*^9, 3.701646940704191*^9}},
 CellLabel->
  "In[2365]:=",ExpressionUUID->"4710de4a-de1f-4ae6-983f-f3edba74290e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFlatFoldedStrip", "[", 
   RowBox[{
    StyleBox["pts_List",
     FontSlant->"Italic"], ",", 
    RowBox[{"{", 
     RowBox[{"w_", ",", "\[Phi]_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "et", ",", "tol", ",", "dlist", ",", "blist", ",", "alist", ",", "xctr", 
      ",", "vbot", ",", "vtop", ",", "errg", ",", "verts", ",", "edges", ",", 
      "types", ",", "addv", ",", "ibot", ",", "itop", ",", "tlist", ",", 
      "tobj", ",", "verts2d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"et", "=", 
      RowBox[{
       RowBox[{"EdgeTypes", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeFlatFoldedStrip", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"SamePtTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SamePtQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"distances", " ", "between", " ", "points"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dlist", "=", 
      RowBox[{"Mag", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Drop", "[", 
          StyleBox[
           RowBox[{"pts", ",", "1"}],
           FontSlant->"Italic"], 
          StyleBox["]",
           FontSlant->"Italic"]}], 
         StyleBox["-",
          FontSlant->"Italic"], 
         RowBox[{"Drop", "[", 
          RowBox[{"pts", ",", 
           RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "bend", " ", "angles", " ", "at", " ", "interior", " ", "points"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"blist", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationAngle", "[", 
          RowBox[{
           RowBox[{"#2", "-", "#1"}], ",", 
           RowBox[{"#3", "-", "#2"}]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Drop", "[", 
           RowBox[{"pts", ",", 
            RowBox[{"-", "2"}]}], "]"}], ",", 
          RowBox[{"Drop", "[", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"pts", ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", "1"}], "]"}], ",", 
          RowBox[{"Drop", "[", 
           RowBox[{"pts", ",", "2"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "\[Alpha]1", " ", "sector", " ", "angles", " ", "at", " ", "each", " ", 
       "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"alist", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"90", "\[Degree]"}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"b", "=", 
              RowBox[{
              "blist", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", "i", "]"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"b", "\[GreaterEqual]", "0"}], ",", 
                RowBox[{"b", "/", "2"}], ",", 
                RowBox[{"\[Pi]", "+", 
                 RowBox[{"b", "/", "2"}]}]}], "]"}], ",", 
              RowBox[{"\[Pi]", "-", 
               RowBox[{"b", "/", "2"}]}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "blist", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"90", "\[Degree]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"vertices", " ", "of", " ", "cp"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"xctr", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", "dlist"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vbot", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LineInt2D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"-", "w"}], "/", "2"}]}], "}"}], ",", 
           RowBox[{"U", "[", 
            RowBox[{
             RowBox[{"-", "\[Phi]"}], "/", "2"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"#1", ",", "0"}], "}"}], ",", 
           RowBox[{"U", "[", "#2", "]"}]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"xctr", ",", "alist"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vtop", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LineInt2D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"w", "/", "2"}]}], "}"}], ",", 
           RowBox[{"U", "[", 
            RowBox[{"\[Phi]", "/", "2"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"#1", ",", "0"}], "}"}], ",", 
           RowBox[{"U", "[", "#2", "]"}]}], "]"}], "&"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"xctr", ",", "alist"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"errg", ":=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Line", "[", "vbot", "]"}], ",", 
              RowBox[{"Line", "[", "vtop", "]"}], ",", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Line", "[", 
                  RowBox[{"{", 
                   RowBox[{"#1", ",", "#2"}], "}"}], "]"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"vbot", ",", "vtop"}], "}"}]}], "]"}]}], "}"}], ",", 
            "Red"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Point", "/@", "vbot"}], ",", 
              RowBox[{"Point", "/@", "vtop"}]}], "}"}], ",", 
            RowBox[{"Darker", "[", "Red", "]"}], ",", 
            RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{"#", ",", "0"}], "}"}], "]"}], "&"}], "/@", "xctr"}], 
            ",", "Black", ",", 
            RowBox[{"PointSize", "[", ".01", "]"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Or", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "<", 
            RowBox[{"-", "tol"}]}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"First", "/@", "vbot"}], ",", "1"}], "]"}], "-", 
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"First", "/@", "vbot"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "errg", "]"}], ";", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeFlatFoldedStrip", "::", "badbot"}], ",", 
          RowBox[{"First", "/@", "vbot"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Or", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "<", 
            RowBox[{"-", "tol"}]}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"First", "/@", "vtop"}], ",", "1"}], "]"}], "-", 
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"First", "/@", "vtop"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "errg", "]"}], ";", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeFlatFoldedStrip", "::", "badtop"}], ",", 
          RowBox[{"First", "/@", "vtop"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"edges", "=", 
       RowBox[{"types", "=", 
        RowBox[{"{", "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "addv", " ", "returns", " ", "the", " ", "index", " ", "of", " ", "a", 
        " ", "vertex", " ", "in", " ", "verts"}], ",", " ", 
       RowBox[{"adding", " ", "if", " ", "needed"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"addv", "[", "p_", "]"}], ":=", 
      RowBox[{"Catch", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"SamePtQ", "[", 
             RowBox[{
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               ",", "p", ",", "opts"}], "]"}], ",", 
            RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"verts", ",", "p"}], "]"}], ";", 
        RowBox[{"Throw", "[", 
         RowBox[{"Length", "[", "verts", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ibot", "=", 
      RowBox[{"addv", "/@", "vbot"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"indices", " ", "of", " ", "bottom", " ", "vertices"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"itop", "=", 
      RowBox[{"addv", "/@", "vtop"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"indices", " ", "of", " ", "top", " ", "vertices"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"build", " ", "edge", " ", "and", " ", "types", " ", "lists"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tlist", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"et", "===", "Automatic"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OddQ", "[", "i", "]"}], ",", "V", ",", "M"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "blist", "]"}]}], "}"}]}], "]"}], ",", 
        "et"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "tlist", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "blist", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeFlatFoldedStrip", "::", "badtyp"}], ",", "tlist", ",", 
          "pts"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"bottom", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "ibot", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[NotEqual]", 
          RowBox[{"ibot", "\[LeftDoubleBracket]", 
           RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"edges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "ibot", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              ",", 
              RowBox[{"ibot", "\[LeftDoubleBracket]", 
               RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
           "]"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"types", ",", "B"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{
          RowBox[{"Length", "[", "ibot", "]"}], "-", "1"}]}], "}"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"cross", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "ibot", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[NotEqual]", 
          RowBox[{
          "itop", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"edges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "ibot", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              ",", 
              RowBox[{
              "itop", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"types", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"i", "\[Equal]", "1"}], "||", 
               RowBox[{"i", "\[Equal]", 
                RowBox[{"Length", "[", "ibot", "]"}]}]}], ",", "B", ",", 
              RowBox[{"tlist", "\[LeftDoubleBracket]", 
               RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "ibot", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"top", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "itop", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[NotEqual]", 
          RowBox[{"itop", "\[LeftDoubleBracket]", 
           RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"edges", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "itop", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              ",", 
              RowBox[{"itop", "\[LeftDoubleBracket]", 
               RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
           "]"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"types", ",", "B"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{
          RowBox[{"Length", "[", "itop", "]"}], "-", "1"}]}], "}"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTPlaneGraphAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", 
        RowBox[{"{", "}"}], ",", "types"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"TypeToFlatFoldAngle", "[", "types", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "translate", " ", "folded", " ", "form", " ", "to", " ", "align", " ", 
       "with", " ", "original", " ", "path"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{"tobj", "[", "Vertices2D", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"verts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
         RowBox[{
          RowBox[{"RotationMatrix2D", "[", 
           RowBox[{"AbsoluteAngle", "[", 
            RowBox[{
             RowBox[{
             "pts", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
             RowBox[{
             "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
            "]"}], "]"}], ".", "#"}]}], "&"}], "/@", "verts2d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "//", 
       RowBox[{"ReplaceProperty", "[", 
        RowBox[{"Vertices2D", "\[Rule]", "verts2d"}], "]"}]}], "//", 
      RowBox[{"AddProperties", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"BottomVertices", "\[Rule]", 
          RowBox[{"Union", "[", "ibot", "]"}]}], ",", 
         RowBox[{"TopVertices", "\[Rule]", 
          RowBox[{"Union", "[", "itop", "]"}]}]}], "}"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
