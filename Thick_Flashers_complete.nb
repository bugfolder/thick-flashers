Cell[CellGroupData[{

Cell[TextData[{
 "DiscreteEllipseEquiangular[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi], \[Theta]] [FIX EXAMPLE]\nDiscreteEllipseEquiangular[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi]]\nDiscreteEllipseEquiangular[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.6712472301761713`*^9, 3.671247308747309*^9}, {
  3.6712475564127*^9, 3.671247557397189*^9}, {3.6712486962561603`*^9, 
  3.671248697461388*^9}, {3.671249880744821*^9, 3.671249886735858*^9}, {
  3.671290605565471*^9, 3.671290605658852*^9}, {3.673174219827631*^9, 
  3.67317422100529*^9}, {3.701379121377181*^9, 3.70137912668853*^9}, {
  3.7013822848053637`*^9, 
  3.701382285013188*^9}},ExpressionUUID->"015ffc7f-4841-4772-8414-\
1453aae4dd72"],

Cell[TextData[{
 "DiscreteEllipseEquiangular[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi], \[Theta]] returns a polygon with vertices on an ellipse spaced \
so that all of the corner angles are the same. Arguments are:\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the number of points.\n\t{",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "} \[LongDash] the semimajor and semiminor axes, respectively.\n\t\[Phi] \
\[LongDash] the angle of the first point relative to the semimajor axis.\n\t\
\[Theta] \[LongDash] the angle by which the ellipse is rotated about the \
origiin."
}], "Text",
 CellChangeTimes->{{3.6712473556680117`*^9, 3.671247549843657*^9}, 
   3.671247988936877*^9, {3.671248729619396*^9, 3.671248744768272*^9}, 
   3.671290605714727*^9, {3.6712906431239758`*^9, 3.671290643991749*^9}, {
   3.673174221512237*^9, 
   3.673174251792357*^9}},ExpressionUUID->"49a81672-e81c-43af-979d-\
740754a58bfc"],

Cell["\<\
While DiscreteEllipseEquiaxial can return analytic formulas for the vertices, \
DiscreteEllipseEquiangular returns numeric values, and so all of the \
arguments must evaluate to numeric values.\
\>", "Text",
 CellChangeTimes->{{3.671249920549181*^9, 3.671249975178143*^9}, {
   3.6712906057707148`*^9, 3.671290622462727*^9}, 3.673174061625328*^9, 
   3.673174222307238*^9},ExpressionUUID->"7f1ee780-a544-4c00-abfa-\
4bb3a1068a02"],

Cell["\<\
Note: FindRoot doesn\[CloseCurlyQuote]t always find a solution. If you hear a \
beep and see \[OpenCurlyDoubleQuote]Failed to \
converge\[CloseCurlyDoubleQuote] message, then we\[CloseCurlyQuote]re \
probably not even close.\
\>", "Text",
 CellChangeTimes->{{3.673176973787667*^9, 
  3.673177001359878*^9}},ExpressionUUID->"287cc4bc-0964-46a5-bad0-\
ae7e7c229865"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiscreteEllipseEquiangular", "[", 
   RowBox[{"m_", ",", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_"}], "}"}], ",", 
    RowBox[{"\[Phi]_", ":", "0"}], ",", 
    RowBox[{"\[Theta]_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pts", ",", "\[Psi]", ",", "vars", ",", "vars0", ",", "v1", ",", "v2", ",",
       "r90", ",", "err", ",", "eqns", ",", "cd", ",", "soln", ",", "rm"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"Cos", "[", 
            RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], 
           SqrtBox[
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["a", "2"]], "+", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Sin", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["b", "2"]]}]]], ",", 
          FractionBox[
           RowBox[{"Sin", "[", 
            RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], 
           SqrtBox[
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["a", "2"]], "+", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Sin", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["b", "2"]]}]]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "0", "]"}], "=", "\[Phi]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "j", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
      "=", "cd"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars0", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"\[Psi]", ",", 
        RowBox[{"{", 
         RowBox[{"\[Psi]", ",", "\[Phi]", ",", 
          RowBox[{"\[Phi]", "+", 
           RowBox[{"2", "\[Pi]"}], "-", 
           RowBox[{"2", 
            RowBox[{"\[Pi]", "/", "m"}]}]}], ",", 
          RowBox[{"2", 
           RowBox[{"\[Pi]", "/", "m"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
       "=", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", 
        RowBox[{"\[Pi]", "/", "m"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r90", "=", 
      RowBox[{"RotationMatrix2D", "[", 
       RowBox[{"\[Pi]", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"err", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"v1", "=", 
          RowBox[{"r90", ".", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{
             RowBox[{
             "pts", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "-", 
             RowBox[{"pts", "\[LeftDoubleBracket]", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"j", "-", "1"}], ",", "m", ",", "1"}], "]"}], 
              "\[RightDoubleBracket]"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"v2", "=", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{
            RowBox[{"pts", "\[LeftDoubleBracket]", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{
            "pts", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"v1", ".", "v2"}], "-", "cd"}]}], " ", ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "m"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindRoot", "@@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "err"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"vars", ",", "vars0"}], "}"}], "]"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PrintThis", "[", 
       RowBox[{"Chop", "[", 
        RowBox[{"err", "/.", "soln"}], "]"}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rm", "=", 
      RowBox[{"RotationMatrix2D", "[", "\[Theta]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rm", ".", "#"}], "&"}], "/@", 
      RowBox[{"(", 
       RowBox[{"pts", "/.", "soln"}], ")"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.671247560484779*^9, 3.671247579586459*^9}, {
   3.671247675128248*^9, 3.671247765241412*^9}, {3.671248301356289*^9, 
