Cell[CellGroupData[{

Cell[TextData[{
 "SegmentsIntersectQ[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ",",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ",",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) IncludeCollinear, IntersectionTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.6288562977912683`*^9, 3.628856310551771*^9}, {
   3.629034214956491*^9, 3.6290342488638783`*^9}, 3.629035700403755*^9, {
   3.676466422965389*^9, 
   3.676466426765106*^9}},ExpressionUUID->"69efb30e-4154-4fad-bd74-\
8ee2f430bb94"],

Cell[TextData[{
 "SegmentsIntersectQ[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ",",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ",",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}] returns True if the line segment {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ",",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} intersects the line segment {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ",",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, including at either endpoint. Options are:\n\tIncludeCollinear \[Rule] \
True | False, if True, we return True for overlapping collinear lines.\n\t\
IntersectionTolerance \[Rule] ",
 StyleBox["itol",
  FontSlant->"Italic"],
 ", specifies a tolerance to use at the endpoints."
}], "Text",
 CellChangeTimes->{{3.628856324267091*^9, 3.628856357323058*^9}, {
  3.629035330573463*^9, 3.629035364834234*^9}, {3.676466465066216*^9, 
  3.67646646828195*^9}, {3.676466508138079*^9, 
  3.676466521782796*^9}},ExpressionUUID->"3d60f8ae-ac5e-40bb-8ce1-\
c0cbe79934f1"],

Cell["\<\
There is some overlap of functionality between SegmentsIntersectQ and \
SegmentSegmentMedialInfo (added in Tessellatica 2.7); both can be used to \
determine whether two segments intersect. This function allows us to ignore \
collinear lines (used in analyzing the overlap graph when calculating visible \
folded forms).\
\>", "Text",
 CellChangeTimes->{{3.676464340641081*^9, 3.676464359072803*^9}, {
   3.676464414213087*^9, 3.676464433610561*^9}, {3.6764645638502903`*^9, 
   3.676464660676058*^9}, 
   3.67646473931181*^9},ExpressionUUID->"db104b5e-74be-494a-8393-\
e1ea36cb274a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IncludeCollinear", "::", "usage"}], 
   "=", "\"\<IncludeCollinear is an options to SegmentsIntersectQ that \
specifies whether overlapping collinear segments should be considered to \
overlap.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629035394748032*^9, 3.629035415806147*^9}, {
  3.629035450645122*^9, 3.629035462639123*^9}},
 CellLabel->
  "In[504]:=",ExpressionUUID->"119bf5ff-4081-4633-a657-7b91b5075b5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SegmentsIntersectQ", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"IncludeCollinear", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"IntersectionTolerance", "\[Rule]", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.629035366753493*^9, 3.62903538872794*^9}, 
   3.6290354656198177`*^9, {3.676466451227922*^9, 3.6764664580511017`*^9}},
 CellLabel->
  "In[505]:=",ExpressionUUID->"31efe6c1-68ef-4bb7-839c-cd66d0fd08d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SegmentsIntersectQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1_",
       FontSlant->"Italic"], ",", 
      StyleBox["p2_",
       FontSlant->"Italic"]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1_",
       FontSlant->"Italic"], ",", 
      StyleBox["q2_",
       FontSlant->"Italic"]}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ic", ",", "itol", ",", "ssmi"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ic", "=", 
      RowBox[{
       RowBox[{"IncludeCollinear", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SegmentsIntersectQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"itol", "=", 
      RowBox[{
       RowBox[{"IntersectionTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SegmentsIntersectQ", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "First", " ", "check", " ", "bounding", " ", "boxes", " ", "to", " ", 
       "eliminate", " ", "the", " ", "easy", " ", "cases"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"BoundingBoxesIntersectQ", "[", 
         RowBox[{
          RowBox[{"BoundingBox", "[", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", 
          RowBox[{"BoundingBox", "[", 
           RowBox[{"{", 
            RowBox[{"q1", ",", "q2"}], "}"}], "]"}], ",", "opts"}], "]"}]}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"And", " ", "if", " ", 
        RowBox[{"we", "'"}], "re", " ", "not", " ", "including", " ", 
        "collinear", " ", "and", " ", "these", " ", "are", " ", "collinear"}],
        ",", " ", 
       RowBox[{
        RowBox[{"that", "'"}], "s", " ", "an", " ", "easy", " ", 
        RowBox[{"answer", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", "ic"}], "&&", 
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{"Det", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"p2", "-", "p1"}], ",", 
             RowBox[{"q1", "-", "q2"}]}], "}"}], "]"}], "]"}], "\[Equal]", 
         "0"}], "&&", 
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", 
              RowBox[{"NormalizeReal", "[", 
               RowBox[{"p2", "-", "p1"}], "]"}]}], ")"}], ".", 
            RowBox[{"(", 
             RowBox[{"q1", "-", "p1"}], ")"}]}], "]"}], "]"}], "\[LessEqual]",
          "itol"}]}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"All", " ", "other", " ", "cases"}], ",", " ", 
       RowBox[{
       "find", " ", "the", " ", "medial", " ", "point", " ", "between", " ", 
        "the", " ", "segments", " ", "and", " ", "use", " ", "its", " ", 
        "distance", " ", "from", " ", "both"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ssmi", "=", 
      RowBox[{"SegmentSegmentMedialInfo", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{"ssmi", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
        "]"}], "\[LessEqual]", 
      RowBox[{"itol", "/", "2"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.6288563673767853`*^9, 3.6288563816311607`*^9}, {
   3.628856563064125*^9, 3.628856563880185*^9}, {3.628856701131357*^9, 
   3.628856742956827*^9}, {3.628856784954216*^9, 3.62885691666682*^9}, {
   3.628856961649525*^9, 3.628856961892031*^9}, {3.62885706533902*^9, 
   3.628857076106572*^9}, {3.62885713874221*^9, 3.628857282288584*^9}, {
   3.62885731666796*^9, 3.6288573456487017`*^9}, {3.628857387235123*^9, 
   3.628857670556899*^9}, {3.628857828181715*^9, 3.628857852587356*^9}, 
   3.628857899310737*^9, 3.62885794887786*^9, {3.628858291445407*^9, 
   3.628858297906313*^9}, {3.628858333108371*^9, 3.628858357829964*^9}, {
   3.628858440060358*^9, 3.6288585149050922`*^9}, {3.628861289479198*^9, 
   3.62886129874161*^9}, {3.628861347281555*^9, 3.628861378930812*^9}, 
   3.628861413573045*^9, {3.628865178789384*^9, 3.6288651814150333`*^9}, {
   3.628882279833735*^9, 3.62888243611429*^9}, {3.6290354714347754`*^9, 
   3.629035563315511*^9}, 3.629035601632782*^9, {3.676403485655768*^9, 
   3.67640348672602*^9}, {3.676466553344307*^9, 3.676466575290032*^9}, {
   3.676466610683806*^9, 3.676466675120507*^9}, {3.676466918840893*^9, 
   3.676466992219084*^9}, {3.676467045528001*^9, 3.676467333670624*^9}, {
   3.676467371789249*^9, 3.676467512521677*^9}, {3.67646754266462*^9, 
   3.676467605802217*^9}, {3.676467712416182*^9, 3.676467822220291*^9}, 
   3.701092751205943*^9},
 CellLabel->
  "In[506]:=",ExpressionUUID->"b76bbe96-8f76-4b8f-8d81-75a30930c793"],

