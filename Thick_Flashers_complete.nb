Cell[TextData[{
 "NNearConstantWidthScale[",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d, {u0, u1}, opts",
  FontSlant->"Italic"],
 "] takes a directrix and director and returns the scaling function that \
gives a near-constant-width ribbon when the directrix is scaled by that \
quantity."
}], "Text",
 CellChangeTimes->{{3.799570099925936*^9, 3.7995701205764008`*^9}, {
