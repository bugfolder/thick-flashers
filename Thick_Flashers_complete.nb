Cell[BoxData[
 RowBox[{
  RowBox[{"Vertex3DGaussianSphereGraphics3D", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sgs", ",", "smv", ",", "gsr", ",", "mm", ",", "aa", ",", "nn", ",", 
      "oo"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{
      "tobj", ",", "TVertex3D", ",", "Vertex3DGaussianSphereGraphics3D"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sgs", "=", 
      RowBox[{
       RowBox[{"ShowGaussianSphere", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DGaussianSphereGraphics3D", "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"smv", "=", 
      RowBox[{
       RowBox[{"ShowMidfoldVectors", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DGaussianSphereGraphics3D", "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"gsr", "=", 
      RowBox[{
       RowBox[{"GaussianSphereRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DGaussianSphereGraphics3D", "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mm", ",", "aa"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"MidfoldVectors", ",", "SectorVectors"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "mm", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"oo", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"sgs", ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Sphere", "[", 
              RowBox[{"oo", ",", "gsr"}], "]"}], ",", 
             RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"bounding", " ", "sphere"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Styled3DArc", ",", 
           RowBox[{"{", 
            RowBox[{"aa", ",", 
             RowBox[{"RotateRight", "[", "aa", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"LineStyle", "\[Rule]", "TraceLine"}], ",", 
               RowBox[{"{", "nn", "}"}]}], "]"}]}], "}"}], ",", "1"}], "]"}], 
         ",", 
         RowBox[{"(*", " ", "trace", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"smv", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Point", "[", "#", "]"}], ",", "MidfoldPoint"}], "]"}],
              "&"}], "/@", "mm"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"midarc", " ", "vectors"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"GaussianSphericalAngleLabels", "[", 
          RowBox[{"aa", ",", "opts"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "oo", "]"}], ",", "Black", ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"central", " ", "point"}], " ", "*)"}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.594806859794633*^9, 3.594806887936843*^9}, 
