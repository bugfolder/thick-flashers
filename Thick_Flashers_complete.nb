Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts1", ",", "edges1", ",", "verts3d1", ",", "types1", ",", "tobj1", ",",
       "verts2", ",", "edges2", ",", "verts3d2", ",", "types2", ",", "tobj2", 
      ",", "tglist", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", "verts1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types1", "=", 
      RowBox[{"{", 
       RowBox[{"B", ",", "B", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"MakeTGraph3DAssigned", "[", 
        RowBox[{"verts1", ",", "edges1", ",", 
         RowBox[{"{", "}"}], ",", "verts3d1", ",", 
         RowBox[{"{", "}"}], ",", "types1"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", "verts2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types2", "=", 
      RowBox[{"{", 
       RowBox[{"B", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{
       RowBox[{"MakeTGraph3DAssigned", "[", 
        RowBox[{"verts2", ",", "edges2", ",", 
         RowBox[{"{", "}"}], ",", "verts3d2", ",", 
         RowBox[{"{", "}"}], ",", "types2"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tglist", "=", 
      RowBox[{"{", 
       RowBox[{"tobj1", ",", "tobj2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MergeGraph3DAssigneds", "[", "tglist", "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"FoldAngleCreasePatternGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"FoldAngleCreasePatternGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"FoldAngleCreasePatternGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"FoldedFormGraphics3D", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"FoldedFormGraphics3D", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594663894798616*^9, 3.594664130749181*^9}, {
   3.594664326661407*^9, 3.5946643368284073`*^9}, {3.594664401025264*^9, 
