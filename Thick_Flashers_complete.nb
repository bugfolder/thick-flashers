        RowBox[{"\"\<~/Desktop/\>\"", "<>", "filename"}], ",", 
        RowBox[{"Graphics3D", "[", "joinedpanels", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "Hold"}], ";"}]], "Input",
