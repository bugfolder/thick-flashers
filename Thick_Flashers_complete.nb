Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StyledRuledPatch", "::", "badline"}], 
   "=", "\"\<`1` is an invalid format for the EndLineStyle option.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.689272201267986*^9, 3.689272246702151*^9}, 
   3.691407764494983*^9, {3.693959499918167*^9, 3.693959504197316*^9}},
 CellLabel->
  "In[1738]:=",ExpressionUUID->"17bd6829-d296-4a10-838b-d3f5c319c239"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledRuledPatch", "[", 
   RowBox[{
    RowBox[{"ss_Function", "|", "ss_InterpolatingFunction"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", " ", "u1_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", " ", "v1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cd", ",", "rd", ",", "rlo", ",", "rls", ",", "els", ",", "u", ",", "v", 
      ",", "ols", ",", "patch", ",", "dt", ",", "rlines", ",", "t", ",", 
      "vv0", ",", "vv1", ",", "rline"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rd", "=", 
      RowBox[{
       RowBox[{"RulingLineDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rlo", "=", 
      RowBox[{
       RowBox[{"RulingLineOffset", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rls", "=", 
      RowBox[{
       RowBox[{"RulingLineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"els", "=", 
      RowBox[{
       RowBox[{"EndLineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cd", "=", 
      RowBox[{
       RowBox[{"CurveDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledRuledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"construct", " ", "the", " ", "OutlineStyle", " ", "for", " ", 
       RowBox[{"StyledPatch", ".", " ", "No"}], " ", "outline", " ", "where", 
       " ", "ruling", " ", "lines", " ", "might", " ", 
       RowBox[{"be", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ols", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{
        RowBox[{"Length", "[", "els", "]"}], ",", "\[IndentingNewLine]", "0", 
        ",", 
        RowBox[{"{", 
         RowBox[{"els", ",", "None", ",", "els", ",", "None"}], "}"}], ",", 
        "\[IndentingNewLine]", "1", ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{
            "els", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], "===", "List"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"els", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", "None", 
            ",", 
            RowBox[{"els", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
            "None"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "els", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
             "None", ",", 
            RowBox[{
            "els", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
             "None"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", "2", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "els", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          "None", ",", 
          RowBox[{
          "els", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          "None"}], "}"}], ",", "\[IndentingNewLine]", "_", ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"StyledRuledPatch", "::", "badline"}], ",", "els"}], "]"}],
          ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"patch", "=", 
      RowBox[{"StyledPatch", "[", 
       RowBox[{"ss", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}], ",", 
        RowBox[{"PatchDivisions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"cd", ",", "1"}], "}"}]}], ",", 
        RowBox[{"OutlineStyle", "\[Rule]", "ols"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "the", " ", "table", " ", "of", " ", "ruling", " ", 
       "lines"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u1", "-", "u0"}], ")"}], "/", "rd"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rlines", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"u0", "+", 
           RowBox[{"i", " ", "dt"}], "+", 
           RowBox[{"If", "[", 
            RowBox[{"rlo", ",", 
             RowBox[{"dt", "/", "2"}], ",", "0"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"vv0", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "v0", "]"}], "===", "Function"}], "||", 
             RowBox[{
              RowBox[{"Head", "[", "v0", "]"}], "===", 
              "InterpolatingFunction"}]}], ",", 
            RowBox[{"v0", "[", "t", "]"}], ",", "v0"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"vv1", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "v1", "]"}], "===", "Function"}], "||", 
             RowBox[{
              RowBox[{"Head", "[", "v1", "]"}], "===", 
              "InterpolatingFunction"}]}], ",", 
            RowBox[{"v1", "[", "t", "]"}], ",", "v1"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rline", "=", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ss", "[", 
              RowBox[{"t", ",", "vv0"}], "]"}], ",", 
             RowBox[{"ss", "[", 
              RowBox[{"t", ",", "vv1"}], "]"}]}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"rls", "===", "None"}], ")"}]}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"rline", ",", "rls"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"If", "[", 
           RowBox[{"rlo", ",", 
            RowBox[{"rd", "-", "1"}], ",", "rd"}], "]"}]}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"patch", ",", "rlines"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.688080243043262*^9, 3.688080268127799*^9}, {
   3.688080717765473*^9, 3.688080721787158*^9}, {3.688080795896179*^9, 
