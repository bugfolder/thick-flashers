Cell[CellGroupData[{

Cell["Similarity transformations", "Subsection",
 CellChangeTimes->{{3.650033035401348*^9, 3.6500330406959677`*^9}, 
   3.708400929555351*^9},ExpressionUUID->"ffa753ad-6909-47a3-87bd-\
6d21e9f1ce7b"],

Cell[CellGroupData[{

Cell[TextData[{
 "SimilarityPair3D[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q3",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.649957810092751*^9, 3.6499578242016582`*^9}, {
  3.649957901700698*^9, 
  3.649957902220728*^9}},ExpressionUUID->"d50e9139-e1d2-4a49-b1bd-\
0eec41f4d731"],

Cell[TextData[{
 "SimilarityPair3D[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2, p3",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, q3",
  FontSlant->"Italic"],
 "}] returns a list {",
 StyleBox["mat, offset",
  FontSlant->"Italic"],
 "} that describes the handedness-preserving similarity transformation from \
the vertex trio {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2, p3",
  FontSlant->"Italic"],
 "} to the vertex trio {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2, q3",
  FontSlant->"Italic"],
 "}, via sequential matrix multiplication by ",
 StyleBox["mat",
  FontSlant->"Italic"],
 " followed by an addition of ",
 StyleBox["offset.",
  FontSlant->"Italic"],
 " The matrix is effectively the product of a scale and a rotation. The \
calculation assumes that the triangle formed by {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "} is, in fact, similar to {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q3",
  FontSlant->"Italic"],
 "}. if it\[CloseCurlyQuote]s not, no error is generated, but the result will \
(obviously) not be correct."
}], "Text",
 CellChangeTimes->{{3.627572047396574*^9, 3.62757216630088*^9}, 
   3.627572765625537*^9, {3.627572832600632*^9, 3.627572859231009*^9}, 
   3.627572902303552*^9, {3.627572980208088*^9, 3.6275730025175357`*^9}, {
   3.627573366497279*^9, 3.6275733879085636`*^9}, 3.627573427982486*^9, {
   3.6287823357448463`*^9, 3.628782357404974*^9}, 3.628786247150931*^9, {
   3.649955513406292*^9, 3.6499555188681393`*^9}, {3.649955626919237*^9, 
   3.649955630916848*^9}, {3.649955671275254*^9, 3.6499557935149403`*^9}, 
   3.6499559186164293`*^9, {3.649955949624859*^9, 3.649955949920956*^9}, {
   3.6499559949410887`*^9, 3.649956071249892*^9}, {3.649957093008771*^9, 
   3.6499570931923532`*^9}, {3.649957871841477*^9, 3.64995790626087*^9}, {
   3.649958154453204*^9, 3.64995822279266*^9}, {3.6502900379342413`*^9, 
   3.650290038629623*^9}, 
   3.722251511262394*^9},ExpressionUUID->"f4d82d5e-5fe1-49d1-971f-\
f2a2725355a9"],

Cell["This is used in JoinGraph3DAssigneds, see below.", "Text",
 CellChangeTimes->{{3.649957221728981*^9, 3.649957234391599*^9}, {
  3.649957838569211*^9, 3.6499578465362477`*^9}, {3.649958228928009*^9, 
  3.6499582375196466`*^9}},ExpressionUUID->"54113a81-6d48-4db4-bca5-\
a30454e94abf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SimilarityPair3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_", ",", "q3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rmp", ",", "rmq", ",", "rm"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rmp", "=", 
      RowBox[{"TriangleBasis3D", "[", 
       RowBox[{"p1", ",", "p2", ",", "p3"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rmq", "=", 
      RowBox[{"TriangleBasis3D", "[", 
       RowBox[{"q1", ",", "q2", ",", "q3"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rm", "=", 
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"Mag", "[", 
          RowBox[{"q2", "-", "q1"}], "]"}], 
         RowBox[{"Mag", "[", 
          RowBox[{"p2", "-", "p1"}], "]"}]], ")"}], 
       RowBox[{
        RowBox[{"Transpose", "[", "rmq", "]"}], ".", "rmp"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"rm", ",", 
       RowBox[{"q1", "-", 
        RowBox[{"rm", ".", "p1"}]}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.64995611200163*^9, 3.64995626723049*^9}, {
   3.6499563007419662`*^9, 3.6499563158542337`*^9}, {3.6499570738130693`*^9, 
   3.649957078834021*^9}, {3.649957627865454*^9, 3.649957630164797*^9}, 
   3.649957930814105*^9, {3.649958422455529*^9, 3.64995843035802*^9}, {
   3.6499586159783077`*^9, 3.6499586386473494`*^9}, {3.649959048830875*^9, 
   3.649959077445537*^9}, {3.6499591177561893`*^9, 3.649959171533928*^9}, {
   3.649959473214327*^9, 3.64995948800112*^9}, {3.649959707955581*^9, 
   3.649959726665109*^9}, {3.649960551251974*^9, 3.64996059608456*^9}, {
   3.649960685022968*^9, 3.649960729874591*^9}, {3.64996078625695*^9, 
   3.649960836475765*^9}, {3.651868966954636*^9, 3.651868980867487*^9}, 
   3.651869259398489*^9},
 CellLabel->
  "In[716]:=",ExpressionUUID->"0c146024-a34b-4a1c-a155-9d84b9e1b365"],

Cell["\<\
Example. Note the blue dot is at the computed location of q2 (so it agrees \
with the actual location).\
\>", "Text",
 CellChangeTimes->{{3.649958684332283*^9, 3.649958694061329*^9}, {
  3.649961035743753*^9, 
  3.649961050381167*^9}},ExpressionUUID->"6ca1458d-6a74-40ae-80a5-\
a61a248061ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "o", ",", "p1", ",", "p2", ",", "p3", ",", "q1", ",", "q2", ",", "q3", ",",
       "rm", ",", "offset"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"o", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{"1.5", ",", "0", ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p3", "=", 
      RowBox[{"{", 
       RowBox[{"1.5", ",", "2", ",", "0.5"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{".2", ",", ".3", ",", ".4"}], "}"}], "+", 
         RowBox[{"0.9", " ", 
          RowBox[{
           RowBox[{"RotationMatrix3Du", "[", 
            RowBox[{
             RowBox[{"\[Pi]", "/", "12"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}], ".", 
           RowBox[{"RotationMatrix3Du", "[", 
            RowBox[{
             RowBox[{"\[Pi]", "/", "8"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ".", 
           RowBox[{"RotationMatrix3Du", "[", 
            RowBox[{
             RowBox[{"\[Pi]", "/", "4"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "]"}], ".", "#"}]}]}],
         "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rm", ",", "offset"}], "}"}], "=", 
      RowBox[{"SimilarityPair3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
