Cell[TextData[{
 "SurfaceNormalFromSurface[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] computes the surface normal vector for a 3D parameterized surface. "
}], "Text",
 CellChangeTimes->{{3.672061797201322*^9, 3.672061812910108*^9}, {
   3.672061849157753*^9, 3.6720618932974854`*^9}, {3.672062244445573*^9, 
