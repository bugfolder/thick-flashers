Cell[TextData[{
 "NCurvedFoldUniformHelix2D[",
 StyleBox["r",
  FontSlant->"Italic"],
 ", \[Theta], ",
 StyleBox["\[Gamma]0, {u0, u1}, opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{{3.799751142773707*^9, 3.799751163630801*^9}, {
