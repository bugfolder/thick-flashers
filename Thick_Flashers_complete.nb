Cell[TextData[{
 "UnionVerticesAndEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.4558960622518187`*^9, 3.4558960639754667`*^9}, {
   3.4559004721776743`*^9, 3.4559004733820553`*^9}, {3.455905404374162*^9, 
   3.4559054224862*^9}, {3.45762399834013*^9, 3.457624002987049*^9}, {
   3.5916515647373133`*^9, 3.591651572102268*^9}, {3.591651610564094*^9, 
   3.591651610931332*^9}, 3.59172860894842*^9, 3.5924319150854607`*^9, 
   3.592435848800584*^9, 3.59244114923475*^9, 3.594653996895113*^9, {
   3.595286486577261*^9, 3.595286487800883*^9}, {3.595286608184885*^9, 
   3.595286609377166*^9}},ExpressionUUID->"c8faa505-81ba-49a6-ab31-\
8afba763bca9"],

Cell[TextData[{
 "UnionVerticesAndEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph containing lists of vertices and edges that may contain \
duplicate vertices and/or duplicate edges and returns a revised TGraph with \
no duplicate vertices or edges. Options are same as for SamePtQ."
}], "Text",
 CellChangeTimes->{{3.455896065591901*^9, 3.455896066984981*^9}, {
   3.4559054110308*^9, 3.4559054293584824`*^9}, 3.4559056805038342`*^9, {
   3.457620573785483*^9, 3.457620578279227*^9}, {3.591651576638946*^9, 
   3.591651623115101*^9}, {3.592435738816567*^9, 3.592435738914399*^9}, {
   3.592441131469747*^9, 
   3.592441140636677*^9}},ExpressionUUID->"b0edf047-7d0c-4b53-adc4-\
31195e15a032"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnionVerticesAndEdges", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", " ", "edges", ",", "nverts", ",", "ll", ",", "vm", ",", 
      "nedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "UnionVerticesAndEdges"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", " ", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vm", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"vv", ",", 
        RowBox[{
         RowBox[{"ll", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"MapIndexed", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"SamePtQ", "[", 
                  RowBox[{"vv", ",", "#1", ",", "opts"}], "]"}], ",", 
                 RowBox[{"First", "[", "#2", "]"}]}], "}"}], "&"}], ",", 
              "nverts"}], "]"}], ",", "First"}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "ll", "]"}], "\[Equal]", "0"}], ",", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"nverts", ",", "vv"}], "]"}], ";", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"vm", ",", 
              RowBox[{"Length", "[", "nverts", "]"}]}], "]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"vm", ",", 
             RowBox[{"ll", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
       "]"}], "/@", "verts"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vm", "[", 
            RowBox[{"[", "#", "]"}], "]"}], "&"}], ",", "edges", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", 
        RowBox[{"SameTest", "\[Rule]", "SameEdgeQ"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", "nverts"}], ",", 
         RowBox[{"Edges", "\[Rule]", "nedges"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4558960725756197`*^9, 3.4558960743421926`*^9}, {
   3.455905432174638*^9, 3.45590543508545*^9}, {3.455905493609838*^9, 
   3.455905513799257*^9}, {3.591651637512072*^9, 3.591651680714877*^9}, {
   3.591651734252989*^9, 3.591651763787935*^9}, {3.592350051315*^9, 
