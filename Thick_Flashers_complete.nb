Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NReshapeGeneric3D", "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.799415627430586*^9, 3.79941563208823*^9}, 
   3.800467905530126*^9, 3.800471568439953*^9},
 CellLabel->
  "In[3891]:=",ExpressionUUID->"9d5ceec2-05e5-4034-b7b3-0870ff539a89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NReshapeGeneric3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b_Function", "|", "b_InterpolatingFunction"}], ",", 
      RowBox[{"d_Function", "|", "d_InterpolatingFunction"}], ",", 
      "\[Sigma]_"}], "}"}], ",", "\[Kappa]n_Function", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bbi_List", ",", "ddi_List", ",", "tti_List"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "fiopts", ",", "\[IndentingNewLine]", "s", ",", "ds", ",",
       "t", ",", "l", ",", "u", ",", "\[IndentingNewLine]", "c\[Rho]L", ",", 
      "s\[Rho]L", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", "sd\[Tau]g", ",",
       "sd\[Kappa]n1", ",", "sd\[Tau]g1", ",", "\[IndentingNewLine]", "lli", ",",
       "uui", ",", "soln", ",", "ttx", ",", "tty", ",", "ttz", ",", "llx", ",",
       "lly", ",", "llz", ",", "uux", ",", "uuy", ",", "uuz", ",", "bbx", ",",
       "bby", ",", "bbz", ",", "\[IndentingNewLine]", "tt", ",", "ll", ",", 
      "uu", ",", "bb", ",", "dd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fiopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"curve", " ", "speed"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"b", "[", "s", "]"}], ",", "s"}], "]"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"db", "=", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"b", "[", "s", "]"}], ",", "s"}], "]"}]}], "}"}], ",", 
          RowBox[{"NormalizeReal", "[", "db", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"u", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"txd", "=", 
            RowBox[{
             RowBox[{"t", "[", "s", "]"}], "\[Cross]", 
             RowBox[{"d", "[", "s", "]"}]}]}], "}"}], ",", 
          RowBox[{"\[Sigma]", " ", 
           RowBox[{"NormalizeReal", "[", "txd", "]"}]}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"u", "[", "s", "]"}], "\[Cross]", 
         RowBox[{"t", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "left", " ", "ruling", " ", "angle", " ", "trig", " ", "functions"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"\[Sigma]", " ", 
         RowBox[{
          RowBox[{"t", "[", "s", "]"}], ".", 
          RowBox[{"d", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"\[Sigma]", " ", 
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{"d", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "compute", " ", "curve", " ", "speed", " ", "*", " ", "geodesic", " ", 
        "curvature"}], ",", " ", 
       RowBox[{"normal", " ", "curvature"}], ",", " ", 
       RowBox[{"geodesic", " ", "torsion"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"l", "[", "s", "]"}], ".", 
         RowBox[{
          RowBox[{"t", "'"}], "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"u", "[", "s", "]"}], ".", 
         RowBox[{
          RowBox[{"t", "'"}], "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"-", 
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{
           RowBox[{"u", "'"}], "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "New", " ", "normal", " ", "curvature", " ", "and", " ", "geodesic", " ",
        "torsion", " ", "products"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ds", "[", "s", "]"}], 
         RowBox[{"\[Kappa]n", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"ds", "[", "s", "]"}]}], " ", 
         RowBox[{"\[Kappa]n", "[", "s", "]"}], 
         FractionBox[
          RowBox[{
           RowBox[{"t", "[", "s", "]"}], ".", 
           RowBox[{"d", "[", "s", "]"}]}], 
          RowBox[{
           RowBox[{"l", "[", "s", "]"}], ".", 
           RowBox[{"d", "[", "s", "]"}]}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "initial", " ", "conditions", " ", "on", " ", "2", "D", " ", "Darboux", 
       " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uui", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"\[Sigma]", " ", 
        RowBox[{"tti", "\[Cross]", "ddi"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lli", "=", 
      RowBox[{
       RowBox[{"RotationMatrix3Du", "[", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "2"}], ",", "uui"}], "]"}], ".", "tti"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "the", " ", "new", " ", "Darboux", " ", "frame"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "tt", ",", "ll", ",", "uu"}], "}"}], "=", 
      RowBox[{"NRecoverDarboux3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ds", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n1", ",", "sd\[Tau]g1"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "tti", ",", "lli", ",", "uui"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rotate", " ", "back", " ", "to", " ", "get", " ", "the", " ", "new", " ",
        "director"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"c\[Rho]L", "[", "s", "]"}], 
            RowBox[{"tt", "[", "s", "]"}]}], "+", 
           RowBox[{
            RowBox[{"s\[Rho]L", " ", "[", "s", "]"}], 
            RowBox[{"ll", "[", "s", "]"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.798572927592586*^9, 3.798572964094378*^9}, {
