              RowBox[{"Sphere", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{".5", ",", ".5", ",", "0"}], "}"}], ",", ".8"}], 
               "]"}], ",", 
              RowBox[{"Opacity", "[", "0", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
