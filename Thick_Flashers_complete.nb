Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"filepath", ",", "ext"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"filepath", "=", "\"\<foo.BAR\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"AssertFileExtension", "[", 
      RowBox[{"filepath", ",", "\"\<bar\>\""}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6760320251341467`*^9, 3.676032058194824*^9}, {
   3.676032088683852*^9, 3.676032089843507*^9}, {3.676032447016189*^9, 
   3.676032450654021*^9}, 3.707922819602409*^9},
 CellLabel->
  "In[4413]:=",ExpressionUUID->"144c261f-b738-4ab4-893e-7be8d5a162d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"filepath", ",", "ext"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"filepath", "=", "\"\<foo.bar\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"AssertFileExtension", "[", 
      RowBox[{"filepath", ",", "\"\<baz\>\""}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowErrorExample"}]], "Input",
 CellChangeTimes->{{3.6760320251341467`*^9, 3.676032058194824*^9}, {
  3.676032088683852*^9, 3.676032100226346*^9}, {3.6760321427807293`*^9, 
  3.6760321430177317`*^9}, {3.676032304288537*^9, 3.676032318825023*^9}, {
  3.676035642167297*^9, 3.676035646772528*^9}},
 CellLabel->
  "In[4414]:=",ExpressionUUID->"5ff8f9ac-b4d9-4248-95da-71decb9e2564"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ReplaceFileExtension[",
 StyleBox["filepath",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ext",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.676035119848256*^9, 
  3.676035133909443*^9}},ExpressionUUID->"8684f1af-1274-41ae-8075-\
396b0b125b23"],

Cell[TextData[{
 "ReplaceFileExtension[",
 StyleBox["filepath",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ext",
  FontSlant->"Italic"],
 "] takes a file path and replaces the extension on the file with a new one."
}], "Text",
 CellChangeTimes->{{3.676035185245969*^9, 
  3.6760351975067587`*^9}},ExpressionUUID->"dda6311b-c232-4eb0-a26d-\
aec80177073b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReplaceFileExtension", "::", "noext"}], 
   "=", "\"\<The file path `1` does not contain an extension.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.676035270414435*^9, 3.6760352849023952`*^9}},
 CellLabel->
  "In[4415]:=",ExpressionUUID->"dd8d429e-2ccc-4d61-a97c-f11ed7401b7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceFileExtension", "[", 
   RowBox[{"filepath_String", ",", " ", "ext_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pos", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{"StringPosition", "[", 
       RowBox[{"filepath", ",", "\"\<.\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "pos", "]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"ReplaceFileExtension", "::", "noext"}], ",", "filepath"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"StringTake", "[", 
       RowBox[{"filepath", ",", 
        RowBox[{"pos", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
      "<>", "ext"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.6760351511908627`*^9, 3.676035168064954*^9}, {
  3.676035219423305*^9, 3.676035390855684*^9}, {3.676035448966365*^9, 
  3.676035460427805*^9}, {3.6760356649349403`*^9, 3.676035682528225*^9}},
 CellLabel->
  "In[4416]:=",ExpressionUUID->"0bc40d40-3cb5-4a5a-bf6f-f9d2b28e327f"],

Cell["Example", "Text",
 CellChangeTimes->{{3.676035394084292*^9, 
  3.676035394796648*^9}},ExpressionUUID->"d9fa06fc-64a8-44a9-9ef9-\
fddad2596359"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceFileExtension", "[", 
   RowBox[{"\"\<foo.bar\>\"", ",", "\"\<baz\>\""}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.67603539773593*^9, 3.676035438477653*^9}, 
   3.70792282717704*^9},
 CellLabel->
  "In[4417]:=",ExpressionUUID->"39903ac2-ea16-4ecc-827f-20d414b9d769"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceFileExtension", "[", 
   RowBox[{"\"\<foobar\>\"", ",", "\"\<baz\>\""}], "]"}], "//", 
  "ShowErrorExample"}]], "Input",
 CellChangeTimes->{{3.67603539773593*^9, 3.676035438477653*^9}, {
  3.6760356936429358`*^9, 3.676035702285581*^9}},
 CellLabel->
