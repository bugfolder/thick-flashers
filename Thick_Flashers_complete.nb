Cell[CellGroupData[{

Cell[TextData[{
 "DevelopableAnglesQ[",
 StyleBox["sectorangles, opts",
  FontSlant->"Italic"],
 "]\n\t(options) DevelopableTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.457895766537785*^9, 3.457895823102817*^9}, {
   3.457896227918153*^9, 3.457896229027732*^9}, {3.4578962858779*^9, 
   3.4578962867577147`*^9}, {3.4578966376336823`*^9, 3.457896697760791*^9}, {
   3.594898756203281*^9, 3.594898772300595*^9}, 3.594934189369514*^9, 
   3.617305518594415*^9, 
   3.708342350545946*^9},ExpressionUUID->"7a2afc73-0657-49c0-a40e-\
a6e1c2f1894d"],

Cell[TextData[{
 "DevelopableAnglesQ[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns true if the given list of sector angles gives a planar vertex, \
i.e., its angles sum to 360\[Degree]. Options are:\n\tDevelopableTolerance \
\[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the tolerance in angular error."
}], "Text",
 CellChangeTimes->{{3.4578962666867948`*^9, 3.457896328050769*^9}, {
   3.457896437173702*^9, 3.457896450612348*^9}, 3.594898756308657*^9, 
   3.594934202653075*^9, {3.708342938683126*^9, 
   3.7083429432464747`*^9}},ExpressionUUID->"301fb6d9-8485-4da7-8de3-\
757eda1a41b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DevelopableTolerance", "::", "usage"}], 
   "=", "\"\<DevelopableTolerance is an option used in DevelopableAnglesQ to \
determine whether a vertex is developable.\>\""}], ";"}]], "Input",
