Cell["\<\
HexagonVertexGraph3DAssigned returns a hexagon containing a single degree-6 \
vertex in its center and a fully folded 3D form.\
\>", "Text",
 CellChangeTimes->{{3.719615871559099*^9, 3.719615900736189*^9}, 
   3.719619666200406*^9},ExpressionUUID->"3bd591b5-7e88-4279-adc5-\
b552cad05f4f"],

Cell["\<\
See also MakeHexVertex (below) for a function that returns a fully \
parameterized 3D hexagonal vertex.\
\>", "Text",
 CellChangeTimes->{{3.7196196065085373`*^9, 
  3.719619647405045*^9}},ExpressionUUID->"b46beff0-ec80-4714-872b-\
06cae7fd7a3f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "HexagonVertexGraph3DAssigned", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"HexagonVertexGraph3DAssigned", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tobj", ",", "verts", ",", "edges", ",", "types", ",", "foldangles"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"verts", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"U", "[", 
           RowBox[{"0.", "\[Degree]"}], "]"}], ",", 
          RowBox[{"U", "[", 
           RowBox[{"60.", "\[Degree]"}], "]"}], ",", 
          RowBox[{"U", "[", 
           RowBox[{"120.", "\[Degree]"}], "]"}], ",", 
          RowBox[{"U", "[", 
           RowBox[{"180.", "\[Degree]"}], "]"}], ",", 
          RowBox[{"U", "[", 
           RowBox[{"240.", "\[Degree]"}], "]"}], ",", 
          RowBox[{"U", "[", 
           RowBox[{"300.", "\[Degree]"}], "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"5", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"7", ",", "2"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"types", "=", 
        RowBox[{"{", 
         RowBox[{
         "V", ",", "M", ",", "V", ",", "M", ",", "V", ",", "M", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"foldangles", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"180.", "\[Degree]"}], ",", 
          RowBox[{
           RowBox[{"-", "60."}], "\[Degree]"}], ",", 
          RowBox[{"180.", "\[Degree]"}], ",", 
          RowBox[{
           RowBox[{"-", "60."}], "\[Degree]"}], ",", 
          RowBox[{"180.", "\[Degree]"}], ",", 
          RowBox[{
           RowBox[{"-", "60."}], "\[Degree]"}], ",", "0", ",", "0", ",", "0", 
          ",", "0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"MakeTGraph", "[", 
            RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], 
          "//", 
          RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
         RowBox[{"AddTGraph3D", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"FoldGraph3D", "[", 
        RowBox[{"tobj", ",", "foldangles"}], "]"}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.595277810545285*^9, 3.595277938322707*^9}, {
   3.595279000893552*^9, 3.595279010912078*^9}, 3.706827081863113*^9, 
   3.706827126525547*^9, {3.706831056038189*^9, 3.706831181904113*^9}, 
   3.708400178081468*^9, 3.708603657171018*^9, {3.719615911947645*^9, 
   3.719615913357464*^9}, {3.719616025971738*^9, 3.7196160948414297`*^9}, {
   3.719619666212089*^9, 3.7196196662275457`*^9}},
 CellLabel->
  "In[1991]:=",ExpressionUUID->"12ece75f-393d-4538-9af4-03a0723f50c5"],

