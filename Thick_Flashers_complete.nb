   3.672093842461871*^9},ExpressionUUID->"87cb64ca-c126-49b9-aad1-\
54b484996d17"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ss", ",", "t", ",", "ff", ",", "uu", ",", "cs3s", ",", "tt", ",", "nn", 
      ",", "bb", ",", "ll", ",", "du", ",", "dv", ",", "dt", ",", "t0", ",", 
      "dr", ",", "\[Kappa]g", ",", "\[Kappa]n", ",", "\[Eta]", ",", "gg"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"du", "=", 
      RowBox[{"1", "/", "10"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dv", "=", 
      RowBox[{"1", "/", "10"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{"1", "/", "10"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dr", "=", "0.3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"t0", "=", "0.5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"curved", " ", "surface"}], ",", " ", 
       RowBox[{
       "which", " ", "happens", " ", "to", " ", "be", " ", "an", " ", 
        "isometric", " ", "mapping"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Cos", "[", "#2", "]"}]}], ")"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"curved", " ", "function"}], ",", " ", 
       RowBox[{"sinusoid", " ", "in", " ", "original", " ", "paper"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"ss", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], "-", "1"}], ",", "t"}], "]"}], ",",
         "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ff = \>\"", ",", 
       RowBox[{"ff", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SurfaceNormalFromSurface", "[", "ss", "]"}], "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], "-", "1"}], ",", "t"}], "]"}], ",",
         "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cs3s", "=", 
      RowBox[{"Darboux3DSystemOld", "[", 
       RowBox[{"ff", ",", "uu", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"cs3s", "//", "PrettyParameters"}], "//", "ColumnForm"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Frenet", "-", 
       RowBox[{"Darboux", " ", "angle"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Kappa]g", ",", "\[Kappa]n", ",", "\[Eta]"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "GeodesicCurvature3D", ",", "NormalCurvature3D", ",", 
         "FrenetDarbouxAngle"}], "}"}], "/.", "cs3s"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{"\[Kappa]g", "[", "t0", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{"\[Kappa]n", "[", "t0", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{
       RowBox[{"\[Eta]", "[", "t0", "]"}], "/", "\[Degree]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Frenet", " ", "and", " ", "Darboux", " ", "frame", " ", "components"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "nn", ",", "bb", ",", "ll"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector3D", ",", "NormalVector3D", ",", "BinormalVector3D", ",",
          "TangentNormalVector3D"}], "}"}], "/.", "cs3s"}]}], ";", 
     "\[IndentingNewLine]", 
