Cell[BoxData[
 RowBox[{
  RowBox[{"FoldSurfaceToCone", "[", 
   RowBox[{
   "b1_Function", ",", "d1_Function", ",", "bb1_Function", ",", 
    "dd1_Function", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "b2i_List", ",", "bb2i_List"}], "}"}], ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "v", ",", "f", ",", "ff", ",",
       "d2i", ",", "dd2i", ",", "\[Psi]", ",", "b2", ",", "d2", ",", "bb2", ",",
       "dd2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldSurfaceToCone", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldSurfaceToCone", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"v", "-", 
       RowBox[{"parameter", " ", "solution"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"Mag2", "[", 
            RowBox[{"b2i", "-", 
             RowBox[{"b1", "[", "s", "]"}]}], "]"}], "-", 
           RowBox[{"Mag2", "[", 
            RowBox[{"bb2i", "-", 
             RowBox[{"bb1", "[", "s", "]"}]}], "]"}]}], 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"b2i", "-", 
                RowBox[{"b1", "[", "s", "]"}]}], ")"}], ".", 
              RowBox[{"d1", "[", "s", "]"}]}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"bb2i", "-", 
                RowBox[{"bb1", "[", "s", "]"}]}], ")"}], ".", 
              RowBox[{"dd1", "[", "s", "]"}]}]}], ")"}]}]], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"b1", "[", "s", "]"}], "+", 
          RowBox[{
           RowBox[{"v", "[", "s", "]"}], 
           RowBox[{"d1", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"bb1", "[", "s", "]"}], "+", 
          RowBox[{
           RowBox[{"v", "[", "s", "]"}], 
           RowBox[{"dd1", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d2i", "=", 
      RowBox[{
       RowBox[{"NormalizeReal", "[", 
        RowBox[{"b2i", "-", 
         RowBox[{"f", "[", "ui", "]"}]}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd2i", "=", 
      RowBox[{
       RowBox[{"NormalizeReal", "[", 
        RowBox[{"bb2i", "-", 
         RowBox[{"ff", "[", "s", "]"}]}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"Sign", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"d1", "[", "ui", "]"}], ".", "d2i"}], "-", 
        RowBox[{
         RowBox[{"dd1", "[", "ui", "]"}], ".", "dd2i"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "b2i"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "bb2i"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Psi]", " ", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{"b2i", "-", 
            RowBox[{"f", "[", "s", "]"}]}], "]"}]}], "//", "sfn"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"dd2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Psi]", " ", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{"bb2i", "-", 
            RowBox[{"ff", "[", "s", "]"}]}], "]"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"b2", ",", "d2", ",", "bb2", ",", "dd2", ",", "f", ",", "ff"}], 
      "}"}]}]}], "]"}]}]], "Input",
