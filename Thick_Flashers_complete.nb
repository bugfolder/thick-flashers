Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "types", ",", "foldangles", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "6", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "7", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4", ",", "8", ",", "7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "B", ",", "B", ",", "B", ",", "V", ",", "M", ",", "B", ",", 
        "B", ",", "B", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "90"}], "\[Degree]"}], ",", "0", ",", "0", ",", "0", ",",
         "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraphAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", "faces", ",", "types"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj", ",", "foldangles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], 
       "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"VeneerScoringCarveGraphics", "[", "tobj", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.62489026416653*^9, 3.624890416224859*^9}, {
   3.624890503181455*^9, 3.624890513491116*^9}, {3.624890613845597*^9, 
