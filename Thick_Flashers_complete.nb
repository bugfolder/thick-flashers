1ea37df99191"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationYMatrix3D", "[", "\[Phi]_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "0", ",", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "0", ",", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "}"}]}], "}"}]}]], "Input",
