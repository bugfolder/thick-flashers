Cell[BoxData[
 RowBox[{
  RowBox[{"FoldSurfaceToCylinder", "[", 
   RowBox[{
   "b1_Function", ",", "d1_Function", ",", "bb1_Function", ",", 
    "dd1_Function", ",", 
    RowBox[{"{", 
     RowBox[{
     "p2i_List", ",", "d2i_List", ",", "pp2i_List", ",", "dd2i_List"}], "}"}],
     ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "v", ",", "f", ",", "ff", ",",
       "b2", ",", "bb2", ",", "d2", ",", "dd2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldSurfaceToCylinder", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldSurfaceToCylinder", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"v", "-", 
       RowBox[{"parameter", " ", "solution"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p2i", "-", 
              RowBox[{"b1", "[", "s", "]"}]}], ")"}], ".", "d2i"}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"pp2i", "-", 
              RowBox[{"bb1", "[", "s", "]"}]}], ")"}], ".", "dd2i"}]}], 
          RowBox[{
           RowBox[{
            RowBox[{"d1", "[", "s", "]"}], ".", "d2i"}], "-", 
           RowBox[{
            RowBox[{"dd1", "[", "s", "]"}], ".", "dd2i"}]}]], "//", "sfn"}]}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"b1", "[", "s", "]"}], "+", 
          RowBox[{
           RowBox[{"v", "[", "s", "]"}], 
           RowBox[{"d1", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"bb1", "[", "s", "]"}], "+", 
          RowBox[{
           RowBox[{"v", "[", "s", "]"}], 
           RowBox[{"dd1", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"f", "[", "s", "]"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"f", "[", "s", "]"}], "-", "p2i"}], ")"}], ".", 
             "d2i"}], ")"}], "d2i"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bb2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"ff", "[", "s", "]"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ff", "[", "s", "]"}], "-", "pp2i"}], ")"}], ".", 
             "dd2i"}], ")"}], "dd2i"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"d2i", "//", "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"dd2i", "//", "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"b2", ",", "d2", ",", "bb2", ",", "dd2", ",", "f", ",", "ff"}], 
      "}"}]}]}], "]"}]}]], "Input",
