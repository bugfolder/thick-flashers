Cell[CellGroupData[{

Cell[TextData[{
 "EdgeOverlaps2D[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph2D\n\t(options) IncludeCollinear"
}], "Subsubsection",
 CellChangeTimes->{{3.628871779093363*^9, 3.62887179205046*^9}, {
  3.629036194173154*^9, 
  3.629036203105097*^9}},ExpressionUUID->"67044a09-9b8f-4509-8a6e-\
0aab2ac53d22"],

Cell[TextData[{
 "EdgeOverlaps2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of undirected edges on the Vertices2D embedding of the \
edges that define the edge overlap graph; an edge {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 "} is in the overlap graph iff the folded form embedding of edge ",
 StyleBox["i",
  FontSlant->"Italic"],
 " and edge ",
 StyleBox["j",
  FontSlant->"Italic"],
 " overlap. Options are:\n\tIncludeCollinear \[Rule] True | False, is passed \
thrugh to SegmentsIntersectQ."
}], "Text",
 CellChangeTimes->{{3.628820920481954*^9, 3.6288210103457136`*^9}, 
   3.628821071109744*^9, 3.6288212387999177`*^9, {3.628863729233081*^9, 
   3.628863749519408*^9}, {3.628868373478641*^9, 3.6288683741821547`*^9}, {
   3.628871814107129*^9, 3.628871839991555*^9}, {3.629036204905656*^9, 
   3.6290362288878818`*^9}},ExpressionUUID->"0008a4b5-126f-4826-95a8-\
71bf06219ce4"],

Cell["\<\
You can rely on the ordering of the indices: first index is always smaller.\
\>", "Text",
 CellChangeTimes->{{3.628868383414173*^9, 
  3.6288683941411333`*^9}},ExpressionUUID->"62b9c16f-b528-46b0-a6d3-\
60827cbe7f3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeOverlaps2D", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts2d", ",", "edges", ",", "epairs", ",", "oedges"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices2D", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"epairs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts2d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"oedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"don", "'"}], "t", " ", "bother", " ", "with", " ", "edges", " ",
         "that", " ", "share", " ", "a", " ", "vertex"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Or", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"j", ",", "1"}], "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"j", ",", "2"}], "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"j", ",", "1"}], "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{"j", ",", "2"}], "\[RightDoubleBracket]"}]}]}], "]"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"first", " ", "quick", " ", "check"}], ",", " ", 
          RowBox[{
          "see", " ", "if", " ", "bounding", " ", "boxes", " ", 
           "intersect"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"BoundingBoxesIntersectQ", "[", 
            RowBox[{
             RowBox[{"BoundingBox", "[", 
              RowBox[{
              "epairs", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], "]"}], ",", 
             RowBox[{"BoundingBox", "[", 
              RowBox[{
              "epairs", "\[LeftDoubleBracket]", "j", 
               "\[RightDoubleBracket]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"now", " ", "check", " ", "for", " ", "real"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"SegmentsIntersectQ", "[", 
           RowBox[{
            RowBox[{
            "epairs", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            ",", 
            RowBox[{
            "epairs", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
            ",", "opts"}], "]"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"oedges", ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "i"}], "}"}]}], "]"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "oedges"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.628821038869235*^9, 3.628821051983617*^9}, {
   3.628821092262985*^9, 3.628821262421224*^9}, {3.628821374752664*^9, 
