Cell[CellGroupData[{

Cell["SplitSquareTwist45Graph2D", "Subsubsection",
 CellChangeTimes->{{3.706825886878676*^9, 3.706825889005108*^9}, {
  3.706955158030664*^9, 3.706955158350236*^9}, {3.706955278273293*^9, 
