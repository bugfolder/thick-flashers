Cell[TextData[{
 "CircularlyAddEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] takes a TGraph and an index list ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 " and adds edges to the vertices specified by ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 " that extend out to a set of new vertices on a circle centered at ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 " of radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.455923184742564*^9, 3.455923188078398*^9}, {
