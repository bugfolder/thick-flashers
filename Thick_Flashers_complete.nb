       RowBox[{"sa", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTDegree4Vertex3D", "[", "dirs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Degree4Vertex3DGraphicsTrio", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"SectorAngleLabels", "\[Rule]", "sal"}], ",", 
        RowBox[{"DihedralAngleLabels", "\[Rule]", "dal"}], ",", 
        RowBox[{"ShowOsculatingVector", "\[Rule]", "True"}]}], "]"}], "/.", 
      RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "ShowExample"}]], "Input",
