Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"angles", ",", "info", ",", "gfn"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"100", "\[Degree]"}], ",", 
        RowBox[{"85", "\[Degree]"}], ",", 
        RowBox[{"55", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"info", "=", 
      RowBox[{"UnitBrocardPolygonInfoCCW", "[", "angles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
