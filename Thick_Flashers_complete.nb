Cell[CellGroupData[{

Cell[TextData[{
 "StyledFrenetTrihedron[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FrenetVectorLength, FrenetVectorLabels, VectorThickness2D, \
VectorArrowheads"
}], "Subsubsection",
 CellChangeTimes->{{3.6879959733336153`*^9, 3.687996088867853*^9}, {
   3.68799613166506*^9, 3.687996134705777*^9}, {3.687996310141873*^9, 
   3.687996312101643*^9}, 3.687996356659189*^9, 3.688997938297781*^9, {
   3.688998002570285*^9, 3.688998047866638*^9}, {3.688998213928211*^9, 
   3.688998224769149*^9}, 3.689001815397182*^9, 3.6912540526363087`*^9, 
   3.691283075611597*^9, 3.691527387249104*^9, 3.7998346841057453`*^9, 
   3.799956146705821*^9},ExpressionUUID->"27fc8f20-4c74-4e3f-87ce-\
fe86745f1a91"],

Cell[TextData[{
 "StyledFrenetTrihedron[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns Graphics3D elements that display a Frenet frame located at point \
p. Arguments are:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the position of the frame (a vector, not a function).\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the tangent vector of the frame.\n\t",
 StyleBox["n",
  FontSlant->"Italic"],
 " \[LongDash] the normal vector of the frame.\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the binormal vector of the frame.\nIt returns a list of \
Graphics3D elements. Colors are symbolic. Options are:\n\tFrenetVectorLength \
\[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies the lengths of the vector line segments.\n\tFrenetVectorLabels \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", specifies the labels to be put on the vectors.\n\tVectorThickness2D, \
VectorArrowheads are passed through to StyledVector."
}], "Text",
 CellChangeTimes->{{3.687996094310459*^9, 3.687996104226926*^9}, {
   3.687996136624464*^9, 3.6879963047982683`*^9}, {3.687996360522953*^9, 
   3.687996430902366*^9}, 3.688137467675481*^9, 3.688997938325183*^9, {
   3.688998025961135*^9, 3.6889980575037737`*^9}, {3.688998228285535*^9, 
   3.688998254900938*^9}, {3.688999052573984*^9, 3.688999053395954*^9}, 
   3.689001815432473*^9, 3.799834684134029*^9, 
   3.799956146763493*^9},ExpressionUUID->"b9c5e688-42ff-44e4-b3ca-\
b0cb9959e4aa"],

