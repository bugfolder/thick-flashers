Cell[CellGroupData[{

Cell["More tilings for primal-dual tessellations", "Section",
 CellChangeTimes->{{3.485213968568303*^9, 3.485213977854639*^9}, {
  3.485269765058734*^9, 
  3.485269769930431*^9}},ExpressionUUID->"465ffba4-b4da-4034-8cc2-\
8b161febbc76"],

Cell[CellGroupData[{

Cell["Goldberg tilings", "Subsection",
 CellChangeTimes->{{3.485213980542665*^9, 3.4852139868301973`*^9}, {
  3.485215045403679*^9, 3.485215048489758*^9}, {3.485220127095283*^9, 
  3.485220132589593*^9}, {3.551745415456223*^9, 
  3.551745416335905*^9}},ExpressionUUID->"59f66050-dc72-4175-9786-\
a690701c3514"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.485213990534466*^9, 
  3.4852139953341103`*^9}},ExpressionUUID->"6306714d-9263-4154-ac2d-\
13843bc1390c"],

Cell["\<\
Michael Goldberg identified a family of radial isoceles triangle tilings in \
his 1955 paper \"Central Tessellations.\" We create these tilings here. \
They're good for primal-dual tessellations.\
\>", "Text",
 CellChangeTimes->{{3.485213998102665*^9, 3.485214054485944*^9}, {
  3.485215059754024*^9, 
  3.485215118801728*^9}},ExpressionUUID->"a26f7ea0-0e43-4a4a-ac58-\
bdab51586b2f"],

Cell["\<\
The offset version of these tessellations gives a nonperiodic tiling that \
Alex Bateman has used for some of his tessellations.\
\>", "Text",
 CellChangeTimes->{{3.485217633918914*^9, 3.485217662231331*^9}, {
  3.592505743866684*^9, 
  3.592505744719252*^9}},ExpressionUUID->"47a391eb-a2a4-49d8-a93a-\
86e39bb43ae0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "GoldbergPoint[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["l",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.4852151273699837`*^9, 3.485215153585844*^9}, {
   3.485215236050121*^9, 3.485215236513938*^9}, {3.485215551930183*^9, 
   3.485215556657675*^9}, {3.485217374912667*^9, 3.485217390214896*^9}, {
   3.485217825080641*^9, 3.485217853678885*^9}, {3.485218009326848*^9, 
   3.485218009794311*^9}, {3.4852183374804497`*^9, 3.48521834521424*^9}, {
   3.485219839545287*^9, 3.48521984110469*^9}, 
   3.631187317329218*^9},ExpressionUUID->"b3b127eb-4a91-40e2-83d7-\
64b4e86b51f1"],

Cell[TextData[{
 "GoldbergPoint",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["l",
  FontSlant->"Italic"],
 "] returns the coordinates of a point of a Goldberg radial isoceles triangle \
tiling that contains a unit edge from {0,0} to {1,0}, where ",
 StyleBox["m",
  FontSlant->"Italic"],
 " is the rotational order; ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the radial quantum number (0 is the origin); ",
 StyleBox["k",
  FontSlant->"Italic"],
 " indicates which wedge the point falls in; and ",
 StyleBox["l",
  FontSlant->"Italic"],
 " is the index of the point within that wedge. ",
 StyleBox["o",
  FontSlant->"Italic"],
 " is an offset value, which can be nonzero only for even ",
 StyleBox["m",
  FontSlant->"Italic"],
 "; it's used to create nonperiodic Goldberg tilings."
}], "Text",
 CellChangeTimes->{{3.485215164081777*^9, 3.485215331169682*^9}, {
   3.485217817768272*^9, 3.485217818143398*^9}, {3.485218021886508*^9, 
   3.485218045934355*^9}, 3.485219852445036*^9, 
   3.631187317329499*^9},ExpressionUUID->"0ca41f24-bf39-4dbb-ab6a-\
1f27214f346e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GoldbergPoint", "[", 
   RowBox[{"m_", ",", "n_", ",", "k_", ",", "l_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[Phi]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RotationMatrix2D", "[", 
       RowBox[{"2", "k", " ", "\[Phi]"}], "]"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", "0"}], "}"}], "+", 
        RowBox[{"2", "l", " ", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
         RowBox[{"U", "[", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "+", "\[Phi]"}], "]"}]}]}], 
       ")"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.4852153597127943`*^9, 3.48521545259697*^9}, {
   3.485215490126851*^9, 3.4852155059171352`*^9}, 3.485215570512259*^9, {
   3.4852164884064093`*^9, 3.485216552347034*^9}, 3.485216595171974*^9, {
   3.485217011597087*^9, 3.485217022195047*^9}, {3.485218014027803*^9, 
   3.4852180173860903`*^9}, {3.485218106507478*^9, 3.485218206197624*^9}, {
   3.4852182671647997`*^9, 3.4852182801330767`*^9}, {3.485218353075568*^9, 
   3.485218361377734*^9}, 3.631187317330039*^9, 3.688166969264679*^9},
 CellLabel->
  "In[3355]:=",ExpressionUUID->"dc7dcb79-b633-4da3-a47e-f0d6eb9b6201"],

