Cell[CellGroupData[{

Cell[TextData[{
 "HingePlateGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HingeThickness, HingeEndsClipped"
}], "Subsubsection",
 CellChangeTimes->{{3.912251256969394*^9, 3.9122512666522007`*^9}, {
   3.912251352950634*^9, 3.9122513889319487`*^9}, 3.912574879056205*^9, {
   3.915799438537242*^9, 3.91579944355147*^9}, {3.920803704653873*^9, 
   3.920803706390153*^9}, {3.926594337736086*^9, 3.9265943407718763`*^9}, 
   3.926594390372563*^9},ExpressionUUID->"500eb831-cf58-49c7-91b7-\
17786631d334"],

Cell[TextData[{
 "HingePlateGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a GraphicsComplex polyhedron that implements a plate hinge \
between two panels in a 3D-printed solid."
}], "Text",
 CellChangeTimes->{{3.912251425801676*^9, 3.912251451015481*^9}, 
   3.912574879080297*^9, {3.920803713209454*^9, 
   3.920803716438109*^9}},ExpressionUUID->"6ee8be67-d094-464c-9330-\
38580e728127"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} \[LongDash] the two panel polyhedron vertices on one side of the hinge.\n\
\t{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} \[LongDash] the corresponding two panel vertices on the other side of the \
hinge."
}], "Text",
 CellChangeTimes->{{3.9122517761975393`*^9, 
  3.91225182910169*^9}},ExpressionUUID->"363a731f-b618-4434-80cb-\
07c65259358b"],

Cell[TextData[{
 "Options:\n\tHingeThickness \[Rule] ",
 StyleBox["ht",
  FontSlant->"Italic"],
 ", the thickness of hinges between connected parts.\n\tHingeEndsClipped \
\[Rule] True | False, whether to square off the ends of the hinge plate. \
Default is True."
}], "Text",
 CellChangeTimes->{{3.912251839577525*^9, 3.912251855519747*^9}, {
   3.92659434618972*^9, 3.926594351637816*^9}, 3.9265943904021463`*^9, {
   3.926594480026545*^9, 
   3.926594508517907*^9}},ExpressionUUID->"3623714b-20b7-4962-9b3d-\
6500a8f665f4"],

Cell["\<\
Returns: a list containing a single GraphicsComplex object that produces the \
hinge.\
\>", "Text",
 CellChangeTimes->{{3.9122518642937727`*^9, 3.912251989434338*^9}, {
  3.912574780610379*^9, 3.912574781812535*^9}, {3.922629881993277*^9, 
  3.9226298898721237`*^9}},ExpressionUUID->"308da439-1d76-46ae-88c6-\
4e512f490701"],

Cell["\<\
We expand the hinge into each polyhedra by an amount equal to half of the \
hinge thickness to ensure that there is overlap between the hinge and the \
faces of its two incident panels.\
\>", "Text",
 CellChangeTimes->{{3.912574786580376*^9, 3.912574804793401*^9}, {
  3.912574836596163*^9, 
  3.912574842913301*^9}},ExpressionUUID->"b3709c91-fbd8-482c-a406-\
231443f227b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "HingePlateGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HingeThickness", "->", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeEndsClipped", "->", "True"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.912252524177183*^9, 3.912252549941126*^9}, 
   3.912574879088312*^9, 3.920803728406895*^9, {3.9265945113782253`*^9, 
