Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAngleSpecLabels", "[", 
   RowBox[{"tobj_TObj", ",", " ", "faspecs_List", ",", " ", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ei", ",", "ud", ",", "verts", ",", "edges", ",", "el"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ei", "=", 
      RowBox[{
       RowBox[{"EdgeIndices", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ud", "=", 
      RowBox[{
       RowBox[{"UseDegrees", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAngleSpecLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "FoldAngleSpecLabels"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{"ei", ",", 
            RowBox[{"\"\<e\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<\[Rule]{\>\""}], 
            ",", "\"\<{\>\""}], "]"}], "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"faspecs", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "/.", 
            RowBox[{"Infinity", "\[Rule]", "\"\<\[Infinity]\>\""}]}], "]"}], 
          "<>", "\"\<, \>\"", "<>", 
          RowBox[{"If", "[", 
           RowBox[{"ud", ",", 
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{
               RowBox[{
                StyleBox["faspecs",
                 FontSlant->"Italic"], "\[LeftDoubleBracket]", 
                RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "/", 
               "\[Degree]"}], "]"}], "<>", "\"\<\[Degree]\>\""}], ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"faspecs", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "]"}]}], 
           "]"}], "<>", "\"\<}\>\""}], ",", 
         RowBox[{
          RowBox[{"Plus", "@@", 
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{
            "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}], "/", "2"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5942012610087013`*^9, 3.594201299972058*^9}, {
   3.594209010905233*^9, 3.5942090113268347`*^9}, {3.59421057620182*^9, 
   3.594210619526789*^9}, {3.594210668346456*^9, 3.594210693230109*^9}, {
   3.594210784852772*^9, 3.594210977248361*^9}, {3.594211018773036*^9, 
   3.594211152421891*^9}, {3.594211819098563*^9, 3.594211821255602*^9}, {
   3.59421213533835*^9, 3.594212274494862*^9}, {3.5942123321945868`*^9, 
   3.594212390613926*^9}, {3.5942181484172897`*^9, 3.5942181576101933`*^9}, 
