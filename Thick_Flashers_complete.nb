  3.595358454889995*^9, 3.595358469614155*^9}, {3.5953606340442863`*^9, 
  3.595360659032642*^9}, {3.72225078884313*^9, 
  3.722250789920123*^9}},ExpressionUUID->"8881eea0-ca11-4cee-8ffb-\
5eb45dafb276"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph to be folded.\n\t",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " \[LongDash] the fold angles."
}], "Text",
 CellChangeTimes->{{3.722250421556538*^9, 
  3.72225043896382*^9}},ExpressionUUID->"b95f42b7-36f6-4768-8c83-\
b7e8452ff4a9"],

Cell[TextData[{
 "Options:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 ", the index of the face whose position remains unchanged.\n\tShowProgress \
\[Rule] True | False, whether to show progress and internal structures. \
Useful for debugging."
}], "Text",
 CellChangeTimes->{
  3.722248539983442*^9, {3.722248727638082*^9, 3.722248741877592*^9}, 
   3.7222488281772833`*^9},ExpressionUUID->"5a802d84-df6f-4d16-9c2e-\
d450c29fc242"],

Cell["\<\
Returns a TGraph3D with the unfolded crease pattern in Vertices. We use a \
standard position of putting the stationary vertex at the origin and the \
first edge in that face along the x-axis.\
\>", "Text",
 CellChangeTimes->{{3.722250450179427*^9, 3.722250462868353*^9}, {
  3.722250793143004*^9, 3.722250793761607*^9}, {3.722250825376343*^9, 
  3.722250832638784*^9}, {3.7222509187525806`*^9, 
  3.722250924256839*^9}},ExpressionUUID->"9607e056-a39a-4701-8c3c-\
479bd13cd487"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "UnfoldGraph3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"StationaryFace", "\[Rule]", "1"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.484828799316506*^9, 3.484828811909363*^9}, 
   3.484829074387739*^9, 3.484927941083176*^9, {3.484928084298373*^9, 
   3.484928084659789*^9}, 3.592791267910019*^9, 3.5952002459112453`*^9, 
   3.595355519909628*^9, 3.595358421983165*^9},
 CellLabel->
  "In[1464]:=",ExpressionUUID->"279b43b4-ced5-4b03-9c7d-7ec278292783"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnfoldGraph3D", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sface", ",", "tobj1", ",", "foldangles", ",", "verts3d", ",", "faces", ",",
       "m", ",", "verts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "UnfoldGraph3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sface", "=", 
      RowBox[{
       RowBox[{"StationaryFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "UnfoldGraph3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", "tobj", ",", 
        RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"-", 
       RowBox[{"EdgeFaceAngles3D", "[", "tobj1", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"FoldEmbedding", "[", 
       RowBox[{"tobj1", ",", "verts3d", ",", "foldangles", ",", "opts"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"translate", " ", "to", " ", "origin"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{"verts3d", "\[LeftDoubleBracket]", 
          RowBox[{"faces", "\[LeftDoubleBracket]", 
           RowBox[{"sface", ",", "1"}], "\[RightDoubleBracket]"}], 
          "\[RightDoubleBracket]"}]}], "&"}], "/@", "verts3d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "rotate", " ", "so", " ", "that", " ", "stationary", " ", "face", " ", 
        "lies", " ", "in", " ", "x"}], "-", 
       RowBox[{
       "y", " ", "plane", " ", "with", " ", "first", " ", "edge", " ", 
        "along", " ", "x"}], "-", 
       RowBox[{"axis", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"TriangleBasis3D", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
          "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
          "&"}], "/@", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{
           "faces", "\[LeftDoubleBracket]", "sface", 
            "\[RightDoubleBracket]"}], ",", "3"}], "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"m", ".", "#"}], "&"}], "/@", "verts3d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"#", ",", 
          RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "verts3d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices", "\[Rule]", "verts"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.458256233072176*^9, 3.458256879673994*^9}, {
