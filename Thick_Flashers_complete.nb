  3.799418819355382*^9}},ExpressionUUID->"829aad9f-a6e9-4b03-b757-\
10f7c5ab335e"],

Cell[TextData[{
 "Returns a list {b, ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 "} giving the ruled parameterization in 2D and 3D."
}], "Text",
 CellChangeTimes->{{3.691254178053851*^9, 3.691254193095383*^9}, {
   3.7994068892774076`*^9, 3.799406929450653*^9}, 3.7994102136795588`*^9, {
