Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sa1", ",", "sa2", ",", "sa3", ",", "\[Gamma]1", ",", "gfn"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"65", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}], ",", 
        RowBox[{"115", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}], ",", 
        RowBox[{"65", "\[Degree]"}], ",", 
        RowBox[{"115", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa3", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"120", "\[Degree]"}], ",", 
        RowBox[{"70", "\[Degree]"}], ",", 
        RowBox[{"65", "\[Degree]"}], ",", 
        RowBox[{"105", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]1", "=", 
      RowBox[{"90.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "gfn", " ", "computes", " ", "dihedrals", " ", "and", " ", "draws", " ",
        "and", " ", "labels", " ", "the", " ", "CP"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gfn", "[", "sa_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"da", ",", "cv", ",", "sal", ",", "dal", ",", "tobj"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"da", "=", 
          RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "[", 
           RowBox[{"sa", ",", "\[Gamma]1"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cv", "=", 
          RowBox[{"Drop", "[", 
           RowBox[{
            RowBox[{"U", "/@", 
             RowBox[{"FoldList", "[", 
              RowBox[{"Plus", ",", "0", ",", "sa"}], "]"}]}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sal", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "&"}], "/@", "sa"}], "/", "\[Degree]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dal", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"NumberForm", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", 
               RowBox[{"5", ",", "2"}], "}"}]}], "]"}], "&"}], "/@", 
           RowBox[{"(", 
            RowBox[{"da", "/", "\[Degree]"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tobj", "=", 
          RowBox[{"MakeTVertexFromCreaseVectors", "[", 
           RowBox[{"cv", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"VertexCreasePatternGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"SectorAngleLabels", "\[Rule]", "sal"}], ",", 
           RowBox[{"DihedralAngleLabels", "\[Rule]", "dal"}]}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gfn", "[", "sa1", "]"}], ",", 
         RowBox[{"gfn", "[", "sa2", "]"}], ",", 
         RowBox[{"gfn", "[", "sa3", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594764251233747*^9, 3.594764522225101*^9}, {
