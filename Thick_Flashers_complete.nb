Cell[TextData[{
 "LFFReduction[",
 StyleBox["slist",
  FontSlant->"Italic"],
 "] takes a list of labeled sector angles and returns the full result of the \
reduction."
}], "Text",
 CellChangeTimes->{{3.534594118357281*^9, 3.5345941609703918`*^9}, {
  3.534600163383451*^9, 
  3.534600164086722*^9}},ExpressionUUID->"bbce5bcc-2010-4876-b018-\
abe40e06beee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LFFReduction", "::", "noteven"}], 
   "=", "\"\<The vertex with sectors `1` is not of even degree.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.534592615556073*^9, 3.5345926271281424`*^9}, {
  3.534592658005373*^9, 3.534592669022544*^9}, {3.534594773162179*^9, 
