Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nr", ",", "na", ",", "vfn", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nr", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"na", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", "i", ")"}], 
       RowBox[{"U", "[", 
        RowBox[{"2", "\[Pi]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", "-", "1"}], ")"}], "/", "na"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeQuadMesh", "[", 
       RowBox[{"nr", ",", "na", ",", 
        RowBox[{"VerticesFn", "\[Rule]", "vfn"}], ",", 
        RowBox[{"SamePtTolerance", "\[Rule]", 
         SuperscriptBox["10", 
          RowBox[{"-", "6"}]]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CornerIndices = \>\"", ",", 
       RowBox[{"tobj", "[", "CornerIndices", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
