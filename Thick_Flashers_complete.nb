          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", ".4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", ".4"}], "}"}]}], "}"}], "]"}], ",", "Green", 
           ",", 
           RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
