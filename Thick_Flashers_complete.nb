Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Gamma]b", ",", "\[Gamma]l", ",", "\[Phi]b", ",", "\[Phi]l", ",", 
      "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]l", "=", 
      RowBox[{"135.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]l", "=", 
      RowBox[{"0.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]b", "=", 
      RowBox[{"60.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]b", "=", 
      RowBox[{"90.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RigidlyFoldableSingleVertexQuadMesh", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Phi]b", ",", "\[Gamma]b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]l", ",", "\[Gamma]l"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.692472905998848*^9, 3.69247290854755*^9}, {
   3.692472963626645*^9, 3.692473080378449*^9}, {3.692475117711043*^9, 
