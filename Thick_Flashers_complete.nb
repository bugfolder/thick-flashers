Cell["Example. Flatten a cone, given a curve on the cone.", "Text",
 CellChangeTimes->{{3.801771767347474*^9, 
  3.801771779923306*^9}},ExpressionUUID->"ad2e6983-f582-484d-a9ed-\
8db8bb75e420"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "s", ",", "\[Theta]", ",", "as", ",", "bb", ",", "dd", ",", "\[Sigma]", ",",
      "ui", ",", "bi", ",", "ti", ",", "b", ",", "d", ",", "u0", ",", "u1", ",",
      "v0", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"as", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]", ">", "0"}], ",", 
       RowBox[{"\[Theta]", "<", 
        RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"bb", "=", 
     RowBox[{"Functionize", "[", 
      RowBox[{"s", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
          RowBox[{"Cos", "[", "s", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "s", "]"}]}]}], "}"}]}], "]"}]}], ";", 
    RowBox[{"dd", "=", 
     RowBox[{"Functionize", "[", 
      RowBox[{"s", ",", 
       RowBox[{"-", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
           RowBox[{"Cos", "[", "s", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], 
           RowBox[{"Sin", "[", "s", "]"}]}]}], "}"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\[Sigma]", "=", 
     RowBox[{"+", "1"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], "=", 
     RowBox[{"FlattenGeneric2D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
       RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
       RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], "//", 
      "PrettyParameters"}], "//", "Print"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u0", ",", "u1"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v0", ",", "v1"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[Theta]", "=", 
     RowBox[{"30.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"b", ",", "d", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"b", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}]}], "}"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"bb", ",", "dd", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"bb", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}]}], "}"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], "}"}], "]"}], "/.", 
     
     RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.801771784711421*^9, 3.8017719472530003`*^9}, {
  3.801772004669875*^9, 3.801772286547858*^9}, {3.801772318948017*^9, 
