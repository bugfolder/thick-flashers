Cell["\<\
Returns: the curve speed function as an InterpolatingFunction.\
\>", "Text",
 CellChangeTimes->{{3.691580464686341*^9, 3.6915804751913853`*^9}, {
   3.691598323976247*^9, 3.691598326279619*^9}, {3.691598733581491*^9, 
