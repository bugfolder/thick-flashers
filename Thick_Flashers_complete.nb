Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeYoshimuraMiuraOri", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "25."}], "\[Degree]"}], ",", 
          RowBox[{"30.", "\[Degree]"}], ",", 
          RowBox[{
           RowBox[{"-", "35."}], "\[Degree]"}], ",", " ", 
          RowBox[{
           RowBox[{"-", "40."}], "\[Degree]"}], ",", 
          RowBox[{"45.", "\[Degree]"}], ",", 
          RowBox[{
           RowBox[{"-", "50."}], "\[Degree]"}]}], "}"}], ",", "2", ",", 
        RowBox[{"45.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CornerIndices = \>\"", ",", 
       RowBox[{"tobj", "[", "CornerIndices", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.642342377994834*^9, 3.6423424797633467`*^9}, 
   3.64234273613871*^9, {3.6423470989658003`*^9, 3.642347112114673*^9}, 
   3.642347149903425*^9, {3.642347252416106*^9, 3.642347266622445*^9}, {
   3.6423474022803392`*^9, 3.642347427111785*^9}, {3.642347494175829*^9, 
   3.642347498058632*^9}, 3.642591302761884*^9, {3.642592056973795*^9, 
   3.642592057405753*^9}, {3.642602026595006*^9, 3.6426020286065493`*^9}, {
   3.642602923249135*^9, 3.6426029506859922`*^9}, {3.642603009810288*^9, 
   3.642603069882086*^9}, {3.642603232622262*^9, 3.642603244169175*^9}, {
   3.642603661274134*^9, 3.642603688302428*^9}, {3.642610747499104*^9, 
   3.642610763147192*^9}, 3.642614131278701*^9, 3.64323942981465*^9},
 CellLabel->
  "In[2535]:=",ExpressionUUID->"5cd85c86-2360-4b96-acc7-66d5988a422d"],

Cell[TextData[{
 "MakeYoshimuraMiuraOri[\[Alpha], {",
 StyleBox["runs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}, \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraph3D+TAssigned+TCornerIndices that represents a \
Yoshimura-Miura ori where\n\t\[Alpha] is the acute sector angle common to all \
stripes\n\t",
 StyleBox["runs",
  FontSlant->"Italic"],
 " is a list, each entry of which specifies the number of columns for which \
the diagonal folds in that column have the same fold direction.\n\t",
 StyleBox["nv",
  FontSlant->"Italic"],
 " is the number of rows in the pattern.\n\t\[Gamma] is the signed fold angle \
of the horizontal folds in the first column\nThe fold pattern is a series of \
vertical stripes of rectangles, each of which is crossed by a diagonal fold \
that slopes upward or downward at angle \[Alpha]. The slope is determined by \
the requirements of flat-foldability at the vertices and the values in ",
 StyleBox["hlist",
  FontSlant->"Italic"],
 ". A run of consecutive ",
 StyleBox["hlist",
  FontSlant->"Italic"],
 " values that are the same gives rise to a Yoshimura pattern; alternating \
values gives the Miura-ori pattern. Options are:\n\tOptions[FoldGraph3D] are \
passed through. (See, e.g., StationaryFace.)"
}], "Text",
 CellChangeTimes->{{3.642340248926059*^9, 3.64234027629237*^9}, {
   3.642341082519075*^9, 3.642341253780287*^9}, {3.64234133776624*^9, 
   3.642341340776283*^9}, {3.642341377874543*^9, 3.642341401621662*^9}, {
   3.642341454664818*^9, 3.64234160359496*^9}, {3.642345988888227*^9, 
   3.642346019983223*^9}, {3.642347326132826*^9, 3.642347350975942*^9}, 
   3.642591019066684*^9, {3.642591192569651*^9, 3.642591216330982*^9}, {
   3.642591672369001*^9, 3.642591827171427*^9}, {3.642601966803692*^9, 
   3.642601983073469*^9}, 3.64260344077828*^9, {3.642603753269054*^9, 
   3.642603755982464*^9}, {3.6426235189480953`*^9, 3.642623519315555*^9}, {
   3.643239713842353*^9, 
   3.643239718042015*^9}},ExpressionUUID->"b95b367a-a36e-429a-a12e-\
1649cbd7ba8a"],

Cell[TextData[{
 "Here\[CloseCurlyQuote]s an example of the ",
 StyleBox["runs",
  FontSlant->"Italic"],
 " parameter: an entry {2,3} would have 2 columns of InitialMinorFoldSign, \
followed by 3 columns of the opposite sign."
}], "Text",
 CellChangeTimes->{{3.642592124110511*^9, 3.64259217608873*^9}, {
  3.642603451798275*^9, 
  3.642603460163048*^9}},ExpressionUUID->"ad22143e-f6b0-4e1f-b2e0-\
ee87c1852031"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeYoshimuraMiuraOri", "[", 
   RowBox[{"\[Alpha]_", ",", 
    RowBox[{"{", 
     RowBox[{"runs_List", ",", "nv_"}], "}"}], ",", "\[Gamma]_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hlist", ",", "nh", ",", "dv", ",", "gp", ",", "verts", ",", "edges", ",",
       "foldangles", ",", "types", ",", "tbase", ",", "tilt", ",", "asign", ",",
       "ibl", ",", "ibr", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hlist", "=", 
      RowBox[{
       RowBox[{"Sign", "[", "\[Gamma]", "]"}], " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], 
             RowBox[{"i", "-", "1"}]], ",", 
            RowBox[{"{", 
             RowBox[{
             "runs", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "runs", "]"}]}], "}"}]}], "]"}], "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"nh", "=", 
      RowBox[{"Length", "[", "hlist", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"number", " ", "of", " ", "columns"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dv", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"Tan", "[", "\[Alpha]", "]"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"height", " ", "of", " ", "each", " ", "column"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gp", "=", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       RowBox[{"ArcCot", "[", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Alpha]", "]"}], 
         RowBox[{"Cot", "[", 
          RowBox[{"\[Gamma]", "/", "2"}], "]"}]}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"signed", " ", "major", " ", "fold", " ", "angle"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"build", " ", "a", " ", "grid", " ", "of", " ", "vertices"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"j", " ", "dv"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "nh"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "nv"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"foldangles", "=", 
       RowBox[{"types", "=", 
        RowBox[{"{", "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "edges", " ", "and", " ", "fold", " ", "angles"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"left", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"j", "+", "1"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", "0"}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", "B"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"each", " ", "full", " ", "column"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"bottom", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "-", "1"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}]}], ",", 
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"(", "i", ")"}], 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}]}]}], "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", "0"}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", "B"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "column", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"tbase", " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[Equal]", "1"}], ",", 
           RowBox[{"Sign", "[", "\[Alpha]", "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
              "hlist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               "\[Equal]", 
              RowBox[{"hlist", "\[LeftDoubleBracket]", 
               RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{"-", "tbase"}], ",", "tbase"}], "]"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"tilt", " ", "of", " ", "bottom", " ", "row"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"asign", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "\[Equal]", "1"}], ",", 
           RowBox[{"Sign", "[", "\[Gamma]", "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
              "hlist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               "\[Equal]", 
              RowBox[{"hlist", "\[LeftDoubleBracket]", 
               RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}]}], ",", 
             "asign", ",", 
             RowBox[{"-", "asign"}]}], "]"}]}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"sign", " ", "of", " ", "fold", " ", "angles"}], " ", "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ibl", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "-", "1"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}], "+", "j"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
            "index", " ", "of", " ", "bottom", " ", "left", " ", "corner"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"ibr", "=", 
            RowBox[{"ibl", "+", 
             RowBox[{"(", 
              RowBox[{"1", "+", "nv"}], ")"}]}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
            "index", " ", "of", " ", "bottom", " ", "right", " ", "corner"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"(*", " ", "diagonal", " ", "*)"}], "\[IndentingNewLine]", 
           
           RowBox[{"tilt", "=", 
            RowBox[{"tbase", "*", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"j", ",", "2"}], "]"}], "\[Equal]", "1"}], ",", "1", 
               ",", 
               RowBox[{"-", "1"}]}], "]"}]}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"tilt", " ", "within", " ", "this", " ", 
               RowBox[{"cell", ":", " ", 
                RowBox[{"+", "1"}]}]}], "=", "up"}], ",", " ", 
             RowBox[{
              RowBox[{"-", "1"}], "=", "down"}]}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"edges", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"tilt", ">", "0"}], ",", 
               RowBox[{"{", 
                RowBox[{"ibl", ",", 
                 RowBox[{"ibr", "+", "1"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ibl", "+", "1"}], ",", "ibr"}], "}"}]}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"foldangles", ",", 
             RowBox[{"asign", "*", "gp"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"types", ",", 
             RowBox[{"Switch", "[", 
              RowBox[{
               RowBox[{"Sign", "[", 
                RowBox[{"asign", "*", "gp"}], "]"}], ",", "1", ",", "V", ",", 
               
               RowBox[{"-", "1"}], ",", "M", ",", "0", ",", "U"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"top", " ", "of", " ", "cell"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"edges", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ibr", "+", "1"}], ",", 
               RowBox[{"ibl", "+", "1"}]}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"foldangles", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"j", "\[Equal]", "nv"}], ",", "0", ",", 
               RowBox[{"asign", "*", "\[Gamma]"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"types", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"j", "\[Equal]", "nv"}], ",", "B", ",", 
               RowBox[{"Switch", "[", 
                RowBox[{
                 RowBox[{"Sign", "[", 
                  RowBox[{"asign", "*", "\[Gamma]"}], "]"}], ",", "1", ",", 
                 "V", ",", 
                 RowBox[{"-", "1"}], ",", "M", ",", "0", ",", "U"}], "]"}]}], 
              "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"right", " ", "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"edges", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"nh", 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}], "+", "j"}], ",", 
            RowBox[{
             RowBox[{"nh", 
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}]}], "+", "j", "+", "1"}]}], 
           "}"}]}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"foldangles", ",", "0"}], "]"}], ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"types", ",", "B"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"MakeTGraph", "[", 
          RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], "//", 
        RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
       RowBox[{"AddTCornerIndices", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"nv", "+", "1"}], ")"}], "nh"}], "+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"nv", "+", "1"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nv", "+", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"nh", "+", "1"}], ")"}]}]}], "}"}]}], "}"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"FoldGraph3D", "[", 
      RowBox[{"tobj", ",", "foldangles", ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.642341639382946*^9, 3.642341717581852*^9}, {
   3.642341849742863*^9, 3.642341868648898*^9}, {3.642342237346209*^9, 
   3.642342361287148*^9}, {3.64234245984105*^9, 3.642342516792337*^9}, {
   3.642342552335288*^9, 3.642342674763942*^9}, {3.642342712743418*^9, 
   3.642342864402365*^9}, {3.642343342755734*^9, 3.642343410930844*^9}, {
   3.6423434638315067`*^9, 3.642343581650497*^9}, {3.642343618677451*^9, 
   3.6423436657528057`*^9}, {3.642343702326556*^9, 3.642343772569965*^9}, {
   3.6423438067316008`*^9, 3.642343852546088*^9}, {3.642343889123172*^9, 
