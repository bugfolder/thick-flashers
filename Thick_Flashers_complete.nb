Cell[CellGroupData[{

Cell["Fold a planar curve", "Subsection",
 CellChangeTimes->{{3.799783426382321*^9, 3.799783429406335*^9}, {
  3.801649563623358*^9, 3.801649566839552*^9}, {3.801657769264922*^9, 
  3.801657770909938*^9}},ExpressionUUID->"c4c6e211-3fd3-40e4-b873-\
68397f641690"],

Cell[CellGroupData[{

Cell[TextData[{
 "FoldCurvedFold3D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rR",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ffi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions"
}], "Subsubsection",
 CellChangeTimes->{{3.79944274677419*^9, 3.799442797151381*^9}, 
   3.799442988715061*^9, {3.799443047908704*^9, 3.799443049650156*^9}, 
   3.799493644969708*^9, 3.799530296596841*^9, 3.801658243886314*^9, 
   3.80399532693297*^9},ExpressionUUID->"44bdb59f-e114-46a1-919e-\
031095f51313"],

Cell[TextData[{
 "CurvedFoldFrom 2D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrR",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ffi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbti",
  FontSlant->"Italic"],
 "}, opts] takes a 2D ruled neighborhood of a fold and constructs the 3D \
folded form."
}], "Text",
 CellChangeTimes->{{3.799443038645782*^9, 3.799443087820142*^9}, 
   3.80399533112372*^9},ExpressionUUID->"b586aa52-62d5-41e3-8fa1-\
a12f378d0dd4"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the 2D curved fold as a vector-valued function.\n\t",
 StyleBox["rL",
  FontSlant->"Italic"],
 " \[LongDash] the left ruling vector in the plane, as a vector-valued \
function.\n\t",
 StyleBox["rR",
  FontSlant->"Italic"],
 " \[LongDash] the right ruling vector in the plane, as a vector-valued \
function.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value parameter.\n\t",
 StyleBox["\[Gamma]i",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the fold angle.\n\t",
 StyleBox["ffi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position in 3D of the curved fold.\n\t",
 StyleBox["tti",
  FontSlant->"Italic"],
 " \[LongDash] the initial tangent vector in 3D of the curved fold.\n\t",
 StyleBox["bbti",
  FontSlant->"Italic"],
 " \[LongDash] the initial top-side binormal vector of the fold, which lies \
halfway between the left and right sides of the fold."
}], "Text",
 CellChangeTimes->{{3.79951259049842*^9, 3.799512745723276*^9}, {
  3.803995082563644*^9, 
  3.803995097322464*^9}},ExpressionUUID->"fc2e59a3-480c-4146-a4f8-\
f29dbe8fe67d"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
   3.6912356648227*^9}, {3.691696354142725*^9, 3.6916963964564757`*^9}, {
   3.6916967872943177`*^9, 3.6916967876341476`*^9}, 3.691697514251375*^9, {
   3.691697597209193*^9, 3.69169762262678*^9}, {3.6916979883579497`*^9, 
   3.691698005633368*^9}, 3.691698253142771*^9, 3.691921636608643*^9, 
   3.6919216713298798`*^9, 3.691921758889015*^9, 
   3.79944345041487*^9},ExpressionUUID->"484f05ae-6117-4758-8abb-\
8250beb10cda"],

Cell[TextData[{
 "Returns: the 3D ruled neighborhood {",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrR",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.79944272256857*^9, 3.799442736259595*^9}, {
  3.799443369626952*^9, 
  3.799443378481267*^9}},ExpressionUUID->"d4c52749-9dab-4fda-8745-\
792ef4776aab"],

