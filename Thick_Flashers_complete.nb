Cell[BoxData[
 RowBox[{
  RowBox[{"StdVertexLabels", "[", 
   RowBox[{"verts_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "vl", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vl", "=", 
      RowBox[{
       RowBox[{"VertexLetter", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StdVertexLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Point", "[", 
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          "]"}], ",", 
         RowBox[{"LabelPt", "[", 
          RowBox[{
           SubscriptBox["vl", "i"], ",", 
           RowBox[{"verts", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.462967988941257*^9, 3.462968018157255*^9}, 
   3.462968058425187*^9, {3.465988148886633*^9, 3.4659882403059*^9}, {
