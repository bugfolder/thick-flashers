Cell[BoxData[
 RowBox[{
  RowBox[{"NSpaceCurveFold3D", "[", 
   RowBox[{
    RowBox[{"ff_Function", "|", "ff_InterpolatingFunction"}], ",", 
    RowBox[{"\[Gamma]_Function", "|", "\[Gamma]_InterpolatingFunction"}], ",",
     "\[FinalSigma]_", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "csys", ",", "ds", ",", "tt", ",", "nn", ",", "bb", ",", "llL",
       ",", "uuL", ",", "duuL", ",", "mduuL", ",", "c\[Rho]L", ",", 
      "s\[Rho]L", ",", "rrL", ",", "llR", ",", "uuR", ",", "duuR", ",", 
      "mduuR", ",", "c\[Rho]R", ",", "s\[Rho]R", ",", "rrR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Get", " ", "the", " ", "Frenet", " ", "frame", " ", "of", " ", "the", " ",
       "curve"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"csys", "=", 
      RowBox[{"NCurve3DSystem", "[", 
       RowBox[{"ff", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
         "BinormalVector3D"}], "}"}], "/.", "csys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"llL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[FinalSigma]", " ", 
          RowBox[{"Cos", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "+", 
         RowBox[{"\[FinalSigma]", " ", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[FinalSigma]"}], " ", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "+", 
         RowBox[{"\[FinalSigma]", " ", 
          RowBox[{"Cos", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuL", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mduuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"duuL", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"duuL", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
         FractionBox[
          RowBox[{
           RowBox[{"duuL", "[", "s", "]"}], ".", 
           RowBox[{"llL", "[", "s", "]"}]}], 
          RowBox[{"mduuL", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"duuL", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         RowBox[{"mduuL", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c\[Rho]L", "[", "s", "]"}], 
          RowBox[{"tt", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"s\[Rho]L", "[", "s", "]"}], " ", 
          RowBox[{"llL", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"llR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[FinalSigma]", " ", 
          RowBox[{"Cos", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "-", 
         RowBox[{"\[FinalSigma]", " ", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[FinalSigma]", " ", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "+", 
         RowBox[{"\[FinalSigma]", " ", 
          RowBox[{"Cos", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uuR", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mduuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"duuR", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"+", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"duuR", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
         FractionBox[
          RowBox[{
           RowBox[{"duuR", "[", "s", "]"}], ".", 
           RowBox[{"llR", "[", "s", "]"}]}], 
          RowBox[{"mduuR", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"duuR", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         RowBox[{"mduuR", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c\[Rho]R", "[", "s", "]"}], 
          RowBox[{"tt", "[", "s", "]"}]}], "-", 
         RowBox[{
          RowBox[{"s\[Rho]R", "[", "s", "]"}], " ", 
          RowBox[{"llR", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.799443499854664*^9, 3.799443551389594*^9}, {
