            RowBox[{"Length", "[", "medges2", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"V", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Length", "[", "vedges1", "]"}], "+", 
            RowBox[{"Length", "[", "vedges2", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{"B", ",", 
          RowBox[{"{", 
           RowBox[{"Length", "[", "bedges", "]"}], "}"}]}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "we", " ", "may", " ", "still", " ", "have", " ", "orphan", " ", 
       "vertices", " ", "that", " ", "got", " ", "merged", " ", "out", " ", 
