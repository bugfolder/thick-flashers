94f984656e1c"],

Cell[CellGroupData[{

Cell[TextData[{
 "RecalcFoldAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph3D"
}], "Subsubsection",
 CellChangeTimes->{{3.6256890736102343`*^9, 3.625689079887717*^9}, {
  3.625689241215046*^9, 3.6256892426856427`*^9}, {3.625689281779255*^9, 
  3.625689294890546*^9}},ExpressionUUID->"ca55a277-56ad-4e22-be05-\
bc26d5811048"],

Cell[TextData[{
 "RecalcFoldAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] computes the fold angles from the current 3D embedding and reassigns the \
FoldAngles property."
}], "Text",
 CellChangeTimes->{{3.625689121526347*^9, 3.625689129180697*^9}, {
  3.6256892712763586`*^9, 3.625689279595361*^9}, {3.625689416419364*^9, 
  3.625689430426148*^9}},ExpressionUUID->"ac206f9b-9daa-4b1f-a587-\
f1e6f7086a94"],

Cell["\<\
Note: if you\[CloseCurlyQuote]re calculating fold angles and there are \
\[PlusMinus]180\[Degree] folds in the enbedding, then there could be sign \
errors in the fold angle, since there\[CloseCurlyQuote]s no local way locally \
to unambiguously determine the parity of the crease assignment. If we have a \
crease assignment (as part of a TAssignedGraph, see below), then we can more \
accurately set the FoldAngles by using the TweakFoldAngles function (below) \
and the hinting that comes from the EdgeType assignments.\
\>", "Text",
 CellChangeTimes->{{3.625664864772839*^9, 3.625665111293787*^9}, {
   3.625686615213643*^9, 3.6256866239490128`*^9}, {3.626463368072513*^9, 
   3.6264633696710863`*^9}, {3.650050652610607*^9, 3.650050678104439*^9}, 
   3.673096624065056*^9},ExpressionUUID->"c7368389-a206-4609-af86-\
7255bd287abc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RecalcFoldAngles", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj1", ",", "fa"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "RecalcFoldAngles"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", "tobj", ",", 
        RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"EdgeFaceAngles3D", "[", "tobj1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"FoldAngles", "\[Rule]", "fa"}], "]"}]}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.625689462008995*^9, 3.625689650663474*^9}, {
   3.625689884882217*^9, 3.625689889642577*^9}, {3.6256899482300262`*^9, 
   3.625689970244649*^9}, 3.626459164733339*^9, 3.708400177928171*^9, 
   3.70860365692438*^9},
 CellLabel->
  "In[1456]:=",ExpressionUUID->"c960c19d-3aab-472f-a386-3f3d874db2d4"],

Cell["\<\
Example: a simple 3D Z-fold. We provide the embedding initially, then \
recalculate the fold angles.\
\>", "Text",
 CellChangeTimes->{{3.625686349158016*^9, 3.625686355925044*^9}, {
  3.6256897656634*^9, 3.625689768597575*^9}, {3.62568999146361*^9, 
  3.625690006846835*^9}},ExpressionUUID->"c25b3a18-9762-42e4-9bb8-\
b9560d5f5df6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
