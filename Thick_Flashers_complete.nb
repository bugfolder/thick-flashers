   3.485107905377616*^9, 3.485107909575193*^9}, {3.59173190628308*^9, 
   3.591731933050378*^9}, {3.592402063758072*^9, 3.592402069307009*^9}, {
   3.59243226431621*^9, 3.592432265012067*^9}, {3.592788385076652*^9, 
