Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"FoldVectors", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["g", "1"], ",", " ", 
      SubscriptBox["g", "2"], ",", " ", "..."}]}]}], TraditionalForm]],
  ExpressionUUID->"cfb05792-1311-4227-b57d-bc44e5895ec7"],
 "} is a ",
 "TObj",
 " property that specifies the 3D dihedral vectors (vectors along the \
creases, i.e., normalized versions of the input vectors) in the folded form."
}], "Text",
 CellChangeTimes->{{3.592076734681664*^9, 3.592076829460827*^9}, 
