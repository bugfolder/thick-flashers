889223a36e8f"],

Cell[TextData[{
 "CanonicalDevelopableSystem[",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs the canonical form functions for a developable surface from an \
arbitrary directrix and director. Can handle cylinders, cones, and tandevs."
}], "Text",
 CellChangeTimes->{
  3.689848430490718*^9, {3.689848485584676*^9, 3.689848525024648*^9}, {
