      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
        "&"}], "/@", 
       RowBox[{"BoundingBoxGC", "/@", "objs"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"z", "-", "extents"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"hets", "=", 
