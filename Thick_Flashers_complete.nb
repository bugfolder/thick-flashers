          RowBox[{"lb", "-", 
           RowBox[{
           "la", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"lb", "+", "dc"}], ",", 
          RowBox[{"do", "+", "dc"}]}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"end", " ", "access"}], ",", " ", 
