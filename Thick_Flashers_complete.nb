   3.48482907485862*^9, 3.484928180021619*^9, {3.591728570760003*^9, 
   3.591728635843073*^9}, {3.591728669125439*^9, 3.59172867251812*^9}, 
   3.591731511660696*^9, {3.592432931244089*^9, 3.5924329479051743`*^9}, {
   3.5924358563345747`*^9, 3.592435856426075*^9}, {3.592828711596292*^9, 
