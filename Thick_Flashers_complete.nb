Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"SectorVectors", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["a", "1"], ",", " ", 
      SubscriptBox["a", "2"], ",", " ", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"bb36be63-8f39-4ddc-b079-bf5e1b2b214d"],
 " is a ",
 "TObj",
 " property that specifies the sector vectors (normals to the sector planes) \
on the Gaussian sphere.\t"
}], "Text",
 CellChangeTimes->{{3.592076681287437*^9, 3.592076721707712*^9}, 
   3.592435753263131*^9},ExpressionUUID->"f3688a40-084f-40fa-b1eb-\
