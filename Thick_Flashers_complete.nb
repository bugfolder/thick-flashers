Cell[TextData[{
 "MultipleGoreData[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "] returns the same type of list as SingleGoreData, but now each element of \
the return list consists of all ",
 StyleBox["m",
  FontSlant->"Italic"],
 " gores."
}], "Text",
