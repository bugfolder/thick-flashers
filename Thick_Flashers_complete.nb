Cell[TextData[{
 "VertexPlaneInequalityConstraints[",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p,u",
  FontSlant->"Italic"],
 "] creates constraint equations that binds a vertex to a half-space defined \
by a plane."
}], "Text",
 CellChangeTimes->{{3.701257222575521*^9, 3.7012572787374296`*^9}, {
   3.701257484371029*^9, 3.701257486346444*^9}, {3.7012581406174192`*^9, 
