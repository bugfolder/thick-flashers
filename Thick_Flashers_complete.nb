Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PrincipalDirections", "::", "usage"}], 
   "=", "\"\<PrincipalDirections is a key to the rules returned by \
SurfaceSystem that gives the two principal directions of curvature of the \
surface.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.687479437826728*^9, 3.687479481921304*^9}, {
   3.688136180596376*^9, 3.688136193573352*^9}, {3.688137309664379*^9, 
