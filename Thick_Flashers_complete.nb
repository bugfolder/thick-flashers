Cell[CellGroupData[{

Cell["Generic graphs", "Section",
 CellChangeTimes->{{3.7202990525721498`*^9, 3.720299054570323*^9}, {
   3.825866484128624*^9, 3.825866485424841*^9}, 
   3.825866591033044*^9},ExpressionUUID->"79ac5d27-95a0-41e4-8461-\
12cfc2f9976f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.720299237804257*^9, 
  3.720299238285054*^9}},ExpressionUUID->"eb548c49-f77c-4a8b-a4cd-\
53c5fa79b9f1"],

Cell["\<\
A \[OpenCurlyDoubleQuote]generic graph\[CloseCurlyDoubleQuote] is described \
by a list of vertices and edge index pairs and, optionally, a list of faces. \
Functions in this section take combinations of these lists as their arguments.\
\>", "Text",
 CellChangeTimes->{{3.720299239751115*^9, 3.720299269980338*^9}, {
  3.8258664928329077`*^9, 3.825866497881112*^9}, {3.825866623978245*^9, 
  3.8258666385221777`*^9}},ExpressionUUID->"f5415d20-5caf-4b05-9675-\
a516b6b8b2eb"],

Cell["\<\
Yes, I know that Mathematica now has a built-in Graph object that has its own \
functionality for rendering, manipulations, etc. But we set all this up \
before the native Graph came along. We\[CloseCurlyQuote]ll make use of native \
functions where we can.\
\>", "Text",
 CellChangeTimes->{{3.720299295538374*^9, 
  3.720299335329775*^9}},ExpressionUUID->"bfacbe89-3606-408d-af75-\
8954b3734025"]
}, Closed]],

Cell[CellGroupData[{

Cell["Graph rendering building blocks", "Subsection",
 CellChangeTimes->{{3.457532625166312*^9, 3.457532627636432*^9}, 
   3.457714582801889*^9, {3.45792030839484*^9, 3.4579203099449453`*^9}, {
   3.533602735534203*^9, 3.533602759019087*^9}, 3.533645923627716*^9, {
   3.594080176035823*^9, 3.594080191737583*^9}, {3.59472552739952*^9, 
   3.594725536990768*^9}, {3.594734169096971*^9, 
   3.594734191550791*^9}},ExpressionUUID->"f6ee251b-fc0f-4e31-a695-\
0c17d27c6710"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457796187655018*^9, 
  3.457796188078433*^9}},ExpressionUUID->"7b9233c5-6015-4f9c-9086-\
b13e9ab80f58"],

Cell["\<\
Functions useful for creating visual representations of graphs (and \
tessellations).\
\>", "Text",
 CellChangeTimes->{{3.4577961821552887`*^9, 
  3.45779618485472*^9}},ExpressionUUID->"852ec6c1-3318-4fa3-8439-\
37ca541237c5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "LabelPt[",
 StyleBox["lbl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.4576131362793303`*^9, 3.457613146580385*^9}, {
   3.457613589540312*^9, 3.457613598483789*^9}, 
   3.471290353260549*^9},ExpressionUUID->"e8f15e9d-92ac-4564-bfac-\
591dc1282fb5"],

Cell[TextData[{
 "LabelPt[",
 StyleBox["lbl, p, r",
  FontSlant->"Italic"],
 "] puts a string label ",
 StyleBox["lbl ",
  FontSlant->"Italic"],
 "next to a point ",
 StyleBox["p",
  FontSlant->"Italic"],
 ". Optional value ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the normalized distance from point ",
 StyleBox["p. In 2D, t",
  FontSlant->"Italic"],
 "he position of the label is always closer to the origin than the point, \
which insures that labels for points at the edge of a graph are not cut off \
by the clip rectangle. Points located at the origin are put to the right of \
the point. In 3D, there\[CloseCurlyQuote]s a fixed offset because the point \
of view can vary dynamically."
}], "Text",
 CellChangeTimes->{{3.457613467240385*^9, 3.457613470377139*^9}, {
  3.4712899680884037`*^9, 3.4712899736379347`*^9}, {3.4712901038453283`*^9, 
  3.4712901173321953`*^9}, {3.471290328119129*^9, 3.471290331973402*^9}, {
  3.471290537722042*^9, 3.471290545159541*^9}, {3.471290921582456*^9, 
  3.471290923078183*^9}, {3.591974531609717*^9, 3.591974533016333*^9}, {
  3.591974828075994*^9, 3.591974867033378*^9}, {3.5919749729880037`*^9, 
  3.591974974866411*^9}},ExpressionUUID->"a24c5b87-0ef5-4c33-8268-\
345a219920d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LabelPt", "[", 
   RowBox[{"lbl_", ",", "p_", ",", 
    RowBox[{"r_", ":", "1.5"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Mag", "[", "p", "]"}], "\[Equal]", "0"}], " ", "||", 
     RowBox[{
      RowBox[{"Length", "[", "p", "]"}], "\[NotEqual]", "2"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Text", "[", 
     RowBox[{"lbl", ",", "p", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "r"}], ",", "0"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", "else", " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"Text", "[", 
     RowBox[{"lbl", ",", "p", ",", 
      RowBox[{"r", " ", 
       RowBox[{"NormalizeReal", "[", "p", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.47129000733906*^9, 3.471290100250842*^9}, {
   3.4712901940338*^9, 3.4712903209480467`*^9}, {3.471290568081696*^9, 
   3.471290625430458*^9}, {3.4712906730114*^9, 3.4712906825933*^9}, {
   3.591974672636725*^9, 3.591974696331279*^9}, {3.591974789436994*^9, 
   3.5919747964512672`*^9}, {3.591974888532112*^9, 3.591974928489299*^9}, {
   3.591974979927243*^9, 3.591975002317004*^9}, 3.701092773560456*^9},
 CellLabel->
  "In[880]:=",ExpressionUUID->"cd2e811a-0c4d-4015-9ac2-c09faeb3ab9d"],

Cell["Example: 2D points.", "Text",
 CellChangeTimes->{{3.45761329462271*^9, 3.457613295316926*^9}, 
   3.471290454401794*^9, {3.591974603866946*^9, 
   3.591974625826267*^9}},ExpressionUUID->"5f46b582-b550-4b01-a0c4-\
a5d3efba6a5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p0", ",", "p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p0", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", 
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], ";", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}]}], ";", 
     RowBox[{"p3", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], ";", 
     RowBox[{"p4", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Gray", ",", 
        RowBox[{"Point", "/@", 
         RowBox[{"{", 
          RowBox[{"p0", ",", "p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}],
         ",", "Black", ",", "\[IndentingNewLine]", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p0\>\"", ",", "p0"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p1\>\"", ",", "p1"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p2\>\"", ",", "p2"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p3\>\"", ",", "p3"}], "]"}], ",", 
        RowBox[{"LabelPt", "[", 
         RowBox[{"\"\<p4\>\"", ",", "p4"}], "]"}]}], "}"}], "]"}]}]}], "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.457613296629635*^9, 3.457613455369594*^9}, 
   3.471290137179636*^9, {3.471290339534869*^9, 3.4712903432957153`*^9}, {
   3.471290698363265*^9, 3.471290722476707*^9}, {3.589466020303685*^9, 
   3.589466024432211*^9}},
 CellLabel->
  "In[881]:=",ExpressionUUID->"4816ad2a-c92f-4d49-83de-b89f79613777"],

Cell["Example: 3D points.", "Text",
 CellChangeTimes->{{3.45761329462271*^9, 3.457613295316926*^9}, 
   3.471290454401794*^9, {3.591974603866946*^9, 
   3.591974617753715*^9}},ExpressionUUID->"2a7db9f0-aaa1-42e3-b5c7-\
d6b7ef58853b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p0", ",", "p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p0", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], ";", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], ";", 
     RowBox[{"p3", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";", 
