c148813ee337"],

Cell[TextData[{
 "AddTGraph3DTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph and sets its Vertices3D to have x- and y-coordinates taken \
from Vertices and z-coordinate 0 and all FoldAngles set to 0."
}], "Text",
