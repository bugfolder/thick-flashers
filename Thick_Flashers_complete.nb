Cell[CellGroupData[{

Cell[TextData[{
 "LabelPtStr[",
 StyleBox["pstr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.471289430619142*^9, 3.47128945817697*^9}, 
   3.47128970428053*^9, {3.471290782903417*^9, 3.4712907899186974`*^9}, {
   3.47129123010708*^9, 3.471291230480694*^9}, {3.591975053027105*^9, 
   3.591975059859714*^9}},ExpressionUUID->"298ef7f3-3fbb-4059-91c1-\
65555ce59006"],

Cell[TextData[{
 "LabelPtStr",
 "[",
 StyleBox["pstr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] takes a string pstr that describes a point and uses pstr as the label for \
the point located at the position obtained by evaluating pstr as an \
expression. It's a nice shorthand tool for labeling points in a schematic."
}], "Text",
 CellChangeTimes->{{3.471289603887299*^9, 3.471289662355302*^9}, 
   3.47128970430005*^9},ExpressionUUID->"e5216463-5f43-4ab8-851b-\
f9e5f962fec7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LabelPtStr", "[", 
   RowBox[{"pstr_", ",", " ", 
    RowBox[{"r_", ":", "1.5"}]}], "]"}], ":=", 
  RowBox[{"LabelPt", "[", 
   RowBox[{"pstr", ",", 
    RowBox[{"ToExpression", "[", "pstr", "]"}], ",", "r"}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.471289459998837*^9, 3.471289489779086*^9}, {
   3.471289522789143*^9, 3.471289534333439*^9}, 3.471289704317654*^9},
 CellLabel->
