Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "angles", ",", "side", ",", "is", ",", "w", ",", "\[Tau]", ",", "ip", ",",
       "ctype1", ",", "ctype2", ",", "types1", ",", "types2", ",", "tiling"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"75", "\[Degree]"}], ",", 
        RowBox[{"85", "\[Degree]"}], ",", 
        RowBox[{"95", "\[Degree]"}], ",", 
        RowBox[{"105", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"side", "=", "1.2"}], ";", "\[IndentingNewLine]", 
