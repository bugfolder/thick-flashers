Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FuzzPoints", "[", 
         RowBox[{"pts", ",", "0"}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{"no", " ", "fuzzing"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"FuzzPoints", "[", 
         RowBox[{"pts", ",", ".1"}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{"fuzzing", ",", " ", 
          RowBox[{"by", " ", "vertex"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"FuzzPoints", "[", 
         RowBox[{"pts", ",", ".1", ",", 
          RowBox[{"FuzzSeed", "\[Rule]", "1"}]}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"fuzzing", " ", "by", " ", "vertex"}], ",", " ", 
          RowBox[{"different", " ", "seed"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"FuzzPoints", "[", 
         RowBox[{"pts", ",", ".1", ",", 
          RowBox[{"FuzzMethod", "\[Rule]", "FuzzByGroup"}]}], "]"}]}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{"all", " ", "same"}], " ", "*)"}], "\[IndentingNewLine]", 
       "}"}], "//", "ColumnForm"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.708344863368435*^9, 3.708344933680738*^9}, {
