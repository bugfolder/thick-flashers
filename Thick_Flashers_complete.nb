Cell[CellGroupData[{

Cell["\<\
FoldedFormScaleRotation[\[Gamma], \[Alpha]]
FoldedFormScale[\[Gamma], \[Alpha]]
FoldedFormRotation[\[Gamma], \[Alpha]]\
\>", "Subsubsection",
 CellChangeTimes->{{3.46612042180369*^9, 3.466120433737096*^9}, {
  3.466128047906662*^9, 3.466128061841814*^9}, {3.46612824670979*^9, 
  3.466128247334432*^9}, {3.628787059625122*^9, 
  3.628787084244088*^9}},ExpressionUUID->"1278e861-d868-499f-a6f7-\
aca772b07a7d"],

Cell[TextData[{
 "FoldedFormScaleRotation",
 "[\[Gamma], \[Alpha]] returns a pair {",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Phi]} that give proper scaling and rotational orientation to the \
computed folded form when we construct the folded form by reversing the sign \
of \[Alpha]. Specifically, if we construct a crease pattern for values (\
\[Gamma], \[Alpha]), then we can construct the properly scaled and rotated \
folded form by constructing the pattern for (\[Gamma], -\[Alpha]), then \
multiplying it by ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and rotating it through an angle \[Phi]."
}], "Text",
 CellChangeTimes->{{3.466128069571383*^9, 3.466128238270281*^9}, 
   3.533591966717614*^9, 
   3.628787059758723*^9},ExpressionUUID->"71e474e4-414c-4d02-8877-\
e8402bc5b5d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldedFormScaleRotation", "[", 
   RowBox[{"\[Gamma]_", ",", " ", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rcp", ",", "bcp", ",", "rff", ",", "bff"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rcp", ",", "bcp"}], "}"}], "=", 
      RowBox[{"ShrinkAndTwistParms", "[", 
       RowBox[{"\[Gamma]", ",", "\[Alpha]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rff", ",", "bff"}], "}"}], "=", 
      RowBox[{"ShrinkAndTwistParms", "[", 
       RowBox[{"\[Gamma]", ",", 
        RowBox[{"-", "\[Alpha]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rcp", "/", "rff"}], ",", 
       RowBox[{"bcp", "-", "bff"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4661283128634*^9, 3.466128423289475*^9}, {
  3.628787047505175*^9, 3.62878705977918*^9}},
 CellLabel->
  "In[3332]:=",ExpressionUUID->"274af205-4b21-4791-9ac4-955280383299"],

Cell["\<\
FoldedFormScale[\[Gamma], \[Alpha]] returns the factor by which the folded \
form pattern should be multipled to have the proper scale when computed from \
scale-and-rotate.\
\>", "Text",
 CellChangeTimes->{{3.46612044236906*^9, 3.466120476262224*^9}, 
   3.466123478782309*^9, 
   3.628787071407908*^9},ExpressionUUID->"6aef1a8a-842f-4fdb-88a6-\
b0314a48d4d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldedFormScale", "[", 
   RowBox[{"\[Gamma]_", ",", " ", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
  "FoldedFormScaleRotation", "\[LeftDoubleBracket]", "1", 
   "\[RightDoubleBracket]"}]}]], "Input",
 CellChangeTimes->{{3.46612348700233*^9, 3.466123518369483*^9}, {
  3.466128429512302*^9, 3.466128440868829*^9}, {3.628787059816732*^9, 
  3.628787071428266*^9}},
 CellLabel->
  "In[3333]:=",ExpressionUUID->"7cc8acf0-2e9a-4af1-a665-ac07ade8142b"],

Cell["\<\
FoldedFormRotation[\[Gamma], \[Alpha]] returns the angle through which the \
folded form pattern should be rotated so that it matches the crease pattern.\
\>", "Text",
 CellChangeTimes->{{3.46612799944016*^9, 3.466128033347527*^9}, {
   3.466128255373258*^9, 3.466128260116452*^9}, 
   3.6287870843167357`*^9},ExpressionUUID->"0188ac8c-d932-49a4-92e9-\
4915c1461de4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldedFormRotation", "[", 
   RowBox[{"\[Gamma]_", ",", " ", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
  "FoldedFormScaleRotation", "\[LeftDoubleBracket]", "2", 
   "\[RightDoubleBracket]"}]}]], "Input",
 CellChangeTimes->{{3.466128449871543*^9, 3.4661284524628057`*^9}, {
  3.628787059866438*^9, 3.628787084337569*^9}},
 CellLabel->
  "In[3334]:=",ExpressionUUID->"56f171a6-a076-434b-8645-014f6a873338"]
}, Closed]],

Cell[CellGroupData[{

Cell["DualShrinkAndTwistParms[\[Rho], \[Beta]]", "Subsubsection",
 CellChangeTimes->{{3.461844001898019*^9, 3.461844011057473*^9}, 
   3.6287870957844477`*^9},ExpressionUUID->"bcd611bc-f3c4-4978-a0ab-\
6066a6088cac"],

Cell["\<\
DualShrinkAndTwistParms[\[Rho], \[Beta]] returns the shrinkage and rotation \
parameters {\[Rho]\[Rho], \[Beta]\[Beta]} that apply to the dual faces.\
\>", "Text",
 CellChangeTimes->{{3.461843936629241*^9, 3.461843997319436*^9}, 
   3.465911842978324*^9, 
   3.6287870958562818`*^9},ExpressionUUID->"fdbfc36d-65ba-4d2d-8861-\
a22b014cd53d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DualShrinkAndTwistParms", "[", 
   RowBox[{"\[Rho]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    SqrtBox[
     RowBox[{"1", "+", 
      SuperscriptBox["\[Rho]", "2"], "-", 
      RowBox[{"2", " ", "\[Rho]", " ", 
       RowBox[{"Cos", "[", "\[Beta]", "]"}]}]}]], ",", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sign", "[", "\[Beta]", "]"}]}], 
     RowBox[{"ArcCos", "[", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{"\[Rho]", " ", 
         RowBox[{"Cos", "[", "\[Beta]", "]"}]}]}], 
       SqrtBox[
        RowBox[{"1", "+", 
         SuperscriptBox["\[Rho]", "2"], "-", 
         RowBox[{"2", " ", "\[Rho]", " ", 
          RowBox[{"Cos", "[", "\[Beta]", "]"}]}]}]]], "]"}]}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.46184385603398*^9, 3.461843906726003*^9}, 
   3.461844132007744*^9, 3.62878709588007*^9},
 CellLabel->
  "In[3335]:=",ExpressionUUID->"e9fd64ec-ab8c-43c6-a714-407e8dd3d4cc"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Primal-dual twist tessellation angle ranges [IN PROGRESS]", "Subsection",
 CellChangeTimes->{{3.485264550444381*^9, 3.485264561921907*^9}, {
  3.533592006786367*^9, 3.533592014249941*^9}, {3.533605641588243*^9, 
  3.53360564265125*^9}, {3.551746264480229*^9, 3.551746265087521*^9}, {
  3.5922607936065474`*^9, 
  3.5922607970289717`*^9}},ExpressionUUID->"4dc4f43f-ac41-4941-88c7-\
565b441b86a7"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.485264569411908*^9, 
  3.485264569850172*^9}},ExpressionUUID->"8a90bf57-87a6-4927-a1ab-\
89e5095cf03c"],

Cell["\<\
Whether a tessellation can be crease assigned depends on the pleat angle and \
the crease assignment. However, if the pleat angle is sufficiently small, it \
can always be crease assigned. Functions in this section evaluate this \"safe\
\" range of pleat angles.\
\>", "Text",
 CellChangeTimes->{{3.485264572154354*^9, 
  3.485264634010112*^9}},ExpressionUUID->"904050d8-25f2-41d1-9dd9-\
b0aab37ebbdc"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PrimalDualUnsafeTwistAngleRange",
 "[",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pfaces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dfaces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 "] (TBD: rewrite and use functions based on individual twist polygons, also \
use TObj\[CloseCurlyQuote]s)"
}], "Subsubsection",
 CellChangeTimes->{{3.466029426727174*^9, 3.466029458251642*^9}, {
   3.485194537937601*^9, 3.485194556615707*^9}, {3.592242554110613*^9, 
   3.592242573766671*^9}, 3.5925013270157557`*^9, 
   3.628787110875214*^9},ExpressionUUID->"f468aa60-3012-43ca-91a5-\
8a6b4013cbde"],

Cell[TextData[{
 "PrimalDualUnsafeTwistAngleRange",
 "[",
 StyleBox["pverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pfaces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dfaces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bverts",
  FontSlant->"Italic"],
 "] take a primal graph with embedding ",
 StyleBox["pverts",
  FontSlant->"Italic"],
 " and faces ",
 StyleBox["pfaces",
  FontSlant->"Italic"],
 ", and the dual graph embedding ",
 StyleBox["dverts",
  FontSlant->"Italic"],
 " and dual faces ",
 StyleBox["dfaces",
  FontSlant->"Italic"],
 ", and a list of all the boundary vertex indices, and returns the range of \
angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "min"], ",", 
     SubscriptBox["\[Alpha]", "max"]}], "}"}], TraditionalForm]],
  ExpressionUUID->"873649db-115c-4590-acbd-d4512a39574d"],
 " within which a crease assignment may not exist (depending on the twist \
assignment). That is, for pleat angles \[Alpha] *outside* this range, any \
crease assignment always works (at least locally) and the \"standard\" crease \
assignment for the pleat parallelgrams apply. Angle values are returned in \
radians."
}], "Text",
 CellChangeTimes->{{3.466029473981185*^9, 3.466029651415202*^9}, {
   3.466030789945725*^9, 3.466030795632091*^9}, {3.5922422629833097`*^9, 
   3.592242268372061*^9}, 3.592242554183111*^9, 
   3.628787111067572*^9},ExpressionUUID->"6a650372-8db3-478a-abfc-\
c1ec0a7e0c90"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PrimalDualUnsafeTwistAngleRange", "[", 
   RowBox[{
   "pverts_", ",", "pfaces_", ",", "dverts_", ",", "dfaces_", ",", 
    "bverts_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ptriples", ",", "dtriples", ",", "pangles", ",", "dangles", ",", 
      "allangles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ptriples", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", "3"}], "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
               "pverts", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}], ",", 
               RowBox[{"RotateLeft", "[", 
                RowBox[{
                "pverts", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}], "]"}], ",", 
               RowBox[{"RotateLeft", "[", 
                RowBox[{
                 RowBox[{
                 "pverts", "\[LeftDoubleBracket]", "#", 
                  "\[RightDoubleBracket]"}], ",", "2"}], "]"}], ",", "#"}], 
              "}"}], "]"}], ",", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"bverts", ",", 
                RowBox[{
                "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}],
                "]"}]}], "&"}]}], "]"}], "&"}], "/@", "pfaces"}], ")"}]}]}], ";", 
     RowBox[{"dtriples", "=", 
      RowBox[{"First", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "dverts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
            ",", 
            RowBox[{"RotateLeft", "[", 
             RowBox[{
             "dverts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}],
              "]"}], ",", 
            RowBox[{"RotateLeft", "[", 
             RowBox[{
              RowBox[{
              "dverts", "\[LeftDoubleBracket]", "#", 
               "\[RightDoubleBracket]"}], ",", "2"}], "]"}]}], "}"}], "]"}], 
         "&"}], "/@", "dfaces"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pangles", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"RotationAngle", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "-", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
         "]"}], "&"}], "/@", "ptriples"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dangles", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"RotationAngle", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "-", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
         "]"}], "&"}], "/@", "dtriples"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allangles", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"pangles", ",", "dangles", ",", 
        RowBox[{"\[Pi]", "-", "pangles"}], ",", 
        RowBox[{"\[Pi]", "-", "dangles"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", "allangles", "]"}], ",", 
       RowBox[{"Max", "[", "allangles", "]"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
