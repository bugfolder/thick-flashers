Cell[TextData[{
 "FlasherFirstSectorVerticesAll[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 "] returns a list of all of the possible vertex variables of type ",
 StyleBox["v",
  FontSlant->"Italic"],
 " that appear as vertices in the first sector of the specified FlasherLines \
pattern, including vertices in the middle of creases (for h > 1 flashers) and \
vertices with k=\[Dash]1."
}], "Text",
 CellChangeTimes->{{3.55576010984926*^9, 3.555760186476828*^9}, {
   3.555760544037579*^9, 3.55576056198791*^9}, 3.555854310285852*^9, 
