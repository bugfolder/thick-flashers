Cell[TextData[{
 "PolyLine[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["polys",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Shrinkage"
}], "Subsubsection",
 CellChangeTimes->{
  3.462346449354005*^9},ExpressionUUID->"33d8ea8e-c488-4525-9475-\
a8a17b451193"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Shrinkage", "::", "usage"}], 
   "=", "\"\<Shrinkage is an option to PolyLine that describes how much \
smaller the polygon should be than its vertices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591721061868658*^9, 3.591721091469447*^9}},
 CellLabel->
  "In[934]:=",ExpressionUUID->"f5ebf22d-2639-4708-935a-ddde280ad5f2"],

Cell[TextData[{
 "PolyLines[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["polys",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of coordinate values and a set of lists of polygon indices \
and creates a line outlining the polygons, but slightly reduced toward the \
centroid.\nOptions are:\n\tShrinkage\[Rule]s, where s is the factor by which \
each polygon is reduced."
}], "Text",
 CellChangeTimes->{{3.455898451260433*^9, 3.4558984987576733`*^9}, {
   3.45589880285649*^9, 3.455898844896873*^9}, {3.457615281015154*^9, 
   3.457615295891342*^9}, 3.457617856979026*^9, {3.457618225559858*^9, 
   3.4576182471094527`*^9}},ExpressionUUID->"046668f9-0e49-4d22-86be-\
98f00685fb7c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PolyLines", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Shrinkage", "\[Rule]", "0.8"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.4558988852123938`*^9, 3.455898898824851*^9}},
 CellLabel->
  "In[935]:=",ExpressionUUID->"63c1b876-bcb6-4093-b81a-83167a4ec379"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolyLines", "[", 
   RowBox[{"verts_List", ",", "polys_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sh", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sh", "=", 
      RowBox[{
       RowBox[{"Shrinkage", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PolyLines", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Line", "[", 
        RowBox[{"AppendFirst", "[", 
         RowBox[{"ShrinkPoly", "[", 
          RowBox[{
           RowBox[{
           "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], ",",
            "sh"}], "]"}], "]"}], "]"}], "&"}], "/@", "polys"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.455898506002523*^9, 3.455898606344875*^9}, {
   3.455898731020442*^9, 3.4558987553654203`*^9}, {3.455898850994296*^9, 
