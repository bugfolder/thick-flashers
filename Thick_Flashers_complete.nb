      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        RowBox[{"Graph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.706916695527077*^9, 3.706916740076153*^9}, {
  3.706917166977807*^9, 3.706917197643432*^9}, {3.7069173234202023`*^9, 
  3.706917325122617*^9}, {3.706917455885061*^9, 3.706917456420162*^9}, {
  3.706951419293445*^9, 3.706951464084338*^9}, {3.706951717975404*^9, 
  3.706951766728443*^9}},
 CellLabel->
