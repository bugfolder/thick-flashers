Cell[CellGroupData[{

Cell["Solving for developable 3D fold angles", "Subsection",
 CellChangeTimes->{{3.594165759676983*^9, 3.59416577371507*^9}, {
   3.594200883482607*^9, 3.594200885186496*^9}, {3.594228850323195*^9, 
   3.594228850920815*^9}, {3.594309143510386*^9, 3.5943091455492268`*^9}, 
   3.5950089187003593`*^9, {3.595252978990959*^9, 3.595252980701024*^9}, 
   3.595254586996734*^9, {3.6264630845717287`*^9, 
   3.6264630861608543`*^9}},ExpressionUUID->"5b060689-aa62-4e0d-864d-\
8899c31517be"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.5942288554649*^9, 
  3.594228855936532*^9}},ExpressionUUID->"ab5faebb-c9a5-41ea-be72-\
b44a31319e36"],

Cell["\<\
When we take a TGraph into 3D, its folds are no longer simple Mountain, \
Valley, or Unfolded; they can take on arbitrary angular values between -\[Pi] \
and \[Pi]. The fold angles canot be chosen arbitrarily; in order to satisfy \
developability, they need to satisfy the generalized Kawasaki condition at \
each interior vertex. The functions in this section provide the ability to \
solve for self-consistent sets of fold angles for a TGraph.\
\>", "Text",
 CellChangeTimes->{{3.594228859113124*^9, 3.594229020149885*^9}, {
   3.594307753225937*^9, 3.594307754127532*^9}, {3.594725698660408*^9, 
   3.594725707235725*^9}, 3.595254636204022*^9, 
   3.595255032074417*^9},ExpressionUUID->"0bf7b063-e1f7-4a50-afd3-\
379bb6b0a45b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FoldAngleSpecLabels[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faspecs, opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) EdgeIndices, UseDegrees"
}], "Subsubsection",
 CellChangeTimes->{{3.59420108482266*^9, 3.594201097348919*^9}, {
  3.594201155617905*^9, 3.594201168416314*^9}, {3.59421099140123*^9, 
  3.594211020335102*^9}, {3.594212059982217*^9, 3.594212072292278*^9}, {
  3.594218046890306*^9, 3.5942180478580837`*^9}, {3.594308810444436*^9, 
  3.59430881795429*^9}, {3.595286794019664*^9, 
  3.595286795052988*^9}},ExpressionUUID->"2794b260-e2a5-4697-bbb5-\
75736074c7f6"],

Cell[TextData[{
 "FoldAngleSpecGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faspecs, opts",
  FontSlant->"Italic"],
 "] returns a Graphics object that displays the graph with edges labeled by \
the specified fold angle specifications ",
 StyleBox["faspecs",
  FontSlant->"Italic"],
 ", which are a list of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["w", "i"], ",", 
      SubscriptBox["\[Alpha]", "i"]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"fc063c73-679f-4acc-8763-c6aabde1ce63"],
 ", ...}, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "i"], TraditionalForm]],ExpressionUUID->
  "a1f0e280-af40-4040-9f7e-968098f167c5"],
 " is a weight for the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th edge and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],ExpressionUUID->
  "f5faea9f-8bf0-411d-8b5a-4af6cb74f406"],
 " is the associated fold angle. Options are:",
 "\n\tEdgeIndices \[Rule] True | False, specifies whether to display the \
index of the edge on top of the edge.\n\tUseDegrees \[Rule] True | False, \
specifies whether to show the angles in degrees rather than radians."
}], "Text",
 CellChangeTimes->{{3.594201105590796*^9, 3.5942012095505457`*^9}, {
   3.594201330350005*^9, 3.5942013393265953`*^9}, {3.5942090328469152`*^9, 
   3.594209034173389*^9}, {3.5942120696543217`*^9, 3.594212120455955*^9}, {
   3.594218051202243*^9, 3.5942181328212137`*^9}, 
   3.5943088825451813`*^9},ExpressionUUID->"504b4b9f-6ce4-491f-9308-\
9b3f006e361a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FoldAngleSpecLabels", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"EdgeIndices", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"UseDegrees", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.594201302957493*^9, 3.594201317040598*^9}, 
   3.594208999834259*^9, 3.594212134342082*^9, {3.594308820572016*^9, 
   3.5943088250695267`*^9}, 3.594308910585862*^9},
 CellLabel->
