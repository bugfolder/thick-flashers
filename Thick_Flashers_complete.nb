     RowBox[{"(*", " ", "assigned", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"GenericFoldedFormLines", "[", "tobj1", "]"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "\"\<Unassigned\>\""}]}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"GenericFoldedFormLines", "[", "tobj2", "]"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "\"\<Assigned\>\""}]}], "]"}], "/.", 
       
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
