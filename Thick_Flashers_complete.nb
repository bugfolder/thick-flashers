Cell[BoxData[
 RowBox[{
  RowBox[{"UncurlCurveInDevelopableSystem", "[", 
   RowBox[{"ccf_Function", ",", "uuf_Function", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "sfn", ",", "cis3s", ",", "sdf", ",", "kgf", ",", 
      "rc2s"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "UncurlCurveInDevelopableSystem", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "UncurlCurveInDevelopableSystem", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cis3s", "=", 
      RowBox[{"Darboux3DSystemOld", "[", 
       RowBox[{"ccf", ",", "uuf", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sdf", ",", "kgf"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Speed3D", ",", "GeodesicCurvature3D"}], "}"}], "/.", 
       "cis3s"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rc2s", "=", 
      RowBox[{"RecoverCurve2DSystemOld", "[", 
       RowBox[{"kgf", ",", "sdf", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"cis3s", ",", "rc2s"}], "]"}]}]}], "]"}]}]], "Input",
