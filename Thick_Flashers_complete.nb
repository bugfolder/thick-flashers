Cell[CellGroupData[{

Cell[TextData[{
 "FlatFoldabilityExcess[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qlist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.624645258161865*^9, 
  3.624645267568892*^9}},ExpressionUUID->"161a8e49-ec92-4bfc-9fcb-\
28d90cd4ac1f"],

Cell[TextData[{
 "FlatFoldabilityExcess[",
 StyleBox["p, qlist",
  FontSlant->"Italic"],
 "] returns the angular deviation from the Kawasaki-Justin condition. If this \
is zero, the vertex is flat-foldable."
}], "Text",
 CellChangeTimes->{{3.5947571557311*^9, 3.594757182688842*^9}, 
   3.594940835450973*^9, {3.62464527886609*^9, 3.6246452813919888`*^9}, 
   3.624645618122759*^9},ExpressionUUID->"9c7aff77-c75c-4e48-ae5a-\
5507458bf6bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlatFoldabilityExcess", "[", 
   StyleBox[
    RowBox[{"p_List", ",", "qlist_List"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{"Mod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Plus", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationAngle", "[", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "]"}], "&"}], "/@", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "-", "p"}], "&"}], "/@", "qlist"}], ",", "2"}], 
         "]"}]}], ")"}]}], "-", "\[Pi]"}], ",", 
    RowBox[{"2", "\[Pi]"}], ",", 
    RowBox[{"-", "\[Pi]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.594757186180188*^9, 3.594757192786262*^9}, {
   3.594757301132803*^9, 3.594757394718726*^9}, 3.594940835481827*^9, {
   3.624645311793305*^9, 3.624645318207903*^9}, {3.624645358742955*^9, 
   3.624645371483856*^9}, {3.624645445136023*^9, 3.624645508252116*^9}, {
   3.624645588920156*^9, 3.624645722734908*^9}, 3.628786222048149*^9, 
   3.7787490502241898`*^9},
 CellLabel->
  "In[586]:=",ExpressionUUID->"d0540397-cb43-4784-84f1-ffcd11b60b86"],

