Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "o", ",", "verts", ",", "edges", ",", "\[Alpha]2", ",", "\[Alpha]1", ",",
       "gmj", ",", "gmn", ",", "foldangles", ",", "tobj", ",", "tobj1", ",", 
      "tobj2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"crease", " ", "pattern"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"o", "=", "0.2"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"offset", " ", "of", " ", "central", " ", "row"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"o", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "+", "o"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "+", "o"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "+", "o"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "12"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"11", ",", "12"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Get", " ", "sector", " ", "angles"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]1", "=", 
      RowBox[{"RotationAngle", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "8", "\[RightDoubleBracket]"}], "-", 
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}], "-", 
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(1\)]\)/\[Degree] = \>\"",
        ",", 
       RowBox[{"\[Alpha]1", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]2", "=", 
      RowBox[{"RotationAngle", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}], "-", 
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(2\)]\)/\[Degree] = \>\"",
        ",", 
       RowBox[{"\[Alpha]2", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"2", "D", " ", "graph"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges", ",", 
         RowBox[{"{", "}"}]}], "]"}], "//", "AddTPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"flat", " ", "3", "D", " ", "form"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"AddTGraph3D", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"folded", " ", "3", "D", " ", "form"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Choose", " ", "the", " ", "major", " ", "fold", " ", "angle"}], ",", 
       " ", 
       RowBox[{
       "calculate", " ", "the", " ", "minor", " ", "fold", " ", "angle"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gmj", "=", 
      RowBox[{"60.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(major\)]\)/\[Degree] = \
\>\"", ",", 
       RowBox[{"gmj", "/", "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gmn", "=", 
      RowBox[{"2", " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"Sin", "[", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{"(", 
             RowBox[{"\[Alpha]1", "-", "\[Alpha]2"}], ")"}]}], "]"}], 
          RowBox[{"Sin", "[", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{"(", 
             RowBox[{"\[Alpha]1", "+", "\[Alpha]2"}], ")"}]}], "]"}]], 
         RowBox[{"Tan", "[", 
          FractionBox["gmj", "2"], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(minor\)]\)/\[Degree] = \
\>\"", ",", 
       RowBox[{"gmn", "/", "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Set", " ", "the", " ", "edge", " ", "angles"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", 
        RowBox[{"-", "gmn"}], ",", "0", ",", "gmj", ",", "gmj", ",", "0", ",",
         "gmn", ",", "0", ",", 
        RowBox[{"-", "gmj"}], ",", 
        RowBox[{"-", "gmj"}], ",", "0", ",", 
        RowBox[{"-", "gmn"}], ",", "0", ",", "0", ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj1", ",", "foldangles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
