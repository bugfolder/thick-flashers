Cell[TextData[{
 "GetAllRules",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\nGetAllProperties[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.591378535563096*^9, 3.591378571968636*^9}, {
   3.591379261943323*^9, 3.591379267349874*^9}, {3.591380375843889*^9, 
   3.5913803769955053`*^9}, 3.5916370961243362`*^9, {3.591637399341639*^9, 
   3.591637412452173*^9}, {3.591638628057374*^9, 3.5916386319186063`*^9}, 
   3.592427125534645*^9, 3.5926704410776243`*^9, {3.5926705250577507`*^9, 
   3.59267054802231*^9}, {3.5926706363021927`*^9, 3.592670642171023*^9}, 
   3.592670676433934*^9, 3.5926710664838123`*^9, {3.5927078973881197`*^9, 
   3.5927079006550217`*^9}, 3.628786726141334*^9, 
   3.6287867934506*^9},ExpressionUUID->"3bde58e2-dd58-49f8-a6ce-f6e679513323"],

Cell[TextData[{
 "GetAllRules[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] converts ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " to a regular list of rules. Normally, you should use GetValue and \
GetValues (see below) to access a TObj\[CloseCurlyQuote]s property, but ",
 "GetAllRules",
 " is a handy way to see the entire contents of a TObj. We also use it in \
some legacy examples where Tessellatica 1 used lists of rules."
}], "Text",
 CellChangeTimes->{{3.5913784231484003`*^9, 3.59137844848098*^9}, {
   3.591378495758061*^9, 3.591378496093727*^9}, {3.592347289788472*^9, 
   3.5923473559425797`*^9}, 3.592435729895569*^9, {3.5926704332095203`*^9, 
   3.592670433261006*^9}, {3.5926706291304812`*^9, 3.592670629209969*^9}, {
   3.592671066545982*^9, 3.592671066613446*^9}, 3.592707923934802*^9, 
   3.594211686546416*^9, {3.6287867262464337`*^9, 3.628786726315474*^9}, {
   3.628786793544534*^9, 
   3.628786793630043*^9}},ExpressionUUID->"f16e575a-1d43-4d61-aba2-\
658f8aff6d21"],

