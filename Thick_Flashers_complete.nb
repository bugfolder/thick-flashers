Cell[TextData[{
 "TwoCycleCriticalTwistAngles[",
 StyleBox["plist",
  FontSlant->"Italic"],
 "] returns the angular range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "min"], ",", 
     SubscriptBox["\[Alpha]", "max"]}]}], TraditionalForm]],ExpressionUUID->
  "00f18c6c-c085-4301-88af-7a17ee580170"],
 "} between which there is a 2-cycle overlap between some pair of edges in \
the polygon ",
 StyleBox["plist",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.627497752764758*^9, 3.627497828169616*^9}, {
  3.62749786772199*^9, 3.627497900509591*^9}, {3.627499256686692*^9, 
  3.627499268997582*^9}, {3.627499301931741*^9, 3.627499336770604*^9}, {
  3.627499405636975*^9, 3.627499406429365*^9}, {3.627499681404904*^9, 
  3.6274997205612392`*^9}, {3.6274999434038477`*^9, 
  3.627499969729388*^9}},ExpressionUUID->"7cc83f7f-4822-4513-af65-\
d5d8e9bdf556"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoCycleCriticalTwistAngles", "[", "plist_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "ipairs", ",", "apairs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "plist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ipairs", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", "j"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"n", "-", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"i", "+", "2"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"n", ",", 
              RowBox[{"n", "+", "i", "-", "2"}]}], "]"}]}], "}"}]}], "]"}], ",",
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"apairs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"TwoCycleCriticalTwistAngles", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+",
               "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "+",
                 "1"}], ",", "n", ",", "1"}], "]"}], 
             "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], "&"}], "/@", 
       "ipairs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           "]"}]}], "}"}], "&"}], "[", 
      RowBox[{"Transpose", "[", "apairs", "]"}], "]"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.627499886889738*^9, 3.627499923207949*^9}, {
  3.627499977508484*^9, 3.627499983972032*^9}, {3.627500206027563*^9, 
  3.627500257758563*^9}, {3.627500298240089*^9, 3.6275003804192257`*^9}, {
