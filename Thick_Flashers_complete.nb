 CellLabel->
  "In[2291]:=",ExpressionUUID->"2ca5bfb3-5cee-4704-ab1f-8698a1ab81db"],

Cell[TextData[{
 "Example. A general non-flat-foldable vertex that binds on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "39b6f032-f5e4-4aa0-bae8-7a428111a83f"],
 ". Compare the minor-first and major-first versions for the same angles."
}], "Text",
