Cell[BoxData[
 RowBox[{
  RowBox[{"LocalFaceOrdering", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "edges", ",", "types", ",", "faces", ",", "sf", ",", "fc", ",", "iedges",
       ",", "dedges", ",", "erules", ",", "detypes"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "types", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "EdgeTypes", ",", "Faces"}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sf", "=", 
      RowBox[{
       RowBox[{"FaceupFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "LocalFaceOrdering", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{
       RowBox[{"Sign", "[", "sf", "]"}], "*", 
       RowBox[{"TwoColorGraph", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"StartFace", "\[Rule]", 
          RowBox[{"Abs", "[", "sf", "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"iedges", ",", "dedges"}], "}"}], "=", 
      RowBox[{"OrientedInteriorEdgePairs", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"erules", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", 
          RowBox[{"{", 
           RowBox[{"edges", ",", "types"}], "}"}]}], "]"}], ",", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Reverse", "/@", "edges"}], ",", "types"}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"detypes", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"dedges", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "/.", "erules"}], "&"}], "/@", "iedges"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"fc", "\[LeftDoubleBracket]", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], "&"}], "/@", "dedges"}]}], "}"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "dual", " ", "graph", " ", "edges", " ", "with", " ", "fold", " ", 
       "types", " ", "and", " ", "color"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[Equal]",
            "1"}], "\[Xnor]", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "===",
            "M"}]}], ",", 
         RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         ",", 
         RowBox[{"Reverse", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}]}], "]"}], "&"}], "/@", "detypes"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.484781429625506*^9, 3.484781483668462*^9}, {
   3.484781550939665*^9, 3.484781551457332*^9}, 3.484781665498341*^9, {
   3.484781792008179*^9, 3.484781863327761*^9}, {3.484781903267929*^9, 
   3.484781929273302*^9}, {3.484782432936131*^9, 3.484782451286713*^9}, {
   3.484782842926651*^9, 3.484782855068776*^9}, 3.484783117956416*^9, {
   3.484783371020174*^9, 3.484783377003989*^9}, {3.4847834152400093`*^9, 
   3.48478353643616*^9}, {3.484783601848737*^9, 3.484783616374629*^9}, {
   3.484783672926202*^9, 3.4847836844932947`*^9}, 3.484783745637507*^9, {
   3.484784529722266*^9, 3.484784598053409*^9}, {3.484784650371312*^9, 
