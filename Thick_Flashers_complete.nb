         RowBox[{"{", "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "obj", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ExtractStyleArgs", "[", 
      RowBox[{"obj", ",", 
       RowBox[{"ShowSample", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.708018908466289*^9, 3.708019042149253*^9}, {
   3.7080190733131533`*^9, 3.708019093894459*^9}, 3.70801915420796*^9, {
