Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyMerge3DTo", "[", 
   RowBox[{"tobj_TObj", ",", "tglist_List", ",", "mgdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vlist", ",", "elist", ",", "verts3d", ",", "vertslist", ",", "angles", ",",
       "anglelist", ",", "medges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vlist", ",", "elist"}], "}"}], "=", "mgdata"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Create", " ", "Vertices3D", " ", "from", " ", "subgraphs"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", 
          RowBox[{"tobj", "[", "Vertices", "]"}], "]"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vertslist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "Vertices3D", "]"}], "&"}], "/@", "tglist"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#1", "\[NotEqual]", "0"}], ",", 
            RowBox[{
             RowBox[{
             "verts3d", "\[LeftDoubleBracket]", "#1", 
              "\[RightDoubleBracket]"}], "=", "#2"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "vlist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "vertslist", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Create", " ", "FoldAngles", " ", "from", " ", "subgraphs"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", 
          RowBox[{"tobj", "[", "Edges", "]"}], "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"anglelist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "FoldAngles", "]"}], "&"}], "/@", "tglist"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#1", "\[NotEqual]", "0"}], ",", 
            RowBox[{
             RowBox[{
             "angles", "\[LeftDoubleBracket]", "#1", 
              "\[RightDoubleBracket]"}], "=", "#2"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "elist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "anglelist", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "merged", " ", "edges", " ", "and", " ", "reassign", " ", 
       "their", " ", "FoldAngle", " ", "to", " ", "0."}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"medges", "=", 
      RowBox[{"GetMergedEdges", "[", "elist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "angles", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "=",
          "0"}], ")"}], "&"}], "/@", "medges"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "And", " ", "add", " ", "the", " ", "Vertices3D", " ", "and", " ", 
       "EdgeTypes", " ", "to", " ", "the", " ", "TGraph"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"AddTGraph3D", "[", 
       RowBox[{"verts3d", ",", "angles"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707909657216565*^9, 3.7079096969101152`*^9}, {
   3.707909730821075*^9, 3.707909815012155*^9}, {3.707909857121476*^9, 
