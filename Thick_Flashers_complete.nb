Cell[CellGroupData[{

Cell[TextData[{
 "EdgeVertexAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.626460049615485*^9, 3.6264600541786957`*^9}, {
   3.626460154166882*^9, 3.62646015486858*^9}, 
   3.626461241200854*^9},ExpressionUUID->"e8a2e0f7-4861-4d32-b695-\
ea8688c4564a"],

Cell[TextData[{
 "EdgeVertexAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of the four sector angles around both vertices of all of \
the edges, of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{"i", ",", "r"}]], ",", " ", 
         SubscriptBox["\[Alpha]", 
          RowBox[{"i", ",", "l"}]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{"j", ",", "r"}]], ",", 
         SubscriptBox["\[Alpha]", 
          RowBox[{"j", ",", "l"}]]}], "}"}]}], "}"}], ",", " ", 
     "\[Ellipsis]"}], "}"}], TraditionalForm]],ExpressionUUID->
  "3a499601-79e9-47ad-809c-ce9dc4f7b897"],
 ", where each list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", 
        RowBox[{"i", ",", "r"}]], ",", " ", 
       SubscriptBox["\[Alpha]", 
        RowBox[{"i", ",", "l"}]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", 
        RowBox[{"j", ",", "r"}]], ",", 
       SubscriptBox["\[Alpha]", 
        RowBox[{"j", ",", "l"}]]}], "}"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"65acc9a7-29e2-488a-a6b2-f5675c2163cd"],
 " applies to edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], TraditionalForm]],ExpressionUUID->
  "e3202988-1a24-48ce-852b-332cbacc9b42"],
 " of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", and angle ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{"i", ",", "r"}]], TraditionalForm]],ExpressionUUID->
  "c0e5ed89-8e41-4f79-aabc-9da9da452f94"],
 " lies to the right of vertex ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", as viewed from the edge, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{"i", ",", "l"}]], TraditionalForm]],ExpressionUUID->
  "605dfafc-b7fb-4b14-9eed-7f21fde2c0f9"],
 " lies to its left, and similarly for the other two angles. Or, \
equivalently, for each edge, the first angle lies CCW of the first vertex, \
and then the angles circulate CCW about the edge."
}], "Text",
 CellChangeTimes->{{3.626460113028257*^9, 3.6264601145375557`*^9}, {
  3.6264601585835247`*^9, 3.626460191214245*^9}, {3.626460715385646*^9, 
  3.626460738303229*^9}, {3.626460872049326*^9, 3.626461114959526*^9}, {
  3.626462684428374*^9, 
  3.6264627168507757`*^9}},ExpressionUUID->"6bdb8da3-1704-4c9f-a148-\
987be8b3874c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeVertexAngles", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "edges", ",", "vei", ",", "vea", ",", "ia", ",", "ib", ",", "veaa", ",", 
      "veab"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "vei"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "VertexEdgeIncidence"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vea", "=", 
      RowBox[{"VertexEdgeAngles", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ia", ",", "ib"}], "}"}], "=", 
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"veaa", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{
           "vea", "\[LeftDoubleBracket]", "ia", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "ia", "\[RightDoubleBracket]"}],
                ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}],
           "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "edge", " ", "angles", " ", "around", " ", "vertex", " ", "ia"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"veab", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{
           "vea", "\[LeftDoubleBracket]", "ib", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "ib", "\[RightDoubleBracket]"}],
                ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}],
           "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "edge", " ", "angles", " ", "around", " ", "vertex", " ", "ib"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "veaa", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"veaa", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "veab", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"veab", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
         "}"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.626461149608427*^9, 3.626461235540138*^9}, {
  3.626461280984852*^9, 3.626461303775401*^9}, {3.626461505608955*^9, 
