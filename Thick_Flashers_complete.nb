Cell[TextData[{
 "NFoldSurfaceToCylinder[",
 StyleBox["b1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd1",
  FontSlant->"Italic"],
 ", {p2i",
 StyleBox[", d2i, pp2i, dd2i}",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] finds the fold and developable surface that matches a cone to a specified \
developable surface over an interval using interpolationg functions."
}], "Text",
 CellChangeTimes->{{3.801503112628154*^9, 3.801503173065975*^9}, 
   3.80150346283514*^9, 3.801590629180255*^9, {3.80165881223181*^9, 
