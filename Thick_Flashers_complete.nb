   3.5336594309739523`*^9}, {3.533659500010126*^9, 3.533659518192474*^9}, 
   3.533659557079628*^9, {3.592128563769618*^9, 3.5921285736790037`*^9}, 
   3.592214217299579*^9, 3.592670440130505*^9, 3.592670635349693*^9, 
   3.592671074664198*^9, {3.593089700994355*^9, 3.593089721739573*^9}, 
   3.6298475055480003`*^9, 3.688996830874831*^9},
 CellLabel->
