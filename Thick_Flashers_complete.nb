 StyleBox["verts3d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["face",
  FontSlant->"Italic"],
 "] returns the face normal vector for a CCW face on a 3D vertex embedding."
}], "Text",
 CellChangeTimes->{{3.591982810310042*^9, 3.591982858700534*^9}, 
   3.592380676237111*^9},ExpressionUUID->"559395ea-3f52-418e-a1fd-\
ffc6292c8d87"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceNormal3D", "[", 
   RowBox[{"verts3d_List", ",", "face_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "c", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{"FaceCentroid", "[", 
       RowBox[{"verts3d", ",", "face"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"NormalizeReal", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"verts3d", "\[LeftDoubleBracket]", 
          RowBox[{
          "face", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
          "\[RightDoubleBracket]"}], "-", "c"}], ")"}], "\[Cross]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"verts3d", "\[LeftDoubleBracket]", 
          RowBox[{
          "face", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
          "\[RightDoubleBracket]"}], "-", "c"}], ")"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.591982869723916*^9, 3.591982879647914*^9}, {
   3.59198291598598*^9, 3.591982963783327*^9}, {3.591983325752371*^9, 
