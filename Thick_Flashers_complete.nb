  3.6299213403589077`*^9}},ExpressionUUID->"4b3a847f-de22-4700-8efb-\
8d47d4269a74"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "tpatch", ",", "w", ",", "\[Tau]", ",", "types", ",", 
      "patch"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tpatch", "=", 
      RowBox[{"ArchimedeanPatch", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<patch = \>\"", ",", 
       RowBox[{"tpatch", "//", "ColumnForm"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"70", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"M", ",", "M", ",", "M"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"V", ",", "V", ",", "V"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"patch", "=", 
      RowBox[{"UnitRegularPolygonCenteredTwistPatch", "[", 
       RowBox[{"tpatch", ",", "w", ",", "\[Tau]", ",", "types"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<patch = \>\"", ",", 
       RowBox[{"patch", "//", "ColumnForm"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"EmbedTiling", "[", 
         RowBox[{"patch", ",", 
          RowBox[{"{", 
           RowBox[{"CreasePattern", ",", "Tiling"}], "}"}]}], "]"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
