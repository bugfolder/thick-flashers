Cell[CellGroupData[{

Cell[TextData[{
 "BarycentricIntersection3D[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{
  3.726094986584016*^9, {3.732459917076013*^9, 
   3.732459925268991*^9}},ExpressionUUID->"8bf6766c-4ff5-4dff-910e-\
a1059860cdc6"],

Cell[TextData[{
 "BarycentricClosest3D[{",
 StyleBox["p1, p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}] gives the barycentric coordinates of the point in the plane of triangle \
{",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "} that intersects the line passing through ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["p2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.726093439936491*^9, 3.726093511441364*^9}, {
  3.726093771248693*^9, 3.7260937775805*^9}, {3.726093810364339*^9, 
  3.7260938120926332`*^9}, {3.726094835476316*^9, 3.7260948362998943`*^9}, {
  3.7324599428748503`*^9, 3.732459977366354*^9}, {3.732460226609808*^9, 
  3.732460228787022*^9}},ExpressionUUID->"94cbca38-f434-4670-a3f1-\
f01cd78de8ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BarycentricIntersection3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_List", ",", "p2_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q_List", ",", "r_List", ",", "s_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "z", ",", "qt", ",", "rt", ",", "st", ",", "t", ",", "eqns", ",", 
      "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"eqns", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"qt", " ", "q"}], " ", "+", " ", 
          RowBox[{"rt", " ", "r"}], " ", "+", " ", 
          RowBox[{"st", " ", "s"}], "  ", "-", " ", 
          RowBox[{"(", 
           RowBox[{"p1", "+", 
            RowBox[{"t", 
             RowBox[{"(", 
              RowBox[{"p2", "-", "p1"}], ")"}]}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"qt", "+", "rt", "+", "st", "-", "1"}], "}"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"eqns", ",", 
         RowBox[{"{", 
          RowBox[{"qt", ",", "rt", ",", "st", ",", "t"}], "}"}]}], "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qt", ",", "rt", ",", "st"}], "}"}], "/.", "soln"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.726093358951878*^9, 3.72609339622506*^9}, {
   3.726093430977074*^9, 3.726093447962716*^9}, {3.726093514233244*^9, 
   3.726093695363957*^9}, {3.72609374310091*^9, 3.726093766477351*^9}, {
   3.726094158536968*^9, 3.726094210199978*^9}, 3.726094814197673*^9, {
   3.732459986163477*^9, 3.732460050192386*^9}},
