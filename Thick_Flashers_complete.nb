Cell[TextData[{
 "FoldSurfaceToCylinder[",
 StyleBox["b1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd1",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb2}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] finds the fold and developable surface that matches a cone to a specified \
developable surface."
}], "Text",
 CellChangeTimes->{{3.801503112628154*^9, 3.801503173065975*^9}, 
   3.80150346283514*^9, 3.801590629180255*^9, 
   3.801682150874774*^9},ExpressionUUID->"c2208010-a4ec-4544-a7c2-\
5f97d46cb5fd"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b1",
  FontSlant->"Italic"],
 " \[LongDash] 2D directrix of the first surface.\n\t",
 StyleBox["d1",
  FontSlant->"Italic"],
 " \[LongDash] 2D director of the first surface.\n\t",
 StyleBox["bb1",
  FontSlant->"Italic"],
 " \[LongDash] 3D directrix of the first surface.\n\t",
 StyleBox["dd1",
  FontSlant->"Italic"],
 " \[LongDash] 3D director of the first surface.\n\t",
 StyleBox["p2i",
  FontSlant->"Italic"],
 " \[LongDash] a point on the 2D directrix\n\t",
 StyleBox["d2i",
  FontSlant->"Italic"],
 " \[LongDash] the 2D constant director\n\t",
 StyleBox["pp2i",
  FontSlant->"Italic"],
 " \[LongDash] a point in the plane of the 3D directrix\n\t",
 StyleBox["dd2i",
  FontSlant->"Italic"],
 " \[LongDash] the 3D constant director"
}], "Text",
 CellChangeTimes->{{3.801503207744983*^9, 3.801503296475118*^9}, {
  3.80168208693235*^9, 3.801682133908819*^9}, {3.801909904580352*^9, 
