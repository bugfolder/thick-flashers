Cell[TextData[{
 "Styled3DAxes[",
 StyleBox["xmax",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ymax",
  FontSlant->"Italic"],
 ", ",
 StyleBox["zmax",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a list of Graphics3D primitives that render 3D axes that start \
at the origin."
}], "Text",
