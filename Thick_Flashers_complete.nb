Cell[TextData[{
 "MakeTMiuraMarsOri[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2, d3, d4",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}] does the same thing as MakeTMiuraMarsOri[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 "}], but makes all the ",
 StyleBox["dlist1",
  FontSlant->"Italic"],
 " distances equal to ",
 StyleBox["d1 ",
  FontSlant->"Italic"],
 "alternating with",
 StyleBox[" d3",
  FontSlant->"Italic"],
 " (",
 StyleBox["nh",
  FontSlant->"Italic"],
 " repeats total) and all the ",
 StyleBox["dlist2",
  FontSlant->"Italic"],
 " distances equal to ",
 StyleBox["d2",
  FontSlant->"Italic"],
 " alternating with ",
 StyleBox["d4",
  FontSlant->"Italic"],
 " (",
 StyleBox["nv",
  FontSlant->"Italic"],
 " repeats total)."
}], "Text",
 CellChangeTimes->{{3.442882672893553*^9, 3.4428828116669903`*^9}, {
