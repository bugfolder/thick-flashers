Cell[CellGroupData[{

Cell["Pleated polygons", "Subsection",
 CellChangeTimes->{{3.67508780310778*^9, 3.675087807688442*^9}, 
   3.708400972688428*^9},ExpressionUUID->"5ecf38c6-6134-487b-980d-\
ade8173a8c8a"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.675087820009944*^9, 
  3.675087820414363*^9}},ExpressionUUID->"c56166e2-9946-426c-8038-\
9272841b1bfd"],

Cell["\<\
A pleat-reduced polygon is one in which the sides have been inset, but the \
total perimeter remains the same, so that excess edge is gathered into \
\[OpenCurlyDoubleQuote]flanges\[CloseCurlyDoubleQuote] that consist of two \
counterpropating lines. These types of polygons arise in rotational solids, \
and also in twist-joined tubes.\
\>", "Text",
 CellChangeTimes->{{3.675087826226365*^9, 3.6750879026619*^9}, {
  3.675369878366461*^9, 
  3.6753699735021667`*^9}},ExpressionUUID->"9447031d-0352-4c94-933c-\
6a03d7bc64ea"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PleatReducePolygon",
 "[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PleatDirection"
}], "Subsubsection",
 CellChangeTimes->{{3.675088139085926*^9, 3.67508815086946*^9}, 
   3.6751064839628053`*^9, 
   3.675106553997443*^9},ExpressionUUID->"aae1d4d9-013c-4b20-b84e-\
3444a69c009c"],

Cell[TextData[{
 "PleatReducePolygon[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ",",
 StyleBox[" r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a discrete 2D polygon and returns a pleated version of the polygon \
of a smaller size with the same total length. Arguments are:\n\t",
 StyleBox["pts",
  FontSlant->"Italic"],
 " \[LongDash] a list of the points of the polygon.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the reduction factor. Should be <1.\nIt returns a list of \
twice as many points. Options are:\n\tPleatDirection \[Rule] CCW | CW, \
specifies the direction that the pleats point rotating about the centroid."
}], "Text",
 CellChangeTimes->{{3.675088132055251*^9, 3.6750881347584863`*^9}, {
   3.675088171366165*^9, 3.6750882454717*^9}, {3.675088279567758*^9, 
   3.675088299300651*^9}, 3.675106484001845*^9, 3.675106554041185*^9, {
   3.675370031257985*^9, 
   3.675370046537673*^9}},ExpressionUUID->"c5bfc8e8-48b8-4db3-9e9e-\
c73fc0701470"],

Cell["Each line of the ", "Text",
 CellChangeTimes->{{3.675370000668263*^9, 
  3.675370004523994*^9}},ExpressionUUID->"4f0e7b73-aff6-4128-b7ee-\
5e10c4221fdf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PleatDirection", "::", "usage"}], 
   "=", "\"\<PleatDirection is an option to PleatReducePolygon the specifies \
the direction that the pleats point in the reduction.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.675088098247498*^9, 3.675088124617227*^9}, 
   3.675106484024175*^9, 3.6751065540668087`*^9},
 CellLabel->
  "In[464]:=",ExpressionUUID->"068800ac-b5b6-436d-aa6f-b7cc6a03719d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PleatReducePolygon", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PleatDirection", "\[Rule]", "CCW"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.6750880346422663`*^9, 3.67508805205377*^9}, 
   3.675106484045092*^9, 3.67510655408984*^9},
 CellLabel->
  "In[465]:=",ExpressionUUID->"1e74a1f6-804d-42c5-b41b-72ae625d8359"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PleatReducePolygon", "[", 
   RowBox[{"pts_List", ",", "r_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pd", ",", "rp", ",", "rm"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"pd", "=", 
      RowBox[{
       RowBox[{"PleatDirection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PleatReducePolygon", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rp", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "r"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rm", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "r"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"pd", "===", "CCW"}], ",", "\[IndentingNewLine]", 
       RowBox[{"RotateRight", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"r", "#1"}], ",", 
                RowBox[{
                 RowBox[{"r", "#1"}], "+", 
                 RowBox[{"rp", 
                  RowBox[{"(", 
                   RowBox[{"#2", "-", "#1"}], ")"}]}]}]}], "}"}], "&"}], ",", 
             
             RowBox[{"{", 
              RowBox[{"pts", ",", 
               RowBox[{"RotateLeft", "[", "pts", "]"}]}], "}"}]}], "]"}], ",",
            "1"}], "]"}], ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"r", "#2"}], "+", 
               RowBox[{"rp", 
                RowBox[{"(", 
                 RowBox[{"#1", "-", "#2"}], ")"}]}]}], ",", 
              RowBox[{"r", "#2"}]}], "}"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"pts", ",", 
             RowBox[{"RotateLeft", "[", "pts", "]"}]}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.675087913001404*^9, 3.67508791747055*^9}, {
   3.675088056438965*^9, 3.6750880927080083`*^9}, {3.675088327388063*^9, 
   3.6750883965897503`*^9}, {3.675088451965502*^9, 3.6750884641355543`*^9}, {
   3.675088671158581*^9, 3.6750887642883987`*^9}, {3.675088825254903*^9, 
   3.675088871985688*^9}, 3.6751064840667*^9, {3.675106554113441*^9, 
   3.675106554130767*^9}, {3.675369799171388*^9, 3.675369816137542*^9}},
 CellLabel->
  "In[466]:=",ExpressionUUID->"b43684cb-cdf5-45a3-8d9a-dd97703f895c"],

Cell["\<\
Example. Reductions of a square. The RGB colored vertices are the first three \
vertices in each list.\
\>", "Text",
 CellChangeTimes->{{3.675369472022365*^9, 
  3.675369503307453*^9}},ExpressionUUID->"adac2156-5ce2-4ff8-a0c7-\
a6ee32df6c7c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "pts1", ",", "pts2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{"DiscreteCircle", "[", "4", "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts1", "=", 
      RowBox[{"PleatReducePolygon", "[", 
       RowBox[{"pts", ",", "0.5"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts2", "=", 
      RowBox[{"PleatReducePolygon", "[", 
       RowBox[{"pts", ",", "0.5", ",", 
        RowBox[{"PleatDirection", "\[Rule]", "CW"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"AppendFirst", "[", "pts1", "]"}], "]"}], ",", "Gray"}],
             "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"Take", "[", 
               RowBox[{"pts1", ",", "3"}], "]"}], "]"}], ",", "Black", ",", 
             RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", 
              RowBox[{
              "pts1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "]"}], ",", "Red", ",", 
             RowBox[{"PointSize", "[", ".04", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", 
              RowBox[{
              "pts1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "]"}], ",", "Green", ",", 
             RowBox[{"PointSize", "[", ".04", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", 
              RowBox[{
              "pts1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
              "]"}], ",", "Blue", ",", 
             RowBox[{"PointSize", "[", ".04", "]"}]}], "]"}]}], "}"}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"AppendFirst", "[", "pts2", "]"}], "]"}], ",", "Gray"}],
             "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"Take", "[", 
               RowBox[{"pts2", ",", "3"}], "]"}], "]"}], ",", "Black", ",", 
             RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", 
              RowBox[{
              "pts2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "]"}], ",", "Red", ",", 
             RowBox[{"PointSize", "[", ".04", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", 
              RowBox[{
              "pts2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "]"}], ",", "Green", ",", 
             RowBox[{"PointSize", "[", ".04", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", 
              RowBox[{
              "pts2", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
              "]"}], ",", "Blue", ",", 
             RowBox[{"PointSize", "[", ".04", "]"}]}], "]"}]}], "}"}], 
         "]"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6753695062437468`*^9, 3.675369763302338*^9}},
 CellLabel->
  "In[467]:=",ExpressionUUID->"c8dec99b-b47c-41c0-8251-56534c9989d8"],

