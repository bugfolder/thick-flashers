   TraditionalForm]],ExpressionUUID->"9c584e23-20d3-4817-9e95-ccb623c5ac9f"],
 " is a TObj property that specifies the dihedral angles around a vertex. \
Each angle lies in the range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"a30a1d0c-b284-464d-8369-54f5320ec97d"],
 ". By convention, sector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],ExpressionUUID->
  "cac9bd3d-f19c-4df4-b33c-2e9514df2abe"],
 " lies between dihedral ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "i"], TraditionalForm]],ExpressionUUID->
  "f7e6480b-7932-4158-9ffb-f34f85bc2e47"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "9428b56a-17ed-4bdc-bbf5-c90378184878"],
 "."
}], "Text",
 CellChangeTimes->{{3.592076394786401*^9, 3.592076460301359*^9}, {
   3.592076495066163*^9, 3.592076533643237*^9}, 3.592435752921059*^9, 
