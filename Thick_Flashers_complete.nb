     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", " ", "V", ",", "U"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraphAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", 
        RowBox[{"{", "}"}], ",", "types"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ColumnForm", "[", 
      RowBox[{"GetAllRules", "[", "tobj", "]"}], "]"}]}]}], 
