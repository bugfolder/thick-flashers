Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRadialPotWedge", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PotGapHalfAngle", "\[Rule]", "0"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"PotFlatFlangeInset", "\[Rule]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PotBorder", "\[Rule]", "PotPlanar"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.594585510168417*^9, 3.594585535065568*^9}, {
   3.650111007110558*^9, 3.650111018261142*^9}, {3.65028920525263*^9, 
   3.650289221386045*^9}, 3.650303085809967*^9},
 CellLabel->
  "In[3464]:=",ExpressionUUID->"8acc401a-593a-4f8a-aed4-f250a4accb8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeRadialPotWedge", "::", "badpts"}], 
   "=", "\"\<Point list `1` is not strictly monontonically increasing or \
