        RowBox[{
        "show", " ", "and", " ", "label", " ", "all", " ", "of", " ", "the", " ",
          "points", " ", "around", " ", "the", " ", "two", " ", "lines", " ", 
         "generating", " ", "the", " ", 
         RowBox[{"hinge", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v1", ",", "v4"}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v2", ",", "v3"}], "}"}], "]"}]}], "}"}], ",", 
           "Black"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", 
            RowBox[{"{", 
             RowBox[{"v1", ",", "v2", ",", "v3", ",", "v4"}], "}"}]}], ",", 
           "Black", ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{"#1", ",", "#2", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "0"}], "}"}]}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                
                RowBox[{"\"\<v1\>\"", ",", "\"\<v2\>\"", ",", "\"\<v3\>\"", 
                 ",", "\"\<v4\>\""}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"v1", ",", "v2", ",", "v3", ",", "v4"}], "}"}]}], 
              "}"}]}], "]"}], ",", "Black"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v1", ",", 
                RowBox[{"v1", "+", 
                 RowBox[{".1", "u1"}]}]}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v2", ",", 
                RowBox[{"v2", "+", 
                 RowBox[{".1", "u2"}]}]}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v3", ",", 
                RowBox[{"v3", "+", 
                 RowBox[{".1", "u3"}]}]}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v4", ",", 
                RowBox[{"v4", "+", 
                 RowBox[{".1", "u4"}]}]}], "}"}], "]"}]}], "}"}], ",", 
           "Purple"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v1", ",", 
                RowBox[{"v1", "+", 
                 RowBox[{".1", "e1"}]}]}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v2", ",", 
                RowBox[{"v2", "+", 
                 RowBox[{".1", "e2"}]}]}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v3", ",", 
                RowBox[{"v3", "+", 
                 RowBox[{".1", "e3"}]}]}], "}"}], "]"}], ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"v4", ",", 
                RowBox[{"v4", "+", 
                 RowBox[{".1", "e4"}]}]}], "}"}], "]"}]}], "}"}], ",", 
           "Orange"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", 
            RowBox[{"{", 
             RowBox[{
             "s1", ",", "s2", ",", "s3", ",", "s4", ",", "s5", ",", "s6", ",",
               "s7", ",", "s8"}], "}"}]}], ",", "Blue", ",", 
           RowBox[{"AbsolutePointSize", "[", "3", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{"#1", ",", "#2", ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"-", "2"}]}], "}"}]}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{
