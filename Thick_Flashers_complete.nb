Cell[CellGroupData[{

Cell["Curved fold shapes", "Subsection",
 CellChangeTimes->{{3.799744650385479*^9, 
  3.799744658478304*^9}},ExpressionUUID->"06a21bb9-2f02-49be-9f32-\
cec6ddbef200"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.79974467354458*^9, 
  3.799744673995075*^9}},ExpressionUUID->"d13ba2b1-41e7-4788-bc17-\
affe75f8ac33"],

Cell["\<\
These functions produce some analytically solvable curve fold shapes and \
their numeric equivalents. Useful for examples and for testing.\
\>", "Text",
 CellChangeTimes->{{3.799744676288903*^9, 3.799744697487851*^9}, {
  3.799781966572384*^9, 
  3.799781972212942*^9}},ExpressionUUID->"d16fb3ec-9e3d-44e5-b049-\
6be422eaf03c"],

Cell["\<\
For a uniform helix (constant fold angle), there is an analytic expression \
for both the folded and unfolded form.\
\>", "Text",
 CellChangeTimes->{{3.799783152748916*^9, 
  3.7997831801962957`*^9}},ExpressionUUID->"617b3164-068d-4dbb-ad3d-\
024b3cbfc16f"],

Cell["\<\
For a nonuniform helix (general fold angle function), there is an analytic \
expression for the folded form, but the differential equation for the shape \
of the 2D curve doesn\[CloseCurlyQuote]t have a closed-form solution for the \
general fold angle function \[Gamma][t]. However, we can still create a \
numeric versions of the unfolded form.\
\>", "Text",
 CellChangeTimes->{{3.799783188612597*^9, 3.79978326228518*^9}, {
  3.79978330894937*^9, 
  3.799783311333536*^9}},ExpressionUUID->"e446d7ad-8796-461a-820d-\
9cbb75b6296b"],

Cell["\<\
All of these functions return a list of four functions: {f, rL, rR, \[Gamma]} \
or {ff, rrL, rrR, \[Gamma]}, as appropriate, depending on whether they are 2D \
or 3D.\
\>", "Text",
 CellChangeTimes->{{3.799782094092984*^9, 
  3.799782131629743*^9}},ExpressionUUID->"6c648652-1277-45ae-9935-\
1097d4e3d1f8"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "CurvedFoldUniformHelix3D[",
 StyleBox["r",
  FontSlant->"Italic"],
 ", \[Theta], ",
 StyleBox["\[Gamma]0",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.799744662252729*^9, 3.799744671434774*^9}, {
  3.799744709955049*^9, 3.799744722797084*^9}, {3.799744806248434*^9, 
  3.799744809953713*^9}},ExpressionUUID->"655d4113-977b-4c23-ae63-\
62d754b17d98"],

Cell["\<\
CurvedFoldUniformHelix3D[r, \[Theta], \[Gamma]0] produces functions that \
describe a uniform fold along a helix with a given radius and helicity angle.\
\
\>", "Text",
 CellChangeTimes->{{3.799744730965797*^9, 3.799744763128796*^9}, {
   3.799749647177718*^9, 3.799749659535693*^9}, {3.799750818618812*^9, 
   3.799750822503708*^9}, 3.799750900355201*^9, 
   3.799751923470971*^9},ExpressionUUID->"599184b1-4770-402d-a7ca-\
d68c24205d12"],

Cell["\<\
Arguments:
\tr \[LongDash] the radius of the curve.
\t\[Theta] \[LongDash] the helicity angle.
\t\[Gamma]0 \[LongDash] the constant fold angle.\
\>", "Text",
 CellChangeTimes->{{3.799748099776724*^9, 3.799748125937078*^9}, {
   3.79975079647245*^9, 3.799750799523525*^9}, 
   3.799750902998814*^9},ExpressionUUID->"2d116697-5dce-4709-9129-\
5e122c76a64f"],

Cell["\<\
Returns: a list {ff, rrL, rrR, \[Gamma]} of the fold ruled neighborhood and \
its fold angle function.\
\>", "Text",
 CellChangeTimes->{{3.799744788080272*^9, 
  3.799744829476794*^9}},ExpressionUUID->"a37e71ab-c02a-4163-8605-\
59ddd10c13b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CurvedFoldUniformHelix3D", "[", 
   RowBox[{"r_", ",", "\[Theta]_", ",", "\[Gamma]0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"r", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}], ",", 
          RowBox[{
           RowBox[{"Tan", "[", "\[Theta]", "]"}], "#"}]}], "}"}]}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"\[Gamma]0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "#1", "]"}], ",", 
           RowBox[{"Sin", "[", "#1", "]"}], ",", 
           RowBox[{
            RowBox[{"Tan", "[", "\[Theta]", "]"}], " ", "#1"}]}], "}"}]}], 
        "&"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
             RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Cos", "[", "#1", "]"}], " ", 
                RowBox[{"Sin", "[", "\[Gamma]0", "]"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}], ")"}], " ", 
                RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
                RowBox[{"Sin", "[", "#1", "]"}]}]}], ")"}]}], 
            RowBox[{
             SqrtBox["2"], " ", 
             SqrtBox[
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
                SuperscriptBox[
                 RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
               SuperscriptBox[
                RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]}]]}], ",", 
          FractionBox[
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}], ")"}], " ", 
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Sin", "[", "\[Gamma]0", "]"}], " ", 
               RowBox[{"Sin", "[", "#1", "]"}]}]}], ")"}]}], 
           RowBox[{
            SqrtBox["2"], " ", 
            SqrtBox[
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
               SuperscriptBox[
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]}]], ",", 
          FractionBox[
           SqrtBox[
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]], 
           SqrtBox["2"]]}], "}"}], "&"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{"Sin", "[", "\[Gamma]0", "]"}]}], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}], ")"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Sin", "[", "#1", "]"}]}]}], ")"}]}], 
           RowBox[{
            SqrtBox["2"], " ", 
            SqrtBox[
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
               SuperscriptBox[
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]}]], ",", 
          FractionBox[
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}], ")"}], " ", 
               RowBox[{"Cos", "[", "#1", "]"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
              RowBox[{
               RowBox[{"Sin", "[", "\[Gamma]0", "]"}], " ", 
               RowBox[{"Sin", "[", "#1", "]"}]}]}], ")"}]}], 
           RowBox[{
            SqrtBox["2"], " ", 
            SqrtBox[
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
               SuperscriptBox[
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]]}]], ",", 
          FractionBox[
           SqrtBox[
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Gamma]0", "]"}], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]], 
           SqrtBox["2"]]}], "}"}], "&"}], ",", 
       RowBox[{"\[Gamma]0", "&"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.79974476769153*^9, 3.799744784857356*^9}, {
   3.799744832905467*^9, 3.799745002231144*^9}, {3.799747243819375*^9, 
   3.799747246641432*^9}, 3.799747995931724*^9, 3.799748669358403*^9, 
   3.799749715400779*^9, 3.799749747594845*^9, 3.799942566006974*^9, 
   3.799942750808793*^9},
 CellLabel->
  "In[3942]:=",ExpressionUUID->"01b77873-a7d0-4fa8-b086-2d52582c3dbe"],

Cell["Derivation.", "Text",
 CellChangeTimes->{{3.799748647747933*^9, 
  3.799748649379026*^9}},ExpressionUUID->"5885d598-fab7-4bca-b597-\
18e2c37509bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r", ",", "\[Theta]", ",", "\[Gamma]0", ",", "as", ",", "ff", ",", 
       "rrL", ",", "rrR", ",", "\[Gamma]", ",", "s"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ff", "=", 
       RowBox[{
        RowBox[{"r", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "#", "]"}], ",", 
           RowBox[{"Sin", "[", "#", "]"}], ",", 
           RowBox[{
            RowBox[{"Tan", "[", "\[Theta]", "]"}], "#"}]}], "}"}]}], "&"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"\[Gamma]", "=", 
       RowBox[{"\[Gamma]0", "&"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"as", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", ">", "0"}], ",", 
         RowBox[{"\[Gamma]0", ">", "0"}], ",", 
         RowBox[{"\[Theta]", "\[Element]", "Reals"}], ",", 
         RowBox[{
          RowBox[{"Sec", "[", "\[Theta]", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", 
           FractionBox["\[Gamma]0", "2"], "]"}], ">", "0"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
       RowBox[{"FoldSpaceCurve3D", "[", 
        RowBox[{"ff", ",", "\[Gamma]", ",", 
         RowBox[{"+", "1"}], ",", 
         RowBox[{"Simplification", "\[Rule]", "FullSimplify"}], ",", 
         RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<ff = \>\"", ",", 
        RowBox[{"ff", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrL = \>\"", ",", 
        RowBox[{"rrL", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrR = \>\"", ",", 
        RowBox[{"rrR", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"some", " ", "more", " ", "simplification"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"rrL", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rrL", "[", "s", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               SuperscriptBox[
                RowBox[{"Sin", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}], ",", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"Cos", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}]}], "}"}]}], ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rrR", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rrR", "[", "s", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               SuperscriptBox[
                RowBox[{"Sin", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}], ",", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"Cos", "[", 
                 FractionBox["x_", "2"], "]"}], "2"], "\[RuleDelayed]", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}]}], "}"}]}], ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<after another round\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrL = \>\"", ",", 
        RowBox[{"rrL", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<rrR = \>\"", ",", 
        RowBox[{"rrR", "//", "PrettyParameters"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.799745008344139*^9, 3.799745086515429*^9}, {
   3.79974519326088*^9, 3.799745205182513*^9}, {3.799747098905987*^9, 
   3.799747103735841*^9}, {3.799747141641116*^9, 3.799747212517539*^9}, {
