Cell[BoxData[
 RowBox[{
  RowBox[{"StyledFrenetTrihedron", "[", 
   RowBox[{
   "p_List", ",", " ", "t_List", ",", "n_List", ",", "b_List", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fvr", ",", "fvl"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fvr", "=", 
      RowBox[{
       RowBox[{"FrenetVectorLength", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledFrenetTrihedron", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fvl", "=", 
      RowBox[{
       RowBox[{"FrenetVectorLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledFrenetTrihedron", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"StyledVector", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"p", "+", 
            RowBox[{"fvr", " ", "t"}]}]}], "}"}], ",", 
         RowBox[{"VectorColor", "\[Rule]", "TangentVectorColor"}], ",", 
         RowBox[{"VectorLabel", "\[Rule]", 
          RowBox[{
          "fvl", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",",
          "opts"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"StyledVector", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"p", "+", 
            RowBox[{"fvr", " ", "n"}]}]}], "}"}], ",", 
         RowBox[{"VectorColor", "\[Rule]", "NormalVectorColor"}], ",", 
         RowBox[{"VectorLabel", "\[Rule]", 
          RowBox[{
          "fvl", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",",
          "opts"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"StyledVector", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"p", "+", 
            RowBox[{"fvr", " ", "b"}]}]}], "}"}], ",", 
         RowBox[{"VectorColor", "\[Rule]", "BinormalVectorColor"}], ",", 
         RowBox[{"VectorLabel", "\[Rule]", 
          RowBox[{
          "fvl", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], ",",
          "opts"}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.687996435932991*^9, 3.687996474622398*^9}, {
