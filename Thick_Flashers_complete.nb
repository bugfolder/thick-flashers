Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Styled2DArc", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ArcLabel", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ArcLabelRadius", "\[Rule]", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"LineStyle", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.44025829893787*^9, 3.440258313104676*^9}, {
   3.440259227174588*^9, 3.440259236598156*^9}, {3.443204888943084*^9, 
