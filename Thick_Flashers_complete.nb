Cell["\<\
One of the things we need to know to construct the projection of the stowed \
form are the radial and axial predecessor vertices.\
\>", "Text",
 CellChangeTimes->{{3.913542252126697*^9, 
  3.9135423176259604`*^9}},ExpressionUUID->"5fa97075-b01d-496d-8c0a-\
e388a38c78ca"],

Cell["\<\
To show the radial predecessors for the j=0 row, build two sectors, then pick \
out just the lines that include k=0 vertices.\
\>", "Text",
 CellChangeTimes->{{3.911575938425645*^9, 3.911575955109933*^9}, {
  3.911576259769981*^9, 3.911576264559698*^9}, {3.911753058166141*^9, 
  3.911753075550229*^9}, {3.91175315904733*^9, 
  3.911753159911332*^9}},ExpressionUUID->"aec70213-5642-4e33-8f63-\
f76f29655bc4"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"k", "=", "0"}], ",", "lines", ",", "verts"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lines", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
        RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}], ",", 
       RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
        RowBox[{"p", ",", "r", ",", "h", ",", "1"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"lines", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"lines", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1", ",", "4"}], "\[RightDoubleBracket]"}], "==",
           "0"}], "||", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "2", ",", "4"}], "\[RightDoubleBracket]"}], "==",
           "0"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"verts", "=", 
     RowBox[{"Union", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{"lines", ",", 
        SubscriptBox["p", 
         RowBox[{"_", ",", "_", ",", "_"}]], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Arrow", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}], ",", 
            RowBox[{"FlasherMMDStyle", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}]}], "]"}], "&"}], "/@", "lines"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"FlasherVertexLabel", "[", 
           RowBox[{"\"\<p\>\"", ",", "#"}], "]"}], "&"}], "/@", "verts"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}], "/.", 
      RowBox[{"FlasherDefaultCPRules", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.555752770244678*^9, 3.555752822227908*^9}, {
