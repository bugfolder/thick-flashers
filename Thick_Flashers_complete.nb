 CellChangeTimes->{{3.6499600662937098`*^9, 
  3.649960066978983*^9}},ExpressionUUID->"49df79b1-3bdf-48f1-a189-\
9e625f62abb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "q", ",", "r", ",", "x", ",", "y", ",", "z"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"3", ",", "1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"TriangleNormal3D", "[", 
       RowBox[{"p", ",", "q", ",", "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p\>\"", ",", "p", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<q\>\"", ",", "q", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<r\>\"", ",", "r", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "q", ",", "r"}], "}"}], "]"}], ",", "Gray", ",", 
           RowBox[{"Opacity", "[", "0.25", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "p", "]"}], ",", 
           RowBox[{"PointSize", "[", ".05", "]"}], ",", "Black"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"p", "+", "z"}]}], "}"}], "]"}], ",", "Blue", ",", 
           RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.649960073723668*^9, 3.649960322903039*^9}, 
   3.6499603763635483`*^9, {3.686847207964734*^9, 3.686847309183989*^9}, {
   3.686847549404313*^9, 3.686847569763384*^9}, {3.915801692465714*^9, 
   3.915801721198818*^9}},
 CellLabel->
  "In[639]:=",ExpressionUUID->"881a7ba5-df1b-4b89-b492-04e8d0c8a5f7"]
}, Closed]]
}, Closed]],

