Cell[TextData[{
 "AssertProperties",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["properties",
  FontSlant->"Italic"],
 "] checks whether ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " contains every property in the list ",
 StyleBox["properties",
  FontSlant->"Italic"],
 " (it may have additional ones). If not, issue an error message and \
Abort[]."
}], "Text",
 CellChangeTimes->{{3.591380065856176*^9, 3.591380112700758*^9}, 
   3.593006082409606*^9},ExpressionUUID->"849929ca-c741-4001-b8a0-\
463236dfd40e"],

