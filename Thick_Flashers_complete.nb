   3.456513584201508*^9}, {3.45761222317176*^9, 3.457612248519285*^9}, {
   3.45761228595032*^9, 3.457612288860946*^9}, {3.457703915323514*^9, 
   3.457703922091471*^9}, {3.457704928147202*^9, 3.457704972472464*^9}, {
   3.457705020804143*^9, 3.4577050383605957`*^9}, {3.457712398402979*^9, 
