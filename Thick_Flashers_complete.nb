Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RecoverCurve2DSystem", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.690971199004568*^9, 3.690971217037642*^9}, 
   3.690988493844738*^9, 3.691182773297948*^9, 3.6912356848331137`*^9, 
   3.691235885131102*^9, 3.691252613445842*^9, {3.691696403881215*^9, 
   3.691696426117591*^9}, {3.6916975142902403`*^9, 3.691697528291098*^9}, 
   3.691697988392797*^9, 3.691698253177126*^9, 3.691921636647003*^9, 
   3.691921671373208*^9, 3.800461010010921*^9, {3.800464812125222*^9, 
   3.8004648167715883`*^9}},
 CellLabel->
  "In[3633]:=",ExpressionUUID->"e40115cd-8ea0-479e-8d82-268213fbda32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RecoverCurve2DSystem", "[", 
   RowBox[{"ds_Function", ",", "\[Kappa]l_Function", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "ci_List", ",", "ti_List"}], "}"}], ",", "opts___"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "dsopts", ",", "soln", ",", 
      "tx", ",", "ty", ",", "lx", ",", "ly", ",", "cx", ",", "cy", ",", "c", ",",
       "t", ",", "l", ",", "\[Kappa]", ",", "n"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve2DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve2DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"DSolve", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"cx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"cy", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"ds", "[", "s", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "s", "]"}], ",", 
               RowBox[{"ty", "[", "s", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"tx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"ty", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"ds", "[", "s", "]"}], 
             RowBox[{"\[Kappa]l", "[", "s", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"lx", "[", "s", "]"}], ",", 
               RowBox[{"ly", "[", "s", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"lx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"ly", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"ds", "[", "s", "]"}]}], 
             RowBox[{"\[Kappa]l", "[", "s", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "s", "]"}], ",", 
               RowBox[{"ty", "[", "s", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"cx", "[", "ui", "]"}], ",", 
              RowBox[{"cy", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ci"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tx", "[", "ui", "]"}], ",", 
              RowBox[{"ty", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ti"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"lx", "[", "ui", "]"}], ",", 
              RowBox[{"ly", "[", "ui", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"RotationMatrix2D", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", "ti"}]}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cx", "[", "s", "]"}], ",", 
           RowBox[{"cy", "[", "s", "]"}], ",", 
           RowBox[{"tx", "[", "s", "]"}], ",", 
           RowBox[{"ty", "[", "s", "]"}], ",", 
           RowBox[{"lx", "[", "s", "]"}], ",", 
           RowBox[{"ly", "[", "s", "]"}]}], "}"}], ",", "s", ",", 
         RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "DSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"RecoverCurve2DSystem", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cx", "[", "s", "]"}], ",", 
            RowBox[{"cy", "[", "s", "]"}]}], "}"}], "/.", "soln"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tx", "[", "s", "]"}], ",", 
            RowBox[{"ty", "[", "s", "]"}]}], "}"}], "/.", "soln"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"lx", "[", "s", "]"}], ",", 
            RowBox[{"ly", "[", "s", "]"}]}], "}"}], "/.", "soln"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}], 
          RowBox[{"l", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve2D", "\[Rule]", "c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed2D", "\[Rule]", "ds"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LeftCurvature2D", "\[Rule]", "\[Kappa]l"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Curvature2D", "\[Rule]", "\[Kappa]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TangentVector2D", "\[Rule]", "t"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LeftNormalVector2D", "\[Rule]", "l"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalVector2D", "\[Rule]", "n"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.7994509525591087`*^9, 3.799450988708941*^9}, {
   3.79948665388072*^9, 3.799486705402948*^9}, {3.79948674667326*^9, 
