Cell[CellGroupData[{

Cell[TextData[{
 "Rotate3Du[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]\nRotate3Du[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w, q",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.6892506488742*^9, 3.689250669025385*^9}, {
  3.689250876358379*^9, 3.689250894436521*^9}, {3.689250950901726*^9, 
  3.689250954260515*^9}, {3.689251629824996*^9, 
  3.689251630865387*^9}},ExpressionUUID->"2dc8b56a-4a1b-4f64-a5d0-\
c4cac1cc6dbb"],

Cell[TextData[{
 "Rotate3Du[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "] rotates the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " through angle \[Phi] about an axis emanating from the origin in direction ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", which must be a unit vector. This uses the simpler (and analytic) \
Rodrigues formula for rotation."
}], "Text",
 CellChangeTimes->{
  3.689250674501274*^9, {3.68925072588398*^9, 3.6892507813912687`*^9}, {
   3.689250835653847*^9, 3.689250837209165*^9}, {3.689250918209992*^9, 
   3.689250957619546*^9}, {3.689251017256605*^9, 3.689251028966391*^9}, {
   3.689251637534727*^9, 3.689251666702704*^9}, 
   3.707924801970228*^9},ExpressionUUID->"b94d4f72-cf88-4c73-b274-\
6d7dd4bb74eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rotate3Du", "[", 
   RowBox[{"p_List", ",", "\[Phi]_", ",", "w_List"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"RotationMatrix3Du", "[", 
    RowBox[{"\[Phi]", ",", "w"}], "]"}], ".", 
   RowBox[{"(", "p", ")"}]}]}]], "Input",
 CellChangeTimes->{{3.689250785451035*^9, 3.689250801396055*^9}, {
  3.6892509399240303`*^9, 3.68925094880774*^9}, {3.689250985395392*^9, 
  3.68925103914113*^9}, {3.689251669045443*^9, 3.689251670324282*^9}},
 CellLabel->
  "In[710]:=",ExpressionUUID->"13c59956-072e-4bf8-8c05-2183568037b0"],

Cell[TextData[{
 "Rotate3Du[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w, q",
  FontSlant->"Italic"],
 "] rotates the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " through angle \[Phi] about an axis emanating from point ",
 StyleBox["q",
  FontSlant->"Italic"],
 " in direction ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", which must be a unit vector."
}], "Text",
 CellChangeTimes->{
  3.689250674501274*^9, {3.68925072588398*^9, 3.6892507813912687`*^9}, {
   3.689250835653847*^9, 3.689250837209165*^9}, {3.689250918209992*^9, 
