Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "UnitRegularPolygonCenteredTwistAltTile", ",", "n_", ",", "w_", ",", 
      "\[Alpha]_", ",", "types_List"}], "}"}], ",", "decoration_", ",", 
    "opts___"}], "]"}], ":=", 
