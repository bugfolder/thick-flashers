999d598ce47d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoCycleCriticalTwistAngleCW", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1a_", ",", "q1b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q2a_", ",", "q2b_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"\[Pi]", "+", 
   RowBox[{"TwoCycleCriticalTwistAngleCCW", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q1b", ",", "q1a"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q2b", ",", "q2a"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.627499327839615*^9, 3.627499359875059*^9}},
