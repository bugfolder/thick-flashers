 RowBox[{
  RowBox[{"FunctionizeOld", "[", 
   RowBox[{"expr_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"FunctionizeOld", "[", 
   RowBox[{"expr", ",", 
    RowBox[{"{", "x", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.688987194174798*^9, 3.688987210167776*^9}, {
