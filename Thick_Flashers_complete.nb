 RowBox[{
  RowBox[{"MergeGraphs", "[", 
   RowBox[{"tglist_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "mgdata", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mgdata", "=", 
      RowBox[{"MergeGraphsData", "[", 
       RowBox[{"tglist", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tglist", "//", 
      RowBox[{"ApplyMerge", "[", "mgdata", "]"}]}]}]}], "]"}]}]], "Input",
