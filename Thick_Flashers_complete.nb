Cell[TextData[{
 "RenderTile[{PolygonTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "}, Tiling, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a list of Graphics elements that render a tile with vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ". Options are:\n\t(global options)\n\tTilePolys \[Rule] True | False, \
specifies whether to render tile polygon with a fill pattern.\n\tTileEdges \
\[Rule] True | False, specifies whether to render te edges of the tile \
polygon.\n\tTileVertexIndices \[Rule] True | False, specifies whether to draw \
vertex indices in the corners of the polygon. \n\tTileEdgeArrowStyle \[Rule] \
TileArrowDH | TileArrowCH | TileArrowDF | TileArrowCF | None, specifies the \
style for rendering an edge type (M or V). This option has no effect if \
EdgeTypes is not provided.\n\t( tile-specific options)\n\tTilePolyFill \
\[Rule] M | V | W | O | None, specifies what fill color to use for the \
polygon of the tile.\n\tTileEdgeArrowDirs \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 " | None, where list, if provided, has entries M or V, one for each edge of \
the tile.\n\tTileIndex \[Rule] ",
 StyleBox["label",
  FontSlant->"Italic"],
 " | None, specifies whether to draw  label in the center of the polygon."
}], "Text",
 CellChangeTimes->{{3.629820544773498*^9, 3.629820601120916*^9}, {
   3.629820673753269*^9, 3.629820675055787*^9}, {3.629820859656908*^9, 
   3.629820875770953*^9}, 3.629821990779095*^9, 3.629822181673921*^9, 
   3.629822286726921*^9, {3.6298224794999733`*^9, 3.6298225435034122`*^9}, {
   3.629822656888944*^9, 3.629822708556574*^9}, 3.629823271277334*^9, 
   3.629839186522317*^9, 
   3.629839227159943*^9},ExpressionUUID->"301978db-94a0-41df-8ce0-\
676dff9fcd52"],

Cell["\<\
There are two types of options: those that turn on/off rendering typically \
for an entire tiling, and those that are used to alter individual tiles in \
different ways. TileIndex, TilePolyFill and TileEdgeArrowDirs are in the \
latter category; these options will typically be set by more specialized \
RenderTile implementations that are built upon the PolygonTile type. Note \
that TileIndex may be passed in from EmbedTiling.\
\>", "Text",
 CellChangeTimes->{{3.629821905034468*^9, 3.629821943078074*^9}, {
   3.629822099639306*^9, 3.62982210731573*^9}, {3.629822339757925*^9, 
   3.629822340916267*^9}, {3.6298226031799717`*^9, 3.629822646689113*^9}, {
   3.6298227188734097`*^9, 3.6298227781520367`*^9}, 3.629839186655437*^9, 
   3.62983922728662*^9, {3.629977045801457*^9, 
   3.629977103252904*^9}},ExpressionUUID->"fa990dd3-c34d-41e2-8ace-\
ee0e7734b330"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TilePolys", "::", "usage"}], 
   "=", "\"\<TilePolys is an option to RenderTile[{PolygonTile, verts}, \
Tiling, opts] that specifies whether to render tile polygons with a fill \
color.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629822408094374*^9, 3.629822475533749*^9}, {
  3.629823094896061*^9, 3.629823095430586*^9}},
