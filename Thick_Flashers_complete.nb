Cell[BoxData[
 RowBox[{
  RowBox[{"BorderlessCreasePatternToPlaneGraphAssigned", "[", 
   RowBox[{
    StyleBox["blcp_",
     FontSlant->"Italic"], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tol", ",", "mlines", ",", "vlines", ",", "spolys", ",", "verts", ",", 
      "imlines", ",", "ivlines", ",", "ispolys", ",", "medges", ",", "vedges",
       ",", "bedges", ",", "border", ",", "d2vs", ",", "medges1", ",", 
      "vedges1", ",", "medges2", ",", "vedges2", ",", "edges", ",", 
      "edgetypes", ",", "vkeep", ",", "vmap"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"SamePtTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "BorderlessCreasePatternToPlaneGraphAssigned", 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Start", " ", "by", " ", "extracting", " ", "mountain", " ", "and", " ",
        "valley", " ", "lines", " ", "and", " ", 
       RowBox[{"polys", ".", " ", "All"}], " ", "else", " ", "will", " ", 
       "be", " ", 
       RowBox[{"ignored", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"mlines", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"blcp", ",", 
        RowBox[{"Style", "[", 
         RowBox[{"_Line", ",", "MountainLine"}], "]"}], ",", "\[Infinity]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vlines", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"blcp", ",", 
        RowBox[{"Style", "[", 
         RowBox[{"_Line", ",", "ValleyLine"}], "]"}], ",", "\[Infinity]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"spolys", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"blcp", ",", 
        RowBox[{"Style", "[", 
         RowBox[{"_Polygon", ",", "___"}], "]"}], ",", "\[Infinity]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "mlines", "]"}], "+", 
         RowBox[{"Length", "[", "vlines", "]"}]}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
         "BorderlessCreasePatternToPlaneGraphAssigned", "::", "nostyle"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "spolys", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
         "BorderlessCreasePatternToPlaneGraphAssigned", "::", "nopolys"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Indexify", " ", "everything"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", 
        RowBox[{"{", 
         RowBox[{"imlines", ",", "ivlines", ",", "ispolys"}], "}"}]}], "}"}], 
      "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mlines", ",", "vlines", ",", "spolys"}], "}"}], ",", "5", ",", 
        RowBox[{"SamePtTolerance", "\[Rule]", "tol"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"medges", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "&"}], "/@", 
       "imlines"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "index", " ", "pairs", " ", "for", " ", "mountain", " ", "lines"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vedges", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "&"}], "/@", 
       "ivlines"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "index", " ", "pairs", " ", "for", " ", "valley", " ", "lines"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bedges", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "&"}], "/@", 
           "ispolys"}], ")"}]}], ",", "1"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "all", " ", "possible", " ", "polygon", " ", "index", " ", "pairs"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bedges", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tally", "[", 
          RowBox[{"bedges", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", "\[Equal]", "#2"}], "||", 
             RowBox[{"#1", "\[Equal]", 
              RowBox[{"Reverse", "[", "#2", "]"}]}]}], "&"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]",
            "1"}], "&"}]}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "filter", " ", "to", " ", "edges", " ", "with", " ", "multiplicity", " ",
        "1"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Or", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[NotEqual]",
             "2"}], "&"}], "/@", 
          RowBox[{"Tally", "[", 
           RowBox[{"Flatten", "[", "bedges", "]"}], "]"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
         "BorderlessCreasePatternToPlaneGraphAssigned", "::", "badborder"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"get", " ", "ordered", " ", "list", " ", "of", " ", "border", " ", 
       RowBox[{"vertices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"border", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{
        RowBox[{"AddTPlaneGraphTo", "[", 
         RowBox[{"MakeTGraph", "[", 
          RowBox[{"verts", ",", "bedges"}], "]"}], "]"}], ",", 
        "BoundaryVertices"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"find", " ", "verts", " ", "with", " ", "multiplicity"}], "=",
         "2"}], ";", " ", 
       RowBox[{"those", " ", "need", " ", "to", " ", "be", " ", "merged"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"d2vs", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Tally", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{"medges", ",", "vedges"}], "}"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[Equal]",
            "2"}], "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"medges1", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"medges", ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"IntersectingQ", "[", 
           RowBox[{"#", ",", "d2vs"}], "]"}]}], "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"don", "'"}], "t", " ", "need", " ", "merging"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vedges1", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"vedges", ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"IntersectingQ", "[", 
           RowBox[{"#", ",", "d2vs"}], "]"}]}], "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"don", "'"}], "t", " ", "need", " ", "merging"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"medges2", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"medges", ",", 
        RowBox[{
         RowBox[{"IntersectingQ", "[", 
          RowBox[{"#", ",", "d2vs"}], "]"}], "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"needs", " ", "merging"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"medges2", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"i", ",", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"Select", "[", 
               RowBox[{"medges2", ",", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"#", ",", "i"}], "]"}], "&"}]}], "]"}], "]"}], ",", 
             
             RowBox[{
              RowBox[{"#", "\[NotEqual]", "i"}], "&"}]}], "]"}]}], "]"}], "/@",
          "d2vs"}], ",", "NotListEmptyQ"}], "]"}]}], ";", 
     RowBox[{"(*", " ", "merged", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vedges2", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"vedges", ",", 
        RowBox[{
         RowBox[{"IntersectingQ", "[", 
          RowBox[{"#", ",", "d2vs"}], "]"}], "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"needs", " ", "merging"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vedges2", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"i", ",", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"Select", "[", 
               RowBox[{"vedges2", ",", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"#", ",", "i"}], "]"}], "&"}]}], "]"}], "]"}], ",", 
             
             RowBox[{
              RowBox[{"#", "\[NotEqual]", "i"}], "&"}]}], "]"}]}], "]"}], "/@",
          "d2vs"}], ",", "NotListEmptyQ"}], "]"}]}], ";", 
     RowBox[{"(*", " ", "merged", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "d2vs", "]"}], "\[NotEqual]", 
        RowBox[{
         RowBox[{"Length", "[", "medges2", "]"}], "+", 
         RowBox[{"Length", "[", "vedges2", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
