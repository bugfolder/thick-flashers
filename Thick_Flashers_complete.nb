Cell[BoxData[
 RowBox[{
  RowBox[{"Vertex3DStyle", "[", "opts___", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x", ",", "trc", ",", "oc", ",", "rc", ",", "tc", ",", "mac", ",", 
      "op2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"trc", "=", 
      RowBox[{
       RowBox[{"TraceColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"oc", "=", 
      RowBox[{
       RowBox[{"OsculatingColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rc", "=", 
      RowBox[{
       RowBox[{"RulingColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tc", "=", 
      RowBox[{
       RowBox[{"MidfoldNormalColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mac", "=", 
      RowBox[{
       RowBox[{"MidfoldColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"op2", "=", 
      RowBox[{
       RowBox[{"Opacity2D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "OrigamiStyle", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"OrigamiStyle", "[", "opts", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "TracePoint"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"Darker", "[", "trc", "]"}], ",", 
            RowBox[{"AbsolutePointSize", "[", "3", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "TraceLine"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", "trc", ",", 
            RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", 
            RowBox[{"AbsoluteDashing", "[", 
             RowBox[{"{", "}"}], "]"}], ",", 
            RowBox[{"CapForm", "[", "\"\<Round\>\"", "]"}], ",", 
            RowBox[{"JoinForm", "[", "\"\<Round\>\"", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "OsculatingPoint"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"Darker", "[", "oc", "]"}], ",", 
            RowBox[{"AbsolutePointSize", "[", "3", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "OsculatingLine"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", "oc", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.5", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "OsculatingFill"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"EdgeForm", "[", "]"}], ",", 
            RowBox[{"FaceForm", "[", 
             RowBox[{"Lighter", "[", "oc", "]"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "op2", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "RulingPoint"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"Darker", "[", "rc", "]"}], ",", 
            RowBox[{"AbsolutePointSize", "[", "3", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "RulingLine"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", "rc", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.5", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "RulingFill"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"EdgeForm", "[", "]"}], ",", 
            RowBox[{"FaceForm", "[", 
             RowBox[{"Lighter", "[", "rc", "]"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "op2", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "MidfoldNormalPoint"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"Darker", "[", "tc", "]"}], ",", 
            RowBox[{"AbsolutePointSize", "[", "3", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "MidfoldNormalLine"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", "tc", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.5", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "MidfoldNormalFill"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"EdgeForm", "[", "]"}], ",", 
            RowBox[{"FaceForm", "[", 
             RowBox[{"Lighter", "[", "tc", "]"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "op2", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "MidfoldPoint"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"Darker", "[", "mac", "]"}], ",", 
            RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "MidfoldLine"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", "mac", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.5", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"x_", ",", "MidfoldFill"}], "]"}], "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"x", ",", 
            RowBox[{"EdgeForm", "[", "]"}], ",", 
            RowBox[{"FaceForm", "[", 
             RowBox[{"Lighter", "[", "mac", "]"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "op2", "]"}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.442605691991481*^9, 3.44260594447535*^9}, {
