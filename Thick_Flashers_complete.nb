Cell[TextData[{
 "InsetPoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 "] insets the vertices of the given polygon by a specified perpendicular \
inset distance ",
 StyleBox["h",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.4624320861764803`*^9, 3.46243211398945*^9}, {
  3.4624321533630133`*^9, 3.46243215581846*^9}, {3.721815046571768*^9, 
  3.721815048051055*^9}},ExpressionUUID->"afd6ab53-6e3a-4d1c-ad02-\
f95024bce857"],

Cell["\<\
This works for polygons with reflex vertices, but not polygons with 180\
\[Degree] vertices.\
\>", "Text",
 CellChangeTimes->{{3.7221736585075293`*^9, 
  3.722173678420494*^9}},ExpressionUUID->"ff562ab1-7402-491c-9a53-\
af1774a93791"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsetPoly", "[", 
   RowBox[{"verts_List", ",", "h_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"elines", ",", "insets", ",", "ilines"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"elines", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"verts", ",", 
         RowBox[{"RotateLeft", "[", "verts", "]"}]}], "}"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "lines", " ", "for", " ", "each", " ", "of", " ", "the", " ", "edges"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"insets", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "h"}], " ", 
         RowBox[{"Rotate90", "[", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{"Subtract", "@@", "#"}], "]"}], "]"}]}], "&"}], "/@", 
       "elines"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"inset", " ", "vectors", " ", "for", " ", "each", " ", "line"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ilines", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#1", "+", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{"#1", "+", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
          "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"insets", ",", "elines"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"LineInt2D1", "[", 
         RowBox[{
          RowBox[{"First", "[", "#1", "]"}], ",", 
          RowBox[{"Last", "[", "#1", "]"}], ",", 
          RowBox[{"First", "[", "#2", "]"}], ",", 
          RowBox[{"Last", "[", "#2", "]"}]}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"ilines", ",", 
         RowBox[{"RotateRight", "[", "ilines", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.462432119557285*^9, 3.462432151285241*^9}, {
   3.46243218308988*^9, 3.462432216328992*^9}, {3.4624322474712*^9, 
   3.462432437935706*^9}, {3.4624324723292933`*^9, 3.462432509418832*^9}, {
   3.46243256914034*^9, 3.4624325709841423`*^9}, {3.462432611226924*^9, 
