   3.626460406107862*^9},ExpressionUUID->"fbf39c16-274a-468e-a77e-\
cf9e967508c6"],

Cell[TextData[{
 "SingleVertexEdgeAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "] returns the sector angles around the vertex whose index is ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", list rotated so that the first sector angle in the return list lies \
between edge {",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i1",
  FontSlant->"Italic"],
 "} and the next CCW edge around the vertex. So, if we view vertex ",
 StyleBox["i0",
  FontSlant->"Italic"],
 " from edge {",
 StyleBox["i0, i1",
  FontSlant->"Italic"],
 "}, the first angle in the return list is on the right side of the edge, and \
the last angle in the return list is on the left."
}], "Text",
 CellChangeTimes->{{3.59526903871638*^9, 3.595269222775436*^9}, {
   3.595269732110367*^9, 3.595269737557533*^9}, {3.595272665248437*^9, 
   3.595272665854072*^9}, {3.5952727081169*^9, 3.595272724354526*^9}, {
   3.5953429075540524`*^9, 3.595342934643701*^9}, {3.626459511806758*^9, 
   3.626459532525657*^9}, 3.6264596487644653`*^9, 3.626460406263823*^9, {
   3.626460614095483*^9, 
   3.6264606959464903`*^9}},ExpressionUUID->"decf7458-bca8-4dec-8c46-\
92cff7d933b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SingleVertexEdgeAngles", "::", "badedge"}], 
   "=", "\"\<Vertex `1` is not adjacent to vertex `2`.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.59526929511005*^9, 3.595269317691634*^9}, {
   3.595272671919743*^9, 3.595272672407707*^9}, 3.595342934749984*^9, 
   3.626459650977443*^9, 3.62646040638669*^9},
 CellLabel->
  "In[1294]:=",ExpressionUUID->"869428e1-7ca6-4e93-ab9c-4ed739628302"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SingleVertexEdgeAngles", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["i0_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["i1_",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "vva", ",", "vfi", ",", "va", ",", "vfa"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "vva", ",", "vfi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "VertexVertexAdjacency", ",", 
          "VertexFaceIncidence"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{
          "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
           "i1"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"SingleVertexEdgeAngles", "::", "badedge"}], ",", "i1", ",",
           "i0"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"va", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"AbsoluteAngle", "[", 
         RowBox[{
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}], 
         "]"}], "&"}], "/@", 
       RowBox[{
       "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vfa", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"Subtract", "@@", "#"}], ",", 
           RowBox[{"2", "\[Pi]"}], ",", 
           RowBox[{"-", "\[Pi]"}]}], "]"}], "]"}], "&"}], "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RotateLeft", "[", "va", "]"}], ",", "va"}], "}"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vfa", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#1", "\[Equal]", "0"}], ",", "Null", ",", "#2"}], "]"}], 
         "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "vfi", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
           "vfa"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"RotateLeft", "[", 
      RowBox[{"vfa", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{
           "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
            "i1", ",", "1", ",", "1"}], "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.5952692332514553`*^9, 3.595269274081085*^9}, {
   3.59526936909868*^9, 3.595269442720821*^9}, {3.595269487191053*^9, 
   3.595269569534866*^9}, {3.595269602625649*^9, 3.595269602847285*^9}, {
   3.595269690424465*^9, 3.595269769434327*^9}, {3.595269807149341*^9, 
   3.595269828116263*^9}, {3.595269868068839*^9, 3.595269879985971*^9}, 
   3.595269928845624*^9, {3.5952699604710603`*^9, 3.595270025546236*^9}, {
   3.595270056190353*^9, 3.595270102396888*^9}, {3.595274502788549*^9, 
   3.595274554185416*^9}, {3.5952746225491037`*^9, 3.595274719677504*^9}, {
   3.595275074840232*^9, 3.595275087637947*^9}, {3.595342907663269*^9, 
