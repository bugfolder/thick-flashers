   "\[Degree]"}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.628539234545133*^9, 3.62853925034675*^9}, {
  3.62853958890772*^9, 3.628539590418661*^9}, {3.628539651033592*^9, 
  3.628539678631802*^9}, {3.6285534978646193`*^9, 3.62855350400949*^9}},
 CellLabel->
