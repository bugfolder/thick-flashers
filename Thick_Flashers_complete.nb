Cell[TextData[{
 "EmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", MonolithicTGraph2D, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] joins the individual tiles together into a single TGraph, then folds it \
into a TGraph2D. Options are:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 " is passed through to FoldGraph2D."
}], "Text",
 CellChangeTimes->{{3.630160950848508*^9, 3.6301609687353783`*^9}, {
  3.630161520876574*^9, 3.630161557593452*^9}, {3.630161706498189*^9, 
