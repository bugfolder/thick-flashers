bb88d6aeae96"],

Cell[TextData[{
 "CircularTriangleTwistCreasePatternGraphics",
 "[",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of 3 angles, a twist angle \[Alpha], an optional list of \
crease types around the central polygon, and options, and returns a list of \
Graphics elements that produce the crease pattern. The base of the triangle \
is horizontal and of unit length; the first angle is at the lower left corner."
}], "Text",
 CellChangeTimes->{{3.534537138168826*^9, 3.534537240289837*^9}, {
   3.534537866938865*^9, 3.53453787077737*^9}, 
   3.593041733649623*^9},ExpressionUUID->"5b8a946c-b27e-4a15-bf83-\
d3bd4a216002"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CircularTriangleTwistCreasePatternGraphics", "[", 
   RowBox[{"angles_List", ",", "\[Alpha]_", ",", "r_", ",", 
    RowBox[{"types_List", ":", 
     RowBox[{"{", "}"}]}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"UnitTriangleVertices", "[", "angles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{"Centroid", "[", "verts", "]"}]}], "&"}], "/@", "verts"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"CircularPolygonTwistCreasePatternGraphics", "[", 
      RowBox[{"verts", ",", "\[Alpha]", ",", "r", ",", "types", ",", "opts"}],
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.534537245148678*^9, 3.534537246295646*^9}, {
