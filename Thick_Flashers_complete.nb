Cell[CellGroupData[{

Cell["DuckGraph2D", "Subsubsection",
 CellChangeTimes->{{3.706822266062096*^9, 3.706822270102257*^9}, {
   3.8330247980333037`*^9, 3.8330248051758757`*^9}, 
   3.962634658544072*^9},ExpressionUUID->"387fd61e-2a44-4587-8c1b-\
74f7a2708349"],

Cell["\<\
DuckGraph2D is a TGraph2D that represents a simple duck; probably the \
simplest figurate origami example.\
\>", "Text",
 CellChangeTimes->{{3.7068223464718637`*^9, 
  3.706822368159163*^9}},ExpressionUUID->"bd328810-a8fc-4fe9-b840-\
9797f61b1f9d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DuckGraph2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"DuckGraph2D", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "tobj", ",", "stobj"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "a", " ", "square", " ", "in", " ", "diamond", " ", "orientation"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"verts", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{
         RowBox[{"MakeTGraph2D", "[", 
          RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "fold", " ", "in", " ", "half", " ", "along", " ", "horizontal", " ", 
         "diagonal"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"kite", "-", 
         RowBox[{"fold", " ", "both", " ", "bottom", " ", "corners"}]}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", "0"}], "}"}], ",", 
            RowBox[{".2", 
             RowBox[{"U", "[", 
              RowBox[{"22.5", "\[Degree]"}], "]"}]}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"fold", " ", "the", " ", "head"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1.7", ",", "0"}], "}"}], ",", 
            RowBox[{".2", 
             RowBox[{"U", "[", 
              RowBox[{"70.", "\[Degree]"}], "]"}]}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "fold", " ", "the", " ", "body", " ", "and", " ", "head", " ", 
         "together"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"stobj", "=", 
        RowBox[{"MakeSplitGraph2D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1.1", ",", "0"}], "}"}], ",", 
            RowBox[{".2", 
             RowBox[{"U", "[", 
              RowBox[{"70.", "\[Degree]"}], "]"}]}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"SplitAndFoldSplitGraph2D", "[", 
         RowBox[{"stobj", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "8", ",", "11", ",", "9", ",", "10", ",", "7"}], 
           "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"rotate", " ", "the", " ", "folded", " ", "form"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"RotateGraph2D", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{
          RowBox[{"-", "22.5"}], "\[Degree]"}]}], "]"}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.7068223811952133`*^9, 3.706822672028496*^9}, {
   3.706823432378808*^9, 3.706823451411049*^9}, {3.706823502835175*^9, 
   3.706823519546134*^9}, {3.706830090275961*^9, 3.7068301066448593`*^9}, {
