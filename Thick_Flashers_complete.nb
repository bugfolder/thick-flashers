Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PrincipalDirectionsUV", "::", "usage"}], 
   "=", "\"\<PrincipalDirectionsUV is a key to the rules returned by \
SurfaceSystem that gives the two principal directions of the surface in the \
parameterized domain.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.687479437826728*^9, 3.687479481921304*^9}, {
   3.688136180596376*^9, 3.688136193573352*^9}, {3.688137309664379*^9, 
