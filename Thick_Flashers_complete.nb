Cell[BoxData[
 RowBox[{
  RowBox[{"StyledPatch", "[", 
   RowBox[{
    RowBox[{"s_Function", "|", "s_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", "v1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nu", ",", "nv", ",", "fs", ",", "ls", ",", "so", ",", "dim", ",", "pts",
       ",", "spts", ",", "polys", ",", "lines"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nu", ",", "nv"}], "}"}], "=", 
      RowBox[{
       RowBox[{"PatchDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{
       RowBox[{"FillStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ls", "=", 
      RowBox[{
       RowBox[{"OutlineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"so", "=", 
      RowBox[{
       RowBox[{"SurfaceOrientation", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"u", ",", "v"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "u0", ",", "u1", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"u1", "-", "u0"}], ")"}], "/", "nu"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "v0", "]"}], "===", "Function"}], "||", 
             RowBox[{
              RowBox[{"Head", "[", "v0", "]"}], "===", 
              "InterpolatingFunction"}]}], ",", 
            RowBox[{"v0", "[", "u", "]"}], ",", "v0"}], "]"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "v1", "]"}], "===", "Function"}], "||", 
             RowBox[{
              RowBox[{"Head", "[", "v1", "]"}], "===", 
              "InterpolatingFunction"}]}], ",", 
            RowBox[{"v1", "[", "u", "]"}], ",", "v1"}], "]"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", "v1", "]"}], "===", "Function"}], "||", 
                
                RowBox[{
                 RowBox[{"Head", "[", "v1", "]"}], "===", 
                 "InterpolatingFunction"}]}], ",", 
               RowBox[{"v1", "[", "u", "]"}], ",", "v1"}], "]"}], "-", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Head", "[", "v0", "]"}], "===", "Function"}], "||", 
                
                RowBox[{
                 RowBox[{"Head", "[", "v0", "]"}], "===", 
                 "InterpolatingFunction"}]}], ",", 
               RowBox[{"v0", "[", "u", "]"}], ",", "v0"}], "]"}]}], ")"}], "/",
            "nv"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"fs", "===", "None"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "triangulate", " ", "quads", " ", "because", " ", "they", " ", 
             "could", " ", "be", " ", "skew", " ", "quads", " ", "and", " ", 
             "that", " ", "confuses", " ", "rendering"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"pts", "\[LeftDoubleBracket]", 
                  RowBox[{"iu", ",", "iv"}], "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"pts", "\[LeftDoubleBracket]", 
                  RowBox[{
                   RowBox[{"iu", "+", "1"}], ",", "iv"}], 
                  "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"pts", "\[LeftDoubleBracket]", 
                  RowBox[{
                   RowBox[{"iu", "+", "1"}], ",", 
                   RowBox[{"iv", "+", "1"}]}], "\[RightDoubleBracket]"}]}], 
                "}"}], "]"}], ",", "fs"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"pts", "\[LeftDoubleBracket]", 
                  RowBox[{
                   RowBox[{"iu", "+", "1"}], ",", 
                   RowBox[{"iv", "+", "1"}]}], "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"pts", "\[LeftDoubleBracket]", 
                  RowBox[{"iu", ",", 
                   RowBox[{"iv", "+", "1"}]}], "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"pts", "\[LeftDoubleBracket]", 
                  RowBox[{"iu", ",", "iv"}], "\[RightDoubleBracket]"}]}], 
                "}"}], "]"}], ",", "fs"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"iu", ",", "nu"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"iv", ",", "nv"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"so", "\[Equal]", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"polys", "=", 
        RowBox[{"ReversePolygons", "[", "polys", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ls", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{
        RowBox[{"Length", "[", "ls", "]"}], ",", "\[IndentingNewLine]", "0", ",", 
        RowBox[{"{", 
         RowBox[{"ls", ",", "ls", ",", "ls", ",", "ls"}], "}"}], ",", 
        "\[IndentingNewLine]", "1", ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{
            "ls", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], "===", "List"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ls", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"ls", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"ls", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"ls", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "ls", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "ls", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "ls", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "ls", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "}"}]}], "]"}], ",", "\[IndentingNewLine]", "4", ",", "ls", ",", 
        "\[IndentingNewLine]", "_", ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"StyledPatch", "::", "badline"}], ",", "ls"}], "]"}], ";", 
         
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"s", "[", 
        RowBox[{"u0", ",", "v0"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"polys", ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "ls", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "===",
           "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{"iu", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"iu", ",", 
                RowBox[{"nu", "+", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
           RowBox[{
           "ls", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "ls", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "===",
           "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"nu", "+", "1"}], ",", "iv"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"iv", ",", 
                RowBox[{"nv", "+", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
           RowBox[{
           "ls", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "ls", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "===",
           "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{"iu", ",", 
                RowBox[{"nv", "+", "1"}]}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"iu", ",", 
                RowBox[{"nu", "+", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
           RowBox[{
           "ls", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
          "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "ls", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "===",
           "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "iv"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"{", 
               RowBox[{"iv", ",", 
                RowBox[{"nv", "+", "1"}]}], "}"}]}], "]"}], "]"}], ",", 
           RowBox[{
           "ls", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
          "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "}"}]}], "}"}]}]}], "]"}]}]], "Input",
