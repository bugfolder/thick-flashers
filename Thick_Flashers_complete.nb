5d582fd4ff4e"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.64243303783393*^9, 
  3.642433038302685*^9}},ExpressionUUID->"f6e651fc-72ad-44d9-bf8e-\
cec6dceef7a5"],

Cell["\<\
A TMiuraMarsOri is a quadrilateral mesh consisting of alternating-direction \
but otherwise identical vertices that can construct both a Miura-ori (if the \
vertex is symmetric bird-foot) or a Barreto \[OpenCurlyQuote]Mars\
\[CloseCurlyQuote] pattern (if it is non-symmetric, but still flat-foldable), \
as well as binding varieties of Mars (if the vertex is non-flat-foldable).\
\>", "Text",
 CellChangeTimes->{{3.642433040561231*^9, 3.642433083285878*^9}, {
   3.642433125458121*^9, 3.642433179774569*^9}, 
   3.64305262769166*^9},ExpressionUUID->"2649f0e3-fcea-4474-ba99-\
14f3fb3d812f"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TObj class: TMiuraMarsOri
\tInherits from: TGraph3D, TAssigned, TCornerIndices, TGeneratingVertex\
\>", "Subsubsection",
 CellChangeTimes->{{3.592466313181075*^9, 3.592466323480549*^9}, 
   3.5926554192185497`*^9, 3.592828986137012*^9, 3.592829322587101*^9, 
   3.594741298380731*^9, 3.59498708801229*^9, {3.594991697107541*^9, 
   3.594991703226702*^9}, {3.59499196736926*^9, 3.59499197727188*^9}, 
   3.5950109222164187`*^9, {3.5950110640507298`*^9, 3.595011064354879*^9}, {
   3.595018821441722*^9, 3.595018821703145*^9}, 3.642433020441679*^9, {
   3.643240973268381*^9, 
   3.643240979267407*^9}},ExpressionUUID->"87b27c50-74ea-4120-a296-\
69a952f06c23"],

Cell["\<\
TMiuraMarsOri is a TObj class that specifies a periodic grid of identical but \
alternating-orientation degree-4 vertices forming an array of identical \
quadrilaterals. In the folded form, it folds flat and has a single degree of \
freedom in its motion.\
\>", "Text",
 CellChangeTimes->{{3.5924389566806183`*^9, 3.592438972831851*^9}, {
   3.592466848517621*^9, 3.592466873209172*^9}, 3.592829322670081*^9, 
   3.594987088123068*^9, {3.59499170776258*^9, 3.594991748206812*^9}, {
   3.5949917906042*^9, 3.594991791996702*^9}, {3.5950109223472*^9, 
   3.595010965913848*^9}, {3.6161624201756682`*^9, 3.616162421898091*^9}, 
   3.642433020509667*^9},ExpressionUUID->"4a8f0b26-26a4-471c-b791-\
e1a21910b5f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TMiuraMarsOri", "::", "usage"}], 
   "=", "\"\<TMiuraMarsOri is a TObj class that specifies a periodic grid of \
alternating degree-4 vertices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592438990875565*^9, 3.592438997072279*^9}, {
  3.592829322730996*^9, 3.5928293227554483`*^9}, {3.594987088152017*^9, 
