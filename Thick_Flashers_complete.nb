           RowBox[{"q", "[", "4", "]"}]}], "}"}], "=", 
         RowBox[{"NLinkedFoldsNext2D", "[", 
          RowBox[{
           RowBox[{"tf", "[", "2", "]"}], ",", 
           RowBox[{"q", "[", "2", "]"}], ",", 
           RowBox[{"\[Gamma]", "[", "2", "]"}], ",", 
           RowBox[{"tf", "[", "3", "]"}], ",", 
           RowBox[{"q", "[", "3", "]"}], ",", 
           RowBox[{"tf", "[", "4", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", 
           RowBox[{"Curve2DSystems", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"cs", "[", "2", "]"}], ",", 
              RowBox[{"cs", "[", "3", "]"}], ",", 
              RowBox[{"cs", "[", "4", "]"}]}], "}"}]}]}], "]"}]}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"InterpolatingFunction", "::", "dmval"}], "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"flist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", "[", "0", "]"}], ",", 
        RowBox[{"f", "[", "1", "]"}], ",", 
        RowBox[{"f", "[", "2", "]"}], ",", 
        RowBox[{"f", "[", "3", "]"}], ",", 
        RowBox[{"f", "[", "4", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StyledRuledPatchSequence", "[", 
          RowBox[{"flist", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
