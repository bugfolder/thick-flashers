Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeYoshimuraVertex", "::", "badangles"}], 
   "=", "\"\<The dihedral angles `1` and `2` must have the same sign.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.616163533758789*^9, 3.616163568618398*^9}, {
  3.6161639416440687`*^9, 3.616163969472775*^9}, {3.61616594046*^9, 
