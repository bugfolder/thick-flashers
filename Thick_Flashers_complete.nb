Cell[TextData[{
 "CrossedEdgeArrow[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}] takes an ordered pair of points and produces a line with an arrowhead in \
the middle of the line, pointing to the right relative to the direction arrow."
}], "Text",
 CellChangeTimes->{{3.457715338542871*^9, 3.457715372164214*^9}, 
   3.533504784588724*^9, {3.533504858232204*^9, 3.533504863301578*^9}, {
