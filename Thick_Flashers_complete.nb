Cell[TextData[{
 "Returns: a list {",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]} for the 2D flattened surface."
}], "Text",
 CellChangeTimes->{{3.799324786467416*^9, 3.799324817160604*^9}, {
