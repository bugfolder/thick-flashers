Cell[BoxData[
 RowBox[{
  RowBox[{"HCwCGraphics", "[", 
   RowBox[{"hcwc_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gopts", ",", "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", 
      "ff1", ",", "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", 
      "yR", ",", "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2",
       ",", "gc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", "ff1", ",", 
        "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", "yR", ",", 
        "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2"}], "}"}],
       "=", "hcwc"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gc", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"StyledRuledPatch", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f0", ",", "f1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"RulingLineStyle", "\[Rule]", "MountainRulingLine"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"RulingLineDivisions", "\[Rule]", "25"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"StyledRuledPatch", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f1", ",", "f2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"RulingLineStyle", "\[Rule]", "ValleyRulingLine"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"RulingLineDivisions", "\[Rule]", "25"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"StyledRuledPatch", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f2", ",", "f3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"RulingLineStyle", "\[Rule]", "MountainRulingLine"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"RulingLineDivisions", "\[Rule]", "25"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"StyledCurve", "[", 
         RowBox[{"f1", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"LineStyle", "\[Rule]", "ValleyLine"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"StyledCurve", "[", 
