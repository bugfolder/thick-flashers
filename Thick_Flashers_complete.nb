            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Styled2DAxes", "[", 
              RowBox[{"2", ",", "2"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"StyledRuledPatch", "[", 
              RowBox[{
               RowBox[{"Planarize", "[", "b", "]"}], ",", 
               RowBox[{"Planarize", "[", "d", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"StyledCurve", "[", 
