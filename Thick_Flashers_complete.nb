Cell["\<\
Another, based on the n=8 Archimedean tiling. Note that we need to give a \
nested list of edge types whose lengths match the requirements of the patch \
specs.\
\>", "Text",
 CellChangeTimes->{{3.6276579370140247`*^9, 3.627657948382809*^9}, {
  3.627660796838403*^9, 3.627660896032447*^9}, {3.6299794409418097`*^9, 
  3.629979457780025*^9}},ExpressionUUID->"74a4c848-64be-42fb-97af-\
97e184fa9f25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "w", ",", "\[Alpha]", ",", "tpatch", ",", "types", ",", 
      "patch", ",", "lattice", ",", "tiling", ",", "cliprect", ",", "ptiling",
       ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "8"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.12"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"29", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tpatch", "=", 
      RowBox[{"ArchimedeanPatch", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"V", ",", "V", ",", "V"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"V", ",", "V", ",", "V"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"V", ",", "V", ",", "V", ",", "V", ",", "V", ",", "V"}], 
         "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"patch", "=", 
      RowBox[{"UnitRegularPolygonCenteredTwistAltPatch", "[", 
       RowBox[{"tpatch", ",", "w", ",", "\[Alpha]", ",", "types"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"lattice", "=", 
      RowBox[{"ArchimedeanPatchLatticeVectors", "[", 
       StyleBox["n",
        FontSlant->"Italic"], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"MakeLatticeTiling", "[", 
       RowBox[{"patch", ",", "lattice", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cliprect", "=", 
      RowBox[{"RectVertices", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{".1", ",", ".1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3.9", ",", "3.9"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ptiling", "=", 
      RowBox[{"PruneTiling", "[", 
       RowBox[{"tiling", ",", "cliprect"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "show", " ", "tiling", " ", "before", " ", "and", " ", "after", " ", 
       "pruning"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"tiling", ",", "Tiling"}], "]"}], ",", 
             RowBox[{"PrunePoly", "[", "cliprect", "]"}]}], "}"}], "]"}], ",", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"ptiling", ",", "Tiling"}], "]"}], ",", 
             RowBox[{"PrunePoly", "[", "cliprect", "]"}]}], "}"}], "]"}]}], 
         "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "crease", " ", "pattern", " ", "and", " ", "folded", " ", "form", " ", 
       "tilings"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"ptiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"ptiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], "}"}], 
        "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"monolithic", " ", "versions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"ptiling", ",", "MonolithicTGraph2D", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
          RowBox[{"Graph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], 
       "]"}], "//", "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics", "[", 
          RowBox[{"VisibleFoldedFormGraphics", "[", 
           RowBox[{"tobj", ",", 
            RowBox[{"FaceupFace", "\[Rule]", "1"}]}], "]"}], "]"}]}], "}"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.629923653202988*^9, 3.629923821155902*^9}, {
