Cell[CellGroupData[{

Cell[TextData[{
 "FlasherSectorQuads[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "]\nFlasherSectorTriangles[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.7199193752252817`*^9, 
  3.719919377288163*^9}},ExpressionUUID->"4a45a40f-d454-4ec5-a04b-\
fffe307f2111"],

Cell[TextData[{
 "FlasherSectorQuads[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h, k",
  FontSlant->"Italic"],
 "] returns a list of vertex quadruplets for the quadrilateral facets in this \
order:\n\tbottom-outside\n\tbottom-inside\n\ttop-inside\n\ttop-outside\nSo \
that in the major region, the vertices cycle counterclockwise and in the \
minor region they cycle clockwise."
}], "Text",
 CellChangeTimes->{{3.5557871358253098`*^9, 3.5557871483932943`*^9}, {
   3.555787180565534*^9, 3.5557872809976187`*^9}, 3.5557873285904927`*^9, 
   3.555854306606194*^9, 3.555854344852313*^9, {3.719919428248264*^9, 
   3.719919437711693*^9}, {3.719943734367242*^9, 
   3.719943750015778*^9}},ExpressionUUID->"799346e3-23b4-448b-9978-\
bf3158a8254a"],

Cell["\<\
The quads will need to be triangulated; each quad can be triangulated in two \
ways.\
\>", "Text",
 CellChangeTimes->{
  3.719943752766724*^9},ExpressionUUID->"f5bc649b-6c40-4cc5-834e-\
3b3c32990981"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherSectorQuads", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "i", ",", "j", ",", "quad"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"r", "*", "h"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "total", " ", "number", " ", "of", " ", "radial", " ", "increments"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"major", " ", "region"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"j", "=", 
               RowBox[{"h", "*", "ig"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{
                   RowBox[{"j", "+", "h"}], ",", "i"}], "]"}], ">", "j"}], ",", 
                RowBox[{"quad", "[", 
                 RowBox[{
                  SubscriptBox["v", 
                   RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"i", "-", "1"}], ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"i", "-", "1"}], ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "h"}], ",", "i"}], "]"}], ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{"i", ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "h"}], ",", 
                    RowBox[{"i", "+", "1"}]}], "]"}], ",", "k"}]]}], "]"}], ",", 
                RowBox[{"{", "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ig", ",", "0", ",", 
              RowBox[{"r", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"h", "*", "ig"}], ",", "n"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"minor", " ", "region"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{
                RowBox[{"h", "*", "ig"}], "-", "1"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{
                   RowBox[{"i", "+", "h"}], ",", 
                   RowBox[{"j", "-", "2"}]}], "]"}], ">", "i"}], ",", 
                RowBox[{"quad", "[", 
                 RowBox[{
                  SubscriptBox["v", 
                   RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{"i", ",", 
                    RowBox[{"j", "-", "1"}], ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"i", "+", "h"}], ",", 
                    RowBox[{"j", "-", "2"}]}], "]"}], ",", 
                    RowBox[{"j", "-", "1"}], ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"i", "+", "h"}], ",", 
                    RowBox[{"j", "-", "1"}]}], "]"}], ",", "j", ",", "k"}]]}],
                  "]"}], ",", 
                RowBox[{"{", "}"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ig", ",", "0", ",", 
              RowBox[{"r", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{
               RowBox[{"h", "*", "ig"}], "+", "1"}], ",", "n"}], "}"}]}], 
           "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], "/.", 
       RowBox[{"quad", "\[Rule]", "List"}]}], "/.", 
      RowBox[{"FlasherWrapRules", "[", "v", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555752024152504*^9, 3.555752074979555*^9}, {
   3.555752202331157*^9, 3.555752222580246*^9}, {3.555752274078933*^9, 
