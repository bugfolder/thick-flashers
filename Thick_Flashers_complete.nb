Cell[TextData[{
 "ApplyCollinearCleanup3DTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 "] takes a TGraph3D that has already had ApplyCollinearCleanup applied and \
applies the modifications described by ",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 " to the Vertices3D data."
}], "Text",
 CellChangeTimes->{{3.707843669233399*^9, 3.707843705887328*^9}, {
