Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "ss", ",", "uu", ",", "u0", ",", "u1", ",", "v0", ",",
       "v1", ",", "sncf", ",", "sng", ",", "gmg", ",", "ggs", ",", "ggm"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{
          RowBox[{"a", " ", 
           SuperscriptBox["#1", "2"]}], "+", 
          RowBox[{"b", " ", 
           SuperscriptBox["#2", "2"]}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", "a", " ", "#1"}], 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["#1", "2"]}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["b", "2"], " ", 
              SuperscriptBox["#2", "2"]}]}]]]}], ",", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", "b", " ", "#2"}], 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["#1", "2"]}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["b", "2"], " ", 
              SuperscriptBox["#2", "2"]}]}]]]}], ",", 
         FractionBox["1", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["a", "2"], " ", 
             SuperscriptBox["#1", "2"]}], "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["b", "2"], " ", 
             SuperscriptBox["#2", "2"]}]}]]]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".3"}], ",", 
        RowBox[{"+", ".3"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sncf", "=", 
      RowBox[{"RainbowSurfaceColorFunction", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sng", "=", 
      RowBox[{"StyledSurfaceNormalGrid", "[", 
       RowBox[{"ss", ",", "uu", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}], ",", 
        RowBox[{"NormalVectorLength", "\[Rule]", "0.25"}], ",", 
        RowBox[{"SurfaceColorFunction", "\[Rule]", "sncf"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gmg", "=", 
      RowBox[{"StyledGaussMapGrid", "[", 
       RowBox[{"uu", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"GaussMapPointSize", "\[Rule]", "0.1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"SurfaceColorFunction", "\[Rule]", "sncf"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ggs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"StyledPatch", "[", 
             RowBox[{"ss", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", "sng"}], "}"}],
           ",", "\[IndentingNewLine]", 
          RowBox[{"Lighting", "\[Rule]", 
           RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
        "CurveVectorStyle"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ggm", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"StyledGaussianSphere", "[", "]"}], ",", "gmg"}], "}"}], 
         "]"}], "/.", "CurveVectorStyle"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{"ggs", ",", "ggm"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.691284233605445*^9, 3.6912844508642473`*^9}, {
