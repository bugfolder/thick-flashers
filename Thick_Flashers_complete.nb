   3.708963372979094*^9},ExpressionUUID->"279c5b02-3a28-4fc7-bd12-\
64e641327c5b"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["pts",
  FontSlant->"Italic"],
 " \[LongDash] a list of points (must all have the same dimension).\n\t",
 StyleBox["fuzzrad",
  FontSlant->"Italic"],
 " \[LongDash] the magnitude of the desired random perturbation vector."
}], "Text",
 CellChangeTimes->{{3.708344573320464*^9, 3.708344607630094*^9}, {
   3.708345245116144*^9, 3.708345245324918*^9}, {3.7083453404483213`*^9, 
   3.7083453413658752`*^9}, {3.708345420472466*^9, 3.708345443684782*^9}, {
   3.708413929199975*^9, 3.7084139428610916`*^9}, 3.7085915648513613`*^9, 
   3.708963372995996*^9},ExpressionUUID->"4d51663c-21b7-4520-9c9c-\
639d5d2511d6"],

Cell[TextData[{
 "Options:\n\tFuzzSeed \[Rule] ",
 StyleBox["seed",
  FontSlant->"Italic"],
 ", an additional seed that that be used to fuzz multiple copies of the same \
thing differently.\n\tFuzzMethod \[Rule] FuzzByVertex | FuzzByGroup, whether \
to perturb each vertex differently or all by the same amount"
}], "Text",
 CellChangeTimes->{{3.708591568529192*^9, 3.7085915851793556`*^9}, {
   3.708593023980363*^9, 3.708593030643051*^9}, 3.708963373017701*^9, {
   3.70896341722348*^9, 3.708963480911342*^9}, {3.7089635888019047`*^9, 
   3.708963617400884*^9}, {3.70896366708037*^9, 3.708963674609673*^9}, 
   3.708964332750501*^9},ExpressionUUID->"22c1699a-86e7-4c90-9438-\
4e4a571a308c"],

Cell["\<\
Fuzzing is a concept that we use to deal with problems arising in STL, \
whereby if the union of two objects has aligned edges, it makes the resulting \
object non-manifold. So in each GraphicsComplex, we perturb the vertices by a \
tiny random amount to break up such alignments among multiple \
GraphicsComplexes.\
\>", "Text",
 CellChangeTimes->{{3.708344236733422*^9, 3.708344315061047*^9}, {
  3.7084139570170937`*^9, 3.708413964202993*^9}, {3.708414227254134*^9, 
  3.7084142287475853`*^9}},ExpressionUUID->"277ff013-6c38-49bb-a46b-\
54de83c51fb1"],

Cell["\<\
It is best to apply fuzzing to objects where each distinct solid object is \
described by a single GraphicsComplex; otherwise, fuzzing will create holes \
in the mesh.\
\>", "Text",
 CellChangeTimes->{{3.708963777105294*^9, 
  3.708963807162156*^9}},ExpressionUUID->"e2ff3a46-7eaa-4c4e-86c4-\
42b3c68c35ca"],

Cell["\<\
Note that in 3D, fuzzing will break planarity of any any polygons with more \
than 3 sides, so you should triangulate anything with 3D polygons before \
fuzzing.\
\>", "Text",
 CellChangeTimes->{{3.708401636226878*^9, 3.708401659858465*^9}, {
  3.708591621244386*^9, 3.708591626801036*^9}, {3.70859168368575*^9, 
  3.708591693368512*^9}},ExpressionUUID->"e29f0e04-829a-469b-a753-\
ccb2ad1ca9ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FuzzSeed", "::", "usage"}], 
   "=", "\"\<FuzzSeed is an option to FuzzPoints that seeds the randomness of \
the fuzzing.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.708591703058088*^9, 3.708591731612493*^9}},
 CellLabel->
  "In[4280]:=",ExpressionUUID->"6e8b6496-9f7c-45b6-8b27-2e512071e905"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FuzzMethod", "::", "usage"}], 
   "=", "\"\<FuzzMethod is an option to FuzzPoints that specifies whether \
fuzzing is individually by vertex or all vertices get the same fuzz.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.708591703058088*^9, 3.708591731612493*^9}, {
  3.708963627298059*^9, 3.708963651616284*^9}},
 CellLabel->
  "In[4281]:=",ExpressionUUID->"3aee197f-07f6-49b6-bad7-c6989bd8c42f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FuzzByVertex", "::", "usage"}], 
   "=", "\"\<FuzzByVertex is an option value that specifies to give each \
vertex a unique fuzz value.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.708963656467726*^9, 3.708963707873186*^9}},
 CellLabel->
  "In[4282]:=",ExpressionUUID->"c3ad7a03-ab40-47b1-b9f9-5f4eaa960d90"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FuzzByGroup", "::", "usage"}], 
   "=", "\"\<FuzzByGroup is an option value that specifies to give each \
vertex the same fuzz value.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.708963656467726*^9, 3.708963729433338*^9}, {
  3.708964332768034*^9, 3.708964332785375*^9}},
 CellLabel->
  "In[4283]:=",ExpressionUUID->"4e49da66-17ab-445e-a608-b104226b22de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FuzzPoints", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"FuzzSeed", "\[Rule]", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FuzzMethod", "\[Rule]", "FuzzByVertex"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.708591735749523*^9, 3.708591751416102*^9}, {
  3.70896373410605*^9, 3.708963747250334*^9}},
 CellLabel->
  "In[4284]:=",ExpressionUUID->"79e0efda-1a07-4d5a-942a-68b6a4e8f87f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FuzzPoints", "::", "badmeth"}], 
   "=", "\"\<`1` is not a valid option for FuzzMethod.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.708963840295191*^9, 3.70896385805085*^9}},
 CellLabel->
  "In[4285]:=",ExpressionUUID->"2d0a1f15-b05e-4c8d-8cb7-001970ef0f43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FuzzPoints", "[", 
   RowBox[{"pts_List", ",", "fuzzrad_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"seed", ",", "fm", ",", "dim", ",", "fv"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"seed", "=", 
      RowBox[{
       RowBox[{"FuzzSeed", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FuzzPoints", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fm", "=", 
      RowBox[{
       RowBox[{"FuzzMethod", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FuzzPoints", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"SeedRandom", "[", 
      RowBox[{"Hash", "[", 
       RowBox[{"{", 
        RowBox[{"pts", ",", "seed"}], "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"fm", ",", "\[IndentingNewLine]", "FuzzByVertex", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"fuzzrad", " ", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"RandomReal", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"-", "1"}]}], "}"}], "]"}], ",", 
              RowBox[{"{", "dim", "}"}]}], "]"}], "]"}]}], "+", "#"}], "&"}], 
        "/@", "pts"}], ",", "\[IndentingNewLine]", "FuzzByGroup", ",", 
       RowBox[{
        RowBox[{"fv", "=", 
         RowBox[{"fuzzrad", " ", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}], "]"}], ",", 
             RowBox[{"{", "dim", "}"}]}], "]"}], "]"}]}]}], ";", 
        RowBox[{
         RowBox[{
          RowBox[{"fv", "+", "#"}], "&"}], "/@", "pts"}]}], ",", 
       "\[IndentingNewLine]", "_", ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"FuzzPoints", "::", "badmeth"}], ",", "fm"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.708344627289059*^9, 3.708344841390977*^9}, {
   3.70834494058057*^9, 3.70834499519265*^9}, {3.708345061783408*^9, 
