659ca6e6e0e1"],

Cell[TextData[{
 "Most functions that alter a TObj exist in two forms: DoSomethingTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["parms",
  FontSlant->"Italic"],
 "], and DoSomething[",
 StyleBox["parms",
  FontSlant->"Italic"],
 "]. The latter is a pure function and is provided because it supports a \
programming idiom common in object-oriented systems, of chaining object \
methods, using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s postfix \[OpenCurlyDoubleQuote]//\
\[CloseCurlyDoubleQuote] operator. It allows statements of the form\n\ttobj = \
tobj // DoSomething // DoSomethingElse // DoStilAnotherThing[",
 StyleBox["parms",
  FontSlant->"Italic"],
 "] ...\nand so forth to successively build up and/or modify an object. You \
will see many examples of this is the examples for each function."
}], "Text",
 CellChangeTimes->{{3.592707949691572*^9, 
  3.59270814519084*^9}},ExpressionUUID->"65f7d096-0282-48af-bf6a-\
9c3ff707b1c8"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ReplacePropertyIn[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rule",
  FontSlant->"Italic"],
 "]\nReplaceProperty[",
 StyleBox["rule",
  FontSlant->"Italic"],
 "]\nReplacePropertiesIn[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rules",
  FontSlant->"Italic"],
 "]\nReplaceProperties[",
 StyleBox["rules",
  FontSlant->"Italic"],
 "]\nAddPropertyTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rule",
  FontSlant->"Italic"],
 "]\nAddProperty[",
 StyleBox["rule",
  FontSlant->"Italic"],
 "]\nAddPropertiesTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rules",
  FontSlant->"Italic"],
 "]\nAddProperties[",
 StyleBox["rules",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.59163900289533*^9, 3.5916390110369883`*^9}, {
   3.591654474839326*^9, 3.591654481539237*^9}, {3.591696185241187*^9, 
   3.591696192136746*^9}, {3.592406797796924*^9, 3.592406822019079*^9}, {
   3.592670945751563*^9, 3.592670951373993*^9}, {3.592670998355365*^9, 
   3.592671001060855*^9}, 3.592676981950189*^9, 3.592677024839531*^9, 
   3.5926810979646587`*^9, {3.592681707225004*^9, 3.592681720266514*^9}, {
   3.592707720628967*^9, 3.592707735585066*^9}, {3.592707831357373*^9, 
   3.592707859506255*^9}, 
   3.592707895682061*^9},ExpressionUUID->"34668b0f-4219-4355-84f8-\
60b4359db5e1"],

Cell[TextData[{
 "ReplacePropertyIn",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rule",
  FontSlant->"Italic"],
 "] replaces a single property in ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " with the corresponding one in ",
 StyleBox["rule",
  FontSlant->"Italic"],
 " and returns the result. If ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " doesn\[CloseCurlyQuote]t contain the property, ",
 StyleBox["rule",
  FontSlant->"Italic"],
 " is ignored."
}], "Text",
 CellChangeTimes->{{3.592406110912367*^9, 3.592406176538302*^9}, 
   3.592681707302882*^9, 
   3.592707720744507*^9},ExpressionUUID->"123cce43-eeca-40f8-ae78-\
f40fd0587ea9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplacePropertyIn", "[", 
   RowBox[{"tobj_TObj", ",", "rule_Rule"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pos", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{
         "tobj", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{
          RowBox[{"First", "[", "rule", "]"}], "\[Rule]", "_"}], ",", "1"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "pos", "]"}], "\[NotEqual]", "0"}], ",", 
       RowBox[{"TObj", "[", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{
          RowBox[{
          "tobj", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{
           RowBox[{
           "pos", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Rule]",
            "rule"}]}], "]"}], "]"}], ",", "tobj"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.59240615804355*^9, 3.592406228017005*^9}, 
   3.592435730419077*^9, {3.592679804127851*^9, 3.592679841468639*^9}, {
