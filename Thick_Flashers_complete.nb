       RowBox[{"{", 
        RowBox[{"TwistFaces", "\[Rule]", "twistfaces"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.592469498377492*^9, 3.5924695273790903`*^9}, {
   3.592519723425968*^9, 3.592519753295986*^9}, 3.5926685760103903`*^9, 
   3.592828867380929*^9, {3.592829354300067*^9, 3.592829354338809*^9}, 
