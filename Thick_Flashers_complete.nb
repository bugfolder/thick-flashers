Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["{i1, f1, i2, f2}",
  FontSlant->"Italic"],
 " \[LongDash] An edge vertex neighborhood, e.g., from \
InteriorEdgeVertexNeighborhoods.\n\t",
 StyleBox["verts",
  FontSlant->"Italic"],
 " \[LongDash] the vertices that are indexed into by {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f2",
  FontSlant->"Italic"],
 "}."
}], "Text",
