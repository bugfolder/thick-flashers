}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FoldAngleLabels[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph3D\n\t(options) EdgeIndices, UseDegrees, \
FoldAngleForm"
}], "Subsubsection",
 CellChangeTimes->{{3.59420108482266*^9, 3.594201097348919*^9}, {
   3.594201155617905*^9, 3.594201168416314*^9}, {3.59421099140123*^9, 
   3.594211020335102*^9}, 3.594217887243222*^9, {3.594307792646179*^9, 
   3.594307793373136*^9}, {3.594308531270457*^9, 3.594308540515696*^9}, {
   3.595254765042938*^9, 3.595254784527774*^9}, {3.595286737112797*^9, 
   3.595286738233456*^9}, {3.595326770521678*^9, 3.595326776006793*^9}, {
   3.595327137409352*^9, 3.595327137719407*^9}, {3.595327177695087*^9, 
   3.595327180621195*^9}},ExpressionUUID->"d3ea7399-d462-4625-931d-\
b75f08754ccf"],

Cell[TextData[{
 "FoldAngleLabels[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] returns a list of labels on the edges of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " with the label given by its FoldAngles property. Options are:\n\t\
EdgeIndices \[Rule] True | False, specifies whether to display the index of \
the edge.\n\tUseDegrees \[Rule] True | False, specifies whether to show the \
angles in degrees rather than radians.\n\tFoldAngleForm \[Rule] ",
 StyleBox["f",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["f",
  FontSlant->"Italic"],
 " formats the value of the angle."
}], "Text",
