        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TestPleat", "[", 
            RowBox[{"#", ",", 
             RowBox[{"First", "[", "angles", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"pts", ",", 
             RowBox[{"RotateLeft", "[", "pts", "]"}]}], "}"}], "]"}]}], "]"}],
         ",", 
        RowBox[{"Graphics", "[", 
