Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bb", ",", "dd", ",", "ss", ",", "ff", ",", "u", ",", "u0", ",", "v"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bb", "[", "u", "]"}], "+", 
         RowBox[{"v", " ", 
          RowBox[{"dd", "[", "u", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"StyledCrossRuledPatch", "[", 
               RowBox[{"ss", ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "1"}], "}"}], ",", 
                RowBox[{"CrossLineStyle", "\[Rule]", "Purple"}]}], "]"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}]}], "}"}], 
         "]"}], "//", "ReverseFillStyle"}], ")"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.689466888674877*^9, 3.689466983298786*^9}, {
   3.689467605248785*^9, 3.689467646250866*^9}, {3.689553280042605*^9, 
