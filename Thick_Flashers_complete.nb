Cell[CellGroupData[{

Cell[TextData[{
 "BorderlessCreasePatternToGraph2DAssigned[",
 StyleBox["blcp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) SamePtTolerance, StationaryFace"
}], "Subsubsection",
 CellChangeTimes->{{3.627692471042678*^9, 3.62769253686759*^9}, {
  3.628021333272728*^9, 
  3.628021335277327*^9}},ExpressionUUID->"4ca334e7-89e2-444d-90c0-\
f9a99b49d317"],

Cell[TextData[{
 "BorderlessCreasePatternToGraph2DAssigned[",
 StyleBox["blcp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a borderless crease pattern ",
 StyleBox["blcp",
  FontSlant->"Italic"],
 ", given as a collection of styled lines and polygons, and turns it into a \
TGraph2D+TAssigned, i.e., a TGraph representing both crease pattern and \
folded form. Options are:\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", specifies the tolerance to use in Indexification of the vertex \
coordinates.\n\tStationaryFace \[Rule] sf, specifies which face remains \
stationary in the folded form."
}], "Text",
 CellChangeTimes->{{3.533669391156823*^9, 3.533669429658675*^9}, {
   3.533669460320707*^9, 3.533669466552266*^9}, {3.533669506277551*^9, 
