  3.7995704346720753`*^9}},ExpressionUUID->"0745720b-887d-427d-b5f8-\
803237827597"],

Cell[TextData[{
 "NearConstantWidthScale[",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d, opts",
  FontSlant->"Italic"],
 "] takes a directrix and director and returns the scaling function that \
gives a near-constant-width ribbon when the directrix is scaled by that \
quantity."
}], "Text",
 CellChangeTimes->{{3.799570099925936*^9, 3.7995701205764008`*^9}, {
  3.799570165270596*^9, 3.799570169939288*^9}, {3.799570208330106*^9, 
  3.799570238285617*^9}, {3.799570438480858*^9, 
  3.799570440162642*^9}},ExpressionUUID->"a9ae4be5-a532-4fdc-86a6-\
60f917c97937"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] a directrix as a pure function.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] a director as a pure function."
}], "Text",
 CellChangeTimes->{{3.799339977563547*^9, 3.799340073083741*^9}, 
   3.799340369941988*^9, {3.799340496927218*^9, 3.799340508559649*^9}, {
