Cell[TextData[{
 "Options:\n\tKillMergedEdges \[Rule] True | False, specify whether to remove \
merged edges\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", tolerance on whether two vertices are distinct."
}], "Text",
 CellChangeTimes->{{3.707777850542234*^9, 3.707777853581541*^9}, {
