Cell["\<\
This example labels the vertices of the CP with their {i, j, k} values, \
making use of FlasherIJKMap.\
\>", "Text",
 CellChangeTimes->{{3.825778560164813*^9, 3.825778593253035*^9}, {
  3.825778947160473*^9, 
  3.825778948399453*^9}},ExpressionUUID->"793ff112-09c8-484c-8ddc-\
d00b98d34ff8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "2"}], ",", 
      RowBox[{"m", "=", "4"}], ",", 
      RowBox[{"dr", "=", ".05"}], ",", "tobj", ",", "verts", ",", "ijkmap", ",",
       "labels"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeFlasher", "[", 
       RowBox[{"r", ",", "h", ",", "m", ",", "dr", ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"tobj", "[", "Vertices", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ijkmap", "=", 
      RowBox[{"tobj", "[", "FlasherIJKMap", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"labels", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"verts", "\[LeftDoubleBracket]", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "2"}], "}"}]}], "]"}], "&"}], "/@", "ijkmap"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", "labels", "}"}], "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
