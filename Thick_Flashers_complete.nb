Cell[TextData[{
 "Graphics3DExtent[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] returns the {",
 StyleBox["length",
  FontSlant->"Italic"],
 ", ",
 StyleBox["width",
  FontSlant->"Italic"],
 ", ",
 StyleBox["height",
  FontSlant->"Italic"],
 "} of the bounding box of all the Point, Line, and Polygon objects in ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ".  If there are no objects, it returns {0,0,0}."
}], "Text",
 CellChangeTimes->{{3.457529845663796*^9, 3.457529849551164*^9}, {
   3.592213213922827*^9, 3.592213219752509*^9}, 3.592213936239807*^9, {
   3.59221399082835*^9, 3.592213997068255*^9}, 3.6287864951115*^9, 
   3.643207939755897*^9, {3.803899286854198*^9, 3.8038992917581673`*^9}, {
   3.9256685741184187`*^9, 
   3.92566857529178*^9}},ExpressionUUID->"43826363-ee68-472b-894c-\
b71c74f10c85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics3DExtent", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bbox", ",", "xmin", ",", "xmax", ",", "ymin", ",", "ymax", ",", "zmin", 
      ",", "zmax"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bbox", "=", 
      RowBox[{"Graphics3DBoundingBox", "[", "expr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "bbox", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xmin", ",", "xmax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ymin", ",", "ymax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"zmin", ",", "zmax"}], "}"}]}], "}"}], "=", "bbox"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xmax", "-", "xmin"}], ",", 
          RowBox[{"ymax", "-", "ymin"}], ",", 
          RowBox[{"zmax", "-", "zmin"}]}], "}"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.457529852227374*^9, 3.4575298562981253`*^9}, {
