Cell[TextData[{
 "Intersectify[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph containing a collection of vertices and edges and creates \
a TGraph with a new vertex at the intersection of every pair of lines. \
Arguments are:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph.\nOptions are:\n\tIntersectionTolerance \[Rule] ",
 StyleBox["itol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["itol",
  FontSlant->"Italic"],
 " is the tolerance used to find intersections.\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the tolerance used during the Indexification step of merging \
overlapping vertices.\nIt returns a TGraph containing the modified graph."
}], "Text",
 CellChangeTimes->{{3.462813913471061*^9, 3.462813936589199*^9}, {
   3.46281397511378*^9, 3.4628140048234053`*^9}, {3.462814051083932*^9, 
   3.46281407343418*^9}, {3.5916523346132793`*^9, 3.591652341846454*^9}, 
   3.5924357391060743`*^9, {3.592441197585882*^9, 3.592441204961021*^9}, 
   3.594654001768977*^9, {3.676398874562927*^9, 3.6763989257903748`*^9}, {
   3.67647228023526*^9, 
   3.676472309553113*^9}},ExpressionUUID->"b8149927-fdc9-439c-9b95-\
6308a8d8bb95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Intersectify", "[", 
   RowBox[{"tobj_TObj", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "newemedges", ",", "newverts", ",", 
      "newedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "Intersectify"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newemedges", "=", 
      RowBox[{
       RowBox[{"EmbeddedIntersectify", "[", 
        RowBox[{"verts", ",", "edges", ",", "opts"}], "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"newverts", ",", "newedges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"newemedges", ",", "2", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newedges", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"newedges", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "\[NotEqual]", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", "newverts"}], ",", 
         RowBox[{"Edges", "\[Rule]", "newedges"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.462814035687296*^9, 3.462814049304615*^9}, {
   3.4628141141842527`*^9, 3.462814120375095*^9}, {3.462833188393023*^9, 
