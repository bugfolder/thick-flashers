  3.707859310035572*^9}},ExpressionUUID->"6af2310b-1e0e-4920-aaae-\
f4e25ff23cb4"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraphAssigned being reduced.\n\t",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 " \[LongDash] a list from CollinearCleanupData that descries the reduction."
}], "Text",
 CellChangeTimes->{{3.707843707838018*^9, 3.707843755815661*^9}, {
   3.707853111188617*^9, 3.707853141196183*^9}, 3.707857756921286*^9, {
