   3.703973957047902*^9, 3.703973994362458*^9}, 3.703974027506732*^9, 
   3.70397562168154*^9, 3.703976139639509*^9, {3.703976260485667*^9, 
   3.703976264027277*^9}, {3.703976496256774*^9, 3.703976499504319*^9}},
 CellLabel->
