Cell["\<\
This assignment is consistent relative to the quad position and splits the \
obtuse angles and, because of its consistent direction, ensures that there \
are never any interior degree-4 vertices. This is the method used in the \
Zirbel flasher paper. This also seems to be the direction that the pattern \
naturally flexes in the partially folded state.\
\>", "Text",
 CellChangeTimes->{
  3.7198532773720016`*^9, {3.719943945790621*^9, 3.71994394719092*^9}, {
   3.825671924774012*^9, 3.825671925044111*^9}, {3.825671981655147*^9, 
   3.825671984222517*^9}},ExpressionUUID->"8c282f7e-2b92-44a1-ad62-\
0a61c51926a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherSectorDiagFoldLinesY", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "fsq", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fsq", "=", 
      RowBox[{"FlasherSectorQuads", "[", 
       RowBox[{"v", ",", "r", ",", "h", ",", "k"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"#", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "3"}], "}"}], "\[RightDoubleBracket]"}], "]"}],
           ",", "FlasherLightFold"}], "]"}], "&"}], "/@", "fsq"}], "/.", 
      RowBox[{"FlasherWrapRules", "[", "v", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555798801341606*^9, 3.555798831006456*^9}, {
   3.5557989877636*^9, 3.555799030010644*^9}, {3.5558543079563*^9, 
