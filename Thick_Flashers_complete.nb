Cell[CellGroupData[{

Cell[TextData[{
 "NReshapeCone3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Beta], ",
 StyleBox["\[Psi]",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, uui",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[NDSolve], Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{
  3.79857276150193*^9, {3.798572806666256*^9, 3.79857284013316*^9}, {
   3.798573047101912*^9, 3.798573047750756*^9}, {3.798573191670987*^9, 
   3.798573194063023*^9}, {3.799318056173518*^9, 3.799318060157711*^9}, {
   3.7993245962218733`*^9, 3.799324599127043*^9}, {3.799332439904475*^9, 
   3.799332466902612*^9}, {3.799335581452736*^9, 3.799335581980678*^9}, {
   3.799344056904434*^9, 3.799344057272032*^9}, {3.799344087440324*^9, 
   3.799344106168263*^9}, {3.79934474959636*^9, 3.799344750060589*^9}, {
   3.799348095667705*^9, 3.799348106931168*^9}, 3.799353010394332*^9, {
   3.799398854753479*^9, 3.7993988563767576`*^9}, 3.800480771236352*^9, 
   3.800550220844137*^9},ExpressionUUID->"f2c8801b-2caa-4ddb-84e6-\
89eedd1894fe"],

Cell[TextData[{
 "NReshapeCone3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Beta], ",
 StyleBox["sv",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, uui",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D oriented developable surface specified by an oriented ruled \
parameterization with cone point directrix and returns a different oriented \
developable surface with the specified normal curvature along the directrix \
using interpolating functions."
}], "Text",
 CellChangeTimes->{{3.798572847292226*^9, 3.798572899717365*^9}, {
   3.7985731966001863`*^9, 3.798573197766917*^9}, {3.798574876085689*^9, 
   3.798574885212594*^9}, {3.798624528951817*^9, 3.798624530092536*^9}, {
   3.799324637560071*^9, 3.799324655520765*^9}, {3.799332469887213*^9, 
   3.799332506695383*^9}, {3.799335590716183*^9, 3.799335626092291*^9}, {
   3.799344112121814*^9, 3.799344145800688*^9}, {3.799344672411291*^9, 
   3.799344674627437*^9}, {3.799348165907903*^9, 3.799348184747322*^9}, {
   3.799398888589663*^9, 3.799398891081829*^9}, 
   3.800480771260359*^9},ExpressionUUID->"36bf4a29-2a27-49ed-ad56-\
f8a67d944b54"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the 3D directrix, as a pure function. It should return a \
constant value.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] the 3D director, as a pure function. It should be \
well-behaved.\n\t\[Sigma] \[LongDash] the orientation, which should be \
\[PlusMinus]1.\n\t\[Beta] \[LongDash] the product (curve speed) \[Times] \
(normal curvature), as a pure function\n\t",
 StyleBox["sv",
  FontSlant->"Italic"],
 " \[LongDash] the sign of ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", indicating which branch we\[CloseCurlyQuote]re on; should be \
\[PlusMinus]1.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter.\n\t",
 StyleBox["bbi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position of the new directrix.\n\t",
 StyleBox["ddi",
  FontSlant->"Italic"],
 " \[LongDash] the initial director of the new surface.\n\t",
 StyleBox["uui",
  FontSlant->"Italic"],
 " \[LongDash] the initial surface normal vector of the new surface.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the interpolation domain."
}], "Text",
 CellChangeTimes->{{3.798572971597745*^9, 3.798573067343102*^9}, {
  3.799324637570926*^9, 3.799324655529855*^9}, {3.799332511270781*^9, 
  3.799332544247019*^9}, {3.7993355394999647`*^9, 3.7993355691326942`*^9}, {
