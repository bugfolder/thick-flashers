Cell[CellGroupData[{

Cell[TextData[{
 "ThreeCycleCriticalTwistAngleCCW[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a2b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q3a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q3b",
  FontSlant->"Italic"],
 "}]\nThreeCycleCriticalTwistAngleCW[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a2b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q3a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q3b",
  FontSlant->"Italic"],
 "}]\nThreeCycleCriticalTwistAngles[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a2b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q3a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q3b",
  FontSlant->"Italic"],
 "}]\nThreeCycleCriticalTwistAngles[",
 StyleBox["plist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.457733459073151*^9, 3.457733493192416*^9}, {
   3.627431589698813*^9, 3.6274315962733727`*^9}, 3.627497352907399*^9, {
   3.627501293390409*^9, 
   3.627501346945437*^9}},ExpressionUUID->"23ad9f7a-3fe3-49f5-8ef6-\
323fef3239ba"],

Cell[TextData[{
 "ThreeCycleCriticalTwistAngleCCW[",
 StyleBox["{q1a,q1b},{q2a,a2b},{q3a,q3b}",
  FontSlant->"Italic"],
 "] takes the endpoints of three edges and returns the critical twist angle \
for those three edges for a counterclockwise (\[Alpha]\[LessEqual]\[Pi]/2) \
twist. If the direction vectors of the three edges lie in the same \
half-plane, then the critical angle is defined to be \[Pi]/2."
}], "Text",
 CellChangeTimes->{
  3.6275012934614487`*^9, {3.627508014354229*^9, 
   3.627508038480196*^9}},ExpressionUUID->"72c6756d-a1b0-4b64-9b33-\
8aeb809da6b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThreeCycleCriticalTwistAngleCCW", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1a_", ",", "q1b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q2a_", ",", "q2b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q3a_", ",", "q3b_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s1", ",", "s2", ",", "s3", ",", "ii", ",", "rpm", ",", "rt", ",", "p12",
       ",", "p23", ",", "t12", ",", "t23", ",", "u2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s1", "=", 
      RowBox[{"q1b", "-", "q1a"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s2", "=", 
      RowBox[{"q2b", "-", "q2a"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s3", "=", 
      RowBox[{"q3b", "-", "q3a"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"SameHalfPlaneQ", "[", 
        RowBox[{"s1", ",", "s2", ",", "s3"}], "]"}], ",", 
       RowBox[{"\[Pi]", "/", "2"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rpm", "=", 
         RowBox[{"RotationMatrix2D", "[", 
          FractionBox[
           RowBox[{"-", "\[Pi]"}], "2"], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"ii", "=", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rt", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rpm", ",", 
             RowBox[{"-", "ii"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ii", ",", "rpm"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p12", "=", 
         RowBox[{"q2b", "-", "q1b"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"p23", "=", 
         RowBox[{"q3b", "-", "q2b"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"t12", "=", 
         RowBox[{"LineInt2D", "[", 
          RowBox[{"q1b", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s2", ".", 
              RowBox[{"(", 
               RowBox[{"p12", ".", "rt"}], ")"}]}], ")"}], ".", "s1"}], ",", 
           "q2b", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s1", ".", 
              RowBox[{"(", 
               RowBox[{"p12", ".", "rt"}], ")"}]}], ")"}], ".", "s2"}]}], 
          "]"}]}], ";", 
        RowBox[{"t23", "=", 
         RowBox[{"LineInt2D", "[", 
          RowBox[{"q2b", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s3", ".", 
              RowBox[{"(", 
               RowBox[{"p23", ".", "rt"}], ")"}]}], ")"}], ".", "s2"}], ",", 
           "q3b", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s2", ".", 
              RowBox[{"(", 
               RowBox[{"p23", ".", "rt"}], ")"}]}], ")"}], ".", "s3"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"u2", "=", 
         RowBox[{"rpm", ".", 
          RowBox[{"(", 
           RowBox[{"t12", "-", "t23"}], ")"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "direction", " ", "vector", " ", "of", " ", "line", " ", "from", " ",
           "q2b", " ", "to", " ", "intersection", " ", "pt"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{"u2", ".", 
           RowBox[{"(", 
            RowBox[{"rpm", ".", "s2"}], ")"}]}], 
          RowBox[{"u2", ".", "s2"}]], "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{
  3.62750129349044*^9, {3.627502267838868*^9, 3.62750227997735*^9}, {
   3.627504108443743*^9, 3.627504110912149*^9}, {3.627508050014021*^9, 
   3.627508100432781*^9}, 3.629058085272165*^9, {3.6314867403992867`*^9, 
   3.631486749505935*^9}, 3.631486823193956*^9, {3.631488375599271*^9, 
