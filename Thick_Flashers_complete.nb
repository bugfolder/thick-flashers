Cell["Different outlining on the four sides.", "Text",
 CellChangeTimes->{{3.672145215392436*^9, 3.672145218792354*^9}, {
  3.6892726525644507`*^9, 
  3.689272658519356*^9}},ExpressionUUID->"08854ed6-e759-4804-8397-\
9117dd793dfa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "spp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{".5", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["#1", "2"], "+", 
              SuperscriptBox["#2", "2"]}], ")"}]}], ")"}]}]}], "}"}], "&"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"spp", "=", 
      RowBox[{"StyledPatch", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"OutlineStyle", "\[Rule]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Red", ",", 
             RowBox[{"Thickness", "[", ".02", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"Green", ",", 
             RowBox[{"Thickness", "[", ".02", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"Blue", ",", 
             RowBox[{"Thickness", "[", ".02", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"Gray", ",", 
             RowBox[{"Thickness", "[", ".02", "]"}]}], "}"}]}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"spp", "//", "AddShadow"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.672145224678674*^9, 3.672145283829448*^9}, {
