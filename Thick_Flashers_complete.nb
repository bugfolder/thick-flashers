Cell[CellGroupData[{

Cell["DoubleSpiralGraph3DAssigned", "Subsubsection",
 CellChangeTimes->{{3.731191795877872*^9, 
  3.731191800701356*^9}},ExpressionUUID->"6109d0ec-edbf-4c0b-a080-\
8a5dc1e26311"],

Cell["\<\
DoubleSpiralGraph3DAssigned gives a Yoshimura-Miura-ori hybrid that spirals \
in two directions.\
\>", "Text",
 CellChangeTimes->{{3.731192022807126*^9, 
  3.731192055750337*^9}},ExpressionUUID->"7b2150f1-b3fa-4cb2-9a99-\
49c5aef377b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DoubleSpiralGraph3DAssigned", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"DoubleSpiralGraph3DAssigned", ",", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "alist", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"alist", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "i"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"30.", "\[Degree]"}], "+", 
             RowBox[{"i", " ", "4.", "\[Degree]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "10"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"alist", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "alist", "]"}], ",", "alist"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"MakeYoshimuraMiuraOri", "[", 
        RowBox[{"alist", ",", "10", ",", 
         RowBox[{"60.", "\[Degree]"}]}], "]"}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.731190293945926*^9, 3.73119035228908*^9}, {
  3.731190540108581*^9, 3.731190570892138*^9}, {3.731190918914007*^9, 
  3.7311909640685797`*^9}, {3.731191251422048*^9, 3.731191276872381*^9}, {
  3.731191517986594*^9, 3.731191542941915*^9}, {3.731191575910128*^9, 
  3.731191582638475*^9}, {3.731191695042766*^9, 3.731191719846727*^9}, {
  3.7311919798581553`*^9, 3.731192002758174*^9}},
 CellLabel->
  "In[2539]:=",ExpressionUUID->"f9597221-8b24-4e9e-bef5-1298e6dc3dcc"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.731192273125831*^9, 
  3.731192274046583*^9}},ExpressionUUID->"e8ac1eed-a826-4ff2-b51d-\
cfe7c9ee9784"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
