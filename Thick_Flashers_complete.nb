   3.689075255799596*^9, {3.689247644443892*^9, 3.689247677568938*^9}, 
   3.689274355348628*^9, {3.689274691110231*^9, 3.689274779809745*^9}, {
   3.689274991595607*^9, 3.68927499161875*^9}, {3.689275290692831*^9, 
   3.689275290711602*^9}, {3.689275398823407*^9, 3.689275401272091*^9}, {
   3.689461619492234*^9, 3.689461641486973*^9}, {3.6898545856502438`*^9, 
   3.689854585667904*^9}, {3.689854847491195*^9, 3.689854987300775*^9}, {
