Cell[CellGroupData[{

Cell[TextData[{
 "ApplyMergeTo[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 "]\nApplyMerge[",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.707868775722307*^9, 3.707868792529422*^9}, 
   3.707868829433176*^9, {3.707904773346949*^9, 3.707904778572029*^9}, 
   3.707905193976967*^9},ExpressionUUID->"4a85e864-c4c7-46a2-b45e-\
be2f0e188f27"],

Cell[TextData[{
 "ApplyMergeTo[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["tglist",
  FontSlant->"Italic"],
 " of TGraphs and, using the data in ",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 ", constructs a new single TGraph that is the merged result. Faces data is \
left empty in the merged graph."
}], "Text",
 CellChangeTimes->{{3.7078688337367363`*^9, 3.707868871626235*^9}, {
   3.707869556873554*^9, 3.70786957699251*^9}, {3.707902703447701*^9, 
   3.707902703913546*^9}, 3.707905194787799*^9, {3.707905359017596*^9, 
   3.707905361554587*^9}},ExpressionUUID->"9fce0a7d-b368-411d-9fcb-\
7f0a6a6b2486"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyMergeTo", "[", 
   RowBox[{"tglist_List", ",", "mgdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vlist", ",", "elist", ",", "nverts", ",", "vm", ",", "nedges"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vlist", ",", "elist"}], "}"}], "=", "mgdata"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Range", "[", 
          RowBox[{"Max", "[", 
           RowBox[{"Flatten", "[", "vlist", "]"}], "]"}], "]"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#1", "\[NotEqual]", "0"}], ",", 
          RowBox[{
           RowBox[{
           "nverts", "\[LeftDoubleBracket]", "#1", "\[RightDoubleBracket]"}], 
           "=", 
           RowBox[{
            RowBox[{
             RowBox[{"tglist", "\[LeftDoubleBracket]", 
              RowBox[{
              "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}], "[", "Vertices", "]"}], "\[LeftDoubleBracket]", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}]}]}], "]"}], "&"}], ",", "vlist", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"vm", "[", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "]"}], " ", "gives", " ", "new", " ",
        "vertex", " ", "index", " ", "from", " ", "jth", " ", "vertex", " ", 
       "of", " ", "ith", " ", "graph"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vm", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
            "}"}], "]"}], "=", "#1"}], ")"}], "&"}], ",", "vlist", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"new", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Range", "[", 
          RowBox[{"Max", "[", 
           RowBox[{"Flatten", "[", "elist", "]"}], "]"}], "]"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#1", "\[NotEqual]", "0"}], ",", 
          RowBox[{
           RowBox[{
           "nedges", "\[LeftDoubleBracket]", "#1", "\[RightDoubleBracket]"}], 
           "=", 
           RowBox[{"vm", "/@", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                 "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
                  ",", 
                 RowBox[{
                 "#2", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "}"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"tglist", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#2", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "[", 
                 "Edges", "]"}], "\[LeftDoubleBracket]", 
                RowBox[{
                "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                "\[RightDoubleBracket]"}]}], "}"}], "]"}]}]}]}], "]"}], "&"}],
        ",", "elist", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"nverts", ",", "nedges"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707868894641435*^9, 3.707868914458689*^9}, {
  3.70786954355291*^9, 3.707869551344592*^9}, {3.70786961069764*^9, 
  3.7078696275130253`*^9}, {3.707869709408419*^9, 3.70786972897409*^9}, {
  3.707869769011918*^9, 3.707869906078636*^9}, {3.707869938740899*^9, 
  3.707870008932722*^9}, {3.707870041957165*^9, 3.7078700562058496`*^9}, {
  3.707870115966515*^9, 3.7078701323662558`*^9}, {3.7079019950675*^9, 
  3.707902053790906*^9}, {3.707902135677008*^9, 3.707902343542628*^9}, {
  3.707902426416277*^9, 3.707902508610379*^9}, {3.707902541711972*^9, 
  3.707902611906118*^9}, {3.707902678729362*^9, 3.707902692992898*^9}, {
  3.707902755451519*^9, 3.707902757265239*^9}, {3.707905195606553*^9, 
  3.707905197315658*^9}},
 CellLabel->
  "In[1228]:=",ExpressionUUID->"20bee9a1-c228-4c06-aace-ea91755201b7"],

