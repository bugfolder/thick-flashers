Cell[CellGroupData[{

Cell[TextData[{
 "MakePlanarRoundedPlateGCs[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) RoundingDivisions"
}], "Subsubsection",
 CellChangeTimes->{
  3.7083463951178102`*^9, {3.7083466565060596`*^9, 3.708346656922041*^9}, 
   3.708398263343669*^9, 3.708401214565505*^9, 3.7084777003563023`*^9, 
   3.708590213473912*^9, {3.708590401679401*^9, 3.708590404885724*^9}, 
   3.708590667872664*^9, 3.708601697953409*^9, {3.708601745294326*^9, 
   3.708601745987336*^9}},ExpressionUUID->"4f9debfb-5bc9-4256-bccb-\
313424fe9571"],

Cell[TextData[{
 "MakePlanarRoundedPlateGCs[",
 StyleBox["gg",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes any collection of 3D Polygons (and other things), extracts the \
Polygons (which should be planar and strictly convex) and converts them all \
to rounded plates as GraphicsComplex objects."
}], "Text",
 CellChangeTimes->{{3.459090724103221*^9, 3.459090749052872*^9}, {
   3.459090799954756*^9, 3.459090962910574*^9}, 3.708346660105153*^9, {
   3.708401202233288*^9, 3.70840121460982*^9}, {3.708414680393411*^9, 
   3.7084146815420732`*^9}, {3.708414756840475*^9, 3.708414758147098*^9}, 
   3.7085902135237517`*^9, 3.708590667945372*^9, 3.708601698027622*^9, {
   3.708601769375031*^9, 
   3.708601801436782*^9}},ExpressionUUID->"1c435c70-f3ca-45b7-82c8-\
c55c8f465bda"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any Graphics3D collection of Polygons (and other things).\n\t\
",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of rounding, and half the desired total thickness."
}], "Text",
 CellChangeTimes->{{3.708414700991184*^9, 3.7084147448857946`*^9}, {
  3.708601805368771*^9, 
  3.70860180583747*^9}},ExpressionUUID->"36f9a40d-e22e-49bf-8740-\
3efd694cfd1a"],

Cell[TextData[{
 "Options:\n\tRoundingDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 " are passed through to MakePlanarRoundedPlateGC."
}], "Text",
 CellChangeTimes->{{3.708414685531008*^9, 3.7084146987762427`*^9}, 
   3.708570157252769*^9, {3.7085904291140227`*^9, 3.708590452023184*^9}, 
   3.708601722336771*^9},ExpressionUUID->"086f8eac-5fb7-442a-a0c1-\
83c1e137ad38"],

Cell["\<\
Returns: a bare (no styling) list of GraphicsComplexes, in which each \
GraphicsComplex represents a single rounded plate.\
\>", "Text",
 CellChangeTimes->{{3.708414763124028*^9, 
  3.708414770366495*^9}},ExpressionUUID->"c4ae9f89-5031-4a12-97da-\
d132b5885961"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePlanarRoundedPlateGCs", "[", 
   RowBox[{"expr_", ",", "r_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "polys", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"polys", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"expr", ",", "_Polygon", ",", "\[Infinity]"}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"MakePlanarRoundedPlateGC", "[", 
        RowBox[{"#", ",", "r", ",", "opts"}], "]"}], "&"}], "/@", 
      "polys"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.4590909651859093`*^9, 3.459091027077569*^9}, {
   3.708401202268585*^9, 3.708401214628218*^9}, 3.708570157292161*^9, 
   3.708590213539015*^9, {3.708590263048949*^9, 3.708590272985503*^9}, 
   3.708590382209505*^9, 3.708590667968474*^9, {3.708601698059721*^9, 
   3.708601722363986*^9}, {3.708601808921858*^9, 3.708601813528988*^9}},
 CellLabel->
  "In[4266]:=",ExpressionUUID->"772c6e63-d7b7-4bf0-91af-bed0440ec227"],

Cell["\<\
Example. Original Graphics3D, thickened/rounded, and thickened/rounded with \
PlateFuzz.\
\>", "Text",
 CellChangeTimes->{{3.459091043738866*^9, 3.459091044473785*^9}, 
   3.708346939893416*^9, {3.708347033127913*^9, 3.708347061937512*^9}, {
   3.708414799726013*^9, 
   3.708414806431631*^9}},ExpressionUUID->"b4d48c60-1f10-40c9-a6e4-\
bf47d42538f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"poly1", ",", "poly2", ",", "gg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"poly1", "=", 
      RowBox[{"Polygon", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"poly2", "=", 
      RowBox[{"Polygon", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"poly1", ",", "poly2"}], "}"}], ",", 
         RowBox[{"FaceForm", "[", 
          RowBox[{"Green", ",", "Red"}], "]"}], ",", 
         RowBox[{"EdgeForm", "[", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", "Blue"}], "}"}], "]"}]}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"gg", ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"MakePlanarRoundedPlateGCs", "[", 
            RowBox[{"gg", ",", "0.25", ",", 
             RowBox[{"RoundingDivisions", "\[Rule]", "6"}]}], "]"}], ",", 
           RowBox[{"FaceForm", "[", 
            RowBox[{"Cyan", ",", "Yellow"}], "]"}]}], "]"}], "]"}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.4590910495098968`*^9, 3.459091199398263*^9}, 
   3.459091245501019*^9, {3.459091279836004*^9, 3.459091298114651*^9}, {
   3.45911417087817*^9, 3.459114207747715*^9}, 3.708345728287483*^9, {
   3.708346613325145*^9, 3.708346628566895*^9}, {3.708346667323943*^9, 
   3.708346703485126*^9}, 3.70834692874224*^9, {3.708346978513538*^9, 
   3.708347010782588*^9}, {3.708347066470718*^9, 3.708347069783253*^9}, {
