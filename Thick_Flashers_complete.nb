 RowBox[{
  RowBox[{
   RowBox[{"RadialAxialTolerance", "::", "usage"}], 
   "=", "\"\<RadialAxialTolerance is an option to RadialAxialOrderingFn that \
specifies the tolerance on switching between radial and axial \
ordering.\>\""}], ";"}]], "Input",
