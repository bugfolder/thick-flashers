  3.9148387911710997`*^9}},ExpressionUUID->"c591dc39-3ba2-425b-a2ad-\
f1df6a250ef0"],

Cell[TextData[{
 "Options:\n\tPanelMinThickness \[Rule] ",
 StyleBox["pmt",
  FontSlant->"Italic"],
 ", the minimum thickness of the triangular panels (blunting the \
\[OpenCurlyDoubleQuote]knife-edge\[CloseCurlyDoubleQuote])."
}], "Text",
 CellChangeTimes->{{3.912178020781704*^9, 3.91217811562254*^9}, {
