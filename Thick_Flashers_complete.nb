   3.707758144992279*^9},ExpressionUUID->"4fa1237a-b263-414d-bfab-\
25da174f394d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuadrilateralSplitTwistTile", "::", "badtypes"}], 
   "=", "\"\<Length `1` of vertex list `2` and length `3` of types list `4` \
do not match.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629826084863046*^9, 3.629826122274577*^9}, 
   3.630018349669633*^9, 3.630072603377318*^9},
 CellLabel->
