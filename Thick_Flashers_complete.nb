  "In[2124]:=",ExpressionUUID->"1c404806-baa2-4ebf-a98d-05ee78c6e5e7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"CreaseVectors", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["g", "1"], ",", " ", 
      SubscriptBox["g", "2"], ",", " ", "..."}]}]}], TraditionalForm]],
  ExpressionUUID->"e69e0eb1-f26f-4f51-8b62-a61f159c09d6"],
 "} is a TObj property that specifies the 2D vectors along the creases, i.e., \
normalized versions of the input vectors) in the crease pattern. They are \
distributed over 2\[Pi] proportional to the sector angles (which could sum to \
more or less than 2\[Pi]) and by convention have the first vector along the \
",
 StyleBox["x",
  FontSlant->"Italic"],
 " axis."
}], "Text",
 CellChangeTimes->{{3.592076734681664*^9, 3.59207686379569*^9}, 
   3.592435753610674*^9, {3.594942497150515*^9, 3.594942525012895*^9}, {
   3.59494255825886*^9, 
   3.594942575873708*^9}},ExpressionUUID->"28f2aa8e-f897-4719-a661-\
3818064c6062"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CreaseVectors", "::", "usage"}], 
   "=", "\"\<CreaseVectors is a TObj property that specifies the 2D vectors \
along the creases around a vertex in the crease pattern.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592075703941037*^9, 3.592075763044495*^9}, {
   3.592075862617152*^9, 3.592075895782761*^9}, {3.592076200085617*^9, 
   3.592076200113782*^9}, 3.5924357536880207`*^9},
