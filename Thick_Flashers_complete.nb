Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"TestTile", ",", "n_"}], "}"}], ",", "TileVertices", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"UnitRegularPolygonVertices", "[", "n", "]"}]}]], "Input",
 CellChangeTimes->{{3.629763183710498*^9, 3.62976323297659*^9}, 
   3.707757305265147*^9},
 CellLabel->
