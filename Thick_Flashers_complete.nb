   3.912346329091951*^9, 3.912346354490658*^9}, {3.912346393596171*^9, 
   3.912346443234237*^9}, {3.912346821844005*^9, 3.912346871927256*^9}, 
   3.912347053822378*^9, {3.912352409453052*^9, 3.91235240999159*^9}, {
