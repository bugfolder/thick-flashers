Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeTHuffmanGrid", "[", 
    RowBox[{
     StyleBox["vtobj",
      FontSlant->"Italic"], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "1"], ",", 
       SubscriptBox[
        StyleBox["d",
         FontSlant->"Italic"], "2"]}], 
      StyleBox["}",
       FontSlant->"Italic"]}], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["nh",
        FontSlant->"Italic"], ",", 
       StyleBox["nv",
        FontSlant->"Italic"]}], 
      StyleBox["}",
       FontSlant->"Italic"]}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "4406a7a6-9424-4e4f-9e64-aa438d39a76f"],
 "\n\t(checked classes) TVertex"
}], "Subsubsection",
 CellChangeTimes->{{3.442882648950871*^9, 3.442882664709007*^9}, {
   3.4429714408856487`*^9, 3.442971444757379*^9}, {3.443015699100732*^9, 
   3.443015732241214*^9}, {3.443017557649104*^9, 3.4430175647959137`*^9}, {
   3.443030898204883*^9, 3.443030903068399*^9}, {3.443220679004146*^9, 
   3.443220679681783*^9}, {3.44322129102423*^9, 3.443221306357909*^9}, {
   3.592084544510817*^9, 3.592084548798002*^9}, 3.592084649607286*^9, {
   3.592438938452269*^9, 3.5924389484895887`*^9}, 3.592466310095572*^9, 
   3.5928293229162407`*^9, 3.594987088450006*^9, {3.594992077387396*^9, 
   3.594992178797234*^9}, {3.5949923067767*^9, 3.594992317314196*^9}, {
   3.594992426799841*^9, 3.594992429625251*^9}, {3.594996713533977*^9, 
   3.594996714557755*^9}, {3.594996953689207*^9, 3.5949969560255837`*^9}, {
   3.595003485036835*^9, 3.595003485305236*^9}, {3.59500358508576*^9, 
   3.59500359857935*^9}, {3.595003803998988*^9, 3.5950038061180053`*^9}, {
   3.643240814058566*^9, 3.643240814058665*^9}, 3.701379346965742*^9, 
   3.70137948058954*^9},ExpressionUUID->"23ef6fb8-58ef-400b-9b1b-\
3a5f8f6a369a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"MakeTHuffmanGrid", "[", 
    RowBox[{
     StyleBox["vtobj",
      FontSlant->"Italic"], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "1"], ",", 
       SubscriptBox[
        StyleBox["d",
         FontSlant->"Italic"], "2"]}], 
      StyleBox["}",
       FontSlant->"Italic"]}], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["nh",
        FontSlant->"Italic"], ",", 
       StyleBox["nv",
        FontSlant->"Italic"]}], 
      StyleBox["}",
       FontSlant->"Italic"]}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "2428ff9f-fe0d-470d-8d66-83278d272b30"],
 " returns a TGraph+TAssigned+TCornerIndices+TGeneratingVertex that \
represents a Huffman grid, where:\n\t",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 " is a degree-4 TVertex representing the vertex from which it is built,\n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["d", "1"], ",", 
     SubscriptBox[
      StyleBox["d",
       FontSlant->"Italic"], "2"]}], 
    StyleBox["}",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "fece8c6e-3fb9-4bdf-a463-7fe4afd0fd34"],
 " are two of the fold lengths around the vertex (the other two are \
determined by the angles),\n\t ",
 StyleBox["nh",
  FontSlant->"Italic"],
 " is the number of repeats along the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], "-", 
    SubscriptBox["\[Gamma]", "3"]}], TraditionalForm]],ExpressionUUID->
  "4bbe5328-9e34-4320-a191-0cb78df803ed"],
 " chain\n\t ",
 StyleBox["nv",
  FontSlant->"Italic"],
 " is the number of repeats along the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "2"], "-", 
    SubscriptBox["\[Gamma]", "4"]}], TraditionalForm]],ExpressionUUID->
  "c4622ed4-275e-42bc-b4f0-6e68a4c83e64"],
 " chain.\n Note, ",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 " does not need to be in standard position, but its sector and dihedral \
angles do need to be consistent."
}], "Text",
 CellChangeTimes->{{3.442882672893553*^9, 3.4428828116669903`*^9}, {
   3.4429714489772468`*^9, 3.4429714526062803`*^9}, {3.443015737240294*^9, 
   3.443015886482121*^9}, {3.4430175708891*^9, 3.4430176693597517`*^9}, 
   3.443220653198539*^9, {3.443220689660924*^9, 3.4432207392757607`*^9}, {
   3.443221309867934*^9, 3.4432213362789187`*^9}, {3.59208444067141*^9, 
   3.592084496129277*^9}, 3.592435758332773*^9, {3.592439012815792*^9, 
   3.592439014181987*^9}, {3.592829323117475*^9, 3.592829323211237*^9}, {
   3.594987088587085*^9, 3.594987088719049*^9}, {3.594992190044483*^9, 
   3.5949922535738363`*^9}, 3.594992334376874*^9, {3.594992446832039*^9, 
   3.594992469842762*^9}, {3.594996716624131*^9, 3.594996723550061*^9}, {
   3.5949969594661407`*^9, 3.594996962447666*^9}, {3.595003494121017*^9, 
   3.595003561541481*^9}, 3.595003819112583*^9, {3.595005058118781*^9, 
   3.595005139568651*^9}, {3.595006633881788*^9, 3.595006634455713*^9}, {
   3.643240625490673*^9, 3.643240779222632*^9}, {3.64324081513797*^9, 
   3.64324081711138*^9}},ExpressionUUID->"2a4b504a-ea61-4046-94a6-\
bdd05fe8a674"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTHuffmanGrid", "::", "badsize"}], 
   "=", "\"\<TVertex `1` must be degree-4; its degree is `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.595005148978063*^9, 3.5950051820813847`*^9}},
 CellLabel->
  "In[2466]:=",ExpressionUUID->"51eba704-edee-46d6-a144-7e359383b23a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTHuffmanGrid", "::", "badlens"}], 
   "=", "\"\<Lengths `1` give one or more negative values in `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594996144774262*^9, 3.594996205001796*^9}},
 CellLabel->
  "In[2467]:=",ExpressionUUID->"41503411-8509-4eed-9a04-0692901e93e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTHuffmanGrid", "[", 
   RowBox[{"vtobj_TObj", ",", 
    RowBox[{"{", 
     RowBox[{"d1_", ",", "d2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"nh_", ",", "nv_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "da", ",", "cv", ",", "d3", ",", "d4", ",", "dd", ",", "vfn", ",", 
      "gtobj", ",", "types", ",", "foldangles", ",", "ei"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"vtobj", ",", "TVertex", ",", "MakeTHuffmanGrid"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"da", ",", "cv"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"vtobj", ",", 
        RowBox[{"{", 
         RowBox[{"DihedralAngles", ",", "CreaseVectors"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "da", "]"}], "\[NotEqual]", "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTHuffmanGrid", "::", "badsize"}], ",", "vtobj", ",", 
          RowBox[{"Length", "[", "da", "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"quadrilateral", " ", "side", " ", "lengths"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"d3", ",", "d4"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d3", ",", "d4"}], "}"}], "/.", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"d1", " ", 
             RowBox[{
             "cv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "-", 
            RowBox[{"d2", " ", 
             RowBox[{
             "cv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "+", 
            RowBox[{"d3", " ", 
             RowBox[{
             "cv", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], "-", 
            RowBox[{"d4", " ", 
             RowBox[{
             "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}]}],
            "\[Equal]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"d3", ",", "d4"}], "}"}]}], "]"}], "\[LeftDoubleBracket]", 
        "1", "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"{", 
       RowBox[{"d1", ",", "d2", ",", "d3", ",", "d4"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"d3", "\[LessEqual]", 
        RowBox[{
         RowBox[{"0", "!!"}], "d4"}], "\[LessEqual]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTHuffmanGrid", "::", "badlens"}], ",", 
          RowBox[{"{", 
           RowBox[{"d1", ",", "d2"}], "}"}], ",", "dd"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{"i", "/", "2"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d1", " ", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "-", 
          RowBox[{"d3", " ", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}]}], 
         ")"}]}], "+", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{"j", "/", "2"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d2", " ", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "-", 
          RowBox[{"d4", " ", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}]}], 
         ")"}]}], "+", "\[IndentingNewLine]", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EvenQ", "[", "i", "]"}], "&&", 
          RowBox[{"EvenQ", "[", "j", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"OddQ", "[", "i", "]"}], "&&", 
          RowBox[{"EvenQ", "[", "j", "]"}]}], ",", 
         RowBox[{"d1", " ", 
          RowBox[{
          "cv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"EvenQ", "[", "i", "]"}], "&&", 
          RowBox[{"OddQ", "[", "j", "]"}]}], ",", 
         RowBox[{"d2", " ", 
          RowBox[{
          "cv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",",
          "\[IndentingNewLine]", "True", ",", 
         RowBox[{
          RowBox[{"d1", " ", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "-", 
          RowBox[{"d4", " ", 
           RowBox[{
           "cv", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}]}]}],
         "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gtobj", "=", 
      RowBox[{"MakeRectangularQuadMesh", "[", 
       RowBox[{"nh", ",", "nv", ",", "vfn", ",", 
        RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Go", " ", "back", " ", "and", " ", "assign", " ", "edge", " ", "types",
        " ", "and", " ", "fold", " ", "angles"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"gtobj", "[", "EdgeTypes", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"mostly", " ", "U"}], ",", " ", 
       RowBox[{"but", " ", "borders", " ", "are", " ", "B"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "types", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"\"\<horizontal\>\"", " ", "folds"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ei", "=", 
           RowBox[{"i", "+", 
            RowBox[{"j", " ", "nh"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "===", "B"}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", 
               RowBox[{"i", "+", "j"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                 "da", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
