Cell[TextData[{
 "ClipSegmentSetToConvexPolygon[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] takes the segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "} and returns a segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["isa",
  FontSlant->"Italic"],
 "} that is clipped to lie wholly within the specified convex polygon ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.484767910982916*^9, 3.484767952188214*^9}, {
  3.484768040199594*^9, 
  3.484768041470489*^9}},ExpressionUUID->"9727e9b6-199d-411f-be69-\
ff6eee42f5b3"],

Cell[TextData[{
 StyleBox["poly",
  FontSlant->"Italic"],
 " can be either CW or CCW. We determine interiorness from the centroid."
}], "Text",
 CellChangeTimes->{{3.628120780406887*^9, 
  3.6281208041242537`*^9}},ExpressionUUID->"415474eb-51fc-433d-9e57-\
5392cd1247ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClipSegmentSetToConvexPolygon", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1_", ",", " ", "q2_", ",", " ", "is_"}], "}"}], ",", " ", 
    "poly_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ctr", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", "poly"}], "/", 
       RowBox[{"Length", "[", "poly", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Fold", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ClipSegmentSetToHalfPlane", "[", 
         RowBox[{"#1", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
             "ctr"}], "}"}]}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", "is"}], "}"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"poly", ",", 
          RowBox[{"RotateLeft", "[", "poly", "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.484767965367968*^9, 3.484767986499957*^9}, {
   3.484768049848742*^9, 3.484768214007534*^9}, {3.484768469736478*^9, 
   3.484768470040239*^9}, 3.676486366201748*^9},
 CellLabel->
  "In[563]:=",ExpressionUUID->"e865a035-0572-4fcf-827f-9d955987ede5"],

