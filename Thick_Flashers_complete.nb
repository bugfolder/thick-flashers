Cell[CellGroupData[{

Cell["Double-joined tubes", "Subsection",
 CellChangeTimes->{{3.671362084109956*^9, 3.6713620897323728`*^9}, {
  3.675366079587671*^9, 
  3.67536608008253*^9}},ExpressionUUID->"514c81b2-c128-4c0a-84a2-\
5640c487d173"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.675366160964972*^9, 
  3.675366161380965*^9}},ExpressionUUID->"bc16f98a-f5a5-4423-ba6c-\
d43c32d64479"],

Cell[TextData[{
 "If we add flanges to a tube, we can reduce its diameter, but adding flanges \
doubles the number of points. The functions in this section make connections \
between a tube with ",
 StyleBox["m",
  FontSlant->"Italic"],
 " points and another one with 2",
 StyleBox["m",
  FontSlant->"Italic"],
 " points. While this function was constructed to join tubes to pleat-reduced \
tubes, it can in fact be used to join any tube to one with twice as many \
points in its perimeter."
}], "Text",
 CellChangeTimes->{{3.675366171108644*^9, 3.675366219529394*^9}, {
  3.67537011778839*^9, 
  3.675370152442491*^9}},ExpressionUUID->"99ef3ce7-82e3-4407-8c11-\
69483b87e375"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DoubleJoinedTubeGraphics[",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[Graphics]"
}], "Subsubsection",
 CellChangeTimes->{{3.671243605296077*^9, 3.671243618843409*^9}, 
   3.671290947786048*^9, {3.671528358950732*^9, 3.671528366638109*^9}, {
   3.673101662338475*^9, 3.673101674616701*^9}, {3.6753556912242103`*^9, 
   3.675355694690493*^9}, {3.675366272960036*^9, 
   3.67536629555921*^9}},ExpressionUUID->"4d16a40f-666e-41c3-be03-\
e494169830ab"],

Cell[TextData[{
 "DoubleJoinedTubeGraphics[",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a Graphics rendering of a top view of what a twist tube joint \
would look like for the given sets of bottom and top points. Arguments are:\n\
\t",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that traces the bottom tube cross section \
in the ",
 StyleBox["x-y",
  FontSlant->"Italic"],
 " plane\n\t",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that traces the top tube cross section in \
the ",
 StyleBox["x-y",
  FontSlant->"Italic"],
 " plane, twice as many points.\nOptions are:\n\tOptions[Graphics] are passed \
through.\nIt returns a Graphics object showing the two cross sections and the \
fold lines. Bottom curve is outlined in Red; top curve is outlined in Green; \
and the twist pleats are translucent to show overlaps."
}], "Text",
 CellChangeTimes->{{3.671243660508953*^9, 3.671243748265405*^9}, {
   3.6712465791044188`*^9, 3.671246612120455*^9}, 3.671290947836775*^9, {
   3.673101662367955*^9, 3.6731016741151657`*^9}, 3.675329991503112*^9, {
   3.675330137533669*^9, 3.6753301582426033`*^9}, 3.675366272990488*^9, {
   3.675366332692428*^9, 
   3.675366345793346*^9}},ExpressionUUID->"c6b422ac-9143-435c-8203-\
ec2ca1bf6d7f"],

Cell["\<\
DoubleJoinedTubeGraphics provides a quick and simple visualization of the top \
view of a twist-joined pair of tubes. Useful for refining the settings of \
shape and offset and making sure that the twists don\[CloseCurlyQuote]t \
self-intersect in the center before going on to compute the whole thing.\
\>", "Text",
 CellChangeTimes->{{3.671377126630992*^9, 3.671377178433831*^9}, {
   3.671441520344907*^9, 3.6714415542027807`*^9}, 
   3.675366273024897*^9},ExpressionUUID->"9410e674-e031-44b9-b3eb-\
d5cac6011f66"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DoubleJoinedTubeGraphics", "::", "badlens"}], 
   "=", "\"\<List `1` should have half as many points as list `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.671180064037623*^9, 3.671180089794998*^9}, {
   3.671180392948053*^9, 3.6711803937339153`*^9}, 3.671243877037076*^9, 
   3.6712909478588142`*^9, 3.675366273041353*^9, {3.675366308881214*^9, 
   3.675366321329511*^9}},
 CellLabel->
  "In[3590]:=",ExpressionUUID->"c6e0980b-5442-4f56-ac82-e87208d5cf00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DoubleJoinedTubeGraphics", "[", 
   RowBox[{"botpts2d_", ",", "toppts2d_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "m", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"TwistDirection", "/.", 
       RowBox[{"{", "opts", "}"}]}], "/.", 
      RowBox[{"Options", "[", "DoubleJoinedTubeGraphics", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "botpts2d", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "toppts2d", "]"}], "\[NotEqual]", 
        RowBox[{"2", "m"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"DoubleJoinedTubeGraphics", "::", "badlens"}], ",", 
          "botpts2d", ",", "toppts2d"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "botpts2d", "]"}], "]"}], ",", 
           "Red"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Polygon", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                  "botpts2d", "\[LeftDoubleBracket]", "j", 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"botpts2d", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"2", "j"}], "+", "1"}], ",", 
                    RowBox[{"2", "m"}], ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}]}], "}"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Polygon", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                  "botpts2d", "\[LeftDoubleBracket]", "j", 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"2", "j"}], "+", "1"}], ",", 
                    RowBox[{"2", "m"}], ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"2", "j"}], ",", 
                    RowBox[{"2", "m"}], ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}]}], "}"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Polygon", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"botpts2d", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"2", "j"}], "+", "2"}], ",", 
                    RowBox[{"2", "m"}], ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"2", "j"}], "+", "1"}], ",", 
                    RowBox[{"2", "m"}], ",", "1"}], "]"}], 
                   "\[RightDoubleBracket]"}]}], "}"}], "]"}]}], 
              "\[IndentingNewLine]", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "m"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Opacity", "[", 
            RowBox[{"1", "/", "m"}], "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "toppts2d", "]"}], "]"}], ",", 
           "Green"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "botpts2d", "\[LeftDoubleBracket]", "j", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                 RowBox[{"2", "j"}], "\[RightDoubleBracket]"}]}], "}"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "m"}], "}"}]}], "]"}], ",", "Blue"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "botpts2d", "\[LeftDoubleBracket]", "j", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"2", "j"}], "+", "1"}], ",", 
                   RowBox[{"2", "m"}], ",", "1"}], "]"}], 
                 "\[RightDoubleBracket]"}]}], "}"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "m"}], "}"}]}], "]"}], ",", "Cyan"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"botpts2d", "\[LeftDoubleBracket]", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"2", "j"}], "+", "1"}], ",", 
                   RowBox[{"2", "m"}], ",", "1"}], "]"}], 
                 "\[RightDoubleBracket]"}]}], "}"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "m"}], "}"}]}], "]"}], ",", 
           RowBox[{"Darker", "[", "Cyan", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", 
            RowBox[{
            "botpts2d", "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}], "]"}], ",", 
           RowBox[{"Darker", "[", "Red", "]"}], ",", 
           RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", 
            RowBox[{
            "toppts2d", "\[LeftDoubleBracket]", "2", 
             "\[RightDoubleBracket]"}], "]"}], ",", 
           RowBox[{"Darker", "[", "Green", "]"}], ",", 
           RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.6712433977954807`*^9, 3.671243601361787*^9}, 
   3.6712437692341347`*^9, {3.671243810408342*^9, 3.671243865534865*^9}, {
   3.671246137795336*^9, 3.671246206670735*^9}, {3.671246250050832*^9, 
   3.671246330782731*^9}, {3.671246372697597*^9, 3.671246546902807*^9}, {
   3.671250418011199*^9, 3.671250421453275*^9}, {3.67129094789338*^9, 
   3.671290947916468*^9}, {3.673101661821487*^9, 3.673101674176823*^9}, {
   3.6753301904996443`*^9, 3.675330277255076*^9}, {3.675330649886818*^9, 
   3.675330677117008*^9}, {3.675330717269096*^9, 3.675330784406656*^9}, {
   3.67533125156371*^9, 3.675331263498001*^9}, {3.675331441965014*^9, 
   3.67533146335072*^9}, {3.675366273050617*^9, 3.675366273063863*^9}, {
   3.675366354902014*^9, 3.675366516822171*^9}, {3.675366572895395*^9, 
   3.675366671151731*^9}},
 CellLabel->
  "In[3591]:=",ExpressionUUID->"f4441e72-de54-4f86-8b6c-86be1e64efc0"],

Cell["Example: a cylinder connected to a pleat-reduced cylinder.", "Text",
 CellChangeTimes->{{3.671179378580347*^9, 3.671179379315285*^9}, {
  3.671179476269991*^9, 3.67117948130822*^9}, {3.67536668875841*^9, 
  3.675366698818937*^9}},ExpressionUUID->"501f9552-c850-4154-be26-\
8d845f9d12f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", "\[Phi]", ",", "botpts2d", ",", "toppts2d"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "12"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"rotational", " ", "order"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"135.", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "amount", " ", "of", " ", "twist", " ", "from", " ", "bottom", " ", 
       "to", " ", "top"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{
       RowBox[{"DiscreteCircle", "[", 
        RowBox[{"m", ",", "1"}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"toppts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"10.", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
       RowBox[{"PleatReducePolygon", "[", 
        RowBox[{"botpts2d", ",", "0.5"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DoubleJoinedTubeGraphics", "[", 
      RowBox[{"botpts2d", ",", "toppts2d"}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6711793832328787`*^9, 3.671179568554941*^9}, {
   3.671179608644779*^9, 3.671179632783592*^9}, {3.671180537675157*^9, 
