Cell["\<\
Example. Paraboloid, different principal curvatures, line at angle \[Alpha] \
to principal curvatures. Show values at a point along the curve and plot both \
Frenet and Darboux frames at that point.\
\>", "Text",
 CellChangeTimes->{{3.6879869581570263`*^9, 3.687986987546091*^9}, {
  3.687987096884499*^9, 3.687987110562695*^9}, {3.6879941091374073`*^9, 
  3.6879941092799478`*^9}, {3.687998314224334*^9, 3.687998320798333*^9}, {
  3.688000256670855*^9, 3.688000261980619*^9}, {3.688135466401993*^9, 
  3.688135474153824*^9}},ExpressionUUID->"d3d2ed9e-ad28-43cf-809d-\
ac404f24ca76"],

Cell["\<\
Also compare the time derivatives of the Darboux frame vectors to their \
values on the RHS of the differential equation, as a consistency check on our \
coefficients \[Kappa]n, \[Kappa]g, \[Tau]g.\
\>", "Text",
 CellChangeTimes->{{3.797263866488914*^9, 
  3.797263923505185*^9}},ExpressionUUID->"37330960-d82e-4b2e-b391-\
f626a83f1ee6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sfn", ",", "as", ",", "ss", ",", "u", ",", "v", ",", "t", ",", "ssu", ",",
       "ssv", ",", "soln", ",", "uuu", ",", "\[Alpha]", ",", "qq", ",", "cc", 
      ",", "uu", ",", "csys", ",", "dsys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", "\[Element]", "Reals"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"#", ",", "as"}], "]"}], "&"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{
          SuperscriptBox["#1", "2"], "+", 
          RowBox[{"3", 
           SuperscriptBox["#2", "2"]}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss[u,v] = \>\"", ",", 
       RowBox[{"ss", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "two", " ", "principle", " ", "lines", " ", "of", " ", "curvature"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ssu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"u", ",", 
        RowBox[{
         RowBox[{"ss", "[", 
          RowBox[{"u", ",", "0"}], "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ssv", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"v", ",", 
        RowBox[{
         RowBox[{"ss", "[", 
          RowBox[{"0", ",", "v"}], "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"surface", " ", "normal"}], ",", " ", 
       RowBox[{"parameterized", " ", "on", " ", "two", " ", "variables"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuu", "=", 
      RowBox[{"SurfaceNormalFromSurface", "[", 
       RowBox[{"ss", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uuu[u,v] = \>\"", ",", 
       RowBox[{"uuu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "line", " ", "of", " ", "curve", " ", "in", " ", "parameterized", " ", 
        "space"}], ",", " ", 
       RowBox[{"rotated", " ", "at", " ", "angle", " ", "\[Alpha]"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"qq", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", " ", 
          RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], ",", 
         RowBox[{"#", " ", 
          RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<qq[t] = \>\"", ",", 
       RowBox[{"qq", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "curve", " ", "function", " ", "on", " ", "one", " ", "variable"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"ss", "@@", 
         RowBox[{"qq", "[", "t", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<cc[t] = \>\"", ",", 
       RowBox[{"cc", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "surface", " ", "normal", " ", "on", " ", "one", " ", "variable"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"uuu", "@@", 
         RowBox[{"qq", "[", "t", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<uu[t] = \>\"", ",", 
       RowBox[{"uu", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"compute", " ", "the", " ", "system"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"cc", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Curve3DSystem\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"csys", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsys", "=", 
      RowBox[{"Darboux3DSystem", "[", 
       RowBox[{"cc", ",", "uu", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Darboux3DSystem\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"dsys", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r", ",", "dr", ",", "t0", ",", "fda", ",", "kn", ",", "kg", ",", 
         "tg", ",", "kp", ",", "ta", ",", "ds", ",", "tt", ",", "nn", ",", 
         "bb", ",", "ll"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"r", "=", "0.3"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"lateral", " ", "size", " ", "of", " ", "plot"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"dr", "=", "0.1"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"vector", " ", "lengths"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"t0", "=", "0.15"}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"point", " ", "to", " ", "plot"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"30", "\[Degree]"}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{"rotation", " ", "angle"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<*** NUMERICAL ***\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"dsys", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//",
          "Print"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "ds", ",", "tt", ",", "nn", ",", "bb", ",", "ll", ",", "uu", ",", 
           "kn", ",", "kg", ",", "tg", ",", "kp", ",", "ta"}], "}"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
             "BinormalVector3D", ",", "TangentNormalVector3D", ",", 
             "SurfaceNormalVector3D", ",", "NormalCurvature3D", ",", 
             "GeodesicCurvature3D", ",", "GeodesicTorsion3D", ",", 
             "Curvature3D", ",", "Torsion3D"}], "}"}], "/.", "csys"}], "/.", 
          "dsys"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Alpha] = \>\"", ",", 
          RowBox[{"\[Alpha]", "/", "\[Degree]"}], ",", "\"\<\[Degree]\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Kappa]\), \(n\)]\)[t0] = \>\"", ",", 
          RowBox[{"kn", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Kappa]\), \(g\)]\)[t0] = \>\"", ",", 
          RowBox[{"kg", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Tau]\), \(g\)]\)[t0] = \>\"", ",", 
          RowBox[{"tg", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Kappa][t0] = \>\"", ",", 
          RowBox[{"kp", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Tau][t0] = \>\"", ",", 
          RowBox[{"ta", "[", "t0", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Check", " ", "consistency", " ", "with", " ", "the", " ", "Darboux",
