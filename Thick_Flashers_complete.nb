}], "Subsubsection",
 CellChangeTimes->{{3.461389912865285*^9, 3.4613899140969276`*^9}, {
   3.617456136478376*^9, 3.617456139544603*^9}, 3.627385975537049*^9, {
   3.631294481966223*^9, 
   3.631294482981263*^9}},ExpressionUUID->"3ad5f5fa-c639-49ca-94c0-\
981ebb306d76"],

Cell[TextData[{
 "ArchimedeanVertexType[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns the vertex type of the ",
 StyleBox["n",
  FontSlant->"Italic"],
 "th Archimedean tiling. We'll use lexical ordering. We list ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["3", "4"], "6"}], TraditionalForm]],ExpressionUUID->
  "6701c937-e9c9-4fd5-a197-aaa43a1bfcee"],
 " twice since there are two enantiomorphic tilings possible with this vertex \
figure."
}], "Text",
 CellChangeTimes->{
  3.627385975539676*^9, {3.629979164255473*^9, 
   3.629979169895073*^9}},ExpressionUUID->"4f55561b-b277-41ac-893f-\
0ab199adc337"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArchimedeanVertexType", "::", "badnum"}], 
   "=", "\"\<ArchimedeanVertexType[`1`] is not defined.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.631294331122127*^9, 3.631294343439523*^9}},
 CellLabel->
  "In[3098]:=",ExpressionUUID->"441c9285-790a-44d7-814b-674bfcfa8ba8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ArchimedeanVertexType", "[", "n_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Message", "[", 
     RowBox[{
      RowBox[{"ArchimedeanVertexType", "::", "badnum"}], ",", "n"}], "]"}], ";", 
    RowBox[{"Abort", "[", "]"}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.63129431057093*^9, 3.631294351910715*^9}},
 CellLabel->
  "In[3099]:=",ExpressionUUID->"0c3c4059-872b-42f8-b981-f37f133c3e55"],

Cell[TextData[{
 "ArchimedeanName[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns a string giving the name of the nth Archimedean tiling."
}], "Text",
 CellChangeTimes->{{3.6174560030783367`*^9, 3.6174560197972383`*^9}, 
   3.627385975543056*^9},ExpressionUUID->"75e4f2e8-478a-4e60-a8bf-\
62e3d4dc4c7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ArchimedeanName", "[", "n_", "]"}], ":=", 
  RowBox[{"StringJoin", "[", 
   RowBox[{"\"\<(\>\"", ",", 
    RowBox[{"Riffle", "[", 
     RowBox[{
      RowBox[{"ToString", "/@", 
       RowBox[{"ArchimedeanVertexType", "[", "n", "]"}]}], ",", "\"\<.\>\""}],
      "]"}], ",", "\"\<)\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.617456025427767*^9, 3.617456075335513*^9}, {
   3.617456163980171*^9, 3.617456173192563*^9}, {3.617456224983698*^9, 
   3.617456250496725*^9}, 3.627385975543431*^9, {3.631310058732362*^9, 
   3.63131006521148*^9}},
 CellLabel->
  "In[3100]:=",ExpressionUUID->"6e1b8580-ffd3-4004-9c26-0231b0925ee9"],

Cell["n=1: ", "Text",
 CellChangeTimes->{{3.631294102639021*^9, 
  3.631294104065016*^9}},ExpressionUUID->"2ba97732-783b-42bc-81b7-\
e07c1cdcc442"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArchimedeanVertexType", "[", "1", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "3", ",", "3", ",", "3", ",", "3"}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[3101]:=",ExpressionUUID->"7c3fbd27-fa2c-4aa7-a3cc-cd508e78623b"],

Cell[TextData[{
 "ArchimedeanPatch[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns a patch of the nth Archimedean tiling that can be tessellated to \
cover the plane."
}], "Text",
 CellChangeTimes->{{3.91353939251262*^9, 3.91353941013229*^9}, {
  3.91353950899947*^9, 3.913539527360038*^9}, {3.91353956021106*^9, 
  3.913539568466783*^9}},ExpressionUUID->"02788f8a-f7a7-4b99-a3ec-\
f43a598ee1a1"],

Cell["\<\
In Mathematica 13+, the JoinTiling calls for some of the functions throw the \
N::mprec message for reaching internal precision limit (due to Simplify[] \
calls, it appears). This doesn\[CloseCurlyQuote]t cause problems in the \
output, so we have added Quiet[] calls to the individual patch definitions.\
\>", "Text",
 CellChangeTimes->{{3.913539737850205*^9, 3.913539808435902*^9}, {
  3.913540074945256*^9, 
  3.9135400947042413`*^9}},ExpressionUUID->"ecd3e37d-2ca7-4353-953d-\
16c78c990885"],

Cell[TextData[{
 "ArchimedeanPatchLatticeVectors[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns the lattice vectors that can be used to translate the patches to \
cover the plane."
}], "Text",
 CellChangeTimes->{{3.9135398661264286`*^9, 
  3.913539900373148*^9}},ExpressionUUID->"5360252b-0eb8-41e0-97eb-\
28a6045d8913"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArchimedeanPatch", "[", "1", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"JoinTiling", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"UnitRegularPolygonTile", ",", "3"}], "}"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"UnitRegularPolygonTile", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "1"}], "}"}]}], "}"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}], "//", "Quiet"}], "//", 
    "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.631140443193075*^9, 3.631140505602401*^9}, {
   3.6311405978940477`*^9, 3.631140611955948*^9}, 3.631144171125721*^9, {
   3.913539812824234*^9, 3.913539814757842*^9}},
 CellLabel->
  "In[3102]:=",ExpressionUUID->"3520ef09-d6db-4aec-9e5e-8a313a681da5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArchimedeanPatchLatticeVectors", "[", "1", "]"}], "=", 
   RowBox[{
    RowBox[{"PatchVectors", "[", 
     RowBox[{
      RowBox[{"ArchimedeanPatch", "[", "1", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.631140615675502*^9, 3.631140655840568*^9}, 
   3.631144175332035*^9},
 CellLabel->
  "In[3103]:=",ExpressionUUID->"e07e2c66-bad6-4e5f-a553-bdf5d7764992"],

Cell["Example. Show the name, patch, and a 2x2 lattice.", "Text",
