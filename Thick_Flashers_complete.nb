 RowBox[{
  RowBox[{
   RowBox[{"TriangulationEdges", "::", "usage"}], 
   "=", "\"\<TriangulationEdges is a property of TTriangulated that specifies \
the edges in a TGraph that came from a triangulation.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.706916091361428*^9, 3.706916116958282*^9}},
