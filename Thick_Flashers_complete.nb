           "TilingDarkFill"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
           "TilingLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{"\"\<A\>\"", ",", 
             RowBox[{"{", 
              RowBox[{".5", ",", ".5"}], "}"}]}], "]"}], ",", "TilingText"}], 
          "]"}]}], "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"test", "/.", 
        RowBox[{"TilingStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
     "]"}], "//", "ShowExample"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.442605977107079*^9, 3.442606033816569*^9}, {
