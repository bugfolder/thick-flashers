      RowBox[{
       RowBox[{"DirectedEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Graph3DGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"de3d", "=", 
      RowBox[{
       RowBox[{"DirectedEdges3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Graph3DGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vc", "=", 
      RowBox[{
       RowBox[{"VertexColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Graph3DGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ec", "=", 
      RowBox[{
       RowBox[{"EdgeColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Graph3DGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
