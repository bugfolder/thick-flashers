Cell[CellGroupData[{

Cell["Consistency check: unfold and refold a nonuniform helix", \
"Subsubsection",
 CellChangeTimes->{{3.799837057384103*^9, 3.799837082734499*^9}, {
  3.799837330430218*^9, 3.799837337079492*^9}, {3.799865582453178*^9, 
  3.7998655841957903`*^9}},ExpressionUUID->"8052d145-9be4-426b-900c-\
21b10e7bd77f"],

Cell["\<\
Verify NFoldCurvedFold3D by starting with a known folded-form and unfolded \
pair for a nonuniform helix and then folding the CP into a folded form to \
verify that we get back what we started with.\
\>", "Text",
 CellChangeTimes->{{3.799837257985036*^9, 3.799837323866763*^9}, 
   3.801658253910871*^9},ExpressionUUID->"18f23d56-ede8-4ae7-8ea1-\
b2e3c5d4ee92"],

Cell["\<\
Note that although we get the apparent same shape, there are some ripples in \
the torsion curve. My thinking is that this is because torsion is the 3rd \
derivative of the original curve function, and that\[CloseCurlyQuote]s where \
FunctionInterpolation starts to fall off in accuracy.\
\>", "Text",
 CellChangeTimes->{{3.799865590355861*^9, 
  3.799865668468598*^9}},ExpressionUUID->"d998c528-80b3-468b-8ba9-\
cfdb6ee29421"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "u0", ",", "u1", ",", "r", ",", "\[Theta]", ",", "\[Gamma]", ",", "ip", ",",
       "f", ",", "rL", ",", "rR", ",", "ff", ",", "rrL", ",", "rrR", ",", 
      "csys", ",", "ui", ",", "\[Gamma]i", ",", "ffi", ",", "tti", ",", 
      "bbti", ",", "ff1", ",", "rrL1", ",", "rrR1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"120", "\[Degree]"}], "-", 
        RowBox[{"60", "\[Degree]", 
         RowBox[{"(", 
          RowBox[{"#", "/", "\[Pi]"}], ")"}]}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "128"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}], "=", 
      RowBox[{"NCurvedFoldHelix3D", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Gamma]", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<original 3D\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"CurvedFoldShapePlots3D", "[", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Unfolded", " ", "2", "D"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "rL", ",", "rR", ",", "\[Gamma]"}], "}"}], "=", 
      RowBox[{"NCurvedFoldHelix2D", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Gamma]", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<Unfolded 2D\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"CurvedFoldShapePlots2D", "[", 
        RowBox[{"f", ",", "rL", ",", "rR", ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Refolded", " ", "3", "D"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"NCurve3DSystem", "[", 
       RowBox[{"ff", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ui", "=", 
      RowBox[{
       RowBox[{".5", "u0"}], "+", 
       RowBox[{".5", "u1"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Gamma]i", ",", "ffi", ",", "tti", ",", "bbti"}], "}"}], "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Gamma]", "[", "ui", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ff", "[", "ui", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"TangentVector3D", "/.", "csys"}], ")"}], "[", "ui", "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"BinormalVector3D", "/.", "csys"}], ")"}], "[", "ui", 
         "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff1", ",", "rrL1", ",", "rrR1"}], "}"}], "=", 
      RowBox[{"NFoldCurvedFold3D", "[", 
       RowBox[{"f", ",", "rL", ",", "rR", ",", 
        RowBox[{"{", 
         RowBox[{
         "ui", ",", "\[Gamma]i", ",", "ffi", ",", "tti", ",", "bbti"}], "}"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<refolded 3D\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"CurvedFoldShapePlots3D", "[", 
        RowBox[{"ff1", ",", "rrL1", ",", "rrR1", ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Show", " ", "all", " ", "three", " ", "versions"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CurvedFoldGraphics3D", "[", 
          RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CurvedFoldGraphics", "[", 
          RowBox[{"f", ",", "rL", ",", "rR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CurvedFoldGraphics3D", "[", 
          RowBox[{"ff1", ",", "rrL1", ",", "rrR1", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799747940244758*^9, 3.799748059208112*^9}, {
   3.799749023452067*^9, 3.799749031042073*^9}, {3.799749084207122*^9, 
   3.799749085906748*^9}, 3.799749205958315*^9, {3.7997509291095667`*^9, 
   3.799750930885685*^9}, {3.799752434382588*^9, 3.799752490488463*^9}, {
