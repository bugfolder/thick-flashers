Cell[CellGroupData[{

Cell["Centered twists on Archimedean tilings", "Subsubsection",
 CellChangeTimes->{{3.627657904646267*^9, 3.627657908038017*^9}, {
  3.627672696615513*^9, 3.6276727010703173`*^9}, {3.629923523547295*^9, 
  3.629923524524664*^9}},ExpressionUUID->"05cf03da-b9b7-41c3-b490-\
3160c062351f"],

Cell["\<\
A square lattice of identical tiles, based on the n=2 Archimedean tiling.\
\>", "Text",
 CellChangeTimes->{{3.6276579370140247`*^9, 3.627657948382809*^9}, {
  3.627660796838403*^9, 
  3.627660804822852*^9}},ExpressionUUID->"02dd3a2a-370f-48ad-a676-\
406242fd2203"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "w", ",", "\[Alpha]", ",", "tpatch", ",", "types", ",", 
      "patch", ",", "lattice", ",", "tiling", ",", "cliprect", ",", "ptiling",
       ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"30.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tpatch", "=", 
      RowBox[{"ArchimedeanPatch", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"V", ",", "V", ",", "M", ",", "M"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"patch", "=", 
      RowBox[{"UnitRegularPolygonCenteredTwistAltPatch", "[", 
       RowBox[{"tpatch", ",", "w", ",", "\[Alpha]", ",", "types"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"lattice", "=", 
      RowBox[{"ArchimedeanPatchLatticeVectors", "[", 
       StyleBox["n",
        FontSlant->"Italic"], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"MakeLatticeTiling", "[", 
       RowBox[{"patch", ",", "lattice", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cliprect", "=", 
      RowBox[{"SquareVertices", "[", "2.9", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ptiling", "=", 
      RowBox[{"PruneTiling", "[", 
       RowBox[{"tiling", ",", "cliprect"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "show", " ", "tiling", " ", "before", " ", "and", " ", "after", " ", 
       "pruning"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"tiling", ",", "Tiling"}], "]"}], ",", 
             RowBox[{"PrunePoly", "[", "cliprect", "]"}]}], "}"}], "]"}], ",", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EmbedTiling", "[", 
              RowBox[{"ptiling", ",", "Tiling"}], "]"}], ",", 
             RowBox[{"PrunePoly", "[", "cliprect", "]"}]}], "}"}], "]"}]}], 
         "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "crease", " ", "pattern", " ", "and", " ", "folded", " ", "form", " ", 
       "tilings"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"ptiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"EmbedTiling", "[", 
            RowBox[{"ptiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], "}"}], 
        "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"monolithic", " ", "versions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"ptiling", ",", "MonolithicTGraph2D", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "32"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"GraphGraphics", "[", "tobj", "]"}], "]"}], "//", "Hold"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
