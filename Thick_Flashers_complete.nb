Cell[CellGroupData[{

Cell["Polygon centered twist tiles", "Subsection",
 CellChangeTimes->{{3.629825605874136*^9, 3.629825619537196*^9}, 
   3.630111545264229*^9},ExpressionUUID->"6cbee48a-5dde-44ad-a847-\
4f1ee6f097a4"],

Cell[CellGroupData[{

Cell[TextData[{
 "{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.629825581181041*^9, 3.62982559509096*^9}, {
  3.629825719482769*^9, 3.629825801430343*^9}, {3.629825855794893*^9, 
  3.629825863308705*^9}},ExpressionUUID->"704d68f3-b976-46be-b63b-\
a3d3d43b6472"],

Cell[TextData[{
 "{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} is a tiletype that describes a simple flat twist in a specified polygon \
where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \[Tau] \
is the pleat angle, defined as the rotation angle of the pleat measured with \
respect to the edge, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
   3.457740055563382*^9}, {3.457899240889505*^9, 3.457899262921368*^9}, {
   3.533668819444027*^9, 3.533668840458009*^9}, {3.533683624395843*^9, 
   3.533683629667203*^9}, {3.533683676248049*^9, 3.533683676297819*^9}, {
   3.533683730482073*^9, 3.533683812423534*^9}, {3.592170850586206*^9, 
   3.5921708645033407`*^9}, {3.592171015904443*^9, 3.592171017781418*^9}, {
   3.592214871731565*^9, 3.592214878400432*^9}, {3.59221494757358*^9, 
