Cell[TextData[{
 "IntervalSetMinus[",
 StyleBox["is1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is2",
  FontSlant->"Italic"],
 "] returns the interval set ",
 StyleBox["is1",
  FontSlant->"Italic"],
 " with all of the intervals of ",
 StyleBox["is2",
  FontSlant->"Italic"],
 " removed."
}], "Text",
 CellChangeTimes->{{3.484755810287229*^9, 
  3.484755846124923*^9}},ExpressionUUID->"17ca3f88-8445-4509-ab17-\
e81e9eb4719b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IntervalSetMinus", "[", 
   RowBox[{"is1_", ",", "is2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ret", "=", "is1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ret", "=", 
          RowBox[{"IntervalSetMinus", "[", 
           RowBox[{"ret", ",", "#"}], "]"}]}], ")"}], "&"}], "/@", "is2"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"IntervalSetCleanup", "[", "ret", "]"}]}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"Dimensions", "[", "is2", "]"}], "]"}], "\[Equal]", 
    "2"}]}]}]], "Input",
 CellChangeTimes->{{3.484755881031637*^9, 3.484755977480851*^9}, {
