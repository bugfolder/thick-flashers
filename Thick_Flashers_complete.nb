 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "m", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "9"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Point", "[", 
             RowBox[{"GoldbergPoint", "[", 
              RowBox[{"m", ",", "in", ",", "0", ",", "0"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"in", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", "Red", ",", 
          RowBox[{"AbsolutePointSize", "[", "12", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Point", "[", 
             RowBox[{"GoldbergPoint", "[", 
              RowBox[{"m", ",", "1", ",", "ik", ",", "0"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"ik", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", "Green",
           ",", 
          RowBox[{"AbsolutePointSize", "[", "8", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Point", "[", 
             RowBox[{"GoldbergPoint", "[", 
              RowBox[{"m", ",", "1", ",", "0", ",", "il"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"il", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", "Blue", 
          ",", 
          RowBox[{"AbsolutePointSize", "[", "4", "]"}]}], "]"}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.485216237744906*^9, 3.485216430751545*^9}, {
   3.485216562629457*^9, 3.485216585399144*^9}, {3.485217299910544*^9, 
