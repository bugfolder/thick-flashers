       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts2", ",", "edges2", ",", "faces2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mgdata", "=", 
      RowBox[{"MergeGraphsData", "[", 
       RowBox[{"{", 
        RowBox[{"tobj1", ",", "tobj2"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<vlist = \>\"", ",", 
       RowBox[{
       "mgdata", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<elist = \>\"", ",", 
       RowBox[{
       "mgdata", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tglist", "=", 
      RowBox[{"{", 
       RowBox[{"tobj1", ",", "tobj2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tglist", "//", 
       RowBox[{"ApplyMerge", "[", "mgdata", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pr", "=", 
