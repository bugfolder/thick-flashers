   3.594233519060855*^9, 3.594233741409395*^9}, {3.594233795439254*^9, 
   3.594233808309639*^9}, {3.625686692174559*^9, 3.625686692488227*^9}, {
   3.625686808983993*^9, 3.625686812258486*^9}, 3.62568970731884*^9},
