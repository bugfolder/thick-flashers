Cell[CellGroupData[{

Cell[TextData[{
 "ExtractStyleArgs[",
 StyleBox["obj, opts",
  FontSlant->"Italic"],
 "]\n\t(options) ShowSample, MagnifySample, StyleObjectSample\n\
ReplaceStyleArgs[",
 StyleBox["obj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["oldstyleargs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["newstyleargs",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.456529639423876*^9, 3.456529643615497*^9}, {
   3.456529705253038*^9, 3.456529713594883*^9}, {3.456530397701955*^9, 
   3.4565303992618833`*^9}, {3.484863767224353*^9, 3.484863781910881*^9}, 
   3.5517251179319057`*^9, {3.592645493126902*^9, 3.592645519583784*^9}, 
   3.628786591945692*^9, 
   3.708018873817561*^9},ExpressionUUID->"dfcec635-f56e-4e54-865d-\
81dee8b682e6"],

Cell[TextData[{
 "ExtractStyleArgs[",
 StyleBox["obj, opts",
  FontSlant->"Italic"],
 "] constructs a list of all the Style arguments in the given object. Useful \
for changing the styles of an imported pattern to something else. Options \
are:\n\tShowSample \[Rule] True | False, prints an example of each style, \
followed by its listing.\n\tMagnifySample \[Rule] True | False, magnifies the \
thickness and dashing of the sample lines by a factor of 10. This is useful \
to distinguish lines that have similar thickness and/or dashing.\n\t\
StyleObjectSample \[Rule] ",
 StyleBox["sm",
  FontSlant->"Italic"],
 " supplies your own sample Graphics elements. Default is a slightly tilted \
line of unit length."
}], "Text",
 CellChangeTimes->{{3.4565296451756372`*^9, 3.456529680605055*^9}, {
   3.4565297192191253`*^9, 3.456529758688175*^9}, 3.456530404992431*^9, {
   3.55095222643798*^9, 3.550952248308195*^9}, {3.589465830644767*^9, 
   3.589465868337573*^9}, {3.592041939671143*^9, 3.592041984522936*^9}, {
   3.592645529549458*^9, 3.592645578000988*^9}, 3.628786592041028*^9, 
   3.708018873840372*^9},ExpressionUUID->"fe98119f-7022-4abf-a496-\
83c2541120ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowSample", "::", "usage"}], 
   "=", "\"\<ShowSample is an option to ExtractStyleArgs that displays an \
example of each style found.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592041809055933*^9, 3.592041833423257*^9}, 
   3.628786592063889*^9},
