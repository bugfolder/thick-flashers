   3.707838247050849*^9}},ExpressionUUID->"09123651-622a-413a-b10a-\
1e9835f61321"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "PolygonTwistTile", ",", "verts_List", ",", " ", "w_", ",", "d_", ",", 
      " ", "\[Tau]_", ",", "ccw_", ",", "types_List"}], "}"}], ",", 
    "TGraph2DAssigned", ",", "opts___"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobjcp", ",", "tobjff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobjcp", "=", 
      RowBox[{"RenderTile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "PolygonTwistTile", ",", "verts", ",", "w", ",", "d", ",", "\[Tau]", 
          ",", "ccw", ",", "types"}], "}"}], ",", "TGraphAssigned", ",", 
        "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjff", "=", 
      RowBox[{"RenderTile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"PolygonTwistTile", ",", "verts", ",", 
          FractionBox[
           RowBox[{"-", "w"}], 
           RowBox[{"1", "-", 
            RowBox[{"2", "w"}]}]], ",", "\[InvisibleSpace]", 
          FractionBox["d", 
           RowBox[{"1", "-", 
            RowBox[{"2", " ", "w"}]}]], ",", 
          RowBox[{"ArcCot", "[", 
           FractionBox[
            RowBox[{"Cot", "[", "\[Tau]", "]"}], 
            RowBox[{"1", "-", 
             RowBox[{"2", "w"}]}]], "]"}], ",", "ccw", ",", "types"}], "}"}], 
        ",", "TGraphAssigned", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjcp", "//", 
      RowBox[{"AddTGraph2D", "[", 
       RowBox[{"tobjff", "[", "Vertices", "]"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.457741122770767*^9, 3.457741186698559*^9}, {
