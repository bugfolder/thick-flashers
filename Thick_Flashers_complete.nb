Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Phi]", ",", "\[Epsilon]", ",", "u0", ",", "u1", ",", "b1", ",", "d1", 
      ",", "bb1", ",", "dd1", ",", "p2i", ",", "d2i", ",", "pp2i", ",", 
      "dd2i", ",", "b2", ",", "bb2", ",", "f", ",", "ff", ",", "s"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]", "=", ".25"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"s", " ", 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "]"}], ",", 
          RowBox[{"Sin", "[", 
           RowBox[{"s", " ", 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "]"}]}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"bb1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
           RowBox[{"Cos", "[", "s", " ", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Phi]", "]"}], 
           RowBox[{"Sin", "[", "s", " ", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p2i", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "+", "\[Epsilon]"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d2i", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pp2i", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "0"}], "}"}], "+", 
       RowBox[{"\[Epsilon]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "0"}], "}"}]}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dd2i", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "b2", ",", "d2i", ",", "bb2", ",", "dd2i", ",", "f", ",", "ff"}], 
       "}"}], "=", 
      RowBox[{"NFoldSurfaceToCylinder", "[", 
       RowBox[{"b1", ",", "d1", ",", "bb1", ",", "dd1", ",", 
        RowBox[{"{", 
         RowBox[{"p2i", ",", "d2i", ",", "pp2i", ",", "dd2i"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"b1", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"f", "[", "s", "]"}], "-", 
                 RowBox[{"b1", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"f", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"b2", "[", "s", "]"}], "-", 
                 RowBox[{"f", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"f", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "p2i", "]"}], ",", "Red"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Styled2DAxes", "[", 
             RowBox[{".75", ",", ".75"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Styled3DAxes", "[", 
             RowBox[{"1", ",", "1", ",", ".5"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"bb1", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"ff", "[", "s", "]"}], "-", 
                 RowBox[{"bb1", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"SurfaceOrientation", "\[Rule]", 
               RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"ff", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"bb2", "[", "s", "]"}], "-", 
                 RowBox[{"ff", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"SurfaceOrientation", "\[Rule]", 
               RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"ff", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "pp2i", "]"}], ",", "Red"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
        "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.801504291622754*^9, 3.801504430851095*^9}, {
   3.801504470523498*^9, 3.801504617020269*^9}, {3.80150469555924*^9, 
   3.80150481262203*^9}, {3.801504852928177*^9, 3.8015049019186487`*^9}, {
