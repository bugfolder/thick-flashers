 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "UnitBrocardParallelogramInfo", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"TwistDirection", "\[Rule]", "CCW"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.629131513492236*^9, 3.62913153360058*^9}, 
