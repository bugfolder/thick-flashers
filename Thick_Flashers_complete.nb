Cell["Example. A trefoil.", "Text",
 CellChangeTimes->{{3.7994475601940117`*^9, 3.799447563226973*^9}, {
  3.799448276175275*^9, 
  3.7994482772209997`*^9}},ExpressionUUID->"ce12d859-3b7e-42e9-ae46-\
6445d6eb7cea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Gamma]0", ",", "ff", ",", "\[Gamma]", ",", "cfsys", ",", "rrL", ",", 
      "rrR", ",", "u0", ",", "u1", ",", "rld", ",", "cd"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{"KnotData", "[", 
       RowBox[{"\"\<Trefoil\>\"", ",", "\"\<SpaceCurve\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<f[t] = \>\"", ",", 
       RowBox[{"ff", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"\[Gamma]0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]0", "=", 
      RowBox[{"135.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "3"}], ",", 
        RowBox[{
         RowBox[{"2", "\[Pi]"}], "+", 
         RowBox[{"\[Pi]", "/", "3"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
      RowBox[{"NSpaceCurveFold3D", "[", 
       RowBox[{"ff", ",", "\[Gamma]", ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "256"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rld", ",", "cd"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"75", ",", "500"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"CurvedFoldShapePlots3D", "[", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"CurvedFoldGraphics3D", "[", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"Lighting", "\[Rule]", 
          RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "//", "Print"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799445903013015*^9, 3.79944591923392*^9}, {
   3.799445969099428*^9, 3.799446229937944*^9}, {3.7994463027540283`*^9, 
