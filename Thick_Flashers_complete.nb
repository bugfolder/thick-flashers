Cell[CellGroupData[{

Cell["TGraph examples", "Subsection",
 CellChangeTimes->{{3.706824397256462*^9, 
  3.70682439976061*^9}},ExpressionUUID->"835efb99-d0ab-4e21-9d05-\
cb1d2b55d872"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.706824402466171*^9, 
  3.706824402928983*^9}},ExpressionUUID->"434a3609-0f88-4508-bfb3-\
1a982298407b"],

Cell["\<\
To illustrate the behavior of various functions, we use a number of simple \
examples over and over. Rather than reconstructing them from scratch each \
time we need one, we\[CloseCurlyQuote]ll predefine some examples here, and \
will continue adding examples throughout.\
\>", "Text",
 CellChangeTimes->{{3.706824405537*^9, 3.70682447646579*^9}, {
  3.706830293623721*^9, 
  3.7068303047009377`*^9}},ExpressionUUID->"4f434426-ce99-455f-a6c3-\
1d0a130c3583"],

Cell["\<\
The general naming scheme will be of the form <description><TGraph type>. For \
example, everything here is a SomethingGraph (although for the two exceptions \
that hae no Faces data, that tidbit is appended to the name). Later on, we \
will have SomethingGraph2D, SomethingGraph3D, SomethingGraph3DAssigned, etc., \
so that the name tells you something about what type of TGraph it is.\
\>", "Text",
 CellChangeTimes->{{3.706830307436097*^9, 
  3.706830445942211*^9}},ExpressionUUID->"584aa84f-220c-4f4c-acf5-\
57788e416ed8"],

Cell["\<\
The global variable $TGraphExamples (see next) contains a list of the names \
of all predefined named examples.\
\>", "Text",
 CellChangeTimes->{{3.719615678711001*^9, 
  3.7196157026157713`*^9}},ExpressionUUID->"f6af36a8-948b-401e-8a2a-\
b728a146c1df"],

Cell["\<\
The function ShowTGraphExample (defined at the very end of this package) \
creates a rendering of any named example, with what, precisely, is rendered \
depending on the class(es) of the TGraph: whether it\[CloseCurlyQuote]s flat, \
2D, or 3D, and/or whether it has a crease assignment.\
\>", "Text",
 CellChangeTimes->{{3.719615705230513*^9, 
  3.71961578436838*^9}},ExpressionUUID->"5190b13b-2e47-4172-8a09-\
5df846727bba"]
}, Closed]],

Cell[CellGroupData[{

Cell["$TGraphExamples", "Subsubsection",
 CellChangeTimes->{{3.706824503418661*^9, 
  3.706824507073339*^9}},ExpressionUUID->"c2b70307-d831-444d-aaeb-\
4285359729e9"],

Cell["\<\
$TGraphExamples is a global list of all examples by name. This list will be \
incrementally built up over the course of this package.\
\>", "Text",
 CellChangeTimes->{{3.70682451837774*^9, 3.706824531722021*^9}, {
  3.719615651414859*^9, 
  3.719615662967518*^9}},ExpressionUUID->"9881a82a-135a-48fe-8a31-\
001dd1ef7405"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$TGraphExamples", "=", 
   RowBox[{"{", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.706824508796698*^9, 3.706824513249888*^9}},
 CellLabel->
  "In[1048]:=",ExpressionUUID->"15ab883b-d472-433a-ae41-303e07a26393"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "AddTGraphExample[",
 StyleBox["name",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.706824555810114*^9, 
  3.7068246030186777`*^9}},ExpressionUUID->"c905bb60-3fea-4200-864f-\
22b8473ec19f"],

Cell[TextData[{
 "AddTGraphExample[",
 StyleBox["name",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] records the name as a string in our global list and then assigns the \
given object to that name. If it is already present, it gets moved to the end \
of the current list."
}], "Text",
 CellChangeTimes->{{3.7068246058667297`*^9, 3.706824652770957*^9}, {
  3.718288921275199*^9, 
  3.7182889495698547`*^9}},ExpressionUUID->"7137b2b1-9028-426b-aa1d-\
568a3728f876"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddTGraphExample", "::", "badobj"}], 
   "=", "\"\<`1` is not a TObj.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.718288342765191*^9, 3.718288358436408*^9}},
 CellLabel->
  "In[1049]:=",ExpressionUUID->"037bf181-e886-47c0-9a31-2da63977e722"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"name_Symbol", ",", "tobj_TObj"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "namestr", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"namestr", "=", 
      RowBox[{"ToString", "[", "name", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"$TGraphExamples", "=", 
      RowBox[{"DeleteItems", "[", 
       RowBox[{"$TGraphExamples", ",", 
        RowBox[{"{", "namestr", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"AppendTo", "[", 
      RowBox[{"$TGraphExamples", ",", "namestr"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"name", "=", "tobj"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.706824667980452*^9, 3.706824706403494*^9}, {
  3.7182888754899*^9, 3.718288909753719*^9}},
 CellLabel->
  "In[1050]:=",ExpressionUUID->"ce1e5470-a53f-4563-981f-4eb8988d7aa2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"name_Symbol", ",", "any_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Message", "[", 
      RowBox[{
       RowBox[{"AddTGraphExample", "::", "badobj"}], ",", "any"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.706824667980452*^9, 3.706824706403494*^9}, {
  3.7182883712539*^9, 3.718288397470148*^9}},
 CellLabel->
  "In[1051]:=",ExpressionUUID->"c7630564-3466-40d5-b87b-70f8a7494190"]
}, Closed]],

