 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) KillMergedEdges, SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.59492899848796*^9, 3.594929032779661*^9}, {
