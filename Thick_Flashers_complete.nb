Cell[TextData[{
 "StyledRuledPatch[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces Graphics or Graphics3D elements for a styled patch that \
represents a ruled surface ",
 StyleBox["s",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "], a surface overlaid with straight lines of constant ",
 StyleBox["u",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.688080297767209*^9, 3.688080359192568*^9}, {
   3.688082343580003*^9, 3.688082446709085*^9}, {3.6880824837386003`*^9, 
   3.68808248577001*^9}, {3.688082638329948*^9, 3.688082653023417*^9}, {
   3.688134659014649*^9, 3.688134663894555*^9}, {3.689247665192663*^9, 
   3.689247704374168*^9}, {3.689266480515312*^9, 3.689266498510154*^9}, {
   3.689274355281386*^9, 3.6892743722538433`*^9}, {3.689274413214671*^9, 
   3.689274415332392*^9}, {3.689274470239334*^9, 3.6892744861225843`*^9}, 
   3.689274531620663*^9, {3.689274943925278*^9, 3.689274966415805*^9}, {
   3.68927592362166*^9, 3.6892759825485888`*^9}, {3.6894616194815397`*^9, 
   3.689461641462734*^9}, 3.689854585586974*^9, {3.68985466993055*^9, 
   3.689854699723868*^9}, {3.689854816625966*^9, 3.689854823394046*^9}, {
   3.691407333228506*^9, 3.691407345719658*^9}, 3.6914077968411217`*^9, 
   3.691408899501064*^9, 3.6915241226331663`*^9, {3.694002725835821*^9, 
   3.694002736315604*^9}, {3.80001399681439*^9, 3.8000140212542877`*^9}, {
   3.800014053718609*^9, 3.800014066044103*^9}, {3.803562019770481*^9, 
   3.803562043418959*^9}},ExpressionUUID->"c084a291-1d41-4887-8ac3-\
3b7796bc4672"],

Cell[TextData[{
 "Options:\n\tRulingLineDivisions \[Rule] ",
 StyleBox["nr",
  FontSlant->"Italic"],
 ", the number of divisions along the u-direction for rendering ruling lines.\
\n\tRulingLineOffset \[Rule] True | False, whether to offset ruling lines \
from the sides of the patch.\n\tRulingLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for drawing the ruling lines.\n\tEndLineStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", specifies the line style on one or both ends.\n\tCurveDivisions, \
FillStyle, SurfaceOrientation are passed through to StyledPatch."
}], "Text",
 CellChangeTimes->{{3.691408903076148*^9, 3.691408957807976*^9}, {
   3.691524021832034*^9, 3.691524030839469*^9}, 3.691524101610699*^9, {
   3.692210974822172*^9, 3.692210986369631*^9}, {3.692298927781845*^9, 
   3.692298934436814*^9}, 3.693959309507842*^9, {3.6939616934700823`*^9, 
   3.693961718742454*^9}, 3.6940021944061823`*^9, 3.694007282887176*^9, {
   3.694007393958525*^9, 3.694007395262271*^9}, {3.694007808874926*^9, 
   3.69400781548911*^9}, {3.785593383841789*^9, 3.785593386616734*^9}, {
   3.8020960201925573`*^9, 3.802096048441592*^9}, 3.803404752633551*^9, {
   3.803898584639456*^9, 
   3.803898589895422*^9}},ExpressionUUID->"4260632c-6d6e-4659-baa8-\
fe119aa65adf"],

Cell["\<\
Note that we use CurveDivisions, not PatchDivisions, because we\
\[CloseCurlyQuote]re only discretizing in a single direction.\
\>", "Text",
 CellChangeTimes->{{3.785593432073386*^9, 
  3.785593453241465*^9}},ExpressionUUID->"69fb166d-985b-4baa-8d1a-\
a4f92f3d576b"],

Cell["\<\
RulingLineOffset specifies whether to offset the ruling lines from the sides \
of the patch. If False, there are ruling lines on the sides; if True, the \
ruling lines are offset by half of the ruling line divisions.\
\>", "Text",
 CellChangeTimes->{{3.689274538585758*^9, 3.689274599240209*^9}, 
   3.691407804963612*^9, {3.692210993850868*^9, 3.692211026316312*^9}, {
   3.693961726341804*^9, 3.69396174832583*^9}, {3.802096065127815*^9, 
   3.8020961336738*^9}},ExpressionUUID->"062033e7-97ea-40e4-9bb9-\
d80d38e74b21"],

Cell["\<\
EndLineStyle specifies the style on the two curved boundaries.\
\>", "Text",
 CellChangeTimes->{{3.8020960713392963`*^9, 
  3.802096077217461*^9}},ExpressionUUID->"83b25646-4fcd-4202-a21a-\
95258b16c47a"],

Cell[TextData[{
 "RulingLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " has several forms that style could take:\n\tNone \[LongDash] don\
\[CloseCurlyQuote]t include ruling lines.\n\t",
 StyleBox["style",
  FontSlant->"Italic"],
 " \[LongDash] a single style to use for all ruling lines."
}], "Text",
 CellChangeTimes->{{3.8017587409990463`*^9, 3.801758808623097*^9}, 
   3.802095905288479*^9},ExpressionUUID->"b395b90c-9a5a-455d-9bb5-\
be5243daa688"],

Cell[TextData[{
 "EndLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " has several forms that ",
 StyleBox["style",
  FontSlant->"Italic"],
 " could take:\n\tNone \[LongDash] don\[CloseCurlyQuote]t put lines on the \
end of the patch.\n\t",
 StyleBox["style",
  FontSlant->"Italic"],
 " \[LongDash] a single named style to use for both ends of the patch.\n\t{",
 StyleBox["style",
  FontSlant->"Italic"],
 "} \[LongDash] a single named style to use for both ends of the patch.\n\t{{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ...}} \[LongDash] multiple style directives to apply to both ends of the \
patch.\n\t{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["style2",
  FontSlant->"Italic"],
 "} \[LongDash] styles to apply individually to the two ends."
}], "Text",
 CellChangeTimes->{{3.6892712528917646`*^9, 3.689271274680113*^9}, {
   3.689271394390013*^9, 3.689271610338603*^9}, {3.6892720782573147`*^9, 
   3.689272082226816*^9}, 3.691407761312769*^9, {3.691523758891292*^9, 
   3.691523761835228*^9}, {3.6922106981080637`*^9, 3.69221070339203*^9}, {
   3.693959394117618*^9, 
   3.693959445354251*^9}},ExpressionUUID->"e53213fa-9df4-4870-812d-\
1e3bd42371a0"],

Cell[TextData[{
 "If you pass a surface function ",
 StyleBox["s",
  FontSlant->"Italic"],
 " (as in the first prototype above) that isn\[CloseCurlyQuote]t a ruled \
surface with ruling lines along lines of constant ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", you will get a plot of the surface with straight lines, but the lines won\
\[CloseCurlyQuote]t run along the surface."
}], "Text",
 CellChangeTimes->{{3.8035621054116583`*^9, 
  3.803562209989026*^9}},ExpressionUUID->"8932cf9b-fee2-46fd-9898-\
6220676ec03a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RulingLineDivisions", "::", "usage"}], 
   "=", "\"\<RulingLineDivisions is an option to StyledRuledPatch that \
specifies the number of divisions transverse to the ruling direction to use \
for drawing ruling lines.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.688081065924526*^9, 3.688081068060779*^9}, {
   3.688081104379384*^9, 3.688081140446023*^9}, 3.689275699645883*^9, 
