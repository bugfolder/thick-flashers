Cell[TextData[{
 "MakeGoldbergTilingGraph[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns a TGraph representing a plane graph of a Goldberg tiling."
}], "Text",
 CellChangeTimes->{{3.485217401967222*^9, 3.485217452983184*^9}, {
