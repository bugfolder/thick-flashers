      RowBox[{"tobj", ",", "TGraph", ",", "Graph3DGraphics3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "Graph3DGraphics3D"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", " ", "edges", ",", " ", "faces"}], "}"}], " ", 
      "=", " ", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", " ", "Edges", ",", " ", "Faces"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hf", " ", "=", " ", 
      RowBox[{"HasFacesQ", "[", "tobj", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gg", " ", "=", " ", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"hf", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{"fcng", "===", "None"}], ")"}]}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"gg", ",", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"Polygon", "[", 
                  RowBox[{
                  "verts3d", "\[LeftDoubleBracket]", "#1", 
                   "\[RightDoubleBracket]"}], "]"}], ",", 
                 RowBox[{"Lighter", "[", 
                  RowBox[{"fc", ",", 
                   RowBox[{".8", "-", 
                    RowBox[{".1", "#2"}]}]}], "]"}]}], "]"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"faces", ",", "fcng"}], "}"}]}], "]"}]}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"gg", ",", 
          RowBox[{"Style", "[", 
