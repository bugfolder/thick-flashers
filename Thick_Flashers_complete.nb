Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "}"}], "&"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "#", "}"}], "&"}], ",", "\[IndentingNewLine]", 
