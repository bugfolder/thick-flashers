Cell[CellGroupData[{

Cell[TextData[{
 "MakeRectMoselyPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MinimumAngle,FlangeExcess, FoldedFormGapSize, \
Options[Graphics], Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{{3.456360555899096*^9, 3.456360578210458*^9}, {
   3.456362306961009*^9, 3.456362307519025*^9}, {3.456511256905506*^9, 
   3.456511294786961*^9}, {3.526762557961286*^9, 3.526762559313137*^9}, {
   3.526825638556994*^9, 3.526825663145781*^9}, 3.5921277684121866`*^9, 
   3.593089942871633*^9},ExpressionUUID->"a04b3cda-65bd-49c8-ba21-\
f1f761987fe2"],

Cell[TextData[{
 "MakeRectMoselyPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of 2D points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " and a rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and creates a crease pattern and folded form of a rotational pot using \
Jeannine Mosely's solid-flange construction starting from a rectangle. It \
returns a ",
 "TObj",
 ". Options are:\n\tMinimumAngle\[Rule]",
 StyleBox["mb",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["mb",
  FontSlant->"Italic"],
 " is the minimum bend angle at which we add a horizontal crease along the \
side.\n\tFlangeExcess\[Rule]",
 StyleBox["fe",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["fe",
  FontSlant->"Italic"],
 " is the proportional increase in flange width relative to the widest panel.\
\n\tGapSize\[Rule]",
 StyleBox["gap",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["gap",
  FontSlant->"Italic"],
 " is the proportional reduction in panel width that introduces a gap into \
the flanges in the folded form. This is only a tweak for rendering of the \
folded form; the crease pattern is not affected by this parameter."
}], "Text",
 CellChangeTimes->{{3.456356366824768*^9, 3.456356480780696*^9}, {
   3.456357875049625*^9, 3.456357882948633*^9}, {3.456358004628619*^9, 
   3.456358052075944*^9}, 3.4563605796995564`*^9, {3.4563623134869537`*^9, 
   3.456362327293576*^9}, {3.456397223211234*^9, 3.456397236205503*^9}, {
   3.4564003055877643`*^9, 3.456400340079489*^9}, {3.526730724180833*^9, 
   3.526730726364172*^9}, {3.5268256790967813`*^9, 3.526825712337274*^9}, {
   3.592128587457424*^9, 3.5921285930009823`*^9}, 3.592170590506476*^9, 
   3.592435766412191*^9},ExpressionUUID->"cda38fc7-8cc6-4505-9695-\
9027a56dd9f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRectMoselyPot", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"FlangeExcess", "\[Rule]", "0.05"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"FoldedFormGapSize", "\[Rule]", "0.05"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456356554910956*^9, 3.456356573084632*^9}, {
   3.45635731355683*^9, 3.456357357633705*^9}, {3.4563578217357187`*^9, 
   3.456357823509667*^9}, {3.45635799031857*^9, 3.456358001126463*^9}, 
   3.456362364440445*^9, {3.456397207804387*^9, 3.45639721839271*^9}, 
   3.4563999008940287`*^9, {3.526823313405148*^9, 3.5268233141490383`*^9}, {
   3.526825717081631*^9, 3.5268257326010838`*^9}, 3.592127768520916*^9},
 CellLabel->
  "In[3549]:=",ExpressionUUID->"f2bdf1ff-b830-41d3-af99-2779b574c284"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRectMoselyPot", "[", 
   RowBox[{"pts_", ",", "m_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mb", ",", "fe", ",", "gs", ",", "\[Phi]", ",", "sf", ",", "cf", ",", 
      "tf", ",", "nn", ",", "ps", ",", "fb", ",", "cs", ",", "xt", ",", 
      "\[Zeta]", ",", "wt", ",", "wr", ",", "rt", ",", "hw", ",", "vt", ",", 
      "stc", ",", "sth", ",", "dl", ",", "an", ",", "a2", ",", "b2", ",", 
      "c2", ",", "d2", ",", "e2", ",", "f2", ",", "g2", ",", "h2", ",", "i2", 
      ",", "j2", ",", "k2", ",", "cpw", ",", "cpsw", ",", "cp", ",", "a3", ",",
       "b3", ",", "c3", ",", "d3", ",", "e3", ",", "f3", ",", "g3", ",", "h3",
       ",", "i3", ",", "j3", ",", "k3", ",", "pfn", ",", "ffw", ",", "ffsw", ",",
       "ff"}], "}"}], ",", 
    RowBox[{
     RowBox[{"mb", "=", 
      RowBox[{
       RowBox[{"MinimumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectMoselyPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fe", "=", 
      RowBox[{
       RowBox[{"FlangeExcess", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectMoselyPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gs", "=", 
      RowBox[{
       RowBox[{"FoldedFormGapSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectMoselyPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "setup", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"N", "[", 
       RowBox[{"\[Pi]", "/", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sf", "=", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ";", 
     RowBox[{"cf", "=", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ";", 
     RowBox[{"tf", "=", 
      RowBox[{"sf", "/", "cf"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ps", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{
         "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        "&"}], "/@", "pts"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"shift", " ", "points", " ", "to", " ", "origin"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fb", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ps", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "\[Equal]", 
        RowBox[{"ps", "\[LeftDoubleBracket]", 
         RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], ")"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"True", " ", "if", " ", "base", " ", "is", " ", "flat"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xt", ",", "\[Zeta]"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "ps", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"wt", "=", 
      RowBox[{"tf", " ", "xt"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"half", "-", 
       RowBox[{"width", " ", "of", " ", "each", " ", "panel"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"wr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "gs"}], ")"}], " ", "wt"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"reduced", " ", "half"}], "-", 
       RowBox[{"width", " ", "of", " ", "each", " ", "panel"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rt", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"Mag", "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"RotateLeft", "[", "ps", "]"}], "-", "ps"}], ")"}]}], ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "x", " ", "coord", " ", "of", " ", "panel", " ", "in", " ", "CP"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"hw", "=", 
      RowBox[{
       RowBox[{"Max", "[", "wt", "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", "fe"}], ")"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"half", "-", 
       RowBox[{"width", " ", "of", " ", "rectangle"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vt", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"hw", ",", 
        RowBox[{"{", "nn", "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"full", " ", "half"}], "-", 
       RowBox[{"width", " ", "of", " ", "wedge", " ", "in", " ", "CP"}]}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sth", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"vt", "-", "wt"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "cf"}], ")"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "length", " ", "of", " ", "side", " ", "of", " ", "flange", " ", "in", " ",
        "FF"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"stc", "=", 
      RowBox[{"cf", " ", "sth"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"half", "-", 
       RowBox[{
       "width", " ", "of", " ", "face", " ", "of", " ", "flange", " ", "in", " ",
         "FF"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dl", "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"N", "[", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RotateLeft", "[", "ps", "]"}], "-", "ps"}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"directions", " ", "of", " ", "each", " ", "panel"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"an", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "0", "}"}], ",", 
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ArcTan", "[", 
              RowBox[{
               RowBox[{"#1", ".", "#2"}], ",", 
               RowBox[{
                RowBox[{"Cross", "[", "#1", "]"}], ".", "#2"}]}], "]"}], 
             "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"dl", ",", 
              RowBox[{"RotateLeft", "[", "dl", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}], ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"fold", " ", "angle"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"CROSS", " ", "SECTION"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cs", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Line", "[", "ps", "]"}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}], "*", "#"}], "&"}], "/@",
             "ps"}], "]"}]}], "}"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"CREASE", " ", "PATTERN"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"-", "vt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"-", "wt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b2", " ", "+", 
         RowBox[{"d2", " ", "cf"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "cf"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"e2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", "0"}], "}"}], "&"}], "/@", "rt"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"+", "wt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"h2", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rt", ",", 
         RowBox[{"+", "vt"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"f2", "+", 
         RowBox[{"h2", " ", "cf"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "cf"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"-", "2"}], "hw"}]}], "}"}], "+", "#"}], "&"}], "/@", 
       "g2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"h2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "hw"}]}], "}"}], "+", "#"}], "&"}], "/@", "b2"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"i2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "hw"}]}], "}"}], "+", "#"}], "&"}], "/@", "c2"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"j2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "hw"}]}], "}"}], "+", "#"}], "&"}], "/@", "d2"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"k2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"2", "hw"}]}], "}"}], "+", "#"}], "&"}], "/@", "e2"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"cpw", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "c2", "]"}], ",", "ValleyLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "d2", "]"}], ",", "MountainLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "f2", "]"}], ",", "MountainLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "g2", "]"}], ",", "ValleyLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"a2", ",", "c2", ",", "an"}], "}"}]}]}]}], "]"}], ",", 
          
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"c2", ",", "d2", ",", 
                RowBox[{"-", "an"}]}], "}"}]}]}]}], "]"}], ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"d2", ",", "f2", ",", "an"}], "}"}]}]}]}], "]"}], ",", 
          
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"f2", ",", "g2", ",", 
                RowBox[{"-", "an"}]}], "}"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a2", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"c2", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"g2", "\[LeftDoubleBracket]", 
                RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], "]"}],
             ",", "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
               "a2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "c2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "g2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
               "}"}], "]"}], ",", "BorderLine"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cpsw", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "f2", "]"}], ",", "MountainLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "g2", "]"}], ",", "ValleyLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "i2", "]"}], ",", "ValleyLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "j2", "]"}], ",", "MountainLine"}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"e2", ",", "f2", ",", "an"}], "}"}]}]}]}], "]"}], ",", 
          
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3", ",", 
               RowBox[{"MinimumAngle", "\[Rule]", "mb"}]}], "]"}], "&"}], ",", 
            RowBox[{"DropFirst", "/@", 
             RowBox[{"DropLast", "/@", 
              RowBox[{"{", 
               RowBox[{"f2", ",", "g2", ",", 
                RowBox[{"-", "an"}]}], "}"}]}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFoldLine", "[", 
              RowBox[{
