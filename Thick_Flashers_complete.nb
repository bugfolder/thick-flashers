      RowBox[{"Planarize", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "ff", "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799330215241061*^9, 3.799330266624402*^9}, 
