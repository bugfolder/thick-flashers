      "\[Alpha]_", ",", "types_List"}], "}"}], ",", "decoration_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PolygonCenteredTwistAltTile", ",", 
      RowBox[{"UnitCyclicPolygonVertices", "[", 
       RowBox[{"angles", ",", "side", ",", "is"}], "]"}], ",", "w", ",", 
      "\[Alpha]", ",", "types"}], "}"}], ",", "decoration", ",", "opts"}], 
   "]"}]}]], "Input",
