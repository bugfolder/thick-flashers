Cell["\<\
Example. A degree-5 vertex; not developable, not (initially) \
Kawasaki-consistent, but the output will have its last sector angle modified \
to make it Kawasaki-consistent.\
\>", "Text",
 CellChangeTimes->{{3.6161717329263983`*^9, 3.6161717335980377`*^9}, {
  3.616173154115739*^9, 3.616173164754417*^9}, {3.6161748991238112`*^9, 
