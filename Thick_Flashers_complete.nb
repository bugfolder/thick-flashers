Cell[TextData[{
 "VertexEdgeAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TPlaneGraph+TGraph2D and returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", " ", 
       SubscriptBox["\[Alpha]", "2"], ",", " ", "..."}], "}"}], ",", " ", 
     "..."}], "}"}], TraditionalForm]],ExpressionUUID->
  "8379be27-7548-40d5-91a5-fa484f37c95a"],
 " of the sector angles around each vertex like VertexEdgeAngles, but using \
the Vertices2D data. As with ",
 "VertexEdgeAngles",
 ", the angles for border faces are Null."
}], "Text",
