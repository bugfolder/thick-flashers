         RowBox[{
          RowBox[{"A", "\[Rule]", "1"}], ",", 
          RowBox[{"B", "\[Rule]", "2"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"X", ",", "Y", ",", "Z"}], "}"}], ",", "\"\<EXAMPLE\>\""}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowErrorExample"}]], "Input",
 CellChangeTimes->{{3.592346896860133*^9, 3.592346959855023*^9}, {
   3.592431391777003*^9, 3.592431395822947*^9}, {3.592431516055719*^9, 
   3.592431523551579*^9}, {3.592431617736424*^9, 3.592431628934984*^9}, 
   3.592465162350274*^9, 3.593006114495487*^9},
 CellLabel->
  "In[1025]:=",ExpressionUUID->"c6a9ac13-4733-4ffb-98d7-c2ef192c8f68"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Format[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.592427134352604*^9, 
  3.59242713585262*^9}},ExpressionUUID->"4c1a654c-f78f-40e8-922f-\
4a907961b8f0"],

Cell["The  display format of a TObj shows a list of its classes.", "Text",
 CellChangeTimes->{{3.5913764913275213`*^9, 3.591376506479087*^9}, {
   3.59137725659964*^9, 3.591377257662259*^9}, {3.591377881336671*^9, 
   3.5913778845092077`*^9}, {3.591378330067452*^9, 3.591378343967243*^9}, {
   3.592427160867259*^9, 3.592427168969599*^9}, 
   3.592435736009736*^9},ExpressionUUID->"e79f6f2e-48a1-4cb3-ad8f-\
1565a6c06527"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Format", "[", 
   RowBox[{"TObj", "[", "args_List", "]"}], "]"}], "^:=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "classes", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"classes", "=", 
      RowBox[{"TClasses", "/.", "args"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"classes", "\[Equal]", "TClasses"}], ",", 
       RowBox[{"classes", "=", 
        RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\"\<\[SkeletonIndicator]TObj:<\>\"", "<>", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"Riffle", "[", 
        RowBox[{
         RowBox[{"ToString", "/@", "classes"}], ",", "\"\<, \>\""}], "]"}], 
       "]"}], "<>", "\"\<>\[SkeletonIndicator]\>\""}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.591377543559453*^9, 3.591377588875644*^9}, {
  3.591377668176691*^9, 3.591377682974882*^9}, {3.591377822045156*^9, 
  3.591377864025658*^9}, {3.591378214750354*^9, 3.591378249691476*^9}, {
  3.591640385176167*^9, 3.591640407782181*^9}, {3.5924271793193903`*^9, 
  3.59242721868047*^9}, {3.592427347762342*^9, 3.5924273957509317`*^9}, {
  3.592435736108761*^9, 3.592435736172387*^9}, {3.5924358258926487`*^9, 
  3.592435825958722*^9}, {3.59265473944636*^9, 3.592654739513229*^9}},
 CellLabel->
  "In[1026]:=",ExpressionUUID->"7a48d102-1088-4ebd-9dc1-2ba6714feb2d"],

Cell["Example", "Text",
 CellChangeTimes->{{3.591377050612894*^9, 3.591377051467554*^9}, {
  3.5924274108583937`*^9, 
  3.59242741990961*^9}},ExpressionUUID->"2983efd8-e01f-4786-909c-\
b963db530d4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"TObj", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TClasses", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"A", ",", " ", "B"}], "}"}]}], ",", 
         RowBox[{"C", "\[Rule]", "1"}], ",", 
         RowBox[{"D", "\[Rule]", "2"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "tobj"}]}], "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.591377053844928*^9, 3.591377086388472*^9}, 
   3.59137732129445*^9, {3.59137793027194*^9, 3.591377941176197*^9}, {
   3.591378593244232*^9, 3.5913785951503057`*^9}, {3.59164041565987*^9, 
   3.591640417079165*^9}, {3.592427229979045*^9, 3.5924272492792063`*^9}, 
   3.592435736271299*^9, 3.59243582604378*^9, 3.592654739613121*^9},
 CellLabel->
  "In[1027]:=",ExpressionUUID->"c0d204c8-2c80-4c92-8c3a-ed9543933e22"],

Cell["Example: class missing.", "Text",
 CellChangeTimes->{{3.5924274461087723`*^9, 
  3.592427450439177*^9}},ExpressionUUID->"34b9fc5b-b18a-442c-9c02-\
42e6a7c4b18f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"TObj", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"C", "\[Rule]", "1"}], ",", 
         RowBox[{"D", "\[Rule]", "2"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "tobj"}]}], "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.591377053844928*^9, 3.591377086388472*^9}, 
   3.59137732129445*^9, {3.59137793027194*^9, 3.591377941176197*^9}, {
   3.591378593244232*^9, 3.5913785951503057`*^9}, {3.59164041565987*^9, 
   3.591640417079165*^9}, {3.592427229979045*^9, 3.5924272492792063`*^9}, {
   3.592427404629841*^9, 3.592427407252305*^9}, 3.592435736370713*^9},
 CellLabel->
  "In[1028]:=",ExpressionUUID->"60b1c98b-a564-40aa-be0b-15f28f743f34"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Class structure\n<class>\nAdd<class>To",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     StyleBox["tobj",
      FontSlant->"Italic"], ",", " ", 
     SubscriptBox[
      StyleBox["parms",
       FontSlant->"Italic"], "i"], ",", " ", "..."}], "]"}], 
   TraditionalForm]],ExpressionUUID->"c79e3cf9-0e84-4b37-8e45-f008b292cd8b"],
 "\nAdd<class>",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["parms",
       FontSlant->"Italic"], "i"], ",", " ", "..."}], "]"}], 
   TraditionalForm]],ExpressionUUID->"b04f0f09-2d7d-4942-b707-86c8ca96926f"],
 "\nMake<class>",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox[
      StyleBox["parms",
       FontSlant->"Italic"], "i"], ",", " ", "..."}], "]"}], 
   TraditionalForm]],ExpressionUUID->"b0920deb-30fe-43ba-8271-8d7bfc20a561"]
}], "Subsubsection",
 CellChangeTimes->{{3.592479384189608*^9, 3.592479389132936*^9}, {
   3.592479559961423*^9, 3.5924795624977283`*^9}, {3.5926498558388834`*^9, 
   3.592649975432519*^9}, 
   3.592659520307723*^9},ExpressionUUID->"be0aab08-582a-47c8-94e6-\
4ee8e8e0e5ea"],

Cell["\<\
When I create a new TObj class, I  define a symbol for its class name (via \
<class>::usage) and then define any new properties introduced in the class. \
\>", "Text",
 CellChangeTimes->{{3.592479394261108*^9, 3.592479542971414*^9}, {
  3.592646869647212*^9, 
  3.592646876333771*^9}},ExpressionUUID->"82576001-2c8e-4d16-bde2-\
c419a6f6bbd2"],

Cell[TextData[{
 "A ",
 StyleBox["base class",
  FontSlant->"Italic"],
 " is built directly from one or more parameters. The most common base class \
in Tessellatica is class TGraph."
}], "Text",
 CellChangeTimes->{{3.5926527406769876`*^9, 
  3.59265281119753*^9}},ExpressionUUID->"9b6e78ca-780f-47f7-9cfa-\
99bc7f56122b"],

Cell[TextData[{
 "A ",
 StyleBox["derived class",
  FontSlant->"Italic"],
 " is a class that must inherit from another class, which could be a base \
class or another derived class. An example of a derived class is class ",
 "TPlaneGraph",
 ", which must inherit from a TGraph."
}], "Text",
 CellChangeTimes->{{3.592652821396811*^9, 3.592652901751622*^9}, 
   3.592828709821431*^9},ExpressionUUID->"8a56141e-8bb9-4693-8196-\
c55d97658b10"],

Cell[TextData[{
 "A ",
 StyleBox["mixin",
  FontSlant->"Italic"],
 " class is a class that can be a base class but is commonly used to add \
behaviors and properties to another class, via multiple inheritance. An \
example of a mixin class is the ",
 "TAssigned",
 " class, which is used to add crease assignment to the TGraph class (and its \
subclasses)."
}], "Text",
 CellChangeTimes->{{3.592652919454307*^9, 3.592652927581683*^9}, {
   3.5926529616913223`*^9, 3.5926530525890627`*^9}, {3.592653181796685*^9, 
   3.592653196795042*^9}, {3.592653261697072*^9, 3.592653360176775*^9}, 
   3.592828860881936*^9},ExpressionUUID->"0b861a03-9b7e-4c40-9f20-\
2d4fbe2bcf49"],

Cell[TextData[{
 "A ",
 StyleBox["multiple-inheritance",
  FontSlant->"Italic"],
 " class is a conceptual class (with no actual names or functions) that we \
use to describe an object that inherits from two or more classes via \
different parentage. A general way of referring to the class structure of a \
multiple-inheritance class is to combine the class names with a \
\[OpenCurlyDoubleQuote]+\[OpenCurlyDoubleQuote] sign; thus, an object that \
inherits from both TGraph and TAssigned would have a TGraph+TAssigned class. \
This usage is only for purposes of documentation and discussion; there\
\[CloseCurlyQuote]s no actual class name called \
\[OpenCurlyDoubleQuote]TGraph+",
 "TAssigned",
 ",\[CloseCurlyDoubleQuote] for example. But for a few common combinations, \
we do define classes, see next."
}], "Text",
 CellChangeTimes->{{3.5926536317804*^9, 3.5926538239604383`*^9}, {
  3.592828861031807*^9, 
  3.5928288612593107`*^9}},ExpressionUUID->"f7db938c-c2db-40ea-a5b9-\
1421f7da81af"],

Cell[TextData[{
 "A ",
 StyleBox["convenience",
  FontSlant->"Italic"],
 " class is a class defined by multiple inheritance. An example of a \
convenience class is the ",
 "TGraphAssigned",
 " class, which inherits from both TGraph and TAssigned classes. The number \
of ways you can combine base classes, derived classes, and mixin classes is \
quite large; we create convenience classes only for the most common \
combinations. "
}], "Text",
 CellChangeTimes->{{3.59265309213774*^9, 3.5926531503181047`*^9}, {
   3.5926533708144403`*^9, 3.592653518612079*^9}, {3.592653839617483*^9, 
   3.592653840256303*^9}, {3.592828861333682*^9, 3.592828883972765*^9}, 
   3.5947345191442957`*^9},ExpressionUUID->"88b74f74-464b-4a2d-bd63-\
0e946ba7e1c4"],

Cell["\<\
Convenience classes are more specific than multiple-inheritance classes, \
which makes them of lesser stature. So, for example, while an TGraphAssigned \
class is a TGraph+TAssigned class, and a TPlaneGraphAssigned is also a \
TGraph+TAssigned class, a TPlaneGraphAssigned is NOT necessarily a \
TGraphAssigned, depending on the order of its construction. So, when we do \
class checking on class arguments using AssertClasses, we never check against \
a convenience class, but rather, against the relevant parent classes. \
\>", "Text",
 CellChangeTimes->{{3.592653589050933*^9, 3.5926536282369957`*^9}, {
   3.592653850497634*^9, 3.592654039514727*^9}, {3.592828709930575*^9, 
   3.5928287100251703`*^9}, {3.59282886144177*^9, 3.5928288841625223`*^9}, {
   3.592828955229719*^9, 3.592828955325704*^9}, 3.5930061146039243`*^9, {
   3.594734519295893*^9, 3.594734519433869*^9}, {3.594739041817286*^9, 
   3.59473904196329*^9}, {3.6149595903641357`*^9, 
   3.6149595954199257`*^9}},ExpressionUUID->"3fca4ae9-47c8-441c-9f46-\
1294ea7c469e"],

Cell[TextData[{
 "Classes can have multiple forms of constructor:\n\tAdd<class>To[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", [",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "c22c9160-9bf4-4a59-8113-5e93c71ea8e7"],
 "] takes a base class object and adds the new class to it. The parameter \
list contains only the additional parameters that are needed for the new \
class.\n\tAdd<class>[",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "cbfe8050-ea46-40b6-a7f8-fdc0898cd8e0"],
 "] returns a pure function that acts on a base class object and adds the \
additional parameters to the base class, returning the new class object.\nFor \
some classes we provide a third form:\n\tMake<class>[",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "8fd93bf2-7f9a-4a41-864b-96eca7926ca2"],
 "] builds the object directly from all required parameters. This form will \
only be provided if the parameter list is relatively short and the \
inheritance hierarchy is direct."
}], "Text",
 CellChangeTimes->{{3.5926464090945*^9, 3.592646537004935*^9}, {
   3.592646586161981*^9, 3.5926467621495113`*^9}, {3.592646806031091*^9, 
   3.592646977958753*^9}, {3.592647028651218*^9, 3.592647030099116*^9}, {
   3.592647109365739*^9, 3.59264713410914*^9}, {3.592649513248152*^9, 
   3.592649619783552*^9}, {3.592654071404261*^9, 3.592654145091686*^9}, 
   3.592655419850404*^9, 3.592828861666543*^9, 3.592828983594698*^9, 
   3.594741299426896*^9, {3.615244676030217*^9, 
   3.61524467678821*^9}},ExpressionUUID->"81de44db-249b-4ea8-82b0-\
3cef1fdbf85f"],

Cell[TextData[{
 "Constructors for base classes only provide the Make<class>[",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "23f2ed88-22a4-47a3-baa2-fd6e2f5ef624"],
 "] constructor."
}], "Text",
 CellChangeTimes->{{3.592645865012635*^9, 3.59264593136011*^9}, 
   3.592646860613526*^9, {3.592649756488927*^9, 3.592649794379077*^9}, {
   3.592649826753048*^9, 
   3.592649836976619*^9}},ExpressionUUID->"9e3e9be8-8ee2-45b8-8a7c-\
8a87cf9b7a19"],

Cell[TextData[{
 "Constructors for derived classes only provide the Add<class>To[",
 StyleBox["tobj_",
  FontSlant->"Italic"],
 "TObj",
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "6b09e598-e7b9-4540-9375-34fccc8f51b4"],
 "] and Add<class>[",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "037c7cc8-86e0-4202-9c95-96092793d4ca"],
 "] constructors."
}], "Text",
 CellChangeTimes->{{3.592486085794169*^9, 3.592486225615457*^9}, {
   3.592645934568226*^9, 3.5926459356921372`*^9}, 3.5926468613123507`*^9, 
   3.592649756489715*^9, {3.592649849736035*^9, 3.592649852639684*^9}, {
   3.592654163570728*^9, 3.59265425680402*^9}, 
   3.5930063244548793`*^9},ExpressionUUID->"fa84e905-c517-42b9-a3a9-\
5731ddd49eaf"],

Cell[TextData[{
 "Mixin classes provide the Add<class>To[",
 StyleBox["tobj_",
  FontSlant->"Italic"],
 "TObj",
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "e5453d6e-5177-4699-b616-d00b74f15e7c"],
 "] and Add<class>[",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "d14409e2-b9af-47ef-810d-05cf66ad78e9"],
 "] constructors but may also provide a Make<class>[",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["parms", "1"], ",", " ", 
    SubscriptBox["parms", "2"], ",", " ", "..."}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "d72213eb-7637-4483-9729-32e603ee3945"],
 "] constructor if they can act as a base class."
}], "Text",
 CellChangeTimes->{{3.592654260796399*^9, 3.592654299897663*^9}, 
   3.5930063245312*^9},ExpressionUUID->"610a4e9b-070c-47b8-89ef-f14a6353d243"],

Cell["\<\
Several classes take no additional parameters in their Add<class>To \
constructor; they simply take an argument of one class (e.g., TGraph) and \
return an argument of the new class (e.g., TPlaneGraph). For these classes, \
Add<class> and Add<class>To behave exactly the same.\
\>", "Text",
 CellChangeTimes->{{3.59264595355048*^9, 3.5926459950273333`*^9}, 
   3.592649756489942*^9, {3.592650001573513*^9, 3.592650011540316*^9}, {
   3.592654317816437*^9, 3.592654331023416*^9}, 
   3.5928287100882173`*^9},ExpressionUUID->"749c1fe8-32c9-4ee2-ae8a-\
af645b54cc15"],

Cell["\<\
Convenience classes may provide different forms of a Make<class> function, \
depending on how long and complicated their properties are. Relatively simple \
ones (e.g., TGraphAssigned) will take the full set of properties as a \
sequence of parameters. More complex ones (e.g., TPlaneGraphAssigned) will \
take a base TObj plus one or more parameters, similar to Add<class>To.\
\>", "Text",
 CellChangeTimes->{{3.592486227744232*^9, 3.592486232831299*^9}, {
   3.592486300784053*^9, 3.592486450746068*^9}, {3.592650044674383*^9, 
   3.5926500803597107`*^9}, {3.5926543396313343`*^9, 3.592654340039419*^9}, 
   3.5928287101646338`*^9, 3.592828884240571*^9, 3.5928289554054193`*^9, 
   3.594734519553533*^9, 
   3.594739042095601*^9},ExpressionUUID->"8a6eab35-61dd-41c7-bfb4-\
61de85014b17"],

Cell[TextData[{
 "The Add<class>To and Add<class> constructors allow you to build up derived \
classes by chaining constructors for base and mixin classes using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s postfix \[OpenCurlyDoubleQuote]//\
\[CloseCurlyDoubleQuote] operator. For example:\n\tMakeTGraph[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 "] // AddTPlaneGraph // Add",
 "TGraphAssigned",
 "[",
 StyleBox["types",
  FontSlant->"Italic"],
 "]\nThis expression returns a TPlaneGraph+TGraphAssigned, i.e., a plane \
graph with adjacency information and crease assignments on its edges."
}], "Text",
 CellChangeTimes->{
  3.592647113215139*^9, 3.592647649318119*^9, {3.5926500918227587`*^9, 
   3.592650092542913*^9}, {3.5926543872366853`*^9, 3.592654399571765*^9}, {
   3.5928287102310133`*^9, 3.592828710287958*^9}, {3.592828884306766*^9, 
   3.592828884366283*^9}, 3.594734519659501*^9, 
   3.594742520611951*^9},ExpressionUUID->"5f79a627-a83a-4d77-a003-\
0daafc5bcb5e"],

Cell[TextData[{
 "Functions that take TObjs as arguments have some notations under their \
names in the subsubsection titles:\n\t(unchecked class) ... means that the \
TObj should be of the specified class but there is no explicit \
class-checking.\n\t(checked class) ... means that the TObj should have the \
specified class(es) and if it doesn\[CloseCurlyQuote]t, an error will be \
thrown that aborts the function.\nTypically we use \
\[OpenCurlyDoubleQuote]unchecked class\[CloseCurlyDoubleQuote] for helper \
functions and use \[OpenCurlyDoubleQuote]checked \
class\[CloseCurlyDoubleQuote] for functions intended for general usage. \
Helper functions are, roughly speaking, equivalent to private methods in OO \
lingo. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " supports true private functions via namespaces, but in Tessellatica we \
expose all functions, which facilitates ongoing development of the package."
}], "Text",
 CellChangeTimes->{{3.592479470031361*^9, 3.592479485638166*^9}, {
   3.592479671737596*^9, 3.592479806136087*^9}, {3.592646346515441*^9, 
   3.592646395111683*^9}, {3.592647070031882*^9, 3.592647076439733*^9}, {
   3.592654429321531*^9, 3.592654539906478*^9}, {3.5932127959438143`*^9, 
   3.5932127965504107`*^9}, 3.594732489714318*^9, {3.5951893208249598`*^9, 
   3.595189327336217*^9}},ExpressionUUID->"ac634e3a-53ef-4f75-a515-\
43588f26c613"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Class hierarchy\n$TClasses\n$TClassInheritance\nRegisterTClass[",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["parents",
  FontSlant->"Italic"],
 "]\nTClassGraphics[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ClassGraphRotation, FontSize"
}], "Subsubsection",
 CellChangeTimes->{{3.5924798110884237`*^9, 3.592479849308627*^9}, {
   3.592518813670166*^9, 3.592518849347272*^9}, {3.5925189468368*^9, 
   3.59251896423519*^9}, {3.592519111994217*^9, 3.59251913480714*^9}, {
   3.592520340733223*^9, 3.592520366379107*^9}, {3.592641750207206*^9, 
   3.592641828864683*^9}, 3.592659515629716*^9, {3.6162451965334163`*^9, 
   3.616245196828013*^9}, {3.616245246515562*^9, 3.616245250337943*^9}, {
   3.6162453878471537`*^9, 
   3.61624542075005*^9}},ExpressionUUID->"ba5d01c4-5a37-47ce-87c9-\
1dcb63be550c"],

Cell["\<\
$TClasses is a list of all of the TObj classes that have been defined.\
\>", "Text",
 CellChangeTimes->{{3.592518113237398*^9, 3.592518123358955*^9}, {
   3.592519153646093*^9, 3.59251915966222*^9}, 3.592641750400982*^9, {
   3.592641821347857*^9, 
   3.592641823969769*^9}},ExpressionUUID->"17fb974e-e221-414e-8242-\
ccc3255df87c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$TClasses", "=", 
   RowBox[{"{", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.592517156514783*^9, 3.592517169602541*^9}, 
   3.5925175324258204`*^9, {3.592517609300915*^9, 3.592517643705567*^9}, {
   3.592517853531061*^9, 3.592517854274357*^9}, {3.592518031775352*^9, 
   3.592518103808536*^9}, 3.592519162908243*^9, 3.592641750426963*^9},
 CellLabel->
  "In[1029]:=",ExpressionUUID->"3903ad38-64bf-4ed5-ba82-8ea77beea015"],

Cell["\<\
$TClassInheritance is a list of the edges of the $TObj classes graph as index \
pairs into $TClasses.\
\>", "Text",
 CellChangeTimes->{{3.592518128902588*^9, 3.592518149860034*^9}, {
   3.592519179917808*^9, 3.592519200235031*^9}, {3.592641750467423*^9, 
   3.5926417739079127`*^9}, 
   3.59300632458575*^9},ExpressionUUID->"51a7a90b-82cc-4ecb-aecb-\
783d99af3699"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$TClassInheritance", "=", 
   RowBox[{"{", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{3.59251810844952*^9, 3.592519178755919*^9, 
  3.592641773929154*^9},
 CellLabel->
  "In[1030]:=",ExpressionUUID->"c20e843b-c67d-458e-a512-09bb4eb86705"],

Cell[TextData[{
 "RegisterTClass[",
 StyleBox["class",
  FontSlant->"Italic"],
 ", ",
 StyleBox["parents",
  FontSlant->"Italic"],
 "] registers ",
 "TClasses",
 " ",
 StyleBox["class",
  FontSlant->"Italic"],
 " in the TObj class hierarchy. If it is a child class, provide a list of its \
parents in ",
 StyleBox["parents",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.592517709251838*^9, 3.5925177926448793`*^9}, {
   3.5925192071305847`*^9, 3.592519209866066*^9}, 3.5926417909393787`*^9, 
   3.592654739706096*^9},ExpressionUUID->"b8300fa7-9333-485d-8fe5-\
ada5f6b092f7"],

Cell["Call RegisterTClass for every class that\[CloseCurlyQuote]s created.", \
"Text",
 CellChangeTimes->{{3.592518863058865*^9, 3.592518872522167*^9}, {
   3.592518925535405*^9, 3.592518933029008*^9}, {3.592519212370332*^9, 
   3.5925192129222*^9}, 
   3.5926417910028763`*^9},ExpressionUUID->"28494ae6-c860-41a4-90dd-\
b148ebf7db69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegisterTClass", "[", 
   RowBox[{"class_Symbol", ",", 
    RowBox[{"parents_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ci", ",", "ce"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"$TClasses", ",", "class"}], "]"}], ",", 
       RowBox[{"Return", "[", "]"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"don", "'"}], "t", " ", "if", " ", 
       RowBox[{"we", "'"}], "ve", " ", "already", " ", "registered"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"$TClasses", ",", "class"}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"ci", "=", 
      RowBox[{"Length", "[", "$TClasses", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ce", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"$TClasses", ",", "#"}], "]"}], "\[LeftDoubleBracket]", 
            RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "\[Rule]", 
           "ci"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"$TClassInheritance", ",", "ce"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"$TClassInheritance", ",", "ce"}], "]"}]}], "]"}]}], 
        ")"}], "&"}], "/@", "parents"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.592517683319663*^9, 3.592517748963071*^9}, {
   3.592517828589175*^9, 3.592517845108394*^9}, {3.592517876905439*^9, 
   3.592518014712348*^9}, 3.592518230019545*^9, {3.592518368427475*^9, 
   3.592518368624152*^9}, {3.5925184140319347`*^9, 3.592518433798942*^9}, {
   3.592518471740129*^9, 3.5925185376871243`*^9}, {3.592519165437086*^9, 
   3.592519168589056*^9}, {3.592519215902722*^9, 3.592519224826234*^9}, {
   3.592641750492201*^9, 3.5926417910389338`*^9}},
 CellLabel->
  "In[1031]:=",ExpressionUUID->"9b358a56-16f6-48f4-99ca-a3b422cf7af1"],

Cell[TextData[{
 "TClassGraphics[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a Graphics object that displays the TObj class hierarchy. Options \
are:\n\tGraphRotation \[Rule] \[Theta], rotates the graph by an angle \
\[Theta] so that labels don\[CloseCurlyQuote]t overlap one another.\n\t\
FontSize \[Rule] ",
 StyleBox["size",
  FontSlant->"Italic"],
 ", specifies the font size for the labels."
}], "Text",
 CellChangeTimes->{{3.592518971928097*^9, 3.592519004008338*^9}, 
   3.592519239813756*^9, 3.592641807790164*^9, {3.592657777102343*^9, 
   3.592657777301277*^9}, {3.6162451919182577`*^9, 3.6162452076284733`*^9}, {
   3.616245256496962*^9, 3.616245285766398*^9}, {3.6162454606839123`*^9, 
   3.616245470882653*^9}},ExpressionUUID->"9c4d314b-df83-4812-ae07-\
47171084add6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassGraphRotation", "::", "usage"}], 
   "=", "\"\<ClassGraphRotation is an option to TClassGraphics that specifies \
the angle to rotate the class hierarchy graph.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.61624537644156*^9, 3.616245442826084*^9}},
 CellLabel->
  "In[1032]:=",ExpressionUUID->"2cce28b3-1841-4409-bd83-ced5139d78d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "TClassGraphics", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ClassGraphRotation", "\[Rule]", 
      RowBox[{
       RowBox[{"-", "60"}], "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FontSize", "\[Rule]", "14"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.616245181763057*^9, 3.61624524433254*^9}, {
  3.616245447768216*^9, 3.616245458302207*^9}, {3.616245569039139*^9, 
  3.616245616429686*^9}},
 CellLabel->
  "In[1033]:=",ExpressionUUID->"2df702a3-cd14-4021-a49d-a2a1f7349fca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TClassGraphics", "[", "opts___", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gr", ",", "fs", ",", "rm", ",", "g"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gr", "=", 
      RowBox[{
       RowBox[{"ClassGraphRotation", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TClassGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{
       RowBox[{"FontSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TClassGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rm", "=", 
      RowBox[{"RotationMatrix2D", "[", "gr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{"LayeredGraphPlot", "[", 
       RowBox[{"$TClassInheritance", ",", "Left", ",", 
        RowBox[{"VertexRenderingFunction", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Point", "[", "#1", "]"}], ",", 
               RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", 
               "DarkGray"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{
                 "$TClasses", "\[LeftDoubleBracket]", "#2", 
                  "\[RightDoubleBracket]"}], ",", "#1", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "1.1"}], ",", 
                   RowBox[{"-", "1.1"}]}], "}"}]}], "]"}], ",", 
               RowBox[{"FontSize", "\[Rule]", "fs"}]}], "]"}]}], "}"}], "&"}],
           ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "/.", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphicsComplex", "[", 
          RowBox[{"pts_", ",", "stuff___"}], "]"}], "\[RuleDelayed]", 
         RowBox[{"GraphicsComplex", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"rm", ".", "#"}], "&"}], "/@", "pts"}], ",", "stuff"}], 
          "]"}]}]}], "/.", 
       RowBox[{
        RowBox[{"Point", "[", "x_", "]"}], "\[RuleDelayed]", 
        RowBox[{"Point", "[", 
         RowBox[{"rm", ".", "x"}], "]"}]}]}], "/.", 
      RowBox[{
       RowBox[{"Text", "[", 
        RowBox[{"label_", ",", "y_", ",", "pos_"}], "]"}], "\[RuleDelayed]", 
       RowBox[{"Text", "[", 
        RowBox[{"label", ",", 
         RowBox[{"rm", ".", "y"}], ",", "pos"}], "]"}]}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.59251900960675*^9, 3.592519021430504*^9}, 
   3.592519172438272*^9, {3.59251923550069*^9, 3.592519260517223*^9}, {
   3.592641750577025*^9, 3.5926417746269836`*^9}, 3.592641807819674*^9, {
   3.59265777991335*^9, 3.592657780314103*^9}, {3.592794161338392*^9, 
   3.592794162684527*^9}, {3.592794210234926*^9, 3.5927942140961447`*^9}, {
   3.592794246052709*^9, 3.592794254442157*^9}, {3.614889823592929*^9, 
   3.614889824057981*^9}, {3.6148899097014093`*^9, 3.6148899101689997`*^9}, {
   3.616245294464849*^9, 3.616245371944943*^9}, 3.616245448696231*^9, {
   3.6162455080894623`*^9, 3.616245534701575*^9}, {3.616245578786245*^9, 
   3.616245579010646*^9}, 3.688166913073412*^9},
 CellLabel->
  "In[1034]:=",ExpressionUUID->"5d1ca914-ceff-4376-967b-02c9031f7646"],

Cell["\<\
See the end of the notebook for an example of TClassGraphics, after all \
classes have been defined.\
\>", "Text",
 CellChangeTimes->{{3.616245670495942*^9, 3.616245671190029*^9}, {
  3.616432967637373*^9, 
  3.616432992106546*^9}},ExpressionUUID->"8580419c-f005-43c2-a2d0-\
0e8871a26613"]
}, Closed]],

Cell[CellGroupData[{

Cell["Tessellatica rendering functions", "Subsubsection",
 CellChangeTimes->{{3.615295717949704*^9, 3.615295726205234*^9}, {
  3.615300160093411*^9, 3.615300160548274*^9}, {3.615300642447804*^9, 
  3.615300643323958*^9}},ExpressionUUID->"474dba66-9df7-4796-9108-\
2134cf401b5b"],

Cell["\<\
There are a number of functions that can be used to visualize and/or render \
different Tessellatica objects. They are defined further down, but for \
convenience, we summarize them here.\
\>", "Text",
 CellChangeTimes->{{3.615295733078831*^9, 3.615295733542009*^9}, {
  3.6152957710079937`*^9, 
  3.6152958221814404`*^9}},ExpressionUUID->"e951b49b-5b47-4933-a707-\
d275e47527c8"],

Cell[TextData[{
 "GenericGraphGraphics[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] -- This is not a Tessellatica object renderer, but is a useful tool for \
basic rendering of plane graphs."
}], "Text",
 CellChangeTimes->{{3.61529582383694*^9, 
  3.615295881545322*^9}},ExpressionUUID->"59abfee0-7f30-45a9-824e-\
be6612317104"],

Cell[TextData[StyleBox["--Functions that render Tessellatica objects--",
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.615296725100332*^9, 
  3.615296746023983*^9}},ExpressionUUID->"2c9d3bd3-658f-47ca-b813-\
f22e9a939db3"],

Cell[TextData[{
 "GraphGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph, displays vertices, edges, and faces, with numbers and \
labels."
}], "Text",
 CellChangeTimes->{{3.615295885813185*^9, 3.6152959248544393`*^9}, {
  3.615296314085555*^9, 
  3.615296314653298*^9}},ExpressionUUID->"9f6cc207-8a42-49ea-9714-\
b66b64fa8612"],

Cell[TextData[{
 "Graph2DGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D and displays the graph using the alternate embedding \
Vertices2D."
}], "Text",
 CellChangeTimes->{{3.615295968914851*^9, 3.615296032318605*^9}, {
   3.6152963113586283`*^9, 3.6152963123101807`*^9}, {3.615296482551084*^9, 
   3.615296482974477*^9}, 
   3.61529778660121*^9},ExpressionUUID->"9efb714a-b2b5-45e6-a593-\
52c189005ea9"],

Cell[TextData[{
 "FoldAngleGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph3D and displays the graph with the original embedding but \
the edges labeled by its FoldAngles."
}], "Text",
 CellChangeTimes->{{3.615296287200418*^9, 3.615296305465971*^9}, {
   3.615296454993835*^9, 3.615296460503579*^9}, 
   3.615297790863347*^9},ExpressionUUID->"597aee99-3f98-426f-94ab-\
b703efe64efc"],

Cell[TextData[{
 "Graph3DGraphics3D[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph3D and displays the graph using the alternate embedding \
Vertices3D."
}], "Text",
 CellChangeTimes->{{3.615296433042886*^9, 3.615296477465331*^9}, 
   3.615297793054492*^9},ExpressionUUID->"08cc1b0d-7da6-4209-ac7e-\
bc2f8a20b362"],

Cell[TextData[{
 "PrimalDualGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TPrimalDualGraph and displays both the primal and dual graph, \
overlaid or side-by-side."
}], "Text",
 CellChangeTimes->{{3.61529661637204*^9, 
  3.6152966405245447`*^9}},ExpressionUUID->"27ee9ab2-62a4-47b1-8df0-\
17de26c08554"],

Cell[TextData[StyleBox["--Functions that render with symbolic styles--",
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.615296706867209*^9, 3.615296717295474*^9}, {
  3.615296747299773*^9, 
  3.615296748739418*^9}},ExpressionUUID->"8496ce5b-7cd0-4dc5-b206-\
45daca6b07a6"],

Cell[TextData[{
 "CreasePatternGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph+TAssigned and returns a rendering of the crease pattern."
}], "Text",
 CellChangeTimes->{{3.61529680227607*^9, 
  3.615296842681081*^9}},ExpressionUUID->"7cc81c07-9c03-4919-a714-\
9039de1135cb"],

Cell[TextData[{
 "GenericFoldedFormGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a generic rendering of the 2D \
folded form."
}], "Text",
 CellChangeTimes->{{3.615296856055827*^9, 
  3.615296926721043*^9}},ExpressionUUID->"7d7e2ef1-6f7a-4e2b-ad26-\
d64a48e3b9c7"],

Cell[TextData[{
 "VisibleFoldedFormGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a rendering of the 2D folded form \
with hidden line removal (not guaranteed to be exact)."
}], "Text",
 CellChangeTimes->{{3.6152969576608953`*^9, 
  3.615297000101777*^9}},ExpressionUUID->"ffe2509f-a4a1-44a3-96b4-\
86855452760e"],

Cell[TextData[{
 "GenericPairGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a side-by-side pair of the crease \
pattern and folded form to the same scale, using the generic folded form."
}], "Text",
 CellChangeTimes->{{3.615297023221809*^9, 
  3.615297102695401*^9}},ExpressionUUID->"1efd6181-d9e6-4813-944e-\
2ae9d354a8c1"],

Cell[TextData[{
 "VisiblePairGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a side-by-side pair of the crease \
pattern and folded form to the same scale, using the visible folded form \
(with hidden line removal)."
}], "Text",
 CellChangeTimes->{{3.615297085839682*^9, 
  3.615297120889275*^9}},ExpressionUUID->"24d5dff8-a505-42aa-9ff4-\
2695e313b938"],

Cell[TextData[{
 "FoldAngleCreasePatternGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph3D+TAssigned and returns a rendering of the crease pattern \
with fold angles labeled with their numerical values."
}], "Text",
 CellChangeTimes->{{3.617405685050866*^9, 3.617405704018505*^9}, {
  3.6174069366341333`*^9, 
  3.617406940226906*^9}},ExpressionUUID->"cf7334ea-0c83-484f-84d1-\
4da449abc56e"],

Cell[TextData[{
 "FoldedFormGraphics3D[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph3D+TAssigned and returns a rendering of the 3D folded \
form."
}], "Text",
 CellChangeTimes->{{3.61529809192593*^9, 
  3.615298111736735*^9}},ExpressionUUID->"29bd1ecc-d8d4-4f50-bec2-\
8311b6ace0c7"],

Cell[TextData[StyleBox["--Renderers for specialized objects--",
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.615296706867209*^9, 3.615296717295474*^9}, {
  3.615296747299773*^9, 3.615296748739418*^9}, {3.615299627397728*^9, 
  3.6152996389832473`*^9}},ExpressionUUID->"27fcb0e7-2f15-47a7-a75c-\
4d86887c8676"],

Cell[TextData[{
 "LFFGraphGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TLFFGraph and returns a rendering of the local flat foldability \
conditions it represents."
}], "Text",
 CellChangeTimes->{{3.6152981613405247`*^9, 
  3.615298187628585*^9}},ExpressionUUID->"01465e9a-0810-4f7b-a382-\
a31b3ee60ef7"],

Cell[TextData[{
 "VertexCreasePatternGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex and returns a rendering of the vertex crease pattern as a \
circular disk."
}], "Text",
 CellChangeTimes->{{3.615298231241131*^9, 3.615298267669737*^9}, {
  3.615298453593396*^9, 
  3.615298455464239*^9}},ExpressionUUID->"4e0a8310-2b57-45cc-947e-\
9c3cba397d0b"],

Cell[TextData[{
 "VertexGenericFoldedFormGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex and returns a generic rendering of the folded form  (no \
hidden line removal) as a folded circular disk."
}], "Text",
 CellChangeTimes->{{3.61529829858498*^9, 
  3.615298338699778*^9}},ExpressionUUID->"186042ce-c54c-4ac2-98a8-\
e25b0270b468"],

Cell[TextData[{
 "Vertex3DCreasePatternGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex3D and returns a rendering of the crease pattern as a \
circular disk."
}], "Text",
 CellChangeTimes->{{3.615298436472993*^9, 
  3.615298460374992*^9}},ExpressionUUID->"5046e649-bca0-454d-86e7-\
a2f034cd33d3"],

Cell[TextData[{
 "Vertex3DFoldedFormGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex3D and returns a rendering of the 3D folded form as a \
folded circular disk."
}], "Text",
 CellChangeTimes->{{3.615298469653619*^9, 
  3.6152985079732428`*^9}},ExpressionUUID->"460dddd3-1466-41a3-ae28-\
d0b17ba91f5d"],

Cell[TextData[{
 "Vertex3DGaussianSphereGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex3D and returns a rendering of the Gaussian sphere."
}], "Text",
 CellChangeTimes->{{3.615298492413096*^9, 
  3.615298504822147*^9}},ExpressionUUID->"869a2e28-ff07-4d86-9789-\
02707fbdb446"],

Cell[TextData[{
 "Vertex3DGraphicsTrio[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex3D and returns a GraphicsRow of all three renderings: \
crease pattern, folded form, and Gaussian sphere."
}], "Text",
 CellChangeTimes->{{3.615298518194036*^9, 
  3.6152985632570353`*^9}},ExpressionUUID->"d310daa3-2efa-4aea-a6cd-\
f26292677203"],

Cell[TextData[{
 "Degree4Vertex3DCreasePatternGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TDegree4Vertex3D and returns a rendering of the crease pattern as \
a circular disk."
}], "Text",
 CellChangeTimes->{{3.615298590772019*^9, 
  3.615298613413506*^9}},ExpressionUUID->"7c8c1177-f296-4a1f-ba24-\
2f7d779e549a"],

Cell[TextData[{
 "Degree4Vertex3DFoldedFormGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TDegree4Vertex3D and returns a rendering of the 3D folded form as \
a circular disk, along with additional relevant vectors and planes."
}], "Text",
 CellChangeTimes->{
  3.615298622459605*^9, {3.615298787007267*^9, 
   3.615298807428653*^9}},ExpressionUUID->"d732fb07-d9bf-4f56-a993-\
857d226c3bb3"],

