Cell[CellGroupData[{

Cell[TextData[{
 "GetMergedEdges[",
 StyleBox["elist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.7078242175916567`*^9, 3.7078242330408916`*^9}, 
   3.70782480325981*^9},ExpressionUUID->"065fbf44-93de-4fd1-ae38-\
6ecbdf89ed5b"],

Cell[TextData[{
 "GetMergedEdges[",
 StyleBox["elist",
  FontSlant->"Italic"],
 "] gives a list of the indices of the edges in the new graph that were \
merged by MergeGraphsWithData."
}], "Text",
 CellChangeTimes->{{3.707824227392386*^9, 3.70782429002512*^9}, {
   3.707824803291894*^9, 3.707824838357915*^9}, 
   3.70786793214162*^9},ExpressionUUID->"f857e56c-2353-4d67-b27e-\
3b09fce070f0"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["elist",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 StyleBox["elist",
  FontSlant->"Italic"],
 " returned by MergeGraphsData."
}], "Text",
 CellChangeTimes->{{3.707824297753165*^9, 3.707824312185322*^9}, 
   3.707867932226156*^9, 3.707904369432616*^9, 
   3.7079051284173203`*^9},ExpressionUUID->"95db16a3-283e-4db6-82a7-\
7199502c3124"],

Cell["\<\
Returns: a list of the indices of the edges in the new graph that resulted \
from merging of edges in subgraphs. Note that if you set KillMergedEdges \
\[Rule] True, this will be an empty list.\
\>", "Text",
 CellChangeTimes->{{3.707824314704489*^9, 3.7078243596496973`*^9}, {
  3.707824845285912*^9, 
  3.707824874534258*^9}},ExpressionUUID->"0692116a-2eb7-48b8-88fc-\
b6775ea41a68"],

Cell[TextData[{
 "We construct this list by looking for edges of multiplicity 2 in ",
 StyleBox["elist",
  FontSlant->"Italic"],
 ", so if your merge set included an ill-formed graph with doubled edges, the \
results of this will be spurious."
}], "Text",
 CellChangeTimes->{{3.707824363128642*^9, 3.707824402626256*^9}, {
  3.707824893740906*^9, 
  3.707824894590453*^9}},ExpressionUUID->"1d440a9b-9d20-4620-b1a9-\
d1560abf8702"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetMergedEdges", "[", "elist_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fe", ",", "ne"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fe", "=", 
      RowBox[{"Flatten", "[", "elist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ne", "=", 
      RowBox[{"Max", "[", "fe", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"First", "/@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Count", "[", 
             RowBox[{"fe", ",", "i"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "ne"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           "\[Equal]", "2"}], "&"}]}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707824404258332*^9, 3.707824443258462*^9}, {
   3.7078245663079*^9, 3.707824655324819*^9}, 3.707824717822166*^9, 
   3.707824803310186*^9},
 CellLabel->
  "In[1232]:=",ExpressionUUID->"cd3ed1c0-db08-4c70-88cb-656925eb4e6c"],

