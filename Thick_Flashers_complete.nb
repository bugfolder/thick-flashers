Cell["Tetrahedron properties from four vertices", "Subsection",
 CellChangeTimes->{{3.595977741051002*^9, 3.595977755555585*^9}, {
  3.7012702409462347`*^9, 3.701270260240948*^9}, {3.768662155605296*^9, 
