              RowBox[{"nx", "[", "0", "]"}], ",", 
              RowBox[{"ny", "[", "0", "]"}], ",", 
              RowBox[{"nz", "[", "0", "]"}]}], "}"}], "\[Equal]", "in"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
