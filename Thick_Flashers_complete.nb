Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Oval", "::", "badrad"}], 
   "=", "\"\<You cannot specify different radii `1` for an oval with the same \
points `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.736508346973381*^9, 3.736508407629508*^9}, {
  3.736513672516187*^9, 3.736513680954157*^9}},
 CellLabel->
  "In[806]:=",ExpressionUUID->"f678d5d7-c2bf-4e10-ad69-274c25660a3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Oval", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_List", ",", "q_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"rp_", ",", "rq_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Phi]", ",", "pq", ",", "dr", ",", "\[Psi]", ",", "fp1", ",", "fp2", ",",
       "fq1", ",", "fq2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"p", "\[Equal]", "q"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"rp", "\[Equal]", "rq"}], ",", 
        RowBox[{"Circle", "[", 
         RowBox[{"p", ",", "rp"}], "]"}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"Oval", "::", "badrad"}], ",", 
           RowBox[{"{", 
            RowBox[{"rp", ",", "rq"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}]}], "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"pq", "=", 
        RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Phi]", "=", 
        RowBox[{"ArcTan", "@@", "pq"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dr", "=", 
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", 
         RowBox[{"Normalize", "[", "pq", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Psi]", "=", 
        RowBox[{"ArcSin", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"rq", "-", "rp"}], ")"}], "/", 
          RowBox[{"Mag", "[", "pq", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fp1", "=", 
        RowBox[{"\[Phi]", "+", 
         RowBox[{"\[Pi]", "/", "2"}], "+", "\[Psi]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fp2", "=", 
        RowBox[{"\[Phi]", "+", 
         RowBox[{"3", 
          RowBox[{"\[Pi]", "/", "2"}]}], "-", "\[Psi]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fq1", "=", 
        RowBox[{"\[Phi]", "-", 
         RowBox[{"\[Pi]", "/", "2"}], "-", "\[Psi]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fq2", "=", 
        RowBox[{"\[Phi]", "+", 
         RowBox[{"\[Pi]", "/", "2"}], "+", "\[Psi]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "+", 
             RowBox[{"rp", " ", 
              RowBox[{"U", "[", "fp2", "]"}]}]}], ",", 
            RowBox[{"q", "+", 
             RowBox[{"rq", " ", 
              RowBox[{"U", "[", "fq1", "]"}]}]}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "+", 
             RowBox[{"rp", " ", 
              RowBox[{"U", "[", "fp1", "]"}]}]}], ",", 
            RowBox[{"q", "+", 
             RowBox[{"rq", " ", 
              RowBox[{"U", "[", "fq2", "]"}]}]}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Circle", "[", 
          RowBox[{"p", ",", "rp", ",", 
           RowBox[{"{", 
            RowBox[{"fp1", ",", "fp2"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Circle", "[", 
          RowBox[{"q", ",", "rq", ",", 
           RowBox[{"{", 
            RowBox[{"fq1", ",", "fq2"}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.735211027058908*^9, 3.735211091752386*^9}, {
  3.735211278759076*^9, 3.735211553990677*^9}, {3.7365083113526287`*^9, 
  3.736508313583592*^9}, {3.736513640460574*^9, 3.73651391659315*^9}, {
