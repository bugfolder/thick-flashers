Cell["An algebraic description for a degree-4 vertex.", "Text",
 CellChangeTimes->{{3.533751017753148*^9, 
  3.533751042270004*^9}},ExpressionUUID->"e3ac692f-f72a-416f-ba9c-\
b2f1f4132248"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UnnormalizedFlatFoldabilityCondition", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        SubscriptBox["y", "1"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "2"], ",", 
        SubscriptBox["y", "2"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "3"], ",", 
        SubscriptBox["y", "3"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "4"], ",", 
        SubscriptBox["y", "4"]}], "}"}]}], "}"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{3.533751034062852*^9, 3.595805833951676*^9, 
  3.595982676479221*^9},
 CellLabel->
  "In[578]:=",ExpressionUUID->"97385f91-b68d-4c2e-acfd-fa13ecc9f3e3"],

Cell[TextData[{
 "Example: Set up a degree-4 vertex and solve for the position of the last \
point (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "4"], TraditionalForm]],ExpressionUUID->
  "f45feaf6-8981-4a66-8fb0-61f7283325b0"],
 ")."
}], "Text",ExpressionUUID->"c98e0c56-c5c4-4aea-9cb8-7e51573092c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p0", "=", 
       RowBox[{"{", 
        RowBox[{"10", ",", "0"}], "}"}]}], ",", 
      RowBox[{"p1", "=", 
       RowBox[{"{", 
        RowBox[{"11", ",", "0"}], "}"}]}], ",", 
      RowBox[{"p2", "=", 
       RowBox[{"{", 
        RowBox[{"10.5", ",", "1"}], "}"}]}], ",", 
      RowBox[{"p3", "=", 
       RowBox[{"{", 
        RowBox[{"9", ",", 
         RowBox[{"-", ".2"}]}], "}"}]}], ",", "p4", ",", "x4", ",", "y4", ",",
       "ke", ",", "soln", ",", "gg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p4", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "+", "x4"}], ",", "y4"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ke", "=", 
      RowBox[{"UnnormalizedFlatFoldabilityCondition", "[", 
       RowBox[{"p0", ",", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ke", "\[Equal]", "0"}], ",", 
           RowBox[{"y4", "\[Equal]", 
            RowBox[{"-", ".8"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x4", ",", "y4"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Gray", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"p0", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], ",", "Red", ",", 
         " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"p0", ",", "p4"}], "}"}], "]"}], ",", "Black", ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p0\>\"", ",", "p0"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p1\>\"", ",", "p1"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p2\>\"", ",", "p2"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p3\>\"", ",", "p3"}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p4\>\"", ",", "p4"}], "]"}]}], "}"}], "/.", "soln"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"gg", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4640170950827*^9, 3.464017147180792*^9}, {
   3.53360148269774*^9, 3.5336014922097597`*^9}, {3.5336016144915657`*^9, 
   3.533601638785798*^9}, 3.533601720355587*^9, 3.53360177269076*^9, {
