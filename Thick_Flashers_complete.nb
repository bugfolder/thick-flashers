Cell[CellGroupData[{

Cell["Polygon offset twist tiles", "Subsection",
 CellChangeTimes->{{3.6298371710836697`*^9, 3.6298371859791117`*^9}, 
   3.6301115516007776`*^9},ExpressionUUID->"3ce42185-4495-4968-8ba4-\
5df68f067925"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457721595250703*^9, 3.457721598296111*^9}, 
   3.627385975877822*^9},ExpressionUUID->"ad257366-f8fb-4d2c-8b9f-\
70c28cfaba27"],

Cell["\<\
This section contains functions that build and investigate a second class of \
tileable twists in twist-tileable polygons: offset twists, where the pleats \
meet the tile edges perpendicularly at a specified offset from the midpoint. \
This algorithm does not work for all circumscribable polygons, but it does \
work for all regular polygons, all triangles, and a few other shapes (cyclic \
Brocard polygons).\
\>", "Text",
 CellChangeTimes->{{3.457722143566229*^9, 3.457722149825455*^9}, {
   3.592170756259306*^9, 3.592170780589327*^9}, {3.627340353624976*^9, 
   3.627340429395031*^9}, {3.627340573495729*^9, 3.627340598672606*^9}, {
   3.6273447443116837`*^9, 3.627344745478757*^9}, 3.6273858717470713`*^9, 
   3.6273859758785768`*^9, {3.627393583726396*^9, 3.627393623322542*^9}, {
   3.627393696797831*^9, 3.627393711214216*^9}, {3.627395818694468*^9, 
   3.627395839731363*^9}, 3.627395886385439*^9, {3.62739605203869*^9, 
   3.627396062982171*^9}, {3.627396115755378*^9, 3.6273961386813307`*^9}, {
   3.62739984388841*^9, 3.6273998490901966`*^9}, {3.629977648602025*^9, 
   3.629977653490453*^9}, {3.707838768971392*^9, 
   3.707838774410801*^9}},ExpressionUUID->"855b6107-e90c-40aa-8303-\
fa60d92cc231"],

Cell[TextData[{
 "In this case, the twist is parameterized by the fractional length of the \
edge subtended by the pleat (",
 StyleBox["w",
  FontSlant->"Italic"],
 ") and by the offset (",
 StyleBox["d",
  FontSlant->"Italic"],
 ") from the midpoint of the edge. Both distances are normalized to each edge \
length."
}], "Text",
 CellChangeTimes->{{3.627393713475754*^9, 3.627393780584299*^9}, {
  3.6299776690987263`*^9, 
  3.6299776720634546`*^9}},ExpressionUUID->"99a40f80-41f6-45a5-bcb2-\
5120818c9245"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "{PolygonOffsetTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.629825581181041*^9, 3.62982559509096*^9}, {
  3.629825719482769*^9, 3.629825801430343*^9}, {3.629825855794893*^9, 
  3.629825863308705*^9}, {3.629837261247677*^9, 
  3.629837284860346*^9}},ExpressionUUID->"894c7341-e94d-4cc4-8ca0-\
ca07dd932a61"],

Cell[TextData[{
 "{PolygonOffsetTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} is a tiletype that describes a simple flat twist in a specified polygon \
where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the offset from the center of the edge, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
   3.457740055563382*^9}, {3.457899240889505*^9, 3.457899262921368*^9}, {
