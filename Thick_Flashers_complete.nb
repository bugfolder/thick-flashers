Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherCylindricallySafeInsetEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.933677536743046*^9, 3.93367755716045*^9}, {
  3.9340593468441133`*^9, 3.9340593535497*^9}, {3.934059389235003*^9, 
  3.934059415897649*^9}},ExpressionUUID->"fb7c1885-2255-4a04-9a93-\
d0bc0f9e50cf"],

Cell[TextData[{
 "ThickFlasherCylindricallySafeInsetEdges[{",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] returns lists of all edges of a thick flasher with their endpoints inset \
to such a distance that cylinders of radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 " placed on the inset edges of any face may touch but do not overlap \
cylinders on the other edges of that face. In addition, the cylinders along \
minor folds (the radial up/down zigzag folds) are further inset so that they \
do not extend outside of the surface of their incident panels, which prevents \
adjacent cylinders from intersecting."
}], "Text",
 CellChangeTimes->{{3.933677636284141*^9, 3.933677732776669*^9}, {
  3.934047716171544*^9, 3.934047747403491*^9}, {3.9340593950204067`*^9, 
  3.9340594040855103`*^9}, {3.934059461462875*^9, 3.9340594742216167`*^9}, {
  3.934060225711728*^9, 3.9340602904477777`*^9}, {3.9347287852208633`*^9, 
  3.934728788922338*^9}},ExpressionUUID->"e93ed793-820a-46ac-9157-\
3705acefb1d5"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a flasher (output of MakeThickFlasher) whose stowed and \
deployed forms (3D forms) will be used to construct the inset edges.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the desired cylindrical radius."
}], "Text",
 CellChangeTimes->{{3.933681269102754*^9, 3.93368133063056*^9}, {
  3.934059482457271*^9, 
  3.934059507858778*^9}},ExpressionUUID->"6c987003-0231-4650-965a-\
15b7e53b26fd"],

Cell[TextData[{
 "Return: two lists {",
 StyleBox["sedges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dedges",
  FontSlant->"Italic"],
 "} of edge point pairs for the inset edges, in the same order as the Edges \
property of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", where\n\t",
 StyleBox["sedges",
  FontSlant->"Italic"],
 " are the edges of the stowed form, and\n\t",
 StyleBox["dedges",
  FontSlant->"Italic"],
 " are the edges of the deployed form."
}], "Text",
 CellChangeTimes->{{3.9336813520901947`*^9, 3.933681376606018*^9}, {
  3.934059522710228*^9, 
  3.934059581550273*^9}},ExpressionUUID->"58c1275e-55b8-4ecb-af90-\
cebbce83cdf1"],

Cell["\<\
Note that the TObj returned by MakeThickFlasher describes the stowed form, \
but contains a TObj that describes the deployed pattern. We make use of both \
of these in our construction.\
\>", "Text",
 CellChangeTimes->{{3.9340475314506187`*^9, 3.9340475558350058`*^9}, {
  3.93405959770647*^9, 
  3.934059642551331*^9}},ExpressionUUID->"47ae8797-db11-4fb6-a44b-\
d6cce0191ea0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ThickFlasherCylindricallySafeInsetEdges", "::", "baddists"}], 
   "=", "\"\<There is not enough room in edge `1` (and possibly others) for a \
cylinder that satisfies the safe conditions.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9341082227696543`*^9, 3.9341082617214813`*^9}, {
  3.934108358741091*^9, 3.9341083616207933`*^9}},
 CellLabel->
  "In[4506]:=",ExpressionUUID->"d7330dce-084a-424c-a4c5-84305fdff107"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherCylindricallySafeInsetEdges", "[", 
   RowBox[{"tobj_", ",", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts3d", ",", "edges", ",", "faces", ",", "vertsdp", ",", "eva", ",", 
      "edists", ",", "edirs", ",", "edirsdp", ",", "eedges", ",", "eedgesdp", 
      ",", "cface", ",", "bedges", ",", "re", ",", "\[Beta]", ",", "s", ",", 
      "sedges", ",", "dedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "edges", ",", "faces", ",", "vertsdp"}], "}"}],
       "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices3D", ",", "Edges", ",", "Faces", ",", "FlasherVerticesDP"}],
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eva", "=", 
      RowBox[{"EdgeVertexAngles3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Inset", " ", "distances", " ", "for", " ", "all", " ", "edges", " ", 
       "to", " ", "not", " ", "collide", " ", "with", " ", "other", " ", 
       "cylinders", " ", "on", " ", "the", " ", "same", " ", 
       RowBox[{"polygon", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"edists", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"r", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}], ",", 
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}]}], "]"}], ",", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}], ",", 
             RowBox[{"Cot", "[", 
              FractionBox[
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "2"], 
              "]"}]}], "]"}]}], "}"}]}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{"eva", "/.", 
         RowBox[{"Null", "->", "\[Pi]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Original", " ", "edges", " ", "before", " ", "insetting"}], ",",
        " ", 
       RowBox[{"stowed", " ", "form"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"eedges", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edge", " ", "direction", " ", "vectors"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"edirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{"-", 
          RowBox[{"Subtract", "@@", "#"}]}], "]"}], "&"}], "/@", "eedges"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Original", " ", "edges", " ", "before", " ", "insetting"}], ",",
        " ", 
       RowBox[{"deployed", " ", "form"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"eedgesdp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "vertsdp", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edge", " ", "direction", " ", "vectors"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"edirsdp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{"-", 
          RowBox[{"Subtract", "@@", "#"}]}], "]"}], "&"}], "/@", 
       "eedgesdp"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Go", " ", "through", " ", "all", " ", "edges", " ", "and", " ", 
        "find", " ", "the", " ", "stowed"}], "-", 
       RowBox[{"form", " ", "near"}], "-", 
       RowBox[{"vertical", " ", "minor", " ", "fold", " ", 
        RowBox[{"edges", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cface", "=", 
      RowBox[{"faces", "\[LeftDoubleBracket]", 
       RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"central", " ", "polygon", " ", "face"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"bedges", "=", 
      RowBox[{"tobj", "[", "BoundaryEdges", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Ignore", " ", "edges", " ", "that", " ", "are", " ", "not", " ", 
        "nearly", " ", "vertical", " ", "in", " ", "the", " ", "stowed", " ", 
        "form"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"edirs", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}], "]"}], "<", 
           "0.866"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Ignore", " ", "edges", " ", "that", " ", "are", " ", "on", " ", 
          "the", " ", "boundary"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"bedges", ",", "i"}], "]"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Vector", " ", "along", " ", "the", " ", "diagonal"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"re", "=", 
         RowBox[{"Subtract", "@@", 
          RowBox[{
          "eedges", "\[LeftDoubleBracket]", "i", 
           "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Save", " ", "distance", " ", "to", " ", "inset"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"s", "=", 
         RowBox[{"r", " ", 
          RowBox[{"Abs", "[", 
           FractionBox[
            RowBox[{
            "re", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
            RowBox[{"Mag", "[", 
             RowBox[{"re", "\[LeftDoubleBracket]", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}], 
             "]"}]], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Take", " ", "safe", " ", "distance", " ", "into", " ", 
          RowBox[{"account", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"edists", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"edists", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"cface", ",", 
               RowBox[{"edges", "\[LeftDoubleBracket]", 
                RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], ",",
              "0", ",", "s"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"edists", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"edists", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"cface", ",", 
               RowBox[{"edges", "\[LeftDoubleBracket]", 
                RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}], ",",
              "0", ",", "s"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Plus", "@@", 
            RowBox[{
            "edists", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}], ">=", 
           RowBox[{"Mag", "[", "re", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{
             "ThickFlasherCylindricallySafeInsetEdges", "::", "baddists"}], ",",
              "i"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sedges", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
            RowBox[{
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ",
              "#3"}]}], ",", 
           RowBox[{
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
            RowBox[{
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], " ",
              "#3"}]}]}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"eedges", ",", "edists", ",", "edirs"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dedges", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
            RowBox[{
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ",
              "#3"}]}], ",", 
           RowBox[{
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
            RowBox[{
             RowBox[{
             "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], " ",
              "#3"}]}]}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"eedgesdp", ",", "edists", ",", "edirsdp"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"sedges", ",", "dedges"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.933678514937114*^9, 3.933678525056176*^9}, {
