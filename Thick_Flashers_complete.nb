Cell[TextData[{
 "NRecoverCurve3DSystemOld[{\[Kappa], \[Tau]}",
 StyleBox[",v, opts",
  FontSlant->"Italic"],
 "] constructs a 3D arbitrary-speed curve from its curvature,  torsion, and \
curve speed."
}], "Text",
