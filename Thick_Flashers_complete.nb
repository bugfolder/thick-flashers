   3.594982084533354*^9},
 CellLabel->
  "In[2335]:=",ExpressionUUID->"6f4ff2a9-e6f3-430a-af20-fa83d17bc685"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFoldVectorsFromSubarcs", "[", 
   RowBox[{
   "g4_List", ",", "g2_List", ",", "s3_", ",", "s4_", ",", "\[Rho]_", ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ovn", ",", "ss", ",", "s1", ",", "s2", ",", "qq", ",", "a1", ",", "a2", 
      ",", "a3", ",", "a4", ",", "g1", ",", "g3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ovn", "=", 
      RowBox[{
       RowBox[{"OsculatingVectorNear", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeFoldVectorsFromSubarcs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"Sign", "[", "s3", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ss", "\[NotEqual]", 
        RowBox[{"Sign", "[", "s4", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeFoldVectorsFromSubarcs", "::", "badsubs"}], ",", "s3", 
          ",", "s4"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"s1", "=", 
      RowBox[{"2", " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"\[Rho]", " ", 
         RowBox[{"Tan", "[", 
          RowBox[{"s3", "/", "2"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s2", "=", 
      RowBox[{"2", " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"\[Rho]", " ", 
         RowBox[{"Tan", "[", 
          RowBox[{"s4", "/", "2"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qq", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"g2", "\[Cross]", "g4"}], "]"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", 
         RowBox[{"(", 
          RowBox[{"ovn", "===", "None"}], ")"}]}], "&&", 
        RowBox[{
         RowBox[{"qq", ".", "ovn"}], "<", "0"}]}], ",", 
       RowBox[{"qq", "=", 
        RowBox[{"-", "qq"}]}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"osculating", " ", "vector"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{
       RowBox[{"RotationMatrix3Du", "[", 
        RowBox[{
         RowBox[{"-", "s1"}], ",", "g2"}], "]"}], ".", "qq"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "normal", " ", "vectors"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{
       RowBox[{"RotationMatrix3Du", "[", 
        RowBox[{
         RowBox[{"+", "s2"}], ",", "g2"}], "]"}], ".", "qq"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a3", "=", 
      RowBox[{
       RowBox[{"RotationMatrix3Du", "[", 
        RowBox[{
         RowBox[{"-", "s3"}], ",", "g4"}], "]"}], ".", "qq"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a4", "=", 
      RowBox[{
       RowBox[{"RotationMatrix3Du", "[", 
        RowBox[{
         RowBox[{"+", "s4"}], ",", "g4"}], "]"}], ".", "qq"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g1", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"a4", "\[Cross]", "a1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"g3", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"a3", "\[Cross]", "a2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"g1", ".", "qq"}], "*", "ss"}], "<", "0"}], ",", 
       RowBox[{
        RowBox[{"g1", "=", 
         RowBox[{"-", "g1"}]}], ";", 
        RowBox[{"g3", "=", 
         RowBox[{"-", "g3"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g2", ",", "g3", ",", "g4"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.441374498294476*^9, 3.441374591758034*^9}, {
   3.441374676011215*^9, 3.441374677686656*^9}, {3.441374773911768*^9, 
