Cell[CellGroupData[{

Cell[TextData[{
 "AddShadow[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ShadowHeight, ShadowOffset, ShadowColor"
}], "Subsubsection",
 CellChangeTimes->{{3.803895148180743*^9, 3.803895154052952*^9}, 
   3.803895276640499*^9},ExpressionUUID->"501f2a93-7674-477f-987c-\
016880ae1b4e"],

Cell[TextData[{
 "AddShadow[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a Graphics3D object and adds a shadow to it."
}], "Text",
 CellChangeTimes->{{3.689267538316017*^9, 3.689267564397023*^9}, {
   3.691520750020528*^9, 3.6915207515371456`*^9}, 3.691521241291294*^9, {
   3.69152221247637*^9, 3.69152221707017*^9}, 3.803860465597093*^9, 
   3.803895109567462*^9, {3.803895177630804*^9, 
   3.8038951944692283`*^9}},ExpressionUUID->"0a799a8e-e6b4-45b4-9761-\
4ec7700c941f"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any expression containing Graphics3D elements."
}], "Text",
 CellChangeTimes->{{3.801743134318005*^9, 
  3.8017431479180937`*^9}},ExpressionUUID->"39478daf-171f-4848-a99f-\
fe498f047de1"],

Cell[TextData[{
 "Options:\n\tShadowHeight \[Rule] Automatic | ",
 StyleBox["z",
  FontSlant->"Italic"],
 ", where Automatic is at the lowest point of the object, or ",
 StyleBox["z",
  FontSlant->"Italic"],
 " is the absolute z-coordinate of the shadow.\n\tShadowOffset \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", where if ShadowHeight \[Rule] Automatic, the shadow is placed a distance \
h below the lowest point of the object. This is ignored if ShadowHeight is \
given as an explicit value.\n\tShadowColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", the desired shadow color."
}], "Text",
 CellChangeTimes->{{3.801743151261394*^9, 3.801743185797911*^9}, {
  3.801743698433593*^9, 3.801743738496634*^9}, {3.801743793562127*^9, 
  3.801743825897606*^9}, {3.803404752413772*^9, 3.803404806911427*^9}, {
  3.803404927909718*^9, 
  3.8034050469262753`*^9}},ExpressionUUID->"c2fc9c08-3d49-4af7-b163-\
712bbe88055e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddShadow", "[", 
   RowBox[{"expr_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"expr", ",", 
    RowBox[{"MakeShadow", "[", 
     RowBox[{"expr", ",", "opts"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.803895242620236*^9, 3.803895265430484*^9}},
 CellLabel->
  "In[1597]:=",ExpressionUUID->"3881c044-f3f5-4047-a843-22fb7020a50d"],

Cell["Example. Combining Line and Polygon properly.", "Text",
 CellChangeTimes->{{3.689266971464262*^9, 3.689266972216762*^9}, 
   3.689267613334561*^9, {3.689267778077717*^9, 3.689267855679696*^9}, {
   3.691521981145679*^9, 
   3.691521987363039*^9}},ExpressionUUID->"7ece1339-70c0-4544-83e1-\
fc08369baabc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "g", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"g", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", ".7"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"-", ".2"}], ",", 
               RowBox[{"-", ".1"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", ".7"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".2", ",", ".2", ",", "1"}], "}"}]}], "}"}], "]"}], ",",
           "Red", ",", 
          RowBox[{"Thickness", "[", ".02", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Arrow", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", ".1", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
          "Purple", ",", 
          RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Arrow", "[", 
           RowBox[{"Tube", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{".1", ",", "1", ",", "1"}], "}"}]}], "}"}], ",", 
             ".01"}], "]"}], "]"}], ",", "Orange"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Polygon", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{".25", ",", ".25", ",", ".3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".75", ",", ".25", ",", ".3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".75", ",", ".75", ",", ".3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".25", ",", ".75", ",", ".3"}], "}"}]}], "}"}], "]"}], ",",
           "Green"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Polygon", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{".2", ",", ".2", ",", ".5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".5", ",", ".2", ",", ".5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".5", ",", ".5", ",", ".5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{".2", ",", ".5", ",", ".5"}], "}"}]}], "}"}], "]"}], ",",
           "Blue"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Graphics3D", "[", "g", "]"}], ",", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"g", "//", "AddShadow"}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.68926697935979*^9, 3.689267006540203*^9}, {
   3.6892670730791388`*^9, 3.6892672196942577`*^9}, {3.68926730320019*^9, 
   3.689267303478112*^9}, {3.689267620153936*^9, 3.6892676203157988`*^9}, {
   3.689267865111297*^9, 3.689267976571247*^9}, {3.691522277429696*^9, 
   3.691522277687757*^9}, {3.801743629859026*^9, 3.801743636561471*^9}, 
   3.803860465632956*^9, 3.803895109596775*^9, {3.8038952995763817`*^9, 
   3.80389532663151*^9}, {3.803899890614848*^9, 3.8038999939894533`*^9}, {
   3.803900121505694*^9, 3.803900138839649*^9}, {3.803900429397649*^9, 
   3.803900461090716*^9}},
 CellLabel->
  "In[1598]:=",ExpressionUUID->"cf6e3530-ee16-4ecc-9afc-5ead24f9f86d"],

Cell["\<\
Example with symbolic styles and an explicit height for the shadow.\
\>", "Text",
 CellChangeTimes->{{3.68926811256469*^9, 3.6892681220967007`*^9}, {
  3.803405210280101*^9, 3.803405216847342*^9}, {3.803405576905817*^9, 
