  RowBox[{"UnitRegularPolygonOffsetTwistSelfContainedQ", "[", 
   RowBox[{"n", ",", "w", ",", 
    RowBox[{"UnitRegularPolygonOffsetTwistOffset", "[", 
     RowBox[{"n", ",", "w", ",", "\[Alpha]"}], "]"}], ",", "types"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627339676906046*^9, 3.627339676974412*^9}, 
