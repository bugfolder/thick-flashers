Cell[CellGroupData[{

Cell[TextData[{
 "RecoverCurve2DSystem[ ds, ",
 StyleBox["\[Kappa]l",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{{3.799450734497087*^9, 3.7994507924117813`*^9}, {
   3.799450861994305*^9, 3.799450863762088*^9}, 3.799486751390749*^9, {
   3.7994869033805637`*^9, 3.799486903959707*^9}, {3.799488248798555*^9, 
   3.799488251660326*^9}, 3.79949087416238*^9, 3.79949120779502*^9, 
   3.800464764774039*^9, 
   3.801317328135311*^9},ExpressionUUID->"27eeba88-7bf8-4a61-84ab-\
7d1d6e662cb1"],

Cell[TextData[{
 "RecoverCurve2DSystem[ds, \[Kappa]l, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, opts] creates a 2D curve given specified curve speed and geodesic (left) \
torsion."
}], "Text",
 CellChangeTimes->{{3.799450814768171*^9, 3.799450834873296*^9}, 
   3.799450948450263*^9, {3.799487251233275*^9, 3.799487268270891*^9}, 
   3.799488256339861*^9, 3.799490874174435*^9, 3.799491207808449*^9, 
   3.80046476625318*^9, 
   3.8013173281614*^9},ExpressionUUID->"4c6e3c1e-a296-4a98-9960-90baa4e87c95"],

Cell[TextData[{
 "Arguments:\n\tds \[LongDash] the curve speed as a pure function.\n\t\
\[Kappa]l \[LongDash] the left (geodesic) curvature as a pure function.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the curve parameter.\n\t",
 StyleBox["ci",
  FontSlant->"Italic"],
 " \[LongDash] initial position of the curve.\n\t",
 StyleBox["ti",
  FontSlant->"Italic"],
 " \[LongDash] initial tangent of the curve."
}], "Text",
 CellChangeTimes->{{3.799450839250968*^9, 3.79945091913232*^9}, 
   3.799491207821637*^9, {3.799597266993869*^9, 3.799597270417963*^9}, 
   3.801317328187601*^9},ExpressionUUID->"6b9f6cae-0543-447c-8642-\
78a207756113"],

Cell["\<\
Returns: a list of rules giving pure functions for vector and scalar fields \
of the plane curve.\
\>", "Text",
 CellChangeTimes->{{3.691235076966158*^9, 3.69123508636825*^9}, {
  3.7994910425414963`*^9, 
  3.799491067334595*^9}},ExpressionUUID->"f150be27-55c6-4673-bcd4-\
ce4106a10073"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RecoverCurve2DSystem", "::", "nosoln"}], 
   "=", "\"\<DSolve couldn't integrate the 2D curve equations.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.7994871182869396`*^9, 
   3.79948714206791*^9}, 3.7994882597419653`*^9, 3.799490874181484*^9, 
   3.8004647675032997`*^9},
 CellLabel->
