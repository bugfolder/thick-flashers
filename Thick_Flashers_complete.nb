Cell[TextData[{
 "MakeTwistTube[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dir}, nh",
  FontSlant->"Italic"],
 "] returns a TGraph3D+TAssigned+TCornerIndices that represents a twist tube \
defined by a list of parameters where\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " is the rotational order of the tube\n\t",
 StyleBox["h1",
  FontSlant->"Italic"],
 " specifies one stable height for that level\n\t",
 StyleBox["h2",
  FontSlant->"Italic"],
 " specifies the second stable height, which is the one used for the folded \
form\n\t",
 StyleBox["dir",
  FontSlant->"Italic"],
 " = \[PlusMinus]1 specifies the desired direction of twist\n\t",
 StyleBox["nh",
  FontSlant->"Italic"],
 " is the number of repetitions."
}], "Text",
 CellChangeTimes->{{3.643365811242515*^9, 3.643365838269869*^9}, {
  3.6433658820514407`*^9, 3.643365992035451*^9}, {3.643368479880849*^9, 
  3.6433684823694897`*^9}, {3.643373048038538*^9, 
  3.643373079939866*^9}},ExpressionUUID->"c8b94f50-ced0-43b9-b8af-\
70632a0a1b66"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTwistTube", "[", 
   RowBox[{"m_", ",", 
    RowBox[{"{", 
     RowBox[{"h1_", ",", "h2_", ",", "dir_"}], "}"}], ",", "nh_"}], "]"}], ":=", 
  RowBox[{"MakeTwistTube", "[", 
   RowBox[{"m", ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"h1", ",", "h2", ",", "dir"}], "}"}], ",", 
      RowBox[{"{", "nh", "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.643373101482759*^9, 3.643373120849999*^9}, {
  3.64337321484342*^9, 3.643373258849182*^9}},
 CellLabel->
  "In[2576]:=",ExpressionUUID->"0745eb95-5147-45be-955a-5d1cdb617821"],

