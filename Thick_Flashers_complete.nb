655d6ffab7fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "f", ",", "ff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "t", "]"}], ",", 
          RowBox[{"Sin", "[", "t", "]"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Planarize", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "ff", "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799330215241061*^9, 3.799330266624402*^9}, 
   3.799330611414932*^9, {3.799330884159268*^9, 3.799330918925889*^9}, 
   3.79933118321233*^9, 3.799337726886561*^9, 3.799338103803021*^9, 
   3.801733050174241*^9},
 CellLabel->
  "In[3844]:=",ExpressionUUID->"70820dba-2895-49fa-83eb-0184d7fb773e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Unplanarize[",
 StyleBox["fn",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.799330988103135*^9, 
  3.799330993885478*^9}},ExpressionUUID->"73f92286-5fdc-4189-b4a9-\
eba3d1afde5f"],

Cell[TextData[{
 "Unplanarize[",
 StyleBox["fn",
  FontSlant->"Italic"],
 "] takes a pure function that returns a list of length 3 and returns the \
pure function that results from dropping the 3rd value in the  list."
}], "Text",
 CellChangeTimes->{{3.799337448281494*^9, 3.799337485793968*^9}, {
  3.7993375404671*^9, 
  3.7993375412258186`*^9}},ExpressionUUID->"48e15937-13ac-4d17-bff7-\
5bdf191a4b70"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Unplanarize", "::", "badfn"}], 
   "=", "\"\<`1` is not a pure function whose return value is a list of \
length 2.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.799330488674588*^9, 3.799330555899081*^9}, {
  3.799330793630517*^9, 3.799330800933276*^9}},
 CellLabel->
  "In[3845]:=",ExpressionUUID->"d21050ad-8dae-413c-88e9-e921dae89941"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Unplanarize", "[", "f_Function", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "f", "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"a", " ", "pure", " ", "function"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "List"}], "||", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "2"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"Unplanarize", "::", "badfn"}], ",", "f"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"ReplacePart", "[", 
        RowBox[{"f", ",", 
         RowBox[{"1", "\[Rule]", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{
            "f", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            "0"}], "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"function", " ", "with", " ", "parameters"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "List"}], "||", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "2"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"Unplanarize", "::", "badfn"}], ",", "f"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"ReplacePart", "[", 
        RowBox[{"f", ",", 
         RowBox[{"2", "\[Rule]", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{
            "f", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
            "0"}], "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.79933019833786*^9, 3.799330208816029*^9}, {
   3.79933027936913*^9, 3.799330353505164*^9}, {3.799330395458918*^9, 
   3.799330471442293*^9}, {3.799330560308888*^9, 3.799330812980986*^9}, 
   3.799337399774208*^9, {3.799338047468155*^9, 3.799338077424946*^9}},
