Cell[BoxData[
 RowBox[{
  RowBox[{"FrenetTrihedronPlot3D", "[", 
   RowBox[{"pp_Function", ",", " ", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "flen", ",", "fn", ",", "fd", ",", "tt", ",", "nn", ",", "bb", ",", "dt",
       ",", "glist", ",", "pplist", ",", "ttlist", ",", "nnlist", ",", 
      "bblist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"flen", "=", 
      RowBox[{
       RowBox[{"FrenetVectorLength", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FrenetTrihedronPlot3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fn", "=", 
      RowBox[{
       RowBox[{"FrenetTrihedrons", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FrenetTrihedronPlot3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fd", "=", 
      RowBox[{
       RowBox[{"FrenetDrop", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FrenetTrihedronPlot3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector3D", ",", "NormalVector3D", ",", "BinormalVector3D"}], 
        "}"}], "/.", 
       RowBox[{"Curve3DSystem", "[", 
        RowBox[{"pp", ",", "opts"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"glist", "=", 
      RowBox[{"{", 
       RowBox[{"StyledCurve", "[", 
        RowBox[{"pp", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"LineStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Black", ",", 
            RowBox[{"Thickness", "[", ".01", "]"}]}], "}"}]}]}], "]"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"fn", ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dt", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"u1", "-", "u0"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"fn", "-", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pplist", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"pp", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "u0", ",", "u1", ",", "dt"}], "}"}]}], "]"}], 
           ",", "fd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ttlist", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"tt", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "u0", ",", "u1", ",", "dt"}], "}"}]}], "]"}], 
           ",", "fd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nnlist", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"nn", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "u0", ",", "u1", ",", "dt"}], "}"}]}], "]"}], 
           ",", "fd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bblist", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"bb", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "u0", ",", "u1", ",", "dt"}], "}"}]}], "]"}], 
           ",", "fd"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"glist", ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledFrenetTrihedron", "[", 
              RowBox[{"#1", ",", "#2", ",", "#3", ",", "#4", ",", "opts"}], 
              "]"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"pplist", ",", "ttlist", ",", "nnlist", ",", "bblist"}], 
             "}"}]}], "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"glist", ",", 
       RowBox[{"Sequence", "@@", 
        RowBox[{"FilterRules", "[", 
         RowBox[{
          RowBox[{"{", "opts", "}"}], ",", 
          RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}]}], "]"}]}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.6689830306051617`*^9, 3.668983240332629*^9}, {
   3.66898327802812*^9, 3.668983284754199*^9}, {3.6689833375542192`*^9, 
