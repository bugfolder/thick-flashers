   3.5947345179546547`*^9},ExpressionUUID->"2659e3fa-b84c-4fca-b3b0-\
13bbe4c3b91a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTTwistGraphTo", "[", 
   RowBox[{"tobj_TObj", ",", 
    RowBox[{"twistfaces_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
