             "in"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nb", ",", "1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "extend", " ", "selected", " ", "vertices", " ", "to", " ", "circle"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newverts", "=", "verts"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
