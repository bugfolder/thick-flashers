29a8b666e3ba"],

Cell[TextData[{
 "RotationYMatrix3D",
 "[\[Phi]] returns the rotation matrix in 3D that rotates through an angle \
\[Phi] in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "y"}], TraditionalForm]],ExpressionUUID->
  "27ff0117-eb77-4e9b-a698-a5b83a1d87d7"],
