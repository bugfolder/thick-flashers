Cell[TextData[{
 "PolygonNormal3D[",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] returns the normal vector for a convex planar polygon."
}], "Text",
 CellChangeTimes->{{3.7222076065052757`*^9, 
  3.722207660434368*^9}},ExpressionUUID->"50f1d330-6d97-4cf6-ba73-\
4ab958a59650"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonNormal3D", "[", "poly_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "c", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", "poly"}], "/", 
       RowBox[{"Length", "[", "poly", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"NormalizeReal", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "poly", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", 
         "c"}], ")"}], "\[Cross]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "poly", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", 
         "c"}], ")"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.722207663821629*^9, 3.722207736153879*^9}},
 CellLabel->
  "In[684]:=",ExpressionUUID->"31c066a2-2d85-4b50-9a05-0f88c83b41a5"],

