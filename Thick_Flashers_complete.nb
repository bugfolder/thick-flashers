Cell["Example: Cone from cross curve surface.", "Text",
 CellChangeTimes->{{3.689467685742732*^9, 3.689467695000304*^9}, {
  3.689863698695084*^9, 3.689863703572029*^9}, {3.69140971378246*^9, 
