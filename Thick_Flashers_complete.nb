              RowBox[{"bx", "[", "0", "]"}], ",", 
              RowBox[{"by", "[", "0", "]"}], ",", 
              RowBox[{"bz", "[", "0", "]"}]}], "}"}], "\[Equal]", "ib"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
