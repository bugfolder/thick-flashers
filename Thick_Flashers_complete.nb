Cell[BoxData[
 RowBox[{
  RowBox[{"MultipleGoreData", "[", 
   RowBox[{"pts_List", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t3d", ",", "r3d", ",", "c3d", ",", "u2d"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t3d", ",", "r3d", ",", "c3d", ",", "u2d"}], "}"}], "=", 
      RowBox[{"SingleGoreData", "[", 
       RowBox[{"pts", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RotateZ3D", "[", " ", 
          RowBox[{"t3d", ",", 
           RowBox[{"2", "  ", "j", " ", 
            RowBox[{"\[Pi]", "/", "m"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RotateZ3D", "[", " ", 
          RowBox[{"r3d", ",", 
           RowBox[{"2", "  ", "j", " ", 
            RowBox[{"\[Pi]", "/", "m"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RotateZ3D", "[", " ", 
          RowBox[{"c3d", ",", 
           RowBox[{"2", "  ", "j", " ", 
            RowBox[{"\[Pi]", "/", "m"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Rotate2D", "[", " ", 
          RowBox[{"u2d", ",", 
           RowBox[{"2", "  ", "j", " ", 
            RowBox[{"\[Pi]", "/", "m"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.650200993294759*^9, 3.650201048224845*^9}, {
   3.650201086047735*^9, 3.650201205206615*^9}, {3.650201328705069*^9, 
