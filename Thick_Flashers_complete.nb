Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bb", ",", "dd", ",", "ccds", ",", "ss"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"2", "#"}]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "2"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ccds", "=", 
      RowBox[{"CanonicalCylinderDevelopableSystem", "[", 
       RowBox[{"bb", ",", "dd", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ccds", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"DevelopableSurface", "/.", "ccds"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"StyledCrossRuledPatch", "[", 
          RowBox[{"ss", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "\[Pi]"}], "/", "4"}], ",", 
             RowBox[{"3", 
              RowBox[{"\[Pi]", "/", "4"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"CrossLineStyle", "\[Rule]", "Purple"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
