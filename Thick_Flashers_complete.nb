Cell["\<\
Tweak the dimensions to result in:
\[LongDash]Circumcircle diameter of 200 mm
\[LongDash]Panel thickness (before inset) of about 2.5 mm
\[LongDash]Panel clearance (gap width) of 0.5 mm
\[LongDash]Hinge thickness of 0.7 mm
\[LongDash]No extra clearance around central polygon\
\>", "Text",
 CellChangeTimes->{{3.920484670468161*^9, 3.920484716052226*^9}, {
  3.922612346239901*^9, 3.922612346783553*^9}, {3.9242515440260553`*^9, 
  3.924251562747361*^9}},ExpressionUUID->"4f8f7aa0-2afe-4d89-b7c0-\
580ea6170016"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", "1"}], ",", 
       RowBox[{"h", "=", "2"}], ",", 
       RowBox[{"m", "=", "6"}], ",", "t", ",", "pt", ",", "dfd", ",", 
       "ffcdia", ",", "fs", ",", "pc", ",", "ht", ",", "tobj", ",", "tobjdp", 
       ",", "panels", ",", "panelinfo", ",", "joinedpanels", ",", 
       "filename"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"descaled", " ", "panel", " ", "thickness"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"t", "=", "0.016568"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"desired", " ", "panel", " ", "thickness"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pt", "=", "2.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Desired", " ", "deployed", " ", "form", " ", "diamater"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"dfd", "=", "200.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Construct", " ", "the", " ", "EZT", " ", "surface", " ", "of", " ", 
        "a", " ", "flasher", " ", "with", " ", "the", " ", "specified", " ", 
        RowBox[{"parameters", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"tobj", "=", 
       RowBox[{"MakeThickFlasher", "[", 
        RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
         RowBox[{"TypeMinimumAngle", "\[Rule]", 
          RowBox[{"10.", "\[Degree]"}]}], ",", 
         RowBox[{
         "FlasherSectorDiagFoldLines", "->", 
          "FlasherSectorDiagFoldLinesY"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Show", " ", "the", " ", "EZT", " ", "surface", " ", "and", " ", 
        "some", " ", "of", " ", "its", " ", "details"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"tobjdp", "=", 
       RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<Embedded zero-thickness surface (deployed and \
stowed)\>\"", "]"}], ";", " ", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"GraphicsRow", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}], ",", 
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
         
         RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Flasher details (dimensionless):\>\"", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"tobj", "[", "FlasherDetails", "]"}], "//", "ColumnForm"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Figure", " ", "out", " ", "the", " ", "scale", " ", "factor", " ", 
        "that", " ", "will", " ", "give", " ", "a", " ", "folded", " ", 
        "form", " ", "circumcircle", " ", "of", " ", "200", " ", 
        RowBox[{"mm", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ffcdia", "=", 
       RowBox[{"\"\<folded form circumcircle diameter\>\"", "/.", 
        RowBox[{"tobj", "[", "FlasherDetails", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fs", "=", 
       RowBox[{"dfd", "/", "ffcdia"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Flasher details (scaled):\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<Stowed form diameter\>\"", "->", "dfd"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<FlasherScale\>\"", "->", "fs"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<Panel thickness\>\"", "->", 
           RowBox[{"t", "*", "fs"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<Updated descaled panel thickness\>\"", "->", 
           RowBox[{"pt", "/", "fs"}]}]}], "}"}], "//", "ColumnForm"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Create", " ", "the", " ", "panels"}], ",", " ", 
        RowBox[{
        "scaling", " ", "the", " ", "flasher", " ", "appropriately"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Panel", " ", "clearance"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pc", "=", "0.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
       RowBox[{"MakeThickFlasherPanels", "[", 
        RowBox[{"tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherScale", "->", "fs"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PanelClearance", "->", "pc"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherPanelMaxBendAngle", "->", 
          RowBox[{"30", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherDeployed", "->", "True"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Panels only\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"panels", ",", "SolidStyle"}], "]"}], ",", 
         RowBox[{"Axes", "->", "True"}]}], "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Join", " ", "the", " ", "panels", " ", "with", " ", "hinges"}], ",", 
        " ", 
        RowBox[{
        "using", " ", "the", " ", "standard", " ", "HingeJoinPanels", " ", 
         RowBox[{"function", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Hinge", " ", "thickness"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ht", "=", "0.7"}], ";", "\[IndentingNewLine]", 
      RowBox[{"joinedpanels", "=", 
       RowBox[{"HingeJoinPanels", "[", 
        RowBox[{
        "panels", ",", "panelinfo", ",", "tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"PanelClearance", "->", "pc"}], ",", "\[IndentingNewLine]", 
         RowBox[{"HingeThickness", "->", "ht"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Panels and hinges \>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Graphics3D", "[", 
        RowBox[{"Style", "[", 
         RowBox[{"joinedpanels", ",", "SolidStyle"}], "]"}], "]"}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Export", " ", "as", " ", "STL"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"filename", "=", 
       RowBox[{"\"\<thick_flasher_deployed(\>\"", "<>", 
        RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<,\>\"", "<>", 
        RowBox[{"ToString", "[", "r", "]"}], "<>", "\"\<,\>\"", "<>", 
        RowBox[{"ToString", "[", "h", "]"}], "<>", "\"\<).stl\>\""}]}], ";", 
      "\[IndentingNewLine]", 
