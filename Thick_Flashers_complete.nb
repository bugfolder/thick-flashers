Cell[CellGroupData[{

Cell[TextData[{
 "MakeThickFlasherFFProjectionRules[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
