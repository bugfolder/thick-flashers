  3.803995658469233*^9}},ExpressionUUID->"97476f47-6b4c-4b79-a6cc-\
2552fd7df0d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "u0", ",", "u1", ",", "\[Gamma]0", ",", "\[Gamma]", ",", "s", ",", "f", ",",
       "rL", ",", "rR", ",", "ui", ",", "\[Gamma]i", ",", "ffi", ",", "tti", ",",
       "bbti", ",", "ff", ",", "rrL", ",", "rrR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
