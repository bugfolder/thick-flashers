Cell[TextData[{
 "FoldAcrossRight3D[",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", opts] takes a 3D fold and the left ruling vector and constructs the full \
3D ruled neighborhood, i.e., it adds the right ruling vector."
}], "Text",
 CellChangeTimes->{{3.799443094830909*^9, 3.799443137697144*^9}, {
   3.799497627768349*^9, 3.799497628201466*^9}, 3.799697145086274*^9, 
