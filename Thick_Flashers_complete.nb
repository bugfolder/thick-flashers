Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTMiuraMarsOri", "[", 
   RowBox[{"tobj_TObj", ",", 
    RowBox[{"{", 
     RowBox[{"d1_", ",", "d2_", ",", "d3_", ",", "d4_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"nh_", ",", "nv_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"MakeTMiuraMarsOri", "[", 
   RowBox[{"tobj", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Take", "[", 
