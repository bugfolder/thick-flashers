Cell[CellGroupData[{

Cell[TextData[{
 "FaceNormals3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t",
 "(unchecked class",
 ") TGraph3D"
}], "Subsubsection",
 CellChangeTimes->{{3.591979310050069*^9, 3.591979320088825*^9}, {
   3.591979392340899*^9, 3.5919793999393673`*^9}, 3.591981340002975*^9, {
   3.592378464801155*^9, 3.592378475765742*^9}, 3.592828772671421*^9, 
   3.5947324924534283`*^9},ExpressionUUID->"08dfe070-e0eb-404b-b80f-\
7f4195c501d4"],

Cell[TextData[{
 "FaceNormals3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a ",
 "TGraph3D",
 " representing a 3D graph and returns a list of vectors that are the face \
normal vectors in 3D, oriented to point towards the white side of the paper."
}], "Text",
 CellChangeTimes->{{3.591979326048386*^9, 3.591979380988366*^9}, 
   3.5919813401049356`*^9, {3.5923784886531*^9, 3.592378495188123*^9}, 
   3.592828772781886*^9},ExpressionUUID->"a12dcd83-b7cf-4842-bfea-\
3fc0a5cd14f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceNormals3D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts3d", ",", "faces", ",", "fc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fc", "=", 
      RowBox[{"FaceCentroids3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"verts3d", "\[LeftDoubleBracket]", 
             RowBox[{
             "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "-", "#2"}], ")"}], "\[Cross]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"verts3d", "\[LeftDoubleBracket]", 
             RowBox[{
             "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "-", "#2"}], ")"}]}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"faces", ",", "fc"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.591979411061666*^9, 3.591979461282012*^9}, {
   3.5919795074558067`*^9, 3.591979597449539*^9}, 3.591981340131021*^9, {
   3.592378619154357*^9, 3.592378619674663*^9}, {3.592380698475657*^9, 
   3.592380702597383*^9}, {3.592380769225482*^9, 3.592380770211513*^9}, 
   3.5924357449935226`*^9, 3.701092791662791*^9},
 CellLabel->
  "In[1443]:=",ExpressionUUID->"9b66d070-c9c1-462e-ac18-21dbc0279280"],

Cell["Example: a valley fold.", "Text",
 CellChangeTimes->{{3.5919741644247723`*^9, 3.5919741652389393`*^9}, {
  3.591977709497746*^9, 
  3.591977715504023*^9}},ExpressionUUID->"16a35fe3-83e5-431b-98f9-\
c6b30ad8c624"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "tobj", ",", "verts3d"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], "//", 
       RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graph3DGraphics3D", "[", "tobj", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FaceNormals3D", "[", "tobj", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.591974170837859*^9, 3.591974176116444*^9}, {
   3.5919742361806097`*^9, 3.591974451425126*^9}, {3.591976035779126*^9, 
   3.591976151356385*^9}, {3.591977610446155*^9, 3.591977613127735*^9}, {
   3.591977724784133*^9, 3.591977739878626*^9}, {3.591978291050632*^9, 
