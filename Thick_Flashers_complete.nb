Cell[TextData[{
 "NCurve2DSystem[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{
  3.691193892973172*^9, {3.691200590592368*^9, 3.691200614119337*^9}, 
