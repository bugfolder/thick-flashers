   3.628527896518166*^9}, {3.628528078298472*^9, 3.628528112215905*^9}, {
   3.6285284994345827`*^9, 3.6285285247982597`*^9}, {3.628528906741399*^9, 
   3.628528939595236*^9}, {3.628528999663331*^9, 3.628529000049116*^9}, {
