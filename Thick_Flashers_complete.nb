Cell["SingleVertexGraph3DAssigned", "Subsubsection",
 CellChangeTimes->{{3.595277737853216*^9, 3.595277771832147*^9}, {
   3.706827063904887*^9, 3.706827068544075*^9}, 3.7068271244128327`*^9, {
