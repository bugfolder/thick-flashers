Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RadialAxialOrderingFn", "::", "badedge"}], 
   "=", "\"\<Edge `1` has zero length and can't be oriented.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.485265387314227*^9, 3.485265408174287*^9}, 
   3.4852658444386168`*^9},
 CellLabel->
  "In[1131]:=",ExpressionUUID->"e4ac2250-c5cb-45a5-ab64-031c30f10e37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RadialAxialOrderingFn", "[", 
   RowBox[{"ctr_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Function", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2"}], "}"}], ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tol", ",", " ", "rm", ",", "ad", ",", "rd", ",", "mp", ",", "rmp", ",",
         "r", ",", "dp"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tol", "=", 
        RowBox[{
         RowBox[{"RadialAxialTolerance", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "RadialAxialOrderingFn", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rm", "=", 
        RowBox[{
         RowBox[{"RadialMajor", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "RadialAxialOrderingFn", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ad", "=", 
        RowBox[{
         RowBox[{"AxialDirection", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "RadialAxialOrderingFn", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rd", "=", 
        RowBox[{
         RowBox[{"RadialDirection", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "RadialAxialOrderingFn", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Chop", "[", 
           RowBox[{"Mag", "[", 
            RowBox[{"p1", "-", "p2"}], "]"}], "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"RadialAxialOrderingFn", "::", "badedge"}], ",", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}]}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"mp", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p1", "+", "p2"}], ")"}], "/", "2"}], "-", "ctr"}]}], ";", 
       
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"midpt", " ", "of", " ", "edge"}], ",", " ", 
         RowBox[{"relative", " ", "to", " ", "ctr"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Chop", "[", 
           RowBox[{"Mag", "[", "mp", "]"}], "]"}], "\[Equal]", "0"}], ",", 
         "True", ",", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"midpt", " ", "lies", " ", "on", " ", "ctr"}], ",", " ", 
           RowBox[{"always", " ", "return", " ", "True"}]}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"mp", "=", 
           RowBox[{"NormalizeReal", "[", "mp", "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{"radial", " ", "unit", " ", "vector"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"rmp", "=", 
           RowBox[{"Rotate90", "[", "mp", "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{"axial", " ", "unit", " ", "vector"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"r", "=", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{"p2", "-", "p1"}], "]"}]}], ";", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "unit", " ", "vector", " ", "in", " ", "direction", " ", "of", " ",
             "edge"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"rm", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"dp", "=", 
              RowBox[{"r", ".", "mp"}]}], ";", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "dp", "]"}], ">", "tol"}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"dp", ">", "0"}], ")"}], "\[Xnor]", 
                RowBox[{"(", 
                 RowBox[{"rd", "===", "Outward"}], ")"}]}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"r", ".", "rmp"}], ">", "0"}], ")"}], "\[Xnor]", 
                RowBox[{"(", 
                 RowBox[{"ad", "===", "CCW"}], ")"}]}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"dp", "=", 
              RowBox[{"r", ".", "rmp"}]}], ";", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "dp", "]"}], ">", "tol"}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"dp", ">", "0"}], ")"}], "\[Xnor]", 
                RowBox[{"(", 
                 RowBox[{"ad", "===", "CCW"}], ")"}]}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"r", ".", "mp"}], ">", "0"}], ")"}], "\[Xnor]", 
                RowBox[{"(", 
                 RowBox[{"rd", "===", "Outward"}], ")"}]}]}], "]"}]}]}], 
           "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.465989925041245*^9, 3.465989929713537*^9}, {
   3.465989985445448*^9, 3.46598998943722*^9}, {3.465990044961897*^9, 
   3.465990045353491*^9}, {3.46599018180002*^9, 3.465990235469927*^9}, {
   3.465990278283346*^9, 3.465990368394433*^9}, {3.465990970182031*^9, 
   3.465990999426308*^9}, {3.465991088305359*^9, 3.465991101011608*^9}, {
   3.46599144281334*^9, 3.465991444268216*^9}, 3.4659914766668386`*^9, {
   3.465991510327979*^9, 3.465991590019762*^9}, {3.46599174778605*^9, 
   3.465991753873681*^9}, {3.485265343612862*^9, 3.485265343663357*^9}, {
   3.485265413197238*^9, 3.485265482927781*^9}, {3.4852655834856663`*^9, 
   3.485265684037422*^9}, {3.4852658453172283`*^9, 3.485266073981065*^9}, {
   3.485266115853725*^9, 3.48526627844359*^9}, {3.4852668351468763`*^9, 
   3.485266835333643*^9}, {3.485268283385713*^9, 3.485268293722275*^9}, {
   3.48526833143366*^9, 3.485268334732238*^9}, {3.701092780625996*^9, 
   3.701092781424312*^9}, 3.708342505599306*^9},
