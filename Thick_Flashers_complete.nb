 RowBox[{
  RowBox[{
   RowBox[{"FrenetRibbonWidth", "::", "usage"}], 
   "=", "\"\<FrenetRibbonWidth is an option to FrenetRibbonPlotPair that \
specifies the width of the ribbon.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.800643186603806*^9, 3.800643207099773*^9}, {
  3.800647971747411*^9, 3.800647997568284*^9}},
 CellLabel->
