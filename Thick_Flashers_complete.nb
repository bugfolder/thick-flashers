Cell[BoxData[
 RowBox[{
  RowBox[{"HCwCGraphics3D", "[", 
   RowBox[{"hcwc_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gopts", ",", "sp", ",", "f0", ",", "f1", ",", "f2", ",", "f3", ",", 
      "ff0", ",", "ff1", ",", "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", 
      "yL", ",", "yR", ",", "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", 
      "\[Gamma]2", ",", "vr", ",", "xe", ",", "z3", ",", "z0L", ",", "z0R", ",",
       "gf"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowHCwCPlanes", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HCwCGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", "ff1", ",", 
        "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", "yR", ",", 
        "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2"}], "}"}],
       "=", "hcwc"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vr", "=", "0.5"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"vector", " ", "lengths"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
      "points", " ", "on", " ", "axis", " ", "of", " ", "rotation", " ", 
       "between", " ", "mirror", " ", "planes"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"z3", "=", 
      RowBox[{
       RowBox[{"ff2", "[", 
        RowBox[{"\[Pi]", "/", "2"}], "]"}], "+", 
       RowBox[{"xL", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ff3", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", 
            RowBox[{"ff2", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}]}], ")"}], ".", "yR"}], 
         RowBox[{"xL", ".", "yR"}]]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z0L", "=", 
      RowBox[{"z3", "-", 
       RowBox[{"z", 
        RowBox[{"(", 
         RowBox[{"z", ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ff3", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", 
            RowBox[{"ff0", "[", "0", "]"}]}], ")"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z0R", "=", 
      RowBox[{"z3", "-", 
       RowBox[{"z", 
        RowBox[{"(", 
         RowBox[{"z", ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ff3", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", 
            RowBox[{"ff3", "[", "0", "]"}]}], ")"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xe", "=", 
      RowBox[{"0.5", "+", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{"ff2", "[", 
            RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", "z3"}], "]"}], ",", 
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{"ff2", "[", "0", "]"}], "-", "z0R"}], "]"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"gf", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"StyledRuledPatch", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ff0", ",", "ff1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"RulingLineDivisions", "\[Rule]", "25"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"SurfaceOrientation", "\[Rule]", 
           RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"StyledRuledPatch", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ff1", ",", "ff2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"RulingLineDivisions", "\[Rule]", "25"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"SurfaceOrientation", "\[Rule]", 
           RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"StyledRuledPatch", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ff2", ",", "ff3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"RulingLineDivisions", "\[Rule]", "25"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"SurfaceOrientation", "\[Rule]", 
           RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"StyledCurve", "[", 
         RowBox[{"ff1", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"LineStyle", "\[Rule]", "FoldedLine"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"StyledCurve", "[", 
         RowBox[{"ff2", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"LineStyle", "\[Rule]", "FoldedLine"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"sp", ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"left", " ", "plane"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{"z0L", ",", "z3", ",", 
                 RowBox[{"z3", "+", 
                  RowBox[{"xe", " ", "xL"}]}], ",", 
                 RowBox[{"z0L", "+", 
                  RowBox[{"xe", " ", "xL"}]}]}], "}"}], "]"}], ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}], ",", "Green"}], "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"right", " ", "plane"}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{"z0R", ",", "z3", ",", 
                 RowBox[{"z3", "+", 
                  RowBox[{"xe", " ", "xR"}]}], ",", 
                 RowBox[{"z0R", "+", 
                  RowBox[{"xe", " ", "xR"}]}]}], "}"}], "]"}], ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}], ",", "Green"}], "]"}]}], 
           "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"gf", ",", "gopts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.803561474008319*^9, 3.803561547536961*^9}, {
   3.803561588480536*^9, 3.803561615633025*^9}, {3.803561693649892*^9, 
   3.803561705833042*^9}, {3.803562797547179*^9, 3.803562865137107*^9}, {
   3.803562913308605*^9, 3.803562963258734*^9}, {3.803563095945709*^9, 
