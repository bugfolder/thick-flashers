Cell[CellGroupData[{

Cell["Flattening a ribbon", "Subsection",
 CellChangeTimes->{{3.801769818045598*^9, 
  3.80176982391637*^9}},ExpressionUUID->"7531823f-b815-4b7f-8d37-\
5b119806d205"],

Cell[CellGroupData[{

Cell[TextData[{
 "FlattenGeneric2D[{",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", \[Sigma]}, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{{3.801769826092054*^9, 3.801769829989329*^9}, {
   3.801770108872091*^9, 3.801770156459346*^9}, 
   3.801771898455246*^9},ExpressionUUID->"fa98f96f-61c4-4ad2-aeec-\
c8974efda984"],

Cell[TextData[{
 "FlattenGeneric2D[{",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", \[Sigma]}, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes an oriented ruled parameterization of a developable surface and \
returns the flattened version."
}], "Text",
 CellChangeTimes->{{3.798572847292226*^9, 3.798572899717365*^9}, {
   3.7985731966001863`*^9, 3.798573197766917*^9}, {3.798574876085689*^9, 
   3.798574885212594*^9}, {3.798624528951817*^9, 3.798624530092536*^9}, {
   3.799324637560071*^9, 3.799324655520765*^9}, {3.799332469887213*^9, 
   3.799332506695383*^9}, {3.799335590716183*^9, 3.799335626092291*^9}, 
   3.799344116522127*^9, 3.800467905409665*^9, 3.800471568339971*^9, {
   3.801770869862853*^9, 3.801770898380573*^9}, 
   3.801771898474327*^9},ExpressionUUID->"596bd723-b5f1-448c-b4fa-\
c754bfdf12b0"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["bb",
  FontSlant->"Italic"],
 " \[LongDash] the 3D directrix, as a pure function. it should not be a cone \
point or the EOR of a tangent devleopable.\n\t",
 StyleBox["dd",
  FontSlant->"Italic"],
 " \[LongDash] the 3D director, as a pure function.\n\t\[Sigma] \[LongDash] \
the orientation, which should be \[PlusMinus]1.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter.\n\t",
 StyleBox["bi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position of the new directrix.\n\t",
 StyleBox["ti",
  FontSlant->"Italic"],
 " \[LongDash] the initial tangent vector of the new directrix."
}], "Text",
 CellChangeTimes->{{3.798572971597745*^9, 3.798573067343102*^9}, {
