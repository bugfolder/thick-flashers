Cell[CellGroupData[{

Cell[TextData[{
 "SplitAndFoldSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vlist",
  FontSlant->"Italic"],
 "]\n\t(checked class) TSplitGraph2D"
}], "Subsubsection",
 CellChangeTimes->{{3.706795831890571*^9, 3.706795849722861*^9}, {
   3.706796178143011*^9, 3.7067961793981247`*^9}, 
   3.706818982348045*^9},ExpressionUUID->"0ffac861-1369-48cc-be92-\
f56d04cdd26d"],

Cell[TextData[{
 "SplitAndFoldSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vlist",
  FontSlant->"Italic"],
 "] takes a TSplitGraph2D, splits it according to its SplitInfo, then folds a \
specified set of vertices across the SplitFoldLine."
}], "Text",
 CellChangeTimes->{{3.706818742896203*^9, 
  3.70681881227997*^9}},ExpressionUUID->"dbbe1326-4bd5-4bb8-b9d5-\
dd22fffc6c94"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TSplitGraph2D that describes the paper, fold line, and \
splitting information\n\t",
 StyleBox["vlist",
  FontSlant->"Italic"],
 " \[LongDash] a list of the indices of the moving vertices."
}], "Text",
 CellChangeTimes->{{3.706818825015194*^9, 
  3.706818865288457*^9}},ExpressionUUID->"0148f971-7185-4808-a50c-\
d8f6b1ead612"],

Cell["\<\
Returns: a new TGraph2D of the split graph with vertices folded. If the input \
was a TPlaneGraph2D, then we will regenerate TPlaneGraph2D data (so Faces may \
be different, even for unaffected faces). As with SplitSplitGraph2D, that the \
returned object is no longer a TSplitGraph2D.\
\>", "Text",
 CellChangeTimes->{{3.706818868095333*^9, 
  3.706818921296109*^9}},ExpressionUUID->"e1ef37db-7128-4c63-86ed-\
2191336b5e75"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SplitAndFoldSplitGraph2D", "[", 
   RowBox[{"tobj_TObj", ",", "vlist_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj1", ",", "sfl", ",", "verts2d", ",", "u"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sfl", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "SplitFoldLine"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"SplitSplitGraph2D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj1", ",", "Vertices2D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"u", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", 
       RowBox[{
       "sfl", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "verts2d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "=", 
         RowBox[{"Reflect", "[", 
          RowBox[{
           RowBox[{
           "verts2d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
           ",", 
           RowBox[{
           "sfl", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
            "u"}], "]"}]}], ")"}], "&"}], "/@", "vlist"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices2D", "\[Rule]", "verts2d"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.706818924240104*^9, 3.706818951129127*^9}, {
  3.706819009922304*^9, 3.706819125451641*^9}, {3.706819228076851*^9, 
  3.706819303676386*^9}, {3.706819396391543*^9, 3.7068194467736*^9}},
 CellLabel->
  "In[1389]:=",ExpressionUUID->"3e5adf21-a98a-4954-8639-0c605b17db70"],

Cell["\<\
Examples. Fold and split on a subset of the possible fold lines, then fold \
some of the vertices.\
\>", "Text",
 CellChangeTimes->{{3.706818641349916*^9, 3.706818648790268*^9}, {
  3.7068194562711277`*^9, 
  3.706819468933663*^9}},ExpressionUUID->"18badb67-c422-46b9-bac8-\
c7768d441d5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "f1", ",", "f2", ",", "sinfo", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"SingleVertexGraph2D", "//", "RebuildPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f1", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", ".1"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.3"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"f1", ",", 
          RowBox[{"f2", "-", "f1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<All split information\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SplitGraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SplitGraph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sinfo", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "SplitInfo"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sinfo", "//", "ColumnForm"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FilterSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
