Cell["\<\
Returns: a TGraph3DAssigned of the box. Note that \[Pi]-ArcSec[3] gives a 3D \
tetrahedron.\
\>", "Text",
 CellChangeTimes->{{3.719836762960309*^9, 3.719836773192265*^9}, {
  3.77584134896507*^9, 
  3.77584136064462*^9}},ExpressionUUID->"9c094680-bcb8-428c-a4d7-\
b626c1e46ab3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeUnitTetrahedron", "[", "\[Gamma]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "tobj", ",", "a", ",", "types", ",", 
      "foldangles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{
           SqrtBox["3"], "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", 
          RowBox[{
           SqrtBox["3"], "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          SqrtBox["3"]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "B", ",", "B", ",", "V", ",", "V", ",", "B", ",", "V", ",", 
        "B", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraphAssigned", "[", 
        RowBox[{"verts", ",", "edges", ",", 
         RowBox[{"{", "}"}], ",", "types"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "\[Gamma]", ",", "\[Gamma]", ",", "0", ",",
         "\[Gamma]", ",", "0", ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj", ",", "foldangles", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "3"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"ReassignGraphAssigned", "[", 
       RowBox[{"tobj", ",", "foldangles"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7575055751307592`*^9, 3.757505770830198*^9}, {
   3.757505802437085*^9, 3.7575058099638166`*^9}, {3.757505875422663*^9, 
   3.757505894732265*^9}, 3.757505942573537*^9, {3.757506202913046*^9, 
   3.757506204689117*^9}, {3.757506251268503*^9, 3.757506291879208*^9}, 
   3.757506630564899*^9, {3.757507189271976*^9, 3.757507208726055*^9}, {
   3.775496032615278*^9, 3.775496047119626*^9}, {3.775496109505012*^9, 
   3.775496235774975*^9}, 3.77549627388631*^9, {3.775496325604683*^9, 
   3.77549639716594*^9}, {3.775496436504065*^9, 3.77549653902309*^9}, {
   3.775496637606696*^9, 3.775496658119091*^9}, {3.775496700186797*^9, 
   3.7754967038855257`*^9}, {3.775841377026903*^9, 3.775841415798734*^9}},
