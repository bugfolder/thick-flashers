Cell[BoxData[
 RowBox[{"temp2", "=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pp", ",", 
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "2"}], ",", "n", ",", 
      RowBox[{"m", "=", "5"}], ",", 
      RowBox[{"k", "=", "0"}], ",", 
      RowBox[{"dr", "=", "0.2"}], ",", "ffr", ",", "verts", ",", "pos", ",", 
      "off"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"r", "*", "h"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"FlasherFirstSectorVerticesAll", "[", 
       RowBox[{"pp", ",", "r", ",", "h"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ffr", "=", 
      RowBox[{"FlasherDefaultFFRules", "[", 
       RowBox[{"pp", ",", "h", ",", "m", ",", "dr"}], "]"}]}], ";", 
