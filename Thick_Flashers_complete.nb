                RowBox[{"PointStyle", "\[Rule]", "RulingPoint"}]}], "]"}], 
              "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "z"}], ",", "z"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"ruling", " ", "vector"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"stv", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"StyledPoint", "[", 
               RowBox[{"#", ",", 
                RowBox[{"PointStyle", "\[Rule]", "MidfoldNormalPoint"}]}], 
               "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "t"}], ",", "t"}], "}"}]}], "}"}], ",", 
