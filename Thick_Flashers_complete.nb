Cell[CellGroupData[{

Cell[TextData[{
 "CreasePatternToGraph2DAssigned[",
 StyleBox["cp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) SamePtTolerance, BorderOverride, StationaryFace"
}], "Subsubsection",
 CellChangeTimes->{{3.628337782815227*^9, 3.628337815018821*^9}, {
  3.628337882999051*^9, 
  3.628337883206901*^9}},ExpressionUUID->"507c9aad-729a-43be-a078-\
ac8baf34a5e1"],

Cell[TextData[{
 "CreasePatternToGraph2DAssigned",
 "[",
 StyleBox["cp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a crease pattern ",
 StyleBox["cp",
  FontSlant->"Italic"],
 ", given as a collection of styled lines and polygons, and turns it into a \
TGraph2D+TAssigned, i.e., a TGraph representing both crease pattern and \
folded form. Options are:\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", specifies the tolerance to use in Indexification of the vertex \
coordinates.\n\tBorderOverride \[Rule] True | False, where True overrides \
whatever you\[CloseCurlyQuote]ve set the border lines to and sets them to \
edge type B.\n\tStationaryFace \[Rule] ",
 StyleBox["sf",
  FontSlant->"Italic"],
 ", specifies which face remains stationary in the folded form."
}], "Text",
 CellChangeTimes->{{3.533669391156823*^9, 3.533669429658675*^9}, {
   3.533669460320707*^9, 3.533669466552266*^9}, {3.533669506277551*^9, 
   3.533669655125202*^9}, {3.533669728920254*^9, 3.533669861861691*^9}, {
   3.533669892707673*^9, 3.533669904914672*^9}, 3.533669939264729*^9, {
