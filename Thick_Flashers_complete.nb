Cell[CellGroupData[{

Cell[TextData[{
 "TriangulateGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.706916124391981*^9, 3.7069161534881167`*^9}, {
  3.706916194232382*^9, 
  3.706916201544257*^9}},ExpressionUUID->"b1cca067-f419-47d4-8f19-\
0d12a7ae6624"],

Cell[TextData[{
 "TriangulateGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph and triangulates the faces by adding additional edges."
}], "Text",
 CellChangeTimes->{{3.706916221601641*^9, 3.70691627358456*^9}, {
  3.706916328250965*^9, 
  3.706916345289982*^9}},ExpressionUUID->"c972ba5b-7f0d-427a-9310-\
fb80074fa07e"],

Cell["\<\
Returns: whatever type of TGraph was passed in, with the addition of \
TriangulationEdges property and rebuilt TPlaneGraph information.\
\>", "Text",
 CellChangeTimes->{{3.70691634775294*^9, 
  3.706916395450031*^9}},ExpressionUUID->"7065d26f-3a21-4145-a4d4-\
a0841a471f87"],

Cell["\<\
Note that other properties that might be affected by triangulation would need \
to be modified. We do properly handle updating of the FoldAngles property of \
TGraph3D and EdgeTypes property of TAssigned, setting triangulation \
FoldAngles to 0\[Degree], and setting triangulate EdgeTypes to U.\
\>", "Text",
 CellChangeTimes->{{3.706916509489756*^9, 3.706916582300151*^9}, {
  3.706916643940542*^9, 3.706916663140608*^9}, {3.706952394363984*^9, 
  3.706952454885976*^9}},ExpressionUUID->"9435f948-f632-422e-90ff-\
eaa5b6a2e65b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangulateGraph", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "nedges", ",", "neo", ",", 
      "nne", ",", "face", ",", "tobj1", ",", "foldangles", ",", "types"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "TriangulateGraph"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "Faces"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"neo", "=", 
      RowBox[{"Length", "[", "edges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", "tobj"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nedges", ",", "faces"}], "}"}], "=", 
      RowBox[{"TriangulatePolygons", "[", 
       RowBox[{"verts", ",", "faces"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nne", "=", 
      RowBox[{"Length", "[", "nedges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"JoinTo", "[", 
      RowBox[{"edges", ",", "nedges"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"tobj", "//", 
        RowBox[{"ReplaceProperty", "[", 
         RowBox[{"Edges", "\[Rule]", "edges"}], "]"}]}], "//", 
       "RebuildPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj1", ",", "TGraph3D"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"foldangles", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"GetValue", "[", 
            RowBox[{"tobj1", ",", "FoldAngles"}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", "nne", "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tobj1", "=", 
         RowBox[{"tobj1", "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"FoldAngles", "\[Rule]", "foldangles"}], "]"}]}]}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj", ",", "TAssigned"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"types", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"GetValue", "[", 
            RowBox[{"tobj1", ",", "EdgeTypes"}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{"U", ",", 
             RowBox[{"{", "nne", "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tobj1", "=", 
         RowBox[{"tobj1", "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"EdgeTypes", "\[Rule]", "types"}], "]"}]}]}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"AddClassTo", "[", 
      RowBox[{"tobj1", ",", "TTriangulated", ",", 
       RowBox[{"{", 
        RowBox[{"TriangulationEdges", "\[Rule]", 
         RowBox[{"Table", "[", 
          RowBox[{"i", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"neo", "+", "1"}], ",", 
             RowBox[{"neo", "+", "nne"}]}], "}"}]}], "]"}]}], "}"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7069163023697653`*^9, 3.706916320337312*^9}, {
   3.706916399529665*^9, 3.706916451947229*^9}, 3.706916689750081*^9, {
   3.706916776063092*^9, 3.706917125561664*^9}, {3.706917233820795*^9, 
   3.7069173037341413`*^9}, {3.706951473079554*^9, 3.706951504813953*^9}, {
   3.706951585311335*^9, 3.706951711008724*^9}, {3.706951798530942*^9, 
   3.706951813570551*^9}, 3.708400178106776*^9, {3.7086032032232943`*^9, 
   3.708603226480528*^9}, {3.708603272944248*^9, 3.708603386231534*^9}, 
   3.708603657204077*^9},
 CellLabel->
  "In[2036]:=",ExpressionUUID->"aa530c63-a6db-460b-828f-324f2bebbb95"],

