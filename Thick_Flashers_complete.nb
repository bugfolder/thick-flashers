             RowBox[{
              RowBox[{"{", 
               RowBox[{"kn1", ",", "kn2"}], "}"}], ",", "Orange"}], "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"ho1", ",", "ho2"}], "}"}], ",", "Gray", ",", 
              RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", ".1"}], ",", 
               RowBox[{"a", "+", ".1"}]}], "}"}], ",", "All", ",", "All"}], 
            "}"}]}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<Panels and knuckles\>\""}]}], "]"}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "r1", "}"}], ",", 
                RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "cu1", "}"}], ",", "Pink", ",", 
                RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "kn1", "}"}], ",", "Orange"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"{", "ho1", "}"}], ",", "Gray", ",", 
                RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"TransformGC", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "r2", "}"}], ",", 
                  RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "cu2", "}"}], ",", "Pink", ",", 
                  RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "kn2", "}"}], ",", "Orange"}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"{", "ho2", "}"}], ",", "Gray", ",", 
                  RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}]}], "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "3", ",", "0"}], "}"}], "+", "#"}], 
               "&"}]}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", ".1"}], ",", 
               RowBox[{"a", "+", ".1"}]}], "}"}], ",", "All", ",", "All"}], 
            "}"}]}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{
          "PlotLabel", "->", "\"\<Panels and knuckles, separated\>\""}]}], 
         "]"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.933364433761119*^9, 3.933364530019498*^9}, {
   3.933364746287744*^9, 3.933364758079247*^9}, {3.9333648538930387`*^9, 
   3.9333648690837*^9}, {3.933365003522987*^9, 3.933365126606522*^9}, {
   3.933365157364668*^9, 3.933365230043352*^9}, 3.933368761044059*^9, 
   3.9333689084697533`*^9, 3.933689372982574*^9, {3.9336902340328836`*^9, 
   3.933690234432582*^9}, {3.9336902936125107`*^9, 3.933690448607081*^9}, {
   3.933691338666106*^9, 3.933691463015018*^9}, {3.933691777904354*^9, 
   3.9336918401318703`*^9}, {3.9336918808275137`*^9, 3.933691882456336*^9}, {
   3.933692142050452*^9, 3.933692187721044*^9}, {3.9336922299299393`*^9, 
   3.933692310919977*^9}, {3.933692343852681*^9, 3.933692392502349*^9}, 
   3.9336924439994907`*^9, 3.9336976402682667`*^9, {3.9336979797088842`*^9, 
   3.933698051892174*^9}, {3.933698141481481*^9, 3.933698276539378*^9}, {
   3.933943452523591*^9, 3.933943521998311*^9}, {3.93394366423066*^9, 
   3.933943675820882*^9}, 3.9339438368572693`*^9, 3.933955460052102*^9, {
   3.934028625745513*^9, 3.934028896025667*^9}, {3.9340289524467793`*^9, 
   3.934029024101034*^9}, {3.934029087750938*^9, 3.934029258295431*^9}, 
   3.934305070799161*^9, 3.934305133313106*^9, {3.935059577345434*^9, 
   3.935059595245532*^9}, {3.935066531635891*^9, 3.935066575831571*^9}, {
   3.935066631607779*^9, 3.935066752822949*^9}, {3.9350668326637697`*^9, 
   3.935066847038871*^9}, {3.935067374108369*^9, 3.935067376186777*^9}, 
   3.9357657214193497`*^9, {3.9666299117499743`*^9, 3.966629913070018*^9}},
