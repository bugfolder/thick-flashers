     RowBox[{"\[Tau]", "=", 
      RowBox[{"75", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
           "QuadrilateralCenteredSplitTwistTile", ",", "verts", ",", "w", ",",
             "\[Tau]", ",", "ip", ",", "ctype", ",", "types"}], "}"}], "}"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "QuadrilateralCenteredSplitTwistTile", ",", "verts", ",", "w", ",",
              "\[Tau]", ",", "ip", ",", "ctype", ",", "types"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
