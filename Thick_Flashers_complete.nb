Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x", ",", "\[Mu]", ",", "gmn", ",", "gmj", ",", "\[Gamma]b", ",", 
      "\[Gamma]l", ",", "\[Phi]b", ",", "\[Phi]l", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", "1"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"degree", " ", "of", " ", "foldedness"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Mu]", "=", "2.0"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "fold", " ", "angle", " ", "multiplier", " ", "for", " ", "these", " ", 
       "sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gmn", "=", 
      RowBox[{"2", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"x", "/", 
         SqrtBox["\[Mu]"]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gmj", "=", 
      RowBox[{"2", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"x", 
         SqrtBox["\[Mu]"]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]l", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"30.", "\[Degree]"}], ",", 
        RowBox[{"30.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]l", "=", 
      RowBox[{"{", 
       RowBox[{"gmj", ",", 
        RowBox[{"-", "gmj"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]b", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{"90.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]b", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "gmn"}], ",", "gmn"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RigidlyFoldableQuadMesh", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Phi]b", ",", "\[Gamma]b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]l", ",", "\[Gamma]l"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.692472905998848*^9, 3.69247290854755*^9}, {
