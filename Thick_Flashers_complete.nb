Cell[CellGroupData[{

Cell["Assignments from TPlaneGraphs", "Subsection",
 CellChangeTimes->{{3.671345538836753*^9, 
  3.671345563081963*^9}},ExpressionUUID->"7eb6052e-79e1-4b68-b083-\
b220ff61957f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.671345566930141*^9, 
  3.671345567744654*^9}},ExpressionUUID->"ae280e43-d20c-4878-b89f-\
565beb8721ec"],

Cell["\<\
We can\[CloseCurlyQuote]t infer the mountain/valley assignment from a \
TPlaneGraph, but we can know which creases are border creases. This, plus \
RecalcFoldAngles, can give the full assignment.\
\>", "Text",
 CellChangeTimes->{{3.6713455694568768`*^9, 3.671345588138892*^9}, 
   3.671345623909643*^9, {3.6713492259914207`*^9, 
   3.671349250396182*^9}},ExpressionUUID->"6f325fa3-8fd7-4718-93cb-\
b598cb7913e3"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PlaneGraphTypes[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.67134565829915*^9, 
  3.671345692137025*^9}},ExpressionUUID->"f49b8803-866d-4e86-bb2f-\
4e6d0397576d"],

Cell[TextData[{
 "PlaneGraphTypes[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] constructs a list of types from the TPlaneGraph properties. The types \
will be B for border creases, U for everything else. Arguments are:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TPlaneGraph.\nIt returns the list of types."
}], "Text",
 CellChangeTimes->{{3.6713457007204847`*^9, 3.6713457099680433`*^9}, {
  3.6713488770331173`*^9, 
  3.67134894027174*^9}},ExpressionUUID->"1d14da5b-3e48-4501-acbd-\
02e5e2db4e92"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PlaneGraphTypes", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "efi", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPlaneGraph", ",", "PlaneGraphTypes"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"efi", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "EdgeFaceIncidence"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"#", ",", "0"}], "]"}], ",", "B", ",", "U"}], "]"}], "&"}], 
      "/@", "efi"}]}]}], "]"}]}]], "Input",
