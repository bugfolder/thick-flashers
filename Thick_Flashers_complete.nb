c13c93fd5eb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Gamma]", ",", "\[Alpha]", ",", "dir", ",", "\[Rho]", ",", "\[Beta]", ",",
       "pverts", ",", "pedges", ",", " ", "pfaces", ",", "dverts", ",", 
      "pefis", ",", "dfaces", ",", "iverts", ",", "bverts", ",", "bedge", ",",
       "bface", ",", "edgepair", ",", "edgetype"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]", "=", "2.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"20.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CCW"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "\[Beta]"}], "}"}], "=", 
      RowBox[{"ShrinkAndTwistParms", "[", 
       RowBox[{"\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"TwistDirection", "\[Rule]", "dir"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[Rho]=\>\"", ",", "\[Rho]", ",", "\"\<, \[Beta]=\>\"", ",", 
       RowBox[{"\[Beta]", "/", "\[Degree]"}], ",", "\"\<\[Degree]\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "4"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pfaces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "5", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "6", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5", ",", "8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6", ",", "9", ",", "8"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pefis", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", "1", "}"}], ",", 
        RowBox[{"{", "2", "}"}], ",", 
        RowBox[{"{", "2", "}"}], ",", 
        RowBox[{"{", "4", "}"}], ",", 
        RowBox[{"{", "4", "}"}], ",", 
        RowBox[{"{", "3", "}"}], ",", 
        RowBox[{"{", "3", "}"}], ",", 
        RowBox[{"{", "1", "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dfaces", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "4", ",", "3"}], "}"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"iverts", "=", 
      RowBox[{"{", "5", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bverts", "=", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", "2", ",", "3", ",", "6", ",", "9", ",", "8", ",", "7", ",", 
        "4"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bedge", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"bface", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edgepair", ",", "edgetype"}], "}"}], "=", 
      RowBox[{"MakePrimalDualTwistTessellationBoundaryEdge", "[", 
       RowBox[{
        RowBox[{
        "pedges", "\[LeftDoubleBracket]", "bedge", "\[RightDoubleBracket]"}], 
        ",", "bface", ",", "pverts", ",", "dverts", ",", "\[Rho]", ",", 
        "\[Beta]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"MakeTGraph", "[", 
          RowBox[{"pverts", ",", "pedges", ",", "pfaces"}], "]"}], "]"}], ",", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "edgepair", "]"}], ",", "edgetype"}], "]"}], 
          "/.", "TypeToCreasePatternStyleRules"}], "]"}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
