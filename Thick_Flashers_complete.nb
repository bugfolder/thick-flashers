}], "Subsubsection",
 CellChangeTimes->{{3.707910902979556*^9, 
  3.707910924571518*^9}},ExpressionUUID->"f2d9da0d-b648-4af1-ae7c-\
277195c8f831"],

Cell[TextData[{
 "ApplyMerge2DTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 "] applies the merge changes to the TGraph2D properties of a graph resulting \
from a merge of several subgraphs."
}], "Text",
 CellChangeTimes->{{3.707905708691448*^9, 3.70790572410831*^9}, {
  3.707905778468769*^9, 3.707905779428781*^9}, {3.7079094485192637`*^9, 
  3.707909516279717*^9}, {3.707910944888079*^9, 
  3.707910950172874*^9}},ExpressionUUID->"c66d02e8-e7cf-48c8-aa10-\
bfd142bf1535"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the merged TGraph.\n\t",
 StyleBox["tglist",
  FontSlant->"Italic"],
 " \[LongDash] the list of subgraphs to merge.\n\t",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 " \[LongDash] merging data, the output from MergeGraphsData."
}], "Text",
 CellChangeTimes->{{3.707909517822734*^9, 
  3.707909585088239*^9}},ExpressionUUID->"5b31f807-74e7-45b3-b692-\
8c2f86719578"],

Cell["Returns: a TGraph2D with its Vertices2D property set.", "Text",
 CellChangeTimes->{{3.707909588702633*^9, 3.707909604752595*^9}, {
  3.7079109687080183`*^9, 
  3.707910977819652*^9}},ExpressionUUID->"dd01cdf7-688f-46c1-924e-\
c61bbe54b16e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyMerge2DTo", "[", 
   RowBox[{"tobj_TObj", ",", "tglist_List", ",", "mgdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vlist", ",", "elist", ",", "verts2d", ",", "vertslist"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vlist", ",", "elist"}], "}"}], "=", "mgdata"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "Vertices2D", " ", "from", " ", "constituent", " ", 
       "graphs"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", 
          RowBox[{"tobj", "[", "Vertices", "]"}], "]"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vertslist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "Vertices2D", "]"}], "&"}], "/@", "tglist"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#1", "\[NotEqual]", "0"}], ",", 
            RowBox[{
             RowBox[{
             "verts2d", "\[LeftDoubleBracket]", "#1", 
              "\[RightDoubleBracket]"}], "=", "#2"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "vlist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "vertslist", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"AddTGraph2D", "[", "verts2d", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707909657216565*^9, 3.7079096969101152`*^9}, {
   3.707909730821075*^9, 3.707909815012155*^9}, {3.707909857121476*^9, 
   3.707909886119005*^9}, {3.707910286807561*^9, 3.707910294183772*^9}, 
   3.707910748261922*^9, {3.707910991915077*^9, 3.707911031478421*^9}},
 CellLabel->
  "In[2001]:=",ExpressionUUID->"fcff5064-fbc1-4a0b-83a2-2980bcd8f9fd"],

