Cell[TextData[{
 "NFlattenGeneric2D[{",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", \[Sigma]}, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes an oriented ruled parameterization of a developable surface and \
returns the flattened version using interpolating functions."
}], "Text",
 CellChangeTimes->{{3.798572847292226*^9, 3.798572899717365*^9}, {
