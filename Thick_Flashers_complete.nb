Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"poly", ",", "segments", ",", "csegments"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"poly", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", ".6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"segments", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", ".25"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", 
              RowBox[{"-", ".25"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", ".25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", ".25"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "}"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}], ",", 
              RowBox[{"1.5", "-", 
               RowBox[{"2.5", 
                RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "-", 
               RowBox[{"3", 
                RowBox[{"Random", "[", "]"}]}]}], ",", 
              RowBox[{"1.5", "-", 
               RowBox[{"2.5", 
                RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"Sort", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Random", "[", "]"}], ",", 
                 RowBox[{"{", "8", "}"}]}], "]"}], "]"}], ",", "2"}], "]"}]}],
            "}"}], ",", 
          RowBox[{"{", "30", "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csegments", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ClipSegmentSetToQuasiConvexPolygonExterior", "[", 
         RowBox[{"#", ",", "poly"}], "]"}], "&"}], "/@", "segments"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"LightGray", ",", 
         RowBox[{"Polygon", "[", "poly", "]"}], ",", "\[IndentingNewLine]", 
         "Gray", ",", 
         RowBox[{"SegmentSetLine", "/@", "segments"}], ",", 
         "\[IndentingNewLine]", "Red", ",", 
         RowBox[{"Thickness", "[", ".01", "]"}], ",", 
         RowBox[{"SegmentSetLine", "/@", "csegments"}]}], "}"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462923112756584*^9, 3.46292311505275*^9}, {
