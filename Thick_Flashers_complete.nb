    RowBox[{"TwistTubeParametersRH", "[", 
     RowBox[{"m", ",", 
      RowBox[{"{", 
       RowBox[{"h1", ",", "h2"}], "}"}]}], "]"}], ",", 
    RowBox[{"TwistTubeParametersLH", "[", 
     RowBox[{"m", ",", 
      RowBox[{"{", 
       RowBox[{"h1", ",", "h2"}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.654262739652358*^9, 3.654262780225333*^9}},
 CellLabel->
  "In[2572]:=",ExpressionUUID->"0f096491-c93f-4f40-9d93-5e0a5cc5c1b0"],

