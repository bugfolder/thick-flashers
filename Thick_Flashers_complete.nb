               RowBox[{"b", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
