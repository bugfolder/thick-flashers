e7da89ece185"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "tobjh", ",", "tobjv"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", "SingleVertexGraph2D"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjh", "=", 
      RowBox[{"FlopGraph2D", "[", "tobj", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjv", "=", 
      RowBox[{"FlopGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"FlopDirection", "\[Rule]", "Vertical"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graph2DGraphics", "[", "tobj", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graph2DGraphics", "[", "tobjh", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graph2DGraphics", "[", "tobjv", "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.484778479752207*^9, 3.484778765342606*^9}, {
