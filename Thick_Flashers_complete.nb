              RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], "}"}], 
          ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"VisibleFoldedFormGraphics", "[", "tobj", "]"}]}], 
           "}"}]}], "}"}], "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
