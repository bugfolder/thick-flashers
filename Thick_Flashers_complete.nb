 RowBox[{
  RowBox[{
   RowBox[{"CreasePatternToPlaneGraphAssigned", "::", "badstyles"}], 
   "=", "\"\<The styles in this object, `1`, contain more than just \
{{MountainLine}, {ValleyLine}, {UnfoldedLine}, {BorderLine}}.\>\""}], 
  ";"}]], "Input",
