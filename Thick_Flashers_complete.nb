          RowBox[{"\"\<pp\>\"", ",", "pp", ",", "r", ",", "h", ",", "m"}], 
          "]"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"FlasherLines", "[", 
          RowBox[{"pp", ",", "r", ",", "h", ",", "m"}], "]"}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "/.", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"FlasherDefaultCPRules", "[", 
