   3.615296232988186*^9}},ExpressionUUID->"15038655-0e83-4bcf-a046-\
f7f73ebc9e3a"],

Cell[TextData[{
 "FoldAngleGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] returns a Graphics object that displays the graph with edges labeled by \
its FoldAngles. Options are:\n\tEdgeIndices \[Rule] True | False, specifies \
whether to display the index of the edge.\n\tUseDegrees \[Rule] True | False, \
specifies whether to show the angles in degrees rather than radians.\n\t\
FoldAngleForm \[Rule] ",
 StyleBox["f",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["f",
  FontSlant->"Italic"],
 " formats the value of the angle."
}], "Text",
 CellChangeTimes->{{3.594201105590796*^9, 3.5942012095505457`*^9}, {
   3.594201330350005*^9, 3.5942013393265953`*^9}, {3.5942090328469152`*^9, 
   3.594209034173389*^9}, 3.594217887345191*^9, {3.594218026430644*^9, 
   3.594218027627221*^9}, 3.5943088776722*^9, {3.595254367523344*^9, 
   3.5952543886259604`*^9}, {3.595254529209985*^9, 3.595254542280084*^9}, 
   3.595254879771581*^9, {3.643373949866431*^9, 3.643373964985034*^9}, {
   3.64337400708997*^9, 
   3.643374027110243*^9}},ExpressionUUID->"a6d1f610-a01d-41c1-bad1-\
bd45b8d2e3e0"],

