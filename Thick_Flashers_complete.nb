Cell[CellGroupData[{

Cell[TextData[{
 "FoldAngleGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph, TGraph3D\n\t(options) EdgeIndices, \
UseDegrees, FoldAngleForm"
}], "Subsubsection",
 CellChangeTimes->{{3.59420108482266*^9, 3.594201097348919*^9}, {
   3.594201155617905*^9, 3.594201168416314*^9}, {3.59421099140123*^9, 
