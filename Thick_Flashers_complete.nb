Cell[TextData[{
 "{UnitCyclicPolygonCenteredTwistTile, {",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["side",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} represents an edge-centered simple flat twist in a cyclic polygon with \
corner angles ",
 StyleBox["angles",
  FontSlant->"Italic"],
 " and side length ",
 StyleBox["side",
  FontSlant->"Italic"],
 " on the ",
 StyleBox["is",
  FontSlant->"Italic"],
 "-th side of the polygon, where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of the pleat where it subtends the edge, \[Tau] is the pleat \
angle, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
