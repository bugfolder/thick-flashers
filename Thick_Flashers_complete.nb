            RowBox[{"{", 
             RowBox[{"0", ",", "50"}], "}"}], ",", "All"}], "}"}]}]}], "]"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Export", " ", "as", " ", "STL"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"filename", "=", 
       RowBox[{"\"\<thick_flasher_stowed(\>\"", "<>", 
