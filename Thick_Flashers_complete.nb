     RowBox[{"nd", "=", "20"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"DashedLine", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"i", "/", "nd"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"i", "/", "nd"}]}], "}"}]}], "}"}], ",", 
          RowBox[{"DashPattern", "\[Rule]", 
           RowBox[{"{", 
