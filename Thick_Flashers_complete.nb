Cell[TextData[{
 "RenderTile[{PolygonOffsetTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629846800932115*^9, 3.6298468039631968`*^9}, 
   3.707838839661014*^9},ExpressionUUID->"f6d090b8-db23-4c14-b216-\
e064ae14c223"],

Cell[TextData[{
 "RenderTile[{PolygonOffsetTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraph2DAssigned+TTwistGraph for the folded form of a unit \
polygon twist. So it contains Vertices for the CP and Vertices2D for the FF, \
but note that they are at different scale, so as to fit within the same tile. \
That is, the FF is not actually what you\[CloseCurlyQuote]d get if you folded \
the CP, but rather, it is the equivalent folded form tile."
}], "Text",
 CellChangeTimes->{{3.4577256920561132`*^9, 3.4577257049238033`*^9}, {
   3.4577412006642714`*^9, 3.457741207355151*^9}, 3.4851968678273377`*^9, 
   3.533683689283862*^9, {3.59221513440875*^9, 3.5922151482539787`*^9}, 
