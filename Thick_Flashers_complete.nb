  3.706915773876408*^9, 
  3.706915784147986*^9}},ExpressionUUID->"2b8de3bb-a8f3-42c0-b38f-\
2f3dda07a346"],

Cell[CellGroupData[{

Cell["\<\
TObj class: TTriangulated
\tMixin with: TGraph or any subclass\
\>", "Subsubsection",
 CellChangeTimes->{{3.706915712042938*^9, 3.70691574579619*^9}, {
  3.706915778500045*^9, 3.706915782763913*^9}, {3.706915994845371*^9, 
  3.706915995286167*^9}},ExpressionUUID->"2700bd09-10cb-4af3-bfbe-\
70a754b5e659"],

Cell["\<\
TTriangulated is a mixin class that can be used to triangulate any TGraph, \
TGraph2D, or TGraph3D.\
\>", "Text",
 CellChangeTimes->{{3.706915754451635*^9, 3.706915756172189*^9}, {
  3.706915788700417*^9, 
  3.70691581121285*^9}},ExpressionUUID->"a137ccbe-fec8-46e1-964f-\
a1d332add81d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TTriangulated", "::", "usage"}], "=", 
   "\[IndentingNewLine]", "\"\<TTriangulated is a TObj class that describes a \
TGraph that has been triangulated.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.706915812922759*^9, 3.70691582370035*^9}, {
  3.70691588514936*^9, 3.706915918669729*^9}, {3.706915950333806*^9, 
  3.706915951246025*^9}, {3.706916496331411*^9, 3.706916496521858*^9}},
