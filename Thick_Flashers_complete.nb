 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.689257735470812*^9, 3.689257748873077*^9}, {
  3.689258122724386*^9, 
  3.689258126250349*^9}},ExpressionUUID->"ed56b030-674b-4f39-8757-\
3860d5ef3ef7"],

Cell[TextData[{
 "InvisibleSphere[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] produces a Sphere centered at ",
 StyleBox["p",
  FontSlant->"Italic"],
 " of radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 " styled to be invisible. This is useful in Graphics3D used inside of \
Manipulate; if your sphere is large enough to enclose everything over the \
entire range of motion, then the bounding box will remain fixed and give \
smoother motion."
}], "Text",
 CellChangeTimes->{{3.6892577519306602`*^9, 3.689257912620267*^9}, {
  3.689257959124658*^9, 
  3.68925796919905*^9}},ExpressionUUID->"5302214b-c6bb-4254-9405-\
aa923d1d14d9"],

Cell[TextData[{
 "InvisibleSphere[p] produces an invisible unit Sphere centered at ",
 StyleBox["p",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.6892581324358177`*^9, 
  3.68925815448405*^9}},ExpressionUUID->"757ef5d2-5176-4770-867b-\
03e444e72fe8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InvisibleSphere", "[", 
   RowBox[{"p_List", ",", 
    RowBox[{"r_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Style", "[", 
   RowBox[{
    RowBox[{"Sphere", "[", 
     RowBox[{"p", ",", "r"}], "]"}], ",", 
    RowBox[{"Opacity", "[", "0", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.689257988319848*^9, 3.689258027862462*^9}},
 CellLabel->
  "In[876]:=",ExpressionUUID->"e69bde0a-a9cd-4d51-8426-d13c84857238"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "InvisibleCube[",
 StyleBox["p",
  FontSlant->"Italic"],
 "]\nInvisibleCube[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.689258032370112*^9, 3.689258059894987*^9}, {
  3.689258208523223*^9, 
  3.689258211861252*^9}},ExpressionUUID->"945aa16b-e713-4c8c-bdb9-\
f3f2cb7f5143"],

Cell[TextData[{
 "InvisibleCube[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] produces the equivalent of an invisible cube at ",
 StyleBox["p",
  FontSlant->"Italic"],
 " of semiedge ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", i.e., edge length 2",
 StyleBox["r",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.689258062025824*^9, 3.689258065606851*^9}, {
  3.689258107750719*^9, 3.689258117540709*^9}, {3.68925817039095*^9, 
  3.689258194933281*^9}, {3.6892582457025137`*^9, 
  3.689258275701178*^9}},ExpressionUUID->"8cbd1a4b-aaa1-47f9-b887-\
fc4c5cef8935"],

Cell[TextData[{
 "InvisibleCube[",
 StyleBox["p",
  FontSlant->"Italic"],
 "] produces the equivalent of an invisible cube at ",
 StyleBox["p",
  FontSlant->"Italic"],
 " of semiedge 1, i.e., edge length 2."
}], "Text",
 CellChangeTimes->{{3.689258062025824*^9, 3.689258065606851*^9}, {
  3.689258107750719*^9, 3.689258117540709*^9}, {3.68925817039095*^9, 
  3.689258272287891*^9}},ExpressionUUID->"5cfb8fbd-d722-4e7f-9a47-\
2a5a1900bb50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InvisibleCube", "[", 
   RowBox[{"p_List", ",", 
    RowBox[{"r_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"#", ",", 
      RowBox[{"PointSize", "[", "0", "]"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Point", "[", 
      RowBox[{"p", "+", 
       RowBox[{"{", 
        RowBox[{"i", ",", "j", ",", "k"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}]}], "]"}]}]}]], "Input",\

 CellChangeTimes->{{3.689257988319848*^9, 3.689258027862462*^9}, {
  3.6892582898668127`*^9, 3.689258312946814*^9}, {3.689258346465835*^9, 
  3.689258368999392*^9}, {3.689258534890669*^9, 3.689258537912909*^9}, {
  3.68925860092085*^9, 3.689258601392027*^9}},
 CellLabel->
  "In[877]:=",ExpressionUUID->"096897bc-cf24-4388-ae73-9a6faad3921f"],

