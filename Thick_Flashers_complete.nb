6d3e23aec469"],

Cell[TextData[{
 "ThickFlasherFoldAnglesFF[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] constructs a list of the fold angles of the folded form (stowed pattern) \
of the embedded zero-thickness surface of a thick flasher computed by \
MakeThickFlasher. Boundary edges have a fold angle of zero by definition."
}], "Text",
 CellChangeTimes->{{3.917279974060701*^9, 3.917280020104914*^9}, {
  3.917280116843063*^9, 
  3.9172801343299313`*^9}},ExpressionUUID->"037de837-5d56-4dd9-8488-\
a07c07ea7d70"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TGraph3DAssigned returned by MakeThickFlasher."
}], "Text",
 CellChangeTimes->{{3.912453166178551*^9, 
  3.912453187664131*^9}},ExpressionUUID->"42c2ca96-c052-4896-bfcd-\
7de596c52ba3"],

Cell["\<\
Returns: a list of the fold angles for all edges for the folded form (stowed \
