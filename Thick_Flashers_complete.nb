Cell["\<\
These functions are useful for obtaining the size of elements in Graphics \
objects if you want to scale them, combine them side-by-side into a single \
object, etc.\
\>", "Text",
 CellChangeTimes->{{3.643207843551323*^9, 
  3.643207873741818*^9}},ExpressionUUID->"46e7ba66-6a2e-40d0-9de1-\
2584048f4e3d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "GraphicsBoundingBox[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]\n",
 "GraphicsExtent",
 "[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.45752984191953*^9, 3.457529842215247*^9}, {
   3.473428951355218*^9, 3.4734289600562487`*^9}, {3.473429021484208*^9, 
   3.473429027611996*^9}, {3.473429090296402*^9, 3.4734290939511957`*^9}, {
   3.5922133844248443`*^9, 3.5922133881817293`*^9}, {3.5922139159869423`*^9, 
   3.592213936154175*^9}, 3.62878644004578*^9, 
   3.628786495041885*^9},ExpressionUUID->"e34d57fa-3bb3-413e-a197-\
658fb0c99340"],

Cell[TextData[{
 "GraphicsBoundingBox",
 "[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] returns a list {{",
 StyleBox["xmin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xmax",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["ymin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ymax",
  FontSlant->"Italic"],
 "}} of the bounding box for all the Point, Line, and Polygon objects in ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ". If there are no objects, it returns an empty list."
}], "Text",
 CellChangeTimes->{{3.473428964495659*^9, 3.473429010972677*^9}, {
   3.592213225151321*^9, 3.592213232303598*^9}, 3.592213916044816*^9, 
   3.6287864401075573`*^9, {3.803895572505692*^9, 
   3.803895581649134*^9}},ExpressionUUID->"47ed7826-584c-49c5-88b7-\
a45e877eaa2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GraphicsBoundingBox", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "pts", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr", "/.", 
      RowBox[{
       RowBox[{"Point", "[", "x_", "]"}], "\[RuleDelayed]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"pts", ",", "x"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr", "/.", 
      RowBox[{
       RowBox[{"Line", "[", "x_", "]"}], "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"pts", ",", "#"}], "]"}], "&"}], "/@", "x"}], ")"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"expr", "/.", 
      RowBox[{
       RowBox[{"Polygon", "[", "x_", "]"}], "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"pts", ",", "#"}], "]"}], "&"}], "/@", "x"}], ")"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "pts", "]"}], ",", 
       RowBox[{"{", "}"}], ",", 
       RowBox[{"BoundingBox", "[", "pts", "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.457529852227374*^9, 3.4575298562981253`*^9}, {
   3.473429047043412*^9, 3.473429075950234*^9}, {3.473429286622755*^9, 
