   3.912252765309927*^9, 3.912252766589542*^9}, {3.912252808456509*^9, 
   3.912252810980138*^9}, {3.912253713936645*^9, 3.912253716238391*^9}, {
   3.912254123661696*^9, 3.912254154426799*^9}, {3.912257491363227*^9, 
   3.91225752064164*^9}, 3.91234673933003*^9, 3.912574879100521*^9, {
   3.912574948805365*^9, 3.912574965385092*^9}, {3.912575001423009*^9, 
