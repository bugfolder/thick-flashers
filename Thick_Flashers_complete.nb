Cell[TextData[{
 "MakeTYoshimuraOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}]\n\t(checked classes) TVertex"
}], "Subsubsection",
 CellChangeTimes->{{3.616178275925315*^9, 3.616178284859013*^9}, {
   3.616178866072078*^9, 3.616178886636874*^9}, {3.616179067633107*^9, 
