                RowBox[{"ll", "[", "t0", "]"}], ",", 
                RowBox[{"uu", "[", "t0", "]"}], ",", 
                RowBox[{"DarbouxVectorLength", "\[Rule]", "dr"}]}], "]"}], ",",
               "\[IndentingNewLine]", 
