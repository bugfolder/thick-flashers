Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAcrossRight3D", "[", 
   RowBox[{"ff_Function", ",", "rrL_Function", ",", "opts___"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "csys", ",", "dff", ",", 
      "ds", ",", "tt", ",", "nn", ",", "bb", ",", "uuL", ",", "llL", ",", 
      "c\[Rho]L", ",", "s\[Rho]L", ",", "c\[Eta]L", ",", "s\[Eta]L", ",", 
      "c\[Eta]R", ",", "s\[Eta]R", ",", "uuR", ",", "llR", ",", "duuR", ",", 
      "mduuR", ",", "\[Kappa]g", ",", "\[Kappa]n", ",", "\[Tau]g", ",", 
      "c\[Rho]R", ",", "s\[Rho]R", ",", "rrR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAcrossRight3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAcrossRight3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "curve", " ", "fold", " ", "system", " ", "and", " ", "Frenet", " ", 
       "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"ff", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
         "BinormalVector3D"}], "}"}], "/.", "csys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"txr", "=", 
             RowBox[{
              RowBox[{"tt", "[", "s", "]"}], "\[Cross]", 
              RowBox[{"rrL", "[", "s", "]"}]}]}], "}"}], ",", 
           RowBox[{"NormalizeReal", "[", "txr", "]"}]}], "]"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"llL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"uuL", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"tt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"rrL", "[", "s", "]"}], ".", 
          RowBox[{"tt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"rrL", "[", "s", "]"}], ".", 
          RowBox[{"llL", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Eta]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"llL", "[", "s", "]"}], ".", 
          RowBox[{"nn", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Eta]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"uuL", "[", "s", "]"}], ".", 
          RowBox[{"nn", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"s\[Eta]L", "[", "s", "]"}]}], 
           RowBox[{"nn", "[", "s", "]"}]}], "+", 
          RowBox[{
           RowBox[{"c\[Eta]L", "[", "s", "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"llR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"c\[Eta]L", "[", "s", "]"}], 
           RowBox[{"nn", "[", "s", "]"}]}], "+", 
          RowBox[{
           RowBox[{"s\[Eta]L", "[", "s", "]"}], 
           RowBox[{"bb", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"uuR", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"mduuR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"duuR", "[", "s", "]"}], "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"duuR", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
          FractionBox[
           RowBox[{
            RowBox[{"duuR", "[", "s", "]"}], ".", 
            RowBox[{"llR", "[", "s", "]"}]}], 
           RowBox[{"mduuR", "[", "s", "]"}]]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"duuR", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
          RowBox[{"mduuR", "[", "s", "]"}]], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"c\[Rho]R", "[", "s", "]"}], 
           RowBox[{"tt", "[", "s", "]"}]}], "-", 
          RowBox[{
           RowBox[{"s\[Rho]R", "[", "s", "]"}], 
           RowBox[{"llR", "[", "s", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
