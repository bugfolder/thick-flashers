     RowBox[{"u", ",", "v", ",", "bb", ",", "cc", ",", "ccc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"Cos", "[", "#1", "]"}]}], ",", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"Sin", "[", "#1", "]"}]}], ",", 
         FractionBox["#1", "2"]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Cos", "[", "#1", "]"}], "+", 
            RowBox[{
             RowBox[{"Sin", "[", "#1", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"#1", "-", "#2"}], ")"}]}]}], ")"}]}], ",", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          SqrtBox["3"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sin", "[", "#1", "]"}], "+", 
            RowBox[{
             RowBox[{"Cos", "[", "#1", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "#1"}], "+", "#2"}], ")"}]}]}], ")"}]}], ",", 
         FractionBox["#2", "2"]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ccc", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"u", "\[LessEqual]", "v"}], ",", 
          RowBox[{"cc", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"bb", "[", "u", "]"}]}], "]"}], ",", 
