Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SectorVectors", "::", "usage"}], 
   "=", "\"\<SectorVectors is a TObj property that specifies the 3D vectors \
normal to the sector angle (face) planes around a vertex.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592075703941037*^9, 3.592075755317908*^9}, {
   3.592075811501129*^9, 3.592075831420706*^9}, 3.592435753337103*^9},
