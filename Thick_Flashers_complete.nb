       RowBox[{"{", 
        RowBox[{"i", ",", "nb"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
