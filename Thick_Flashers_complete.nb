 CellLabel->
  "In[2290]:=",ExpressionUUID->"174d17bd-d6e4-4ce4-a3e7-f8148d3f58c6"],

Cell[TextData[{
 "MajorFirstBindingDihedralAngles",
 "[",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "4679fda3-be6e-4329-b718-9b4968cba8e5"],
 "] takes a major-first list of four sector angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "45c81170-54ce-4ca6-beac-19316ed26499"],
 "and returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], ",", 
     SubscriptBox["\[Gamma]", "2"], ",", 
     SubscriptBox["\[Gamma]", "3"], ",", 
     SubscriptBox["\[Gamma]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "fd962a54-9ae4-4bb9-8834-eb390dcc6db0"],
 " of the magnitude of the angles for all four dihedral angles at the point \
of binding (signs would be determined by the specific crease assignment of \
the major folds, of course). It returns \[Pi] if the fold can fully fold, \
less otherwise.  The vertex is assumed to be valley-like, i.e., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "44ef96d8-baf3-4076-9752-4778ee1f52e6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "77e45c65-3f23-4b40-af63-806c77f394d4"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "4"], TraditionalForm]],ExpressionUUID->
  "6eeaad88-a61c-434d-9c98-5b4082bec6c4"],
 " are positive, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "3"], TraditionalForm]],ExpressionUUID->
  "87215992-90b6-4028-8785-441695b6cd3b"],
 " is negative."
}], "Text",
 CellChangeTimes->{{3.6172734842813873`*^9, 3.617273527290641*^9}, 
   3.617307999980966*^9, {3.6173095508078756`*^9, 3.617309570574632*^9}, {
   3.617310327976358*^9, 3.617310343998301*^9}, {3.617313456098721*^9, 
   3.61731346672082*^9}, {3.617434451738997*^9, 3.617434459092127*^9}, {
   3.6174345577046833`*^9, 3.617434562802997*^9}, 
   3.6174363630588*^9},ExpressionUUID->"5a2ee76e-957d-4b67-8aa2-698f522f9876"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MajorFirstBindingDihedralAngles", "[", 
   RowBox[{"{", 
    RowBox[{
    "\[Alpha]1_", ",", "\[Alpha]2_", ",", "\[Alpha]3_", ",", "\[Alpha]4_"}], 
    "}"}], "]"}], ":=", 
  RowBox[{"RotateRight", "[", 
   RowBox[{
    RowBox[{"MinorFirstBindingDihedralAngles", "[", 
     RowBox[{"{", 
      RowBox[{
      "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4", ",", "\[Alpha]1"}], 
      "}"}], "]"}], ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.617273533484493*^9, 3.617273534066185*^9}, {
   3.617273657679604*^9, 3.617273738999488*^9}, {3.617307512118289*^9, 
