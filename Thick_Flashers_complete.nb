Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CanonicalDevelopableSystem", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.68980816965057*^9, 3.689808183674678*^9}, 
   3.690988494021354*^9, 3.691161081339386*^9, 3.691365870681203*^9, 
   3.691955081705477*^9, 3.69195534322987*^9, 3.691956195614176*^9},
 CellLabel->
  "In[3832]:=",ExpressionUUID->"964dd448-ccd6-4da2-8913-f03b2888e057"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonicalDevelopableSystem", "[", 
   RowBox[{"bbf_Function", ",", "ddf_Function", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "sfn", ",", "u", ",", "v", ",", "bb", ",", "dbb", ",",
       "ddd", ",", "dim", ",", "ds", ",", "dd", ",", "ss", ",", "al", ",", 
      "alf", ",", "cc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CanonicalDevelopableSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CanonicalDevelopableSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "\[Element]", "Reals"}], ",", 
           RowBox[{"v", "\[Element]", "Reals"}]}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"bbf", "[", "u", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "directrix", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ddf", "[", "u", "]"}], "/", 
        RowBox[{"Mag", "[", 
         RowBox[{"ddf", "[", "u", "]"}], "]"}]}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"director", ",", " ", 
       RowBox[{"now", " ", "normalized"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dbb", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"bb", ",", "u"}], "]"}], "//", "sfn"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"ddd", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"dd", ",", "u"}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{"Length", "[", "bb", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ddd", "===", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "dim", "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Print", "[", "\"\<CYLINDER\>\"", "]"}], "//", "Hold"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"bb", "=", 
         RowBox[{
          RowBox[{"bb", "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"bb", ".", "dd"}], ")"}], "dd"}]}], "//", "sfn"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"cc", "=", 
         RowBox[{
          RowBox[{"bb", " ", "+", " ", 
           RowBox[{"v", " ", "dd"}]}], "//", "sfn"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Print", "[", "\"\<CONE OR TANDEV\>\"", "]"}], "//", 
         "Hold"}], ";", "\[IndentingNewLine]", 
        RowBox[{"bb", "=", 
         RowBox[{
          RowBox[{"bb", "-", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{"dbb", ".", "ddd"}], 
              RowBox[{"ddd", ".", "ddd"}]], ")"}], "dd"}]}], "//", "sfn"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"dbb", "=", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"bb", ",", "u"}], "]"}], "//", "sfn"}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dbb", "===", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", "dim", "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Print", "[", "\"\<CONE\>\"", "]"}], "//", "Hold"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"cc", "=", 
            RowBox[{
             RowBox[{"bb", "+", 
              RowBox[{"v", " ", "dd"}]}], "//", "sfn"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Print", "[", "\"\<TANDEV\>\"", "]"}], "//", "Hold"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"ds", "=", 
            RowBox[{
             RowBox[{"Mag", "[", "dbb", "]"}], "//", "sfn"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"al", "=", 
            RowBox[{
             RowBox[{"Integrate", "[", 
              RowBox[{"ds", ",", "u"}], "]"}], "//", "sfn"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"arc", " ", "length", " ", "of", " ", "directrix"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"alf", "=", 
            RowBox[{"FunctionizeOld", "[", 
             RowBox[{"al", ",", "u"}], "]"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{"arc", " ", "length", " ", "function"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"cc", "=", 
            RowBox[{
             RowBox[{"bb", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"alf", "[", "v", "]"}], "-", 
                 RowBox[{"1", 
                  RowBox[{"alf", "[", "u", "]"}]}]}], ")"}], "dd"}]}], "//", 
             "sfn"}]}], ";"}]}], 
         RowBox[{"(*", " ", 
          RowBox[{"cross", " ", "curve", " ", "surface"}], " ", "*)"}], 
         "\[IndentingNewLine]", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"bb", "+", 
        RowBox[{"v", " ", "dd"}]}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Directrix", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"bb", ",", "u"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Director", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"dd", " ", ",", "u"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"DevelopableSurface", " ", "\[Rule]", " ", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"ss", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"CrossCurveSurface", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"cc", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]",
       "}"}]}]}], "]"}]}]], "Input",
