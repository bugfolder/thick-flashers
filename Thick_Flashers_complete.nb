   3.936105558511387*^9},ExpressionUUID->"30cee361-b909-4248-b6d7-\
edb15852b10d"],

Cell[TextData[{
 "MakeHingeSamples[",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a set of hinged panels consisting of a square panel plus hinges \
on both left and right connecting vertically oriented panels."
}], "Text",
 CellChangeTimes->{{3.9361055677442083`*^9, 3.9361055762372828`*^9}, {
  3.9361056079264097`*^9, 
  3.936105642613428*^9}},ExpressionUUID->"d5e857ca-ae5c-49c0-a7e8-\
22ba1cf5685b"],

Cell["\<\
Arguments:
\ta \[LongDash] the width and length of the middle square panel and the width \
of the vertical panels.
\tb \[LongDash] the height of the vertical panels.
\tt \[LongDash] the thickness of all panels.\
\>", "Text",
 CellChangeTimes->{{3.9361056457646646`*^9, 
  3.936105678093019*^9}},ExpressionUUID->"42c35522-6535-4b88-92ea-\
e8f9569ebd62"],

Cell["\<\
Options:
\tOptions[MakeHingeGC] are passed through. You can create examples of all \
types of hinges.\
\>", "Text",
 CellChangeTimes->{{3.9361056833969*^9, 
  3.936105752510666*^9}},ExpressionUUID->"0bc1ce72-bd3d-4241-a31c-\
aa7e2fdb0be5"],

Cell["\<\
Returns: a list of GraphicsComplex objects that represent both the panels and \
the hinges.\
\>", "Text",
 CellChangeTimes->{{3.936105754678397*^9, 
  3.936105769165433*^9}},ExpressionUUID->"038972f3-8a46-4a0a-9301-\
3fa7d6146793"],

Cell["\<\
You must specify PanelClearance and HingeThickness explicitly.\
\>", "Text",
 CellChangeTimes->{{3.93317141862532*^9, 3.933171437872695*^9}, {
   3.9331729880703487`*^9, 3.933173001029524*^9}, 
   3.936105777391588*^9},ExpressionUUID->"259e4750-7c47-448f-913f-\
c458241195e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeHingeSamples", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PanelClearance", "->", "0.4"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeThickness", "->", "0.2"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.933171502901018*^9, 3.933171543107595*^9}, 
   3.933171964964746*^9, {3.93317243424126*^9, 3.933172436791183*^9}, 
   3.933175875734458*^9, 3.93317601158517*^9, 3.936105558512795*^9, {
   3.936105706649198*^9, 3.9361057101053257`*^9}},
 CellLabel->
  "In[4372]:=",ExpressionUUID->"1af2aa53-2d3c-4781-9d7b-ab5d4377938f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeHingeSamples", "[", 
   RowBox[{"a_", ",", "b_", ",", "t_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pc", ",", "ht", ",", "hth", ",", "polys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pc", ",", "ht"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"PanelClearance", ",", "HingeThickness"}], "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeHingeSamples", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hth", "=", 
      RowBox[{"0.5", "ht"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ExtrudeGC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "a"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "a"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "t"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ExtrudeGC", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "t"}], "-", "pc"}], ",", "0"}], "}"}], "+", "#"}],
            "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "a"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "a"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"t", "-", "ht"}], ",", 
           RowBox[{"t", "-", "ht", "+", "b"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ExtrudeGC", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], "t"}], "-", 
               RowBox[{"2", "pc"}]}], ",", "0"}], "}"}], "+", "#"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "a"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "a"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"t", "-", "ht"}], ",", 
           RowBox[{"t", "-", "ht", "+", "b"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ExtrudeGC", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"-", "3"}], "t"}], "-", 
               RowBox[{"3", "pc"}]}], ",", "0"}], "}"}], "+", "#"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "a"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "a"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"t", "-", "ht"}], ",", 
           RowBox[{"t", "-", "ht", "+", "b"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ExtrudeGC", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "+", "pc"}], ",", "0"}], "}"}], "+", "#"}], "&"}], 
          "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "a"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "a"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"t", "-", "ht"}], ",", 
           RowBox[{"t", "-", "ht", "+", "b"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ExtrudeGC", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "+", 
               RowBox[{"2", "pc"}], "+", "t"}], ",", "0"}], "}"}], "+", "#"}],
            "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "a"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "a"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"t", "-", "ht"}], ",", 
           RowBox[{"t", "-", "ht", "+", "b"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ExtrudeGC", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "+", 
               RowBox[{"3", "pc"}], "+", 
               RowBox[{"2", "t"}]}], ",", "0"}], "}"}], "+", "#"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "a"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "a"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"t", "-", "ht"}], ",", 
           RowBox[{"t", "-", "ht", "+", "b"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"MakeHingeGC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "pc"}], ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "pc"}], ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", "opts"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"MakeHingeGC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "pc"}], "-", "t"}], ",", "0", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "pc"}], "-", "t"}], ",", "a", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "pc"}], "-", "t"}], ",", "0", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "pc"}], "-", "t"}], ",", "a", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}]}], "}"}], ",", 
         "opts"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"MakeHingeGC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "3"}], "pc"}], "-", 
              RowBox[{"2", "t"}]}], ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "3"}], "pc"}], "-", 
              RowBox[{"2", "t"}]}], ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "pc"}], "-", 
              RowBox[{"2", "t"}]}], ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "pc"}], "-", 
              RowBox[{"2", "t"}]}], ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", "opts"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"MakeHingeGC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", "pc"}], ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", "pc"}], ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", "opts"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"MakeHingeGC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", "pc", "+", "t"}], ",", "0", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", "pc", "+", "t"}], ",", "a", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", 
              RowBox[{"2", "pc"}], "+", "t"}], ",", "0", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", 
              RowBox[{"2", "pc"}], "+", "t"}], ",", "a", ",", 
             RowBox[{"t", "-", 
              RowBox[{"3", "hth"}], "+", "b"}]}], "}"}]}], "}"}], ",", 
         "opts"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"MakeHingeGC", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", 
              RowBox[{"2", "pc"}], "+", 
              RowBox[{"2", "t"}]}], ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", 
              RowBox[{"2", "pc"}], "+", 
              RowBox[{"2", "t"}]}], ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", 
              RowBox[{"3", "pc"}], "+", 
              RowBox[{"2", "t"}]}], ",", "0", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", 
              RowBox[{"3", "pc"}], "+", 
              RowBox[{"2", "t"}]}], ",", "a", ",", 
             RowBox[{"t", "-", "hth"}]}], "}"}]}], "}"}], ",", "opts"}], 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.933171444500751*^9, 3.933171459729926*^9}, {
  3.933171491128932*^9, 3.933171499642456*^9}, {3.933171550196847*^9, 
  3.9331715921062593`*^9}, {3.93317177307833*^9, 3.9331717908947887`*^9}, {
  3.933171826877583*^9, 3.933171918544105*^9}, {3.933171949657053*^9, 
  3.9331719549810534`*^9}, {3.93317199508284*^9, 3.933171999778036*^9}, {
  3.9331720355969048`*^9, 3.93317216933296*^9}, {3.93317221843956*^9, 
  3.933172360545298*^9}, {3.9331727263082542`*^9, 3.933172830439411*^9}, {
  3.933172861136462*^9, 3.9331729629443893`*^9}, {3.933173012024974*^9, 
  3.933173028505563*^9}, {3.933175875736278*^9, 3.933175875737937*^9}, {
  3.933175987303087*^9, 3.933176017046283*^9}, {3.93317606238533*^9, 
  3.933176178964795*^9}, {3.936105558515006*^9, 3.9361055585169373`*^9}},
 CellLabel->
  "In[4373]:=",ExpressionUUID->"059fdc5e-1493-4b83-b306-b327133f2634"],

Cell["Example. Basic membrane hinges.", "Text",
 CellChangeTimes->{{3.93317179636504*^9, 3.933171797446409*^9}, {
  3.9361058219362297`*^9, 
  3.936105825726386*^9}},ExpressionUUID->"3324bebe-5ecf-424f-9761-\
1729deb7fabf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics3D", "[", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"MakeHingeSamples", "[", 
       RowBox[{"10", ",", "5", ",", "2", ",", "\[IndentingNewLine]", 
        RowBox[{"PanelClearance", "->", "0.4"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeThickness", "->", "0.2"}]}], "\[IndentingNewLine]", 
       "]"}], ",", "SolidStyle"}], "]"}], ",", 
    RowBox[{"Axes", "->", "True"}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.933171801396469*^9, 3.933171808254175*^9}, {
   3.933171934160089*^9, 3.9331719826061373`*^9}, 3.93317211561339*^9, {
   3.933172653505473*^9, 3.933172677554904*^9}, 3.9331758757387867`*^9, 
   3.933176018693391*^9, 3.93610555851746*^9, {3.936105792676927*^9, 
   3.9361058172449102`*^9}, {3.936105981443116*^9, 3.936105983554813*^9}},
 CellLabel->
  "In[4374]:=",ExpressionUUID->"690ed1d7-7841-49ff-9677-9fed6f81fab9"],

Cell["Example. Rectangular multiwire hinges.", "Text",
 CellChangeTimes->{{3.93317179636504*^9, 3.933171797446409*^9}, {
  3.9361058219362297`*^9, 
  3.936105841190415*^9}},ExpressionUUID->"78c7d08c-d214-4e93-8c2e-\
c90128aeab67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics3D", "[", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"MakeHingeSamples", "[", 
       RowBox[{"10", ",", "5", ",", "2", ",", "\[IndentingNewLine]", 
        RowBox[{"PanelClearance", "->", "0.4"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeThickness", "->", "0.2"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeType", "->", "HingeMultiWireGC"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"HingeWireWidth", "->", "2.5"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeNumWires", "->", "100"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeMinWireGap", "->", "1"}]}], "\[IndentingNewLine]", 
       "]"}], ",", "SolidStyle"}], "]"}], ",", 
    RowBox[{"Axes", "->", "True"}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.933171801396469*^9, 3.933171808254175*^9}, {
   3.933171934160089*^9, 3.9331719826061373`*^9}, 3.93317211561339*^9, {
   3.933172653505473*^9, 3.933172677554904*^9}, 3.9331758757387867`*^9, 
   3.933176018693391*^9, 3.93610555851746*^9, {3.936105792676927*^9, 
   3.936105934142021*^9}, {3.936105986936534*^9, 3.93610598872672*^9}},
 CellLabel->
  "In[4375]:=",ExpressionUUID->"404fed06-d96b-4cdb-bbda-759672ebb53d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Bendy hinged mechanisms", "Subsection",
 CellChangeTimes->{{3.914838424345704*^9, 3.9148384563426237`*^9}, {
   3.915803714178024*^9, 3.915803716365155*^9}, 3.922631164985509*^9, {
   3.922632312754208*^9, 3.9226323133304167`*^9}, {3.934726816015027*^9, 
   3.9347268173429728`*^9}},ExpressionUUID->"49086abf-2731-4023-b4c6-\
0dca3615d17f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.914838459491023*^9, 
  3.914838459963175*^9}},ExpressionUUID->"fea7b8d6-cf8b-4059-8bdf-\
4c78fae155b8"],

Cell["\<\
These functions are used to create a hinged mechanism from a collection of \
slightly-non-touching panels  and a TObj that represents the Embedded \
Zero-Thickness Surface (EZTS) on which the panels are placed. We create \
hinges that join edges of the panels according to the topology of the EZTS \
TObj, optionally incorporating some adjustments to help make them \
3D-printable.\
\>", "Text",
 CellChangeTimes->{{3.914838463024096*^9, 3.9148385624538193`*^9}, {
  3.922308018904101*^9, 3.922308045923847*^9}, {3.922631181314105*^9, 
  3.9226311824408693`*^9}},ExpressionUUID->"fb54079e-4086-4ecf-b215-\
64f1f48d3526"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
HingeShift
HingeShiftTolerance\
\>", "Subsubsection",
 CellChangeTimes->{{3.915799523341834*^9, 
  3.915799529278714*^9}},ExpressionUUID->"31677552-aca5-46e6-9d68-\
c4382e728012"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeShift", "::", "usage"}], 
   "=", "\"\<HingeShift is an option to HingeJoinPanels that specifies \
whether to shift hinges to be coplanar (or nearly so) with adjacent panel \
faces.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.915799530702497*^9, 3.915799574256145*^9}},
 CellLabel->
  "In[4376]:=",ExpressionUUID->"90ca14bf-6d05-4cbf-84f6-d95529cc668a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeShiftTolerance", "::", "usage"}], 
   "=", "\"\<HingeShiftTolerance is an option to HingeJoinPanels that \
specifies how close two surfaces need to be in angle to be considered \
coplanar.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.915799577724289*^9, 3.915799615781616*^9}},
 CellLabel->
  "In[4377]:=",ExpressionUUID->"a0c2cdc7-2584-441d-8381-d9b5cef98d64"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "HingeJoinPanels[",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HingeThickness, HingeShift, HingeShiftTolerance, \
Options[MakeHingeGC]"
}], "Subsubsection",
 CellChangeTimes->{{3.911992511557048*^9, 3.91199256350414*^9}, {
   3.911992612616053*^9, 3.911992622043659*^9}, {3.911994155100019*^9, 
   3.911994161142987*^9}, {3.91200539294808*^9, 3.912005403973561*^9}, {
   3.912178008673173*^9, 3.912178012025175*^9}, {3.912251286850899*^9, 
   3.912251347951091*^9}, 3.913296262697418*^9, 3.9135541876863422`*^9, {
   3.913985350743001*^9, 3.913985351860354*^9}, {3.915797335366123*^9, 
   3.91579734383612*^9}, {3.925729146039648*^9, 
   3.925729150872369*^9}},ExpressionUUID->"ad0139f6-2ff2-4ef8-a8f2-\
f83acaad2693"],

Cell[TextData[{
 "HingeJoinPanels[",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of panels, a TObj that describes an embedded zero-thickness \
surface (EZTS), and some additional information that relates the two, and \
adds 3D hinge polyhedra that connect edges of panels according to the \
information in the embedded zero-thickness surface and some additional panel \
information."
}], "Text",
 CellChangeTimes->{{3.911992656288212*^9, 3.911992662612894*^9}, {
   3.911993764290818*^9, 3.91199388443383*^9}, {3.911993920903912*^9, 
   3.911993926275028*^9}, {3.911994063902663*^9, 3.911994117281125*^9}, {
   3.912005395414098*^9, 3.912005411539344*^9}, {3.912178015792781*^9, 
   3.912178016166047*^9}, {3.913296262726774*^9, 3.9132963337775383`*^9}, {
   3.913985368082251*^9, 3.913985376109625*^9}, {3.922548949903208*^9, 
   3.92254898050381*^9}, {3.922628169125877*^9, 3.922628170918466*^9}, 
   3.925729182790317*^9},ExpressionUUID->"73b3592d-5220-4967-91f4-\
0924dad739f0"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["panels",
  FontSlant->"Italic"],
 " \[LongDash] the list of panels typically scaled to real-world dimensions;\n\
\t",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " \[LongDash] a structured list of index information described below.\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TGraph3DAssigned that describes the embedded zero-thickness \
surface."
}], "Text",
 CellChangeTimes->{{3.911994124360935*^9, 3.911994261392596*^9}, {
  3.912005424921616*^9, 3.912005481584758*^9}, {3.913296349143371*^9, 
  3.913296399189253*^9}, {3.914838749094984*^9, 
  3.9148387911710997`*^9}},ExpressionUUID->"b2f5876d-4d92-48dd-9bfb-\
5ebe002fa77a"],

Cell[TextData[{
 "Options:\n\tHingeThickness \[Rule] ",
 StyleBox["ht | list",
  FontSlant->"Italic"],
 ", the thickness of hinges between connected parts. Providing a list of \
length ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "[Length[Edges]] lets you specify the thickness on an edge-by-edge basis for \
all edges of the ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ".\n\tHingeShift \[Rule] True | False | ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", whether to shift any hinges adjacent to a nearly-parallel panel face to \
lie within the face. Providing a list lets you specify the check and action \
on an edge-by-edge basis.\n\tHingeShiftTolerance \[Rule] \[Eta] | ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", where \[Eta] is the angular tolerance on whether to invoke the hinge \
shift. Providing a list lets you specify the angular tolerance on an \
edge-by-edge basis.\n\tOptions[MakeHingeGC] are passed through."
}], "Text",
 CellChangeTimes->{{3.912178020781704*^9, 3.91217811562254*^9}, {
   3.912178148694954*^9, 3.912178179581933*^9}, {3.912178359190773*^9, 
   3.912178368967973*^9}, {3.912251327729396*^9, 3.912251347974477*^9}, {
   3.912251849396229*^9, 3.912251849462622*^9}, 3.913554187708951*^9, 
   3.913985359394309*^9, {3.915797351933811*^9, 3.915797449635781*^9}, {
   3.915804625321198*^9, 3.915804637022449*^9}, {3.92235341379661*^9, 
   3.9223535520891438`*^9}, {3.922353585136964*^9, 3.922353609320433*^9}, {
   3.922354383548996*^9, 3.922354481917458*^9}, {3.9257291333722363`*^9, 
   3.9257291433672457`*^9}},ExpressionUUID->"e2bee06f-fe4a-42d9-9f65-\
1ee023ab6025"],

Cell[TextData[{
 "Returns: a structured list of GraphicsComplex polyhedra for both the panels \
and the hinges in the form {",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 "}, where ",
 StyleBox["panels",
  FontSlant->"Italic"],
 " is the list of panels as it was input and ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 " is the list of hinges, one list for each edge of the EZTS surface, with \
each list containing one or more GraphicsComplex objects. Note that the hinge \
polyhedra will intersect the panel polyhedra. "
}], "Text",
 CellChangeTimes->{{3.911994321355447*^9, 3.911994379835372*^9}, {
  3.912005512553893*^9, 3.912005513913563*^9}, {3.922373323155707*^9, 
  3.922373348045106*^9}, {3.922567970500309*^9, 3.922567983100405*^9}, {
  3.922568018853706*^9, 3.922568033321714*^9}, {3.9225681048728533`*^9, 
  3.9225681284742727`*^9}, {3.922627976941922*^9, 
  3.922628069068503*^9}},ExpressionUUID->"6b6bb657-6b0b-4ced-a14a-\
8e4deda6f05a"],

Cell[TextData[{
 "There is a one-to-one mapping between the hinges and the EZTS edges; each \
entry in ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 " is a list. if an edge has no hinge, the entry in the list is an empty \
list. This one-to-one correspondence lets you pick out specific hinges if you \
know the index of their corresponding edge in ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{
  3.922627987520718*^9, {3.922628104202093*^9, 
   3.922628130240793*^9}},ExpressionUUID->"1578fa68-2016-4baa-82bf-\
08bf9cfd9e2f"],

Cell[TextData[{
 "The ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " argument is a structured list that establishes the correspondence between ",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", the list of GraphicsComplex panels, and ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", the TObj that describes the EZTS that gives the topology of the mechanism \
and describes the folds that we are creating hinges for. For each panel, the \
corresponding element of ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " is a list of entries of the form {",
 StyleBox["e",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 "}}, where ",
 StyleBox["e",
  FontSlant->"Italic"],
 " is the index of an edge of the ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " that corresponds to some edge of the panel, and {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 "} are the vertex indices of the panel that correspond (respectively) to the \
ordered vertices of edge ",
 StyleBox["e",
  FontSlant->"Italic"],
 " (i.e., in the same order as ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "[Edges]\[LeftDoubleBracket]",
 StyleBox["e",
  FontSlant->"Italic"],
 "\[RightDoubleBracket]). Each element of ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " is a set of these entries, one for each edge of the panel that corresponds \
to an edge of the EZTS described by ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". You don\[CloseCurlyQuote]t need to include entries for boundary edges of \
the EZTS or any other edges that don\[CloseCurlyQuote]t get hinges. Any edges \
that have zero or one {",
 StyleBox["e",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 "}} entries in ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " will be ignored (resulting in an empty list in ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 "); those that have exactly two entries in ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " receive a hinge, i.e., a list of one or more GraphicsComplex objects."
}], "Text",
 CellChangeTimes->{{3.9119968897667513`*^9, 3.911996959285138*^9}, {
   3.911997006220289*^9, 3.911997148383873*^9}, 3.911997187651119*^9, {
   3.912001222444088*^9, 3.9120012940933943`*^9}, {3.912001326143878*^9, 
   3.9120013269772987`*^9}, {3.912004850065068*^9, 3.91200488256297*^9}, {
   3.913553416319351*^9, 3.913553418175283*^9}, {3.91483883522929*^9, 
   3.914838994912235*^9}, {3.915799714283785*^9, 3.9157997329478817`*^9}, {
   3.915803744725965*^9, 3.915803783956319*^9}, {3.922308061088039*^9, 
   3.92230813761128*^9}, {3.922354506293053*^9, 3.922354596412704*^9}, {
   3.922548248238722*^9, 3.922548385867264*^9}, {3.922548424843447*^9, 
   3.922548531554248*^9}, {3.922548564546714*^9, 3.92254858545089*^9}, {
   3.922548767400459*^9, 3.922548809768062*^9}, {3.922549023647601*^9, 
   3.922549128222926*^9}, {3.922628176592557*^9, 
   3.922628310278556*^9}},ExpressionUUID->"5082366d-d515-4133-96f8-\
cd60a0fe988a"],

Cell[TextData[{
 "Note that the ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " structure is also used for pin hinges, where instead of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", we provide a list of ",
 StyleBox["axes",
  FontSlant->"Italic"],
 "; in that case, ",
 StyleBox["e",
  FontSlant->"Italic"],
 " will be the index into the list of axes."
}], "Text",
 CellChangeTimes->{{3.942676388019855*^9, 
  3.942676435210573*^9}},ExpressionUUID->"6784a671-80f7-46d5-8609-\
c6add390b769"],

Cell["\<\
The HingeShift option is used when the hinge is (nearly) parallel with an \
incident panel face. Normally in such circumstances, the hinge would protrude \
by half of its thickness, but if HingeShift \[Rule] True, the hinge end is \
shifted to be approximately coplanar with the surface.\
\>", "Text",
 CellChangeTimes->{{3.915797468027218*^9, 3.915797609513399*^9}, {
  3.9158000352381*^9, 3.915800036157398*^9}, {3.915804643951889*^9, 
  3.915804645047542*^9}, {3.9223546427794323`*^9, 
  3.9223546431804523`*^9}},ExpressionUUID->"2b30bb79-6f64-4e2c-a3b2-\
44aacda76dcf"],

Cell[TextData[{
 "Note that HingeThickness, HingeShift, and HingeShiftTolerance can be \
specified as single values or lists. The list forms of HingeThickness, \
HingeShift, and HingeShiftTolerance require lists that correspond to all \
edges of the ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", but any edges that don\[CloseCurlyQuote]t connect two panels, like \
boundary edges, won\[CloseCurlyQuote]t receive a hinge, so the corresponding \
values in the specification list will be ignored. (There must be values in \
the list, though, to preserve the one-to-one correspondence with EZTS \
edges.)"
}], "Text",
 CellChangeTimes->{{3.922353623052913*^9, 3.922353692608797*^9}, {
  3.922549149772677*^9, 3.922549194085756*^9}, {3.922628338492446*^9, 
  3.9226284037349663`*^9}},ExpressionUUID->"3fe1083b-2bb7-4e66-9224-\
79a44f091a8a"],

Cell[TextData[{
 "Since the return value is a list {",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 "}, you can separately style the groups (for example, by setting different \
opacity) if you want to see how the hinges are embedded between the panels."
}], "Text",
 CellChangeTimes->{{3.9223831022948728`*^9, 3.922383156102833*^9}, {
  3.922628410138298*^9, 
  3.92262841109581*^9}},ExpressionUUID->"f44b0fc4-e737-40df-aa29-\
4e4677ebde7d"],

Cell["\<\
The resulting expression can be exported from Mathematica to STL format for \
3D printing.\
\>", "Text",
 CellChangeTimes->{{3.911994463164815*^9, 3.911994515895692*^9}, 
   3.9225492073087263`*^9},ExpressionUUID->"56d9a0a7-4143-4642-95a4-\
b5e16d7bcc60"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "HingeJoinPanels", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HingeThickness", "->", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeShift", "->", "False"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeShiftTolerance", "->", 
      RowBox[{"10.", "\[Degree]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.912178190894848*^9, 3.912178233525726*^9}, 
   3.912178298413398*^9, {3.912251327740641*^9, 3.912251347982142*^9}, 
   3.913296262769024*^9, 3.91355418771904*^9, 3.913985395886362*^9, {
   3.915799384882142*^9, 3.915799409241654*^9}, 3.915799624158368*^9, 
   3.915802556865137*^9, 3.915802907717209*^9, {3.935404342743732*^9, 
   3.935404343134144*^9}},
 CellLabel->
  "In[4378]:=",ExpressionUUID->"db142ecb-2715-475a-a63b-b43a5f68a24d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HingeJoinPanels", "[", 
   RowBox[{
   "panels_List", ",", "panelinfo_List", ",", "tobj_TObj", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ht", ",", "hs", ",", "hst", ",", "edges", ",", "ne", ",", "einfo", ",", 
      "emap", ",", "epair", ",", "panel1", ",", "panel2", ",", "p1", ",", 
      "p2", ",", "q1", ",", "q2", ",", "hn", ",", "fnorms", ",", "pface", ",",
       "hinges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ht", ",", "hs", ",", "hst"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "HingeThickness", ",", "HingeShift", ",", "HingeShiftTolerance"}], 
         "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HingeJoinPanels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"tobj", "[", "Edges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ne", "=", 
      RowBox[{"Length", "[", "edges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "ht", "]"}], "=!=", "List"}], ",", 
       RowBox[{"ht", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"ht", ",", 
          RowBox[{"{", "ne", "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "hs", "]"}], "=!=", "List"}], ",", 
       RowBox[{"hs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"hs", ",", 
          RowBox[{"{", "ne", "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "hst", "]"}], "=!=", "List"}], ",", 
       RowBox[{"hst", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"hst", ",", 
          RowBox[{"{", "ne", "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Create", " ", "a", " ", "map", " ", "for", " ", "each", " ", "edge", " ",
         "of", " ", "the", " ", "panel", 
        RowBox[{"(", "s", ")"}], " ", "and", " ", "corresponding", " ", 
        "information", " ", "incident", " ", "to", " ", "the", " ", "edge", " ",
         "from", " ", "the", " ", 
        RowBox[{"panelinfo", ".", " ", "For"}], " ", "each", " ", "edge"}], ",",
        " ", 
       RowBox[{
       "we", " ", "create", " ", "up", " ", "to", " ", "two", " ", "entries", 
        " ", "of", " ", "the", " ", "form", " ", 
        RowBox[{"{", 
         RowBox[{"ip", ",", " ", 
          RowBox[{"{", 
           RowBox[{"i1", ",", " ", "i2"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{
       "where", " ", "ip", " ", "is", " ", "the", " ", "index", " ", "of", " ",
         "a", " ", "panel", " ", "that", " ", "is", " ", "incident", " ", 
        "to", " ", "the", " ", "edge", " ", "and", " ", 
        RowBox[{"{", 
         RowBox[{"i1", ",", "i2"}], "}"}], " ", "are", " ", "the", " ", 
        "ordered", " ", "panel", " ", "vertices", " ", "for", " ", "that", " ",
         "edge", " ", "that", " ", "are", " ", "to", " ", "be", " ", 
        "connected", " ", "to", " ", "an", " ", "adjacent", " ", "panel", " ",
         "by", " ", "a", " ", 
        RowBox[{"hinge", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"einfo", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "ne", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"emap", "=", 
         RowBox[{
         "panelinfo", "\[LeftDoubleBracket]", "i", 
          "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "this", " ", "index", " ", "may", " ", "change", " ", "when", " ", 
          "we", " ", "drop", " ", "fsig", " ", "and", " ", "vmap"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"einfo", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
             "}"}]}], "]"}], "&"}], "/@", "emap"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "panelinfo", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Now", " ", "go", " ", "through", " ", "this", " ", "map", " ", "and", 
        " ", "for", " ", "any", " ", "edge", " ", "that", " ", "has", " ", 
        "two", " ", "panel", " ", "entries"}], ",", " ", 
       RowBox[{"construct", " ", "a", " ", 
        RowBox[{"hinge", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"hinges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"epair", "=", 
         RowBox[{
         "einfo", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "epair", "]"}], "!=", "2"}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"hinges", ",", 
             RowBox[{"{", "}"}]}], "]"}], ";", 
           RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"panel1", "=", 
         RowBox[{"panels", "\[LeftDoubleBracket]", 
          RowBox[{"epair", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"panel2", "=", 
         RowBox[{"panels", "\[LeftDoubleBracket]", 
          RowBox[{"epair", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Set", " ", "initial", " ", "values", " ", "for", " ", "the", " ", 
          "hinge", " ", 
          RowBox[{"vertices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2"}], "}"}], "=", 
         RowBox[{"panel1", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", 
           RowBox[{"epair", "\[LeftDoubleBracket]", 
            RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q1", ",", "q2"}], "}"}], "=", 
         RowBox[{"panel2", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", 
           RowBox[{"epair", "\[LeftDoubleBracket]", 
            RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Check", " ", "to", " ", "see", " ", "if", " ", "we", " ", "need", " ",
           "to", " ", "shift", " ", "either", " ", "side", " ", "of", " ", 
          "the", " ", 
          RowBox[{"hinge", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"hs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Hinge", " ", "normal", " ", "vector", " ", 
            RowBox[{"(", 
             RowBox[{"averaged", ",", " ", 
              RowBox[{
              "in", " ", "case", " ", "hinge", " ", "is", " ", "skew"}]}], 
             ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"hn", "=", 
            RowBox[{"NormalizeReal", "[", 
             RowBox[{
              RowBox[{"TriangleNormal3D", "[", 
               RowBox[{"{", 
                RowBox[{"p1", ",", "q1", ",", "q2"}], "}"}], "]"}], "+", 
              RowBox[{"TriangleNormal3D", "[", 
               RowBox[{"{", 
                RowBox[{"p1", ",", "q2", ",", "p2"}], "}"}], "]"}]}], "]"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", "panel1", " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"fnorms", "=", 
            RowBox[{"FaceNormalsGC", "[", "panel1", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"pface", "=", 
               RowBox[{"panel1", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "j", ",", "1"}], 
                "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Limit", " ", "check", " ", "to", " ", "panel", " ", "faces", " ",
                 "that", " ", "contain", " ", "both", " ", "panel", " ", 
                "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"Intersection", "[", 
                   RowBox[{"pface", ",", 
                    RowBox[{"epair", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], "!=",
                  "2"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Check", " ", "the", " ", "alignment", " ", "of", " ", "the", " ",
                 "face", " ", "normals", " ", "and", " ", "shift", " ", 
                "vertices", " ", "if", " ", 
                RowBox[{"appropriate", "."}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"hn", ".", 
                   RowBox[{
                   "fnorms", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}], "]"}], ">=", 
                 RowBox[{"Cos", "[", 
                  RowBox[{
                  "hst", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"p1", "-=", 
                  RowBox[{"0.5", 
                   RowBox[{
                   "ht", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], 
                   RowBox[{
                   "fnorms", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"p2", "-=", 
                  RowBox[{"0.5", 
                   RowBox[{
                   "ht", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], 
                   RowBox[{
                   "fnorms", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Break", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}], "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", 
                RowBox[{
                "panel1", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"panel", " ", "2"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"fnorms", "=", 
            RowBox[{"FaceNormalsGC", "[", "panel2", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"pface", "=", 
               RowBox[{"panel2", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "j", ",", "1"}], 
                "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Limit", " ", "check", " ", "to", " ", "panel", " ", "faces", " ",
                 "that", " ", "contain", " ", "both", " ", "panel", " ", 
                "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"Intersection", "[", 
                   RowBox[{"pface", ",", 
                    RowBox[{"epair", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], "!=",
                  "2"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Check", " ", "the", " ", "alignment", " ", "of", " ", "the", " ",
                 "face", " ", "normals", " ", "and", " ", "shift", " ", 
                "vertices", " ", "if", " ", 
                RowBox[{"appropriate", "."}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"hn", ".", 
                   RowBox[{
                   "fnorms", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}], "]"}], ">=", 
                 RowBox[{"Cos", "[", 
                  RowBox[{
                  "hst", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"q1", "-=", 
                  RowBox[{"0.5", 
                   RowBox[{
                   "ht", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], 
                   RowBox[{
                   "fnorms", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"q2", "-=", 
                  RowBox[{"0.5", 
                   RowBox[{
                   "ht", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], 
                   RowBox[{
                   "fnorms", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"Break", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
               "]"}], ";"}], "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", 
                RowBox[{
                "panel2", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"hinges", ",", 
          RowBox[{"MakeHingeGC", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2"}], "}"}], ",", 
            RowBox[{"Sequence", "@@", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"HingeThickness", "->", 
                 RowBox[{
                 "ht", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}]}], "}"}], ",", 
               RowBox[{"{", "opts", "}"}]}], "]"}]}]}], "]"}]}], "]"}], ";"}],
        "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "ne"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"panels", ",", "hinges"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.912005611471409*^9, 3.912005703724725*^9}, {
   3.912020894949328*^9, 3.912020896356599*^9}, {3.912022526159424*^9, 
   3.9120225318951178`*^9}, {3.91217830332811*^9, 3.912178387818928*^9}, {
   3.912190516110386*^9, 3.9121905385568666`*^9}, {3.912191300089595*^9, 
