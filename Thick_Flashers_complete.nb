Cell[CellGroupData[{

Cell[TextData[{
 "JoinGraphsData[",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.649946250721564*^9, 3.649946267888624*^9}, 
   3.649946317058064*^9, {3.649947274058954*^9, 3.649947274448381*^9}, {
   3.6499515342092943`*^9, 
   3.649951537737292*^9}},ExpressionUUID->"c0975110-aabc-4212-b912-\
c9b74f24cdb0"],

Cell[TextData[{
 "JoinGraphsData[",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 " that describe a list of TGraphs and rearranges them for merging according \
to the information in each ",
 StyleBox["graphspec.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.649946270416518*^9, 3.649946446293384*^9}, {
   3.649946508786581*^9, 3.649946509572444*^9}, {3.649946548878963*^9, 
   3.6499467952642508`*^9}, {3.64994729248547*^9, 3.649947335900647*^9}, {
   3.649947392784791*^9, 3.649947393112605*^9}, {3.649947582349647*^9, 
   3.649947584813387*^9}, 3.649947638950212*^9, {3.649951540802124*^9, 
   3.64995154129749*^9}, {3.707782301796689*^9, 3.707782322039585*^9}, {
   3.707822780035458*^9, 3.70782278129099*^9}, {3.707867791707217*^9, 
   3.707867792553196*^9}},ExpressionUUID->"4eee89b5-6e89-487b-9236-\
38921fefafcd"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["graphspecs",
  FontSlant->"Italic"],
 " \[LongDash] a list of TGraphs together with data specifying their relative \
position."
}], "Text",
 CellChangeTimes->{{3.707822784418241*^9, 
  3.707822818411724*^9}},ExpressionUUID->"979e498a-680d-4244-9904-\
8c975919b26a"],

Cell[TextData[{
 "Returns a list ",
 StyleBox["tglist",
  FontSlant->"Italic"],
 " of repositioned TGraphs suitable for feeding to MergeGraphs. "
}], "Text",
 CellChangeTimes->{{3.707782324145287*^9, 3.7077823472960253`*^9}, {
   3.707822828179002*^9, 3.70782282856389*^9}, 
   3.707905219379644*^9},ExpressionUUID->"b076ebb8-0576-466d-b355-\
5dfdd751f76b"],

Cell[TextData[{
 "Each ",
 StyleBox["graphspec",
  FontSlant->"Italic"],
 " is of the form {",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}}}, where ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is a TGraph and {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}} specify how that graph is to be joined to one of its predecessors in the \
list. The TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " is to be offset, rotated, and scaled so that the vertex pair {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "} of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th TGraph will be the position of the {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "} vertex pair of the transformed ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". The first {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", {",
 StyleBox["j1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["k1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k2",
  FontSlant->"Italic"],
 "}} can be an empty list, because it is ignored."
}], "Text",
 CellChangeTimes->{
  3.7077823051707582`*^9, {3.707822852957839*^9, 
   3.707822853652917*^9}},ExpressionUUID->"c513f3ee-eb5f-44d7-8f77-\
a803e6328232"],

Cell["\<\
See the documentation of JoinTiling below for a similar type of joining.\
\>", "Text",
 CellChangeTimes->{{3.649946512145859*^9, 3.6499465316716013`*^9}, {
  3.649947429038258*^9, 
  3.649947434674571*^9}},ExpressionUUID->"fcc2a5ae-6c37-43ef-9692-\
ed1265fa37d8"],

Cell["\<\
We break the joining process into two steps (see JoinGraphs, next) so that we \
can later implement more complex joining of crease-assigned, 2D, and 3D \
graphs.\
\>", "Text",
 CellChangeTimes->{{3.649947439661511*^9, 
  3.649947491065896*^9}},ExpressionUUID->"cff1fbb2-9bc1-4a6e-b47e-\
4cd6883a0fe7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JoinGraphsData", "[", "graphspecs_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tglist", ",", "i", ",", "j1", ",", "j2", ",", "k1", ",", "k2", ",", 
      "vertsj", ",", "vertsk", ",", "rm", ",", "offset"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tglist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "graphspecs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"AssertClass", "[", 
        RowBox[{"#", ",", "TGraph", ",", "JoinGraphsData"}], "]"}], "&"}], "/@",
       "tglist"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", "j1", ",", "j2", ",", "k1", ",", "k2"}], "}"}], "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"graphspecs", "\[LeftDoubleBracket]", 
           RowBox[{"l", ",", "2"}], "\[RightDoubleBracket]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vertsj", "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "[",
           "Vertices", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vertsk", "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "[",
           "Vertices", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rm", ",", "offset"}], "}"}], "=", 
         RowBox[{"SimilarityPair2D", "[", 
          RowBox[{
           RowBox[{"vertsk", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"k1", ",", "k2"}], "}"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{"vertsj", "\[LeftDoubleBracket]", 
            RowBox[{"{", 
             RowBox[{"j1", ",", "j2"}], "}"}], "\[RightDoubleBracket]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vertsk", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"offset", "+", 
             RowBox[{"rm", ".", "#"}]}], ")"}], "&"}], "/@", "vertsk"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "=", 
         RowBox[{
          RowBox[{
          "tglist", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"Vertices", "\[Rule]", "vertsk"}], "]"}]}]}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "2", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "tglist"}]}], "]"}]}]], "Input",
