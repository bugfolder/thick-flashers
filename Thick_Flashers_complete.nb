   3.5919785751171503`*^9}, {3.591979611357408*^9, 3.591979612445657*^9}, {
   3.591981340172868*^9, 3.591981340206461*^9}, 3.591983729995565*^9, 
   3.592039961862591*^9, {3.592049781492382*^9, 3.592049799044975*^9}, 
   3.592208506694645*^9, 3.592377766830329*^9, {3.592378638763578*^9, 
   3.5923787004535303`*^9}, {3.592380730647951*^9, 3.592380742239319*^9}, 
   3.592435858484644*^9, 3.592647646916857*^9, 3.592648918683517*^9, 
   3.592828718158222*^9, {3.592828772875107*^9, 3.592828772940687*^9}, {
