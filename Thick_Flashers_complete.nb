              RowBox[{"mm", "\[LeftDoubleBracket]", 
               RowBox[{
               "mni", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"mm", "\[LeftDoubleBracket]", 
