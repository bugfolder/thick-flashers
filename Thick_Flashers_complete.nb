   3.80001662448181*^9},ExpressionUUID->"ecc9724f-936b-4ec4-937d-\
a99fd14c1958"],

Cell["\<\
Returns: a list of Style objects containing the graphics elements. \
\>", "Text",
 CellChangeTimes->{{3.691407609466503*^9, 
  3.691407615094455*^9}},ExpressionUUID->"b8190b16-8bfa-4b22-bac5-\
035021ed9293"],

Cell["\<\
This is useful for comparing surfaces to their Gauss map, because the rainbow \
color makes it clear how the one surface maps to the other.\
\>", "Text",
 CellChangeTimes->{{3.800018041788477*^9, 
  3.8000180943814373`*^9}},ExpressionUUID->"aa517001-ebe2-4481-9c7e-\
ae1cec098cf7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledColoredPatch", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PatchDivisions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"50", ",", "50"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"SurfaceColorFunction", "\[Rule]", "Automatic"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.672144578451386*^9, 3.672144612838942*^9}, {
   3.672144656636854*^9, 3.67214465909191*^9}, {3.688134072271159*^9, 
   3.688134098949463*^9}, 3.68924766498873*^9, {3.689266480368379*^9, 
   3.68926649841722*^9}, 3.691407733972714*^9, 3.691523782744891*^9, {
   3.693961646926214*^9, 3.693961667702268*^9}, {3.78559316666658*^9, 
   3.785593174975198*^9}, {3.800011483938833*^9, 3.800011497192182*^9}, 
   3.800016458386862*^9, 3.80001654092595*^9, {3.800017141129409*^9, 
   3.800017142557275*^9}, {3.800017684468658*^9, 3.80001768524163*^9}, {
   3.800017721764661*^9, 3.800017730537525*^9}},
 CellLabel->
  "In[1719]:=",ExpressionUUID->"04066459-e7bf-4ebe-ade1-00bda9330a9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledColoredPatch", "[", 
   RowBox[{
    RowBox[{"s_Function", "|", "s_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", "v1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nu", ",", "nv", ",", "scf", ",", "fdim", ",", "pts", ",", "ua", ",", 
      "va", ",", "ub", ",", "vb"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nu", ",", "nv"}], "}"}], "=", 
      RowBox[{
       RowBox[{"PatchDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledColoredPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"scf", "=", 
      RowBox[{
       RowBox[{"SurfaceColorFunction", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledColoredPatch", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"scf", "===", "Automatic"}], ",", 
       RowBox[{"scf", "=", 
        RowBox[{"Gray", "&"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ua", "=", 
         RowBox[{"u0", "+", 
          RowBox[{
           FractionBox[
            RowBox[{"(", 
             RowBox[{"iu", "-", "1"}], ")"}], "nu"], 
           RowBox[{"(", 
            RowBox[{"u1", "-", "u0"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ub", "=", 
         RowBox[{"u0", "+", 
          RowBox[{
           FractionBox["iu", "nu"], 
           RowBox[{"(", 
            RowBox[{"u1", "-", "u0"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"va", "=", 
         RowBox[{"v0", "+", 
          RowBox[{
           FractionBox[
            RowBox[{"(", 
             RowBox[{"iv", "-", "1"}], ")"}], "nv"], 
           RowBox[{"(", 
            RowBox[{"v1", "-", "v0"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vb", "=", 
         RowBox[{"v0", "+", 
          RowBox[{
           FractionBox["iv", "nv"], 
           RowBox[{"(", 
            RowBox[{"v1", "-", "v0"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "triangulate", " ", "quads", " ", "because", " ", "they", " ", 
          "could", " ", "be", " ", "skew", " ", "quads", " ", "and", " ", 
          "that", " ", "confuses", " ", "rendering"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"s", "[", 
                RowBox[{"ua", ",", "va"}], "]"}], ",", 
               RowBox[{"s", "[", 
                RowBox[{"ub", ",", "va"}], "]"}], ",", 
               RowBox[{"s", "[", 
                RowBox[{"ub", ",", "vb"}], "]"}]}], "}"}], "]"}], ",", 
            RowBox[{"scf", "@@", 
             FractionBox[
              RowBox[{
               RowBox[{"{", 
                RowBox[{"ua", ",", "va"}], "}"}], "+", 
               RowBox[{"{", 
                RowBox[{"ub", ",", "va"}], "}"}], "+", 
               RowBox[{"{", 
                RowBox[{"ub", ",", "vb"}], "}"}]}], "3"]}], ",", 
            RowBox[{"EdgeForm", "[", "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"s", "[", 
                RowBox[{"ua", ",", "va"}], "]"}], ",", 
               RowBox[{"s", "[", 
                RowBox[{"ub", ",", "vb"}], "]"}], ",", 
               RowBox[{"s", "[", 
                RowBox[{"ua", ",", "vb"}], "]"}]}], "}"}], "]"}], ",", 
            RowBox[{"scf", "@@", 
             FractionBox[
              RowBox[{
               RowBox[{"{", 
                RowBox[{"ua", ",", "va"}], "}"}], "+", 
               RowBox[{"{", 
                RowBox[{"ub", ",", "vb"}], "}"}], "+", 
               RowBox[{"{", 
                RowBox[{"ua", ",", "vb"}], "}"}]}], "3"]}], ",", 
            RowBox[{"EdgeForm", "[", "]"}]}], "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"iu", ",", "nu"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"iv", ",", "nv"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.672144540955038*^9, 3.672144566481948*^9}, {
