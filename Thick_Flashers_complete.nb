Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "\[Gamma]0", ",", "u0", ",", "u1", ",", "ff", ",", "rrL", ",", 
      "rrR", ",", "f", ",", "rL", ",", "rR", ",", "ui", ",", "fi", ",", 
      "ti"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]0", "=", 
      RowBox[{"120", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "fi", ",", "ti"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "s", "]"}], ",", 
          RowBox[{"Sin", "[", "s", "]"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cos", "[", 
             FractionBox["\[Gamma]0", "2"], "]"}]}], " ", 
           RowBox[{"Cos", "[", "s", "]"}]}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cos", "[", 
             FractionBox["\[Gamma]0", "2"], "]"}]}], " ", 
           RowBox[{"Sin", "[", "s", "]"}]}], ",", 
          RowBox[{"Sin", "[", 
           FractionBox["\[Gamma]0", "2"], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}], " ", 
           RowBox[{"Cos", "[", "s", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Cos", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}], " ", 
           RowBox[{"Sin", "[", "s", "]"}]}], ",", 
          RowBox[{"Sin", "[", 
           FractionBox["\[Gamma]0", "2"], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
      RowBox[{"NFoldAcrossRight3D", "[", 
       RowBox[{"ff", ",", "rrL", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StyledCurvedFold", "[", 
          RowBox[{"ff", ",", 
           RowBox[{"{", 
            RowBox[{"rrL", ",", "rrR"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StyledVector", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ff", "[", "u0", "]"}], ",", 
             RowBox[{
              RowBox[{"ff", "[", "u0", "]"}], "+", 
              RowBox[{".5", 
               RowBox[{"rrL", "[", "u0", "]"}]}]}]}], "}"}], ",", 
           RowBox[{"VectorColor", "\[Rule]", "Red"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StyledVector", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ff", "[", "u0", "]"}], ",", 
             RowBox[{
              RowBox[{"ff", "[", "u0", "]"}], "+", 
              RowBox[{".5", 
               RowBox[{"rrR", "[", "u0", "]"}]}]}]}], "}"}], ",", 
           RowBox[{"VectorColor", "\[Rule]", "Green"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "\[IndentingNewLine]", "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799491413473093*^9, 3.799491527975568*^9}, {
