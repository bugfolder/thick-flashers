Cell[TextData[{
 "RuledSurfaceNormal[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}",
 StyleBox[", opts",
  FontSlant->"Italic"],
 "] returns the surface normal function for an oriented ruled surface."
}], "Text",
 CellChangeTimes->{{3.691703665446906*^9, 3.691703674867025*^9}, {
  3.691703738553177*^9, 3.691703747684648*^9}, {3.691704121306945*^9, 
