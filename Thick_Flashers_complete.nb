Cell[TextData[{
 "AssertProperty[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["property",
  FontSlant->"Italic"],
 "] checks whether ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " contains ",
 StyleBox["property",
  FontSlant->"Italic"],
 ". If not, issue an error message and Abort[]. You will normally not use \
this; instead, you should use AssertClass (see below) when possible."
}], "Text",
 CellChangeTimes->{{3.591638753910356*^9, 3.591638781236025*^9}, 
   3.593006069367742*^9, {3.593007073916929*^9, 
