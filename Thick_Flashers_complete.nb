Cell[CellGroupData[{

Cell[TextData[{
 "MakeBoundedVoronoiDiagramPrimalDualGraph",
 "[",
 StyleBox["bounds",
  FontSlant->"Italic"],
 ", ",
 StyleBox["points",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.4660799129647202`*^9, 3.4660799688168087`*^9}, {
   3.466080142412875*^9, 3.46608014911557*^9}, {3.466080185098905*^9, 
   3.4660801872966747`*^9}, 3.484829077823191*^9, 3.551747578635261*^9, 
   3.592522033035727*^9, 3.59252208335762*^9, 3.592828810821916*^9, 
   3.594072164286948*^9},ExpressionUUID->"ef5c26af-281b-4269-b1ca-\
004a3d635d9f"],

Cell[TextData[{
 "MakeBoundedVoronoiDiagramPrimalDualGraph",
 "[",
 StyleBox["bounds",
  FontSlant->"Italic"],
 ", ",
 StyleBox["points",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["bounds",
  FontSlant->"Italic"],
 ", which is a bounding polygon, and a list of contained points ",
 StyleBox["points",
  FontSlant->"Italic"],
 ", and constructs the bounded Voronoi diagram; this becomes the primal \
graph. It returns a TPrimalDualGraph. The Delaunay triangulation of points \
will be the dual graph. It returns the list of plane graph data needed to \
construct a primal-dual tessellation."
}], "Text",
 CellChangeTimes->{{3.4660800432217607`*^9, 3.466080084088366*^9}, 
   3.466080152701232*^9, {3.4660801924831653`*^9, 3.466080209031086*^9}, {
   3.466080761920184*^9, 3.466080790980165*^9}, {3.466081036098229*^9, 
   3.466081040730608*^9}, 3.466086173580482*^9, 3.4660935956701317`*^9, 
   3.484829045525918*^9, 3.4848290778820558`*^9, {3.592522083420818*^9, 
   3.592522097199403*^9}, {3.592828810931447*^9, 3.592828811032265*^9}, 
   3.59407216440373*^9},ExpressionUUID->"2fc30973-5fac-4f72-9a0a-\
16c8de1b77e1"],

Cell["\<\
In general, Voronoi diagrams tend to have long protruding spikes, so if we \
used an unbounded Voronoi diagram, the primal graph would be spiky as well. \
By supplying a boundary, we effectively \"cut off\" those spikes, producing a \
more well-behaved (and therefore aesthetic) primal graph.\
\>", "Text",
 CellChangeTimes->{{3.466093617131138*^9, 
  3.466093748730352*^9}},ExpressionUUID->"fe6bf58e-87f4-4e4e-89ea-\
f809ef1c5b5f"],

Cell["\<\
Since we use the built-in function BoundedDiagram to compute the bounded \
Voronoi diagram, the boundary vertices must lie within unique Voronoi cells. \
That means you should use relatively simple boundaries; if you use a \
point-dense boundary (like a polygonal approximation to a circle) you will \
likely have more than one boundary point in a Voronoi cell and the algorithm \
will fail and Abort.\
\>", "Text",
 CellChangeTimes->{{3.4660875496251287`*^9, 3.466087708436698*^9}, {
  3.592522057144914*^9, 
  3.5925220572420893`*^9}},ExpressionUUID->"fc209375-3644-4514-ba60-\
a0bc04703b55"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeBoundedVoronoiDiagramPrimalDualGraph", "::", "notuniq"}], 
   "=", "\"\<MakeBoundedVoronoiDiagramPrimalDualGraph failed because \
BoundedDiagram failed (see preceding message for details).\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.466087246832629*^9, 3.466087286757043*^9}, {
  3.4660882310525703`*^9, 3.4660882429796658`*^9}, {3.484829078016757*^9, 
  3.484829078115675*^9}, {3.592522082143043*^9, 3.592522082395611*^9}, {
  3.5928288110950527`*^9, 3.592828811145735*^9}, {3.594072164423616*^9, 
  3.5940721644484797`*^9}},
 CellLabel->
  "In[3375]:=",ExpressionUUID->"f5e5169e-39ef-4c99-a480-c32e7549dec1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeBoundedVoronoiDiagramPrimalDualGraph", "[", 
   RowBox[{"bounds_", ",", "points_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "delval", ",", "bd", ",", "vorverts", ",", "vadj", ",", "pverts", ",", 
      "pfaces1", ",", "pedges", ",", "dverts1", ",", "pfaces", ",", "dverts", 
      ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "construct", " ", "the", " ", "Delaunay", " ", "triangulation", " ", 
      "and", " ", "the", " ", "Voronoi", " ", "diagram", " ", "of", " ", 
      "the", " ", "points"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"delval", "=", 
      RowBox[{"DelaunayTriangulation", "[", "points", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bd", "=", 
      RowBox[{"BoundedDiagram", "[", 
       RowBox[{"bounds", ",", "points", ",", "delval"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"SameQ", "[", 
        RowBox[{
         RowBox[{"Head", "[", "bd", "]"}], ",", "BoundedDiagram"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
         "MakeBoundedVoronoiDiagramPrimalDualGraph", "::", "notuniq"}], "]"}],
         ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vorverts", ",", "vadj"}], "}"}], "=", "bd"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"construct", " ", "verts", " ", "and", " ", "edges"}], ";", 
       " ", 
       RowBox[{
       "also", " ", "note", " ", "the", " ", "faces", " ", "and", " ", "dual",
         " ", "vertices", " ", "for", " ", "later", " ", "use"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", "vorverts"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pfaces1", "=", 
      RowBox[{"Last", "/@", "vadj"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "/@",
            "pfaces1"}], ",", "1"}], "]"}], ",", 
        RowBox[{"SameTest", "\[Rule]", "SameEdgeQ"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dverts1", "=", "points"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"build", " ", "all", " ", "the", " ", "plane", " ", "graph", " ", 
       RowBox[{"data", ".", " ", "Note"}], " ", "that", " ", "pfaces", " ", 
       "will", " ", "in", " ", "general", " ", "be", " ", "a", " ", 
       "different", " ", "order", " ", "than", " ", 
       RowBox[{"pfaces1", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"pverts", ",", "pedges"}], "]"}], "//", "AddTPlaneGraphTo"}],
        "//", "AddTPrimalDualGraphTo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"now", " ", "we", " ", "replace", " ", "the", " ", 
        RowBox[{"(", "approximate", ")"}], " ", "dual", " ", "vertices", " ", 
        "with", " ", "the", " ", "real", " ", "ones"}], ",", " ", 
       RowBox[{
       "using", " ", "the", " ", "permutation", " ", "derived", " ", "from", "  ",
         "face", " ", 
        RowBox[{"lists", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pfaces", ",", "dverts"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Faces", ",", "DualVertices"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"SameFaceQ", "[", 
          RowBox[{
           RowBox[{
           "pfaces", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "pfaces1", "\[LeftDoubleBracket]", "j", 
            "\[RightDoubleBracket]"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
          "dverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "=", 
          RowBox[{
          "dverts1", "\[LeftDoubleBracket]", "j", 
           "\[RightDoubleBracket]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "pfaces", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "pfaces", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertyIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"DualVertices", "\[Rule]", "dverts"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.466081047184951*^9, 3.4660811171165*^9}, {
   3.466081192087391*^9, 3.466081217101456*^9}, {3.4660813020307293`*^9, 
   3.466081333541414*^9}, {3.4660852178151817`*^9, 3.466085236226894*^9}, {
   3.4660854673893147`*^9, 3.466085477177209*^9}, {3.466085894676124*^9, 
