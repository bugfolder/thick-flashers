Cell["\<\
We don\[CloseCurlyQuote]t provide separate functions for starting or ending \
with 2D curves and surfaces because we can use Planarize and Unplanarize to \
convert everything to/from 3D for common processing.\
\>", "Text",
 CellChangeTimes->{{3.800479848031123*^9, 
  3.800479885223567*^9}},ExpressionUUID->"5c87285f-784d-4c2b-af34-\
fb35ba178b10"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ReshapeGeneric3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Kappa]n, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, tti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{
  3.79857276150193*^9, {3.798572806666256*^9, 3.79857284013316*^9}, {
   3.798573047101912*^9, 3.798573047750756*^9}, {3.798573191670987*^9, 
