Cell[CellGroupData[{

Cell["Barycentric coordinates", "Subsection",
 CellChangeTimes->{{3.7260949704799147`*^9, 
  3.7260949741513247`*^9}},ExpressionUUID->"9393d0f1-c168-40c7-b256-\
f667804a3efb"],

Cell[CellGroupData[{

Cell[TextData[{
 "Barycentric3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.734462845925861*^9, 3.734462861141165*^9}, {
   3.734463095572998*^9, 3.734463096044626*^9}, 
   3.73446331864844*^9},ExpressionUUID->"4b4352c3-8456-4fe8-a1df-\
b54e6c674bc9"],

Cell[TextData[{
 "BarycentricTriangleCoords[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}] gives the barycentric 4-vector coordinates of a point with respect to \
triangle {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.726093439936491*^9, 3.726093511441364*^9}, {
  3.726093771248693*^9, 3.7260937775805*^9}, {3.726093810364339*^9, 
  3.7260938120926332`*^9}, {3.726094835476316*^9, 3.7260948362998943`*^9}, {
  3.734462899125894*^9, 
  3.73446294310131*^9}},ExpressionUUID->"8892ecde-8a97-4511-a066-\
f72e72bd0ec6"],

Cell[TextData[{
 "Returns: a 4-vector {",
 StyleBox["qt",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rt",
  FontSlant->"Italic"],
 ", ",
 StyleBox["st",
  FontSlant->"Italic"],
 ", ",
 StyleBox["zt",
  FontSlant->"Italic"],
 "} where {",
 StyleBox["qt",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rt",
  FontSlant->"Italic"],
 ", ",
 StyleBox["st",
  FontSlant->"Italic"],
 "} are the barycentric coordinates of the point in triangle {",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "} that is closest to ",
 StyleBox["p",
  FontSlant->"Italic"],
 " and ",
 StyleBox["zt",
  FontSlant->"Italic"],
 " is the signed distance out of the plane of the triangle."
}], "Text",
 CellChangeTimes->{{3.7344629820205193`*^9, 
  3.7344630414458327`*^9}},ExpressionUUID->"09ba1fd5-e5d5-4e46-acf3-\
f27ca85447ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Barycentric3D", "[", 
   RowBox[{"p_List", ",", 
    RowBox[{"{", 
     RowBox[{"q_List", ",", "r_List", ",", "s_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "z", ",", "qt", ",", "rt", ",", "st", ",", "zt", ",", "eqns", ",", 
      "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"TriangleNormal3D", "[", 
       RowBox[{"q", ",", "r", ",", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"qt", " ", "q"}], " ", "+", " ", 
          RowBox[{"rt", " ", "r"}], " ", "+", " ", 
          RowBox[{"st", " ", "s"}], " ", "+", " ", 
          RowBox[{"zt", " ", "z"}], " ", "-", " ", "p"}], ",", 
         RowBox[{"{", 
          RowBox[{"qt", "+", "rt", "+", "st", "-", "1"}], "}"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"eqns", ",", 
         RowBox[{"{", 
          RowBox[{"qt", ",", "rt", ",", "st", ",", "zt"}], "}"}]}], "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qt", ",", "rt", ",", "st", ",", "zt"}], "}"}], "/.", 
      "soln"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.726093358951878*^9, 3.72609339622506*^9}, {
   3.726093430977074*^9, 3.726093447962716*^9}, {3.726093514233244*^9, 
   3.726093695363957*^9}, {3.72609374310091*^9, 3.726093766477351*^9}, {
