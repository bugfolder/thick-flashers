               RowBox[{"{", 
                RowBox[{"xmin", ",", "ymin", ",", "zmin"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"xmax", ",", "ymin", ",", "zmin"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"xmax", ",", "ymax", ",", "zmin"}], "}"}], ",", 
