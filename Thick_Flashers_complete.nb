   RowBox[{
    RowBox[{
     RowBox[{"Plus", "@@", 
      RowBox[{
       RowBox[{"tobj", "[", "Vertices", "]"}], "\[LeftDoubleBracket]", "#", 
       "\[RightDoubleBracket]"}]}], "/", "2"}], "&"}], "/@", 
   RowBox[{"tobj", "[", "Edges", "]"}]}]}]], "Input",
