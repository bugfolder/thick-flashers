  "In[153]:=",ExpressionUUID->"77c56f32-13ed-412e-b305-d5f75049c370"],

Cell[TextData[{
 "Reflect[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 "] reflects a point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " in the hyperplane defined by the unnormalized vector ",
 StyleBox["u",
  FontSlant->"Italic"],
 " through point ",
 StyleBox["q.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.690651461278023*^9, 3.690651480038528*^9}, {
  3.690651613706141*^9, 3.6906516161460657`*^9}, {3.690651892600111*^9, 
  3.690651907669823*^9}},ExpressionUUID->"3466ad2e-4ac1-4ea0-895f-\
d03432ff71a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Reflect", "[", 
   RowBox[{"p_List", ",", "q_List", ",", "u_List"}], "]"}], ":=", 
  RowBox[{"p", "-", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "q"}], ")"}], ".", "u"}], ")"}], 
    RowBox[{"u", "/", 
     RowBox[{"(", 
      RowBox[{"u", ".", "u"}], ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.690651517927093*^9, 3.6906515351710997`*^9}, 
   3.690651810124446*^9, {3.690651966130169*^9, 3.690651967198979*^9}, {
