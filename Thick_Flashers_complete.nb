Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "verts", ",", "edges", ",", "tobj", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "-", "1"}], ",", 
             RowBox[{"j", "-", "1"}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", "1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"n", "+", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", "j", ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"(", 
               RowBox[{"n", "+", "1"}], ")"}]}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTPlaneGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphGraphics", "[", "tobj", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.643719474229019*^9, 3.643719509769684*^9}, {
