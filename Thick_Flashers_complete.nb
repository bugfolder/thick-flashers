Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "u0", ",", "u1", ",", "kp", ",", "ta", ",", "rcs", ",", "nrcs", ",", 
      "cc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"u0", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"u1", "=", 
      RowBox[{"3", "\[Pi]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"kp", "=", 
      RowBox[{"1.2", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ta", "=", 
      RowBox[{"0.5", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rcs", "=", 
      RowBox[{"RecoverCurve3DSystemOld", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kp", ",", "ta"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nrcs", "=", 
      RowBox[{"NRecoverCurve3DSystemOld", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kp", ",", "ta"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Curve3D", "/.", "rcs"}], ")"}], "[", "t", "]"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Curve3D", "/.", "nrcs"}], ")"}], "[", "t", "]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"Red", ",", "Green"}], "}"}]}]}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PartitionedGraphicsGrid", "[", 
       RowBox[{
        RowBox[{"Curve3DSystemPlots", "[", 
         RowBox[{"rcs", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", "4"}], "]"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PartitionedGraphicsGrid", "[", 
       RowBox[{
        RowBox[{"Curve3DSystemPlots", "[", 
         RowBox[{"nrcs", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", "4"}], "]"}], "//",
       "Print"}], ";"}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
