Cell[TextData[{
 "TwistCreasePatternLines[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes an ",
 "TGraphAssigned",
 ", and returns a list of MountainLine and ValleyLine styled objects that \
give the crease pattern."
}], "Text",
 CellChangeTimes->{{3.457659060433057*^9, 3.457659064822044*^9}, {
