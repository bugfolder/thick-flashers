                RowBox[{"xmin", ",", "ymax", ",", "zmax"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"xmin", ",", "ymin", ",", "zmax"}], "}"}]}], "}"}], 
             "]"}], ",", "Red"}], "]"}]}], "}"}], ",", 
        RowBox[{"Boxed", "\[Rule]", "True"}], ",", 
        RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", "bbox"}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.473429107686733*^9, 3.473429260553314*^9}, {
