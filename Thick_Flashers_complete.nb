Cell["\<\
Ma8ImportRules
Ma9ImportRules
Ma10ImportRules
Ma11ImportRules
Ma12ImportRules\
\>", "Subsubsection",
 CellChangeTimes->{{3.53442915633243*^9, 3.534429160715854*^9}, {
  3.675962996899259*^9, 3.675962997402276*^9}, {3.708014931091167*^9, 
  3.708014933570648*^9}, {3.765046983116969*^9, 
  3.765046987577445*^9}},ExpressionUUID->"1d117931-2c5b-49ff-b114-\
53951e6df9cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ma8ImportRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"JoinedCurve", "[", 
       RowBox[{"_", ",", 
        RowBox[{"{", "pts_List", "}"}], ",", "_"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"Line", "[", "pts", "]"}]}], ",", 
     RowBox[{
      RowBox[{"JoinedCurve", "[", 
       RowBox[{"_", ",", "ptsets_", ",", "_"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"Line", "/@", "ptsets"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.534429164319004*^9, 3.534429179177342*^9}},
 CellLabel->
  "In[853]:=",ExpressionUUID->"411ec3ef-3e3b-431e-905d-fcddc9252dad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ma9ImportRules", "=", "Ma8ImportRules"}], ";"}]], "Input",
