Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAngleLabels", "[", 
   RowBox[{"tobj_TObj", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ei", ",", "ud", ",", "faf", ",", "verts", ",", "edges", ",", 
      "foldangles", ",", "fa"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ei", "=", 
      RowBox[{
       RowBox[{"EdgeIndices", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ud", "=", 
      RowBox[{
       RowBox[{"UseDegrees", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faf", "=", 
      RowBox[{
       RowBox[{"FoldAngleForm", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "foldangles"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "FoldAngles"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fa", "=", 
         RowBox[{
         "foldangles", "\[LeftDoubleBracket]", "i", 
          "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"ei", ",", 
             RowBox[{"\"\<e\>\"", "<>", 
              RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<\[Rule]\>\""}], 
             ",", "\"\<\>\""}], "]"}], "<>", 
           RowBox[{"If", "[", 
            RowBox[{"ud", ",", 
             RowBox[{
              RowBox[{"ToString", "[", 
               RowBox[{"faf", "[", 
                RowBox[{"fa", "/", "\[Degree]"}], "]"}], "]"}], 
              "<>", "\"\<\[Degree]\>\""}], ",", 
             RowBox[{"ToString", "[", 
              RowBox[{"faf", "[", 
               RowBox[{
               "fa", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
               "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Plus", "@@", 
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], "/", "2"}]}], "]"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
