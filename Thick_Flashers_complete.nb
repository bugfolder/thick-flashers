Cell["Example. Create an STL model.", "Text",
 CellChangeTimes->{{3.708415195386937*^9, 3.7084151997926207`*^9}, 
   3.7084152731818743`*^9},ExpressionUUID->"21fb94e9-b35c-41f1-909f-\
e681f2ee29fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"poly1", ",", "poly2", ",", "ggorig", ",", "ggrp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"poly1", "=", 
      RowBox[{"Polygon", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"poly2", "=", 
      RowBox[{"Polygon", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ggorig", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"poly1", ",", "poly2"}], "}"}], ",", 
         RowBox[{"FaceForm", "[", 
          RowBox[{"Green", ",", "Red"}], "]"}], ",", 
         RowBox[{"EdgeForm", "[", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", "Blue"}], "}"}], "]"}]}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ggrp", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"MakePlanarRoundedPlateGCs", "[", 
          RowBox[{"ggorig", ",", "0.25", ",", 
           RowBox[{"RoundingDivisions", "\[Rule]", "6"}]}], "]"}], ",", 
         RowBox[{"FaceForm", "[", 
          RowBox[{"Cyan", ",", "Yellow"}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{"ggorig", ",", "ggrp"}], "}"}], "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ExamplesDir", "[", "]"}], "<>", "\"\<test.stl\>\""}], ",", 
       "ggrp", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<STL\>\"", ",", 
         RowBox[{"\"\<BinaryFormat\>\"", "\[Rule]", " ", "False"}]}], "}"}]}],
       "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.708347096980454*^9, 3.708347117054644*^9}, {
   3.708347171192625*^9, 3.708347271018522*^9}, {3.708347303669457*^9, 
