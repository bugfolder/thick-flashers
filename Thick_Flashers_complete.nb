  3.719662313718041*^9}, {3.719662389301069*^9, 3.719662458463855*^9}, {
  3.719662499198975*^9, 3.719662700477858*^9}, {3.719662762934277*^9, 
  3.7196628046700983`*^9}, {3.719662861725216*^9, 3.719662863596549*^9}},
