               RowBox[{"1", ",", "4", ",", "7", ",", "2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "7", ",", "6", ",", "8"}], "}"}]}], "}"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
               "ff", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "==", 
               RowBox[{"{", 
