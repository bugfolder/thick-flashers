 RowBox[{
  RowBox[{"Styled3DAxes", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xmin_", ",", " ", "xmax_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"ymin_", ",", " ", "ymax_"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"zmin_", ",", " ", "zmax_"}], "}"}], ",", " ", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"at", ",", "ac", ",", "als", ",", "al", ",", "alp"}], "}"}], ",",
