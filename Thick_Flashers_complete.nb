Cell[CellGroupData[{

Cell[TextData[{
 "StyledDarbouxTrihedron[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["l",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) DarbouxVectorLength, DarbouxVectorLabels, VectorThickness2D, \
VectorArrowheads"
}], "Subsubsection",
 CellChangeTimes->{{3.6879959733336153`*^9, 3.687996088867853*^9}, {
   3.68799613166506*^9, 3.687996134705777*^9}, {3.687996310141873*^9, 
   3.687996312101643*^9}, 3.687996356659189*^9, {3.688132550520152*^9, 
   3.688132560588284*^9}, {3.688132665392418*^9, 3.688132667629434*^9}, 
   3.68813612012897*^9, 3.6889991934557657`*^9, {3.688999246549604*^9, 
   3.688999260027321*^9}, 3.689001815464032*^9, 3.691254069031415*^9, 
   3.799834733027164*^9, 
   3.7999561468773117`*^9},ExpressionUUID->"4ccbb878-27c7-4223-bc49-\
b17a7b372f42"],

Cell[TextData[{
 "StyledDarbouxTrihedron[ ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["l",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns Graphics3D elements that display a Darboux frame located at point \
",
 StyleBox["p",
  FontSlant->"Italic"],
 ". Arguments are: \n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the position of the frame (a vector, not a function).\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the tangent vector of the frame.\n\t",
 StyleBox["l",
  FontSlant->"Italic"],
 " \[LongDash] the tangent normal vector of the frame.\n\t",
 StyleBox["u",
  FontSlant->"Italic"],
 " \[LongDash] the surface normal vector of the frame.\nIt returns a list of \
Graphics3D elements. Colors are symbolic. Options are:\n\tDarbouxVectorLength \
\[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies the lengths of the vector line segments.\n\tCarbouxVectorLabels \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", specifies the labels to be put on the vectors.\n\tVectorThickness2D, \
VectorArrowheads are passed through to StyledVector."
}], "Text",
 CellChangeTimes->{{3.687996094310459*^9, 3.687996104226926*^9}, {
