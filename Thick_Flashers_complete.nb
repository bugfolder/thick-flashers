Cell[TextData[{
 "LFFGraphGraphics",
 "[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TObj representing a LFF graph and returns a Graphics object that \
displays the graph. Options ",
 StyleBox["opts",
  FontSlant->"Italic"],
 " are passed through to Graphics."
}], "Text",
 CellChangeTimes->{{3.591792888941485*^9, 3.5917929154910707`*^9}, 
   3.592435749022271*^9, 3.592828834377289*^9, {3.593017222328246*^9, 
   3.593017237022366*^9}, 
   3.595200871456385*^9},ExpressionUUID->"f72b99d6-4504-4504-9993-\
b5ad85e9fe07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LFFGraphGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"everts", ",", "eedges", ",", "edgetypes"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"everts", ",", "eedges", ",", "edgetypes"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "LFFEdgeTypes"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{
                "everts", "\[LeftDoubleBracket]", "#1", 
                 "\[RightDoubleBracket]"}], "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"#2", "\[Equal]", 
                  RowBox[{"-", "1"}]}], ",", "Red", ",", "Blue"}], "]"}]}], 
              "]"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"eedges", ",", "edgetypes"}], "}"}]}], "]"}], ",", 
          RowBox[{"AbsolutePointSize", "[", "4", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "#", "]"}], ",", "Black"}], "]"}], "&"}], 
           "/@", "everts"}]}], "}"}], "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
