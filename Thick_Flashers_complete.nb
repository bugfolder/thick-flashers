ca90830025b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cp", ",", "tobj", ",", "pg", ",", "cp1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cp", "=", 
      RowBox[{"CreasePatternGraphics", "[", "pgtobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"CreasePatternToPlaneGraphAssigned", "[", "cp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pg", "=", 
      RowBox[{"GraphGraphics", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cp1", "=", 
      RowBox[{"CreasePatternGraphics", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"PaperFill", "\[Rule]", "PaperColoredSideFill"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
