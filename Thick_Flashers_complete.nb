Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "plist", ",", "tobj", ",", "tobj1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plist", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"f", "[", "\[Phi]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "0.", ",", 
          RowBox[{"1.92", "\[Pi]"}], ",", 
          RowBox[{"1.92", 
           RowBox[{"\[Pi]", "/", "30"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "break", " ", "the", " ", "first", " ", "segment", " ", "in", " ", 
       "the", " ", "middle", " ", "so", " ", 
       RowBox[{"there", "'"}], "s", " ", "no", " ", "bend", " ", "or", " ", 
       "torsion", " ", "at", " ", "the", " ", 
       RowBox[{"endpoints", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTSpaceCurve", "[", 
       RowBox[{"plist", ",", "0.8", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"60", "\[Degree]"}], ",", 
          RowBox[{"60", "\[Degree]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"tobj", "[", "SpaceCurveInteriorVertices", "]"}], "\[LeftDoubleBracket]",
        "1", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<BendAngleFF/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"tobj1", "[", "BendAngleFF", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<BendAngleCP/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"tobj1", "[", "BendAngleCP", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SubarcAngles/\[Degree]=\>\"", ",", 
       RowBox[{
        RowBox[{"tobj1", "[", "SubarcAngles", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SpaceCurveMaximumWidth\>\"", "\[Rule]", 
       RowBox[{"tobj", "[", "SpaceCurveMaximumWidth", "]"}]}], "]"}], ";", 
     " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", "plist", "]"}], ",", 
             RowBox[{"Point", "[", 
              RowBox[{
              "plist", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
               "]"}]}], "}"}], ",", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
