Cell["\<\
This example illustrates an example in which two of the twist angles change \
direction from CCW (<90\[Degree]) to CW (>90\[Degree]).\
\>", "Text",
 CellChangeTimes->{{3.630198020207677*^9, 3.6301981002488337`*^9}, {
  3.630198450090534*^9, 3.6301984671855187`*^9}, {3.630244961578717*^9, 
  3.630244967519782*^9}},ExpressionUUID->"7947c3c7-3bb6-4bd9-93c3-\
b13f0eaefe4d"],

Cell["\<\
TBD: there\[CloseCurlyQuote]s an error in the crease assignment: two of the \
creases of the smallest triangle should be mountain. (I think this is related \
to the change of direction of those two twist angles, so should be an easy \
fix.)\
\>", "Text",
 CellChangeTimes->{{3.707839330831932*^9, 3.707839336951835*^9}, {
  3.70783946454643*^9, 
  3.707839500169856*^9}},ExpressionUUID->"7f06b28e-f0f0-4773-bdc0-\
251df272e30e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
