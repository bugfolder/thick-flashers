Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFoldVectorsFromSectorsAndDihedrals", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a1_", ",", " ", "a2_", ",", "a3_", ",", "a4_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"gm1_", ",", "gm2_", ",", "gm3_", ",", "gm4_"}], "}"}], ",", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ovn", ",", "g1", ",", "g2", ",", "g3", ",", "g4", ",", "aa", ",", "bb", 
      ",", "gg", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ovn", "=", 
      RowBox[{
       RowBox[{"OsculatingVectorNear", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "MakeFoldVectorsFromSectorsAndDihedrals", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"g1", "=", 
      RowBox[{"U3D", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g2", "=", 
      RowBox[{
       RowBox[{"RotationXMatrix3D", "[", 
        RowBox[{"gm1", "/", "2"}], "]"}], ".", 
       RowBox[{"U3D", "[", "a1", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g3", "=", 
      RowBox[{
       RowBox[{"RotationXMatrix3D", "[", 
        RowBox[{"gm1", "/", "2"}], "]"}], ".", 
       RowBox[{"RotationMatrix3Du", "[", 
        RowBox[{"gm2", ",", 
         RowBox[{"U3D", "[", "a1", "]"}]}], "]"}], ".", 
       RowBox[{"U3D", "[", 
        RowBox[{"a1", "+", "a2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g4", "=", 
      RowBox[{
       RowBox[{"RotationXMatrix3D", "[", 
        RowBox[{
         RowBox[{"-", "gm1"}], "/", "2"}], "]"}], ".", 
       RowBox[{"U3D", "[", 
        RowBox[{"-", "a4"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{"{", 
       RowBox[{"g1", ",", "g2", ",", "g3", ",", "g4"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<{a1, a2, a3, a4}/\[Degree] (input) =\>\"", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a1", ",", " ", "a2", ",", " ", "a3", ",", " ", "a4"}], 
           "}"}], "/", "\[Degree]"}]}], "]"}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"compare", " ", "input", " ", "and", " ", "computed"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<{a1, a2, a3, a4}/\[Degree] (computed) =\>\"", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ArcCos", "[", 
             RowBox[{"g1", ".", "g2"}], "]"}], ",", " ", 
            RowBox[{"ArcCos", "[", 
             RowBox[{"g2", ".", "g3"}], "]"}], ",", " ", 
            RowBox[{"ArcCos", "[", 
             RowBox[{"g3", ".", "g4"}], "]"}], ",", " ", 
            RowBox[{"ArcCos", "[", 
             RowBox[{"g4", ".", "g1"}], "]"}]}], "}"}], "/", "\[Degree]"}]}], 
        "]"}], ";"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ovn", "===", "None"}], ",", " ", 
       RowBox[{"Return", "[", "gg", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTDegree4Vertex3D", "[", "gg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"RotationMatrix3DTwixt", "[", 
         RowBox[{
          RowBox[{"tobj", "[", "OsculatingVector", "]"}], ",", "ovn"}], "]"}],
         ".", "#"}], "&"}], "/@", "gg"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.440445180043562*^9, 3.440445253404481*^9}, {
