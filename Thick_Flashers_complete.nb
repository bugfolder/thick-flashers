               "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
               "-", 
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}]}], "]"}]}], "}"}], "/", 
         "\[Degree]"}], "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CW angles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
