     RowBox[{"tiling", "=", 
      RowBox[{"MakeLatticeTiling", "[", 
       RowBox[{"patch", ",", "lattice", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
