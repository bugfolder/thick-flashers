  3.629849611432975*^9}},ExpressionUUID->"bf1de9ca-a7ad-4ed1-9f00-\
46e22ddf50a4"],

Cell[TextData[{
 "{UnitTriangleTile, ",
 StyleBox["angles",
  FontSlant->"Italic"],
 "} is a tile type that specifies a unit triangle by its corner angles."
}], "Text",
 CellChangeTimes->{{3.629849936650879*^9, 
  3.6298499520594673`*^9}},ExpressionUUID->"588f3919-649b-4008-b641-\
d180db4d6c9e"],

