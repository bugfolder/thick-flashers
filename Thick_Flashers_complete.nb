Cell[CellGroupData[{

Cell["Consistency check: nonuniform helix (numeric only)", "Subsubsection",
 CellChangeTimes->{{3.799752363239119*^9, 3.799752370448572*^9}, {
  3.79975296011383*^9, 3.7997529933617*^9}, {3.799782911348013*^9, 
