         RowBox[{"B", "\[Rule]", "2"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<HasPropertyQ[tobj,A]: \>\"", ",", 
       RowBox[{"HasPropertyQ", "[", 
        RowBox[{"tobj", ",", "A"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<HasPropertyQ[tobj,C]: \>\"", ",", 
       RowBox[{"HasPropertyQ", "[", 
        RowBox[{"tobj", ",", "C"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GetAllRules", "[", "tobj", "]"}]}]}], "\[IndentingNewLine]", 
