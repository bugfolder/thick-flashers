   3.798133819795909*^9}},ExpressionUUID->"cb8b7d1f-2134-4be2-9610-\
1af3435fea4b"],

Cell[TextData[{
 "Options:\n\tAxesThickness3D \[Rule] ",
 StyleBox["th",
  FontSlant->"Italic"],
 ", specifies the thickness of the axes.\n\tAxesColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of the axes.\n\tAxesLabelStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", specifies the text style for the axes labels.\n\tAxesLabel \[Rule] {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z",
  FontSlant->"Italic"],
 "}, labels to put at the end of the positive-pointing axes (same option as \
in Graphics3D)\n\tAxesLabelPosition \[Rule] {{",
 StyleBox["x1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["x2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["x3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y3",
  FontSlant->"Italic"],
 "}}, relative positions passed to Text[] to specify the positions of the \
labels."
}], "Text",
 CellChangeTimes->{{3.798133821780842*^9, 3.7981338287679253`*^9}, {
   3.798134549818209*^9, 3.798134557296864*^9}, {3.799608886297443*^9, 
