Cell[TextData[{
 "MergeGraphs[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of TGraphs and returns a single TGraph that is the merged \
result ."
}], "Text",
