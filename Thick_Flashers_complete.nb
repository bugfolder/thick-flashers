Cell[TextData[{
 "ShowTGraphExample[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PlotLabel\nShowTGraphExample[",
 StyleBox["name",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.719613865579784*^9, 3.719613872053009*^9}, {
  3.719615003533144*^9, 3.719615004075471*^9}, {3.719615046416484*^9, 
  3.7196150654302797`*^9}, {3.719615120653425*^9, 
  3.719615127430439*^9}},ExpressionUUID->"c82530f7-454d-4b73-ae81-\
f405599316e3"],

Cell[TextData[{
 "ShowTGraphExample[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] displays any of the named $TGraphExamples, showing the graph and its \
various 2D and 3D forms, depending on what classes it contains."
}], "Text",
 CellChangeTimes->{{3.719614974381027*^9, 3.71961503275823*^9}, {
  3.719615089405455*^9, 3.7196151113900423`*^9}, {3.7196152836314178`*^9, 
  3.719615285286696*^9}},ExpressionUUID->"70d8dc64-3c85-4c5d-a57f-\
e792874a955b"],

Cell["\<\
Options:
\tPlotLabel \[Rule] pl, specify a plot label.\
\>", "Text",
 CellChangeTimes->{{3.7196152978216877`*^9, 
  3.719615310734776*^9}},ExpressionUUID->"171a4f44-9954-456b-a21d-\
757c2c23dad6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ShowTGraphExample", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", "\[Rule]", "None"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.71961514059715*^9, 3.719615157846973*^9}},
 CellLabel->
  "In[4434]:=",ExpressionUUID->"c9a1a2dc-3b50-4568-9972-4ee6b1689814"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ShowTGraphExample", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pl", ",", "gg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pl", "=", 
      RowBox[{
       RowBox[{"PlotLabel", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ShowTGraphExample", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj", ",", "TGraph3D"}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"HasClassQ", "[", 
          RowBox[{"tobj", ",", "TAssigned"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"gg", ",", 
           RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "]"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"gg", ",", 
           RowBox[{"Graph3DGraphics3D", "[", "tobj", "]"}]}], "]"}]}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj", ",", "TGraph2D"}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"HasClassQ", "[", 
          RowBox[{"tobj", ",", "TAssigned"}], "]"}], ",", 
         RowBox[{"PrependTo", "[", 
          RowBox[{"gg", ",", 
           RowBox[{"VisibleFoldedFormGraphics", "[", "tobj", "]"}]}], "]"}], ",", 
         RowBox[{"PrependTo", "[", 
          RowBox[{"gg", ",", 
           RowBox[{"Graph2DGraphics", "[", "tobj", "]"}]}], "]"}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj", ",", "TAssigned"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}]}], "]"}], ",", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"gg", ",", 
         RowBox[{"GraphGraphics", "[", "tobj", "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"(", 
          RowBox[{"pl", "===", "None"}], ")"}]}], ",", 
        RowBox[{"GraphicsRow", "[", 
         RowBox[{"gg", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "pl"}]}], "]"}], ",", 
        RowBox[{"GraphicsRow", "[", "gg", "]"}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.719613879115991*^9, 3.719614015629434*^9}, {
   3.71961404720577*^9, 3.719614214990614*^9}, {3.719614384406988*^9, 
