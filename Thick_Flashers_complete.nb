Cell[TextData[{
 "LineLineDistance[",
 StyleBox["{p1, p2}, {q1, q2}",
  FontSlant->"Italic"],
 "]\nSegmentSegmentDistance[",
 StyleBox["{p1, p2}, {q1, q2}",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.676474943845235*^9, 3.6764749456990433`*^9}, 
