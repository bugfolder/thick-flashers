Cell[BoxData[
 RowBox[{
  RowBox[{"DynamicModule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gmax", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
