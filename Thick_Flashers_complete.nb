Cell["\<\
This takes a crease pattern with no border and creates a \
TPlaneGraph+TAssigned from it.\
\>", "Text",
 CellChangeTimes->{{3.7078230728928766`*^9, 
  3.707823090286024*^9}},ExpressionUUID->"234a1b29-774d-4ae4-adb7-\
b4a992d64d47"],

Cell["\<\
It is now deprecated [no longer used]. In general, you should avoid using \
borderless graphs; instead, use a bordered graph and don\[CloseCurlyQuote]t \
display the border edges.\
\>", "Text",
 CellChangeTimes->{{3.707823092261088*^9, 
  3.707823143094003*^9}},ExpressionUUID->"5a06673e-39c5-4b03-865d-\
417cb2bbfea7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "Options", "[", "BorderlessCreasePatternToPlaneGraphAssigned", "]"}], "=", 
   
   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{"SamePtTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.533670027634433*^9, 3.533670042460389*^9}, 
