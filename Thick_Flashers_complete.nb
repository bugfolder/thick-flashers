            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"f", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
