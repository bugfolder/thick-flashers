Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p1", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p2", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p3", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"p4", "=", 
          RowBox[{"Rotate3D", "[", 
           RowBox[{"p1", ",", "\[Phi]", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1", ",", "0"}], "}"}], ",", "p2"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Sphere", "[", 
                 RowBox[{
                  RowBox[{".5", 
                   RowBox[{"(", 
                    RowBox[{"p2", "+", "p3"}], ")"}]}], ",", ".7"}], "]"}], ",", 
                RowBox[{"Opacity", "[", "0", "]"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"{", 
                  RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "]"}], ",", 
                "Paper3DFill"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"{", 
                  RowBox[{"p2", ",", "p4", ",", "p3"}], "}"}], "]"}], ",", 
                "Paper3DFill"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{"p1", ",", 
                   RowBox[{
                    RowBox[{".75", " ", "p2"}], " ", "+", " ", 
                    RowBox[{".25", " ", "p3"}]}]}], "}"}], "]"}], ",", 
                "ValleyLine"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{"p1", ",", 
                   RowBox[{
                    RowBox[{".5", " ", "p2"}], " ", "+", " ", 
                    RowBox[{".5", " ", "p3"}]}]}], "}"}], "]"}], ",", 
                "CreaseLine"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{"p1", ",", 
                   RowBox[{
                    RowBox[{".25", " ", "p2"}], " ", "+", " ", 
                    RowBox[{".75", " ", "p3"}]}]}], "}"}], "]"}], ",", 
                "MountainLine"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{"p1", ",", "p3", ",", "p4", ",", "p2", ",", "p1"}], 
                  "}"}], "]"}], ",", "BorderLine"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{"p2", ",", "p3"}], "}"}], "]"}], ",", 
                "FoldedLine"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Text", "[", 
               
               RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(1\)]\)\>\"", ",", 
                "p1", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Text", "[", 
               
               RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(2\)]\)\>\"", ",", 
                "p2", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Text", "[", 
               
               RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(3\)]\)\>\"", ",", 
                "p3", ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Text", "[", 
               
               RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(4\)]\)\>\"", ",", 
                "p4", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], "/.", 
            RowBox[{"OrigamiStyle", "[", "]"}]}], ",", 
           RowBox[{"Lighting", "\[Rule]", "\"\<Neutral\>\""}]}], "]"}]}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Phi]", ",", 
            RowBox[{".1", "\[Pi]"}]}], "}"}], ",", 
