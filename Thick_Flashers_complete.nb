Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SingleVertexEdgeAngles3D", "::", "badedge"}], 
   "=", "\"\<Vertex `1` is not adjacent to vertex `2`.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.59526929511005*^9, 3.595269317691634*^9}, {
   3.595272671919743*^9, 3.595272672407707*^9}, 3.595273655969487*^9, 
   3.626459811083634*^9, 3.626460410315377*^9},
 CellLabel->
  "In[1451]:=",ExpressionUUID->"4b8bac41-17c6-42e4-b006-1b8623515011"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SingleVertexEdgeAngles3D", "[", 
   StyleBox[
    RowBox[{"tobj_TObj", ",", " ", "i0_", ",", " ", "i1_"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts3d", ",", "vva", ",", "vfi", ",", "fn", ",", "vc", ",", "va", ",", 
      "vf", ",", "vfa"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "vva", ",", "vfi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices3D", ",", "VertexVertexAdjacency", ",", 
          "VertexFaceIncidence"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fn", "=", 
      RowBox[{"FaceNormals3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vc", "=", 
      RowBox[{
      "verts3d", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"this", " ", "vertex", " ", "coords"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"va", "=", 
      RowBox[{
      "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "vertices", " ", "adjacent", " ", "to", " ", "this", " ", "vertex"}], ",",
        " ", 
       RowBox[{"by", " ", "index"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{"va", ",", "i1"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"SingleVertexEdgeAngles3D", "::", "badedge"}], ",", "i1", ",",
           "i0"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vf", "=", 
      RowBox[{
      "vfi", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "faces", " ", "incident", " ", "to", " ", "this", " ", "vertex"}], ",",
        " ", 
       RowBox[{"by", " ", 
        RowBox[{"index", ".", " ", "Could"}], " ", "include", " ", 
        RowBox[{"zeroes", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vfa", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
           "vf", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "\[Equal]",
            "0"}], ",", "\[IndentingNewLine]", "Null", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"DirectedAngle3D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"verts3d", "\[LeftDoubleBracket]", 
              RowBox[{
              "va", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}], "-", "vc"}], ",", 
            RowBox[{
             RowBox[{"verts3d", "\[LeftDoubleBracket]", 
              RowBox[{"va", "\[LeftDoubleBracket]", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"j", "+", "1"}], ",", 
                 RowBox[{"Length", "[", "va", "]"}], ",", "1"}], "]"}], 
               "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "-", 
             "vc"}], ",", 
            RowBox[{"fn", "\[LeftDoubleBracket]", 
             RowBox[{
             "vf", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], "]"}]}], "\[IndentingNewLine]", 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "va", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RotateLeft", "[", 
      RowBox[{"vfa", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"va", ",", "i1", ",", "1", ",", "1"}], "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595273280577409*^9, 3.59527331148926*^9}, {
   3.59527340076353*^9, 3.595273417292164*^9}, {3.595273452899425*^9, 
