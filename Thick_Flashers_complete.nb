Cell[CellGroupData[{

Cell[TextData[{
 "MakeTachiMiuraSheet[",
 "\[Beta]0, {\[Gamma]0, \[Gamma]}, {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 "}, w, {",
 StyleBox["nl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.643287221087326*^9, 3.643287229439049*^9}, 
   3.643288075001093*^9},ExpressionUUID->"f4a53aae-b386-4bd9-afb0-\
a2e0beba8468"],

Cell[TextData[{
 "MakeTachiMiuraSheet[\[Beta]0, {\[Gamma]0, \[Gamma]}, {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 "}, w, {",
 StyleBox["nl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw",
  FontSlant->"Italic"],
 "}] constructs a TGraph+TAssigned+TCornerIndices that represents a single \
sheet of a Tachi-Miura cellular form, where\n\t\[Beta]0 is the first bend \
angle at the design minor fold angle, positive for bend upward, negative for \
bend downward\n\t\[Gamma]0 is the design minor fold angle\n\t\[Gamma] is the \
minor fold angle for this rendering\n\t",
 StyleBox["dh",
  FontSlant->"Italic"],
 " is the half-length of the horizontal segments of the generating path (and \
full length of first and last segments)\n\t",
 StyleBox["dd",
  FontSlant->"Italic"],
 " is the full length of the diagonal segments of the generating path\n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the panel width\n\t",
 StyleBox["nl",
  FontSlant->"Italic"],
 " is the number of up-and-down repeats along the length (x direction)\n\t",
 StyleBox["nw",
  FontSlant->"Italic"],
 " is the number of repeat pairs along the width (y direction)\nThe sheet is \
automatically rotated and positioned so that vertex 1 is at the origin and it \
is parallel to the x-z plane.\t"
}], "Text",
 CellChangeTimes->{{3.64328730662055*^9, 3.643287360270974*^9}, {
  3.643287403589492*^9, 3.643287426570971*^9}, {3.643287532188094*^9, 
  3.6432878163615723`*^9}, {3.643287972584013*^9, 
  3.6432880157019377`*^9}},ExpressionUUID->"f8af3cfd-58a0-4374-bdb9-\
7e1b5eb243d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTachiMiuraSheet", "[", 
   RowBox[{"\[Beta]0_", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]0_", ",", "\[Gamma]_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"dh_", ",", "dd_"}], "}"}], ",", "w_", ",", 
    RowBox[{"{", 
     RowBox[{"nl_", ",", "nw_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Zeta]0", ",", "\[Alpha]", ",", "\[Zeta]", ",", "\[Beta]", ",", "h", ",",
       "pts", ",", "dpts", ",", "tobj", ",", "ci", ",", "vrg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Zeta]0", "=", 
      RowBox[{"\[Pi]", "-", 
       RowBox[{"Abs", "[", "\[Beta]0", "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"ruling", " ", "angle"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"ArcTan", "[", 
       RowBox[{
        RowBox[{"Cot", "[", 
         FractionBox["\[Zeta]0", "2"], "]"}], 
        RowBox[{"Csc", "[", 
         FractionBox["\[Gamma]0", "2"], "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "angle"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Zeta]", "=", 
      RowBox[{"2", " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"Cot", "[", "\[Alpha]", "]"}], 
         RowBox[{"Csc", "[", 
          FractionBox["\[Gamma]", "2"], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"\[Pi]", "-", "\[Zeta]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"h", "=", 
      RowBox[{
       RowBox[{"Sec", "[", "\[Zeta]0", "]"}], 
       RowBox[{"Sin", "[", "\[Zeta]", "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"height", " ", "at", " ", "current", " ", "size"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"construct", " ", "the", " ", "target", " ", "path"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"dh", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dpts", "=", 
      RowBox[{"{", 
       RowBox[{"dd", " ", 
        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "-", "\[Zeta]"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"dpts", ",", 
       RowBox[{
        RowBox[{"dpts", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "dh"}], ",", "0"}], "}"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"dpts", ",", 
       RowBox[{
        RowBox[{"dpts", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"dd", " ", 
         RowBox[{"U", "[", 
          RowBox[{"\[Pi]", "+", "\[Zeta]"}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"dpts", ",", 
       RowBox[{
        RowBox[{"dpts", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "dh"}], ",", "0"}], "}"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"pts", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"pts", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"pts", "\[LeftDoubleBracket]", 
               RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", "#"}], 
             "&"}], "/@", "dpts"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nl"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"pts", "\[LeftDoubleBracket]", 
       RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "=", 
      RowBox[{
       RowBox[{"pts", "\[LeftDoubleBracket]", 
        RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "dh"}], ",", "0"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"Line", "[", "pts", "]"}], ",", 
         RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "]"}], "//", "Hold"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"make", " ", "the", " ", "first", " ", "layer"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSemigeneralizedMiuraOriP", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"Sign", "[", "\[Beta]0", "]"}]}], "}"}], "#"}], "&"}], "/@",
          "pts"}], ",", "w", ",", "nw", ",", "\[Gamma]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ci", "=", 
      RowBox[{"tobj", "[", "CornerIndices", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<CornerIndices = \>\"", ",", "ci"}], "]"}], "//", "Hold"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"vrg", "=", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", "ci", "]"}], ",", "3"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"CreasePatternGraphics", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"VertexRotateGraph3D", "[", 
       RowBox[{"tobj", ",", "vrg"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", "tobj"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.643287239874402*^9, 3.6432872863046*^9}, {
  3.643287408877743*^9, 3.643287420229364*^9}, {3.643287500290151*^9, 
  3.643287525967876*^9}, {3.643287564261456*^9, 3.64328756575562*^9}, {
  3.643287607572835*^9, 3.643287609697719*^9}, {3.643287839177745*^9, 
  3.643287987227195*^9}, {3.643288032814846*^9, 3.643288064979919*^9}, {
  3.6432884649711947`*^9, 3.643288467151478*^9}},
 CellLabel->
  "In[2561]:=",ExpressionUUID->"c46dcbc0-acf3-4d29-a24a-c0dab9cd766a"],

Cell["Example", "Text",
 CellChangeTimes->{{3.6432882505090938`*^9, 
  3.643288251293592*^9}},ExpressionUUID->"b38541c0-a4a4-4d0c-81ff-\
53c5103c9037"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTachiMiuraSheet", "[", 
       RowBox[{
        RowBox[{"60.", "\[Degree]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"90.", "\[Degree]"}], ",", 
          RowBox[{"105.", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", "1.2", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.643288260056492*^9, 3.643288415859067*^9}, 
   3.643288482398237*^9, {3.643289168778368*^9, 3.643289169124356*^9}, {
   3.6432892296812553`*^9, 3.643289231632077*^9}},
 CellLabel->
  "In[2562]:=",ExpressionUUID->"786a5632-2088-492c-a0eb-0fbf0171f8d0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeTachiMiuraStackGraphics3D[\[Beta]0, {\[Gamma]0, \[Gamma]}, {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 "}, w, {",
 StyleBox["nl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw, nh",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) StackGap"
}], "Subsubsection",
 CellChangeTimes->{{3.643287221087326*^9, 3.643287229439049*^9}, 
   3.643288075001093*^9, {3.64328861670392*^9, 3.643288648932188*^9}, {
   3.6432935187170353`*^9, 3.64329352378725*^9}, {3.6432936829637337`*^9, 
   3.6432936876315618`*^9}},ExpressionUUID->"ad054111-33d3-4be0-9271-\
1e534e53f2cb"],

Cell[TextData[{
 "MakeTachiMiuraStackGraphics3D[\[Beta]0, {\[Gamma]0, \[Gamma]}, {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 "}, w, {",
 StyleBox["nl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw, nh",
  FontSlant->"Italic"],
 "}] constructs a Graphics3D representation of a Tachi-Miura cellular form, \
where\n\t\[Beta]0 is the first bend angle at the design minor fold angle, \
positive for bend upward, negative for bend downward\n\t\[Gamma]0 is the \
design minor fold angle\n\t\[Gamma] is the minor fold angle for this \
rendering\n\t",
 StyleBox["dh",
  FontSlant->"Italic"],
 " is the half-length of the horizontal segments of the generating path (and \
full length of first and last segments)\n\t",
 StyleBox["dd",
  FontSlant->"Italic"],
 " is the full length of the diagonal segments of the generating path\n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the panel width\n\t",
 StyleBox["nl",
  FontSlant->"Italic"],
 " is the number of up-and-down repeats along the length (x direction)\n\t",
 StyleBox["nw",
  FontSlant->"Italic"],
 " is the number of repeat pairs along the width (y direction)\n\t",
 StyleBox["nh",
  FontSlant->"Italic"],
 " is the number of stacked sheets\nThe sheet is automatically rotated and \
positioned so that vertex 1 of the bottom sheet is at the origin and it is \
parallel to the x-z plane. Options are:\n\tStackGap \[Rule] \[Epsilon], \
specifies the vertical spacing between layers as a fraction of ",
 StyleBox["dh",
  FontSlant->"Italic"],
 ". This improves rendering."
}], "Text",
 CellChangeTimes->{{3.64328730662055*^9, 3.643287360270974*^9}, {
  3.643287403589492*^9, 3.643287426570971*^9}, {3.643287532188094*^9, 
  3.6432878163615723`*^9}, {3.643287972584013*^9, 3.6432880157019377`*^9}, {
  3.64328862618965*^9, 3.643288633677003*^9}, {3.643288663745853*^9, 
  3.6432887179125967`*^9}, {3.643288879879525*^9, 3.643288884532208*^9}, {
  3.643288916530678*^9, 
  3.643288947840684*^9}},ExpressionUUID->"efe070a0-eac7-4531-bba3-\
3dcc2e6c733e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StackGap", "::", "usage"}], 
   "=", "\"\<StackGap is an option to MakeTachiMiuraStackGraphics3D that \
specifies the vertical gap between successive layers.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.643288953778984*^9, 3.64328897980236*^9}},
 CellLabel->
  "In[2563]:=",ExpressionUUID->"eff61d35-ceb2-46fb-866f-fb9ee88db161"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeTachiMiuraStackGraphics3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"StackGap", "\[Rule]", "0.001"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.643288983323567*^9, 3.643289009898308*^9}},
 CellLabel->
  "In[2564]:=",ExpressionUUID->"63ff1d2e-184f-4831-9bb8-f199fa3199cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTachiMiuraStackGraphics3D", "[", 
   RowBox[{"\[Beta]0_", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]0_", ",", "\[Gamma]_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"dh_", ",", "dd_"}], "}"}], ",", "w_", ",", 
    RowBox[{"{", 
     RowBox[{"nl_", ",", "nw_", ",", "nh_"}], "}"}], ",", "opts___"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sg", ",", "tobj1", ",", "tobj2", ",", "h", ",", "gg1", ",", "gg2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sg", "=", 
      RowBox[{
       RowBox[{"StackGap", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTachiMiuraStackGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"MakeTachiMiuraSheet", "[", 
       RowBox[{"\[Beta]0", ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]0", ",", "\[Gamma]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"dh", ",", "dd"}], "}"}], ",", "w", ",", 
        RowBox[{"{", 
         RowBox[{"nl", ",", "nw"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"layer", " ", "points", " ", "up"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"MakeTachiMiuraSheet", "[", 
       RowBox[{
        RowBox[{"-", "\[Beta]0"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]0", ",", "\[Gamma]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"dh", ",", "dd"}], "}"}], ",", "w", ",", 
        RowBox[{"{", 
         RowBox[{"nl", ",", "nw"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"layer", " ", "points", " ", "down"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"h", "=", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", "=", 
           RowBox[{"tobj1", "[", "Vertices3D", "]"}]}], "}"}], ",", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"v", "\[LeftDoubleBracket]", 
            RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}], "-", 
           RowBox[{"v", "\[LeftDoubleBracket]", 
            RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}]}], "]"}]}], 
        "]"}], "+", 
       RowBox[{"sg", " ", "dh"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"vertical", " ", "layer", " ", "spacing"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gg1", "=", 
      RowBox[{"FoldedFormGraphics3D", "[", "tobj1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg2", "=", 
      RowBox[{"FoldedFormGraphics3D", "[", "tobj2", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"EvenQ", "[", "i", "]"}], ",", 
          RowBox[{"Translate3D", "[", 
           RowBox[{
            RowBox[{
            "gg1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"i", " ", "h"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Translate3D", "[", 
           RowBox[{
            RowBox[{
            "gg2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"i", "+", "1"}], ")"}], " ", "h"}]}], "}"}]}], 
           "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"nh", "-", "1"}]}], "}"}]}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.643288730975093*^9, 3.643288875015169*^9}, {
  3.64328902062381*^9, 3.643289072447804*^9}},
 CellLabel->
  "In[2565]:=",ExpressionUUID->"277f7989-fafa-48fc-adeb-66ba962b0d5c"],

