Cell[CellGroupData[{

Cell[TextData[{
 "DoubleJoinedTubes[",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dz",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TubeHeight, PanelOverlap, TypeMinimumAngle, \
TypeMaximumAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.6711788953470993`*^9, 3.671178896638007*^9}, {
   3.67117922313023*^9, 3.671179234799026*^9}, {3.671179279851207*^9, 
   3.671179281202106*^9}, 3.671290969759507*^9, {3.671332896415043*^9, 
   3.671332901260229*^9}, {3.6715283040522547`*^9, 3.67152830482096*^9}, {
   3.673101661954793*^9, 3.673101674247295*^9}, {3.675322972469213*^9, 
   3.6753229895706367`*^9}, {3.6753241667824717`*^9, 3.675324167777259*^9}, {
   3.67535589558469*^9, 3.67535589617391*^9}, {3.675357937698241*^9, 
   3.675357939064281*^9}},ExpressionUUID->"3ff5c1e1-414a-4a21-a774-\
098e7a83a13e"],

Cell[TextData[{
 "DoubleJoinedTubes[",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dz",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates an isometric triangulated joint between two ",
 StyleBox["z",
  FontSlant->"Italic"],
 "-oriented quasi-cylindrical tubes where the upper one has twice as many \
points as the lower one. Arguments are:\n\t",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that traces the bottom tube cross section \
in the ",
 StyleBox["x-y",
  FontSlant->"Italic"],
 " plane\n\t",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that traces the top tube cross section in \
the ",
 StyleBox["x-y",
  FontSlant->"Italic"],
 " plane, incorporating offsets and/or rotation\n\t",
 StyleBox["dz",
  FontSlant->"Italic"],
 " \[LongDash] the ",
 StyleBox["z",
  FontSlant->"Italic"],
 "-offset between the centroids of the top and bottom surfaces.\nOptions are:\
\n\tTubeHeight \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", specifies the cylinder height of the top and bottom cylinders.\n\t\
PanelOverlap \[Rule] True | False, specifies whether to add an extra panel \
for overlap\n\tTypeMinimumAngle, TypeMaximumAngle are passed through to \
ReassignGraph3D"
}], "Text",
 CellChangeTimes->{{3.671178906081423*^9, 3.671178965584174*^9}, {
   3.6711790212561197`*^9, 3.671179200430028*^9}, 3.671290969808563*^9, {
   3.6715283112826853`*^9, 3.6715283434795103`*^9}, 3.673098033769256*^9, {
   3.673101661990464*^9, 3.6731016743111773`*^9}, {3.675322993457251*^9, 
   3.675323012521871*^9}, {3.675355902636785*^9, 3.675355917325645*^9}, 
   3.675357947265477*^9},ExpressionUUID->"8c2ed34e-6d5a-4a73-86f0-\
7dfb6e26b3cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "DoubleJoinedTubes", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"TubeHeight", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"PanelOverlap", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.671179304791991*^9, 3.671179323748104*^9}, 
   3.6712909698490047`*^9, {3.671332970605996*^9, 3.671332981127567*^9}, {
   3.675323015332824*^9, 3.675323022585432*^9}, {3.675368177289934*^9, 
   3.6753681803179417`*^9}},
 CellLabel->
  "In[3593]:=",ExpressionUUID->"97b238f7-9a5a-4146-9479-cf86dbbce72d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DoubleJoinedTubes", "::", "badlens"}], 
   "=", "\"\<List `1` does not have half as many entries as list `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.671180064037623*^9, 3.671180089794998*^9}, {
   3.671180392948053*^9, 3.6711803937339153`*^9}, 3.671290969869729*^9, 
   3.675355991287766*^9, {3.675356036831039*^9, 3.675356062254468*^9}},
 CellLabel->
  "In[3594]:=",ExpressionUUID->"06e53400-d322-4eee-9aee-a28cb91d8ae6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DoubleJoinedTubes", "::", "badperi"}], 
   "=", "\"\<Lists `1` and `2` must have the same perimeter.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.671180064037623*^9, 3.671180089794998*^9}, {
   3.671180318415332*^9, 3.671180318705687*^9}, {3.671180367607332*^9, 
   3.671180368649484*^9}, {3.671180401321964*^9, 3.6711804017164*^9}, 
   3.671290969891457*^9, 3.675355991295815*^9},
 CellLabel->
  "In[3595]:=",ExpressionUUID->"871a74f5-72e3-4b1a-8677-cde3ef0f5291"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DoubleJoinedTubes", "[", 
   RowBox[{
   "botpts2d_List", ",", "toppts2d_List", ",", "dz_", ",", "opts___"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "td", ",", "th", ",", "po", ",", "m", ",", "m2", ",", "mm2", ",", 
      "blens", ",", "tlens", ",", "pxvals", ",", "qxvals", ",", "g", ",", "h",
       ",", "gavg", ",", "havg", ",", "p", ",", "q", ",", "pp", ",", "qq", ",",
       "dl", ",", "dh", ",", "gbot", ",", "htop", ",", "eqns", ",", "vars", ",",
       "vars0", ",", "soln", ",", "mm", ",", "cp", ",", "ff", ",", "verts", ",",
       "edges", ",", "types", ",", "verts3d", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"td", "=", 
      RowBox[{
       RowBox[{"TwistDirection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DoubleJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"th", "=", 
      RowBox[{
       RowBox[{"TubeHeight", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DoubleJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"po", "=", 
      RowBox[{
       RowBox[{"PanelOverlap", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DoubleJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "botpts2d", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "toppts2d", "]"}], "\[NotEqual]", 
        RowBox[{"2", "m"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"DoubleJoinedTubes", "::", "badlens"}], ",", "botpts2d", ",",
           "toppts2d"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"blens", "=", 
      RowBox[{"Mag", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"RotateLeft", "[", "botpts2d", "]"}], "-", "botpts2d"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tlens", "=", 
      RowBox[{"Mag", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"RotateLeft", "[", "toppts2d", "]"}], "-", "toppts2d"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Plus", "@@", "blens"}], ")"}], "-", 
          RowBox[{"(", 
           RowBox[{"Plus", "@@", "tlens"}], ")"}]}], "]"}], ">", 
        SuperscriptBox["10", 
         RowBox[{"-", "6"}]]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"DoubleJoinedTubes", "::", "badperi"}], ",", "botpts2d", ",",
           "toppts2d"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"unwrapped", " ", "x"}], "-", 
        RowBox[{"coordinates", " ", "of", " ", "bottom", " ", "and", " ", 
         RowBox[{"top", ".", " ", "Double"}], " ", "the", " ", "length", " ", 
         "so", " ", "we", " ", "can", " ", "index", " ", "at", " ", "j"}]}], "=", 
       RowBox[{
        RowBox[{"0", " ", "and", " ", "j"}], "=", 
        RowBox[{
         RowBox[{
         "m", " ", "in", " ", "the", " ", "cp", " ", "without", " ", "wrap"}],
          "-", 
         RowBox[{"around", " ", 
          RowBox[{"effects", "."}]}]}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"pxvals", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"blens", ",", "blens"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qxvals", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"tlens", ",", "tlens"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"wraparound", " ", "behavior"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", "j_", "]"}], ":=", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"Mod", "[", 
         RowBox[{"j", ",", "m"}], "]"}], "]"}], "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"j", "<", "0"}], "||", 
         RowBox[{"j", "\[GreaterEqual]", "m"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h", "[", "j_", "]"}], ":=", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"Mod", "[", 
         RowBox[{"j", ",", "m"}], "]"}], "]"}], "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"j", "<", "0"}], "||", 
         RowBox[{"j", "\[GreaterEqual]", 
          RowBox[{"2", "m"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"average", " ", "variables"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gavg", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"g", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "/", "m"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"havg", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"h", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{
            RowBox[{"2", "m"}], "-", "1"}]}], "}"}]}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "m"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"ff", " ", "points"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pp", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"botpts2d", "\[LeftDoubleBracket]", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], 
         "\[RightDoubleBracket]"}], ",", "z"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pp", "[", "j_", "]"}], ":=", 
      RowBox[{"pp", "[", 
       RowBox[{"j", ",", 
        RowBox[{"g", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qq", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"j", "+", "1"}], ",", 
           RowBox[{"2", "m"}], ",", "1"}], "]"}], "\[RightDoubleBracket]"}], ",",
         "z"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qq", "[", "j_", "]"}], ":=", 
      RowBox[{"qq", "[", 
       RowBox[{"j", ",", 
        RowBox[{"h", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"cp", " ", "points"}], ";", " ", 
       RowBox[{
       "dl", " ", "and", " ", "dh", " ", "are", " ", "variables", " ", "to", " ",
         "be", " ", "solved", " ", 
        RowBox[{"for", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pxvals", "\[LeftDoubleBracket]", 
         RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], ",", "z"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", "j_", "]"}], ":=", 
      RowBox[{"p", "[", 
       RowBox[{"j", ",", 
        RowBox[{"g", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"qxvals", "\[LeftDoubleBracket]", 
          RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], "+", "dl"}], ",", 
        RowBox[{"z", "+", "dh"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "j_", "]"}], ":=", 
      RowBox[{"q", "[", 
       RowBox[{"j", ",", 
        RowBox[{"h", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"equations", ":", " ", 
       RowBox[{"isometries", " ", "plus", " ", "offsets"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{
       RowBox[{"Join", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Mag2", "[", 
              RowBox[{
               RowBox[{"p", "[", "j", "]"}], "-", 
               RowBox[{"q", "[", 
                RowBox[{"2", "j"}], "]"}]}], "]"}], "-", 
             RowBox[{"Mag2", "[", 
              RowBox[{
               RowBox[{"pp", "[", "j", "]"}], "-", 
               RowBox[{"qq", "[", 
                RowBox[{"2", "j"}], "]"}]}], "]"}]}], "\[Equal]", "0"}], ",", 
           
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Mag2", "[", 
              RowBox[{
               RowBox[{"p", "[", "j", "]"}], "-", 
               RowBox[{"q", "[", 
                RowBox[{
                 RowBox[{"2", "j"}], "+", "1"}], "]"}]}], "]"}], "-", 
             RowBox[{"Mag2", "[", 
              RowBox[{
               RowBox[{"pp", "[", "j", "]"}], "-", 
               RowBox[{"qq", "[", 
                RowBox[{
                 RowBox[{"2", "j"}], "+", "1"}], "]"}]}], "]"}]}], "\[Equal]",
             "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Mag2", "[", 
              RowBox[{
               RowBox[{"p", "[", 
                RowBox[{"j", "+", "1"}], "]"}], "-", 
               RowBox[{"q", "[", 
                RowBox[{
                 RowBox[{"2", "j"}], "+", "1"}], "]"}]}], "]"}], "-", 
             RowBox[{"Mag2", "[", 
              RowBox[{
               RowBox[{"pp", "[", 
                RowBox[{"j", "+", "1"}], "]"}], "-", 
               RowBox[{"qq", "[", 
                RowBox[{
                 RowBox[{"2", "j"}], "+", "1"}], "]"}]}], "]"}]}], "\[Equal]",
             "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
           RowBox[{
            RowBox[{"havg", "-", "gavg", "-", "dz"}], "\[Equal]", "0"}]}], 
          "}"}]}], "]"}], "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PrintThis", "[", "eqns", "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "Solve", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"g", "[", "j", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"h", "[", "j", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "m"}], "-", "1"}]}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"dl", ",", "dh"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vars0", "=", 
      RowBox[{"Table", "[", 
       RowBox[{".1", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "vars", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"soln", "=", 
        RowBox[{"Solve", "[", 
         RowBox[{"eqns", ",", "vars"}], "]"}]}], ";"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"soln", "=", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"soln", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"dh", "/.", "#1"}], ")"}], "<", 
             RowBox[{"(", 
              RowBox[{"dh", "/.", "#2"}], ")"}]}], "&"}]}], "]"}], "//", 
         "Last"}]}], ";"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Solve", " ", "takes", " ", "substantial", " ", "time", " ", "and", " ",
         "issues", " ", "a", " ", "warning"}], ",", " ", 
       RowBox[{"FindRoot", " ", "is", " ", "better"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindRoot", "@@", 
       RowBox[{"{", 
        RowBox[{"eqns", ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
