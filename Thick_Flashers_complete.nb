Cell[CellGroupData[{

Cell[TextData[{
 "RodriguesMatrix[",
 StyleBox["w",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.79796761469322*^9, 
  3.797967624876931*^9}},ExpressionUUID->"37d6108c-93a0-4023-95a9-\
89ad50074349"],

Cell[TextData[{
 "RodriguesMatrix[",
 StyleBox["w",
  FontSlant->"Italic"],
 "] returns the 3\[Times]3 matrix W(w) that enters into Rodrigues\
\[CloseCurlyQuote]s formula for 3D rotations."
}], "Text",
 CellChangeTimes->{{3.797967633844982*^9, 
  3.797967668461529*^9}},ExpressionUUID->"3cae472d-6463-4e72-8330-\
00657d56f9a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RodriguesMatrix", "[", "w_List", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", 
       RowBox[{"w", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
      ",", 
      RowBox[{"w", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"w", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",",
       "0", ",", 
      RowBox[{"-", 
       RowBox[{
       "w", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], "}"}],
     ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"w", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
      ",", 
      RowBox[{"w", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
       "0"}], "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.797967679660686*^9, 3.797967707928294*^9}},
 CellLabel->
  "In[697]:=",ExpressionUUID->"066f605f-d6f6-4b01-8eb3-4c9ca1a947f5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RotationMatrix3Du[\[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.6881247371502943`*^9, 
  3.688124755106691*^9}},ExpressionUUID->"d0377586-e561-42fb-ab8b-\
3e876171afa6"],

Cell[TextData[{
 "RotationMatrix3Du[\[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "] assumes that ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is a unit vector, and then uses the much simpler Rodrigues formula."
}], "Text",
 CellChangeTimes->{{3.688124765042925*^9, 
  3.6881248103857527`*^9}},ExpressionUUID->"17a5eb1d-1924-4a99-9c79-\
50ef06605be5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationMatrix3Du", "[", 
   RowBox[{"\[Phi]_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"W", "=", 
       RowBox[{"RodriguesMatrix", "[", "w", "]"}]}], ",", 
      RowBox[{"I", "=", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"I", "+", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Phi]", "]"}], "W"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"W", ".", "W"}], ")"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.688124817746644*^9, {3.688124869328501*^9, 3.688124894486638*^9}, {
   3.688124925506774*^9, 3.688124936057324*^9}, {3.688125050107394*^9, 
   3.68812518003581*^9}, {3.797967740321373*^9, 3.797967743382687*^9}},
 CellLabel->
  "In[698]:=",ExpressionUUID->"dfb53560-b9bb-4a6a-a5cf-cb843ae70104"],

Cell["Example", "Text",
 CellChangeTimes->{{3.688125192237838*^9, 
  3.688125192959752*^9}},ExpressionUUID->"294ed883-1596-44e4-ad3d-\
340146af8a5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationMatrix3Du", "[", 
   RowBox[{
    RowBox[{"\[Pi]", "/", "2"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.688125200432431*^9, 3.688125233820896*^9}},
 CellLabel->
  "In[699]:=",ExpressionUUID->"7f4a47bd-34ef-4e47-8315-af7e85faf53a"],

Cell["\<\
Same symbolic form as above; much simpler, but only valid for a unit \
direction vector.\
\>", "Text",
 CellChangeTimes->{{3.688125904752348*^9, 3.688125931846383*^9}, {
  3.6881350287032413`*^9, 
  3.688135049613603*^9}},ExpressionUUID->"9da1bd61-de53-47ac-a9ae-\
09149756e59b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", "x", ",", "y", ",", "z"}], "}"}], ",", 
    RowBox[{"LeafCount", "[", 
     RowBox[{"RotationMatrix3Du", "[", 
      RowBox[{"\[Phi]", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "]"}]}], "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6881258662068*^9, 3.688125897740308*^9}, {
  3.688125953599693*^9, 3.688125966181187*^9}, {3.797967779419327*^9, 
  3.79796778221595*^9}},
 CellLabel->
  "In[700]:=",ExpressionUUID->"f81cfcea-a6ee-40fc-91ac-a84f3b15e899"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RotationMatrix3Du[{",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.691276448076988*^9, 
  3.691276472818678*^9}},ExpressionUUID->"d2703baa-7953-411b-975a-\
115a07dc2c68"],

Cell[TextData[{
 "RotationMatrix3Du[{",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 "] gives the 3D rotation matrix for a counterclockwise rotation about the 3D \
unit vector w, where the rotation angle is now specified by its angle cosine \
and sine {",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["s",
  FontSlant->"Italic"],
 "}. It is particularly useful in analysis with vectors, where angle sines \
and cosines can often be expressed in dot products, which avoids the need to \
use inverse trig functions to find angles."
}], "Text",
 CellChangeTimes->{{3.691276490361933*^9, 3.691276549643402*^9}, {
  3.691276590420523*^9, 
  3.691276648347044*^9}},ExpressionUUID->"38b1bd14-f705-4270-b987-\
d42732dcceda"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationMatrix3Du", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c_", ",", "s_"}], "}"}], ",", "w_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"W", "=", 
       RowBox[{"RodriguesMatrix", "[", "w", "]"}]}], ",", 
      RowBox[{"I", "=", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"I", "+", 
     RowBox[{"s", " ", "W"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "c"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"W", ".", "W"}], ")"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.688124817746644*^9, {3.688124869328501*^9, 3.688124894486638*^9}, {
   3.688124925506774*^9, 3.688124936057324*^9}, {3.688125050107394*^9, 
   3.68812518003581*^9}, {3.691276562856562*^9, 3.691276577950802*^9}, 
   3.797967806851778*^9},
 CellLabel->
  "In[701]:=",ExpressionUUID->"aa83fa8a-f1ca-4e11-8ee9-75701e2b314f"]
}, Closed]],

Cell[CellGroupData[{

Cell["RotationZMatrix3D[\[Phi]]", "Subsubsection",
 CellChangeTimes->{3.439844437439793*^9, 
  3.43984658371494*^9},ExpressionUUID->"e0e0010a-53f5-4edc-a80b-5f71c5b52956"],

Cell[TextData[{
 "RotationZMatrix3D",
 "[\[Phi]] returns the rotation matrix in 3D that rotates through an angle \
\[Phi] in the x-y plane, i.e., about the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "cf1a5d0c-e2cf-45aa-93b8-cfc01f5504c2"],
 " axis."
}], "Text",
 CellChangeTimes->{{3.439844378119258*^9, 3.439844422194233*^9}, {
   3.43984447501318*^9, 3.439844520574202*^9}, 
   3.439846583746478*^9},ExpressionUUID->"a44e4c31-9c36-4cde-b73a-\
ff0b6fd4716c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationZMatrix3D", "[", "\[Phi]_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
      RowBox[{"-", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.439844534419726*^9, 3.439844534619395*^9}, 
   3.439846583774139*^9},
 CellLabel->
  "In[702]:=",ExpressionUUID->"ba0dd77d-5322-4458-a10e-720861da474a"]
}, Closed]],

Cell[CellGroupData[{

Cell["RotationXMatrix3D[\[Phi]]", "Subsubsection",
 CellChangeTimes->{
  3.439844437439793*^9, {3.439844508992135*^9, 3.439844509237523*^9}, 
   3.439846593088012*^9},ExpressionUUID->"3ba6da31-f3b8-4786-80d7-\
7338936d83e5"],

Cell[TextData[{
 "RotationXMatrix3D",
 "[\[Phi]] returns the rotation matrix in 3D that rotates through an angle \
\[Phi] in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "-", "z"}], TraditionalForm]],ExpressionUUID->
  "5b45190c-1024-42a4-8deb-31c58985dfa7"],
 " plane, i.e., about the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "f260a8f3-9b91-45b0-816c-12944e3bdce3"],
 " axis."
}], "Text",
 CellChangeTimes->{{3.439844378119258*^9, 3.439844422194233*^9}, {
   3.43984447501318*^9, 3.439844527011104*^9}, 
