Cell[BoxData[
 RowBox[{
  RowBox[{"RecoverCurve3DSystem", "[", 
   RowBox[{"ds_Function", ",", "\[Kappa]_Function", ",", "\[Tau]_Function", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "ci_List", ",", "ti_List", ",", "bi_List"}], "}"}], ",",
     "opts___"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "sfn", ",", "dsopts", ",", "s", ",", "cx", ",", 
      "cy", ",", "cz", ",", "tx", ",", "ty", ",", "tz", ",", "nx", ",", "ny", 
      ",", "nz", ",", "bx", ",", "by", ",", "bz", ",", "soln", ",", "c", ",", 
      "t", ",", "n", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve3DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve3DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Integrate", " ", "the", " ", "Frenet"}], "-", 
       RowBox[{"Serret", " ", "differential", " ", "equation"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"cx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"cy", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"cz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tx", "[", "s", "]"}], ",", 
              RowBox[{"ty", "[", "s", "]"}], ",", 
              RowBox[{"tz", "[", "s", "]"}]}], "}"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"tx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"ty", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"tz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Kappa]", "[", "s", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nx", "[", "s", "]"}], ",", 
                RowBox[{"ny", "[", "s", "]"}], ",", 
                RowBox[{"nz", "[", "s", "]"}]}], "}"}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"nx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"ny", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"nz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                RowBox[{"\[Kappa]", "[", "s", "]"}]}], 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"tx", "[", "s", "]"}], ",", 
                 RowBox[{"ty", "[", "s", "]"}], ",", 
                 RowBox[{"tz", "[", "s", "]"}]}], "}"}]}], "+", 
              RowBox[{
               RowBox[{"\[Tau]", "[", "s", "]"}], 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"bx", "[", "s", "]"}], ",", 
                 RowBox[{"by", "[", "s", "]"}], ",", 
                 RowBox[{"bz", "[", "s", "]"}]}], "}"}]}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"bx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"by", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"bz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"\[Tau]", "[", "s", "]"}]}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nx", "[", "s", "]"}], ",", 
                RowBox[{"ny", "[", "s", "]"}], ",", 
                RowBox[{"nz", "[", "s", "]"}]}], "}"}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cx", "[", "ui", "]"}], ",", 
             RowBox[{"cy", "[", "ui", "]"}], ",", 
             RowBox[{"cz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ci"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"tx", "[", "ui", "]"}], ",", 
             RowBox[{"ty", "[", "ui", "]"}], ",", 
             RowBox[{"tz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ti"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nx", "[", "ui", "]"}], ",", 
             RowBox[{"ny", "[", "ui", "]"}], ",", 
             RowBox[{"nz", "[", "ui", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{"bi", "\[Cross]", "ti"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"bx", "[", "ui", "]"}], ",", 
             RowBox[{"by", "[", "ui", "]"}], ",", 
             RowBox[{"bz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "bi"}]}], 
         "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cx", "[", "s", "]"}], ",", 
          RowBox[{"cy", "[", "s", "]"}], ",", 
          RowBox[{"cz", "[", "s", "]"}], ",", 
          RowBox[{"tx", "[", "s", "]"}], ",", 
          RowBox[{"ty", "[", "s", "]"}], ",", 
          RowBox[{"tz", "[", "s", "]"}], ",", 
          RowBox[{"nx", "[", "s", "]"}], ",", 
          RowBox[{"ny", "[", "s", "]"}], ",", 
          RowBox[{"nz", "[", "s", "]"}], ",", 
          RowBox[{"bx", "[", "s", "]"}], ",", 
          RowBox[{"by", "[", "s", "]"}], ",", 
          RowBox[{"bz", "[", "s", "]"}]}], "}"}], ",", "s", ",", 
        RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "DSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"RecoverCurve3DSystem", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Flatten", "[", "soln", "]"}]}], ";", "\[IndentingNewLine]", 
