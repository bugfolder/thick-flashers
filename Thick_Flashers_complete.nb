Cell[TextData[StyleBox["5. DISCRETIZED CURVED FOLDS",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{3.799974681824692*^9, 3.799974685149852*^9}, {
  3.804622173739697*^9, 
  3.804622181915004*^9}},ExpressionUUID->"57208be4-f372-4217-a774-\
bb37088a3f11"],

Cell[CellGroupData[{

Cell["Discretized curved folds", "Subsection",
 CellChangeTimes->{{3.691923916838069*^9, 3.691923928351379*^9}, {
  3.692008490094879*^9, 
  3.6920084905543327`*^9}},ExpressionUUID->"e63b2334-5e17-4258-ba16-\
cf17e10c47b5"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.691926887723531*^9, 
  3.691926888206231*^9}},ExpressionUUID->"cbd5e3ac-07da-47d2-94f6-\
5eb7b04eb184"],

Cell["\<\
In this section, we set up functions for discretizing curved folds.\
\>", "Text",
 CellChangeTimes->{{3.691926889893547*^9, 
  3.691926900597921*^9}},ExpressionUUID->"95aba2b6-188b-4f1e-9091-\
c4f67318bd83"],

Cell[TextData[{
 "If the fold angle is constant (it is ",
 StyleBox["uniform",
  FontSlant->"Italic"],
 "), there is a natural discretization scheme that applies."
}], "Text",
 CellChangeTimes->{{3.691926916677203*^9, 
  3.6919269637372513`*^9}},ExpressionUUID->"cee04d95-5d26-4e77-8612-\
8d581245ab47"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DiscretizeSystem[",
 StyleBox["sys",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.691925739549122*^9, 
  3.691925745905623*^9}},ExpressionUUID->"4044f244-26b3-4951-ad1f-\
1affdf821f28"],

Cell[TextData[{
 "DiscretizeSystem[",
 StyleBox["sys",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 "] takes any list of pure functions (or InterpolatingFunction) of a single \
variable and returns the same system, but with each function applied to a \
list of parameter values."
}], "Text",
 CellChangeTimes->{{3.691925750565691*^9, 3.691925757793976*^9}, {
   3.691925945547411*^9, 3.6919260193223133`*^9}, 
   3.692060467727962*^9},ExpressionUUID->"0b446d87-f345-4235-b91c-\
581d61dd0506"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["sys",
  FontSlant->"Italic"],
 " \[LongDash] a list of entries of the form ",
 StyleBox["key",
  FontSlant->"Italic"],
 " \[Rule] ",
 StyleBox["function",
  FontSlant->"Italic"],
 ", where function acts on a single variable.\n\t",
 StyleBox["tlist",
  FontSlant->"Italic"],
 " \[LongDash] a list of parameter values."
}], "Text",
 CellChangeTimes->{{3.691926022124073*^9, 3.691926052335691*^9}, {
  3.691926206082011*^9, 
  3.691926207673668*^9}},ExpressionUUID->"4c55d835-2a11-4248-88f0-\
6e3fc110c4da"],

Cell[TextData[{
 "Returns: the same list, of entries of the form ",
 StyleBox["key",
  FontSlant->"Italic"],
 " \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", where each list is the function applied to the values in ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.691926184934226*^9, 
  3.691926230955877*^9}},ExpressionUUID->"3c87a4ad-5125-4697-91ab-\
62de36ba44c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiscretizeSystem", "[", 
   RowBox[{"sys_List", ",", "tlist_List"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Rule]", 
     RowBox[{
      RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "/@",
       "tlist"}]}], "&"}], "/@", "sys"}]}]], "Input",
 CellChangeTimes->{{3.691926266519611*^9, 3.6919263484187*^9}, {
  3.691926501601604*^9, 3.691926511806682*^9}},
 CellLabel->
  "In[4084]:=",ExpressionUUID->"50b714c2-275e-4deb-afa1-98b98722ddc5"],

Cell["Example", "Text",
 CellChangeTimes->{{3.6919263637029676`*^9, 
  3.691926366161126*^9}},ExpressionUUID->"a49cc3e6-48b3-4603-be2f-\
b495d5c39fbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tlist", ",", "c", ",", "cc", ",", "sys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tlist", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "1", ",", ".25"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         SuperscriptBox["#", "2"]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         SuperscriptBox["#", "2"], ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sys", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Curve2D", "\[Rule]", "c"}], ",", 
        RowBox[{"Curve3D", "\[Rule]", "cc"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DiscretizeSystem", "[", 
      RowBox[{"sys", ",", "tlist"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.691926367356915*^9, 3.691926479469857*^9}, {
  3.691926523094195*^9, 3.691926526924243*^9}},
 CellLabel->
  "In[4085]:=",ExpressionUUID->"0a276df7-38ce-4718-ab2c-48ebed73581b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DiscretizeCurveUniformly[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", {u0, u1}]"
}], "Subsubsection",
 CellChangeTimes->{{3.6919239477443333`*^9, 3.691923969190735*^9}, {
   3.691924020848273*^9, 3.6919240218445888`*^9}, 3.6919247938905373`*^9, 
   3.69192499378745*^9, {3.691926685245758*^9, 3.691926705976809*^9}, {
   3.7995230967332*^9, 
   3.799523107993464*^9}},ExpressionUUID->"d40cf3fb-94a1-4922-ac87-\
8f86af1a094f"],

Cell[TextData[{
 "DiscretizeCurveUniformly[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", {u0, u1}] takes a curve function and returns a list of parameter values \
that discretize it for uniform fold angle."
}], "Text",
 CellChangeTimes->{{3.691924009294808*^9, 3.691924081415306*^9}, {
  3.6919248151732273`*^9, 3.691924840007051*^9}, {3.6919249955842667`*^9, 
  3.691924998224671*^9}, {3.6919266852849073`*^9, 3.691926711265639*^9}, {
  3.799523096757866*^9, 
  3.799523108012993*^9}},ExpressionUUID->"cce6602e-4887-40e2-94d6-\
81e978c50034"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the curved fold function.\n\t",
 StyleBox["n",
  FontSlant->"Italic"],
 " \[LongDash] the number of divisions. Each returned list will have n+1 \
entries.\n\t{u0, u1} \[LongDash] the interval of discretization."
}], "Text",
 CellChangeTimes->{{3.691924109204939*^9, 3.69192418289181*^9}, {
  3.691925010847618*^9, 3.6919250169958067`*^9}, {3.79952309678194*^9, 
  3.799523108030571*^9}},ExpressionUUID->"febc6812-9397-4049-939d-\
ec3b3e040f36"],

Cell["\<\
Returns: a list of t-values that give the desired discretization.\
\>", "Text",
 CellChangeTimes->{{3.6919249116470337`*^9, 
  3.69192492385483*^9}},ExpressionUUID->"0e0b66be-9ebf-47e4-bc36-\
b8d6d85646f8"],

Cell["This works for both 2D and 3D curves.", "Text",
 CellChangeTimes->{{3.6919249585926237`*^9, 
  3.6919249681155376`*^9}},ExpressionUUID->"94425408-22a2-495c-8fb4-\
564b79fe4515"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiscretizeCurveUniformly", "[", 
   RowBox[{"fn_Function", ",", "nt_", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dt", ",", "t", ",", "tvars", ",", "tvars0", ",", "dfn", ",", "eqns", ",",
       "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dt", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u1", "-", "u0"}], ")"}], "/", "nt"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tvars", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"t", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "nt"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tvars0", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"u0", "+", 
         RowBox[{"i", " ", "dt"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "nt"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dfn", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"fn", "[", "t", "]"}], ",", "t"}], "]"}], ",", "t"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t", "[", "0", "]"}], "\[Equal]", "u0"}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{
                RowBox[{"fn", "[", 
                 RowBox[{"t", "[", "i", "]"}], "]"}], "-", 
                RowBox[{"fn", "[", 
                 RowBox[{"t", "[", 
                  RowBox[{"i", "-", "1"}], "]"}], "]"}]}], 
               RowBox[{"Mag", "[", 
                RowBox[{
                 RowBox[{"fn", "[", 
                  RowBox[{"t", "[", "i", "]"}], "]"}], "-", 
                 RowBox[{"fn", "[", 
                  RowBox[{"t", "[", 
                   RowBox[{"i", "-", "1"}], "]"}], "]"}]}], "]"}]], "-", 
              FractionBox[
               RowBox[{
                RowBox[{"fn", "[", 
                 RowBox[{"t", "[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"fn", "[", 
                 RowBox[{"t", "[", "i", "]"}], "]"}]}], 
               RowBox[{"Mag", "[", 
                RowBox[{
                 RowBox[{"fn", "[", 
                  RowBox[{"t", "[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
                 RowBox[{"fn", "[", 
                  RowBox[{"t", "[", "i", "]"}], "]"}]}], "]"}]]}], ")"}], ".", 
            RowBox[{"dfn", "[", 
             RowBox[{"t", "[", "i", "]"}], "]"}]}], "\[Equal]", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"nt", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t", "[", "nt", "]"}], "\[Equal]", "u1"}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindRoot", "@@", 
       RowBox[{"{", 
        RowBox[{"eqns", ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"tvars", ",", "tvars0"}], "}"}], "]"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tvars", "/.", "soln"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.691924085652533*^9, 3.691924104780338*^9}, {
   3.691924201368586*^9, 3.691924206595025*^9}, {3.691924259902467*^9, 
   3.691924308605097*^9}, {3.691924357044239*^9, 3.691924509816358*^9}, {
   3.69192458125758*^9, 3.691924671418292*^9}, {3.691924847147581*^9, 
   3.691924939616151*^9}, {3.691925050566408*^9, 3.691925050892421*^9}, {
   3.691925240157289*^9, 3.691925243777562*^9}, {3.691926685301264*^9, 
   3.691926706040923*^9}, {3.691960236980081*^9, 3.691960247372917*^9}, 
   3.798622845657163*^9, {3.799523096792969*^9, 3.799523108039948*^9}},
 CellLabel->
  "In[4086]:=",ExpressionUUID->"2a73287a-1923-4338-8494-f366cd1578ac"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.691925135300885*^9, 
  3.691925136278569*^9}},ExpressionUUID->"e3a1bb96-d603-4aa0-8df5-\
4899a0799d84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", ",", "u0", ",", "u1", ",", "nt", ",", "tlist"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["#", "2"]}], ",", "#"}], "}"}], "&"}]}], ";", 
     RowBox[{"(*", " ", "parabola", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nt", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tlist", "=", 
      RowBox[{"DiscretizeCurveUniformly", "[", 
       RowBox[{"c", ",", "nt", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<tlist = \>\"", ",", "tlist"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"c", "[", "t", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "u0", ",", "u1", ",", ".01"}], "}"}]}], "]"}],
            "]"}], ",", "Red"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"c", "/@", "tlist"}], "]"}], ",", "Gray"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Point", "[", 
             RowBox[{"c", "[", "#", "]"}], "]"}], "&"}], "/@", "tlist"}], ",",
           "Black", ",", 
          RowBox[{"PointSize", "[", ".015", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.69192513979096*^9, 3.691925439973591*^9}, {
  3.691926685324918*^9, 3.691926705859363*^9}, {3.692217664990045*^9, 
  3.692217677424717*^9}, {3.799523096812183*^9, 3.799523108045493*^9}},
 CellLabel->
