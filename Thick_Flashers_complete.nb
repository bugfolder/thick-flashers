Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kp", ",", "ta", ",", "rcs", ",", "cc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kp", "=", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ta", "=", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rcs", "=", 
      RowBox[{"RecoverCurve3DSystemOld", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kp", ",", "ta"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "FullSimplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Theta]", ">", "0"}], ",", 
           RowBox[{"\[Theta]", "<", 
            RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"InitialPosition3D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", "0", ",", "0"}], 
          "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"InitialTangentVector3D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"InitialNormalVector3D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rcs", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//", 
      "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"Curve3D", "/.", "rcs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", "=", 
         RowBox[{"30", "\[Degree]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"cc", "[", "t", "]"}], ",", 
