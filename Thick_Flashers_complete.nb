Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InvertFolds", "::", "usage"}], 
   "=", "\"\<InvertFolds is an option to VeneerScoringGraphics that specifies \
to swap mountain and valley assignments in the scoring pattern.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.624895771306522*^9, 3.624895809176711*^9}, 
   3.624913968835318*^9, {3.624915105219548*^9, 3.624915105690913*^9}, 
