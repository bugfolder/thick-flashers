Cell["\<\
That\[CloseCurlyQuote]s enough to make a complete tessellation. Typically you\
\[CloseCurlyQuote]d use an ordering function, like this example.\
\>", "Text",
 CellChangeTimes->{{3.592505887359917*^9, 3.592505904228602*^9}, {
  3.592506011663105*^9, 
  3.592506012789652*^9}},ExpressionUUID->"9819ba72-8a17-4fd1-b67a-\
5021473e4314"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "n", ",", "tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
      "dir", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "7"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"MakeGoldbergTilingPrimalDualGraph", "[", 
       RowBox[{"m", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"OrientEdgePairs", "[", 
       RowBox[{"tobjpd", ",", 
        RowBox[{"RadialAxialOrderingFn", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", "1.15"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"25.71", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CW"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"TwistDirection", "\[Rule]", "dir"}], ",", 
        RowBox[{"PostRotation", "\[Rule]", "PrimalRotation"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PrimalDualGraphics", "[", 
          RowBox[{"tobjpd", ",", 
           RowBox[{"DualDirectedEdges", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"FaceupFace", "\[Rule]", "1"}]}], "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
