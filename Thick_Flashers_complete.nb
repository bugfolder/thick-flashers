Cell[CellGroupData[{

Cell["HCwC folds", "Subsection",
 CellChangeTimes->{{3.803587514781382*^9, 3.803587518052083*^9}, 
   3.803597149946061*^9},ExpressionUUID->"2d24b02c-fb05-4b2c-baec-\
