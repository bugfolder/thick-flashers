Cell[TextData[{
 "FuzzPoints[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fuzzrad, seed",
  FontSlant->"Italic"],
 "] takes a list of points and returns a version where each point has been \
perturbed by a random vector."
}], "Text",
 CellChangeTimes->{{3.708344487823364*^9, 3.7083445713782887`*^9}, {
   3.708345379319474*^9, 3.708345380197708*^9}, {3.708413905343265*^9, 
