   3.690651377828184*^9}, 3.690973257946775*^9, {3.690988939192072*^9, 
   3.690988939211789*^9}, {3.690989223009618*^9, 3.690989223024517*^9}, {
   3.69123544513852*^9, 3.691235445157853*^9}, 3.691252772025978*^9, {
   3.6914079221217213`*^9, 3.6914079285230713`*^9}, 3.691505396955882*^9, {
   3.691505452301759*^9, 3.691505471796139*^9}, {3.6924557890491*^9, 
   3.6924557961519938`*^9}, 3.799401888456038*^9, {3.7994023793670263`*^9, 
   3.799402379370369*^9}, {3.799403284406681*^9, 3.799403311258399*^9}, 
   3.800453578419615*^9, {3.803905867027183*^9, 3.803905868752012*^9}},
