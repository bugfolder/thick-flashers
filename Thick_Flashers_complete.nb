Cell[CellGroupData[{

Cell[TextData[{
 "RenderTileCache[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629763870930233*^9, 3.629763881702368*^9}, {
   3.629763993776374*^9, 3.629764011516386*^9}, {3.629816469351712*^9, 
   3.629816472410325*^9}, {3.6299760590620136`*^9, 3.629976064970721*^9}, 
   3.629976290722834*^9, {3.6303254973619432`*^9, 3.6303255090771017`*^9}, 
   3.630325640588631*^9, {3.63032600727026*^9, 3.630326016860929*^9}, 
   3.707771231682212*^9},ExpressionUUID->"0a9427c4-76a3-4078-9e74-\
4d3d9c1a1d3c"],

Cell[TextData[{
 "RenderTileCache[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the value of RenderTile[",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] and stores it associated with symbol RenderTileCache so that subsequent \
calls for the same tile are returned via pattern-matching lookup, rather than \
full recalculation, which can be quite expensive for \
VisibleFoldedFormGraphics."
}], "Text",
 CellChangeTimes->{{3.63032603434869*^9, 3.630326123326803*^9}, {
  3.707771261335854*^9, 
  3.707771265151475*^9}},ExpressionUUID->"a27b1df4-25d4-4975-bb68-\
be55231a392a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "RenderTileCache", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RenderTileCache", "[", 
   RowBox[{"tiletype_List", ",", "decoration_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"RenderTileCache", "[", 
    RowBox[{"tiletype", ",", "decoration", ",", "opts"}], "]"}], "=", 
   RowBox[{"RenderTile", "[", 
    RowBox[{"tiletype", ",", "decoration", ",", "opts"}], "]"}]}]}]}], "Input",\

 CellChangeTimes->{{3.6303259032135277`*^9, 3.630325970378108*^9}, {
  3.707774874096115*^9, 3.707774894033999*^9}, {3.707775010371014*^9, 
  3.707775012210479*^9}},
 CellLabel->
  "In[2796]:=",ExpressionUUID->"df78e498-42cc-458a-8c6c-9fa1bf565f4f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "EmbedTile[{",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["offset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", ",
 StyleBox["scale}, decoration, opts",
  FontSlant->"Italic"],
 "]\n\t(options) Numeric"
}], "Subsubsection",
 CellChangeTimes->{{3.707771234834202*^9, 
  3.70777123694459*^9}},ExpressionUUID->"15e6389f-b7d3-4c17-b708-\
132756d13b86"],

Cell[TextData[{
 "EmbedTile[{",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 ", ",
 StyleBox["offset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", ",
 StyleBox["scale}, decoration, opts",
  FontSlant->"Italic"],
 "] takes a ",
 StyleBox["tilespec",
  FontSlant->"Italic"],
 " and produces the specified decoration, offset, rotated, and scaled."
}], "Text",
 CellChangeTimes->{{3.629764118087059*^9, 3.629764146619921*^9}, {
   3.629764285268505*^9, 3.629764290274724*^9}, {3.629816346488064*^9, 
   3.629816370478095*^9}, {3.630325512029419*^9, 3.630325523012167*^9}, {
   3.6303255536108007`*^9, 3.630325577696783*^9}, 3.630325642108726*^9, {
   3.707771282592916*^9, 
   3.707771283584997*^9}},ExpressionUUID->"fab909c9-be19-4a4c-91e8-\
abc82c684b35"],

Cell["\<\
Options:
\tNumeric \[Rule] True | False, render vertices numerically.
\tOther options are passed through to RenderTile.\
\>", "Text",
 CellChangeTimes->{{3.707771285848469*^9, 
  3.707771287696423*^9}},ExpressionUUID->"78934ea7-f483-4b5b-a797-\
1c800d1b7683"],

Cell[TextData[{
 "Note that different versions of EmbedTile may be needed for different types \
of ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ". The default behavior handles all ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 " that return lists of Graphics or Graphics3D elements, plus the \
TileVertices ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", which returns a list of bare points that are the vertices of the \
underlying tile."
}], "Text",
 CellChangeTimes->{{3.629816868246509*^9, 3.62981692901029*^9}, {
   3.6298185018531303`*^9, 3.629818523939972*^9}, 
   3.707757311460832*^9},ExpressionUUID->"3c8a93a7-009b-46d9-b378-\
f91472de06fd"],

Cell[TextData[{
 "Normally this function is not called directly by users, but if you are \
introducing a new type of ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", you may need to create an implementation of EmbedTile for that ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.629817578540691*^9, 
  3.629817636716033*^9}},ExpressionUUID->"9b0ed0eb-a805-4a61-af0d-\
10c75a3caa63"],

Cell["\<\
See the implementation of EmbedTile for the TGraphAssigned, TGraph2DAssigned, \
and TGraph3DAssigned decorations below for an example of how to extend for a \
new type of decoration.\
\>", "Text",
 CellChangeTimes->{{3.707771304295318*^9, 3.7077713574170527`*^9}, {
  3.707837922786682*^9, 
  3.707837930382775*^9}},ExpressionUUID->"5d12154e-b2e7-4380-b4c1-\
dd06970ab407"],

Cell[TextData[{
 "Even if you don\[CloseCurlyQuote]t specify Numeric \[Rule] True, if any of ",
 StyleBox["offset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rotation",
  FontSlant->"Italic"],
 ", or ",
 StyleBox["scale",
  FontSlant->"Italic"],
 " are numeric, that will have the same effect of forcing all vertex \
coordinates to Numeric."
}], "Text",
 CellChangeTimes->{{3.629817520277266*^9, 3.629817562504957*^9}, 
   3.62981763036471*^9},ExpressionUUID->"48c8a8ec-ea93-483b-8c0b-\
bc40ca7d4a89"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Numeric", "::", "usage"}], 
   "=", "\"\<Numeric is an option to EmbedTile that applies N[] to tile \
coordinates.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.628372744268607*^9, 3.628372799108567*^9}, {
  3.628381101364735*^9, 3.628381108755254*^9}, {3.629816465015305*^9, 
  3.629816466747401*^9}},
 CellLabel->
  "In[2798]:=",ExpressionUUID->"31ce2962-02b0-412f-92f6-b819e4985ea5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "EmbedTile", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Numeric", "\[Rule]", "False"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
