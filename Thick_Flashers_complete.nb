Cell[CellGroupData[{

Cell["Converting MeshRegion to TGraph", "Subsection",
 CellChangeTimes->{{3.703164599296052*^9, 
  3.703164606839501*^9}},ExpressionUUID->"10e0e698-8c44-435c-9531-\
7f4fa05fb972"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.703164610294715*^9, 
  3.703164610815431*^9}},ExpressionUUID->"dd3ab9c0-1aeb-4ee7-8ae7-\
117fb59c9bfb"],

Cell["\<\
Mathematica 11 introduced the MeshRegion. These functions convert MeshRegions \
to TGraphs.\
\>", "Text",
 CellChangeTimes->{{3.703164613247346*^9, 3.703164696400422*^9}, 
   3.7068239490454*^9},ExpressionUUID->"e8e8eb29-bbba-4295-b42b-7b522cf60386"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PolygonMeshRegionToTGraph[",
 StyleBox["mreg",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.703164705208201*^9, 
  3.7031647167445107`*^9}},ExpressionUUID->"ed5ee9d1-9afb-4fb8-8265-\
3d8404f5c1a3"],

Cell[TextData[{
 "PolygonMeshRegionToTGraph[",
 StyleBox["mreg",
  FontSlant->"Italic"],
 "] converts a MeshRegion consisting of 2D Polygons to a TGraph, preserving \
order of Vertices and Faces."
}], "Text",
 CellChangeTimes->{{3.703164729922677*^9, 3.7031647608086586`*^9}, {
  3.70316508938879*^9, 
  3.703165116955761*^9}},ExpressionUUID->"4b1ec7aa-a596-43f8-8200-\
9783224e9b3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonMeshRegionToTGraph", "[", "mreg_MeshRegion", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "faces", ",", "edges"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"MeshCoordinates", "[", "mreg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{
       RowBox[{"MeshCells", "[", 
        RowBox[{"mreg", ",", "2"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"Polygon", "[", "pp_", "]"}], "\[RuleDelayed]", "pp"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"EdgesFromFaces", "[", "faces", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.703164765563342*^9, 3.703164776072343*^9}, {
  3.703164851106822*^9, 3.703164921956739*^9}, {3.703164962363116*^9, 
  3.703165031723016*^9}},
 CellLabel->
  "In[1254]:=",ExpressionUUID->"3eba424b-5288-4593-8994-1266eb4bcd7a"],

Cell["Example", "Text",
 CellChangeTimes->{{3.703164777944219*^9, 
  3.7031647786650567`*^9}},ExpressionUUID->"39d8cf30-804d-48a8-90cc-\
49921afe4463"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "vm", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"20", ",", "2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vm", "=", 
      RowBox[{"VoronoiMesh", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", "vm", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"PolygonMeshRegionToTGraph", "[", "vm", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphGraphics", "[", "tobj", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.703163823605801*^9, 3.703163844351448*^9}, {
  3.703164181317622*^9, 3.703164304985589*^9}, {3.703164806153788*^9, 
  3.703164854282957*^9}, {3.703164927057897*^9, 3.70316492861018*^9}, {
  3.703165036891896*^9, 3.703165066571189*^9}, {3.703165128060924*^9, 
  3.703165128284132*^9}, {3.703165596145997*^9, 3.703165612937061*^9}},
 CellLabel->
  "In[1255]:=",ExpressionUUID->"f81e91e2-18df-4a28-8e3a-9a7279e9f1be"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Flopping, rotation", "Subsection",
 CellChangeTimes->{{3.706877528915208*^9, 
  3.7068775326808662`*^9}},ExpressionUUID->"a97521c1-4f6c-423d-82fa-\
e1f080c9e24a"],

Cell[CellGroupData[{

Cell[TextData[{
 "FlopGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) FlopDirection"
}], "Subsubsection",
 CellChangeTimes->{{3.6277676529263363`*^9, 3.627767695299454*^9}, {
  3.722098262331099*^9, 
  3.722098263745302*^9}},ExpressionUUID->"dfcc5ca8-5249-4aa6-b62c-\
6b41ecc4d493"],

Cell[TextData[{
 "FlopGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] flops the Vertices of the given TGraph, as if you had turned over the \
crease pattern."
}], "Text",
 CellChangeTimes->{{3.627767712997183*^9, 3.627767736098975*^9}, {
  3.627767770510756*^9, 3.627767778757546*^9}, {3.627767831181095*^9, 
  3.6277678561047783`*^9}, {3.722098265569955*^9, 
  3.722098286762128*^9}},ExpressionUUID->"2396949f-e8a6-4365-b325-\
8d9b134214b1"],

Cell["\<\
Options are:
\tFlopDirection \[Rule] Horizontal | Vertical, specifies the direction (not \
axis) of flopping.\
\>", "Text",
 CellChangeTimes->{
  3.7220982769066777`*^9},ExpressionUUID->"13bfc7ae-a7ff-4845-bc3e-\
67597fe4d934"],

Cell["\<\
Note: since flopping reverses the order of Faces, if you apply FlopGraph to a \
TPlaneGraph, you\[CloseCurlyQuote]ll need to rebuild it because all of the \
TPlaneGraph fields will be invalidated.\
\>", "Text",
 CellChangeTimes->{{3.722101478386281*^9, 
  3.722101543667802*^9}},ExpressionUUID->"7f82255a-e3d2-4fa3-8eae-\
92b5919d340f"],

Cell["See also FlopGraphAssigned, FlopGraph2D, FlopGraph3D.", "Text",
 CellChangeTimes->{{3.722101546067308*^9, 
  3.722101565507452*^9}},ExpressionUUID->"d6ceb1eb-01d5-45f6-ab51-\
c5d8808fdde0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlopDirection", "::", "usage"}], 
   "=", "\"\<FlopDirection is an option to FlopGraph that specifies the \
direction of flopping of the crease pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.62776789654139*^9, 3.627767918789322*^9}, {
  3.722098290648883*^9, 3.722098295753338*^9}},
 CellLabel->
  "In[1256]:=",ExpressionUUID->"8d06fdd1-619d-46a5-b743-02f91b6b3c4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FlopGraph", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"FlopDirection", "\[Rule]", "Horizontal"}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.627767875691601*^9, 3.627767894200099*^9}, {
  3.722101475836792*^9, 3.722101475978634*^9}},
 CellLabel->
  "In[1257]:=",ExpressionUUID->"4d24383f-590b-4206-acba-143dd53a0961"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlopGraph", "[", 
   RowBox[{
    StyleBox["tobj_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fd", ",", "verts", ",", "faces", ",", "ctr"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "FlopGraph"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fd", "=", 
      RowBox[{
       RowBox[{"FlopDirection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FlopGraph", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hori", "=", 
      RowBox[{"(", 
       RowBox[{"fd", "===", "Horizontal"}], ")"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#1", "]"}], "+", 
             RowBox[{"Min", "[", "#1", "]"}]}], ")"}], "/", "2"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "#2", "]"}], "+", 
             RowBox[{"Min", "[", "#2", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "&"}], "@@", 
       RowBox[{"Transpose", "[", "verts", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"fd", "===", "Horizontal"}], ",", "\[IndentingNewLine]", 
       RowBox[{"verts", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ctr", "+", 
           RowBox[{"ReflectionYMatrix2D", ".", 
            RowBox[{"(", 
             RowBox[{"#", "-", "ctr"}], ")"}]}]}], "&"}], "/@", "verts"}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"verts", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ctr", "+", 
           RowBox[{"ReflectionXMatrix2D", ".", 
            RowBox[{"(", 
             RowBox[{"#", "-", "ctr"}], ")"}]}]}], "&"}], "/@", "verts"}]}]}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"Reverse", "/@", "faces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperties", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", "verts"}], ",", 
         RowBox[{"Faces", "\[Rule]", "faces"}]}], "}"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627767928398541*^9, 3.627768044131306*^9}, {
  3.627768136345787*^9, 3.627768244068619*^9}, {3.627768277187147*^9, 
