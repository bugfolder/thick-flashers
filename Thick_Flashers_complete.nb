Cell[TextData[{
 "AddTAssigned[",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns a pure function that adds a TAssigned class to its argument with \
EdgeTypes ",
 StyleBox["types.",
  FontSlant->"Italic"],
 " If ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is empty, all edges will be given the U (Unassigned) type."
}], "Text",
 CellChangeTimes->{{3.592660673469639*^9, 3.5926607024597473`*^9}, {
  3.592828863235948*^9, 3.592828863329564*^9}, {3.62568457643357*^9, 
  3.625684590335121*^9}, {3.625684638980268*^9, 
  3.625684663938617*^9}},ExpressionUUID->"a1db3c49-2b10-41c3-957f-\
592ca0322789"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddTAssigned", "[", 
   RowBox[{"types_List", ":", 
    RowBox[{"{", "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"AddTAssignedTo", "[", 
    RowBox[{"#", ",", "types"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.592660712195681*^9, 3.592660726134669*^9}, {
  3.59282886342764*^9, 3.592828863494886*^9}, {3.592855544888287*^9, 
  3.592855545686268*^9}},
 CellLabel->
  "In[1799]:=",ExpressionUUID->"cefab5bd-f3c7-4387-a301-2c499e572102"],

