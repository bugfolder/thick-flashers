Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"u0", ",", "u1", ",", "v0", ",", "v1", ",", "ss", ",", "uu"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[Pi]"}], "/", "3"}], ",", 
        RowBox[{"\[Pi]", "/", "3"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"{", 
         RowBox[{"#1", ",", 
          RowBox[{"Sin", "[", "#2", "]"}], ",", 
          RowBox[{
           RowBox[{"Cos", "[", "#2", "]"}], "-", "1"}]}], "}"}]}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"NSurfaceNormalFromSurface", "[", 
       RowBox[{"ss", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v0", ",", "v1"}], "}"}], ",", 
        RowBox[{"SurfaceOrientation", "\[Rule]", 
         RowBox[{"+", "1"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Styled3DAxes", "[", 
            RowBox[{"2.2", ",", "2", ",", "1"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StyledPatch", "[", 
            RowBox[{"ss", ",", 
             RowBox[{"{", 
              RowBox[{"u0", ",", "u1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StyledSurfaceNormalGrid", "[", 
            RowBox[{"ss", ",", "uu", ",", 
             RowBox[{"{", 
              RowBox[{"u0", ",", "u1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", "}"}]}], "}"}], ",", 
         RowBox[{"Lighting", "\[Rule]", 
          RowBox[{"NeutralLighting", "[", ".9", "]"}]}]}], "]"}], "/.", 
       "CurveVectorStyle"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
