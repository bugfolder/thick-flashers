Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CanonicalTangentDevelopableSystem", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.68980816965057*^9, 3.689808183674678*^9}, 
   3.690988494021354*^9, 3.691161081339386*^9, 3.691365870681203*^9, 
   3.691955081705477*^9, 3.691956229421962*^9},
 CellLabel->
  "In[3828]:=",ExpressionUUID->"807c52d6-7ba9-437e-b581-aa1ced2c57b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonicalTangentDevelopableSystem", "[", 
   RowBox[{"bbf_Function", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "sfn", ",", "u", ",", "v", ",", "bb", ",", "dbb", ",",
       "ds", ",", "dd", ",", "ss", ",", "al", ",", "alf", ",", "cc"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CanonicalTangentDevelopableSystem", "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CanonicalTangentDevelopableSystem", "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "\[Element]", "Reals"}], ",", 
           RowBox[{"v", "\[Element]", "Reals"}]}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"bbf", "[", "u", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "directrix", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dbb", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"bb", ",", "u"}], "]"}], "//", "sfn"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"velocity", " ", "of", " ", "directrix"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{
       RowBox[{"Mag", "[", "dbb", "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"speed", " ", "of", " ", "directrix"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"dbb", "/", "ds"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", "director", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"bb", "+", 
        RowBox[{"v", " ", "dd"}]}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"surface", " ", "function"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"al", "=", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{"ds", ",", "u"}], "]"}], "//", "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"arc", " ", "length", " ", "of", " ", "directrix"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"alf", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{"al", ",", "u"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"arc", " ", "length", " ", "function"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"bb", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"alf", "[", "v", "]"}], "-", 
           RowBox[{"1", 
            RowBox[{"alf", "[", "u", "]"}]}]}], ")"}], "dd"}]}], "//", 
       "sfn"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"cross", " ", "curve", " ", "surface"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Directrix", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"bb", ",", "u"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Director", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"dd", " ", ",", "u"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"DevelopableSurface", " ", "\[Rule]", " ", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"ss", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"CrossCurveSurface", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{"cc", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]",
       "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.689808144427472*^9, 3.689808167553638*^9}, {
