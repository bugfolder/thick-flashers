Cell[TextData[{
 "AddDistinctEdgeData",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edge",
  FontSlant->"Italic"],
 "] adds an indexed edge to the given TGraph. It returns a list {",
 StyleBox["tobj1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ei",
  FontSlant->"Italic"],
 "}, where ",
 StyleBox["tobj1",
  FontSlant->"Italic"],
 " is the modified TGraph and ",
 StyleBox["ei",
  FontSlant->"Italic"],
 " is the index of the added edge. If the edge already exists (in either \
vertex order), then ",
 StyleBox["tobj1",
  FontSlant->"Italic"],
 " is the same as ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " and the index of the existing edge is returned."
}], "Text",
 CellChangeTimes->{{3.5946499950492477`*^9, 3.594650015535738*^9}, {
   3.594650071652143*^9, 3.5946500781811647`*^9}, 3.5946501142813463`*^9, {
   3.5946535525805893`*^9, 3.594653553004459*^9}, {3.594655447339725*^9, 
   3.594655476432639*^9}, {3.594655548867978*^9, 3.594655600792004*^9}, 
   3.594659603129503*^9},ExpressionUUID->"b4dfb4e3-5d8e-4dba-b000-\
a453ea87bed7"],

Cell[TextData[{
 "If the submitted edge has the same indices for both vertices, the graph is \
returned unchanged and ",
 StyleBox["ei",
  FontSlant->"Italic"],
 " will be Null. This can be very useful; if you have a graph that might have \
degenerate vertices, you can build it up from the embedding by adding all \
possible edges, and edges that connect degenerate vertices will be \
automatically ignored."
}], "Text",
 CellChangeTimes->{{3.5946596088640423`*^9, 3.594659736437612*^9}, {
  3.594659861902479*^9, 
  3.594659934662999*^9}},ExpressionUUID->"d8a7879a-5dc1-47f8-8591-\
c132d209dfa3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddDistinctEdgeData", "[", 
   RowBox[{"tobj_TObj", ",", "e_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"edges", ",", "ei"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Equal", "@@", "e"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"tobj", ",", "Null"}], "}"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ei", "=", 
      RowBox[{"FindEdge", "[", 
       RowBox[{"tobj", ",", "e"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ei", "===", "Null"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tobj", "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"Edges", "\[Rule]", 
            RowBox[{"Append", "[", 
             RowBox[{"edges", ",", "e"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"1", "+", 
          RowBox[{"Length", "[", "edges", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"tobj", ",", "ei"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.594653541076376*^9, 3.594653593700266*^9}, {
   3.594655850390601*^9, 3.594655938289127*^9}, {3.594656417393729*^9, 
   3.5946564589567957`*^9}, 3.5946576012994547`*^9, {3.594659352237652*^9, 
   3.594659388839278*^9}, {3.59465977557646*^9, 3.5946598097725487`*^9}},
 CellLabel->
  "In[1215]:=",ExpressionUUID->"78a0e1e5-5478-414b-bc83-5249d33b7cef"],

Cell[TextData[{
 "AddDistinctEdge[",
 StyleBox["e",
  FontSlant->"Italic"],
 "] returns a pure function that adds the edge to the TGraph and returns just \
the modified TGraph."
}], "Text",
 CellChangeTimes->{{3.59465594312105*^9, 3.594655959504685*^9}, {
  3.59465760630389*^9, 
  3.5946576160937552`*^9}},ExpressionUUID->"44608a65-2ed8-40c1-bfba-\
82b6cc3dd856"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddDistinctEdge", "[", "e_List", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"AddDistinctEdgeData", "[", 
     RowBox[{"#", ",", "e"}], "]"}], "\[LeftDoubleBracket]", "1", 
    "\[RightDoubleBracket]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.594655979445245*^9, 3.594656019000054*^9}, {
  3.594657601547488*^9, 3.594657621847228*^9}},
 CellLabel->
  "In[1216]:=",ExpressionUUID->"794df30f-59b6-4af1-b77a-feb32161b8f3"],

