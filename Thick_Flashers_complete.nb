Cell[CellGroupData[{

Cell[TextData[{
 "EdgeFaceAngles",
 "2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph2D, TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.595335988604109*^9, 3.595335993065559*^9}, 
   3.5953360430803547`*^9, 3.595336084902326*^9, {3.595344015740616*^9, 
   3.5953440239462423`*^9}, 
   3.626459162890172*^9},ExpressionUUID->"0416c1b5-eee7-4e1d-abae-\
99f354ae10d5"],

Cell[TextData[{
 "EdgeFaceAngles",
 "2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of the edge face angles from the 2D embedding Vertices2D, \
according to these rules:\n\tBoundary edges have an edge angle of 0 by \
definition.\n\tEdges between two faces with the same winding number have an \
edge angle of 0.\n\tEdges between two faces with opposite winding numbers \
have an edge angle of \[Pi].\nNote that for an assigned crease pattern (see \
TAssigned, below) the edge angle in this case could actually be \[PlusMinus]\
\[Pi]. This function always returns +\[Pi]. This is still sufficient to \
reproduce the 2D embedding using FoldGraph2D."
}], "Text",
 CellChangeTimes->{{3.5953359945062833`*^9, 3.59533601892816*^9}, {
   3.595336092596756*^9, 3.595336236834133*^9}, {3.595339271895361*^9, 
   3.595339274637434*^9}, {3.595339643662042*^9, 3.595339651165415*^9}, {
   3.595339720216488*^9, 3.595339774589556*^9}, 3.626459163095647*^9, {
   3.626462750343433*^9, 
   3.626462750942364*^9}},ExpressionUUID->"22311678-2fc3-43f9-9fa7-\
277b07bb46b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeFaceAngles2D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts2d", ",", "faces", ",", "efi", ",", "fwn", ",", "fpair"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", "faces", ",", "efi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices2D", ",", "Faces", ",", "EdgeFaceIncidence"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fwn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"WindingNumber", "[", 
         RowBox[{"verts2d", ",", "#"}], "]"}], "&"}], "/@", "faces"}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{"winding", " ", "number", " ", "of", " ", "each", " ", "face"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fpair", "=", 
         RowBox[{
         "efi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"fpair", ",", "0"}], "]"}], ",", "\[IndentingNewLine]", 
          "0", ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fwn", "\[LeftDoubleBracket]", 
              RowBox[{
              "fpair", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
               "\[RightDoubleBracket]"}], "\[Equal]", " ", 
             RowBox[{"fwn", "\[LeftDoubleBracket]", 
              RowBox[{
              "fpair", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
               "\[RightDoubleBracket]"}]}], ",", "0", ",", "\[Pi]"}], "]"}]}],
          "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "efi", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.595339044710459*^9, 3.595339158399909*^9}, {
   3.595339222755669*^9, 3.595339251347137*^9}, {3.595339295766979*^9, 
   3.595339378835322*^9}, {3.59533943144966*^9, 3.5953395741185913`*^9}, {
   3.595339608149478*^9, 3.595339630075109*^9}, {3.595339678720539*^9, 
   3.595339685154252*^9}, 3.626459163217787*^9},
 CellLabel->
  "In[1323]:=",ExpressionUUID->"6223be8e-fcb2-4de1-b804-b9f92a1be527"],

