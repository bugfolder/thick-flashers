Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GraphicsToTGraph", "::", "dupvert"}], 
   "=", "\"\<The extracted edges `1` contain at least one edge with duplicate \
vertices `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.485092643254809*^9, 3.485092647189043*^9}, 
   3.592387031712519*^9, 3.592435852361111*^9},
 CellLabel->
  "In[1251]:=",ExpressionUUID->"804c92cd-a36d-40b2-98d5-310da08b4d3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GraphicsToTGraph", "[", 
   RowBox[{"obj_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tol", ",", "fif", ",", "llist", ",", "verts", ",", "edges", ",", 
      "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"SamePtTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GraphicsToTGraph", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fif", "=", 
      RowBox[{
       RowBox[{"AddTPlaneGraphTo", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "GraphicsToTGraph", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"llist", "=", 
      RowBox[{"ExtractFracturedLines", "[", "obj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{
        RowBox[{"First", "/@", "llist"}], ",", "2", ",", 
        RowBox[{"SamePtTolerance", "\[Rule]", "tol"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"Length", "/@", 
           RowBox[{"Union", "/@", "edges"}]}], "]"}], "===", 
         RowBox[{"{", "2", "}"}]}]}], ",", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"GraphicsToTGraph", "::", "dupvert"}], ",", "edges", ",", 
         "verts"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"verts", ",", "edges"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.485092386338882*^9, 3.485092440314746*^9}, {
   3.485092472289438*^9, 3.485092546699832*^9}, {3.4850925958697863`*^9, 
