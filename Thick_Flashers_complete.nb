        RowBox[{"tobj", "=", 
         RowBox[{"MakeTYoshimuraOri", "[", 
          RowBox[{"vtobj", ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"nh", ",", "nv"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
