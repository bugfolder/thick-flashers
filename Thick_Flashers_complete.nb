7d3b2a81867c"],

Cell["\<\
Here\[CloseCurlyQuote]s a picture of the arrangement labeling points and \
edges.\
\>", "Text",
 CellChangeTimes->{{3.595802209080818*^9, 3.5958022136001983`*^9}, {
  3.595802828145071*^9, 
  3.595802831216759*^9}},ExpressionUUID->"c102197d-f925-48e9-81ac-\
eaadc812a6d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "q", ",", "r", ",", "s", ",", "a", ",", "b", ",", "c", ",", 
      "d", ",", "e", ",", "f"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "/", "2"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         SqrtBox["2"]}], ",", "0", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         SqrtBox["2"]}], ",", "0", ",", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"p", ",", "q", ",", "r"}], "}"}], "]"}], ",", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"p", ",", "q", ",", "s"}], "}"}], "]"}], ",", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"p", ",", "r", ",", "s"}], "}"}], "]"}], ",", 
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{"q", ",", "r", ",", "s"}], "}"}], "]"}]}], "}"}], ",", 
           
           RowBox[{"Opacity", "[", "0.9", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", 
            RowBox[{"{", 
             RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}]}], ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"\"\<p\>\"", ",", "p", ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<q\>\"", ",", "q", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"-", "1.5"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<r\>\"", ",", "r", ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<s\>\"", ",", "s", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"FontSize", "\[Rule]", "14"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{"\"\<a\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", "+", "q"}], ")"}], "/", "2"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<b\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", "+", "s"}], ")"}], "/", "2"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<c\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"s", "+", "q"}], ")"}], "/", "2"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<d\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", "+", "r"}], ")"}], "/", "2"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<e\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "+", "q"}], ")"}], "/", "2"}]}], "]"}], ",", 
             RowBox[{"Text", "[", 
              RowBox[{"\"\<f\>\"", ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "+", "s"}], ")"}], "/", "2"}]}], "]"}]}], "}"}],
            ",", 
           RowBox[{"FontSize", "\[Rule]", "14"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"Lighting", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"Boxed", "\[Rule]", "True"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.595802214892312*^9, 3.595802376137965*^9}, {
  3.595802415594048*^9, 3.595802810698934*^9}, {3.595975958392028*^9, 
  3.5959759701421757`*^9}},
 CellLabel->
