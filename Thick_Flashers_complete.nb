Cell[TextData[{
 "CanonicalCylinderDevelopableSystem[",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions"
}], "Subsubsection",
 CellChangeTimes->{{3.689848398656933*^9, 3.689848414247396*^9}, 
   3.689848544820633*^9, 3.690988444661417*^9, {3.6912540779558697`*^9, 
   3.6912540795086527`*^9}, {3.691365286091098*^9, 
   3.69136528871244*^9}},ExpressionUUID->"64ca21ea-2722-4c88-a129-\
7f90c581fd9c"],

Cell[TextData[{
 "CanonicalCylinderDevelopableSystem[",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs the canonical form functions for a generalized cylinder from \
an arbitrary directrix and a constant director."
}], "Text",
 CellChangeTimes->{
  3.689848430490718*^9, {3.689848485584676*^9, 3.689848525024648*^9}, {
   3.689849645902365*^9, 3.689849646419836*^9}, {3.69136525153568*^9, 
   3.6913652593811607`*^9}, {3.691365780877742*^9, 3.6913657816782017`*^9}, {
   3.691954789235505*^9, 
   3.691954814956877*^9}},ExpressionUUID->"040b7a44-4448-4a3e-85c4-\
105f9bec715f"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] an arbitrary directrix as a pure function.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] a constant director as a pure function."
}], "Text",
 CellChangeTimes->{{3.691365169540002*^9, 
  3.69136520200457*^9}},ExpressionUUID->"7c2324f2-b007-42f7-a1c4-\
fd4ecd5b4754"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
  3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
  3.6912356648227*^9}, {3.691241735558269*^9, 
  3.691241736473103*^9}},ExpressionUUID->"8f1ef707-63d2-4162-a90e-\
002311075966"],

Cell["\<\
Returns: a list of rules for the surface, canonical directrix and director, \
and the cross-curve surface.\
\>", "Text",
 CellChangeTimes->{{3.69136521901416*^9, 
  3.691365243707859*^9}},ExpressionUUID->"8d7fa023-440d-4942-994e-\
77ba4a3e8e9d"],

