Cell[BoxData[
 RowBox[{
  RowBox[{"Styled3DSolidArrow", "[", 
   RowBox[{"r1_List", ",", "r2_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rr", "=", 
       RowBox[{"Mag", "[", 
        RowBox[{"r2", "-", "r1"}], "]"}]}], ",", "ahf", ",", "ahr", ",", "ar",
       ",", "\[Alpha]", ",", "fs", ",", "rx"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ahf", "=", 
      RowBox[{
       RowBox[{"ArrowheadFraction", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DSolidArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ahr", "=", 
      RowBox[{
       RowBox[{"ArrowheadRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DSolidArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ar", "=", 
      RowBox[{
       RowBox[{"ArrowRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DSolidArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{
       RowBox[{"ArrowLabel", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DSolidArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{
       RowBox[{"FillStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DSolidArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rx", "=", 
      RowBox[{
       RowBox[{"ahf", " ", "r1"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "ahf"}], ")"}], " ", "r2"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cylinder", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r1", ",", "rx"}], "}"}], ",", 
             RowBox[{"ar", " ", "ahf", " ", "rr"}]}], "]"}], ",", 
           RowBox[{"Cone", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rx", ",", "r2"}], "}"}], ",", 
             RowBox[{"ahr", " ", "ahf", " ", "rr"}]}], "]"}]}], "}"}], ",", 
         "fs"}], "]"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"\[Alpha]", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\[Alpha]", ",", "r2"}], "]"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.43998565242043*^9, 3.4399857835764627`*^9}, {
