Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "tobj", ",", "size", ",", "vsp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.7", ",", ".7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.7", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".5", ",", "2.21"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRadialPot", "[", 
       RowBox[{"pts", ",", "8", ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"size", "=", "425"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"15", " ", "cm"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vsp", "=", 
      RowBox[{"VeneerScoringCarveGraphics", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"ImageSize", "\[Rule]", "size"}], ",", 
        RowBox[{"InvertFolds", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], ",", "vsp"}], 
         "}"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ExamplesDir", "[", "]"}], 
        "<>", "\"\<VeneerScoringCarveGraphics.eps\>\""}], ",", 
       RowBox[{"Show", "[", 
        RowBox[{"vsp", ",", 
         RowBox[{"PlotRangePadding", "\[Rule]", "0"}]}], "]"}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "size"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6248949601808043`*^9, 3.624895017480774*^9}, {
