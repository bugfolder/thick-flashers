Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r2d", ",", "c", ",", "cc", ",", "mcids", ",", "d", ",", "dd", ",", "u0",
       ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r2d", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"r2d", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"#", "/", "r2d"}], "]"}], ",", 
          RowBox[{"Sin", "[", 
           RowBox[{"#", "/", "r2d"}], "]"}]}], "}"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", "1"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", "d", ",", "cc", ",", "dd"}], "}"}], "=", 
      RowBox[{"MatchCurvesPair", "[", 
       RowBox[{"c", ",", "cc", ",", "1", ",", "1", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c[t] = \>\"", ",", 
       RowBox[{"c", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<d[t] = \>\"", ",", 
       RowBox[{"d", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<cc[t] = \>\"", ",", 
       RowBox[{"cc", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<dd[t] = \>\"", ",", 
       RowBox[{"dd", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"c", ",", "d", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"c", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledVector", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"c", "[", "u0", "]"}], ",", 
                RowBox[{
                 RowBox[{"c", "[", "u0", "]"}], "+", 
                 RowBox[{"d", "[", "u0", "]"}]}]}], "}"}], ",", 
              RowBox[{"VectorColor", "\[Rule]", "Orange"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"StyledRuledPatch", "[", 
              RowBox[{"cc", ",", "dd", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"StyledCurve", "[", 
              RowBox[{"cc", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"StyledVector", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cc", "[", "u0", "]"}], ",", 
                 RowBox[{
                  RowBox[{"cc", "[", "u0", "]"}], "+", 
                  RowBox[{"dd", "[", "u0", "]"}]}]}], "}"}], ",", 
               RowBox[{"VectorColor", "\[Rule]", "Orange"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}], "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
