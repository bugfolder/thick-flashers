Cell[BoxData[
 RowBox[{
  RowBox[{"Curve3DSystem", "[", 
   RowBox[{"c_Function", ",", "opts___"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "sfn", ",", "s", ",", "dc", ",", "ds", ",", "t", ",",
       "dt", ",", "mdt", ",", "\[Kappa]", ",", "n", ",", "b", ",", "\[Tau]"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Curve3DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Curve3DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"dc", "[", "s", "]"}], "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"dc", "[", "s", "]"}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mdt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"dt", "[", "s", "]"}], "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"mdt", "[", "s", "]"}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"dt", "[", "s", "]"}], "/", 
          RowBox[{"mdt", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", "s", "]"}], "\[Cross]", 
          RowBox[{"n", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{
             RowBox[{"b", "'"}], "[", "s", "]"}], ".", 
            RowBox[{"n", "[", "s", "]"}]}]}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve3D", "\[Rule]", "c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed3D", "\[Rule]", "ds"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Curvature3D", "\[Rule]", "\[Kappa]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Torsion3D", "\[Rule]", "\[Tau]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", "t"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BinormalVector3D", "\[Rule]", "b"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalVector3D", "\[Rule]", "n"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
