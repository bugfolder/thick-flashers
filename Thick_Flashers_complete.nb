Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bb", ",", "dd", ",", "u", ",", "v", ",", "ss"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "#", ",", 
         SuperscriptBox["#", "2"]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{
         RowBox[{"bb", "[", "u", "]"}], "+", 
         RowBox[{"v", " ", 
          RowBox[{"dd", "[", "u", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ss", "//", "PrettyParameters"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"StyledRuledPatch", "[", 
           RowBox[{"ss", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", ".5"}], ",", ".5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", ".5"}], ",", ".5"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"RulingLineStyle", "\[Rule]", "CreaseLine"}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"StyledCurve", "[", 
           RowBox[{"bb", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", ".5"}], ",", ".5"}], "}"}], ",", 
            RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
