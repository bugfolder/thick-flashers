Cell[TextData[{
 "HCwCCircle4[",
 StyleBox["ti1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]1i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]2i",
  FontSlant->"Italic"],
 "]\nHCwCCircle4Parms"
}], "Subsubsection",
 CellChangeTimes->{{3.803558312087694*^9, 3.803558331144116*^9}, {
   3.803558418801517*^9, 3.803558423079438*^9}, {3.803558721690323*^9, 
   3.803558722810429*^9}, 3.803573209579165*^9, 3.803574308496976*^9, {
   3.80359782615994*^9, 
   3.803597835360161*^9}},ExpressionUUID->"e47d0428-6d15-463d-8329-\
e462b8a627a6"],

Cell[TextData[{
 "HCwCCircle4[",
 StyleBox["ti1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]1i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]2i",
  FontSlant->"Italic"],
 "] constructs the building block for the Huffman Hexagonal Column with Cusps \
using a circle of radius 4 for the second curve and incorporating optional \
conic surfaces at the beginning and end of the first fold."
}], "Text",
 CellChangeTimes->{{3.803558338249037*^9, 3.803558377793177*^9}, 
   3.803558429625379*^9, {3.803558723793661*^9, 3.803558724985488*^9}, {
   3.803573209595047*^9, 3.803573259266699*^9}, {3.803574308509317*^9, 
   3.803574321394639*^9}},ExpressionUUID->"570774ec-067b-44be-873d-\
29381812cc04"],

Cell["\<\
Arguments:
\tti1 \[LongDash] parameter value at end of first cone.
\tti2 \[LongDash] parameter value at beginning of second cone.
\t\[Gamma]1i \[LongDash] initial value of the first fold angle at parameter t1.
\t\[Gamma]2i \[LongDash] initial value of the second fold angle at parameter \
t1.\
\>", "Text",
 CellChangeTimes->{{3.80355837979987*^9, 3.803558478536791*^9}, {
  3.80355872599404*^9, 
  3.803558726697731*^9}},ExpressionUUID->"06d3ae2b-3656-49f8-8ff9-\
4662c3829136"],

Cell["\<\
Returns: a list {f0,f1,f2,f3,ff0,ff1,ff2,ff3,xL,xR,yL,yR,z,pv,q,\[Gamma]1,\
\[Gamma]2} of the 2D and 3D fold vectors, mirror frame vectors, and pivot \
vector for the given set of parameters.\
\>", "Text",
 CellChangeTimes->{{3.803567478505994*^9, 3.803567511898466*^9}, {
  3.80356769341923*^9, 3.803567749236916*^9}, {3.8035731570660973`*^9, 
  3.803573158265648*^9}},ExpressionUUID->"fb7af347-8d93-4273-8a08-\
d92c8edece8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HCwCCircle4", "[", 
   RowBox[{
    RowBox[{"ti1_", "?", "NumericQ"}], ",", 
    RowBox[{"ti2_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Gamma]1i_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Gamma]2i_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "iopts", ",", "q", ",", "t", ",", "\[IndentingNewLine]", "ti0", ",", 
      "ti3", ",", "ti12", ",", "\[IndentingNewLine]", "f0", ",", "ds0", ",", 
      "b\[Kappa]g0", ",", "b\[Kappa]n0", ",", "s\[Lambda]0", ",", 
      "\[IndentingNewLine]", "f1", ",", "ds1", ",", "\[Gamma]1", ",", "rR1", ",",
       "rL1", ",", "\[Kappa]g1", ",", "t1", ",", "l1", ",", "vR1", ",", 
      "\[IndentingNewLine]", "f2", ",", "ds2", ",", "\[Gamma]2", ",", "rL2", ",",
       "rR2", ",", "\[Kappa]g2", ",", "t2", ",", "l2", ",", "vR2", ",", 
      "\[IndentingNewLine]", "f3", ",", "\[IndentingNewLine]", "eqn1", ",", 
      "eqn2", ",", "eqn3", ",", "\[IndentingNewLine]", "d3dsys", ",", 
      "\[Kappa]1", ",", "\[Tau]1", ",", "c3dsys", ",", "\[IndentingNewLine]", 
      "ff0", ",", "rrR0", ",", "\[IndentingNewLine]", "ff1", ",", "tt1", ",", 
      "nn1", ",", "bb1", ",", "\[FinalSigma]1", ",", "llL1", ",", "uuL1", ",",
       "llR1", ",", "uuR1", ",", "rrR1", ",", "\[IndentingNewLine]", "ff2", ",",
       "tt2", ",", "rrL2", ",", "uuL2", ",", "llL2", ",", "llR2", ",", "uuR2",
       ",", "rrR2", ",", "\[IndentingNewLine]", "ff3", ",", 
      "\[IndentingNewLine]", "xL", ",", "xR", ",", "yL", ",", "yR", ",", "z", 
      ",", "pv"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"iopts", "=", 
      RowBox[{"Sequence", "[", 
       RowBox[{"InterpolationPoints", "\[Rule]", "128"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti0", ",", "ti3"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Zeroth", " ", "fold"}], ",", " ", 
       RowBox[{"cone", " ", "point"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"f0", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"First", " ", "fold"}], ",", " ", "circle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"f1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "t", "]"}], ",", 
          RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rL1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"-", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], ",", 
           RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "t", "]"}]}], ",", 
          RowBox[{"Cos", "[", "t", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "t", "]"}]}], ",", 
          RowBox[{"-", 
           RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]g1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"From", " ", "here"}], ",", " ", 
       RowBox[{"can", " ", "change", " ", 
        RowBox[{"in", "/", "out"}], " ", "different", " ", "curves"}]}], 
      "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Second", " ", "fold"}], ",", " ", "parabola"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"q", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "+", 
           RowBox[{"4", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{"Cos", "[", "q", "]"}]}], ")"}]}]}], ",", 
          RowBox[{"4", " ", 
           RowBox[{"Sin", "[", "q", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rR2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"q", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"q", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"q", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "q", "]"}]}], ",", 
          RowBox[{"Cos", "[", "q", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"q", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "q", "]"}]}], ",", 
          RowBox[{"-", 
           RowBox[{"Sin", "[", "q", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]g2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"q", ",", 
        FractionBox["1", "4"]}], " ", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Third", " ", "fold"}], ",", " ", 
       RowBox[{"right", " ", "edge", " ", "of", " ", "cylinder"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"f3", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"q", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", 
          RowBox[{"4", " ", 
           RowBox[{"Sin", "[", "q", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Connection", " ", "ruling"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", "q"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"-", "2"}], "+", 
            RowBox[{"4", " ", 
             RowBox[{"Cos", "[", "q", "]"}]}], "-", 
            RowBox[{"Cos", "[", "t", "]"}]}], 
           SqrtBox[
            RowBox[{"21", "-", 
             RowBox[{"16", " ", 
              RowBox[{"Cos", "[", "q", "]"}]}], "-", 
             RowBox[{"8", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"q", "-", "t"}], "]"}]}], "+", 
             RowBox[{"4", " ", 
              RowBox[{"Cos", "[", "t", "]"}]}]}]]], ",", 
          FractionBox[
           RowBox[{
            RowBox[{"4", " ", 
             RowBox[{"Sin", "[", "q", "]"}]}], "-", 
            RowBox[{"Sin", "[", "t", "]"}]}], 
           SqrtBox[
            RowBox[{"21", "-", 
             RowBox[{"16", " ", 
              RowBox[{"Cos", "[", "q", "]"}]}], "-", 
             RowBox[{"8", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"q", "-", "t"}], "]"}]}], "+", 
             RowBox[{"4", " ", 
              RowBox[{"Cos", "[", "t", "]"}]}]}]]]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Consistency", " ", "equations"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"eqn1", "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Gamma]1", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sin", "[", "t", "]"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"t", "-", 
              RowBox[{"q", "[", "t", "]"}]}], "]"}]}]}], ")"}], " ", 
         RowBox[{"Tan", "[", 
          FractionBox[
           RowBox[{"\[Gamma]1", "[", "t", "]"}], "2"], "]"}]}], 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          RowBox[{"Cos", "[", "t", "]"}]}], "-", 
         RowBox[{"4", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"t", "-", 
            RowBox[{"q", "[", "t", "]"}]}], "]"}]}]}]]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqn2", "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Gamma]2", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       FractionBox[
        RowBox[{
         RowBox[{"Sec", "[", 
          RowBox[{"q", "[", "t", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", 
             RowBox[{"t", "-", 
              RowBox[{"2", " ", 
               RowBox[{"q", "[", "t", "]"}]}]}], "]"}]}], "-", 
           RowBox[{"4", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"q", "[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"2", " ", 
              RowBox[{"q", "[", "t", "]"}]}], "]"}]}]}], ")"}], " ", 
         RowBox[{"Tan", "[", 
          FractionBox[
           RowBox[{"\[Gamma]1", "[", "t", "]"}], "2"], "]"}]}], 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"Cos", "[", "t", "]"}]}], "+", 
         RowBox[{"4", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"t", "-", 
            RowBox[{"q", "[", "t", "]"}]}], "]"}]}]}]]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqn3", "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox["q", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"t", "<", "ti1"}], ",", "0", ",", 
         RowBox[{"t", ">", "ti2"}], ",", "0", ",", "True", ",", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "4"}], "+", 
             RowBox[{"Cos", "[", 
              RowBox[{"t", "-", 
               RowBox[{"q", "[", "t", "]"}]}], "]"}], "+", 
             RowBox[{"2", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"q", "[", "t", "]"}], "]"}]}]}], ")"}], " ", 
           RowBox[{"Cot", "[", 
            FractionBox[
             RowBox[{"\[Gamma]2", "[", "t", "]"}], "2"], "]"}], " ", 
           RowBox[{"Tan", "[", 
            FractionBox[
             RowBox[{"\[Gamma]1", "[", "t", "]"}], "2"], "]"}]}], 
          RowBox[{
           RowBox[{"-", "1"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"Cos", "[", "t", "]"}]}], "+", 
           RowBox[{"4", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"t", "-", 
