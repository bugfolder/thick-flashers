             RowBox[{"2", " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Gamma]", "[", "#1", "]"}], "]"}]}], "-", 
