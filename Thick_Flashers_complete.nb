Cell[TextData[{
 "LocalFaceOrdering",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked classes) TGraph+TAssigned\n\t(options) FaceupFace"
}], "Subsubsection",
 CellChangeTimes->{{3.48478188541764*^9, 3.484781896343564*^9}, 
   3.484785636603426*^9, {3.484786360561766*^9, 3.484786362609735*^9}, {
   3.484787556395952*^9, 3.48478756853857*^9}, {3.4847875991923537`*^9, 
