Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherTrimTrianglePanels", "[", 
   RowBox[{
   "panels_List", ",", "panelinfo_List", ",", "tobj_TObj", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pmt", ",", "panels1", ",", "panelinfo1", ",", "prt", ",", "gc", ",", 
      "ff", ",", "g1", ",", "g2", ",", "g3", ",", "g4", ",", "g5", ",", "g6", 
      ",", "g7", ",", "g8", ",", "uq", ",", "ut", ",", "x", ",", "y", ",", 
      "dg", ",", "ff1", ",", "gc1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pmt", "=", 
      RowBox[{
       RowBox[{"PanelMinThickness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ThickFlasherTrimTrianglePanels", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"pmt", "==", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"panels", ",", "panelinfo", ",", "tobj"}], "}"}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"panels1", "=", "panels"}], ";", "\[IndentingNewLine]", 
     RowBox[{"panelinfo1", "=", "panelinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "A", " ", "debugging", " ", "function", " ", "to", " ", "display", " ", 
       "information", " ", "about", " ", "a", " ", "single", " ", 
       RowBox[{"panel", ".", " ", "Leaving"}], " ", "it", " ", "here", " ", 
       "in", " ", "case", " ", "we", " ", "need", " ", "it", " ", 
       RowBox[{"later", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"prt", "[", "i_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"gc", ",", "SolidStyle"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Text", "[", 
                  RowBox[{
                   RowBox[{"\"\<g\>\"", "<>", 
                    RowBox[{"ToString", "[", "k", "]"}]}], ",", 
                   RowBox[{"gc", "\[LeftDoubleBracket]", 
                    RowBox[{"1", ",", "k"}], "\[RightDoubleBracket]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", 
                   RowBox[{"Length", "[", 
                    RowBox[{
                    "gc", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], ",", 
               "Black", ",", 
               RowBox[{"FontWeight", "->", "Bold"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{"Face", " ", "indices"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"FaceLabelsGC", "[", "gc", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<faces = \>\"", ",", 
           RowBox[{"First", "/@", 
            RowBox[{
            "gc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"\"\<panelinfo\[LeftDoubleBracket]\>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}], 
            "<>", "\"\<\[RightDoubleBracket] = \>\""}], ",", 
           RowBox[{
           "panelinfo1", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Trim", " ", "the", " ", "triangle", " ", "panels", " ", "to", " ", 
       "respect", " ", 
       RowBox[{"PanelMinThickness", "."}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"gc", "=", 
         RowBox[{
         "panels1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "The", " ", "triangle", " ", "panels", " ", "have", " ", "six", " ",
            "faces", " ", "and", " ", "six", " ", "vertices"}], ";", " ", 
          RowBox[{
          "all", " ", "other", " ", "panels", " ", "have", " ", "something", " ", 
           RowBox[{"else", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{
             "gc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}], "!=", "6"}], "||", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{
             "gc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}], "!=", "6"}]}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "g1", ",", "g2", ",", "g3", ",", "g4", ",", "g5", ",", "g6"}], 
          "}"}], "=", 
         RowBox[{
         "gc", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
        
        RowBox[{"(*", " ", "vertices", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ff", "=", 
         RowBox[{"First", "/@", 
          RowBox[{
          "gc", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"face", " ", "indices"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "ff", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], "==", "4"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", "Stowed", " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"uq", "=", 
            RowBox[{"NormalizeReal", "[", 
             RowBox[{"g2", "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g1", "+", "g4"}], ")"}], "/", "2"}]}], "]"}]}], ";", 
           
           RowBox[{"(*", " ", 
            RowBox[{"normal", " ", "to", " ", "trim", " ", "plane"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"ut", "=", 
            RowBox[{"TriangleNormal3D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g1", "+", "g4"}], ")"}], "/", "2"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g3", "+", "g5"}], ")"}], "/", "2"}], ",", "g6"}], 
             "]"}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
            "direction", " ", "of", " ", "width", " ", "measurement"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"Clear", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"dg", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"g2", "+", 
               RowBox[{"y", 
                RowBox[{"(", 
                 RowBox[{"g1", "-", "g2"}], ")"}]}]}], ")"}], "-", 
             RowBox[{"(", 
              RowBox[{"g2", "+", 
               RowBox[{"x", 
                RowBox[{"(", 
                 RowBox[{"g4", "-", "g2"}], ")"}]}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"x", "=", 
            RowBox[{"x", "/.", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sign", "[", 
                    RowBox[{"ut", ".", 
                    RowBox[{"(", 
                    RowBox[{"g1", "-", "g4"}], ")"}]}], "]"}], 
                   RowBox[{"ut", ".", "dg"}]}], "==", "pmt"}], "&&", 
                 RowBox[{
                  RowBox[{"uq", ".", "dg"}], "==", "0"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "\[LeftDoubleBracket]",
               "1", "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "<=", "0"}], "||", 
              RowBox[{"x", ">=", "1"}]}], ",", 
             RowBox[{
              RowBox[{"Message", "[", 
               RowBox[{
                RowBox[{"ThickFlasherTrimTrianglePanels", "::", "badtrim"}], ",",
                 "pmt"}], "]"}], ";", 
              RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"g7", "=", 
            RowBox[{"g2", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"g4", "-", "g2"}], ")"}], "x"}]}]}], ";", 
           RowBox[{"(*", " ", 
            RowBox[{
            "point", " ", "in", " ", "desired", " ", "trim", " ", "plane"}], 
            " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"g2", ",", "g6", ",", "g8"}], "}"}], "=", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"LinePlaneInt3D", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"g2", ",", 
                  RowBox[{"g1", "-", "g2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"g7", ",", "uq"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"LinePlaneInt3D", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"g6", ",", 
                  RowBox[{"g3", "-", "g6"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"g7", ",", "uq"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"LinePlaneInt3D", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"g6", ",", 
                  RowBox[{"g5", "-", "g6"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"g7", ",", "uq"}], "}"}]}], "]"}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"ff1", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "2", ",", "6", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "4", ",", "5", ",", "8"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "5", ",", "4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"6", ",", "8", ",", "5", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "4", ",", "7", ",", "2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "7", ",", "8", ",", "6"}], "}"}]}], "}"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ff", "\[LeftDoubleBracket]", 
               RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "==", 
              RowBox[{"{", 
               RowBox[{"2", ",", "4", ",", "1"}], "}"}]}], ",", 
             RowBox[{"ff1", "=", 
              RowBox[{"Reverse", "/@", "ff1"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"For", " ", "stowed", " ", "form"}], ",", " ", 
             RowBox[{"we", " ", "need", " ", "to", " ", "tweak", " ", 
              RowBox[{"panelinfo", "."}]}]}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"panelinfo1", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2", ",", "2", ",", "1"}], 
             "\[RightDoubleBracket]"}], "=", "8"}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", "Deployed", " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"uq", "=", 
            RowBox[{"NormalizeReal", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g2", "+", "g6"}], ")"}], "/", "2"}], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g1", "+", "g4"}], ")"}], "/", "2"}]}], "]"}]}], ";", 
           
           RowBox[{"(*", " ", 
            RowBox[{"normal", " ", "to", " ", "trim", " ", "plane"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"ut", "=", 
            RowBox[{"TriangleNormal3D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g1", "+", "g4"}], ")"}], "/", "2"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g3", "+", "g5"}], ")"}], "/", "2"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"g2", "+", "g6"}], ")"}], "/", "2"}]}], "]"}]}], ";", 
           
           RowBox[{"(*", " ", 
            RowBox[{
            "direction", " ", "of", " ", "width", " ", "measurement"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"Clear", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"dg", "=", 
