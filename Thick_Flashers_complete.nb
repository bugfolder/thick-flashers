  RowBox[{"EdgeLengths3D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts3d", ",", "edges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Mag", "[", 
        RowBox[{"Subtract", "@@", 
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
        "]"}], "&"}], "/@", "edges"}]}]}], "]"}]}]], "Input",
