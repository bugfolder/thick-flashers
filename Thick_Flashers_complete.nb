Cell[CellGroupData[{

Cell["Four orthogonal lines", "Subsubsection",
 CellChangeTimes->{{3.617476739005881*^9, 3.617476743163032*^9}, 
   3.617477524379869*^9, {3.6278254715814466`*^9, 3.627825479499104*^9}, 
   3.62782570545252*^9, {3.701384696449003*^9, 3.701384700984272*^9}, 
   3.7013847911298656`*^9},ExpressionUUID->"3f5d58d1-ba71-4ee2-9412-\
dc400fb58445"],

Cell["\<\
This example shows how to build a woven tessellation from a manually built \
set of intersecting lines and boundary. We build a set of lines, Intersectify \
them, to make the TGraph, then feed it to MakeWovenTessellation. Again, we \
flop the folded form.\
\>", "Text",
 CellChangeTimes->{{3.6174775078537908`*^9, 3.617477517256857*^9}, {
  3.627769982923163*^9, 3.62777002113415*^9}, {3.627819221708824*^9, 
  3.627819288660655*^9}, {3.627825670729173*^9, 
  3.6278257024372597`*^9}},ExpressionUUID->"791c9cfc-8fc2-4403-920b-\
f8a9eaee5704"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sgverts", ",", "sgedges", ",", "tobjcsg", ",", "tobj", ",", "tobjw"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Make", " ", "a", " ", "graph"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sgverts", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0.5"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0.9"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", "1.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1.5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sgedges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "12"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "11"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "12"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjcsg", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"sgverts", ",", "sgedges"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Intersectify", " ", "to", " ", "break", " ", "it", " ", "into", " ", 
       "individual", " ", "line", " ", "segments"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"Intersectify", "[", "tobjcsg", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobjcsg", "]"}], ",", 
         RowBox[{"GraphGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "plot", " ", "the", " ", "inset", " ", "separation", " ", "to", " ", 
       "find", " ", "an", " ", "aesthetically", " ", "pleasing", " ", "strip",
        " ", "width"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"InsetSeparationPlot", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "0.3"}], "}"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "the", " ", "new", " ", "woven", " ", "tessellation"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjw", "=", 
      RowBox[{"MakeSimpleWovenTessellationOld", "[", 
       RowBox[{"tobj", ",", "0.1", ",", 
        RowBox[{"WovenParity", "\[Rule]", 
         RowBox[{"-", "1"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Turn", " ", "over", " ", "the", " ", "folded", " ", "form"}], 
       ",", " ", 
       RowBox[{"i", ".", "e", "."}], ",", " ", 
       RowBox[{
       "invert", " ", "the", " ", "crease", " ", "assignment", " ", "and", " ",
         "flop", " ", "the", " ", 
        RowBox[{"image", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobjw", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", 
          RowBox[{
           RowBox[{"FlopGraph2D", "[", "tobjw", "]"}], ",", 
           RowBox[{"FaceupFace", "\[Rule]", 
            RowBox[{"Length", "[", 
             RowBox[{"GetValue", "[", 
              RowBox[{"tobjw", ",", "Faces"}], "]"}], "]"}]}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462926963598337*^9, 3.4629270068181953`*^9}, {
