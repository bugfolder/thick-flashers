Cell["\<\
Example. A 2x2 array of squares that is split along one of the interior \
edges. FaceShrink spreads the vertices so that the doubled edge becomes \
visible.\
\>", "Text",
 CellChangeTimes->{{3.825866701722197*^9, 3.825866708306368*^9}, {
  3.825866769195073*^9, 3.82586681112306*^9}, {3.825867083828685*^9, 
  3.825867098541251*^9}},ExpressionUUID->"e38ecf94-8c95-4e11-ab6c-\
9b1005dd0604"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "faces", ",", "cverts"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "10"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "5", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "6", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5", ",", "8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6", ",", "10", ",", "9"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cverts", "=", 
      RowBox[{"FaceShrink", "[", 
       RowBox[{"verts", ",", "faces", ",", 
        RowBox[{"FaceShrinkage", "\[Rule]", "0.2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GenericGraphGraphics", "[", 
         RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GenericGraphGraphics", "[", 
         RowBox[{"cverts", ",", "edges", ",", "faces"}], "]"}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.825866813065223*^9, 3.8258670770292063`*^9}, {
  3.82586713088155*^9, 3.825867152173868*^9}},
