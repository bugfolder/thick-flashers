Cell[BoxData[
 RowBox[{
  RowBox[{"StyledCurve", "[", 
   RowBox[{
    RowBox[{"c_Function", "|", "c_InterpolatingFunction"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t0_", ",", "t1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nt", ",", "cd", ",", "ct", ",", "ctt", ",", "ls", ",", "dim", ",", 
      "pts", ",", "tt", ",", "g", ",", "apts", ",", "ga"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nt", "=", 
      RowBox[{
       RowBox[{"CurveDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurve", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cd", "=", 
      RowBox[{
       RowBox[{"CurveDirected", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurve", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ls", "=", 
      RowBox[{
       RowBox[{"LineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurve", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ct", "=", 
      RowBox[{
       RowBox[{"CurveTube", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurve", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ctt", "=", 
      RowBox[{
       RowBox[{"CurveTubeThickness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurve", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dim", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"c", "[", "t0", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ls", "===", "None"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"c", "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "t0", ",", "t1", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t1", "-", "t0"}], ")"}], "/", "nt"}]}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"StyledLine", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"LineDirected", "\[Rule]", "cd"}], ",", 
       RowBox[{"LineStyle", "\[Rule]", "ls"}], ",", 
       RowBox[{"LineTube", "\[Rule]", "ct"}], ",", 
       RowBox[{"LineTubeThickness", "\[Rule]", "ctt"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
