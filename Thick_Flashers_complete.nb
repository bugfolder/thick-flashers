Cell[CellGroupData[{

Cell["Unit triangle centered twist tiles", "Subsection",
 CellChangeTimes->{{3.629850066402248*^9, 
  3.629850072585106*^9}},ExpressionUUID->"ae06267d-c0f9-4260-9d99-\
e15c131ecb43"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.457721595250703*^9, 3.457721598296111*^9}, 
   3.627385976175665*^9},ExpressionUUID->"460fc1c2-5070-4ad1-8a10-\
2e0b0c62297b"],

Cell[TextData[{
 "Unit triangle tiles can be specified by a list of their three angles. For \
non-equilateral triangles, the side lengths are, of course, not all equal, \
and when you start putting them together, you may well wish to scale them. \
For that, you can use the ",
 StyleBox["scale",
  FontSlant->"Italic"],
 " argument in the tilespec."
}], "Text",
 CellChangeTimes->{{3.457722143566229*^9, 3.457722149825455*^9}, {
   3.592170756259306*^9, 3.592170780589327*^9}, {3.627333375519019*^9, 
   3.627333387581321*^9}, 3.627385873833942*^9, 3.6273859761762*^9, {
   3.627401463773492*^9, 3.627401554636607*^9}, {3.627401877928489*^9, 
   3.627401878831832*^9}},ExpressionUUID->"10902ca4-7f2d-49c2-abd9-\
a454d9b1dd77"]
}, Closed]],

