Cell[TextData[{
 "SplitGraphGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pfinfo, opts",
  FontSlant->"Italic"],
 "] produces a Graphics object that gives a visualization of the \
splitting-by-fold in the crease pattern by drawing all of the folded edges \
and face splitting lines on top of the GraphGraphics representation, that \
latter with their corresponding indices."
}], "Text",
 CellChangeTimes->{{3.7067277526407547`*^9, 3.706727835881607*^9}, {
