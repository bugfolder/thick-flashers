  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.555770143718812*^9, 3.555770150569172*^9}, 
   3.5558543181687107`*^9, 3.555854354889843*^9, {3.719869577319119*^9, 
   3.719869585221236*^9}, 3.719925980202486*^9, {3.719934013980151*^9, 
   3.719934014132218*^9}},ExpressionUUID->"1581c35a-5f8d-4c25-b2ce-\
5c471073046b"],

Cell[TextData[{
 "FlasherXYFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dr",
  FontSlant->"Italic"],
 "] returns a list of functions that return zero when the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and ",
 StyleBox["y",
  FontSlant->"Italic"],
 " coordinates of the folded form points of the specified flasher are equal \
to their default values for radial spacing ",
 StyleBox["dr",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.555770103802979*^9, 3.555770107960988*^9}, {
   3.5557701658540297`*^9, 3.555770286221524*^9}, {3.555776958114599*^9, 
   3.555776962241098*^9}, {3.5558543182796383`*^9, 3.555854318370816*^9}, 
   3.55585435499504*^9, 3.719856897022521*^9, 3.719869501687148*^9, {
