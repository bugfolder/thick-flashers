184f97401fbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tilespecs", ",", "tilespecs1", ",", "t1", ",", "t2"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tilespecs", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"TestTile", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"TestTile", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "1", ",", 
            RowBox[{"{", 
             RowBox[{"0.1", ",", "0"}], "}"}]}], "}"}]}], "}"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"t1", "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"tilespecs1", "=", 
        RowBox[{"JoinTiling", "[", 
         RowBox[{"tilespecs", ",", 
          RowBox[{"Numeric", "\[Rule]", "False"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t2", "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"tilespecs1", "=", 
        RowBox[{"JoinTiling", "[", 
         RowBox[{"tilespecs", ",", 
          RowBox[{"Numeric", "\[Rule]", "True"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Timing (Numeric\[Rule]False) = \>\"", ",", 
       RowBox[{"t1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Timing (Numeric\[Rule]True) = \>\"", ",", 
       RowBox[{"t2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"EmbedTiling", "[", 
        RowBox[{"tilespecs1", ",", "Tiling", ",", 
         RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
      RowBox[{"TilingStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
