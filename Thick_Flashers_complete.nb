Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ds", ",", "\[Kappa]", ",", "\[Tau]", ",", "ui", ",", "ci", ",", "ti", ",",
       "bi", ",", "csys"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ds", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "ci", ",", "ti", ",", "bi"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
