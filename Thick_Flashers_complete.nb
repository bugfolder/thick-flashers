Cell["Example: a 3x3 square grid, cut along four edges.", "Text",
 CellChangeTimes->{{3.643719417388682*^9, 3.643719418133285*^9}, {
  3.643719485322005*^9, 3.643719488832284*^9}, {3.825687628225894*^9, 
  3.82568763152195*^9}, {3.825768051776816*^9, 
  3.825768052065399*^9}},ExpressionUUID->"04d7fd9c-6256-409f-af5c-\
763c03ce1fa4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "n", ",", "verts", ",", "edges", ",", "tobj", ",", "nverts", ",", 
      "nedges", ",", "nfaces"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "-", "1"}], ",", 
             RowBox[{"j", "-", "1"}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", "1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"n", "+", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
              RowBox[{"i", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"n", "+", "1"}], ")"}], 
                RowBox[{"(", "j", ")"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"(", 
               RowBox[{"n", "+", "1"}], ")"}]}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTPlaneGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphGraphics", "[", "tobj", "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nverts", ",", "nedges", ",", "nfaces"}], "}"}], "=", 
      RowBox[{"SplitEdges", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5", ",", "18", ",", "19"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", "nverts", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", "nedges", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", "nfaces", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
