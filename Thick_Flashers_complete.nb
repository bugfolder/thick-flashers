            RowBox[{"13", ",", "14"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"14", ",", "15"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"15", ",", "16"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"16", ",", "17"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"17", ",", "18"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"18", ",", "7"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tobjpd", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"MakeTGraph", "[", 
             RowBox[{"verts", ",", "edges"}], "]"}], "//", 
            "AddTPlaneGraphTo"}], "//", "AddTPrimalDualGraphTo"}], "//", 
          "MakeReciprocalDiagram"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tobj", "=", 
         RowBox[{"MakePrimalDualFlagstoneTessellation", "[", 
          RowBox[{"tobjpd", ",", "0.6"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"PrimalDualGraphics", "[", "tobjpd", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"GenericFoldedFormGraphics", "[", "tobj", "]"}]}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"VisibleFoldedFormGraphics", "[", "tobj", "]"}], "*)"}], 
           "\[IndentingNewLine]", "}"}], "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", 
      "]"}], "//", "ShowExample"}], "//", "Hold"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"As", " ", "of", " ", "Ma12"}], ",", " ", 
