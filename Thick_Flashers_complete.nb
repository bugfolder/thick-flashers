Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.643287098727108*^9, 
  3.643287099166832*^9}},ExpressionUUID->"36894bcb-3231-4141-9d37-\
b035a2dbb716"],

Cell["\<\
Tomohiro Tachi and Koryo Miura developed several flexible mechanisms that can \
be created by stacking multiple layers of semi-generalized Miura-oris, \
including the Tachi-Miura polyhedron.\
\>", "Text",
 CellChangeTimes->{{3.643287101614518*^9, 3.643287151323828*^9}, {
  3.643287211344421*^9, 
  3.643287214927849*^9}},ExpressionUUID->"6a2ccda0-f4b6-4d78-ad24-\
a4aa959eb7c5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeTachiMiuraPolyhedronGraphics3D[\[Beta]0, {\[Gamma]0, \[Gamma]}, {",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d3",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.643293261348247*^9, 3.64329330515947*^9}, {
   3.643293337862254*^9, 3.643293339397959*^9}, 3.6432936044960814`*^9, {
   3.6432942987371607`*^9, 3.643294299456237*^9}, {3.643294374195144*^9, 
   3.6432943747232857`*^9}},ExpressionUUID->"8af2b9ee-ca2a-45f7-8a95-\
f0815497d82f"],

Cell[TextData[{
 "MakeTachiMiuraPolyhedraGraphics3D[\[Beta]0, {\[Gamma]0, \[Gamma]}, {",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d3",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a Graphics3D representation of a Tachi-Miura polyhedron where\n\t\
\[Beta]0 is the first and second bend angles (should be positive),\n\t\
\[Gamma]0 is the design minor fold angle\n\t\[Gamma] is the minor fold angle \
for this rendering\n\t{",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d3",
  FontSlant->"Italic"],
 "} are the first three segment lengths in the generating path\n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the panel width\n\t",
 StyleBox["nw",
  FontSlant->"Italic"],
 " is the number of repetitions in the width direction\nOptions are:\n\t\
StackGap \[Rule] \[Epsilon], specifies the vertical spacing between layers as \
a fraction of ",
 StyleBox["d1",
  FontSlant->"Italic"],
 ". This improves rendering.\n\tOptions[MakeSemigeneralizedMiuraOriP] are \
passed through."
}], "Text",
 CellChangeTimes->{{3.643293307839457*^9, 3.643293536449669*^9}, {
  3.643293596223385*^9, 3.643293597741588*^9}, {3.643293983057139*^9, 
  3.6432939991882668`*^9}, {3.643294208680125*^9, 3.643294208782356*^9}, {
  3.6432943805869436`*^9, 
  3.643294389162112*^9}},ExpressionUUID->"5a6eb8e1-c875-4cb0-857d-\
3bbd1458956e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StackGap", "::", "usage"}], 
   "=", "\"\<StackGap is an option to MakeTachiMiuraPolyhedraGraphics3D and \
MakeTachiMiuraStackGraphics3D that specifies the vertical gap between \
successive layers.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.643288953778984*^9, 3.64328897980236*^9}, {
  3.643293561219345*^9, 3.643293562241503*^9}},
 CellLabel->
  "In[2557]:=",ExpressionUUID->"2a30a1dc-7239-4d79-a7eb-54b2d784ffd2"],

