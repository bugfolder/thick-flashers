Cell[CellGroupData[{

Cell["Multiple linked folds", "Subsection",
 CellChangeTimes->{{3.804518884572214*^9, 
  3.804518888915987*^9}},ExpressionUUID->"752947a4-4b12-42f6-93f4-\
68c3104b7e72"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.80452135234925*^9, 
  3.804521352797345*^9}},ExpressionUUID->"bc2db3ce-2c5d-4f6c-9f3d-\
a07ccb0f07ba"],

Cell["\<\
For this analysis, we go straight to numerical functions, because there are \
so few non-trivial configurations that have analytic solutions that it\
\[CloseCurlyQuote]s not worth putting together the analytic functions.\
\>", "Text",
 CellChangeTimes->{{3.804521357741448*^9, 3.804521382917012*^9}, 
   3.804521418670084*^9, {3.804528926444571*^9, 
   3.80452893950929*^9}},ExpressionUUID->"ef1fc99f-7f21-4c35-b8a9-\
a5417acb3f7a"],

Cell["\<\
In addition, we use ListInterpolation with evenly spaced points, rather than \
FunctionInterpolation (which uses adaptive spacing), to keep control over the \
cascade of higher-order derivatives when we have a long series of folds.\
\>", "Text",
 CellChangeTimes->{{3.804521427352572*^9, 3.804521442694695*^9}, {
  3.804521576190995*^9, 3.8045216062071548`*^9}, {3.8045289437012253`*^9, 
  3.804528965325101*^9}},ExpressionUUID->"436bc2b2-2028-46ea-b32e-\
e0fa31a2ae7f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "NLinkedFoldsNext2D[",
 StyleBox["f0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f2",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) InterpolationOrder, InterpolationPoints, \
Options[FunctionInterpolation], Curve2DSystems"
}], "Subsubsection",
 CellChangeTimes->{{3.804520253406785*^9, 3.804520337143137*^9}, 
   3.804520425112533*^9, 3.8045213461652822`*^9, {3.804521452917652*^9, 
   3.804521469093609*^9}, {3.804524826728669*^9, 3.804524837198626*^9}, {
   3.804528524314665*^9, 3.8045285296905107`*^9}, {3.80453151915239*^9, 
   3.804531524920209*^9}},ExpressionUUID->"26ab9470-46e6-4365-9723-\
f9a0c3b15e61"],

Cell[TextData[{
 "NLinkedFoldsNext2D[",
 StyleBox["f0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f2",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a set of three 2D folds, parameterizations, and fold angle, and \
returns the next fold angle and parameterization in the triple."
}], "Text",
 CellChangeTimes->{{3.804520344065229*^9, 3.804520407646842*^9}, 
   3.804521478960495*^9, {3.804524856762217*^9, 
   3.804524888632165*^9}},ExpressionUUID->"36f895e5-d4c6-431a-9834-\
325bd1b067c2"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f0",
  FontSlant->"Italic"],
 " \[LongDash] first 2D fold as a pure function.\n\t",
 StyleBox["q0",
  FontSlant->"Italic"],
 " \[LongDash] parameterization variable of the first fold, parameterized on \
the parameter common to all folds.\n\t\[Gamma]0 \[LongDash] first fold angle, \
parameterized on the common parameter.\n\t",
 StyleBox["f1",
  FontSlant->"Italic"],
 " \[LongDash] second 2D fold, parameterized on its own parameter.\n\t",
 StyleBox["q1",
  FontSlant->"Italic"],
 " \[LongDash] parameterization variable of the second fold, parameterized on \
the common parameter.\n\t",
 StyleBox["f2",
  FontSlant->"Italic"],
 " \[LongDash] geodesic curvature of the second fold.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interest."
}], "Text",
 CellChangeTimes->{{3.6941075557750607`*^9, 3.6941076220877542`*^9}, {
  3.804520437112335*^9, 3.804520560967535*^9}, {3.804530942138601*^9, 
  3.804531019939612*^9}, {3.804531316582*^9, 
  3.804531327877776*^9}},ExpressionUUID->"34e6b69b-db6f-47e6-a8a3-\
5488b7fac09b"],

Cell[TextData[{
 "Options:\n\tInterpolationOrder \[Rule] ",
 StyleBox["io",
  FontSlant->"Italic"],
 ", specifies the interpolation order to use for the ListInterpolation.\n\t\
InterpolationPoints \[Rule] ",
 StyleBox["ip",
  FontSlant->"Italic"],
 ", specifies the number of points to use in the ListInterpolation.\n\t\
Options[FunctionInterpolation] are passed through to NCurve2DSystem (if \
needed).\n\tCurve2DSystems \[Rule] Automatic | ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", lets you provide precomputed Curve2DSystems for the fold lines."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691935258654289*^9, 
   3.691935301197094*^9}, 3.694107675753793*^9, {3.80452826964774*^9, 
   3.804528357632792*^9}, {3.804531538590748*^9, 
   3.80453155804784*^9}},ExpressionUUID->"d1f4bfa2-180f-4633-a8f9-\
e03bed0281dc"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["\[Gamma]1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} of the parameterization of the second fold angle and third fold \
parameter, all expressed in terms of the common parameterization."
}], "Text",
 CellChangeTimes->{{3.69410782343384*^9, 3.694107846737583*^9}, {
  3.804520569784155*^9, 3.804520595488785*^9}, {3.804522537342538*^9, 
  3.804522570693509*^9}},ExpressionUUID->"99c5e7f9-a359-47f3-a66b-\
a9e58e17be71"],

Cell["\<\
Note that you can pass the Curve2DSystems for the fold lines as options if \
you want to precompute them for efficiency.\
\>", "Text",
 CellChangeTimes->{{3.804523818247511*^9, 3.804523884944573*^9}, {
   3.804525704301692*^9, 3.8045257063008957`*^9}, 3.80452825991244*^9, 
   3.804531343246019*^9},ExpressionUUID->"e881153f-e2a8-4666-ae4c-\
10a689b7fc7d"],

Cell["\<\
Note, too, that the process of project ruling lines from one parameter value \
to the next may well project to a parameter value that lies outside of the \
domain {u0, u1}, in which case subsequent evaluations could require function \
extrapolations.\
\>", "Text",
 CellChangeTimes->{{3.80453134781417*^9, 3.804531390814129*^9}, {
  3.804531422694482*^9, 
  3.804531447158871*^9}},ExpressionUUID->"bb9d50cb-9057-4561-9bb7-\
b838ae8813c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Curve2DSystems", "::", "usage"}], 
   "=", "\"\<Curve2DSystems is an option to NLinkedFoldsNext2D that specifies \
the Curve2DSystem for one, two, or all three of the fold lines.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.804528375073298*^9, 3.804528414209819*^9}},
 CellLabel->
  "In[4070]:=",ExpressionUUID->"ac64db0c-7a4d-4b3f-98b5-79f980f8727f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "NLinkedFoldsNext2D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"InterpolationOrder", "\[Rule]", "4"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"InterpolationPoints", "\[Rule]", "32"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Curve2DSystems", "\[Rule]", "Automatic"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.68980816965057*^9, 3.689808183674678*^9}, 
   3.689848577039259*^9, 3.690988493972368*^9, 3.691179503122077*^9, 
   3.691183960021525*^9, 3.691254300095761*^9, 3.6914944115328407`*^9, 
   3.691496079721467*^9, 3.691504591861905*^9, 3.692200301691255*^9, 
   3.694107806867712*^9, 3.694107857093521*^9, 3.8045209030293007`*^9, {
   3.80452148563058*^9, 3.804521526042608*^9}, {3.804521565007778*^9, 
   3.804521566198358*^9}, 3.8045256866199617`*^9, {3.804528238801715*^9, 
   3.804528248695685*^9}, {3.8046949332234163`*^9, 3.804694961902122*^9}, {
   3.804695000769129*^9, 3.804695035758275*^9}},
 CellLabel->
  "In[4071]:=",ExpressionUUID->"36783e07-9d54-4a7e-bfab-49dd8db5925e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NLinkedFoldsNext2D", "]"}], ";"}]], "Input",\

 CellChangeTimes->{{3.804523718850156*^9, 3.804523729124289*^9}, 
   3.8045256903107347`*^9},
 CellLabel->
  "In[4072]:=",ExpressionUUID->"bd229e59-9c3a-4e8c-a937-290ca867383f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NLinkedFoldsNext2D", "[", 
   RowBox[{
    RowBox[{"f0_Function", "|", "f0_InterpolatingFunction"}], ",", 
    RowBox[{"q0_Function", "|", "q0_InterpolatingFunction"}], ",", 
    RowBox[{"\[Gamma]0_Function", "|", "\[Gamma]0_InterpolatingFunction"}], ",", 
    RowBox[{"f1_Function", "|", "f1_InterpolatingFunction"}], ",", 
    RowBox[{"q1_Function", "|", "q1_InterpolatingFunction"}], ",", 
    RowBox[{"f2_Function", "|", "f2_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "io", ",", "ip", ",", "cs", ",", "s", ",", "c2dsys0", ",", "c2dsys1", ",",
       "c2dsys2", ",", "l0", ",", "ds0", ",", "\[Kappa]g0", ",", "t1", ",", 
      "l1", ",", "ds1", ",", "\[Kappa]g1", ",", "\[Gamma]1", ",", 
      "\[Gamma]1vals", ",", "rfn", ",", "q2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"io", "=", 
      RowBox[{
       RowBox[{"InterpolationOrder", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NLinkedFoldsNext2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ip", "=", 
      RowBox[{
       RowBox[{"InterpolationPoints", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NLinkedFoldsNext2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cs", "=", 
      RowBox[{
       RowBox[{"Curve2DSystems", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NLinkedFoldsNext2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"cs", "===", "Automatic"}], ",", 
       RowBox[{"cs", "=", 
        RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c2dsys0", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "cs", "]"}], "\[GreaterEqual]", "1"}], ",", 
        RowBox[{"cs", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"NCurve2DSystem", "[", 
         RowBox[{"f0", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"c2dsys1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "cs", "]"}], "\[GreaterEqual]", "2"}], ",", 
        RowBox[{"cs", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"NCurve2DSystem", "[", 
         RowBox[{"f1", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"c2dsys2", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "cs", "]"}], "\[GreaterEqual]", "3"}], ",", 
        RowBox[{"cs", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"NCurve2DSystem", "[", 
         RowBox[{"f2", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"l0", ",", "ds0", ",", "\[Kappa]g0"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "LeftNormalVector2D", ",", "Speed2D", ",", "LeftCurvature2D"}], "}"}],
        "/.", "c2dsys0"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t1", ",", "l1", ",", "ds1", ",", "\[Kappa]g1"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector2D", ",", "LeftNormalVector2D", ",", "Speed2D", ",", 
         "LeftCurvature2D"}], "}"}], "/.", "c2dsys1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]1", "=", 
      RowBox[{"ListInterpolation", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], 
           RowBox[{"ArcTan", "[", 
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{
                RowBox[{"q0", "'"}], "[", "s", "]"}], 
               RowBox[{"ds0", "[", 
                RowBox[{"q0", "[", "s", "]"}], "]"}], 
               RowBox[{"\[Kappa]g0", "[", 
                RowBox[{"q0", "[", "s", "]"}], "]"}]}], 
              RowBox[{
               RowBox[{
                RowBox[{"q1", "'"}], "[", "s", "]"}], 
               RowBox[{"ds1", "[", 
                RowBox[{"q1", "[", "s", "]"}], "]"}], 
               RowBox[{"\[Kappa]g1", "[", 
                RowBox[{"q1", "[", "s", "]"}], "]"}]}]], 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"f1", "[", 
                  RowBox[{"q1", "[", "s", "]"}], "]"}], "-", 
                 RowBox[{"f0", "[", 
                  RowBox[{"q0", "[", "s", "]"}], "]"}]}], ")"}], ".", 
               RowBox[{"l1", "[", 
                RowBox[{"q1", "[", "s", "]"}], "]"}]}], 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"f1", "[", 
                  RowBox[{"q1", "[", "s", "]"}], "]"}], "-", 
                 RowBox[{"f0", "[", 
                  RowBox[{"q0", "[", "s", "]"}], "]"}]}], ")"}], ".", 
               RowBox[{"l0", "[", 
                RowBox[{"q0", "[", "s", "]"}], "]"}]}]], 
             RowBox[{"Tan", "[", 
              FractionBox[
               RowBox[{"\[Gamma]0", "[", "s", "]"}], "2"], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1", ",", 
            FractionBox[
             RowBox[{"u1", "-", "u0"}], "ip"]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationOrder", "\[Rule]", "io"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rfn", "[", 
       RowBox[{"s_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Gamma]1", "'"}], "[", 
        RowBox[{"q1", "[", "s", "]"}], "]"}], "-", 
       RowBox[{
        RowBox[{
         RowBox[{"q1", "'"}], "[", "s", "]"}], 
        RowBox[{"ds1", "[", "s", "]"}], 
        RowBox[{"\[Kappa]g1", "[", "s", "]"}], 
        RowBox[{"Tan", "[", 
         FractionBox[
          RowBox[{"\[Gamma]1", "[", "s", "]"}], "2"], "]"}], 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f0", "[", 
               RowBox[{"q0", "[", "s", "]"}], "]"}], "-", 
              RowBox[{"f1", "[", 
               RowBox[{"q1", "[", "s", "]"}], "]"}]}], ")"}], ".", 
            RowBox[{"t1", "[", 
             RowBox[{"q1", "[", "s", "]"}], "]"}]}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f0", "[", 
               RowBox[{"q0", "[", "s", "]"}], "]"}], "-", 
              RowBox[{"f1", "[", 
               RowBox[{"q1", "[", "s", "]"}], "]"}]}], ")"}], ".", 
            RowBox[{"l1", "[", 
             RowBox[{"q1", "[", "s", "]"}], "]"}]}]], "+", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f2", "[", "q2", "]"}], "-", 
              RowBox[{"f1", "[", 
               RowBox[{"q1", "[", "s", "]"}], "]"}]}], ")"}], ".", 
            RowBox[{"t1", "[", 
             RowBox[{"q1", "[", "s", "]"}], "]"}]}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"f2", "[", "q2", "]"}], "-", 
              RowBox[{"f1", "[", 
               RowBox[{"q1", "[", "s", "]"}], "]"}]}], ")"}], ".", 
            RowBox[{"l1", "[", 
             RowBox[{"q1", "[", "s", "]"}], "]"}]}]]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q2", "=", 
      RowBox[{"ListInterpolation", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"q2", "/.", 
           RowBox[{"FindRoot", "[", 
            RowBox[{
             RowBox[{"rfn", "[", "s", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"q2", ",", 
               RowBox[{"q1", "[", "s", "]"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1", ",", 
            FractionBox[
             RowBox[{"u1", "-", "u0"}], "ip"]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationOrder", "\[Rule]", "io"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]1", ",", "q2"}], "}"}]}]}], "]"}]}]], "Input",
