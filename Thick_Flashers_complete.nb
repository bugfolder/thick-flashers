Cell["Example.", "Text",
 CellChangeTimes->{{3.5940725520097938`*^9, 3.594072552711787*^9}, 
   3.594074528605997*^9},ExpressionUUID->"ff07dea0-c6e1-490d-86ee-\
1a6dd0a5c351"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "rvals", ",", "tobjpd", ",", "fn", ",", "\[Gamma]", ",", 
      "\[Alpha]", ",", "dir", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "11"}], ";", "\[IndentingNewLine]", 
     RowBox[{"rvals", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"MakeRotationalTrapezoidPrimalDualGraph", "[", 
       RowBox[{"m", ",", "rvals", ",", 
        RowBox[{"IncludeCenter", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fn", "=", 
      RowBox[{"RadialAxialOrderingFn", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"RadialMajor", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"OrientEdgePairs", "[", 
       RowBox[{"tobjpd", ",", "fn"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"20.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CW"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"Direction", "\[Rule]", "dir"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PrimalDualGraphics", "[", 
          RowBox[{"tobjpd", ",", 
           RowBox[{"DualDirectedEdges", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"FaceupFace", "\[Rule]", "1"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594072554327301*^9, 3.594072605331151*^9}, {
   3.594072696458988*^9, 3.594072726527075*^9}, {3.594072771796604*^9, 
   3.594072828959951*^9}, {3.594072971272368*^9, 3.594072971421361*^9}, {
   3.594073086740569*^9, 3.594073094990727*^9}, {3.59407352904606*^9, 
   3.5940735295292263`*^9}, {3.5940736819941473`*^9, 3.594073682401766*^9}, {
   3.594073780446868*^9, 3.594073873551572*^9}, {3.59407391858151*^9, 
   3.594073951172944*^9}, {3.59407414065753*^9, 3.594074152151223*^9}, {
   3.594074193713086*^9, 3.5940742120065002`*^9}, {3.594074251661274*^9, 
   3.59407431874304*^9}, {3.594074371093151*^9, 3.594074373388523*^9}, {
   3.5940744405747423`*^9, 3.594074459751169*^9}, {3.594074512035027*^9, 
   3.594074512178383*^9}, 3.5942076013862867`*^9, 3.594734830144953*^9, 
   3.594735274084042*^9, 3.595200379018712*^9, 3.595200529762198*^9, 
   3.595200712594571*^9, 3.615288952030211*^9, {3.615289426454179*^9, 
   3.6152894515814857`*^9}, {3.628891978886888*^9, 3.6288919790425262`*^9}, {
   3.8330255581440353`*^9, 3.83302556101759*^9}},
 CellLabel->
  "In[3384]:=",ExpressionUUID->"4a057482-649d-454c-861a-a92d77ede809"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Primal-dual flagstone tessellations", "Section",
 CellChangeTimes->{{3.551745703807547*^9, 3.5517457358904037`*^9}, {
   3.551746694259274*^9, 3.551746695978652*^9}, 3.551828819218048*^9, {
   3.551832302875041*^9, 3.551832309378605*^9}, 
   3.592523585862958*^9},ExpressionUUID->"462f661d-f567-4dba-b8dc-\
5f56cae4e532"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.551745710748562*^9, 
  3.551745711196316*^9}},ExpressionUUID->"ead75a66-7933-42c8-b1b8-\
7f9f0859eefd"],

Cell["\<\
Flagstone tessellations take a primal-dual graph pair and construct a crease \
pattern by shrinking the primal polygons and adding double pleats in the \
\[OpenCurlyDoubleQuote]grout\[CloseCurlyDoubleQuote] regions between the \
shrunken polygons, and then tries make all the pleats play nicely where they \
come together at the vertices.\
\>", "Text",
 CellChangeTimes->{{3.551746636632534*^9, 3.551746682227713*^9}, {
   3.551836476830751*^9, 3.5518365265202413`*^9}, {3.592523511693952*^9, 
   3.592523553634591*^9}, 
   3.795114016288205*^9},ExpressionUUID->"d24dd86c-207a-4d34-bc58-\
40b921b0b643"],

Cell["\<\
There are two ways of doing this: parallel-pleat and tilted-pleat versions.\
\>", "Text",
 CellChangeTimes->{{3.79511402445604*^9, 
  3.795114046520772*^9}},ExpressionUUID->"5531df16-c1c8-413d-8e58-\
2fafe090a376"]
}, Closed]],

Cell[CellGroupData[{

Cell["Parallel-pleat flagstone tessellations", "Subsection",
 CellChangeTimes->{{3.616244366457225*^9, 3.616244374000899*^9}, {
  3.795114051280394*^9, 
  3.795114053280549*^9}},ExpressionUUID->"199e29a1-e9c8-4904-8ecc-\
d206eceebcbf"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.551745710748562*^9, 
  3.551745711196316*^9}},ExpressionUUID->"595cec51-7357-4627-8f19-\
f6dcbe04912d"],

Cell["\<\
This algorithm, which makes the pleats parallel to the flagstone edges, \
strives for maximally balanced pleats and chooses the centroid of the grout \
polygon as the alignment point for each central polygon.\
\>", "Text",
 CellChangeTimes->{{3.551746636632534*^9, 3.551746682227713*^9}, {
  3.551836476830751*^9, 3.5518365265202413`*^9}, {3.592523511693952*^9, 
  3.592523553634591*^9}, {3.795113992688551*^9, 
  3.795114010528496*^9}},ExpressionUUID->"c2a56c1b-9e0b-4274-a227-\
0f4c97b31485"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakePrimalDualFlagstoneTessellation",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Rho], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TPrimalDualGraph\n\t(options) GroupFaces"
}], "Subsubsection",
 CellChangeTimes->{{3.551746734956232*^9, 3.551746755286964*^9}, {
   3.551746793950767*^9, 3.551746794708689*^9}, 3.5517548916600113`*^9, {
   3.551828320605745*^9, 3.551828343905328*^9}, {3.551836077422262*^9, 
   3.551836083603747*^9}, {3.551958210752139*^9, 3.551958212110574*^9}, {
   3.592523567272922*^9, 3.592523578167922*^9}, 3.592828742964588*^9, 
   3.592828812156989*^9, 
   3.615293795386698*^9},ExpressionUUID->"c82e1889-6faf-4ad7-8d70-\
25ede4f5aaab"],

Cell[TextData[{
 "MakePrimalDualFlagstoneTessellation",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Rho]] take a TPrimalDualGraph and constructs the crease pattern and \
folded form of a primal-dual flagstone tessellation using a shrinkage factor \
\[Rho]<1, returning a TGraph2D+TAssigned. Options are:\n\t\
GroupFaces\[Rule]True | False; if True, ",
 StyleBox["faces",
  FontSlant->"Italic"],
 " will have an extra level of depth with faces that show up on the same \
layer ordering level grouped together. Can be used to compute the visible \
folded form with more fidelity than VisibleFoldedFormGraphics provides."
}], "Text",
 CellChangeTimes->{{3.5517468025395193`*^9, 3.5517468078672657`*^9}, {
   3.551746840205658*^9, 3.551746891278955*^9}, 3.55175490419655*^9, {
   3.551874423193776*^9, 3.5518744900343723`*^9}, {3.5519189778000603`*^9, 
   3.5519190207063107`*^9}, {3.551919799711117*^9, 3.551919831065756*^9}, {
   3.551958221107699*^9, 3.5519582916735*^9}, {3.551958843637601*^9, 
   3.551958844132441*^9}, 3.592208110036187*^9, 3.592433371431275*^9, {
   3.592523593640004*^9, 3.5925236451001*^9}, {3.592828743125859*^9, 
   3.592828743405101*^9}, 3.5928289099227123`*^9, {3.592828961435508*^9, 
   3.5928289615723*^9}, 3.592871160174193*^9, 3.5947352742456617`*^9, {
   3.594739041062924*^9, 3.5947390412236156`*^9}, 3.595200712757902*^9, {
   3.615288320561325*^9, 3.615288377169033*^9}, 
   3.615293795456232*^9},ExpressionUUID->"5ed7b227-84d9-49e1-ae59-\
f0720c86f465"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GroupFaces", "::", "usage"}], 
   "=", "\"\<GroupFaces is an option to MakePrimalDualFlagstoneTessellation \
that specifies whether to group faces on the same level of folding.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.592523781327182*^9, 3.5925238034447327`*^9}, 
   3.5928287435049257`*^9, 3.615293795484706*^9},
 CellLabel->
  "In[3385]:=",ExpressionUUID->"a612515c-2b4f-4a38-875a-631594a13b7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakePrimalDualFlagstoneTessellation", "]"}], "=", 
   
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"GroupFaces", "\[Rule]", "False"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.551828327632205*^9, 3.551828336483706*^9}, 
   3.551828367307129*^9, {3.551836085847213*^9, 3.5518360913280354`*^9}, {
   3.551918967000642*^9, 3.5519189736105328`*^9}, {3.551919023953695*^9, 
   3.551919024489521*^9}, 3.551919210007329*^9, 3.551919789488823*^9, 
   3.592828743604526*^9, 3.615293795710497*^9},
 CellLabel->
  "In[3386]:=",ExpressionUUID->"b2cd739b-ee8a-4ba6-bf43-5dd53204ee96"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePrimalDualFlagstoneTessellation", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", "\[Rho]_", ",", "opts___"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gf", ",", "edges", ",", "edgetypes", ",", "clines", ",", "csave", ",", 
      "pverts", ",", "pedges", ",", "pfaces", ",", "vva", ",", "boundary", ",",
       "bedges", ",", "vfi", ",", "dverts", ",", "dedges", ",", "iverts", ",",
       "iedges", ",", "bedgepairs", ",", "nb", ",", "nv", ",", "vpo", ",", 
      "vpi", ",", "iv", ",", "vd", ",", "fp", ",", "fn", ",", "cpl", ",", 
      "ctr", ",", "cpv", ",", "cpvi", ",", "t", ",", "pcl", ",", "vertscp", ",",
       "vertsff", ",", "gfaces", ",", "faces", ",", "tobjcp", ",", "tobjff"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPrimalDualGraph"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gf", "=", 
      RowBox[{
       RowBox[{"GroupFaces", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "MakePrimalDualFlagstoneTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"edges", " ", "of", " ", "the", " ", "new", " ", "graph"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"edgetypes", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "edge", " ", "types", " ", "of", " ", "the", " ", "new", " ", "graph"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gfaces", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "7", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"clines", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"accumulation", " ", "of", " ", "colored", " ", "lines"}], ",",
        " ", 
       RowBox[{"useful", " ", "for", " ", "debugging"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"csave", "[", "color_", "]"}], ":=", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"clines", ",", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"edges", "\[LeftDoubleBracket]", 
            RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "]"}], ",", 
          "color"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "save", " ", "the", " ", "last", " ", "edge", " ", "we", " ", "created",
        " ", "with", " ", "a", " ", "color"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "pverts", ",", "pedges", ",", "pfaces", ",", "vva", ",", "vfi", ",", 
        "boundary", ",", "bedges", ",", "dverts", ",", "dedges", ",", 
        "iverts", ",", "iedges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "Faces", ",", "VertexVertexAdjacency",
           ",", "VertexFaceIncidence", ",", "BoundaryVertices", ",", 
          "BoundaryEdges", ",", "DualVertices", ",", "DualEdges", ",", 
          "InteriorVertices", ",", "InteriorEdges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "neighborhood", " ", "of", " ", "each", " ", "vertex"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"nb", "\[LeftDoubleBracket]", "iv", "\[RightDoubleBracket]"}],
         " ", "is", " ", "a", " ", "set", " ", "of", " ", "triples", " ", 
        RowBox[{"{", 
         RowBox[{"fp", ",", " ", "vd", ",", " ", "fn"}], "}"}], " ", "for", " ",
         "each", " ", "edge", " ", "surrounding", " ", "vertex", " ", "iv"}], 
       ",", " ", 
       RowBox[{"where", " ", "fp", " ", "is", " ", "preceding", " ", "face"}],
        ",", " ", 
       RowBox[{
       "vd", " ", "is", " ", "vertex", " ", "at", " ", "other", " ", "end", " ",
         "of", " ", "the", " ", "edge"}], ",", " ", 
       RowBox[{"and", " ", "fn", " ", "is", " ", "following", " ", "face"}], ",",
        " ", 
       RowBox[{"cycling", " ", "CCW"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"nb", "=", 
      RowBox[{"Transpose", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"RotateRight", "[", "#", "]"}], "&"}], "/@", "vfi"}], ",",
           "vva", ",", "vfi"}], "}"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"nv", "\[LeftDoubleBracket]", "iv", "\[RightDoubleBracket]"}], 
       " ", "is", " ", "the", " ", "vertex", " ", "degree", " ", "of", " ", 
       "vertex", " ", "iv"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"Length", "/@", "vva"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"vpo", "[", 
        RowBox[{"iv", ",", "if"}], "]"}], " ", "is", " ", "the", " ", "outer",
        " ", "pleat", " ", "vertex", " ", "closest", " ", "to", " ", "vertex",
        " ", "iv", " ", "and", " ", "face", " ", "if"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"for", " ", "each", " ", "face"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{"(*", " ", 
         RowBox[{
         "for", " ", "each", " ", "vertex", " ", "of", " ", "the", " ", 
          "face"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"iv", "=", 
           RowBox[{"pfaces", "\[LeftDoubleBracket]", 
            RowBox[{"if", ",", "j"}], "\[RightDoubleBracket]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"vpo", "[", 
            RowBox[{"iv", ",", "if"}], "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Rho]"}], ")"}], 
             RowBox[{
             "dverts", "\[LeftDoubleBracket]", "if", 
              "\[RightDoubleBracket]"}]}], "+", 
            RowBox[{
             RowBox[{"(", "\[Rho]", ")"}], 
             RowBox[{
             "pverts", "\[LeftDoubleBracket]", "iv", 
              "\[RightDoubleBracket]"}]}]}]}]}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", 
            RowBox[{
            "pfaces", "\[LeftDoubleBracket]", "if", "\[RightDoubleBracket]"}],
             "]"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"if", ",", 
         RowBox[{"Length", "[", "pfaces", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"vpi", "[", 
         RowBox[{"iv", ",", "vd", ",", "if"}], "]"}], " ", "is", " ", "an", " ",
         "inner", " ", "pleat", " ", "vertex", " ", "closest", " ", "to", " ",
         "vertex", " ", "iv"}], ",", " ", 
       RowBox[{"face", " ", "if"}], ",", " ", 
       RowBox[{
       "that", " ", "runs", " ", "toward", " ", "vertex", " ", "vd"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"for", " ", "each", " ", "vertex"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{"(*", " ", 
         RowBox[{
         "for", " ", "each", " ", "edge", " ", "at", " ", "the", " ", 
          "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"fp", ",", "vd", ",", "fn"}], "}"}], "=", 
           RowBox[{"nb", "\[LeftDoubleBracket]", 
            RowBox[{"iv", ",", "j"}], "\[RightDoubleBracket]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"preceding", " ", "face"}], ",", " ", 
            RowBox[{"distal", " ", "vertex"}], ",", " ", 
            RowBox[{"next", " ", "face"}]}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fp", "\[NotEqual]", "0"}], "&&", 
             RowBox[{"fn", "\[NotEqual]", "0"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"vpi", "[", 
               RowBox[{"iv", ",", "vd", ",", "fp"}], "]"}], "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"3", "/", "4"}], ")"}], 
                RowBox[{"vpo", "[", 
                 RowBox[{"iv", ",", "fp"}], "]"}]}], " ", "+", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "4"}], ")"}], 
                RowBox[{"vpo", "[", 
                 RowBox[{"iv", ",", "fn"}], "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"vpi", "[", 
               RowBox[{"iv", ",", "vd", ",", "fn"}], "]"}], "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "4"}], ")"}], 
                RowBox[{"vpo", "[", 
                 RowBox[{"iv", ",", "fp"}], "]"}]}], " ", "+", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"3", "/", "4"}], ")"}], 
                RowBox[{"vpo", "[", 
                 RowBox[{"iv", ",", "fn"}], "]"}]}]}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{
           "nv", "\[LeftDoubleBracket]", "iv", "\[RightDoubleBracket]"}]}], 
