379f507ffcb0"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph3D being reduced.\n\t",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 " \[LongDash] a list from CollinearCleanupData that descries the reduction."
}], "Text",
