Cell[CellGroupData[{

Cell["Class TGraph2D", "Subsection",
 CellChangeTimes->{{3.5946863227494087`*^9, 
  3.594686326124899*^9}},ExpressionUUID->"da6386ff-b189-4fb4-887c-\
64fbc2968e31"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.594686185702346*^9, 3.594686186725738*^9}, 
   3.615244391160701*^9},ExpressionUUID->"9d6a6ec6-dcdf-4d39-a804-\
85c2da28bda5"],

Cell["\<\
For a graph that represents a crease pattern, it is useful to represent it as \
a folded form using an alternate vertex embedding. We introduce the class \
TGraph2D with property Vertices2D to represent this alternate embedding. \
(This might seem ambiguous, since Vertices also represents a 2D embedding, \
but we will shortly introduce a 3D embedding for the folded form and call it \
Vertices3D; so Vertices2D and Vertices3D both represent the same thing, just \
different embedding dimensions for the folded form.)\
\>", "Text",
 CellChangeTimes->{{3.594686189998588*^9, 3.594686256137388*^9}, {
   3.5946862879193*^9, 3.594686297358432*^9}, {3.594686335163754*^9, 
   3.59468642397416*^9}, 
   3.615244391161188*^9},ExpressionUUID->"edd81be5-6de6-4006-84fe-\
6ba72eff501f"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TObj class: TGraph2D
\tMixin with: TGraph or subclass\
\>", "Subsubsection",
 CellChangeTimes->{{3.594686451701799*^9, 
  3.594686480346567*^9}},ExpressionUUID->"3f23ad53-cc88-48cd-8a2e-\
bb06a18aa69a"],

Cell["\<\
TGraph2D is a mixin class that can be used to give any TGraph (or subclass of \
a TGraph) a second 2D embedding.\
\>", "Text",
 CellChangeTimes->{{3.594686483028681*^9, 
  3.594686556277637*^9}},ExpressionUUID->"10b6bfa1-862d-4ec7-ab68-\
00555e0f1711"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TGraph2D", "::", "usage"}], 
   "=", "\"\<TGraph2D is a TObj class that describes a graph with a second 2D \
embedding.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.594686516071947*^9, 3.594686532562665*^9}},
 CellLabel->
  "In[1308]:=",ExpressionUUID->"cc81a101-fbb7-4454-ad4a-b24bd9ad4375"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegisterTClass", "[", 
   RowBox[{"TGraph2D", ",", 
    RowBox[{"{", "TGraph", "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.594686560890888*^9, 3.594686566754078*^9}, {
  3.615297660971989*^9, 3.615297663944936*^9}},
 CellLabel->
  "In[1309]:=",ExpressionUUID->"f0846dca-9d3d-4951-8ac9-3120d79b579b"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TGraph2D properties:
\tVertices2D\
\>", "Subsubsection",
