  3.799847484853197*^9}},ExpressionUUID->"1d4a494a-8ef2-428a-936e-\
e39233889260"],

Cell["\<\
Compare the left and right ruling angles for a nonuniform helix in folded and \
unfolded state, just to confirm they\[CloseCurlyQuote]re the same.\
\>", "Text",
 CellChangeTimes->{{3.799752380377597*^9, 3.799752399357673*^9}, {
   3.799752700436389*^9, 3.799752718598965*^9}, {3.799782920659061*^9, 
   3.799782921075696*^9}, 
   3.7998372087543516`*^9},ExpressionUUID->"bb551b5f-4fe3-4e3a-9905-\
cb2bd43d87c3"],

Cell["\<\
This also provides verification for NFlattenFold2D, since that\
\[CloseCurlyQuote]s what we use to get the unfolded form.\
\>", "Text",
 CellChangeTimes->{{3.79975299882655*^9, 3.79975302959543*^9}, 
   3.799782933731691*^9, 
   3.801658122857458*^9},ExpressionUUID->"922a83df-7073-4b04-8ca4-\
ec33e537ccac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "u0", ",", "u1", ",", "r", ",", "\[Theta]", ",", "\[Gamma]", ",", "ip", ",",
       "f", ",", "rL", ",", "rR", ",", "ff", ",", "rrL", ",", "rrR"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"60", "\[Degree]"}], "+", 
        RowBox[{"60", "\[Degree]", 
         RowBox[{"(", 
          RowBox[{"#", "/", "u1"}], ")"}]}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "128"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}], "=", 
      RowBox[{"NCurvedFoldHelix3D", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Gamma]", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "rL", ",", "rR", ",", "\[Gamma]"}], "}"}], "=", 
      RowBox[{"NCurvedFoldHelix2D", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Gamma]", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CurvedFoldShapePlots3D", "[", 
          RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CurvedFoldShapePlots2D", "[", 
          RowBox[{"f", ",", "rL", ",", "rR", ",", "\[Gamma]", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CurvedFoldGraphics3D", "[", 
          RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CurvedFoldGraphics", "[", 
          RowBox[{"f", ",", "rL", ",", "rR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799747940244758*^9, 3.799748059208112*^9}, {
   3.799749023452067*^9, 3.799749031042073*^9}, {3.799749084207122*^9, 
