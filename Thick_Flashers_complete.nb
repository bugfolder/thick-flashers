Cell[CellGroupData[{

Cell[TextData[{
 "MatchCurveSpeed[",
 StyleBox["c1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{{3.6915802284484468`*^9, 3.691580238645296*^9}, 
   3.691580338242102*^9, {3.691581337583536*^9, 3.691581338736824*^9}, {
   3.800209262940659*^9, 3.800209263941353*^9}, 3.800209302340154*^9, {
