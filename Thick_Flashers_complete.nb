e56cfc03af75"],

Cell[TextData[{
 "WindingNumber[",
 StyleBox["verts",
  FontSlant->"Italic"],
 "] returns the intrinsic winding number of the polygon with vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", i.e., how many CCW turns it makes before it closes. Used for \
distinguishing a face from the perimeter in a plane graph and in detecting \
faces that have been turned over in a folded graph."
}], "Text",
 CellChangeTimes->{{3.458174423006332*^9, 3.458174447308517*^9}, {
   3.458174554317867*^9, 3.45817457202006*^9}, {3.458213578152179*^9, 
   3.458213621075598*^9}, 3.484829044319221*^9, {3.5953391947080913`*^9, 
   3.5953392087375727`*^9}, {3.595341803778609*^9, 3.595341815977005*^9}, {
   3.628958602984205*^9, 
   3.628958638116211*^9}},ExpressionUUID->"d343b80d-b419-4c10-a37b-\
1fe86f64e78f"],

Cell["\<\
In order to be robust against poorly-formed polygons, we drop repeated \
vertices and also drop vertices with an angle of -\[Pi], i.e., vertices that \
double back on themselves.\
\>", "Text",
 CellChangeTimes->{{3.643731246607154*^9, 3.643731264163588*^9}, {
  3.643731512021476*^9, 
  3.643731566608806*^9}},ExpressionUUID->"bd0bb2ba-0bba-4256-bbd6-\
49a923c8bd88"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"WindingNumber", "::", "tooshort"}], 
   "=", "\"\<Vertex list `1` must be of length greater than or equal to \
3.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.596754009272759*^9, 3.596754031242193*^9}, {
  3.628958651280504*^9, 3.62895865410989*^9}},
 CellLabel->
  "In[1157]:=",ExpressionUUID->"e487f019-8ecf-41b9-99aa-6cbeab19c3f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"WindingNumber", "::", "badverts"}], 
   "=", "\"\<Vertex list `1` has a repeated vertex.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.596754034465874*^9, 3.596754078219742*^9}, {
  3.628958703846401*^9, 3.628958708187001*^9}, {3.628958875920976*^9, 
  3.6289588768886623`*^9}},
 CellLabel->
  "In[1158]:=",ExpressionUUID->"01e2f417-f0cc-40a5-a1ac-83140b18678c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"WindingNumber", "[", "verts_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"diff", ",", "absangles", ",", "relangles", ",", "pos"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "verts", "]"}], "<", "3"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"WindingNumber", "::", "tooshort"}], ",", "verts"}], "]"}], 
        ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"if", " ", "a", " ", "vertex", " ", "is", " ", "repeated"}], ",",
        " ", 
       RowBox[{
       "we", " ", "drop", " ", "it", " ", "and", " ", "try", " ", "again"}]}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"diff", "=", 
      RowBox[{"Chop", "[", 
       RowBox[{"Mag", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RotateLeft", "[", "verts", "]"}], "-", "verts"}], ")"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pos", "=", 
      RowBox[{"Catch", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "diff", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[Equal]",
              "0"}], ",", 
            RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "diff", "]"}]}], "}"}]}], "]"}], ";", 
        RowBox[{"Throw", "[", "0", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"pos", "\[NotEqual]", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"WindingNumber", "[", 
        RowBox[{"Drop", "[", 
         RowBox[{"verts", ",", 
          RowBox[{"{", "pos", "}"}]}], "]"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"absangles", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ArcTan", "@@", 
             RowBox[{"Subtract", "@@", "#"}]}], "&"}], ")"}], "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RotateLeft", "[", "verts", "]"}], ",", "verts"}], "}"}],
            "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"relangles", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"#", ",", 
             RowBox[{"2", "\[Pi]"}], ",", 
             RowBox[{"-", "\[Pi]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"absangles", "-", 
            RowBox[{"RotateRight", "[", "absangles", "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
           "If", " ", "a", " ", "vertex", " ", "returns", " ", "an", " ", 
            "angle", " ", "of"}], " ", "-", "\[Pi]"}], ",", " ", 
          RowBox[{"drop", " ", "it", " ", "and", " ", "try", " ", "again"}]}],
          " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"pos", "=", 
         RowBox[{"Catch", "[", 
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                "relangles", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}], "\[Equal]", 
                RowBox[{"-", "\[Pi]"}]}], ",", 
               RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "relangles", "]"}]}], "}"}]}], "]"}], ";", 
           RowBox[{"Throw", "[", "0", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"pos", "\[NotEqual]", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{"WindingNumber", "[", 
           RowBox[{"Drop", "[", 
            RowBox[{"verts", ",", 
             RowBox[{"{", "pos", "}"}]}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"Plus", "@@", "relangles"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}]}], "]"}]}], "]"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.458174592871118*^9, 3.458174606141253*^9}, {
   3.458213638517716*^9, 3.458213759335387*^9}, {3.458213799911519*^9, 
   3.458213935973089*^9}, {3.458214054774919*^9, 3.458214065852387*^9}, {
   3.458214106507814*^9, 3.458214169686368*^9}, {3.596754082428767*^9, 
   3.5967541386850863`*^9}, 3.627328596557711*^9, {3.628958662972684*^9, 
   3.628958673781282*^9}, {3.6289587134630337`*^9, 3.628958744956175*^9}, {
   3.628958807018475*^9, 3.628958828485771*^9}, 3.6289588841078873`*^9, {
   3.64372988039831*^9, 3.643729890628585*^9}, {3.643730005439262*^9, 
   3.643730015085029*^9}, {3.643730051187343*^9, 3.643730055538528*^9}, {
   3.643730188379307*^9, 3.643730198578635*^9}, {3.643730460860265*^9, 
   3.643730615832572*^9}, {3.643730648110744*^9, 3.643730712033074*^9}, {
   3.643730843386075*^9, 3.643730848128336*^9}, {3.6437311731989202`*^9, 
   3.64373118170866*^9}, {3.643731282359622*^9, 3.643731494215371*^9}, {
   3.643731584748872*^9, 3.643731615392449*^9}, {3.643819308529083*^9, 
   3.643819328380936*^9}},
