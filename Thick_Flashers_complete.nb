Cell["\<\
An example with BaseFaces, to give a common backplane, and \
MinimumEdgeLengths, to set one edge to zero.\
\>", "Text",
 CellChangeTimes->{{3.6933963598982987`*^9, 3.693396385441526*^9}, 
   3.693419381225917*^9},ExpressionUUID->"4442af27-c6f0-49ac-8ed9-\
8ab851971424"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nb", ",", "d\[Gamma]b", ",", "\[Gamma]b", ",", "\[Gamma]l0", ",", 
      "\[Gamma]l", ",", "\[Phi]b", ",", "\[Phi]l", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]l0", "=", 
      RowBox[{"132.5", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]l", "=", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]l0", ",", 
        RowBox[{"-", "\[Gamma]l0"}], ",", 
        RowBox[{"-", "\[Gamma]l0"}], ",", "\[Gamma]l0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]l", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "\[Gamma]l", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nb", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d\[Gamma]b", "=", 
      RowBox[{"2", 
       RowBox[{"\[Pi]", "/", "nb"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]b", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d\[Gamma]b", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nb", "-", "2"}], ")"}], "/", "2"}]}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"-", "d\[Gamma]b"}], ",", 
          RowBox[{"{", 
           RowBox[{"nb", "-", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d\[Gamma]b", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nb", "-", "2"}], ")"}], "/", "2"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"N", "[", 
       RowBox[{"\[Gamma]b", "/", "\[Degree]"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]b", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "\[Gamma]b", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RigidlyFoldableQuadMesh", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Phi]b", ",", "\[Gamma]b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]l", ",", "\[Gamma]l"}], "}"}], ",", 
        RowBox[{"BaseFaces", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Length", "[", "\[Gamma]b", "]"}], ",", "0"}], "}"}]}], 
          "}"}]}], ",", 
        RowBox[{"MinimumEdgeLengths", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", "6", ",", "2", ",", "0"}], "}"}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.692472905998848*^9, 3.69247290854755*^9}, {
   3.692472963626645*^9, 3.692473080378449*^9}, {3.692475117711043*^9, 
