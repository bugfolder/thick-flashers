Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTDegree4Vertex3D", "::", "maekawa"}], 
   "=", "\"\<Crease directions `1` give assignment `2` which does not satisfy \
Maekawa's Theorem.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.617439340878703*^9, 3.617439393656597*^9}, {
  3.6174394803478003`*^9, 3.617439482323903*^9}},
 CellLabel->
  "In[2238]:=",ExpressionUUID->"ab65fa17-a7ad-4089-92e6-717e91e2574e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTDegree4Vertex3D", "[", 
   RowBox[{"{", 
    RowBox[{"g1_", ",", "g2_", ",", "g3_", ",", "g4_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobj", ",", "aa", ",", "gg", ",", "\[Alpha]", ",", "\[Gamma]", ",", 
      "mm", ",", "g", ",", "cd", ",", "od", ",", "odi", ",", "f", ",", "mji", 
      ",", "mni", ",", "q", ",", "z", ",", "\[Theta]", ",", "\[Zeta]", ",", 
      "\[Sigma]", ",", "\[Beta]\[Beta]", ",", "\[Beta]", ",", "t", ",", 
      "\[Rho]", ",", "ss34", ",", "ss12", ",", "i\[Tau]", ",", "it"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", 
       RowBox[{"{", 
        RowBox[{"g1", ",", "g2", ",", "g3", ",", "g4"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "aa", ",", "gg", ",", "\[Alpha]", ",", "\[Gamma]", ",", "mm", ",", 
        "g"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "SectorVectors", ",", "FoldVectors", ",", "SectorAngles", ",", 
          "DihedralAngles", ",", "MidfoldVectors", ",", "CreaseVectors"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Identify", " ", "the", " ", "major", " ", "and", " ", "minor", " ", 
       "creases", " ", "and", " ", "the", " ", "odd", " ", "crease"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cd", "=", 
      RowBox[{"Sign", "/@", "\[Gamma]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"crease", " ", "directions", " ", "as"}], " ", "\[PlusMinus]", 
       "1"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{"cd", ",", "1"}], "]"}], "-", 
          RowBox[{"Count", "[", 
           RowBox[{"cd", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], "]"}], "\[NotEqual]", "2"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
