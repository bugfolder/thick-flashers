        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cyl", "[", 
           RowBox[{
            RowBox[{"lb", "+", "le", "+", "dc"}], ",", 
            RowBox[{"lb", "+", 
             RowBox[{"2", "le"}], "+", "dc"}], ",", "do"}], "]"}], ",", 
          RowBox[{"cyl", "[", 
           RowBox[{
            RowBox[{"lpq", "-", "lb", "-", 
             RowBox[{"2", "le"}], "-", "dc"}], ",", 
