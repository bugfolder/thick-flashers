Cell["Example. Flatten a cone, given a curve on the cone.", "Text",
 CellChangeTimes->{{3.801771767347474*^9, 
  3.801771779923306*^9}},ExpressionUUID->"61b0bb54-d5ea-4564-b5ac-\
654d89fd86b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "\[Theta]", ",", "as", ",", "bb", ",", "dd", ",", "\[Sigma]", ",",
       "ui", ",", "bi", ",", "ti", ",", "b", ",", "d", ",", "u0", ",", "u1", ",",
       "v0", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
           RowBox[{"Cos", "[", "s", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], 
           RowBox[{"Sin", "[", "s", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     RowBox[{"dd", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"-", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
            RowBox[{"Cos", "[", "s", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], 
            RowBox[{"Sin", "[", "s", "]"}]}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], "=", 
      RowBox[{"NFlattenGeneric2D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"StyledRuledPatch", "[", 
              RowBox[{"b", ",", "d", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"StyledCurve", "[", 
              RowBox[{"b", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
               
               RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}]}], "}"}],
            ",", "\[IndentingNewLine]", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"StyledRuledPatch", "[", 
              RowBox[{"bb", ",", "dd", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"v0", ",", "v1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"StyledCurve", "[", 
              RowBox[{"bb", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
               
               RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}]}], "}"}],
            ",", "\[IndentingNewLine]", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.801771784711421*^9, 3.8017719472530003`*^9}, {
   3.801772004669875*^9, 3.801772286547858*^9}, {3.801772318948017*^9, 
   3.80177233153891*^9}, {3.80178351021905*^9, 3.801783540966796*^9}, 
   3.801783663324651*^9, {3.801783722202556*^9, 3.8017837260235863`*^9}},
 CellLabel->
  "In[3883]:=",ExpressionUUID->"76c96499-f382-4c5d-b873-8f982feccef2"]
}, Closed]]
}, Closed]],

