}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "VertexIndex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) SamePtTolerance\nEdgeIndex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["e",
  FontSlant->"Italic"],
 "]\nFaceIndex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.643724056477927*^9, 3.643724114593511*^9}, {
  3.643724880498765*^9, 
  3.6437248824971547`*^9}},ExpressionUUID->"e3492935-4cdf-465b-9ea6-\
b4a5bd305a19"],

Cell[TextData[{
 "VertexIndex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the index of vertex ",
 StyleBox["v",
  FontSlant->"Italic"],
 " within ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". If it is not found, it returns 0. Options are:\n\tSamePtTolerance \[Rule] \
",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", to specify the tolerance on sameness."
}], "Text",
 CellChangeTimes->{{3.643724492170998*^9, 
  3.643724545198057*^9}},ExpressionUUID->"25eb6ff4-4c65-4153-a454-\
e99ad7523fdb"],

Cell[TextData[{
 "VertexIndex and EdgeIndex have the same names as built-in functions that \
work with built-in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " graphs. We\[CloseCurlyQuote]ll use the argument type of TObj to make the \
distinction."
}], "Text",
 CellChangeTimes->{{3.64372375860036*^9, 3.643723765823344*^9}, {
  3.643723929822418*^9, 3.643723961650984*^9}, {3.643725029640778*^9, 
  3.643725039534656*^9}},ExpressionUUID->"04eb6911-2f87-484c-a2e5-\
5b2fa5381852"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Unprotect", "[", "VertexIndex", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VertexIndex", "[", 
    RowBox[{"tobj_TObj", ",", "v_List", ",", "opts___"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"verts", "=", 
       RowBox[{"tobj", "[", "Vertices", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"SamePtQ", "[", 
            RowBox[{
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             ",", "v", ",", "opts"}], "]"}], ",", 
           RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"Throw", "[", "0", "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "VertexIndex", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.643723714021776*^9, 3.643723913538406*^9}, {
  3.64372407725479*^9, 3.643724077842132*^9}, {3.643724485059895*^9, 
  3.64372448810087*^9}, {3.64372493653509*^9, 3.64372493697455*^9}},
 CellLabel->
  "In[1084]:=",ExpressionUUID->"a7fe577a-9943-46c7-a4d4-8aa5bd16b84f"],

Cell[TextData[{
 "EdgeIndex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["e",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the index of edge ",
 StyleBox["e",
  FontSlant->"Italic"],
 " given as a vertex index pair. If it is not found, it returns 0."
}], "Text",
 CellChangeTimes->{{3.643724685544058*^9, 3.643724723730332*^9}, {
  3.643724889048267*^9, 
  3.643724920558663*^9}},ExpressionUUID->"65c28a61-8e93-4b3f-b3f8-\
b18fc1253115"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Unprotect", "[", "EdgeIndex", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EdgeIndex", "[", 
    RowBox[{"tobj_TObj", ",", "e_List", ",", "opts___"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"edges", "=", 
       RowBox[{"tobj", "[", "Edges", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"SameEdgeQ", "[", 
            RowBox[{
             RowBox[{
             "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             ",", "e", ",", "opts"}], "]"}], ",", 
           RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"Throw", "[", "0", "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "EdgeIndex", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.643724608670014*^9, 3.643724653000278*^9}, {
  3.643724715340417*^9, 3.643724718821816*^9}, {3.643724925388604*^9, 
  3.64372492941237*^9}},
 CellLabel->
  "In[1087]:=",ExpressionUUID->"3e3152b5-ffa6-4021-990a-eb57b3bebf6b"],

Cell[TextData[{
 "FaceIndex[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f",
  FontSlant->"Italic"],
 "] returns the index of a face ",
 StyleBox["f",
  FontSlant->"Italic"],
 " given a cyclic ordering of its vertices. If it is not found, it returns \
0."
}], "Text",
 CellChangeTimes->{{3.643724730627441*^9, 3.6437247617047596`*^9}, {
  3.643724842275547*^9, 
  3.643724846362685*^9}},ExpressionUUID->"2b217cf0-683c-432e-9d93-\
c5ef945bbd0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FaceIndex", "[", 
    RowBox[{"tobj_TObj", ",", "f_List", ",", "opts___"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"faces", "=", 
       RowBox[{"tobj", "[", "Faces", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"SameFaceQ", "[", 
            RowBox[{
             RowBox[{
             "faces", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             ",", "f", ",", "opts"}], "]"}], ",", 
           RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "faces", "]"}]}], "}"}]}], "]"}], ";", 
       RowBox[{"Throw", "[", "0", "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.643724608670014*^9, 3.643724653000278*^9}, {
  3.643724715340417*^9, 3.643724718821816*^9}, {3.64372482591196*^9, 
  3.643724869220641*^9}},
 CellLabel->
  "In[1090]:=",ExpressionUUID->"88a06f93-4521-4097-940b-16b695b41cb1"],

