 RowBox[{
  RowBox[{"Graph3DGraphics3D", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vl", ",", "el", ",", "fl", ",", "de", ",", "de3d", ",", "vc", ",", "ec",
       ",", "fc", ",", "fcng", ",", "verts3d", ",", " ", "edges", ",", " ", 
      "faces", ",", "hf", ",", "gg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
