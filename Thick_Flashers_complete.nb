Cell[CellGroupData[{

Cell[TextData[{
 "AnyThreeInASemiNecklaceQ[",
 StyleBox["types",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "]\nAnyThreeInASemiNecklaceQ[",
 StyleBox["types",
  FontSlant->"Italic"],
 "]\nOppositeTypesDifferentQ[",
 StyleBox["types",
  FontSlant->"Italic"],
 "]\n",
 "RegularPolygonTwistValidQ",
 "[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.45772293587004*^9, 3.457722937285446*^9}, 
   3.592165341442614*^9, 3.6286370480393057`*^9, 
   3.628637202535249*^9},ExpressionUUID->"4922a144-df29-45b4-8b04-\
ab710e58e36d"],

Cell[TextData[{
 "AnyThreeInASemiNecklaceQ[",
 StyleBox["types",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 "] returns True if any three entries in necklace ",
 StyleBox["types",
  FontSlant->"Italic"],
 " of type ",
 StyleBox["m",
  FontSlant->"Italic"],
 " always lie within a seminecklace."
}], "Text",ExpressionUUID->"961b55ea-e8f8-4bbb-b0ac-67f6d0472727"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AnyThreeInASemiNecklaceQ", "[", 
   RowBox[{"types_List", ",", " ", "m_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{"types", ",", "m"}], "]"}], "<", "3"}], "||", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "types", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"pos", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"types", ",", "m"}], "]"}], "]"}]}], ",", "np", ",", "tpls",
        ",", "gaps"}], "}"}], ",", 
     RowBox[{
      RowBox[{"np", "=", 
       RowBox[{"Length", "[", "pos", "]"}]}], ";", 
      RowBox[{"tpls", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"pos", "[", 
            RowBox[{"[", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j", ",", "k"}], "}"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"np", "-", "2"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"i", "+", "1"}], ",", 
             RowBox[{"np", "-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"j", "+", "1"}], ",", "np"}], "}"}]}], "]"}], ",", "2"}],
         "]"}]}], ";", 
      RowBox[{"gaps", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"RotateLeft", "[", "#", "]"}], "-", "#"}], ",", "n"}], 
            "]"}], ",", 
           RowBox[{"Function", "[", 
            RowBox[{"x", ",", 
             RowBox[{"x", "\[LessEqual]", 
              RowBox[{"n", "/", "2"}]}]}], "]"}]}], "]"}], "&"}], "/@", 
        "tpls"}]}], ";", 
      RowBox[{"And", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "<", 
           RowBox[{"n", "/", "2"}]}], "&"}], "/@", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"RotateLeft", "[", "#", "]"}], "+", "#"}], "&"}], "/@", 
           "gaps"}], "]"}]}], ")"}]}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.457722853028915*^9, 3.457722857570374*^9}, 
   3.627591688867957*^9},
 CellLabel->
  "In[2708]:=",ExpressionUUID->"96e1700d-7df5-4f7b-a841-6cb47f9a0056"],

Cell[TextData[{
 "AnyThreeInASemiNecklaceQ[",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns True if any three of the same type lie within a seminecklace."
}], "Text",ExpressionUUID->"f548451b-ab98-4fc0-88ed-c27adbf65234"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AnyThreeInASemiNecklaceQ", "[", "types_List", "]"}], ":=", 
  RowBox[{
   RowBox[{"AnyThreeInASemiNecklaceQ", "[", 
    RowBox[{"types", ",", "M"}], "]"}], "&&", 
   RowBox[{"AnyThreeInASemiNecklaceQ", "[", 
    RowBox[{"types", ",", "V"}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.627591714036862*^9},
 CellLabel->
  "In[2709]:=",ExpressionUUID->"89f7a5e6-1871-4a04-88a6-0b99970795f7"],

Cell[TextData[{
 "OppositeTypesDifferentQ[",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns True if types is of odd length or diametrically opposite types \
are different."
}], "Text",ExpressionUUID->"007fb879-c53a-4b8f-b207-765c684276ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OppositeTypesDifferentQ", "[", "types_List", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "types", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{"n", ",", "2"}], "]"}], "\[Equal]", "1"}], "||", 
     RowBox[{"!", 
      RowBox[{"Or", "@@", 
       RowBox[{"MapThread", "[", 
        RowBox[{"SameQ", ",", 
         RowBox[{"{", 
          RowBox[{"types", ",", 
           RowBox[{"RotateLeft", "[", 
            RowBox[{"types", ",", 
             RowBox[{"n", "/", "2"}]}], "]"}]}], "}"}]}], "]"}]}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{3.62759171559025*^9},
 CellLabel->
  "In[2710]:=",ExpressionUUID->"44e6984d-ae83-4c60-b6e1-b7299dd5b9bb"],

Cell[TextData[{
 "RegularPolygonTwistValidQ",
 "[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns True if the twist angle \[Alpha] and MV-assignment ",
 StyleBox["types",
  FontSlant->"Italic"],
 " are consistent with a valid simple flat twist whose center is a regular ",
 StyleBox["n",
  FontSlant->"Italic"],
 "-sided polygon. Use this as a check on validity, because supplying invalid \
parameters to the other routines will result in unpredictable results. The \
conditions we apply are:\n1. n\[GreaterEqual]3\n2. If ",
 StyleBox["n",
  FontSlant->"Italic"],
 "=4 or 5 and \[Alpha] is greater than the cyclic angle, types must satisfy \
AnyThreeInASemiNecklaceQ.\n3. If MM or VV only (cyclic), \[Alpha] must be \
less than the cyclic angle.\n4. If MV and VM only (alternating form), \
\[Alpha] must be less than the alternating form angle.\n5. If general mixed \
form, mixed form conditions on twist angle apply."
}], "Text",
 CellChangeTimes->{{3.484252458804396*^9, 3.484252468530175*^9}, {
   3.592165341511858*^9, 3.592165380110812*^9}, 3.628637048211379*^9, 
   3.6286372026309566`*^9},ExpressionUUID->"da729425-fa93-43e0-a465-\
751a3169b0e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegularPolygonTwistValidQ", "[", 
   RowBox[{"n_", ",", "\[Alpha]_", ",", "types_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ty", ",", "\[Alpha]\[Alpha]", ",", "mm", ",", "mv"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ty", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{"Times", "[", 
          RowBox[{"types", ",", 
           RowBox[{"RotateLeft", "[", "types", "]"}]}], "]"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M", "\[Rule]", "1"}], ",", 
          RowBox[{"V", "\[Rule]", 
           RowBox[{"-", "1"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]\[Alpha]", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"\[Alpha]", ",", 
        RowBox[{"\[Pi]", "-", "\[Alpha]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mm", "=", 
      RowBox[{"MemberQ", "[", 
       RowBox[{"ty", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mv", "=", 
      RowBox[{"MemberQ", "[", 
       RowBox[{"ty", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "\[GreaterEqual]", "3"}], ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"n", "\[Equal]", "4"}], "||", 
           RowBox[{"n", "\[Equal]", "5"}]}], ")"}], "&&", 
         RowBox[{"\[Alpha]\[Alpha]", ">", 
          RowBox[{
           FractionBox["\[Pi]", "2"], "-", 
           FractionBox["\[Pi]", "n"]}]}]}], "\[Implies]", 
        RowBox[{
         RowBox[{"AnyThreeInASemiNecklaceQ", "[", "types", "]"}], "&&", 
         RowBox[{"OppositeTypesDifferentQ", "[", "types", "]"}]}]}], ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mm", "&&", 
          RowBox[{"!", "mv"}]}], ")"}], "\[Implies]", 
        RowBox[{"\[Alpha]\[Alpha]", "\[LessEqual]", 
         RowBox[{
          FractionBox["\[Pi]", "2"], "-", 
          FractionBox["\[Pi]", "n"]}]}]}], ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mv", "&&", 
          RowBox[{"!", "mm"}]}], ")"}], "\[Implies]", 
        RowBox[{"\[Alpha]\[Alpha]", "\[LessEqual]", 
         FractionBox[
          RowBox[{"2", "\[Pi]"}], "n"]}]}], ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mm", "&&", "mv"}], ")"}], "\[Implies]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"n", "\[LessEqual]", "4"}], "\[Implies]", 
           RowBox[{"\[Alpha]\[Alpha]", "\[LessEqual]", 
            RowBox[{"\[Pi]", "-", 
             FractionBox[
              RowBox[{"2", "\[Pi]"}], "n"]}]}]}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"n", "\[GreaterEqual]", "4"}], "\[Implies]", 
           RowBox[{"\[Alpha]\[Alpha]", "\[LessEqual]", 
            FractionBox[
             RowBox[{"2", "\[Pi]"}], "n"]}]}], ")"}]}]}], ")"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.484834026269554*^9, 3.484834026944203*^9}, 
   3.592165341543429*^9, {3.5949849228389072`*^9, 3.594984923238822*^9}, {
   3.595030397741514*^9, 3.5950304674709*^9}, 3.627591718172346*^9, 
   3.628637048351359*^9, 3.628637202651271*^9},
 CellLabel->
  "In[2711]:=",ExpressionUUID->"434b8e76-a481-4b6d-9a19-bfd0e73c32ab"],

Cell["Examples", "Text",ExpressionUUID->"3beb8d49-1760-40f1-bd11-96ddd2adb7d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"RegularPolygonTwistValidQ", "[", 
     RowBox[{"3", ",", 
      RowBox[{"29.999", "\[Degree]"}], ",", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "M"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"RegularPolygonTwistValidQ", "[", 
     RowBox[{"3", ",", 
      RowBox[{"30.001", "\[Degree]"}], ",", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "M"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"RegularPolygonTwistValidQ", "[", 
     RowBox[{"3", ",", 
      RowBox[{"59.999", "\[Degree]"}], ",", 
