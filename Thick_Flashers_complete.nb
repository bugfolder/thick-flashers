   3.629839485613419*^9},ExpressionUUID->"a704dc6b-67a7-4937-b769-\
bb4478ee46c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CenteredTwistTiltAngle", "[", 
   RowBox[{"w_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{"ArcTan", "[", 
   RowBox[{
    RowBox[{"Tan", "[", "\[Alpha]", "]"}], "/", "w"}], "]"}]}]], "Input",
 CellChangeTimes->{3.627339666096946*^9, 3.627340281707345*^9, 
  3.627385975625769*^9, 3.62738656406706*^9, 3.628637057691306*^9, 
