Cell[TextData[{
 "TetrahedronCosA[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595802850696343*^9, 
  3.59580286107876*^9}},ExpressionUUID->"6cebd820-3930-4600-8c39-\
56e855742b21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronCosA", "[", 
   StyleBox[
    RowBox[{
    "a_", ",", " ", "b_", ",", " ", "c_", ",", " ", "d_", ",", " ", "e_", ",",
      " ", "f_"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["a", "4"]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["b", "2"], "-", 
        SuperscriptBox["c", "2"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["d", "2"], "-", 
        SuperscriptBox["e", "2"]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["b", "2"], "+", 
        SuperscriptBox["c", "2"], "+", 
        SuperscriptBox["d", "2"], "+", 
        SuperscriptBox["e", "2"], "-", 
        RowBox[{"2", " ", 
         SuperscriptBox["f", "2"]}]}], ")"}]}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "+", "b", "-", "c"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "-", "b", "+", "c"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "a"}], "+", "b", "+", "c"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]], " ", 
     SqrtBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "+", "d", "-", "e"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "-", "d", "+", "e"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "a"}], "+", "d", "+", "e"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "d", "+", "e"}], ")"}]}]]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.595802870066107*^9, 3.5958028703764677`*^9}, {
  3.595802914706084*^9, 3.595802933510071*^9}},
 CellLabel->
  "In[647]:=",ExpressionUUID->"e7f5de2f-2832-48bc-9823-fadf7429fea3"],

