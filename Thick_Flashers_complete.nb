Cell[CellGroupData[{

Cell["Sequential flat-folding", "Section",
 CellChangeTimes->{{3.706691030696747*^9, 3.706691037980686*^9}, {
  3.706876524409286*^9, 
  3.70687652555833*^9}},ExpressionUUID->"45d3c57f-e240-46af-82b8-\
9afeeddbc8d3"],

Cell[CellGroupData[{

Cell["Class TSplitGraph2D", "Subsection",
 CellChangeTimes->{{3.5946863227494087`*^9, 3.594686326124899*^9}, 
   3.70679042049121*^9, 
   3.706790673698587*^9},ExpressionUUID->"c4087c01-a862-48b8-9d43-\
d76f5b1cca5e"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.594686185702346*^9, 3.594686186725738*^9}, 
   3.615244391160701*^9},ExpressionUUID->"edb708d2-b469-47cb-b2ed-\
e413018498b9"],

Cell["\<\
One of the ways of generating a complex TGraph2D (a description of a \
flat-folded shape) is to start with a simpler version and then sequentially \
add folds to it. Class TSplitTGraph2D is a class that represents an \
intermediate stage of this flat-folding process: it describes an interaction \
between a TGraph2D and a superimposed fold line that will split some faces \
and edges. TSplitGraph2D describes the state with splitting information \
included but not actually applied yet. This gives us the opportunity to \
adjust the splitting information so as to only fold certain parts of the \
model. The fold line and splitting information is encapsulated in this class.\
\
\>", "Text",
 CellChangeTimes->{{3.594686189998588*^9, 3.594686256137388*^9}, {
   3.5946862879193*^9, 3.594686297358432*^9}, {3.594686335163754*^9, 
   3.59468642397416*^9}, 3.615244391161188*^9, {3.706790435105584*^9, 
   3.706790527818102*^9}, {3.706790630354623*^9, 3.706790724884075*^9}, {
   3.706791164073922*^9, 
   3.706791237513682*^9}},ExpressionUUID->"5675defc-66a1-4683-87a9-\
18b92343d489"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TObj class: TSplitGraph2D
\tInherits from: TGraph2D\
\>", "Subsubsection",
 CellChangeTimes->{{3.594686451701799*^9, 3.594686480346567*^9}, 
   3.70679048431038*^9, {3.706790732035191*^9, 3.7067907325715246`*^9}, {
   3.706915855726201*^9, 
   3.706915862500963*^9}},ExpressionUUID->"812c8976-7185-41a2-a55b-\
4a21e6ec4ced"],

Cell["\<\
TSplitGraph2D is a subclass that can be used to give any TGraph2D a fold line \
and splitting information.\
\>", "Text",
 CellChangeTimes->{{3.594686483028681*^9, 3.594686556277637*^9}, 
   3.706790484324107*^9, {3.706790737251811*^9, 3.706790747947886*^9}, {
   3.706791241864674*^9, 3.706791242784704*^9}, {3.706915872357373*^9, 
   3.70691587326163*^9}},ExpressionUUID->"94c301d7-2f3b-423b-b457-\
18b57256a859"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TSplitGraph2D", "::", "usage"}], 
   "=", "\"\<TSplitGraph2D is a TObj class that describes a flat folded form \
with an interacting fold line and splitting information.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594686516071947*^9, 3.594686532562665*^9}, {
  3.706790484331586*^9, 3.706790484340368*^9}, {3.70679061228438*^9, 
  3.706790622146809*^9}, {3.706791253880688*^9, 3.706791256592403*^9}},
 CellLabel->
  "In[1371]:=",ExpressionUUID->"3411652e-a849-4598-a0f4-d37a2cab8419"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RegisterTClass", "[", 
   RowBox[{"TSplitGraph2D", ",", 
    RowBox[{"{", "TGraph2D", "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.594686560890888*^9, 3.594686566754078*^9}, {
   3.615297660971989*^9, 3.615297663944936*^9}, 3.706790484346346*^9, {
   3.706790601820038*^9, 3.706790602420082*^9}},
 CellLabel->
  "In[1372]:=",ExpressionUUID->"58f958b7-d6e5-40df-bb5d-a3c7125b7daa"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
TSplitGraph2D properties:
\tSplitFoldLine
\tSplitInfo\
\>", "Subsubsection",
 CellChangeTimes->{{3.5946865710292387`*^9, 3.594686593387146*^9}, 
   3.7067904843627043`*^9, {3.706790754955944*^9, 
   3.706790760987977*^9}},ExpressionUUID->"31939597-30ad-47df-bb37-\
5bdb28d2fbc1"],

Cell[TextData[{
 "SplitFoldLine is a property that describes the position and direction of a \
fold line superimposed on the folded form. It consists of a list {",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "} where ",
 StyleBox["p",
  FontSlant->"Italic"],
 " is a point on the line and ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is a direction vector for the line."
}], "Text",
 CellChangeTimes->{{3.5946866048105917`*^9, 3.5946866196656437`*^9}, {
  3.706790766510366*^9, 3.706790785715921*^9}, {3.706791275834217*^9, 
  3.7067912925368977`*^9}},ExpressionUUID->"e9b8e78f-345b-4c92-83a7-\
3e6c7164c4e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SplitFoldLine", "::", "usage"}], 
   "=", "\"\<SplitFoldLine is a TObj property that specifies a fold line on a \
TGraph2D\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59237727961279*^9, 3.592377307622538*^9}, 
   3.592435744246968*^9, 3.594229125361625*^9, {3.594686631310248*^9, 
   3.594686635787291*^9}, {3.706790800184325*^9, 3.70679081962864*^9}},
 CellLabel->
  "In[1373]:=",ExpressionUUID->"287b647d-9531-4a47-93e1-9bf1ab1a1751"],

Cell["\<\
SplitInfo is a collection of data that describes splitting that could happen \
to a TGraph2D.\
\>", "Text",
 CellChangeTimes->{{3.5946866048105917`*^9, 3.5946866196656437`*^9}, {
  3.706790766510366*^9, 3.706790785715921*^9}, {3.706790832238401*^9, 
  3.7067908424844923`*^9}, {3.706790898373*^9, 
  3.706790915301309*^9}},ExpressionUUID->"2cf55e17-6fc7-4e22-a8a4-\
6ef11506dd10"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SplitInfo", "::", "usage"}], 
   "=", "\"\<SplitInfo is a TObj property that specifies splitting activity \
on a TGraph2D\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59237727961279*^9, 3.592377307622538*^9}, 
   3.592435744246968*^9, 3.594229125361625*^9, {3.594686631310248*^9, 
   3.594686635787291*^9}, {3.706790800184325*^9, 3.70679083523199*^9}, {
   3.706790926453814*^9, 3.706790931709587*^9}},
 CellLabel->
  "In[1374]:=",ExpressionUUID->"eb65be3f-ad5f-4277-9802-e1f8f31c653f"],

Cell[TextData[{
 "SplitInfo is a structured list of the form {",
 StyleBox["vfinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["efinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["esinfo, fsinfo",
  FontSlant->"Italic"],
 "} where\n\t",
 StyleBox["vfinfo",
  FontSlant->"Italic"],
 " is a list of indices of vertices hit by the fold line.\n\t",
 StyleBox["efinfo",
  FontSlant->"Italic"],
 " is a list of indices of edges that are collinear with the fold line.\n\t",
 StyleBox["esinfo",
  FontSlant->"Italic"],
 " is a list of pairs {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "} of edges that are split by the fold line in their interior. ",
 StyleBox["i",
  FontSlant->"Italic"],
 " is the edge index, ",
 StyleBox["t",
  FontSlant->"Italic"],
 " is the relative distance along the edge where the split occurs.\n\t",
 StyleBox["fsinfo",
  FontSlant->"Italic"],
 " is a list of data {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", {",
 StyleBox["fj, j",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["fk",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "}} of faces that are split by a fold line, where\n\t\t",
 StyleBox["i",
  FontSlant->"Italic"],
 " is the index of a face to be split,\n\t\t{",
 StyleBox["fj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 "} specifies one endpoint of the new face-splitting edge. If f",
 StyleBox["j",
  FontSlant->"Italic"],
 "\[Equal]0, it\[CloseCurlyQuote]s a vertex and ",
 StyleBox["j",
  FontSlant->"Italic"],
 " is the vertex index. If f",
 StyleBox["j",
  FontSlant->"Italic"],
 "\[Equal]1, it\[CloseCurlyQuote]s a split edge and ",
 StyleBox["j",
  FontSlant->"Italic"],
 " is the edge index.\n\t\t{",
 StyleBox["fk",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "} specifies the other endpoint of the new face-splitting edge in the same \
way."
}], "Text",
 CellChangeTimes->{{3.706791441906219*^9, 
  3.706791485475818*^9}},ExpressionUUID->"14d7a4c0-ec5e-4357-8bb4-\
fd53d6b2ce53"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph2D, TPlaneGraph\n\t(options) \
PtOnLineTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.7067102944330873`*^9, 3.706710304898733*^9}, {
   3.706710423303617*^9, 3.70671042389854*^9}, 3.706710690634048*^9, 
   3.706710945237199*^9, 3.706780523554916*^9, 3.706780616395419*^9, 
   3.706780689184894*^9, {3.706791348707408*^9, 
   3.706791369817759*^9}},ExpressionUUID->"d26f8f2f-68f4-4c72-bf67-\
e81d313c566d"],

Cell[TextData[{
 "MakeSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p",
  FontSlant->"Italic"],
 ",",
 StyleBox["r",
  FontSlant->"Italic"],
 "}, opts] takes a TGraph2D+TPlaneGraph and adds information about a fold \
line, which vertices and edges are hit by the fold line, and which edges and \
faces would be split."
}], "Text",
 CellChangeTimes->{{3.706710306976008*^9, 3.706710315430669*^9}, {
   3.706710413837056*^9, 3.706710465311659*^9}, 3.706780523579379*^9, {
   3.706780688805869*^9, 3.706780737818116*^9}, {3.7067913760446057`*^9, 
   3.706791426682453*^9}},ExpressionUUID->"c4236448-24fd-41e2-9f92-\
ee171f32779e"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph2D+TPlaneGraph that represents the initial folded \
state.\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] a point on the desired fold line.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] a vector along the desired fold line."
}], "Text",
 CellChangeTimes->{{3.706691337892794*^9, 3.70669139157979*^9}, {
   3.706691491235763*^9, 3.706691534722044*^9}, 
   3.706710479459261*^9},ExpressionUUID->"6cd325b8-ecfa-4643-b019-\
9f488b07e5ad"],

Cell[TextData[{
 "Options:\n\tPtOnLineTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", the tolerance on whether a vertex is hit by the fold line; passed through \
to PtOnLineQ."
}], "Text",
 CellChangeTimes->{{3.706691549903835*^9, 3.706691577428012*^9}, {
   3.7067106087635937`*^9, 3.706710683851078*^9}, {3.7067108495464087`*^9, 
   3.7067108578190417`*^9}, {3.706719500023348*^9, 3.7067195036747437`*^9}, 
   3.706719563510325*^9, 3.706780612705136*^9, {3.706780751961837*^9, 
   3.706780757490123*^9}},ExpressionUUID->"cb86a175-25c9-40a9-aecd-\
9c8edf7bbe68"],

Cell["\<\
Returns a TSplitGraph2D, with the new properties SplitFoldLine and SplitInfo. \
\>", "Text",
 CellChangeTimes->{{3.7067104849500732`*^9, 3.706710563599285*^9}, {
   3.706725397145872*^9, 3.706725423774228*^9}, {3.706725510871835*^9, 
   3.706725569996077*^9}, {3.7067257217838497`*^9, 3.7067259589490356`*^9}, {
   3.706726024468256*^9, 3.706726026825412*^9}, {3.706730576414211*^9, 
   3.706730682708572*^9}, {3.706730835839948*^9, 3.706730837923047*^9}, {
   3.706730871312442*^9, 3.70673088441722*^9}, {3.706737150070327*^9, 
   3.706737202825635*^9}, {3.706737270484042*^9, 3.706737368462406*^9}, 
   3.70678076938723*^9, 3.706791458715754*^9, {3.706791497971066*^9, 
   3.7067915171550913`*^9}},ExpressionUUID->"d7670fdc-4134-4164-9325-\
7d4ce9ee8dc4"],

Cell["\<\
The SplitInfo property gives us a description of what would happen if we \
folded the entire model everywhere that it intersected the fold line. Often, \
though, we will only want to fold a subset of the model. MakeSplitGraph2D \
puts the splitting information in a form that will be relatively easy to \
visualize and construct a subset that describes just the part of the model \
that we want to fold.\
\>", "Text",
 CellChangeTimes->{{3.7067260736546926`*^9, 3.7067261774723887`*^9}, {
   3.706726209704813*^9, 3.706726226509523*^9}, {3.706737381517411*^9, 
   3.706737389223943*^9}, 3.706780523602799*^9, 3.706780688825324*^9, {
   3.70678083537918*^9, 3.706780869843436*^9}, {3.706791537788005*^9, 
   3.70679155924653*^9}},ExpressionUUID->"04fc5f8a-0b19-4f10-8815-\
7e7b8ecc7f32"],

Cell[TextData[{
 "See above for the structure of the SplitInfo property. Note that if an edge \
is represented in ",
 StyleBox["esinfo",
  FontSlant->"Italic"],
 ", that is a guarantee that its endpoints are not in ",
 StyleBox["vfinfo",
  FontSlant->"Italic"],
 ", and vice-versa. Similarly, if an edge is represented in ",
 StyleBox["efinfo",
  FontSlant->"Italic"],
 ", that is a guarantee that any face incident to that edge is not in ",
 StyleBox["fsinfo",
  FontSlant->"Italic"],
 " and vice-versa."
}], "Text",
 CellChangeTimes->{{3.706725194146278*^9, 3.706725227244634*^9}, 
   3.706725417631723*^9, 3.706730659869533*^9, {3.706730740709787*^9, 
   3.7067307808361273`*^9}, 3.706730838880992*^9, 3.706730873890057*^9, {
   3.706791579933094*^9, 
   3.70679158778006*^9}},ExpressionUUID->"22136731-01b4-4cec-be71-\
e5595025a092"],

Cell["\<\
We also rely on the behavior that faces are non-concave, so that a face \
contains exactly 0 or 2 split elements (vertices or edges). If, for some \
reason this condition isn\[CloseCurlyQuote]t satisfied, we detect it and \
bail, rather than trying to forge onward and make things worse.\
\>", "Text",
 CellChangeTimes->{{3.706728008033609*^9, 3.706728068324142*^9}, {
  3.706728114304881*^9, 3.706728140768054*^9}, {3.706737434451002*^9, 
  3.706737462825394*^9}},ExpressionUUID->"a7df8441-c9e9-46a3-b95c-\
11d6476bf7b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSplitGraph2D", "::", "badsplit"}], 
   "=", "\"\<MakeSplitGraph2D failed to split face `1` based on vfinfo=`2`, \
esinfo=`3`. Intersection list is flist=`4`\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.706727408807975*^9, 3.706727476996554*^9}, 
   3.706730663942867*^9, 3.706730840041885*^9, {3.706780523621134*^9, 
   3.70678052363661*^9}, {3.706780688839599*^9, 3.706780688849*^9}, {
   3.706791611816975*^9, 3.706791611832767*^9}, {3.706874357090856*^9, 
   3.7068743774348593`*^9}},
 CellLabel->
  "In[1375]:=",ExpressionUUID->"e5cb3cb9-5a1b-4b66-88a4-ab49becb789c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeSplitGraph2D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PtOnLineTolerance", "\[Rule]", 
     RowBox[{"(", 
      RowBox[{"PtOnLineTolerance", "/.", 
       RowBox[{"Options", "[", "PtOnLineQ", "]"}]}], ")"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.706710748343236*^9, 3.706710792717568*^9}, {
   3.706719439600387*^9, 3.706719477261733*^9}, {3.706719511223061*^9, 
   3.706719542832306*^9}, 3.706719597813456*^9, 3.7067805236518188`*^9, 
   3.706780688862844*^9, 3.706791611846211*^9},
 CellLabel->
  "In[1376]:=",ExpressionUUID->"1d52925a-d684-48dc-bd50-090fc25b6ca6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSplitGraph2D", "[", 
   RowBox[{"tobj_TObj", ",", 
    RowBox[{"{", 
     RowBox[{"p_List", ",", "r_List"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tol", ",", "vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo", ",", 
      "flist", ",", "verts2d", ",", "edges", ",", "faces", ",", "fei", ",", 
      "r0", ",", "d0", ",", "tpair"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"PtOnLineTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSplitGraph2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph2D", ",", "TPlaneGraph"}], "}"}], ",", 
       "MakeSplitGraph2D"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", "edges", ",", "faces", ",", "fei"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices2D", ",", "Edges", ",", "Faces", ",", "FaceEdgeIncidence"}],
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"vertices", " ", "on", " ", "fold", " ", "line"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vfinfo", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"PtOnLineQ", "[", 
          RowBox[{
           RowBox[{
           "verts2d", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "r"}], "}"}], ",", "opts"}], "]"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"vfinfo", ",", "i"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "verts2d", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edges", " ", "on", " ", "fold", " ", "line", " ", 
       RowBox[{"(", 
        RowBox[{
        "has", " ", "both", " ", "vertices", " ", "on", " ", "fold", " ", 
         "line"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"efinfo", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ContainsAll", "[", 
          RowBox[{"vfinfo", ",", 
           RowBox[{
           "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
          "]"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"efinfo", ",", "i"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edges", " ", "split", " ", "by", " ", "fold", " ", "line"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"esinfo", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"DisjointQ", "[", 
          RowBox[{"vfinfo", ",", 
           RowBox[{
           "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r0", ",", "d0", ",", "tpair"}], "}"}], "=", 
           RowBox[{"LineSegmentMedialInfo", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"p", ",", 
               RowBox[{"p", "+", "r"}]}], "}"}], ",", 
             RowBox[{"verts2d", "\[LeftDoubleBracket]", 
              RowBox[{
              "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               "\[RightDoubleBracket]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "d0"}], "\[LessEqual]", "tol"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"esinfo", ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{
                "tpair", "\[LeftDoubleBracket]", "2", 
                 "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"faces", " ", "split", " ", "by", " ", "fold", " ", "line"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fsinfo", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "If", " ", "any", " ", "face", " ", "edge", " ", "is", " ", "on", " ",
          "the", " ", "fold", " ", "line"}], ",", " ", 
        RowBox[{
        "no", " ", "need", " ", "to", " ", "consider", " ", "further"}]}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"IntersectingQ", "[", 
           RowBox[{
            RowBox[{
            "fei", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
             "efinfo"}], "]"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"flist", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"vfinfo", ",", 
              RowBox[{"faces", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], "]"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"flist", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"faces", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], 
               "}"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "faces", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"First", "/@", "esinfo"}], ",", 
              RowBox[{"fei", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], "]"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"flist", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"fei", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], 
               "}"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "fei", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"ignore", " ", "faces", " ", "that", " ", 
          RowBox[{"don", "'"}], "t", " ", "hit", " ", "the", " ", "fold", " ",
           "line", " ", "anywhere"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "flist", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "ignore", " ", "faces", " ", "that", " ", "hit", " ", "the", " ", 
          "fold", " ", "line", " ", "at", " ", "only", " ", "one", " ", 
          "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "flist", "]"}], "\[Equal]", "1"}], "&&", 
           RowBox[{
            RowBox[{"flist", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "\[Equal]", 
            "0"}]}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "faces", " ", "that", " ", "hit", " ", "the", " ", "fold", " ", 
          "line", " ", "at", " ", "two", " ", "places", " ", "should", " ", 
          "be", " ", "split"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "flist", "]"}], "\[Equal]", "2"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"fsinfo", ",", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", "i", "}"}], ",", "flist"}], "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"otherwise", ",", " ", 
            RowBox[{
            "bad", " ", "number", " ", "of", " ", "intersections", " ", 
             "with", " ", "face"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"MakeSplitGraph2D", "::", "badsplit"}], ",", "i", ",", 
             "vfinfo", ",", "esinfo", ",", "flist"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "faces", "]"}]}], "}"}]}], "]"}], ";", 
     RowBox[{"AddClassTo", "[", 
      RowBox[{"tobj", ",", "TSplitGraph2D", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SplitFoldLine", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"p", ",", "r"}], "}"}]}], ",", 
         RowBox[{"SplitInfo", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo"}], 
           "}"}]}]}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
