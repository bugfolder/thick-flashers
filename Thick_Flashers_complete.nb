Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bb0", ",", "dd0", ",", "bb1", ",", "u", ",", "v", ",", "bb", ",", 
      "ctds", ",", "dd", ",", "ss", ",", "cc", ",", "ccc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb0", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "#"}]}], "}"}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dd0", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], " ", 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<solution\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directrix", "\[Rule]", "bb0"}], ",", 
          RowBox[{"Director", "\[Rule]", "dd0"}]}], "}"}], "//", 
        "PrettyParameters"}], "//", "ColumnForm"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bb1", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bb0", "[", "u", "]"}], "+", 
         RowBox[{"u", " ", 
          RowBox[{"dd0", "[", "u", "]"}]}]}], ",", "u"}], "]"}]}], ";", 
