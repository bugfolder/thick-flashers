Cell[BoxData[
 RowBox[{
  RowBox[{"GetValues", "[", 
   RowBox[{"tobj_TObj", ",", " ", "properties_List", ",", "opts___"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "cp", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cp", "=", 
      RowBox[{
       RowBox[{"AssertProperties", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
