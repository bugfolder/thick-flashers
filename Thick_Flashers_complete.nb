Cell[TextData[{
 "AddPropertyTo",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rule",
  FontSlant->"Italic"],
 "] adds the specified properties to ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", replacing any preexisting property of the same name or adding a new one \
if it didn\[CloseCurlyQuote]t exist, and returning the modified TObj."
}], "Text",
 CellChangeTimes->{{3.592406310763799*^9, 3.59240638332439*^9}, {
   3.5926769069491167`*^9, 3.592676935409321*^9}, 
   3.592676981729466*^9},ExpressionUUID->"227994e1-5aaa-4791-a1b2-\
e688d0f335a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddPropertyTo", "[", 
   RowBox[{"tobj_TObj", ",", " ", "rule_Rule"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"GetAllProperties", "[", "tobj", "]"}], ",", 
      RowBox[{"First", "[", "rule", "]"}]}], "]"}], ",", 
    RowBox[{"ReplacePropertyIn", "[", 
     RowBox[{"tobj", ",", "rule"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"TObj", "[", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"GetAllRules", "[", "tobj", "]"}], ",", "rule"}], "]"}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.592406384852723*^9, 3.592406476879039*^9}, {
   3.592406524031966*^9, 3.5924066011940107`*^9}, {3.592406728034501*^9, 
   3.592406739716507*^9}, {3.5924067790164948`*^9, 3.592406789167246*^9}, {
   3.592435730819805*^9, 3.592435730887865*^9}, 3.592670433423382*^9, 
   3.592670629359157*^9, 3.592670763768903*^9, 3.592671026310098*^9, 
   3.592671066802301*^9, 3.5926769817619543`*^9, 3.592681707724187*^9, 
   3.592707720958765*^9, 3.628786726553801*^9, 3.628786793874023*^9},
 CellLabel->
  "In[967]:=",ExpressionUUID->"e909a082-8928-4b3d-9411-3de81364c021"],

