Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ff", ",", "\[Gamma]", ",", "rrr", ",", "rrl", ",", "t", ",", "t0", ",", 
      "th"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", "0.05"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"90", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rrl", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationZMatrix3D", "[", "t", "]"}], ".", 
         RowBox[{"RotationYMatrix3D", "[", 
          RowBox[{"\[Gamma]", "/", "2"}], "]"}], ".", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], ",", "t"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rrr", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationZMatrix3D", "[", "t", "]"}], ".", 
         RowBox[{"RotationYMatrix3D", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]"}], "/", "2"}], "]"}], ".", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", "t"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"t0", "=", 
      RowBox[{"\[Pi]", "/", "4"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"th", "=", 
      RowBox[{"Thickness", "[", ".02", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Styled3DAxes", "[", 
          RowBox[{".5", ",", ".5", ",", ".5"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"StyledCurvedFold", "[", 
             RowBox[{"ff", ",", 
              RowBox[{"{", 
               RowBox[{"rrl", ",", "rrr"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"FoldLineStyle", "\[Rule]", 
               RowBox[{"{", 
