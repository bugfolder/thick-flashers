   3.911645080551575*^9}, {3.911645115009653*^9, 3.911645119431991*^9}, {
   3.911646491008168*^9, 3.9116465552566547`*^9}, {3.911898819033116*^9, 
   3.911898846529307*^9}, 3.9119027500313253`*^9},
 CellLabel->
  "In[4463]:=",ExpressionUUID->"1edba141-54a9-4eaa-a158-e0b7bac72e67"],

