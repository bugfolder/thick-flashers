 RowBox[{
  RowBox[{
   RowBox[{"TPlaneGraphAssigned", "::", "usage"}], 
   "=", "\"\<TPlaneGraphAssigned is a TObj class that represents a full plane \
graph with crease assignment on its edges.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5924720013634353`*^9, 3.592472009398618*^9}, {
  3.592828725691881*^9, 3.592828725759369*^9}, {3.592828956112447*^9, 
