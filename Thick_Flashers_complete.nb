           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Pi]", "/", "2"}], "-", "sr"}], ")"}], ",", 
           RowBox[{"rr", "[", "nn", "]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "nn", "]"}]}], ",", 
        RowBox[{"rr", "[", "nn", "]"}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Pi]", "/", "2"}], "-", "sl"}], ")"}]}], ",", 
           RowBox[{"rr", "[", "nn", "]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "nn", "]"}]}], ",", 
        RowBox[{"-", 
         RowBox[{"rr", "[", "nn", "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"aa", "[", "nn", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{"sr", ",", 
           RowBox[{
            RowBox[{"gg", "[", "nn", "]"}], "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "nn", "]"}]}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"-", "sl"}], ",", 
           RowBox[{
            RowBox[{"gg", "[", "nn", "]"}], "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "nn", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"-", "sl"}], ",", 
           RowBox[{
            RowBox[{"gg", "[", "nn", "]"}], "\[LeftDoubleBracket]", "4", 
            "\[RightDoubleBracket]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "nn", "]"}]}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{"sr", ",", 
           RowBox[{
