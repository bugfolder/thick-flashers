Cell[TextData[{
 "FlasherFFPointDiscreteHeight[",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 "] returns the discrete height of folded form point ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"e94a6f07-6131-48bb-a517-33dfaf6dd91b"],
 " for panel height parameter ",
 StyleBox["h",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.555716133179361*^9, 3.555716168112652*^9}, {
   3.5557657163742437`*^9, 3.555765721246245*^9}, {3.555854312553204*^9, 
   3.555854312632848*^9}, 3.719918733401883*^9, {3.71994511408716*^9, 
   3.719945123335409*^9}},ExpressionUUID->"d47b2dab-91c1-4d17-af20-\
86d74e319ed9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherFFPointDiscreteHeight", "[", 
   RowBox[{"i_", ",", "j_", ",", "h_"}], "]"}], ":=", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"i", "+", "1"}], ",", "j"}], "]"}], "-", "h"}], ",", 
      RowBox[{"2", "h"}], ",", "0"}], "]"}], "-", "h"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555716084256577*^9, 3.555716128446104*^9}, 
   3.55571627981317*^9, {3.555718642171098*^9, 3.555718661672017*^9}, {
   3.555854312733348*^9, 3.555854312901633*^9}, 3.71991873342199*^9},
 CellLabel->
  "In[4148]:=",ExpressionUUID->"76c4e12a-cdc8-4e39-9416-6bc95b8c89c1"],

