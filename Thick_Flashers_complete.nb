Cell["\<\
The number of DOF should be a total of 5 times that number; 2 for each vertex \
in the CP, 3 for each vertex in the FF.\
\>", "Text",
 CellChangeTimes->{{3.555771471457031*^9, 3.555771493766718*^9}, {
  3.555771525637067*^9, 3.555771526245195*^9}, {3.719857497674104*^9, 
  3.719857506076819*^9}},ExpressionUUID->"c2e7723d-4746-4c56-83b0-\
95a86b0a4ad5"],

Cell[TextData[{
 "Look at a couple different examples. (You can plug in different numbers for \
",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["m",
  FontSlant->"Italic"],
 ".) Un-Hold the expression to see the results."
}], "Text",
 CellChangeTimes->{{3.555780366217576*^9, 3.55578039086336*^9}, {
   3.5557810345176687`*^9, 3.555781047533003*^9}, {3.555854084331894*^9, 
   3.555854090378948*^9}, 3.555854320742929*^9, 
   3.5558543572390013`*^9},ExpressionUUID->"55d5d2ba-9bac-42d6-b8c6-\
b553dd3a3d59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "pp", ",", 
      RowBox[{"r", "=", "3"}], ",", 
      RowBox[{"h", "=", "3"}], ",", 
      RowBox[{"m", "=", "4"}], ",", 
      RowBox[{"dr", "=", ".05"}], ",", "vars", ",", "nverts", ",", "nisos", ",",
       "nxys", ",", "ndwns", ",", "norrngs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vars", "=", 
      RowBox[{"FlasherVars", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"FlasherLabeledSector", "[", 
            RowBox[{"\"\<p\>\"", ",", "p", ",", "r", ",", "h", ",", "m"}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"FlasherLines", "[", 
            RowBox[{"p", ",", "r", ",", "h", ",", "m"}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"FlasherLabeledSector", "[", 
            RowBox[{"\"\<pp\>\"", ",", "pp", ",", "r", ",", "h", ",", "m"}], 
            "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{"FlasherLines", "[", 
            RowBox[{"pp", ",", "r", ",", "h", ",", "m"}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "/.", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"FlasherDefaultCPRules", "[", 
           RowBox[{"p", ",", "m"}], "]"}], ",", 
          RowBox[{"FlasherDefaultFFRules", "[", 
           RowBox[{"pp", ",", "h", ",", "m", ",", "0.1"}], "]"}]}], "]"}]}], 
       "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"FlasherFirstSectorVertices", "[", 
        RowBox[{
         StyleBox["p",
          FontSlant->"Italic"], ",", 
         StyleBox["r",
          FontSlant->"Italic"], ",", 
         StyleBox["h",
          FontSlant->"Italic"]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<number of vertices = \>\"", ",", "nverts"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<number of variables = \>\"", ",", 
       RowBox[{"5", "*", "nverts"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<number of CP position constraints = \>\"", ",", "1"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nisos", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"FlasherIsometryFns", "[", 
        RowBox[{"vars", ",", "r", ",", "h", ",", "m"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<number of all isometries = \>\"", ",", "nisos"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"nxys", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"FlasherXYFns", "[", 
        RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "dr"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<number of xyfns = \>\"", ",", "nxys"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"norrngs", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"FlasherOuterRingFns", "[", 
        RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<number of norrngs = \>\"", ",", "norrngs"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Remaining DOF = \>\"", ",", 
       RowBox[{
        RowBox[{"5", " ", "*", " ", "nverts"}], "-", 
        RowBox[{"(", 
         RowBox[{"1", "+", "nisos", "+", "nxys", "+", "norrngs"}], ")"}]}]}], 
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.555776517568284*^9, 3.555776601034932*^9}, {
   3.555778085724073*^9, 3.555778093089365*^9}, 3.555778597842293*^9, {
   3.5557804055077477`*^9, 3.555780658018581*^9}, {3.555780691049909*^9, 
   3.555780708163638*^9}, {3.55578074794128*^9, 3.555780765615761*^9}, {
   3.555780832947494*^9, 3.555780839451567*^9}, {3.555780911305724*^9, 
   3.555780929725707*^9}, 3.555836140622653*^9, {3.5558361733276157`*^9, 
   3.5558362114444637`*^9}, {3.555836691750062*^9, 3.555836699420397*^9}, {
   3.555838016645243*^9, 3.555838065548055*^9}, 3.555838670738811*^9, {
   3.555839069362913*^9, 3.555839137852723*^9}, {3.55585075490362*^9, 
   3.555850762303646*^9}, {3.555854075449531*^9, 3.555854076478142*^9}, {
   3.55585432083222*^9, 3.5558543213677483`*^9}, {3.555854357333428*^9, 
   3.555854357800995*^9}, 3.555956406966607*^9, 3.719848622876974*^9, 
   3.719848673813662*^9, 3.719854079922917*^9, 3.719856536139572*^9, 
   3.7198568970575657`*^9, 3.719857153027629*^9, {3.719866525929103*^9, 
   3.719866525955192*^9}, 3.719868815370842*^9, 3.7198695773613653`*^9, 
   3.719869806295288*^9, {3.719930872855731*^9, 3.719930887926399*^9}, {
   3.719930931290227*^9, 3.719930977149598*^9}, {3.719934191105796*^9, 
   3.7199342033096952`*^9}, {3.719936124495943*^9, 3.719936134135377*^9}, {
   3.719936360649754*^9, 3.719936360806028*^9}, {3.719938570547217*^9, 
   3.7199385891348753`*^9}, 3.7199463916143503`*^9, {3.825679487728024*^9, 
   3.825679488649378*^9}, {3.911861316586847*^9, 3.911861330210703*^9}, 
   3.911879914108885*^9, {3.9118800968907127`*^9, 3.911880097214842*^9}},
 CellLabel->
  "In[4179]:=",ExpressionUUID->"8f17eac1-3318-4309-bafc-b73947881371"]
