 CellLabel->
  "In[3189]:=",ExpressionUUID->"f71e6ed1-c35e-4271-adff-0d6c02c7d1d6"],

Cell[TextData[{
 "TwoUniformPatch[",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns the lattice patch for the tiling."
}], "Text",
 CellChangeTimes->{{3.631272464753629*^9, 
