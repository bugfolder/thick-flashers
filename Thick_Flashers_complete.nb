Cell[CellGroupData[{

Cell["TRotationalPot constructors", "Subsubsection",
 CellChangeTimes->{{3.592683276076127*^9, 3.592683283452841*^9}, 
   3.592829369366856*^9},ExpressionUUID->"d75bdaef-5c75-4983-9e47-\
c78a5b0a3756"],

Cell["\<\
There are enough parameters here that we won\[CloseCurlyQuote]t create a \
general constructor. Instead, we\[CloseCurlyQuote]ll construct each \
individual type of pot in its own Make function.\
\>", "Text",
 CellChangeTimes->{{3.592683542144761*^9, 
  3.592683598179092*^9}},ExpressionUUID->"5504b575-f5c2-4a22-a6ca-\
faf20657162c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeUniPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MinimumAngle, CreasePatternBoundary, CircleDivisions, ",
 "FoldedFormGapSize, Options[Graphics], Options[Graphics3D]",
 "\n\t(option values) Default, Circle"
}], "Subsubsection",
 CellChangeTimes->{{3.456360555899096*^9, 3.456360578210458*^9}, {
   3.456511258480364*^9, 3.4565112777482862`*^9}, {3.526731058107636*^9, 
   3.5267310654749117`*^9}, {3.526762549569682*^9, 3.52676255072178*^9}, 
   3.592127768865018*^9, {3.593044936800232*^9, 
   3.593044943908537*^9}},ExpressionUUID->"081ae1f5-31a7-4483-8480-\
4aa35967a96b"],

Cell[TextData[{
 "MakeUniPot[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of 2D points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " and a rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " and creates a crease pattern and folded form of a rotational flanged pot \
and returns a TObj containing CreasePattern, ",
 "FoldedForm2D",
 ", and the properties above. Options are:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"MinimumAngle", "\[Rule]", "mb"}], TraditionalForm]],
  ExpressionUUID->"2912a4c7-fb78-4234-adc9-08ae4993aa20"],
 ", where ",
 StyleBox["mb",
  FontSlant->"Italic"],
 " is the minimum bend angle at which we add a horizontal crease along the \
side.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"CreasePatternBoundary", "\[Rule]", 
    RowBox[{"Default", " ", "|", " ", "Circle"}]}], TraditionalForm]],
  ExpressionUUID->"bbf57547-922a-41b3-827e-cb008170de36"],
 ", specifying whether to use a circular cut line or regular polygonal cut \
line. Note that this only affects the crease pattern, not the folded form.\n\t\
",
 Cell[BoxData[
  FormBox[
   RowBox[{"CircleDivisions", "\[Rule]", "n"}], TraditionalForm]],
  ExpressionUUID->"01b5d355-1e0d-4298-8ea0-1bf413f82885"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the numbe of divisions to use within a single wedge of the pattern.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"FoldedFormGapSize", "\[Rule]", "gap"}], TraditionalForm]],
  ExpressionUUID->"07509a13-5419-42dd-be02-8cda5efc3b7f"],
 ", where ",
 StyleBox["gap",
  FontSlant->"Italic"],
 " is the proportional reduction in panel width that introduces a gap into \
the flanges in the folded form. This is only a tweak for rendering of the \
folded form; the crease pattern is not affected by this parameter."
}], "Text",
 CellChangeTimes->{{3.456356366824768*^9, 3.456356480780696*^9}, {
   3.456357875049625*^9, 3.456357882948633*^9}, {3.456358004628619*^9, 
   3.456358052075944*^9}, 3.4563605796995564`*^9, 3.456397776557507*^9, {
   3.4563979444478283`*^9, 3.456397951693556*^9}, {3.456398499828661*^9, 
   3.456398591723905*^9}, {3.526730747665512*^9, 3.526730756161202*^9}, {
   3.526747256793701*^9, 3.526747273936509*^9}, {3.592127776838883*^9, 
   3.592127829210259*^9}, 3.59217059016337*^9, 3.592435765755062*^9, 
   3.629847505195421*^9},ExpressionUUID->"d25845c4-c9e7-4a01-a8a1-\
978933f22c5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CreasePatternBoundary", "::", "usage"}], 
   "=", "\"\<CreasePatternBoundary is an option to MakeUniPot that specifies \
the shape of boundary to put on the crease pattern.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5921276872634697`*^9, 3.592127720186857*^9}, 
   3.592127883640028*^9},
 CellLabel->
  "In[3537]:=",ExpressionUUID->"121e9eb1-479c-4aaf-bd39-4f5985fcdc2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FoldedFormGapSize", "::", "usage"}], 
   "=", "\"\<FoldedFormGapSize is an option to MakeUniPot that specifies the \
size of the flange gap to use in the folded form\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5921276872634697`*^9, 3.592127720186857*^9}, {
  3.592127848203586*^9, 3.5921278780246*^9}},
 CellLabel->
  "In[3538]:=",ExpressionUUID->"2032ea17-4be0-4aed-bfe4-a7b40b98379a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeUniPot", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MinimumAngle", "\[Rule]", 
      RowBox[{"10.", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"CreasePatternBoundary", "\[Rule]", "Default"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"CircleDivisions", "\[Rule]", "10"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FoldedFormGapSize", "\[Rule]", "0.05"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456356554910956*^9, 3.456356573084632*^9}, {
   3.45635731355683*^9, 3.456357357633705*^9}, {3.4563578217357187`*^9, 
   3.456357823509667*^9}, {3.45635799031857*^9, 3.456358001126463*^9}, 
   3.456397767646634*^9, {3.456398579295109*^9, 3.456398585397861*^9}, 
   3.456399284681927*^9, 3.456399373620479*^9, {3.456400123025455*^9, 
   3.456400123887846*^9}, {3.5267620784341993`*^9, 3.52676208513019*^9}, 
   3.526762358898555*^9, 3.592127767731683*^9},
 CellLabel->
  "In[3539]:=",ExpressionUUID->"b780cfed-dd68-41aa-9308-4cb9d59bb107"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeUniPot", "[", 
   RowBox[{"pts_", ",", "m_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mb", ",", "cb", ",", "cd", ",", "gs", ",", "\[Phi]", ",", "sf", ",", 
      "cf", ",", "tf", ",", "sh", ",", "ps", ",", "fb", ",", "cs", ",", "xt", 
      ",", "\[Zeta]", ",", "wt", ",", "wr", ",", "rt", ",", "vt", ",", "st", ",",
       "dl", ",", "an", ",", "fbfn", ",", " ", "a2", ",", "b2", ",", "c2", ",",
       "d2", ",", "e2", ",", "f2", ",", "g2", ",", "cpw", ",", "cpsw", ",", 
      "cp", ",", "a3", ",", "b3", ",", "c3", ",", "d3", ",", "e3", ",", "f3", 
      ",", "g3", ",", "pfn", ",", "ffw", ",", "ffsw", ",", "ff"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mb", "=", 
      RowBox[{
       RowBox[{"MinimumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeUniPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cb", "=", 
      RowBox[{
       RowBox[{"CreasePatternBoundary", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeUniPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cd", "=", 
      RowBox[{
       RowBox[{"CircleDivisions", "/.", 
