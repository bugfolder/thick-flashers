Cell[CellGroupData[{

Cell[TextData[{
 "MakeDihedralsFromSectorsAndMinorDihedral",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", 
       SubscriptBox["\[Alpha]", "2"], ",", 
       SubscriptBox["\[Alpha]", "3"], ",", 
       SubscriptBox["\[Alpha]", "4"]}], "}"}], ",", 
     SubscriptBox["\[Gamma]", "1"], ",", " ", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "f1e0301e-6d93-45c0-b2ad-dd268edf5ae5"],
 "\n\t(options) AllowSelfIntersection"
}], "Subsubsection",
 CellChangeTimes->{{3.594758310994151*^9, 3.594758365809675*^9}, {
  3.59475851499326*^9, 3.594758515374041*^9}, {3.594759719461534*^9, 
  3.594759736391721*^9}, {3.594763035545971*^9, 3.594763112172603*^9}, {
  3.59476315796979*^9, 3.594763175642277*^9}, {3.594763212429682*^9, 
  3.594763215636161*^9}, {3.59476330233543*^9, 3.594763309134095*^9}, {
  3.594766311944967*^9, 3.594766336643174*^9}, {3.594766375189825*^9, 
  3.594766378234681*^9}, {3.6172425931788664`*^9, 3.6172425965492067`*^9}, {
  3.617258177361968*^9, 3.617258177670443*^9}, {3.6173196906266813`*^9, 
  3.617319715053645*^9}},ExpressionUUID->"ea9b6514-3ced-4947-870f-\
a58ef8dc88d6"],

Cell[TextData[{
 "MakeDihedralsFromSectorsAndMinorDihedral",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], ",", 
       SubscriptBox["\[Alpha]", "2"], ",", 
       SubscriptBox["\[Alpha]", "3"], ",", 
       SubscriptBox["\[Alpha]", "4"]}], "}"}], ",", 
     SubscriptBox["\[Gamma]", "1"], ",", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "6fdadf4b-a43e-41c2-a4f0-aadaf65e157b"],
 " takes a minor-first list of sector angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", " ", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", " ", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "6a2db9e2-adcf-4517-9466-445b02ebeb60"],
 " and minor dihedral angle ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "4fc7030b-e255-4347-a1fd-ea09e953759e"],
 " (so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "3"], TraditionalForm]],ExpressionUUID->
  "cb92e4f3-d828-403b-8470-45534986af5e"],
 " (the angle across from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "906b4f69-c8a6-4cfb-b678-f94a5113d39f"],
 ") will be of the opposite type as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "bd79c962-a87b-410d-9ee9-ddb867e56204"],
 ") and returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], ",", " ", 
     SubscriptBox["\[Gamma]", "2"], ",", 
     SubscriptBox["\[Gamma]", "3"], ",", 
     SubscriptBox["\[Gamma]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "06a96d2e-ba05-4f17-b5b2-b85a32151ec9"],
 " of the four dihedral angles. Enter a positive value for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "fbb20d1f-1b2e-41d5-bfc0-7cd5b7def0d3"],
 " to specify a valley fold, a negative value to specify a mountain fold. The \
signs of the two major creases ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "b1392bdd-9299-4b70-a400-a650055a2875"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "4"], TraditionalForm]],ExpressionUUID->
  "01c4a87e-8cd0-43a3-8fbc-f4a340cc0660"],
 " are determined from the sizes of the sector angles. If the vertex is \
straight-major ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Alpha]", "1"], "+", 
      SubscriptBox["\[Alpha]", "4"]}], "\[Equal]", 
     RowBox[{
      SubscriptBox["\[Alpha]", "2"], "+", 
      SubscriptBox["\[Alpha]", "3"]}], "\[Equal]", "\[Pi]"}]}], 
   TraditionalForm]],ExpressionUUID->"4c53898b-cf20-4df6-870f-cc45605aad6f"],
 "), an error is generated because the dihedrals are uncoupled so there is \
not a unique solution for the major fold angles. Options are:\n\t\
AllowSelfIntersection \[Rule] True | False, whether to return values that \
specify a self-intersecting vertex. If False, an error is thrown."
}], "Text",
 CellChangeTimes->{{3.594758375336089*^9, 3.594758519650736*^9}, {
   3.594759749306047*^9, 3.5947598430696287`*^9}, {3.594763131753046*^9, 
   3.594763178130497*^9}, 3.594763227643448*^9, {3.594763312894845*^9, 
   3.5947633139900837`*^9}, {3.594763383934276*^9, 3.5947635110062*^9}, 
   3.594766383636855*^9, {3.594770851393937*^9, 3.594770964864376*^9}, {
   3.5948264632319193`*^9, 3.59482651070327*^9}, {3.594826584938858*^9, 
   3.594826597220851*^9}, {3.59499339354926*^9, 3.594993408948897*^9}, {
   3.616623488851992*^9, 3.61662349605676*^9}, 3.61731572721885*^9, {
   3.61731972151807*^9, 3.617319774930402*^9}, {3.6173199847488737`*^9, 
   3.617319985386848*^9}, {3.617435143649443*^9, 3.617435213045691*^9}, {
   3.617435288692243*^9, 3.617435290252919*^9}, {3.617435474769435*^9, 
   3.617435477626636*^9}},ExpressionUUID->"fecd641f-5db3-45ab-950f-\
86c2e0c9307f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AllowSelfIntersection", "::", "usage"}], 
   "=", "\"\<AllowSelfIntersection is an option to \
MakeDihedralsFromSectorsAndMinorDihedral that specifies whether to return \
successfully if the resulting vertex is self-intersecting, i.e., beyond the \
binding condition.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.6173198186541853`*^9, 3.617319870430367*^9}},
 CellLabel->
  "In[2295]:=",ExpressionUUID->"61e1460f-34af-4f59-b219-ee18fc573bfa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "::", "baddev"}], 
   "=", "\"\<Sector angles `1` are not developable.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59475968901122*^9, 3.594759704856963*^9}, {
   3.594759867269778*^9, 3.594759871880265*^9}, 3.594763181700273*^9, 
   3.594763218686259*^9, {3.594763319224173*^9, 3.594763320655517*^9}, 
   3.594766363117977*^9, {3.617320092297941*^9, 3.617320100423593*^9}},
 CellLabel->
  "In[2296]:=",ExpressionUUID->"091e5363-1f0c-4ec5-9cb5-c09a70fa9e1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "::", "strtmjr"}], 
   "=", "\"\<Cannot compute dihedrals because sector angles `1` are \
straight-major.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59475968901122*^9, 3.594759704856963*^9}, {
   3.594759867269778*^9, 3.594759871880265*^9}, {3.594760004524878*^9, 
   3.5947600167649097`*^9}, 3.5947631844367943`*^9, 3.5947632239991713`*^9, 
   3.5947633259861193`*^9, 3.59476636334748*^9, {3.594826442151005*^9, 
   3.594826458084951*^9}, {3.6173204118315396`*^9, 3.617320447370632*^9}},
 CellLabel->
  "In[2297]:=",ExpressionUUID->"ef17c1a6-420d-4c81-b7a0-177089eaf491"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "::", "maxangle"}], 
   "=", "\"\<Dihedral angle `1` is beyond the maximum angle `2` for sector \
angles `3`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59475968901122*^9, 3.594759704856963*^9}, {
   3.594759867269778*^9, 3.594759871880265*^9}, 3.594763181700273*^9, 
   3.594763218686259*^9, {3.594763319224173*^9, 3.594763320655517*^9}, 
   3.594766363117977*^9, {3.617320092297941*^9, 3.617320100423593*^9}, {
   3.61732021527859*^9, 3.617320285540596*^9}},
 CellLabel->
  "In[2298]:=",ExpressionUUID->"700ceda1-59cf-499a-aa32-319e4cbe95f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
