Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BorderlessCreasePatternToPlaneGraphAssigned", "::", "badborder"}],
    "=", "\"\<The computed border does not appear to be a single closed loop.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.533672005458214*^9, 3.533672034343336*^9}, 
   3.533681522196728*^9, 3.592468182049268*^9, 3.592828731172118*^9, 
