        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"RecoverCurve3DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]", ",", "\[Tau]", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "ci", ",", "ti", ",", "bi"}], "}"}]}], "]"}]}], ";",
