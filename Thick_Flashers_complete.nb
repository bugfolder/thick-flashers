Cell[CellGroupData[{

Cell[TextData[{
 "HatTransform[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["angle",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hat",
  FontSlant->"Italic"],
 "]\nHatTransform[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hats",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.7360781417023582`*^9, 3.736078153910443*^9}, {
  3.7360782719801693`*^9, 
  3.73607827662747*^9}},ExpressionUUID->"8c1d3e0c-0626-4137-8b09-\
6fbcded10218"],

Cell[TextData[{
 "HatTransform[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["angle",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hat",
  FontSlant->"Italic"],
 "] takes an expression and tries to hat-transform the variable angle by \
making the appropriate substitutions for trigonometric expressions of angle."
}], "Text",
 CellChangeTimes->{{3.736078167347075*^9, 3.736078248675879*^9}, {
  3.7360782838463306`*^9, 3.736078304645869*^9}, {3.736078548008733*^9, 
  3.736078554619622*^9}},ExpressionUUID->"1ab1b840-40ec-4b5e-b2a6-\
2a43af4e5b61"],

Cell["\<\
Note that we attempt all of the clean transformations before we resort to the \
ArcTan function. For best results, TrigExpand all functions before applying \
HatTransform, then you can Simplify afterwards.\
\>", "Text",
 CellChangeTimes->{{3.7360785569694843`*^9, 3.736078584041346*^9}, {
  3.736078660406686*^9, 
  3.736078679087133*^9}},ExpressionUUID->"9df3f2e3-e997-4467-9f85-\
da2036bfcc76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatTransform", "[", 
   RowBox[{"expr_", ",", "\[Xi]_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"expr", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[Xi]", "]"}], "\[Rule]", 
        FractionBox[
         RowBox[{"2", "x"}], 
         RowBox[{"1", "+", 
          SuperscriptBox["x", "2"]}]]}], ",", 
       RowBox[{
        RowBox[{"Csc", "[", "\[Xi]", "]"}], "\[Rule]", 
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox["x", "2"]}], 
         RowBox[{"2", "x"}]]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Xi]", "]"}], "\[Rule]", 
        FractionBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}], 
         RowBox[{"1", "+", 
          SuperscriptBox["x", "2"]}]]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "\[Xi]", "]"}], "\[Rule]", 
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox["x", "2"]}], 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]}], ",", 
       RowBox[{
        RowBox[{"Tan", "[", "\[Xi]", "]"}], "\[Rule]", 
        FractionBox[
         RowBox[{"2", "x"}], 
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]}], ",", 
       RowBox[{
        RowBox[{"Cot", "[", "\[Xi]", "]"}], "\[Rule]", 
        FractionBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}], 
         RowBox[{"2", "x"}]]}], ",", 
       RowBox[{
        RowBox[{"Tan", "[", 
         FractionBox["\[Xi]", "2"], "]"}], "\[Rule]", "x"}]}], "}"}]}], ")"}],
    "/.", 
   RowBox[{"{", 
    RowBox[{"\[Xi]", "\[Rule]", 
     RowBox[{"2", " ", 
      RowBox[{"ArcTan", "[", "x", "]"}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.7360783058521137`*^9, 3.736078429458213*^9}, {
  3.736078493785413*^9, 3.736078541820475*^9}, {3.7360792746030397`*^9, 
  3.736079313437984*^9}},
 CellLabel->
  "In[746]:=",ExpressionUUID->"308d5aea-2740-4d89-8ff6-720714984b9a"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.736078591137182*^9, 
  3.7360785929624047`*^9}},ExpressionUUID->"6d0031fb-bb98-4356-aae6-\
71a566188412"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatTransform", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Xi]", "]"}], ",", 
      RowBox[{"Cos", "[", "\[Xi]", "]"}], ",", 
      RowBox[{"Tan", "[", "\[Xi]", "]"}], ",", 
      RowBox[{"Cot", "[", 
       RowBox[{"\[Xi]", "+", "\[Phi]"}], "]"}]}], "}"}], ",", "\[Xi]", ",", 
    "x"}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.736078594667968*^9, 3.736078645486538*^9}},
 CellLabel->
  "In[747]:=",ExpressionUUID->"4f5f57dc-1047-4c81-9cc9-1b7e7339a538"],

Cell[TextData[{
 "HatTransform[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hats",
  FontSlant->"Italic"],
 "] takes an expression and tries to hat-transform all of the variables in \
list ",
 StyleBox["angles",
  FontSlant->"Italic"],
 " by making the appropriate substitutions for trigonometric expressions."
}], "Text",
 CellChangeTimes->{{3.736078167347075*^9, 3.736078248675879*^9}, {
  3.736078934518662*^9, 
  3.736078934963357*^9}},ExpressionUUID->"c12c38d0-986d-4e9e-8075-\
37feb1045748"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatTransform", "[", 
   RowBox[{"expr_", ",", "angles_List", ",", "hats_List"}], "]"}], ":=", 
  RowBox[{"Fold", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"HatTransform", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
       RowBox[{"#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}],
       "]"}], "&"}], ",", "expr", ",", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"angles", ",", "hats"}], "}"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.736078256781039*^9, 3.736078267752934*^9}, {
  3.736078683774061*^9, 3.7360787097329807`*^9}, {3.736078761648862*^9, 
  3.736078834138943*^9}, {3.736078906415867*^9, 3.736078907227973*^9}},
 CellLabel->
  "In[748]:=",ExpressionUUID->"b77f9c3c-aa19-40a9-b2f4-5a47cf707d4c"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.736078591137182*^9, 
  3.7360785929624047`*^9}},ExpressionUUID->"a7e70d94-fa50-4727-beca-\
3fa6f5ca4845"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatTransform", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Xi]1", "]"}], ",", 
      RowBox[{"Cos", "[", "\[Xi]2", "]"}], ",", 
      RowBox[{"Tan", "[", "\[Xi]3", "]"}], ",", 
      RowBox[{"Cot", "[", 
       RowBox[{"\[Xi]2", "+", "\[Phi]"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Xi]1", ",", "\[Xi]2", ",", "\[Xi]3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.736078594667968*^9, 3.736078645486538*^9}, {
   3.736078853194874*^9, 3.736078888008593*^9}, 3.736184185314663*^9},
 CellLabel->
  "In[749]:=",ExpressionUUID->"aa6c96cf-dd0e-44b6-b9e8-2ca8da6cef74"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Triangle hat value from sides", "Subsection",
 CellChangeTimes->{{3.595719339158187*^9, 3.595719346004105*^9}, {
  3.595719822981251*^9, 3.595719825379757*^9}, {3.595720763317491*^9, 
  3.595720774556071*^9}, {3.595803243751709*^9, 
  3.595803245062684*^9}},ExpressionUUID->"45fbd923-f488-4f7d-ae3f-\
ec7f0c1c0a7d"],

Cell[CellGroupData[{

Cell[TextData[{
 "TriangleHatA[",
 StyleBox["a, b, c",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595719351685194*^9, 3.595719365441308*^9}, {
  3.595719592780892*^9, 3.5957196146737*^9}, {3.595801796694992*^9, 
  3.59580179784484*^9}},ExpressionUUID->"1b5b58e9-d1e4-4ba5-9c1c-\
6c465a2beff0"],

Cell[TextData[{
 "TriangleHatA[",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "] returns the hat at angle A of a triangle with sides ",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["c",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.595719377617557*^9, 3.59571941327957*^9}, {
  3.595719453710682*^9, 
  3.595719454092681*^9}},ExpressionUUID->"d7f64de9-b0c8-4766-92af-\
7ad581a29749"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleHatA", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", "b", "-", "c"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"a", "-", "b", "+", "c"}], ")"}]}], 
   SqrtBox[
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"a", "-", "b", "-", "c"}], ")"}]}], " ", 
     RowBox[{"(", 
      RowBox[{"a", "+", "b", "-", "c"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"a", "-", "b", "+", "c"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]]]}]], "Input",
 CellChangeTimes->{{3.595719414976273*^9, 3.595719433103641*^9}},
 CellLabel->
  "In[750]:=",ExpressionUUID->"1d443c3a-b775-4e5e-afef-03dae89edb8c"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["2D rotation hats from vertices", "Subsection",
 CellChangeTimes->{{3.779202189146604*^9, 3.77920222893049*^9}, {
  3.779204558040176*^9, 
  3.779204568296132*^9}},ExpressionUUID->"66bb9011-0cfb-427f-a7f8-\
e84c9c91c604"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.77920457205628*^9, 
  3.779204572568488*^9}},ExpressionUUID->"14b9948a-06f1-4601-b0da-\
8ad1742e4c81"],

Cell["\<\
Just as we can compute rotation angles from points, we can also compute \
rotation hats from points using vector relationships.\
\>", "Text",
 CellChangeTimes->{{3.779202211602128*^9, 3.779202276634778*^9}, {
  3.779204198886124*^9, 
  3.7792042072616796`*^9}},ExpressionUUID->"03a220f2-bf76-41c4-8a6e-\
76ec9bb1d870"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RotationHat[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 "]\nRotationHat[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]\nRotationHat[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.779204148376387*^9, 3.779204177349704*^9}, 
   3.779204429567156*^9},ExpressionUUID->"c38142bd-e0cb-4f98-9f3d-\
c5bb1f6d2624"],

Cell[TextData[{
 "RotationHat[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 "] returns the tangent of half of the rotation angle from ",
 StyleBox["r1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["r2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.779204435934678*^9, 
  3.779204455902791*^9}},ExpressionUUID->"1edc03d9-187b-4912-aa99-\
c23cd3043134"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationHat", "[", 
   RowBox[{"r1_List", ",", "r2_List"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{
     RowBox[{"Mag", "[", "r1", "]"}], 
     RowBox[{"Mag", "[", "r2", "]"}]}], "-", 
    RowBox[{"r1", ".", "r2"}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", "r1"}], ")"}], ".", 
    "r2"}]]}]], "Input",
 CellChangeTimes->{{3.7792022810322866`*^9, 3.7792022917150383`*^9}, {
  3.779204215574605*^9, 3.779204265534886*^9}},
 CellLabel->
  "In[751]:=",ExpressionUUID->"d01a19b2-4bfa-492b-bac2-02c912a6b3ed"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.779204277685811*^9, 
  3.77920427945467*^9}},ExpressionUUID->"f657d595-5d64-4640-b9d2-\
46d5f2192778"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r1", ",", "r2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r1", "=", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r2", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RotationHat", "[", 
       RowBox[{"r1", ",", "r2"}], "]"}], "//", "Simplify"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.779204280423443*^9, 3.779204354030927*^9}},
 CellLabel->
  "In[752]:=",ExpressionUUID->"c468105b-e885-418c-9053-d3a9a3916965"],

Cell[TextData[{
 "RotationHat[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] returns the tangent of half of the rotation angle from ",
 StyleBox["q",
  FontSlant->"Italic"],
 " to ",
 StyleBox["r",
  FontSlant->"Italic"],
 " about ",
 StyleBox["p",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.779204473329977*^9, 
  3.779204492863698*^9}},ExpressionUUID->"dae21bd4-7d9b-44dd-bf96-\
ce684ae43269"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationHat", "[", 
   RowBox[{"p_List", ",", "q_List", ",", "r_List"}], "]"}], ":=", 
  RowBox[{"RotationHat", "[", 
   RowBox[{
    RowBox[{"q", "-", "p"}], ",", 
    RowBox[{"r", "-", "p"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.779204358999888*^9, 3.7792043802470016`*^9}},
 CellLabel->
  "In[753]:=",ExpressionUUID->"001b49c8-a288-49bb-a361-ab3ba27fd7de"],

Cell[TextData[{
 "RotationHat[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}] returns the tangent of half of the rotation angle between the vector \
from ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2",
  FontSlant->"Italic"],
 " and the vector from ",
 StyleBox["q1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q2.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.779204473329977*^9, 
  3.779204542319761*^9}},ExpressionUUID->"77526f05-6c44-4f28-a8eb-\
c0433e9962a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationHat", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_List", ",", "p2_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q1_List", ",", "q2_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"RotationHat", "[", 
   RowBox[{
    RowBox[{"p2", "-", "p1"}], ",", 
    RowBox[{"q2", "-", "q1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.77920438573629*^9, 3.779204414015386*^9}},
 CellLabel->
  "In[754]:=",ExpressionUUID->"3237b0f1-f11c-4fee-a448-76ff4d25a8d8"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["2D rotation matrices from hats", "Subsection",
 CellChangeTimes->{{3.595713083095001*^9, 3.595713085724348*^9}, {
  3.5958032786767406`*^9, 3.5958032876757708`*^9}, {3.736635597362941*^9, 
  3.73663562216269*^9}},ExpressionUUID->"b4a4a521-ba38-40e6-9583-\
488a7c19011e"],

Cell[CellGroupData[{

Cell[TextData[{
 "HatRotationDenominator[",
 StyleBox["h",
  FontSlant->"Italic"],
 "]\nHatRotationMatrix2DNumerator[",
 StyleBox["h",
  FontSlant->"Italic"],
 "]\nHatRotationMatrix2DDenominator[",
 StyleBox["h",
  FontSlant->"Italic"],
 "]\nHatRotationMatrix2D[",
 StyleBox["h",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.59561061977444*^9, 3.595610626172397*^9}, {
  3.595610792756367*^9, 3.5956108167431507`*^9}, {3.59561107056036*^9, 
  3.595611079982498*^9}, {3.595611244552321*^9, 
  3.5956112546542053`*^9}},ExpressionUUID->"72ee0467-ddf6-4645-bbc3-\
de3adf4c7652"],

Cell[TextData[{
 "HatRotationDenominator[",
 StyleBox["h",
  FontSlant->"Italic"],
 "] returns the denominator of all of the fractions in any hat rotation \
matrix (either 2D or 3D)."
}], "Text",
 CellChangeTimes->{{3.59561102772393*^9, 3.595611041968994*^9}, {
  3.595611277699339*^9, 
  3.595611302272431*^9}},ExpressionUUID->"92921d1a-ed11-4475-89e7-\
4e93f943a018"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatRotationDenominator", "[", "h_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    SuperscriptBox["h", "2"]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.595611043192595*^9, 3.5956110598502903`*^9}},
 CellLabel->
  "In[755]:=",ExpressionUUID->"f8a1186e-43fa-4787-9eab-2280017e741f"],

Cell["\<\
It is useful to split hat rotation matrices up into a polynomial numerator \
matrix (which, in general, is noncommutative), and a polynomial denominator \
(which is diagonal, and so therefore commutes with everything). So the hat \
rotation matrix is the product of the numerator times the inverse of the \
denominator.\
\>", "Text",
 CellChangeTimes->{{3.59552817369357*^9, 3.5955282115939693`*^9}, {
  3.595528244856963*^9, 3.595528256143252*^9}, {3.5955283083948717`*^9, 
  3.5955283134118*^9}, {3.595528416752006*^9, 3.595528448003197*^9}, {
  3.595611344457578*^9, 
  3.595611360148706*^9}},ExpressionUUID->"d9e7f9f0-f255-47d9-aee0-\
fc1c8cccd3af"],

Cell[TextData[{
 "HatRotationMatrix2DNumerator[",
 StyleBox["h",
  FontSlant->"Italic"],
 "] returns the numerator of the 2D hat rotation matrix, i.e., with the \
denominator term factored out."
}], "Text",
 CellChangeTimes->{{3.595611386204602*^9, 
  3.5956114204646597`*^9}},ExpressionUUID->"13b7e533-21f3-4f46-a52f-\
42a4eb02ce44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatRotationMatrix2DNumerator", "[", "h_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{"2", "h"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["h", "2"]}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"-", "s"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "c"}], "}"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595610678559673*^9, 3.595610735580934*^9}, {
  3.595610899598402*^9, 3.595610911155891*^9}},
 CellLabel->
  "In[756]:=",ExpressionUUID->"b134dd7a-0977-4e23-9684-bf365a5bdab0"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.595610742686535*^9, 3.59561075113211*^9}, 
   3.595610916986064*^9},ExpressionUUID->"efeeefef-ba57-49a7-a459-\
88ef0f4a65b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatRotationMatrix2DNumerator", "[", "h", "]"}], " ", "//", " ", 
   "MatrixForm"}], " ", "//", " ", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.595610759771957*^9, 3.595610774167046*^9}, {
  3.595610858271667*^9, 3.595610873212537*^9}, {3.595610934341426*^9, 
  3.595610935490337*^9}, {3.595611748755559*^9, 3.595611770195229*^9}},
 CellLabel->
  "In[757]:=",ExpressionUUID->"bfc1aac3-0c35-4992-9aa7-d5daa290a6bd"],

Cell[TextData[{
 "HatRotationMatrix2DDenominator[",
 StyleBox["h",
  FontSlant->"Italic"],
 "] returns the product of the denominator and Identity[2]."
}], "Text",
 CellChangeTimes->{{3.5956110996537232`*^9, 
  3.595611124779491*^9}},ExpressionUUID->"1bda9901-367a-4ac0-8932-\
f661f55811be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatRotationMatrix2DDenominator", "[", "h_", "]"}], " ", ":=", " ", 
  
  RowBox[{
   RowBox[{"HatRotationDenominator", "[", "h", "]"}], " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.59561113232724*^9, 3.595611154629471*^9}, 
   3.595611748876994*^9, {3.595611833899385*^9, 3.595611833938128*^9}},
 CellLabel->
  "In[758]:=",ExpressionUUID->"8b27e171-3d78-414a-83e7-485e104722d2"],

Cell["Example", "Text",
 CellChangeTimes->{{3.595611176235311*^9, 
  3.595611177031954*^9}},ExpressionUUID->"a3703640-b4ab-4612-959b-\
e9b9751c724b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatRotationMatrix2DDenominator", "[", "h", "]"}], " ", "//", " ", 
   "MatrixForm"}], " ", "//", " ", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.595610759771957*^9, 3.595610774167046*^9}, {
   3.595610858271667*^9, 3.595610873212537*^9}, {3.595610934341426*^9, 
   3.595610935490337*^9}, {3.595611189126777*^9, 3.595611190292345*^9}, 
   3.595611748877697*^9, {3.595611842933831*^9, 3.595611842972868*^9}},
 CellLabel->
  "In[759]:=",ExpressionUUID->"5762d7df-d280-4857-905b-408e458cde61"],

Cell[TextData[{
 "HatRotationMatrix2D[",
 StyleBox["h",
  FontSlant->"Italic"],
 "] gives the 2D rotation matrix for a counterclockwise rotation in the plane \
by the angle whose hat transformation is ",
 StyleBox["h",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.595610628245209*^9, 
  3.595610669913006*^9}},ExpressionUUID->"9131dfd9-c1a7-4ade-9118-\
92831a242ccd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatRotationMatrix2D", "[", "h_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"HatRotationMatrix2DNumerator", "[", "h", "]"}], "/", 
   RowBox[{"HatRotationDenominator", "[", "h", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.595610678559673*^9, 3.595610735580934*^9}, {
   3.595611442402694*^9, 3.5956114585783453`*^9}, 3.595611748879361*^9, {
   3.595611852540449*^9, 3.59561185257956*^9}},
 CellLabel->
  "In[760]:=",ExpressionUUID->"5a94a8e4-20f3-42f5-a779-a3efccb7562b"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.595610742686535*^9, 3.59561075113211*^9}, 
   3.595610916986064*^9},ExpressionUUID->"1a6928f4-a2f3-44a6-a950-\
a8b35e3841b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatRotationMatrix2D", "[", "h", "]"}], " ", "//", " ", 
   "MatrixForm"}], " ", "//", " ", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.595610759771957*^9, 3.595610774167046*^9}, {
   3.595610858271667*^9, 3.595610873212537*^9}, 3.595611748880052*^9, {
   3.595611855919419*^9, 3.595611855959173*^9}},
 CellLabel->
  "In[761]:=",ExpressionUUID->"77cb1271-4df3-48bc-859e-a471bfa830b5"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Consistency conditions from hats", "Subsection",
 CellChangeTimes->{{3.595713083095001*^9, 3.595713085724348*^9}, {
  3.5958032786767406`*^9, 3.5958032876757708`*^9}, {3.736634408436317*^9, 
  3.7366344107946243`*^9}},ExpressionUUID->"86a4083c-b5c3-4df7-901d-\
55b366d9d2b0"],

Cell[CellGroupData[{

Cell[TextData[{
 "HatRotationConditions2D[",
 StyleBox["hats, opts",
  FontSlant->"Italic"],
 "]\n\t(options) HatExcess, HatMatrixSplit, HatMatrixSign"
}], "Subsubsection",
 CellChangeTimes->{{3.595611881981205*^9, 3.595611925560431*^9}, {
   3.59561203019345*^9, 3.595612034112474*^9}, {3.5956125976681557`*^9, 
   3.5956125984762783`*^9}, {3.595670038729101*^9, 3.595670039772171*^9}, 
   3.5956701912299833`*^9, {3.595670276141635*^9, 3.5956702863732367`*^9}, 
   3.5956861944748287`*^9, {3.595690958928091*^9, 3.595690962875196*^9}, {
   3.5957000912478743`*^9, 3.595700118691189*^9}, 3.5957001737528467`*^9, {
   3.5960230423846407`*^9, 3.5960230624546757`*^9}, {3.5960303489783382`*^9, 
   3.596030351655395*^9}},ExpressionUUID->"08c2d1d1-e460-4236-ad93-\
2111952a2c09"],

Cell[TextData[{
 "HatRotationConditions2D[",
 StyleBox["hats, opts",
  FontSlant->"Italic"],
 "] returns the 2x2 matrix whose entries must be zero in order for the sum of \
the angles whose hat transforms are ",
 StyleBox["hats",
  FontSlant->"Italic"],
 " around the vertex to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]", " ", "n"}], TraditionalForm]],ExpressionUUID->
  "dac52782-bef7-4d09-9bd0-38fb82fbdd2c"],
 " for some integer ",
 StyleBox["n",
  FontSlant->"Italic"],
 ". Options are:\n\tHatExcess \[Rule] excess, where ",
 StyleBox["excess",
  FontSlant->"Italic"],
 " is the hat transformation of the excess angle, or 0 for a developable \
vertex.\n\tHatMatrixSplit \[Rule] Automatic | None | ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where n is the number of matrices on the left and the remainder are on \
the right. None puts all of the numerators on the left. Automatic splits them \
as evenly as possible between left and right. In either case, denominators \
are cleared from either side so that each entry is a polynomial.\n\t\
HatMatrixSign \[Rule] 1 | -1, changes the sign of the RHS of the expression."
}], "Text",
 CellChangeTimes->{{3.595611934877542*^9, 3.595611964333376*^9}, {
   3.595612011691249*^9, 3.595612082429765*^9}, {3.595612112636605*^9, 
   3.595612138642123*^9}, 3.59561260392588*^9, {3.59567004282092*^9, 
   3.595670043539588*^9}, {3.595670199289804*^9, 3.595670206729295*^9}, {
   3.5956702633024077`*^9, 3.595670315050634*^9}, {3.595670522887664*^9, 
   3.595670573364615*^9}, {3.595685640764491*^9, 3.595685642009242*^9}, {
   3.595686042134006*^9, 3.595686080798849*^9}, 3.5956861945905643`*^9, {
   3.595686258582822*^9, 3.595686260267554*^9}, {3.5956909656384277`*^9, 
   3.595691033451261*^9}, {3.595700101359112*^9, 3.5957001013594837`*^9}, {
   3.59570017387473*^9, 3.5957002333309793`*^9}, {3.595702266218487*^9, 
   3.595702266721407*^9}, {3.5957037478508887`*^9, 3.595703785471561*^9}, {
   3.595703835819635*^9, 3.595703836667088*^9}, {3.596023478139489*^9, 
   3.596023481979347*^9}, {3.596030359031723*^9, 
   3.596030397758*^9}},ExpressionUUID->"564b9518-c027-4073-8816-a177be8312b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatExcess", "::", " ", "usage"}], 
   "=", "\"\<HatExcess is an option to HatRotationConditions2D that specifies \
the excess angle on the product of rotation matrices.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.596030405380525*^9, 3.596030428917262*^9}, {
  3.596030518431774*^9, 3.596030545865627*^9}},
 CellLabel->
  "In[762]:=",ExpressionUUID->"00da8f5b-5c4d-4e81-b77b-4f5595809966"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatMatrixSplit", "::", "usage"}], 
   "=", "\"\<HatMatrixSplit is an option to HatRotationConditions2D that \
specifies to split the hat rotation matrix product into two parts.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.595670760779736*^9, 3.595670824283865*^9}, 
   3.595686194757125*^9, 3.59570017415987*^9, {3.595700254711432*^9, 
   3.5957002554837437`*^9}},
 CellLabel->
  "In[763]:=",ExpressionUUID->"4c5ba250-9375-414d-92be-a48593ab7fd4"],

Cell["\<\
HatMatrixSign is an option to HatRotationConditions2D that specifies the sign \
of the RHS of the equation. HatMatrixSign \[Rule] 1 is used for vertex \
developability; HatMatrixSign \[Rule] \[Dash]1 is used for face planarity.\
\>", "Text",
 CellChangeTimes->{{3.596023386349153*^9, 
  3.596023461524984*^9}},ExpressionUUID->"0614d4f0-ac59-4191-af5b-\
436b1efa703b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatMatrixSign", "::", "usage"}], 
   "=", "\"\<HatMatrixSign is an option to HatRotationConditions2D that \
specifies the sign of the RHS of the equation.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595703801781225*^9, 3.595703826533897*^9}},
 CellLabel->
  "In[764]:=",ExpressionUUID->"fd18c6ed-c330-4ce0-9fbc-e095d7d63187"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "HatRotationConditions2D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HatExcess", "\[Rule]", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HatMatrixSplit", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"HatMatrixSign", "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.595670719640242*^9, 3.595670753649089*^9}, 
   3.59568619478012*^9, 3.595700174411302*^9, {3.595703788241143*^9, 
   3.5957037953602247`*^9}, {3.596030554942293*^9, 3.596030558444879*^9}},
 CellLabel->
  "In[765]:=",ExpressionUUID->"24a251c7-1105-4014-860e-433df348f948"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HatRotationConditions2D", "::", "badsplit"}], 
   "=", "\"\<The split distance `1` must be between 0 and `2` or None or \
Automatic.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.595686457129794*^9, 3.595686462764573*^9}, {
   3.595686555952579*^9, 3.595686561222593*^9}, {3.595690548868716*^9, 
   3.59569057139565*^9}, 3.595700174659847*^9, {3.5957056794216127`*^9, 
   3.595705680795648*^9}},
 CellLabel->
  "In[766]:=",ExpressionUUID->"b20525cd-e4a2-481d-b9bc-99ad8c4121e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatRotationConditions2D", "[", 
   RowBox[{"hats_List", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "he", ",", "hms", ",", "hsg", ",", "ahats", ",", "nl", ",", "nr", ",", 
      "lhats", ",", "rhats", ",", "lhs", ",", "rhs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"he", "=", 
      RowBox[{
       RowBox[{"HatExcess", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HatRotationConditions2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hms", "=", 
      RowBox[{
       RowBox[{"HatMatrixSplit", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HatRotationConditions2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hsg", "=", 
      RowBox[{
       RowBox[{"HatMatrixSign", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HatRotationConditions2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ahats", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"he", "\[Equal]", "0"}], ",", "hats", ",", 
        RowBox[{"Append", "[", 
         RowBox[{"hats", ",", 
          RowBox[{"-", "he"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nl", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"hms", ",", "\[IndentingNewLine]", "Automatic", ",", 
        RowBox[{"Ceiling", "[", 
         RowBox[{
          RowBox[{"Length", "[", "ahats", "]"}], "/", "2"}], "]"}], ",", 
        "\[IndentingNewLine]", "None", ",", 
        RowBox[{"Length", "[", "ahats", "]"}], ",", "\[IndentingNewLine]", 
        "_", ",", "hms"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nr", "=", 
      RowBox[{
       RowBox[{"Length", "[", "ahats", "]"}], "-", "nl"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"nl", "<", "0"}], "||", 
        RowBox[{"nr", "<", "0"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"HatRotationConditions2D", "::", "badsplit"}], ",", "hms", ",", 
          RowBox[{"Length", "[", "ahats", "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lhats", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"ahats", ",", "nl"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhats", "=", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"-", "ahats"}], ",", 
        RowBox[{"-", "nr"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lhs", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Times", "@@", 
         RowBox[{"(", 
          RowBox[{"HatRotationDenominator", "/@", "rhats"}], ")"}]}], ")"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nl", "\[NotEqual]", "0"}], ",", 
         RowBox[{"Dot", "@@", 
          RowBox[{"(", 
           RowBox[{"HatRotationMatrix2DNumerator", "/@", "lhats"}], ")"}]}], ",", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rhs", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Times", "@@", 
         RowBox[{"(", 
          RowBox[{"HatRotationDenominator", "/@", "lhats"}], ")"}]}], ")"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nr", "\[NotEqual]", "0"}], ",", 
         RowBox[{"Dot", "@@", 
          RowBox[{"(", 
           RowBox[{"HatRotationMatrix2DNumerator", "/@", "rhats"}], ")"}]}], ",", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lhs", "-", 
      RowBox[{"hsg", " ", "rhs"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595612141092373*^9, 3.595612305947384*^9}, {
   3.59561235540265*^9, 3.595612355904353*^9}, {3.5956123945569077`*^9, 
   3.595612434394558*^9}, {3.595612468050631*^9, 3.59561246836974*^9}, 
   3.5956126065770683`*^9, {3.595670098575136*^9, 3.595670143585453*^9}, {
   3.595670323879985*^9, 3.595670519663597*^9}, 3.595670604257268*^9, {
   3.59567082826495*^9, 3.595670923402644*^9}, {3.595670956280272*^9, 
   3.595671033621707*^9}, {3.595671281329068*^9, 3.5956712897744083`*^9}, {
   3.595671366850873*^9, 3.595671369279563*^9}, {3.595671408812577*^9, 
   3.595671411469811*^9}, {3.595685756456114*^9, 3.5956857601492233`*^9}, {
   3.595685856944412*^9, 3.595685857577956*^9}, {3.595685912878681*^9, 
   3.595685962931395*^9}, {3.595686194820211*^9, 3.595686194835082*^9}, {
   3.595686611655972*^9, 3.595686671132123*^9}, {3.595690522767843*^9, 
