   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".8", ",", ".9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", ".1"}], ",", ".7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RenderTile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "PolygonTwistTile", ",", "verts", ",", ".2", ",", ".2", ",", 
          RowBox[{"90", "\[Degree]"}], ",", "True", ",", 
          RowBox[{"{", 
           RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], "}"}], ",", 
        "TGraphAssigned"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Num sides = \>\"", ",", 
       RowBox[{"PolygonTwistNumSides", "[", "tobj", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], 
      "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
