      RowBox[{"{", 
       RowBox[{"2", ",", "0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b2", ",", "d2", ",", "bb2", ",", "dd2", ",", "f", ",", "ff"}],
        "}"}], "=", 
      RowBox[{"FoldSurfaceToCone", "[", 
       RowBox[{"b1", ",", "d1", ",", "bb1", ",", "dd1", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "b2i", ",", "bb2i"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"b1", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"f", "[", "s", "]"}], "-", 
                 RowBox[{"b1", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"f", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"b2", "[", "s", "]"}], "-", 
                 RowBox[{"f", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"b1", ",", 
