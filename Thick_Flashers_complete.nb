Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SpaceCurveFirstCreaseAngle", "::", "usage"}], 
   "=", "\"\<SpaceCurveFirstCreaseAngle is an option to MakeTSpaceCurve that \
