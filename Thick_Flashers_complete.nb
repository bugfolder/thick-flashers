Cell[BoxData[
 RowBox[{
  RowBox[{"MakeMajorConnectedUnitChain", "[", 
   RowBox[{"sectorangles_List", ",", " ", "type_", ",", "n_", ",", " ", 
    RowBox[{"{", 
     RowBox[{"wr_", ",", "wl_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"MakeTLinearChain", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{"sectorangles", ",", 
      RowBox[{"{", 
       RowBox[{"n", "+", "1"}], "}"}]}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{"1", ",", 
      RowBox[{"{", "n", "}"}]}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{"type", ",", 
      RowBox[{"{", "n", "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"wr", ",", "wl"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.617404737314915*^9, 3.617404749631256*^9}, {
  3.617404823454975*^9, 3.617404876957756*^9}},
