Cell[CellGroupData[{

Cell["Spherical ellipses", "Subsection",
 CellChangeTimes->{{3.65029709702872*^9, 3.650297105939936*^9}, {
  3.650297147385418*^9, 
  3.650297152345593*^9}},ExpressionUUID->"e87be202-bf80-4641-92b5-\
870520d9b8bd"],

Cell[CellGroupData[{

Cell[TextData[{
 "SphericalEllipseVector3D[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", \[Alpha], \[Beta]] [FIX EXAMPLE]"
}], "Subsubsection",
 CellChangeTimes->{{3.593818848421905*^9, 3.593818885649861*^9}, 
   3.593993677186795*^9, {3.701379233521413*^9, 3.70137924177747*^9}, 
   3.70137946676567*^9, {3.7013824549973917`*^9, 
   3.701382458959684*^9}},ExpressionUUID->"eeb2be55-7fc7-4359-9e9f-\
cd94421e3090"],

Cell[TextData[{
 "SphericalEllipseVector3D",
 "[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", \[Alpha], \[Beta]] takes three points that define two consecutive folds \
with a total of \[Alpha] angle of paper between them, and it returns a unit \
vector, parameterized on \[Beta]\[Element]{-2\[Pi],2\[Pi]] that traces out \
every possible position of the fold vector in the wedge between the two \
lines. That is, the returned point lies on the spherical ellipse centered on \
p2 whose focii are the intersections of the lines from p2 to p1 and p3 with \
the unit sphere centered on p2. See the example."
}], "Text",
 CellChangeTimes->{{3.593817418538672*^9, 3.593817522160996*^9}, {
   3.593817558022583*^9, 3.593817562678526*^9}, {3.593818886720969*^9, 
   3.593818888201006*^9}, {3.5938189242792864`*^9, 3.593818995539091*^9}, 
   3.59399367732274*^9},ExpressionUUID->"db50b186-f8a5-4243-ad3f-\
66d3554a2e65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalEllipseVector3D", "[", 
   RowBox[{"p1_", ",", "p2_", ",", "p3_", ",", "\[Alpha]_", ",", "\[Beta]_"}],
    "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bx", ",", "by", ",", "bz", ",", "e", ",", "A", ",", "B", ",", "y", ",", 
      "z", ",", "x"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"a", " ", "local", " ", "coordinate", " ", "system"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bx", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p1", "+", "p3"}], ")"}], "/", "2"}], "-", "p2"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"bz", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p1", "-", "p2"}], ")"}], "\[Cross]", 
        RowBox[{"(", 
         RowBox[{"p3", "-", "p2"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"by", "=", 
      RowBox[{"bz", "\[Cross]", "bx"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", 
      RowBox[{"ArcCos", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p1", "-", "p2"}], ")"}], ".", "bx"}], "/", 
        RowBox[{"Mag", "[", 
         RowBox[{"(", 
          RowBox[{"p1", "-", "p2"}], ")"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", "eccentricity", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Alpha]", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"B", "=", 
      RowBox[{
       SqrtBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", "e"}], "]"}], "-", 
           RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], ")"}], "/", "2"}]], " ", 
       RowBox[{"Sec", "[", "e", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"A", " ", 
       RowBox[{"Cos", "[", "\[Beta]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"B", " ", 
       RowBox[{"Sin", "[", "\[Beta]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      SqrtBox[
       RowBox[{"1", "-", 
        SuperscriptBox["y", "2"], "-", 
        SuperscriptBox["z", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x", " ", "bx"}], " ", "+", " ", 
      RowBox[{"y", " ", "by"}], " ", "+", " ", 
      RowBox[{"z", " ", "bz"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.593817373723803*^9, 3.593817413178617*^9}, {
   3.593817874174134*^9, 3.593817971932462*^9}, {3.593818104361023*^9, 
   3.593818194212262*^9}, {3.59381826379777*^9, 3.593818345648932*^9}, {
   3.593818449613197*^9, 3.5938184583727617`*^9}, 3.593818779525834*^9, {
   3.593818890687117*^9, 3.593818891663853*^9}, {3.5938200106893272`*^9, 
   3.59382001748971*^9}, 3.593993677343897*^9, {3.701092755752408*^9, 
   3.701092756426182*^9}},
 CellLabel->
  "In[627]:=",ExpressionUUID->"67aac79e-b823-431c-a6e5-a45d644b7086"],

Cell["Example. A manipulable example.", "Text",
 CellChangeTimes->{{3.593818514793189*^9, 3.593818515497384*^9}, {
  3.593820104324459*^9, 
  3.593820108090918*^9}},ExpressionUUID->"58040b97-4519-4477-8a20-\
89b83a2d1d38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DynamicModule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "p3", ",", "amin", ",", "\[Alpha]", ",", "r"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".5"}], ",", 
        RowBox[{"-", "1.5"}], ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p3", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"+", ".4"}], ",", 
        RowBox[{"-", "1.5"}], ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"amin", "=", 
      RowBox[{"OrientedAngle3D", "[", 
       RowBox[{
        RowBox[{"p1", "-", "p2"}], ",", 
        RowBox[{"p3", "-", "p2"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"80.", "\[Degree]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "must", " ", "be", " ", "larger", " ", "than", " ", "the", " ", 
        "minimum", " ", "angle"}], ",", " ", 
       RowBox[{
       "which", " ", "is", " ", "twice", " ", "the", " ", "spherical", " ", 
        "eccentricity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"SphericalEllipseVector3D", "[", 
          RowBox[{
          "p1", ",", "p2", ",", "p3", ",", "\[Alpha]", ",", "\[Beta]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Sphere", "[", 
               RowBox[{"p2", ",", "1"}], "]"}], ",", 
              RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Point", "[", "p1", "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<p1\>\"", ",", "p1", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Point", "[", "p2", "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<p2\>\"", ",", "p2", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Point", "[", "p3", "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<p3\>\"", ",", "p3", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "]"}], ",", 
              "Black"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{"p2", ",", "r"}], "}"}], "]"}], ",", "Gray"}], "]"}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{"Append", "[", 
                  RowBox[{
                   RowBox[{"PolygonalEllipseArc3D", "[", 
                    RowBox[{
                    RowBox[{"NormalizeReal", "[", 
                    RowBox[{"p1", "-", "p2"}], "]"}], ",", 
                    RowBox[{"r", "-", "p2"}]}], "]"}], ",", "p2"}], "]"}], 
                 "]"}], ",", 
                RowBox[{"Polygon", "[", 
                 RowBox[{"Append", "[", 
                  RowBox[{
                   RowBox[{"PolygonalEllipseArc3D", "[", 
                    RowBox[{
                    RowBox[{"NormalizeReal", "[", 
                    RowBox[{"p3", "-", "p2"}], "]"}], ",", 
                    RowBox[{"r", "-", "p2"}]}], "]"}], ",", "p2"}], "]"}], 
                 "]"}]}], "}"}], ",", 
              RowBox[{"Lighter", "[", "Red", "]"}], ",", 
              RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"PolygonalEllipseArc3D", "[", 
                  RowBox[{
                   RowBox[{"NormalizeReal", "[", 
                    RowBox[{"p1", "-", "p2"}], "]"}], ",", 
                   RowBox[{"r", "-", "p2"}]}], "]"}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"Line", "[", 
                 RowBox[{"PolygonalEllipseArc3D", "[", 
                  RowBox[{
                   RowBox[{"NormalizeReal", "[", 
                    RowBox[{"p3", "-", "p2"}], "]"}], ",", 
                   RowBox[{"r", "-", "p2"}]}], "]"}], "]"}]}], 
               "\[IndentingNewLine]", "}"}], ",", "Red"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "r", "]"}], ",", 
              RowBox[{"Darker", "[", "Red", "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"PlotLabel", "\[Rule]", 
           RowBox[{"\"\<Min angle (\[Degree]) = \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"amin", "/", "\[Degree]"}], "]"}]}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.731515678368829*^9, 3.731515694643296*^9}, {
  3.731515725666746*^9, 3.731515753331338*^9}},
 CellLabel->
  "In[628]:=",ExpressionUUID->"20ae6055-ec24-4fd4-8d36-23207837b9db"]
}, Closed]]
}, Closed]],

