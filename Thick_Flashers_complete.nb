Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSimpleWovenTessellationOld", "[", 
   RowBox[{"tobj_TObj", ",", "inset_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mps", ",", "mbps", ",", "wpar", ",", "sface", ",", "sp", ",", "tobjdef",
       ",", "verts", ",", "edges", ",", "faces", ",", "boundary", ",", 
      "iedges", ",", "dedges", ",", "edgepairs", ",", "twocoloring", ",", "h",
       ",", "insetverts", ",", "facedata", ",", "beq", ",", "d", ",", "dd", ",",
       "makenewvert", ",", "nd", ",", "ndd", ",", "newverts", ",", 
      "newfaceverts", ",", "newboundaryverts", ",", "hdruleff", ",", 
      "newedges", ",", "newtypes", ",", "prevnewvert", ",", "newvert", ",", 
      "nextnewvert", ",", "altnewvert", ",", "prevvalvert", ",", 
      "nextvalvert", ",", "addpleat", ",", "hdrulecp", ",", "tobjout", ",", 
      "vva", ",", "kawaconds", ",", "kawavals", ",", "merit", ",", "eqns", ",",
       "ineqns", ",", "vars", ",", "time", ",", "soln", ",", "newvertsff"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "MakeSimpleWovenTessellationOld"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mps", "=", 
      RowBox[{
       RowBox[{"MinimumPleatSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellationOld", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"mbps", "=", 
      RowBox[{
       RowBox[{"MinimumBorderPleatSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellationOld", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"wpar", "=", 
      RowBox[{
       RowBox[{"WovenParity", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellationOld", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sface", "=", 
      RowBox[{
       RowBox[{"StationaryFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellationOld", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellationOld", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"build", " ", "the", " ", "full", " ", "primal"}], "-", 
       RowBox[{
       "dual", " ", "graph", " ", "that", " ", "we", " ", "use", " ", "to", " ",
         "define", " ", "the", " ", "woven", " ", "pattern"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tobjdef", "=", 
      RowBox[{
       RowBox[{"AddTPlaneGraphTo", "[", "tobj", "]"}], "//", 
       "AddTPrimalDualGraphTo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "faces", ",", "boundary", ",", "iedges", ",",
         "dedges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobjdef", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "Faces", ",", "BoundaryVertices", ",",
           "InteriorEdges", ",", "DualEdges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<original pattern = \>\"", ",", 
         RowBox[{"GraphGraphics", "[", "tobjdef", "]"}]}], "]"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "edgepairs", " ", "*)"}], "\[IndentingNewLine]", " ", 
     
     RowBox[{"edgepairs", "=", 
      RowBox[{"OrientedInteriorEdgePairs", "[", "tobjdef", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"PrintThis", "[", "edgepairs", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"build", " ", "the", " ", "two"}], "-", "coloring"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"twocoloring", "=", 
      RowBox[{"TwoColorGraph", "[", 
       RowBox[{"tobjdef", ",", 
        RowBox[{"StartFace", "\[Rule]", 
         RowBox[{
          RowBox[{"(", "wpar", ")"}], 
          RowBox[{"(", "sface", ")"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"PrintThis", "[", "twocoloring", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"inset", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"insetverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"InsetPoly", "[", 
         RowBox[{
          RowBox[{
          "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], ",",
           "h"}], "]"}], "&"}], "/@", "faces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<inset polygons = \>\"", ",", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Black", ",", 
               RowBox[{"Point", "/@", "verts"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Red", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Line", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    "verts", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}], "&"}], "/@", "#"}], "]"}], 
                 "&"}], "/@", "edges"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Green", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Line", "[", 
                  RowBox[{"AppendFirst", "[", "#", "]"}], "]"}], "&"}], "/@", 
                "insetverts"}]}], "}"}]}], "}"}], "]"}], "/.", 
          RowBox[{"h", "\[Rule]", "inset"}]}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "new", " ", "vertices", " ", "of", " ", "the", " ", "tessellation"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"facedata", "=", 
      RowBox[{"Transpose", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"RotateRight", "/@", "faces"}], ",", "\[IndentingNewLine]", 
          "faces", ",", "\[IndentingNewLine]", 
          RowBox[{"RotateLeft", "/@", "faces"}], ",", "\[IndentingNewLine]", 
          "insetverts", ",", "\[IndentingNewLine]", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"{", 
                RowBox[{"Length", "[", "#2", "]"}], "}"}]}], "]"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"twocoloring", ",", "faces"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"N", "/@", 
             RowBox[{"NormalizeReal", "/@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                "verts", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}], "-", 
                RowBox[{"verts", "\[LeftDoubleBracket]", 
                 RowBox[{"RotateRight", "[", "#", "]"}], 
                 "\[RightDoubleBracket]"}]}], ")"}]}]}], "&"}], "/@", 
           "faces"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"N", "/@", 
             RowBox[{"NormalizeReal", "/@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"verts", "\[LeftDoubleBracket]", 
                 RowBox[{"RotateLeft", "[", "#", "]"}], 
                 "\[RightDoubleBracket]"}], "-", 
                RowBox[{
                "verts", "\[LeftDoubleBracket]", "#", 
                 "\[RightDoubleBracket]"}]}], ")"}]}]}], "&"}], "/@", 
           "faces"}]}], "\[IndentingNewLine]", "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"beq", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"boundary", ",", "#1"}], "]"}], "&&", 
        RowBox[{"MemberQ", "[", 
         RowBox[{"boundary", ",", "#2"}], "]"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"makenewvert", "[", 
       RowBox[{
       "ip_", ",", "iv_", ",", "in_", ",", "ivert_", ",", "rot_", ",", "ep_", 
        ",", "en_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "csc", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"csc", "=", 
          RowBox[{"1", "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"en", ".", 
             RowBox[{"Rotate90", "[", "ep", "]"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "iv", "}"}], ",", 
           RowBox[{"Which", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"beq", "[", 
               RowBox[{"ip", ",", "iv"}], "]"}], "&&", 
              RowBox[{"beq", "[", 
               RowBox[{"iv", ",", "in"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"newverts", ",", "ivert"}], "]"}], "]"}], ",", "0"}],
               "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"rot", "\[Equal]", "1"}], ",", 
             RowBox[{"Which", "[", " ", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"beq", "[", 
                RowBox[{"ip", ",", "iv"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", 
                    RowBox[{"ivert", "+", 
                    RowBox[{"csc", " ", 
                    RowBox[{"dd", "[", 
                    RowBox[{"++", "ndd"}], "]"}], "ep"}]}]}], "]"}], "]"}], ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", "ivert"}], "]"}], "]"}]}], "}"}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{"beq", "[", 
                RowBox[{"iv", ",", "in"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", 
                    RowBox[{"ivert", "-", 
                    RowBox[{"csc", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"++", "nd"}], "]"}], " ", "en"}]}]}], "]"}], 
                  "]"}], ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", "ivert"}], "]"}], "]"}]}], "}"}], 
               ",", "\[IndentingNewLine]", "True", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", 
                    RowBox[{"ivert", "-", 
                    RowBox[{"csc", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"++", "nd"}], "]"}], " ", "en"}]}]}], "]"}], 
                  "]"}], ",", "0"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"rot", "\[Equal]", 
              RowBox[{"-", "1"}]}], ",", 
             RowBox[{"Which", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"beq", "[", 
                RowBox[{"ip", ",", "iv"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", 
                    RowBox[{"ivert", "+", 
                    RowBox[{"csc", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"++", "nd"}], "]"}], "ep"}]}]}], "]"}], "]"}], ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", "ivert"}], "]"}], "]"}]}], "}"}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{"beq", "[", 
                RowBox[{"iv", ",", "in"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", 
                    RowBox[{"ivert", "-", 
                    RowBox[{"csc", " ", 
                    RowBox[{"dd", "[", 
                    RowBox[{"++", "ndd"}], "]"}], " ", "en"}]}]}], "]"}], 
                  "]"}], ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", "ivert"}], "]"}], "]"}]}], "}"}], 
               ",", "\[IndentingNewLine]", "True", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"newverts", ",", 
                    RowBox[{"ivert", "+", 
                    RowBox[{"csc", " ", 
                    RowBox[{"d", "[", 
                    RowBox[{"++", "nd"}], "]"}], "ep"}]}]}], "]"}], "]"}], ",",
                  "0"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", "True", ",", 
             RowBox[{"Abort", "[", "]"}]}], " ", 
            RowBox[{"(*", " ", 
             RowBox[{"error", "!"}], " ", "*)"}], "\[IndentingNewLine]", 
            "]"}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nd", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ndd", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newfaceverts", "=", 
      RowBox[{"Apply", "[", 
       RowBox[{"makenewvert", ",", "facedata", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newboundaryverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"boundary", ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "]"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"newboundaryverts", ",", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
           "]"}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[NotEqual]",
              "0"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"newboundaryverts", ",", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
             "]"}]}], "]"}]}]}], "]"}], "&"}], "/@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"newfaceverts", ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"hdruleff", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h", "\[Rule]", "inset"}], ",", 
        RowBox[{
         RowBox[{"d", "[", "_", "]"}], "\[Rule]", 
         RowBox[{"0.8", " ", "inset"}]}], ",", 
        RowBox[{
         RowBox[{"dd", "[", "_", "]"}], "\[Rule]", 
         RowBox[{"0.2", " ", "inset"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<new vertices = \>\"", ",", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Black", ",", 
               RowBox[{"Point", "/@", "verts"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Red", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Line", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    "verts", "\[LeftDoubleBracket]", "#", 
                    "\[RightDoubleBracket]"}], "&"}], "/@", "#"}], "]"}], 
                 "&"}], "/@", "edges"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Green", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Line", "[", 
                  RowBox[{"AppendFirst", "[", "#", "]"}], "]"}], "&"}], "/@", 
                "insetverts"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Blue", ",", 
               RowBox[{"Point", "/@", "newverts"}]}], "}"}]}], "}"}], "]"}], "/.",
           "hdruleff"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "new", " ", "edges", " ", "of", " ", "the", " ", "tessellation"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newtypes", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"newtypes", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"beq", "[", 
                RowBox[{
                 RowBox[{"#", "\[LeftDoubleBracket]", 
                  RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"#", "\[LeftDoubleBracket]", 
                  RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}],
                ",", "B", ",", "M"}], "]"}]}], "]"}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"newedges", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}]}],
             "]"}]}], ")"}], "&"}], "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}]}], "&"}], "/@",
       "newfaceverts"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"PrintThis", "[", "newedges", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
