dimensions.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.913984030632537*^9, 3.913984080833194*^9}, 
   3.913984300301947*^9},
 CellLabel->
  "In[4516]:=",ExpressionUUID->"11acb74b-2283-4815-8603-3a59e7360dfe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherPanelSplit", "::", "usage"}], 
   "=", "\"\<FlasherPanelSplit is an option to MakeThickFlasherPanels that \
specifies which quad panels are divided along their diagonals, allowing bends \
at diagonal folds that cross quad panels.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.913296687499219*^9, 3.913296744186372*^9}, {
   3.913460692256574*^9, 3.913460709184188*^9}, 3.917089759823159*^9, {
   3.917089824143089*^9, 3.917089861652822*^9}, {3.917199003873992*^9, 
   3.917199013476343*^9}, 3.9239069330656557`*^9, {3.924459869338382*^9, 
   3.924459902233038*^9}, {3.924469293172027*^9, 3.9244692931733713`*^9}},
 CellLabel->
  "In[4517]:=",ExpressionUUID->"5ac3e21b-30f2-440c-be26-c2e2dd4f2b18"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherPanelMaxBendAngle", "::", "usage"}], 
   "=", "\"\<FlasherPanelMaxBendAngle is an option to MakeThickFlasherPanels \
that specifies the bevel angle allowing bends at diagonal folds that cross \
quad panels.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.913296687499219*^9, 3.913296744186372*^9}, {
   3.913460692256574*^9, 3.913460709184188*^9}, 3.917089759823159*^9, {
   3.917089824143089*^9, 3.917089861652822*^9}, {3.917199003873992*^9, 
   3.917199013476343*^9}, 3.9239069330656557`*^9},
 CellLabel->
  "In[4518]:=",ExpressionUUID->"0675418e-ca03-44cc-b84e-c29fd378ee4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherCentralExtraInset", "::", "usage"}], 
   "=", "\"\<FlasherCentralExtraInset is an option to MakeThickFlasherPanels \
that specifies extra lateral clearance to apply to the central polygon panel.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.913296687499219*^9, 3.913296744186372*^9}, {
   3.913460692256574*^9, 3.913460709184188*^9}, 3.917089759823159*^9, {
   3.917089824143089*^9, 3.917089861652822*^9}, {3.917199003873992*^9, 
   3.917199013476343*^9}, 3.9239069330656557`*^9, {3.924250811567168*^9, 
   3.924250839579866*^9}, {3.924251774708331*^9, 3.924251774709711*^9}},
 CellLabel->
  "In[4519]:=",ExpressionUUID->"a4bd3d6f-ff0b-40c1-aaae-606995aca0f6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeThickFlasherPanels[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PanelClearance, FlasherDeployed, FlasherScale, \
FlasherPanelSplit, FlasherPanelMaxBendAngle, FlasherCentralExtraInset"
}], "Subsubsection",
 CellChangeTimes->{{3.911903147083892*^9, 3.9119031549094667`*^9}, {
   3.911903484847119*^9, 3.911903498072442*^9}, 3.91190357933968*^9, {
   3.911903666661096*^9, 3.9119037014641447`*^9}, {3.911905088306177*^9, 
   3.911905088975287*^9}, {3.911917952381631*^9, 3.911917957254613*^9}, {
   3.913296583347725*^9, 3.913296596220402*^9}, {3.913296726615195*^9, 
   3.913296730352564*^9}, {3.9132967806570272`*^9, 3.913296781754052*^9}, 
   3.913460692245273*^9, {3.913983937999341*^9, 3.913983947990471*^9}, {
   3.917089721549534*^9, 3.917089725025773*^9}, {3.917089797341338*^9, 
   3.917089815629513*^9}, 3.917286837905704*^9, {3.922629741507337*^9, 
   3.922629742653051*^9}, 3.9226306488384*^9, 3.9239069330784187`*^9, {
   3.923907069767198*^9, 3.923907072682558*^9}, {3.924250787224461*^9, 
   3.9242507882591147`*^9}, {3.924250852022491*^9, 3.924250852657357*^9}, 
   3.924251774725147*^9, {3.924459908128845*^9, 3.9244599136399107`*^9}, 
   3.924469293187605*^9},ExpressionUUID->"17458468-101a-45ff-9510-\
d7baab2d2f17"],

Cell[TextData[{
 "MakeThickFlasherPanels[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraphAssigned3D that describes a thick flasher (the output of \
MakeThickFlasher) and constructs the polyhedra that represent all of the \
panels of the thick flasher, along with some additional information that \
relates it to the embedded-zero-thickness surface of the flasher. Most \
quadrilaterals are divided into two triangular panels, matching the \
triangulation of the EZT flasher (which was set by the \
FlasherSectorDiagFoldLines option in MakeThickFlasher)."
}], "Text",
 CellChangeTimes->{{3.911903621632066*^9, 3.911903640993775*^9}, {
   3.91190370474335*^9, 3.911903771142905*^9}, {3.911905092328125*^9, 
   3.911905121900709*^9}, {3.911917962111912*^9, 3.911918006198327*^9}, 
   3.911988004917923*^9, {3.912004705255887*^9, 3.912004715615858*^9}, {
   3.912004802142535*^9, 3.9120048038372393`*^9}, 3.917089759818841*^9, {
   3.917112775109324*^9, 3.91711286547751*^9}, {3.923906933094408*^9, 
   3.9239070415197678`*^9}},ExpressionUUID->"2bac4979-a481-4dce-87cc-\
152be8428368"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TGraphAssigned3D returned by MakeThickFlasher."
}], "Text",
 CellChangeTimes->{{3.911903775664432*^9, 3.911903895037034*^9}, {
   3.9119039273019857`*^9, 3.91190393060372*^9}, 
   3.911918014157058*^9},ExpressionUUID->"09869237-ec7e-4191-a15e-\
5a31f0b8307e"],

Cell[TextData[{
 "Options:\n\tPanelClearance \[Rule] ",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", where pc is the gap to put between panels by insetting each panel by \
pc/2.\n\tFlasherDeployed \[Rule] True | False; if True, returned the stowed \
form; if False, return the deployed form.\n\tFlasherScale \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is a scaling factor to apply to the panel vertices (typically to convert \
to real dimensions, e.g., mm).\n\tFlasherPanelSplit \[Rule] None | Automatic, \
whether to divide quad panels along their diagonals and which to do so.\n\t\
FlasherPanelMaxBendAngle \[Rule] ",
 StyleBox["ba",
  FontSlant->"Italic"],
 ", where the two panels that make up a quad are beveled to allow a maximum \
bend angle of \[PlusMinus]",
 StyleBox["ba",
  FontSlant->"Italic"],
 ".\n\tFlasherCentralExtraInset \[Rule] ",
 StyleBox["fcec",
  FontSlant->"Italic"],
 ", additional extra lateral clearance to apply to the central polygon \
panel."
}], "Text",
 CellChangeTimes->{{3.9132966017594643`*^9, 3.913296672279364*^9}, 
   3.91329673453624*^9, {3.913553369752321*^9, 3.913553379124366*^9}, {
   3.913984151982419*^9, 3.913984243843832*^9}, {3.917112872534019*^9, 
   3.917112931463799*^9}, {3.91719903012435*^9, 3.9171990363098507`*^9}, {
   3.917286850487148*^9, 3.917286851071578*^9}, {3.922609790507339*^9, 
   3.922609791179165*^9}, {3.9226306318335543`*^9, 3.922630648854683*^9}, {
   3.922630765837815*^9, 3.922630786342694*^9}, 3.923907078103684*^9, {
   3.924250795502187*^9, 3.92425079638019*^9}, {3.924250864735476*^9, 
   3.924250889755405*^9}, 3.924251774740226*^9, {3.9244599265113583`*^9, 
   3.924459977047072*^9}, {3.924469371279245*^9, 
   3.924469388243527*^9}},ExpressionUUID->"e966fb9a-edd0-4183-8ba2-\
2996a90e2be7"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["panels",
  FontSlant->"Italic"],
 ",  ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 "} where\n\t",
 StyleBox["panels",
  FontSlant->"Italic"],
 " is a list of GraphicsComplex polyhedra, each of which is a panel of the \
thick flasher;\n\t",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " is a corresponding list of information about each panel that relates it to \
the structure of the EZT surface described by ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". See the description of ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " in the documentation for function HingeJoinPanels."
}], "Text",
 CellChangeTimes->{{3.911996765691084*^9, 3.911996877671562*^9}, {
   3.911997178300517*^9, 3.911997182728433*^9}, 3.912004817237165*^9, {
   3.922549535563796*^9, 
   3.922549562004548*^9}},ExpressionUUID->"1df48fbf-5620-48e9-ba1a-\
e6fbf624a71e"],

Cell[TextData[{
 "Note that in ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", a single ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " vertex can map to different panel vertices for different panel edges. See \
the triangular panels in this pattern (the pairs around the central polygon) \
for an example where this happens."
}], "Text",
 CellChangeTimes->{{3.922549593206741*^9, 3.922549628170908*^9}, {
  3.923907119705925*^9, 
  3.923907126073628*^9}},ExpressionUUID->"6b563c96-6ecf-4d40-b751-\
a60a8331db9f"],

Cell["\<\
The panels are computed in the stowed form as separate polyhedra. If \
FlasherDeployed \[Rule] True, then after building panels we translate/rotate \
each panel to its appropriate position in the deployed pattern.\
\>", "Text",
 CellChangeTimes->{{3.913553573201105*^9, 3.913553632634347*^9}, {
  3.913984262919635*^9, 3.913984290116631*^9}, {3.922307722724966*^9, 
  3.922307764058345*^9}, {3.922549669388361*^9, 
  3.9225496707148438`*^9}},ExpressionUUID->"b0ec9c0f-1f23-4308-96c8-\
0a8cb783ee79"],

Cell["\<\
If FlasherPanelSplit \[Rule] Automatic, we split most quad panels into two \
triangular panels in the same way that the EZT surface quads are split into \
triangles (which was affected by the FlasherSectorDiagFoldLines option). \
However, for FlasherSectorDiagFoldLines \[Rule] FlasherSectorDiagFoldLinesY \
(the default), the corner quads don\[CloseCurlyQuote]t need to be split and \
they are not split; we detect the corner quads because they are the only \
panels that have degree-2 vertices (which are their outermost corners). If \
FlasherPanelSplit \[Rule] None, we don\[CloseCurlyQuote]t split any quads \
along their diagonals (and so will rely on residual flexing and/or play to \
achieve mobility).\
\>", "Text",
 CellChangeTimes->{{3.911934280404357*^9, 3.911934328786956*^9}, {
  3.912001401701386*^9, 3.912001514784928*^9}, {3.9120049022850647`*^9, 
  3.912004920386326*^9}, {3.917113025145698*^9, 3.917113041010268*^9}, {
  3.923864104043112*^9, 3.923864167089806*^9}, {3.923907162571248*^9, 
  3.923907179916169*^9}, {3.924460007985282*^9, 3.9244600730791683`*^9}, {
  3.924469293204496*^9, 
  3.9244692932209587`*^9}},ExpressionUUID->"10e3b6af-9555-4f04-b851-\
53a29481ace2"],

Cell["\<\
When we split a quad, we\[CloseCurlyQuote]ll insert a beveled angle along \
each side of the fold line to allow a limited range of flexing. There is a \
choice in how we insert the bevel on each side; we choose angles that \
minimize the creation of acutely-angled corners on the panels. See \
sub-functions split57 and split68 in the code for the specific optimization \
algorithm.\
\>", "Text",
 CellChangeTimes->{{3.934278152964926*^9, 
  3.934278248166934*^9}},ExpressionUUID->"d8a51552-0455-4e0d-a268-\
e3405a635a29"],

Cell["\<\
We inset panel faces by PanelClearance/2, but only inset faces that would \
touch other faces (in the stowed or deployed form, as specified by the option \
FlasherDeployed) to provide clearance for 3D printing; we also inset the \
faces of the bevels at quad diagonals to avoid zero-width hinges along the \
diagonals.\
\>", "Text",
 CellChangeTimes->{{3.918499086211144*^9, 3.918499121706478*^9}, {
   3.9184991591689463`*^9, 3.91849919196735*^9}, {3.918508852334631*^9, 
   3.91850885313311*^9}, {3.91850950144503*^9, 3.918509512267482*^9}, {
   3.918827664190981*^9, 3.918827692441314*^9}, {3.922307781337811*^9, 
   3.922307827104562*^9}, 3.922630648872055*^9, {3.923864210222878*^9, 
   3.9238642104245443`*^9}},ExpressionUUID->"d963122c-4d0f-4b2a-87c4-\
eac16a1f2961"],

Cell["\<\
Note that the panels for triangle facets have a slightly different topology \
for stowed and deployed forms to accommodate the different faces involved in \
the insetting.\
\>", "Text",
 CellChangeTimes->{{3.922549673988229*^9, 3.92254973754602*^9}, {
  3.923907203609591*^9, 3.9239072051840973`*^9}, {3.933594638459041*^9, 
  3.9335946415061398`*^9}},ExpressionUUID->"8d0a5c81-c24d-4401-82ce-\
0b2af0d880e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeThickFlasherPanels", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PanelClearance", "->", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FlasherDeployed", "->", "False"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FlasherScale", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FlasherPanelSplit", "->", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"FlasherPanelMaxBendAngle", "->", 
      RowBox[{"30", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FlasherCentralExtraInset", "->", "0"}]}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.913296792060329*^9, 3.913296810719336*^9}, {
   3.913460692259595*^9, 3.913460714843896*^9}, {3.913984123655989*^9, 
   3.9139841354251947`*^9}, 3.917089759824432*^9, {3.917089869564582*^9, 
   3.917089878194312*^9}, 3.917199003878215*^9, 3.922630648876964*^9, 
   3.923906933099628*^9, {3.924250898336012*^9, 3.924250914619054*^9}, 
   3.924251774744912*^9, {3.924459987916114*^9, 3.92445999558706*^9}, 
   3.924469293226677*^9},
 CellLabel->
  "In[4520]:=",ExpressionUUID->"810e7b71-ee31-4820-8916-9744372f0efb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlasherPanelSplit", "::", "badval"}], " ", "=", 
   " ", "\"\<`1` is a bad option to FlasherPanelSplit. It should be Automatic \
or None.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.924460173226882*^9, 3.924460186839943*^9}, {
  3.924460242057253*^9, 3.924460250629458*^9}, {3.924469293228648*^9, 
  3.924469293229643*^9}},
 CellLabel->
  "In[4521]:=",ExpressionUUID->"48b0bcb3-14ff-4bc0-89f6-4197cd3cd438"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeThickFlasherPanels", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pc", ",", "fd", ",", "fs", ",", "pb", ",", "ba", ",", "fc", ",", "bah", 
      ",", "r", ",", "h", ",", "m", ",", "t", ",", "ijkm", ",", "verts3d", ",",
       "edges", ",", "faces", ",", "vertsdp", ",", "pp", ",", "igrules", ",", 
      "ffrules", ",", "quads", ",", "quad", ",", "iquad", ",", "qsolid", ",", 
      "triangles", ",", "triangle", ",", "central", ",", "z", ",", "bv", ",", 
      "panels", ",", "pifs", ",", "psfs", ",", "panelinfo", ",", "p1", ",", 
      "p2", ",", "p3", ",", "p4", ",", "i1", ",", "i2", ",", "i3", ",", "i4", 
      ",", "i1i3", ",", "rvrs", ",", "u", ",", "ut", ",", "\[Epsilon]", ",", 
      "v", ",", "w12", ",", "w43", ",", "w32", ",", "note", ",", "prt", ",", 
      "prt1", ",", "prti", ",", "cmp", ",", "cmp1", ",", "cmpi", ",", "q1", ",",
       "q2", ",", "q7", ",", "q8", ",", "q5", ",", "q6", ",", "q3", ",", "q4",
       ",", "q5a", ",", "q5b", ",", "q6a", ",", "q6b", ",", "q7a", ",", "q7b",
       ",", "q8a", ",", "q8b", ",", "v4", ",", "v5", ",", "v6", ",", "v7", ",",
       "v8", ",", "emap", ",", "emapfn", ",", "split57", ",", "split68", ",", 
      "qpts", ",", "iqpts", ",", "pfaces", ",", "gc", ",", "vtrio", ",", 
      "vsrc", ",", "vdst", ",", "mat", ",", "off", ",", "gc1", ",", "gc2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pc", ",", "fd", ",", "fs", ",", "pb", ",", "ba", ",", "fc"}], 
       "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "PanelClearance", ",", "FlasherDeployed", ",", "FlasherScale", ",", 
          "FlasherPanelSplit", ",", " ", "FlasherPanelMaxBendAngle", ",", 
          "FlasherCentralExtraInset"}], "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeThickFlasherPanels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pb", "=!=", "Automatic"}], "&&", 
        RowBox[{"pb", "=!=", "None"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"FlasherPanelSplit", "::", "badval"}], ",", "pb"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Half", " ", "the", " ", "bend", " ", "angle", " ", "is", " ", "used", " ",
        "in", " ", "several", " ", 
       RowBox[{"places", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bah", "=", 
      RowBox[{"ba", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", "ijkm"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "FlasherR", ",", "FlasherH", ",", "FlasherM", ",", 
          "ThickFlasherThickness", ",", "FlasherIJKMap"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "edges", ",", "faces", ",", "vertsdp"}], "}"}],
       "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices3D", ",", "Edges", ",", "Faces", ",", "FlasherVerticesDP"}],
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "rules", " ", "that", " ", "map", " ", "symbolic", " ",
        "points", " ", 
       SubscriptBox["pp", 
        RowBox[{"i", ",", "j", ",", "k"}]], " ", "to", " ", "their", " ", 
       "corresponding", " ", "vertex", " ", "index", " ", "in", " ", 
       RowBox[{"tobj", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"igrules", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "@@", 
           RowBox[{"Prepend", "[", 
            RowBox[{"#1", ",", "pp"}], "]"}]}], "->", "#2"}], "&"}], ",", 
        RowBox[{"Transpose", "[", "ijkm", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "rules", " ", "that", " ", "map", " ", "symbolic", " ",
        "points", " ", 
       SubscriptBox["pp", 
        RowBox[{"i", ",", "j", ",", "k"}]], " ", "to", " ", "their", " ", "3",
        "D", " ", 
       RowBox[{"coordinates", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ffrules", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "@@", 
           RowBox[{"Prepend", "[", 
            RowBox[{"#1", ",", "pp"}], "]"}]}], "->", 
          RowBox[{
          "verts3d", "\[LeftDoubleBracket]", "#2", 
           "\[RightDoubleBracket]"}]}], "&"}], ",", 
        RowBox[{"Transpose", "[", "ijkm", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"handy", " ", "to", " ", "have", " ", "this", " ", "around"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bv", "=", "FlasherPanelCrossQuadBevel"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
