Cell[BoxData[
 RowBox[{
  RowBox[{"CurvedFoldShapePlots3D", "[", 
   RowBox[{
    RowBox[{"f_Function", "|", "ff_InterpolatingFunction"}], ",", 
    RowBox[{"rrL_Function", "|", "rrL_InterpolatingFunction"}], ",", 
    RowBox[{"rrR_Function", "|", "rRr_InterpolatingFunction"}], ",", 
    RowBox[{"\[Gamma]_Function", "|", "\[Gamma]_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "csys", ",", "\[Kappa]", ",", "\[Tau]", ",", "tt", ",", "\[Kappa]g"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"csys", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ContainsInterpolatingFunctionQ", "[", "f", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"NCurve3DSystem", "[", 
         RowBox[{"f", ",", 
          RowBox[{"{", 
           RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Curve3DSystem", "[", 
         RowBox[{"f", ",", "opts"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Kappa]", ",", "\[Tau]", ",", "tt"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Curvature3D", ",", "Torsion3D", ",", "TangentVector3D"}], 
        "}"}], "/.", "csys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Kappa]", "[", "s", "]"}], ",", 
           RowBox[{
            RowBox[{"\[Kappa]", "[", "s", "]"}], 
            RowBox[{"Cos", "[", 
             FractionBox[
              RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}]}], ",", 
           RowBox[{"\[Tau]", "[", "s", "]"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<\[Kappa]\>\"", ",", 
              RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Kappa]\), \(g\)]\)\>\"", ",",
               "Blue"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<\[Tau]\>\"", ",", "Magenta"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Darker", "[", "Blue", "]"}], ",", "Blue", ",", "Magenta",
             ",", "White"}], "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcCos", "[", 
             RowBox[{
              RowBox[{"rrL", "[", "s", "]"}], ".", 
              RowBox[{"tt", "[", "s", "]"}]}], "]"}], "/", "\[Degree]"}], ",", 
           RowBox[{
            RowBox[{"ArcCos", "[", 
             RowBox[{
              RowBox[{"rrR", "[", "s", "]"}], ".", 
              RowBox[{"tt", "[", "s", "]"}]}], "]"}], "/", "\[Degree]"}], ",", 
           RowBox[{
            RowBox[{"\[Gamma]", "[", "s", "]"}], "/", "\[Degree]"}], ",", 
           "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(L\)]\)/\[Degree]\>\
\"", ",", "Red"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(R\)]\)/\[Degree]\>\
\"", ",", 
              RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<\[Gamma]/\[Degree]\>\"", ",", "Purple"}], "]"}]}], 
           "}"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "Red", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Darker", "[", "Green", "]"}], ",", "Dashed"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Purple", ",", "Dotted"}], "}"}], ",", "White"}], 
           "}"}]}]}], "]"}]}], "}"}]}]}], "]"}]}]], "Input",
