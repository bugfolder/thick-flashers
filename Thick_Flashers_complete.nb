Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ExtractStyleArgs", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ShowSample", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     RowBox[{"MagnifySample", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"StyleObjectSample", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", ".1"}], "}"}]}], "}"}], "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], "]"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.456529798969633*^9, 3.456529813807016*^9}, {
   3.456529871570668*^9, 3.456529954983078*^9}, {3.45653029716152*^9, 
   3.456530297622602*^9}, 3.45653040614021*^9, {3.485092067349125*^9, 
   3.485092073763286*^9}, {3.550952217666815*^9, 3.550952223575893*^9}, {
   3.550952536652048*^9, 3.55095256460232*^9}, {3.5509525952814417`*^9, 
   3.550952601473244*^9}, {3.592041928632687*^9, 3.59204193271411*^9}, 
   3.59264551968773*^9, 3.628786592207753*^9, 3.708018873892519*^9, {
