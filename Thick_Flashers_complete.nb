Cell[TextData[{
 "DevelopabilityExcess3D[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["plist",
  FontSlant->"Italic"],
 "] takes a 3D vertex ",
 StyleBox["v",
  FontSlant->"Italic"],
 " and an ordered list of vertices ",
 StyleBox["plist",
  FontSlant->"Italic"],
 " around it that describe the vertex neighborhood of ",
 StyleBox["v",
  FontSlant->"Italic"],
 " and computes the total angle less 2\[Pi] of the surface. If this has the \
value zero, then the vertex is developable (flat-unfoldable). This function \
is useful to take a parameterized vertex description of a 3D shape and force \
it to be developable by solving for the parameters that makes the value of \
the angular excess equal zero."
}], "Text",
 CellChangeTimes->{{3.49617172105239*^9, 3.496171880983634*^9}, {
  3.496172284460559*^9, 3.496172291456235*^9}, {3.591978909332282*^9, 
  3.591978919927555*^9}, {3.595982424836453*^9, 
  3.595982433722937*^9}},ExpressionUUID->"3e63cde0-7a27-4045-a201-\
60f3e963d80a"],

Cell["\<\
Note that this function assumes that each point is connected to the next one \
via the shortest angle of rotation, i.e., all vertex angles are \[Pi] or \
less. If the structure might contain vertex angles larger than \[Pi], this \
function gives a bogus answer.\
\>", "Text",
 CellChangeTimes->{{3.496238258642924*^9, 3.496238300320732*^9}, {
   3.496238416439427*^9, 3.496238420949632*^9}, 
   3.589464673986601*^9},ExpressionUUID->"6c1d37bc-7638-44ae-b232-\
6cab3a0d3f49"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DevelopabilityExcess3D", "[", 
   RowBox[{"v_", ",", "plist_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rr", ",", "angles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", "v"}], "&"}], "/@", "plist"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"vectors", " ", "to", " ", "each", " ", "vertex"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"ShortestAngle3D", ",", 
        RowBox[{"{", 
         RowBox[{"rr", ",", 
          RowBox[{"RotateLeft", "[", "rr", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Plus", "@@", "angles"}], "-", 
      RowBox[{"2", "\[Pi]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.496171883594037*^9, 3.496171901356296*^9}, {
   3.49617194558057*^9, 3.49617211605507*^9}, {3.4961721470487947`*^9, 
   3.496172147528172*^9}, {3.496172205524617*^9, 3.496172257174549*^9}, 
   3.496172294472212*^9, {3.496172404144728*^9, 3.496172406023794*^9}, {
   3.496172463379062*^9, 3.496172483845356*^9}, {3.496172554396171*^9, 
   3.49617262714482*^9}, {3.49617266476421*^9, 3.496172667856458*^9}, {
   3.496172883917351*^9, 3.496172929046535*^9}, 3.591978848727092*^9, 
   3.591978919966172*^9, 3.595982424954509*^9, 3.628786344593638*^9},
 CellLabel->
  "In[733]:=",ExpressionUUID->"a202b0e6-12ea-494c-bfd8-eef66997feac"],

