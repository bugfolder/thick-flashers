Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bb", ",", "dd", ",", "\[Theta]", ",", "u", ",", "v", ",", "ss", ",", 
      "uu1", ",", "uu2", ",", "u0", ",", "u1", ",", "nu", ",", "du"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{"\[Theta]", ",", 
           RowBox[{"-", 
            RowBox[{"bb", "[", "u", "]"}]}]}], "]"}], ".", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ",", "u"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ss", "=", 
      RowBox[{"FunctionizeOld", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bb", "[", "u", "]"}], "+", 
         RowBox[{"v", " ", 
          RowBox[{"dd", "[", "u", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu1", "=", 
      RowBox[{"RuledSurfaceNormal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bb", ",", "dd", ",", "1"}], "}"}], ",", 
        RowBox[{"SurfaceOrientation", "\[Rule]", "1"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu2", "=", 
      RowBox[{"RuledSurfaceNormal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bb", ",", "dd", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"SurfaceOrientation", "\[Rule]", "1"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"45", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u0", "=", 
      RowBox[{
       RowBox[{"-", ".5"}], "\[Pi]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u1", "=", 
      RowBox[{"1.4", "\[Pi]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nu", "=", "10"}], ";", "\[IndentingNewLine]", 
     RowBox[{"du", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u1", "-", "u0"}], ")"}], "/", "nu"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"ss", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
              RowBox[{"CurveDivisions", "\[Rule]", "200"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"bb", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"StyledVector", "[", 
               RowBox[{
                RowBox[{"bb", "[", "u", "]"}], ",", 
                RowBox[{".5", 
                 RowBox[{"uu1", "[", 
                  RowBox[{"u", ",", "0"}], "]"}]}], ",", 
                RowBox[{"VectorColor", "\[Rule]", "Purple"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u", ",", "u0", ",", "u1", ",", "du"}], "}"}]}], "]"}],
             ",", "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"ss", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
              RowBox[{"CurveDivisions", "\[Rule]", "200"}], ",", 
              RowBox[{"SurfaceOrientation", "\[Rule]", 
               RowBox[{"-", "1"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"StyledCurve", "[", 
             RowBox[{"bb", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"StyledVector", "[", 
               RowBox[{
                RowBox[{"bb", "[", "u", "]"}], ",", 
                RowBox[{".5", 
                 RowBox[{"uu2", "[", 
                  RowBox[{"u", ",", "0"}], "]"}]}], ",", 
                RowBox[{"VectorColor", "\[Rule]", "Purple"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u", ",", "u0", ",", "u1", ",", "du"}], "}"}]}], "]"}],
             ",", "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "]"}]}], "}"}], "]"}], 
      "\[IndentingNewLine]", "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.691704283781425*^9, 3.691704472110504*^9}, {
   3.691704516886451*^9, 3.691704843630665*^9}, {3.6917049065988417`*^9, 
   3.691704912658024*^9}, {3.691705075375277*^9, 3.69170522412802*^9}, 
   3.694002195065463*^9, 3.694007283183775*^9, {3.797265477759536*^9, 
