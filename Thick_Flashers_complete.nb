Cell[CellGroupData[{

Cell[TextData[{
 "MakeSemigeneralizedMiuraOriB[",
 StyleBox["blist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw",
  FontSlant->"Italic"],
 ", \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.642624398398085*^9, {3.642624621969589*^9, 3.642624622352464*^9}, 
   3.642684776997446*^9, {3.642684815880765*^9, 3.642684818031864*^9}, 
   3.643289345425548*^9},ExpressionUUID->"8e9abb6e-d567-40e7-87e3-\
b6eadefecd15"],

Cell[TextData[{
 "MakeSemigeneralizedMiuraOriB[",
 StyleBox["blist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dlist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", nw, \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a TGraph3D+TAssigned that represents a semi-generalized Miura-ori \
(periodic in only one direction) from a description of the desired path, \
where\n\t",
 StyleBox["blist",
  FontSlant->"Italic"],
 " is the list of path bend angles at each of the vertices along a single \
strip. If the first and last values are 180\[Degree], the left and right \
edges of the crease pattern will be vertical lines.\n\t",
 StyleBox["dlist",
  FontSlant->"Italic"],
 " are the distances between vertices in odd-numbered rows.\n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of each strip, which is paired with its mirror image.\n\t",
 StyleBox["nw",
  FontSlant->"Italic"],
 " is the number of pair repetitions across the width\n\t\[Gamma] is the \
initial minor fold angle at the bottom left. All horizontal fold angles are \
\[PlusMinus]\[Gamma].\nOptions are:\n\tOptions[FoldGraph3D] are passed \
through to FoldGraph."
}], "Text",
 CellChangeTimes->{{3.642623914001541*^9, 3.642624007455812*^9}, {
   3.642624048971643*^9, 3.64262432762982*^9}, {3.6426246264166813`*^9, 
   3.642624629528961*^9}, 3.642684777155979*^9, {3.6426848223065577`*^9, 
   3.642684893222384*^9}, {3.642685178061172*^9, 3.642685178181444*^9}, {
   3.643289346097859*^9, 3.643289346898432*^9}, {3.64328942738897*^9, 
   3.643289432267287*^9}, {3.7016413543448052`*^9, 3.701641357800345*^9}, {
   3.701641407832119*^9, 
   3.701641415136899*^9}},ExpressionUUID->"1960aff1-7d43-4fb7-b784-\
3c5e0a074ecb"],

Cell["\<\
Returns: a TGraph3D+TAssigned that describes the crease pattern and folded \
form.\
\>", "Text",
 CellChangeTimes->{{3.9227293242980347`*^9, 
  3.922729342938485*^9}},ExpressionUUID->"b6a549e1-4c04-4efb-9149-\
45f506ce6e43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSemigeneralizedMiuraOriB", "[", 
   RowBox[{
   "blist_List", ",", "dlist_List", ",", "w_", ",", "nw_", ",", "\[Gamma]_", ",",
     "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"alist", ",", "mfi"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"alist", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"mfi", "=", 
          RowBox[{"Xor", "[", 
           RowBox[{
            RowBox[{"\[Gamma]", ">", "0"}], ",", 
            RowBox[{"OddQ", "[", "i", "]"}]}], "]"}]}], ";", 
         RowBox[{"(*", " ", 
          RowBox[{"True", " ", "=", " ", 
           RowBox[{
           "minor", " ", "fold", " ", "incident", " ", "on", " ", "vertex", " ",
             "is", " ", "valley"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
            "blist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ">",
             "0"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{"mfi", ",", 
             RowBox[{
              RowBox[{
              "blist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               "/", "2"}], ",", 
             RowBox[{"\[Pi]", "-", 
              RowBox[{
               RowBox[{
               "blist", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "/", "2"}]}]}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{"mfi", ",", 
             RowBox[{"\[Pi]", "+", 
              RowBox[{
               RowBox[{
               "blist", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}], "/", "2"}]}], ",", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{
               "blist", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}], "/", "2"}]}], "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "blist", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeSemigeneralizedMiuraOriA", "[", 
      RowBox[{
      "alist", ",", "dlist", ",", "w", ",", "nw", ",", "\[Gamma]", ",", 
       "opts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.64268519917014*^9, {3.642685656448899*^9, 3.642685669876524*^9}, {
   3.642687141500608*^9, 3.642687318331714*^9}, {3.642687350692403*^9, 
   3.64268735777618*^9}, {3.642687642840267*^9, 3.642687697794718*^9}, {
   3.642687743379188*^9, 3.642687970795011*^9}, {3.642688048707596*^9, 
   3.642688079826253*^9}, {3.64268852711022*^9, 3.642688527725486*^9}, {
   3.64268911709129*^9, 3.642689117921772*^9}, 3.6426895896344547`*^9, {
   3.643289347754998*^9, 3.643289348668116*^9}},
 CellLabel->
  "In[2547]:=",ExpressionUUID->"72572d1c-7d96-4046-bf12-3acbcf522d51"],

Cell["Example", "Text",
 CellChangeTimes->{{3.642687360922293*^9, 
  3.642687361590972*^9}},ExpressionUUID->"e28a888a-fc20-4dd4-807f-\
1316944901dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "blist", ",", "dlist", ",", "w", ",", "nw", ",", "\[Gamma]", ",", 
      "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"blist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"180", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "120"}], "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "120"}], "\[Degree]"}], ",", 
        RowBox[{"179", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "180"}], "\[Degree]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dlist", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.25"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nw", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"45.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSemigeneralizedMiuraOriB", "[", 
       RowBox[{"blist", ",", "dlist", ",", "w", ",", "nw", ",", "\[Gamma]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CornerIndices = \>\"", ",", 
       RowBox[{"tobj", "[", "CornerIndices", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"FoldAngleGraphics", "[", "tobj", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"FoldedFormGraphics3D", "[", 
        RowBox[{"VertexRotateGraph3D", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "4", ",", "21"}], "}"}]}], "]"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.642626178952121*^9, 3.642626268781659*^9}, {
   3.642626384801794*^9, 3.6426264047301598`*^9}, {3.642632156401955*^9, 
   3.642632179811406*^9}, {3.642632651452029*^9, 3.642632714283173*^9}, {
   3.642633492497828*^9, 3.642633550208844*^9}, 3.642633583213945*^9, {
   3.642633686247956*^9, 3.642633694419078*^9}, {3.642633736621851*^9, 
   3.642633741536384*^9}, {3.642633841786639*^9, 3.642633859123762*^9}, {
   3.642633920355566*^9, 3.642633932834351*^9}, 3.642634096523904*^9, 
   3.6426341282203712`*^9, 3.642634275274366*^9, 3.642684777373485*^9, {
   3.642687373776663*^9, 3.642687392496516*^9}, {3.642687982431175*^9, 
   3.642688023243426*^9}, {3.642688146239356*^9, 3.642688155020871*^9}, 
   3.642688481399147*^9, 3.64323985576513*^9, {3.6432893501957912`*^9, 
