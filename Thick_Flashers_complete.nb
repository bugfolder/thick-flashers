        RowBox[{"240", "\[Degree]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p7", "=", 
      RowBox[{"p1", "+", 
       RowBox[{"U", "[", 
        RowBox[{"210", "\[Degree]"}], "]"}]}]}], ";", 
     RowBox[{"p8", "=", 
      RowBox[{"p1", "+", 
       RowBox[{"U", "[", 
        RowBox[{"270", "\[Degree]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
