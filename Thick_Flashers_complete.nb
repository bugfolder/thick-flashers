   3.800211638776268*^9, 3.800211638778049*^9}, {3.800228616689229*^9, 
   3.800228624656546*^9}, {3.8002286736317263`*^9, 3.800228710702029*^9}, {
   3.80022879483771*^9, 3.800228812942815*^9}, {3.80022885659971*^9, 
