Cell[CellGroupData[{

Cell[TextData[{
 "MakeFoldVectorsDevelopable[",
 StyleBox["foldvectors",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]",
 "\n\t(options) ForceFlatFoldable"
}], "Subsubsection",
 CellChangeTimes->{{3.6161751164742103`*^9, 
  3.616175131974721*^9}},ExpressionUUID->"67a89e33-1585-4c56-baa2-\
3202eec45602"],

Cell[TextData[{
 "MakeFoldVectorsDevelopable[",
 StyleBox["foldvectors",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of fold vectors ",
 StyleBox["foldvectors",
  FontSlant->"Italic"],
 " for a vertex and perturbs them minimally so that the resulting sheet has \
zero net curvature but is \"close\" to the original configuration. Useful for \
constructing physically accurate representations of vertices. Options are:\n\t\
ForceFlatFoldable \[Rule] True | False, specify whether to force it to be \
flat-foldable or not. Only meaningful for even degree, so is ignored for \
odd-length lists."
}], "Text",
 CellChangeTimes->{{3.439992084096199*^9, 3.439992172382823*^9}, {
   3.440000543763592*^9, 3.440000568219003*^9}, {3.440001832974667*^9, 
   3.440001878781438*^9}, {3.441928021094653*^9, 3.441928021094705*^9}, {
   3.442875525313459*^9, 3.442875525313519*^9}, {3.443209854238377*^9, 
   3.443209857899709*^9}, {3.5928292122598467`*^9, 3.5928292122599382`*^9}, {
   3.592829516307036*^9, 3.5928295163071747`*^9}, {3.592829763791303*^9, 
   3.592829763791393*^9}, {3.592830369936763*^9, 3.5928303717396107`*^9}, {
   3.593022539129715*^9, 3.593022541286866*^9}, 3.594756117845578*^9, {
   3.594756214924569*^9, 3.5947562149246473`*^9}, {3.5948105922335443`*^9, 
   3.594810592233998*^9}, {3.61617514134449*^9, 
   3.6161751520913982`*^9}},ExpressionUUID->"fbbfbe6e-ad9b-4a31-8306-\
2b47ce3d3389"],

Cell["\<\
TBD, this developability constraint is numerically unstable. Find a better \
constraint function.\
\>", "Text",
 CellChangeTimes->{{3.5947565290425653`*^9, 
  3.594756565383738*^9}},ExpressionUUID->"9d5c2864-f438-4b33-b527-\
adcad04bc3dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ForceFlatFoldable", "::", "usage"}], 
   "=", "\"\<ForceFlatFoldable is an option to \
\!\(TraditionalForm\`MakeFoldVectorsDevelopable\) that forces a 3D vertex to \
be flat-foldable.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.5920775867860126`*^9, 3.59207762608482*^9}, 
   3.5928292124332037`*^9, 3.59282951647963*^9, 3.592829763963554*^9, {
   3.592830406428601*^9, 3.5928304121031*^9}, {3.594756117902507*^9, 
   3.594756117927187*^9}, 3.594756214945032*^9, 3.594756275644745*^9, 
   3.5948105924051657`*^9},
 CellLabel->
  "In[2217]:=",ExpressionUUID->"4a84aa29-1233-4b1c-8f8e-b3395bba46b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeFoldVectorsDevelopable", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"ForceFlatFoldable", "\[Rule]", "False"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.440001811439644*^9, 3.440001830013783*^9}, 
   3.4419280213284397`*^9, 3.442875525462281*^9, 3.592829212467499*^9, 
   3.592829516523029*^9, 3.592829764001281*^9, 3.592830419505258*^9, 
   3.594756117980072*^9, 3.5947562149980993`*^9, 3.594810592441101*^9},
 CellLabel->
  "In[2218]:=",ExpressionUUID->"90f36de0-42bf-46e7-ae9f-cb0047b9e482"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFoldVectorsDevelopable", "[", 
   RowBox[{"rlist_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ff", ",", "nn", ",", "rz", ",", "ry", ",", "rr", ",", "dry", ",", "drz",
       ",", "\[Alpha]", ",", "asum", ",", "fom", ",", "cons", ",", "vbls", ",",
       "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"ForceFlatFoldable", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeFoldVectorsDevelopable", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", " ", "=", 
      RowBox[{"ff", " ", "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"nn", ",", "2"}], "]"}], "\[Equal]", "0"}], ")"}]}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{"turn", " ", "off", " ", "flag", " ", "if", " ", 
       RowBox[{"there", "'"}], "s", " ", "an", " ", "odd", " ", "number", " ",
        "of", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "rlist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "two", " ", "unit", " ", "vectors", " ", "perpendicular", " ",
        "to", " ", "each", " ", "initial", " ", "vector"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rz", "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Cross", ",", 
         RowBox[{"{", 
          RowBox[{"rlist", ",", 
           RowBox[{"RotateLeft", "[", "rlist", "]"}]}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ry", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Cross", ",", 
        RowBox[{"{", 
         RowBox[{"rz", ",", "rlist"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Symbolically", " ", "perturbed", " ", "vectors"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"rr", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationMatrix3Du", "[", 
           RowBox[{
            RowBox[{"drz", "[", "i", "]"}], ",", 
            RowBox[{
            "rz", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
           "]"}], ".", 
          RowBox[{"RotationMatrix3Du", "[", 
           RowBox[{
            RowBox[{"dry", "[", "i", "]"}], ",", 
            RowBox[{
            "ry", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
           "]"}], ".", 
          RowBox[{
          "rlist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"dry", "[", "i_", "]"}], "\[RuleDelayed]", 
          RowBox[{"dry", "[", 
           RowBox[{"Round", "[", "i", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"drz", "[", "i_", "]"}], "\[RuleDelayed]", 
          RowBox[{"drz", "[", 
           RowBox[{"Round", "[", "i", "]"}], "]"}]}]}], "}"}]}]}], ";", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"ArcCos", "/@", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Dot", ",", 
         RowBox[{"{", 
          RowBox[{"rr", ",", 
           RowBox[{"RotateLeft", "[", "rr", "]"}]}], "}"}], ",", "1"}], 
        "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fom", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"dry", "[", "i", "]"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"drz", "[", "i", "]"}], "2"]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nn"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"figure", " ", "of", " ", "merit"}], ",", " ", 
       RowBox[{"to", " ", "minimize"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"asum", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Plus", "@@", "\[Alpha]"}], "-", 
        RowBox[{"2", "\[Pi]"}]}], "\[Equal]", "0"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "equation", " ", "that", " ", "enforces", " ", "sum", " ", "of", " ", 
       "sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cons", "=", 
      RowBox[{"If", "[", 
       RowBox[{"ff", ",", 
        RowBox[{"asum", "&&", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "\[Alpha]", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "i"]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], "\[Equal]", "0"}]}], ",",
         "asum"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vbls", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"dry", "[", "i", "]"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"drz", "[", "i", "]"}], ",", "0"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindMinimum", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fom", ",", "cons"}], "}"}], ",", "vbls"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"nonlinear", " ", "constrained", " ", "minimization"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rr", "/.", 
      RowBox[{
      "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}]}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "return", " ", "the", " ", "set", " ", "of", " ", "vectors", " ", "that", 
     " ", "achieves", " ", "the", " ", "minimum"}], " ", "*)"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.439992185353351*^9, 3.439992473148577*^9}, {
   3.43999251133901*^9, 3.439992776156108*^9}, {3.439992849528983*^9, 
   3.439992859332311*^9}, {3.4400000091317587`*^9, 3.440000027171452*^9}, {
   3.44000008419625*^9, 3.440000137404921*^9}, 3.440000168272565*^9, {
   3.440001916463272*^9, 3.440002110399116*^9}, {3.440002147555957*^9, 
   3.440002149088087*^9}, {3.440002203329144*^9, 3.440002236267338*^9}, {
   3.440257021179824*^9, 3.440257021247951*^9}, {3.441928021588172*^9, 
   3.4419280218708153`*^9}, {3.4428755256870327`*^9, 3.442875525835115*^9}, {
   3.59282921251782*^9, 3.592829212556559*^9}, {3.592829516572274*^9, 
   3.592829516607348*^9}, {3.592829764051255*^9, 3.592829764085939*^9}, {
   3.592830424488133*^9, 3.592830429345343*^9}, 3.59475611800991*^9, {
   3.594756215028651*^9, 3.594756215061538*^9}, {3.594756306891813*^9, 
   3.594756308134455*^9}, {3.594810592492028*^9, 3.594810592524444*^9}, {
   3.594813545074448*^9, 3.594813585451043*^9}, {3.594813732941814*^9, 
   3.594813863081855*^9}, {3.594813925328561*^9, 3.5948141982967176`*^9}, {
   3.594814263408718*^9, 3.594814476073628*^9}, {3.594814523384851*^9, 
   3.594814564879931*^9}, {3.594814684133016*^9, 3.594814697372435*^9}, {
   3.594814750419533*^9, 3.594814846156259*^9}, {3.5948149259736547`*^9, 
   3.594814989874076*^9}, {3.594815111835609*^9, 3.594815134504934*^9}, {
   3.594815184870262*^9, 3.594815257403716*^9}, {3.594815373602704*^9, 
   3.5948153975670233`*^9}, {3.594815462004823*^9, 3.5948155436483297`*^9}, {
   3.594815586013711*^9, 3.594815601547902*^9}, {3.594815693093339*^9, 
   3.59481570377953*^9}, {3.594984925208428*^9, 3.594984925412261*^9}, {
   3.616175161333897*^9, 3.616175166587645*^9}, {3.688165714527044*^9, 
   3.688165753613195*^9}, 3.688165935271535*^9, 3.701092813634041*^9},
 CellLabel->
  "In[2219]:=",ExpressionUUID->"f16c52d5-36ee-4068-8455-4fb06ab39f7a"],

Cell["\<\
Example; pick a \"good-looking\" vertex, and then tweak it to developable and \
then flat foldability.\
\>", "Text",
 CellChangeTimes->{{3.43999279471355*^9, 3.439992795454802*^9}, {
   3.440002734082847*^9, 3.440002754042525*^9}, {3.44320996041686*^9, 
   3.4432099793987923`*^9}, {3.592078301905212*^9, 3.592078302471322*^9}, {
   3.594815720167873*^9, 3.594815753828617*^9}, 
   3.594829357719981*^9},ExpressionUUID->"ba2c1397-a7ba-4cd9-8b20-\
f867cd0f8a5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sal", ",", "dal", ",", "gfn", ",", "dirs", ",", "dirs2", ",", "dirs3"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sal", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "16"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(1\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(2\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(3\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(4\)]\)\>\""}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dal", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "14"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(1\)]\)\>\"", " ", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(2\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(3\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(4\)]\)\>\""}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gfn", "[", 
       RowBox[{"dirs1_", ",", "label_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tobj", "=", 
          RowBox[{"MakeTVertex3DFromFoldVectors", "[", "dirs1", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", "label", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Sector angles/\[Degree]\>\"", "\[Rule]", 
           RowBox[{
            RowBox[{"tobj", "[", "SectorAngles", "]"}], "/", "\[Degree]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Fold angles/\[Degree]\>\"", "\[Rule]", 
           RowBox[{
            RowBox[{"tobj", "[", "DihedralAngles", "]"}], "/", 
            "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Developability excess/\[Degree]\>\"", " ", "\[Rule]", 
           RowBox[{
            RowBox[{"DevelopabilityExcess", "[", 
             RowBox[{"tobj", "[", "SectorAngles", "]"}], "]"}], "/", 
            "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Flat-foldability excess/\[Degree]\>\"", " ", "\[Rule]", 
           RowBox[{
            RowBox[{"FlatFoldabilityExcess", "[", 
             RowBox[{"tobj", "[", "SectorAngles", "]"}], "]"}], "/", 
            "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Vertex3DGraphicsTrio", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"SectorAngleLabels", "\[Rule]", "sal"}], ",", 
             RowBox[{"DihedralAngleLabels", "\[Rule]", "dal"}]}], "]"}], "/.", 
           RowBox[{"Vertex3DStyle", "[", "]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dirs", "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1.", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1."}], ",", "1.", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", ".2"}], ",", 
           RowBox[{"-", ".2"}], ",", "1."}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", ".5"}], ",", 
           RowBox[{"-", ".5"}], ",", ".5"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationXMatrix3D", "[", 
          RowBox[{"50.", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
       "dirs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"original", " ", "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"dirs", ",", "\"\<Initial vertex\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"developable", ",", " ", 
       RowBox[{"not", " ", "necessarily", " ", "flat", " ", "foldable"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dirs2", "=", 
      RowBox[{"MakeFoldVectorsDevelopable", "[", 
       RowBox[{"dirs", ",", 
        RowBox[{"ForceFlatFoldable", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"dirs2", ",", "\"\<Developable vertex\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"developable", " ", "and", " ", "flat", " ", "foldable"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dirs3", "=", 
      RowBox[{"MakeFoldVectorsDevelopable", "[", 
       RowBox[{"dirs", ",", 
        RowBox[{"ForceFlatFoldable", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"dirs3", ",", "\"\<Flat-foldable vertex\>\""}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.44261767602177*^9, 3.442617908683637*^9}, {
   3.442618034697379*^9, 3.442618064486623*^9}, 3.442671214328623*^9, {
   3.442875526069555*^9, 3.442875526219291*^9}, {3.443209936576672*^9, 
   3.443209936749585*^9}, {3.533652321286767*^9, 3.533652325641364*^9}, 
   3.533655049267891*^9, {3.533655682956946*^9, 3.533655717091691*^9}, {
   3.5920780058263597`*^9, 3.592078148113278*^9}, 3.592078193843303*^9, {
   3.592078228956675*^9, 3.592078261751541*^9}, {3.592082002822476*^9, 
   3.592082002854171*^9}, {3.5924370893392763`*^9, 3.592437089434701*^9}, {
