       RowBox[{"t3d", ",", "r3d", ",", "c3d", ",", "u2d"}], "}"}], "=", 
      RowBox[{"MultipleGoreData", "[", 
       RowBox[{"pts", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Graphics3D", "[", "t3d", "]"}], ",", 
          RowBox[{"Graphics3D", "[", "r3d", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Graphics3D", "[", "c3d", "]"}], ",", 
          RowBox[{"Graphics", "[", "u2d", "]"}]}], "}"}]}], "}"}], "]"}]}]}], 
