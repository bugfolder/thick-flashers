7f541733b0f0"],

Cell["\<\
It\[CloseCurlyQuote]s often useful to compute an InsetSeparationPlot to \
determine the maximum inset distance possible for a given line pattern.\
\>", "Text",
 CellChangeTimes->{{3.7218459219452863`*^9, 
  3.721845957424608*^9}},ExpressionUUID->"9a2cebb9-0a87-46f9-a624-\
866041720793"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "InsetSeparationFn[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 "]\nInsetSeparationPlot[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{min, max}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.462811172450553*^9, 3.462811190975977*^9}, 
   3.462813882781736*^9, 3.462928583898365*^9, {3.462929593247056*^9, 
   3.4629296033095827`*^9}, {3.592614349089426*^9, 3.592614376821618*^9}, {
   3.59261471726081*^9, 
   3.592614723291556*^9}},ExpressionUUID->"32523d57-de1a-4d6a-a1a8-\
958afd21b372"],

Cell[TextData[{
 "InsetSeparationFn[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 "] returns a pure function that gives the minimum inset point separation as \
a function of its argument. It is useful for finding the maximum inset \
distance for a given pattern."
}], "Text",
 CellChangeTimes->{{3.462811194279889*^9, 3.462811270692549*^9}, 
   3.462813882805383*^9, 
   3.4629285839189987`*^9},ExpressionUUID->"1e9f8eef-e534-4cf0-bc3b-\
e93e1c2d0b81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsetSeparationFn", "[", 
   RowBox[{"verts_List", ",", "edges_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "faces", ",", "h", ",", "iverts", ",", "idists"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Faces"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"iverts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"InsetPoly", "[", 
           RowBox[{
            RowBox[{
            "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], ",",
             "h"}], "]"}], "&"}], "/@", "faces"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"idists", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{
            RowBox[{
            "iverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
            "-", 
            RowBox[{
            "iverts", "\[LeftDoubleBracket]", "j", 
             "\[RightDoubleBracket]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "iverts", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"Length", "[", "iverts", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Function", "[", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"Min", "[", "idists", "]"}], "/.", 
        RowBox[{"h", "\[Rule]", "#"}]}], "]"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.46281130713931*^9, 3.462811454338696*^9}, 
   3.462813882831238*^9, 3.462928583939086*^9, {3.463514256661672*^9, 
   3.463514326053729*^9}, {3.46351442459536*^9, 3.463514440717996*^9}, {
   3.59256018554776*^9, 3.5925602604745293`*^9}, 3.592647648987388*^9, 
   3.5928287444391003`*^9, 3.627328560657102*^9, 3.627328638854115*^9, {
   3.721830344354658*^9, 3.721830344530164*^9}},
 CellLabel->
  "In[3410]:=",ExpressionUUID->"acc44ee8-8758-4d2c-a7d2-85244a0e7ffd"],

Cell["Example", "Text",
 CellChangeTimes->{{3.463512860734061*^9, 
  3.463512861397346*^9}},ExpressionUUID->"08b7a586-b121-4783-b0a5-\
78db46a789d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "isfn", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"isfn", "=", 
      RowBox[{"InsetSeparationFn", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "isfn", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"isfn", "[", "0.4", "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592560272822977*^9, 3.592560306062686*^9}, {
  3.592560365270883*^9, 3.5925603742820253`*^9}},
 CellLabel->
  "In[3411]:=",ExpressionUUID->"592d5c76-71e1-47a7-89fa-4a984a18eebc"],

Cell[TextData[{
 "InsetSeparationPlot[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{min, max}, opts",
  FontSlant->"Italic"],
 "] plots the inset separation over the range {",
 StyleBox["min",
  FontSlant->"Italic"],
 ", ",
 StyleBox["max",
  FontSlant->"Italic"],
 "}. This lets us specify the exact inset distance to use in what is a \
computationally expensive calculation, MakeSimpleWovenTessellation."
}], "Text",
 CellChangeTimes->{{3.462928941321763*^9, 3.462929001917947*^9}, {
  3.462929151981067*^9, 3.462929153955909*^9}, {3.462929288220132*^9, 
  3.4629292888274946`*^9}, {3.592560639028685*^9, 3.592560639748561*^9}, {
  3.592561742662376*^9, 3.592561747550995*^9}, {3.592614393157084*^9, 
  3.592614429170466*^9}, {3.721830376786621*^9, 
  3.7218303935888033`*^9}},ExpressionUUID->"8fec302e-6451-4470-b9df-\
c97290acfca7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsetSeparationPlot", "[", 
   RowBox[{"tobj_TObj", ",", 
    RowBox[{"{", 
     RowBox[{"min_", ",", "max_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"isfn", ",", "verts", ",", "edges"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "InsetSeparationPlot"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"isfn", "=", 
      RowBox[{"InsetSeparationFn", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"isfn", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "min", ",", "max"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.462929003928843*^9, 3.462929129806184*^9}, {
   3.462929221399036*^9, 3.4629292530527687`*^9}, {3.462929291928388*^9, 
   3.462929300463252*^9}, {3.592560613162189*^9, 3.592560622004224*^9}, {
   3.592560680463879*^9, 3.592560690121937*^9}, {3.59256151040729*^9, 
   3.592561516241259*^9}, {3.592561559218162*^9, 3.592561590900694*^9}, {
   3.59261443366148*^9, 3.592614506815278*^9}, 3.592614729411179*^9, 
   3.593006102585947*^9},
 CellLabel->
