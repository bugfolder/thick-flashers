Cell[BoxData[
 RowBox[{
  RowBox[{"RecoverCurve3DSystemOld", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kp_Function", ",", "ta_Function"}], "}"}], ",", "v_Function", ",",
     "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ip", ",", "it", ",", "in", ",", "si", ",", "as", ",", "t", ",", "sfn", ",",
       "ib", ",", "dsopts", ",", "soln", ",", "tx", ",", "ty", ",", "tz", ",",
       "nx", ",", "ny", ",", "nz", ",", "bx", ",", "by", ",", "bz", ",", "cx",
       ",", "cy", ",", "cz"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ip", "=", 
      RowBox[{
       RowBox[{"InitialPosition3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"it", "=", 
      RowBox[{
       RowBox[{"InitialTangentVector3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"in", "=", 
      RowBox[{
       RowBox[{"InitialNormalVector3D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverCurve3DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"it", "=", 
      RowBox[{"NormalizeReal", "[", "it", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"in", "=", 
      RowBox[{"NormalizeReal", "[", "in", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ib", "=", 
      RowBox[{"it", "\[Cross]", "in"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Integrate", " ", "the", " ", "matrix", " ", "system"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"DSolve", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"tx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"ty", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"tz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"v", "[", "t", "]"}], 
             RowBox[{"kp", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"nx", "[", "t", "]"}], ",", 
               RowBox[{"ny", "[", "t", "]"}], ",", 
               RowBox[{"nz", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"nx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"ny", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"nz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"v", "[", "t", "]"}]}], 
              RowBox[{"kp", "[", "t", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tx", "[", "t", "]"}], ",", 
                RowBox[{"ty", "[", "t", "]"}], ",", 
                RowBox[{"tz", "[", "t", "]"}]}], "}"}]}], "+", 
             RowBox[{
              RowBox[{"v", "[", "t", "]"}], " ", 
              RowBox[{"ta", "[", "t", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"bx", "[", "t", "]"}], ",", 
                RowBox[{"by", "[", "t", "]"}], ",", 
                RowBox[{"bz", "[", "t", "]"}]}], "}"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"bx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"by", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"bz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"v", "[", "t", "]"}]}], " ", 
             RowBox[{"ta", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"nx", "[", "t", "]"}], ",", 
               RowBox[{"ny", "[", "t", "]"}], ",", 
               RowBox[{"nz", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"cx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"cy", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"cz", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"v", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "t", "]"}], ",", 
               RowBox[{"ty", "[", "t", "]"}], ",", 
               RowBox[{"tz", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tx", "[", "0", "]"}], ",", 
              RowBox[{"ty", "[", "0", "]"}], ",", 
              RowBox[{"tz", "[", "0", "]"}]}], "}"}], "\[Equal]", "it"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"nx", "[", "0", "]"}], ",", 
              RowBox[{"ny", "[", "0", "]"}], ",", 
              RowBox[{"nz", "[", "0", "]"}]}], "}"}], "\[Equal]", "in"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"bx", "[", "0", "]"}], ",", 
              RowBox[{"by", "[", "0", "]"}], ",", 
              RowBox[{"bz", "[", "0", "]"}]}], "}"}], "\[Equal]", "ib"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"cx", "[", "0", "]"}], ",", 
              RowBox[{"cy", "[", "0", "]"}], ",", 
              RowBox[{"cz", "[", "0", "]"}]}], "}"}], "\[Equal]", "ip"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tx", "[", "t", "]"}], ",", 
           RowBox[{"ty", "[", "t", "]"}], ",", 
           RowBox[{"tz", "[", "t", "]"}], ",", 
           RowBox[{"nx", "[", "t", "]"}], ",", 
           RowBox[{"ny", "[", "t", "]"}], ",", 
           RowBox[{"nz", "[", "t", "]"}], ",", 
           RowBox[{"bx", "[", "t", "]"}], ",", 
           RowBox[{"by", "[", "t", "]"}], ",", 
           RowBox[{"bz", "[", "t", "]"}], ",", 
           RowBox[{"cx", "[", "t", "]"}], ",", 
           RowBox[{"cy", "[", "t", "]"}], ",", 
           RowBox[{"cz", "[", "t", "]"}]}], "}"}], ",", "t", ",", 
         RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "DSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"RecoverCurve3DSystemOld", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"soln", "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cx", "[", "t", "]"}], ",", 
             RowBox[{"cy", "[", "t", "]"}], ",", 
             RowBox[{"cz", "[", "t", "]"}]}], "}"}], "/.", "soln"}], ",", 
          "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Curvature3D", "\[Rule]", "kp"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Torsion3D", "\[Rule]", "ta"}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"tx", "[", "t", "]"}], ",", 
             RowBox[{"ty", "[", "t", "]"}], ",", 
             RowBox[{"tz", "[", "t", "]"}]}], "}"}], "/.", "soln"}], ",", 
          "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"NormalVector3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nx", "[", "t", "]"}], ",", 
             RowBox[{"ny", "[", "t", "]"}], ",", 
             RowBox[{"nz", "[", "t", "]"}]}], "}"}], "/.", "soln"}], ",", 
          "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"BinormalVector3D", "\[Rule]", 
        RowBox[{"FunctionizeOld", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"bx", "[", "t", "]"}], ",", 
             RowBox[{"by", "[", "t", "]"}], ",", 
             RowBox[{"bz", "[", "t", "]"}]}], "}"}], "/.", "soln"}], ",", 
          "t"}], "]"}]}]}], "}"}]}]}], "]"}]}]], "Input",
