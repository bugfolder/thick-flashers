   3.719934071436253*^9}},ExpressionUUID->"61e73b64-42ca-46a1-b407-\
7582aac6b0ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherXYFns", "[", 
   RowBox[{"vars_", ",", "r_", ",", "h_", ",", "m_", ",", "dr_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "ffrules", ",", "fsv", ",", "fsvn"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ffrules", "=", 
      RowBox[{"FlasherDefaultFFRules", "[", 
       RowBox[{"pp", ",", "h", ",", "m", ",", "dr"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fsv", "=", 
      RowBox[{"FlasherFirstSectorVertices", "[", 
       RowBox[{"pp", ",", "r", ",", "h"}], "]"}]}], ";", 
     RowBox[{"(*", " ", "vertices", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fsvn", "=", 
      RowBox[{"fsv", "/.", "ffrules"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"desired", " ", "values"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"FlasherScalarize", "[", 
           RowBox[{"vars", ",", "fsv", ",", "m"}], "]"}], "]"}], "-", 
         "fsvn"}], ")"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555770401924124*^9, 3.555770415047363*^9}, {
   3.5557704496843853`*^9, 3.555770496762341*^9}, {3.555770528727864*^9, 
   3.555770589295057*^9}, {3.555770640890703*^9, 3.5557706510349293`*^9}, {
