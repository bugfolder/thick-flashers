Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "angles", ",", "w", ",", "\[Tau]", ",", "types1", ",", "types2", ",", 
      "tiling"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"50", "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}], ",", 
        RowBox[{"70", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"80", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types1", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "M"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types2", "=", 
      RowBox[{"{", 
       RowBox[{"V", ",", "V", ",", "V"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
           "UnitTriangleCenteredTwistTile", ",", "angles", ",", "w", ",", 
            "\[Tau]", ",", "types1"}], "}"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
