   RowBox[{"Options", "[", "FoldedFormPolys", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PaperFill", "\[Rule]", "PaperWhiteSideFill"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
