Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "tobj", ",", "tobjdp", ",", "cr", ",", 
     "eins", ",", "einsdp", ",", "cyls", ",", "cylsdp"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"cr", "=", 
     RowBox[{"0.4", "t"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Stowed", " ", "form"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eins", ",", "einsdp"}], "}"}], "=", 
     RowBox[{"ThickFlasherCylindricallySafeInsetEdges", "[", 
      RowBox[{"tobj", ",", "cr"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cyls", "=", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Cylinder", "[", 
          RowBox[{"#", ",", "cr"}], "]"}], "&"}], "/@", "eins"}], ",", 
       "Orange"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cylsdp", "=", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Cylinder", "[", 
          RowBox[{"#", ",", "cr"}], "]"}], "&"}], "/@", "einsdp"}], ",", 
       "Orange"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{
                  RowBox[{"tobj", "[", "Vertices3D", "]"}], "\[LeftDoubleBracket]",
                   "#", "\[RightDoubleBracket]"}], "]"}], "&"}], "/@", 
               RowBox[{"tobj", "[", "Faces", "]"}]}], ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", "cyls"}], 
           "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Polygon", "[", 
                 RowBox[{
                  RowBox[{"tobjdp", "[", "Vertices3D", "]"}], "\[LeftDoubleBracket]",
                   "#", "\[RightDoubleBracket]"}], "]"}], "&"}], "/@", 
               RowBox[{"tobjdp", "[", "Faces", "]"}]}], ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", "cylsdp"}], 
           "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Print"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
