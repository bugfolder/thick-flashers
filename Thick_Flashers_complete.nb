         RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2"}], "}"}], "]"}], ",", "Red"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Point", "[", "q1", "]"}], ",", 
             RowBox[{"Point", "[", "q2", "]"}]}], "}"}], ",", 
           RowBox[{"Darker", "[", "Red", "]"}], ",", 
           RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
