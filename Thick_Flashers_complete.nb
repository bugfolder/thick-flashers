             RowBox[{"Text", "[", 
              RowBox[{"\"\<q1\>\"", ",", "q1", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
