   3.707905255537019*^9},ExpressionUUID->"147c9fb6-072f-4b89-84b4-\
80ae35bf3902"],

Cell[TextData[{
 "MergeGraph2DAssigneds[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of Graph2DAssigned that have vertices in common and returns \
a single TGraphAssigned in which the individual TGraphs are merged into a \
single TGraph."
}], "Text",
 CellChangeTimes->{{3.649888922203361*^9, 3.649888943356659*^9}, {
   3.64988898857837*^9, 3.649889043743241*^9}, {3.649889126393442*^9, 
