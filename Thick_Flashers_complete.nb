Cell["Example.", "Text",
 CellChangeTimes->{{3.59285566054122*^9, 3.592855668403802*^9}, {
  3.592857924264883*^9, 3.592857924685048*^9}, {3.643238508141679*^9, 
  3.643238508565742*^9}},ExpressionUUID->"1166c0aa-6409-40b8-b393-\
e8e915a3bddb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", 
       RowBox[{"AddTCornerIndices", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "3"}], "}"}]}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ColumnForm", "[", 
      RowBox[{"GetAllRules", "[", "tobj", "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592489167995578*^9, 3.592489266449102*^9}, 
   3.592660643499117*^9, 3.592670434896594*^9, 3.592670630166175*^9, 
   3.592671069194716*^9, 3.5928288635954227`*^9, {3.592854315847213*^9, 
   3.592854322431271*^9}, {3.592857934081427*^9, 3.592857941656533*^9}, 
   3.628786728295917*^9, 3.6287867957332*^9, 3.643238129938642*^9, {
   3.643238497465494*^9, 3.643238533790183*^9}},
 CellLabel->
  "In[2064]:=",ExpressionUUID->"cd60d25e-6c68-4e57-b3c5-cd9222705792"]
}, Closed]]
}, Closed]],

