   3.592441046531357*^9}},ExpressionUUID->"48434164-556c-43ff-9bf0-\
a828ef1bfd54"],

Cell[TextData[{
 "DropOrphanVertices[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph, drops vertices that don't have any edges connected to \
them, and renumbers the vertices and edges, returning a new ",
 "TGraph",
 " containing new lists of vertices and edges."
}], "Text",
 CellChangeTimes->{{3.457624165219461*^9, 3.4576242202710857`*^9}, {
  3.591649209575597*^9, 3.5916492395084467`*^9}, {3.592349668380108*^9, 
  3.592349681827263*^9}, {3.592349718320083*^9, 3.5923497186642237`*^9}, {
  3.592435848057706*^9, 
  3.592435848151106*^9}},ExpressionUUID->"50df8d01-48d8-4ee3-af83-\
28dd446c9590"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DropOrphanVertices", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "vrefs", ",", "vmap", ",", "iv", ",", 
      "newverts", ",", "newedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "DropOrphanVertices"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vrefs", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Flatten", "[", "edges", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vmap", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"iv", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"vrefs", ",", "i"}], "]"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"vmap", ",", 
            RowBox[{"i", "\[Rule]", "iv"}]}], "]"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"newverts", ",", 
            RowBox[{
            "verts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
            "]"}], ";", 
          RowBox[{"iv", "++"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newedges", "=", 
      RowBox[{"edges", "/.", "vmap"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"newverts", ",", "newedges"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.457624301628048*^9, 3.457624334575203*^9}, {
   3.45762447703014*^9, 3.4576245017540493`*^9}, {3.457624543288497*^9, 
   3.457624774805174*^9}, 3.466261501032315*^9, 3.484834016534699*^9, {
   3.591649315949452*^9, 3.591649412328117*^9}, {3.591649536049404*^9, 
   3.591649536820366*^9}, {3.592349758677003*^9, 3.592349792930048*^9}, 
   3.592435738211606*^9, 3.5924358482431993`*^9, {3.592441049127002*^9, 
   3.592441070710721*^9}, 3.593006101299827*^9},
 CellLabel->
  "In[1107]:=",ExpressionUUID->"c8eccae9-2edf-455f-86a3-4bb19093afbe"],

