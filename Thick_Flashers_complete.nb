Cell[CellGroupData[{

Cell["Reparameterizing curves", "Subsection",
 CellChangeTimes->{{3.69158016709494*^9, 
  3.69158017086007*^9}},ExpressionUUID->"fbbf0d74-d503-476c-b033-\
cc1a06c4f870"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.691598452191948*^9, 
  3.6915984526614656`*^9}},ExpressionUUID->"44ac965a-1d5b-4221-b173-\
ebd2a70dddb6"],

Cell["\<\
In cases where we want to match 2D and 3D curves, the two curves to match \
must have the same curve speed. Or we might want unit-speed curves. In either \
case, we need to compute curve speeds and reparameterize curves based on \
their speed. These functions support that.\
\>", "Text",
 CellChangeTimes->{{3.69159845476462*^9, 
  3.691598514501677*^9}},ExpressionUUID->"4b38b934-ca88-4d1a-aa84-\
8f9f70030ed1"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "CurveSpeed[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions"
}], "Subsubsection",
 CellChangeTimes->{{3.69159826058912*^9, 
  3.691598270847945*^9}},ExpressionUUID->"13f144ea-5343-4d1f-ab55-\
ea44a9f3e775"],

Cell[TextData[{
 "CurveSpeed[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] computes the speed of a curve."
}], "Text",
 CellChangeTimes->{{3.691580240584978*^9, 3.6915802790773783`*^9}, {
  3.691580451784436*^9, 3.691580452377629*^9}, {3.6915813455875597`*^9, 
  3.691581350650943*^9}, {3.691581429459126*^9, 3.69158143739536*^9}, {
  3.691598286053751*^9, 
  3.6915983104337177`*^9}},ExpressionUUID->"7937e4f3-16c3-4519-b950-\
dc9b89c18a11"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] the curve as a vector-valued pure function, could be 2D or \
3D."
}], "Text",
 CellChangeTimes->{{3.691580289272049*^9, 3.69158032759784*^9}, {
  3.6915813570112767`*^9, 3.691581366544193*^9}, {3.691581441891892*^9, 
  3.691581445413598*^9}, {3.691598312668149*^9, 
  3.691598317897519*^9}},ExpressionUUID->"f76807af-cfc2-4a5e-950e-\
0ca9c43d7ba2"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
  3.691235123137779*^9, 
  3.691235148876122*^9}},ExpressionUUID->"d8941111-a1cb-4458-b9d5-\
a150ffd003ab"],

Cell["Returns: the curve speed function.", "Text",
 CellChangeTimes->{{3.691580464686341*^9, 3.6915804751913853`*^9}, {
  3.691598323976247*^9, 
  3.691598326279619*^9}},ExpressionUUID->"c5705031-26b2-4353-a50e-\
06b36f1219ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CurveSpeed", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.691580406330134*^9, 3.691580428135356*^9}, 
   3.69159833779921*^9},
 CellLabel->
  "In[3716]:=",ExpressionUUID->"67bca866-9964-473d-ba1f-e97d8ccd4040"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CurveSpeed", "[", 
   RowBox[{"c_Function", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"si", ",", "as", ",", "sfn", ",", "dc", ",", "s"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CurveSpeed", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CurveSpeed", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Functionize", "[", 
      RowBox[{"s", ",", 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"dc", "[", "s", "]"}], "]"}], "//", "sfn"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.691598348204551*^9, 3.691598434837747*^9}, 
   3.798622844652083*^9, {3.800211305191303*^9, 3.800211368267762*^9}, {
   3.800211405669875*^9, 3.8002114363889627`*^9}},
 CellLabel->
  "In[3717]:=",ExpressionUUID->"0374feb7-d63c-4caf-b9bd-8e9cda6d596e"],

