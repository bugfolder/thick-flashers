   3.668498851564069*^9, 3.668498877631831*^9}, {3.66849893608141*^9, 
   3.668498951774135*^9}, {3.6684989892760983`*^9, 3.668499125616729*^9}, {
   3.6684991971443*^9, 3.668499260081471*^9}, {3.6684993065987186`*^9, 
