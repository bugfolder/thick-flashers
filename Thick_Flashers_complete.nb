   RowBox[{"tiletype_", ",", "decorations_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"RenderTile", "[", 
     RowBox[{"tiletype", ",", "#", ",", "opts"}], "]"}], "&"}], "/@", 
   "decorations"}]}]], "Input",
