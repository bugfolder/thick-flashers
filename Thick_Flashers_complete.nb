Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwoColorGraph", "::", "vertdeg"}], 
   "=", "\"\<The interior vertices of the graph do not all have even \
degree.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.484779154346143*^9, 3.484779211831388*^9}, 
   3.484829075176518*^9, 3.592828712576893*^9, 3.592859456993633*^9},
 CellLabel->
  "In[1202]:=",ExpressionUUID->"c3e30827-cc2d-45cb-b199-c1e460b9ada8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoColorGraph", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"edges", ",", "faces", ",", "sf", ",", "pedges", ",", "dedges"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "TwoColorGraph"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sf", "=", 
      RowBox[{
       RowBox[{"StartFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TwoColorGraph", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"TwoColorableGraphQ", "[", 
         RowBox[{"edges", ",", "faces"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"TwoColorGraph", "::", "vertdeg"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pedges", ",", "dedges"}], "}"}], "=", 
      RowBox[{"OrientedInteriorEdgePairs", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sign", "[", "sf", "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "#"]}], "&"}], "/@", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{
        RowBox[{"Graph", "[", "dedges", "]"}], ",", 
        RowBox[{"Abs", "[", "sf", "]"}]}], "]"}]}]}]}], "]"}]}]], "Input",
