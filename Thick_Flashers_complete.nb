Cell[BoxData[
 RowBox[{
  RowBox[{"StyledCurvedFoldBounded", "[", 
   RowBox[{
    RowBox[{"f_Function", "|", "f_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"bl_Function", "|", "bl_InterpolatingFunction"}], ",", 
      RowBox[{"br_Function", "|", "br_InterpolatingFunction"}]}], "}"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"u0_", ",", " ", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fls", ",", "rlls", ",", "rlrs", ",", "blls", ",", "blrs"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fls", "=", 
      RowBox[{
       RowBox[{"FoldLineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurvedFoldBounded", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rlls", "=", 
      RowBox[{
       RowBox[{"RulingLineLeftStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurvedFoldBounded", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rlrs", "=", 
      RowBox[{
       RowBox[{"RulingLineRightStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurvedFoldBounded", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"blls", "=", 
      RowBox[{
       RowBox[{"BoundaryLineLeftStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurvedFoldBounded", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"blrs", "=", 
      RowBox[{
       RowBox[{"BoundaryLineRightStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledCurvedFoldBounded", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"StyledRuledPatchSequence", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bl", ",", "f", ",", "br"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], ",", 
       RowBox[{"RulingLineStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"rlls", ",", "rlrs"}], "}"}]}], ",", 
       RowBox[{"TransverseLineStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"blls", ",", "fls", ",", "blrs"}], "}"}]}], ",", "opts"}], 
      "]"}]}]}], "]"}]}]], "Input",
