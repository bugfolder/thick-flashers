Cell[TextData[{
 "Styled2DAxes[{",
 StyleBox["xmin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xmax",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["ymin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ymax",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a list of Graphics primitives that render 2D axes. "
}], "Text",
 CellChangeTimes->{{3.672715188049601*^9, 3.672715272110371*^9}, {
   3.688989024889936*^9, 3.688989034272901*^9}, {3.688989067073591*^9, 
   3.688989067212344*^9}, {3.68899652200963*^9, 3.6889965745648603`*^9}, {
   3.688996614939123*^9, 3.688996641172966*^9}, {3.688996800814582*^9, 
   3.6889968699349346`*^9}, {3.688996903523241*^9, 3.6889969310818644`*^9}, {
   3.688996968130826*^9, 3.68899697523712*^9}, 3.689001935553639*^9, {
   3.689001973361155*^9, 3.689001976998102*^9}, {3.689867868867279*^9, 
   3.689867887648625*^9}, 
   3.7981344671705*^9},ExpressionUUID->"6a5a3309-5ba8-414c-8879-3eb5c0fd842b"],

Cell[TextData[{
 "Options:\n\tAxesThickness2D \[Rule] ",
 StyleBox["th",
  FontSlant->"Italic"],
 ", specifies the thickness of the axes.\n\tAxesArrowheads \[Rule] ",
 StyleBox["size",
  FontSlant->"Italic"],
 ", specifies the size of the arrowhead relative to the width of the graphic.\
\n\tAxesColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color of the axes.\n\tAxesLabelStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", specifies the text style for the axes labels.\n\tAxesLabel \[Rule] {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 "}, labels to put at the end of the positive-pointing axes (same option as \
in Graphics)\n\tAxesLabelPosition \[Rule] {{",
 StyleBox["x1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["x2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y2",
  FontSlant->"Italic"],
 "}}, relative positions passed to Text[] to specify the positions of the \
labels."
}], "Text",
 CellChangeTimes->{{3.798134469209214*^9, 3.798134527152993*^9}, 
   3.799608963395329*^9, 
   3.799956718348644*^9},ExpressionUUID->"f3d5f9f2-1bdf-4f22-8a9b-\
b6f0f9243a76"],

Cell["Returns: a list of Graphics elements.", "Text",
 CellChangeTimes->{{3.798134477017314*^9, 
  3.798134483103513*^9}},ExpressionUUID->"acff0648-7711-44f0-9d6f-\
0dbeaa396787"],

Cell[TextData[{
 "Styled2DAxes[",
 StyleBox["xmax",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ymax",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a list of Graphics primitives that render 2D axes, emanating \
from the origin. "
}], "Text",
 CellChangeTimes->{
  3.68986786234921*^9, {3.689867894737546*^9, 
   3.689867902413341*^9}},ExpressionUUID->"9a24a188-5a73-4e20-9f91-\
bac24941cc9c"],

Cell[TextData[{
 "Styled2DAxes[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces a list of Graphics primitives that render 2D axes, emanating \
from the origin of unit length."
}], "Text",
 CellChangeTimes->{
  3.68986786234921*^9, {3.689867894737546*^9, 
   3.6898679273952217`*^9}},ExpressionUUID->"50101c6e-3a53-4eb0-8f57-\
99de19a730e4"],

Cell[TextData[{
 "Use this when we want a more schematic form of axes without the tics from \
the default ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " axes."
}], "Text",
 CellChangeTimes->{{3.688989069493427*^9, 
  3.688989093516543*^9}},ExpressionUUID->"b1bfea33-42fe-40ea-988a-\
f896c8299f8d"],

