   3.8035695755218782`*^9, 3.803569902501443*^9}, {3.8035699550148168`*^9, 
   3.803569982108884*^9}, {3.803570030519384*^9, 3.803570037375047*^9}, {
   3.803570140792815*^9, 3.803570141061536*^9}, {3.803570183712444*^9, 
   3.803570371151293*^9}, 3.803571239783009*^9, 3.803573209625577*^9, {
   3.803573310259274*^9, 3.803573310260467*^9}, {3.803574620257079*^9, 
   3.803574682877754*^9}, {3.8035747432631817`*^9, 3.803574940499419*^9}, {
   3.803575020491493*^9, 3.803575075472946*^9}, {3.803575124468989*^9, 
   3.80357522988242*^9}, {3.803575273637097*^9, 3.803575381635523*^9}, {
   3.803578930279647*^9, 3.803578938710693*^9}, {3.8035799978964*^9, 
   3.803579998341617*^9}, {3.803583444786153*^9, 3.803583445028113*^9}, {
   3.803597883401827*^9, 3.803597980273053*^9}, {3.803598061104992*^9, 
