Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SurfaceNormalFromSurface", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SurfaceOrientation", "\[Rule]", "1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.672061731527852*^9, 3.672061778834166*^9}, 
   3.672061846313052*^9, 3.672061878015157*^9, 3.690988493890079*^9, 
   3.6912416500554657`*^9, 3.691505396803813*^9, 3.691505452184478*^9, {
   3.797258041800178*^9, 3.7972580464880857`*^9}, 3.797258080825163*^9},
 CellLabel->
  "In[3742]:=",ExpressionUUID->"54549cab-6416-4e34-a6b8-688cc35d75ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SurfaceNormalFromSurface", "[", 
   RowBox[{"ss_Function", ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "so", ",", "si", ",", "as", ",", "u", ",", "v", ",", "sfn", ",", "su", ",",
       "sv", ",", "uu"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"so", "=", 
      RowBox[{
       RowBox[{"SurfaceOrientation", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SurfaceNormalFromSurface", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SurfaceNormalFromSurface", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SurfaceNormalFromSurface", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "\[Element]", "Reals"}], ",", 
           RowBox[{"v", "\[Element]", "Reals"}]}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"su", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"ss", "[", 
          RowBox[{"u", ",", "v"}], "]"}], ",", "u"}], "]"}], "//", "sfn"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sv", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"ss", "[", 
          RowBox[{"u", ",", "v"}], "]"}], ",", "v"}], "]"}], "//", "sfn"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"su", "\[Cross]", "sv"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"so", " ", 
        RowBox[{"uu", "/", 
         RowBox[{"Mag", "[", "uu", "]"}]}]}], "//", "sfn"}]}], ";", 
