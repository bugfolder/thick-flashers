   3.799490125693174*^9}},ExpressionUUID->"e8fc5ff0-4d54-441a-8710-\
2366823f113d"],

Cell[TextData[{
 "NCurve2DSystem[",
 StyleBox["cc",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a curve system using InterpolatingFunctions over the domain {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}. ",
 StyleBox["cc",
  FontSlant->"Italic"],
 " should be a vector-valued function, either analytic or based on \
InterpolatingFunctions over the same domain. "
}], "Text",
 CellChangeTimes->{{3.691192227763728*^9, 3.6911923135385237`*^9}, 
   3.691192358189658*^9, {3.691200594114738*^9, 3.691200625681141*^9}, 
   3.691252522151187*^9, 3.691256500472389*^9, 3.691505347442335*^9, {
   3.799490120200747*^9, 
   3.799490125735413*^9}},ExpressionUUID->"84898c67-b811-4f39-b3ed-\
7057150643b7"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that gives a vector-valued curve (could \
contain InterpolatingFunctions).\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.691256507766392*^9, 3.691256580203262*^9}, {
  3.799490120226139*^9, 3.799490125751071*^9}, {3.7994904122087193`*^9, 
  3.7994904149132*^9}},ExpressionUUID->"0f0d3ec7-61ce-4971-b7c8-46a6908ed453"],

Cell["\<\
Options:
\tOptions[FunctionInterpolation] are passed through.\
\>", "Text",
 CellChangeTimes->{{3.691256503745596*^9, 
  3.691256505731749*^9}},ExpressionUUID->"79c2519c-f823-4cfc-9bff-\
1994729f2598"],

Cell["\<\
Returns: a list of rules giving pure functions for vectors and \
InterpolatingFunctions for scalar fields of the plane curve.\
\>", "Text",
 CellChangeTimes->{{3.691256589686189*^9, 
  3.69125664256*^9}},ExpressionUUID->"8e28a1ed-f996-4292-862a-3a991de1f516"],

Cell["\<\
The order of construction and subexpressions are chosen to allow Mathematica \
to apply derivatives to InterpolatingFunction objects while minimizing the \
number of InterpolatingFunction evaluations required for each function \
evaluation.\
\>", "Text",
 CellChangeTimes->{{3.79985786142257*^9, 
  3.799857958310246*^9}},ExpressionUUID->"1d1ba4df-7d8b-440f-9595-\
fad59e52f4a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "Curve2DSystem", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.799486724982356*^9, 3.799486753025183*^9}, 
   3.799488263328748*^9, 3.799490874190533*^9},
 CellLabel->
  "In[3628]:=",ExpressionUUID->"74fec5a4-47e7-4a0f-8d6e-218d6f9a18fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NCurve2DSystem", "[", 
   RowBox[{
    RowBox[{"c_Function", "|", "c_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "dc", ",", "ds", ",", "t", ",", "l", ",", "rdc", ",", "ddc", ",",
       "\[Kappa]", ",", "n", ",", "\[Kappa]l"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"Mag", "[", 
         RowBox[{"dc", "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"dc", "[", "s", "]"}], 
         RowBox[{"ds", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rdc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", 
         RowBox[{"dc", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ddc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"dc", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"rdc", "[", "s", "]"}], 
         RowBox[{"ds", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{
          RowBox[{"ddc", "[", "s", "]"}], ".", 
          RowBox[{"rdc", "[", "s", "]"}]}], 
         SuperscriptBox[
          RowBox[{"ds", "[", "s", "]"}], "3"]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"ddc", "[", "s", "]"}], ".", 
           RowBox[{"rdc", "[", "s", "]"}]}], "]"}], 
         SuperscriptBox[
          RowBox[{"ds", "[", "s", "]"}], "3"]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"ddc", "[", "s", "]"}], ".", 
           RowBox[{"rdc", "[", "s", "]"}]}], "]"}], 
         FractionBox[
          RowBox[{"rdc", "[", "s", "]"}], 
          RowBox[{"ds", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve2D", "\[Rule]", "c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed2D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"ds", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"LeftCurvature2D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"\[Kappa]l", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"Curvature2D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"\[Kappa]", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector2D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"t", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"LeftNormalVector2D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"NormalVector2D", "\[Rule]", 
        RowBox[{"FunctionInterpolationAlt", "[", 
         RowBox[{
          RowBox[{"n", "[", "s", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], 
         "]"}]}]}], "\[IndentingNewLine]", "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.668362892429557*^9, 3.66836289243172*^9}, {
