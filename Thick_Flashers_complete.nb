Cell[CellGroupData[{

Cell[TextData[{
 "MakeRotationalMesh",
 "[",
 StyleBox["nr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["na",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vfn",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HorizontalEdgeTypeFn, VerticalEdgeTypeFn, BorderOverride, \
IncludeCenter"
}], "Subsubsection",
 CellChangeTimes->{
  3.5940575348482733`*^9, {3.594057742206872*^9, 3.594057745436277*^9}, {
   3.594059028251216*^9, 3.594059032449527*^9}, {3.594060037155455*^9, 
   3.594060109716538*^9}, {3.594061004948015*^9, 3.594061011722224*^9}, 
   3.5940697716778*^9, 3.5940708329072857`*^9, {3.59407114841498*^9, 
   3.594071152051578*^9}, {3.5950002109445343`*^9, 3.595000234224078*^9}, 
   3.595286134538072*^9, 3.617444348822513*^9, 
   3.617444407070068*^9},ExpressionUUID->"304d10e5-3b20-475f-8ec4-\
e2c0ce691f50"],

Cell[TextData[{
 "MakeRotationalMesh",
 "[",
 StyleBox["nr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["na",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vfn",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a rotational crease-assigned quad mesh that is ",
 StyleBox["nr",
  FontSlant->"Italic"],
 " vertices outward (radially) and ",
 StyleBox["na",
  FontSlant->"Italic"],
 " vertices around (axially). all the facets are quads except the central \
facet, which is an ",
 StyleBox["na",
  FontSlant->"Italic"],
 "-gon, or if IncludeCenter\[Rule]True, the center is divided into triangles. \
",
 StyleBox["vfn",
  FontSlant->"Italic"],
 " is a function that returns the coordinates of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}th vertex as the value of ",
 StyleBox["vfn[i,j]",
  FontSlant->"Italic"],
 ". Radial number ",
 StyleBox["j",
  FontSlant->"Italic"],
 " starts from 0 (if IncludeCenter \[Rule] True), otherwise from 1, and runs \
to ",
 StyleBox["nr",
  FontSlant->"Italic"],
 ". Axial numbering runs ",
 StyleBox["i",
  FontSlant->"Italic"],
 "=0...",
 StyleBox["na",
  FontSlant->"Italic"],
 "-1. It returns a TGraphAssigned of Vertices, Edges, and EdgeTypes (but no \
Faces). Options are:\n\tRadialEdgeFn \[Rule] ",
 StyleBox["erfn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["erfn[i,j]",
  FontSlant->"Italic"],
 " returns the type of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}\[Theta] radial edge. Default is unassigned (U).\n\tAxialEdgeFn \[Rule] ",
 StyleBox["eafn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["eafn[i,j]",
  FontSlant->"Italic"],
 " returns the type of the {i,j}\[Theta] axial edge. Default is unassigned \
(U).\n\tBorderOverride \[Rule] True | False, where True overrides ",
 StyleBox["erfn",
  FontSlant->"Italic"],
 " and ",
 StyleBox["eafn",
  FontSlant->"Italic"],
 " and makes the outermost edge lines of type B.\n\tIncludeCenter \[Rule] \
True | False, where True adds a vertex in the center (at ",
 StyleBox["i",
  FontSlant->"Italic"],
 "=0). ",
 StyleBox["vfn",
  FontSlant->"Italic"],
 "[0,",
 StyleBox[" j",
  FontSlant->"Italic"],
 "] should return the coordinate value independent of ",
 StyleBox["j",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.594057330456885*^9, 3.594057530001993*^9}, {
   3.5940577493961577`*^9, 3.594057837246922*^9}, {3.594058669922537*^9, 
   3.594058702031582*^9}, {3.594058863590161*^9, 3.594058875059916*^9}, 
   3.594059039588849*^9, {3.594059172426364*^9, 3.594059189175597*^9}, 
