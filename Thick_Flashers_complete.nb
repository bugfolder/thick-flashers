Cell[BoxData[
 RowBox[{
  RowBox[{"ShowTGraphExample", "[", "name_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"ToExpression", "[", "name", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj", ",", "TGraph"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"ShowTGraphExample", "::", "badnam"}], ",", "name"}], "]"}],
         ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ShowTGraphExample", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"PlotLabel", "\[Rule]", "name"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.719615365779951*^9, 3.719615443760717*^9}, {
