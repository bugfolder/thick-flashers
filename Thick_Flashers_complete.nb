Cell[TextData[{
 "GetValue[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["property",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the value of the specified property. Default behavior checks for \
existence and throws an error if the property is missing, but you can \
override this by supplying the option CheckProperty\[Rule]False, in which \
case if the property is missing, its name is returned."
}], "Text",
 CellChangeTimes->{{3.591646765852274*^9, 3.5916467925453467`*^9}, {
  3.591646855238255*^9, 3.591646917618237*^9}, {3.591647052242049*^9, 
