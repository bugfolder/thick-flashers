Cell[CellGroupData[{

Cell["3D-printed bendy-hinge thick flasher construction", "Subsection",
 CellChangeTimes->{{3.912005189812814*^9, 3.9120052048477707`*^9}, {
  3.9124269102583423`*^9, 3.912426911511031*^9}, {3.913553828957631*^9, 
  3.913553831069303*^9}, {3.9348333134282*^9, 
  3.934833315002802*^9}},ExpressionUUID->"1bdff99d-5307-465a-bc2c-\
d1ec7f805c3c"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.914838669914978*^9, 
  3.9148386703655853`*^9}},ExpressionUUID->"64659102-bd6e-463a-a1ed-\
7c5da66544c6"],

Cell[TextData[{
 "The typical workflow for creating a 3D-printable flasher would be:\n\t\
First, use MakeThickFlasher to construct the TGraph3DAssigned, which \
represents the ETZ surface (and is sized so that the central polygon \
circumscribes a unit circle).\n\tNext, use MakeThickFlasherPanels to \
construct the ",
 StyleBox["panels",
  FontSlant->"Italic"],
 " and ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", using the FlasherScale option to set the desired size.\n\tLast, use \
ThickFlasherStowedHingeJoinPanels (for stowed form) or HingeJoinPanels (for \
deployed form) to inset the panels and add hinges. Use the HingeShift \[Rule] \
True option to keep top and bottom hinges from poking out of their respective \
panels."
}], "Text",
 CellChangeTimes->{{3.911994518914768*^9, 3.9119946882547894`*^9}, {
   3.91200552958985*^9, 3.9120055311404467`*^9}, 3.912862386011409*^9, 
   3.913296262753651*^9, {3.913554240588906*^9, 3.913554243658702*^9}, {
   3.915803991241503*^9, 3.915804015361039*^9}, {3.917287293668453*^9, 
   3.9172873004275417`*^9}, {3.917287415278008*^9, 3.917287433399988*^9}, {
   3.917363042500029*^9, 3.917363098093273*^9}, 3.9225521467353168`*^9, 
   3.923906933469063*^9, {3.923907299439896*^9, 3.9239073111179647`*^9}, {
   3.923907528760776*^9, 
   3.92390755141969*^9}},ExpressionUUID->"8cd2605d-9070-4361-bf70-\
bfa4aafea7d8"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
CentralHingeThickness
AngledHingeThickness
CentralPolygonPreshift\
\>", "Subsubsection",
 CellChangeTimes->{{3.92390735989778*^9, 3.9239073852991343`*^9}, {
   3.9353995309016123`*^9, 3.9353995349338303`*^9}, {3.935775809589333*^9, 
   3.935775817513547*^9}, {3.935775926854703*^9, 3.935775938247902*^9}, 
   3.937485930417157*^9},ExpressionUUID->"92488679-7b26-4ed0-902a-\
a2cff0e73dbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CentralHingeThickness", "::", "usage"}], 
   "=", "\"\<CentralHingeThickness is an option to \
ThickFlasherStowedHingeJoinPanels that specifies the thickness for the hinges \
around the central polygon.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9225661584482193`*^9, 3.922566192505353*^9}},
 CellLabel->
  "In[4536]:=",ExpressionUUID->"4d8a844c-c898-4a31-a3da-7ef51d40c59e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OuterHingeThickness", "::", "usage"}], 
   "=", "\"\<OuterHingeThickness is an option to \
ThickFlasherStowedHingeJoinPanels that specifies the thickness for the hinges \
around everything except the central polygon.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9225661584482193`*^9, 3.9225662129575*^9}},
 CellLabel->
  "In[4537]:=",ExpressionUUID->"742dd864-cef1-43fd-a6c0-647ed65a3637"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AngledHingeThickness", "::", "usage"}], 
   "=", "\"\<AngledHingeThickness is an option to \
ThickFlasherStowedHingeJoinPanels that specifies the minimum and maximum \
thicknesses for hinges based on angle.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9225661584482193`*^9, 3.9225662129575*^9}, {
  3.935775829320568*^9, 3.9357758451473417`*^9}, {3.935775933618206*^9, 
  3.935775949632053*^9}},
 CellLabel->
  "In[4538]:=",ExpressionUUID->"e8907f0f-8639-430f-bbd3-99a6c86f417c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CentralPolygonPreshift", "::", "usage"}], 
   "=", "\"\<CentralPolygonPreshift is an option to \
ThickFlasherStowedHingeJoinPanels that specifies an upward shift of the \
central polygon to be applied prior to joining with hinges. This compensates \
for insetting the bottom of its adjacent panels\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9225661584482193`*^9, 3.9225662129575*^9}, {
  3.935399549640973*^9, 3.935399599162546*^9}},
 CellLabel->
  "In[4539]:=",ExpressionUUID->"0d98fbf9-0321-4103-8bbe-b48a14fc57db"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherStowedHingeJoinPanels[",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PanelClearance, PanelMinThickness, CentralHingeThickness, \
AngledHingeThickness, CentralPolygonPreshift, Options[HingeJoinPanels]"
}], "Subsubsection",
 CellChangeTimes->{{3.922557628219519*^9, 3.92255764678004*^9}, {
  3.922557850229174*^9, 3.9225578511407824`*^9}, {3.923907318519951*^9, 
  3.923907340209713*^9}, {3.926582389237252*^9, 3.926582392402144*^9}, {
  3.935399606333509*^9, 3.935399608017702*^9}, {3.9357761405719147`*^9, 
  3.9357761456917353`*^9}, {3.9374859331378193`*^9, 
  3.9374859744349327`*^9}},ExpressionUUID->"518fe3e7-3335-4cb4-8939-\
c745d44fc8bf"],

Cell[TextData[{
 "ThickFlasherStowedHingeJoinPanels[",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] is a modified version of HingeJoinPanels that makes some tweaks to the \
stowed form to improve 3D printing before and after generating the hinges."
}], "Text",
 CellChangeTimes->{{3.922557662542322*^9, 3.92255769705266*^9}, {
   3.9225577296773*^9, 3.922557741515873*^9}, 
   3.9225581771060038`*^9},ExpressionUUID->"abec763c-19c3-43c3-9b42-\
c20a8d760308"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["panels",
  FontSlant->"Italic"],
 " \[LongDash] the list of panels typically scaled to real-world dimensions;\n\
\t",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " \[LongDash] a structured list of index information described below.\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TGraph3DAssigned that describes the embedded zero-thickness \
surface."
}], "Text",
 CellChangeTimes->{{3.911994124360935*^9, 3.911994261392596*^9}, {
  3.912005424921616*^9, 3.912005481584758*^9}, {3.913296349143371*^9, 
  3.913296399189253*^9}, {3.914838749094984*^9, 
  3.9148387911710997`*^9}},ExpressionUUID->"fc189b1e-f22c-4c78-95cd-\
d24d133f036e"],

Cell[TextData[{
 "Options:\n\tPanelClearance \[Rule] ",
 StyleBox["pc",
  FontSlant->"Italic"],
 ", the desired clearance between panels (should be the same value passed to \
MakeThickFlasherPanels).\n\tPanelMinThickness \[Rule] ",
 StyleBox["pmt",
  FontSlant->"Italic"],
 ", the minimum thickness of the triangular panels (blunting the \
\[OpenCurlyDoubleQuote]knife-edge\[CloseCurlyDoubleQuote]).\n\t\
CentralHingeThickness \[Rule] Automatic | c",
 StyleBox["ht",
  FontSlant->"Italic"],
 ", the desired thickness of hinge for the central polygon hinges.\n\t\
AngledHingeThickness \[Rule] None | {",
 StyleBox["tmin, tmax}",
  FontSlant->"Italic"],
 ", the minimum and maximum desired hinge thickness varying with angle.\n\t\
CentralPolygonPreshift \[Rule] ",
 StyleBox["cpp",
  FontSlant->"Italic"],
 ", the distance to shift the central polygon upward to compensate for \
InsetBottomFaceUpwardGC.\n\tOptions[HingeJoinPanels] are passed through."
}], "Text",
 CellChangeTimes->{{3.912178020781704*^9, 3.91217811562254*^9}, {
   3.912178148694954*^9, 3.912178179581933*^9}, {3.912178359190773*^9, 
   3.912178368967973*^9}, {3.912251327729396*^9, 3.912251347974477*^9}, {
   3.912251849396229*^9, 3.912251849462622*^9}, 3.913554187708951*^9, 
   3.913985359394309*^9, {3.915797351933811*^9, 3.915797449635781*^9}, {
   3.915804625321198*^9, 3.915804637022449*^9}, {3.92235341379661*^9, 
   3.9223535520891438`*^9}, {3.922353585136964*^9, 3.922353609320433*^9}, {
   3.922354383548996*^9, 3.922354481917458*^9}, 3.922557814141171*^9, {
   3.922558081904052*^9, 3.922558137264877*^9}, {3.922566445568888*^9, 
   3.922566481233648*^9}, {3.922630631992079*^9, 3.92263064894182*^9}, 
   3.923906933485511*^9, {3.925728751166155*^9, 3.925728763093173*^9}, 
   3.925731210593966*^9, {3.926582398884472*^9, 3.926582440428467*^9}, {
   3.9353996128219976`*^9, 3.9353996666116962`*^9}, {3.935404432473399*^9, 
   3.935404443152721*^9}, {3.935775734669146*^9, 3.935775803829563*^9}, {
   3.935775957559762*^9, 3.935775979928987*^9}, 
   3.937485822116643*^9},ExpressionUUID->"3d997f9e-7cb3-47c8-b327-\
15d6dd81a0e1"],

Cell[TextData[{
 "Returns: a list of GraphicsComplex polyhedra for both the panels and the \
hinges in the form {",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 "}, where ",
 StyleBox["panels",
  FontSlant->"Italic"],
 " is the list of panels as input and ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 " is the list of hinges. Note that the hinge polyhedra will intersect the \
panel polyhedra."
}], "Text",
 CellChangeTimes->{{3.911994321355447*^9, 3.911994379835372*^9}, {
  3.912005512553893*^9, 3.912005513913563*^9}, {3.922373323155707*^9, 
  3.922373348045106*^9}},ExpressionUUID->"77f72638-ffe6-42a8-9930-\
d02de5455e71"],

Cell["\<\
It does the following:
\t\[LongDash]It trims the triangle panels to respect a minimum panel \
thickness (so don\[CloseCurlyQuote]t call it for an already-triangle-trimmed \
set of panels).
\t\[LongDash]It shifts the central panel upward so that its vertices are \
coplanar with those of the surrounding triangles.
\t\[LongDash]It performs a HingeJoinPanels with HingeShift \[Rule] True for \
all hinges except those around the central polygon panel;
\t\[LongDash]It then vertically shifts the central panel and hinges so that \
the hinges remain horizontal but their tops are coplanar with the top of the \
central polygon and their bottoms are coplanar with the bottoms of the \
surrounding triangles.\
\>", "Text",
 CellChangeTimes->{{3.9225578254215803`*^9, 3.9225578278763933`*^9}, {
  3.922557860374082*^9, 3.9225579642782927`*^9}, {3.9225580051275673`*^9, 
  3.922558016974237*^9}, {3.933517677317197*^9, 
  3.933517744302297*^9}},ExpressionUUID->"7d673b72-0c81-4011-af48-\
e79a1f3d41a2"],

Cell["\<\
The shifting of the central polygon and hinges is done to ensure that the no \
hinge is tilted upward across the short direction (for hinge strength).\
\>", "Text",
 CellChangeTimes->{{3.933517762645059*^9, 
  3.933517820885111*^9}},ExpressionUUID->"485732c8-0667-4b45-a6d5-\
2ca86e487db5"],

Cell["\<\
If CentralHingeThickness is set to anything other than Automatic, then its \
value overrides the value of HingeShift (if AngledHingeThickness \[Rule] \
None) or the value set by AngledHingeThickness (if AngledHingeThickness is \
set).\
\>", "Text",
 CellChangeTimes->{{3.935776029841913*^9, 3.935776056351878*^9}, {
  3.937485825186075*^9, 
  3.937485920018523*^9}},ExpressionUUID->"28ea5b8d-461f-4d02-9331-\
6dc01e416577"],

Cell["\<\
This is only relevant to stowed-form thick flashers. For deployed-form, you \
can use HingeJoinPanels as usual.\
\>", "Text",
 CellChangeTimes->{{3.922558030829309*^9, 
  3.922558056623131*^9}},ExpressionUUID->"a9f6da42-beae-4d04-9626-\
63c007d50eb1"],

Cell[TextData[{
 "The ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " argument is a structured list that establishes the correspondence between ",
 StyleBox["panels",
  FontSlant->"Italic"],
 ", the list of GraphicsComplex panels, and ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", the TObj that describes the EZTS that gives the topology of the mechanism \
and describes the folds that we are creating hinges for. For each panel, the \
corresponding element of ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " is a list of entries of the form {",
 StyleBox["e",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 "}}, where ",
 StyleBox["e",
  FontSlant->"Italic"],
 " is the index of an edge of the ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " that corresponds to some edge of the panel, and {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 "} are the vertex indices of the panel that correspond (respectively) to the \
ordered vertices of edge ",
 StyleBox["e",
  FontSlant->"Italic"],
 " (i.e., in the same order as ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "[Edges]\[LeftDoubleBracket]",
 StyleBox["e",
  FontSlant->"Italic"],
 "\[RightDoubleBracket]). Each element of ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " is a set of these entries, one for each edge of the panel that corresponds \
to an edge of the EZTS described by ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". You don\[CloseCurlyQuote]t need to include entries for boundary edges of \
the EZTS or any other edges that don\[CloseCurlyQuote]t get hinges. Any edges \
that have zero or one {",
 StyleBox["e",
  FontSlant->"Italic"],
 ", {",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i2",
  FontSlant->"Italic"],
 "}} entries in ",
 StyleBox["panelinfo",
  FontSlant->"Italic"],
 " will be ignored (resulting in an empty list in ",
 StyleBox["hinges",
  FontSlant->"Italic"],
 "); those that have exactly two entries in panelinfo receive a hinge, i.e., \
a list of one or more GraphicsComplex objects."
}], "Text",
 CellChangeTimes->{{3.9119968897667513`*^9, 3.911996959285138*^9}, {
   3.911997006220289*^9, 3.911997148383873*^9}, 3.911997187651119*^9, {
   3.912001222444088*^9, 3.9120012940933943`*^9}, {3.912001326143878*^9, 
   3.9120013269772987`*^9}, {3.912004850065068*^9, 3.91200488256297*^9}, {
   3.913553416319351*^9, 3.913553418175283*^9}, {3.91483883522929*^9, 
   3.914838994912235*^9}, {3.915799714283785*^9, 3.9157997329478817`*^9}, {
   3.915803744725965*^9, 3.915803783956319*^9}, {3.922308061088039*^9, 
   3.92230813761128*^9}, {3.922354506293053*^9, 3.922354596412704*^9}, {
   3.922548248238722*^9, 3.922548385867264*^9}, {3.922548424843447*^9, 
   3.922548531554248*^9}, {3.922548564546714*^9, 3.92254858545089*^9}, {
