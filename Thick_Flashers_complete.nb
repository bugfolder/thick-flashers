Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "pverts", ",", "pedges", ",", "pfaces", ",",
         "dverts", ",", "dedges", ",", "dfaces", ",", "iverts", ",", "bverts",
         ",", "iedges", ",", "bedges", ",", "bfaces"}], 
       StyleBox["}",
        FontSlant->"Italic"]}], 
      StyleBox[",",
       FontSlant->"Italic"], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"verts", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", ".5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"5", ",", "7"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "7"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["pverts",
           FontSlant->"Italic"], ",", 
          StyleBox["pedges",
           FontSlant->"Italic"], ",", 
          StyleBox["pfaces",
           FontSlant->"Italic"], ",", 
          StyleBox["dverts",
           FontSlant->"Italic"], ",", 
          StyleBox["dedges",
           FontSlant->"Italic"], ",", 
          StyleBox["dfaces",
           FontSlant->"Italic"], ",", 
          StyleBox["iverts",
           FontSlant->"Italic"], ",", 
          StyleBox["bverts",
           FontSlant->"Italic"], ",", 
          StyleBox["iedges",
           FontSlant->"Italic"], ",", 
          StyleBox["bedges",
           FontSlant->"Italic"], ",", 
          StyleBox["bfaces",
           FontSlant->"Italic"]}], "}"}], "=", 
        RowBox[{"AddTPrimalDualGraphTo", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "dverts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"dverts", "\[LeftDoubleBracket]", 
           RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"dverts", "\[LeftDoubleBracket]", 
           RowBox[{"3", ",", "2"}], "\[RightDoubleBracket]"}]}], "}"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"PrimalDualGraphics", "[", 
         RowBox[{"pverts", ",", "pedges", ",", "dverts", ",", "dedges"}], 
         "]"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrimalDualUnsafeTwistAngleRange", "[", 
         RowBox[{
         "pverts", ",", "pfaces", ",", "dverts", ",", "dfaces", ",", 
          "bverts"}], "]"}], "/", 
        RowBox[{"N", "[", "\[Degree]", "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}], "//", "ShowExample"}], "//", "Hold"}], ";"}]], "Input",
 CellChangeTimes->{{3.466029776298232*^9, 3.466029786532011*^9}, {
