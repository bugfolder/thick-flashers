Cell[BoxData[
 RowBox[{
  RowBox[{"StyledGenericFoldLine", "[", 
   RowBox[{"rlist_List", ",", "gg_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gmin", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gmin", "=", 
      RowBox[{
       RowBox[{"MinimumAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledFoldLine", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gg", ">", "gmin"}], "||", 
        RowBox[{"gg", "<", 
         RowBox[{"-", "gmin"}]}]}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", "rlist", "]"}], ",", "FoldedLine"}], "]"}], ",", 
       RowBox[{"{", "}"}]}], "]"}]}]}], "]"}]}]], "Input",
