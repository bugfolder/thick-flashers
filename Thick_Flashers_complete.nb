}, Closed]],

Cell[CellGroupData[{

Cell["NewPath", "Subsubsection",
 CellChangeTimes->{{3.6760363857697*^9, 
  3.676036387041941*^9}},ExpressionUUID->"a551959c-33d4-43e4-a49f-\
e77dd6126fa0"],

Cell["\<\
NewPath is an option to file converters that specifies the destination path \
for the converted file. NewPath\[Rule]ReplaceFileExtension will mean to keep \
the old path, just replace the file extension. Default behavior will \
typically be to replace the file extension.\
\>", "Text",
 CellChangeTimes->{{3.676036390737112*^9, 
  3.6760364719772863`*^9}},ExpressionUUID->"715baebe-60ad-4b3e-9493-\
c67e658389fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NewPath", "::", "usage"}], 
   "=", "\"\<NewPath is an option to file converter functions that specifies \
a new destination for the converted file.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.676036477976512*^9, 3.676036499787966*^9}},
 CellLabel->
  "In[4419]:=",ExpressionUUID->"3206b037-af87-48f2-8737-179e05e7f102"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "GetPaths[",
 StyleBox["dirpath",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ext",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.676489212408495*^9, 
  3.676489226435824*^9}},ExpressionUUID->"a448c144-17ce-4d87-aa16-\
0973888f064b"],

Cell[TextData[{
 "GetPaths[",
 StyleBox["dirpath",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ext",
  FontSlant->"Italic"],
 "] gets a list of all file paths with the extension ",
 StyleBox["ext",
  FontSlant->"Italic"],
 " in the directory ",
 StyleBox["dirpath",
  FontSlant->"Italic"],
 " (which should end with a delimiter). It returns a list of entries \
{dirpath, filename} (split, to make it easy to put modified versions in a \
different directory)."
}], "Text",
 CellChangeTimes->{{3.67648922932406*^9, 3.676489263169917*^9}, {
  3.676489301039916*^9, 3.676489352740382*^9}, {3.676489387137941*^9, 
  3.676489394313898*^9}, {3.676489448463784*^9, 
  3.676489451110691*^9}},ExpressionUUID->"4f266b8d-a737-4a90-ab19-\
761c37205138"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetPaths", "[", 
   RowBox[{"dirpath_String", ",", "ext_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "filenames"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"StringLength", "[", "dirpath", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"filenames", "=", 
      RowBox[{"FileNames", "[", 
       RowBox[{
        RowBox[{"\"\<*.\>\"", "<>", "ext"}], ",", "dirpath"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dirpath", ",", 
         RowBox[{"StringTake", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"n", "+", "1"}], ",", 
             RowBox[{"StringLength", "[", "#", "]"}]}], "}"}]}], "]"}]}], 
        "}"}], "&"}], "/@", "filenames"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.676489354422577*^9, 3.676489373684173*^9}, {
   3.676489548522081*^9, 3.676489619517212*^9}, 3.676489720523237*^9, 
   3.676489751676381*^9, {3.676489787525878*^9, 3.676489838175394*^9}, {
   3.676489872456047*^9, 3.676489897020884*^9}, {3.676489943113876*^9, 
   3.676489952896781*^9}, {3.676490004386794*^9, 3.676490083064329*^9}},
 CellLabel->
  "In[4420]:=",ExpressionUUID->"a1ceda51-7362-4c31-9676-a7700dbc6e7c"],

Cell["Example", "Text",
 CellChangeTimes->{{3.676489409408661*^9, 
  3.676489410121859*^9}},ExpressionUUID->"1299e37d-ec04-425c-8079-\
4e9d10f16925"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dirpath", ",", "ext"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dirpath", "=", 
      RowBox[{"ExamplesDir", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ExamplesDir[] = \>\"", ",", "dirpath"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ext", "=", "\"\<fold\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"GetPaths", "[", 
