          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angles1", "=", 
      RowBox[{"angles2", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", 
         RowBox[{"90", "\[Degree]"}], ",", "0", ",", "0", ",", "0"}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"To", " ", "make", " ", "life", " ", "interesting"}], ",", " ", 
       RowBox[{
        RowBox[{"we", "'"}], "ll", " ", "offset", " ", "and", " ", "rotate", " ",
         "Graph", " ", "2."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"verts3d2", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{".1", ",", ".2", ",", ".3"}], "}"}], "+", 
         RowBox[{
          RowBox[{"RotationZMatrix3D", "[", 
           RowBox[{"30.", "\[Degree]"}], "]"}], ".", "#"}]}], "&"}], "/@", 
       "verts3d2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"MakeTGraph3DAssigned", "[", 
        RowBox[{"verts1", ",", "edges1", ",", 
         RowBox[{"{", "}"}], ",", "verts3d1", ",", "angles1", ",", "types1"}],
         "]"}], "//", "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{
       RowBox[{"MakeTGraph3DAssigned", "[", 
        RowBox[{"verts2", ",", "edges2", ",", 
         RowBox[{"{", "}"}], ",", "verts3d2", ",", "angles2", ",", "types2"}],
         "]"}], "//", "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Join", " ", "graph", " ", "2", " ", "to", " ", "graph", " ", "1", " ",
         "by", " ", "aligning", " ", "a", " ", "pair", " ", "of", " ", 
        "points"}], ",", " ", 
       RowBox[{
        RowBox[{"so", " ", "use", "\[IndentingNewLine]", "xy"}], "-", 
        RowBox[{"plane", " ", 
         RowBox[{"rotation", "/", "repositioning"}], " ", "of", " ", "the", " ", 
         RowBox[{"pair", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
