Cell[TextData[{
 "OrientedInteriorEdgePairs[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a list {",
 StyleBox["iedeges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dedges",
  FontSlant->"Italic"],
 "} where ",
 StyleBox["iedges",
  FontSlant->"Italic"],
 " is a list of vertex index pairs defining the interior edges, i.e., edges \
of the plane graph minus the boundary, and ",
 StyleBox["dedges",
  FontSlant->"Italic"],
 " is a list of index pairs on the faces (which, when we get to \
TPrimalDualGraph\[CloseCurlyQuote]s, are the vertices of the interior dual of \
the graph). The TGraph must have nonempty Faces; if not, a fatal error will \
be issued."
}], "Text",
 CellChangeTimes->{{3.592787805639472*^9, 3.592787885404059*^9}, {
   3.592790554082748*^9, 3.592790556079561*^9}, 3.5928288024043417`*^9, {
   3.593010582839588*^9, 3.593010594062738*^9}, {3.593010719865364*^9, 
   3.5930107261663113`*^9}},ExpressionUUID->"2c72b635-15d1-4804-8a3b-\
aa78446ca313"],

Cell["\<\
The interior edges are oriented to match the Edges of the TGraph. The dual \
edges are oriented so that the vector between the centroids of the faces is a \
CCW rotation relative to the vector between the vertices.\
\>", "Text",
 CellChangeTimes->{{3.4627301020052156`*^9, 3.462730128187482*^9}, {
   3.462730451590238*^9, 3.4627304822746677`*^9}, {3.462730848419407*^9, 
   3.462730849361964*^9}, 3.462730887196281*^9, {3.465913624780949*^9, 
   3.465913624800613*^9}, {3.591725640092994*^9, 3.591725659133003*^9}, {
   3.591725866125314*^9, 3.591725882111124*^9}, 3.592435743434472*^9, {
   3.59278779541245*^9, 3.5927878016447678`*^9}, {3.592787938460515*^9, 
   3.592787953271269*^9}, {3.593010535781718*^9, 3.593010553465953*^9}, 
   3.7039745822234178`*^9},ExpressionUUID->"4251d97f-811a-4fe3-9bd2-\
238cb10b2d13"],

Cell[TextData[{
 "Used in FoldGraph2D, TwoColorGraph, AddTPrimalDualGraphTo, ",
 "LocalFaceOrdering",
 ", MakeSimpleWovenTessellationTPlaneGraphPair. This is a TPlaneGraph-ish \
function, but ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " only needs to be a TGraph."
}], "Text",
 CellChangeTimes->{{3.592615085924207*^9, 3.592615089619688*^9}, {
   3.592788804012698*^9, 3.592788812359908*^9}, {3.592789873789561*^9, 
   3.592789930552219*^9}, {3.592790697359659*^9, 3.592790715517348*^9}, 
   3.592791270541271*^9, {3.592828710828237*^9, 3.592828711008441*^9}, 
   3.592828802469105*^9, 3.5928594582837763`*^9, 3.595200248178089*^9, 
   3.628786904023158*^9, 
   3.628863672626324*^9},ExpressionUUID->"be4ae638-2610-4bb5-b7ca-\
3c89a8834bea"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OrientedInteriorEdgePairs", "::", "nofaces"}], 
   "=", "\"\<The TObj `1` must have nonempty Faces.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.593010603978962*^9, 3.593010677634843*^9}},
 CellLabel->
  "In[1192]:=",ExpressionUUID->"ff18dfff-d766-4bf5-920c-dca09e2c2c75"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrientedInteriorEdgePairs", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "tm", ",", "epfi", ",", 
      "iepfi", ",", "iedges", ",", "dedges", ",", "dverts", ",", "signs"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"HasFacesQ", "[", "tobj", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"OrientedInteriorEdgePairs", "::", "nofaces"}], ",", 
          "tobj"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "Faces"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tm", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sort", "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}]}], ")"}], 
        "&"}], "/@", "faces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"epfi", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"Position", "[", 
             RowBox[{"tm", ",", "#"}], "]"}], "]"}], "\[LeftDoubleBracket]", 
           "1", "\[RightDoubleBracket]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Union", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"tm", ",", "1"}], "]"}], "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"list", " ", "of", " ", "edge", " ", "pair"}], ",", " ", 
       RowBox[{"face", " ", "pair"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"iepfi", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"epfi", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}],
           "\[Equal]", "2"}], "&"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"list", " ", "of", " ", "interior", " ", "edge", " ", "pair"}],
        ",", " ", 
       RowBox[{"dual", " ", "edge", " ", "pair"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "iepfi", "]"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}]}], "}"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"iedges", ",", "dedges"}], "}"}], "=", 
      RowBox[{"Transpose", "[", "iepfi", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"iedges", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"edges", ",", "#"}], "]"}], ",", "#", ",", 
          RowBox[{"Reverse", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
       "iedges"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "match", " ", "direction", " ", "to", " ", "existing", " ", "edges"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{"FaceCentroids", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"signs", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Subtract", "@@", 
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "#1", 
              "\[RightDoubleBracket]"}]}], ")"}], ".", 
           RowBox[{"Rotate90", "[", 
            RowBox[{"Subtract", "@@", 
             RowBox[{
             "dverts", "\[LeftDoubleBracket]", "#2", 
              "\[RightDoubleBracket]"}]}], "]"}]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"iedges", ",", "dedges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"iedges", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#1", "\[Equal]", 
             RowBox[{"-", "1"}]}], ",", "#2", ",", 
            RowBox[{"Reverse", "[", "#2", "]"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"signs", ",", "dedges"}], "}"}]}], "]"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.462730492153813*^9, 3.462730548832929*^9}, {
   3.462730602482972*^9, 3.46273076063655*^9}, 3.4627308393250937`*^9, 
   3.462730894011407*^9, {3.462972503846977*^9, 3.462972524759612*^9}, {
   3.4659136248108797`*^9, 3.465913624844823*^9}, {3.591725674309675*^9, 
   3.5917256951247063`*^9}, {3.591725741633234*^9, 3.591725746854325*^9}, {
   3.591725866225342*^9, 3.591725882207438*^9}, {3.591782567968588*^9, 
   3.591782568542609*^9}, 3.5924357435094*^9, {3.592787199417588*^9, 
   3.592787225781905*^9}, {3.5927873753977413`*^9, 3.5927874408882723`*^9}, {
   3.592787482748161*^9, 3.59278749145814*^9}, {3.592787534716737*^9, 
   3.592787617229801*^9}, {3.592787669873157*^9, 3.592787758275062*^9}, {
   3.5927922897301803`*^9, 3.5927923847729483`*^9}, {3.593010685154581*^9, 
   3.593010712441083*^9}, {3.593010755317711*^9, 3.593010759883933*^9}, {
   3.593010820764437*^9, 3.59301082433211*^9}, {3.593010936004884*^9, 
   3.593010948388056*^9}, {3.593011013812365*^9, 3.593011016637746*^9}, {
   3.593011098145738*^9, 3.593011285938998*^9}},
 CellLabel->
  "In[1193]:=",ExpressionUUID->"b66e05c0-dc16-4206-932b-639a2e0591c2"],

Cell["\<\
Example. This shows that the interior edges match the direction of the \
original edges, and the face pair is a CCW rotation of the edge pair.\
\>", "Text",
 CellChangeTimes->{{3.462730897722834*^9, 3.462730898355099*^9}, {
  3.593011395780154*^9, 
  3.593011432224002*^9}},ExpressionUUID->"1009ce6b-f13e-4f06-9ed7-\
7eeda8b2f4c8"],

