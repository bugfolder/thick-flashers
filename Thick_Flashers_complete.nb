513631bba2d5"],

Cell[TextData[{
 "ParaboloidalFlasherDefaultDPRules[",
 StyleBox["p, m, f",
  FontSlant->"Italic"],
 "] returns a rule that maps any DP vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"9396405e-f802-4541-b9fb-cbb326593d2b"],
 " to its theoretically ideal position in the DP for rotational order ",
