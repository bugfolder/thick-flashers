   3.708570166814978*^9}, {3.708570254202252*^9, 3.708570258937215*^9}, 
   3.708601721990219*^9},ExpressionUUID->"afceb57a-6103-481b-87ca-\
bb1bc46fe814"],

Cell[TextData[{
 "MakePlanarRoundedPlateGC[",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a planar convex polygon and returns a GraphicsComplex that \
describes a thick plate with rounded edges and corners."
}], "Text",
 CellChangeTimes->{{3.459037890136999*^9, 3.459037893464857*^9}, {
   3.4590379276067553`*^9, 3.459038150032057*^9}, 3.459038627389222*^9, {
   3.708343581500182*^9, 3.708343594841697*^9}, {3.70834366730606*^9, 
   3.708343690011565*^9}, 3.708401201987891*^9, {3.708570118939711*^9, 
   3.7085701194174147`*^9}, 3.708570156953712*^9, 3.708570254242285*^9, 
   3.708601722061927*^9},ExpressionUUID->"ad151094-d64d-45bf-a442-\
bb688c49bb04"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["poly",
  FontSlant->"Italic"],
 " \[LongDash] a list of 3D vertices that define the polygon.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of rounding, and half the desired total thickness."
}], "Text",
 CellChangeTimes->{{3.708343613129904*^9, 3.708343654007031*^9}, {
  3.708602919225717*^9, 
  3.708602926267519*^9}},ExpressionUUID->"96741835-1bb9-4be7-9ec7-\
54f490e99d77"],

Cell[TextData[{
 "Options:\n\tRoundingDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the number of division to use in creating the rounded corners."
}], "Text",
 CellChangeTimes->{{3.708343584856293*^9, 3.708343589526625*^9}, {
   3.708343740330816*^9, 3.708343783823826*^9}, {3.7083455595994062`*^9, 
   3.708345559837372*^9}, {3.70834569808*^9, 3.708345720338773*^9}, {
   3.708345787696371*^9, 3.708345825930876*^9}, 3.7084777006056347`*^9, {
   3.708570284358286*^9, 3.708570290885127*^9}, 
   3.708602941112379*^9},ExpressionUUID->"c3ad098f-18ab-41d4-8145-\
7ba37bc8c5f2"],

Cell["\<\
These types of plates have the nice property that if you join a set of \
polygons edge-to-edge and then perform this conversion on each polygon, the \
round-edged plates make smooth joints for any angle of join between the \
polygons.\
\>", "Text",
 CellChangeTimes->{
  3.708343597813402*^9, {3.708343699840807*^9, 3.70834370535337*^9}, {
   3.708570304089083*^9, 
   3.708570321634676*^9}},ExpressionUUID->"948372d6-6526-4638-bacb-\
3bb46bf0f615"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RoundingDivisions", "::", "usage"}], 
   "=", "\"\<RoundingDivisions is an option to MakePlanarRoundedPlateGC that \
specifies the number of divisions to use in rounding.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.708345640390102*^9, 3.708345663676242*^9}, {
   3.708345721303198*^9, 3.708345722805798*^9}, 3.708401202035244*^9, {
   3.70847770063189*^9, 3.708477700649551*^9}, 3.70857015701335*^9, 
   3.708570254266492*^9, 3.708601722097018*^9},
 CellLabel->
  "In[4261]:=",ExpressionUUID->"9cacfc12-e4a0-4107-8a9d-1c5eb36f1bec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakePlanarRoundedPlateGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"RoundingDivisions", "\[Rule]", "4"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.459038242158097*^9, 3.459038248539515*^9}, 
   3.459038628462338*^9, 3.4590407396103*^9, 3.459040864711842*^9, {
   3.708343803026116*^9, 3.708343806959352*^9}, {3.708345567504936*^9, 
   3.708345567773915*^9}, 3.708345676535295*^9, 3.708345723877472*^9, 
   3.708401202061736*^9, 3.708477700668281*^9, 3.708570157043469*^9, 
   3.708570254277128*^9, {3.708570335154883*^9, 3.7085703369975452`*^9}, 
