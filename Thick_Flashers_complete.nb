Cell["\<\
Another example: a helix. First construct the helix to get its parameters; \
then see if our function can reconstruct it.\
\>", "Text",
 CellChangeTimes->{{3.799521690600378*^9, 3.799521694568999*^9}, {
  3.799521833449572*^9, 
  3.7995218463136687`*^9}},ExpressionUUID->"84c82b3f-ce24-47d0-a07f-\
2593767e96a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h", ",", "c", ",", "pcs", ",", "\[Theta]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{
          RowBox[{"Tan", "[", "\[Theta]", "]"}], " ", "#"}]}], "}"}], "&"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"pcs", "=", 
      RowBox[{"RecoverCurve3DSystem", "[", 
       RowBox[{"c", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Theta]", ">", "0"}], ",", 
           RowBox[{"\[Theta]", "<", 
            RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"pcs", "//", "ColumnForm"}], "//", "PrettyParameters"}], "//", 
      "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{
       RowBox[{"Curve3D", "[", "0", "]"}], "/.", "pcs"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{
       RowBox[{"TangentVector3D", "[", "0", "]"}], "/.", "pcs"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", 
      RowBox[{
       RowBox[{"BinormalVector3D", "[", "0", "]"}], "/.", "pcs"}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.689453264770805*^9, 3.6894533404845257`*^9}, {
   3.689453376641898*^9, 3.689453456514914*^9}, {3.689453622792039*^9, 
   3.6894536254309683`*^9}, {3.6894537143081303`*^9, 3.68945371661893*^9}, {
   3.690651188789486*^9, 3.690651191752236*^9}, 3.690988939037358*^9, 
