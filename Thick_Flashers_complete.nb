       RowBox[{"Turn", " ", "over", " ", "the", " ", "folded", " ", "form"}], 
       ",", " ", 
       RowBox[{"i", ".", "e", "."}], ",", " ", 
       RowBox[{
       "invert", " ", "the", " ", "crease", " ", "assignment", " ", "and", " ",
         "flop", " ", "the", " ", 
