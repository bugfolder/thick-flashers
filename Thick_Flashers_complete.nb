Cell[TextData[{
 "Vertex3DGaussianSphereGraphics3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TVertex3D\n\t(options) ShowGaussianSphere, Show",
 "Midfold",
 "Vectors, GaussianSphereRadius, SectorAngleLabels, DihedralAngleLabels, \
Options[Graphics3D]"
}], "Subsubsection",
 CellChangeTimes->{{3.594806159402633*^9, 3.594806200415124*^9}, 
   3.594806291155775*^9, {3.5948063501341467`*^9, 3.594806357021078*^9}, 
