Cell[CellGroupData[{

Cell[TextData[{
 "StyledCurvedFoldBounded[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", {",
 StyleBox["bl, br",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FoldLineStyle, RulingLineLeftStyle, RulingLineRightStyle, \
BoundaryLineLeftStyle, BoundaryLineRightStyle, RulingLineDivisions, \
CurveDivisions, FillStyle, OutlineStyle, SurfaceOrientation"
}], "Subsubsection",
 CellChangeTimes->{{3.6922033108532124`*^9, 3.692203323455735*^9}, 
