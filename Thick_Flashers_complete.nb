Cell["\<\
Example with varying director angle with respect to the tangent. Dashed line \
is the constant-distance-along-director solution; solid surface is the \
constant-width solution.\
\>", "Text",
 CellChangeTimes->{{3.7995994239045973`*^9, 3.7995994249198003`*^9}, {
  3.799602878649534*^9, 3.7996029316164227`*^9}, {3.799604119720274*^9, 
  3.799604145240653*^9}},ExpressionUUID->"e43a47d6-9c65-4b09-b265-\
bf3d3454079d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "b", ",", "d", ",", "w0", ",", "u0", ",", "u1", ",", "wL", ",", "wR", ",",
       "s"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"b", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w0", "=", "0.10"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{".35", "\[Pi]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"wL", "=", 
      RowBox[{"NConstantWidthScale2D", "[", 
       RowBox[{"b", ",", "d", ",", "w0", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wR", "=", 
      RowBox[{"NConstantWidthScale2D", "[", 
       RowBox[{"b", ",", "d", ",", 
        RowBox[{"-", "w0"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StyledRuledPatch", "[", 
          RowBox[{"b", ",", "d", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"wL", ",", "wR"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StyledCurve", "[", 
          RowBox[{"b", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", 
           RowBox[{"LineStyle", "\[Rule]", 
            RowBox[{"{", "Black", "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StyledCurve", "[", 
          RowBox[{
           RowBox[{"Functionize", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"b", "[", "s", "]"}], "+", 
              RowBox[{"w0", " ", 
               RowBox[{"d", "[", "s", "]"}]}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", 
           RowBox[{"LineStyle", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"Dashed", ",", "Gray"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StyledCurve", "[", 
          RowBox[{
           RowBox[{"Functionize", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"b", "[", "s", "]"}], "-", 
              RowBox[{"w0", " ", 
               RowBox[{"d", "[", "s", "]"}]}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", 
           RowBox[{"LineStyle", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"Dashed", ",", "Gray"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799599426425684*^9, 3.799599508761319*^9}, 
   3.799600340041903*^9, {3.799601049580476*^9, 3.799601052884378*^9}, {
   3.799601099492537*^9, 3.79960112322966*^9}, {3.7996020743266983`*^9, 
   3.799602087685113*^9}, {3.799602402688529*^9, 3.799602504718657*^9}, {
   3.79960264388957*^9, 3.7996026440948763`*^9}, {3.799602834739684*^9, 
   3.799602851580883*^9}, 3.799603119422064*^9, {3.799603413614541*^9, 
   3.799603418109225*^9}, {3.79960346267024*^9, 3.799603610702656*^9}, {
   3.799603722857531*^9, 3.799603776399241*^9}, {3.799603937427162*^9, 
   3.79960398048129*^9}, {3.799604106266835*^9, 3.799604111209784*^9}, {
   3.799604153347418*^9, 3.799604192322253*^9}, {3.799604495422386*^9, 
   3.799604497348587*^9}, {3.79961964738592*^9, 3.799619647389664*^9}, 
   3.79962204289922*^9, {3.799622084360407*^9, 3.799622115907514*^9}, {
   3.799622824947199*^9, 3.799622828047125*^9}},
 CellLabel->
