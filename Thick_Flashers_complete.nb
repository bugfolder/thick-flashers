Cell[TextData[{
 "As with regular polygon offset twists, the fact that the twist angle \
\[Alpha] depends on the angles of the triangle but tiles mate with other on \
constant ",
 StyleBox["w, d",
  FontSlant->"Italic"],
 " means that there is no Alt form of the tiling that takes \[Alpha] as a \
parameter."
}], "Text",
 CellChangeTimes->{{3.627680890155739*^9, 3.627680891123054*^9}, {
  3.627680993182931*^9, 
  3.627681035609866*^9}},ExpressionUUID->"12a3f011-f4cc-47b5-923f-\
a5427092bdae"]
}, Closed]],

