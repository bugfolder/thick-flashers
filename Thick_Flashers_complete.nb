   3.643237968645165*^9},ExpressionUUID->"273bb34d-21b1-40b6-84cd-\
401c115a53f1"],

Cell[TextData[{
 "CornerIndices\[Rule]{{",
 StyleBox["botleft",
  FontSlant->"Italic"],
 ", ",
 StyleBox["botright",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["topleft",
  FontSlant->"Italic"],
 ", ",
 StyleBox["topright",
  FontSlant->"Italic"],
 "}} is a TObj property that specifies the indices at the corners of a \
(roughly) rectangular grid crease pattern. It\[CloseCurlyQuote]s useful for \
reorienting a folded form."
}], "Text",
 CellChangeTimes->{{3.6426063112271557`*^9, 3.642606394426322*^9}, {
  3.643238546322886*^9, 
  3.643238576713446*^9}},ExpressionUUID->"08fc735f-23b8-4141-9c4f-\
beee5a4841ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CornerIndices", "::", "usage"}], 
   "=", "\"\<CornerIndices is a TObj property that specifies the four corners \
of a rectangular crease pattern grid.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.642606409938197*^9, 3.642606433279735*^9}},
 CellLabel->
  "In[2060]:=",ExpressionUUID->"a1bb77f3-57ce-4632-ad0e-fab38791fcc0"]
}, Closed]],

Cell[CellGroupData[{

