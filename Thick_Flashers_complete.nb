Cell[CellGroupData[{

Cell["2D to 3D function conversions", "Subsection",
 CellChangeTimes->{{3.799330185928364*^9, 3.799330196823819*^9}, {
  3.799331045119168*^9, 3.799331045989601*^9}, {3.799338121294504*^9, 
  3.799338121646645*^9}},ExpressionUUID->"dffd0ccd-51f9-4297-9550-\
f150203a935f"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.79933104976584*^9, 
  3.799331052286088*^9}},ExpressionUUID->"dd6ba596-74f3-4a95-9326-\
bd1108c1e8e1"],

Cell[TextData[{
 "Many of our functions for curling, flattening, and reshaping can all be \
described and analyzed in terms of 3D functions where the 2D versions are \
just 3D versions confined to the ",
 StyleBox["x",
  FontSlant->"Italic"],
 "-",
 StyleBox["y",
  FontSlant->"Italic"],
 " plane. To facilitate the analysis and avoid proliferation of 2D-3D, 3D-2D, \
and 3D-3D conversion functions, we introduce these two utility functions, \
Planarize and Unplanarize, that take pure functions and convert them from 2D \
to 3D representations."
}], "Text",
 CellChangeTimes->{{3.799331053974177*^9, 
  3.799331168463223*^9}},ExpressionUUID->"dea5fc92-78ed-4ea4-96eb-\
89ef8edba34b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Planarize[",
 StyleBox["fn",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.799330979253944*^9, 
  3.799330982421796*^9}},ExpressionUUID->"66b93739-35b3-4a0a-aab9-\
286290f292f4"],

Cell["\<\
Planarize[fn] takes a pure function that returns a list of length 3 and \
returns the pure function that results from dropping the 3rd value in the  \
list.\
\>", "Text",
 CellChangeTimes->{{3.799337448281494*^9, 
  3.799337485793968*^9}},ExpressionUUID->"8cd38d2b-b62d-4132-aa5b-\
87f9200e76ce"],

Cell["\<\
Planarize can handle both pure functions and functions with explicit \
parameters.\
\>", "Text",
 CellChangeTimes->{{3.799337489617812*^9, 3.799337523842016*^9}, {
  3.799337998021141*^9, 
  3.799338007829597*^9}},ExpressionUUID->"d4195374-3d0a-4931-8434-\
47a6d1c3cced"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Planarize", "::", "badfn"}], 
   "=", "\"\<`1` is not a pure function whose return value is a list of \
length 3.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.799330488674588*^9, 3.799330555899081*^9}},
 CellLabel->
  "In[3840]:=",ExpressionUUID->"8e66c507-7c6e-4510-b3e8-07dc060909e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Planarize", "[", "f_Function", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "f", "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"a", " ", "pure", " ", "function"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "List"}], "||", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "3"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"Planarize", "::", "badfn"}], ",", "f"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"ReplacePart", "[", 
        RowBox[{"f", ",", 
         RowBox[{"1", "\[Rule]", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
            "f", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            "2"}], "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"function", " ", "with", " ", "parameters"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "List"}], "||", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "f", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "]"}], "\[NotEqual]", "3"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"Planarize", "::", "badfn"}], ",", "f"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"ReplacePart", "[", 
        RowBox[{"f", ",", 
         RowBox[{"2", "\[Rule]", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
            "f", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
            "2"}], "]"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.79933019833786*^9, 3.799330208816029*^9}, {
   3.79933027936913*^9, 3.799330353505164*^9}, {3.799330395458918*^9, 
   3.799330471442293*^9}, {3.799330560308888*^9, 3.799330780300358*^9}, {
   3.799337743171698*^9, 3.799337796028137*^9}, 3.7993378543906*^9, {
   3.799337886589654*^9, 3.799337935814042*^9}, {3.799338022618037*^9, 
   3.799338031014069*^9}},
 CellLabel->
  "In[3841]:=",ExpressionUUID->"00d43230-1b8b-40ff-ac9b-cdb0db0897e7"],

Cell["Example with a pure function.", "Text",
 CellChangeTimes->{{3.799330213360753*^9, 3.799330214079356*^9}, 
   3.799330856772785*^9, {3.799330936020257*^9, 
   3.799330938853312*^9}},ExpressionUUID->"76f4f24c-75b7-4f20-8c02-\
0d36f9cbe315"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "ff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"Tan", "[", "#", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Planarize", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "ff", "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799330215241061*^9, 3.799330266624402*^9}, 
   3.799330611414932*^9, {3.799331176834992*^9, 3.799331178567013*^9}, 
   3.799337941519318*^9, {3.799337971879331*^9, 3.799337976871018*^9}, 
   3.799338106817477*^9},
 CellLabel->
  "In[3842]:=",ExpressionUUID->"67ed4c44-cfb3-4bd8-a2bf-56ce04da4ace"],

Cell["Example with parameters.", "Text",
 CellChangeTimes->{{3.799337958036982*^9, 
  3.799337961453271*^9}},ExpressionUUID->"299cdf05-392e-4b9c-8eed-\
9cbbdff5b243"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "ff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"Function", "[", 
       RowBox[{"x", ",", 
        RowBox[{"{", 
         RowBox[{
