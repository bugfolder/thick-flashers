 RowBox[{
  RowBox[{"ArcHav", "[", "x_", "]"}], ":=", 
  RowBox[{"ArcCos", "[", 
   RowBox[{"1", "-", 
    RowBox[{"2", "x"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.636736902878374*^9, 3.636736919139248*^9}},
