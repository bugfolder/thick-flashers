Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.803598196418818*^9, 
  3.803598196906672*^9}},ExpressionUUID->"fbe81112-b920-4f74-bf35-\
b3922c3bdbf4"],

Cell["\<\
These functions all have to do with the analysis and display of David Huffman\
\[CloseCurlyQuote]s \[OpenCurlyDoubleQuote]Hexagonal Column with Cusps.\
\[CloseCurlyDoubleQuote] We do two versions:
(a) unit circle plus confocal parabola (partially worked out)
(b) unit circle plus circle of radius 4 (fully worked out).
The second example is used in the book.\
\>", "Text",
 CellChangeTimes->{{3.8035981986117687`*^9, 3.803598214669215*^9}, {
  3.803598332879263*^9, 
  3.8035983782208643`*^9}},ExpressionUUID->"0e00c77e-ed91-480a-a960-\
c6bb86ee1041"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "HCwCParabola[",
 StyleBox["ti1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]1i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]2i",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.803558312087694*^9, 3.803558331144116*^9}, {
   3.803558418801517*^9, 3.803558423079438*^9}, {3.803558721690323*^9, 
   3.803558722810429*^9}, 
   3.803573209579165*^9},ExpressionUUID->"d3a6cf72-2fe2-44f6-bbac-\
6f40dec5132b"],

Cell[TextData[{
 "HCwCParabola[",
 StyleBox["ti1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]1i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]2i",
  FontSlant->"Italic"],
 "] constructs the building block for the Huffman Hexagonal Column with Cusps \
using a parabola for the second curve and incorporating optional conic \
surfaces at the beginning and end of the first fold."
}], "Text",
 CellChangeTimes->{{3.803558338249037*^9, 3.803558377793177*^9}, 
   3.803558429625379*^9, {3.803558723793661*^9, 3.803558724985488*^9}, {
   3.803573209595047*^9, 
   3.803573259266699*^9}},ExpressionUUID->"f6368bed-ec80-48c9-ae1c-\
6176e532c252"],

Cell["\<\
Arguments:
\tti1 \[LongDash] parameter value at end of first cone.
\tti2 \[LongDash] parameter value at beginning of second cone.
\t\[Gamma]1i \[LongDash] initial value of the first fold angle at parameter t1.
\t\[Gamma]2i \[LongDash] initial value of the second fold angle at parameter \
t1.\
\>", "Text",
 CellChangeTimes->{{3.80355837979987*^9, 3.803558478536791*^9}, {
  3.80355872599404*^9, 
  3.803558726697731*^9}},ExpressionUUID->"dea06522-5213-4273-bcc8-\
e9042ebc3dce"],

Cell["\<\
Returns: a list {f0,f1,f2,f3,ff0,ff1,ff2,ff3,xL,xR,yL,yR,z,pv,q,\[Gamma]1,\
\[Gamma]2} of the 2D and 3D fold vectors, mirror frame vectors, and pivot \
vector for the given set of parameters.\
\>", "Text",
 CellChangeTimes->{{3.803567478505994*^9, 3.803567511898466*^9}, {
  3.80356769341923*^9, 3.803567749236916*^9}, {3.8035731570660973`*^9, 
  3.803573158265648*^9}},ExpressionUUID->"5c65bcbe-0200-437f-8141-\
df250efaec97"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HCwCParabola", "[", 
   RowBox[{
    RowBox[{"ti1_", "?", "NumericQ"}], ",", 
    RowBox[{"ti2_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Gamma]1i_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Gamma]2i_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "iopts", ",", "q", ",", "t", ",", "\[IndentingNewLine]", "ti0", ",", 
      "ti3", ",", "ti12", ",", "\[IndentingNewLine]", "f0", ",", "ds0", ",", 
      "b\[Kappa]g0", ",", "b\[Kappa]n0", ",", "s\[Lambda]0", ",", 
      "\[IndentingNewLine]", "f1", ",", "ds1", ",", "\[Gamma]1", ",", "rR1", ",",
       "rL1", ",", "\[Kappa]g1", ",", "t1", ",", "l1", ",", "vR1", ",", 
      "\[IndentingNewLine]", "f2", ",", "ds2", ",", "\[Gamma]2", ",", "rL2", ",",
       "rR2", ",", "\[Kappa]g2", ",", "t2", ",", "l2", ",", "vR2", ",", 
      "\[IndentingNewLine]", "f3", ",", "\[IndentingNewLine]", "eqn1", ",", 
      "eqn2", ",", "eqn3", ",", "\[IndentingNewLine]", "d3dsys", ",", 
      "\[Kappa]1", ",", "\[Tau]1", ",", "c3dsys", ",", "\[IndentingNewLine]", 
      "ff0", ",", "rrR0", ",", "\[IndentingNewLine]", "ff1", ",", "tt1", ",", 
      "nn1", ",", "bb1", ",", "\[FinalSigma]1", ",", "llL1", ",", "uuL1", ",",
       "llR1", ",", "uuR1", ",", "rrR1", ",", "\[IndentingNewLine]", "ff2", ",",
       "tt2", ",", "rrL2", ",", "uuL2", ",", "llL2", ",", "llR2", ",", "uuR2",
       ",", "rrR2", ",", "\[IndentingNewLine]", "ff3", ",", 
      "\[IndentingNewLine]", "xL", ",", "xR", ",", "yL", ",", "yR", ",", "z", 
      ",", "pv"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"iopts", "=", 
      RowBox[{"Sequence", "[", 
       RowBox[{"InterpolationPoints", "\[Rule]", "128"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ti0", ",", "ti3"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Zeroth", " ", "fold"}], ",", " ", 
       RowBox[{"cone", " ", "point"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"f0", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
