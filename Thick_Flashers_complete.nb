Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["ff",
  FontSlant->"Italic"],
 " \[LongDash] the 3D space curve of the fold, as a vector-valued function.\n\
\t",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 " \[LongDash] the fold angle.\n\t\[FinalSigma] \[LongDash] the fold \
orientation.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
