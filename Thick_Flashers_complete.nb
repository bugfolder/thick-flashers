Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pverts", ",", "tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", "dir", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "0", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"0.1", "+", 
         RowBox[{"0.8", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Random", "[", "]"}], ",", 
            RowBox[{"Random", "[", "]"}]}], "}"}]}]}], ",", 
        RowBox[{"{", "8", "}"}]}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{
      "MakeDelaunayTriangulationPrimalDualGraph", "[", "pverts", "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", "1.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"15.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CCW"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"Direction", "\[Rule]", "dir"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"PrimalDualGraphics", "[", 
             RowBox[{"tobjpd", ",", 
              RowBox[{"DualDirectedEdges", "\[Rule]", "True"}]}], "]"}], "\[LeftDoubleBracket]",
             "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"FaceupFace", "\[Rule]", 
            RowBox[{"-", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", "}"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
