Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MergeGraphsData", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"KillMergedEdges", "\[Rule]", "False"}], "\[IndentingNewLine]", 
