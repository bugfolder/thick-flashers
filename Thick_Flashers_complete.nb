 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeTachiMiuraPolyhedronGraphics3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"StackGap", "\[Rule]", "0.001"}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.643288983323567*^9, 3.643289009898308*^9}, 
   3.643293573528994*^9, 3.643294304613265*^9},
