Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "patch", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"patch", "=", 
       RowBox[{"JoinTiling", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "1"}], "}"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"UnitRegularPolygonTile", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"3", ",", "4", ",", "3"}], "}"}]}], "}"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"EmbedTiling", "[", 
          RowBox[{"patch", ",", "Tiling", ",", 
           RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
           RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
        RowBox[{"TilingStyle", "[", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"PatchVectors", "[", 
       RowBox[{"patch", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], "//", "ShowExample"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.631124049548348*^9, 3.631124235278098*^9}, {
  3.631127483915752*^9, 3.631127497217922*^9}},
 CellLabel->
