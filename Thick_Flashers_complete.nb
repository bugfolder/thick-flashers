Cell["Example. Different wire widths.", "Text",
 CellChangeTimes->{{3.9207334691138763`*^9, 3.9207334798576527`*^9}, {
  3.932817686632601*^9, 
  3.932817689262833*^9}},ExpressionUUID->"3e6b8b39-1a60-4258-b9e3-\
1e0283043929"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", "1"}], ",", 
      RowBox[{"b", "=", "5"}], ",", "z"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"a", ",", 
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"a", ",", "8", ",", 
                 RowBox[{"-", "1"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"a", ",", "8", ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"a", ",", 
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
            RowBox[{"Polygon", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"b", ",", 
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"-", "1"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"b", ",", "8", ",", 
                 RowBox[{"-", "1"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"b", ",", "8", ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"b", ",", 
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], "]"}]}], 
           "}"}], ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"HingeRectWireGC", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"a", ",", "0", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"b", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
              RowBox[{"HingeThickness", "->", "1"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"HingeRectWireGC", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"a", ",", "2.5", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"b", ",", "2.5", ",", "0"}], "}"}]}], "}"}], ",", 
              RowBox[{"HingeThickness", "->", "1"}], ",", 
              RowBox[{"HingeWireWidth", "->", "2"}], ",", 
              RowBox[{"HingeWireZ", "->", "z"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"HingeRectWireGC", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"a", ",", "6", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"b", ",", "6", ",", "0"}], "}"}]}], "}"}], ",", 
              RowBox[{"HingeThickness", "->", "1"}], ",", 
              RowBox[{"HingeWireWidth", "->", "3"}], ",", 
              RowBox[{"HingeWireZ", "->", "z"}]}], "]"}]}], 
           "\[IndentingNewLine]", "}"}], ",", "SolidStyle"}], "]"}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.92073363964014*^9, 3.920733691920351*^9}, {
   3.920734828906855*^9, 3.92073486660093*^9}, {3.9207350631554403`*^9, 
   3.920735063394363*^9}, {3.920735277699842*^9, 3.920735306292804*^9}, {
   3.92073550184067*^9, 3.920735510253689*^9}, {3.920735579853503*^9, 
   3.920735820640735*^9}, {3.920735853993313*^9, 3.920735856023163*^9}, {
   3.920736411634473*^9, 3.920736411649327*^9}, {3.920736559911882*^9, 
   3.920736602214365*^9}, 3.932817024817593*^9, {3.932817698183712*^9, 
   3.932817777025692*^9}, {3.932817853113967*^9, 3.932817876912977*^9}, {
   3.932817935740782*^9, 3.932817963470853*^9}, {3.932818140164309*^9, 
   3.932818140166625*^9}, {3.9328182271436253`*^9, 3.932818228923484*^9}},
 CellLabel->
  "In[4353]:=",ExpressionUUID->"533c32fb-3d9b-43ab-9987-315e682cae73"]
}, Closed]],

Cell[CellGroupData[{

Cell["HingeSquareWireGC", "Subsubsection",
 CellChangeTimes->{{3.932818162547546*^9, 
  3.932818168869*^9}},ExpressionUUID->"55209392-ecde-4d0d-95e5-4efa1d12d9ae"],

Cell["\<\
For backward compatibility, HingeSquareWireGC has now been replaced by \
HingeRectWireGC, which allows us to specify the width.\
\>", "Text",
 CellChangeTimes->{{3.9328181840673237`*^9, 
  3.932818209109612*^9}},ExpressionUUID->"01cd0112-291d-4cd8-b4d2-\
63d130c009dc"],

Cell[BoxData[
 RowBox[{"HingeSquareWireGC", ":=", "HingeRectWireGC"}]], "Input",
 CellChangeTimes->{{3.9328181716494913`*^9, 3.932818178996717*^9}},
 CellLabel->
  "In[4354]:=",ExpressionUUID->"a68d1ecc-38c0-41ce-8f25-3f67a80aff77"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
HingeNumWires
HingeMinWireGap
HingeEndsInset\
\>", "Subsubsection",
 CellChangeTimes->{{3.925727750418459*^9, 3.925727759218408*^9}, {
  3.929555609161165*^9, 
  3.9295556132589283`*^9}},ExpressionUUID->"3f8146b4-6eab-47eb-b42b-\
41b5f174d653"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeNumWires", "::", "usage"}], 
   "=", "\"\<HingeNumWires is an option to HingeMultiWireGC that specifies \
the number of wires to use for the hinge.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.920736708872613*^9, 3.92073673124349*^9}, 
   3.920736806035491*^9},
 CellLabel->
  "In[4355]:=",ExpressionUUID->"4234eeef-1e0b-4eb8-b181-64c1a9641a38"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeNumWires", "::", "badval"}], 
   "=", "\"\<The number of wires `1` specified to HingeMultiWireGC must be an \
integer greater than 2.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.920736708872613*^9, 3.92073673124349*^9}, {
  3.920736806035491*^9, 3.920736838620203*^9}},
 CellLabel->
  "In[4356]:=",ExpressionUUID->"78eaa346-36a4-4875-9ddd-516a950a1f95"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeMinWireGap", "::", "usage"}], 
   "=", "\"\<HingeMinWireGap is an option to HingeMultiWireGC that specifies \
the minimum gap to leave between wires.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.925727789090959*^9, 3.925727813740433*^9}},
 CellLabel->
  "In[4357]:=",ExpressionUUID->"a9936b40-cae3-444e-b413-1920d4b3c7fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeEndsInset", "::", "usage"}], 
   "=", "\"\<HingeEndsInset is an option to HingeMultiWireGC that specifies \
to inset the ends of the hinge by half of the HingeThickness at each end so \
that the wires are flush with their end surfaces.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.929555621938402*^9, 3.9295556683055677`*^9}},
 CellLabel->
  "In[4358]:=",ExpressionUUID->"22f044c1-da80-445d-ad58-65b01e2a82cb"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "HingeMultiWireGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HingeThickness, HingeEndsClipped, HingeEndsInset, \
HingeWireWidth, HingeNumWires, HingeMinWireGap, HingeWireCap"
}], "Subsubsection",
 CellChangeTimes->{{3.92073661100948*^9, 3.920736639170724*^9}, {
   3.92073676135728*^9, 3.920736763772159*^9}, {3.926593493609893*^9, 
   3.9265934966741734`*^9}, 3.926594390282156*^9, {3.9295555853034782`*^9, 
   3.929555596499538*^9}, {3.93281826125264*^9, 
   3.932818289857986*^9}},ExpressionUUID->"af22c7c8-c331-4f73-b276-\
9d51fc8de016"],

Cell[TextData[{
 "HingeMultiWireGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a GraphicsComplex polyhedron that implements a hinge consisting \
of multiple wires between two panels in a 3D-printed solid."
}], "Text",
 CellChangeTimes->{{3.912251425801676*^9, 3.912251451015481*^9}, 
   3.912574879080297*^9, {3.920736659293292*^9, 
   3.9207366698431396`*^9}},ExpressionUUID->"7998aed2-38db-47b9-b447-\
e59ecc72aea7"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} \[LongDash] the two panel polyhedron vertices on one side of the hinge.\n\
\t{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} \[LongDash] the corresponding two panel vertices on the other side of the \
hinge."
}], "Text",
 CellChangeTimes->{{3.9122517761975393`*^9, 
  3.91225182910169*^9}},ExpressionUUID->"baad6f9d-0bb7-4e60-b48a-\
72a21bd4a19f"],

Cell[TextData[{
 "Options:\n\tHingeThickness \[Rule] ",
 StyleBox["ht",
  FontSlant->"Italic"],
 ", the thickness of hinges between connected parts.\n\tHingeEndsClipped \
\[Rule] True | False, whether to clip the ends to run the wires straight \
across. Default is True.\n\tHingeEndsInset \[Rule] True | False, whether to \
inset the ends by half the thickness so the wires are flush with the \
specified endpoints. Default is True.\n\tHingeWireWidth \[Rule] ",
 StyleBox["hw",
  FontSlant->"Italic"],
 " | Automatic, specifies the width of each wire.\n\tHingeNumWires \[Rule] ",
 StyleBox["nw",
  FontSlant->"Italic"],
 ", the number of wires to put between the panels (minimum 2).\n\t\
HingeMinWireGap \[Rule] ",
 StyleBox["wg",
  FontSlant->"Italic"],
 ", the minimum gap to put between adjacent wires.\n\tHingeWireCap is passed \
through to HingeWireGC."
}], "Text",
 CellChangeTimes->{{3.912251839577525*^9, 3.912251855519747*^9}, {
   3.920736675338975*^9, 3.920736697140416*^9}, {3.92073674662661*^9, 
   3.92073675926059*^9}, {3.925727820284315*^9, 3.925727839172179*^9}, {
   3.926593503271846*^9, 3.9265935305196533`*^9}, 3.92659439031178*^9, {
   3.9295556740889473`*^9, 3.92955571690421*^9}, {3.930758252236771*^9, 
   3.930758253890154*^9}, {3.932818279783113*^9, 
   3.932818315126346*^9}},ExpressionUUID->"8953ed9f-7b0b-4147-883b-\
1ae1c3ded9dc"],

Cell["\<\
Returns: a list of GraphicsComplex polyhedra that represent the wire hinges.\
\>", "Text",
 CellChangeTimes->{{3.920736912861524*^9, 
  3.920736922821521*^9}},ExpressionUUID->"0dd3a3dc-9c7a-41e5-953e-\
67cbb8a3735a"],

Cell["\<\
The two panel edges don\[CloseCurlyQuote]t have to be parallel; they can even \
be skew. However, if they are skew, note that rectangular wires will be \
skewed similarly.\
\>", "Text",
 CellChangeTimes->{{3.9207375654430723`*^9, 3.920737590619326*^9}, {
  3.932818359408812*^9, 
  3.9328183903274803`*^9}},ExpressionUUID->"d311aef1-2eef-4bf3-9e44-\
6637dea48e3b"],

Cell["\<\
Note that the wires always attempt to run straight across the hinges, so if \
the edge on one side is longer than the edge on the other, the wires will be \
aligned to the short-side edge.\
\>", "Text",
 CellChangeTimes->{{3.920736924765427*^9, 3.920736967150148*^9}, {
  3.932818400569236*^9, 
  3.932818401360235*^9}},ExpressionUUID->"28e2a8cb-430f-44cf-867c-\
94bc07745c40"],

Cell["\<\
If you set HingeNumWires to a very large number, then the  number of wires \
will vary with the length of the hinge and their spacing will be set by \
HingeMinWireGap.\
\>", "Text",
 CellChangeTimes->{{3.925727889123169*^9, 
  3.925727979363291*^9}},ExpressionUUID->"e86cdff1-fbf3-4d15-b6af-\
76d13d985799"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "HingeMultiWireGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HingeThickness", "->", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeEndsClipped", "->", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeEndsInset", "->", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeWireWidth", "->", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"HingeNumWires", "->", "2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeMinWireGap", "->", "0"}]}], "\[IndentingNewLine]", "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.912252524177183*^9, 3.912252549941126*^9}, 
   3.912574879088312*^9, {3.920736845070668*^9, 3.920736859724792*^9}, {
   3.925727849068521*^9, 3.925727863636999*^9}, {3.926593547489171*^9, 
   3.9265935525051827`*^9}, 3.926594390326749*^9, {3.9295557218871593`*^9, 
   3.929555727032009*^9}, {3.932818416338265*^9, 3.932818428440978*^9}},
 CellLabel->
  "In[4359]:=",ExpressionUUID->"416f088b-309c-415f-98f4-2b22ce28578b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HingeMultiWireGC", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ht", ",", "hc", ",", "hi", ",", "hw", ",", "wz", ",", "nw", ",", "wg", ",",
       "p1r", ",", "p2r", ",", "q1r", ",", "q2r", ",", "rp", ",", "rq", ",", 
      "pw", ",", "qw"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ht", ",", "hc", ",", "hi", ",", "hw", ",", "nw", ",", "wg"}], 
       "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "HingeThickness", ",", "HingeEndsClipped", ",", "HingeEndsInset", ",",
           "HingeWireWidth", ",", "HingeNumWires", ",", "HingeMinWireGap"}], 
         "}"}], "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "HingeMultiWireGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"hw", "===", "Automatic"}], ",", 
       RowBox[{"hw", "=", "ht"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", 
         RowBox[{"IntegerQ", "[", "nw", "]"}]}], "||", 
        RowBox[{"nw", "<", "2"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"HingeNumWires", "::", "badval"}], ",", "nw"}], "]"}], ";", 
        
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Possibly", " ", "clip", " ", "the", " ", "points"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1r", ",", "p2r", ",", "q1r", ",", "q2r"}], "}"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{"hc", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"HingeEndsClip", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Possibly", " ", "inset", " ", "the", " ", "points", " ", "by", " ", 
        "the", " ", "half"}], "-", 
       RowBox[{"width", " ", "of", " ", "the", " ", "wire"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"hi", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rp", "=", 
         RowBox[{"NormalizeReal", "[", 
          RowBox[{"p2r", "-", "p1r"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rq", "=", 
         RowBox[{"NormalizeReal", "[", 
          RowBox[{"q2r", "-", "q1r"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p1r", ",", "p2r", ",", "q1r", ",", "q2r"}], "}"}], "+=", 
         RowBox[{"0.5", "hw", 
          RowBox[{"{", 
           RowBox[{"rp", ",", 
            RowBox[{"-", "rp"}], ",", "rq", ",", 
            RowBox[{"-", "rq"}]}], "}"}]}]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Compute", " ", "the", " ", "best"}], "-", 
       RowBox[{"fit", " ", "z"}], "-", "direction"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"wz", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"TriangleNormal3D", "[", 
         RowBox[{"p1r", ",", "p2r", ",", "q1r"}], "]"}], "+", 
        RowBox[{"TriangleNormal3D", "[", 
         RowBox[{"p1r", ",", "p2r", ",", "q2r"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Set", " ", "upper", " ", "bound", " ", "on", " ", "nw", " ", "to", " ",
        "respect", " ", "the", " ", "minimum", " ", 
       RowBox[{"gap", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nw", "=", 
      RowBox[{"1", "+", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"nw", "-", "1"}], ",", 
         RowBox[{"Floor", "[", 
          FractionBox[
           RowBox[{"Mag", "[", 
            RowBox[{"p1r", "-", "p2r"}], "]"}], 
           RowBox[{"hw", "+", "wg"}]], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "the", " ", "specified", " ", "number", " ", "of", " ", 
       "wires", " ", "connecting", " ", "the", " ", "edges"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"nw", ">", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"multiple", " ", "wires"}], ",", " ", 
         RowBox[{"spread", " ", "them", " ", "out"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"pw", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "k"}], ")"}], "p1r"}], "+", 
            RowBox[{
             RowBox[{"(", "k", ")"}], "p2r"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"qw", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "k"}], ")"}], "q1r"}], "+", 
            RowBox[{
             RowBox[{"(", "k", ")"}], "q2r"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"HingeRectWireGC", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"pw", ",", "qw"}], "}"}], ",", 
            RowBox[{"HingeWireZ", "->", "wz"}], ",", "opts"}], "]"}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"If", "[", 
