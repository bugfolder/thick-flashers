                RowBox[{"0", ",", "\[Pi]"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}]}], "}"}], ",", 
