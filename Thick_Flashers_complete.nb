Cell[TextData[{
 "MakeMinorConnectedUnitChain[",
 StyleBox["sectorangles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "L"], ",", 
     SubscriptBox["w", "R"]}]}], TraditionalForm]],ExpressionUUID->
  "48202283-7ae6-4979-94f3-b653d8e8f6d7"],
 StyleBox["}, opts",
  FontSlant->"Italic"],
 "] takes a list of four sector angles and returns a TLinearChain that is a \
chain of ",
 StyleBox["n+1",
  FontSlant->"Italic"],
 " of these vertices spaced unit distance apart and connected by a chain of \
folds of alternating type ",
 StyleBox["type",
  FontSlant->"Italic"],
 " (i.e., minor-connected)."
}], "Text",
