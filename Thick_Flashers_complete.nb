Cell[BoxData[
 RowBox[{
  RowBox[{"Styled3DDiskFromInPlaneVectors", "[", 
   RowBox[{"p_List", ",", 
    RowBox[{"{", 
     RowBox[{"r1_List", ",", "r2_List"}], "}"}], ",", "r_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ad", ",", "ls", ",", "fs", ",", "x", ",", "y", ",", "z", ",", "pts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ad", "=", 
      RowBox[{
       RowBox[{"ArcDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DDiskFromInPlaneVectors", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ls", "=", 
      RowBox[{
       RowBox[{"LineStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DDiskFromInPlaneVectors", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{
       RowBox[{"FillStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Styled3DDiskFromInPlaneVectors", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{"NormalizeReal", "[", "r1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"r1", "\[Cross]", "r2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"y", "=", 
      RowBox[{"z", "\[Cross]", "x"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "+", 
         RowBox[{"r", "#"}]}], "&"}], "/@", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", " ", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], " ", "+", " ", 
          RowBox[{"y", " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", "0", ",", 
           RowBox[{"2", "\[Pi]"}], ",", 
           RowBox[{"2", 
            RowBox[{"\[Pi]", "/", "ad"}]}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"fs", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", "pts", "]"}], ",", "fs"}], "]"}]}], "]"}], 
       ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ls", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", "pts", "]"}], ",", "ls"}], "]"}]}], "]"}]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
