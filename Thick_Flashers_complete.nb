      RowBox[{"verts", "/.", "ffr"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "offsets", " ", "for", " ", "selected", " ", "points", " ",
        "to", " ", "shift", " ", "labels"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
