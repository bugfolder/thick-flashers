Cell["\<\
Example. A paraboloidal cylinder with transverse ruling lines, given as a \
surface.\
\>", "Text",
 CellChangeTimes->{{3.688081529687203*^9, 3.688081530415124*^9}, {
  3.688081570783464*^9, 3.6880815756519423`*^9}, {3.688082210324199*^9, 
