257f69a55456"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hcwc", ",", "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", 
      "ff1", ",", "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", 
      "yR", ",", "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2",
       ",", "vr", ",", "xe", ",", "z3", ",", "z0L", ",", "z0R", ",", "gg"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"hcwc", "=", 
      RowBox[{"HCwCParabola", "[", 
       RowBox[{
        RowBox[{"5.", "\[Degree]"}], ",", 
        RowBox[{"85.", "\[Degree]"}], ",", 
        RowBox[{"60.", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "90."}], "\[Degree]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", "ff1", ",", 
        "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", "yR", ",", 
        "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2"}], "}"}],
       "=", "hcwc"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vr", "=", "0.5"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"vector", " ", "lengths"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
      "points", " ", "on", " ", "axis", " ", "of", " ", "rotation", " ", 
       "between", " ", "mirror", " ", "planes"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"z3", "=", 
      RowBox[{
       RowBox[{"ff2", "[", 
        RowBox[{"\[Pi]", "/", "2"}], "]"}], "+", 
       RowBox[{"xL", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ff3", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", 
            RowBox[{"ff2", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}]}], ")"}], ".", "yR"}], 
         RowBox[{"xL", ".", "yR"}]]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z0L", "=", 
      RowBox[{"z3", "-", 
       RowBox[{"z", 
        RowBox[{"(", 
         RowBox[{"z", ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ff3", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", 
            RowBox[{"ff0", "[", "0", "]"}]}], ")"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z0R", "=", 
      RowBox[{"z3", "-", 
       RowBox[{"z", 
        RowBox[{"(", 
         RowBox[{"z", ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ff3", "[", 
             RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", 
            RowBox[{"ff3", "[", "0", "]"}]}], ")"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xe", "=", 
      RowBox[{"0.5", "+", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{"ff2", "[", 
            RowBox[{"\[Pi]", "/", "2"}], "]"}], "-", "z3"}], "]"}], ",", 
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{"ff2", "[", "0", "]"}], "-", "z0R"}], "]"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"build", " ", "the", " ", "Graphics3D", " ", "representation"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gg", "=", 
      RowBox[{"HCwCGraphics3D", "[", 
       RowBox[{"hcwc", ",", "\[IndentingNewLine]", 
        RowBox[{"Axes", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ViewPoint", "\[Rule]", 
         RowBox[{"5", 
          RowBox[{"(", 
           RowBox[{"xL", "+", 
            RowBox[{".8", "yL"}], "+", 
            RowBox[{".4", "z"}]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"ViewVertical", "\[Rule]", "z"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", "0.8", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowHCwCPlanes", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "but", " ", "add", " ", "to", " ", "it", " ", "various", " ", 
       "vectors"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ReplacePart", "[", 
       RowBox[{"gg", ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "gg", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"left", " ", "vectors"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"StyledVector", "[", 
            RowBox[{
             RowBox[{"ff2", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", 
             RowBox[{"vr", " ", "xL"}], ",", 
             RowBox[{"VectorColor", "\[Rule]", "Red"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StyledVector", "[", 
            RowBox[{
             RowBox[{"ff2", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", 
             RowBox[{"vr", " ", "yL"}], ",", 
             RowBox[{"VectorColor", "\[Rule]", "Green"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StyledVector", "[", 
            RowBox[{
             RowBox[{"ff2", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", 
             RowBox[{"vr", " ", "z"}], ",", 
             RowBox[{"VectorColor", "\[Rule]", "Blue"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"right", " ", "vectors"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"StyledVector", "[", 
            RowBox[{
             RowBox[{"ff3", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", 
             RowBox[{"vr", " ", "xR"}], ",", 
             RowBox[{"VectorColor", "\[Rule]", "Red"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StyledVector", "[", 
            RowBox[{
             RowBox[{"ff3", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", 
             RowBox[{"vr", " ", "yR"}], ",", 
             RowBox[{"VectorColor", "\[Rule]", "Green"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StyledVector", "[", 
            RowBox[{
             RowBox[{"ff3", "[", 
              RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", 
             RowBox[{"vr", " ", "z"}], ",", 
             RowBox[{"VectorColor", "\[Rule]", "Blue"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"pivot", " ", "vector"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"StyledVector", "[", 
            RowBox[{
             RowBox[{"ff1", "[", "0", "]"}], ",", 
             RowBox[{"2", "vr", " ", "pv"}], ",", 
             RowBox[{"VectorColor", "\[Rule]", "Purple"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"pivot", " ", "plane"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Polygon", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ff0", "[", "0", "]"}], ",", 
                RowBox[{"ff1", "[", "0", "]"}], ",", 
                RowBox[{"ff2", "[", "0", "]"}]}], "}"}], "]"}], ",", 
             RowBox[{"Opacity", "[", "0.2", "]"}], ",", "Purple", ",", 
             RowBox[{"EdgeForm", "[", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", "}"}]}], "}"}]}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
