   RowBox[{"h_", ",", "w_List"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"HatRotationDenominator", "[", "h", "]"}], " ", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.595527754361866*^9, 3.595527821575969*^9}, {
   3.595527861855826*^9, 3.5955280118846817`*^9}, {3.595528473923346*^9, 
   3.595528544400693*^9}, 3.595529203578464*^9, 3.595610965644889*^9, 
   3.595611004419694*^9, {3.59561161509552*^9, 3.595611629805258*^9}},
 CellLabel->
  "In[789]:=",ExpressionUUID->"8ef306df-5f81-419f-93ff-204a237fc78d"],

