Cell[TextData[{
 "TileArrowDF[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "] returns a directed full arrowhead centered on the line from ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q. ",
  FontSlant->"Italic"],
 "If dir>0, then ",
 StyleBox["p",
  FontSlant->"Italic"],
 " is the tail; otherwise ",
 StyleBox["q",
  FontSlant->"Italic"],
 " is the tail."
}], "Text",
 CellChangeTimes->{{3.6275806886248307`*^9, 3.627580723023911*^9}, {
   3.627580922866042*^9, 3.627580960953753*^9}, 3.6275816550933876`*^9, {
   3.627582719809739*^9, 3.627582732255163*^9}, 3.627654900599959*^9, {
   3.629838825861334*^9, 3.629838826090947*^9}, {3.629838942457243*^9, 
   3.629838948352613*^9}},ExpressionUUID->"d0f0809a-1dd3-46b3-b3a0-\
f22178330058"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TileArrowDF", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p_", ",", "q_"}], "}"}], ",", " ", "dir_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "s", ",", "ctr", ",", "sz", ",", "w", ",", "pts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"q", "-", "p"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"Rotate90", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "+", "q"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sz", "=", "0.18"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.3"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"sz", "#"}]}], "&"}], "/@", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dir", ">", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", ".5"}], " ", "r"}], "-", 
            RowBox[{"w", " ", "s"}]}], ",", 
           RowBox[{
            RowBox[{"+", ".5"}], " ", "r"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", ".5"}], " ", "r"}], "+", 
            RowBox[{"w", " ", "s"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"+", ".5"}], " ", "r"}], "-", 
            RowBox[{"w", " ", "s"}]}], ",", 
           RowBox[{
            RowBox[{"-", ".5"}], " ", "r"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"+", ".5"}], " ", "r"}], "+", 
            RowBox[{"w", " ", "s"}]}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Polygon", "[", "pts", "]"}], ",", "TilingLine"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.627580968539734*^9, 3.627581201475292*^9}, {
   3.627581359073287*^9, 3.627581435702797*^9}, 3.62758188230826*^9, {
