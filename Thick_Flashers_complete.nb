Cell["\<\
Example. A dynamic manipulation. The fold angles are being solved dynamically \
as you manipulate the angle of the central crease.\
\>", "Text",
 CellChangeTimes->{{3.594237037223569*^9, 3.594237063075036*^9}, {
  3.594237337690959*^9, 
  3.594237351337229*^9}},ExpressionUUID->"b36c244f-5110-4ee7-a184-\
6853a5c8687e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "types", ",", "tobjcp", ",", "faspecs", ",",
         "foldangles", ",", "tobjff"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"verts", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
