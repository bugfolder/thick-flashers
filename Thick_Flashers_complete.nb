Cell["\<\
And reconstruct it it does. Note that we need to use FullSimplify to get the \
recognizable expressions.\
\>", "Text",
 CellChangeTimes->{{3.7995222730124288`*^9, 
  3.799522317468864*^9}},ExpressionUUID->"a9a50351-9da6-4bc0-b180-\
9ad8b062c803"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]", ",", "as", ",", "ds", ",", "\[Kappa]", ",", "\[Tau]", ",", 
      "ui", ",", "ci", ",", "ti", ",", "bi", ",", "csys", ",", "c"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"as", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", ">", "0"}], ",", 
        RowBox[{"\[Theta]", "<", 
         RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{
       RowBox[{"Sec", "[", "\[Theta]", "]"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "ci", ",", "ti", ",", "bi"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"RecoverCurve3DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]", ",", "\[Tau]", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "ci", ",", "ti", ",", "bi"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "FullSimplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"csys", "//", " ", "PrettyParameters"}], "//", "ColumnForm"}], 
      "//", "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"Curve3D", "/.", "csys"}], "/.", 
       RowBox[{"\[Theta]", "\[Rule]", 
        RowBox[{"15.", "\[Degree]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"c", "[", "s", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.668968168605674*^9, 3.6689682121787868`*^9}, 
   3.668970341870265*^9, 3.669145167101568*^9, {3.67210182323211*^9, 
