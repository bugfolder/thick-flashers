Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", " ", "edges", ",", "faces", ",", "types", ",", "tobj", ",",
       "tobj1", ",", "tobj2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", ".5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", ".5"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "6", ",", "3", ",", "4", ",", "5", ",", "7"}], 
        "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "M"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"MakeTGraph2DAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", "faces", ",", 
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", "unassigned", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{"MakeTGraph2DAssigned", "[", 
       RowBox[{"verts", ",", "edges", ",", "faces", ",", 
