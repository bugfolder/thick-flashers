Cell[CellGroupData[{

Cell[TextData[{
 "Styled2DArc[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 ", opts]\n\t(options) ArcLabel, ArcLabelRadius, LineStyle"
}], "Subsubsection",
 CellChangeTimes->{{3.440258169019055*^9, 3.440258179386034*^9}, {
   3.4402592412607403`*^9, 3.440259251347217*^9}, {3.443204850708323*^9, 
   3.44320487052221*^9}, {3.443205291954304*^9, 3.443205294519713*^9}, 
   3.443206808975539*^9, {3.6689856253850613`*^9, 3.668985625385232*^9}, {
   3.801001674451446*^9, 
   3.8010016982233768`*^9}},ExpressionUUID->"5b9a81bb-4f92-41ea-88c9-\
e0d39754babd"],

Cell[TextData[{
 "Styled2DArc[",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 ", opts] returns a list of Graphics primitives that give a 2D \"pie slice\" \
extending counterclockwise from direction ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "1"], TraditionalForm]],ExpressionUUID->
  "536441db-8fb5-4081-99f2-ca27e0a14d88"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "694a6c09-62af-4831-b337-55b45126aa34"],
 ". Options are:\n\tArcLabel \[Rule] ",
 StyleBox["label",
  FontSlant->"Italic"],
 ", specifies that the middle of the arc is to be labeled with the graphics \
primitive ",
 StyleBox["label",
  FontSlant->"Italic"],
 ".\n\tArcLabelRadius \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies that the label is placed a distance ",
 StyleBox["r",
  FontSlant->"Italic"],
 " from the center of the unit circle."
}], "Text",
 CellChangeTimes->{{3.44025819254538*^9, 3.4402582872905903`*^9}, {
   3.440259254221453*^9, 3.4402592889196253`*^9}, {3.443204873899643*^9, 
   3.443204933780149*^9}, 3.443205299585046*^9, 3.443206212849834*^9, 
   3.591800708629938*^9, {3.668985625407954*^9, 3.6689856254080133`*^9}, {
   3.801001702620306*^9, 
   3.801001711448276*^9}},ExpressionUUID->"b6572521-d9ad-42e9-ac97-\
d69b70fe79de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArcLabel", "::", "usage"}], 
   "=", "\"\<ArcLabel is an option to Styled2DArc that specifies a label to \
be placed in the middle of the arc.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.591800711660677*^9, 3.591800740452772*^9}, 
   3.668985625427194*^9},
 CellLabel->
  "In[1624]:=",ExpressionUUID->"a4b2c7e7-fe72-4ce3-8564-e0bd50a0db0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArcLabelRadius", "::", "usage"}], 
   "=", "\"\<ArcLabelRadius is an option to Styled2DArc that specifies the \
distance from the center that the label should be placed.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.591800711660677*^9, 3.591800782394551*^9}, 
