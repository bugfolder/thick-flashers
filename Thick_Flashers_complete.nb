Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PrimalDualGraphics", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ShowPrimalEdges", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ShowDualEdges", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PrimalDirectedEdges", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DualDirectedEdges", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ShowPrimalVertices", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ShowDualVertices", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PrimalVertexLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DualVertexLabels", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PrimalVertexLetter", "\[Rule]", "\"\<p\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"DualVertexLetter", "\[Rule]", "\"\<d\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlaceSideBySide", "\[Rule]", "False"}]}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.465988931609723*^9, 3.465988945368341*^9}, {
