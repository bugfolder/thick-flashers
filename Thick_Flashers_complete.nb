Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "\[Gamma]0", ",", "\[Gamma]", ",", "u0", ",", "u1", ",", "ff", 
      ",", "rrL", ",", "rrR", ",", "f", ",", "rL", ",", "rR", ",", "ui", ",", 
      "fi", ",", "ti"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]0", "=", 
      RowBox[{"120", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"\[Gamma]0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "fi", ",", "ti"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "s", "]"}], ",", 
          RowBox[{"Sin", "[", "s", "]"}], ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}]}], " ", 
          RowBox[{"Cos", "[", "#1", "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}]}], " ", 
          RowBox[{"Sin", "[", "#1", "]"}]}], ",", 
         RowBox[{"Sin", "[", 
          FractionBox["\[Gamma]0", "2"], "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[Gamma]0", "2"], "]"}], " ", 
          RowBox[{"Cos", "[", "#1", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[Gamma]0", "2"], "]"}], " ", 
          RowBox[{"Sin", "[", "#1", "]"}]}], ",", 
         RowBox[{"Sin", "[", 
          FractionBox["\[Gamma]0", "2"], "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"CurvedFoldShapePlots3D", "[", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "rL", ",", "rR"}], "}"}], "=", 
      RowBox[{"NFlattenFold2D", "[", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "fi", ",", "ti"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"CurvedFoldShapePlots2D", "[", 
        RowBox[{"f", ",", "rL", ",", "rR", ",", "\[Gamma]", ",", 
