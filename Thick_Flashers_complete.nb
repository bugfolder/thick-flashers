   RowBox[{"Options", "[", "MakeTSpaceCurve", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SpaceCurveFirstCreaseAngle", "\[Rule]", 
      RowBox[{"0", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
