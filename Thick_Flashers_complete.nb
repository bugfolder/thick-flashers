Cell[CellGroupData[{

Cell[TextData[{
 "MonolithicEmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) StationaryFace, KillMergedEdges, SamePtTolerance, \
CollinearCleanup, CollinearTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.707863928641756*^9, 3.70786393494163*^9}, {
   3.707864025397832*^9, 3.707864025902627*^9}, 3.70786419072264*^9, 
   3.707866345526781*^9, {3.707866886440535*^9, 
   3.707866888600347*^9}},ExpressionUUID->"3228d8ab-3fb1-48bd-aec5-\
8cf6cd64276d"],

Cell[TextData[{
 "MonolithicEmbedTiling[",
 StyleBox["tiling",
  FontSlant->"Italic"],
 ", TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] embeds a tiling as a single TGraph2DAssigned by merging individual tiles. \
Its folded form is the actual folded form resulting from folding the tiles."
}], "Text",
 CellChangeTimes->{{3.707836500641687*^9, 3.707836546655613*^9}, {
  3.707836582304219*^9, 3.707836589239737*^9}, {3.707864416797285*^9, 
  3.7078644481061716`*^9}, {3.707866541069887*^9, 
  3.707866565278678*^9}},ExpressionUUID->"fd32b65c-da31-4607-9574-\
fab5af1ed5b4"],

Cell[TextData[{
 "Options:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 " is passed through to FoldGraph2D.\n\tKillMergedEdges \[Rule] True | False, \
specify whether to remove borders edges of tiles.\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", tolerance on whether two vertices are distinct.\n\tCollinearCleanup \
\[Rule] True | False, specify whether to remove degree-2 vertices between \
collinear edges.\n\tCollinearTolerance \[Rule] tol, tolerance on whether two \
edges at degree-2 vertices are collinear."
}], "Text",
 CellChangeTimes->{{3.7078668414715166`*^9, 3.70786686584019*^9}, 
   3.707866914492471*^9},ExpressionUUID->"26f0ed31-6408-41c9-a2d9-\
af2baa956ea3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MonolithicEmbedTiling", "[", 
   RowBox[{"tiling_List", ",", "TGraph2DAssigned", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cc", ",", "kme", ",", "tlist", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kme", "=", 
      RowBox[{
       RowBox[{"KillMergedEdges", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MonolithicEmbedTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"CollinearCleanup", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MonolithicEmbedTiling", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tlist", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"tiling", ",", "TGraph2DAssigned"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MergeGraph2DAssigneds", "[", 
       RowBox[{"tlist", ",", 
        RowBox[{"KillMergedEdges", "\[Rule]", "kme"}], ",", "opts"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"cc", ",", 
       RowBox[{"tobj", "=", 
        RowBox[{"CollinearCleanupGraph2DAssigned", "[", "tobj", "]"}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FoldGraph2D", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"TypeToFlatFoldAngle", "[", 
        RowBox[{"tobj", "[", "EdgeTypes", "]"}], "]"}], ",", "opts"}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.630160978600581*^9, 3.63016099822439*^9}, {
   3.630161058580984*^9, 3.630161076601981*^9}, {3.707767435949171*^9, 
