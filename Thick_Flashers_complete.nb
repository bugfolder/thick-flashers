Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the directrix as a pure function.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] the director as a pure function.\n\t\[Sigma] \[LongDash] the \
orientation, = \[PlusMinus]1."
}], "Text",
