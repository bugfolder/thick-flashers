Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "UnitTriangleOffsetTwistTile", ",", "angles_", ",", "w_", ",", "d_", ",",
       "types_List"}], "}"}], ",", "decoration_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PolygonOffsetTwistTile", ",", 
      RowBox[{"UnitTriangleVertices", "[", "angles", "]"}], ",", "w", ",", 
      "d", ",", "types"}], "}"}], ",", "decoration", ",", "opts"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.629848399972303*^9, 3.629848426890907*^9}, {
   3.629848667124596*^9, 3.629848744918406*^9}, {3.62984930933378*^9, 
