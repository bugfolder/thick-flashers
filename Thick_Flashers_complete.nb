  3.7069555014491253`*^9}},ExpressionUUID->"79d5e069-1c99-4dea-a23a-\
3890125fa9bd"],

Cell["\<\
We can\[CloseCurlyQuote]t use FoldGraph2DAll on SplitSquareTwist45Graph \
because one of the folds remains unfolded, but we can build this by modifying \
SquareTwist45Graph2D.\
\>", "Text",
 CellChangeTimes->{{3.7069556005000143`*^9, 
  3.7069556376593513`*^9}},ExpressionUUID->"975629ec-387e-48dd-9686-\
1a077891a91f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SplitSquareTwist45Graph2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"SplitSquareTwist45Graph2D", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj", ",", "edges"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tobj", "=", "SplitSquareTwist45Graph"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", "SquareTwist45Graph2D"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"GetValue", "[", 
           RowBox[{"tobj", ",", "Edges"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"8", ",", "9"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tobj", "//", 
         RowBox[{"ReplaceProperty", "[", 
          RowBox[{"Edges", "\[Rule]", "edges"}], "]"}]}], "//", 
        "RebuildPlaneGraph"}]}]}], "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.70682984856465*^9, 3.706829884696419*^9}, {
   3.7068299161460657`*^9, 3.7068299216173058`*^9}, {3.7069553958657513`*^9, 
   3.706955395888623*^9}, {3.706955519126647*^9, 3.70695552306562*^9}, {
   3.70695557367141*^9, 3.706955576970284*^9}, {3.7069557818688173`*^9, 
   3.706955793839856*^9}, 3.708400177653901*^9, 3.70860365648834*^9},
 CellLabel->
  "In[1365]:=",ExpressionUUID->"563f2968-7017-49e0-a4a7-a2d9b0e043e5"],

