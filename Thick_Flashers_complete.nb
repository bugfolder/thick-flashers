  FontSlant->"Italic"],
 ", ",
 StyleBox["bb2i",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions"
}], "Subsubsection",
 CellChangeTimes->{{3.801503059303677*^9, 3.801503104049746*^9}, {
   3.801503348444891*^9, 3.8015033537542963`*^9}, 3.801503459549855*^9, 
   3.801590629123617*^9, {3.801908804943684*^9, 
   3.8019088198924503`*^9}},ExpressionUUID->"56a99be9-a10b-411c-a731-\
f853b03dca1d"],

Cell[TextData[{
 "FoldSurfaceToCone[",
 StyleBox["b1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd1",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bb2}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] finds the fold and developable surface that matches a cone to a specified \
developable surface."
}], "Text",
 CellChangeTimes->{{3.801503112628154*^9, 3.801503173065975*^9}, 
   3.80150346283514*^9, 
   3.801590629180255*^9},ExpressionUUID->"581006a1-9813-4431-8d9d-\
81e360d57bf5"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b1",
  FontSlant->"Italic"],
 " \[LongDash] 2D directrix of the first surface.\n\t",
 StyleBox["d1",
  FontSlant->"Italic"],
 " \[LongDash] 2D director of the first surface.\n\t",
 StyleBox["bb1",
  FontSlant->"Italic"],
 " \[LongDash] 3D directrix of the first surface.\n\t",
 StyleBox["dd1",
  FontSlant->"Italic"],
 " \[LongDash] 3D director of the first surface.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter at which the two surfaces are properly oriented.\n\t",
 StyleBox["b2i",
  FontSlant->"Italic"],
 " \[LongDash] 2D cone point of the second surface.\n\t",
 StyleBox["bb2i",
  FontSlant->"Italic"],
 " \[LongDash] 3D cone point of the second surface."
}], "Text",
 CellChangeTimes->{{3.801503207744983*^9, 3.801503296475118*^9}, {
  3.801908808043466*^9, 
  3.801908815242422*^9}},ExpressionUUID->"a0569f62-d421-4355-97ab-\
f477ea42e493"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
