0c9691d2990c"],

Cell[TextData[{
 "Options:\n\tKillMergedEdges \[Rule] True | False, specify whether to remove \
merged edges.\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", tolerance on whether two vertices are distinct."
}], "Text",
 CellChangeTimes->{{3.707777850542234*^9, 3.707777853581541*^9}, {
   3.707778293920401*^9, 3.70777842795789*^9}, {3.707781820295705*^9, 
   3.707781862978016*^9}, 3.707823804378097*^9, 3.707824770290392*^9, 
   3.707824971870028*^9, {3.707825192562799*^9, 
   3.707825195249933*^9}},ExpressionUUID->"99e5dad7-7be8-4f91-80ac-\
d2666dcad6a5"],

Cell["\<\
Returns a single TGraph2DAssigned containing the merged graph.\
\>", "Text",
 CellChangeTimes->{{3.707767605880972*^9, 3.707767608733931*^9}, {
  3.707783672716524*^9, 
  3.707783673261705*^9}},ExpressionUUID->"42f12329-446d-41a1-bf39-\
30a9a3f4a1ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MergeGraph2DAssigneds", "[", 
   RowBox[{"tglist_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mgdata", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"AssertClasses", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"TGraph", ",", "TGraph2D", ",", "TAssigned"}], "}"}], ",", 
         "MergeGraph2DAssigneds"}], "]"}], "&"}], "/@", "tglist"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mgdata", "=", 
      RowBox[{"MergeGraphsData", "[", 
       RowBox[{"tglist", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"ApplyMergeTo", "[", 
       RowBox[{"tglist", ",", "mgdata"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "//", 
       RowBox[{"ApplyMerge2D", "[", 
        RowBox[{"tglist", ",", "mgdata"}], "]"}]}], "//", 
      RowBox[{"ApplyMergeAssigned", "[", 
       RowBox[{"tglist", ",", "mgdata"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707783701125811*^9, 3.707783712677651*^9}, {
  3.707783766766123*^9, 3.70778379106336*^9}, {3.707784086401854*^9, 
  3.707784127257392*^9}, {3.707817241401869*^9, 3.707817255393718*^9}, {
  3.707817333153957*^9, 3.707817343058769*^9}, {3.707825239442099*^9, 
  3.70782525806498*^9}, {3.707905257785371*^9, 3.707905260529553*^9}, {
  3.707911256723084*^9, 3.70791130640932*^9}},
 CellLabel->
  "In[2003]:=",ExpressionUUID->"ecb936b4-4716-4044-960e-89a095ddcb86"],

Cell["\<\
Example. For simplicity, the folded form doesn\[CloseCurlyQuote]t actually \
have any folds in it (and remember, the join fold is assumed to be unfolded).\
\
\>", "Text",
 CellChangeTimes->{{3.594663884595607*^9, 3.594663890738531*^9}, {
  3.649964172495646*^9, 
  3.649964213468704*^9}},ExpressionUUID->"e4511eaa-94e9-4940-9bf9-\
8a94bb9b1fc7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts1", ",", "edges1", ",", "verts2d1", ",", "types1", ",", "tobj1", ",",
       "verts2", ",", "edges2", ",", "verts2d2", ",", "types2", ",", "tobj2", 
      ",", "tglist", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d1", "=", "verts1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types1", "=", 
      RowBox[{"{", 
       RowBox[{"B", ",", "B", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{"MakeTGraph2DAssigned", "[", 
        RowBox[{"verts1", ",", "edges1", ",", 
         RowBox[{"{", "}"}], ",", "verts2d1", ",", "types1"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d2", "=", "verts2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types2", "=", 
      RowBox[{"{", 
       RowBox[{"B", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{
       RowBox[{"MakeTGraph2DAssigned", "[", 
        RowBox[{"verts2", ",", "edges2", ",", 
         RowBox[{"{", "}"}], ",", "verts2d2", ",", "types2"}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "go", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tglist", "=", 
      RowBox[{"{", 
       RowBox[{"tobj1", ",", "tobj2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MergeGraph2DAssigneds", "[", "tglist", "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GraphGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"CreasePatternGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"CreasePatternGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"CreasePatternGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"GenericFoldedFormGraphics", "[", 
            RowBox[{"tobj1", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GenericFoldedFormGraphics", "[", 
            RowBox[{"tobj2", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}]}], "]"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"GenericFoldedFormGraphics", "[", 
            RowBox[{"tobj", ",", 
             RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}]}], "]"}]}], 
          "\[IndentingNewLine]", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594663894798616*^9, 3.594664130749181*^9}, {
   3.594664326661407*^9, 3.5946643368284073`*^9}, {3.594664401025264*^9, 
   3.594664414552273*^9}, 3.594664465127211*^9, {3.594664571710458*^9, 
