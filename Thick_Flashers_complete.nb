          RowBox[{"{", 
           RowBox[{"i", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cliprect", "=", 
      RowBox[{"SquareVertices", "[", "2.3", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ptilespecs", "=", 
      RowBox[{"PruneTiling", "[", 
       RowBox[{"tilespecs", ",", "cliprect"}], "]"}]}], ";", 
