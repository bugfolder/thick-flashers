   3.707822137772848*^9},ExpressionUUID->"ae4e7189-a54d-4617-9843-\
73438f338123"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GraphicsToTGraph", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"SamePtTolerance", " ", "\[Rule]", " ", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.485092351526634*^9, 3.485092381790701*^9}, {
   3.485096150328274*^9, 3.485096151758368*^9}, 3.591791216234027*^9, 
