Cell[CellGroupData[{

Cell[TextData[{
 "TriangleBasis3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "]\nTriangleBasis3D[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r}",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.649959813227148*^9, 3.649959858937087*^9}, {
   3.6499603674247026`*^9, 3.64996036934406*^9}, {3.686847388349579*^9, 
   3.686847413638243*^9}, 3.701092493377264*^9, {3.915801507828701*^9, 
   3.915801513052771*^9}},ExpressionUUID->"fbf12b31-e554-46a0-8b59-\
768859c0931b"],

Cell[TextData[{
 "TriangleBasis3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 "] returns a list {",
 StyleBox["x",
  FontSlant->"Italic"],
 ", ",
 StyleBox["y",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z",
  FontSlant->"Italic"],
 "} of three vectors that define an orthonormal system local to the triangle \
with 3D vertices ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", in which:\n\t(a) ",
 StyleBox["x",
  FontSlant->"Italic"],
 " lies along the line from ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q",
  FontSlant->"Italic"],
 "\n\t(b) ",
 StyleBox["r",
  FontSlant->"Italic"],
 " lies in the upper half of the ",
 StyleBox["x",
  FontSlant->"Italic"],
 "-",
 StyleBox["y",
  FontSlant->"Italic"],
 " plane.\n\t(c) {",
 StyleBox["p",
  FontSlant->"Italic"],
 ",",
 StyleBox["q",
  FontSlant->"Italic"],
 ",",
 StyleBox["r",
  FontSlant->"Italic"],
 "} circulate CCW around the z-axis."
}], "Text",
 CellChangeTimes->{{3.6499598341859007`*^9, 3.649959990928333*^9}, 
   3.649960373340371*^9, {3.686847331186198*^9, 
   3.686847377198447*^9}},ExpressionUUID->"ffeb2760-f074-4d9d-9940-\
7918460a1197"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleBasis3D", "[", 
   RowBox[{"p_", ",", "q_", ",", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"q", "-", "p"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"x", "\[Cross]", 
        RowBox[{"(", 
         RowBox[{"r", "-", "p"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"z", "\[Cross]", "x"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.649960001488458*^9, 3.649960062629581*^9}, 
   3.649960374944026*^9, {3.701092765223481*^9, 3.701092765821232*^9}},
 CellLabel->
  "In[633]:=",ExpressionUUID->"ab8cc187-48c7-4e81-8592-60c28a598dfe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleBasis3D", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_"}], "}"}], "]"}], ":=", 
  RowBox[{"TriangleBasis3D", "[", 
   RowBox[{"p", ",", "q", ",", "r"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.915801540795678*^9, 3.915801583572721*^9}},
 CellLabel->
  "In[634]:=",ExpressionUUID->"5ac4b254-93c4-4715-bf3d-cd0f2ff9d608"],

Cell["\<\
TriangleBasis3D is a matrix, of course; it is the rotation matrix that \
rotates the vertices of the triangle {p, q, r} so that it lies in the x-y \
plane and the edge from p to q is parallel to the x-axis.\
\>", "Text",
 CellChangeTimes->{{3.7260819932131033`*^9, 3.7260820001408033`*^9}, {
  3.726082063957675*^9, 3.7260821028942957`*^9}, {3.72608243188858*^9, 
  3.726082433673234*^9}},ExpressionUUID->"50bcc183-79f1-4bd1-9a8d-\
e64ee4d25ad5"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.6499600662937098`*^9, 3.649960066978983*^9}, 
   3.726081355856695*^9},ExpressionUUID->"23459253-bab3-4b9a-ae60-\
bd4cc8a5b683"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "q", ",", "r", ",", "x", ",", "y", ",", "z"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"3", ",", "1.3", ",", "1.5"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
      RowBox[{"TriangleBasis3D", "[", 
       RowBox[{"p", ",", "q", ",", "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{"\"\<p\>\"", ",", "p", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<q\>\"", ",", "q", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<r\>\"", ",", "r", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Polygon", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", "q", ",", "r"}], "}"}], "]"}], ",", "Gray", ",", 
           RowBox[{"Opacity", "[", "0.25", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "p", "]"}], ",", 
           RowBox[{"PointSize", "[", ".05", "]"}], ",", "Black"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"p", "+", "x"}]}], "}"}], "]"}], ",", "Red", ",", 
           RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"p", "+", "y"}]}], "}"}], "]"}], ",", "Green", ",", 
           RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"p", "+", "z"}]}], "}"}], "]"}], ",", "Blue", ",", 
           RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.649960073723668*^9, 3.649960322903039*^9}, 
   3.6499603763635483`*^9, {3.686847207964734*^9, 3.686847309183989*^9}, {
   3.686847562751547*^9, 3.686847564612344*^9}, 3.726081284075012*^9, {
   3.726081315937592*^9, 3.726081328440926*^9}, {3.7260814446419992`*^9, 
   3.726081445187112*^9}},
 CellLabel->
  "In[635]:=",ExpressionUUID->"930c94d7-cc12-4332-aaf1-a9847594076d"],

Cell["\<\
Example. This shows how we can use TriangleBasis3D to rotate a triangle to \
the x-y plane (and move its first vertex to the origin). See UnfoldGraph3D \
for usage in this way.\
\>", "Text",
 CellChangeTimes->{{3.7260813877434*^9, 3.726081398321622*^9}, {
  3.726082115374364*^9, 3.726082137573572*^9}, {3.726082444633173*^9, 
  3.7260824646008377`*^9}},ExpressionUUID->"e9680695-c0ae-4d86-9775-\
d578b3d2b030"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "q", ",", "r", ",", "m", ",", "x", ",", "y", ",", "z", ",", 
      "pp", ",", "qq", ",", "rr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"{", 
       RowBox[{"3", ",", "1.3", ",", "1.5"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"TriangleBasis3D", "[", 
       RowBox[{"p", ",", "q", ",", "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", "m"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pp", ",", "qq", ",", "rr"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"m", ".", "#"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "-", "p"}], ",", 
         RowBox[{"q", "-", "p"}], ",", 
         RowBox[{"r", "-", "p"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{"\"\<p\>\"", ",", "p", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<q\>\"", ",", "q", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<r\>\"", ",", "r", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{"p", ",", "q", ",", "r"}], "}"}], "]"}], ",", "Gray", 
              ",", 
              RowBox[{"Opacity", "[", "0.25", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", "p", "]"}], ",", 
              RowBox[{"PointSize", "[", ".05", "]"}], ",", "Black"}], "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Arrow", "[", 
               RowBox[{"{", 
                RowBox[{"p", ",", 
                 RowBox[{"p", "+", "x"}]}], "}"}], "]"}], ",", "Red", ",", 
              RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Arrow", "[", 
               RowBox[{"{", 
                RowBox[{"p", ",", 
                 RowBox[{"p", "+", "y"}]}], "}"}], "]"}], ",", "Green", ",", 
              RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Arrow", "[", 
               RowBox[{"{", 
                RowBox[{"p", ",", 
                 RowBox[{"p", "+", "z"}]}], "}"}], "]"}], ",", "Blue", ",", 
              RowBox[{"Thickness", "[", "0.02", "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{"\"\<p'\>\"", ",", "pp", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<q'\>\"", ",", "qq", ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<r'\>\"", ",", "rr", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"{", 
                RowBox[{"pp", ",", "qq", ",", "rr"}], "}"}], "]"}], ",", 
              "Gray", ",", 
              RowBox[{"Opacity", "[", "0.25", "]"}]}], "]"}]}], 
