 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TDegree4Vertex3D and returns a GraphicsRow of the crease pattern \
and folded form."
}], "Text",
 CellChangeTimes->{{3.61529890932789*^9, 3.615298924483311*^9}, {
  3.617405307871855*^9, 
  3.617405328150487*^9}},ExpressionUUID->"a9ec68df-1e3c-4306-acf7-\
