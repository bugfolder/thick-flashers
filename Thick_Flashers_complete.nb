Cell["\<\
Example: Two reversing Yoshimuras (with a Miura-ori section in the middle).\
\>", "Text",
 CellChangeTimes->{{3.642603040992803*^9, 3.6426030416982307`*^9}, {
  3.642603720043972*^9, 
  3.642603742375955*^9}},ExpressionUUID->"cd2fb488-0ad6-44f1-97e0-\
