   3.719941386239593*^9, 3.719941392909786*^9}, {3.719941452895154*^9, 
   3.719941460855174*^9}, {3.719941714920814*^9, 3.719941787046275*^9}, 
   3.7199421415348063`*^9, 3.719946418452291*^9, {3.8256114436889067`*^9, 
   3.825611459744749*^9}, {3.8256128139638*^9, 3.825612868306691*^9}, 
   3.825612922084549*^9, 3.825613257671306*^9, {3.825613494328464*^9, 
   3.8256135236393747`*^9}, {3.8256135550562162`*^9, 3.825613562527371*^9}, 
   3.825613838939425*^9, 3.825614812122162*^9, 3.825614897890903*^9, {
   3.825614949858816*^9, 3.825614954475061*^9}, 3.825614995362797*^9, {
   3.825615032419716*^9, 3.82561504181993*^9}, {3.8256151225654573`*^9, 
