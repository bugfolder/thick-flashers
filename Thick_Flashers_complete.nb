   3.7996040753635263`*^9}, {3.800013996832127*^9, 3.8000140212768097`*^9}, {
   3.800014053731089*^9, 3.8000140660741053`*^9}, {3.801758996068108*^9, 
   3.801759010337945*^9}, {3.801759116916008*^9, 3.80175911924273*^9}, {
   3.801759322628641*^9, 3.8017593624852533`*^9}, {3.8017593986861687`*^9, 
   3.801759437165506*^9}, {3.801759467438223*^9, 3.801759469518419*^9}, {
   3.801759530471363*^9, 3.801759544273387*^9}, {3.801759603135085*^9, 
   3.8017597254480124`*^9}, {3.8017597832407*^9, 3.8017598537850924`*^9}, {
   3.801760149493719*^9, 3.801760151762629*^9}, {3.801760271445208*^9, 
