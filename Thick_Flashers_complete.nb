Cell[CellGroupData[{

Cell["3D-folding and unfolding", "Subsection",
 CellChangeTimes->{{3.592791381706237*^9, 3.5927913931054773`*^9}, 
   3.592828774196814*^9, {3.5942125535693283`*^9, 3.594212557221488*^9}, {
   3.594230677254504*^9, 3.5942306774125147`*^9}, {3.594230741625266*^9, 
   3.594230742120564*^9}, {3.594236598752762*^9, 3.594236599552446*^9}, {
   3.594305536294875*^9, 3.594305539062491*^9}, {3.595008711066245*^9, 
