Cell[BoxData[
 RowBox[{
  RowBox[{"ConcyclicQ", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1.00001"}], "}"}]}], "}"}], ",", 
    RowBox[{"ConcyclicTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}]}], "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4852101898510923`*^9, 3.485210243330458*^9}, {
