Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dhats", ",", "shats"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dhats", "=", 
      RowBox[{"Hat", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"90", " ", "\[Degree]"}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"ArcTan", "[", "2", "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", "90"}], " ", "\[Degree]"}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"ArcTan", "[", "2", "]"}]}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"shats", "=", 
      RowBox[{"Hat", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"120", "\[Degree]"}], ",", 
         RowBox[{"60", "\[Degree]"}], ",", 
         RowBox[{"60", "\[Degree]"}], ",", 
         RowBox[{"120", "\[Degree]"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Dihedral hats = \>\"", ",", "dhats"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Sector hats = \>\"", ",", "shats"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"HatVertexConsistencyConditions3D", "[", 
         RowBox[{"dhats", ",", "shats"}], "]"}], "//", "N"}], "//", "Chop"}], 
      "//", "MatrixForm"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
