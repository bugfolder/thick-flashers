      RowBox[{"\"\<vlist = \>\"", ",", 
       RowBox[{
       "mgdata", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<elist = \>\"", ",", 
       RowBox[{
       "mgdata", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pr", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj1", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 1\>\""}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "pr"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj2", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "pr"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
