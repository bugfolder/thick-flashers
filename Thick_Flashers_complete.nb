Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h", ",", "u0", ",", "u1", ",", "s", ",", "c", ",", "csys"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"h", "=", "0.5"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{".75", "\[Pi]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationYMatrix3D", "[", 
          RowBox[{"15.", "\[Degree]"}], "]"}], ".", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "s", "]"}], ",", 
           RowBox[{"Sin", "[", "s", "]"}], ",", 
           RowBox[{"h", " ", "s"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"NCurve3DSystem", "[", 
       RowBox[{"c", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Curve3DSystemPlots", "[", 
      RowBox[{"csys", ",", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
