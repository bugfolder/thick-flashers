Cell[TextData[{
 "EdgeFaceAngles",
 "3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked classes) TGraph3D, TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.591645537275234*^9, 3.5916455385066977`*^9}, {
   3.591819639010729*^9, 3.591819639698378*^9}, 3.591821058942465*^9, {
   3.5919721856744957`*^9, 3.5919721884893007`*^9}, {3.591973081045742*^9, 
   3.591973090229315*^9}, {3.591975530966204*^9, 3.591975538382103*^9}, {
   3.591977902874394*^9, 3.591977905891724*^9}, 3.591981352025079*^9, {
   3.592380918925476*^9, 3.592380929633834*^9}, 3.592828718248457*^9, 
   3.592828773030089*^9, 3.594732492564217*^9, {3.595345608173608*^9, 
   3.595345614811532*^9}, 
   3.626459164095447*^9},ExpressionUUID->"6fc1a1ec-f19a-43e4-a2ea-\
d4b0ab1ca86e"],

Cell[TextData[{
 "EdgeFaceAngles",
 "3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TObj representing a 3D plane graph and computes a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], ",", " ", 
     SubscriptBox["\[Gamma]", "2"], ",", " ", "..."}], "}"}], 
   TraditionalForm]],ExpressionUUID->"d7969493-09dc-472f-95ad-10ec3b31667f"],
 " of the dihedral (fold) angles on each edge of the graph. Border edges are \
assigned a fold angle of 0. Note that badness will happen if any two faces \
incident to the same edge are parallel."
}], "Text",
 CellChangeTimes->{{3.5918195591610603`*^9, 3.591819642769787*^9}, {
   3.59182106068711*^9, 3.59182107506145*^9}, {3.5918211284823933`*^9, 
   3.591821149808724*^9}, {3.591950515832015*^9, 3.591950520172013*^9}, {
   3.5919721948820353`*^9, 3.591972256332747*^9}, {3.591976378911337*^9, 
   3.591976422060802*^9}, 3.59198135213822*^9, 3.592435745089977*^9, {
   3.625686871583688*^9, 3.625686872294028*^9}, 
   3.626459164289202*^9},ExpressionUUID->"e98bb819-436e-44b2-81fe-\
8956a116c225"],

Cell["\<\
Note: this is the FoldAngles property of a TGraph3D. Use this function if you\
\[CloseCurlyQuote]ve altered the Vertices3D property (and you should probably \
update the FoldAngles property with the results of this). Alternatively, you \
can use the result of this as a check on the consistency of FoldAngles \
property. We use this function to recalculate the fold angles, see \
RecalcFoldAngles, below.\
\>", "Text",
