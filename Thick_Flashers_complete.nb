 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "TwistJoinedTubeGraphics", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"TwistDirection", "\[Rule]", "CCW"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.675330173822532*^9, 3.675330185169523*^9}},
 CellLabel->
  "In[3567]:=",ExpressionUUID->"e5257577-d440-4ce6-b074-117d8a7b1eda"],

