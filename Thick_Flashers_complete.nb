Cell[CellGroupData[{

Cell[TextData[{
 "FacesAboveAutomatic[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(unchecked classes) TGraph2D+TAssigned\n\t(options) ShowProgress, \
ReportInconsistentOrdering, FaceupFace"
}], "Subsubsection",
 CellChangeTimes->{{3.628870707723118*^9, 3.628870748382229*^9}, {
  3.628870792468803*^9, 3.6288707956353416`*^9}, {3.628870961948242*^9, 
  3.628870968655452*^9}, {3.628871043850952*^9, 3.628871044514859*^9}, {
  3.628888345898197*^9, 3.62888834757378*^9}, {3.629038115941112*^9, 
  3.629038124116689*^9}, {3.7079232669324427`*^9, 
  3.70792327174772*^9}},ExpressionUUID->"327e2e5d-b29a-4725-ad85-\
462bb0cd84c8"],

Cell[TextData[{
 "FacesAboveAutomatic[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns an ordered list of face indices \
above each face where the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th entry in the list is a list of the indices of all the faces that lie \
above the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th face."
}], "Text",
 CellChangeTimes->{{3.6288707268378987`*^9, 3.628870839857526*^9}, {
   3.6288708749834146`*^9, 3.628870926818408*^9}, {3.628870972703418*^9, 
   3.628870982305377*^9}, {3.628871046610497*^9, 3.628871047276134*^9}, {
   3.628888371300447*^9, 3.628888389995125*^9}, 3.629038112077445*^9, {
   3.629038184385182*^9, 3.629038211270739*^9}, {3.707923211413727*^9, 
   3.707923237683868*^9}, {3.707940318559772*^9, 
   3.7079403200790653`*^9}},ExpressionUUID->"18a6c2a5-4dfa-4385-a9d2-\
74278f2b1b1d"],

Cell[TextData[{
 "Options:\n\tShowProgress \[Rule] True | False, if true, display some graphs \
showing the relationships that are used along the way.\n\t\
ReportInconsistentOrdering \[Rule] True | False, if true, post a Message if \
an inconsistent ordering was detected.\n\tFaceupFace \[Rule] ",
 StyleBox["fuface",
  FontSlant->"Italic"],
 ", passed through to LocalFaceOrdering."
}], "Text",
 CellChangeTimes->{{3.707923214221965*^9, 3.707923217035375*^9}, {
  3.707923277870242*^9, 
  3.707923279254709*^9}},ExpressionUUID->"3b7f0115-4f8d-4e47-8aff-\
c0d9dd94da76"],

Cell["\<\
In general, this problem is (notoriously) NP-hard. We apply some heuristics \
that give a good answer for most twist tessellations. \
\>", "Text",
 CellChangeTimes->{
  3.707940324342709*^9},ExpressionUUID->"729b2d3b-a023-4111-8daa-\
0ba7e32107fd"],

Cell["\<\
Comment. If two edges overlap collinearly, the ordering condition for the \
adjacent facets is a bit more complicated, so we don\[CloseCurlyQuote]t \
consider those (yet).\
\>", "Text",
 CellChangeTimes->{{3.628885698848543*^9, 3.6288857535000772`*^9}, {
  3.629036277870512*^9, 
  3.629036328896662*^9}},ExpressionUUID->"9a829f98-34e3-4492-90a5-\
73495d0c724d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReportInconsistentOrdering", "::", "usage"}], 
   "=", "\"\<ReportInconsistentOrdering is an option to FacesAboveAutomatic \
that specifies whether to report inconsistent ordering encountered during \
computation of the folded form.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.6290381446697187`*^9, 3.629038173491352*^9}},
 CellLabel->
  "In[1881]:=",ExpressionUUID->"45dfbc3d-c34a-48ea-91bf-f93b246eb27e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FacesAboveAutomatic", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ShowProgress", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ReportInconsistentOrdering", "\[Rule]", "True"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.628871015965991*^9, 3.628871031085255*^9}, {
  3.629038127982519*^9, 3.629038136107714*^9}},
 CellLabel->
  "In[1882]:=",ExpressionUUID->"0c533b2b-7420-4f9a-8cb9-4351b82814d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FacesAboveAutomatic", "::", "incons"}], 
   "=", "\"\<Inconsistent face ordering was detected for face pairs \
`1`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629038228984169*^9, 3.629038255381556*^9}},
 CellLabel->
  "In[1883]:=",ExpressionUUID->"4a0274fa-5caa-47e1-a9db-aee3310ac40e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FacesAboveAutomatic", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sp", ",", "rio", ",", "nf", ",", "lfo", ",", "lfoold", ",", "fo", ",", 
      "eo", ",", "efp", ",", "fa", ",", "eofn", ",", "eobadf", ",", "ei", ",",
       "ej", ",", "fi1", ",", "fi2", ",", "fj1", ",", "fj2", ",", "m11ij", ",",
       "m12ij", ",", "m21ij", ",", "m22ij", ",", "m11ji", ",", "m12ji", ",", 
      "m21ji", ",", "m22ji", ",", "lfog", ",", "gdm", ",", "fi", ",", "fj", ",",
       "plij", ",", "plji", ",", "aedges"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FacesAboveAutomatic", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rio", "=", 
      RowBox[{
       RowBox[{"ReportInconsistentOrdering", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FacesAboveAutomatic", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nf", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"tobj", "[", "Faces", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fo", "=", 
      RowBox[{"FaceOverlaps2D", "[", "tobj", "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "undirected", " ", "edges", " ", "on", " ", "the", " ", "faces", " ", 
       "that", " ", "specify", " ", "overlapping"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"eo", "=", 
      RowBox[{"EdgeOverlaps2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"IncludeCollinear", "\[Rule]", "False"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "undirected", " ", "edges", " ", "on", " ", "the", " ", "edges", " ", 
       "that", " ", "specify", " ", "overlapping"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"efp", "=", 
      RowBox[{"EdgeFacePairs", "[", "tobj", "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"faces", " ", "incident", " ", "to", " ", "each", " ", "edge"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "nf", "}"}]}], "]"}]}], ";", 
