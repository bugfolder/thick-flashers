Cell[BoxData[
 RowBox[{
  RowBox[{"Curve2DSystem", "[", 
   RowBox[{"c_Function", ",", "opts___"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "dc", ",", "ds", ",", "t", ",",
       "dt", ",", "l", ",", "\[Kappa]l", ",", "\[Kappa]", ",", "n"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Curve2DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Curve2DSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{"dc", "[", "s", "]"}], "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"dc", "[", "s", "]"}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"t", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"l", "[", "s", "]"}], ".", 
           RowBox[{"dt", "[", "s", "]"}]}], "/", 
          RowBox[{"ds", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"\[Kappa]l", "[", "s", "]"}], "]"}], 
          RowBox[{"l", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve2D", "\[Rule]", "c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed2D", "\[Rule]", "ds"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LeftCurvature2D", "\[Rule]", "\[Kappa]l"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Curvature2D", "\[Rule]", "\[Kappa]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TangentVector2D", "\[Rule]", "t"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LeftNormalVector2D", "\[Rule]", "l"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalVector2D", "\[Rule]", "n"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
