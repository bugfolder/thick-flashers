Cell[CellGroupData[{

Cell["Merging, joining, and collinear cleanup", "Section",
 CellChangeTimes->{{3.707763128758116*^9, 3.707763138351282*^9}, {
  3.707912787156271*^9, 
  3.707912824726163*^9}},ExpressionUUID->"1a9ee723-b73f-4a9f-9600-\
d904e56ec1a6"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.7077631695901213`*^9, 
  3.707763170303489*^9}},ExpressionUUID->"d9863f29-0974-42e7-b365-\
0acfcc9c0c1a"],

Cell["\<\
These functions implement Merging and Joining on crease-assigned graphs. They \
are analogous to the functions JoinGraphs and MergeGraphs and do the same \
thing, but they handle the extra data associated with crease assignments and \
folded forms.\
\>", "Text",
 CellChangeTimes->{{3.707763172271903*^9, 3.707763240168342*^9}, {
  3.707823226814588*^9, 
  3.707823235655521*^9}},ExpressionUUID->"8ea74da4-0d02-4954-81ba-\
524b1f234586"],

Cell["\<\
As a reminder: Merging means we take two graphs whose vertices already are \
aligned and join them at the aligned vertices and edges. Joining means we \
take multiple graphs and reposition elements relative to their predecessors \
so that vertices overlap, then we Merge them.\
\>", "Text",
 CellChangeTimes->{{3.707763242238779*^9, 3.707763314200529*^9}, {
  3.707823248639248*^9, 
  3.707823252799584*^9}},ExpressionUUID->"4aab7d66-5f4c-4e7e-aecb-\
8992176da3d7"],

Cell["\<\
As was the case with MergeGraphs and JoinGraphs, the Apply[*][To] routines \
are helpers that you should not call directly, unless you are building Merge \
and Join functions for more specialized subclasses.\
\>", "Text",
 CellChangeTimes->{{3.707911412520086*^9, 
  3.70791147377689*^9}},ExpressionUUID->"34839336-5e77-46ad-b6a1-\
3864e69b0d68"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Merging TGraphAssigned, TGraph2DAssigned, and TGraph3DAssigned\
\>", "Subsection",
 CellChangeTimes->{{3.649888823173614*^9, 3.649888846509706*^9}, {
  3.649964691606399*^9, 3.649964694861749*^9}, {3.707912835421698*^9, 
  3.70791283795701*^9}},ExpressionUUID->"7260cfdc-cafa-4428-ad2b-\
76bc260dec88"],

Cell[CellGroupData[{

Cell[TextData[{
 "ApplyMergeAssignedTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 "]\nApplyMergeAssigned[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.7079056431390967`*^9, 3.7079057052277536`*^9}, {
   3.707905755365341*^9, 3.707905770876274*^9}, {3.707909669752145*^9, 
   3.707909679488111*^9}, {3.707909717505975*^9, 3.707909726497292*^9}, 
   3.7079107590268526`*^9},ExpressionUUID->"96bfcf64-3cb7-4a9c-8c4f-\
cb484b4b1cac"],

Cell[TextData[{
 "ApplyMergeAssignedTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 "] applies the merge changes to the TAssigned properties of a graph \
resulting from a merge of several subgraphs."
}], "Text",
 CellChangeTimes->{{3.707905708691448*^9, 3.70790572410831*^9}, {
  3.707905778468769*^9, 3.707905779428781*^9}, {3.7079094485192637`*^9, 
  3.707909516279717*^9}},ExpressionUUID->"e04646c9-52ac-436e-95ad-\
d33f45bcf3c7"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the merged TGraph.\n\t",
 StyleBox["tglist",
  FontSlant->"Italic"],
 " \[LongDash] the list of subgraphs to merge.\n\t",
 StyleBox["mgdata",
  FontSlant->"Italic"],
 " \[LongDash] merging data, the output from MergeGraphsData."
}], "Text",
 CellChangeTimes->{{3.707909517822734*^9, 
  3.707909585088239*^9}},ExpressionUUID->"04d03a0e-de07-43af-871b-\
042e5475f713"],

Cell["Returns: a TGraphAssigned with its EdgeTypes property set.", "Text",
 CellChangeTimes->{{3.707909588702633*^9, 3.707909604752595*^9}, 
   3.707910984443038*^9},ExpressionUUID->"dc408b4e-25f7-4eea-9728-\
ed70a0864a65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyMergeAssignedTo", "[", 
   RowBox[{"tobj_TObj", ",", "tglist_List", ",", "mgdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vlist", ",", "elist", ",", "ne", ",", "types", ",", "typelist", ",", 
      "medges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vlist", ",", "elist"}], "}"}], "=", "mgdata"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ne", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"tobj", "[", "Edges", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Create", " ", "EdgeTypes"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"U", ",", 
        RowBox[{"{", "ne", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"typelist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "EdgeTypes", "]"}], "&"}], "/@", "tglist"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#1", "\[NotEqual]", "0"}], ",", 
            RowBox[{
             RowBox[{
             "types", "\[LeftDoubleBracket]", "#1", "\[RightDoubleBracket]"}],
              "=", "#2"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "elist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "typelist", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tglist", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Reassign", " ", "merged", " ", "edges", " ", "to", " ", "U"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"medges", "=", 
      RowBox[{"GetMergedEdges", "[", "elist", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "types", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "=",
          "U"}], ")"}], "&"}], "/@", "medges"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"AddTAssigned", "[", "types", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707909657216565*^9, 3.7079096969101152`*^9}, {
