Cell[CellGroupData[{

Cell[TextData[{
 "ExtrudeTorusGC[",
 StyleBox["xyouter",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xyinner",
  FontSlant->"Italic"],
 ", {",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["xyz",
  FontSlant->"Italic"],
 "]\nExtrudeTorusGC[",
 StyleBox["xyouter",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xyinner",
  FontSlant->"Italic"],
 ", {",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.712840947012488*^9, 3.712840975052505*^9}, {
  3.712841098405723*^9, 
  3.712841114725128*^9}},ExpressionUUID->"4affeb95-029d-4cfb-90d6-\
2185c5422fa7"],

Cell[TextData[{
 "ExtrudeTorusGC[",
 StyleBox["xyouter",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xyinner",
  FontSlant->"Italic"],
 ", {",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["xyz",
  FontSlant->"Italic"],
 "] takes two 2D polygons (same length) defining the outside and inside of a \
polygonal torus and extrudes a 3D solid with Polygon faces, given as a \
GraphicsComplex."
}], "Text",
 CellChangeTimes->{{3.712840985390987*^9, 3.712841050556992*^9}, {
  3.712841105037862*^9, 
  3.712841106432027*^9}},ExpressionUUID->"4d3bbfe9-8af7-4897-833d-\
1e1b9c712eac"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["xyouter",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that defines the outside polygon of the \
polygonal torus.\n\t",
 StyleBox["xyinner",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that defines the inside polygon of the \
polygonal torus.\n\t{",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "} \[LongDash] the interval of extrusion.\n\t",
 StyleBox["xyz",
  FontSlant->"Italic"],
 " \[LongDash] a list of unit vectors that define the plane of the polygon \
and direction of extrusion."
}], "Text",
 CellChangeTimes->{{3.708871569805011*^9, 3.708871600015812*^9}, {
  3.708871633179426*^9, 3.708871698112944*^9}, {3.71284113897583*^9, 
  3.712841164270047*^9}},ExpressionUUID->"d91ea5b7-eb9c-4adb-a560-\
1042f804bd34"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ExtrudeTorusGC", "::", "badlens"}], 
   "=", "\"\<Lists `1` and `1` do not have the same length.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.712841404249861*^9, 3.712841422496543*^9}},
 CellLabel->
  "In[4271]:=",ExpressionUUID->"21ea9cb6-c213-4bea-9eec-95490f6f2b0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtrudeTorusGC", "[", 
   RowBox[{"xyouter_List", ",", "xyinner_List", ",", 
    RowBox[{"{", 
     RowBox[{"z0_", ",", "z1_"}], "}"}], ",", 
    RowBox[{"xyz_List", ":", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "x", ",", "y", ",", "z", ",", "pts"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "xyouter", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "xyinner", "]"}], "\[NotEqual]", "n"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"ExtrudeTorusGC", "::", "badlens"}], ",", "xyouter", ",", 
          "xyinner"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", "xyz"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"y", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"z", " ", "z1"}]}], "&"}], "/@", 
         RowBox[{"Join", "[", 
          RowBox[{"xyouter", ",", "xyinner"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"y", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"z", " ", "z0"}]}], "&"}], "/@", 
         RowBox[{"Join", "[", 
          RowBox[{"xyouter", ",", "xyinner"}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsComplex", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"top", " ", "face", " ", "with", " ", "hole"}], " ", "*)"}],
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Polygon", "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"1", ",", "n"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",", 
                "1"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"n", "+", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Range", "[", 
                   RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",", 
                 "1"}], "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"n", "+", 
               RowBox[{"Range", "[", 
                RowBox[{"1", ",", "n"}], "]"}]}]}], "}"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"outer", " ", "walls"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"1", ",", "n"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"2", "n"}], "+", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"1", ",", "n"}], "]"}], ",", "n", ",", "1"}], 
                "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"2", "n"}], "+", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Range", "[", 
                   RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",", 
                 "1"}], "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",", 
                "1"}], "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"inner", " ", "walls"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"n", "+", 
                RowBox[{"Range", "[", 
                 RowBox[{"1", ",", "n"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"3", "n"}], "+", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"Range", "[", 
                   RowBox[{"1", ",", "n"}], "]"}], ",", "n", ",", "1"}], 
                 "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"3", "n"}], "+", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",",
                   "1"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"n", "+", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",",
                   "1"}], "]"}]}]}], "}"}], "//", "Reverse"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"bottom", " ", "face", " ", "with", " ", "hole"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"2", "n"}], "+", 
                RowBox[{"Range", "[", 
                 RowBox[{"1", ",", "n"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"2", "n"}], "+", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",",
                   "1"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"3", "n"}], "+", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"1", ",", "n"}], "]"}], "+", "1"}], ",", "n", ",",
                   "1"}], "]"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"3", "n"}], "+", 
                RowBox[{"Range", "[", 
                 RowBox[{"1", ",", "n"}], "]"}]}]}], "}"}], "//", "Reverse"}],
             "]"}]}]}], "}"}], "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.712841056841329*^9, 3.712841094543339*^9}, {
   3.71284117497085*^9, 3.712841206137868*^9}, {3.712841365801338*^9, 
   3.712841432250142*^9}, {3.712841473123001*^9, 3.712841504314283*^9}, {
   3.7128415406283712`*^9, 3.712841556482943*^9}, 3.712841598229671*^9, {
   3.712841736342705*^9, 3.7128418852227173`*^9}, {3.712841921889452*^9, 
   3.712842086135089*^9}},
 CellLabel->
