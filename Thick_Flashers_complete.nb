Cell[TextData[{
 "Single",
 "VertexEdgeAngles",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i1",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.595269016959195*^9, 3.595269046493414*^9}, {
   3.595269078736968*^9, 3.595269080305293*^9}, {3.5952697287422748`*^9, 
