Cell["\<\
There are some self-intersection collisions (flaps that fold beyond valley or \
mountain). That suggests I need to have more inequality constraints to \
prevent that.\
\>", "Text",
 CellChangeTimes->{{3.701296050377347*^9, 3.701296095081338*^9}, 
   3.701470518710536*^9, {3.701639721857411*^9, 
   3.70163972201794*^9}},ExpressionUUID->"57b3cbd6-4db2-4d6a-98a4-\
dbd3792d3f1a"]
}, Closed]],

Cell[CellGroupData[{

Cell["MakeWaterbombBase[\[Theta]1, \[Theta]2, \[Theta]3]", "Subsubsection",
 CellChangeTimes->{{3.704315208373034*^9, 
  3.704315221692252*^9}},ExpressionUUID->"8463b2cf-1e31-48ce-bd02-\
fe4da16b5134"],

Cell["\<\
MakeWaterbombBase[\[Theta]1, \[Theta]2, \[Theta]3] creates a Waterbomb base \
whose partially folded state is determined by three angular parameters.\
\>", "Text",
 CellChangeTimes->{{3.7043152315327272`*^9, 3.704315274396708*^9}, 
   3.7043153942218*^9},ExpressionUUID->"a437158e-d4b1-4ca4-a5bc-224413019e5b"],

Cell["\<\
Arguments:
\t\[Theta]1 \[LongDash] the angle between the left diagonal edges. 0\[Degree] \
is flat-folded.
\t\[Theta]2 \[LongDash] the angle between the right diagonal edges. \
0\[Degree] is flat-folded.
\t\[Theta]3 \[LongDash] a \[OpenCurlyDoubleQuote]skew\[CloseCurlyDoubleQuote] \
angle that determines how much the top edge is twisted relative to the bottom.\
\>", "Text",
 CellChangeTimes->{{3.704315276099867*^9, 
  3.7043153786291933`*^9}},ExpressionUUID->"7a03efa1-38cc-404a-9f35-\
d70983eb0bf0"],

Cell["Returns: a TGraph3D+TAssigned of the 3D folded state.", "Text",
 CellChangeTimes->{{3.704315381981291*^9, 
  3.704315401518*^9}},ExpressionUUID->"ec776ed2-2ffa-45c8-a7cf-c5d6d8f16ebc"],

Cell["\<\
Note that while you can choose \[Theta]1 and \[Theta]2 broadly, the valid \
range of \[Theta]3 is limited and depends on \[Theta]1 and \[Theta]2.\
\>", "Text",
 CellChangeTimes->{{3.704315406974004*^9, 
  3.7043154405425167`*^9}},ExpressionUUID->"a3f8d462-e03b-4e37-b60d-\
0244cb13bce6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeWaterbombBase", "[", 
   RowBox[{"\[Theta]1_", ",", "\[Theta]2_", ",", "\[Theta]3_"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "types", ",", "verts3d", ",", "foldangles", ",",
       "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "B", ",", "V", ",", "V", ",", "B", ",", "M", ",", "M", ",", 
        "B", ",", "V", ",", "V", ",", "B", ",", "B"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "\[Pi]", ",", "\[Pi]", ",", "0", ",", 
        RowBox[{"-", "\[Pi]"}], ",", 
        RowBox[{"-", "\[Pi]"}], ",", "0", ",", "\[Pi]", ",", "\[Pi]", ",", 
        "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "verts3d", " ", "are", " ", "perturbed", " ", "to", " ", "get", " ", 
       "away", " ", "from", " ", "singular", " ", "state"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{"1", "/", "2"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", ".1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", ".1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph3DAssigned", "[", 
        RowBox[{"verts", ",", "edges", ",", 
         RowBox[{"{", "}"}], ",", "verts3d", ",", "foldangles", ",", 
         "types"}], "]"}], "//", "AddTPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"StrainTQMesh", "[", 
      RowBox[{"tobj", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"VertexPointEqualityConstraints", "[", 
          RowBox[{"1", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Function", "[", 
          RowBox[{"vv", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"vv", "\[LeftDoubleBracket]", 
              RowBox[{"4", ",", "3"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             "0"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Function", "[", 
          RowBox[{"vv", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"vv", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}], "\[Equal]", 
             "0"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Function", "[", 
          RowBox[{"vv", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"NormalizeReal", "[", 
               RowBox[{
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}], 
                "-", 
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "4", 
                 "\[RightDoubleBracket]"}]}], "]"}], ".", 
              RowBox[{"NormalizeReal", "[", 
               RowBox[{
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                "-", 
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "4", 
                 "\[RightDoubleBracket]"}]}], "]"}]}], "\[Equal]", 
             RowBox[{"Cos", "[", "\[Theta]1", "]"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Function", "[", 
          RowBox[{"vv", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"NormalizeReal", "[", 
               RowBox[{
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "7", "\[RightDoubleBracket]"}], 
                "-", 
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "4", 
                 "\[RightDoubleBracket]"}]}], "]"}], ".", 
              RowBox[{"NormalizeReal", "[", 
               RowBox[{
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                "-", 
                RowBox[{
                "vv", "\[LeftDoubleBracket]", "4", 
                 "\[RightDoubleBracket]"}]}], "]"}]}], "\[Equal]", 
             RowBox[{"Cos", "[", "\[Theta]1", "]"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Function", "[", 
          RowBox[{"vv", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  FractionBox[
                   RowBox[{
                    RowBox[{
                    "vv", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "+", 
                    RowBox[{
                    "vv", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], "2"], "-", 
                  RowBox[{
                  "vv", "\[LeftDoubleBracket]", "4", 
                   "\[RightDoubleBracket]"}]}], ")"}], "\[Cross]", 
                RowBox[{"NormalizeReal", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    FractionBox[
                    RowBox[{
                    RowBox[{
                    "vv", "\[LeftDoubleBracket]", "6", 
                    "\[RightDoubleBracket]"}], "+", 
                    RowBox[{
                    "vv", "\[LeftDoubleBracket]", "7", 
                    "\[RightDoubleBracket]"}]}], "2"], "-", 
                    RowBox[{
                    "vv", "\[LeftDoubleBracket]", "4", 
                    "\[RightDoubleBracket]"}]}], ")"}], 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], "]"}]}], ")"}],
               ".", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "\[Equal]", 
             RowBox[{"Sin", "[", "\[Theta]3", "]"}]}], "}"}]}], "]"}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ConstrainFromAssignment", "\[Rule]", "False"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"QuadBendStiffness", "\[Rule]", "\[Infinity]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"FlatFoldStiffness", "\[Rule]", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"SplitBentFaces", "\[Rule]", "False"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.704315489880143*^9, 3.704315508794707*^9}, {
  3.70431556365512*^9, 3.704315580360897*^9}},
 CellLabel->
  "In[2664]:=",ExpressionUUID->"8d2c6323-3a74-42c8-bdc2-d5c2f36156a2"],

Cell["Example", "Text",
 CellChangeTimes->{{3.704315517656042*^9, 
  3.704315518550976*^9}},ExpressionUUID->"a75fb3a2-5fe8-4bd4-9ffa-\
3d4716dee065"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3", ",", "tobj"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]1", "=", 
      RowBox[{"40.", "\[Degree]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "angle", " ", "between", " ", "vertices", " ", "1", " ", "and", " ", 
       "6"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Theta]2", "=", 
      RowBox[{"40.", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "angle", " ", "between", " ", "vertices", " ", "2", " ", "and", " ", 
       "7"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Theta]3", "=", 
      RowBox[{
       RowBox[{"-", "10."}], "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "skew", " ", "angle", " ", "between", " ", "top", " ", "and", " ", 
       "bottom"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeWaterbombBase", "[", 
       RowBox[{"\[Theta]1", ",", "\[Theta]2", ",", "\[Theta]3"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.7043155214185457`*^9, 3.704315624055968*^9}},
 CellLabel->
  "In[2665]:=",ExpressionUUID->"e076973e-926c-41ed-96ac-b51328c8253c"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Rotationally stretched pleats", "Subsection",
 CellChangeTimes->{{3.701513980306779*^9, 3.701513982777557*^9}, {
  3.701538044575027*^9, 3.701538050182564*^9}, {3.7018572107462873`*^9, 
  3.7018572114270988`*^9}},ExpressionUUID->"6aa87841-909a-48e2-bcde-\
052361b8baec"],

Cell[CellGroupData[{

Cell[TextData[{
 "RotationalPleats[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph2D, TAssigned\n\t(checked property) VertexRows\n\
\t(options) Options[StrainTQMesh]"
}], "Subsubsection",
 CellChangeTimes->{{3.701519888802606*^9, 3.701519894368876*^9}, {
   3.701519928192333*^9, 3.7015199443134413`*^9}, {3.701536425232777*^9, 
   3.701536484457519*^9}, {3.701536583001712*^9, 3.7015365886510067`*^9}, {
   3.701537939847298*^9, 3.701537941270018*^9}, {3.701538056448256*^9, 
   3.7015380596382937`*^9}, {3.701538305948246*^9, 3.701538311625146*^9}, 
   3.701538456522016*^9, {3.7015588362316628`*^9, 3.701558836461425*^9}, {
   3.70162324675996*^9, 3.701623278262785*^9}, 3.70185724604637*^9, 
   3.701860206587351*^9},ExpressionUUID->"5cd4dd75-f582-4ad9-a1a6-\
b169ac3ff102"],

Cell[TextData[{
 "RotationalPleats[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a folded strip, creates a pattern consisting of multiple \
repetitions of the pattern in the ",
 StyleBox["y",
  FontSlant->"Italic"],
 " direction (crease-pattern-wise), and stretches the folded form into a \
rotational form about the z-axis."
}], "Text",
 CellChangeTimes->{{3.701519946017103*^9, 3.701520029434093*^9}, {
   3.701536358702361*^9, 3.701536373135539*^9}, {3.701536815211595*^9, 
   3.701536821459508*^9}, {3.7015379487169747`*^9, 3.701537952797955*^9}, 
   3.701538065145128*^9, {3.7015380973446918`*^9, 3.701538123175701*^9}, {
   3.7015384609137497`*^9, 3.701538472386851*^9}, {3.701549272185956*^9, 
   3.701549276221572*^9}, {3.70154981910268*^9, 3.7015498200296707`*^9}, {
   3.701622900747344*^9, 3.701622902315065*^9}, 3.701623437800488*^9, 
   3.701857246083802*^9, 
   3.701860206689056*^9},ExpressionUUID->"d1769b82-249c-4492-af94-\
3bcd42e6e98d"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the flat-folded strip being stretched. Typically the output of \
MakeFoldedStripA.\n\t",
 StyleBox["n",
  FontSlant->"Italic"],
 " \[LongDash] the number of pair repetitions across the width.\n\t\[Phi] \
\[LongDash] the angular arc to stretch it over."
}], "Text",
 CellChangeTimes->{{3.701519059075235*^9, 3.70151906124211*^9}, {
   3.701519158750208*^9, 3.701519185556126*^9}, {3.701536491282407*^9, 
   3.7015365207374363`*^9}, {3.701536565682125*^9, 3.701536575569516*^9}, {
   3.701537956141961*^9, 3.701537967222288*^9}, 3.701538458642386*^9, {
   3.701549296554231*^9, 3.701549324338388*^9}, {3.701623364313277*^9, 
   3.701623414967923*^9}},ExpressionUUID->"d65fe03e-f2e2-4482-af7c-\
5950cb3ef745"],

Cell[TextData[{
 "Options:\n\tSplitBentFaces \[Rule] True | False, whether to split any bent \
quads into two triangles.\n\tSplitBendTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", the angular tolerance on whether a bent quad should be split.\n\t\
SamePtTolerance is passed through to Indexify."
}], "Text",
 CellChangeTimes->{{3.701519147549416*^9, 3.701519157573344*^9}, {
  3.701519188411356*^9, 3.701519191387048*^9}, {3.7015383212906017`*^9, 
  3.7015383251690693`*^9}, {3.70169584567732*^9, 
  3.701695888229846*^9}},ExpressionUUID->"de13b12a-074d-49d2-a224-\
68c322f7705f"],

Cell["\<\
Returns:
\ta TGraph3D+TAssigned that describes the folded form.\
\>", "Text",
 CellChangeTimes->{{3.701519243915688*^9, 3.701519260883823*^9}, {
  3.701538334521456*^9, 
  3.701538342121176*^9}},ExpressionUUID->"3ee76663-b051-42dd-8797-\
3b9381422921"],

Cell["\<\
The initial 2D strip should lie in the x-y plane, lower left corner at the \
origin, bottom along x-axis, and its top and bottom edges should be straight, \
but they don\[CloseCurlyQuote]t have to be parallel; rectangles, triangles, \
and trapezoids are all acceptable.\
\>", "Text",
 CellChangeTimes->{
  3.70169230147169*^9, {3.70169271679288*^9, 
   3.701692724832932*^9}},ExpressionUUID->"4779843a-0add-4a8d-a382-\
d22a5e5e1d15"],

Cell["\<\
Conceptually, the folded strip is replicated into many layers; the stack is \
then rotated about the x axis to lie in the x-z plane; then it is \
rotationally stretched around the z-axis. For computational efficiency, we \
actually stretch just a single strip, then construct the full array from \
symmetry considerations.\
\>", "Text",
 CellChangeTimes->{{3.701640109861722*^9, 3.701640250141787*^9}, {
  3.701692215741987*^9, 
  3.701692321061791*^9}},ExpressionUUID->"d949c8b9-f692-40ae-aff5-\
bb4f24efab3c"],

Cell["\<\
The way this works is, we first stretch the pattern under the following \
constraints:
\t\[LongDash]lower left vertex in CP is constrained to its initial position
\t\[LongDash]bottom row of vertices in the CP are constrained to the x-z \
plane
\t\[LongDash]top row of vertices in the CP are constrained to a rotated \
version of the x-z plane
\t\[LongDash]upper right vertex in CP is additionally constrained in radius \
to its initial value
That is enough to define the 3D shape. Once we\[CloseCurlyQuote]ve found the \
shape, we replicate it rotationally.\
\>", "Text",
 CellChangeTimes->{{3.701548838829523*^9, 3.701548868061003*^9}, {
   3.701549265609418*^9, 3.701549267432837*^9}, {3.701549327665703*^9, 
   3.701549403282785*^9}, {3.701549472800078*^9, 3.701549501403922*^9}, {
   3.701549550692181*^9, 3.7015496148368807`*^9}, {3.701549687317618*^9, 
   3.701549725046204*^9}, {3.701549832054587*^9, 3.701549847415146*^9}, {
   3.701624158487883*^9, 3.701624174232078*^9}, {3.701624237425607*^9, 
   3.701624239068385*^9}, {3.70162787127249*^9, 3.701627873383365*^9}, {
   3.701640497120905*^9, 3.701640497992165*^9}, 3.701640577681202*^9, {
   3.701692330764149*^9, 
   3.701692354957522*^9}},ExpressionUUID->"9c19720f-fd6a-45b0-b925-\
b981cd236655"],

Cell["\<\
The number of these constraints and the isometry constraints exactly equals \
the number of vertex variables, so instead of using FindMinimum (as we do in \
StrainTQMesh) we need to use FindRoot to find a solution. A chunk of the code \
here mirrors what is done in StrainTQMesh.\
\>", "Text",
 CellChangeTimes->{{3.701687568548465*^9, 3.7016876601656017`*^9}, {
  3.701692371629406*^9, 
  3.70169241225434*^9}},ExpressionUUID->"0fb0b1e0-bf51-41fd-b450-\
03e93c4969cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RotationalPleats", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SplitBentFaces", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SplitBendTolerance", "\[Rule]", 
      RowBox[{"1", "\[Degree]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7016891390202*^9, 3.701689170188683*^9}, 
   3.701857246115237*^9, 3.701860206707335*^9},
 CellLabel->
  "In[2666]:=",ExpressionUUID->"c20ea6cd-51af-4721-8eeb-80ae3360e960"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationalPleats", "[", 
   RowBox[{"tobj_TObj", ",", " ", "n_", ",", "\[Phi]_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sbf", ",", "sbt", ",", "verts", ",", "edges", ",", "faces", ",", 
      "types", ",", "verts2d", ",", "bverts", ",", "tverts", ",", "nb", ",", 
      "nt", ",", "nbt", ",", "d\[Phi]", ",", "verts3d", ",", "foldangles", ",",
       "tobj1", ",", "qfaces", ",", "vars", ",", "x", ",", "vars0", ",", 
      "vvars", ",", "econds", ",", "dconds", ",", "sconds", ",", "soln", ",", 
      "nedges", ",", "bedges", ",", "tedges", ",", "cedges", ",", "cpfn", ",",
       "fffn", ",", "vpfn", ",", "gedges", ",", "vpairs", ",", "tobj2"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph2D", ",", "RotationalPleats"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertProperties", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"BottomVertices", ",", "TopVertices"}], "}"}], ",", 
       "RotationalPleats"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sbf", "=", 
      RowBox[{
       RowBox[{"SplitBentFaces", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RotationalPleats", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sbt", "=", 
      RowBox[{
       RowBox[{"SplitBendTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RotationalPleats", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]", "=", 
      RowBox[{"\[Phi]", "/", 
       RowBox[{"(", 
        RowBox[{"2", "n"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "verts", ",", "edges", ",", "faces", ",", "types", ",", "verts2d", ",",
         "bverts", ",", "tverts"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "Edges", ",", "Faces", ",", "EdgeTypes", ",", 
          "Vertices2D", ",", "BottomVertices", ",", "TopVertices"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nb", "=", 
      RowBox[{"Length", "[", "bverts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nt", "=", 
      RowBox[{"Length", "[", "tverts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Make", " ", "a", " ", "vertically", " ", "oriented", " ", "3", "D", " ",
        "version", " ", "of", " ", "the", " ", "flat", " ", "fold"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationXMatrix3D", "[", 
          RowBox[{"90", "\[Degree]"}], "]"}], ".", 
         RowBox[{"Append", "[", 
          RowBox[{"#", ",", "0"}], "]"}]}], "&"}], "/@", "verts2d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"TypeToFlatFoldAngle", "[", "types", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"AddTGraph3D", "[", 
        RowBox[{"verts3d", ",", "foldangles"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "create", " ", "symbolic", " ", "variables", " ", "for", " ", "3", "d", 
       " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"x", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"3", 
           RowBox[{"Length", "[", "verts", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"all", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vars0", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"verts3d", ",", "1"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "values"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"vvars", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{"vars", ",", "3"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"vertices", " ", "as", " ", "variables"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edge", " ", "isometry", " ", "functions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"econds", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{
            RowBox[{"vvars", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{"vvars", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], "]"}], "/", 
          RowBox[{"Mag", "[", 
           RowBox[{
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{"verts", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], "]"}]}], "-", "1"}], "&"}], "/@", 
       "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "diagonal", " ", "isometry", " ", "functions", " ", "for", " ", 
       "quads"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"qfaces", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"faces", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "\[Equal]", "4"}], "&"}]}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"quadrilateral", " ", "faces"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dconds", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Mag", "[", 
             RowBox[{
              RowBox[{"vvars", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], "-", 
              RowBox[{"vvars", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}]}], "]"}], "/", 
            RowBox[{"Mag", "[", 
             RowBox[{
              RowBox[{"verts", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], "-", 
              RowBox[{"verts", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}]}], "]"}]}], "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Mag", "[", 
             RowBox[{
              RowBox[{"vvars", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], "-", 
              RowBox[{"vvars", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}]}], "]"}], "/", 
            RowBox[{"Mag", "[", 
             RowBox[{
              RowBox[{"verts", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], "-", 
              RowBox[{"verts", "\[LeftDoubleBracket]", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}]}], "]"}]}], "-", "1"}], ")"}]}], 
        "&"}], "/@", "qfaces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "shape", " ", "constraint", " ", "functions", " ", "that", " ", 
       "define", " ", "the", " ", "stretched", " ", "shape"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sconds", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "lower", " ", "left", " ", "vertex", " ", "to", " ", "its", " ", 
          "original", " ", "position"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"vvars", "\[LeftDoubleBracket]", 
           RowBox[{
           "bverts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], "-", 
          RowBox[{"verts3d", "\[LeftDoubleBracket]", 
           RowBox[{
           "bverts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "remaining", " ", "bottom", " ", "row", " ", "of", " ", "vertices",
             " ", "to", " ", "x"}], "-", 
           RowBox[{"z", " ", "plane"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", ".", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ")"}], "&"}], "/@", 
          
          RowBox[{"vvars", "\[LeftDoubleBracket]", 
           RowBox[{"Drop", "[", 
            RowBox[{"bverts", ",", "1"}], "]"}], "\[RightDoubleBracket]"}]}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "top", " ", "row", " ", "of", " ", "vertices", " ", "to", " ", 
            "rotated", " ", "x"}], "-", 
           RowBox[{"y", " ", "plane"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", ".", 
             RowBox[{"U3D", "[", 
              RowBox[{
               RowBox[{"\[Pi]", "/", "2"}], "+", "d\[Phi]"}], "]"}]}], ")"}], 
           "&"}], "/@", 
          RowBox[{"vvars", "\[LeftDoubleBracket]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
              "bverts", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}], "\[Equal]", 
              RowBox[{
              "tverts", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{"Drop", "[", 
              RowBox[{"tverts", ",", "1"}], "]"}], ",", "tverts"}], "]"}], 
           "\[RightDoubleBracket]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "upper", " ", "right", " ", "vertex", " ", "constrained", " ", 
            "to", " ", "its", " ", "original", " ", "radius", " ", "from", " ",
             "z"}], "-", "axis"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{"vvars", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{"tverts", "\[LeftDoubleBracket]", 
              RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}], 
           "]"}], "-", 
          RowBox[{"Mag", "[", 
           RowBox[{"verts3d", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{"tverts", "\[LeftDoubleBracket]", 
              RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "\[RightDoubleBracket]"}], 
           "]"}]}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Double", "-", 
        RowBox[{"check", " ", "that", " ", "#vars"}]}], " ", "=", " ", 
       "#eqns"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nv", "=", 
          RowBox[{"Length", "[", "vars", "]"}]}], ",", 
         RowBox[{"ne", "=", 
          RowBox[{"Length", "[", 
           RowBox[{"Join", "[", 
            RowBox[{"econds", ",", "dconds", ",", "sconds"}], "]"}], 
           "]"}]}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nv", "\[NotEqual]", "ne"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<ERROR: nv = \>\"", ",", "nv", ",", "\"\<, ne = \>\"", 
            ",", "ne"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Solve", " ", "all", " ", "equations", " ", "for", " ", "new", " ", 
       "shape"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindRoot", "@@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"sconds", ",", "econds", ",", "dconds"}], "]"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"vars", ",", "vars0"}], "}"}], "]"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"vvars", "/.", "soln"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj1", "//", 
       RowBox[{"ReplaceProperty", "[", 
        RowBox[{"Vertices3D", "\[Rule]", "verts3d"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Break", " ", "bent", " ", "quads", " ", "into", " ", "triangles", " ", 
       "whose", " ", "bend", " ", "exceeds", " ", "tolerance"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sbf", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ba13", "=", 
              RowBox[{"SkewQuadrilateralAngle", "@@", 
               RowBox[{
               "verts3d", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}]}]}], ",", 
             RowBox[{"ba24", "=", 
              RowBox[{"SkewQuadrilateralAngle", "@@", 
               RowBox[{"verts3d", "\[LeftDoubleBracket]", 
                RowBox[{"RotateLeft", "[", "#", "]"}], 
                "\[RightDoubleBracket]"}]}]}]}], "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"ba13", "\[GreaterEqual]", "sbt"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"nedges", ",", 
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], 
              "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"ba24", "\[GreaterEqual]", "sbt"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"nedges", ",", 
                 RowBox[{"#", "\[LeftDoubleBracket]", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "4"}], "}"}], 
                  "\[RightDoubleBracket]"}]}], "]"}]}], "]"}]}], "]"}]}], 
          "]"}], "&"}], "/@", "qfaces"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sbf", "&&", 
        RowBox[{"!", 
