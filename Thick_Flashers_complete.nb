Cell[TextData[{
 "NCurvedFoldUniformHelix2D[",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Theta]",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]0",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces the 2D functions that describe a uniform fold along a helix with \
a given radius and helicity angle."
}], "Text",
 CellChangeTimes->{{3.799744730965797*^9, 3.799744763128796*^9}, {
   3.799749647177718*^9, 3.799749659535693*^9}, {3.799750818618812*^9, 
