Cell[CellGroupData[{

Cell["Panel construction", "Subsection",
 CellChangeTimes->{{3.911901231243453*^9, 3.911901234251112*^9}, {
  3.911932130231328*^9, 3.911932130821158*^9}, {3.912004772267976*^9, 
