Cell["\<\
Example. Two polygons with slightly skew edges and the hinge that joins them \
with different types and options.\
\>", "Text",
 CellChangeTimes->{{3.9122525565224733`*^9, 3.912252558654389*^9}, {
  3.912575224927684*^9, 3.912575234182829*^9}, {3.920736171783286*^9, 
  3.920736175175708*^9}, {3.9208042903987713`*^9, 3.920804293460449*^9}, {
  3.922817941146407*^9, 
  3.9228179526373577`*^9}},ExpressionUUID->"5e255b0b-03a2-4f19-8db2-\
c1abb63758b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "q1", ",", "q2", ",", "r1", ",", "r2", ",", 
      "polys", ",", "gc1", ",", "gc2", ",", "gc3", ",", "gc4"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", ".4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2.2", ",", ".4", ",", "0.1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1", ",", "r2"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1.4", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"polys", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "r1"}], "}"}], "]"}], ",", 
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{"q1", ",", "q2", ",", "r2"}], "}"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc1", "=", 
      RowBox[{"MakeHingeGC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], ",", 
        RowBox[{"HingeType", "->", "HingePlateGC"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc2", "=", 
      RowBox[{"MakeHingeGC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], ",", 
        RowBox[{"HingeType", "->", "HingeMultiWireGC"}], ",", 
        RowBox[{"HingeNumWires", "->", "5"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc3", "=", 
      RowBox[{"MakeHingeGC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], ",", 
        RowBox[{"HingeType", "->", "HingeRoundedPlateGC"}], ",", 
        RowBox[{"RoundingDivisions", "->", "6"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gc4", "=", 
      RowBox[{"MakeHingeGC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], ",", 
        RowBox[{"HingeType", "->", "HingePlateGC"}], ",", 
        RowBox[{"HingeLengthInset", "->", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", "0.2"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", "polys", "}"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<Polygons to join\>\""}]}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"polys", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"gc1", ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<HingePlateGC\>\""}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"polys", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"gc3", ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<HingeRoundedPlateGC\>\""}]}], "]"}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"polys", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"gc2", ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<HingeMultiWireGC\>\""}]}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"polys", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"gc4", ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<HingePlateGC w/ inset\>\""}]}], 
         "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.912252560619796*^9, 3.912252698393826*^9}, {
   3.912252765309927*^9, 3.912252766589542*^9}, {3.912252808456509*^9, 
   3.912252810980138*^9}, {3.912253713936645*^9, 3.912253716238391*^9}, {
   3.912254123661696*^9, 3.912254154426799*^9}, {3.912257491363227*^9, 
   3.91225752064164*^9}, 3.91234673933003*^9, 3.912574879100521*^9, {
   3.912574948805365*^9, 3.912574965385092*^9}, {3.912575001423009*^9, 
   3.912575217551062*^9}, {3.912756144147727*^9, 3.912756145295474*^9}, {
   3.914838331940864*^9, 3.914838334121308*^9}, 3.920735999898373*^9, {
   3.920736033250415*^9, 3.9207360367437162`*^9}, {3.920804298200651*^9, 
   3.920804373289049*^9}, {3.9208044696347027`*^9, 3.9208044791962757`*^9}, {
   3.922629983133355*^9, 3.922630056664517*^9}, {3.922696557599286*^9, 
   3.9226966163463783`*^9}, {3.922696691880213*^9, 3.922696748664336*^9}, {
   3.922817863409427*^9, 3.922817935149908*^9}, {3.922817972097776*^9, 
