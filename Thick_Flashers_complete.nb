Cell[TextData[{
 "PtInTriangleQ[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c",
  FontSlant->"Italic"],
 "}] returns True if the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " lies within the triangle defined by the points ",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["c",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.462903444631745*^9, 
  3.46290344832555*^9}},ExpressionUUID->"5de4ad7c-21a6-47de-bd84-\
4e9f3bc6cd9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PtInTriangleQ", "[", 
   RowBox[{"p_", ",", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "=", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Inverse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"b", "-", "a"}], ",", 
           RowBox[{"c", "-", "a"}]}], "}"}], "]"}], "]"}], ".", 
       RowBox[{"(", 
        RowBox[{"p", "-", "a"}], ")"}]}]}], ";", 
     RowBox[{
      RowBox[{"x", ">", "0"}], "&&", 
      RowBox[{"x", "<", "1"}], "&&", 
      RowBox[{"y", ">", "0"}], "&&", 
      RowBox[{"y", "<", "1"}], "&&", 
      RowBox[{
       RowBox[{"x", "+", "y"}], "<", "1"}]}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[496]:=",ExpressionUUID->"9fcdf181-ef05-4dd9-b785-1deba0567f67"],

Cell["Example", "Text",ExpressionUUID->"4f3dafb3-6478-4c15-8edf-656fa543dbf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PointSize", "[", ".02", "]"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"{", 
           RowBox[{".1", ",", ".1"}], "}"}]}], ",", 
         RowBox[{"b", "=", 
          RowBox[{"{", 
           RowBox[{".9", ",", ".2"}], "}"}]}], ",", 
         RowBox[{"c", "=", 
          RowBox[{"{", 
           RowBox[{".4", ",", ".8"}], "}"}]}], ",", "p"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{"1", ",", ".5", ",", "0"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c", ",", "a"}], "}"}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Random", "[", "]"}], ",", 
               RowBox[{"Random", "[", "]"}]}], "}"}]}], ";", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"PtInTriangleQ", "[", 
                 RowBox[{"p", ",", 
                  RowBox[{"{", 
                   RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}], ",", 
                "Red", ",", "Blue"}], "]"}], ",", 
              RowBox[{"Point", "[", "p", "]"}]}], "}"}]}], ",", 
           RowBox[{"{", "60", "}"}]}], "]"}]}], "}"}]}], "]"}]}], "}"}], 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.462903475892728*^9, 3.462903493757595*^9}, {
   3.462922975660445*^9, 3.462922978776563*^9}, 3.48477065809137*^9, 
   3.484770689451844*^9},
 CellLabel->
  "In[497]:=",ExpressionUUID->"94b75a03-5c91-4516-9823-5619a770aa9d"],

Cell[TextData[{
 "PtInTrianglesQ[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 "] returns True if the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " lies within any of the triangles in ",
 StyleBox["tlist",
  FontSlant->"Italic"],
 ", given a list of point triples."
}], "Text",
 CellChangeTimes->{{3.6288543802505407`*^9, 
  3.628854418079874*^9}},ExpressionUUID->"f418c26d-2276-48d1-9e45-\
5dab688ab813"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PtInTrianglesQ", "[", 
   RowBox[{"p_", ",", "tlist_List"}], "]"}], ":=", 
  RowBox[{"Catch", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"PtInTriangleQ", "[", 
         RowBox[{"p", ",", "#"}], "]"}], ",", 
        RowBox[{"Throw", "[", "True", "]"}]}], "]"}], "&"}], "/@", "tlist"}], 
    ";", "False"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.628854448113683*^9, 3.628854502008164*^9}},
 CellLabel->
  "In[498]:=",ExpressionUUID->"d912b1aa-d549-4bf6-8c5e-b3ad1fb67d17"],

Cell["Example", "Text",
 CellChangeTimes->{{3.628854509475218*^9, 
  3.628854510234397*^9}},ExpressionUUID->"5bfcb811-6b94-456f-96ed-\
a654e2bfcda8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tlist", ",", "p"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tlist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", ".5"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", ".5"}], "}"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"AppendFirst", "[", "#", "]"}], "]"}], ",", "Orange"}], 
           "]"}], "&"}], "/@", "tlist"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"2.4", 
                RowBox[{"Random", "[", "]"}]}], "-", "1.2"}], ",", 
              RowBox[{"Random", "[", "]"}]}], "}"}]}], ";", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Point", "[", "p", "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"PtInTrianglesQ", "[", 
                RowBox[{"p", ",", "tlist"}], "]"}], ",", "Red", ",", "Blue"}],
               "]"}], ",", 
             RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}]}], ",", 
          RowBox[{"{", "60", "}"}]}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.628854518769166*^9, 3.628854784076783*^9}},
 CellLabel->
  "In[499]:=",ExpressionUUID->"196f18a0-6801-43cd-ac2e-8ede555a5a60"],

Cell[TextData[{
 "PtInConvexPolygonQ[",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] returns True if ",
 StyleBox["q",
  FontSlant->"Italic"],
 " lies within the convex polygon ",
 StyleBox["poly",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.463409837290081*^9, 3.463409868125969*^9}, {
   3.4635105503376837`*^9, 3.463510573726296*^9}, 3.6288627640448914`*^9, {
   3.628862938348648*^9, 
   3.628862941243528*^9}},ExpressionUUID->"b967f711-9c48-4e01-9dc2-\
7a2d040986a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PtInConvexPolygonQ", "[", 
   RowBox[{"q_", ",", "poly_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ctr", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ctr", "=", 
      RowBox[{"Centroid", "[", "poly", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"PtNotInHalfPlaneQ", "[", 
             RowBox[{"q", ",", 
              RowBox[{"{", 
               RowBox[{"#1", ",", "#2", ",", "ctr"}], "}"}]}], "]"}], ",", 
            RowBox[{"Throw", "[", "False", "]"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"poly", ",", 
           RowBox[{"RotateLeft", "[", "poly", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Throw", "[", "True", "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.46340988074914*^9, 3.463409978380582*^9}, {
  3.463410024723815*^9, 3.463410026161771*^9}, {3.463510081542588*^9, 
  3.463510090240822*^9}, {3.463510129574459*^9, 3.463510150386753*^9}, {
