Cell[CellGroupData[{

Cell["Twist tiles", "Section",
 CellChangeTimes->{{3.707755454369514*^9, 
  3.707755455730157*^9}},ExpressionUUID->"5650801d-b364-42d4-bcc6-\
007a958e51b5"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.707755467601335*^9, 
  3.707755468090646*^9}},ExpressionUUID->"e6411944-d7a6-48f0-8fbf-\
ce3e10b35614"],

Cell["\<\
Twist tiles are tiles that incorporate polygonal twists within a polygonal \
tile.\
\>", "Text",
 CellChangeTimes->{{3.707755469721634*^9, 3.707755509098114*^9}, {
  3.7077731494079447`*^9, 
  3.707773162241198*^9}},ExpressionUUID->"efa4d0e1-0acd-47d0-b49a-\
07684bbb3c1f"],

Cell[TextData[{
 "In general, the naming of a twist tile will follow this scheme: <",
 StyleBox["shape",
  FontSlant->"Italic"],
 ">[<",
 StyleBox["twisttype",
  FontSlant->"Italic"],
 ">]Tile, where\n\t<",
 StyleBox["shape",
  FontSlant->"Italic"],
 "> describes the shape (outline) of the tile,\n\t<",
 StyleBox["twisttype",
  FontSlant->"Italic"],
 "> (optional) describes the type of twist that is within the tile. \nSo, for \
example, in UnitTrapezoidOffsetTwistTile, <",
 StyleBox["shape",
  FontSlant->"Italic"],
 "> is UnitTrapezoid, <",
 StyleBox["twisttype",
  FontSlant->"Italic"],
 "> is OffsetTwist."
}], "Text",
 CellChangeTimes->{{3.707753481729775*^9, 3.707753484952075*^9}, {
  3.707755576269039*^9, 
  3.707755579796558*^9}},ExpressionUUID->"a83ec07e-a871-4a8b-ab5d-\
d98f1ba5236b"]
}, Closed]],

Cell[CellGroupData[{

Cell["Polygon twist tiles", "Subsection",
 CellChangeTimes->{{3.630017396698839*^9, 3.630017405101023*^9}, 
   3.630017545572129*^9, 
   3.630111529882805*^9},ExpressionUUID->"a9a3ecf6-f074-443f-b3f5-\
af9bab629d32"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.630017552348058*^9, 
  3.630017553451103*^9}},ExpressionUUID->"f1f1244f-fd57-4010-b9a8-\
dda6d6edd9dc"],

Cell["\<\
There is a general family of twist tiles that involves sending pleats in from \
the tile edges at a specified angle relative to the tile edge. The pleats \
intersect to create a central polygon. Two cases of particular interest are \
edge-centered twist tiles (PolygonCenteredTwistTile, PolygonCenteredTwistAlt) \
and offset twist tiles (PolygonOffsetTwistTile). We can implement both of \
these as special cases of a general-purpose tile, PolygonTwistTile, which we \
construct here.\
\>", "Text",
 CellChangeTimes->{{3.6300175767544737`*^9, 3.63001758238017*^9}, {
   3.630017616040153*^9, 3.630017669980307*^9}, {3.6300178757992167`*^9, 
   3.630017990894956*^9}, {3.630018254681344*^9, 3.630018256646113*^9}, 
   3.630149588625594*^9, 
   3.630149649371005*^9},ExpressionUUID->"da0b92e7-b613-44d8-ab16-\
6da6f9c34d89"],

Cell["\<\
You will normally not build tilings directly from this type of tile. We use \
it as a building block for other types of twist tiles. Note, too, that it is, \
in general, only flat-foldable for certain polygons and combinations of \
parameters.\
\>", "Text",
 CellChangeTimes->{{3.630018103218436*^9, 3.630018145044701*^9}, {
  3.6300182636854777`*^9, 3.6300182909881487`*^9}, {3.707773182441077*^9, 
  3.707773184033681*^9}},ExpressionUUID->"1a3b91d7-1be5-4aae-9d89-\
c04cfdce7e21"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "{PolygonTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.630017996479157*^9, 
  3.630018033540922*^9}},ExpressionUUID->"1306470f-80b3-47e7-9eab-\
b9d5746ec18f"],

Cell[TextData[{
 "{PolygonTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} is a tiletype that describes a twist in a polygon specified by its \
vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \[Tau] \
is the pleat angle, defined as the rotation angle of the pleat measured with \
respect to the edge, ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the offset from the center of the edge, ",
 StyleBox["ccw",
  FontSlant->"Italic"],
 " is a flag indicating whether the pleat crease assignment should assume a \
CCW twist, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.630018057104121*^9, 3.630018098648444*^9}, {
  3.630018154303489*^9, 3.630018213928781*^9}, {3.6300725017534*^9, 
  3.630072501904191*^9}},ExpressionUUID->"347081ef-0c0d-4d10-a47e-\
3897e2da578a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PolygonTwistTile", "::", "usage"}], 
   "=", "\"\<PolygonTwistTile is a tile type that produces a simple flat \
twist in a polygon.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629825639748377*^9, 3.629825695990987*^9}, 
   3.62982619453579*^9, {3.629827526832037*^9, 3.629827546351098*^9}, {
   3.630018227820609*^9, 3.630018234216425*^9}, {3.630018298190243*^9, 
   3.630018303087718*^9}},
 CellLabel->
  "In[2862]:=",ExpressionUUID->"1b8b4fdf-0cb3-4b1a-b081-814a099dea11"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TileCheckTypes[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.630109263963629*^9, 
  3.630109270728582*^9}},ExpressionUUID->"a08f40da-79ba-48f1-b1b7-\
ca41e9e7024c"],

Cell[TextData[{
 "TileCheckTypes[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] checks the length of ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " against the length of ",
 StyleBox["types",
  FontSlant->"Italic"],
 " and throws an error if there is a mismatch."
}], "Text",
 CellChangeTimes->{{3.630109285580242*^9, 
  3.630109299960266*^9}},ExpressionUUID->"85c74434-a8f9-4efb-ba01-\
81b7fee162d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TileCheckTypes", "::", "badtypes"}], 
   "=", "\"\<Length `1` of vertex list `2` does not match length `3` of types \
list `4`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.630109331410438*^9, 3.630109363606354*^9}},
 CellLabel->
  "In[2863]:=",ExpressionUUID->"e03f46d5-fcb9-467e-8fa5-3b287fed3f76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TileCheckTypes", "[", 
   RowBox[{"verts_List", ",", "types_List"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "verts", "]"}], "\[NotEqual]", 
     RowBox[{"Length", "[", "types", "]"}]}], ",", 
    RowBox[{
     RowBox[{"Message", "[", 
      RowBox[{
       RowBox[{"TileCheckTypes", "::", "badtypes"}], ",", 
       RowBox[{"Length", "[", "verts", "]"}], ",", "verts", ",", 
       RowBox[{"Length", "[", "types", "]"}], ",", "types"}], "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.6301093101772346`*^9, 3.630109326559719*^9}, {
  3.630109371478774*^9, 3.6301094101726513`*^9}},
 CellLabel->
  "In[2864]:=",ExpressionUUID->"e364be89-38ca-4727-b2c4-13320c2887bc"]
}, Closed]],

