Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "b", ",", "d", ",", "\[Sigma]", ",", "\[Theta]", ",", "ui", ",", "bbi", ",",
       "uui", ",", "ddi", ",", "\[Beta]", ",", "\[Beta]0", ",", "bb", ",", 
      "dd", ",", "s", ",", "u0", ",", "u1", ",", "v0", ",", "v1", ",", "cc", ",",
       "c"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"a", " ", "cone"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"b", "=", 
      RowBox[{"Unplanarize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "&"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"Unplanarize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "#", "]"}]}], ",", 
          RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "conditions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "bbi", ",", "ddi", ",", "uui"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "desired", " ", "normal", " ", "curvature", " ", "to", " ", "achieve", " ",
        "flatness"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"\[Beta]0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}], "=", 
      RowBox[{"ReshapeCone3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"b", ",", "d", ",", "\[Sigma]"}], "}"}], ",", "\[Beta]", ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "ddi", ",", "uui"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\[Beta]0", ">", "0"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"print", " ", "the", " ", "functions"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<bb = \>\"", ",", 
       RowBox[{"bb", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<dd = \>\"", ",", 
       RowBox[{"dd", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"plot", " ", "range"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v0", ",", "v1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"pick", " ", "a", " ", "value", " ", "of", " ", "\[Beta]0"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Beta]0", "=", ".7"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "a", " ", "directed", " ", "cross", " ", "curve"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"bb", "[", "s", "]"}], "+", " ", 
         RowBox[{"dd", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"b", "[", "s", "]"}], "+", " ", 
         RowBox[{"d", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"bb", ",", "dd", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"StyledCurve", "[", 
               RowBox[{"cc", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", 
               RowBox[{"2", ",", "2", ",", "2"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"b", ",", "d", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                RowBox[{"SurfaceOrientation", "\[Rule]", "\[Sigma]"}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"StyledCurve", "[", 
               RowBox[{"c", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"CurveDirected", "\[Rule]", "True"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
            RowBox[{"Method", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
           "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
