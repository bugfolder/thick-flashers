      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}], "//", 
        RowBox[{"AddTGraph3D", "[", 
         RowBox[{"verts3d", ",", " ", "foldangles"}], "]"}]}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"re", "-", 
        RowBox[{
        "fold", " ", "it", " ", "to", " ", "the", " ", "new", " ", 
         "angle"}]}], ",", " ", 
       RowBox[{
       "keeping", " ", "original", " ", "orientation", " ", "of", " ", 
        "facet", " ", "2"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj", ",", "foldangles", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "2"}], ",", 
        RowBox[{"ShowProgress", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Graph3DGraphics3D", "[", "tobj", "]"}], ",", 
        RowBox[{"Graph3DGraphics3D", "[", "tobj1", "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
