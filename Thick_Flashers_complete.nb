 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "2"}], ",", 
