  3.693415668608426*^9, 
  3.693415669087931*^9}},ExpressionUUID->"a9e1bfba-535c-43ee-a690-\
7f8833c52b79"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["nh",
  FontSlant->"Italic"],
 " is the number of facets in the horizontal direction\n\t",
 StyleBox["nv",
  FontSlant->"Italic"],
 " is the number of facets in the vertical direction."
}], "Text",
 CellChangeTimes->{{3.69340963094125*^9, 3.6934096345950747`*^9}, {
  3.693409748436303*^9, 
  3.693409761317964*^9}},ExpressionUUID->"13887391-d75a-473a-944e-\
3a274850bc17"],

Cell[TextData[{
 " Typically {",
 StyleBox["i",
  FontSlant->"Italic"],
 "=0, ",
 StyleBox["j",
  FontSlant->"Italic"],
 "=0} will be in the lower left corner of the pattern."
}], "Text",
 CellChangeTimes->{
  3.693409679477895*^9},ExpressionUUID->"3dec7ff8-51c8-42fe-871f-\
7d2b2bc4ad1a"],

Cell[TextData[{
 "Options:\n\tVerticesFn \[Rule] ",
 StyleBox["vfn | None",
  FontSlant->"Italic"],
 ", a function that returns the coordinates of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}th vertex as the value of ",
 StyleBox["vfn[i,j]",
  FontSlant->"Italic"],
 ".\n\tVertices3DFn \[Rule] ",
 StyleBox["v3dfn",
  FontSlant->"Italic"],
 " | None, a function that returns the 3D coordinates of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}th vertex as the value of ",
 StyleBox["v3dfn[i,j].",
  FontSlant->"Italic"],
 "\n\tHorizontalEdgeTypeFn \[Rule] ",
 StyleBox["hetfn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["hetfn[i,j]",
  FontSlant->"Italic"],
 " returns the type of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}th horizontal edge.\n\tVerticalEdgeTypeFn \[Rule] ",
 StyleBox["vetfn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["vetfn[i,j]",
  FontSlant->"Italic"],
 " returns the type of the {i,j}th vertical edge.\n\tHorizontalEdgeAngleFn \
\[Rule] ",
 StyleBox["heafn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["heafn[i,j]",
  FontSlant->"Italic"],
 " returns the fold angle of the {",
 StyleBox["i,j",
  FontSlant->"Italic"],
 "}th horizontal edge.\n\tVerticalEdgeTypeFn \[Rule] ",
 StyleBox["veafn",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["veafn[i,j]",
  FontSlant->"Italic"],
 " returns the type of the {i,j}th vertical edge.\n\tBorderOverride \[Rule] \
True | False, where True overrides ",
 StyleBox["hetfn",
  FontSlant->"Italic"],
 " and ",
 StyleBox["vetfn",
  FontSlant->"Italic"],
 " and makes all border lines of type B.\n\tSamePtTolerance \[Rule] ",
 StyleBox["tol |",
  FontSlant->"Italic"],
 " None, specifies the tolerance to use for merging vertices that are close \
together."
}], "Text",
 CellChangeTimes->{{3.594057330456885*^9, 3.594057530001993*^9}, {
   3.5940577493961577`*^9, 3.594057837246922*^9}, {3.594058669922537*^9, 
   3.594058702031582*^9}, {3.594058863590161*^9, 3.594058875059916*^9}, 
   3.594059039588849*^9, {3.594059172426364*^9, 3.594059189175597*^9}, 
   3.594060037310161*^9, {3.594060125396596*^9, 3.594060126803766*^9}, 
   3.594060262067026*^9, {3.594069548519369*^9, 3.594069613531061*^9}, 
   3.5940697493389072`*^9, {3.594070403737878*^9, 3.594070498515996*^9}, {
   3.594070539187318*^9, 3.594070551775152*^9}, 3.59473451738591*^9, {
