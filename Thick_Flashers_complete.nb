 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "NSurfaceNormalFromSurface", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"SurfaceOrientation", "\[Rule]", "1"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.797258506369285*^9, 3.79725853005872*^9}},
 CellLabel->
