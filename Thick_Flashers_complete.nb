Cell[CellGroupData[{

Cell[TextData[{
 "QuasiConvexPolygonsIntersectQ[",
 StyleBox["pinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qpinfo",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.628821822063929*^9, 3.628821837493211*^9}, {
   3.628821880242095*^9, 3.628821880994349*^9}, {3.628854225247619*^9, 
   3.628854229067761*^9}, 3.628854896924986*^9, {3.628854944235917*^9, 
   3.6288549493497066`*^9}},ExpressionUUID->"da9baaab-c111-4a2c-8e73-\
05cb3c7e4074"],

Cell[TextData[{
 "QuasiConvexPolygonsIntersectQ",
 "[",
 StyleBox["pinfo",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qinfo",
  FontSlant->"Italic"],
 "] returns True if the two 2D polygons described by intersection info ",
 StyleBox["pinfo",
  FontSlant->"Italic"],
 " and ",
 StyleBox["qinfo",
  FontSlant->"Italic"],
 " intersect. Either polygon can be quasi-convex and can circulate in either \
direction."
}], "Text",
 CellChangeTimes->{{3.628821852661985*^9, 3.62882188980972*^9}, {
  3.628854235251484*^9, 3.628854254194151*^9}, {3.62885490508153*^9, 
  3.628854952743887*^9}},ExpressionUUID->"f6c795a8-4b15-4ec6-9288-\
b0e57a832a25"],

Cell["\<\
We require full intersection information because when checking lots of \
polygon pairs, it\[CloseCurlyQuote]s more efficient to precalculate all of \
the info and then use that information to do cheap comparisons first, \
expensive ones later.\
\>", "Text",
 CellChangeTimes->{{3.628855103693021*^9, 3.6288551151869907`*^9}, {
  3.628855441429913*^9, 
  3.628855502857787*^9}},ExpressionUUID->"15dbb81e-5649-4b21-a26d-\
f0ec597d3392"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuasiConvexPolygonsIntersectQ", "::", "badinfo"}], 
   "=", "\"\<The intersection information list `1` is not a length-4 \
list.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.628864987363141*^9, 3.628865019242399*^9}},
 CellLabel->
  "In[521]:=",ExpressionUUID->"bfeeec10-88a5-488a-9483-7a30a3bd7bca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuasiConvexPolygonsIntersectQ", "[", 
   RowBox[{
    StyleBox["pinfo_List",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["qinfo_List",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pverts", ",", "pbox", ",", "pconv", ",", "ptverts", ",", "qverts", ",", 
      "qbox", ",", "qconv", ",", "qtverts", ",", "psegs", ",", "qsegs"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "pinfo", "]"}], "\[NotEqual]", "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"QuasiConvexPolygonsIntersectQ", "::", "badinfo"}], ",", 
          "pinfo"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "qinfo", "]"}], "\[NotEqual]", "4"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"QuasiConvexPolygonsIntersectQ", "::", "badinfo"}], ",", 
          "qinfo"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pverts", ",", "pbox", ",", "pconv", ",", "ptverts"}], "}"}], "=",
       "pinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qverts", ",", "qbox", ",", "qconv", ",", "qtverts"}], "}"}], "=",
       "qinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "first", " ", "and", " ", "simplest", " ", "check", " ", "is", " ", 
        "to", " ", "see", " ", "if", " ", "their", " ", "bounding", " ", 
        "boxes", " ", "are", " ", "disjoint"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"BoundingBoxesIntersectQ", "[", 
           RowBox[{"pbox", ",", "qbox"}], "]"}]}], ",", 
         RowBox[{"Throw", "[", "False", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "next", " ", "check", " ", "is", " ", "to", " ", "see", " ", "if", " ",
          "any", " ", "of", " ", "the", " ", "vertices", " ", "of", " ", 
         "poly", " ", "is", " ", "contained", " ", "in", " ", 
         RowBox[{"qverts", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"qconv", ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"PtInConvexPolygonQ", "[", 
              RowBox[{"#", ",", "qverts"}], "]"}], ",", 
             RowBox[{"Throw", "[", "True", "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"PtInTrianglesQ", "[", 
              RowBox[{"#", ",", "qtverts"}], "]"}], ",", 
             RowBox[{"Throw", "[", "True", "]"}]}], "]"}]}], "]"}], "&"}], "/@",
         "pverts"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "last", " ", "check", " ", "is", " ", "to", " ", "see", " ", "if", " ",
          "any", " ", "line", " ", "segments", " ", "of", " ", "poly", " ", 
         "intersect", " ", "any", " ", "line", " ", "segment", " ", "of", " ",
          "qpoly"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"psegs", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"pverts", ",", 
           RowBox[{"RotateLeft", "[", "pverts", "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qsegs", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"qverts", ",", 
           RowBox[{"RotateLeft", "[", "qverts", "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"SegmentsIntersectQ", "[", 
             RowBox[{"#1", ",", "#2"}], "]"}], ",", 
            RowBox[{"Throw", "[", "True", "]"}]}], "]"}], "&"}], ",", "psegs",
          ",", "qsegs", ",", "1"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "if", " ", "we", " ", "never", " ", "found", " ", "anything"}], ",", 
         " ", 
         RowBox[{"they", " ", 
          RowBox[{"don", "'"}], "t", " ", 
          RowBox[{"intersect", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{"Throw", "[", "False", "]"}]}], "]"}]}]}], "]"}]}]], "Input",
