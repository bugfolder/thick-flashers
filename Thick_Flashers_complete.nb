  3.7079361142950373`*^9}},ExpressionUUID->"bb77cca0-5754-400d-a6be-\
8b2681a8c0f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "foldangles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", "SingleVertexGraph"}], ";", "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{"\[Pi]", ",", "\[Pi]", ",", 
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", "0", ",", "0", ",", "0", ",",
         "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph2DAll", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Graph2DGraphics", "[", "tobj", "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
