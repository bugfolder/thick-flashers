Cell[TextData[{
 "NCurveSpeed[",
 StyleBox["c",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] computes the speed of a curve as an InterpolatingFunction."
}], "Text",
 CellChangeTimes->{{3.691580240584978*^9, 3.6915802790773783`*^9}, {
   3.691580451784436*^9, 3.691580452377629*^9}, {3.6915813455875597`*^9, 
