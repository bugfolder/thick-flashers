   3.4415018868636217`*^9, 3.4415019037276797`*^9}, {3.4418367077079086`*^9, 
   3.441836764134556*^9}, {3.441889372776023*^9, 3.441889449167226*^9}, {
   3.441925356973134*^9, 3.441925359008573*^9}, 3.441928485745756*^9, {
   3.4419287564335*^9, 3.441928768051717*^9}, {3.441929471520324*^9, 
   3.4419296063794403`*^9}, {3.441929648077079*^9, 3.441929650132425*^9}, {
   3.441929718958166*^9, 3.441929755921832*^9}, 3.441929805581838*^9, 
   3.44199197122571*^9, {3.442671372422742*^9, 3.442671517245743*^9}, {
   3.4426718145650387`*^9, 3.4426718547768097`*^9}, {3.442672348255006*^9, 
   3.442672419301582*^9}, {3.443016718234557*^9, 3.4430167186694*^9}, {
   3.443039744847826*^9, 3.443039761602171*^9}, 3.443039793899955*^9, {
   3.443039875118794*^9, 3.443039875199159*^9}, {3.443043350023992*^9, 
   3.443043380056567*^9}, 3.443123969017146*^9, {3.443124418752808*^9, 
   3.443124475276147*^9}, {3.443224689881306*^9, 3.4432247369581614`*^9}, {
   3.592078556946488*^9, 3.592078684630349*^9}, 3.592437131455439*^9, {
   3.592437821159959*^9, 3.592437821160016*^9}, {3.592437851362495*^9, 
   3.592437882221999*^9}, 3.592829169698284*^9, {3.592829562091935*^9, 
   3.592829577773855*^9}, 3.59482170662827*^9, 3.5948223108616257`*^9, {
   3.594982799541434*^9, 3.594982803537477*^9}, {3.59498488889401*^9, 
   3.594984891930352*^9}, 3.616173723701407*^9, {3.617439608582251*^9, 
