Cell["Show the triangle panels in a single sector.", "Text",
 CellChangeTimes->{{3.913553321188135*^9, 3.913553326749768*^9}, {
  3.922613159120007*^9, 
  3.922613159711544*^9}},ExpressionUUID->"4b427d43-21c8-4c5c-af67-\
873036a3e581"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", "fst", ",", "fspolys"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fst", "=", 
     RowBox[{"FlasherSectorTriangles", "[", 
      RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PrintThis", "[", "fst", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"fspolys", "=", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ctr", "=", 
            RowBox[{
             RowBox[{"Plus", "@@", "#1"}], "/", "4"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"ctr", "+", 
                RowBox[{"0.8", 
                 RowBox[{"(", 
                  RowBox[{"#1", "-", "ctr"}], ")"}]}]}], "]"}], ",", 
              "LightGray"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"\"\<q\>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{
                  "#2", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}], "]"}]}], ",", "ctr"}], "]"}], ",", 
              RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}]}], 
         "]"}], "&"}], ",", "fst"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fspolys", ",", 
        RowBox[{"FlasherFirstSectorAllPossibleVerticesLabels", "[", 
         RowBox[{"\"\<p\>\"", ",", "p", ",", 
          RowBox[{"r", "*", "h"}]}], "]"}]}], "}"}], "/.", 
      RowBox[{"FlasherDefaultCPRules", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.911903262919632*^9, 3.911903291719178*^9}, {
   3.911903331497651*^9, 3.911903338295684*^9}, 3.91190390873025*^9, 
   3.91190447368842*^9, {3.911906705370748*^9, 3.911906737217489*^9}, {
   3.911916359840579*^9, 3.911916378624357*^9}, 3.911919846264626*^9},
 CellLabel->
  "In[4510]:=",ExpressionUUID->"1a782635-306e-4408-ad66-85660665cd58"],

Cell["Show the quad panels in a single sector.", "Text",
 CellChangeTimes->{{3.913553333677326*^9, 3.913553339293417*^9}, {
  3.922613162855987*^9, 
  3.922613165526617*^9}},ExpressionUUID->"ccf5e0ee-bd95-4b02-8205-\
178e35b537a2"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", "fsq", ",", "fspolys"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fsq", "=", 
     RowBox[{"FlasherSectorQuads", "[", 
      RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PrintThis", "[", "fsq", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"fspolys", "=", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ctr", "=", 
            RowBox[{
             RowBox[{"Plus", "@@", "#1"}], "/", "4"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Polygon", "[", 
               RowBox[{"ctr", "+", 
                RowBox[{"0.8", 
                 RowBox[{"(", 
                  RowBox[{"#1", "-", "ctr"}], ")"}]}]}], "]"}], ",", 
              "LightGray"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{
                RowBox[{"\"\<q\>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{
                  "#2", "\[LeftDoubleBracket]", "1", 
                   "\[RightDoubleBracket]"}], "]"}]}], ",", "ctr"}], "]"}], ",", 
              RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}]}], 
         "]"}], "&"}], ",", "fsq"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fspolys", ",", 
        RowBox[{"FlasherFirstSectorAllPossibleVerticesLabels", "[", 
         RowBox[{"\"\<p\>\"", ",", "p", ",", 
          RowBox[{"r", "*", "h"}]}], "]"}]}], "}"}], "/.", 
      RowBox[{"FlasherDefaultCPRules", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.911903262919632*^9, 3.911903291719178*^9}, {
   3.911903331497651*^9, 3.911903338295684*^9}, 3.91190390873025*^9, 
   3.91190447368842*^9, {3.911906705370748*^9, 3.911906737217489*^9}},
 CellLabel->
  "In[4511]:=",ExpressionUUID->"e8f8b86f-1582-4753-ade2-ac883cafdcd1"],

Cell["Armed with that information, we can construct the panels.", "Text",
 CellChangeTimes->{{3.922549327092141*^9, 
  3.922549335629406*^9}},ExpressionUUID->"62dfcdd6-88c0-4f75-bc65-\
a8251a53914c"]
}, Closed]],

Cell[CellGroupData[{

Cell["More notes", "Subsubsection",
 CellChangeTimes->{{3.911998557658442*^9, 3.911998558682633*^9}, {
  3.922628900737249*^9, 
  3.922628901594301*^9}},ExpressionUUID->"694f7a6e-77fc-4fc0-b1be-\
1f608266cc16"],

Cell["\<\
In the past, we have treated quad panels as rigid polygons in fabrication and \
relied on their slight bendability and/or play in the hinges joining them \
(like membrane hinges) to deal with the fact that an ideal flasher is not, in \
fact, rigidly foldable. However, some experiments have determined that when \
we are 3D-printing panels from rigid materials with living hinges that give \
\[OpenCurlyDoubleQuote]close to kinematic\[CloseCurlyDoubleQuote] behavior, \
some flexing of the panels over the course of motion is absolutely required.\
\>", "Text",
 CellChangeTimes->{{3.9225493415956087`*^9, 
  3.922549502522781*^9}},ExpressionUUID->"c4cf3e34-68a8-46fa-9241-\
925ffc3741b7"],

Cell["\<\
Thus, we make it possible to split the quad panels along their diagonals and \
add hinges between them to allow panels to bend. We know that flashers are \
not rigidly foldable if the panels are un-split, so with thick rigid panels, \
we will need to add additional hinges across quads in order to make them \
truly rigidly foldable.\
\>", "Text",
 CellChangeTimes->{{3.911998704603318*^9, 3.911998773327766*^9}, {
  3.911998811489783*^9, 3.911998823926351*^9}, {3.913553760684147*^9, 
  3.913553816467711*^9}, {3.917198835856852*^9, 3.917198845153091*^9}, {
  3.922549508747677*^9, 
  3.9225495099883003`*^9}},ExpressionUUID->"fb8af8a6-1ecf-492a-811e-\
606ddd9ac02c"],

Cell["\<\
Note that we can split quads in two possible directions. Use the \
FlasherSectorDiagFoldLines option in MakeThickFlasher to choose the direction \
that quads get split in that function. The possible values are (see \
MakeThickFlasher for more details):
\tFlasherSectorDiagFoldLinesY \[LongDash] the usual direction, splits \
trapezoids across their short direction.
\tFlasherSectorDiagFoldLinesZ \[LongDash] split all trapezoids in the \
opposite direction.
\tFlasherSectorDiagFoldLinesX \[LongDash] split trapezoids in a combination \
of the two (making X\[CloseCurlyQuote]s of the split folds).\
\>", "Text",
 CellChangeTimes->{{3.917198864521079*^9, 3.917198911425366*^9}, {
  3.922628908793955*^9, 
  3.9226290490404053`*^9}},ExpressionUUID->"faf0d560-e809-4076-9682-\
7fb1680549b3"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherPanelCrossQuadBevel[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 ", \[Alpha]]"
}], "Subsubsection",
 CellChangeTimes->{{3.917198217497801*^9, 3.91719822955424*^9}, 
   3.917282070893591*^9},ExpressionUUID->"37a989bb-2339-4a59-b020-\
212518aea43f"],

Cell[TextData[{
 "FlasherPanelCrossQuadBevel[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 ", \[Alpha]]  computes a new position for point ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " shifted along line {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "} so that the normal vector of triangle {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "} is rotated by an angle \[Alpha] from its initial position, reducing the \
length of edge {",
 StyleBox["p1, p4",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.91719726636398*^9, 3.917197395626622*^9}, {
  3.9172820638556557`*^9, 
  3.917282119831356*^9}},ExpressionUUID->"99ed542f-a724-4d60-9f95-\
c6349739686a"],

Cell["\<\
This is used to create a bendable diagonal for flasher quads formed from two \
triangle facets by beveling the facets along the line at which they are \
joined.\
\>", "Text",
 CellChangeTimes->{{3.917198248802232*^9, 3.917198271050815*^9}, {
  3.917198661156493*^9, 3.91719867289253*^9}, {3.917282130800419*^9, 
  3.917282131743737*^9}},ExpressionUUID->"0ebdef40-e218-4789-9784-\
53008c376367"],

Cell[TextData[{
 "Note that since we don\[CloseCurlyQuote]t know the handedness of the \
arrangement of points, we can\[CloseCurlyQuote]t use signed rotation angle; \
instead, we useAbs[",
 StyleBox["t",
  FontSlant->"Italic"],
 "] to ensure that the point is always shifted toward ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.917198675172772*^9, 3.917198760006306*^9}, {
  3.917281691759972*^9, 
  3.917281693979649*^9}},ExpressionUUID->"9d79c1c9-453e-4b59-875f-\
f7286979eda8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherPanelCrossQuadBevel", "[", 
   RowBox[{"p1_", ",", "p2_", ",", "p3_", ",", "p4_", ",", "\[Alpha]_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", "p5", ",", "n1", ",", "n2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p5", "=", 
      RowBox[{"p1", "+", 
       RowBox[{
        RowBox[{"Abs", "[", "t", "]"}], 
        RowBox[{"(", 
         RowBox[{"p4", "-", "p1"}], ")"}]}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"parameterized", " ", "new", " ", "point"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"n1", "=", 
      RowBox[{"TriangleNormal3D", "[", 
       RowBox[{"p1", ",", "p2", ",", "p3"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n2", "=", 
      RowBox[{"TriangleNormal3D", "[", 
       RowBox[{"p5", ",", "p2", ",", "p3"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p5", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"n1", ".", "n2"}], "==", 
         RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "1"}], "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 CellChangeTimes->{{3.917197244389065*^9, 3.917197288674355*^9}, {
   3.917197539114246*^9, 3.91719764884138*^9}, {3.917198284709657*^9, 
   3.917198345670728*^9}, {3.917198448635248*^9, 3.9171985318586817`*^9}, {
   3.917281700862795*^9, 3.91728170193297*^9}, 3.917282063862872*^9},
 CellLabel->
  "In[4512]:=",ExpressionUUID->"263bd918-d435-41a9-bd27-7759aaf4bef2"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.917197908586643*^9, 
  3.917197910041441*^9}},ExpressionUUID->"a71f1f07-38f5-4174-a846-\
e3db6c354c02"],

Cell[BoxData[
 RowBox[{"FlasherPanelCrossQuadBevel", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", ".3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"30", "\[Degree]"}]}], "]"}]], "Input",
