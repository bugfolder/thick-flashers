Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FoldLinearChain", "::", "badtypes"}], 
   "=", "\"\<Unassigned types `1` encountered along spine of linear \
chain.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.617397555218279*^9, 3.617397589186687*^9}},
 CellLabel->
  "In[2420]:=",ExpressionUUID->"6f7b82ea-c293-4631-9046-31a7a7a175a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldLinearChain", "[", 
   RowBox[{"tobj_TObj", ",", "\[Gamma]_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "rz", ",", "aa", ",", "types", ",", "foldangles", ",", 
      "\[Gamma]\[Gamma]", ",", "gg", ",", "tobj1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TLinearChain"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rz", "=", 
      RowBox[{
       RowBox[{"RotateToZ", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldLinearChain", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"aa", ",", "types"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"VerticesSectorAngles", ",", "EdgeTypes"}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "types", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "foldangles", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "=", 
      RowBox[{"\[Gamma]\[Gamma]", "=", "\[Gamma]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<types across vertex = \>\"", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"types", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{"5", "i"}], "-", "6"}], "\[RightDoubleBracket]"}], ",", 
            
            RowBox[{"types", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{"5", "i"}], "-", "1"}], "\[RightDoubleBracket]"}]}], 
           "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<sector angles/\[Degree] = \>\"", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
            "aa", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "/",
             "\[Degree]"}], "//", "N"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"TypeFoldedQ", "[", 
              RowBox[{"types", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"5", "i"}], "-", "6"}], "\[RightDoubleBracket]"}], 
              "]"}], "&&", 
             RowBox[{"TypeFoldedQ", "[", 
              RowBox[{"types", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"5", "i"}], "-", "1"}], "\[RightDoubleBracket]"}], 
              "]"}]}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"FoldLinearChain", "::", "badtypes"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"types", "\[LeftDoubleBracket]", 
                RowBox[{
                 RowBox[{"5", "i"}], "-", "6"}], "\[RightDoubleBracket]"}], ",", 
               RowBox[{"types", "\[LeftDoubleBracket]", 
                RowBox[{
                 RowBox[{"5", "i"}], "-", "1"}], "\[RightDoubleBracket]"}]}], 
              "}"}]}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"types", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{"5", "i"}], "-", "6"}], "\[RightDoubleBracket]"}], "===", 
           RowBox[{"types", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{"5", "i"}], "-", "1"}], "\[RightDoubleBracket]"}]}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"same", " ", "type"}], ",", " ", 
            RowBox[{"so", " ", "major"}]}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"gg", "=", 
           RowBox[{"RotateRight", "[", 
            RowBox[{
             RowBox[{"MakeDihedralsFromSectorsAndMajorDihedral", "[", 
              RowBox[{
               RowBox[{"RotateLeft", "[", 
                RowBox[{
                 RowBox[{
                 "aa", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
                  ",", "2"}], "]"}], ",", "\[Gamma]\[Gamma]"}], "]"}], ",", 
             "2"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"opposite", " ", "type"}], ",", " ", 
            RowBox[{"so", " ", "minor"}]}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"gg", "=", 
           RowBox[{"RotateRight", "[", 
            RowBox[{
             RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "[", 
              RowBox[{
               RowBox[{"RotateLeft", "[", 
                RowBox[{
                 RowBox[{
                 "aa", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
                  ",", "2"}], "]"}], ",", "\[Gamma]\[Gamma]"}], "]"}], ",", 
             "2"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<dihedral angles at vertex = \>\"", ",", 
            RowBox[{
             RowBox[{"gg", "/", "\[Degree]"}], "//", "N"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]\[Gamma]", "=", 
         RowBox[{
          RowBox[{"foldangles", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{"5", "i"}], "-", "1"}], "\[RightDoubleBracket]"}], "=", 
          RowBox[{
          "gg", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"foldangles", "\[LeftDoubleBracket]", 
          RowBox[{
           RowBox[{"5", "i"}], "-", "3"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{
         "gg", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"foldangles", "\[LeftDoubleBracket]", 
          RowBox[{
           RowBox[{"5", "i"}], "-", "4"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{
         "gg", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
        ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{
          RowBox[{"Length", "[", "aa", "]"}], "-", "1"}]}], "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj", ",", "foldangles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj1", "//", 
       RowBox[{"ReplaceProperty", "[", 
        RowBox[{"EdgeTypes", "\[Rule]", 
         RowBox[{"FoldAngleToType", "[", "foldangles", "]"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"rz", ",", "\[IndentingNewLine]", 
       RowBox[{"tobj1", "//", 
        RowBox[{"ReplaceProperty", "[", 
         RowBox[{"Vertices3D", "\[Rule]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"RotationMatrix3Du", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "\[Gamma]"}], "/", "2"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}], ".", 
              "#"}], "&"}], "/@", 
            RowBox[{"tobj1", "[", "Vertices3D", "]"}]}], ")"}]}], "]"}]}], ",",
        "\[IndentingNewLine]", "tobj1"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.617386798990254*^9, 3.617386825766955*^9}, {
   3.617386946990991*^9, 3.617386953593677*^9}, {3.617387176990403*^9, 
   3.617387178767668*^9}, {3.617387269774276*^9, 3.617387270029206*^9}, {
   3.617387752871139*^9, 3.61738778290098*^9}, {3.617387816532359*^9, 
