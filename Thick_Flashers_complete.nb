Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "spp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{".5", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["#1", "2"], "+", 
              SuperscriptBox["#2", "2"]}], ")"}]}], ")"}]}]}], "}"}], "&"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"spp", "=", 
      RowBox[{"StyledPatch", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"OutlineStyle", "\[Rule]", "FoldedLine"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PatchDivisions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"5", ",", "5"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"spp", "//", "AddShadow"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Lighting", "\[Rule]", 
