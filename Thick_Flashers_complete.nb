           "]"}], "\[Equal]", "4"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"kawaconds", ",", 
           RowBox[{"FlatFoldabilityCondition", "[", 
            RowBox[{
             RowBox[{
             "newverts", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}], ",", 
             RowBox[{"newverts", "\[LeftDoubleBracket]", 
              RowBox[{
              "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}]}], "]"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "vva", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Kawasaki conditions (unoptimized) = \>\"", ",", 
         RowBox[{"kawaconds", "/.", "hdruleff"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "optimization", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"merit", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"(", 
          SuperscriptBox[
           RowBox[{"d", "[", "i", "]"}], "2"], ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nd"}], "}"}]}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"(", 
          SuperscriptBox[
           RowBox[{"dd", "[", "i", "]"}], "2"], ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "ndd"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "kawaconds"}], "/.", 
       RowBox[{"h", "\[Rule]", "inset"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ineqns", "=", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d", "[", "i", "]"}], "\[GreaterEqual]", 
            RowBox[{"mps", " ", "h"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "nd"}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dd", "[", "i", "]"}], "\[GreaterEqual]", 
            RowBox[{"mbps", " ", "h"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "ndd"}], "}"}]}], "]"}]}], "]"}], "/.", 
       RowBox[{"h", "\[Rule]", "inset"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"d", "[", "i", "]"}], ",", 
             RowBox[{"mps", " ", "h"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "nd"}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"dd", "[", "i", "]"}], ",", 
             RowBox[{"mbps", " ", "h"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "ndd"}], "}"}]}], "]"}]}], "]"}], "/.", 
       RowBox[{"h", "\[Rule]", "inset"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "soln"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"merit", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"eqns", ",", "ineqns"}], "]"}]}], "}"}], ",", "vars"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Optimization took \>\"", ",", "time", 
         ",", "\"\< seconds.\>\""}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "FindMinimum"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"MakeSimpleWovenTessellationOld", "::", "optfail"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"PrintThis", "[", "soln", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kawavals", "=", 
      RowBox[{
       RowBox[{"kawaconds", "/.", 
        RowBox[{"h", "\[Rule]", "inset"}]}], "/.", 
       RowBox[{
       "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Kawasaki conditions (optimized) = \>\"", ",", 
         RowBox[{"Chop", "[", "kawavals", "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"If", " ", "mismatch"}], ",", " ", 
       RowBox[{
        RowBox[{"don", "'"}], "t", " ", "abort"}], ",", " ", 
       RowBox[{"but", " ", "report", " ", "the", " ", "mismatch"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "/@", "kawavals"}], "]"}], ">", 
        SuperscriptBox["10", 
         RowBox[{"-", "4"}]]}], ",", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"MakeSimpleWovenTessellationOld", "::", "nokawa"}], ",", 
         "kawavals"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newvertsff", "=", 
      RowBox[{
       RowBox[{"newverts", "/.", 
        RowBox[{"h", "\[Rule]", "inset"}]}], "/.", 
       RowBox[{
       "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "proper", " ", "embedding", " ", "based", " ", "on", " ", 
       "the", " ", "solution"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjout", "=", 
      RowBox[{"tobjout", "//", 
       RowBox[{"ReplaceProperty", "[", 
        RowBox[{"Vertices2D", "\[Rule]", "newvertsff"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjout", "=", 
      RowBox[{"UnfoldGraph2D", "[", 
       RowBox[{"tobjout", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "sface"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<topological crease pattern and folded form (optimized)\>\"",
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"GraphGraphics", "[", "tobjout", "]"}], ",", 
            RowBox[{"Graph2DGraphics", "[", "tobjout", "]"}]}], "}"}], "]"}], 
         "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"CreasePatternGraphics", "[", "tobjout", "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"GenericFoldedFormGraphics", "[", "tobjout", "]"}]}], 
           "\[IndentingNewLine]", "}"}], "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "tobjout"}]}], "]"}]}]], "Input",
