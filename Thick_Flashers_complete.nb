Cell[CellGroupData[{

Cell[TextData[{
 "NMatchCurveSpeed[",
 StyleBox["c1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{u0, u1}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[NDSolve], Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{{3.6915802284484468`*^9, 3.691580238645296*^9}, 
   3.691580338242102*^9, {3.691581337583536*^9, 3.691581338736824*^9}, {
   3.691592107075506*^9, 3.69159212689917*^9}, {3.6916016863816833`*^9, 
   3.691601690932227*^9}, {3.6916049725147667`*^9, 3.691604972883399*^9}, {
   3.799523049962212*^9, 3.7995230519344482`*^9}, 3.80021007381279*^9, {
   3.800210167003771*^9, 3.800210171762924*^9}, {3.800210485133381*^9, 
   3.800210487029398*^9}, 3.800210564367228*^9, 
   3.800211638752042*^9},ExpressionUUID->"e1bb213d-bac8-4307-934e-\
c4699b204053"],

Cell[TextData[{
 "NMatchCurveSpeed[",
 StyleBox["c1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["c2",
  FontSlant->"Italic"],
 ", ui, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes two curves and numerically reparameterizes the second one over an \
interval so that it has the same curve speed as the first and the old and new \
reparameterized curves match at a specified point."
}], "Text",
 CellChangeTimes->{{3.691580240584978*^9, 3.6915802790773783`*^9}, {
   3.691580451784436*^9, 3.691580452377629*^9}, {3.6915813455875597`*^9, 
   3.691581350650943*^9}, {3.691581429459126*^9, 3.69158143739536*^9}, {
   3.691592118830287*^9, 3.691592162934783*^9}, 3.800210073822134*^9, {
   3.800210494685166*^9, 3.800210507197673*^9}, 3.8002105643769712`*^9, 
   3.800211638763793*^9},ExpressionUUID->"bedc9539-6a00-4bb5-b40d-\
d223d3929bab"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c1",
  FontSlant->"Italic"],
 " \[LongDash] the first curve as a vector-valued pure function, could be 2D \
or 3D.\n\t",
 StyleBox["c2",
  FontSlant->"Italic"],
 " \[LongDash] the second curve as a vector-valued pure function, could be 2D \
or 3D.\n\tui \[LongDash] the parameter at which the old and new curves should \
match.\n\t",
 StyleBox["{u0, u1}",
  FontSlant->"Italic"],
 " \[LongDash] the interval of reparameterization."
}], "Text",
 CellChangeTimes->{{3.691580289272049*^9, 3.69158032759784*^9}, {
   3.6915813570112767`*^9, 3.691581366544193*^9}, {3.691581441891892*^9, 
   3.691581445413598*^9}, {3.691592166363264*^9, 3.691592186968381*^9}, {
   3.799523055201556*^9, 3.799523061489961*^9}, 3.800210523502262*^9, 
   3.800210564386303*^9},ExpressionUUID->"45d5ae81-cf99-4e6d-a143-\
13fbf92ec6e1"],

Cell["\<\
Options:
\tOptions[FunctionInterpolation] are passed through.\
\>", "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, 
   3.691592861002241*^9},ExpressionUUID->"8fb88837-5e70-445b-95ea-\
57d5ba048421"],

Cell["\<\
Returns: the reparameterized second curve as a vector-valued pure function \
whose components are InterpolationFunctions.\
\>", "Text",
 CellChangeTimes->{{3.691580464686341*^9, 3.6915804751913853`*^9}, {
  3.691592205416861*^9, 3.691592209809816*^9}, {3.691592864367875*^9, 
  3.691592890698355*^9}},ExpressionUUID->"b0a2b23a-374f-48a0-a42b-\
d48b354631e2"],

Cell["\<\
Note that the second curve will have a different u1 for its domain. If the \
first curve is shorter than the second, then the domain of the second will be \
truncated so that the two curves map one-to-one over their respective domains.\
\>", "Text",
 CellChangeTimes->{{3.691592211587811*^9, 3.6915922241213293`*^9}, {
   3.691600684532049*^9, 3.691600697385045*^9}, {3.691600728424299*^9, 
   3.691600779206899*^9}, 
   3.799523107384844*^9},ExpressionUUID->"c01e50c3-26bc-44c2-87e6-\
01b68a045d24"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NMatchCurveSpeed", "::", "nosoln"}], 
   "=", "\"\<NDSolve couldn's solve for the reparameterization.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691590034772623*^9, 3.691590064838083*^9}, 
   3.800209302355802*^9, {3.8002096275363693`*^9, 3.800209640862933*^9}, {
   3.800210403470829*^9, 3.800210405637693*^9}, 3.800210576094316*^9, 
   3.800211638770805*^9},
 CellLabel->
  "In[3729]:=",ExpressionUUID->"e7bb0f40-707d-450e-8f09-143c8bee600e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NMatchCurveSpeed", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.800212174090212*^9, 3.800212181210331*^9}},
 CellLabel->
  "In[3730]:=",ExpressionUUID->"9b02a979-310f-49d8-8597-9aba98035ea4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NMatchCurveSpeed", "[", 
   RowBox[{
    RowBox[{"c1_Function", "|", "c1_InterpolatingFunction"}], ",", 
    RowBox[{"c2_Function", "|", "c2_InterpolatingFunction"}], ",", "ui_", ",",
     " ", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "s", ",", "dc1", ",", "dc2", ",", "f", ",", "soln"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dc1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c1", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dc2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"c2", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"f", "'"}], "[", "s", "]"}], 
            SqrtBox[
             RowBox[{
              RowBox[{"dc2", "[", 
               RowBox[{"f", "[", "s", "]"}], "]"}], ".", 
              RowBox[{"dc2", "[", 
               RowBox[{"f", "[", "s", "]"}], "]"}]}]]}], "\[Equal]", 
           SqrtBox[
            RowBox[{
             RowBox[{"dc1", "[", "s", "]"}], ".", 
             RowBox[{"dc1", "[", "s", "]"}]}]]}], ",", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"f", "[", "ui", "]"}], "\[Equal]", "ui"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"f", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "NDSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"NMatchCurveSpeed", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Flatten", "[", "soln", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"f", "[", "s", "]"}], "/.", "soln"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FunctionInterpolationAlt", "[", 
      RowBox[{
       RowBox[{"c2", "[", 
        RowBox[{"f", "[", "s", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.691580180808895*^9, 3.69158022627394*^9}, {
   3.691580371475801*^9, 3.691580403355137*^9}, {3.691580443846138*^9, 
