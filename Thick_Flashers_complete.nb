Cell[CellGroupData[{

Cell[TextData[{
 "MakeSemigeneralizedMiuraOriP[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw",
  FontSlant->"Italic"],
 ", {\[Gamma]0, \[Gamma]}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nMakeSemigeneralizedMiuraOriP[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nw",
  FontSlant->"Italic"],
 ", \[Gamma], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FirstBendAngle, LastBendAngle"
}], "Subsubsection",
 CellChangeTimes->{
  3.642624398398085*^9, {3.642624621969589*^9, 3.642624622352464*^9}, 
   3.642684776997446*^9, {3.642684815880765*^9, 3.642684818031864*^9}, {
   3.642690584837919*^9, 3.642690607191401*^9}, {3.642693580072123*^9, 
   3.642693590285447*^9}, {3.643051411392362*^9, 3.643051419038278*^9}, {
   3.643063519888253*^9, 3.643063523871331*^9}, {3.643064720222528*^9, 
   3.643064725150871*^9}, {3.643064769530637*^9, 3.643064770161393*^9}, 
   3.64328935922649*^9, {3.643292674271878*^9, 3.643292686205771*^9}, {
   3.643292743921904*^9, 3.643292766121381*^9}, 3.643292882027485*^9, {
   3.64329291438507*^9, 
   3.643292915467225*^9}},ExpressionUUID->"e05b82a1-504c-469e-b028-\
db40181c34d9"],

Cell[TextData[{
 "MakeSemigeneralizedMiuraOriP[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", nw, {\[Gamma]0, \[Gamma]}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a TGraph3D+TAssigned that represents a semi-generalized Miura-ori \
(periodic in only one direction) from a description of the desired path, \
where\n\t",
 StyleBox["pts",
  FontSlant->"Italic"],
 " is a list of points in the x-y plane that describes the path we want the \
surface to follow.\n\t",
 StyleBox["dlist",
  FontSlant->"Italic"],
 " are the distances between vertices; note that Length[",
 StyleBox["alist",
  FontSlant->"Italic"],
 "]=1+Length[",
 StyleBox["dlist",
  FontSlant->"Italic"],
 "].\n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of each half-strip.\n\t",
 StyleBox["nw",
  FontSlant->"Italic"],
 " is the number of pair repetitions across the width.\n\t\[Gamma]0 is the \
minor fold angle for which it was designed to follow path ",
 StyleBox["pts",
  FontSlant->"Italic"],
 ".\n\t\[Gamma] is the initial minor fold angle at the bottom left, which may \
be different from \[Gamma]0. All horizontal fold angles in the crease pattern \
are \[PlusMinus]\[Gamma].\nOptions are:\n\tFirstBendAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "0"], TraditionalForm]],ExpressionUUID->
  "ba635d72-136b-4547-ab08-8c61e1c47ccf"],
 " specifies the bend angle that would apply to the first vertex (which \
determines the first sector angle).\n\tLastBendAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "N"], TraditionalForm]],ExpressionUUID->
  "ccf43a74-8726-49e3-86d9-9886850508e1"],
 " specifies the bend angle that would apply to the last vertex (which \
determines the last sector angle).\n\tOptions[FoldGraph3D] are passed through \
to FoldGraph."
}], "Text",
 CellChangeTimes->{{3.642623914001541*^9, 3.642624007455812*^9}, {
   3.642624048971643*^9, 3.64262432762982*^9}, {3.6426246264166813`*^9, 
   3.642624629528961*^9}, 3.642684777155979*^9, {3.6426848223065586`*^9, 
   3.642684893222384*^9}, {3.642685178061172*^9, 3.642685178181444*^9}, {
   3.642690597202779*^9, 3.642690635910203*^9}, {3.642690677828701*^9, 
   3.642690681549116*^9}, {3.643048411294441*^9, 3.643048413540251*^9}, {
   3.6430514220062*^9, 3.64305148773949*^9}, {3.643054760672797*^9, 
   3.643054800251668*^9}, {3.6430634907072678`*^9, 3.643063543359404*^9}, {
   3.643064727732459*^9, 3.643064825894874*^9}, {3.643289359961053*^9, 
   3.643289361018255*^9}, {3.64328944194849*^9, 3.643289446690666*^9}, {
   3.643292700776296*^9, 3.64329271658018*^9}, {3.643292751435459*^9, 
   3.643292804886804*^9}, {3.643292923112591*^9, 
   3.643293028161816*^9}},ExpressionUUID->"ddf6ac05-1733-4b8d-a551-\
7e624587d2e2"],

Cell["\<\
Returns: a TGraph3D+TAssigned that describes the crease pattern and folded \
form.\
\>", "Text",
 CellChangeTimes->{{3.9227293242980347`*^9, 
  3.922729342938485*^9}},ExpressionUUID->"2de5dfb6-4887-415e-87f6-\
90bd5328a473"],

Cell[TextData[{
 "Note that ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " specifies the path that the ",
 StyleBox["middle",
  FontSlant->"Italic"],
 " of each row follows, not any of the horizontal crease lines."
}], "Text",
 CellChangeTimes->{{3.922731192875251*^9, 
  3.922731263038412*^9}},ExpressionUUID->"a7e703f9-bbc9-4c45-a9b7-\
93a26a5ce054"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FirstBendAngle", "::", "usage"}], 
   "=", "\"\<FirstBendAngle is an option to MakeSemigeneralizedMiuraOriP that \
specifies the bend angle that would apply to the first vertex of the \
path.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.643063547537413*^9, 3.643063575293401*^9}},
 CellLabel->
  "In[2550]:=",ExpressionUUID->"aabf6bc9-7779-4ef7-b617-823e1a11522f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LastBendAngle", "::", "usage"}], 
   "=", "\"\<LastBendAngle is an option to MakeSemigeneralizedMiuraOriP that \
specifies the bend angle that would apply to the last vertex of the \
path.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.643063547537413*^9, 3.643063591709308*^9}},
 CellLabel->
  "In[2551]:=",ExpressionUUID->"2bb40e2f-1250-496b-b9eb-4bd57c80671b"],

Cell["\<\
Note that you can design for a numerical value of the minor fold angle (\
\[Gamma]0) but then feed in a variable for \[Gamma] to realize a \
parametrically foldable pattern.\
\>", "Text",
 CellChangeTimes->{{3.643064912232816*^9, 3.643064946206551*^9}, {
  3.922731718352077*^9, 
  3.922731720847769*^9}},ExpressionUUID->"497db20f-b162-4e07-b9cf-\
7288109b1913"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeSemigeneralizedMiuraOriP", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"FirstBendAngle", "\[Rule]", 
      RowBox[{"180", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"LastBendAngle", "\[Rule]", 
      RowBox[{"180", "\[Degree]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.643063592907995*^9, 3.643063625510573*^9}, {
  3.643064837494901*^9, 3.643064842911145*^9}, {3.6432930398072443`*^9, 
  3.643293040450506*^9}},
 CellLabel->
  "In[2552]:=",ExpressionUUID->"ddbf65c4-84b4-4137-a356-870fc68a0673"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSemigeneralizedMiuraOriP", "[", 
   RowBox[{"pts_List", ",", "w_", ",", "nw_", ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]0_", ",", "\[Gamma]_"}], "}"}], ",", "opts___"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fb", ",", "lb", ",", "gd", ",", "blist", ",", "dlist", ",", "gm", ",", 
      "alist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fb", "=", 
      RowBox[{
       RowBox[{"FirstBendAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSemigeneralizedMiuraOriP", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"lb", "=", 
      RowBox[{
       RowBox[{"LastBendAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSemigeneralizedMiuraOriP", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dlist", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mag", "[", 
            RowBox[{"#2", "-", "#1"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"pts", ",", 
            RowBox[{"RotateLeft", "[", "pts", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"blist", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RotationAngle", "[", 
            RowBox[{
             RowBox[{"#2", "-", "#1"}], ",", 
             RowBox[{"#3", "-", "#2"}]}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"pts", ",", 
            RowBox[{"RotateLeft", "[", "pts", "]"}], ",", 
            RowBox[{"RotateLeft", "[", 
             RowBox[{"pts", ",", "2"}], "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"-", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"blist", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "fb", "}"}], ",", "blist", ",", 
        RowBox[{"{", "lb", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"alist", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"gm", "=", 
          RowBox[{"\[Gamma]0", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "i"]}]}], ";", 
         RowBox[{"(*", " ", 
          RowBox[{
          "fold", " ", "angle", " ", "incident", " ", "on", " ", "the", " ", 
           "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "blist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "\[Equal]", "\[Pi]"}], "||", 
            RowBox[{
             RowBox[{
             "blist", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "\[Equal]", 
             RowBox[{"-", "\[Pi]"}]}]}], ",", 
           RowBox[{"\[Pi]", "/", "2"}], ",", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"ArcTan", "[", 
              RowBox[{
               RowBox[{"Csc", "[", 
                RowBox[{"gm", "/", "2"}], "]"}], 
               RowBox[{"Tan", "[", 
                RowBox[{
                 RowBox[{
                 "blist", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}], "/", "2"}], "]"}]}], "]"}], ",", 
             "\[Pi]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "blist", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dlist", "=", 
      RowBox[{"dlist", "-", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["w", "2"], ")"}], 
        RowBox[{"(", 
         RowBox[{"Cot", "/@", 
          RowBox[{"Drop", "[", 
           RowBox[{"alist", ",", "1"}], "]"}]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["w", "2"], ")"}], 
        RowBox[{"(", 
         RowBox[{"Cot", "/@", 
          RowBox[{"Drop", "[", 
           RowBox[{"alist", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeSemigeneralizedMiuraOriA", "[", 
      RowBox[{
      "alist", ",", "dlist", ",", "w", ",", "nw", ",", "\[Gamma]", ",", 
       "opts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.642690661206272*^9, 3.642690666816263*^9}, {
