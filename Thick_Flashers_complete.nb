Cell[CellGroupData[{

Cell[TextData[{
 "FilterSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["eflist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fslist",
  FontSlant->"Italic"],
 "]\n\t(checked class) TSplitGraph2D"
}], "Subsubsection",
 CellChangeTimes->{{3.706730224750823*^9, 3.706730240541627*^9}, {
   3.706781041461916*^9, 3.706781050892582*^9}, {3.7067814240321207`*^9, 
   3.706781426591407*^9}, 3.7067816575937977`*^9, {3.706782437328784*^9, 
   3.7067824383288507`*^9}, 3.706787872916282*^9, {3.706793261476581*^9, 
   3.706793288797716*^9}, {3.706795723115965*^9, 
   3.706795724817908*^9}},ExpressionUUID->"161af4cd-3b2d-493c-8b1d-\
4e14eee3ed5b"],

Cell[TextData[{
 "FilterSplitGraph2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["eflist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fslist",
  FontSlant->"Italic"],
 "] takes a TSplitGraph2D and returns a new version that contains a subset of \
the splitting information specified by the desired folded edges and split \
faces."
}], "Text",
 CellChangeTimes->{{3.706730242435814*^9, 3.706730291767683*^9}, {
   3.706730348843758*^9, 3.706730351498174*^9}, 3.706780523915817*^9, 
   3.7067806890741987`*^9, {3.706781057238808*^9, 3.706781061693098*^9}, {
   3.706781414615728*^9, 3.706781418087703*^9}, {3.706781662170133*^9, 
   3.70678167238582*^9}, {3.706782444338118*^9, 3.706782452192725*^9}, 
   3.7067916121524897`*^9, {3.706793295486108*^9, 3.706793298115731*^9}, {
   3.706793343812038*^9, 3.7067933516757183`*^9}, {3.706793627287907*^9, 
   3.7067936534546003`*^9}},ExpressionUUID->"2a3a6b86-0c6e-4cce-8d19-\
895ad39925b7"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TSplitGraph2D to be modified.\n\t",
 StyleBox["eflist",
  FontSlant->"Italic"],
 " \[LongDash] a list of the desired folded edges, given as indices\n\t",
 StyleBox["fslist",
  FontSlant->"Italic"],
 " \[LongDash] a list of the desired split faces, given as indices"
}], "Text",
 CellChangeTimes->{{3.706781527360121*^9, 3.706781651753489*^9}, {
   3.706781685419363*^9, 3.706781715458632*^9}, 3.706791612180233*^9, {
   3.706793310076036*^9, 3.706793336947751*^9}, {3.706793660022963*^9, 
   3.706793671463104*^9}},ExpressionUUID->"01dee4fb-ae08-4f48-9c94-\
845a2c58a368"],

Cell["\<\
Returns a new TSplitGraph2D with modified SplitInfo property.\
\>", "Text",
 CellChangeTimes->{{3.706781722178275*^9, 3.706781742458529*^9}, {
  3.706781862580755*^9, 3.706781863627233*^9}, {3.7067936788640018`*^9, 
  3.706793697807123*^9}},ExpressionUUID->"def13551-c148-487b-919b-\
2daccaf88154"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FilterSplitGraph2D", "[", 
   RowBox[{"tobj_TObj", ",", "eflist_List", ",", "fslist_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "edges", ",", "sinfo", ",", "vfinfo", ",", "efinfo", ",", "esinfo", ",", 
      "fsinfo", ",", "vfinfo1", ",", "efinfo1", ",", "esinfo1", ",", 
      "fsinfo1", ",", "vfe", ",", "vsf", ",", "esf"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph2D", ",", "TPlaneGraph"}], "}"}], ",", 
       "FilterSplitGraph2D"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "sinfo"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "SplitInfo"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo"}], "}"}],
       "=", "sinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"efinfo1", "=", "eflist"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fsinfo1", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"fsinfo", ",", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"fslist", ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "vertices", " ", "that", " ", "are", " ", "part", " ", "of", " ", 
       "folded", " ", "edges"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vfe", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
        "edges", "\[LeftDoubleBracket]", "efinfo1", "\[RightDoubleBracket]"}],
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "vertices", " ", "that", " ", "are", " ", "hit", " ", "by", " ", 
        "face"}], "-", 
       RowBox[{"splitting", " ", "folds"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"vsf", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           "&"}], "/@", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Drop", "[", 
                RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "fsinfo1"}], ",",
              "1"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]",
              "0"}], "&"}]}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vfinfo1", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Join", "[", 
        RowBox[{"vfe", ",", "vsf"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "edges", " ", "that", " ", "are", " ", "hit", " ", "by", " ", "face"}],
        "-", 
       RowBox[{"splitting", " ", "folds"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"esf", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           "&"}], "/@", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Drop", "[", 
                RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "fsinfo1"}], ",",
              "1"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]",
              "1"}], "&"}]}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"esinfo1", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"esinfo", ",", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"esf", ",", 
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"SplitInfo", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"vfinfo1", ",", "efinfo1", ",", "esinfo1", ",", "fsinfo1"}], 
         "}"}]}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.706781876277767*^9, 3.706781906387738*^9}, {
   3.706782282600513*^9, 3.706782398048249*^9}, {3.706787766874095*^9, 
   3.706788122780637*^9}, 3.70679018288701*^9, {3.706793288811707*^9, 
   3.706793288822097*^9}, {3.7067940032356586`*^9, 3.706794107147139*^9}, {
   3.706794185316463*^9, 3.7067941855237703`*^9}, {3.706794231244355*^9, 
   3.70679423458114*^9}, {3.706794272109726*^9, 3.706794272556892*^9}, {
   3.706794321909768*^9, 3.706794401142248*^9}, {3.706794480022606*^9, 
   3.706794720865726*^9}, {3.706794768649575*^9, 3.706794919429236*^9}, {
   3.706794954823337*^9, 3.70679499618255*^9}, {3.706795056628573*^9, 
   3.7067952145834913`*^9}, 3.706795448337205*^9, 3.706795488370394*^9, {
   3.706795541865937*^9, 3.70679555721732*^9}},
 CellLabel->
  "In[1383]:=",ExpressionUUID->"f4f1dd6e-81d2-4841-997b-335b2f3bd7cb"],

Cell["\<\
Example. Create a TSplitGraph2D, then filter the SplitInfo to a subset of the \
folded edges and split faces.\
\>", "Text",
 CellChangeTimes->{{3.706732766226624*^9, 3.7067327669841437`*^9}, 
   3.706781034188162*^9, {3.706793211578088*^9, 3.706793235242882*^9}, {
   3.706793725081077*^9, 3.706793731375533*^9}, {3.70679552963971*^9, 
   3.70679556405581*^9}, {3.706821084733737*^9, 
   3.70682111450801*^9}},ExpressionUUID->"3a24510a-8700-40f2-902f-\
e65169f5513e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "f1", ",", "f2", ",", "sinfo"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"SingleVertexGraph2D", "//", "RebuildPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f1", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", ".1"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.3"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"f1", ",", 
          RowBox[{"f2", "-", "f1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<all split information\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SplitGraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SplitGraph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sinfo", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "SplitInfo"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sinfo", "//", "ColumnForm"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FilterSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<filtered split information\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SplitGraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SplitGraph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], "//",
       "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sinfo", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "SplitInfo"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sinfo", "//", "ColumnForm"}], "//", "Print"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.706791840799945*^9, 3.706791934239752*^9}, {
   3.706791968800919*^9, 3.706792019447933*^9}, {3.706792164694173*^9, 
   3.706792186977502*^9}, 3.7067931167240562`*^9, 3.706793610357353*^9, {
   3.706793759431761*^9, 3.706793816672655*^9}, 3.706794204757501*^9, 
   3.706794737652244*^9, 3.70679502215819*^9, 3.706795436343595*^9, 
   3.706795503803889*^9, 3.706795573698896*^9, {3.706820246160811*^9, 
   3.706820246175542*^9}, {3.706820771612535*^9, 3.706820796885977*^9}, {
   3.706820828923915*^9, 3.706820833282367*^9}, {3.706821126526094*^9, 
   3.706821158797246*^9}, 3.706823198205355*^9, 3.7084001777668257`*^9, 
   3.708603656665695*^9},
 CellLabel->
  "In[1384]:=",ExpressionUUID->"f231a6bd-810e-455f-aaea-22556d71a6c9"],

