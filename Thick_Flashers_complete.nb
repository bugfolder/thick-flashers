Cell[CellGroupData[{

Cell[TextData[{
 "HingeRoundedPlateGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HingeThickness, RoundingDivisions"
}], "Subsubsection",
 CellChangeTimes->{{3.9226956153333397`*^9, 
  3.922695641230845*^9}},ExpressionUUID->"3e06bc5d-fcbe-4476-9b73-\
ee676daa6758"],

Cell[TextData[{
 "HingeRoundedPlateGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a GraphicsComplex polyhedron that implements a plate hinge \
between two panels in a 3D-printed solid."
}], "Text",
 CellChangeTimes->{{3.922695650883709*^9, 
  3.922695690978923*^9}},ExpressionUUID->"a228367e-b822-4954-8840-\
2095b5d2a298"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} \[LongDash] the two panel polyhedron vertices on one side of the hinge.\n\
\t{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} \[LongDash] the corresponding two panel vertices on the other side of the \
hinge."
}], "Text",
 CellChangeTimes->{{3.9122517761975393`*^9, 
  3.91225182910169*^9}},ExpressionUUID->"87615202-b607-4e0e-b8f8-\
370350940090"],

Cell[TextData[{
 "Options:\n\tHingeThickness \[Rule] ",
 StyleBox["ht",
  FontSlant->"Italic"],
 ", the thickness of hinges between connected parts.\n\tRoundingDivisions \
\[Rule] ",
 StyleBox["rd",
  FontSlant->"Italic"],
 ", the number of divisions to use in rounding edges and corners. See \
MakePlanarRoundedPlateGCs.\n\tPlanarTolerance \[Rule] ",
 StyleBox["pt",
  FontSlant->"Italic"],
 ", the tolerance on planarity of the four points."
}], "Text",
 CellChangeTimes->{{3.912251839577525*^9, 3.912251855519747*^9}, {
  3.922695707853303*^9, 3.922695759511924*^9}, {3.922696181312693*^9, 
  3.9226962023499126`*^9}},ExpressionUUID->"4d5c12ff-4d3c-44e6-9951-\
989fc6243b0c"],

Cell["\<\
Returns: a list containing a set of GraphicsComplex objects that produce the \
hinge.\
\>", "Text",
 CellChangeTimes->{{3.9122518642937727`*^9, 3.912251989434338*^9}, {
  3.912574780610379*^9, 3.912574781812535*^9}, {3.922629881993277*^9, 
  3.9226298898721237`*^9}, {3.922695767837702*^9, 
  3.92269577625175*^9}},ExpressionUUID->"d3eb90f1-d3ff-460b-a7f5-\
c65676746e5c"],

Cell["\<\
The rounding has the effect of expanding the hinge into each polyhedra by an \
amount equal to half of the hinge thickness to ensure that there is overlap \
between the hinge and the faces of its two incident panels, as in \
HingePlateGC, but gives smoother corners at the ends.\
\>", "Text",
 CellChangeTimes->{{3.912574786580376*^9, 3.912574804793401*^9}, {
  3.912574836596163*^9, 3.912574842913301*^9}, {3.922695782618548*^9, 
  3.922695827573018*^9}},ExpressionUUID->"599028ce-5a9c-46a1-9227-\
965a2abfc8bd"],

Cell["\<\
If the four points are planar, we create a single rounded plate from the \
quadrilateral. If they\[CloseCurlyQuote]re not planar, we use two rounded \
plates from the two triangles of the skew quadrilateral.\
\>", "Text",
 CellChangeTimes->{{3.92269621148311*^9, 
  3.922696247166939*^9}},ExpressionUUID->"4ef31483-7d04-47d0-ba5e-\
fe8f137dce78"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "HingeRoundedPlateGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HingeThickness", "->", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"RoundingDivisions", "->", 
      RowBox[{"(", 
       RowBox[{"RoundingDivisions", "/.", 
        RowBox[{"Options", "[", "MakePlanarRoundedPlateGC", "]"}]}], ")"}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"PlanarTolerance", "->", 
      RowBox[{"(", 
       RowBox[{"PlanarTolerance", "/.", 
        RowBox[{"Options", "[", "Polygon3DPlanarQ", "]"}]}], ")"}]}]}], 
