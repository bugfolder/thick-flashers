Cell[TextData[{
 "RecoverCurve3DSystem[ds",
 StyleBox[", \[Kappa]",
  FontSlant->"Italic"],
 ", \[Tau], {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bi",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs a space curve from its coefficients and some specified initial \
conditions."
}], "Text",
 CellChangeTimes->{{3.668947828478882*^9, 3.668947977055999*^9}, {
   3.668948036710371*^9, 3.668948054819468*^9}, 3.668951330975006*^9, {
