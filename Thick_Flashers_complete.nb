Cell[CellGroupData[{

Cell[TextData[{
 "Styled3DDisk[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ArcDivisions, LineStyle, FillStyle"
}], "Subsubsection",
 CellChangeTimes->{{3.693765184298026*^9, 3.69376522245758*^9}, {
  3.6937652854817257`*^9, 
  3.693765294258286*^9}},ExpressionUUID->"53e9ae5c-2955-49a1-9271-\
ff1634e3d56f"],

Cell[TextData[{
 "Styled3DDisk[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs a styled circular disk from its center, normal vector, and \
radius."
}], "Text",
 CellChangeTimes->{{3.693765225680377*^9, 
  3.693765279658027*^9}},ExpressionUUID->"97433093-85cd-464d-a18d-\
30e9ae62ba5f"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the center of the disk.\n\t",
 StyleBox["n",
  FontSlant->"Italic"],
 " \[LongDash] the normal vector of the disk.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the radius of the disk."
}], "Text",
 CellChangeTimes->{{3.693765298233899*^9, 
  3.693765316242386*^9}},ExpressionUUID->"6ab691d6-dd5e-4e69-815e-\
8d7ea6f4ac6c"],

Cell[TextData[{
 "Options:\n\tArcDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", specifies the number of points to use in drawing the circle.\n\tLineStyle\
\[Rule]",
 StyleBox["style | ",
  FontSlant->"Italic"],
 "None, specifies the Style directive to use in outlining the disk or None \
for no outline.\n\tFillStyle\[Rule]",
 StyleBox["style | ",
  FontSlant->"Italic"],
 "None, specifies the Style directive to use in drawing the disk or None for \
no fill."
}], "Text",
 CellChangeTimes->{{3.693765319626251*^9, 3.693765369290348*^9}, 
   3.693872658259513*^9},ExpressionUUID->"beaf7068-6192-4460-84dd-\
e8d3e5283e11"],

Cell["Returns Graphics3D elements that represent the disk.", "Text",
 CellChangeTimes->{{3.6937653714741497`*^9, 
  3.693765385266884*^9}},ExpressionUUID->"ca029085-2421-4044-8932-\
f2b691fca243"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Styled3DDisk", "[", 
   RowBox[{"p_List", ",", "n_List", ",", "r_", ",", "opts___"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nx", ",", " ", "ny", ",", "n1", ",", "n2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nx", "=", 
      RowBox[{"n", "\[Cross]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ny", "=", 
      RowBox[{"n", "\[Cross]", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mag", "[", "nx", "]"}], ">", 
        RowBox[{"Mag", "[", "ny", "]"}]}], ",", 
       RowBox[{"n1", "=", 
        RowBox[{"NormalizeReal", "[", "nx", "]"}]}], ",", 
       RowBox[{"n1", "=", 
        RowBox[{"NormalizeReal", "[", "ny", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n2", "=", 
      RowBox[{"n", "\[Cross]", "n1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Styled3DDiskFromInPlaneVectors", "[", 
      RowBox[{"p", ",", 
       RowBox[{"{", 
        RowBox[{"n1", ",", "n2"}], "}"}], ",", "r", ",", "opts"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.443223762473865*^9, 3.443223821373687*^9}, {
   3.668985732066074*^9, 3.668985744640215*^9}, {3.693765516158428*^9, 
