     "PolygonOffsetTwistTile", ",", "verts_List", ",", " ", "w_", ",", " ", 
      "d_", ",", "types_List"}], "}"}], ",", "TGraph2DAssigned", ",", 
    "opts___"}], "]"}], " ", ":=", " ", 
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PolygonTwistTile", ",", "verts", ",", "w", ",", "d", ",", 
      FractionBox["\[Pi]", "2"], ",", 
      RowBox[{"d", ">", "0"}], ",", "types"}], "}"}], ",", "TGraph2DAssigned",
     ",", "opts"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.630024392026183*^9, 3.630024398617792*^9}, {
