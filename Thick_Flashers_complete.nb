     RowBox[{
     "verts", ",", "edges", ",", "chull", ",", "nverts", ",", "nedges"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "CircularlyAddEdgesToConvexHull"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"chull", "=", 
      RowBox[{"ConvexHull", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "+", 
         RowBox[{"r", "*", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{"#", "-", "ctr"}], "]"}]}]}], "&"}], "/@", 
       RowBox[{"verts", "[", 
        RowBox[{"[", "chull", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"chull", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", "verts", "]"}], "+", "i"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "nverts", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertiesIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices", "\[Rule]", 
          RowBox[{"Join", "[", 
           RowBox[{"verts", ",", "nverts"}], "]"}]}], ",", 
         RowBox[{"Edges", "\[Rule]", 
          RowBox[{"Join", "[", 
           RowBox[{"edges", ",", "nedges"}], "]"}]}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
