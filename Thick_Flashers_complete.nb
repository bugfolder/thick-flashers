f94b362a2efd"],

Cell[TextData[{
 "TetrahedronSkewDistance[",
 StyleBox["p, q, r, s",
  FontSlant->"Italic"],
 "] gives the distance between the lines through the {",
 StyleBox["p,q",
  FontSlant->"Italic"],
 "} and {",
 StyleBox["r,s",
  FontSlant->"Italic"],
 "} edges of a tetrahedron with vertices ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["s",
  FontSlant->"Italic"],
 ". This can also be used to find the skew distance between two lines in \
3-space by giving two points on each line."
}], "Text",
 CellChangeTimes->{{3.595715091376808*^9, 3.595715147008801*^9}, {
  3.595980673420803*^9, 3.59598067519695*^9}, {3.595983036538944*^9, 
  3.5959830447236834`*^9}},ExpressionUUID->"964ba609-bceb-41d3-8708-\
6e45c8d44704"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronSkewDistance", "[", 
   RowBox[{"p_List", ",", "q_List", ",", "r_List", ",", "s_List"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"6", 
    RowBox[{"TetrahedronVolume", "[", 
     RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "]"}]}], 
   RowBox[{"Mag", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"q", "-", "p"}], ")"}], "\[Cross]", 
     RowBox[{"(", 
      RowBox[{"r", "-", "s"}], ")"}]}], "]"}]]}]], "Input",
 CellChangeTimes->{{3.595715153496808*^9, 3.595715231387313*^9}, {
  3.595715456407029*^9, 3.59571548539758*^9}, {3.595983056621504*^9, 
