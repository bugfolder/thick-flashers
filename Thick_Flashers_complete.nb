Cell["\<\
This is the same as FlasherIsometryFns, but for parabolic flashers. Instead \
of enforcing isometry between the CP and FF, it enforces isometry between the \
DP and FF.\
\>", "Text",
 CellChangeTimes->{
  3.719932085524315*^9, {3.825679300093281*^9, 
   3.825679328790861*^9}},ExpressionUUID->"bbc9ab79-df7a-4e3d-8d85-\
5729db05dc8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ParaboloidalFlasherIsometryFns", "[", 
   RowBox[{
   "vars_", ",", "r_", ",", "h_", ",", "m_", ",", "f_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "v", ",", "fs", ",", "lp", ",", "dfn", ",", "dp", ",", "dpp"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"first", " ", "sector", " ", "of", " ", "flasher"}], ",", " ", 
       
       RowBox[{"symbolic", " ", "variable", " ", "v"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{"FlasherSectorFoldLines", "[", 
       RowBox[{
        StyleBox["v",
         FontSlant->"Italic"], ",", 
        StyleBox["r",
         FontSlant->"Italic"], ",", 
        StyleBox["h",
         FontSlant->"Italic"], 
        StyleBox[",",
         FontSlant->"Italic"], 
        StyleBox["0",
         FontSlant->"Italic"], 
        StyleBox[",",
         FontSlant->"Italic"], 
        StyleBox["opts",
         FontSlant->"Italic"]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "all", " ", "line", " ", "segment", " ", "vertex", " ", "pairs", " ", 
       "in", " ", "the", " ", "first", " ", "sector"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"lp", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"fs", ",", 
          RowBox[{"Line", "[", "_", "]"}], ",", "\[Infinity]"}], "]"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "distance", " ", "fn", " ", "that", " ", "takes", " ", "a", " ", "list",
        " ", "of", " ", "point", " ", "pairs"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dfn", "=", 
      RowBox[{
       RowBox[{"Mag", "[", 
        RowBox[{"Subtract", "@@", "#"}], "]"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Scalarize", " ", "cp", " ", "pairs", " ", "and", " ", "compute", " ", 
       "length"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dp", "=", 
      RowBox[{"dfn", "/@", 
       RowBox[{"N", "[", 
        RowBox[{"ParaboloidalFlasherScalarize", "[", 
         RowBox[{"vars", ",", 
          RowBox[{"lp", "/.", 
           RowBox[{"v", "\[Rule]", "p"}]}], ",", "m", ",", "f"}], "]"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Scalarize", " ", "ff", " ", "pairs", " ", "and", " ", "compute", " ", 
       RowBox[{"length", "^", "2"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dpp", "=", 
      RowBox[{"dfn", "/@", 
       RowBox[{"N", "[", 
        RowBox[{"ParaboloidalFlasherScalarize", "[", 
         RowBox[{"vars", ",", 
          RowBox[{"lp", "/.", 
           RowBox[{"v", "\[Rule]", "pp"}]}], ",", "m", ",", "f"}], "]"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"return", " ", "difference", " ", "between", " ", "lengths"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dpp", "-", "dp"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.55576846937304*^9, 3.5557685968683147`*^9}, {
