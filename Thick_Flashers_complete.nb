     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], "k1", 
           SuperscriptBox["#1", "2"]}], "+", 
          RowBox[{
           FractionBox["1", "2"], "k2", 
           SuperscriptBox["#2", "2"]}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<ss[u,v] = \>\"", ",", 
