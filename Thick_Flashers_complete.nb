  3.617405055093057*^9}},ExpressionUUID->"067df384-e286-4896-87b2-\
13c9856a72f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sa", ",", "\[Gamma]", ",", "n", ",", "w", ",", "da", ",", "vtobj", ",", 
      "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"70.", "\[Degree]"}], ",", 
        RowBox[{"70.", "\[Degree]"}], ",", 
        RowBox[{"110.", "\[Degree]"}], ",", 
        RowBox[{"110.", "\[Degree]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"90", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", "6"}], ";", "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.33"}], ";", "\[IndentingNewLine]", 
     RowBox[{"da", "=", 
      RowBox[{"MakeDihedralsFromSectorsAndMajorDihedral", "[", 
       RowBox[{"sa", ",", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vtobj", "=", 
      RowBox[{"MakeTDegree4Vertex3DFromSectorsAndDihedrals", "[", 
       RowBox[{"sa", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeMajorConnectedUnitChain", "[", 
       RowBox[{"sa", ",", 
        RowBox[{"FoldAngleToType", "[", "\[Gamma]", "]"}], ",", "n", ",", 
        "w"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldLinearChain", "[", 
       RowBox[{"tobj", ",", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertex3DCreasePatternGraphics", "[", "vtobj", "]"}], ",", 
         RowBox[{"Vertex3DFoldedFormGraphics3D", "[", "vtobj", "]"}], ",", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"Vertex3DStyle", "[", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.617257443776836*^9, 3.61725762505096*^9}, {
