Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "verts1", ",", "edges", ",", "faces"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"twistobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "Faces"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts1", ",", "edges", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"twistobj1", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "Faces"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CCWTwistQ", "[", 
        RowBox[{"verts", ",", "edges", ",", 
         RowBox[{
         "faces", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        "]"}], ",", 
       RowBox[{"CCWTwistQ", "[", 
        RowBox[{"verts1", ",", "edges", ",", 
         RowBox[{
         "faces", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
        "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
