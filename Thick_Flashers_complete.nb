Cell["\<\
Changes for version 11.0d16
Fix UnitCyclicBrocardPolygonInfoCCW and UnitCyclicBrocardPolygonInfoCW, which \
were broken by Mathematica 11.\
\>", "Text",
 CellChangeTimes->{{3.7056051760153728`*^9, 
  3.705605216521074*^9}},ExpressionUUID->"fbbe44a3-368f-4282-90e4-\
