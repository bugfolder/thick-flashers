Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"o", ",", "p1", ",", "p2", ",", "p3", ",", "gfn"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"o", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p1", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p3", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gfn", "[", 
       RowBox[{"p_", ",", "q_", ",", "opts___"}], "]"}], ":=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"o", ",", "p1"}], "}"}], "]"}], ",", "Red"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"o", ",", "p2"}], "}"}], "]"}], ",", "Green"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"o", ",", "p3"}], "}"}], "]"}], ",", "Blue"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Sphere", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
           RowBox[{"Opacity", "[", "0.4", "]"}]}], "]"}], ",", 
         RowBox[{"AbsoluteThickness", "[", "4", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Line", "[", 
          RowBox[{"PolygonalEllipseArc3D", "[", 
           RowBox[{"p", ",", "q", ",", "opts"}], "]"}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcMethod", "\[Rule]", "CircumscribedArc"}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcDivisions", "\[Rule]", "1"}], ",", 
            RowBox[{"ArcMaximumAngle", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"ArcMethod", "\[Rule]", "CircumscribedArc"}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcDivisions", "\[Rule]", "3"}], ",", 
            RowBox[{"ArcMaximumAngle", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"ArcMethod", "\[Rule]", "CircumscribedArc"}]}], "]"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcDivisions", "\[Rule]", "9"}], ",", 
            RowBox[{"ArcMaximumAngle", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"ArcMethod", "\[Rule]", "CircumscribedArc"}], ",", 
            RowBox[{"RotationAxis", "\[Rule]", "p3"}]}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcMethod", "\[Rule]", "InscribedArc"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcDivisions", "\[Rule]", "1"}], ",", 
            RowBox[{"ArcMaximumAngle", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"ArcMethod", "\[Rule]", "InscribedArc"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcDivisions", "\[Rule]", "3"}], ",", 
            RowBox[{"ArcMaximumAngle", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"ArcMethod", "\[Rule]", "InscribedArc"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"gfn", "[", 
           RowBox[{"p1", ",", "p2", ",", 
            RowBox[{"ArcDivisions", "\[Rule]", "9"}], ",", 
            RowBox[{"ArcMaximumAngle", "\[Rule]", "\[Infinity]"}], ",", 
            RowBox[{"ArcMethod", "\[Rule]", "InscribedArc"}], ",", 
            RowBox[{"RotationAxis", "\[Rule]", "p3"}], ",", 
            RowBox[{"ArcDirection", "\[Rule]", "CW"}]}], "]"}]}], 
         "\[IndentingNewLine]", "}"}]}], "}"}], "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
