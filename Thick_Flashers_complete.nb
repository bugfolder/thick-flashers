Cell[BoxData[
 RowBox[{
  RowBox[{"MakeYoshimuraVertex", "[", 
   RowBox[{"sectorangles_List", ",", 
    RowBox[{"{", 
     RowBox[{"gm2_", ",", "gm6_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mm", ",", "gm1", ",", "gm3", ",", "gm4", ",", "gm5", ",", "m11", ",", 
      "m22", ",", "m33", ",", "soln", ",", "foldangles"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "sectorangles", "]"}], "\[NotEqual]", "6"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeYoshimuraVertex", "::", "badsectors"}], ",", 
          "sectorangles"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sign", "[", "gm2", "]"}], "\[NotEqual]", 
        RowBox[{"Sign", "[", "gm6", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeYoshimuraVertex", "::", "badangles"}], ",", "gm2", ",",
           "gm6"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Plus", "@@", 
         RowBox[{"Take", "[", 
          RowBox[{"sectorangles", ",", "3"}], "]"}]}], "\[NotEqual]", 
        "\[Pi]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeYoshimuraVertex", "::", "badfirst"}], ",", 
          RowBox[{"Take", "[", 
           RowBox[{"sectorangles", ",", "3"}], "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Plus", "@@", 
         RowBox[{"Take", "[", 
          RowBox[{"sectorangles", ",", 
           RowBox[{"-", "3"}]}], "]"}]}], "\[NotEqual]", "\[Pi]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeYoshimuraVertex", "::", "badfirst"}], ",", 
          RowBox[{"Take", "[", 
           RowBox[{"sectorangles", ",", 
            RowBox[{"-", "3"}]}], "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Solve", " ", "for", " ", "fold", " ", "angles", " ", "in", " ", "3", 
       "D", " ", "that", " ", "satisfy", " ", "vertex", " ", 
       RowBox[{"consistency", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Add", " ", "slack", " ", "variables", " ", "on", " ", "diagonal", " ", 
       "elements"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"mm", "=", 
      RowBox[{"VertexConsistencyMatrix3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "gm4", ",", "gm2", ",", "gm3", ",", "gm4", ",", "gm5", ",", "gm6"}], 
         "}"}], ",", "sectorangles"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{
        RowBox[{"Sign", "[", "gm2", "]"}], ",", "\[IndentingNewLine]", "0", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"gm3", "\[Rule]", "0"}], ",", 
          RowBox[{"gm4", "\[Rule]", "0"}], ",", 
          RowBox[{"gm5", "\[Rule]", "0"}]}], "}"}], ",", 
        "\[IndentingNewLine]", "1", ",", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mm", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"mm", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"mm", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{"mm", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
             SuperscriptBox["m11", "2"]}], ",", 
            RowBox[{
             RowBox[{"mm", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "-", 
             SuperscriptBox["m22", "2"]}], ",", 
            RowBox[{
             RowBox[{"mm", "\[LeftDoubleBracket]", 
              RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}], "-", 
             SuperscriptBox["m33", "2"]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"gm3", ",", ".1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"gm4", ",", 
            RowBox[{"-", ".1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"gm5", ",", ".1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m11", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m22", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m33", ",", "1"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mm", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"mm", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{"mm", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{"mm", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
             SuperscriptBox["m11", "2"]}], ",", 
            RowBox[{
             RowBox[{"mm", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "-", 
             SuperscriptBox["m22", "2"]}], ",", 
            RowBox[{
             RowBox[{"mm", "\[LeftDoubleBracket]", 
              RowBox[{"3", ",", "3"}], "\[RightDoubleBracket]"}], "-", 
             SuperscriptBox["m33", "2"]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"gm3", ",", 
            RowBox[{"-", ".1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"gm4", ",", ".1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"gm5", ",", 
            RowBox[{"-", ".1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m11", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m22", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"m33", ",", "1"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<mm = \>\"", ",", 
         RowBox[{"Chop", "[", 
          RowBox[{"mm", "/.", "soln"}], "]"}]}], "]"}], ";"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "gm4", ",", "gm2", ",", "gm3", ",", "gm4", ",", "gm5", ",", "gm6"}], 
        "}"}], "/.", "soln"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTVertex3DFromAngles", "[", 
      RowBox[{"sectorangles", ",", "foldangles", ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
