Cell[TextData[{
 "NFoldAcrossRightBoth[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 2D and 3D fold and their left ruling vectors and constructs the \
full 2D and 3D ruled neighborhoods, i.e., it adds the right ruling vectors, \
using interpolating functions."
}], "Text",
 CellChangeTimes->{{3.799443094830909*^9, 3.799443137697144*^9}, {
   3.799497627768349*^9, 3.799497628201466*^9}, {3.799501683732283*^9, 
   3.79950170255728*^9}, 3.799697161387595*^9, 3.800465204471101*^9, {
   3.8011753434744673`*^9, 3.801175358324417*^9}, 3.801647976357845*^9, {
   3.801649109651104*^9, 3.801649145947417*^9}, 
   3.8016549742726293`*^9},ExpressionUUID->"54f3c043-9eba-486c-aaad-\
35f2e8ff96c6"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the 2D space curve of the fold, as a vector-valued function.\n\
\t",
 StyleBox["rL",
  FontSlant->"Italic"],
 " \[LongDash] the 2D left ruling vector.\n\t",
 StyleBox["ff",
  FontSlant->"Italic"],
 " \[LongDash] the 3D space curve of the fold, as a vector-valued function.\n\
\t",
 StyleBox["rrL",
  FontSlant->"Italic"],
 " \[LongDash] the 3D left ruling vector.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.7994432330333567`*^9, 3.799443249729931*^9}, {
