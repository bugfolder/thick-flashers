            RowBox[{"ExponentFunction", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{"Null", "&"}], ")"}]}]}], "]"}]}], "]"}], "]"}], "&"}], 
      ")"}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
