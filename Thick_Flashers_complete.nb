Cell[CellGroupData[{

Cell["3D folded shapes", "Section",
 CellChangeTimes->{{3.594754035762661*^9, 3.594754038450048*^9}, {
  3.703969030203153*^9, 
  3.703969030947225*^9}},ExpressionUUID->"011badb4-fe59-47b3-beed-\
8b1d1967cc5a"],

Cell[CellGroupData[{

Cell["3D vertices", "Subsection",
 CellChangeTimes->{{3.719617645026748*^9, 
  3.71961764681086*^9}},ExpressionUUID->"9fcb21ab-ba2f-494b-8094-\
d1916abe9f39"],

Cell[CellGroupData[{

Cell["Hexagon vertex analysis", "Subsubsection",
 CellChangeTimes->{{3.719662819923037*^9, 
  3.719662823091275*^9}},ExpressionUUID->"ff3d9923-5ac4-475f-ab1e-\
1f4cceebf7c0"],

Cell["\<\
This example analyzes a parameterized hexagon vertex, which is how we got the \
formula for \[Psi] in the preceding.\
\>", "Text",
 CellChangeTimes->{{3.71966282584271*^9, 
  3.719662882843834*^9}},ExpressionUUID->"0947dbc6-066d-4d68-97e6-\
1ac176742797"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "v1", ",", "v2", ",", "rm", ",", "types", ",",
       "verts3d", ",", "tobj1", ",", "tobj2", ",", "soln", ",", "\[Theta]0"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"U", "[", 
           RowBox[{"i", " ", 
            RowBox[{"\[Pi]", "/", "3"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "5"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", "0", ",", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Psi]", "]"}], ",", "0", ",", 
        RowBox[{"Sin", "[", "\[Psi]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rm", "[", "i_", "]"}], ":=", 
      RowBox[{"RotationZMatrix3D", "[", 
       RowBox[{"i", " ", 
        RowBox[{"\[Pi]", "/", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Theta]", ">", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "V", ",", "M", ",", "V", ",", "M", ",", "V", ",", "M", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Theta]", "<", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "M", ",", "V", ",", "M", ",", "V", ",", "M", ",", "V", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}], ",", 
        "\[IndentingNewLine]", "True", ",", 
        RowBox[{"{", 
         RowBox[{
         "U", ",", "U", ",", "U", ",", "U", ",", "U", ",", "U", ",", "B", ",",
           "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"v1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", "0", ",", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Psi]", "]"}], ",", "0", ",", 
        RowBox[{"Sin", "[", "\[Psi]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rm", "[", "i_", "]"}], ":=", 
      RowBox[{"RotationZMatrix3D", "[", 
       RowBox[{"i", " ", 
        RowBox[{"\[Pi]", "/", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "v1", ",", 
        RowBox[{
         RowBox[{"rm", "[", "1", "]"}], ".", "v2"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "2", "]"}], ".", "v1"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "3", "]"}], ".", "v2"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "4", "]"}], ".", "v1"}], ",", 
        RowBox[{
         RowBox[{"rm", "[", "5", "]"}], ".", "v2"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"solve", " ", "for", " ", 
        RowBox[{"\[Psi]", ".", " ", "In"}], " ", "general"}], ",", " ", 
       RowBox[{"there", " ", "will", " ", "be", " ", "two", " ", 
        RowBox[{"solutions", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mag2", "[", 
             RowBox[{"v1", "-", 
              RowBox[{
               RowBox[{"rm", "[", "1", "]"}], ".", "v2"}]}], "]"}], "\[Equal]",
             "1"}], ",", "\[Psi]"}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"ArcTan", "[", 
             RowBox[{"x_", ",", "y_"}], "]"}], "\[RuleDelayed]", 
            RowBox[{"ArcTan", "[", 
             RowBox[{"y", "/", "x"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"C", "[", "1", "]"}], "\[Rule]", "0"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]", ">", 
           RowBox[{
            RowBox[{"-", "\[Pi]"}], "/", "2"}]}], ",", 
          RowBox[{"\[Theta]", "<", 
           RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Solutions are: \>\"", ",", "soln"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Plot", " ", "the", " ", "two", " ", 
        RowBox[{"solutions", ".", " ", "Note"}], " ", "that", " ", "for", " ",
         "\[Theta]", " ", "less", " ", "than", " ", "about", " ", "0.5"}], ",",
        " ", 
       RowBox[{"there", " ", "are", " ", "two", " ", "solutions"}], ",", " ", 
       
       RowBox[{
       "corresponding", " ", "to", " ", "the", " ", "two", " ", "possible", " ",
         "positions", " ", "of", " ", "the", " ", "v2", " ", 
        RowBox[{"vertices", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Psi]", "/.", "#"}], "&"}], "/@", "soln"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", 
          RowBox[{
           RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
          RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"At", " ", "the", " ", "discontinuities"}], ",", " ", 
       RowBox[{
        RowBox[{
        "the", " ", "solution", " ", "switches", " ", "to", " ", "a", " ", 
         "spurious", " ", 
         RowBox[{"solution", ".", " ", "Check"}], " ", "this", " ", "by", " ",
          "plotting", " ", "the", " ", "error", " ", "function", " ", "for", " ",
          "our", " ", "equation"}], ";", " ", 
        RowBox[{
        "it", " ", "should", " ", "be", " ", "zero", " ", "for", " ", "a", " ",
          "valid", " ", 
         RowBox[{"solution", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Mag2", "[", 
              RowBox[{"v1", "-", 
               RowBox[{
                RowBox[{"rm", "[", "1", "]"}], ".", "v2"}]}], "]"}], "-", 
             "1"}], ")"}], "/.", "#"}], "&"}], "/@", "soln"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", 
          RowBox[{
           RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
          RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], "//", "Print"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Now", " ", "show", " ", "two", " ", "examples", " ", "within", " ", 
       "the", " ", "valid", " ", 
       RowBox[{"range", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Theta]0", "=", 
      RowBox[{"25.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"MakeTGraph", "[", 
            RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], 
          "//", 
          RowBox[{"AddTAssigned", "[", 
           RowBox[{"types", "/.", 
            RowBox[{"\[Theta]", "\[Rule]", "\[Theta]0"}]}], "]"}]}], "//", 
         RowBox[{"AddTGraph3D", "[", 
          RowBox[{
           RowBox[{"verts3d", "/.", 
            RowBox[{
            "soln", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "/.", 
           RowBox[{"\[Theta]", "\[Rule]", "\[Theta]0"}]}], "]"}]}], "//", 
        "RecalcFoldAngles"}], "//", 
       RowBox[{"TweakFoldAngles", "[", 
        RowBox[{"types", "/.", 
         RowBox[{"\[Theta]", "\[Rule]", "\[Theta]0"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"MakeTGraph", "[", 
            RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], 
          "//", 
          RowBox[{"AddTAssigned", "[", 
           RowBox[{"types", "/.", 
            RowBox[{"\[Theta]", "\[Rule]", "\[Theta]0"}]}], "]"}]}], "//", 
         RowBox[{"AddTGraph3D", "[", 
          RowBox[{
           RowBox[{"verts3d", "/.", 
            RowBox[{
            "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
           "/.", 
           RowBox[{"\[Theta]", "\[Rule]", "\[Theta]0"}]}], "]"}]}], "//", 
        "RecalcFoldAngles"}], "//", 
       RowBox[{"TweakFoldAngles", "[", 
        RowBox[{"types", "/.", 
         RowBox[{"\[Theta]", "\[Rule]", "\[Theta]0"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj1", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj2", "]"}]}], "}"}], "]"}], 
      "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.719661495356869*^9, 3.71966160234823*^9}, {
  3.719661642364441*^9, 3.719661656492714*^9}, {3.7196616903011227`*^9, 
