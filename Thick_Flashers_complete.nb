   3.6286934704338613`*^9},ExpressionUUID->"5f3fde11-f10c-4975-a4d5-\
7f97fcec65c5"],

Cell[TextData[{
 "UnitRegularPolygon",
 "OffsetTwistSelfContainedQ[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", d, ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns True if the angles and MV-assignment are consistent with a valid \
simple flat twist AND the resulting tile is self-contained, i.e., the twist \
polygon lies wholly within its tile."
}], "Text",
 CellChangeTimes->{{3.4577463017989073`*^9, 3.457746323657337*^9}, 
   3.627339676723423*^9, 
   3.6273859759738817`*^9},ExpressionUUID->"ec12fd3d-81a3-469e-a4da-\
303d525dca3b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitRegularPolygonOffsetTwistSelfContainedQ", "[", 
    RowBox[{"n_", ",", "w_", ",", "d_", ",", "types_List"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"RegularPolygonTwistValidQ", "[", 
     RowBox[{"n", ",", 
      RowBox[{"UnitRegularPolygonOffsetTwistAngle", "[", 
       RowBox[{"n", ",", "w", ",", "d"}], "]"}], ",", "types"}], "]"}], "&&", 
    
    RowBox[{"w", "\[LessEqual]", 
     RowBox[{
      FractionBox["1", "3"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", 
         RowBox[{"Abs", "[", "d", "]"}]}]}], ")"}]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.592165344659134*^9, {3.627339676756432*^9, 3.627339676789706*^9}, 
   3.62734572522364*^9, 3.627345797096367*^9, 3.627385975974297*^9, 
   3.627591723901224*^9, 3.62863707561456*^9, 3.628637203176688*^9},
 CellLabel->
  "In[3013]:=",ExpressionUUID->"5cc49ee7-6ab4-4cc1-99c9-32811941cf3c"],

Cell[TextData[{
 "UnitRegularPolygonOffsetTwistAltSelfContainedQ",
 "[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns the same thing but using twist angle \[Alpha]."
}], "Text",
 CellChangeTimes->{{3.4577463309615717`*^9, 3.457746333625294*^9}, 
   3.627339676875279*^9, 3.627385975974608*^9, 
