Cell[TextData[{
 "Options:\n\tArrowPosition \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the fractional position along the line. Default is 2/3 of the way along \
the line (offset from center to lessen collisions with labels placed in the \
middle of the line).\n\tArrowheadStyle \[Rule] Arrowheads[",
 StyleBox["spec",
  FontSlant->"Italic"],
 "], to modify the appearance of arrowheads."
}], "Text",
 CellChangeTimes->{{3.713634904407009*^9, 
  3.713634922567452*^9}},ExpressionUUID->"494bbbcb-f014-4ec2-b61e-\
76cbb7c65245"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DirectedEdgeArrow3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ap", ",", "ahs", ",", "r"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"ap", "=", 
      RowBox[{
       RowBox[{"ArrowPosition", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DirectedEdgeArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ahs", "=", 
      RowBox[{
       RowBox[{"ArrowheadStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "DirectedEdgeArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"p1", "+", 
       RowBox[{"ap", 
        RowBox[{"(", 
         RowBox[{"p2", "-", "p1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tube", "[", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", "ahs", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"Tube", "[", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "r"}], "}"}], "]"}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
