Cell[TextData[{
 "MakeTVertex3DFromTGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i1",
  FontSlant->"Italic"],
 "] constructs a TVertex3D for a single vertex of a TGraph3D, where ",
 StyleBox["i0",
  FontSlant->"Italic"],
 " is the index of the central vertex, and ",
 StyleBox["i1",
  FontSlant->"Italic"],
 " is the index of the adjacent vertex that will define fold direction vector \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],ExpressionUUID->
  "88afbd19-5175-4b17-8098-baba3603952f"],
 "."
}], "Text",
 CellChangeTimes->{{3.595276176936623*^9, 3.595276265354195*^9}, {
