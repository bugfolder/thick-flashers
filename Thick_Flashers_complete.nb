Cell[BoxData[
 RowBox[{
  RowBox[{"CrossedEdgeArrow", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ap", ",", "ahs", ",", "r", ",", "rt"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ap", "=", 
      RowBox[{
       RowBox[{"ArrowPosition", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CrossedEdgeArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ahs", "=", 
      RowBox[{
       RowBox[{"ArrowheadStyle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CrossedEdgeArrow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"p1", "+", 
       RowBox[{"ap", 
        RowBox[{"(", 
         RowBox[{"p2", "-", "p1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rt", "=", 
      RowBox[{"r", "+", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "6"}]], 
        RowBox[{"Rotate90", "[", 
         RowBox[{"p2", "-", "p1"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", "ahs", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{"rt", ",", "r"}], "}"}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
