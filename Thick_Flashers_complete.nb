      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "#2", "]"}]}], ",", 
         RowBox[{"Sin", "[", "#2", "]"}], ",", "#1"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
