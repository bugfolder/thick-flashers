Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj", ",", "f1", ",", "f2", ",", "sinfo"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"SingleVertexGraph2D", "//", "RebuildPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f1", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", ".1"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.5"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"f1", ",", 
          RowBox[{"f2", "-", "f1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
