   3.911848724735029*^9}},ExpressionUUID->"81f2741d-0176-41f4-a678-\
45786c9b6261"],

Cell[TextData[{
 "Many of our functions can be applied to both the crease pattern points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "3a3c5e1e-9949-4f5f-becd-abb7f5aa38a5"],
 " and folded form points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["pp",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "c3322f96-9a73-4b4d-b521-0ad24379cd63"],
 ". Those functions will take an argument, ",
 StyleBox["v",
  FontSlant->"Italic"],
 ", which represents the symbolic head, e.g., ",
 StyleBox["p",
  FontSlant->"Italic"],
 " or ",
 StyleBox["pp",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.719919131543439*^9, 
  3.719919222230987*^9}},ExpressionUUID->"5b4fb682-c9a4-4934-b4e2-\
c25cd1f11f16"],

Cell[TextData[{
 "FlasherWrapRules[",
 StyleBox["v",
  FontSlant->"Italic"],
 "] returns a rule that maps points with index ",
 StyleBox["i",
  FontSlant->"Italic"],
 "=\[Dash]1 to the appropriate points in the adjacent sector."
}], "Text",
 CellChangeTimes->{{3.7199191225512543`*^9, 3.719919126335993*^9}, {
  3.7199192301680326`*^9, 3.719919267382957*^9}, {3.719943467583543*^9, 
  3.719943469966197*^9}, {3.911848697249217*^9, 
  3.911848703833673*^9}},ExpressionUUID->"7cd0f3fe-93ca-41f8-a8e0-\
8ef828916574"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherWrapRules", "[", "v_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["v", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
    SubscriptBox["v", 
     RowBox[{"j", ",", "0", ",", 
      RowBox[{"k", "-", "1"}]}]]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.719854012836753*^9, 3.7198540283582067`*^9}, {
  3.719878815890201*^9, 3.719878817830103*^9}, {3.911848819633423*^9, 
  3.91184882101031*^9}},
 CellLabel->
  "In[4094]:=",ExpressionUUID->"cda472cd-9339-4999-9730-9012c4c8fbd5"],

Cell[TextData[{
 "FlasherWrapRules[",
 StyleBox["v, m",
  FontSlant->"Italic"],
 "] returns rules that map points with index ",
 StyleBox["i",
  FontSlant->"Italic"],
 "=\[Dash]1 or ",
 StyleBox["k",
  FontSlant->"Italic"],
 "=\[Dash]1 to the appropriate points in the adjacent sector."
}], "Text",
 CellChangeTimes->{{3.7199191225512543`*^9, 3.719919126335993*^9}, {
  3.7199192301680326`*^9, 3.719919267382957*^9}, {3.719943467583543*^9, 
  3.719943469966197*^9}, {3.911848697249217*^9, 3.911848703833673*^9}, {
  3.911848751636229*^9, 3.9118487643752394`*^9}, {3.911848843514113*^9, 
  3.911848848065007*^9}},ExpressionUUID->"7d8dd35d-6a1f-4c52-961d-\
9fd626abfb6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherWrapRules", "[", 
   RowBox[{"v_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox["v", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
     SubscriptBox["v", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{"k", "-", "1"}]}]]}], ",", 
    RowBox[{
     SubscriptBox["v", 
      RowBox[{"i_", ",", "j_", ",", 
       RowBox[{"-", "1"}]}]], "->", 
     SubscriptBox["v", 
      RowBox[{"i", ",", "j", ",", 
       RowBox[{"m", "-", "1"}]}]]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.719854012836753*^9, 3.7198540283582067`*^9}, {
  3.719878815890201*^9, 3.719878817830103*^9}, {3.911848780635657*^9, 
  3.911848832721323*^9}},
 CellLabel->
  "In[4095]:=",ExpressionUUID->"50282aed-635b-44de-9f95-639e4089cc82"]
}, Closed]],

