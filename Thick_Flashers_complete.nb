   3.9111461963765574`*^9}},ExpressionUUID->"413ada2c-358e-44f5-90bb-\
852caa87cb57"],

Cell[TextData[{
 "MakeFlasher[",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dr",
  FontSlant->"Italic"],
 "] sets up and solves for the design of a flasher. "
}], "Text",
 CellChangeTimes->{{3.555852179920305*^9, 3.555852292385377*^9}, {
  3.55585233169029*^9, 3.555852439928059*^9}, {3.5558534052815933`*^9, 
  3.555853419447778*^9}, {3.555853468093226*^9, 3.555853470086399*^9}, {
  3.555854321702399*^9, 3.55585432180553*^9}, {3.55585435811005*^9, 
  3.555854358243123*^9}, {3.555854490587639*^9, 3.555854512079216*^9}, {
  3.55587294036359*^9, 3.555872968375396*^9}, {3.555877743471888*^9, 
  3.555877759390441*^9}, {3.555953532176882*^9, 3.5559535350633707`*^9}, {
  3.555953668751749*^9, 3.555953717889508*^9}, {3.71993102902227*^9, 
  3.719931037998898*^9}},ExpressionUUID->"3f716ac9-7c7e-47d8-80c3-\
3b2b86ab821b"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " -- the number of rings.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " -- the height order (how many turns a diagonal takes to get from the \
bottom to the top of a ring)\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " -- the rotational symmetry\n\t",
 StyleBox["dr",
  FontSlant->"Italic"],
 " -- the radial spacing of successive vertices in the same plane."
}], "Text",
 CellChangeTimes->{{3.719931396604858*^9, 
  3.71993146171073*^9}},ExpressionUUID->"97dbee38-b68d-44c4-84df-\
fc044f2cebc8"],

Cell[TextData[{
 "Options:\n \tFlasherSectorDiagFoldLines \[Rule] ",
 StyleBox["fsdfl",
  FontSlant->"Italic"],
 ", specifies the orientation of the quad diagonal fold lines. Passed through \
to FlasherSectorFoldLines.\n \tTypeMinimumAngle is passed through to \
ReassignGraph3D."
}], "Text",
 CellChangeTimes->{{3.719931466591586*^9, 3.719931530773669*^9}, {
   3.7199413404217176`*^9, 3.719941380535017*^9}, 3.719945676239248*^9, {
   3.8256795750326643`*^9, 
   3.8256795767126093`*^9}},ExpressionUUID->"f5b132d1-6984-4456-8826-\
620cd3bfc64a"],

Cell["\<\
Returns: a TGraph3DAssigned, with a few additional properties:
\tFlasherLabeledCPSectorGraphics \[LongDash] a Graphics of the first sector \
of the CP with vertex labels
\tFlasherLabeledFFSectorGraphics3D \[LongDash] a Graphics3D of the first \
sector of the FF with vertex labels
\tFlasherCPGraphics \[LongDash] a Graphics of the CP with no polygons and \
color-coded fold lines
\tFlasherFFGraphics3D \[LongDash] a Graphics3D of the FF with no polygons and \
color-coded fold lines
\tFlasherDetails \[LongDash] a list of rules giving assorted numerical \
values.
\tFlasherIJKMap \[LongDash] a list that pairs {i,j,k} indices with their \
corresponding indices into the Vertices property of the TGraph.\
\>", "Text",
 CellChangeTimes->{{3.719936597709552*^9, 3.7199366164444847`*^9}, {
  3.7199369243486223`*^9, 3.719936925356485*^9}, {3.71994279501542*^9, 
  3.719942891998571*^9}, {3.825778096878317*^9, 
  3.825778129446754*^9}},ExpressionUUID->"0842197a-e82d-4674-88e9-\
2daaeaf57252"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeFlasher", "::", "badiso"}], 
   "=", "\"\<Warning: isometry equations could not be satisfied. Residual \
error is `1.`\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.7199425333213387`*^9, 3.719942597070138*^9}, {
  3.7199426442068787`*^9, 3.719942646486374*^9}},
 CellLabel->
  "In[4189]:=",ExpressionUUID->"d77bf975-dc18-4a2d-9cf0-fefbaaf5001b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFlasher", "[", 
   RowBox[{"r_", ",", "h_", ",", "m_", ",", "dr_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vars", ",", "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", 
      "ppy", ",", "ppz", ",", "dz", ",", "eqnfns", ",", "srules", ",", 
      "allvars", ",", "newvars", ",", "fwd", ",", "bkd", ",", "args", ",", 
      "soln", ",", "vertrules", ",", "isovals", ",", "cpsg", ",", "cplg", ",",
       "ffsg", ",", "fflg", ",", "picdia", ",", "pccdia", ",", "cpccdia", ",",
       "orverts", ",", "ffverts", ",", "oph", ",", "opw", ",", "cpicdia", ",",
       "ffdia", ",", "ffh", ",", "cpedges", ",", "ffedges", ",", "btedges", ",",
       "verts", ",", "edges", ",", "verts3d", ",", "tobj", ",", "allverts", ",",
       "allvinds", ",", "ijkmap", ",", "msgs"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"PART", " ", 
      RowBox[{"I", ":", " ", 
       RowBox[{"solve", " ", "for", " ", "the", " ", "flasher"}]}]}], " ", 
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vars", "=", 
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqnfns", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FlasherCPRotationFns", "[", 
         RowBox[{"vars", ",", "m"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"FlasherIsometryFns", "[", 
         RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "opts"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"FlasherXYFns", "[", 
         RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "dr"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"FlasherOuterRingFns", "[", 
         RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "dz"}], "]"}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{"dz", " ", "is", " ", "now", " ", "a", " ", "variable"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         SubscriptBox["ppz", 
          RowBox[{"0", ",", "0"}]], "}"}]}], 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "forces", " ", "central", " ", "polygon", " ", "to", " ", "z"}], "=",
          "0"}], " ", "*)"}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"srules", "=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"FlasherDefaultScalarRules", "[", 
         RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "dr"}], "]"}], ",", 
        RowBox[{"dz", "\[Rule]", "0"}]}], "]"}]}], ";", 
     RowBox[{"allvars", "=", 
      RowBox[{"First", "/@", "srules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newvars", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Unique", "[", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "allvars", "]"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"fwd", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Rule", ",", 
        RowBox[{"{", 
         RowBox[{"allvars", ",", "newvars"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"bkd", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#2", "\[Rule]", "#1"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"allvars", ",", "newvars"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"args", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"eqnfns", "/.", "fwd"}], ",", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"newvars", ",", 
           RowBox[{"allvars", "/.", "srules"}]}], "}"}], "]"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"FindRoot", "@@", "args"}], ")"}], ",", 
        RowBox[{"Abort", "[", "]"}], ",", 
        RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", " ", "=", " ", 
      RowBox[{"soln", " ", "/.", " ", "bkd"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vertrules", "=", 
      RowBox[{"FlasherVertexRules", "[", 
       RowBox[{"vars", ",", "m", ",", "soln"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"isovals", "=", 
      RowBox[{
       RowBox[{"Abs", "/@", 
        RowBox[{"FlasherIsometryFns", "[", 
         RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "opts"}], "]"}]}],
        "/.", "soln"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Plus", "@@", "isovals"}], ">", 
        SuperscriptBox["10", 
         RowBox[{"-", "6"}]]}], ",", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"MakeFlasher", "::", "badiso"}], ",", "isovals"}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"PART", " ", 
       RowBox[{"II", ":", " ", 
        RowBox[{
        "compute", " ", "graphical", " ", "bits", " ", "and", " ", 
         "diagnostic", " ", "info"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"graphical", " ", "images"}], ",", " ", 
       RowBox[{
        RowBox[{"sector", " ", "&"}], " ", "pattern"}], ",", " ", 
       RowBox[{
        RowBox[{"cp", " ", "&"}], " ", "ff"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cpsg", "=", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"FlasherLabeledSector", "[", 
         RowBox[{"\"\<p\>\"", ",", "p", ",", "r", ",", "h", ",", "m", ",", 
          "opts"}], "]"}], "]"}], "/.", "vertrules"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cplg", "=", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"FlasherLines", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "opts"}], "]"}], 
        "]"}], "/.", "vertrules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ffsg", "=", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"FlasherLabeledSector", "[", 
         RowBox[{"\"\<pp\>\"", ",", "pp", ",", "r", ",", "h", ",", "m", ",", 
          "opts"}], "]"}], "]"}], "/.", "vertrules"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fflg", "=", 
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{"FlasherLines", "[", 
         RowBox[{"pp", ",", "r", ",", "h", ",", "m", ",", "opts"}], "]"}], 
        "]"}], "/.", "vertrules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"central", " ", "polygon", " ", "incircle", " ", "diameter"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"picdia", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "central", " ", "polygon", " ", "circumcircle", " ", "diameter"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pccdia", "=", 
      RowBox[{"2", "*", 
       RowBox[{"Mag", "[", 
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"0", ",", "0", ",", "0"}]], "/.", "vertrules"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"cp", " ", "outermost", " ", "vertices"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"orverts", "=", 
      RowBox[{
       RowBox[{"FlasherOuterRingSectorVertices", "[", 
        RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}], "/.", 
       "vertrules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"crease", " ", "pattern", " ", "incircle", " ", "diameter"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cpicdia", "=", 
      RowBox[{"2", "*", 
       RowBox[{"Min", "[", 
        RowBox[{"Mag", "/@", "orverts"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "crease", " ", "pattern", " ", "circumcircle", " ", "diameter"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"cpccdia", "=", 
      RowBox[{"2", "*", 
       RowBox[{"Max", "[", 
        RowBox[{"Mag", "/@", 
         RowBox[{"(", 
          RowBox[{"orverts", "/.", "vertrules"}], ")"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"outermost", " ", "panel", " ", "height"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"oph", "=", 
      RowBox[{"Mag", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["p", 
           RowBox[{
            RowBox[{"r", "*", "h"}], ",", 
            RowBox[{"r", "*", "h"}], ",", "0"}]], "-", 
          SubscriptBox["p", 
           RowBox[{
            RowBox[{"r", "*", "h"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"r", "-", "1"}], ")"}], "*", "h"}], ",", "0"}]]}], 
         ")"}], "/.", "vertrules"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"outermost", " ", "panel", " ", "width"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"opw", "=", 
      RowBox[{"Mag", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["p", 
           RowBox[{
            RowBox[{"r", "*", "h"}], ",", 
            RowBox[{"r", "*", "h"}], ",", "0"}]], "-", 
          SubscriptBox["p", 
           RowBox[{
            RowBox[{
             RowBox[{"r", "*", "h"}], "-", "1"}], ",", 
            RowBox[{"r", "*", "h"}], ",", "0"}]]}], ")"}], "/.", 
        "vertrules"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"outermost", " ", "vertices", " ", "in", " ", "ff"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ffverts", "=", 
      RowBox[{
       RowBox[{"FlasherFirstSectorVertices", "[", 
        RowBox[{"pp", ",", "r", ",", "h"}], "]"}], "/.", "vertrules"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"folded", " ", "form", " ", "circumcircle", " ", "diameter"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ffdia", "=", 
      RowBox[{"2", "*", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mag", "[", 
           RowBox[{"Take", "[", 
            RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], "/@", "ffverts"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"folded", " ", "form", " ", "height"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ffh", "=", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Last", "/@", "ffverts"}], "]"}], "-", 
       RowBox[{"Min", "[", 
        RowBox[{"Last", "/@", "ffverts"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"PART", " ", 
       RowBox[{"III", ":", " ", 
        RowBox[{"construct", " ", "a", " ", "TGraph3DAssigned"}]}]}], " ", 
      "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "lists", " ", "of", " ", "point", " ", "pairs", " ", "for", " ", "both",
        " ", "cp", " ", "and", " ", "ff"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"cpedges", "=", 
      RowBox[{
       RowBox[{"First", "/@", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"FlasherLines", "[", 
           RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "opts"}], "]"}], ",",
           "_Line", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], "/.", 
       "vertrules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ffedges", "=", 
      RowBox[{
       RowBox[{"First", "/@", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"FlasherLines", "[", 
           RowBox[{"pp", ",", "r", ",", "h", ",", "m", ",", "opts"}], "]"}], ",",
           "_Line", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], "/.", 
       "vertrules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"ordered", " ", "5"}], "-", "tuples"}], ",", " ", 
       RowBox[{"for", " ", "indexification"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"btedges", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Join", ",", 
        RowBox[{"{", 
         RowBox[{"cpedges", ",", "ffedges"}], "}"}], ",", "2"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"btedges", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"#", ",", 
          RowBox[{"-", "3"}]}], "]"}], "&"}], "/@", "verts"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", "verts"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MakeTGraph", "[", 
           RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraph"}], "//", 
         RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}], "//", 
        "RecalcFoldAngles"}], "//", 
       RowBox[{
        RowBox[{"ReassignGraph3D", "[", 
         RowBox[{"#", ",", "opts"}], "]"}], "&"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "a", " ", "table", " ", "of", " ", "all", " ", 
       "vertices", " ", "with", " ", "symbolic", " ", "values"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"allverts", "=", 
      RowBox[{"FlasherVertices", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "m"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvinds", "=", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Indexify", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"verts", ",", 
            RowBox[{"allverts", "/.", "vertrules"}]}], "]"}], "]"}], "\[LeftDoubleBracket]",
          "2", "\[RightDoubleBracket]"}], ",", 
        RowBox[{"-", 
         RowBox[{"Length", "[", "allverts", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ijkmap", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#1", "/.", 
            RowBox[{"{", 
             RowBox[{
              SubscriptBox["p", 
               RowBox[{"i_", ",", "j_", ",", "k_"}]], "\[RuleDelayed]", 
              RowBox[{"{", 
               RowBox[{"i", ",", "j", ",", "k"}], "}"}]}], "}"}]}], ",", 
           "#2"}], "}"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"allverts", ",", "allvinds"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"add", " ", "the", " ", "additional", " ", "properties"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"AddProperties", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FlasherR", "\[Rule]", "r"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherH", "\[Rule]", "h"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherM", "\[Rule]", "m"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherLabeledCPSectorGraphics", "\[Rule]", "cpsg"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FlasherLabeledFFSectorGraphics3D", "\[Rule]", "ffsg"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"FlasherCPGraphics", "\[Rule]", "cplg"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FlasherFFGraphics3D", "\[Rule]", "fflg"}], ",", 
         "\[IndentingNewLine]", " ", 
         RowBox[{"FlasherDetails", "\[Rule]", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            
            RowBox[{"\"\<central polygon incircle diameter\>\"", "\[Rule]", 
             "picdia"}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"\"\<central polygon circumcircle diameter\>\"", "\[Rule]",
              "pccdia"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             
             RowBox[{"\"\<crease pattern incircle diameter\>\"", "\[Rule]", 
              "cpicdia"}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"\"\<crease pattern circumcircle diameter\>\"", "\[Rule]",
               "cpccdia"}]}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"\"\<crease pattern incircle diameter\>\"", "\[Rule]", 
             "cpicdia"}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"\"\<folded form circumcircle diameter\>\"", "\[Rule]", 
             "ffdia"}], ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<outermost panel height\>\"", "\[Rule]", "oph"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"\"\<outermost panel width\>\"", "\[Rule]", "opw"}]}], 
           "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherIJKMap", "\[Rule]", "ijkmap"}]}], "}"}], "]"}]}]}]}],
