Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cc", ",", "\[Eta]", ",", "u0", ",", "u1", ",", "b", ",", "d", ",", "bb",
       ",", "dd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"0.5", " ", "#"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Eta]", "=", 
      RowBox[{
       RowBox[{"0.35", "\[Pi]"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "d", ",", "bb", ",", "dd"}], "}"}], "=", 
      RowBox[{"NRibbonPair", "[", 
       RowBox[{"cc", ",", "\[Eta]", ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"h", " ", "=", " ", "0.2"}], ",", "v0", ",", "v1", ",", "cd",
          ",", "rd"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v0", ",", "v1"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", ".5"}], ",", ".5"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cd", "=", "200"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rd", "=", "20"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Graphics3D", "[", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Styled3DAxes", "[", 
                 RowBox[{"1", ",", "1", ",", "1"}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"StyledRuledPatch", "[", 
                 RowBox[{"bb", ",", "dd", ",", 
                  RowBox[{"{", 
                   RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                  RowBox[{"CurveDivisions", "\[Rule]", "cd"}], ",", 
                  RowBox[{"RulingLineDivisions", "\[Rule]", "rd"}]}], "]"}], ",",
                 "\[IndentingNewLine]", 
                RowBox[{"StyledCurve", "[", 
                 RowBox[{"bb", ",", 
                  RowBox[{"{", 
                   RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                  RowBox[{"CurveDirected", "\[Rule]", "True"}], ",", 
                  RowBox[{"CurveDivisions", "\[Rule]", "cd"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"StyledVector", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"bb", "[", "u0", "]"}], ",", 
                    RowBox[{
                    RowBox[{"bb", "[", "u0", "]"}], "+", 
                    RowBox[{"dd", "[", "u0", "]"}]}]}], "}"}], ",", 
                  RowBox[{"VectorColor", "\[Rule]", "Orange"}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", "}"}]}], "}"}], ",", 
              RowBox[{"Lighting", "\[Rule]", 
               RowBox[{"NeutralLighting", "[", "0.8", "]"}]}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Graphics", "[", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Styled2DAxes", "[", 
                RowBox[{"1", ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
               RowBox[{"StyledRuledPatch", "[", 
                RowBox[{"b", ",", "d", ",", 
                 RowBox[{"{", 
                  RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"v0", ",", "v1"}], "}"}], ",", 
                 RowBox[{"CurveDivisions", "\[Rule]", "cd"}], ",", 
                 RowBox[{"RulingLineDivisions", "\[Rule]", "rd"}]}], "]"}], ",",
                "\[IndentingNewLine]", 
               RowBox[{"StyledCurve", "[", 
                RowBox[{"b", ",", 
                 RowBox[{"{", 
                  RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                 RowBox[{"CurveDirected", "\[Rule]", "True"}], ",", 
                 RowBox[{"CurveDivisions", "\[Rule]", "cd"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"StyledVector", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"b", "[", "u0", "]"}], ",", 
                   RowBox[{
                    RowBox[{"b", "[", "u0", "]"}], "+", 
                    RowBox[{"d", "[", "u0", "]"}]}]}], "}"}], ",", 
                 RowBox[{"VectorColor", "\[Rule]", "Brown"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
           "}"}], "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "]"}]}]}], 
