 "GenericGraphGraphics[",
 StyleBox["verts, edges, faces, opts",
  FontSlant->"Italic"],
 "]\n\t(options) VertexLabels, EdgeLabels, FaceLabels, DirectedEdges, \
VertexColor, EdgeColor, FaceColor, FaceColoring, Options[Graphics]"
}], "Subsubsection",
