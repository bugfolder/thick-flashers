   3.692267192408519*^9}},ExpressionUUID->"48a97ccc-bb8a-417b-89d4-\
8d9799380ce7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bl", ",", "cl", ",", "dl", ",", "el", ",", "br", ",", "cr", ",", "dr", ",",
       "er", ",", "xh", ",", "v0", ",", "vhl", ",", "vhr", ",", "f", ",", 
      "eqns", ",", "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bl", "=", 
      RowBox[{"cl", "=", 
       RowBox[{"{", 
        RowBox[{"fl", ",", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dl", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cos", "[", "ul", "]"}]}], ",", 
        RowBox[{"Sin", "[", "ul", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"br", "=", 
      RowBox[{"cr", "=", 
       RowBox[{"{", 
        RowBox[{"hr", ",", "ur"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dr", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"cl", "+", 
       RowBox[{"vl", " ", "dl"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xh", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v0", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xh", ".", "cl"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"xh", ".", "dl"}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xh", ".", "cr"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"xh", ".", "dr"}], ")"}]}]}], ")"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ul", "\[Rule]", "0"}], ",", 
         RowBox[{"ur", "\[Rule]", "0"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vhl", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"hl", "-", 
          RowBox[{"xh", ".", "cl"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"xh", ".", "dl"}], ")"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{"ul", "\[Rule]", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vhr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"hr", "-", 
          RowBox[{"xh", ".", "cr"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"xh", ".", "dr"}], ")"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{"ur", "\[Rule]", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"el", "=", 
      RowBox[{"cl", "+", 
       RowBox[{"vhl", " ", "dl"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"er", "=", 
      RowBox[{"cr", "+", 
       RowBox[{"vhr", " ", "dr"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cl", "+", 
           RowBox[{"vl", " ", "dl"}]}], ")"}], "\[Equal]", 
         RowBox[{"(", " ", 
          RowBox[{"cr", "+", 
           RowBox[{"vr", " ", "dr"}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"vl", "+", "vr"}], "\[Equal]", "v0"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{"eqns", ",", 
           RowBox[{"{", 
            RowBox[{"vl", ",", "ul", ",", "vr"}], "}"}]}], "]"}], "/.", 
         RowBox[{
          RowBox[{"C", "[", "_", "]"}], "\[Rule]", "0"}]}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "f", ",", "bl", ",", "cl", ",", "dl", ",", "el", ",", "br", ",", 
          "cr", ",", "dr", ",", "er"}], "}"}], "/.", "soln"}], "/.", 
       RowBox[{"ur", "\[Rule]", "t"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.692263936845262*^9, 3.692264224881625*^9}, {
   3.692264326051414*^9, 3.6922644525306673`*^9}, {3.692264566136526*^9, 
   3.692264569857718*^9}, 3.6922646425228243`*^9, {3.692264706337067*^9, 
