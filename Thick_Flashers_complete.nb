Cell["\<\
TObj class: TYoshimuraOri
\tInherits from: TGraph3D, TAssigned, TCornerIndices, TGeneratingVertex\
\>", "Subsubsection",
 CellChangeTimes->{{3.592466313181075*^9, 3.592466323480549*^9}, 
   3.5926554192185497`*^9, 3.592828986137012*^9, 3.592829322587101*^9, 
   3.594741298380731*^9, 3.59498708801229*^9, {3.594991697107541*^9, 
   3.594991703226702*^9}, {3.59499196736926*^9, 3.59499197727188*^9}, 
   3.5950109222164187`*^9, {3.5950110640507298`*^9, 3.595011064354879*^9}, {
   3.595018821441722*^9, 3.595018821703145*^9}, 3.616162456654442*^9, {
   3.643277199257018*^9, 
   3.643277205983725*^9}},ExpressionUUID->"940e2aed-b740-439d-9b14-\
5faf7eeb506a"],

Cell["\<\
TYoshimuraOri is a TObj class that specifies a periodic grid of identical but \
alternating degree-6 vertices forming an array of identical triangles in the \
Yoshimura pattern. In the folded form, it coils up cylindrically and has two \
degrees of freedom in its motion.\
\>", "Text",
 CellChangeTimes->{{3.5924389566806183`*^9, 3.592438972831851*^9}, {
   3.592466848517621*^9, 3.592466873209172*^9}, 3.592829322670081*^9, 
   3.594987088123068*^9, {3.59499170776258*^9, 3.594991748206812*^9}, {
   3.5949917906042*^9, 3.594991791996702*^9}, {3.5950109223472*^9, 
   3.595010965913848*^9}, {3.616162426170517*^9, 3.61616245768964*^9}, {
   3.616162512908448*^9, 
   3.6161625165399427`*^9}},ExpressionUUID->"cfde79b0-6145-4e00-9f2e-\
b17e11d67736"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TYoshimuraOri", "::", "usage"}], 
   "=", "\"\<TYoshimuraOri is a TObj class that specifies a periodic grid of \
alternating degree-6 vertices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592438990875565*^9, 3.592438997072279*^9}, {
  3.592829322730996*^9, 3.5928293227554483`*^9}, {3.594987088152017*^9, 
