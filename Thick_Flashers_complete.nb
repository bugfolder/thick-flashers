Cell[BoxData[
 RowBox[{
  RowBox[{"FrenetRibbonPlotPair", "[", 
   RowBox[{
    RowBox[{"c_Function", "|", "c_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "rw", ",", "gopts", ",", "csys", ",", "cc", ",", "b", ",", "n", ",", 
      "ip", ",", "cd", ",", "bcolor", ",", "ncolor", ",", "gb", ",", "gn"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rw", "=", 
      RowBox[{
       RowBox[{"FrenetRibbonWidth", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FrenetRibbonPlotPair", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"NCurve3DSystem", "[", 
       RowBox[{"c", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cc", ",", "b", ",", "n"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Curve3D", ",", "BinormalVector3D", ",", "NormalVector3D"}], 
        "}"}], "/.", "csys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bcolor", "=", 
      RowBox[{"BinormalVectorColor", "/.", "CurveVectorStyle"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ncolor", "=", 
      RowBox[{"NormalVectorColor", "/.", "CurveVectorStyle"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gn", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StyledCurve", "[", 
          RowBox[{"c", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
           "opts"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"StyledRuledPatch", "[", 
           RowBox[{"c", ",", "n", ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "rw"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"FillStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"FaceForm", "[", 
                RowBox[{"ncolor", ",", 
                 RowBox[{"Lighter", "[", 
                  RowBox[{"ncolor", ",", ".5"}], "]"}]}], "]"}], ",", 
               RowBox[{"Opacity", "[", "0.85", "]"}], ",", 
               RowBox[{"EdgeForm", "[", "]"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", "opts"}], "]"}], "//", "AddShadow"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gb", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StyledCurve", "[", 
          RowBox[{"c", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
           "opts"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"StyledRuledPatch", "[", 
           RowBox[{"c", ",", "b", ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "rw"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"FillStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"FaceForm", "[", 
                RowBox[{"bcolor", ",", 
                 RowBox[{"Lighter", "[", 
                  RowBox[{"bcolor", ",", ".5"}], "]"}]}], "]"}], ",", 
               RowBox[{"Opacity", "[", "0.85", "]"}], ",", 
               RowBox[{"EdgeForm", "[", "]"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", "opts"}], "]"}], "//", "AddShadow"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"gn", ",", "gb"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8006426770936327`*^9, 3.800642737651057*^9}, {
   3.800642997565138*^9, 3.800643063701736*^9}, {3.800643104133912*^9, 
   3.80064311901532*^9}, {3.800643163589694*^9, 3.800643181005501*^9}, {
   3.800643222550452*^9, 3.800643228845006*^9}, {3.800643282008358*^9, 
   3.80064331692667*^9}, {3.800643366257798*^9, 3.800643379918647*^9}, {
   3.800643442490506*^9, 3.80064351854567*^9}, {3.800643550754587*^9, 
   3.800643583210123*^9}, {3.800643622492432*^9, 3.800643659161113*^9}, {
   3.800643696187435*^9, 3.8006437214278393`*^9}, {3.800643790539554*^9, 
   3.800643792337624*^9}, 3.800643862860834*^9, {3.800644105174119*^9, 
   3.800644136645259*^9}, {3.800644188416338*^9, 3.800644257782213*^9}, {
   3.8006443006803617`*^9, 3.800644358565776*^9}, {3.800647971758624*^9, 
   3.8006479975714483`*^9}, {3.800652625684186*^9, 3.800652630568808*^9}, {
   3.800653596263496*^9, 3.800653602119383*^9}, {3.803913188216698*^9, 
   3.803913198093789*^9}, {3.803913265360863*^9, 3.803913276547201*^9}, {
   3.803913411611133*^9, 3.803913419022517*^9}, {3.80391455888968*^9, 
   3.803914561149759*^9}},
 CellLabel->
