Cell[BoxData[
 RowBox[{
  RowBox[{"SplitGraph2DGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts2d", ",", "edges", ",", "sfl", ",", "sinfo", ",", "p", ",", "r", ",",
       "vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo", ",", "et", ",", 
      "elems", ",", "fj", ",", "j", ",", "p1", ",", "p2", ",", "q1", ",", 
      "q2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TSplitGraph2D", ",", "SplitGraph2DGraphics"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", "edges", ",", "sfl", ",", "sinfo"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices2D", ",", "Edges", ",", "SplitFoldLine", ",", "SplitInfo"}],
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "r"}], "}"}], "=", "sfl"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vfinfo", ",", "efinfo", ",", "esinfo", ",", "fsinfo"}], "}"}],
       "=", "sinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "make", " ", "a", " ", "lookup", " ", "table", " ", "from", " ", 
       "split", " ", "edge", " ", "index", " ", "to", " ", "its", " ", 
       "split", " ", "parameter"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"et", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}], "=", 
         RowBox[{
         "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ")"}],
        "&"}], "/@", "esinfo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"elems", "=", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"folded", " ", "edges"}], ",", " ", 
         RowBox[{"no", " ", "labels", " ", "needed"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], "=", 
            RowBox[{"verts2d", "\[LeftDoubleBracket]", 
             RowBox[{"edges", "\[LeftDoubleBracket]", 
              RowBox[{
              "efinfo", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", "Blue"}], 
            "]"}]}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "efinfo", "]"}]}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"face", "-", 
           RowBox[{"splitting", " ", "edges"}]}], ",", " ", 
          RowBox[{"label", " ", "with", " ", "face", " ", "index"}]}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"fj", ",", "j"}], "}"}], "=", 
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"p1", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fj", "\[Equal]", "0"}], ",", 
              RowBox[{
              "verts2d", "\[LeftDoubleBracket]", "j", 
               "\[RightDoubleBracket]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"q1", ",", "q2"}], "}"}], "=", 
                RowBox[{"verts2d", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "edges", "\[LeftDoubleBracket]", "j", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"q1", "+", 
                RowBox[{
                 RowBox[{"et", "[", "j", "]"}], 
                 RowBox[{"(", 
                  RowBox[{"q2", "-", "q1"}], ")"}]}]}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"fj", ",", "j"}], "}"}], "=", 
            RowBox[{"fsinfo", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"p2", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fj", "\[Equal]", "0"}], ",", 
              RowBox[{
              "verts2d", "\[LeftDoubleBracket]", "j", 
               "\[RightDoubleBracket]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"q1", ",", "q2"}], "}"}], "=", 
                RowBox[{"verts2d", "\[LeftDoubleBracket]", 
                 RowBox[{
                 "edges", "\[LeftDoubleBracket]", "j", 
                  "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"q1", "+", 
                RowBox[{
                 RowBox[{"et", "[", "j", "]"}], 
                 RowBox[{"(", 
                  RowBox[{"q2", "-", "q1"}], ")"}]}]}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", "Blue"}], 
            "]"}]}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "fsinfo", "]"}]}], "}"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", 
             RowBox[{"p", "+", "r"}]}], "}"}], "]"}], ",", "LightGray"}], 
         "]"}], "]"}], ",", 
       RowBox[{"Graph2DGraphics", "[", 
        RowBox[{"tobj", ",", "opts"}], "]"}], ",", 
       RowBox[{"Graphics", "[", "elems", "]"}]}], "]"}]}]}], "]"}]}]], "Input",\

