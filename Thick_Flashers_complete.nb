                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                 "da", "\[LeftDoubleBracket]", "3", 
                  "\[RightDoubleBracket]"}]}], "]"}]}]}], "]"}]}], "]"}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nh"}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nv"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"\"\<vertical\>\"", " ", "folds"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ei", "=", 
           RowBox[{
            RowBox[{"nh", 
             RowBox[{"(", 
              RowBox[{"nv", "+", "1"}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "-", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"nh", "+", "1"}], ")"}]}], "+", "i", "+", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "===", "B"}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", 
               RowBox[{"i", "+", "j"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                 "da", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "types", "\[LeftDoubleBracket]", "ei", 
                "\[RightDoubleBracket]"}], "=", 
               RowBox[{"FoldAngleToType", "[", 
                RowBox[{
                 RowBox[{
                 "foldangles", "\[LeftDoubleBracket]", "ei", 
                  "\[RightDoubleBracket]"}], "=", 
                 RowBox[{
                 "da", "\[LeftDoubleBracket]", "4", 
                  "\[RightDoubleBracket]"}]}], "]"}]}]}], "]"}]}], "]"}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "nv"}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nh"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gtobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"gtobj", "//", 
          RowBox[{"ReplaceProperty", "[", 
           RowBox[{"EdgeTypes", "\[Rule]", "types"}], "]"}]}], "//", 
         "AddTPlaneGraph"}], "//", 
        RowBox[{"AddTGeneratingVertex", "[", "vtobj", "]"}]}], "//", 
       RowBox[{"AddClass", "[", 
        RowBox[{"THuffmanGrid", ",", 
         RowBox[{"{", 
          RowBox[{"FoldLengths", "\[Rule]", "dd"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Now", " ", "fold", " ", "the", " ", "graph", " ", "into", " ", "3", 
       "D"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"And", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "foldangles"}], 
         ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"gtobj", "//", "AddTGraph3D"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FoldGraph3D", "[", 
        RowBox[{"gtobj", ",", "foldangles"}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
