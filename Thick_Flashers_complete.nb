  3.6290329071752987`*^9}},ExpressionUUID->"571c218f-1ef8-4f6d-a070-\
b7ce1daa4168"],

Cell[TextData[{
 "BoundingBox[",
 StyleBox["plist",
  FontSlant->"Italic"],
 "] return the bounding box {{",
 StyleBox["xmin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xmax",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["ymin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ymax",
  FontSlant->"Italic"],
 "}} of a list of points."
}], "Text",
 CellChangeTimes->{{3.628872098480035*^9, 
  3.628872116485949*^9}},ExpressionUUID->"06ab13e9-ddc2-4b81-9992-\
c43f6fc43e13"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BoundingBox", "[", "plist_List", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Min", "[", "#", "]"}], ",", 
      RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
   RowBox[{"Transpose", "[", "plist", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.628872149422714*^9, 3.628872150934861*^9}, {
  3.628872233074286*^9, 3.628872304600228*^9}, {3.628872388380148*^9, 
