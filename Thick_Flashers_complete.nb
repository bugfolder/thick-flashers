   3.592522083096574*^9, {3.5925224807301197`*^9, 3.5925226061331663`*^9}, 
   3.592828742641827*^9, {3.592828811358174*^9, 3.592828811408651*^9}, {
   3.592828909531435*^9, 3.592828909598773*^9}, {3.592871136256804*^9, 
