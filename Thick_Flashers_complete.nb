Cell["\<\
Example. Nonconvex polygon, will use triangulation of the polygon.\
\>", "Text",
 CellChangeTimes->{{3.628863501119346*^9, 
  3.628863512238497*^9}},ExpressionUUID->"280056b6-c09d-4baa-b6d1-\
