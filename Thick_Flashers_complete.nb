Cell["\<\
Another example, this time a degree-6 vertex that\[CloseCurlyQuote]s roughly \
waterbomb-base-like.\
\>", "Text",
 CellChangeTimes->{{3.6161759633613453`*^9, 3.616175969735732*^9}, {
  3.616176179883488*^9, 
  3.616176186889399*^9}},ExpressionUUID->"62cd0e59-f691-4498-b0d8-\
db3e7aeab710"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gfn", ",", "dirs", ",", "dirs2", ",", "dirs3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"gfn", "[", 
       RowBox[{"dirs1_", ",", "label_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tobj", "=", 
          RowBox[{"MakeTVertex3DFromFoldVectors", "[", "dirs1", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", "label", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Sector angles/\[Degree]\>\"", "\[Rule]", 
           RowBox[{
            RowBox[{"tobj", "[", "SectorAngles", "]"}], "/", "\[Degree]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Fold angles/\[Degree]\>\"", "\[Rule]", 
           RowBox[{
            RowBox[{"tobj", "[", "DihedralAngles", "]"}], "/", 
            "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Developability excess/\[Degree]\>\"", " ", "\[Rule]", 
           RowBox[{
            RowBox[{"DevelopabilityExcess", "[", 
             RowBox[{"tobj", "[", "SectorAngles", "]"}], "]"}], "/", 
            "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Flat-foldability excess/\[Degree]\>\"", " ", "\[Rule]", 
           RowBox[{
            RowBox[{"FlatFoldabilityExcess", "[", 
             RowBox[{"tobj", "[", "SectorAngles", "]"}], "]"}], "/", 
            "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Vertex3DGraphicsTrio", "[", "tobj", "]"}], "/.", 
           RowBox[{"Vertex3DStyle", "[", "]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dirs", "=", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{".5", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", ".5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1", ",", ".5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", ".5"}], ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", ".8"}], ",", ".5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", ".8"}], ",", ".5"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationXMatrix3D", "[", 
          RowBox[{"50.", "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
       "dirs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"original", " ", "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"dirs", ",", "\"\<Initial vertex\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"developable", ",", " ", 
       RowBox[{"not", " ", "necessarily", " ", "flat", " ", "foldable"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dirs2", "=", 
      RowBox[{"MakeFoldVectorsDevelopable", "[", 
       RowBox[{"dirs", ",", 
        RowBox[{"ForceFlatFoldable", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"dirs2", ",", "\"\<Developable vertex\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"developable", " ", "and", " ", "flat", " ", "foldable"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dirs3", "=", 
      RowBox[{"MakeFoldVectorsDevelopable", "[", 
       RowBox[{"dirs", ",", 
        RowBox[{"ForceFlatFoldable", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gfn", "[", 
      RowBox[{"dirs3", ",", "\"\<Flat-foldable vertex\>\""}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.44261767602177*^9, 3.442617908683637*^9}, {
   3.442618034697379*^9, 3.442618064486623*^9}, 3.442671214328623*^9, {
