Cell["\<\
Same thing, but include center vertex, assign creases, override border.\
\>", "Text",
 CellChangeTimes->{{3.5940575978062353`*^9, 3.5940575985016336`*^9}, {
  3.594058948417242*^9, 3.594058958710631*^9}, {3.594068994441584*^9, 
  3.5940689963836713`*^9}, {3.594069127629762*^9, 3.5940691603882027`*^9}, {
  3.594071080482879*^9, 
  3.594071086657009*^9}},ExpressionUUID->"67148b06-e129-41fe-a080-\
45b9188b04ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nr", ",", "na", ",", "vfn", ",", "erfn", ",", "eafn", ",", "tobj"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nr", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"na", "=", "6"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", "i", ")"}], 
       RowBox[{"U", "[", 
        RowBox[{"2", "\[Pi]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", "-", "1"}], ")"}], "/", "na"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"erfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", "M"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eafn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", "V"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRotationalMesh", "[", 
       RowBox[{"nr", ",", "na", ",", "vfn", ",", 
        RowBox[{"RadialEdgeFn", "\[Rule]", "erfn"}], ",", 
        RowBox[{"AxialEdgeFn", "\[Rule]", "eafn"}], ",", 
        RowBox[{"IncludeCenter", "\[Rule]", "True"}], ",", 
        RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594057643412326*^9, 3.5940577370554457`*^9}, {
   3.5940579825602827`*^9, 3.594057989712686*^9}, {3.59405826556793*^9, 
   3.59405844221087*^9}, {3.594058525206237*^9, 3.594058527919942*^9}, {
   3.59405871575379*^9, 3.594058752216541*^9}, {3.594058900101481*^9, 
   3.594058922692294*^9}, {3.594058982187069*^9, 3.594059011272228*^9}, {
   3.594059196995329*^9, 3.5940592280087233`*^9}, 3.594060037453629*^9, 
   3.594060498083675*^9, {3.594061590129327*^9, 3.594061682060021*^9}, {
   3.5940618741444473`*^9, 3.594061918084995*^9}, {3.594061973721918*^9, 
   3.594061993576104*^9}, {3.594062045677178*^9, 3.594062047075718*^9}, {
   3.594068960721479*^9, 3.594068977364011*^9}, {3.594069146253336*^9, 
   3.594069146613665*^9}, 3.594069771336979*^9, 3.594070880442315*^9, {
   3.594071090925458*^9, 3.5940711034055843`*^9}, 3.594734257539678*^9, 
   3.594734827835763*^9, 3.595200527403414*^9, 3.595286135100136*^9, 
   3.617444348390785*^9, 3.6174444066356983`*^9},
 CellLabel->
  "In[2089]:=",ExpressionUUID->"b41d0681-3ec9-4c4b-9eba-ab0abadc2fed"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Rigidly foldable quad mesh", "Subsection",
 CellChangeTimes->{{3.69252864669431*^9, 3.692528649820389*^9}, {
  3.692530192629635*^9, 
  3.692530196874422*^9}},ExpressionUUID->"f580a1da-4715-49d8-85dd-\
69f3bd1c1388"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.7010903382024*^9, 
  3.701090338649734*^9}},ExpressionUUID->"6c5c126b-6600-476b-8e0d-\
5ae4b3ea70d8"],

Cell["\<\
A rigidly foldable quad mesh is a quad mesh whose vertices are developable \
and flat-foldable and for which an intermediate state exists (between \
unfolded and flat-folded). This then satisfies Tachi\[CloseCurlyQuote]s \
criteria that enables the pattern to be rigidly foldable continuously from \
unfolded to flat-folded.\
\>", "Text",
 CellChangeTimes->{{3.701090340361405*^9, 
  3.701090412851505*^9}},ExpressionUUID->"c6988c76-ac5e-409c-a55c-\
e604c6627d9b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RigidlyFoldableQuadMesh[{\[Phi]b, \[Gamma]b}, {\[Phi]l, \[Gamma]l}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) DefaultMinimumEdgeLength, MinimumEdgeLengths, BaseFaces, \
Rectangular, CornerAngles, AddPlaneGraph, PrintSectorsOnFail, \
SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{
  3.6925301813690243`*^9, {3.692556608503007*^9, 3.692556627610016*^9}, {
   3.692556691489829*^9, 3.692556693995457*^9}, {3.692556819146328*^9, 
   3.692556824558717*^9}, {3.6925569136713247`*^9, 3.692556960480152*^9}, {
   3.692557115696692*^9, 3.6925571281128273`*^9}, {3.692557563279008*^9, 
   3.692557583110711*^9}, {3.692557990279798*^9, 3.692558020252495*^9}, 
   3.692560864842564*^9, {3.692905718966328*^9, 3.692905726139516*^9}, {
   3.692910063851471*^9, 3.692910073783868*^9}, {3.692910194078891*^9, 
   3.6929101958676043`*^9}, {3.692971360563498*^9, 3.692971368100273*^9}, {
   3.692971776688869*^9, 3.69297179698332*^9}, {3.692971916034182*^9, 
   3.692971928602662*^9}, {3.692998384510713*^9, 3.6929983882556977`*^9}, {
   3.69339488967223*^9, 3.6933949074353123`*^9}, {3.69341916331975*^9, 
   3.6934191698798723`*^9}, {3.693522071045277*^9, 3.693522080739418*^9}, {
   3.693579752659986*^9, 
   3.693579756372553*^9}},ExpressionUUID->"2a3fdee5-3a32-4027-baa0-\
12fe1b606c0c"],

Cell[TextData[{
 "RigidlyFoldableQuadMesh[{\[Phi]b, \[Gamma]b}, {\[Phi]l, \[Gamma]l}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a rigidly foldable quadrilateral mesh from a specification of \
fold directions and fold angles along the bottom and left side."
}], "Text",
 CellChangeTimes->{{3.692465575594235*^9, 3.692465597926352*^9}, {
   3.692472917675828*^9, 3.692472937490591*^9}, {3.692530751476946*^9, 
   3.692530807311836*^9}, 3.692556641895246*^9, {3.692556913905599*^9, 
   3.692556960598774*^9}, {3.692557583234983*^9, 3.692557594085024*^9}, 
   3.692558049409748*^9, {3.692905718991124*^9, 3.6929057261650457`*^9}, {
   3.6929100008608513`*^9, 3.692910003817257*^9}, 3.692910091401548*^9, {
   3.692971360665504*^9, 3.692971368201468*^9}, {3.692971776782*^9, 
   3.692971797003713*^9}, {3.692971916055662*^9, 3.692971928620824*^9}, 
   3.6929719720682693`*^9},ExpressionUUID->"e53e68ac-c836-47ab-b9fa-\
e4844a080783"],

Cell["\<\
Arguments:
\t\[Phi]b \[LongDash] a list of direction angles for interior vertical creases.
\t\[Gamma]b \[LongDash] a list of fold angles for interior vertical creases, \
incremented along the bottom edge rightward.
\t\[Phi]l \[LongDash] a list of direction angles for interior horizontal \
creases.
\t\[Gamma]l \[LongDash] a list of fold angles for interior horizontal \
creases, incremented along the left edge upward.\
\>", "Text",
 CellChangeTimes->{{3.6924656146845207`*^9, 3.692465687853135*^9}, {
  3.69247291744122*^9, 3.69247293724092*^9}, {3.6924875239845877`*^9, 
  3.692487579477067*^9}, {3.692556914021967*^9, 3.692557031895155*^9}, {
  3.69255756339966*^9, 3.692557583359478*^9}, {3.692558028198482*^9, 
  3.692558037572132*^9}, {3.692558086195434*^9, 3.692558097646822*^9}, {
  3.692558144996994*^9, 3.692558150539214*^9}, {3.692560866678229*^9, 
  3.6925608692498198`*^9}, {3.692565222996891*^9, 3.692565291121049*^9}, {
  3.69290571901534*^9, 3.692905733846253*^9}, {3.692971360769115*^9, 
  3.6929713682971077`*^9}, {3.692971776879818*^9, 3.692971796192896*^9}, {
  3.692971916076754*^9, 3.692971927797304*^9}, {3.692998398205628*^9, 
  3.6929984093670397`*^9}},ExpressionUUID->"f4ba22e6-e996-4f73-b7df-\
5ec64809f2a8"],

Cell[TextData[{
 "Options:\n\tDefaultMinimumEdgeLength \[Rule] ",
 StyleBox["len",
  FontSlant->"Italic"],
 ", set the minimum edge length for all edges to ",
 StyleBox["len",
  FontSlant->"Italic"],
 ".\n\tMinimumEdgeLengths \[Rule] {{",
 StyleBox["d",
  FontSlant->"Italic"],
 ",",
 StyleBox["i",
  FontSlant->"Italic"],
 ",",
 StyleBox["j",
  FontSlant->"Italic"],
 ",",
 StyleBox["len",
  FontSlant->"Italic"],
 "}, ...}, set the minimum edge length for specific edges to ",
 StyleBox["len",
  FontSlant->"Italic"],
 ".\n\tBaseFaces \[Rule] {{",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j1",
  FontSlant->"Italic"],
 "},...}, specify faces that should be coplanar.\n\tRectangular \[Rule] True \
| False, specify that the paper shape is rectangular.\n\tCornerAngles \[Rule] \
\[Alpha] | {\[Alpha]bl, \[Alpha]br, \[Alpha]tr, \[Alpha]tl}, specify the \
corner angles for non-rectangular paper.\n\tAddPlaneGraph \[Rule] True | \
False, whether to try to build the plane graph for the pattern.\n\t\
PrintSectorsOnFail \[Rule] True | Fase, whether to print the sector angles if \
optimization fails.\n\tSamePtTolerance is passed through to MakeQuadMesh."
}], "Text",
 CellChangeTimes->{{3.692557133158628*^9, 3.69255715889799*^9}, 
   3.692565179402507*^9, {3.6929049012016478`*^9, 3.692904928156681*^9}, {
   3.692904972478196*^9, 3.692904983729025*^9}, 3.6929057262155647`*^9, {
   3.692910201289677*^9, 3.692910201509414*^9}, {3.692960358205618*^9, 
   3.6929604288052273`*^9}, 3.693394889694702*^9, {3.693394920445718*^9, 
   3.693394961595948*^9}, {3.693416571826275*^9, 3.693416572911647*^9}, {
   3.693419145264968*^9, 3.693419185327992*^9}, {3.6935220838753777`*^9, 
   3.693522113108575*^9}, {3.6935797590287747`*^9, 
   3.693579774325377*^9}},ExpressionUUID->"7403565a-38b2-41b5-9b73-\
3772c59b00bd"],

Cell["\<\
Returns: A TGraph3D+TAssigned giving the crease pattern and folded form.\
\>", "Text",
 CellChangeTimes->{{3.69246570397723*^9, 3.692465706169395*^9}, {
  3.692530123727072*^9, 
  3.692530144740151*^9}},ExpressionUUID->"9ddc30ab-0736-40a5-9bdc-\
468389d45d9f"],

Cell["\<\
Note: you can\[CloseCurlyQuote]t use the same fold angle (in absolute value) \
in both \[Gamma]b and \[Gamma]l, because that would force a sector angle to \
zero. If two same angles are detected, an error is thrown.\
\>", "Text",
 CellChangeTimes->{{3.692466721714527*^9, 3.692466771029137*^9}, {
  3.692530150038503*^9, 3.6925301698273373`*^9}, {3.692530714044979*^9, 
  3.6925307277713547`*^9}, {3.6925569141404667`*^9, 3.692556924266142*^9}, {
  3.692557061636278*^9, 3.692557084533499*^9}, {3.692971360872817*^9, 
  3.692971367149785*^9}},ExpressionUUID->"a6fbca26-2308-47f8-abef-\
de8777ab76d6"],

Cell["\<\
We create the smallest possible pattern, meaning the shortest total edge \
length that respects the minimum edge lengths and other constraints.\
\>", "Text",
 CellChangeTimes->{{3.692530763909621*^9, 3.692530769392566*^9}, {
  3.692530814156855*^9, 3.692530842705694*^9}, {3.692557092461822*^9, 
  3.6925570978156*^9}, {3.692904998896735*^9, 3.6929050014840317`*^9}, {
  3.692971980857341*^9, 3.6929719938248167`*^9}, {3.692998428945704*^9, 
  3.692998429635555*^9}},ExpressionUUID->"6503b1ab-e467-4c62-bef9-\
e93dd2e1bd6e"],

Cell["\<\
DefaultMinimimumEdgeLength sets a minimum length for all edges other than \
those that are overridden by MinimumEdgeLengths.\
\>", "Text",
 CellChangeTimes->{{3.693394988579587*^9, 
  3.693395017515596*^9}},ExpressionUUID->"3ca8fa2a-4a70-4895-a976-\
d1b4e9d80da9"],

Cell[TextData[{
 "MinimumEdgeLengths \[Rule] {{",
 StyleBox["d",
  FontSlant->"Italic"],
 ",",
 StyleBox["i",
  FontSlant->"Italic"],
 ",",
 StyleBox["j",
  FontSlant->"Italic"],
 ",",
 StyleBox["len",
  FontSlant->"Italic"],
 "}, ...} lets you set minimum edge lengths for specific edges, overriding \
the default:\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " = 0 to specify a horizontal edge, 1 for vertical edge\n\t",
 StyleBox["i,j",
  FontSlant->"Italic"],
 " are the edge indices\n\t",
 StyleBox["len",
  FontSlant->"Italic"],
 " is the desired length.\nYou can set a minimum edge length to zero, in \
which case, if it is not forced larger, the vertices at either end will be \
merged into a single vertex and some of the facets will become triangles."
}], "Text",
 CellChangeTimes->{{3.693395030995503*^9, 3.6933951093562098`*^9}, {
  3.693419567227749*^9, 
  3.693419612196547*^9}},ExpressionUUID->"67b523e1-770e-412e-b7cd-\
4a792b98ed09"],

Cell["\<\
If you give a list of face index pairs in BaseFaces, then the optimizer will \
strive to place the centroids of the listed faces to be in the same plane as \
the first one listed, and will furthermore strive to make all other vertices \
not part of those faces be at or above that level. This is useful for making \
facades that have a common back plane. You should pick faces that (according \
to their fold angles) will be parallel, typically the corner faces.\
\>", "Text",
 CellChangeTimes->{{3.692905005633629*^9, 3.692905121635525*^9}, {
  3.6929051604334927`*^9, 3.692905176783906*^9}, {3.692905212175859*^9, 
  3.6929052210764647`*^9}, {3.692905726240858*^9, 3.692905726264675*^9}, {
  3.692908220004413*^9, 3.6929082368674297`*^9}, {3.692910224093519*^9, 
  3.6929102247228603`*^9}, {3.693416640999935*^9, 
  3.6934166435681562`*^9}},ExpressionUUID->"5b4acb09-7e2f-4505-9ede-\
87a7a4b1e524"],

Cell["\<\
If Rectangular \[Rule] True (the default), we try to embed the crease pattern \
within a rectangular sheet of paper. This actually simplifies the problem \
(making it an LP), but it\[CloseCurlyQuote]s fairly easy to construct \
configurations for which there is no solution. If you set Rectangular \[Rule] \
False, then the outline is allowed to be irregular, and the solution space is \
larger. But this takes longer, especially for large arrays. Because this is \
now a general nonlinear search, there is no guarantee of finding a solution, \
even if one might exist.\
\>", "Text",
 CellChangeTimes->{{3.692998453211113*^9, 3.692998584789467*^9}, {
  3.693395128419962*^9, 
  3.693395151052479*^9}},ExpressionUUID->"efabfeb3-ba9a-498e-b754-\
700aa2d3e4bd"],

Cell["\<\
If you set Rectangular \[Rule] False, then the CornerAngles specification \
sets the angles of the four corner facets. 90\[Degree] gives right angles; \
180\[Degree] effectively trims off the corners.\
\>", "Text",
 CellChangeTimes->{{3.6933951704052343`*^9, 
  3.693395228348509*^9}},ExpressionUUID->"1bd62a11-1443-4708-b069-\
e449e0bfd830"],

Cell["\<\
If the crease pattern ends up self-crossing, it may not be possible to build \
the plane graph and AddTPlaneGraph, called internally, will throw an error \
and abort. You can disable construction of the plane graph by setting \
AddPlaneGraph \[Rule] False, to see what\[CloseCurlyQuote]s going on.\
\>", "Text",
 CellChangeTimes->{{3.6935221232831173`*^9, 
  3.6935222108531446`*^9}},ExpressionUUID->"90c51b85-df07-4430-9245-\
5b8e4f5e4581"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DefaultMinimumEdgeLength", "::", "usage"}], 
   "=", "\"\<DefaultMinimumEdgeLength is an option to RigidlyFoldableQuadMesh \
that specifies a default minimum edge length for all edges.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.692557224122755*^9, 3.69255725036574*^9}, {
  3.693394889709241*^9, 3.693394889714012*^9}, {3.693395299438323*^9, 
  3.693395304045072*^9}},
 CellLabel->
  "In[2090]:=",ExpressionUUID->"6cb18e99-5c42-4d61-b743-4b172cc80caf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MinimumEdgeLengths", "::", "usage"}], 
   "=", "\"\<MinimumEdgeLengths is an option to RigidlyFoldableQuadMesh that \
lets you set a minimum edge length for specific edges.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.692557224122755*^9, 3.69255725036574*^9}, {
  3.693394889709241*^9, 3.693394889714012*^9}, {3.693395290542369*^9, 
  3.693395322333004*^9}},
 CellLabel->
  "In[2091]:=",ExpressionUUID->"714a93a7-4248-4635-abe2-e0c2b95f5f82"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BaseFaces", "::", "usage"}], 
   "=", "\"\<BaseFaces is an option to RigidlyFoldableQuadMesh that specifies \
a set of faces that should be in the same plane.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.692557224122755*^9, 3.69255725036574*^9}, {
  3.692905136239948*^9, 3.692905155787466*^9}},
 CellLabel->
  "In[2092]:=",ExpressionUUID->"f2550e2a-f602-4588-ab7b-a0cf6c4c4284"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Rectangular", "::", "usage"}], 
   "=", "\"\<Rectangular is an option to RigidlyFoldableQuadMesh that \
specifies that the paper should be rectangular.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.692557224122755*^9, 3.69255725036574*^9}, {
   3.692905136239948*^9, 3.692905155787466*^9}, {3.692960446311367*^9, 
   3.692960459801346*^9}, 3.692960587794976*^9},
 CellLabel->
  "In[2093]:=",ExpressionUUID->"363fd679-7a22-4933-ae3b-a38c91e2b23c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CornerAngles", "::", "usage"}], 
   "=", "\"\<CornerAngles is an option to RigidlyFoldableQuadMesh that \
specifies the corner angles for non-rectangular paper.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.692557224122755*^9, 3.69255725036574*^9}, {
  3.692905136239948*^9, 3.692905155787466*^9}, {3.692960481043138*^9, 
  3.692960497895846*^9}},
 CellLabel->
  "In[2094]:=",ExpressionUUID->"cd72d991-59c2-42c3-9803-5a5a61b33071"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AddPlaneGraph", "::", "usage"}], 
   "=", "\"\<AddPlaneGraph is an option to RigidlyFoldableQuadMesh that \
specifies whether to construct the full plane graph for the pattern.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.693522248302335*^9, 3.693522282118431*^9}},
 CellLabel->
  "In[2095]:=",ExpressionUUID->"3616d323-5a3c-4c46-8ec2-78d7999109ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PrintSectorsOnFail", "::", "usage"}], 
   "=", "\"\<PrintSectorsOnFail is an option to RigidlyFoldableQuadMesh that \
specifies whether to print the sector angles if the optimization \
fails.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.693522248302335*^9, 3.693522282118431*^9}, {
  3.69357971561357*^9, 3.693579735860249*^9}},
 CellLabel->
  "In[2096]:=",ExpressionUUID->"bbc655c0-2d01-4148-aa26-24c104791c86"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RigidlyFoldableQuadMesh", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"DefaultMinimumEdgeLength", "\[Rule]", "1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"BaseFaces", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Rectangular", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"CornerAngles", "\[Rule]", 
      RowBox[{"90", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AddPlaneGraph", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PrintSectorsOnFail", "\[Rule]", "False"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.6925572049690437`*^9, 3.692557219346772*^9}, 
   3.692560891712945*^9, {3.692905125924782*^9, 3.69290513057853*^9}, {
