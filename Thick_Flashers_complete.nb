Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cc", ",", "sys"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cc", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"0.1", "#"}]}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sys", "=", 
