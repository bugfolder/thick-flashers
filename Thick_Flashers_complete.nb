Cell["\<\
Example. Show two sectors of the CP (note that x-y positions are still \
approximate) and the entire folded form projection as solved-for (this is now \
exact).\
\>", "Text",
 CellChangeTimes->{{3.9111474356173487`*^9, 3.911147440681382*^9}, {
  3.913543085230903*^9, 
  3.913543137610523*^9}},ExpressionUUID->"b8a799f6-5693-4a0f-89da-\
32b5371420cc"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", "ffprules", ",", 
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.2"}], ",", "lines", ",", "fsverts", ",", "gverts"}],
     "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ffprules", "=", 
     RowBox[{"MakeThickFlasherFFProjectionRules", "[", 
      RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"lines", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
        RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}], ",", 
       RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
        RowBox[{"p", ",", "r", ",", "h", ",", "1"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"lines", "=", 
       RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
        RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ")"}], "//", 
     "Hold"}], ";", "\[IndentingNewLine]", 
    RowBox[{"gverts", "=", 
     RowBox[{"Union", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{"lines", ",", 
        SubscriptBox["p", 
         RowBox[{"_", ",", "_", ",", "_"}]], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"fsverts", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"FlasherSectorVerticesRadiallyOrdered", "[", 
       RowBox[{"p", ",", "r", ",", "h"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Show", " ", "the", " ", "first", " ", "two", " ", "quadrants", " ", 
      "with", " ", "all", " ", 
      RowBox[{"vertices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Arrow", "[", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "]"}], ",", 
             RowBox[{"Switch", "[", 
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               ",", "\"\<mj\>\"", ",", 
               RowBox[{"Lighter", "[", 
                RowBox[{"Red", ",", "0.75"}], "]"}], ",", "\"\<mn\>\"", ",", 
               RowBox[{"Lighter", "[", 
                RowBox[{"Blue", ",", "0.75"}], "]"}], ",", "\"\<dg\>\"", ",", 
               "Green"}], "]"}]}], "]"}], "&"}], "/@", "lines"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"FlasherVertexLabel", "[", 
            RowBox[{"\"\<p\>\"", ",", "#"}], "]"}], "&"}], "/@", "gverts"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "/.", 
       RowBox[{"FlasherDefaultCPRules", "[", 
        RowBox[{"p", ",", "m"}], "]"}]}], "]"}], "//", "Print"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Show", " ", "the", " ", "FFP", " ", "with", " ", "first"}], "-", 
      RowBox[{"sector", " ", "vertices", " ", "labeled"}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"FlasherVertexLabel", "[", 
             
             RowBox[{"\"\<\!\(\*StyleBox[\"p\",FontWeight->\"Plain\"]\)\>\"", 
              ",", "#"}], "]"}], "&"}], "/@", "fsverts"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"FlasherLines", "[", 
           RowBox[{"p", ",", "r", ",", "h", ",", "m"}], "]"}]}], "}"}], "/.", 
        
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["p", 
           RowBox[{"i_", ",", "j_", ",", 
            RowBox[{"-", "1"}]}]], "->", 
          SubscriptBox["p", 
           RowBox[{"i", ",", "j", ",", 
            RowBox[{"m", "-", "1"}]}]]}], "}"}]}], "/.", "ffprules"}], "]"}], 
     "//", "Print"}], ";"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.911753382386656*^9, 3.9117535761407127`*^9}, {
   3.911753616478991*^9, 3.911753709598409*^9}, {3.911753913602195*^9, 
   3.911753914607492*^9}, {3.9117539635771723`*^9, 3.911753980464233*^9}, {
   3.911754138435783*^9, 3.911754139882535*^9}, {3.9117541771185637`*^9, 
   3.911754185506279*^9}, {3.911755479834599*^9, 3.911755480990782*^9}, {
   3.911755589826995*^9, 3.911755691473267*^9}, {3.9118155112068768`*^9, 
   3.911815511212103*^9}, 3.911902750142411*^9, 3.911988247961606*^9, {
   3.912573977836175*^9, 3.912573977840665*^9}, 3.913542927373022*^9, 
   3.913639328590372*^9, 3.9136394989563*^9, 3.913639555675648*^9},
 CellLabel->
  "In[4469]:=",ExpressionUUID->"c03cffe9-5a8c-4a26-a571-87ddcb11de90"],

Cell[TextData[{
 "Here\[CloseCurlyQuote]s how we treat the different types of corners in the \
FFP. ",
 StyleBox["a",
  FontWeight->"Bold"],
 " is the vertex we\[CloseCurlyQuote]re setting conditions on, ",
 StyleBox["b",
  FontWeight->"Bold"],
 " is the vertex immediately inside of this one, ",
 StyleBox["c",
  FontWeight->"Bold"],
 " and ",
 StyleBox["d",
  FontWeight->"Bold"],
 " are the vertices to either side of ",
 StyleBox["b",
  FontWeight->"Bold"],
 ". We have:\n\t(a) ordinary panels bending around a corner (both panels have \
thickness ",
 StyleBox["t",
  FontSlant->"Italic"],
 "),\n\t(b) a vertex that comes just after a split (left panel has thickness ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", right panel has maximum thickness ",
 StyleBox["t",
  FontSlant->"Italic"],
 "),\n\t(c) a panel that terminates on the outside edge (right panel has \
thickness ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", right angle across the terminating edge)."
}], "Text",
 CellChangeTimes->{{3.9116831636061373`*^9, 3.911683175869195*^9}, {
  3.911752499937959*^9, 3.911752531010345*^9}, {3.9134765201395283`*^9, 
  3.913476553595729*^9}, {3.9135431519434*^9, 3.913543212290745*^9}, {
  3.913639608790307*^9, 3.913639643887463*^9}, {3.913640040757564*^9, 
  3.913640083916312*^9}},ExpressionUUID->"81413a72-bbe8-4259-abf8-\
4512e17fec94"],

