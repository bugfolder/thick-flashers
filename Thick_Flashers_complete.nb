Cell[TextData[{
 "RotateSegment90[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}] rotates the line segment {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} by 90\[Degree] CCW."
}], "Text",
 CellChangeTimes->{{3.551817542759199*^9, 
  3.551817571903932*^9}},ExpressionUUID->"5177a65c-4751-482b-939e-\
837d1ccfad14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotateSegment90", "[", 
   RowBox[{"{", 
    RowBox[{"p1_", ",", "p2_"}], "}"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "=", 
       FractionBox[
        RowBox[{"p1", "+", "p2"}], "2"]}], ",", 
      RowBox[{"r", "=", 
       RowBox[{"Rotate90", "[", 
        FractionBox[
         RowBox[{"p2", "-", "p1"}], "2"], "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "-", "r"}], ",", 
      RowBox[{"s", "+", "r"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.551817520443983*^9, 3.551817540037963*^9}, {
  3.551817594361504*^9, 3.551817686730467*^9}},
 CellLabel->
  "In[268]:=",ExpressionUUID->"bbf5960f-d8f1-416f-bd8d-b6f616ed5f9c"],

