Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, Tiling, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a rendering of the tiling polygon. The central polygon edge types \
(M or V) get mapped to tiling edge directions."
}], "Text",
 CellChangeTimes->{{3.62982656442409*^9, 3.6298265729637203`*^9}, {
  3.629839528252887*^9, 
  3.629839551026307*^9}},ExpressionUUID->"1d3aab88-aa93-467d-9e49-\
548808df42ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "PolygonCenteredTwistTile", ",", "verts_List", ",", "w_", ",", "\[Tau]_",
       ",", "types_List"}], "}"}], ",", "Tiling", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "edgedirs", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TileCheckTypes", "[", 
      RowBox[{"verts", ",", "types"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"edgedirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#", "===", "M"}], ",", 
          RowBox[{"+", "1"}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "types"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RenderTile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"PolygonTile", ",", "verts"}], "}"}], ",", "Tiling", ",", 
       RowBox[{"TileEdgeArrowDirs", "\[Rule]", "edgedirs"}], ",", "opts"}], 
      "]"}]}]}], "]"}]}]], "Input",
