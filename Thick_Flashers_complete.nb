Cell[CellGroupData[{

Cell["Bird-foot vertex", "Subsubsection",
 CellChangeTimes->{{3.636737737789118*^9, 3.63673774223699*^9}, {
   3.64303804528495*^9, 3.6430380470124083`*^9}, 
   3.643052639039131*^9},ExpressionUUID->"2dcd0fef-579a-4ea9-9a2d-\
73dec6e44cbf"],

Cell["\<\
This symmetric bird-foot vertex is used to verify some trigonometric \
identities.\
\>", "Text",
 CellChangeTimes->{{3.636737743988981*^9, 3.6367377614043016`*^9}, 
   3.643052625781822*^9},ExpressionUUID->"c26b6d9c-9efa-434c-a56e-\
f52c5fa5f323"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]", ",", "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", 
      "\[Alpha]4", ",", "gp", ",", "gm", ",", "\[Gamma]1", ",", "\[Gamma]2", ",",
       "\[Gamma]3", ",", "\[Gamma]4", ",", "tobj", ",", "\[Zeta]", ",", 
      "\[Theta]", ",", "\[Beta]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"60", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
       "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]", "-", "\[Alpha]"}], ",", "\[Alpha]", ",", "\[Alpha]", 
        ",", 
        RowBox[{"\[Pi]", "-", "\[Alpha]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gp", "=", 
      RowBox[{"90", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gm", "=", 
      RowBox[{"2", 
       RowBox[{"ArcCot", "[", 
        RowBox[{
         RowBox[{"Sec", "[", "\[Alpha]", "]"}], 
         RowBox[{"Cot", "[", 
          FractionBox["gp", "2"], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4"}], 
       "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"gm", ",", "gp", ",", 
        RowBox[{"-", "gm"}], ",", "gp"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTDegree4Vertex3DFromSectorsAndDihedrals", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"tobj", "[", "OsculatingAngle", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Zeta]", "=", 
      RowBox[{"tobj", "[", "RulingAngle", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"\[Pi]", "-", "\[Zeta]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"bend", " ", "angle", " ", "of", " ", "minor", " ", "creases"}],
       " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Degree4Vertex3DFoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
       RowBox[{"Vertex3DStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "check", " ", "our", " ", "two", " ", "formulas", " ", "for", " ", 
       "ruling", " ", "angle", " ", "\[Zeta]"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<(computed) \[Zeta]/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{"\[Zeta]", "/", "\[Degree]"}], "//", "N"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<(algebraic) \[Zeta]/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"ArcCos", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", "\[Alpha]1", "]"}], 
            RowBox[{"Cos", "[", "\[Alpha]2", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
            RowBox[{"Sin", "[", "\[Alpha]2", "]"}], 
            RowBox[{"Cos", "[", "\[Gamma]2", "]"}]}]}], "]"}], "/", 
         "\[Degree]"}], "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Osculating angle: \[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], "-", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
           RowBox[{"Cos", "[", 
            RowBox[{"\[Gamma]1", "/", "2"}], "]"}]}]}], ")"}], "//", "N"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Ruling angle: \[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Zeta]", "/", "2"}], "]"}], "-", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Gamma]2", "/", "2"}], "]"}]}]}], ")"}], "//", "N"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Sector/Minor fold/bend angle: \[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Tan", "[", "\[Alpha]", "]"}], "-", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Gamma]3", "/", "2"}], "]"}], 
           RowBox[{"Tan", "[", 
            RowBox[{"\[Beta]", "/", "2"}], "]"}]}]}], ")"}], "//", "N"}]}], 
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.636737099119504*^9, 3.636737292486808*^9}, {
   3.636737357449512*^9, 3.636737522917156*^9}, {3.636737576045295*^9, 
   3.636737667162328*^9}, {3.636738011834751*^9, 3.6367380120230103`*^9}, {
   3.636738416952585*^9, 3.636738422372363*^9}, {3.636739743800666*^9, 
   3.636739789134014*^9}, {3.636742983366403*^9, 3.636743004110739*^9}, {
   3.643038132826898*^9, 3.643038241971085*^9}, {3.643038279202737*^9, 
   3.643038313471273*^9}, {3.643056621651829*^9, 3.643056644071173*^9}, {
   3.643062616847328*^9, 3.643062747644263*^9}, 3.691542009808185*^9, 
   3.691971165872299*^9},
 CellLabel->
  "In[2266]:=",ExpressionUUID->"15d6fec0-a79d-4be0-a325-9d681cc4ac15"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MaximumDihedralAngles",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[Alpha]", "1"], ",", 
      SubscriptBox["\[Alpha]", "2"], ",", 
      SubscriptBox["\[Alpha]", "3"], ",", 
      SubscriptBox["\[Alpha]", "4"]}], "}"}], "]"}], TraditionalForm]],
  ExpressionUUID->"c2a617ca-1726-4df3-9529-32a28ec417d8"]
}], "Subsubsection",
 CellChangeTimes->{{3.594992599574737*^9, 3.5949926286367826`*^9}, {
   3.594992669196424*^9, 3.594992670123527*^9}, 3.594993325297268*^9, {
   3.594993443036734*^9, 3.594993447982148*^9}, {3.594993697801972*^9, 
   3.59499370173578*^9}, {3.594993966376042*^9, 3.594993978295152*^9}, {
   3.59499403383575*^9, 3.594994041422181*^9}, 3.594994079776212*^9, {
   3.617226134259446*^9, 3.617226147135022*^9}, {3.6172264356625547`*^9, 
   3.617226451461521*^9}, 3.617258100303056*^9, {3.6172733029028883`*^9, 
   3.617273323080858*^9}},ExpressionUUID->"71780c25-b730-4472-8795-\
17b9b28fdf8e"],

Cell[TextData[{
 "MaximumDihedralAngles",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[Alpha]", "1"], ",", 
      SubscriptBox["\[Alpha]", "2"], ",", 
      SubscriptBox["\[Alpha]", "3"], ",", 
      SubscriptBox["\[Alpha]", "4"]}], "}"}], "]"}], TraditionalForm]],
  ExpressionUUID->"2649623c-feae-411c-a2ad-1f4358617350"],
 " takes a list of four sector angles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"], ",", 
     SubscriptBox["\[Alpha]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "a36d2ba3-497f-4be5-812e-2e4009b20be6"],
 " and returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], ",", 
     SubscriptBox["\[Gamma]", "2"], ",", 
     SubscriptBox["\[Gamma]", "3"], ",", 
     SubscriptBox["\[Gamma]", "4"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "9a18058d-5f93-4524-b205-8539623a627d"],
 " of the maximum reachable angles for all four dihedral angles, not \
considering limitations of binding (self-intersection). It returns \[Pi] if \
the fold can fully fold, less otherwise. All values are positive. This works \
for any cyclic permutation of sector angles, since the four formulas are just \
cyclic permutations of one another."
}], "Text",
 CellChangeTimes->{{3.594993454920213*^9, 3.594993509045392*^9}, {
   3.594993983646879*^9, 3.594993991406254*^9}, {3.594994047194995*^9, 
   3.594994061498309*^9}, {3.594995052802276*^9, 3.594995117693399*^9}, 
   3.6172260328927608`*^9, {3.617226134259878*^9, 3.617226184106699*^9}, 
   3.6172264555648947`*^9, {3.6172275804870872`*^9, 3.6172276243371687`*^9}, {
   3.61722769886471*^9, 3.617227782508271*^9}, {3.617227847338578*^9, 
   3.617227872774612*^9}, {3.617240059671732*^9, 3.617240108290438*^9}, 
   3.617273302969015*^9, {3.617273351446523*^9, 3.6172733776354*^9}, {
   3.617273448831284*^9, 3.61727345211862*^9}, {3.617308965535369*^9, 
   3.617308967060329*^9}, {3.6173132836609583`*^9, 3.617313297475589*^9}, {
   3.617434083656277*^9, 
   3.61743409652551*^9}},ExpressionUUID->"b610fc9c-1916-4a2d-8148-\
d52d0b3526d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MaximumDihedralAngles", "[", 
   RowBox[{"{", 
    RowBox[{
    "\[Alpha]1_", ",", "\[Alpha]2_", ",", "\[Alpha]3_", ",", "\[Alpha]4_"}], 
    "}"}], "]"}], ":=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"2", 
     RowBox[{"ArcSin", "[", 
      RowBox[{"Min", "[", 
       RowBox[{
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]2", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]3", "]"}]}], 
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]4", "]"}]}]]], ",", "1"}], "]"}], 
      "]"}]}], ",", 
    RowBox[{"2", 
     RowBox[{"ArcSin", "[", 
      RowBox[{"Min", "[", 
       RowBox[{
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]3", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]4", "]"}]}], 
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]2", "]"}]}]]], ",", "1"}], "]"}], 
      "]"}]}], " ", ",", "\[IndentingNewLine]", 
    RowBox[{"2", 
     RowBox[{"ArcSin", "[", 
      RowBox[{"Min", "[", 
       RowBox[{
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]4", "]"}]}], 
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]2", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]3", "]"}]}]]], ",", "1"}], "]"}], 
      "]"}]}], ",", 
    RowBox[{"2", 
     RowBox[{"ArcSin", "[", 
      RowBox[{"Min", "[", 
       RowBox[{
        SqrtBox[
         FractionBox[
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]2", "]"}]}], 
          RowBox[{
           RowBox[{"Sin", "[", "\[Alpha]3", "]"}], 
           RowBox[{"Sin", "[", "\[Alpha]4", "]"}]}]]], ",", "1"}], "]"}], 
      "]"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.594993522414315*^9, 3.594993576533063*^9}, {
   3.594993616290854*^9, 3.594993617496931*^9}, {3.594993994480795*^9, 
   3.594993994953587*^9}, {3.594995039665831*^9, 3.594995044229106*^9}, {
   3.617226134260384*^9, 3.617226148338157*^9}, {3.617226235031417*^9, 
   3.61722624430102*^9}, 3.617227685601824*^9, {3.617227789404098*^9, 
   3.617227814466631*^9}, {3.617239790966765*^9, 3.6172398911240683`*^9}, 
   3.61727330300132*^9, {3.617434119580174*^9, 3.617434134092392*^9}},
 CellLabel->
