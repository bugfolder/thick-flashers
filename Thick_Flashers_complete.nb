668c5b9440c7"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] an arbitrary directrix as a pure function.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] an arbitrary director as a pure function."
}], "Text",
 CellChangeTimes->{{3.691365169540002*^9, 3.69136520200457*^9}, {
