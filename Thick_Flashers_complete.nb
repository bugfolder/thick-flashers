Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTYoshimuraOri", "[", 
   RowBox[{"vtobj_TObj", ",", "d1_", ",", 
    RowBox[{"{", 
     RowBox[{"nh_", ",", "nv_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "al", ",", "gm", ",", "cv", ",", "d2", ",", "d3", ",", "d5", ",", "d6", ",",
       "ta", ",", "tb", ",", "ft1", ",", "ft2", ",", "verts", ",", "edges", ",",
       "faces", ",", "types", ",", "angles", ",", "gtobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"vtobj", ",", "TVertex"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"al", ",", "gm", ",", "cv"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"vtobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "SectorAngles", ",", "DihedralAngles", ",", "CreaseVectors"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "al", "]"}], "\[NotEqual]", "6"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTYoshimuraOri", "::", "badsize"}], ",", "vtobj", ",", 
