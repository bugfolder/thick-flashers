Cell[CellGroupData[{

Cell["2D circular vertices", "Section",
 CellChangeTimes->{{3.457635016614788*^9, 3.457635034315824*^9}, {
   3.4576351978549957`*^9, 3.457635201327177*^9}, 3.4576500686480722`*^9, {
