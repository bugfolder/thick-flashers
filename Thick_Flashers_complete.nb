Cell[BoxData[
 RowBox[{
  RowBox[{"ReshapeCone3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"b_Function", ",", "d_Function", ",", "\[Sigma]_"}], "}"}], ",", 
    "\[Beta]_Function", ",", "\[Psi]_", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "bbi_List", ",", "ddi_List", ",", "uui_List"}], 
     "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sim", ",", "as", ",", "sfn", ",", "dsopts", ",", "\[IndentingNewLine]", 
      "s", ",", "ds", ",", "t", ",", "l", ",", "u", ",", 
      "\[IndentingNewLine]", "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", 
      "sd\[Tau]g", ",", "\[IndentingNewLine]", "lli", ",", "tti", ",", "soln",
       ",", "ttx", ",", "tty", ",", "ttz", ",", "llx", ",", "lly", ",", "llz",
       ",", "uux", ",", "uuy", ",", "uuz", ",", "bbx", ",", "bby", ",", "bbz",
       ",", "\[IndentingNewLine]", "tt", ",", "ll", ",", "uu", ",", "bb", ",",
       "dd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sim", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ReshapeCone3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", 
        RowBox[{
         RowBox[{"Assumptions", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "ReshapeCone3D", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sim", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"sim", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"curve", " ", "speed"}], ",", " ", 
       RowBox[{
        RowBox[{"can", " ", "be", " ", "unit"}], "-", "speed"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]g", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Sigma]"}], " ", "\[Psi]", " ", 
          RowBox[{"Mag", "[", 
           RowBox[{
            RowBox[{"d", "'"}], "[", "s", "]"}], "]"}]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd\[Kappa]n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Beta]", "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd\[Tau]g", "=", 
      RowBox[{"0", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "remaining", " ", "initial", " ", "conditions", " ", "of", " ", 
       "Darboux", " ", "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"lli", "=", 
      RowBox[{
       RowBox[{"\[Sigma]", " ", "ddi"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tti", "=", 
      RowBox[{
       RowBox[{"lli", "\[Cross]", "uui"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "the", " ", "new", " ", "Darboux", " ", "frame"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bb", ",", "tt", ",", "ll", ",", "uu"}], "}"}], "=", 
      RowBox[{"RecoverDarboux3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ds", ",", "sd\[Kappa]g", ",", "sd\[Kappa]n", ",", "sd\[Tau]g"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "bbi", ",", "tti", ",", "lli", ",", "uui"}], 
         "}"}], ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "rotate", " ", "to", " ", "get", " ", "the", " ", "new", " ", 
       "director"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"\[Sigma]", " ", 
          RowBox[{"ll", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "discard", " ", "the", " ", "cross", " ", "curve", " ", "we", " ", 
       "calculated", " ", "and", " ", "replace", " ", "with", " ", "cone", " ",
        "point"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"bbi", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "return", " ", "the", " ", "new", " ", "cone", " ", 
       "parameterization"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "dd", ",", "\[Sigma]"}], "}"}]}]}], "]"}]}]], "Input",\

