Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", "tobj", ",", "pwjv"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0.5", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]", ",", 
           RowBox[{"\[Pi]", "/", "4"}]}], "}"}]}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRectangularPotWedge", "[", 
       RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", 
        RowBox[{"PotGapHalfAngle", "\[Rule]", 
         RowBox[{"4", "\[Degree]"}]}], ",", 
        RowBox[{"PotFlangeExcess", "\[Rule]", "0.5"}], ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"10", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pwjv", "=", 
      RowBox[{"tobj", "[", "PotWedgeJoinVertices", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", "pwjv", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
