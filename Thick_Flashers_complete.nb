Cell["\<\
Example: a self-similar size reduction of a polygon. Requires an acute \
triangulation, which we currently have to build manually. Use \
GenericFoldedFormGraphics because VisibleFoldedFormGraphics takes too long to \
compute the overlaps.\
\>", "Text",
 CellChangeTimes->{{3.6151455854790893`*^9, 3.615145609524642*^9}, {
  3.615145690307689*^9, 3.615145691662138*^9}, {3.675959106754179*^9, 
  3.675959108538287*^9}},ExpressionUUID->"412c85dc-97e4-40ec-b61a-\
9c5b249ba2d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "gpoly", ",", "dverts", ",", "tobjtri", ",", 
      "tobjpd", ",", "tobjpd1", ",", "tobjpd2", ",", "fv", ",", "ev", ",", 
      "av", ",", "tobjft"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"set", " ", "up", " ", "a", " ", "polygon"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.1", ",", 
          RowBox[{"-", "0.3"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.7", ",", "1.8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".9", ",", "1.4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "1.8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", ".4"}], ",", "1.3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{".2", ",", "0.9"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gpoly", "=", 
      RowBox[{"GenericGraphGraphics", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", "verts"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"manually", " ", "create", " ", "an", " ", "acute", " ", 
       RowBox[{"triangulation", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"edges", " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"edges", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"9", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"6", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"9", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"9", ",", "7"}], "}"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjtri", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraphTo"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Construct", " ", "new", " ", 
       RowBox[{"primal", "/", "dual"}], " ", "graph", " ", "that", " ", 
       "includes", " ", "dual", " ", "vertices", " ", "and", " ", "midpoints",
        " ", "of", " ", "boundary", " ", "edges"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"face", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fv", "=", 
      RowBox[{"FaceCircumcenters", "[", "tobjtri", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edge", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ev", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"verts", " ", "+", " ", 
         RowBox[{"RotateLeft", "[", "verts", "]"}]}], ")"}], "/", "2"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"all", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"av", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"verts", ",", "ev", ",", "fv"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"av", ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "10"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"10", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "11"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"11", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "12"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"12", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "13"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"13", ",", "5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "14"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"14", ",", "6"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "15"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"15", ",", "7"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"7", ",", "16"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"16", ",", "8"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"8", ",", "17"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"17", ",", "9"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"9", ",", "18"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"18", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"10", ",", "19"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"19", ",", "24"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"24", ",", "18"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"19", ",", "11"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"24", ",", "25"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"25", ",", "20"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"20", ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"25", ",", "22"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"22", ",", "23"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"23", ",", "17"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"23", ",", "16"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"22", ",", "15"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"20", ",", "21"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"21", ",", "13"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"21", ",", "14"}], "}"}]}], "}"}]}], "]"}], "//", 
       "AddTPlaneGraphTo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Construct", " ", "dual", " ", "graph", " ", "and", " ", "reciprocal", " ",
        "diagram", " ", 
       RowBox[{"(", 
        RowBox[{"not", " ", "necessarily", " ", "orthogonal"}], ")"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjpd1", " ", "=", " ", 
      RowBox[{
       RowBox[{"tobjpd", " ", "//", "AddTPrimalDualGraph"}], "//", 
       "MakeReciprocalDiagram"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "set", " ", "dual", " ", "vertices", " ", "to", " ", "original", " ", 
        "vertices"}], ",", " ", 
       RowBox[{
       "which", " ", "will", " ", "establish", " ", "orthogonality"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjpd2", "=", 
      RowBox[{"tobjpd1", "//", 
       RowBox[{"ReplaceProperty", "[", 
        RowBox[{"DualVertices", "\[Rule]", "dverts"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "And", " ", "make", " ", "the", " ", "flagstone", " ", "tessellation"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjft", "=", 
      RowBox[{"MakePrimalDualFlagstoneTessellation", "[", 
       RowBox[{"tobjpd2", ",", "0.85"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"gpoly", ",", 
           RowBox[{"GraphGraphics", "[", "tobjtri", "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"GraphGraphics", "[", "tobjpd", "]"}], ",", 
           RowBox[{"PrimalDualGraphics", "[", "tobjpd1", "]"}], ",", 
           RowBox[{"PrimalDualGraphics", "[", "tobjpd2", "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"CreasePatternGraphics", "[", "tobjft", "]"}], ",", 
           RowBox[{"GenericFoldedFormGraphics", "[", "tobjft", "]"}]}], 
          "\[IndentingNewLine]", "}"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.615140710753853*^9, 3.615140997696553*^9}, {
   3.615141069783462*^9, 3.61514118950824*^9}, {3.615141290668889*^9, 
