   RowBox[{"DirectedAngle3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1."}], "}"}]}], "]"}], "/", "\[Degree]"}], 
  " ", "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.441837024540153*^9, 3.441837096445868*^9}, 
   3.442671213490768*^9, {3.457703675336994*^9, 3.457703678752977*^9}, 
   3.496237773701942*^9, {3.496238134189416*^9, 3.496238162067853*^9}, 
   3.591978819988112*^9, 3.628786319953611*^9},
