    RowBox[{"{", 
     RowBox[{"tobj", ",", "f1", ",", "f2", ",", "sinfo", ",", "tobj1"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"SingleVertexGraph2D", "//", "RebuildPlaneGraph"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f1", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", ".1"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1.3"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeSplitGraph2D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"f1", ",", 
          RowBox[{"f2", "-", "f1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<All split information\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SplitGraphGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SplitGraph2DGraphics", "[", "tobj", "]"}]}], "}"}], "]"}], "//",
