         RowBox[{"9", ",", "12"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "the", " ", "new", " ", "woven", " ", "tessellation"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjw", "=", 
      RowBox[{"MakeSimpleWovenTessellation", "[", 
       RowBox[{"tobj", ",", ".15", ",", 
        RowBox[{"WovenParity", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"WovenPeriodicity", "\[Rule]", "wper"}], ",", 
        RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Turn", " ", "over", " ", "the", " ", "folded", " ", "form"}], 
