Cell[CellGroupData[{

Cell["Quadrilateral offset split-twist tiles", "Subsubsection",
 CellChangeTimes->{{3.630164173466615*^9, 
  3.630164179521942*^9}},ExpressionUUID->"c0eb769f-411f-4569-8178-\
e2fdca24d65c"],

Cell["\<\
Here we make an array of four quadrilateral offset split-twist tiles, \
choosing a different degree-6 vertex for each to give a symmetric pattern.\
\>", "Text",
 CellChangeTimes->{{3.630164182954343*^9, 
  3.630164217207653*^9}},ExpressionUUID->"ba96ecd5-9f29-4899-9077-\
6f5d19b7ed34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "w", ",", "d", ",", "name", ",", "angles", ",", "side", ",", "is", ",", 
      "tiling", ",", "cp", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", "0.18"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.12"}], ";", "\[IndentingNewLine]", 
     RowBox[{"name", "=", "UnitQuadrilateralOffsetSplitTwistTile"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"side", "=", 
      RowBox[{"1", "/", 
       SqrtBox["2"]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"is", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tiling", "=", 
      RowBox[{"JoinTiling", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"name", ",", 
            RowBox[{"{", 
             RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",",
             "d", ",", "1", ",", "V", ",", 
            RowBox[{"{", 
             RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], "}"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"name", ",", 
             RowBox[{"{", 
              RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",", 
             RowBox[{"-", "d"}], ",", "2", ",", "V", ",", 
             RowBox[{"{", 
              RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "1"}], "}"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"name", ",", 
             RowBox[{"{", 
              RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",", 
             RowBox[{"-", "d"}], ",", "4", ",", "V", ",", 
             RowBox[{"{", 
              RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"name", ",", 
             RowBox[{"{", 
              RowBox[{"angles", ",", "side", ",", "is"}], "}"}], ",", "w", ",",
              "d", ",", "3", ",", "V", ",", 
             RowBox[{"{", 
              RowBox[{"V", ",", "V", ",", "V", ",", "V"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GraphicsRow", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Graphics", "[", 
            RowBox[{"EmbedTiling", "[", 
             RowBox[{"tiling", ",", "Tiling", ",", 
              RowBox[{"TilePolys", "\[Rule]", "True"}], ",", 
              RowBox[{"TileEdgeArrowStyle", "\[Rule]", "TileArrowCF"}], ",", 
              RowBox[{"TileIndices", "\[Rule]", "True"}], ",", 
              RowBox[{"TileVertexIndices", "\[Rule]", "True"}]}], "]"}], 
            "]"}], ",", 
           RowBox[{"Graphics", "[", 
            RowBox[{"EmbedTiling", "[", 
             RowBox[{"tiling", ",", "CreasePattern"}], "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Graphics", "[", 
            RowBox[{"EmbedTiling", "[", 
             RowBox[{"tiling", ",", "FoldedForm2D"}], "]"}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], "]"}], "/.", 
        RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"EmbedTiling", "[", 
       RowBox[{"tiling", ",", "MonolithicTGraph2D", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "17"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"GraphGraphics", "[", "tobj", "]"}], "]"}], "//", "Hold"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"VisibleFoldedFormGraphics", "[", 
           RowBox[{"tobj", ",", 
            RowBox[{"FaceupFace", "\[Rule]", 
             RowBox[{"-", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", "}"}], 
        "]"}], "/.", 
       RowBox[{"TilingStyle", "[", "]"}]}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.627646848774387*^9, 3.627646859774793*^9}, {
