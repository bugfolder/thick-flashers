Cell[CellGroupData[{

Cell["SurfaceOrientation", "Subsubsection",
 CellChangeTimes->{{3.785592991637948*^9, 
  3.785592993910476*^9}},ExpressionUUID->"b5bdbf1c-ac27-4165-bb68-\
aaecc439c71e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SurfaceOrientation", "::", "usage"}], 
   "=", "\"\<SurfaceOrientation is an option to StyledPatch and related \
functions that specifies the orientation of the surface (if orientable). It \
should be \[PlusMinus]1.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.785592996814532*^9, 3.785593046531664*^9}},
 CellLabel->
  "In[1722]:=",ExpressionUUID->"9bf53fa0-0dfa-40c7-a15c-3f984e560866"],

Cell["\<\
It would be nice to use the simpler \[OpenCurlyDoubleQuote]Orientation\
\[CloseCurlyDoubleQuote] but Mathematica already uses that for something else.\
\>", "Text",
 CellChangeTimes->{{3.785593054518909*^9, 
  3.785593086087359*^9}},ExpressionUUID->"345d744f-fbb4-4224-adac-\
076de3ae4806"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "StyledPatch[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) PatchDivisions, FillStyle, OutlineStyle, SurfaceOrientation"
}], "Subsubsection",
 CellChangeTimes->{{3.6721441196706033`*^9, 3.672144176353245*^9}, 
   3.672144360566031*^9, {3.688134046094569*^9, 3.68813405150145*^9}, 
   3.689247664843276*^9, {3.6892664803209753`*^9, 3.68926649836797*^9}, 
   3.689854539798129*^9, 3.691407503675458*^9, 3.691407738290504*^9, {
   3.6915237188864207`*^9, 3.691523724027563*^9}, {3.78559297507958*^9, 
   3.785592978110542*^9}, {3.8000139966931467`*^9, 3.800014021142955*^9}, {
   3.80001405354139*^9, 3.800014065884179*^9}, 3.803404752545532*^9, 
   3.803896000700777*^9},ExpressionUUID->"f4bf6927-e06a-4040-953b-\
272ab365e420"],

Cell[TextData[{
 "StyledPatch[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces Graphics or Graphics3D elements for a styled patch that \
represents a curved surface specified by a parametric function. "
}], "Text",
 CellChangeTimes->{{3.672144204921938*^9, 3.6721443950838137`*^9}, {
   3.67214446184886*^9, 3.672144529787459*^9}, {3.672146235402009*^9, 
   3.6721462385211477`*^9}, {3.6880804261571302`*^9, 3.688080444331476*^9}, {
   3.688133815733856*^9, 3.688133876681094*^9}, {3.688133949237656*^9, 
   3.688133990545233*^9}, 3.689247664895981*^9, 3.689247697036193*^9, {
   3.689266480352092*^9, 3.6892664983989077`*^9}, {3.689270974331038*^9, 
   3.68927097880434*^9}, {3.689271239737019*^9, 3.689271244681344*^9}, {
   3.6914076068989887`*^9, 3.691407629429899*^9}, {3.8000139967109823`*^9, 
   3.800014021162018*^9}, {3.800014053561824*^9, 
   3.800014065901191*^9}},ExpressionUUID->"603b9e23-8ad6-4819-a2fb-\
ab55384b0b80"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["s",
  FontSlant->"Italic"],
 " \[LongDash] a pure function of two variables that gives the surface in 2D \
or 3D.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] bounds on the first parameter.\n\t{",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "} \[LongDash] bounds on the second parameter, either evaluatable quantities \
or functions of ",
 StyleBox["u",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.691407631452083*^9, 3.691407646510158*^9}, {
  3.782510994812099*^9, 3.782511007095962*^9}, {3.8000139967280197`*^9, 
  3.800014021180029*^9}, {3.80001405358147*^9, 
  3.800014065919335*^9}},ExpressionUUID->"6e69c707-a6db-4d0a-8810-\
7f46f9c56f91"],

Cell[TextData[{
 "Options:\n\tPatchDivisions \[Rule] {",
 StyleBox["nu",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}, the number of divisions to use in the two parameters.\n\tFillStyle \
\[Rule] ",
 StyleBox["style | ",
  FontSlant->"Italic"],
 "None, specifies a named style or a list of style directives to use for the \
patch surface.\n\tOutlineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", specifies the named style to use for outlining the patch.\n\t\
SurfaceOrientation \[Rule] \[PlusMinus]1, specifies the orientation of the \
surface."
}], "Text",
 CellChangeTimes->{{3.691407622644957*^9, 3.691407624510171*^9}, 
   3.691407757895178*^9, {3.69152370275533*^9, 3.691523704134989*^9}, {
   3.691523736543352*^9, 3.6915237509816933`*^9}, {3.692211331236106*^9, 
   3.69221135448422*^9}, {3.785593091303384*^9, 3.785593106767454*^9}, 
   3.803404752575341*^9, 3.803860465756765*^9, 3.803895109648538*^9, {
   3.803895990293192*^9, 3.803895991284533*^9}, {3.803898603799368*^9, 
   3.803898606135696*^9}, 
   3.803905631167576*^9},ExpressionUUID->"1716288a-64c5-4a70-a49f-\
d65c126d97fe"],

Cell["\<\
Returns: a list of Style objects containing the graphics elements.\
\>", "Text",
 CellChangeTimes->{{3.691407609466503*^9, 3.691407615094455*^9}, 
   3.803895983383014*^9},ExpressionUUID->"e8c5ec51-68fb-4174-a192-\
89b56e6dd710"],

Cell["\<\
If FillStyle \[Rule] None, then the polygons of the patch are not generated \
at all. If FillStyle \[Rule] NoFill, they are generated, but OrigamiStyle[] \
will not render them. Other style settings might.\
\>", "Text",
 CellChangeTimes->{{3.692211361642054*^9, 3.692211423534809*^9}, 
   3.693872225427573*^9, {3.693961618253424*^9, 
   3.693961618405656*^9}},ExpressionUUID->"367dbd29-2099-457a-97ee-\
3d7952f01b2f"],

Cell[TextData[{
 "OutlineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " has several forms that ",
 StyleBox["style",
  FontSlant->"Italic"],
 " could take:\n\tNone \[LongDash] don\[CloseCurlyQuote]t outline the patch.\n\
\t",
 StyleBox["style",
  FontSlant->"Italic"],
 " \[LongDash] a single named style to use for the entire outline.\n\t{",
 StyleBox["style}",
  FontSlant->"Italic"],
 " \[LongDash] a single named style to use for the entire outline.\n\t{{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ...}} \[LongDash] multiple style directives to apply to the entire \
outline.\n\t{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["style2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["style3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["style4",
  FontSlant->"Italic"],
 "} \[LongDash] styles to apply individually to the 4 sides (CCW order in the \
(",
 StyleBox["u",
  FontSlant->"Italic"],
 ",",
 StyleBox["v",
  FontSlant->"Italic"],
 ") plane, beginning with the ",
 StyleBox["v",
  FontSlant->"Italic"],
 "=0 line)."
}], "Text",
 CellChangeTimes->{{3.6892712528917646`*^9, 3.689271274680113*^9}, {
   3.689271394390013*^9, 3.689271610338603*^9}, {3.6892720782573147`*^9, 
   3.689272082226816*^9}, 3.691407761312769*^9, {3.691523758891292*^9, 
   3.691523761835228*^9}, {3.6922106981080637`*^9, 
   3.69221070339203*^9}},ExpressionUUID->"2b37c877-bfb9-4766-8491-\
c376a271e500"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PatchDivisions", "::", "usage"}], 
   "=", "\"\<PatchDivisions is an option to StyledPatch that specifies the \
number of divisions to use in the two directions for constructing the \
patch.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.672144618239594*^9, 3.672144648493103*^9}, 
   3.689247664917343*^9, {3.694007371526363*^9, 3.694007372438019*^9}},
 CellLabel->
  "In[1723]:=",ExpressionUUID->"6350448e-9f32-4666-9bca-d1b71f13a19e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OutlineStyle", "::", "usage"}], 
   "=", "\"\<OutlineStyle is an option to StyledPatch that specifies the \
style(s) to use for outlining the patch.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.672144618239594*^9, 3.672144648493103*^9}, 
   3.689247664917343*^9, {3.69140771092811*^9, 3.691407726045879*^9}},
