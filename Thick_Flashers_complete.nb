  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) FlasherSectorDiagFoldLines"
}], "Subsubsection",
 CellChangeTimes->{{3.5558536563529053`*^9, 3.555853662782896*^9}, 
   3.555854321538135*^9, 3.5558543579886227`*^9, {3.555952668864356*^9, 
