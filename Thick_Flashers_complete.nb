   3.691696722841139*^9, 3.691696725524605*^9}, 3.691697514309483*^9, {
   3.6916975518343806`*^9, 3.691697570945507*^9}, {3.691697988408156*^9, 
   3.691698028433237*^9}, 3.691698253192799*^9, 3.691921636667813*^9, 
