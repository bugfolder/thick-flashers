Cell[CellGroupData[{

Cell["SpacerMiuraOriFullyFoldedGraph3DAssigned", "Subsubsection",
 CellChangeTimes->{{3.73119165584559*^9, 
  3.731191665317869*^9}},ExpressionUUID->"0e964d28-d8c7-4ba1-9cd4-\
4b0443c48a0a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SpacerMiuraOriFullyFoldedGraph3DAssigned", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"SpacerMiuraOriFullyFoldedGraph3DAssigned", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]", ",", "dh", ",", "dv", ",", "ds", ",", "nh", ",", "nv", ",",
         "\[Gamma]", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Alpha]", "=", 
        RowBox[{"60.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dh", ",", "dv", ",", "ds"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"nh", ",", "nv"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Gamma]", "=", 
        RowBox[{
         RowBox[{"-", "179"}], "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tobj", "=", 
        RowBox[{"MakeSpacerMiuraOri", "[", 
         RowBox[{"\[Alpha]", ",", 
          RowBox[{"{", 
           RowBox[{"dh", ",", "dv", ",", "ds"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"nh", ",", "nv"}], "}"}], ",", 
          RowBox[{"MajorFoldAngle", "\[Rule]", "\[Gamma]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"VertexRotateGraph3D", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"tobj", "[", "CornerIndices", "]"}], "]"}], ",", "3"}], 
          "]"}]}], "]"}]}]}], "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.731190293945926*^9, 3.73119035228908*^9}, {
  3.731190540108581*^9, 3.731190570892138*^9}, {3.731190918914007*^9, 
  3.7311909640685797`*^9}, {3.731191251422048*^9, 3.731191276872381*^9}, {
  3.731191517986594*^9, 3.731191542941915*^9}, {3.731191575910128*^9, 
  3.731191582638475*^9}, {3.731191695042766*^9, 3.731191719846727*^9}},
 CellLabel->
  "In[2531]:=",ExpressionUUID->"f6909c35-fbec-4b8c-b932-2144e0c61969"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", "SpacerMiuraOriFullyFoldedGraph3DAssigned"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.73119042139404*^9, 3.731190500486322*^9}, 
   3.731190579511966*^9, {3.7311909712087393`*^9, 3.731190976510544*^9}, {
   3.731191140966232*^9, 3.731191164808674*^9}, 3.731191285801035*^9, 
   3.731191555354146*^9, 3.731191589937533*^9, 3.731191715243465*^9},
 CellLabel->
