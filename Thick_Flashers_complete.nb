   3.7994468953320627`*^9}, {3.799446982432784*^9, 3.799446982695668*^9}, {
   3.7994473196403418`*^9, 3.799447319809806*^9}, {3.799447492612812*^9, 
   3.79944749279464*^9}, 3.799447525277338*^9, {3.799447959161351*^9, 
   3.79944801594094*^9}, {3.799448401763482*^9, 3.799448459140112*^9}, {
   3.799448544698811*^9, 3.7994485615763702`*^9}, {3.799448622248465*^9, 
   3.799448631371752*^9}, 3.799525566691695*^9, {3.799527884153935*^9, 
