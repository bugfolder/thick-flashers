    RowBox[{"faces_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"MakeTGraph", "[", 
    RowBox[{"verts", ",", "edges"}], "]"}], "//", 
   "AddTPlaneGraph"}]}]], "Input",
