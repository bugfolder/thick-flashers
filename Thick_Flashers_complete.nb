Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Gamma]", ",", "\[Alpha]", ",", "dir", ",", "\[Rho]", ",", "\[Beta]", ",",
       "pverts", ",", "pedges", ",", " ", "tobjpd", ",", "tobjtt"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]", "=", "2.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"20.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CCW"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "\[Beta]"}], "}"}], "=", 
      RowBox[{"ShrinkAndTwistParms", "[", 
       RowBox[{"\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"TwistDirection", "\[Rule]", "dir"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CP: \[Rho]=\>\"", ",", "\[Rho]", ",", "\"\<, \[Beta]=\>\"",
        ",", 
       RowBox[{"\[Beta]", "/", "\[Degree]"}], ",", "\"\<\[Degree]\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "\[Beta]"}], "}"}], "=", 
      RowBox[{"ShrinkAndTwistParms", "[", 
       RowBox[{"\[Gamma]", ",", 
        RowBox[{"-", "\[Alpha]"}], ",", 
        RowBox[{"TwistDirection", "\[Rule]", "dir"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<FF: \[Rho]=\>\"", ",", "\[Rho]", ",", "\"\<, \[Beta]=\>\"",
        ",", 
       RowBox[{"\[Beta]", "/", "\[Degree]"}], ",", "\"\<\[Degree]\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "4"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "9"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"9", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"pverts", ",", "pedges"}], "]"}], "//", "AddTPlaneGraphTo"}],
        "//", "AddTPrimalDualGraphTo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjtt", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"TwistDirection", "\[Rule]", "dir"}], ",", 
        RowBox[{"PostRotation", "\[Rule]", "PrimalRotation"}]}], "]"}]}], ";",
