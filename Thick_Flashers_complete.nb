}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "OrigamiStyle[",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MountainColor, ValleyColor, CreaseColor, BorderColor, \
FoldedColor, WhiteSideColor, ColoredSideColor, Opacity2D, Opacity3D, \
ShowHidden"
}], "Subsubsection",
 CellChangeTimes->{{3.442605180944417*^9, 3.442605187408441*^9}, {
   3.442605252147149*^9, 3.442605285140089*^9}, {3.442605525149303*^9, 
   3.442605534139636*^9}, {3.442605564397704*^9, 3.4426055661647663`*^9}, {
   3.442607683194464*^9, 3.442607713996737*^9}, {3.4426235403940372`*^9, 
   3.44262355705539*^9}, {3.443204329596594*^9, 3.443204337105536*^9}, {
   3.4432050657233768`*^9, 3.443205067689061*^9}, 3.456355469388751*^9, {
   3.4565135695966053`*^9, 3.456513573492292*^9}, {3.457633981607611*^9, 
   3.457633984399027*^9}, {3.457634074144739*^9, 3.45763407482437*^9}, {
   3.45770389136657*^9, 3.457703904524926*^9}, {3.457706170267766*^9, 
   3.457706173915245*^9}, {3.457993503109355*^9, 3.457993506268598*^9}, {
   3.48406600344983*^9, 3.484066006273531*^9}, {3.533945284650906*^9, 
   3.533945286810379*^9}},ExpressionUUID->"d3fac68e-becc-4e56-9695-\
310d2f9ca93a"],

Cell[TextData[{
 "OrigamiStyle produces a set of rules that change the abstract style types \
given above into proper style directives for rendering 2D crease patterns and \
3D folded forms. that is, the rules transform Style[",
 StyleBox["elems",
  FontSlant->"Italic"],
 ", ",
 StyleBox["origamistyle",
  FontSlant->"Italic"],
 "] into the appropriately styled graphics elements where ",
 StyleBox["origamistyle",
  FontSlant->"Italic"],
 " is one of the symbolic line or fill specifications above. Options are:\n\t\
MountainColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color for mountain fold lines in crease patterns.\n\t\
ValleyColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color for valley fold lines in crease patterns.\n\t\
CreaseColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color for crease lines in crease patterns.\n\tBorderColor\
\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color for borders in crease patterns and folded forms.\n\t\
FoldedColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the color for folded edges in folded forms.\n\tWhiteSideColor\
\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the base color for the white side of the paper.\n\t\
ColoredSideColor\[Rule]",
 StyleBox["color",
  FontSlant->"Italic"],
 ", specifies the base color for the colored side of the paper.\n\tOpacity2D\
\[Rule]",
 StyleBox["opacity",
  FontSlant->"Italic"],
 ", specifies how opaque to make the polygon faces in the folded form in 2D \
graphics (PaperWhiteSideFill, PaperColoredSideFill)\n\tOpacity3D\[Rule]",
 StyleBox["opacity",
  FontSlant->"Italic"],
 ", specifies how opaque to make the polygon faces in the folded form in 3D \
graphics (Paper3DFill)\n...and there are two special options:\n\tShowUnfolded \
\[Rule] True | False, to turn on/off the display of UnfoldedLine-type lines.\n\
\tShowHidden \[Rule]True | False, to turn on/off the display of \
HiddenFoldedLine-type lines."
}], "Text",
 CellChangeTimes->{{3.442605189640786*^9, 3.4426052420742407`*^9}, {
   3.44260541305866*^9, 3.442605511418973*^9}, {3.4426055694953823`*^9, 
   3.442605593493712*^9}, {3.442607714027358*^9, 3.44260772853197*^9}, {
   3.442608488985815*^9, 3.442608541765217*^9}, {3.442622525902917*^9, 
   3.442622568295794*^9}, {3.442623571142665*^9, 3.442623610834753*^9}, {
   3.44320423997702*^9, 3.443204390515008*^9}, {3.443222919315265*^9, 
   3.443222934314745*^9}, {3.456355493373221*^9, 3.456355501931417*^9}, {
   3.456361353041876*^9, 3.45636137391156*^9}, {3.45636151773134*^9, 
   3.456361530616549*^9}, {3.456513476382303*^9, 3.456513485481909*^9}, {
   3.4565135284988537`*^9, 3.456513559013023*^9}, {3.45770399761735*^9, 
   3.457704006867715*^9}, 3.457706180372307*^9, 3.457993500128798*^9, {
   3.533945289758102*^9, 3.533945317952202*^9}, 3.5947325330512743`*^9, 
   3.6289485252160597`*^9, {3.628949740004608*^9, 3.628949764112586*^9}, 
   3.628949811555072*^9, {3.628950160701814*^9, 3.628950176377807*^9}, 
   3.6289506071476183`*^9, 3.628950647502482*^9, 3.628950686024961*^9, {
   3.6289509414182863`*^9, 3.628950941888235*^9}, {3.628950981175508*^9, 
   3.628951008083714*^9}, 3.628951273098792*^9, 3.628959611009027*^9, 
   3.628959672641039*^9, {3.650064913166798*^9, 
   3.6500649717772217`*^9}},ExpressionUUID->"9881d40c-dfbc-4604-8095-\
302a25b77588"],

