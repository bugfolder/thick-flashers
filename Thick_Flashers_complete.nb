Cell["Flat-foldability condition from vectors", "Subsection",
 CellChangeTimes->{{3.46401666595666*^9, 3.464016670242593*^9}, {
   3.469131555031014*^9, 3.469131562287672*^9}, {3.533658281033898*^9, 
