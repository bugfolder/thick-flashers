Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pts", ",", "botpts2d", ",", "toppts2d", ",", "dz", ",", "tobj"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{
       RowBox[{"DiscreteCircle", "[", "5", "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{"PleatReducePolygon", "[", 
