Cell[CellGroupData[{

Cell[TextData[{
 "QuasiConvexPolygonIntersectionInfo[",
 StyleBox["poly",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.6288227551635737`*^9, 3.628822766003892*^9}, {
   3.628850931157219*^9, 3.628850934664169*^9}, {3.6288527444358587`*^9, 
   3.628852746155783*^9}, 
   3.628862781382081*^9},ExpressionUUID->"9747bd17-5d55-4b7d-aed1-\
7e5503160ae2"],

Cell[TextData[{
 "QuasiConvexPolygonIntersectionInfo[",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] takes a polygon containing at most reflex vertex (that\[CloseCurlyQuote]s \
the \[OpenCurlyDoubleQuote]quasi\[CloseCurlyDoubleQuote]) and returns a list \
{",
 StyleBox["poly",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbox",
  FontSlant->"Italic"],
 ", ",
 StyleBox["convex",
  FontSlant->"Italic"],
 ", ",
 StyleBox["triangles",
  FontSlant->"Italic"],
 "} where ",
 StyleBox["poly",
  FontSlant->"Italic"],
 " are the original vertices, ",
 StyleBox["bbox",
  FontSlant->"Italic"],
 " is the bounding box in the form {{",
 StyleBox["xmin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["xmax",
  FontSlant->"Italic"],
 "},{",
 StyleBox["ymin",
  FontSlant->"Italic"],
 ",",
 StyleBox["ymax",
  FontSlant->"Italic"],
 "}}, ",
 StyleBox["convex",
  FontSlant->"Italic"],
 " is a flag that is true if the polygon is convex, and ",
 StyleBox["triangles",
  FontSlant->"Italic"],
 " is a list of triangle vertices that constitute a triangulation of the \
polygon. Polygon ",
 StyleBox["poly",
  FontSlant->"Italic"],
 " can circulate either CCW or CW. This information is used in tests of \
polygon inclusion and overlap."
}], "Text",
 CellChangeTimes->{{3.628822768658264*^9, 3.6288227851524153`*^9}, {
   3.6288509394158363`*^9, 3.628851080558885*^9}, {3.628851478215734*^9, 
   3.628851488572718*^9}, 3.62885276318305*^9, {3.6288536341628323`*^9, 
   3.628853653465349*^9}, {3.628853729164772*^9, 3.628853746523233*^9}, {
   3.628862782341679*^9, 3.628862786151956*^9}, {3.676486068610648*^9, 
   3.6764860697483*^9}},ExpressionUUID->"b0519b5d-2f2a-45d9-9a0f-\
aea3c92eb1a8"],

Cell["\<\
TBD. This function is a stopgap measure. Eventually, we\[CloseCurlyQuote]ll \
want to replace this with simply PolygonInfo that can handle arbitrary \
polygons with any number of reflex vertices and produces an acute \
triangulation. Most polygons we use this on are convex, but in the \
determination of overlaps in VisibleFoldedFormGraphics when applied to tiling \
tessellations, some border polygons can have a single reflex vertex.\
\>", "Text",
 CellChangeTimes->{{3.628851084550786*^9, 3.628851203927063*^9}, {
  3.628851272482586*^9, 3.628851278082291*^9}, {3.707927111607102*^9, 
  3.707927112559457*^9}},ExpressionUUID->"fc57b4eb-8cdd-40e8-bc82-\
6cfe1a36d0a1"],

Cell["\<\
TBD: a general polygon triangulation via a greedy algorithm would be a nice \
general-purpose thing to have.\
\>", "Text",
 CellChangeTimes->{{3.707930914906179*^9, 
  3.707930936441564*^9}},ExpressionUUID->"5064a222-da3d-4ba2-aa6e-\
57da47884691"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuasiConvexPolygonIntersectionInfo", "::", "badpoly"}], 
   "=", "\"\<The polygon `1` has more than 1 reflex vertex.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.628118896265346*^9, 3.628118913199304*^9}, 
   3.628851416317978*^9, 3.628852765363014*^9},
 CellLabel->
  "In[516]:=",ExpressionUUID->"dc967983-ff5d-4abc-9caa-0ab752e2c7ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuasiConvexPolygonIntersectionInfo", "[", "poly_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bbox", ",", "angles", ",", "nsp", ",", "nsm", ",", "rpos", ",", 
      "convex", ",", "tverts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"bounding", " ", "box"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bbox", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "}"}], "&"}], "[", 
       RowBox[{"Transpose", "[", "poly", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "triangulation", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"RotationAngles", "[", "poly", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nsp", "=", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}], "/@", "angles"}], ",", "True"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "#", " ", "of", " ", "strictly", " ", "positive", " ", "angles"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nsm", "=", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "<", "0"}], "&"}], "/@", "angles"}], ",", "True"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "#", " ", "of", " ", "strictly", " ", "negative", " ", "angles"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rpos", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nsp", ">", "nsm"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[GreaterEqual]", "0"}], "&"}], "/@", "angles"}], ",",
            "False"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[LessEqual]", "0"}], "&"}], "/@", "angles"}], ",",
            "False"}], "]"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"position", 
        RowBox[{"(", "s", ")"}], " ", "of", " ", "opposite"}], "-", 
       RowBox[{"sign", " ", "angles"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"Length", "[", "rpos", "]"}], ",", "\[IndentingNewLine]", "0", 
       ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"no", " ", "reflex", " ", "vertices"}], ",", " ", 
         RowBox[{
          RowBox[{"triangulate", " ", "from", " ", "first", " ", "non"}], "-", 
          RowBox[{"flat", " ", "vertex"}]}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"convex", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rpos", "=", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "\[NotEqual]", "0"}], "&"}], "/@", "angles"}], ",",
              "True"}], "]"}], "]"}], "\[LeftDoubleBracket]", "1", 
          "\[RightDoubleBracket]"}]}]}], ",", "\[IndentingNewLine]", "1", ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"one", " ", "reflex", " ", "vertex"}], ",", " ", 
         RowBox[{"triangulate", " ", "from", " ", "that", " ", "vertex"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"convex", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rpos", "=", 
         RowBox[{
         "rpos", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ",",
        "\[IndentingNewLine]", "_", ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "more", " ", "than", " ", "one", " ", "reflex", " ", "vertex"}], ",",
          " ", 
         RowBox[{
          RowBox[{"can", "'"}], "t", " ", "handle", " ", 
          RowBox[{"yet", ".", " ", "Show"}], " ", "the", " ", "error"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"AppendFirst", "[", "poly", "]"}], "]"}], ",", "Red"}],
              "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "/@", "poly"}], ",", "Black", ",", 
              RowBox[{"Thickness", "[", ".01", "]"}]}], "]"}]}], "}"}], "]"}],
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"QuasiConvexPolygonIntersectionInfo", "::", "badpoly"}], ",",
           "poly"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "poly", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "&"}],
        "/@", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rpos", ",", 
             RowBox[{"rpos", "+", "i"}], ",", 
             RowBox[{"rpos", "+", "i", "+", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"Length", "[", "poly", "]"}], "-", "2"}]}], "}"}]}], 
          "]"}], ",", 
         RowBox[{"Length", "[", "poly", "]"}], ",", "1"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"poly", ",", "bbox", ",", "convex", ",", "tverts"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.628851283376618*^9, 3.628851306376762*^9}, {
  3.628851348847456*^9, 3.628851390333591*^9}, {3.628851420913688*^9, 
