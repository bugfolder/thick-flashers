Cell[BoxData[
 RowBox[{
  RowBox[{"ExtractStyleArgs", "[", 
   RowBox[{"obj_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ss", ",", "ms", ",", "sos", ",", "sta", ",", "styleargs"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"ShowSample", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExtractStyleArgs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ms", "=", 
      RowBox[{
       RowBox[{"MagnifySample", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExtractStyleArgs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sos", "=", 
      RowBox[{
       RowBox[{"StyleObjectSample", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExtractStyleArgs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styleargs", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"obj", ",", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"_", ",", "style___"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"{", "style", "}"}]}], ",", "\[Infinity]"}], "]"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ss", ",", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"sta", "=", 
           RowBox[{
           "styleargs", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"ms", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"sta", "=", 
              RowBox[{"sta", "/.", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Thickness", "[", "t_", "]"}], "\[RuleDelayed]", 
                  RowBox[{"Thickness", "[", 
                   RowBox[{"10", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"AbsoluteThickness", "[", "t_", "]"}], "\[RuleDelayed]", 
                  RowBox[{"AbsoluteThickness", "[", 
                   RowBox[{"10", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Dashing", "[", "d_", "]"}], "\[RuleDelayed]", 
                  RowBox[{"Dashing", "[", 
                   RowBox[{"10", "d"}], "]"}]}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"AbsoluteDashing", "[", "d_", "]"}], "\[RuleDelayed]", 
                  RowBox[{"AbsoluteDashing", "[", 
                   RowBox[{"10", "d"}], "]"}]}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"PointSize", "[", "t_", "]"}], "\[RuleDelayed]", 
                  RowBox[{"PointSize", "[", 
                   RowBox[{"10", " ", "t"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"AbsolutePointSize", "[", "t_", "]"}], "\[RuleDelayed]", 
                  RowBox[{"AbsolutePointSize", "[", 
                   RowBox[{"10", " ", "t"}], "]"}]}]}], "}"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"ContainsAny", "[", 
                 RowBox[{
                  RowBox[{"Head", "/@", "sta"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"Thickness", ",", "AbsoluteThickness"}], "}"}]}], 
                 "]"}]}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"sta", ",", 
                 RowBox[{"AbsoluteThickness", "[", "10", "]"}]}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"ContainsAny", "[", 
                 RowBox[{
                  RowBox[{"Head", "/@", "sta"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"PointSize", ",", "AbsolutePointSize"}], "}"}]}], 
                 "]"}]}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"sta", ",", 
                 RowBox[{"AbsolutePointSize", "[", "10", "]"}]}], "]"}]}], 
              "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Graphics", "[", 
              RowBox[{"Style", "[", 
               RowBox[{"sos", ",", "sta"}], "]"}], "]"}], ",", 
             RowBox[{
             "styleargs", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}]}], "}"}], "]"}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "styleargs", "]"}]}], "}"}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", "styleargs"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.4565296078183613`*^9, 3.45652963332297*^9}, {
   3.456529761667095*^9, 3.456529869125465*^9}, {3.456529937721197*^9, 
   3.456530061786277*^9}, {3.45653017672407*^9, 3.456530237191184*^9}, 
   3.456530407871939*^9, {3.48486408459402*^9, 3.484864105647325*^9}, {
   3.550952291752842*^9, 3.550952302942877*^9}, {3.550952340148541*^9, 
   3.550952431736268*^9}, {3.550952583175716*^9, 3.5509526116146317`*^9}, 
   3.592645519722715*^9, {3.628786592257398*^9, 3.628786592357913*^9}, 
   3.708018873912499*^9, {3.708019177057514*^9, 3.708019582004394*^9}, {
   3.708019634685788*^9, 3.708019748359071*^9}},
 CellLabel->
