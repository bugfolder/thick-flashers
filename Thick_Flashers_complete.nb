Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.911988658006716*^9, 
  3.911988658479784*^9}},ExpressionUUID->"8a81f1dc-ae20-424d-9d79-\
d554aa132613"],

Cell["\<\
To create a 3D-printable solid model of the thick flasher, we\
\[CloseCurlyQuote]ll build polyhedra for each panel on the embedded \
zero-thickness surface, then inset them (to put gaps between them), and then \
add connectors between all connected edges for the 3D-printed hinges.\
\>", "Text",
 CellChangeTimes->{{3.911901364470245*^9, 3.911901429058647*^9}, {
  3.913553174933293*^9, 3.913553219709848*^9}, {3.922549271309009*^9, 
  3.922549271636492*^9}},ExpressionUUID->"0b21f6aa-14f1-49d0-83b2-\
bd2e2603c2ed"],

Cell[TextData[{
 "So we\[CloseCurlyQuote]ll build each individual panel as a GraphicsComplex. \
And then we\[CloseCurlyQuote]ll need to store a correspondence between the \
vertices of the GraphicsComplex and the corresponding vertices of the EZT \
surface (which, remember, is a TGraph3DAssigned plus some extra properties). \
One of those properties is the FlasherIJKMap, which lets us go between the \
TGraph3D vertices (and edges and polys) and their ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "df181877-90e0-4aaf-825b-b00834dbba2c"],
 " values."
}], "Text",
 CellChangeTimes->{{3.911901445461971*^9, 3.911901460759781*^9}, {
   3.911902261183397*^9, 3.911902295370619*^9}, {3.911902336753406*^9, 
   3.911902457416003*^9}, 3.911902489628293*^9, {3.913553231277504*^9, 
   3.913553244443684*^9}},ExpressionUUID->"cfa7790e-dc58-4546-bcbf-\
aa80f403af6a"],

Cell["\<\
We\[CloseCurlyQuote]ll have three kinds of polyhedra:
\t(a) The central polygon (easiest to build).
\t(b) Triangles.
\t(c) Quads.\
\>", "Text",
 CellChangeTimes->{{3.911902782339587*^9, 
  3.911902843368392*^9}},ExpressionUUID->"c4beb852-9141-42ca-b142-\
b71debcaf9e0"],

Cell["Start with an example to play with and examine.", "Text",
 CellChangeTimes->{{3.9119028565194483`*^9, 3.911902861265332*^9}, {
  3.911988395533178*^9, 
  3.911988397637632*^9}},ExpressionUUID->"910b08b6-d4a8-49f7-aa67-\
00b76ae53964"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.1"}], ",", "tobj", ",", "tobjdp"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"tobj", "[", "FlasherDetails", "]"}], "//", "ColumnForm"}], 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "//", "Print"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<IJK Map:\>\"", "//", "Print"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "[", "FlasherIJKMap", "]"}], "//", "Print"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.911902955986402*^9, 3.911902958738657*^9}, {
   3.911903049831697*^9, 3.911903059975348*^9}, 3.911904318753705*^9, {
   3.913553288830754*^9, 3.91355329774256*^9}, {3.913993609968346*^9, 
   3.91399362207028*^9}},
 CellLabel->
