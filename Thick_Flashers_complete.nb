     RowBox[{"Print", "[", 
      RowBox[{"\"\<(dihedral angles)/\[Degree] = \>\"", ",", 
       RowBox[{"da", "/", "\[Degree]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"dirs", "=", 
