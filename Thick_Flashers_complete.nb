Cell[TextData[{
 "PtInWedgeQ[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}] returns True if the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " lies in the wedge defined by the line from ",
 StyleBox["p0",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p1",
  FontSlant->"Italic"],
 " and the line from ",
 StyleBox["p0",
  FontSlant->"Italic"],
 " to ",
 StyleBox["p2.",
  FontSlant->"Italic"],
 " In other words, it returns True if and only if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Angle]", 
     RowBox[{"(", 
      RowBox[{"p1", "-", "p0"}], ")"}]}], "\[LessEqual]", 
    RowBox[{"\[Angle]", 
     RowBox[{"(", 
      RowBox[{"q", "-", "p0"}], ")"}]}], "\[LessEqual]", 
    RowBox[{"(", 
     RowBox[{"p2", "-", "p0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "504b3a61-938a-4905-a7c7-92ddf59c7e31"],
 "."
}], "Text",
 CellChangeTimes->{{3.462903275694273*^9, 
  3.462903321197145*^9}},ExpressionUUID->"b4263609-c2cb-4255-a6be-\
1b6d5f99f55b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PtInWedgeQ", "[", 
   RowBox[{"q_", ",", 
    RowBox[{"{", 
     RowBox[{"p0_", ",", "p1_", ",", "p2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fq", "=", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{"q", "-", "p0"}], ")"}]}]}], ",", 
      RowBox[{"f1", "=", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{"p1", "-", "p0"}], ")"}]}]}], ",", 
      RowBox[{"f2", "=", 
       RowBox[{"ArcTan", "@@", 
        RowBox[{"(", 
         RowBox[{"p2", "-", "p0"}], ")"}]}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"fq", "-", "f1"}], ",", 
       RowBox[{"2", "\[Pi]"}]}], "]"}], "\[LessEqual]", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"f2", "-", "f1"}], ",", 
       RowBox[{"2", "\[Pi]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[494]:=",ExpressionUUID->"3e3ea5c7-fa0f-4d38-9679-59c97251297d"],

Cell["Example", "Text",ExpressionUUID->"14b5f06a-7632-4499-a8ce-c314ace5e9ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "wedge"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "-", 
           RowBox[{"1.5", 
            RowBox[{"Random", "[", "]"}]}]}], ",", 
          RowBox[{"1", "-", 
           RowBox[{"1.5", 
            RowBox[{"Random", "[", "]"}]}]}]}], "}"}], ",", 
        RowBox[{"{", "40", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"wedge", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Line", "[", 
         RowBox[{"wedge", "\[LeftDoubleBracket]", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1", ",", "3"}], "}"}], 
          "\[RightDoubleBracket]"}], "]"}], ",", 
        RowBox[{"PointSize", "[", ".02", "]"}], ",", "Gray", ",", 
        RowBox[{"Point", "/@", "pts"}], ",", "Red", ",", 
        RowBox[{"Point", "/@", 
         RowBox[{"Select", "[", 
          RowBox[{"pts", ",", 
           RowBox[{
            RowBox[{"PtInWedgeQ", "[", 
             RowBox[{"#", ",", "wedge"}], "]"}], "&"}]}], "]"}]}]}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.462903358542176*^9, 3.4629034372697773`*^9}, {
