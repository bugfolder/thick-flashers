      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"emedges", ",", "2", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Intersectify", "[", 
      RowBox[{"tobj", ",", "opts"}], "]"}]}]}], "]"}]}]], "Input",
