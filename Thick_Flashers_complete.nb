Cell[TextData[{
 "EdgeFlatFoldEnergy[",
 StyleBox["{i1, f1, i2, f2}",
  FontSlant->"Italic"],
 "] returns an energy that reaches a minimum when a fold between two faces is \
flat-folded."
}], "Text",
 CellChangeTimes->{{3.702581757784544*^9, 3.702581806303808*^9}, 
   3.702662368518146*^9, 3.702664772828959*^9, {3.702665207167992*^9, 
