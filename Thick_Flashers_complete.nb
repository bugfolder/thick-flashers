Cell[TextData[{
 "{UnitTriangleCenteredTwist",
 "AltTile,",
 " ",
 StyleBox["angles",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} represents an edge-centered simple flat twist in a unit triangle with \
corner angles ",
 StyleBox["angles",
  FontSlant->"Italic"],
 " where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the width of the pleat where it subtends the edge, \[Alpha] is the \
twist angle, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
