Cell[TextData[{
 "AssertClasses",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["classes",
  FontSlant->"Italic"],
 ", ",
 StyleBox["where",
  FontSlant->"Italic"],
 "] returns True if the TObj belongs to all of the specified classes. If it \
doesn\[CloseCurlyQuote]t, it issues an error message on the first failure and \
aborts."
}], "Text",
 CellChangeTimes->{{3.592431236047289*^9, 3.5924313085373926`*^9}, {
   3.592431439553096*^9, 3.592431440152581*^9}, 3.5924357358513203`*^9, 
   3.593006114375489*^9},ExpressionUUID->"41bd8e5d-89ba-4a48-a85a-\
59cbd77c4075"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AssertClasses", "::", "nottobj"}], 
   "=", "\"\<`1` is not a TObj.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627948553897115*^9, 3.6279485757487693`*^9}, {
  3.627948884770965*^9, 3.627948885137909*^9}},
 CellLabel->
  "In[1021]:=",ExpressionUUID->"f9f99176-e4ac-4e1f-882a-de49d9488099"],

