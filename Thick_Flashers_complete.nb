              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"f", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"b2", "[", "s", "]"}], "-", 
