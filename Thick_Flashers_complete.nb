Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sal", ",", "dal", ",", "sa", ",", "da", ",", "dirs", ",", "tobj"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sal", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "16"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(1\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(2\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(3\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Alpha]\), \(4\)]\)\>\""}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dal", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "14"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(1\)]\)\>\"", " ", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(2\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(3\)]\)\>\"", 
         ",", "\"\<\!\(\*SubscriptBox[\(\[Gamma]\), \(4\)]\)\>\""}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sa", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"140.", "\[Degree]"}], ",", 
        RowBox[{"30.", "\[Degree]"}], ",", 
        RowBox[{"90.", "\[Degree]"}], ",", 
        RowBox[{"100.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"da", "=", 
      RowBox[{"MakeDihedralsFromSectorsAndMinorDihedral", "[", 
       RowBox[{"sa", ",", 
        RowBox[{"60.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<(sector angles)/\[Degree] = \>\"", ",", 
