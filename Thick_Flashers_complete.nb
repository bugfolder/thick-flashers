Cell[CellGroupData[{

Cell[TextData[{
 "NPlanarCurvedFold3DSequence[",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", {{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m1",
  FontSlant->"Italic"],
 "},...}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ComposeReflections, Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{{3.694116073681051*^9, 3.694116080663991*^9}, 
   3.694116403821804*^9, {3.694116690221582*^9, 3.694116704352896*^9}, {
   3.701385260703289*^9, 3.7013852645182037`*^9}, 3.701388095424985*^9, {
   3.80641980063585*^9, 3.806419815267009*^9}, {3.8064306048021193`*^9, 
   3.806430607521278*^9}},ExpressionUUID->"3624fcee-9a5a-44c7-a132-\
39cc4caabb54"],

Cell[TextData[{
 "NPlanarCurvedFold3DSequence[",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", {{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m1",
  FontSlant->"Italic"],
 "},...}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a parameterized surface and a sequence of point/mirror planes \
relative to the original surface and returns two lists of functions that \
describe the surface reverse-folded at each mirror plane intersection."
}], "Text",
 CellChangeTimes->{{3.694116089568431*^9, 3.69411617804052*^9}, {
  3.694116213273121*^9, 3.694116260585855*^9}, {3.694116305186516*^9, 
  3.694116306633852*^9}, {3.694116398235631*^9, 3.6941163988993073`*^9}, {
  3.806419825740863*^9, 
  3.806419830941361*^9}},ExpressionUUID->"cd0aa289-580a-4877-98c0-\
c063cef81b4a"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["bb",
  FontSlant->"Italic"],
 " \[LongDash] the directrix of the ruled parameterization.\n\t",
 StyleBox["dd",
  FontSlant->"Italic"],
 " \[LongDash] the director of the ruled parameterization.\n\t{{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m1",
  FontSlant->"Italic"],
 "}, ...} \[LongDash] a list of {mirror point, mirror normal vector} pairs \
relative to the original surface that define the positions of the reverse \
folds."
}], "Text",
 CellChangeTimes->{{3.694116266826014*^9, 3.69411638325939*^9}, {
  3.694116417076719*^9, 
  3.694116432355965*^9}},ExpressionUUID->"fe3b36f0-bf4f-479a-8f86-\
6c8acc589331"],

Cell["\<\
Options:
\tComposeReflections \[Rule] True | False, whether to compose the \
reflections. See explanation for PlanarCurvedFold3DSequence. Default is True.
\tOptions[FunctionInterpolation] are passed through.\
\>", "Text",
 CellChangeTimes->{{3.806427630379501*^9, 3.806427737280353*^9}, {
  3.8064306275538583`*^9, 3.806430643200891*^9}, {3.8064306906339407`*^9, 
  3.806430692754941*^9}},ExpressionUUID->"d8518b13-b093-4a80-b7d7-\
1613d916a306"],

Cell[TextData[{
 "Returns: a list of lists {",
 StyleBox["vi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi",
  FontSlant->"Italic"],
 "} of functions that describe each curved fold, with the first entry being \
the original directrix. For each:\n\t",
 StyleBox["vi",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the distance parameter from the directrix to the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th curve.\n\t",
 StyleBox["bbi",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the directrix of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th curve.\n\t",
 StyleBox["cci",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th curve.\n\t",
 StyleBox["ddi",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th director."
}], "Text",
 CellChangeTimes->{{3.694116436195911*^9, 3.69411652843663*^9}, {
  3.694116561317149*^9, 3.694116675894272*^9}, {3.6941167553354597`*^9, 
  3.694116755783067*^9}},ExpressionUUID->"9d639f6d-6e17-4dfd-95d9-\
6c11ef52edb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "NPlanarCurvedFold3DSequence", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.806419926745928*^9, 3.806419934454518*^9}},
 CellLabel->
  "In[4038]:=",ExpressionUUID->"cf12dd86-9866-4716-9a1e-1f88b0ec548c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NPlanarCurvedFold3DSequence", "[", 
   RowBox[{
    RowBox[{"bblf_Function", "|", "bblf_InterpolatingFunction"}], ",", 
    RowBox[{"ddlf_Function", "|", "ddlf_InterpolatingFunction"}], ",", 
    "pm_List", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cr", ",", "fiopts", ",", "u", ",", "sfn", ",", "ret", ",", "epm", ",", 
      "p", ",", "m", ",", "bbl", ",", "ddl", ",", "vf", ",", "ff", ",", "bbr",
       ",", "ddr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cr", "=", 
      RowBox[{
       RowBox[{"ComposeReflections", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PlanarCurvedFold3DSequence", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fiopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"ret", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "&"}], ",", "bblf", ",", "bblf", ",", "ddlf"}], "}"}], 
       "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "initial", " ", "entry", " ", "in", " ", "the", " ", "output", " ", 
       "list"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"epm", "=", "pm"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "an", " ", "editable", " ", "copy", " ", "that", " ", "we", " ", "will",
        " ", "manipulate"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bbl", ",", "ddl"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"bblf", ",", "ddlf"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "epm", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"pop", " ", "off", " ", "the", " ", "first", " ", 
         RowBox[{"point", "/", "mirror"}], " ", "pair"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "m"}], "}"}], "=", 
         RowBox[{
         "epm", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"epm", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{"epm", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vf", "=", 
         RowBox[{"FunctionInterpolationAlt", "[", 
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"p", "-", 
               RowBox[{"bbl", "[", "u", "]"}]}], ")"}], ".", "m"}], 
            RowBox[{
             RowBox[{"ddl", "[", "u", "]"}], ".", "m"}]], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ff", "=", 
         RowBox[{"FunctionInterpolationAlt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bbl", "[", "u", "]"}], "+", 
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"p", "-", 
                 RowBox[{"bbl", "[", "u", "]"}]}], ")"}], ".", "m"}], 
              RowBox[{
               RowBox[{"ddl", "[", "u", "]"}], ".", "m"}]], " ", 
             RowBox[{"ddl", "[", "u", "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ddr", "=", 
         RowBox[{"FunctionInterpolationAlt", "[", 
          RowBox[{
           RowBox[{"Reflectu", "[", 
            RowBox[{
             RowBox[{"ddl", "[", "u", "]"}], ",", "m"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bbr", "=", 
         RowBox[{"FunctionInterpolationAlt", "[", 
          RowBox[{
           RowBox[{"Reflectu", "[", 
            RowBox[{
             RowBox[{"bbl", "[", "u", "]"}], ",", "p", ",", "m"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "u0", ",", "u1"}], "}"}], ",", "fiopts"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "add", " ", "this", " ", "set", " ", "to", " ", "the", " ", "output",
           " ", "list"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"ret", ",", 
          RowBox[{"{", 
           RowBox[{"vf", ",", "bbr", ",", "ff", ",", "ddr"}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"mirror", " ", "all", " ", "subsequent", " ", 
          RowBox[{"point", "/", "mirror"}], " ", "pairs", " ", "in", " ", 
          "this", " ", "one"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"cr", ",", 
          RowBox[{"epm", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Reflectu", "[", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                 ",", "p", ",", "m"}], "]"}], ",", 
               RowBox[{"Reflectu", "[", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 ",", "m"}], "]"}]}], "}"}], "&"}], "/@", "epm"}]}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "and", " ", "setup", " ", "the", " ", "next", " ", "left", " ", 
          "parameterization"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bbl", "=", "bbr"}], ";", "\[IndentingNewLine]", 
        RowBox[{"ddl", "=", "ddr"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "ret"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.694107468084787*^9, 3.694107503287229*^9}, {
   3.694107790994778*^9, 3.694107810036125*^9}, {3.694107858565468*^9, 
   3.694108190861805*^9}, {3.694109443783731*^9, 3.6941094481534786`*^9}, {
   3.694109537898757*^9, 3.694109561921648*^9}, {3.694109606626995*^9, 
   3.694109613993861*^9}, {3.694116836667642*^9, 3.694116846161111*^9}, {
   3.694117098724022*^9, 3.694117099051342*^9}, {3.694117131514907*^9, 
   3.694117401359714*^9}, {3.694117438287554*^9, 3.694117457494236*^9}, {
   3.694117498512431*^9, 3.694117821039166*^9}, {3.798622845622514*^9, 
   3.798622845633504*^9}, {3.806419646799049*^9, 3.806419673142783*^9}, {
   3.8064198719912*^9, 3.806419904183793*^9}, {3.806419945018249*^9, 
   3.806420020425088*^9}, {3.8064201096995707`*^9, 3.806420125298234*^9}, {
   3.80642023356067*^9, 3.806420356734146*^9}, {3.8064204550377607`*^9, 
   3.8064204626127453`*^9}, {3.8064204939873443`*^9, 3.806420502363468*^9}, {
   3.806420621056913*^9, 3.806420635623136*^9}, 3.806421433031629*^9, {
   3.806430653366909*^9, 3.806430686820582*^9}},
 CellLabel->
  "In[4039]:=",ExpressionUUID->"c15d7aaa-006a-46e3-b84a-b982a2fe6fed"],

Cell["\<\
Example. A z-oriented cone with slices at different tilt angles.\
\>", "Text",
 CellChangeTimes->{{3.694117931834103*^9, 3.694117932640997*^9}, {
  3.694118012794373*^9, 3.694118018602561*^9}, {3.694119059539624*^9, 
  3.694119062547982*^9}, {3.6941191242445593`*^9, 3.6941191286847553`*^9}, {
  3.694119311224034*^9, 
  3.694119311942437*^9}},ExpressionUUID->"7127ca1c-ca2f-44fc-9d53-\
fa3ce39f4240"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Theta]", ",", "bb", ",", "dd", ",", "pm", ",", "pcf3ds", ",", 
      "cclist", ",", "b", ",", "d", ",", "clist", ",", "u", ",", "u0", ",", 
      "u1", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "\[Pi]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Cos", "[", "#", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "#", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pm", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
          RowBox[{
           RowBox[{"RotationXMatrix3D", "[", 
            RowBox[{"10.", "\[Degree]"}], "]"}], ".", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "3"}], "}"}], ",", 
          RowBox[{
           RowBox[{"RotationYMatrix3D", "[", 
            RowBox[{"10.", "\[Degree]"}], "]"}], ".", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pcf3ds", "=", 
      RowBox[{"NPlanarCurvedFold3DSequence", "[", 
       RowBox[{"bb", ",", "dd", ",", "pm", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cclist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "pcf3ds"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "we", " ", "know", " ", "what", " ", "the", " ", "2", "D", " ", 
        "ruled", " ", "parameterization", " ", "is"}], ",", " ", 
       RowBox[{"so", " ", "can", " ", "build", " ", "the", " ", "CP"}], ",", 
       " ", "too"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"#", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}], ",", 
         RowBox[{"Sin", "[", 
          RowBox[{"#", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], "}"}], "&"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"clist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Functionize", "[", 
         RowBox[{"u", ",", 
          RowBox[{
           RowBox[{"b", "[", "u", "]"}], "+", 
           RowBox[{
            RowBox[{
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "[",
              "u", "]"}], 
            RowBox[{"d", "[", "u", "]"}]}]}]}], "]"}], "&"}], "/@", 
       "pcf3ds"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"v1", "=", 
      RowBox[{"4", 
       RowBox[{"Sec", "[", "\[Theta]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"StyledRuledPatch", "[", 
               RowBox[{"bb", ",", "dd", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "v1"}], "}"}]}], "]"}], "//", 
              "ReverseFillStyle"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Styled3DDisk", "[", 
                RowBox[{
                 RowBox[{"pm", "\[LeftDoubleBracket]", 
                  RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"pm", "\[LeftDoubleBracket]", 
                  RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
                 "2.5", ",", 
                 RowBox[{"FillStyle", "\[Rule]", 
                  RowBox[{"{", 
                   RowBox[{"LightGray", ",", 
                    RowBox[{"Opacity", "[", ".2", "]"}]}], "}"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "pm", "]"}]}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], ",", 
           RowBox[{"Lighting", "\[Rule]", 
            RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"StyledRuledPatchSequence", "[", 
              RowBox[{"cclist", ",", 
