Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "c", ",", "u0", ",", "u1", ",", "csys", ",", "plots"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
