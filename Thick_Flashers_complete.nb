Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.4"}], ",", "rules"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rules", "=", 
     RowBox[{"ThickFlasherDefaultDPRules", "[", 
      RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"FlasherLines", "[", 
          RowBox[{"p", ",", "r", ",", "h", ",", "m"}], "]"}], "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["p", 
           RowBox[{"i_", ",", "j_", ",", 
            RowBox[{"-", "1"}]}]], "->", 
          SubscriptBox["p", 
           RowBox[{"i", ",", "j", ",", 
            RowBox[{"m", "-", "1"}]}]]}], "}"}]}], "/.", "rules"}], ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
     "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
