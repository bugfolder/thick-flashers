Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Styled3DSolidArrow", "[", 
    RowBox[{
     SubscriptBox["r", "1"], ",", 
     SubscriptBox["r", "2"], ",", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "15b7e524-b34a-49b1-8b13-8b14630eab7a"],
 " [DEPRECATED]\n\t(options) ArrowheadFraction, ArrowheadRadius,  ArrowLabel, \
FillStyle"
}], "Subsubsection",
 CellChangeTimes->{{3.439985585175975*^9, 3.4399856022768292`*^9}, {
   3.439986123367893*^9, 3.439986137287017*^9}, {3.439986795513664*^9, 
   3.439986798308604*^9}, {3.440255414241076*^9, 3.44025541463195*^9}, {
   3.4432058615432663`*^9, 3.443205861543322*^9}, {3.443206886692376*^9, 
   3.44320688834722*^9}, {3.589633479346553*^9, 3.5896334824141817`*^9}, {
   3.589633581911587*^9, 3.589633587073799*^9}, {3.589633620017853*^9, 
   3.589633629463317*^9}, {3.591794732573002*^9, 3.591794734004877*^9}, {
   3.591798982237427*^9, 3.59179898457187*^9}, {3.668985756033851*^9, 
   3.668985756033947*^9}, 3.693873269192939*^9, 
   3.800993229839123*^9},ExpressionUUID->"c70cd603-6518-4b76-9960-\
4ae440e55b83"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Styled3DSolidArrow", "[", 
    RowBox[{
     SubscriptBox["r", "1"], ",", 
     SubscriptBox["r", "2"], ",", 
     StyleBox["opts",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "03ce0054-1e61-4917-a141-3ac1ed04eefe"],
 " returns a list of Graphics3D primitives that give an arrow with a conical \
tip. Useful for drawing vectors in 3D. Options are:\n\tArrowheadFraction\
\[Rule]",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies the fraction of the length to devote to the conical arrowhead.\n\
\tArrowheadRadius\[Rule]",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies the radius of the base of the arrow relative to its length.\n\t\
ArrowRadius\[Rule]",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies the radius of the stem of the arrow relative to its length.\n\t\
FillStyle\[Rule]",
 StyleBox["r",
  FontSlant->"Italic"],
 ", specifies the fill style for all surfaces."
}], "Text",
 CellChangeTimes->{{3.439985618543407*^9, 3.4399856417830753`*^9}, {
  3.4432058621571507`*^9, 3.443205862157217*^9}, {3.4432069004521513`*^9, 
  3.44320698351176*^9}, {3.668985756056683*^9, 
  3.668985756056745*^9}},ExpressionUUID->"88066b60-0cd7-42b3-b5fa-\
7484b247fa3d"],

Cell[TextData[{
 "This is deprecated because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " now directly supports 3D solid arrows via the Arrow[Tube[...]] \
construction. See example."
}], "Text",
 CellChangeTimes->{{3.591798991596035*^9, 3.591798992370915*^9}, {
  3.591799032954573*^9, 
  3.591799080757799*^9}},ExpressionUUID->"ffa4ab35-18fc-4c3b-84b2-\
bbb9ead0000a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArrowheadFraction", "::", "usage"}], 
   "=", "\"\<ArrowheadFraction is an option to Styled3DSolidArrow that \
specifies the fraction of the length that should be used for the arrowhead.\>\
\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592043051419056*^9, 3.59204309313667*^9}, 
   3.668985756077365*^9},
 CellLabel->
  "In[1669]:=",ExpressionUUID->"d1138528-cdb2-4a7f-b583-3156b4335e86"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArrowheadRadius", "::", "usage"}], 
   "=", "\"\<ArrowheadRadius is an option ot Styled3DSolidArrow that \
specifies the radius of the base of the arrowhead.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59204309601978*^9, 3.592043126286212*^9}, 
   3.668985756102289*^9},
 CellLabel->
  "In[1670]:=",ExpressionUUID->"978b3fbd-f621-47de-acd7-c9fe1217b80f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArrowRadius", "::", "usage"}], 
   "=", "\"\<ArrowRadius is an option to Styled3DSolidArrow that specifies \
the radius of the body of the arrow.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592043128296009*^9, 3.592043151614531*^9}, 
   3.668985756126968*^9},
 CellLabel->
  "In[1671]:=",ExpressionUUID->"24ccc260-8576-4d52-a488-f9768a15c6d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ArrowLabel", "::", "usage"}], 
   "=", "\"\<ArrowLabel is an option to Styled3DSolidArrow that specifies an \
label to place at the arrow ti.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592043159419942*^9, 3.592043181223779*^9}, 
   3.668985756152262*^9},
 CellLabel->
  "In[1672]:=",ExpressionUUID->"bf0fcefa-e87f-4e20-aa4e-b55dfbc96f0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Styled3DSolidArrow", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ArrowheadFraction", "\[Rule]", "0.333"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ArrowheadRadius", "\[Rule]", "0.333"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ArrowRadius", "\[Rule]", "0.25"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ArrowLabel", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"FillStyle", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.439986056050698*^9, 3.43998612013102*^9}, {
   3.439986803022603*^9, 3.439986806887533*^9}, {3.440000698848103*^9, 
