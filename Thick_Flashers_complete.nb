Cell[TextData[{
 "RenderTile[",
 "{UnitCyclicBrocardPolygonOffsetTwistTile, {",
 StyleBox["n, angle1, angle2, i1, i2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}",
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] renders the tile as a PolygonOffsetTwistTile for any decoration."
}], "Text",
 CellChangeTimes->{{3.629848267057731*^9, 3.6298482853062563`*^9}, {
   3.629848551984913*^9, 3.629848553749979*^9}, {3.629848591151129*^9, 
