  RowBox[{"StringJoin", "[", 
   RowBox[{"ToString", "/@", "types"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.457998049063136*^9, 3.457998070693295*^9}, {
   3.457998125059573*^9, 3.457998125721494*^9}, 3.627591711593334*^9},
