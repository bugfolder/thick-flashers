Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "=", "2"}], ",", 
      RowBox[{"h", "=", "3"}], ",", 
      RowBox[{"m", "=", "6"}], ",", 
      RowBox[{"f", "=", "5"}], ",", 
      RowBox[{"dr", "=", ".2"}], ",", "tobj", ",", "tobjdp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj", "=", 
      RowBox[{"MakeParaboloidalFlasher", "[", 
       RowBox[{"r", ",", "h", ",", "m", ",", "f", ",", "dr", ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"20.", "\[Degree]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobjdp", "=", 
      RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"tobj", "[", "FlasherDetails", "]"}], "//", "ColumnForm"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"FoldedFormGraphics3D", "[", "tobjdp", "]"}], ",", 
           RowBox[{"Graphics3D", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "f"}], "}"}], "]"}], ",", "Red", ",", 
              RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], "]"}]}], "]"}],
          ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
