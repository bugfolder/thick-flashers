Cell["\<\
Example. Try to make a unit-speed parabola. There\[CloseCurlyQuote]s no \
analytic solution in the usual sense, but Mathematica will find an expression \
using its InverseFunction construction.\
\>", "Text",
 CellChangeTimes->{{3.691581530314789*^9, 3.691581531264145*^9}, {
  3.691592586522756*^9, 3.691592628204698*^9}, {3.800209916009362*^9, 
  3.8002099637771273`*^9}},ExpressionUUID->"24f76951-5323-4ee4-9ad0-\
441890d01871"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "c1", ",", "sd1", ",", "c2", ",", "sd2", ",", "c3", ",", 
      "sd3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c1", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", "0"}], "}"}], "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd1", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"c1", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c1 = \>\"", ",", 
       RowBox[{"c1", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<sd1 = \>\"", ",", 
       RowBox[{"sd1", "/.", 
        RowBox[{"s", "\[Rule]", "\"\<s\>\""}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c2", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         SuperscriptBox["#", "2"]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd2", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"c2", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c2 = \>\"", ",", 
       RowBox[{"c2", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<sd2 = \>\"", ",", 
       RowBox[{"sd2", "/.", 
        RowBox[{"s", "\[Rule]", "\"\<s\>\""}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c3", "=", 
      RowBox[{"MatchCurveSpeed", "[", 
       RowBox[{"c1", ",", "c2", ",", "0", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd3", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"c3", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c3 = \>\"", ",", 
       RowBox[{"c3", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<sd3 = \>\"", ",", 
       RowBox[{"sd3", "/.", 
        RowBox[{"s", "\[Rule]", "\"\<s\>\""}]}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.691581534487035*^9, 3.691581719797289*^9}, {
   3.6915821845856037`*^9, 3.691582187931343*^9}, {3.691582256572974*^9, 
