Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vtobj", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vtobj", "=", 
      RowBox[{"MakeTDegree4Vertex3DFromSectorsAndMinorDihedral", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"150.", "\[Degree]"}], ",", 
          RowBox[{"80.", "\[Degree]"}], ",", 
          RowBox[{"30", "\[Degree]"}], ",", 
          RowBox[{"100.", "\[Degree]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"-", "40."}], "\[Degree]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTHuffmanGrid", "[", 
        RowBox[{"vtobj", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "5"}], "}"}]}], "]"}], "//", 
       "AddTPrimalDualGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"GaussMapGraphics3D", "[", "tobj", "]"}]}], 
        "\[IndentingNewLine]", "}"}], "/.", 
       RowBox[{"Vertex3DStyle", "[", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
