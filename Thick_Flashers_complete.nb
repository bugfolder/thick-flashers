Cell[CellGroupData[{

Cell["Folded form", "Subsection",
 CellChangeTimes->{{3.719925373053091*^9, 3.719925376429039*^9}, {
  3.7199257011265*^9, 
  3.719925701980982*^9}},ExpressionUUID->"1a6fb6c2-674e-4789-8560-\
3245c0f1589d"],

Cell[CellGroupData[{

Cell[TextData[{
 "FlasherFFPointRotation[",
 StyleBox["i, j",
  FontSlant->"Italic"],
 "]\nFlasherFFPointRadialOffset[",
 StyleBox["i, j",
  FontSlant->"Italic"],
 "]\nFlasherFFPointDiscreteHeight[",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.555712228266211*^9, 3.555712235514163*^9}, {
   3.55571872091643*^9, 3.555718758111345*^9}, {3.555765475579214*^9, 
   3.555765478192793*^9}, {3.555766823104807*^9, 3.555766824560306*^9}, 
   3.55585431244217*^9, {3.555954913144929*^9, 3.5559549195010767`*^9}, {
   3.555956222856917*^9, 3.55595622616777*^9}, {3.555956270276532*^9, 
   3.555956271476375*^9}, {3.719856897101097*^9, 3.7198569125475473`*^9}, {
   3.719856989441243*^9, 3.719856991819563*^9}, {3.719918582416169*^9, 
   3.719918586326487*^9}, {3.719918658076989*^9, 3.7199186837712293`*^9}, {
   3.7199187333757763`*^9, 
   3.719918755247081*^9}},ExpressionUUID->"7047ba89-1fc1-4672-84e5-\
0e7fd5c322b4"],

Cell[TextData[{
 "The points of a single sector of the pattern have two indices, ",
 StyleBox["i",
  FontSlant->"Italic"],
 " and ",
 StyleBox["j",
  FontSlant->"Italic"],
 ". There are a couple of useful functions of these indices that are used to \
compute the ideal folded form position."
}], "Text",
 CellChangeTimes->{{3.555714429644994*^9, 3.55571443333828*^9}, {
  3.555716175056884*^9, 3.555716175744997*^9}, {3.55571876610314*^9, 
  3.555718775614873*^9}},ExpressionUUID->"f6e82ed2-02b9-467c-b5c7-\
bfc5d9d85b05"],

Cell[TextData[{
 "FlasherFFPointRotation[",
 StyleBox["i, j",
  FontSlant->"Italic"],
 "] gives the number of times a point in the CP gets rotated in the folded \
form."
}], "Text",
 CellChangeTimes->{
  3.555712247361405*^9, {3.555714930970046*^9, 3.5557149343215847`*^9}, 
   3.719918658103883*^9},ExpressionUUID->"35fa081d-7438-40a3-9abc-\
9711437c5a39"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherFFPointRotation", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"j", "\[LessEqual]", 
     RowBox[{"i", "+", "1"}]}], ",", 
    RowBox[{"i", "+", "1"}], ",", "j"}], "]"}]}]], "Input",
 CellChangeTimes->{3.719918658118165*^9},
 CellLabel->
  "In[4144]:=",ExpressionUUID->"d29ada8a-5a9e-4e63-bcf0-8904cf4a7c44"],

