      RowBox[{
       RowBox[{"GridDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledSurfaceNormalGrid", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sncf", "=", 
      RowBox[{
       RowBox[{"SurfaceColorFunction", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledSurfaceNormalGrid", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sncf", "===", "Automatic"}], ",", 
       RowBox[{"sncf", "=", 
        RowBox[{"SurfaceNormalVectorColor", "&"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"du", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u1", "-", "u0"}], ")"}], "/", "nu"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dv", "=", 
