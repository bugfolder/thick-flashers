  3.485216807534738*^9}, {3.485216858788252*^9, 3.485216870819537*^9}, {
  3.485216909310277*^9, 3.485216951033477*^9}, {3.485216991507023*^9, 
  3.485216994325152*^9}, {3.485217084737146*^9, 3.485217239258871*^9}, {
