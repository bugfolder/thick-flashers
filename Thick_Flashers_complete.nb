Cell[CellGroupData[{

Cell["Example of 3D conic section folds", "Subsubsection",
 CellChangeTimes->{{3.802100130223421*^9, 
  3.802100142007294*^9}},ExpressionUUID->"5f9a3533-70c1-4a28-bc4f-\
621f7a4ede65"],

Cell["\<\
This example illustrates how to start with a 2D pattern and then fold it into \
3D to get both 2D and 3D renderings.\
\>", "Text",
 CellChangeTimes->{{3.8021001486474133`*^9, 3.8021001689753118`*^9}, {
  3.802101319096018*^9, 
  3.802101325695786*^9}},ExpressionUUID->"be56435c-9f07-425d-8f79-\
f649ef6b96b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "fL", ",", "fR", ",", "hL", ",", "hR", ",", "css", ",", "f", ",",
       "bL", ",", "dL", ",", "cL", ",", "bR", ",", "dR", ",", "cR", ",", "rL",
       ",", "rR", ",", "u0", ",", "u1", ",", "ff", ",", "rrL", ",", "rrR", ",",
       "bbL", ",", "ddL", ",", "ccL", ",", "bbR", ",", "ddR", ",", "ccR", ",",
       "gc1", ",", "gc2", ",", "gf"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"2", "D", " ", "description"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fL", ",", "fR"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "2"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"focal", " ", "positions"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"hL", ",", "hR"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"positions", " ", "of", " ", "cross", " ", "curves"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "60"}], "\[Degree]"}], ",", 
        RowBox[{"60", "\[Degree]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"parameter", " ", "domain"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"css", "=", 
      RowBox[{"ConicSection2DSystem", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fL", ",", "fR"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"hL", ",", "hR"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"css", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//", 
      "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "cL", ",", "cR", ",", "bL", ",", "bR"}], "}"}], "=", 
      
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "CurvedFold2D", ",", "SecondCrossCurveLeft2D", ",", 
         "SecondCrossCurveRight2D", ",", "DirectrixLeft2D", ",", 
         "DirectrixRight2D"}], "}"}], "/.", "css"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Fold", " ", "into", " ", "3", "D"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Degree]"}], ",", 
        RowBox[{"120.", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"rL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"cL", "[", "s", "]"}], "-", 
          RowBox[{"f", "[", "s", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"cR", "[", "s", "]"}], "-", 
          RowBox[{"f", "[", "s", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
      RowBox[{"NFoldCurvedFold3D", "[", 
       RowBox[{"f", ",", "rL", ",", "rR", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", 
          RowBox[{
           RowBox[{"-", "60."}], "\[Degree]"}], ",", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"f", "[", "0", "]"}], ",", "0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bbL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ff", "[", "s", "]"}], "+", 
         RowBox[{
          RowBox[{"rrL", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rL", "[", "s", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"bL", "[", "s", "]"}], "-", 
              RowBox[{"f", "[", "s", "]"}]}], ")"}]}], ")"}]}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"bbR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ff", "[", "s", "]"}], "+", 
         RowBox[{
          RowBox[{"rrR", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rR", "[", "s", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"bR", "[", "s", "]"}], "-", 
              RowBox[{"f", "[", "s", "]"}]}], ")"}]}], ")"}]}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ccL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ff", "[", "s", "]"}], "+", 
         RowBox[{
          RowBox[{"rrL", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rL", "[", "s", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"cL", "[", "s", "]"}], "-", 
              RowBox[{"f", "[", "s", "]"}]}], ")"}]}], ")"}]}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ccR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"ff", "[", "s", "]"}], "+", 
         RowBox[{
          RowBox[{"rrR", "[", "s", "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rR", "[", "s", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"cR", "[", "s", "]"}], "-", 
              RowBox[{"f", "[", "s", "]"}]}], ")"}]}], ")"}]}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"optical", " ", "coloring"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gc1", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"StyledCurvedFoldOptical", "[", 
        RowBox[{"f", ",", 
         RowBox[{"{", 
          RowBox[{"cL", ",", "cR"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"bL", ",", "bR"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Sequence", "@@", "CurvedFoldOpticalStyles"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"2", "D", " ", "crease", " ", "pattern"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gc2", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"StyledCurvedFoldOptical", "[", 
        RowBox[{"f", ",", 
         RowBox[{"{", 
          RowBox[{"cL", ",", "cR"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"bL", ",", "bR"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"RulingLineOffset", "\[Rule]", "True"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"RulingLineLeftStyle", "\[Rule]", "ValleyLine"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"RulingLineRightStyle", "\[Rule]", "MountainLine"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldLineStyle", "\[Rule]", "ValleyLine"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FillStyle", "\[Rule]", "NoFill"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"3", "D", " ", "folded", " ", "form"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gf", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"StyledCurvedFoldOptical", "[", 
           RowBox[{"ff", ",", 
            RowBox[{"{", 
             RowBox[{"ccL", ",", "ccR"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"bbL", ",", "bbR"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"RulingLineOffset", "\[Rule]", "True"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", 
             RowBox[{
              RowBox[{"bbL", "[", "u0", "]"}], ",", ".03"}], "]"}], ",", 
            "Red"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Sphere", "[", 
             RowBox[{
              RowBox[{"bbR", "[", "u0", "]"}], ",", ".03"}], "]"}], ",", 
            "Green"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Lighting", "\[Rule]", 
         RowBox[{"NeutralLighting", "[", ".8", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<ShrinkWrap\>\"", "\[Rule]", "True"}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{"gc1", ",", "gc2", ",", "gf"}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.8020977016786823`*^9, 3.80209772581528*^9}, {
  3.802097778734477*^9, 3.802097794702499*^9}, {3.802097860391259*^9, 
  3.8020979270953197`*^9}, {3.8020982566144457`*^9, 3.802098331995217*^9}, {
  3.8020983823995028`*^9, 3.802098834529475*^9}, {3.802098869251389*^9, 
  3.802098964024367*^9}, {3.802099684195199*^9, 3.802099753159503*^9}, {
  3.80209981970525*^9, 3.802099920385911*^9}, {3.802100598160699*^9, 
  3.802100756197242*^9}, {3.802100818097597*^9, 3.802100921161665*^9}, {
  3.802101271008676*^9, 3.802101285795798*^9}, {3.802101374285124*^9, 
  3.802101376496866*^9}},
 CellLabel->
  "In[4031]:=",ExpressionUUID->"c1716f02-319b-4d1a-ba00-4898de33267d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Planar curved folds [DEPRECATED]", "Subsection",
 CellChangeTimes->{{3.694107382263183*^9, 3.6941073871415467`*^9}, {
  3.806504461687342*^9, 
  3.806504464351245*^9}},ExpressionUUID->"bbcda479-e569-4e0b-a172-\
368cb60b42eb"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.694107715913227*^9, 
  3.694107716472645*^9}},ExpressionUUID->"f665f312-a191-41d9-816b-\
000395f8ac60"],

Cell["\<\
This section has functions for working with curved folds that are planar and \
are created by reflecting a surface in a constant plane, called the mirror \
plane.\
\>", "Text",
 CellChangeTimes->{{3.694107412655262*^9, 3.694107419845861*^9}, {
  3.694107721047337*^9, 
  3.694107740336765*^9}},ExpressionUUID->"2523bbc5-31b2-4f73-9d79-\
e5f288f067e2"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PlanarCurvedFold3DSequence[",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", {{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m1",
  FontSlant->"Italic"],
 "},...}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) ComposeReflections, Simplification, Assumptions"
}], "Subsubsection",
 CellChangeTimes->{{3.694116073681051*^9, 3.694116080663991*^9}, 
   3.694116403821804*^9, {3.694116690221582*^9, 3.694116704352896*^9}, {
   3.701385260703289*^9, 3.7013852645182037`*^9}, 3.701388095424985*^9, {
   3.806427617996914*^9, 
   3.806427621685554*^9}},ExpressionUUID->"f3af0d56-3f4b-40cb-a7d9-\
699aab5b0d07"],

Cell[TextData[{
 "PlanarCurvedFold3DSequence[",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", {{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m1",
  FontSlant->"Italic"],
 "},...}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a parameterized surface and a sequence of point/mirror planes \
relative to the original surface and returns two lists of functions that \
describe the surface reverse-folded at each mirror plane intersection."
}], "Text",
 CellChangeTimes->{{3.694116089568431*^9, 3.69411617804052*^9}, {
  3.694116213273121*^9, 3.694116260585855*^9}, {3.694116305186516*^9, 
  3.694116306633852*^9}, {3.694116398235631*^9, 
  3.6941163988993073`*^9}},ExpressionUUID->"8b6660a9-41f0-43cc-b78f-\
502284278858"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["bb",
  FontSlant->"Italic"],
 " \[LongDash] the directrix of the ruled parameterization.\n\t",
 StyleBox["dd",
  FontSlant->"Italic"],
 " \[LongDash] the director of the ruled parameterization.\n\t{{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m1",
  FontSlant->"Italic"],
 "}, ...} \[LongDash] a list of {mirror point, mirror normal vector} pairs \
relative to the original surface that define the positions of the reverse \
folds."
}], "Text",
 CellChangeTimes->{{3.694116266826014*^9, 3.69411638325939*^9}, {
  3.694116417076719*^9, 
  3.694116432355965*^9}},ExpressionUUID->"511f32eb-e6a2-48c5-98da-\
b3cf2a3348f4"],

Cell[TextData[{
 "Options:\n\tComposeReflections \[Rule] True | False, whether to compose the \
reflections. See explanation below.\n\tSimplification \[Rule] None | Simplify \
| FullSimplify, specifies the level of simplification of intermediate \
results.\n\tAssumptions \[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify."
}], "Text",
 CellChangeTimes->{{3.806427630379501*^9, 
  3.806427737280353*^9}},ExpressionUUID->"b99b5b05-12ff-4513-9c2c-\
3bb85b2f6c5e"],

Cell[TextData[{
 "Returns: a list of lists {",
 StyleBox["vi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi",
  FontSlant->"Italic"],
 "} of functions that describe each curved fold, with the first entry being \
the original directrix. For each:\n\t",
 StyleBox["vi",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the distance parameter from the directrix to the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th curve.\n\t",
 StyleBox["bbi",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the directrix of the surface following the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th curve.\n\t",
 StyleBox["cci",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th curve.\n\t",
 StyleBox["ddi",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 "] gives the director of the surface after the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "th curve."
}], "Text",
 CellChangeTimes->{{3.694116436195911*^9, 3.69411652843663*^9}, {
  3.694116561317149*^9, 3.694116675894272*^9}, {3.6941167553354597`*^9, 
  3.694116755783067*^9}, {3.806427909293932*^9, 3.806427917031157*^9}, {
  3.806442852322345*^9, 
  3.806442868905954*^9}},ExpressionUUID->"77200c7a-45f3-42aa-86c6-\
b618b971e368"],

Cell["\<\
If ComposeReflections \[Rule] True, we initially cut the surface with all \
planes to define the fold lines, then fold along those lines. The effect is \
that the position of a later mirror plane is reflected through the mirror \
planes that precedes it in the list.\
\>", "Text",
 CellChangeTimes->{{3.806427751485623*^9, 3.80642778669452*^9}, {
  3.8064280760637603`*^9, 3.8064280771035748`*^9}, {3.806428227000792*^9, 
  3.806428271577943*^9}},ExpressionUUID->"b3951f9c-6c14-4828-ac41-\
e889092ba6fa"],

Cell["\<\
If ComposeReflections \[Rule] False, the surface is reflected in the first \
plane, then the result is reflected in the second, and so forth. In this \
case, each fold line will end up lying within its corresponding plane of \
reflection.\
\>", "Text",
 CellChangeTimes->{{3.8064277898935843`*^9, 3.806427824494225*^9}, {
  3.806428088632127*^9, 3.806428110656753*^9}, {3.80642823008879*^9, 
  3.806428230809635*^9}},ExpressionUUID->"f53a2840-d787-4a62-bed9-\
19a68b91131e"],

Cell["\<\
Note that you can use this to construct the 3D folded form using \
StyledRuledPatch going from one cci[u] function to the next.\
\>", "Text",
 CellChangeTimes->{{3.6941167233435297`*^9, 3.6941167870953093`*^9}, {
  3.806427924918433*^9, 3.806427925671268*^9}, {3.806427973489973*^9, 
  3.806428026136223*^9}},ExpressionUUID->"3f65fcca-7cf0-4554-a827-\
a8966b3f1977"],

Cell["\<\
You can also can use the list of vi[u] functions with the original 2D \
directrix to construct the curves of the ruled crease pattern.\
\>", "Text",
 CellChangeTimes->{{3.806427974512517*^9, 3.806427977613394*^9}, {
  3.806428029559504*^9, 
  3.806428048031616*^9}},ExpressionUUID->"d3eee735-4ac7-42bf-ab1a-\
12eb1b3d62bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ComposeReflections", "::", "usage"}], 
   "=", "\"\<ComposeReflections is an option to PlanarCurvedFold3DSequence \
that specifies whether to compose the planar reflections.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.806427860774318*^9, 3.806427878743216*^9}, {
  3.806428052512542*^9, 3.806428058376677*^9}, {3.806428146768948*^9, 
  3.806428153440968*^9}},
 CellLabel->
  "In[4032]:=",ExpressionUUID->"16b41609-9669-4c3f-9e79-72b531af2aa1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "PlanarCurvedFold3DSequence", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ComposeReflections", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.68980816965057*^9, 3.689808183674678*^9}, 
   3.689848577039259*^9, 3.690988493972368*^9, 3.691179503122077*^9, 
   3.691183960021525*^9, 3.691254300095761*^9, 3.6914944115328407`*^9, 
   3.691496079721467*^9, 3.691504591861905*^9, 3.692200301691255*^9, 
   3.694107806867712*^9, 3.694107857093521*^9, 3.69411683534772*^9, {
   3.80642815662604*^9, 3.806428160512908*^9}, {3.806428275693857*^9, 
   3.806428276113425*^9}},
 CellLabel->
  "In[4033]:=",ExpressionUUID->"3df4975a-b355-4131-b894-858f198c3f7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "PlanarCurvedFold3DSequence", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.806419913026307*^9, 3.806419919400428*^9}},
 CellLabel->
  "In[4034]:=",ExpressionUUID->"d3575d55-7245-4a72-a501-f18a8577c0ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PlanarCurvedFold3DSequence", "[", 
   RowBox[{
   "bblf_Function", ",", "ddlf_Function", ",", "pm_List", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cr", ",", "si", ",", "as", ",", "t", ",", "sfn", ",", "ret", ",", "epm",
       ",", "p", ",", "m", ",", "bbl", ",", "ddl", ",", "vf", ",", "ff", ",", 
      "bbr", ",", "ddr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cr", "=", 
      RowBox[{
       RowBox[{"ComposeReflections", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PlanarCurvedFold3DSequence", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PlanarCurvedFold3DSequence", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "PlanarCurvedFold3DSequence", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ret", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "&"}], ",", "bblf", ",", "bblf", ",", "ddlf"}], "}"}], 
       "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "initial", " ", "entry", " ", "in", " ", "the", " ", "output", " ", 
       "list"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"epm", "=", "pm"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "an", " ", "editable", " ", "copy", " ", "that", " ", "we", " ", "will",
        " ", "manipulate"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bbl", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"bblf", "[", "t", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ddl", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"ddlf", "[", "t", "]"}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "epm", "]"}], ">", "0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"pop", " ", "off", " ", "the", " ", "first", " ", 
         RowBox[{"point", "/", "mirror"}], " ", "pair"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "m"}], "}"}], "=", 
         RowBox[{
         "epm", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"epm", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{"epm", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vf", "=", 
         RowBox[{"Functionize", "[", 
          RowBox[{"t", ",", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"p", "-", 
                RowBox[{"bbl", "[", "t", "]"}]}], ")"}], ".", "m"}], 
             RowBox[{
              RowBox[{"ddl", "[", "t", "]"}], ".", "m"}]], "//", "sfn"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ff", "=", 
         RowBox[{"Functionize", "[", 
          RowBox[{"t", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"bbl", "[", "t", "]"}], "+", 
             RowBox[{
              RowBox[{"vf", "[", "t", "]"}], " ", 
              RowBox[{"ddl", "[", "t", "]"}]}]}], "//", "sfn"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"ddr", "=", 
         RowBox[{"Functionize", "[", 
          RowBox[{"t", ",", 
           RowBox[{
            RowBox[{"Reflectu", "[", 
             RowBox[{
              RowBox[{"ddl", "[", "t", "]"}], ",", "m"}], "]"}], "//", 
            "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bbr", "=", 
         RowBox[{"Functionize", "[", 
          RowBox[{"t", ",", 
           RowBox[{
            RowBox[{"Reflectu", "[", 
             RowBox[{
              RowBox[{"bbl", "[", "t", "]"}], ",", "p", ",", "m"}], "]"}], "//",
             "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "add", " ", "this", " ", "set", " ", "to", " ", "the", " ", "output",
           " ", "list"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"ret", ",", 
          RowBox[{"{", 
           RowBox[{"vf", ",", "bbr", ",", "ff", ",", "ddr"}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"mirror", " ", "all", " ", "subsequent", " ", 
          RowBox[{"point", "/", "mirror"}], " ", "pairs", " ", "in", " ", 
          "this", " ", "one", " ", "unless", " ", 
          RowBox[{"we", "'"}], "re", " ", "composing", " ", 
          RowBox[{"reflections", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        
        RowBox[{"If", "[", 
         RowBox[{"cr", ",", 
          RowBox[{"epm", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Reflectu", "[", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                 ",", "p", ",", "m"}], "]"}], ",", 
               RowBox[{"Reflectu", "[", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 ",", "m"}], "]"}]}], "}"}], "&"}], "/@", "epm"}]}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "and", " ", "setup", " ", "the", " ", "next", " ", "left", " ", 
          "parameterization"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"bbl", "=", "bbr"}], ";", "\[IndentingNewLine]", 
        RowBox[{"ddl", "=", "ddr"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "ret"}]}], "]"}]}]], "Input",
