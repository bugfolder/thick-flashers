Cell[TextData[{
 "FlattenFold2D[",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrR",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D ruled neighborhood of a fold and returns the 2D ruled \
neighborhood of its unfolded form."
}], "Text",
 CellChangeTimes->{{3.799443161176457*^9, 3.79944318707195*^9}, 
   3.801658122657609*^9},ExpressionUUID->"eaf36e1b-7d2a-4088-ae69-\
d21d893bccce"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["ff",
  FontSlant->"Italic"],
 " \[LongDash] the 3D space curve of the fold, as a vector-valued function.\n\
\t",
 StyleBox["\[Gamma]",
  FontSlant->"Italic"],
 " \[LongDash] the fold angle."
}], "Text",
 CellChangeTimes->{{3.7994432330333567`*^9, 3.799443249729931*^9}, {
  3.799443348093048*^9, 
  3.799443354431157*^9}},ExpressionUUID->"2b37cfdd-2bd4-4435-ab98-\
3949f047e222"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify.\n\t\
Options[DSolve] are passed through."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
