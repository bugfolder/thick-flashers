91c10c987623"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", 
       RowBox[{"AddTAssigned", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ColumnForm", "[", 
      RowBox[{"GetAllRules", "[", "tobj", "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592489167995578*^9, 3.592489266449102*^9}, 
   3.592660643499117*^9, 3.592670434896594*^9, 3.592670630166175*^9, 
