Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.707912591306768*^9, 
  3.707912591835819*^9}},ExpressionUUID->"088b66c6-0689-42a0-844a-\
4740c06da039"],

Cell["\<\
These functions support removal of collinear degree-2 vertices in these more \
specialized subclasses of TGraph.\
\>", "Text",
 CellChangeTimes->{{3.707912593810478*^9, 
  3.70791264296397*^9}},ExpressionUUID->"d60684f2-f1a2-4dae-abc9-\
7d6d7fa14b4e"],

Cell["\<\
The functions ApplyCollinearCleanup[*][To] are helper functions that you will \
not usually call. Instead, you should call one of
\tCollinearCleanupGraphAssigned
\tCollinearCleanupGraph2DAssigned
\tCollinearCleanupGraph3DAssigned\
\>", "Text",
 CellChangeTimes->{{3.707859197570978*^9, 3.7078592726099997`*^9}, {
   3.707861826089618*^9, 3.707861827113546*^9}, 
   3.70791266600576*^9},ExpressionUUID->"10d04f60-2994-4223-9052-\
7a2a792bcf57"],

Cell["\<\
Should you implement a subclass that requires further cleanup, it should be \
relatively easy to extend using the model here.\
\>", "Text",
 CellChangeTimes->{{3.707861848409649*^9, 
  3.7078618817628937`*^9}},ExpressionUUID->"daf3be35-45d8-4af0-b9de-\
7301fd286377"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ApplyCollinearCleanupAssignedTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 "]\nApplyCollinearCleanupAssigned[",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraphAssigned"
}], "Subsubsection",
