7c0c2ced1934"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dirs", ",", "dal", ",", "sal", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dirs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "1.`"}], ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"0.20598338218783738`", ",", 
          RowBox[{"-", "0.7983036836917765`"}], ",", 
          RowBox[{"-", "0.5659346913439743`"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "0.7071067811865475`", ",", "0.7071067811865475`", ",", "0.`"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.6393258570250122`"}], ",", "0.10364390117735031`", ",", 
          RowBox[{"-", "0.7619188869479304`"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTDegree4Vertex3D", "[", "dirs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dal", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", "Italic", ",", " ", "14"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<a\>\"", " ", ",", "\"\<b\>\"", ",", "\"\<c\>\"", 
         ",", "\"\<d\>\""}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sal", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", "Italic", ",", " ", "14"}], "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\"", 
         ",", "\"\<D\>\""}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SectorAngles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{"tobj", "[", "SectorAngles", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<DihedralAngles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{"tobj", "[", "DihedralAngles", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Degree4Vertex3DGraphicsTrio", "[", 
       RowBox[{"tobj", ",", "\[IndentingNewLine]", 
        RowBox[{"DihedralAngleLabels", "\[Rule]", "dal"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"SectorAngleLabels", "\[Rule]", "sal"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowOsculatingVector", "\[Rule]", "True"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowRulingVector", "\[Rule]", "True"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowTangentVector", "\[Rule]", "True"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowOsculatingPlane", "\[Rule]", "True"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowRulingPlane", "\[Rule]", "True"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowTangentPlane", "\[Rule]", "True"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ShowRulingGreatCircles", "\[Rule]", "True"}]}], 
       "\[IndentingNewLine]", " ", "]"}], "/.", 
      RowBox[{"Vertex3DStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.442617527517089*^9, 3.442617570011818*^9}, {
