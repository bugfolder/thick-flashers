Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronSinA[",
 StyleBox["p, q, r, s",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.5959758065377197`*^9, 3.595975815321929*^9}, {
   3.5959772720588493`*^9, 3.595977277057139*^9}, 
   3.59597904314955*^9},ExpressionUUID->"8460c4e8-401a-410d-868c-\
adde24a5df74"],

Cell[TextData[{
 "TetrahedronSinA[",
 StyleBox["p, q, r, s",
  FontSlant->"Italic"],
 "] returns the sine of the dihedral angle along edge ",
 StyleBox["p,q",
  FontSlant->"Italic"],
 " for a tetrahedron with vertices ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["s",
  FontSlant->"Italic"],
 ". The sign of the angle is determined by the rotation vector from triangle ",
 StyleBox["p,q,r",
  FontSlant->"Italic"],
 " to triangle ",
 StyleBox["p,q,s",
  FontSlant->"Italic"],
 " about axis ",
 StyleBox["p,q",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.595975830505522*^9, 3.595975885282953*^9}, {
   3.595978104743583*^9, 3.595978119394473*^9}, 3.59597864774561*^9, {
   3.595978997579958*^9, 3.595979019767745*^9}, {3.595979082710415*^9, 
   3.595979133720303*^9}, {3.59597917126215*^9, 3.595979204867899*^9}, {
   3.5959792352581377`*^9, 3.595979240993197*^9}, {3.595981474985169*^9, 
   3.595981498831461*^9}},ExpressionUUID->"9b9d1e40-0a70-4971-9b5d-\
722121fa1b63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronSinA", "[", 
   RowBox[{"p_", ",", " ", "q_", ",", " ", "r_", ",", " ", "s_"}], "]"}], " ",
   ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"Mag", "[", 
     RowBox[{"q", "-", "p"}], "]"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s", "-", "r"}], ")"}], ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", "-", "p"}], ")"}], "\[Cross]", 
       RowBox[{"(", 
        RowBox[{"q", "-", "r"}], ")"}]}], ")"}]}]}], 
   RowBox[{
    RowBox[{"Mag", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"q", "-", "p"}], ")"}], "\[Cross]", 
      RowBox[{"(", 
       RowBox[{"r", "-", "p"}], ")"}]}], "]"}], 
    RowBox[{"Mag", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"q", "-", "p"}], ")"}], "\[Cross]", 
      RowBox[{"(", 
       RowBox[{"s", "-", "p"}], ")"}]}], "]"}]}]]}]], "Input",
 CellChangeTimes->{{3.595978651956435*^9, 3.595978817298987*^9}, 
   3.595978877645165*^9, 3.595979193264821*^9, 3.595979867741114*^9, {
   3.595980941846252*^9, 3.595981030328508*^9}},
 CellLabel->
  "In[665]:=",ExpressionUUID->"5a3ac036-89be-4d73-81c7-04386f76f752"],

