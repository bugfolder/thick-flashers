Cell[TextData[{
 "TetrahedronCosA[",
 StyleBox["p, q, r, s",
  FontSlant->"Italic"],
 "] returns the cosine of the dihedral angle along edge ",
 StyleBox["p-q",
  FontSlant->"Italic"],
 " for a tetrahedron with vertices ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["s",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.595975830505522*^9, 3.595975885282953*^9}, {
