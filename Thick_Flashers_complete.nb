Cell[TextData[{
 "In these next two functions, we represent a \"partial line segment\" by the \
structure {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1}, in which the segment runs from ",
 StyleBox["q1",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", parameterized on a value ",
 StyleBox["t",
  FontSlant->"Italic"],
 "\[Element][0,1], but only the portion whose parameter lies within the range \
[t0, t1] is visible as a folded edge; the rest is hidden. We use this to \
construct the pattern of lines visible on a twist."
}], "Text",
 CellChangeTimes->{{3.457692365676146*^9, 3.457692548128094*^9}, {
  3.80001409262652*^9, 
  3.8000141081318693`*^9}},ExpressionUUID->"9bbf4b61-121a-4e76-9a55-\
2bc149b8de74"],

Cell[TextData[{
 "MakePartialFoldedLine[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", t0, t1}] takes a parameterized segment and creates hidden \
(HiddenFoldedLine) and folded (FoldedLine) styled lines, based on the \
segmentation of the segment."
}], "Text",
 CellChangeTimes->{{3.4576607065468693`*^9, 3.457660709120826*^9}, {
   3.457663653117242*^9, 3.4576636704085*^9}, 3.457732973813793*^9, 
   3.628948527199106*^9, {3.800014092675524*^9, 
   3.800014108160874*^9}},ExpressionUUID->"16934329-47fb-400c-bee0-\
1bf3656da4f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePartialFoldedLine", "[", 
   RowBox[{"{", 
    RowBox[{"q1_", ",", "q2_", ",", "t0_", ",", "t1_"}], "}"}], "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"t0", "\[GreaterEqual]", "t1"}], "||", 
      RowBox[{"t0", "\[GreaterEqual]", "1"}], "||", 
      RowBox[{"t1", "\[LessEqual]", "0"}]}], ",", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], "]"}], ",", "HiddenFoldedLine"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"t0", ">", "0"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"q1", ",", 
              RowBox[{"q1", "+", 
               RowBox[{"t0", 
                RowBox[{"(", 
                 RowBox[{"q2", "-", "q1"}], ")"}]}]}]}], "}"}], "]"}], ",", 
           "HiddenFoldedLine"}], "]"}], ",", 
         RowBox[{"{", "}"}]}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q1", "+", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"t0", ",", "0"}], "]"}], 
              RowBox[{"(", 
               RowBox[{"q2", "-", "q1"}], ")"}]}]}], ",", 
            RowBox[{"q1", "+", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"t1", ",", "1"}], "]"}], 
              RowBox[{"(", 
               RowBox[{"q2", "-", "q1"}], ")"}]}]}]}], "}"}], "]"}], ",", 
         "FoldedLine"}], "]"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"t1", "<", "1"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q1", "+", 
               RowBox[{"t1", 
                RowBox[{"(", 
                 RowBox[{"q2", "-", "q1"}], ")"}]}]}], ",", "q2"}], "}"}], 
            "]"}], ",", "HiddenFoldedLine"}], "]"}], ",", 
         RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.4576637333805313`*^9, 3.457663832143833*^9}, 
   3.457732973848678*^9, {3.628948527290766*^9, 3.6289485274262238`*^9}, {
   3.800014092692211*^9, 3.800014108189499*^9}},
 CellLabel->
  "In[2743]:=",ExpressionUUID->"da0225d7-bbfd-4da2-af53-f1c0627d6ba0"],

Cell["Example", "Text",ExpressionUUID->"074f37ef-01c2-40ca-b9d2-bd16d507e4e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakePartialFoldedLine", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"-", ".3"}], ",", ".6"}], "}"}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.457663683368446*^9, 3.45766368642309*^9}, {
   3.457663841041931*^9, 3.457663844871847*^9}, {3.457663880198279*^9, 
   3.457663885115169*^9}, 3.457732974102268*^9},
 CellLabel->
  "In[2744]:=",ExpressionUUID->"497669c8-50f4-41c3-8f8d-dde7e93fa9ae"],

Cell[TextData[{
 "CoverPartialLine[{",
 StyleBox["a1 ,b1, tmin1, tmax1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["a2, b2, c2, mi",
  FontSlant->"Italic"],
 "] takes two line segments, each parameterized by their endpoints and the \
starting and stopping parameters of the visible part, and returns a modified \
version of line 1 in which the visibility of the line has been reduced; the \
hidden portion is that part of line 1 that extends into the half-plane \
defined by line 2 containing point ",
 StyleBox["c2",
  FontSlant->"Italic"],
 ", which may not lie on line ",
 StyleBox["a2",
  FontSlant->"Italic"],
 "-",
 StyleBox["b2.",
  FontSlant->"Italic"],
 " If parameter ",
 StyleBox["mi",
  FontSlant->"Italic"],
 " (\"must intersect\") is True, the two line segments must actually \
intersect for covering to occur. This is the key routine used by \
TwistFoldedFormLines, see next."
}], "Text",
 CellChangeTimes->{{3.457663915597158*^9, 3.4576639239404173`*^9}, {
   3.457691712320509*^9, 3.457691725789511*^9}, 3.457732870311438*^9, 
   3.457732995950354*^9, {3.592167160374333*^9, 
   3.592167160556829*^9}},ExpressionUUID->"f707ed32-0a9f-4f5c-bfc2-\
b79f014d8005"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CoverPartialLine", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a1_", ",", "b1_", ",", "tmin1_", ",", "tmax1_"}], "}"}], ",", 
    "a2_", ",", "b2_", ",", "c2_", ",", "mi_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"det", "=", 
       RowBox[{"Det", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"b1", "-", "a1"}], ",", 
          RowBox[{"b2", "-", "a2"}]}], "}"}], "]"}]}], ",", "t1", ",", "t2", ",",
       "r2", ",", "sc2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"det", "\[Equal]", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "b1", ",", "tmin1", ",", "tmax1"}], "}"}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"t1", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Det", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a1", "-", "a2"}], ",", 
           RowBox[{"b2", "-", "a2"}]}], "}"}], "]"}]}], "/", "det"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t2", "=", 
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a2", "-", "a1"}], ",", 
          RowBox[{"b1", "-", "a1"}]}], "}"}], "]"}], "/", "det"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r2", "=", 
      RowBox[{"Rotate90", "[", 
       RowBox[{"b2", "-", "a2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sc2", "=", 
      RowBox[{"Sign", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"c2", "-", "a2"}], ")"}], ".", "r2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t1", "<", "0"}], "||", 
        RowBox[{"t1", ">", "1"}], "||", 
        RowBox[{"t2", "<", "0"}], "||", 
        RowBox[{"t2", ">", "1"}]}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "mi"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sc2", "\[Equal]", 
             RowBox[{"Sign", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"a1", "-", "a2"}], ")"}], ".", "r2"}], "]"}]}], "||", 
            
            RowBox[{"sc2", "\[Equal]", 
             RowBox[{"Sign", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"b1", "-", "a2"}], ")"}], ".", "r2"}], "]"}]}]}], 
           ")"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"a1", ",", "b1", ",", "0", ",", "0"}], "}"}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{"a1", ",", "b1", ",", "tmin1", ",", "tmax1"}], "}"}], 
          "]"}]}], "]"}]}], "]"}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sc2", "\[Equal]", 
        RowBox[{"Sign", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "b1"}], "-", "a1", "-", "a2"}], ")"}], ".", "r2"}], 
         "]"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "b1", ",", "tmin1", ",", 
          RowBox[{"Min", "[", 
           RowBox[{"tmax1", ",", "t1"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "b1", ",", 
          RowBox[{"Max", "[", 
           RowBox[{"tmin1", ",", "t1"}], "]"}], ",", "tmax1"}], "}"}], 
        "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.457688549178513*^9, 3.457688566670011*^9}, 
   3.457732995971458*^9},
 CellLabel->
  "In[2745]:=",ExpressionUUID->"9b97ed09-84a7-405f-b9f3-742531366fe7"],

Cell["Example", "Text",ExpressionUUID->"db9e7855-45bb-4957-b593-230b89a28ef4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a1", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"b1", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", ".6"}], "}"}]}], ",", 
      RowBox[{"a2", "=", 
       RowBox[{"{", 
        RowBox[{".4", ",", ".3"}], "}"}]}], ",", 
      RowBox[{"b2", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", ".3"}], "}"}]}], ",", 
      RowBox[{"c2", "=", 
       RowBox[{"{", 
        RowBox[{".7", ",", ".1"}], "}"}]}], ",", "cl"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cl", "=", 
      RowBox[{"CoverPartialLine", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a1", ",", "b1", ",", "0", ",", "1"}], "}"}], ",", "a2", ",",
         "b2", ",", "c2", ",", "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CoverPartialLine = \>\"", ",", "cl"}], "]"}], ";", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", ".02", "]"}], ",", 
        RowBox[{"Point", "/@", 
         RowBox[{"{", 
          RowBox[{"a1", ",", "b1", ",", "a2", ",", "b2", ",", "c2"}], "}"}]}],
         ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"1", ",", "0.5", ",", "0"}], "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{"a2", ",", "b2"}], "}"}], "]"}], ",", 
        RowBox[{
         RowBox[{"MakePartialFoldedLine", "[", "cl", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{
  3.457688632003896*^9, {3.457688670606328*^9, 3.457688806017962*^9}, {
   3.457692576408617*^9, 3.4576926022258663`*^9}, {3.457732974360944*^9, 
   3.4577329960100193`*^9}, {3.457737013302445*^9, 3.457737101696864*^9}, 
   3.4846115643891897`*^9, 3.592167173537166*^9},
 CellLabel->
