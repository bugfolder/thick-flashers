         RowBox[{"ff1", "[", "t", "]"}], "+", 
         RowBox[{
          RowBox[{"vR1", "[", "t", "]"}], 
          RowBox[{"rrR1", "[", "t", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "ti0", ",", "ti3"}], "}"}], ",", "iopts"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"2", "nd", " ", "fold"}], ",", " ", 
       RowBox[{
       "left", " ", "and", " ", "right", " ", "side", " ", "Darboux", " ", 
        "frames"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tt2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        FractionBox[
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"ff2", "[", "t", "]"}], ",", "t"}], "]"}], 
         RowBox[{"Mag", "[", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"ff2", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rrL2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"-", 
         RowBox[{"rrR1", "[", "t", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uuL2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"uuR1", "[", "t", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"llL2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"uuL2", "[", "t", "]"}], "\[Cross]", 
         RowBox[{"tt2", "[", "t", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"llR2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Gamma]2", "[", "t", "]"}], "]"}], 
          RowBox[{"llL2", "[", "t", "]"}]}], "-", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Gamma]2", "[", "t", "]"}], "]"}], 
          RowBox[{"uuL2", "[", "t", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uuR2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Gamma]2", "[", "t", "]"}], "]"}], 
          RowBox[{"llL2", "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Gamma]2", "[", "t", "]"}], "]"}], 
          RowBox[{"uuL2", "[", "t", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Knowing", " ", "that", " ", "3", "rd", " ", "surface", " ", "is", " ",
         "cylindrical"}], ",", " ", 
       RowBox[{
       "we", " ", "know", " ", "rrR2", " ", "is", " ", "a", " ", "constant"}],
        ",", " ", 
       RowBox[{
       "so", " ", "we", " ", "only", " ", "need", " ", "1", " ", "value"}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rrR2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rR2", "[", "t", "]"}], ".", 
            RowBox[{"t2", "[", "t", "]"}]}], ")"}], " ", 
          RowBox[{"tt2", "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rR2", "[", "t", "]"}], ".", 
            RowBox[{"l2", "[", "t", "]"}]}], ")"}], " ", 
          RowBox[{"llR2", "[", "t", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ti12", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"ti1", "+", "ti2"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{"rrR2", "[", "ti12", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"third", " ", "fold"}], ",", " ", 
       RowBox[{
       "along", " ", "the", " ", "the", " ", "edge", " ", "of", " ", "the", " ",
         "cylinder"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ff3", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"ff2", "[", "t", "]"}], "+", 
         RowBox[{
          RowBox[{"vR2", "[", "t", "]"}], 
          RowBox[{"rrR2", "[", "t", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
      "Construct", " ", "the", " ", "mirror", " ", "frames", " ", "and", " ", 
       "the", " ", "pivot", " ", 
       RowBox[{"vector", "."}]}], "\[IndentingNewLine]", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "the", " ", "normal", " ", "vector", " ", "to", " ", 
       "the", " ", "left", " ", "vertical", " ", "plane"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"yL", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ff2", "[", "ti3", "]"}], "-", 
          RowBox[{"ff1", "[", "ti3", "]"}]}], ")"}], "\[Cross]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ff0", "[", "ti3", "]"}], "-", 
          RowBox[{"ff1", "[", "ti3", "]"}]}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "compute", " ", "the", " ", "normal", " ", "vector", " ", "to", " ", 
       "the", " ", "right", " ", "vertical", " ", "plane"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"yR", "=", 
      RowBox[{"rrR2", "[", "ti3", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"compute", " ", "the", " ", "\"\<z\>\"", " ", "vector"}], ",", 
       " ", 
       RowBox[{
       "which", " ", "defines", " ", "the", " ", "direction", " ", "of", " ", 
        "the", " ", "axis", " ", "of", " ", "rotational", " ", 
        RowBox[{"symmetry", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"yL", "\[Cross]", "yR"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "compute", " ", "the", " ", "3", "rd", " ", "vector", " ", "in", " ", 
        "each", " ", "system"}], ",", " ", 
       RowBox[{
       "used", " ", "to", " ", "construct", " ", "the", " ", "plane", " ", 
        "polygons"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"xL", "=", 
      RowBox[{"yL", "\[Cross]", "z"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xR", "=", 
      RowBox[{"yR", "\[Cross]", "z"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"construct", " ", "the", " ", "pivot", " ", "axis"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pv", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"ff2", "[", "ti0", "]"}], "+", 
          RowBox[{"ff0", "[", "ti0", "]"}]}], "2"], "-", 
        RowBox[{"ff1", "[", "ti0", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Return", " ", 
        RowBox[{"values", ":", " ", 
         RowBox[{
         "2", "D", " ", "and", " ", "3", "D", " ", "fold", " ", 
          "sequences"}]}]}], ",", " ", 
       RowBox[{"mirror", " ", "frames"}], ",", " ", 
       RowBox[{"and", " ", "pivot", " ", "vector"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "f0", ",", "f1", ",", "f2", ",", "f3", ",", "ff0", ",", "ff1", ",", 
       "ff2", ",", "ff3", ",", "xL", ",", "xR", ",", "yL", ",", "yR", ",", 
       "z", ",", "pv", ",", "q", ",", "\[Gamma]1", ",", "\[Gamma]2"}], 
      "}"}]}]}], "]"}]}]], "Input",
