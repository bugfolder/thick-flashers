Cell[CellGroupData[{

Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Tolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.629846622752091*^9, 3.629846625422895*^9}, 
   3.7078385601377997`*^9},ExpressionUUID->"b9d047eb-fd2e-45c2-a08c-\
b767c21ba863"],

Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraph2DAssigned+TTwistGraph for the folded form of a unit \
polygon twist. So it contains Vertices for the CP and Vertices2D for the FF, \
but note that they are at different relative scale, so as to fit within the \
same tile. That is, the FF is not actually what you\[CloseCurlyQuote]d get if \
you folded the CP, but rather, it is the equivalent folded form tile."
}], "Text",
 CellChangeTimes->{{3.4577256920561132`*^9, 3.4577257049238033`*^9}, {
   3.4577412006642714`*^9, 3.457741207355151*^9}, 3.4851968678273377`*^9, 
