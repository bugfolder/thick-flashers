Cell[BoxData[
 RowBox[{
  RowBox[{"MakeDihedralsFromSectorsAndMajorDihedral", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]1_", ",", "\[Alpha]2_", ",", "\[Alpha]3_", ",", "\[Alpha]4_"}], 
     "}"}], ",", "\[Gamma]1_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "asi", ",", "ma", ",", "ba", ",", "mu", ",", "\[Gamma]2", ",", 
      "\[Gamma]3", ",", "\[Gamma]4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"asi", "=", 
      RowBox[{
       RowBox[{"AllowSelfIntersection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "MakeDihedralsFromSectorsAndMajorDihedral", "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DevelopableAnglesQ", "[", 
         RowBox[{"{", 
          RowBox[{
          "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}],
           "}"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{
          "MakeDihedralsFromSectorsAndMajorDihedral", "::", "baddev"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", 
            "\[Alpha]4"}], "}"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MajorFirstStraightMajorAnglesQ", "[", 
        RowBox[{"{", 
         RowBox[{
         "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
         "}"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{
          "MakeDihedralsFromSectorsAndMajorDihedral", "::", "strtmjr"}], ",", 
          
          RowBox[{"{", 
           RowBox[{
           "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", 
            "\[Alpha]4"}], "}"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ma", "=", 
      RowBox[{"MaximumDihedralAngles", "[", 
       RowBox[{"{", 
        RowBox[{
        "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
        "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "\[Gamma]1", "]"}], ">", 
        RowBox[{
        "ma", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{
          "MakeDihedralsFromSectorsAndMajorDihedral", "::", "maxangle"}], ",",
           "\[Gamma]1", ",", 
          RowBox[{
          "ma", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", 
            "\[Alpha]4"}], "}"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ba", "=", 
      RowBox[{"MajorFirstBindingDihedralAngles", "[", 
       RowBox[{"{", 
        RowBox[{
        "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
        "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", "asi"}], "&&", 
        RowBox[{
         RowBox[{"Abs", "[", "\[Gamma]1", "]"}], ">", 
         RowBox[{
         "ba", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{
          "MakeDihedralsFromSectorsAndMajorDihedral", "::", "binding"}], ",", 
          "\[Gamma]1", ",", 
          RowBox[{
          "ba", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", 
            "\[Alpha]4"}], "}"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Alpha]1", "+", "\[Alpha]3"}], "\[Equal]", "\[Pi]"}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"flat", "-", "foldable"}], ",", " ", 
         RowBox[{"formulas", " ", "simplify", " ", "a", " ", "lot"}]}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mu", "=", 
         FractionBox[
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Alpha]4", "+", "\[Alpha]1"}], "2"], "]"}], 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"\[Alpha]4", "-", "\[Alpha]1"}], "2"], "]"}]]}], ";", 
        RowBox[{"\[Gamma]3", "=", "\[Gamma]1"}], ";", 
        RowBox[{"\[Gamma]4", "=", 
         RowBox[{"2", 
          RowBox[{"ArcTan", "[", " ", 
           RowBox[{
            RowBox[{"Tan", "[", 
             FractionBox["\[Gamma]1", "2"], "]"}], "/", "mu"}], "]"}]}]}], ";", 
        RowBox[{"\[Gamma]2", "=", 
         RowBox[{"-", "\[Gamma]4"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Alpha]4", "+", "\[Alpha]1"}], "\[Equal]", "\[Pi]"}], ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"straight", "-", "minor"}], ",", " ", 
         RowBox[{
          RowBox[{"though", " ", "not", " ", "flat"}], "-", "foldable"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Gamma]3", "=", 
         RowBox[{"2", " ", 
          RowBox[{"ArcSin", "[", " ", 
           RowBox[{
            RowBox[{"Sin", "[", 
             FractionBox["\[Gamma]1", "2"], "]"}], 
            FractionBox[
             RowBox[{"Sin", "[", "\[Alpha]4", "]"}], 
             RowBox[{"Sin", "[", "\[Alpha]2", "]"}]]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]4", "=", 
         RowBox[{"2", 
          RowBox[{"ArcCot", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Cot", "[", 
                 FractionBox["\[Gamma]1", "2"], "]"}], " ", 
                RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "+", 
               RowBox[{
                RowBox[{"Cot", "[", 
                 FractionBox["\[Gamma]3", "2"], "]"}], 
                RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}]}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Cot", "[", "\[Alpha]4", "]"}], "+", 
               RowBox[{"Cot", "[", "\[Alpha]2", "]"}]}], ")"}]}], 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Csc", "[", "\[Alpha]2", "]"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"Csc", "[", "\[Alpha]1", "]"}], "2"]}]], "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]2", "=", 
         RowBox[{"-", "\[Gamma]4"}]}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", "True", ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"not", " ", "flat"}], "-", "foldable"}], ",", " ", 
         RowBox[{
         "but", " ", "we", " ", "still", " ", "have", " ", "formulas"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Gamma]3", "=", 
         RowBox[{"2", 
          RowBox[{"ArcSin", "[", 
           RowBox[{
            RowBox[{"Sin", "[", 
             FractionBox["\[Gamma]1", "2"], "]"}], 
            SqrtBox[
             FractionBox[
              RowBox[{
               RowBox[{"Sin", "[", "\[Alpha]4", "]"}], 
               RowBox[{"Sin", "[", "\[Alpha]1", "]"}]}], 
              RowBox[{
               RowBox[{"Sin", "[", "\[Alpha]2", "]"}], 
               RowBox[{"Sin", "[", "\[Alpha]3", "]"}]}]]]}], "]"}]}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"from", " ", 
           RowBox[{"Huffman", "'"}], "s", " ", "Major"}], "-", 
          RowBox[{"Angle", " ", "Identity"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]4", "=", 
         RowBox[{"2", 
          RowBox[{"ArcCot", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]1", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]4", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]2", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]1", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]3", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]2", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]4", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]1", "]"}]}]}], ")"}]}], "]"}]}]}],
         ";", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"from", " ", "general", " ", "adjacent"}], "-", 
          RowBox[{"angle", " ", "identity"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]2", "=", 
         RowBox[{"2", 
          RowBox[{"ArcCot", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]1", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Cot", "[", 
                FractionBox["\[Gamma]3", "2"], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cot", "[", "\[Alpha]4", "]"}], "+", 
                 RowBox[{"Cot", "[", "\[Alpha]2", "]"}]}], ")"}], 
               RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]2", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}], "-", 
              RowBox[{
               RowBox[{"Csc", "[", "\[Alpha]4", "]"}], 
               RowBox[{"Csc", "[", "\[Alpha]1", "]"}]}]}], ")"}]}], 
           "]"}]}]}]}]}], 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"from", " ", "general", " ", "adjacent"}], "-", 
        RowBox[{"angle", " ", "identity"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4"}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.594758524013739*^9, 3.594758593947508*^9}, {
   3.594758630513091*^9, 3.594758751521736*^9}, 3.594758820533544*^9, {
   3.594758917103615*^9, 3.594758936516608*^9}, {3.594759280872106*^9, 
