Cell[TextData[{
 "EdgeFacePairs[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.628868447241885*^9, 
  3.628868461576251*^9}},ExpressionUUID->"f1b5495a-7cc5-4ee3-b9e9-\
795e3657d224"],

Cell[TextData[{
 "EdgeFacePairs[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of the indices of the incident faces for each edge in ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.628868479044138*^9, 3.628868500743002*^9}, {
  3.628868539275654*^9, 
  3.628868590322534*^9}},ExpressionUUID->"a4267726-5c4d-44fd-ae04-\
47decedebbba"],

Cell["\<\
This is the same data that\[CloseCurlyQuote]s in the property \
EdgeFaceIncidence of a TPlaneGraph, but we don\[CloseCurlyQuote]t require a \
full TPlaneGraph, since circular polygon graphs and twist tiles are not \
those; they\[CloseCurlyQuote]re missing their border edges.\
\>", "Text",
 CellChangeTimes->{{3.628868592174021*^9, 3.628868613406799*^9}, {
  3.6288693750545464`*^9, 
  3.62886937843819*^9}},ExpressionUUID->"a94fb44b-9b15-4444-9131-\
ca8a9fc09d62"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeFacePairs", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"edges", ",", "faces", ",", "fe"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fe", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Reverse", "/@", "#"}]}], "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"RotateLeft", "[", "#", "]"}]}], "}"}], "]"}], "&"}], "/@",
          "faces"}], ")"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"all", " ", "edges", " ", "for", " ", "each", " ", "face"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"First", "/@", 
        RowBox[{"Position", "[", 
         RowBox[{"fe", ",", "#"}], "]"}]}], "&"}], "/@", "edges"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.6288686262193003`*^9, 3.628868643462358*^9}, {
