Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "verts2d", ",", "edges", ",", "tobj"}], "}"}], ",",
