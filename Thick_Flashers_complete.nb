Cell[TextData[{
 "CircularRegularPolygonTwistPairGraphics[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a Graphics object that displays the crease pattern and folded \
form for the same parameters side by side. Note that you still have to apply \
OrigamiStyle to render it. Options are:\n\tSpacing \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the fractional spacing between them (this option is passed through to \
PlaceInRowGraphics)\n\tCircleDivisions \[Rule] ",
 StyleBox["cd",
  FontSlant->"Italic"],
 ", option pass through to CircularlyCompletePoly"
}], "Text",
 CellChangeTimes->{{3.457983287971663*^9, 3.457983356487824*^9}, {
