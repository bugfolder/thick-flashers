Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["c",
  FontSlant->"Italic"],
 " \[LongDash] a pure function that specifies the arbitrary-speed (3D) space \
curve.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
