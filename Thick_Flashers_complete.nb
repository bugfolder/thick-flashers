Cell[BoxData[
 RowBox[{
  RowBox[{"NFoldAcrossRight2D", "[", 
   RowBox[{
    RowBox[{"f_Function", "|", "f_InterpolatingFunction"}], ",", 
    RowBox[{"rL_Function", "|", "rL_InterpolatingFunction"}], ",", 
    RowBox[{"\[Gamma]_Function", "|", "\[Gamma]_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", " ", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "csys", ",", "ds", ",", "\[Kappa]g", ",", "t", ",", "l", ",", 
      "cot\[Rho]L", ",", "expr1", ",", "expr2", ",", "c\[Rho]L", ",", 
      "s\[Rho]L", ",", "c\[Rho]R", ",", "s\[Rho]R", ",", "rR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "curve", " ", "fold", " ", "system", " ", "and", " ", "Frenet", " ", 
      "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"csys", "=", 
      RowBox[{"NCurve2DSystem", "[", 
       RowBox[{"f", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "\[Kappa]g", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed2D", ",", "LeftCurvature2D", ",", "TangentVector2D", ",", 
         "LeftNormalVector2D"}], "}"}], "/.", "csys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"f", "'"}], "[", "s", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", 
         RowBox[{"t", "[", "s", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cot\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{
          RowBox[{"t", "[", "s", "]"}], ".", 
          RowBox[{"rL", "[", "s", "]"}]}], 
         RowBox[{
          RowBox[{"l", "[", "s", "]"}], ".", 
          RowBox[{"rL", "[", "s", "]"}]}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Right", " ", "ruling", " ", "angle", " ", "sines", " ", "and", " ", 
       "cosines"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"expr1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Tan", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
          RowBox[{"cot\[Rho]L", "[", "s", "]"}]}], "-", 
         FractionBox[
          RowBox[{
           RowBox[{"\[Gamma]", "'"}], "[", "s", "]"}], 
          RowBox[{
           RowBox[{"ds", "[", "s", "]"}], " ", 
           RowBox[{"\[Kappa]g", "[", "s", "]"}]}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"expr2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"Tan", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"expr1", "[", "s", "]"}], "2"]}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{"\[Gamma]", "[", "s", "]"}], "]"}], 
         FractionBox[
          RowBox[{
           RowBox[{"expr1", "[", "s", "]"}], " "}], 
          RowBox[{"expr2", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]R", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{"Tan", "[", 
           FractionBox[
            RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], "]"}], 
         RowBox[{"expr2", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "ruling", " ", "vector"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rR", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix2D", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c\[Rho]R", "[", "s", "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"s\[Rho]R", "[", "s", "]"}]}]}], "}"}], "]"}], ".", 
         RowBox[{"t", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"f", ",", "rL", ",", "rR"}], "}"}]}]}], "]"}]}]], "Input",
