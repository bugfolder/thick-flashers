                RowBox[{"{", 
                 RowBox[{"g2", ",", 
                  RowBox[{"g1", "-", "g2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"g7", ",", "uq"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"LinePlaneInt3D", "[", 
