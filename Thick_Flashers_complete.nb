      RowBox[{"80", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", "2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype1", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"ctype2", "=", "V"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types1", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "M", ",", "M"}], "}"}]}], ";", 
