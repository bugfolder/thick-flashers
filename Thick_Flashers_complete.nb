   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594993771711656*^9, 3.594993810471897*^9}, {
   3.594993916807595*^9, 3.594993927196415*^9}, 3.594994009777563*^9, {
