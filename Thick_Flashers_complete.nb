Cell[CellGroupData[{

Cell["Waterbomb tessellation", "Subsection",
 CellChangeTimes->{{3.701187881736595*^9, 
  3.701187885849022*^9}},ExpressionUUID->"cb7b84a0-02c5-4b1d-b73b-\
8598e621e49b"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.701187889087806*^9, 
  3.701187889832757*^9}},ExpressionUUID->"da0dc06b-49cc-4344-aa9c-\
37947ca3c752"],

Cell["\<\
The Waterbomb tessellation (or \[OpenCurlyDoubleQuote]Magic Ball\
\[CloseCurlyDoubleQuote]) has some very interesting kinematic properties. \
Here we construct an analytic model of its periodic 3D form.\
\>", "Text",
 CellChangeTimes->{{3.701187891312914*^9, 3.701187916169697*^9}, {
  3.701256159869868*^9, 3.701256199657935*^9}, {3.701366363627383*^9, 
  3.7013663719378777`*^9}, {3.7013671469860997`*^9, 
  3.701367148216764*^9}},ExpressionUUID->"395c761c-85c4-4d8c-9224-\
8aac7f4766e4"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeWaterbombTessellation[",
 StyleBox["nx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ny",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.701187923096273*^9, 3.701187927169143*^9}, {
   3.701187998163903*^9, 3.701188012995424*^9}, {3.701288023538645*^9, 
   3.701288024281959*^9}, {3.7013640101350536`*^9, 3.701364025070318*^9}, 
   3.701365762566126*^9},ExpressionUUID->"4619fccd-623a-4715-985c-\
6d0cd14f7678"],

Cell[TextData[{
 "MakeWaterbombTessellation[",
 StyleBox["nx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ny, t",
  FontSlant->"Italic"],
 "] creates a TGraph3D+TAssigned of a flat-folded waterbomb tessellation with \
",
 StyleBox["nx",
  FontSlant->"Italic"],
 " repeats horizontally and ",
 StyleBox["ny",
  FontSlant->"Italic"],
 " repeats vertically in the crease pattern."
}], "Text",
 CellChangeTimes->{{3.701188008448606*^9, 3.701188036667107*^9}, {
   3.701188090370562*^9, 3.701188118058981*^9}, {3.701204765498662*^9, 
   3.701204765672072*^9}, {3.701205883426332*^9, 3.701205884034145*^9}, {
   3.7012880303209553`*^9, 3.701288035554641*^9}, {3.701364014654255*^9, 
   3.7013640464464626`*^9}, 
   3.701367182673279*^9},ExpressionUUID->"655fd0e1-ee21-43c9-9516-\
6fd89dfa7aa3"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["nx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ny",
  FontSlant->"Italic"],
 " \[LongDash] number of square units in the x and y direction.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] a parameter in [0, 1] that determines the 3D folded state, \
where 0 is unfolded, 1 is flat-folded."
}], "Text",
 CellChangeTimes->{{3.701364057695009*^9, 3.701364094846603*^9}, {
   3.701365834205576*^9, 3.701365841845235*^9}, 
   3.7013671885455236`*^9},ExpressionUUID->"7dcf0d6c-8c21-4a6b-935a-\
7069e8aed863"],

Cell["\<\
In both CP and FF, the lower left corner is at the origin and the four \
corners of the lower left unit, which is a Waterbomb base, lie in the x-y \
plane.\
\>", "Text",
 CellChangeTimes->{{3.701364096806961*^9, 
  3.701364146726471*^9}},ExpressionUUID->"f023b97d-5316-416a-90d1-\
b8bc5f39a75f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeWaterbombTessellation", "[", 
   RowBox[{"nx_", ",", "ny_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "h", ",", "p1", ",", "p2", ",", "p3", ",", "p4", ",", "p5", ",", "p6", ",",
        "p7", ",", "q1", ",", "q2", ",", "q3", ",", "q4", ",", "q5", ",", 
       "q6", ",", "q7", ",", "q8", ",", "xfrm", ",", "verts", ",", "verts3d", 
       ",", "edges", ",", "types", ",", "foldangles", ",", "vi", ",", "makev",
        ",", "makee"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h", "=", 
       RowBox[{"1", "/", "2"}]}], ";", "\[IndentingNewLine]", 
