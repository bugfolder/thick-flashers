Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTSpaceCurve", "[", 
   RowBox[{"plist_List", ",", "w_", ",", " ", "s_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fca", ",", "ovn", ",", "wl", ",", "wr", ",", "sl", ",", "sr", ",", "op",
       ",", "nn", ",", "pp", ",", "rr", ",", "ll", ",", "qq", ",", "ta", ",", 
      "\[Gamma]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "aa", ",", "gg", ",",
       "tl", ",", "tr", ",", "ppl", ",", "ppr", ",", "itobj", ",", "p", ",", 
      "pl", ",", "pr", ",", "r", ",", "g", ",", "wlm", ",", "wrm", ",", "dn", 
      ",", "wm0", ",", "verts", ",", "edges", ",", "faces", ",", "verts3d", ",",
       "foldangles", ",", "types", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fca", "=", 
      RowBox[{
       RowBox[{"SpaceCurveFirstCreaseAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTSpaceCurve", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ovn", "=", 
      RowBox[{
       RowBox[{"OsculatingVectorNear", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeTSpaceCurve", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "get", " ", "left", " ", "and", " ", "right", " ", "angles", " ", "and",
        " ", "widths"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "w", "]"}], "===", "List"}], ",", 
       RowBox[{
        RowBox[{"wl", "=", 
         RowBox[{
         "w", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"wr", "=", 
         RowBox[{
         "w", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ",",
        " ", 
       RowBox[{"wl", "=", 
        RowBox[{"wr", "=", "w"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "s", "]"}], "===", "List"}], ",", 
       RowBox[{
        RowBox[{"sl", "=", 
         RowBox[{
         "s", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"sr", "=", 
         RowBox[{
         "s", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ",",
        " ", 
       RowBox[{"sl", "=", 
        RowBox[{"sr", "=", "s"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"start", " ", "building", " ", "lists"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{
       RowBox[{"Length", "[", "plist", "]"}], "-", "1"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "index", " ", "of", " ", "the", " ", "vertices", " ", "runs", " ", 
       "from", " ", "0", " ", "to", " ", "nn"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pp", "[", "i", "]"}], "=", 
        RowBox[{"plist", "\[LeftDoubleBracket]", 
         RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nn"}], "}"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"variable", " ", 
         RowBox[{"pp", "[", "i", "]"}], " ", "is", " ", "just", " ", "for", " ",
          "convenience"}], " ", "&"}], " ", "consistency", " ", 
       RowBox[{"of", " ", "[", "]"}], " ", 
       RowBox[{
        RowBox[{
        "versus", " ", "\[LeftDoubleBracket]", "\[RightDoubleBracket]"}], 
        "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"rr", "[", "i", "]"}], "=", 
        RowBox[{"NormalizeReal", "[", 
         RowBox[{
          RowBox[{"pp", "[", "i", "]"}], "-", 
          RowBox[{"pp", "[", 
           RowBox[{"i", "-", "1"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "direction", " ", "vectors", " ", "along", " ", "the", " ", "curve"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ll", "[", "i", "]"}], "=", 
        RowBox[{"Mag", "[", 
         RowBox[{
          RowBox[{"pp", "[", "i", "]"}], "-", 
          RowBox[{"pp", "[", 
           RowBox[{"i", "-", "1"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "segment", " ", "lengths", " ", "along", " ", "the", " ", "curve"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"first", " ", "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qq", "[", "0", "]"}], "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"rr", "[", "1", "]"}], "\[Cross]", 
        RowBox[{"rr", "[", "2", "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "osculating", " ", "vector"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qq", "[", "0", "]"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ovn", "===", "None"}], ",", 
        RowBox[{"qq", "[", "0", "]"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"qq", "[", "0", "]"}], ".", "ovn"}], ">", "0"}], ",", 
          RowBox[{"qq", "[", "0", "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"qq", "[", "0", "]"}]}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Sigma]", "[", "0", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"sr", ",", "sl", ",", "Null", ",", "Null"}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"subarc", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "0", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"sr", "+", "sl"}], ",", "0", ",", 
        RowBox[{"sr", "+", "sl"}]}], "}"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"dihedral", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gg", "[", "0", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Pi]", "/", "2"}], "-", "sr"}], ")"}], ",", 
           RowBox[{"rr", "[", "1", "]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "0", "]"}]}], ",", 
        RowBox[{"rr", "[", "1", "]"}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Pi]", "/", "2"}], "-", "sl"}], ")"}]}], ",", 
           RowBox[{"rr", "[", "1", "]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "0", "]"}]}], ",", 
        RowBox[{"-", 
         RowBox[{"rr", "[", "1", "]"}]}]}], "}"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"fold", " ", "vectors"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aa", "[", "0", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{"sr", ",", 
           RowBox[{
            RowBox[{"gg", "[", "0", "]"}], "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "0", "]"}]}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"-", "sl"}], ",", 
           RowBox[{
            RowBox[{"gg", "[", "0", "]"}], "\[LeftDoubleBracket]", "2", 
            "\[RightDoubleBracket]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "0", "]"}]}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{
           RowBox[{"-", "sl"}], ",", 
           RowBox[{
            RowBox[{"gg", "[", "0", "]"}], "\[LeftDoubleBracket]", "4", 
            "\[RightDoubleBracket]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "0", "]"}]}], ",", 
        RowBox[{
         RowBox[{"RotationMatrix3Du", "[", 
          RowBox[{"sr", ",", 
           RowBox[{
            RowBox[{"gg", "[", "0", "]"}], "\[LeftDoubleBracket]", "4", 
            "\[RightDoubleBracket]"}]}], "]"}], ".", 
         RowBox[{"qq", "[", "0", "]"}]}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "vectors"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"\[Alpha]", "[", "0", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "2"}], ",", 
        RowBox[{"\[Pi]", "/", "2"}], ",", 
        RowBox[{"\[Pi]", "/", "2"}], ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"sector", " ", "angles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tl", "[", "0", "]"}], "=", "wl"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"distance", " ", "along", " ", "left"}], "-", 
       RowBox[{"side", " ", "crease"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"tr", "[", "0", "]"}], "=", "wr"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"distance", " ", "along", " ", "right"}], "-", 
       RowBox[{"side", " ", "crease"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{"interior", " ", "vertices"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", " ", 
       RowBox[{"compute", " ", "torsion"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"qq", "[", "i", "]"}], "=", 
         RowBox[{"NormalizeReal", "[", 
          RowBox[{
           RowBox[{"rr", "[", "i", "]"}], "\[Cross]", 
           RowBox[{"rr", "[", 
            RowBox[{"i", "+", "1"}], "]"}]}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"qq", "[", "i", "]"}], ".", 
            RowBox[{"qq", "[", 
             RowBox[{"i", "-", "1"}], "]"}]}], "<", "0"}], ",", 
          RowBox[{
           RowBox[{"qq", "[", "i", "]"}], "=", 
           RowBox[{"-", 
            RowBox[{"qq", "[", "i", "]"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ta", "[", "i", "]"}], "=", 
         RowBox[{"DirectedAngle3D", "[", 
          RowBox[{
           RowBox[{"qq", "[", 
            RowBox[{"i", "-", "1"}], "]"}], ",", 
           RowBox[{"qq", "[", "i", "]"}], ",", 
           RowBox[{"rr", "[", "i", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"construct", " ", "the", " ", "next", " ", "vertex"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"itobj", "[", "i", "]"}], "=", 
         RowBox[{"MakeTDegree4Vertex3DFromSubarcs", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"rr", "[", "i", "]"}]}], ",", 
           RowBox[{"rr", "[", 
            RowBox[{"i", "+", "1"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Sigma]", "[", 
              RowBox[{"i", "-", "1"}], "]"}], "\[LeftDoubleBracket]", "2", 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{"ta", "[", "i", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Sigma]", "[", 
              RowBox[{"i", "-", "1"}], "]"}], "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}], "+", 
            RowBox[{"ta", "[", "i", "]"}]}], ",", "1", ",", 
           RowBox[{"OsculatingVectorNear", "\[Rule]", 
            RowBox[{"qq", "[", 
             RowBox[{"i", "-", "1"}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Sigma]", "[", "i", "]"}], ",", 
           RowBox[{"\[Gamma]", "[", "i", "]"}], ",", 
           RowBox[{"\[Alpha]", "[", "i", "]"}], ",", 
           RowBox[{"aa", "[", "i", "]"}], ",", 
           RowBox[{"gg", "[", "i", "]"}], ",", 
           RowBox[{"qq", "[", "i", "]"}]}], "}"}], "=", 
         RowBox[{"GetValues", "[", 
          RowBox[{
           RowBox[{"itobj", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "SubarcAngles", ",", "DihedralAngles", ",", "SectorAngles", ",", 
             "SectorVectors", ",", "FoldVectors", ",", "OsculatingVector"}], 
            "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tl", "[", "i", "]"}], "=", 
         FractionBox["wl", 
          SqrtBox[
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Alpha]", "[", "i", "]"}], "\[LeftDoubleBracket]", 
              "2", "\[RightDoubleBracket]"}], "]"}], 
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Alpha]", "[", "i", "]"}], "\[LeftDoubleBracket]", 
              "3", "\[RightDoubleBracket]"}], "]"}]}]]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tr", "[", "i", "]"}], "=", 
         FractionBox["wr", 
          SqrtBox[
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Alpha]", "[", "i", "]"}], "\[LeftDoubleBracket]", 
              "1", "\[RightDoubleBracket]"}], "]"}], 
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"\[Alpha]", "[", "i", "]"}], "\[LeftDoubleBracket]", 
              "4", "\[RightDoubleBracket]"}], "]"}]}]]]}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"nn", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"last", " ", "vertex"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qq", "[", "nn", "]"}], "=", 
      RowBox[{"qq", "[", 
       RowBox[{"nn", "-", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sl", "=", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"nn", "-", "1"}], "]"}], "\[LeftDoubleBracket]", "2", 
       "\[RightDoubleBracket]"}]}], ";", 
     RowBox[{"sr", "=", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"nn", "-", "1"}], "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Sigma]", "[", "nn", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"Null", ",", "Null", ",", "sl", ",", "sr"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "nn", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"sr", "+", "sl"}], ",", "0", ",", 
        RowBox[{"sr", "+", "sl"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gg", "[", "nn", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{
