             RowBox[{"{", 
              
              RowBox[{"\"\<p\>\"", ",", "\"\<q1\>\"", ",", "\"\<q2\>\"", 
               ",", "\"\<pp\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"p", ",", "q1", ",", "q2", ",", "pp"}], "}"}]}], 
            "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
