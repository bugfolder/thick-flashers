Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronVolumeSquared[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595713120132145*^9, 3.595713133545433*^9}, {
  3.768661896302619*^9, 
  3.768661897044189*^9}},ExpressionUUID->"69a9e684-cebc-4993-8ff2-\
3e5e2b8c3471"],

Cell[TextData[{
 "TetrahedronVolume[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "] gives the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["volume", "2"], TraditionalForm]],ExpressionUUID->
  "f0a34007-4201-4255-831b-dfa30accc0ef"],
 " of a tetrahedron whose edge lengths are ",
 StyleBox["a\[Dash]f",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.595713145577135*^9, 3.595713162662592*^9}, 
   3.768661859394041*^9, {3.768661900907*^9, 
   3.768661901237376*^9}},ExpressionUUID->"f9e25754-abad-4462-8fde-\
1d1d9053aad7"],

Cell["\<\
If the edge lengths are incompatible, the resulting value will be negative.\
\>", "Text",
 CellChangeTimes->{{3.768661866731229*^9, 3.768661909094925*^9}, {
  3.768661961129871*^9, 
  3.768661968362616*^9}},ExpressionUUID->"b91f03d9-9590-4eab-86bd-\
9e7c8084fe0c"],

Cell["\<\
This comes from the Cayley-Menger determinant formula for tetrahedron volume.\
\
\>", "Text",
 CellChangeTimes->{{3.768661044092875*^9, 
  3.768661060231169*^9}},ExpressionUUID->"8e1e9ed4-ed2a-4cdf-b36d-\
1a277fad4345"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronVolumeSquared", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "e_", ",", "f_"}], 
   "]"}], ":=", 
  RowBox[{
   FractionBox["1", "288"], 
   RowBox[{"Det", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", 
        SuperscriptBox["a", "2"], ",", 
        SuperscriptBox["d", "2"], ",", 
        SuperscriptBox["b", "2"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        SuperscriptBox["a", "2"], ",", "0", ",", 
        SuperscriptBox["e", "2"], ",", 
        SuperscriptBox["c", "2"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        SuperscriptBox["d", "2"], ",", 
        SuperscriptBox["e", "2"], ",", "0", ",", 
        SuperscriptBox["f", "2"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        SuperscriptBox["b", "2"], ",", 
        SuperscriptBox["c", "2"], ",", 
        SuperscriptBox["f", "2"], ",", "0"}], "}"}]}], "}"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.595713177563087*^9, 3.595713201086776*^9}, {
  3.595713242021379*^9, 3.595713365341716*^9}, {3.768661917418466*^9, 
  3.768661931517377*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"6d89b19a-8e1d-42a2-bf05-396291b63490"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronExistsQ[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595713120132145*^9, 3.595713133545433*^9}, {
  3.768661896302619*^9, 3.768661897044189*^9}, {3.768662014252771*^9, 
  3.76866201736089*^9}},ExpressionUUID->"2f116618-18b4-4401-8b44-\
4af7b541be32"],

Cell[TextData[{
 "TetrahedronExistsQ[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "] returns True if a tetrahedron with edge lengths ",
 StyleBox["a",
  FontSlant->"Italic"],
 "\[Dash]",
 StyleBox["f",
  FontSlant->"Italic"],
 " exist (which includes degenerate tetrahedra, where the four vertices are \
coplanar)."
}], "Text",
 CellChangeTimes->{{3.595713145577135*^9, 3.595713162662592*^9}, 
   3.768661859394041*^9, {3.768661900907*^9, 3.768661901237376*^9}, {
   3.7686620220064387`*^9, 3.768662058357207*^9}, {3.768662104449501*^9, 
   3.7686621134662523`*^9}},ExpressionUUID->"07219fdf-f5f8-43bf-b8fb-\
8f94c700a5ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronExistsQ", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "e_", ",", "f_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"TetrahedronVolumeSquared", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "]"}], "\[GreaterEqual]",
    "0"}]}]], "Input",
 CellChangeTimes->{{3.595713177563087*^9, 3.595713201086776*^9}, {
  3.595713242021379*^9, 3.595713365341716*^9}, {3.768661917418466*^9, 
  3.768661931517377*^9}, {3.768662066180846*^9, 3.768662081920419*^9}},
 CellLabel->
  "In[642]:=",ExpressionUUID->"4ebd90cf-1228-4c5b-8687-a82406e8de3a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronVolume[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595713120132145*^9, 
  3.595713133545433*^9}},ExpressionUUID->"ea3f16e7-3215-41de-b0b1-\
98d5ec52dcd0"],

Cell[TextData[{
 "TetrahedronVolume[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "] gives the volume of a tetrahedron whose edge lengths are ",
 StyleBox["a\[Dash]f",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.595713145577135*^9, 3.595713162662592*^9}, 
   3.768661859394041*^9},ExpressionUUID->"79e61b97-f970-4a39-8faf-\
4626f12e0fe6"],

Cell["\<\
If the edge lengths are incompatible, the resulting volume will be imaginary.\
\
\>", "Text",
 CellChangeTimes->{{3.768661866731229*^9, 
  3.768661879808063*^9}},ExpressionUUID->"6c7155ce-cafa-4310-8c29-\
81e65c4ebb5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronVolume", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "e_", ",", "f_"}], 
   "]"}], ":=", 
  RowBox[{"\[Sqrt]", 
   RowBox[{"TetrahedronVolumeSquared", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.595713177563087*^9, 3.595713201086776*^9}, {
  3.595713242021379*^9, 3.595713365341716*^9}, {3.768661943944833*^9, 
  3.7686619517679*^9}},
 CellLabel->
  "In[643]:=",ExpressionUUID->"8ce9620a-8a62-41bc-8106-c00a0ae10c2e"],

