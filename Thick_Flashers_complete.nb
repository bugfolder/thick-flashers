Cell[TextData[{
 "MakePrimalDualTwistTessellationEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Gamma], \[Alpha], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t",
 "(unchecked class",
 ") TPrimalDualGraph\n\t(options) PostRotation, TwistDirection"
}], "Subsubsection",
 CellChangeTimes->{
  3.485256450683302*^9, {3.485256598863229*^9, 3.48525660341425*^9}, {
   3.485256805875897*^9, 3.485256807164473*^9}, 3.4852628963235188`*^9, {
