  "In[1916]:=",ExpressionUUID->"a3ba22db-fb36-4686-a66b-67a6a0694dea"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BorderlessCreasePatternToPlaneGraphAssigned", "::", "nopolys"}], 
   "=", "\"\<The input pattern had no styled polygons so no border could be \
computed.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.533671178362317*^9, 3.533671206590559*^9}, 
   3.533681521947163*^9, 3.592468181799381*^9, 3.592828731071958*^9, 
   3.592828959619935*^9, 3.594739232897303*^9, 3.59473947814722*^9},
