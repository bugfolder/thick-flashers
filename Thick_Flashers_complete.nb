Cell[TextData[{
 "FoldedFormPolys[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a list of Graphics elements that \
gives a set of (possibly overlapping) polygons that render the folded form. \
Note that the same fill is used to render all polygons, whether face up or \
face down, but you can specify which side color that is. Options are:\n\t\
PaperFill \[Rule] PaperWhiteSideFill | PaperColoredSideFill, specifies the \
color of the paper that will be used to render all polygons.\t"
}], "Text",
 CellChangeTimes->{{3.45789193755861*^9, 3.457891975666669*^9}, 
   3.457894574106389*^9, 3.484782314029711*^9, {3.484835703421386*^9, 
   3.484835772671935*^9}, 3.485099458464629*^9, {3.591803748698476*^9, 
   3.5918037590652647`*^9}, 3.592179916558292*^9, 3.592207999683292*^9, {
   3.592428317683409*^9, 3.592428319952231*^9}, 3.592433576781578*^9, {
   3.592828890416596*^9, 3.592828890533216*^9}, 3.592871304514659*^9, 
   3.59473241277986*^9, 3.594733051718525*^9, 3.594734948126282*^9, 
   3.595200667214548*^9, 3.628949765017284*^9, 3.628950648242497*^9, {
   3.628959338647155*^9, 3.628959339342884*^9}, 3.628959494560785*^9, {
   3.62895952849986*^9, 3.628959529227376*^9}, 3.6289597841043262`*^9, {
   3.628959822840116*^9, 
   3.62895982363987*^9}},ExpressionUUID->"9d60c87a-ccc5-4c9b-b990-\
df01a8429825"],

Cell["\<\
This limitation is because the rendering order of the polygons does not match \
the stacking order of the faces (which could even be non-transitive).\
\>", "Text",
 CellChangeTimes->{{3.628959849246413*^9, 
  3.628959900338129*^9}},ExpressionUUID->"6b14c38d-f45b-48ec-a903-\
b6881eecaf11"],

