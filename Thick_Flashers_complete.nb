  "In[3474]:=",ExpressionUUID->"08d8ddff-8bb2-4c16-9c39-35cca795e25f"],

Cell["\<\
Solve for the isometry condition for \[Delta]\[NotEqual]0 symbolically. It\
\[CloseCurlyQuote]s huge (we report the LeafCount). And if you try to \
Simplify it, it runs for a really long time. So that\[CloseCurlyQuote]s why \
we find a numerical solution inside MakeRadialPotWedge.\
\>", "Text",
 CellChangeTimes->{{3.6515059427185698`*^9, 3.651505960049159*^9}, {
  3.651511287088127*^9, 3.651511288366908*^9}, {3.651511960597426*^9, 
  3.651512035905634*^9}, {3.707922272795443*^9, 
  3.70792228649811*^9}},ExpressionUUID->"3ec524f1-054c-4f69-9cad-\
ac81d717bc44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "wi", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", 
      "aa", ",", "bb", ",", "cc", ",", "dd", ",", "ee", ",", "ff", ",", "vi", 
      ",", "si", ",", "ti", ",", "dc", ",", "soln"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"wi", "=", 
      RowBox[{"xi", " ", 
       RowBox[{"Tan", "[", 
        RowBox[{"\[Phi]", "-", "\[Delta]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "cp", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"ri", " ", 
       RowBox[{"U", "[", "0", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"a", "+", 
       RowBox[{"wi", " ", 
        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"b", "+", 
       RowBox[{"si", " ", 
        RowBox[{"U", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"ri", " ", 
       RowBox[{"U", "[", 
        RowBox[{"2", "\[Phi]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", 
      RowBox[{"f", "+", 
       RowBox[{"wi", " ", 
        RowBox[{"U", "[", 
         RowBox[{
          RowBox[{"2", "\[Phi]"}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"e", "+", 
       RowBox[{"ti", " ", 
        RowBox[{"U", "[", 
         RowBox[{
          RowBox[{"2", "\[Phi]"}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "ff", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"aa", "=", 
      RowBox[{
       RowBox[{"xi", " ", 
        RowBox[{"U3D", "[", "0", "]"}]}], "+", 
       RowBox[{"zi", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bb", "=", 
      RowBox[{"aa", "+", 
       RowBox[{"wi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{"\[Pi]", "/", "2"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"bb", "+", 
       RowBox[{"si", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"\[Phi]", "-", "\[Delta]"}], ")"}]}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"xi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{"2", "\[Phi]"}], "]"}]}], "+", 
       RowBox[{"zi", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ee", "=", 
      RowBox[{"ff", " ", "+", " ", 
       RowBox[{"wi", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"2", "\[Phi]"}], "-", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"ee", "+", 
       RowBox[{"ti", " ", 
        RowBox[{"U3D", "[", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], "+", 
          RowBox[{"2", "\[Delta]"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "parameters", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vi", "=", 
      RowBox[{"xi", " ", 
       RowBox[{"Sec", "[", 
        RowBox[{"\[Phi]", "-", "\[Delta]"}], "]"}], 
       RowBox[{"Sin", "[", "\[Delta]", "]"}], 
       RowBox[{"Sec", "[", 
        RowBox[{"\[Phi]", "-", 
         RowBox[{"2", "\[Delta]"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ri", " ", 
           RowBox[{"Tan", "[", "\[Phi]", "]"}]}], "-", "wi"}], ")"}], "ui", " ", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"1", "-", "\[Rho]"}], "2"], ")"}]}], "-", "vi"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ti", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ri", " ", 
           RowBox[{"Tan", "[", "\[Phi]", "]"}]}], "-", "wi"}], ")"}], "ui", " ", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"1", "+", "\[Rho]"}], "2"], ")"}]}], "-", "vi"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"distance", " ", "condition"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mag2", "[", 
          RowBox[{"cc", "-", "dd"}], "]"}], "\[Equal]", 
         RowBox[{"Mag2", "[", 
          RowBox[{"c", "-", "d"}], "]"}]}], ",", "ui"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"LeafCount", "[", "soln", "]"}]}]}], "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.651505961312973*^9, 3.65150600891113*^9}, {
  3.651506048245743*^9, 3.651506172070189*^9}, {3.651506216924984*^9, 
  3.6515064554298363`*^9}, {3.651506497325713*^9, 3.651506515200515*^9}, {
