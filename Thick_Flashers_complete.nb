Cell[TextData[{
 "PtNotInHalfPlaneQ[",
 StyleBox["q",
  FontSlant->"Italic"],
 ", {",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 "}] returns True if the point ",
 StyleBox["q",
  FontSlant->"Italic"],
 " does not lie within the half-plane defined by the line through {",
 StyleBox["p1,",
  FontSlant->"Italic"],
 " ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} that contains ",
 StyleBox["p3",
  FontSlant->"Italic"],
 " (which should not lie on that line)",
 StyleBox[".",
  FontSlant->"Italic"],
 " If the test point lies on the line, it returns False."
}], "Text",
 CellChangeTimes->{{3.4629002499807034`*^9, 3.462900292913322*^9}, {
  3.628852919321049*^9, 3.628852934727816*^9}, {3.6288530169300203`*^9, 
  3.628853022929657*^9}},ExpressionUUID->"61341d7d-4e02-4e79-b08d-\
306e05b1ef65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PtNotInHalfPlaneQ", "[", 
   RowBox[{"q_", ",", 
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"!", 
   RowBox[{"PtInHalfPlaneQ", "[", 
    RowBox[{"q", ",", 
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}]}]}]], "Input",
