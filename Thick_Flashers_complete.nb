Cell[CellGroupData[{

Cell["Lighting and shadows", "Subsection",
 CellChangeTimes->{{3.689089770622779*^9, 3.68908977314226*^9}, {
  3.801760822239896*^9, 
  3.801760823709038*^9}},ExpressionUUID->"304c9be6-2664-4efd-b82f-\
db67ede9b747"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.689089775190582*^9, 
  3.689089775607524*^9}},ExpressionUUID->"35b92fde-eb3d-4720-b038-\
a45b5e1b17d4"],

Cell[TextData[{
 "With paper having a light side and a colored side, we want the true colors \
to show, so we want to use neutral lighting. Often, though, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s default Lighting\[Rule]\[CloseCurlyDoubleQuote]Neutral\
\[CloseCurlyDoubleQuote] washes out any shading on the white side of the \
paper. To deal with this, we provide the ",
 "NeutralLighting",
 " function that can be used to turn down the lighting to an acceptable \
level. "
}], "Text",
 CellChangeTimes->{{3.689089791235449*^9, 3.689089907783041*^9}, {
  3.689555710202029*^9, 
  3.689555725836664*^9}},ExpressionUUID->"3e48fd87-e454-4cb8-bd37-\
839631266130"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "NeutralLighting",
 "[",
 StyleBox["r",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.689088480207374*^9, 3.689088483528079*^9}, {
   3.689088618000061*^9, 3.689088618297246*^9}, 
   3.689555710249023*^9},ExpressionUUID->"9d869e9f-71cc-4ff5-8320-\
a3e019389640"],

Cell[TextData[{
 "NeutralLighting",
 "[",
 StyleBox["r",
  FontSlant->"Italic"],
 "] dims the default \[OpenCurlyDoubleQuote]Neutral\[CloseCurlyDoubleQuote] \
lighting by a factor ",
 StyleBox["r",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.689088521654793*^9, 3.6890885561078444`*^9}, {
   3.689088639587344*^9, 3.689088644580727*^9}, 3.689089949483426*^9, {
   3.689555710294065*^9, 
   3.689555728111423*^9}},ExpressionUUID->"b23c2f98-8c30-4573-a494-\
b8229c6d3a94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NeutralLighting", "[", "r_", "]"}], ":=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<Ambient\>\"", ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{
        RowBox[{"0.35", "r"}], ",", 
        RowBox[{"0.35", "r"}], ",", 
        RowBox[{"0.35", "r"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Directional\>\"", ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{
        RowBox[{"0.37", "r"}], ",", 
        RowBox[{"0.37", "r"}], ",", 
        RowBox[{"0.37", "r"}]}], "]"}], ",", 
      RowBox[{"ImageScaled", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0", ",", "2"}], "}"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Directional\>\"", ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{
        RowBox[{"0.37", "r"}], ",", 
        RowBox[{"0.37", "r"}], ",", 
        RowBox[{"0.37", "r"}]}], "]"}], ",", 
      RowBox[{"ImageScaled", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2"}], "}"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Directional\>\"", ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{
        RowBox[{"0.37", "r"}], ",", 
        RowBox[{"0.37", "r"}], ",", 
        RowBox[{"0.37", "r"}]}], "]"}], ",", 
      RowBox[{"ImageScaled", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "2", ",", "2"}], "}"}], "]"}]}], "}"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.689088558702054*^9, 3.689088614099866*^9}, 
   3.689555710320333*^9},
 CellLabel->
  "In[1590]:=",ExpressionUUID->"292a85ca-1bb2-48af-95b2-df094bc97947"],

Cell["Example", "Text",
 CellChangeTimes->{{3.689089954616128*^9, 
  3.689089955359981*^9}},ExpressionUUID->"c655d6df-c503-44e0-860a-\
af25c59b71ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "g", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"g", "=", "OrigamiSampleGraphics3D"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Show", "[", "g", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{"g", ",", 
           RowBox[{"Lighting", "\[Rule]", 
            RowBox[{"NeutralLighting", "[", ".75", "]"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{"g", ",", 
           RowBox[{"Lighting", "\[Rule]", 
            RowBox[{"NeutralLighting", "[", ".5", "]"}]}]}], "]"}]}], "}"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.689089994151472*^9, 3.689090071702714*^9}, {
  3.689090102605813*^9, 3.68909010457027*^9}, {3.689555710347096*^9, 
  3.689555710359723*^9}},
 CellLabel->
  "In[1591]:=",ExpressionUUID->"eb52accc-bb85-44b9-b7c2-d849ec74f682"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeShadow[",
 StyleBox["expr, opts",
  FontSlant->"Italic"],
 "]\n\t(options) ShadowHeight, ShadowOffset, ShadowColor"
}], "Subsubsection",
 CellChangeTimes->{{3.689267523003063*^9, 3.6892675306033993`*^9}, {
   3.691520743997288*^9, 3.691520747562932*^9}, {3.691520813081324*^9, 
   3.691520820946113*^9}, {3.691521235946033*^9, 3.691521239838331*^9}, 
   3.6915222234460278`*^9, 3.803404752396604*^9, {3.803404920572815*^9, 
   3.803404923357765*^9}, 3.803860465581863*^9, 
   3.803895109514231*^9},ExpressionUUID->"3c26976c-8ec6-40c5-bf76-\
18f40cc62ec2"],

Cell[TextData[{
 "MakeShadow[",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a Graphics3D object and creates a flattened shadow of it."
}], "Text",
 CellChangeTimes->{{3.689267538316017*^9, 3.689267564397023*^9}, {
   3.691520750020528*^9, 3.6915207515371456`*^9}, 3.691521241291294*^9, {
   3.69152221247637*^9, 3.69152221707017*^9}, 3.803860465597093*^9, 
   3.803895109567462*^9},ExpressionUUID->"08afbcf8-1002-4b12-992c-\
eb6241c54d6d"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any expression containing Graphics3D elements."
}], "Text",
 CellChangeTimes->{{3.801743134318005*^9, 
  3.8017431479180937`*^9}},ExpressionUUID->"eeb506e3-f6d2-462c-b74c-\
3ea1257cbeb9"],

Cell[TextData[{
 "Options:\n\tShadowHeight \[Rule] Automatic | ",
 StyleBox["z",
  FontSlant->"Italic"],
 ", where Automatic is at the lowest point of the object, or ",
 StyleBox["z",
  FontSlant->"Italic"],
 " is the absolute z-coordinate of the shadow.\n\tShadowOffset \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", where if ShadowHeight \[Rule] Automatic, the shadow is placed a distance \
h below the lowest point of the object. This is ignored if ShadowHeight is \
given as an explicit value.\n\tShadowColor \[Rule] ",
 StyleBox["color",
  FontSlant->"Italic"],
 ", the desired shadow color."
}], "Text",
 CellChangeTimes->{{3.801743151261394*^9, 3.801743185797911*^9}, {
  3.801743698433593*^9, 3.801743738496634*^9}, {3.801743793562127*^9, 
  3.801743825897606*^9}, {3.803404752413772*^9, 3.803404806911427*^9}, {
  3.803404927909718*^9, 
  3.8034050469262753`*^9}},ExpressionUUID->"348eb7e6-570f-4969-ada9-\
af3480272b91"],

Cell["\<\
The shadow is given a fixed color, independent of the lighting.\
\>", "Text",
 CellChangeTimes->{{3.691522000617337*^9, 
  3.691522019935954*^9}},ExpressionUUID->"b8fad7c8-0244-46b7-9034-\
63801dec6e1c"],

Cell["\<\
Note that Line and Polygon objects have different lighting models; Line \
colors are independent of lighting, while Polygon colors are affected by \
lighting, opacity, edge. So we have to do different conversions on Lines and \
Polygons.\
\>", "Text",
 CellChangeTimes->{
  3.689267832581807*^9, {3.691520835444395*^9, 3.6915208483775682`*^9}, {
   3.691521786760365*^9, 
   3.691521848569392*^9}},ExpressionUUID->"bc5bc701-2dca-4ac9-83bb-\
d067af4b5b22"],

Cell["\<\
For best results, Line and Polygon objects should be immediately enclosed by \
Style wrappers. If you do this, then they\[CloseCurlyQuote]ll end up with the \
same shadow color. If, however, you bury everything within a larger Style \
directive, then Lines will cast a Black shadow, independent of the \
ShadowColor option.\
\>", "Text",
 CellChangeTimes->{{3.6915218531598473`*^9, 3.691521965031946*^9}, {
  3.69396148445479*^9, 
  3.693961488140667*^9}},ExpressionUUID->"f6deb5bd-2e3b-47c6-922e-\
1d88df70dbaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShadowHeight", "::", "usage"}], 
   "=", "\"\<ShadowHeight is an option to StyledCurve and StyledPatch that \
specifies the height of the shadow below the curve or patch. Only for \
3D.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.688133929981358*^9, 3.688133945402214*^9}, {
   3.688134001099555*^9, 3.688134065342812*^9}, 3.689247664964958*^9, {
   3.689266498322239*^9, 3.689266549025202*^9}, {3.691522404638389*^9, 
   3.691522404938772*^9}},
 CellLabel->
  "In[1592]:=",ExpressionUUID->"3956b78f-0250-4f58-ac19-ad804b054b97"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShadowColor", "::", "usage"}], 
   "=", "\"\<ShadowColor is an option to StyledCurve and StyledPatch that \
specifies the color of the shadow below the curve or patch. Only for \
3D.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.688133929981358*^9, 3.688133945402214*^9}, {
   3.688134001099555*^9, 3.688134065342812*^9}, 3.689247664964958*^9, {
   3.689266498322239*^9, 3.689266549025202*^9}, {3.6915206795980663`*^9, 
   3.691520684049724*^9}, {3.691522406846593*^9, 3.691522407173732*^9}},
 CellLabel->
  "In[1593]:=",ExpressionUUID->"df1450aa-1d57-453f-a9d4-b31c5616b4f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeShadow", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ShadowHeight", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ShadowOffset", "\[Rule]", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ShadowColor", "\[Rule]", "LightGray"}]}], "\[IndentingNewLine]",
     "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.691520921999411*^9, 3.691520950686*^9}, {
   3.691521370947847*^9, 3.691521371786265*^9}, {3.691521993423464*^9, 
   3.691521993965086*^9}, {3.8017431925363283`*^9, 3.80174319338981*^9}, 
   3.801743746347655*^9, 3.8034047524284806`*^9, {3.8034050841756268`*^9, 
   3.803405089126814*^9}, {3.803405536390188*^9, 3.803405537241866*^9}, 
   3.8038604656089168`*^9, 3.8038951095777903`*^9},
 CellLabel->
  "In[1594]:=",ExpressionUUID->"88f7cbcf-8cdf-4d5d-b5b0-dface1b94494"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShadowOffset", "::", "usage"}], 
   "=", "\"\<ShadowOffset is an option to MakeShadow that specifies how far \
below the lowest point of the object the shadow should be placed.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.8034050955357*^9, 3.80340512792661*^9}, 
   3.8038604656140137`*^9, 3.803895109580336*^9},
 CellLabel->
  "In[1595]:=",ExpressionUUID->"dbcdb7b6-d5c3-440c-b4eb-c0efc7f5489b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeShadow", "[", 
   RowBox[{"g_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sh", ",", "so", ",", "sc", ",", "bbox", ",", "gs"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sh", "=", 
      RowBox[{
       RowBox[{"ShadowHeight", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeShadow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"so", "=", 
      RowBox[{
       RowBox[{"ShadowOffset", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeShadow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sc", "=", 
      RowBox[{
       RowBox[{"ShadowColor", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeShadow", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sh", "===", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bbox", "=", 
         RowBox[{"Graphics3DBoundingBox", "[", "g", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ListEmptyQ", "[", "bbox", "]"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sh", "=", 
         RowBox[{
          RowBox[{"bbox", "\[LeftDoubleBracket]", 
           RowBox[{"3", ",", "1"}], "\[RightDoubleBracket]"}], "-", 
          "so"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gs", "=", 
      RowBox[{"FunctionTransform", "[", 
       RowBox[{"g", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "0"}], "}"}], "#"}], "+", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "sh"}], "}"}]}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"gs", "/.", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"expr_Text", "\[RuleDelayed]", 
         RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"expr_Line", ",", "sopts___"}], "]"}], "\[RuleDelayed]", 
         RowBox[{"Style", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"sopts", ",", "sc", ",", 
              RowBox[{"EdgeForm", "[", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", "expr_Tube", "]"}], ",", "sopts___"}], "]"}],
          "\[RuleDelayed]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Arrow", "[", "expr", "]"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Glow", "[", "sc", "]"}], ",", "Black", ",", 
              RowBox[{"Opacity", "[", "1", "]"}], ",", 
              RowBox[{"EdgeForm", "[", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"expr_Arrow", ",", "sopts___"}], "]"}], "\[RuleDelayed]", 
         RowBox[{"Style", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"sopts", ",", "sc", ",", 
              RowBox[{"Opacity", "[", "1", "]"}], ",", 
              RowBox[{"EdgeForm", "[", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"expr_Polygon", ",", "sopts___"}], "]"}], "\[RuleDelayed]", 
         
         RowBox[{"Style", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"sopts", ",", 
              RowBox[{"Glow", "[", "sc", "]"}], ",", "Black", ",", 
              RowBox[{"Opacity", "[", "1", "]"}], ",", 
              RowBox[{"EdgeForm", "[", "]"}]}], "}"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"expr_", ",", "sopts___"}], "]"}], "\[RuleDelayed]", 
         RowBox[{"Style", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"sopts", ",", 
              RowBox[{"Glow", "[", "sc", "]"}], ",", "Black", ",", 
              RowBox[{"Opacity", "[", "1", "]"}], ",", 
              RowBox[{"EdgeForm", "[", "]"}]}], "}"}], "]"}]}], "]"}]}]}], 
       "}"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.689266830042927*^9, 3.689266963691285*^9}, {
   3.689267239442786*^9, 3.68926732076189*^9}, {3.6892674058333263`*^9, 
   3.689267517422523*^9}, {3.689272539154511*^9, 3.689272545684414*^9}, {
