fc195e880d4c"],

Cell["\<\
For a general polygon twist, the twist crease pattern isn\[CloseCurlyQuote]t \
necessarily flat foldable, because the twist angles vary around the central \
polygon. We can use the functions in this section to probe geometric \
properties of such polygons.\
\>", "Text",
 CellChangeTimes->{{3.629217267726231*^9, 3.629217316882386*^9}, {
  3.6299779029702272`*^9, 3.6299779239365673`*^9}, {3.630022597360283*^9, 
  3.630022605496745*^9}, {3.630070501963317*^9, 
  3.63007050289694*^9}},ExpressionUUID->"740030d7-a911-4f7f-aeac-\
d17de5d2bf16"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "PolygonTwistNumSides[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraphAssigned"
}], "Subsubsection",
 CellChangeTimes->{{3.630070028352302*^9, 3.630070063188438*^9}, 
   3.707838362050193*^9},ExpressionUUID->"ccf073ab-8a64-4da9-ab83-\
c11ca74c7cf8"],

Cell[TextData[{
 "PolygonTwistNumSides[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraphAssigned of a ",
 StyleBox["n",
  FontSlant->"Italic"],
 "-gon twist tile and returns the number of sides of the tile and central \
polygon. (Which we can get because the central polygon is always the first \
polygon in the face list.)"
}], "Text",
 CellChangeTimes->{{3.630070044926183*^9, 3.6300701466883187`*^9}, 
   3.707838319068419*^9},ExpressionUUID->"c6c43ff8-b1be-4e63-b57c-\
c5be842f4d5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonTwistNumSides", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Length", "[", 
   RowBox[{
    RowBox[{"tobj", "[", "Faces", "]"}], "\[LeftDoubleBracket]", "1", 
    "\[RightDoubleBracket]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.630070159009982*^9, 3.630070183529338*^9}},
 CellLabel->
  "In[2875]:=",ExpressionUUID->"5e98a611-7ec4-44e1-b731-752d7229da8f"],

