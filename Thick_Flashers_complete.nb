        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"d1", ",", "d3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Ceiling", "[", 
              RowBox[{"nh", "/", "2"}], "]"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}], ",", "nh"}], "]"}], ",", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
