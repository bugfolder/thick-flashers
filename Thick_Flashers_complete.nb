1b51a7c778e2"],

Cell["\<\
If a TVertex is flat-foldable, then we can construct and render the folded \
form as a TGraph2D+TAssigned.\
\>", "Text",
 CellChangeTimes->{{3.597510623608252*^9, 
  3.597510652158584*^9}},ExpressionUUID->"d165f201-cec6-4932-a8ff-\
b23a9c8faa9d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "VertexGenericFoldedFormGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TVertex\n\t(options) CircleDivisions, Options[",
 "CircularAngleLabels",
 "], Options[Graphics]"
}], "Subsubsection",
 CellChangeTimes->{{3.594806159402633*^9, 3.594806171713335*^9}, {
   3.594806272435766*^9, 3.594806313696294*^9}, 3.594811206690653*^9, {
   3.594811941996428*^9, 3.594811959985792*^9}, {3.594812358473679*^9, 
   3.594812364479859*^9}, {3.594943150629582*^9, 3.594943151972293*^9}, {
   3.5975149088912916`*^9, 3.597514910199047*^9}, 3.597521267206468*^9, {
   3.597521678243435*^9, 3.597521691889323*^9}, 3.597522395234702*^9, 
   3.597522742216036*^9, 
   3.597525577849787*^9},ExpressionUUID->"73c0f953-43b1-44c1-b5ae-\
59d642fdbf9c"],

Cell[TextData[{
 "VertexGenericFoldedFormGraphics",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex and produces a graphical rendering of the folded form as \
a circular vertex. Options are:\n\tSectorAngleLabels \[Rule] Automatic | ",
 StyleBox["list",
  FontSlant->"Italic"],
 " | None, specifies a list of labels for each sector angle;\n\t\
DihedralAngleLabels \[Rule] Automatic | ",
 StyleBox["list",
  FontSlant->"Italic"],
 " | None, specifies a list of labels for each dihedral angle (the tips of \
the direction vectors);\n\tOptions[Graphics] are passed through."
}], "Text",
 CellChangeTimes->{
  3.594806479326036*^9, {3.594806570768551*^9, 3.594806601382454*^9}, {
   3.594806689560814*^9, 3.594806734453295*^9}, 3.594811939935762*^9, 
   3.594812020674701*^9, {3.5949431545647173`*^9, 3.594943156403695*^9}, {
   3.597514916906427*^9, 3.5975149489740973`*^9}, 
   3.597522742297101*^9},ExpressionUUID->"891220e4-25eb-415a-874e-\
cc02cadb3824"],

Cell["\<\
We use the generic folded form so as not to have to solve the layer ordering \
problem to compute the visible form.\
\>", "Text",
 CellChangeTimes->{{3.597521885773231*^9, 
  3.597521905291459*^9}},ExpressionUUID->"949ae293-d3f3-43d8-b36e-\
3b9d8f1674a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexGenericFoldedFormGraphics", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cv", ",", "gobj", ",", "fa"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{
      "tobj", ",", "TVertex", ",", "VertexGenericFoldedFormGraphics"}], "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"cv", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "CreaseVectors"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gobj", "=", 
      RowBox[{"MakeCircularVertexGraph", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"TypeToFlatFoldAngle", "[", 
       RowBox[{"gobj", "[", "EdgeTypes", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphGraphics", "[", "gobj", "]"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"gobj", "=", 
      RowBox[{"FoldGraph2D", "[", 
       RowBox[{"gobj", ",", "fa"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"cv", "=", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"gobj", "[", "Vertices2D", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", 
          RowBox[{
           RowBox[{"Length", "[", "cv", "]"}], "+", "1"}]}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"GenericFoldedFormGraphics", "[", "gobj", "]"}], "\[LeftDoubleBracket]",
           "1", "\[RightDoubleBracket]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], "]"}], ",", "Black", ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CircularAngleLabels", "[", 
          RowBox[{"cv", ",", "opts"}], "]"}]}], "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.594806859794633*^9, 3.594806894576826*^9}, 
   3.594808055389967*^9, {3.59480809068863*^9, 3.594808092128839*^9}, {
