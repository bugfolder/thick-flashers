Cell[TextData[{
 "RenderTile[{QuadrilateralSplitTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraph2DAssigned+TTwistGraph for the folded form of a \
quadrilateral split twist twist. "
}], "Text",
