   3.485107408610834*^9}, {3.485107911889517*^9, 3.485107917024323*^9}, {
   3.592788422805047*^9, 3.592788426236871*^9}, 3.592828803670596*^9, 
   3.5942057318378983`*^9, {3.59420736940147*^9, 3.5942073732876062`*^9}, {
   3.594207583133145*^9, 3.59420759981393*^9}, {3.594207719613093*^9, 
   3.59420773642395*^9}, 3.59420779162962*^9, 3.5942078764445066`*^9, {
   3.5942083202543993`*^9, 3.594208332830417*^9}, 3.594208679432781*^9, 
