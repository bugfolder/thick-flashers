  "In[707]:=",ExpressionUUID->"ec4023f9-0f94-42a0-9135-c5fa912fb3e5"],

Cell[TextData[{
 "Rotate3D[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w, q",
  FontSlant->"Italic"],
 "] rotates the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 " through angle \[Phi] about an axis emanating from point ",
 StyleBox["q",
  FontSlant->"Italic"],
 " in direction ",
 StyleBox["w",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{
  3.689250674501274*^9, {3.68925072588398*^9, 3.6892507813912687`*^9}, {
   3.689250835653847*^9, 3.689250837209165*^9}, {3.689250918209992*^9, 
   3.689250957619546*^9}},ExpressionUUID->"79915615-c130-4d0c-8b6e-\
bf7680b3bbe7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rotate3D", "[", 
   RowBox[{"p_List", ",", "\[Phi]_", ",", "w_List", ",", "q_List"}], "]"}], ":=", 
  RowBox[{"q", "+", 
   RowBox[{"Rotate3D", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", "q"}], ")"}], ",", "\[Phi]", ",", "w"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.689250785451035*^9, 3.689250801396055*^9}, {
  3.6892509399240303`*^9, 3.68925094880774*^9}, {3.689250985395392*^9, 
