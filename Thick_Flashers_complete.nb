Cell[CellGroupData[{

Cell["Primal-dual twist tessellations", "Section",
 CellChangeTimes->{{3.457733992108505*^9, 3.4577339955964537`*^9}, {
   3.4577918462745676`*^9, 3.457791848701275*^9}, {3.461745133176136*^9, 
