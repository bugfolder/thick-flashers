3267ae917531"],

Cell[TextData[{
 "PartitionedGraphicsGrid[",
 StyleBox["glist, n",
  FontSlant->"Italic"],
 "] returns a GraphicsGrid of a list of Graphics and/or Graphics3D objects \
with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " items per row, padding with empty space if needed to fill out a row."
}], "Text",
 CellChangeTimes->{{3.457618994540207*^9, 3.457619004194029*^9}, {
   3.5335051635782*^9, 3.533505164937951*^9}, {3.533644612600017*^9, 
