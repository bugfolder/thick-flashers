Cell[TextData[{
 "StyledCurvedFold[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{rl, rr}",
  FontSlant->"Italic"],
 ", {u0, u1}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] produces Graphics/Graphics3D elements that represent a curved fold on a \
ruled surface from the fold and its left and right ruling vectors."
}], "Text",
 CellChangeTimes->{{3.688080297767209*^9, 3.688080359192568*^9}, {
