Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.630244932206806*^9, 
  3.630244932745943*^9}},ExpressionUUID->"11d3d45d-c042-4a1f-9c16-\
2b618b9bdb81"],

Cell[TextData[{
 "If the crease pattern is flat-foldable (not necessarily the case), then the \
folded form tile is geometrically similar to a crease pattern tile with \
different {",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Tau]} parameters, and we can use that fact to compute an equivalent \
tile for the folded form."
}], "Text",
 CellChangeTimes->{
  3.6302450037084002`*^9},ExpressionUUID->"ab6d1288-cb06-4d23-b77e-\
e4b5600f002c"],

Cell[TextData[{
 "This example computes equivalent {",
 StyleBox["w",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote], ",
 StyleBox["d",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote], \[Tau]\[CloseCurlyQuote]} parameters for a folded form \
tile. Line OABP is the original tile edge. Line OACP\[CloseCurlyQuote] is the \
folded image of the edge. Line OP\[CloseCurlyQuote] is the folded form tile \
edge; distances and angles are computed relative to it."
}], "Text",
 CellChangeTimes->{{3.630020406334034*^9, 3.6300204218039722`*^9}, {
  3.630021352087652*^9, 3.630021377341976*^9}, {3.630024755382943*^9, 
  3.630024816931074*^9}, {3.630245009887276*^9, 
  3.630245011821053*^9}},ExpressionUUID->"795f8bc9-ffc2-432a-b382-\
26040f800e66"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "O", ",", "A", ",", "B", ",", "C", ",", "P", ",", "Pp", ",", "Ap", ",", 
      "Bp", ",", "\[Tau]p", ",", "soln", ",", "ex"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"O", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"1", "-", "w"}], "2"], "+", "d"}], ",", "0"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"B", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"1", "+", "w"}], "2"], "+", "d"}], ",", "0"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"P", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"C", "=", 
      RowBox[{"B", "+", 
       RowBox[{"2", " ", "w", " ", 
        RowBox[{"Sin", "[", "\[Tau]", "]"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Tau]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Pp", "=", 
      RowBox[{"P", "+", 
       RowBox[{"2", " ", "w", " ", 
        RowBox[{"Sin", "[", "\[Tau]", "]"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", "\[Tau]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Tau]", "]"}]}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Ap", "=", 
      RowBox[{"LineInt2D", "[", 
       RowBox[{"O", ",", 
        RowBox[{"Pp", "-", "O"}], ",", "A", ",", 
        RowBox[{"U", "[", "\[Tau]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Bp", "=", 
      RowBox[{"LineInt2D", "[", 
       RowBox[{"O", ",", 
        RowBox[{"Pp", "-", "O"}], ",", "C", ",", 
        RowBox[{"U", "[", "\[Tau]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "equivalent", " ", "tilt", " ", "angle", " ", "for", " ", "folded", " ",
        "form"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Tau]p", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{
          RowBox[{"U", "[", 
           RowBox[{"\[Tau]", "-", 
            FractionBox["\[Pi]", "2"]}], "]"}], ".", 
          RowBox[{"(", 
           RowBox[{"Pp", "-", "O"}], ")"}]}], 
         RowBox[{
          RowBox[{"U", "[", "\[Tau]", "]"}], ".", 
          RowBox[{"(", 
           RowBox[{"Pp", "-", "O"}], ")"}]}]], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[Tau]' = \>\"", ",", "\[Tau]p"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"1", "-", "wp"}], "2"], "+", "dp"}], "\[Equal]", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Ap", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Pp", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]]}], ",", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"1", "+", "wp"}], "2"], "+", "dp"}], "\[Equal]", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Bp", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Pp", "-", "O"}], ")"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"wp", ",", "dp"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<w' = \>\"", ",", 
       RowBox[{"wp", "/.", 
        RowBox[{
        "soln", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
       ",", "\"\<, d' = \>\"", ",", 
       RowBox[{"dp", "/.", 
        RowBox[{
        "soln", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "and", " ", "show", " ", "a", " ", "plot", " ", "of", " ", "the", " ", 
       "geometry"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ex", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"w", "\[Rule]", "0.15"}], ",", 
        RowBox[{"d", "\[Rule]", 
         RowBox[{"-", "0.08"}]}], ",", 
        RowBox[{"\[Tau]", "\[Rule]", 
         RowBox[{"70", "\[Degree]"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"Black", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"O", ",", "P"}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         "Gray", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"A", ",", 
            RowBox[{"A", "+", 
             RowBox[{".5", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}]}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"B", ",", 
            RowBox[{"B", "+", 
             RowBox[{".5", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}]}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"C", ",", 
            RowBox[{"C", "+", 
             RowBox[{".5", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "Orange", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"O", ",", "Pp"}], "}"}], "]"}], ",", "\[IndentingNewLine]",
          "Green", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"A", ",", "C", ",", "Pp"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "LightGray", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"B", ",", "C"}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"P", ",", "Pp"}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"C", "-", 
             RowBox[{".1", 
              RowBox[{"U", "[", "\[Tau]", "]"}]}]}], ",", "C"}], "}"}], "]"}],
          ",", "\[IndentingNewLine]", "Black", ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "O", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<O\>\"", ",", "O", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "A", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<A\>\"", ",", "A", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "B", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<B\>\"", ",", "B", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "C", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<C\>\"", ",", "C", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "P", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<P\>\"", ",", "P", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "Pp", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<P'\>\"", ",", "Pp", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "Ap", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<A'\>\"", ",", "Ap", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Point", "[", "Bp", "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{"\"\<B'\>\"", ",", "Bp", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", "ex"}]}]}], 
