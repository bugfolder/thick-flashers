Cell[CellGroupData[{

Cell[TextData[{
 "MakeGoldbergTiling[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "]\nMakeGoldbergTilingGraph[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "]\n",
 "MakeGoldbergTilingPrimalDualGraph",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{
  3.485219847137932*^9, 3.485221326001009*^9, {3.592297285276779*^9, 
   3.592297315584923*^9}, 3.592297979334088*^9, {3.59250576579187*^9, 
   3.5925057699835777`*^9}, 3.592828740951767*^9, 
   3.594072109182222*^9},ExpressionUUID->"4db60fbf-b2ee-4ab6-8fcb-\
75c39fe4dc55"],

Cell[TextData[{
 "MakeGoldbergTiling[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "] creates a list of point pairs that define line segments for a Goldberg \
tiling of rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", radial order ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", and horizontal offset ",
 StyleBox["o",
  FontSlant->"Italic"],
 " (which can be nonzero only for even values of ",
 StyleBox["m",
  FontSlant->"Italic"],
 ")."
}], "Text",
 CellChangeTimes->{{3.4852155619537573`*^9, 3.485215610513685*^9}, {
  3.485215666449944*^9, 3.48521570344947*^9}, {3.4852158212099047`*^9, 
  3.485215838729764*^9}, {3.485217857595264*^9, 
  3.4852178950627813`*^9}},ExpressionUUID->"c74eeb97-f551-4aee-92fd-\
e9545d870f7d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeGoldbergTiling", "[", 
   RowBox[{"m_", ",", "n_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GoldbergPoint", "[", 
           RowBox[{"m", ",", "in", ",", "ik", ",", "il"}], "]"}], ",", 
          RowBox[{"GoldbergPoint", "[", 
           RowBox[{"m", ",", 
            RowBox[{"in", "+", "1"}], ",", "ik", ",", "il"}], "]"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"ik", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"il", ",", "0", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"in", ",", "il", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GoldbergPoint", "[", 
           RowBox[{"m", ",", "in", ",", "ik", ",", "il"}], "]"}], ",", 
          RowBox[{"GoldbergPoint", "[", 
           RowBox[{"m", ",", "in", ",", "ik", ",", 
            RowBox[{"il", "+", "1"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ik", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"il", ",", "0", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"in", ",", 
          RowBox[{"il", "+", "1"}], ",", "n"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GoldbergPoint", "[", 
           RowBox[{"m", ",", "in", ",", "ik", ",", "il"}], "]"}], ",", 
          RowBox[{"GoldbergPoint", "[", 
           RowBox[{"m", ",", 
            RowBox[{"in", "+", "1"}], ",", "ik", ",", 
            RowBox[{"il", "+", "1"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ik", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"il", ",", "0", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"in", ",", 
          RowBox[{"il", "+", "1"}], ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
     "}"}], ",", "3"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.485215722497023*^9, 3.4852157721255493`*^9}, {
  3.485215846924504*^9, 3.485216064125535*^9}, {3.48521610591049*^9, 
