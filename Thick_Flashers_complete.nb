      "eqns", ",", "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bl", "=", 
      RowBox[{"cl", "=", 
       RowBox[{"{", 
        RowBox[{"hl", ",", "ul"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dl", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"br", "=", 
      RowBox[{"cr", "=", 
