Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "u", ",", "u0", ",", "u1", ",", "bb", ",", "dd", ",", "pm", ",", 
       "pcf3ds", ",", "cclist", ",", "cclast", ",", "b", ",", "d", ",", 
       "clist", ",", "clast", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u0", ",", "u1"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Pi]"}], "/", "4"}], ",", 
         RowBox[{"\[Pi]", "/", "4"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bb", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"u", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "u", "]"}], ",", 
           RowBox[{"Sin", "[", "u", "]"}], ",", "0"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dd", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"u", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pm", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}], "]"}]}], "}"}],
          ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"NormalizeReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}], "]"}]}], 
          "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pcf3ds", "=", 
       RowBox[{"PlanarCurvedFold3DSequence", "[", 
        RowBox[{"bb", ",", "dd", ",", "pm", ",", 
         RowBox[{"ComposeReflections", "\[Rule]", "False"}], ",", 
         RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v1", "=", "3"}], ";", "\[IndentingNewLine]", 
      RowBox[{"cclast", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"u", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"pcf3ds", "\[LeftDoubleBracket]", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "3"}], "\[RightDoubleBracket]"}], "[", 
           "u", "]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", "-", 
             RowBox[{
              RowBox[{"pcf3ds", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}], "[",
               "u", "]"}]}], ")"}], 
           RowBox[{
            RowBox[{"pcf3ds", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "4"}], "\[RightDoubleBracket]"}], "[", 
            "u", "]"}]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cclist", "=", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "&"}],
           "/@", "pcf3ds"}], ",", "cclast"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "we", " ", "know", " ", "what", " ", "the", " ", "2", "D", " ", 
         "ruled", " ", "parameterization", " ", "is"}], ",", " ", 
        RowBox[{"so", " ", "can", " ", "build", " ", "the", " ", "CP"}], ",", 
        " ", "too"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"u", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "u"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"u", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clast", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"u", ",", 
         RowBox[{
          RowBox[{"b", "[", "u", "]"}], "+", 
          RowBox[{"v1", " ", 
           RowBox[{"d", "[", "u", "]"}]}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clist", "=", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Functionize", "[", 
            RowBox[{"u", ",", 
             RowBox[{
              RowBox[{"b", "[", "u", "]"}], "+", 
              RowBox[{
               RowBox[{
                RowBox[{
                "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "[",
                 "u", "]"}], 
               RowBox[{"d", "[", "u", "]"}]}]}]}], "]"}], "&"}], "/@", 
          "pcf3ds"}], ",", "clast"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
              
              RowBox[{
               RowBox[{"StyledRuledPatch", "[", 
                RowBox[{"bb", ",", "dd", ",", 
                 RowBox[{"{", 
                  RowBox[{"u0", ",", "u1"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "v1"}], "}"}]}], "]"}], "//", 
               "ReverseFillStyle"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Styled3DDisk", "[", 
                 RowBox[{
                  RowBox[{"pm", "\[LeftDoubleBracket]", 
                   RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"pm", "\[LeftDoubleBracket]", 
                   RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
                  "1", ",", 
                  RowBox[{"FillStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{"LightGray", ",", 
                    RowBox[{"Opacity", "[", ".2", "]"}]}], "}"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", 
                  RowBox[{"Length", "[", "pm", "]"}]}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics3D", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Styled3DAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
              
              RowBox[{"StyledRuledPatchSequence", "[", 
               RowBox[{"cclist", ",", 
                RowBox[{"{", 
                 RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"StyledCurve", "[", 
                 RowBox[{
                  RowBox[{
                  "cclist", "\[LeftDoubleBracket]", "i", 
                   "\[RightDoubleBracket]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", 
                  RowBox[{"Length", "[", "cclist", "]"}]}], "}"}]}], "]"}], ",",
               "\[IndentingNewLine]", 
              RowBox[{"{", "}"}]}], "}"}], ",", 
            RowBox[{"Lighting", "\[Rule]", 
             RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"StyledRuledPatchSequence", "[", 
              RowBox[{"clist", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"StyledCurve", "[", 
                RowBox[{
                 RowBox[{
                 "clist", "\[LeftDoubleBracket]", "i", 
                  "\[RightDoubleBracket]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "clist", "]"}]}], "}"}]}], "]"}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"{", "}"}]}], "}"}], "]"}]}], "}"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}],
    "//", "ShowExample"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.80642837316205*^9, 3.806428380041988*^9}, {
