              RowBox[{"shifts", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "3"}], "\[RightDoubleBracket]"}], "]"}], 
             "<>", "\"\<)\\n\>\""}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{"script", "<>", "\"\<print('Shifted panel')\\n\>\""}]}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
