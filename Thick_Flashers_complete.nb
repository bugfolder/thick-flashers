Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FrenetTrihedronPlot3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"FrenetVectorLength", "\[Rule]", "0.1"}], ",", 
     "\[IndentingNewLine]", 
