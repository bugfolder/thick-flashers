          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "]"}]}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TransformGC", "[", 
      RowBox[{"expr", ",", 
       RowBox[{
        RowBox[{"2", "*", "#"}], "&"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.912661048326859*^9, 3.912661122604766*^9}, {
  3.91354096521059*^9, 3.913540978709268*^9}, {3.914837593198785*^9, 
