fc56059f26e1"],

Cell[TextData[{
 "PolygonNormal3DRobust[",
 StyleBox["poly",
  FontSlant->"Italic"],
 "] returns the normal vector for a planar polygon that may have flat or \
reflex vertices."
}], "Text",
 CellChangeTimes->{{3.7222076065052757`*^9, 3.722207660434368*^9}, {
  3.722207893358823*^9, 
  3.722207905508111*^9}},ExpressionUUID->"7ff90efe-5809-458c-9cda-\
0b6721aad26a"],

Cell["\<\
We compute the normals at each vertex, pick the one with the largest \
magnitude, then use it to check total winding angle; if it\[CloseCurlyQuote]s \
negative, then we flip the sign.\
\>", "Text",
 CellChangeTimes->{{3.722208202543427*^9, 
  3.722208243263397*^9}},ExpressionUUID->"3083178d-6069-4a91-acd5-\
2588270be028"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonNormal3DRobust", "[", "poly_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"trio", ",", "n", ",", "winding"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"trio", "=", 
      RowBox[{"{", 
       RowBox[{"poly", ",", 
        RowBox[{"RotateLeft", "[", "poly", "]"}], ",", 
        RowBox[{"RotateLeft", "[", 
         RowBox[{"poly", ",", "2"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#2", "-", "#1"}], ")"}], "\[Cross]", 
              RowBox[{"(", 
               RowBox[{"#3", "-", "#2"}], ")"}]}], "&"}], ",", "trio"}], 
           "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Mag", "[", "#1", "]"}], ">", 
            RowBox[{"Mag", "[", "#2", "]"}]}], "&"}]}], "]"}], "//", 
        "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"winding", "=", 
      RowBox[{"Plus", "@@", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ArcTan", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#2", "-", "#1"}], ")"}], ".", 
             RowBox[{"(", 
              RowBox[{"#3", "-", "#2"}], ")"}]}], " ", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#2", "-", "#1"}], ")"}], ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#3", "-", "#2"}], ")"}], "\[Cross]", "n"}], 
              ")"}]}]}], "]"}], "&"}], ",", "trio"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", " ", 
      RowBox[{"Sign", "[", "winding", "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.722207663821629*^9, 3.722207736153879*^9}, 
   3.722207914800488*^9, {3.722207952133011*^9, 3.7222081087101917`*^9}, {
   3.722208153862059*^9, 3.722208184406395*^9}, {3.722208397201597*^9, 
   3.722208649107822*^9}},
 CellLabel->
  "In[686]:=",ExpressionUUID->"e1dcdbd5-2d1b-4054-bee7-2804b7d7f6d7"],

