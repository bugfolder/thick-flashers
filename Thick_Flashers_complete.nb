   3.70775421696738*^9}},ExpressionUUID->"a4c9e6db-5f50-4751-a0ab-\
5b902d5e5b5b"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tiletype",
  FontSlant->"Italic"],
 " \[LongDash] the type of the tile to be rendered.\n\t",
 StyleBox["decorations",
  FontSlant->"Italic"],
 " \[LongDash] a list of decorations to be created and overlaid."
}], "Text",
 CellChangeTimes->{{3.707754161263247*^9, 
  3.7077541999834213`*^9}},ExpressionUUID->"18585ff1-8814-4564-afd7-\
1e00688b4fb4"],

Cell["\<\
This is used most often to overlay Tiling on top of CreasePattern or \
FoldedForm2D.\
\>", "Text",
 CellChangeTimes->{{3.629938176837988*^9, 3.629938204657421*^9}, 
   3.630010307342692*^9},ExpressionUUID->"a0166689-cb2f-486a-be81-\
5dbf0b05f47e"],

