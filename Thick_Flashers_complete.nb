Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeFlapCubeBox", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"FlapFoldAngle", "\[Rule]", 
      RowBox[{"45", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FlapAngle", "\[Rule]", 
      RowBox[{"45", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"FlapWidth", "\[Rule]", 
      RowBox[{"1", "/", "5"}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
