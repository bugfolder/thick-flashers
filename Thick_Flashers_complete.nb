           RowBox[{"-", "1"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"InitialNormalVector3D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}]}], "]"}]}], ";", 
