 RowBox[{
  RowBox[{"MakeChordStarGraph", "[", 
   RowBox[{"specs_List", ",", "m_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"emedges", ",", "verts", ",", "edges", ",", "tobj"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"emedges", "=", 
