 "UnitRegularPolygonCenteredTwistSelfContainedTypes[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau]]"
}], "Subsubsection",
 CellChangeTimes->{{3.457743994532847*^9, 3.457744000082833*^9}, {
   3.627339666831357*^9, 3.627339666964429*^9}, 3.6273858663013487`*^9, 
