   3.668986539605369*^9}, {3.688137290720461*^9, 3.688137292654072*^9}, {
   3.688137343885932*^9, 3.688137344783866*^9}, {3.68979756141362*^9, 
   3.6897975615534983`*^9}, 3.690988444517088*^9, {3.691199544490179*^9, 
   3.6911995974921517`*^9}, {3.691236275383231*^9, 3.691236277216035*^9}, 
   3.691252690231483*^9, 3.691254043989609*^9, 3.691494979117792*^9, 
   3.691505296604574*^9, {3.799520114109933*^9, 3.799520133462904*^9}, {
   3.799522379821442*^9, 3.799522417157188*^9}, 3.800465724410152*^9, 
   3.801317328694652*^9},ExpressionUUID->"8ad1233a-68b9-4e34-8a3a-\
968625a289ba"],

Cell[TextData[{
 "NRecoverCurve3DSystem[ds",
 StyleBox[", \[Kappa]",
  FontSlant->"Italic"],
 ", \[Tau], {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bi",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs a space curve from its coefficients and some specified initial \
conditions using InterpolatingFunctions."
}], "Text",
 CellChangeTimes->{{3.668947828478882*^9, 3.668947977055999*^9}, {
   3.668948036710371*^9, 3.668948054819468*^9}, 3.668951330975006*^9, {
   3.668951363372705*^9, 3.668951368076372*^9}, {3.668967538192066*^9, 
   3.668967539384394*^9}, {3.672062016459675*^9, 3.672062021305244*^9}, {
   3.6874777368721123`*^9, 3.687477753780041*^9}, {3.689797563389432*^9, 
   3.689797582585987*^9}, 3.690989404744676*^9, 3.690990056637327*^9, {
   3.69119961229562*^9, 3.691199612971944*^9}, {3.6912009456361217`*^9, 
   3.6912009505507107`*^9}, {3.691240436888981*^9, 3.691240470312284*^9}, 
   3.69125269026622*^9, 3.691505296638789*^9, 3.691505593772298*^9, 
   3.799515826559915*^9, {3.799520160808452*^9, 3.799520169078108*^9}, {
   3.799520221710574*^9, 3.799520230126319*^9}, {3.7995224241652737`*^9, 
   3.799522441534102*^9}, 3.800465726110647*^9, 
   3.801317328727401*^9},ExpressionUUID->"e5247d8c-d665-408b-b3b5-\
afc174908a9d"],

Cell[TextData[{
 "Arguments:\n\tds \[LongDash] the desired curve speed, as a pure function.\n\
\t\[Kappa] \[LongDash] the curvature, as a pure function.\n\t\[Tau] \
\[LongDash] the torsion, as a pure function.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] parameter of the initial condition.\n\t",
 StyleBox["ci",
  FontSlant->"Italic"],
 " \[LongDash] the initial curve position.\n\t",
 StyleBox["ti",
  FontSlant->"Italic"],
 " \[LongDash] the initial curve tangent.\n\t",
 StyleBox["bi",
  FontSlant->"Italic"],
 " \[LongDash] the initial curve binormal vector.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of interpolation."
}], "Text",
 CellChangeTimes->{{3.691240429083367*^9, 3.691240440211678*^9}, {
   3.799515828887549*^9, 3.799515832062826*^9}, {3.79952023859029*^9, 
   3.799520310303363*^9}, {3.799522443949256*^9, 3.799522451813739*^9}, 
   3.801317328756781*^9},ExpressionUUID->"7ea0bba3-9d7b-43db-840c-\
93261c39d8b4"],

Cell["\<\
Options:
\tOptions[NDSolve] are passed through.\
\>", "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
  3.691235123137779*^9, 3.691235148876122*^9}, {3.799522462061708*^9, 
  3.799522471573263*^9}},ExpressionUUID->"9d6a3569-8cc4-4f48-b3de-\
1d8b0de5ac56"],

Cell["\<\
Returns: a list of rules giving pure functions for the relevant vector and \
scalar fields of the space curve.\
\>", "Text",
 CellChangeTimes->{{3.691240447010771*^9, 
  3.691240453771187*^9}},ExpressionUUID->"fef611fd-5006-4b21-a728-\
ee8859e2230c"],

Cell[TextData[{
 "In the same way as we did in NRecoverCurve2DSystem[ds, ",
 StyleBox["\[Kappa]l",
  FontSlant->"Italic"],
 ", ...], we reinterpolate the solutions we get from NDSolve rather than \
using them directly, because if we feed the curve c[s] back to \
NRecoverCurve3DSystem[c, ...], Mathematica finds a spurious delta-function in \
the curvature at each end, which results in substantial distortion when that \
function gets reinterpolated."
}], "Text",
 CellChangeTimes->{{3.799858254961391*^9, 3.799858286473297*^9}, {
   3.799858373474311*^9, 3.7998583810746512`*^9}, {3.799858470034898*^9, 
   3.799858519827011*^9}, {3.79985857866052*^9, 3.799858684772311*^9}, {
   3.799865067641942*^9, 3.799865099401092*^9}, {3.79986514054628*^9, 
   3.799865205706547*^9}, 3.8004648925392637`*^9, 3.800465735728221*^9, 
   3.801317328800378*^9},ExpressionUUID->"ac26c1a1-ded2-42f3-a5c8-\
f09f89757645"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NRecoverCurve3DSystem", "::", "nosoln"}], 
   "=", "\"\<NDSolve couldn't integrate the Frenet-Serret equations.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, 3.799520989448175*^9, {
   3.799522476366475*^9, 3.799522477789508*^9}, 3.8004657383089027`*^9},
 CellLabel->
  "In[3681]:=",ExpressionUUID->"46a4ce1e-3cfd-408c-b2b7-4ff39ed5817d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NRecoverCurve3DSystem", "[", 
   RowBox[{
    RowBox[{"ds_Function", "|", "ds_InterpolatingFunction"}], ",", 
    RowBox[{"\[Kappa]_Function", "|", "\[Kappa]_InterpolatingFunction"}], ",", 
    RowBox[{"\[Tau]_Function", "|", "\[Tau]_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "ci_List", ",", "ti_List", ",", "bi_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "s", ",", "cx", ",", "cy", ",", "cz", ",", "tx", ",", 
      "ty", ",", "tz", ",", "nx", ",", "ny", ",", "nz", ",", "bx", ",", "by", 
      ",", "bz", ",", "soln", ",", "c", ",", "t", ",", "n", ",", "b"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Integrate", " ", "the", " ", "Frenet"}], "-", 
       RowBox[{"Serret", " ", "differential", " ", "equation"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"cx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"cy", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"cz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tx", "[", "s", "]"}], ",", 
              RowBox[{"ty", "[", "s", "]"}], ",", 
              RowBox[{"tz", "[", "s", "]"}]}], "}"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"tx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"ty", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"tz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Kappa]", "[", "s", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nx", "[", "s", "]"}], ",", 
                RowBox[{"ny", "[", "s", "]"}], ",", 
                RowBox[{"nz", "[", "s", "]"}]}], "}"}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"nx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"ny", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"nz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                RowBox[{"\[Kappa]", "[", "s", "]"}]}], 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"tx", "[", "s", "]"}], ",", 
                 RowBox[{"ty", "[", "s", "]"}], ",", 
                 RowBox[{"tz", "[", "s", "]"}]}], "}"}]}], "+", 
              RowBox[{
               RowBox[{"\[Tau]", "[", "s", "]"}], 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"bx", "[", "s", "]"}], ",", 
                 RowBox[{"by", "[", "s", "]"}], ",", 
                 RowBox[{"bz", "[", "s", "]"}]}], "}"}]}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"bx", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"by", "'"}], "[", "s", "]"}], ",", 
             RowBox[{
              RowBox[{"bz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"\[Tau]", "[", "s", "]"}]}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nx", "[", "s", "]"}], ",", 
                RowBox[{"ny", "[", "s", "]"}], ",", 
                RowBox[{"nz", "[", "s", "]"}]}], "}"}]}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cx", "[", "ui", "]"}], ",", 
             RowBox[{"cy", "[", "ui", "]"}], ",", 
             RowBox[{"cz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ci"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"tx", "[", "ui", "]"}], ",", 
             RowBox[{"ty", "[", "ui", "]"}], ",", 
             RowBox[{"tz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "ti"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nx", "[", "ui", "]"}], ",", 
             RowBox[{"ny", "[", "ui", "]"}], ",", 
             RowBox[{"nz", "[", "ui", "]"}]}], "}"}], "\[Equal]", 
           RowBox[{"bi", "\[Cross]", "ti"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"bx", "[", "ui", "]"}], ",", 
             RowBox[{"by", "[", "ui", "]"}], ",", 
             RowBox[{"bz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "bi"}]}], 
         "\[IndentingNewLine]", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cx", "[", "s", "]"}], ",", 
          RowBox[{"cy", "[", "s", "]"}], ",", 
          RowBox[{"cz", "[", "s", "]"}], ",", 
          RowBox[{"tx", "[", "s", "]"}], ",", 
          RowBox[{"ty", "[", "s", "]"}], ",", 
          RowBox[{"tz", "[", "s", "]"}], ",", 
          RowBox[{"nx", "[", "s", "]"}], ",", 
          RowBox[{"ny", "[", "s", "]"}], ",", 
          RowBox[{"nz", "[", "s", "]"}], ",", 
          RowBox[{"bx", "[", "s", "]"}], ",", 
          RowBox[{"by", "[", "s", "]"}], ",", 
          RowBox[{"bz", "[", "s", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "DSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"NRecoverCurve3DSystem", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Flatten", "[", "soln", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cx", "[", "s", "]"}], ",", 
           RowBox[{"cy", "[", "s", "]"}], ",", 
           RowBox[{"cz", "[", "s", "]"}]}], "}"}], "/.", "soln"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"c", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tx", "[", "s", "]"}], ",", 
           RowBox[{"ty", "[", "s", "]"}], ",", 
           RowBox[{"tz", "[", "s", "]"}]}], "}"}], "/.", "soln"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"t", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"t", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"nx", "[", "s", "]"}], ",", 
           RowBox[{"ny", "[", "s", "]"}], ",", 
           RowBox[{"nz", "[", "s", "]"}]}], "}"}], "/.", "soln"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"n", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"bx", "[", "s", "]"}], ",", 
           RowBox[{"by", "[", "s", "]"}], ",", 
           RowBox[{"bz", "[", "s", "]"}]}], "}"}], "/.", "soln"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"b", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Curve3D", "\[Rule]", "c"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Speed3D", "\[Rule]", "ds"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Curvature3D", "\[Rule]", "\[Kappa]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Torsion3D", "\[Rule]", "\[Tau]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"TangentVector3D", "\[Rule]", "t"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"BinormalVector3D", "\[Rule]", "b"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"NormalVector3D", "\[Rule]", "n"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.668362892429557*^9, 3.66836289243172*^9}, {
   3.668362959737321*^9, 3.668363023189096*^9}, {3.668363067507318*^9, 
