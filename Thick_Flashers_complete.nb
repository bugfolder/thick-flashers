Cell[TextData[{
 "MakeGoldbergTilingPrimalDualGraph",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 "] returns a TPrimalDualGraph representing a primal-dual graph pair for a \
Goldberg tiling where the dual graph is a reciprocal diagram, and thus its \
vertices can be used as the centers of rotation for a shrink-rotate \
tessellation."
}], "Text",
 CellChangeTimes->{{3.485221137879643*^9, 3.4852211801595993`*^9}, {
   3.5922973396161423`*^9, 3.592297348062609*^9}, {3.592297485567651*^9, 
   3.592297501483781*^9}, 3.592435764268313*^9, {3.592505837913498*^9, 
   3.592505840160935*^9}, {3.592506542035891*^9, 3.592506567977078*^9}, 
   3.592828741071945*^9, 3.592828809726809*^9, 
   3.59407210925485*^9},ExpressionUUID->"583870dd-5b6b-4982-b5a7-\
78fb716d0099"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeGoldbergTilingPrimalDualGraph", "[", 
   RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "tobj", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MakeGoldbergTilingGraph", "[", 
        RowBox[{"m", ",", "n"}], "]"}], "//", "AddTPlaneGraphTo"}], "//", 
      "AddTPrimalDualGraphTo"}], "//", 
     "MakeTriangleGraphReciprocalDiagram"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.485221199354245*^9, 3.485221268636593*^9}, 
