Cell["\<\
Construct a helix as the edge of regression for a tangent developable. Solve \
for ueor (maximum u-value for a cross curve) for the helix.\
\>", "Text",
 CellChangeTimes->{{3.689453253807868*^9, 3.689453262224497*^9}, {
  3.689453483716386*^9, 3.6894535433133993`*^9}, {3.6894536547407217`*^9, 
  3.689453661844275*^9}, {3.69100373203043*^9, 3.6910037325821466`*^9}, {
  3.6910037690232267`*^9, 
  3.691003769397485*^9}},ExpressionUUID->"e377d4cb-108d-47b5-8122-\
000deaf2a8bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h", ",", "c", ",", "pcs", ",", "sc", ",", "u0", ",", "v0"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", 
         RowBox[{"h", " ", "#"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pcs", "=", 
      RowBox[{"Curve3DSystem", "[", 
       RowBox[{"c", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"pcs", "//", "ColumnForm"}], "//", "PrettyParameters"}], "//", 
      "Print"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sc", "=", 
      RowBox[{"Speed3D", "/.", "pcs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"sc", "[", "t", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "u0", ",", "ueor"}], "}"}]}], "]"}], "\[Equal]",
           "v0"}], ",", "ueor"}], "]"}], "//", "Simplify"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.689453264770805*^9, 3.6894533404845257`*^9}, {
   3.689453376641898*^9, 3.689453456514914*^9}, {3.689453622792039*^9, 
