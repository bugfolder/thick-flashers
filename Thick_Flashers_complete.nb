          RowBox[{
           RowBox[{"Point", "[", "q1", "]"}], ",", "Green", ",", 
           RowBox[{"PointSize", "[", ".02", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
