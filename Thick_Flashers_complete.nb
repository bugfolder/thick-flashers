Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDihedralsFromSectorsAndMajorDihedral", "::", "binding"}], 
   "=", "\"\<Dihedral angle `1` is beyond the binding angle `2` for sector \
angles `3`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.59475968901122*^9, 3.594759704856963*^9}, {
   3.594759867269778*^9, 3.594759871880265*^9}, {3.594760004524878*^9, 
