Cell[CellGroupData[{

Cell["\<\
Monolithic graphs, crease patterns, and folded form, backwards compatible\
\>", "Subsection",
 CellChangeTimes->{{3.630160673451483*^9, 3.630160692008222*^9}, {
  3.707867262843408*^9, 
  3.707867266899069*^9}},ExpressionUUID->"ba38cfbc-b376-4e69-9b85-\
092eda6c0b06"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.707866738015319*^9, 
  3.707866738615048*^9}},ExpressionUUID->"595c3a7c-fc50-4d62-8238-\
412e421d437f"],

Cell["\<\
In Tessellatica 11.0, we generated monolithic graphs, CPs, and FFs using \
different calling functions. We here map the old calling functions to our new \
ones to make it easier to port old examples.\
\>", "Text",
 CellChangeTimes->{{3.707866740893862*^9, 
  3.707866806215961*^9}},ExpressionUUID->"ad55f986-f1b4-4fcb-acf9-\
8516489c0d66"],

Cell["\<\
Everything in this section is deprecated; you should call \
MonolithicEmbedTiling directly with the appropriate decoration.\
\>", "Text",
 CellChangeTimes->{{3.7078674100214868`*^9, 
  3.707867433253483*^9}},ExpressionUUID->"b3b5f6c1-ad82-4baa-b38d-\
7c7590cccef0"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Tiling decorations
\tMonolithicTGraph, MonolithicTGraph2D, MonolithicCreasePattern, \
MonolithicFoldedForm\
\>", "Subsubsection",
