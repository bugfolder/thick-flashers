Cell["Example: trefoil", "Text",
 CellChangeTimes->{{3.533658028182228*^9, 
  3.533658031166087*^9}},ExpressionUUID->"d96f74e3-f32f-4d21-8880-\
a1af343f2595"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "plist", ",", "plist1", ",", 
      RowBox[{"\[Sigma]", "=", 
       RowBox[{"63.4", "\[Degree]"}]}], ",", 
      RowBox[{"\[Tau]", "=", 
       RowBox[{"4", "\[Degree]"}]}], ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"KnotData", "[", 
       RowBox[{"\"\<Trefoil\>\"", ",", "\"\<SpaceCurve\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plist", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"\[Phi]", "+", 
           RowBox[{"\[Pi]", "/", "3"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", "0", ",", 
           RowBox[{"2", "\[Pi]"}], ",", 
           RowBox[{"\[Pi]", "/", "40"}]}], "}"}]}], "]"}], "//", "N"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "break", " ", "the", " ", "first", " ", "segment", " ", "in", " ", 
       "the", " ", "middle", " ", "so", " ", 
       RowBox[{"there", "'"}], "s", " ", "no", " ", "bend", " ", "or", " ", 
       "torsion", " ", "at", " ", "the", " ", 
       RowBox[{"endpoints", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"plist1", "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "=", "0.1"}], ",", "p0"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"p0", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "x"}], ")"}], " ", 
            RowBox[{
            "plist", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
            "+", 
           RowBox[{
            RowBox[{"(", "x", ")"}], 
            RowBox[{
            "plist", "\[LeftDoubleBracket]", "2", 
             "\[RightDoubleBracket]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "p0", "}"}], ",", 
           RowBox[{"Drop", "[", 
            RowBox[{"plist", ",", "1"}], "]"}], ",", 
           RowBox[{"{", "p0", "}"}]}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTSpaceCurve", "[", 
       RowBox[{"plist1", ",", "0.58", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Sigma]", "+", 
           RowBox[{"\[Tau]", "/", "2"}]}], ",", 
          RowBox[{"\[Sigma]", "-", 
           RowBox[{"\[Tau]", "/", "2"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SpaceCurveMaximumWidth\>\"", "\[Rule]", 
       RowBox[{"tobj", "[", "SpaceCurveMaximumWidth", "]"}]}], "]"}], ";", 
     " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Line", "[", "plist", "]"}], ",", 
             RowBox[{"Point", "[", 
              RowBox[{
              "plist", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
               "]"}]}], "}"}], ",", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4420580720627203`*^9, 3.442058347878783*^9}, {
   3.442058700843926*^9, 3.44205870311481*^9}, {3.442059544125647*^9, 
