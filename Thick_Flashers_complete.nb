Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sa", ",", "da", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sa", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"80", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"100", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"da", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "90"}], "\[Degree]"}], ",", 
