Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "types", ",", "tobjcp", ",", "faspecs", ",", 
      "foldangles", ",", "tobjff"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "V", ",", "M", ",", "V", ",", "V", ",", "V", ",", "M", ",", "V", ",", 
        "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobjcp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}], "//", 
        RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"faspecs", "=", 
      RowBox[{"MakeStdFoldAngleSpecs", "[", "tobjcp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "faspecs", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], "=", 
      
      RowBox[{"{", 
       RowBox[{"\[Infinity]", ",", 
        RowBox[{"100.", "\[Degree]"}]}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"fix", " ", "one", " ", "angle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"MakeGraphFoldAngles", "[", 
       RowBox[{"tobjcp", ",", "faspecs"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"solve", " ", "for", " ", "remaining", " ", "angles"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjff", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobjcp", ",", "foldangles", ",", 
        RowBox[{"StationaryFace", "\[Rule]", "6"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobjcp", "]"}], ",", 
        RowBox[{"Graph3DGraphics3D", "[", "tobjff", "]"}]}], "}"}], "]"}]}]}],
    "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594199497989636*^9, 3.594199836595595*^9}, {
   3.594199972130941*^9, 3.594200086491446*^9}, {3.59420082185769*^9, 
