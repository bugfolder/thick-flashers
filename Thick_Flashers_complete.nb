Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTLinearChain", "::", "badlists"}], 
   "=", "\"\<Length `1` of vertex sectors list `2` should be 1 more than \
length `3` of lengths list `4`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.617382735488225*^9, 3.617382798217739*^9}},
 CellLabel->
  "In[2412]:=",ExpressionUUID->"e323fa46-f9e7-42c6-b303-67794f0afcf5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTLinearChain", "::", "badtypes"}], 
   "=", "\"\<Length `1` of lengths list `2` should be equal to length `3` of \
types list `4`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.617382735488225*^9, 3.617382798217739*^9}, {
  3.617384497509654*^9, 3.617384516255243*^9}},
 CellLabel->
  "In[2413]:=",ExpressionUUID->"c6a07ba1-a44c-4ba8-ae3d-1f3d493841f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTLinearChain", "[", 
   RowBox[{"aa_List", ",", "dd_List", ",", "tt_List", ",", 
    RowBox[{"{", 
     RowBox[{"wr_", ",", "wl_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "wrd", ",", "wld", ",", "p", ",", "\[Phi]", ",", "verts", ",", "edges", ",",
       "faces", ",", "types", ",", "nv", ",", "t2", ",", "t4"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ListEmptyQ", "[", "aa", "]"}], "||", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"Length", "/@", "aa"}], "]"}], "\[NotEqual]", 
         RowBox[{"{", "4", "}"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTLinearChain", "::", "badsecs"}], ",", "aa"}], "]"}], ";", 
