7503b17c0c78"],

Cell[TextData[{
 "Styled3DDiskFromInPlaneVectors[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["{r1, r2}",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns the graphics primitives for a disk (a filled circle) based on its \
position, orientation, and radius."
}], "Text",
 CellChangeTimes->{{3.440612627429846*^9, 3.440612642095929*^9}, {
  3.440612674913216*^9, 3.440612736762813*^9}, {3.440612795966018*^9, 
  3.440612799380759*^9}, {3.440612871697193*^9, 3.44061292711265*^9}, {
  3.44150161049352*^9, 3.441501610493575*^9}, {3.441501683566943*^9, 
  3.4415016887942457`*^9}, {3.442793479404379*^9, 3.442793479404415*^9}, {
  3.443206654494309*^9, 3.443206680596644*^9}, {3.443211405169218*^9, 
  3.4432114221257057`*^9}, {3.668985731788232*^9, 3.668985731788544*^9}, {
  3.693765749337565*^9, 3.6937657902637444`*^9}, {3.693872076323119*^9, 
  3.693872077235281*^9}},ExpressionUUID->"7567bab4-ff7b-4e99-a188-\
6201fb702c2c"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] the center of the disk.\n\t{",
 StyleBox["r1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r2",
  FontSlant->"Italic"],
 "} \[LongDash] direction vectors that define the plane of the disk. They don\
\[CloseCurlyQuote]t have to be normalized or orthogonal.\n\tr \[LongDash] the \
radius of the disk,"
}], "Text",
 CellChangeTimes->{{3.693765906990356*^9, 3.693765934759681*^9}, {
  3.693872080890895*^9, 
  3.693872107267523*^9}},ExpressionUUID->"eb560cae-bb35-44b1-af17-\
9797272d25cd"],

Cell[TextData[{
 "Options are:\n\tArcDivisions\[Rule]",
 StyleBox["n",
  FontSlant->"Italic"],
 ", specifies the number of points to use in drawing the circle.\n\tLineStyle\
\[Rule]",
 StyleBox["style | ",
  FontSlant->"Italic"],
 "None, specifies the Style directive to use in outlining the disk or None \
for no outline.\n\tFillStyle\[Rule]",
 StyleBox["style | ",
  FontSlant->"Italic"],
 "None, specifies the Style directive to use in drawing the disk or None for \
no fill."
}], "Text",
 CellChangeTimes->{{3.6937657923607683`*^9, 3.6937658024626517`*^9}, {
  3.693872558184197*^9, 
  3.693872582134926*^9}},ExpressionUUID->"b14db0b3-bc57-4fef-8dc3-\
7943ab382ba9"],

Cell["\<\
Returns a list of Graphics3D elements that represent the disk.\
\>", "Text",
 CellChangeTimes->{{3.6937653714741497`*^9, 3.693765385266884*^9}, {
  3.6937658730159907`*^9, 
  3.693765873927845*^9}},ExpressionUUID->"4b55372d-1077-4ed6-b7c6-\
c886350062f7"],

