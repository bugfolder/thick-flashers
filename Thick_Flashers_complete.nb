Cell[TextData[{
 "HasPropertyQ",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["property",
  FontSlant->"Italic"],
 "] returns True if ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " contains the given ",
 StyleBox["property",
  FontSlant->"Italic"],
 " and False otherwise."
}], "Text",
 CellChangeTimes->{{3.591380568382844*^9, 3.5913805886631813`*^9}, 
   3.59238877574161*^9},ExpressionUUID->"60241ab7-1835-4d5a-af55-\
08d532915952"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HasPropertyQ", "[", 
   RowBox[{"tobj_TObj", ",", " ", "property_Symbol"}], "]"}], ":=", 
  RowBox[{"MemberQ", "[", 
   RowBox[{
    RowBox[{"GetAllProperties", "[", "tobj", "]"}], ",", "property"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.591380589983345*^9, 3.591380634499967*^9}, {
   3.59163656092432*^9, 3.591636561587779*^9}, {3.591648046668316*^9, 
