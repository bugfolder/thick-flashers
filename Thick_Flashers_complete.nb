Cell[TextData[{
 "UnitBrocardPolygonInfo",
 "[",
 StyleBox["angles, opts",
  FontSlant->"Italic"],
 "]\n\t(options) BrocardAngle, TwistDirection"
}], "Subsubsection",
 CellChangeTimes->{{3.628715320611944*^9, 3.628715325195464*^9}, {
   3.6287218781302366`*^9, 3.628721878719617*^9}, {3.628724680236582*^9, 
