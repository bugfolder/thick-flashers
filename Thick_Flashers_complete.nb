 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "h", ",", "\[Gamma]0", ",", "ff", ",", "\[Gamma]", ",", "cfsys", ",", 
      "rrL", ",", "rrR", ",", "u0", ",", "u1"}], "}"}], ",", 
