Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingePlateGC", "::", "badpts"}], 
   "=", "\"\<Arguments `1`,`2` passed to HingePlateGC are ill-formed.\>\""}], 
  ";"}]], "Input",
