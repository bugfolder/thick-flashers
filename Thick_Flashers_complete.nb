   RowBox[{"TileEdges", "::", "usage"}], 
   "=", "\"\<TileEdges is an option to RenderTile[{PolygonTile, verts}, \
Tiling, opts] that specifies whether to render the edges of time \
polygons.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.629822552512055*^9, 3.6298225798951807`*^9}, 
   3.629823104791955*^9},
