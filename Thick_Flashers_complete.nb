Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeRectangularPot", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"PotPanels", "\[Rule]", "Automatic"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.651517125754939*^9, 3.651517142143785*^9}},
 CellLabel->
  "In[3498]:=",ExpressionUUID->"2bbcd61a-2a6b-4c99-abac-f683eec33c6b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRectangularPot", "[", 
   RowBox[{"pts_List", ",", " ", "m_", ",", "\[Rho]_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m0", ",", "tobjw", ",", "verts3d", ",", "pwjv", ",", "tbl", ",", "di", ",",
       "gs", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m0", "=", 
      RowBox[{
       RowBox[{"PotPanels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeRectangularPot", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m0", "===", "Automatic"}], ",", 
       RowBox[{"m0", "=", "m"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjw", "=", 
      RowBox[{"MakeRectangularPotWedge", "[", 
       RowBox[{"pts", ",", "m", ",", "\[Rho]", ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "pwjv"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobjw", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "PotWedgeJoinVertices"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "we", " ", "need", " ", "3", " ", "points", " ", "along", " ", "each", 
        " ", "edge", " ", "to", " ", "match", " ", "up"}], ",", " ", 
       RowBox[{"and", " ", "for", " ", "best", " ", "accuracy"}], ",", " ", 
       RowBox[{
       "the", " ", "third", " ", "point", " ", "should", " ", "be", " ", "as",
         " ", "far", " ", "off", " ", "of", " ", "the", " ", "line", " ", 
        "between", " ", "the", " ", "first", " ", "two", " ", "as", " ", 
        RowBox[{"possible", ".", " ", "So"}]}], ",", " ", 
       RowBox[{
       "we", " ", "make", " ", "a", " ", "table", " ", "of", " ", "all", " ", 
        "of", " ", "the", " ", "points", " ", "along", " ", "the", " ", 
        "bottom", " ", "edge", " ", "and", " ", "sort", " ", "them", " ", 
        "by", " ", "distance", " ", "from", " ", "the", " ", "line", " ", 
        "between", " ", "the", " ", "two", " ", 
        RowBox[{"corners", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tbl", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"di", ",", 
          RowBox[{"PointLineDistance", "[", 
           RowBox[{
            RowBox[{"verts3d", "\[LeftDoubleBracket]", 
             RowBox[{"pwjv", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "di"}], "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"verts3d", "\[LeftDoubleBracket]", 
               RowBox[{"pwjv", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}], ",", 
              RowBox[{"verts3d", "\[LeftDoubleBracket]", 
               RowBox[{"pwjv", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", 
                 RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], 
               "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"di", ",", "1", ",", 
          RowBox[{"Length", "[", 
           RowBox[{
           "pwjv", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"di", "=", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"tbl", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<", 
           
           RowBox[{
           "#2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "&"}]}], "]"}], "\[LeftDoubleBracket]", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Now", " ", "build", " ", "the", " ", "list", " ", "of", " ", 
       "graphspecs", " ", "for", " ", "joining", " ", "sequentially"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tobjw", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"i", "-", "1"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", 
                RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"2", ",", "di"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}]}], "\[RightDoubleBracket]"}], ",", 
              RowBox[{"pwjv", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "di"}], "\[RightDoubleBracket]"}]}], "}"}]}],
            "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "m0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"JoinGraph3DAssigneds", "[", 
       RowBox[{"gs", ",", "opts"}], "]"}], "//", "AddTPlaneGraph"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.650062212370223*^9, 3.650062323762513*^9}, {
   3.650062357167031*^9, 3.650062473504459*^9}, {3.650062656564355*^9, 
   3.650062702769022*^9}, 3.650062871552209*^9, {3.6500635858015213`*^9, 
