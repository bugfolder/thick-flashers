Cell[TextData[{
 "RenderTile[{PolygonOffsetTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.629837606513099*^9, 3.629837611205377*^9}, {
   3.629837689866628*^9, 3.6298376957612247`*^9}, 3.6298467883813343`*^9, 
   3.707838793632615*^9},ExpressionUUID->"0fc0a424-03a0-4783-ab32-\
8dc5fbc2bb48"],

Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraphAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraphAssigned+TTwistGraph, that describes the creases for a \
twist in a specified polygon where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is the fractional offset distance from the center (could be + or -), and \
",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
