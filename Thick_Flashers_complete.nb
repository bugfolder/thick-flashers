           ",", 
          RowBox[{"EdgeForm", "[", "]"}], ",", 
          RowBox[{"Lighter", "[", 
           RowBox[{"Gray", ",", "0.5"}], "]"}]}], "]"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", "}"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
