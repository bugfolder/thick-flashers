       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "0"}], "}"}], ",", 
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.7012796640242558`*^9, 3.701279940940444*^9}, 
   3.702581521446032*^9, {3.702582923892684*^9, 3.702582935587099*^9}, {
   3.702582967275143*^9, 3.702583051235848*^9}, {3.702583897229518*^9, 
   3.70258393533364*^9}, {3.702662573912733*^9, 3.702662727816004*^9}, {
   3.702662911602785*^9, 3.702662912009699*^9}, 3.702664772866895*^9, {
   3.702667251697871*^9, 3.702667270073175*^9}, {3.702667331228749*^9, 
   3.702667333723799*^9}},
 CellLabel->
  "In[2646]:=",ExpressionUUID->"0ae676e7-e5d8-4af1-97d5-defb0220fc1a"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Strained TQ meshes", "Subsection",
 CellChangeTimes->{{3.701094093786622*^9, 3.701094129548605*^9}, {
   3.701094229804249*^9, 3.70109423018964*^9}, 3.701113011384563*^9, {
   3.701173911740534*^9, 3.701173911893242*^9}, {3.701256931008858*^9, 
   3.7012569331024437`*^9}},ExpressionUUID->"cceb44af-1862-4eef-b305-\
6e1c1b4730b2"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.701094132296877*^9, 
  3.701094132767426*^9}},ExpressionUUID->"016a6e8e-7bc1-41f0-9c2c-\
308f226dc0b2"],

Cell["\<\
A mesh composed of triangles and quads (but no higher polygons) is a \
\[OpenCurlyDoubleQuote]TQ (Triangle-Quad) mesh\[CloseCurlyDoubleQuote]. Many \
useful origami patterns fall into this category.\
\>", "Text",
 CellChangeTimes->{{3.701173836900794*^9, 
  3.701173902382612*^9}},ExpressionUUID->"cb6eac8c-5680-483a-ab87-\
d215796615cb"],

Cell["\<\
In general, pure quad meshes are highly overconstrained when it comes to \
rigid foldability; only very special cases (such as those computed by \
RigidlyFoldableQuadMesh) can be flexed. However, if we allow bending of some \
of the quadrilateral facets along their diagonals, we gain additional degrees \
of freedom and can impose distortions on the 3D form.\
\>", "Text",
 CellChangeTimes->{{3.7010941382638683`*^9, 3.7010942731662707`*^9}, {
  3.7011739403098516`*^9, 
  3.7011739645890636`*^9}},ExpressionUUID->"c4c1a703-ef98-4325-ba24-\
7c6ee1e56a6d"],

Cell["\<\
If we simply replace quads with triangles, we have an ambiguity: which \
diagonal gets bent (because the other stays straight)? And usually, the \
system will now be underconstrained, which means that the desired 3D state \
must be found by minimizing the overall bending energy.\
\>", "Text",
 CellChangeTimes->{{3.701094275188678*^9, 
  3.701094396551456*^9}},ExpressionUUID->"2fcef1b7-e6b7-4df9-a94c-\
755f9c9f1481"],

Cell["\<\
Functions in this section allow us to distort TQ meshes by introducing \
bending and minimizing the overall bend energy. For completeness, we also \
include the possibility of energies associated with folds.\
\>", "Text",
 CellChangeTimes->{{3.7010943992629433`*^9, 3.701094454830725*^9}, {
  3.701173974085319*^9, 3.701173974342146*^9}, {3.701256067327524*^9, 
  3.701256106927812*^9}},ExpressionUUID->"30ae3a2b-f043-49ff-8513-\
e00ca9205546"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TQMeshQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.701173993331054*^9, 
  3.701174041031619*^9}},ExpressionUUID->"b5ee04f9-eaca-45d5-8e31-\
f69d72d77731"],

Cell[TextData[{
 "TQMeshQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns True if the given TGraph has Faces and they are all triangles or \
quads."
}], "Text",
 CellChangeTimes->{{3.701174018021987*^9, 
  3.701174087063311*^9}},ExpressionUUID->"943cab24-5b04-477f-a156-\
2b55413def53"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TQMeshQ", "[", "tobj_TObj", "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"faces", "=", 
      RowBox[{"tobj", "[", "Faces", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"ListEmptyQ", "[", "faces", "]"}]}], "&&", " ", 
     RowBox[{"(", 
      RowBox[{"And", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], "\[LessEqual]", "4"}], "&"}], "/@",
          "faces"}], ")"}]}], ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.701174089904319*^9, 3.701174120006791*^9}, {
  3.701174406066914*^9, 3.701174451203326*^9}},
 CellLabel->
  "In[2647]:=",ExpressionUUID->"369f538a-4d36-4122-ac67-1dc12edd66ef"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "StrainTQMesh[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cons",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph3D, TPlaneGraph\n\t(options) SplitBentFaces, \
SplitBendTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.701094460199665*^9, 3.701094551802001*^9}, {
   3.701094617248906*^9, 3.701094646654688*^9}, {3.701109536683475*^9, 
   3.701109547697034*^9}, {3.701265747501486*^9, 3.70126575037438*^9}, {
   3.701265798557491*^9, 3.7012657997411947`*^9}, 3.701265890460746*^9, {
   3.701266227415601*^9, 
   3.701266231937826*^9}},ExpressionUUID->"ce2c99f8-c877-4dd4-a260-\
d4ea9a91641b"],

Cell[TextData[{
 "StrainTQMesh[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {",
 StyleBox["qa",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ua",
  FontSlant->"Italic"],
 ", ",
 StyleBox["alist",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["qb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ub",
  FontSlant->"Italic"],
 ", ",
 StyleBox["blist",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph3D+TPlaneGraph that is a TQ mesh and finds an equilibrium \
position that satisfies constraints on the vertices while minimizing various \
bend energies."
}], "Text",
 CellChangeTimes->{{3.701094629151726*^9, 3.701094661219305*^9}, {
  3.7010947385949297`*^9, 3.701094759612199*^9}, {3.701095370537115*^9, 
  3.7010953969526854`*^9}, {3.701266215620591*^9, 
  3.701266294945265*^9}},ExpressionUUID->"c91ae9df-a913-4d80-8aed-\
427a5c630f18"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TGraph3D that specifies the crease pattern and initial \
values for the folded form.\n\t",
 StyleBox["cons",
  FontSlant->"Italic"],
 " \[LongDash] a list of constraints functions that constrain vertices in \
various ways"
}], "Text",
 CellChangeTimes->{{3.70109540190308*^9, 3.701095509891101*^9}, {
  3.701265809478017*^9, 
  3.701265860756607*^9}},ExpressionUUID->"cb34bb7f-e229-4818-ba72-\
1d0ae1ec4042"],

Cell[TextData[{
 "Options:\n\tConstrainFromAssigment \[Rule] True | False, whether to \
constrain fold angles from the assignment\n\tStrainGravity \[Rule] ",
 StyleBox["g",
  FontSlant->"Italic"],
 ", weighting factor to apply gravity as an energy function.\n\t\
GravityDirection \[Rule] ",
 StyleBox["u",
  FontSlant->"Italic"],
 ", the direction vector that gravity points toward.\n\tQuadBendStiffness \
\[Rule] ",
 StyleBox["z",
  FontSlant->"Italic"],
 ", weighting factor for quad bend energy. Use \[Infinity] to disallow quad \
bending.\n\tFlatFoldStiffness \[Rule] ",
 StyleBox["z",
  FontSlant->"Italic"],
 ", weighting factor for flat-fold energy. Use 0 to allow free motion of \
folds.\n\tSplitBentFaces \[Rule] True | False, whether to split any bent \
quads into two triangles.\n\tSplitBendTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", the angular tolerance on whether a bent quad should be split."
}], "Text",
 CellChangeTimes->{{3.701095503001195*^9, 3.701095550904725*^9}, {
  3.701265899046178*^9, 3.701265918774149*^9}, {3.701265977942482*^9, 
  3.701266008709317*^9}, {3.701266056390766*^9, 3.701266111385433*^9}, {
  3.701266141463827*^9, 3.701266167440291*^9}, {3.701281628834743*^9, 
  3.701281705075555*^9}, {3.702587237205789*^9, 3.702587266054119*^9}, {
  3.702587304126959*^9, 3.70258734328778*^9}, {3.702667372306495*^9, 
  3.702667372866212*^9}},ExpressionUUID->"e31ca1f1-424a-4cbf-9753-\
ce755a0db3ab"],

Cell["\<\
Returns:
\tA TGraph3D with the new 3D state.\
\>", "Text",
 CellChangeTimes->{{3.701095554904482*^9, 
  3.701095571722441*^9}},ExpressionUUID->"3a1534fe-14d8-4ade-94e3-\
abcacb03a6ae"],

Cell["\<\
Note: this function actually works for meshes that include both triangles and \
quads, but it won\[CloseCurlyQuote]t work for higher-order polygons, for \
which the possible ways to triangulate planarly make the problem more \
complicated.\
\>", "Text",
 CellChangeTimes->{{3.701095942294717*^9, 3.701095970103981*^9}, {
  3.701112867997861*^9, 
  3.70111294115979*^9}},ExpressionUUID->"454db514-26a9-4085-9ca7-\
4d09bd0ef3db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConstrainFromAssignment", "::", "usage"}], 
   "=", "\"\<ConstrainFromAssignment is an option to StrainTQMesh that \
specifies whether to constrain fold angles from the initial crease \
assignment.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701266193893656*^9, 3.701266208993734*^9}, {
  3.701266316201634*^9, 3.7012663345066147`*^9}, {3.702587237220302*^9, 
  3.702587237235703*^9}, {3.702587365498979*^9, 3.702587388551591*^9}, {
  3.702657009672868*^9, 3.702657025391674*^9}},
 CellLabel->
  "In[2648]:=",ExpressionUUID->"a4b71ea4-6a44-4ced-9f91-62998cc9df17"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StrainGravity", "::", "usage"}], 
   "=", "\"\<StrainGravity is an option to StrainTQMesh that specifies the \
strength of gravity acting on a strained TQ mesh.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701266193893656*^9, 3.701266208993734*^9}, {
  3.701266316201634*^9, 3.7012663345066147`*^9}, {3.701281720215657*^9, 
  3.701281744587549*^9}},
 CellLabel->
  "In[2649]:=",ExpressionUUID->"878d462c-b215-40be-9eea-ee99b941a177"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravityDirection", "::", "usage"}], 
   "=", "\"\<GravityDirection is an option to StrainTQMesh that specifies the \
direction that gravity points for a strained TQ mesh.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.701266193893656*^9, 3.701266208993734*^9}, {
  3.701266316201634*^9, 3.7012663345066147`*^9}, {3.7012817236626396`*^9, 
  3.701281757435532*^9}},
 CellLabel->
  "In[2650]:=",ExpressionUUID->"0cb52ba0-7b06-401e-b8f2-5fd7570bb0ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuadBendStiffness", "::", "usage"}], 
   "=", "\"\<QuadBendStiffness is an option to StrainTQMesh that specifies \
the relative stiffness of quadrilateral faces against bending along their \
diagonals.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701266193893656*^9, 3.701266208993734*^9}, {
  3.701266316201634*^9, 3.7012663345066147`*^9}, {3.702587237220302*^9, 
  3.702587237235703*^9}},
 CellLabel->
  "In[2651]:=",ExpressionUUID->"cbedca49-5ba9-41e6-b8eb-d63ca791ec09"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlatFoldStiffness", "::", "usage"}], 
   "=", "\"\<FlatFoldStiffness is an option to StrainTQMesh that specifies \
the relative stiffness of folds to stay in their flat-folded configuration.\>\
\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701266193893656*^9, 3.701266208993734*^9}, {
  3.701266316201634*^9, 3.701266356979028*^9}, {3.702587261366116*^9, 
  3.702587261378397*^9}},
 CellLabel->
  "In[2652]:=",ExpressionUUID->"ce0d253b-60ce-4c5c-a6f2-ff9448b8e678"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SplitBentFaces", "::", "usage"}], 
   "=", "\"\<SplitBentFaces is an option to BendQuadMeshPlanely that \
specifies whether bent quad faces should be split into pairs of \
triangles.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701109595025847*^9, 3.701109650162434*^9}, {
  3.701109709363339*^9, 3.701109709787817*^9}},
 CellLabel->
  "In[2653]:=",ExpressionUUID->"a2a0f6b0-5eb8-4f26-adbf-0f7c67bc6d30"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SplitBendTolerance", "::", "usage"}], 
   "=", "\"\<SplitBendTolerance is an option to BendQuadMeshPlanely that \
specifies the bend angle at or above which we split a quad into \
triangles.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.701109655794349*^9, 3.701109706155993*^9}},
 CellLabel->
  "In[2654]:=",ExpressionUUID->"7e67bcb5-4282-4fe8-9805-85c0c33c8353"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StrainTQMesh", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ConstrainFromAssignment", "\[Rule]", "False"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"StrainGravity", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"GravityDirection", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"QuadBendStiffness", "\[Rule]", "1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"FlatFoldStiffness", "\[Rule]", "1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SplitBentFaces", "\[Rule]", "True"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SplitBendTolerance", "\[Rule]", 
      RowBox[{"1", "\[Degree]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.701095632351762*^9, 3.701095645218752*^9}, {
   3.7011094974831343`*^9, 3.701109526361491*^9}, {3.701266369171603*^9, 
   3.7012663847423*^9}, 3.7012664448952017`*^9, {3.701281776683562*^9, 
   3.701281791982995*^9}, {3.702587237249013*^9, 3.702587261389138*^9}, {
   3.702587394447801*^9, 3.702587401446743*^9}, 3.702657029832547*^9},
 CellLabel->
  "In[2655]:=",ExpressionUUID->"6c6cb817-5ed8-434f-aaac-86d58a7a4d72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrainTQMesh", "[", 
   RowBox[{"tobj_TObj", ",", "cons_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cfa", ",", "qbs", ",", "ffs", ",", "sbf", ",", "sbt", ",", "verts", ",",
       "edges", ",", "faces", ",", "types", ",", "verts3d", ",", "qfaces", ",",
       "ievns", ",", "vars", ",", "vars0", ",", "vverts", ",", "x", ",", 
      "econds", ",", "dconds", ",", "faconds", ",", "exconds", ",", "genergy",
       ",", "benergy", ",", "iequads", ",", "ffenergy", ",", "fom", ",", 
      "soln", ",", "tobj1", ",", "nedges"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cfa", "=", 
      RowBox[{
       RowBox[{"ConstrainFromAssignment", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StrainTQMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qbs", "=", 
      RowBox[{
       RowBox[{"QuadBendStiffness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StrainTQMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ffs", "=", 
      RowBox[{
       RowBox[{"FlatFoldStiffness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StrainTQMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sbf", "=", 
      RowBox[{
       RowBox[{"SplitBentFaces", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StrainTQMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sbt", "=", 
      RowBox[{
       RowBox[{"SplitBendTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StrainTQMesh", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "StrainTQMesh"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPlaneGraph", ",", "StrainTQMesh"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"cfa", ",", 
       RowBox[{"AssertProperty", "[", 
        RowBox[{"tobj", ",", "EdgeTypes", ",", "StrainTQMesh"}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "faces", ",", "verts3d"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges", ",", "Faces", ",", "Vertices3D"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qfaces", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"faces", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "\[Equal]", "4"}], "&"}]}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"quadrilateral", " ", "faces"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ievns", "=", 
      RowBox[{"InteriorEdgeVertexNeighborhoods", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "VARIABLES", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"x", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"3", 
           RowBox[{"Length", "[", "verts", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"all", " ", "variables"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vars0", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"verts3d", ",", "1"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "values"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"vverts", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{"vars", ",", "3"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"vertices", " ", "as", " ", "variables"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "CONSTRAINTS", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"edge", " ", "isometry", " ", "constraints"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"econds", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Mag", "[", 
            RowBox[{
             RowBox[{"vverts", "\[LeftDoubleBracket]", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}], "-", 
             RowBox[{"vverts", "\[LeftDoubleBracket]", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}]}], "]"}], "/", 
           RowBox[{"Mag", "[", 
            RowBox[{
             RowBox[{"verts", "\[LeftDoubleBracket]", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}], "-", 
             RowBox[{"verts", "\[LeftDoubleBracket]", 
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[RightDoubleBracket]"}]}], "]"}]}], "-", "1"}], "\[Equal]", 
         "0"}], "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "diagonal", " ", "isometry", " ", "constraints", " ", "for", " ", 
       "quads"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dconds", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"qbs", "===", "\[Infinity]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"infinitely", " ", "stiff", " ", "quads"}], ",", " ", 
          RowBox[{
          "no", " ", "bending", " ", "on", " ", "either", " ", "diagonal"}]}],
          " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Mag", "[", 
                 RowBox[{
                  RowBox[{"vverts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "-", 
                  RowBox[{"vverts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "3", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
                 "]"}], "/", 
                RowBox[{"Mag", "[", 
                 RowBox[{
                  RowBox[{"verts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "-", 
                  RowBox[{"verts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "3", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
                 "]"}]}], "-", "1"}], "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Mag", "[", 
                 RowBox[{
                  RowBox[{"vverts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "-", 
                  RowBox[{"vverts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "4", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
                 "]"}], "/", 
                RowBox[{"Mag", "[", 
                 RowBox[{
                  RowBox[{"verts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "-", 
                  RowBox[{"verts", "\[LeftDoubleBracket]", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "4", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
                 "]"}]}], "-", "1"}], "\[Equal]", "0"}]}], "}"}], "&"}], "/@",
           "qfaces"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"allow", " ", "bending"}], ",", " ", 
          RowBox[{"either", " ", "diagonal", " ", "is", " ", "isometric"}]}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Mag", "[", 
                RowBox[{
                 RowBox[{"vverts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}], "-", 
                 RowBox[{"vverts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}]}], "]"}], "/", 
               RowBox[{"Mag", "[", 
                RowBox[{
                 RowBox[{"verts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}], "-", 
                 RowBox[{"verts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}]}], "]"}]}], "-", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Mag", "[", 
                RowBox[{
                 RowBox[{"vverts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}], "-", 
                 RowBox[{"vverts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}]}], "]"}], "/", 
               RowBox[{"Mag", "[", 
                RowBox[{
                 RowBox[{"verts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}], "-", 
                 RowBox[{"verts", "\[LeftDoubleBracket]", 
                  RowBox[{
                  "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}],
                   "\[RightDoubleBracket]"}]}], "]"}]}], "-", "1"}], ")"}]}], 
           "\[Equal]", "0"}], "&"}], "/@", "qfaces"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "fold", " ", "angle", " ", "constraints", " ", "from", " ", "from", " ",
        "assignment"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"faconds", "=", 
      RowBox[{"If", "[", 
       RowBox[{"cfa", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"types", "=", 
          RowBox[{"GetValue", "[", 
           RowBox[{"tobj", ",", "EdgeTypes"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"faconds", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Switch", "[", 
               RowBox[{"#1", ",", "\[IndentingNewLine]", "V", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"ListEmptyQ", "[", "#2", "]"}]}], ",", 
                  RowBox[{"EdgeValleyFoldConstraints", "[", 
                   RowBox[{"#2", ",", "vverts"}], "]"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
                "M", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"ListEmptyQ", "[", "#2", "]"}]}], ",", 
                  RowBox[{"EdgeMountainFoldConstraints", "[", 
                   RowBox[{"#2", ",", "vverts"}], "]"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
                "_", ",", 
                RowBox[{"{", "}"}]}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"types", ",", "ievns"}], "}"}]}], "]"}], "]"}]}]}], ",", 
        RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"external", " ", "constraints"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"exconds", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "vverts", "]"}], "&"}], "/@", "cons"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"FIGURE", " ", "OF", " ", "MERIT"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"bend", " ", "energy", " ", "of", " ", "quads"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"benergy", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"qbs", "\[Equal]", "0"}], "||", 
         RowBox[{"qbs", "===", "\[Infinity]"}]}], ",", "0", ",", 
        RowBox[{"qbs", " ", 
         RowBox[{"Plus", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Apply", "[", 
              RowBox[{"QuadBendEnergy", ",", 
               RowBox[{
               "vverts", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}]}], "]"}], "&"}], "/@", "qfaces"}], 
           ")"}]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"flat", " ", "fold", " ", "energy"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ffenergy", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ffs", "\[Equal]", "0"}], ",", "0", ",", 
        RowBox[{"ffs", " ", 
         RowBox[{"Plus", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"EdgeFlatFoldEnergy", "[", 
              RowBox[{"#", ",", "vverts"}], "]"}], "&"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"ievns", ",", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"ListEmptyQ", "[", "#", "]"}]}], "&"}]}], "]"}]}], 
           ")"}]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fom", "=", 
      RowBox[{"benergy", "+", "ffenergy"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"find", " ", "a", " ", "solution"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<# vars = \>\"", ",", 
        RowBox[{"Length", "[", "vars", "]"}]}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<# conds = \>\"", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"econds", ",", "dconds", ",", "faconds", ",", "exconds"}], 
          "]"}], "]"}]}], "]"}], "//", "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindMinimum", "@@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"fom", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"econds", ",", "dconds", ",", "faconds", ",", "exconds"}],
             "]"}]}], "}"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"vars", ",", "vars0"}], "}"}], "]"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "make", " ", "a", " ", "new", " ", "object", " ", "with", " ", "the", " ",
        "new", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"vverts", "/.", 
       RowBox[{
       "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"ReplaceProperty", "[", 
        RowBox[{"Vertices3D", "\[Rule]", "verts3d"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sbf", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Seek", " ", "new", " ", "edges", " ", "as", " ", "those", " ", 
         "whose", " ", "bend", " ", "angle", " ", "exceeds", " ", "the", " ", 
         "tolerance"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ba13", "=", 
              RowBox[{"SkewQuadrilateralAngle", "@@", 
               RowBox[{
               "verts3d", "\[LeftDoubleBracket]", "#", 
                "\[RightDoubleBracket]"}]}]}], ",", 
             RowBox[{"ba24", "=", 
              RowBox[{"SkewQuadrilateralAngle", "@@", 
               RowBox[{"verts3d", "\[LeftDoubleBracket]", 
                RowBox[{"RotateLeft", "[", "#", "]"}], 
                "\[RightDoubleBracket]"}]}]}]}], "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"ba13", "\[GreaterEqual]", "sbt"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"nedges", ",", 
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "3"}], "}"}], "\[RightDoubleBracket]"}]}], 
              "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"ba24", "\[GreaterEqual]", "sbt"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"nedges", ",", 
                 RowBox[{"#", "\[LeftDoubleBracket]", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "4"}], "}"}], 
                  "\[RightDoubleBracket]"}]}], "]"}]}], "]"}]}], "]"}]}], 
          "]"}], "&"}], "/@", "qfaces"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sbf", "&&", 
        RowBox[{"!", 
         RowBox[{"ListEmptyQ", "[", "nedges", "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj1", "=", 
        RowBox[{
         RowBox[{"tobj1", "//", 
          RowBox[{"ReplaceProperties", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Edges", "\[Rule]", 
              RowBox[{"Join", "[", 
               RowBox[{"edges", ",", "nedges"}], "]"}]}], ",", 
             RowBox[{"EdgeTypes", "\[Rule]", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"tobj1", "[", "EdgeTypes", "]"}], ",", 
                RowBox[{"Table", "[", 
                 RowBox[{"U", ",", 
                  RowBox[{"{", 
                   RowBox[{"Length", "[", "nedges", "]"}], "}"}]}], "]"}]}], 
               "]"}]}]}], "}"}], "]"}]}], "//", "RebuildPlaneGraph"}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj1", "//", "RecalcFoldAngles"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"ReassignGraphAssigned", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"tobj1", "[", "FoldAngles", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "tobj1"}]}], "]"}]}]], "Input",
