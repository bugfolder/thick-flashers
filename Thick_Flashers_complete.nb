856b7d591a38"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tglist",
  FontSlant->"Italic"],
 " \[LongDash] a list of TGraphs."
}], "Text",
 CellChangeTimes->{{3.7077779009570017`*^9, 3.7077779087261763`*^9}, 
