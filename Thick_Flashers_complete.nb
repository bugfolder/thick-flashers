Cell[CellGroupData[{

Cell["Woven tessellation generation", "Subsection",
 CellChangeTimes->{{3.4628137675253577`*^9, 3.462813793155284*^9}, {
   3.701384751513516*^9, 3.701384767753687*^9}, 
   3.703797699450547*^9},ExpressionUUID->"43b54745-3846-441b-92fe-\
0ed0b08f79a5"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.462813825625152*^9, 
  3.462813826728821*^9}},ExpressionUUID->"e1da6074-f335-429a-bb5e-\
e0d830c0cce4"],

Cell["\<\
The typical process for creating  woven tessellation is illustrated in the \
examples, but it basically follows this pattern:
(1) Generate a TGraph consisting of intersecting straight lines (e.g., via \
MakeChordStarGraph, MakeCourteousAnarchyGraph, or via your own algorithm).
(2) If necessary, Intersectify the TGraph to break it up into individual line \
segments.
(3) Create an InsetSepararationPlot of the graph to determine a suitable \
inset distance.
(4) Feed the graph to MakeSimpleWovenTessellation. The output is a TGraph2D \
that describes the crease pattern and folded form.\
\>", "Text",
 CellChangeTimes->{{3.627818893198103*^9, 3.627819045420371*^9}, 
   3.721819530520012*^9, {3.7218304203651657`*^9, 3.721830420960589*^9}, {
   3.7218459828274403`*^9, 
   3.721846025452281*^9}},ExpressionUUID->"237796f5-6130-4390-897b-\
acd06b982107"],

Cell["\<\
Mathematica 11 broke the original version of this function; I\
\[CloseCurlyQuote]ve rewritten part of the code to fix this.\
\>", "Text",
 CellChangeTimes->{{3.721880205164152*^9, 
  3.721880227558145*^9}},ExpressionUUID->"8c30dcc5-ce4a-4f25-8808-\
bbeddfb1ec8a"],

Cell["\<\
In Tessellatica 11.1, I\[CloseCurlyQuote]ve updated this function to allow \
variable-width strips, not insetting the boundary, and, most significantly, \
added support for periodic boundary conditions. See the examples. Also fixed \
a minor bug that affected pleat width at the boundary.\
\>", "Text",
 CellChangeTimes->{{3.721814398295563*^9, 3.721814433901832*^9}, {
  3.721821329164507*^9, 3.7218213512982893`*^9}, {3.721830456578163*^9, 
  3.721830457226225*^9}, {3.721830492974947*^9, 3.721830520460973*^9}, {
  3.721880128431272*^9, 3.721880138244269*^9}, {3.721880176649528*^9, 
  3.721880202713498*^9}, {3.722108758350595*^9, 3.722108797374139*^9}, {
  3.722109703871365*^9, 
  3.722109705014782*^9}},ExpressionUUID->"ba2796df-383e-41d1-b6e6-\
95f58cadb4e8"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeSimpleWovenTessellation[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["inset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) MinimumPleatSize, \
MinimumBorderPleatSize, WovenParity, WovenPeriodicity, StationaryFace, \
ShowProgress"
}], "Subsubsection",
 CellChangeTimes->{{3.462801032297914*^9, 3.462801076702921*^9}, {
   3.462809293429165*^9, 3.462809297706608*^9}, 3.462899289141987*^9, {
   3.4633500734024076`*^9, 3.463350077158038*^9}, 3.533604274414126*^9, {
   3.592561828634435*^9, 3.592561838016004*^9}, 3.592562067369824*^9, 
   3.59282874454596*^9, 3.627766048374625*^9, 3.72181953056413*^9, {
   3.721819587742323*^9, 3.721819588106988*^9}, {3.721844426171793*^9, 
   3.7218444282528667`*^9}},ExpressionUUID->"403daf07-ae84-47fe-b8c8-\
1d0812931d24"],

Cell[TextData[{
 "MakeSimpleWovenTessellation[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["inset",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs a woven tessellation."
}], "Text",
 CellChangeTimes->{{3.462801090830243*^9, 3.4628011766818523`*^9}, {
   3.462801223120502*^9, 3.462801478799604*^9}, {3.46280372147653*^9, 
   3.46280376625351*^9}, {3.462808769026128*^9, 3.462808832494242*^9}, {
   3.4628089726120234`*^9, 3.4628089745713863`*^9}, {3.462809308004095*^9, 
   3.462809309106576*^9}, 3.462899289167313*^9, {3.463349968109605*^9, 
   3.46334998070033*^9}, {3.463350081227915*^9, 3.4633501322262697`*^9}, 
   3.533604274466965*^9, {3.5336043247731943`*^9, 3.533604347625696*^9}, {
   3.592561846225069*^9, 3.5925619223945093`*^9}, {3.59256207150628*^9, 
   3.5925620892324677`*^9}, 3.592828744701784*^9, 3.592828910578703*^9, 
   3.594742520027498*^9, 3.627766447636694*^9, {3.627842546906045*^9, 
   3.62784254850447*^9}, 3.721812833426374*^9, 3.721812910496167*^9, {
   3.721813043330606*^9, 3.721813044358157*^9}, 
   3.721819643763504*^9},ExpressionUUID->"51c0cac8-e150-4f65-9589-\
68f9980ade4d"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] a TGraph that specifies the original graph.\n\t",
 StyleBox["inset",
  FontSlant->"Italic"],
 " \[LongDash] a constant inset distance or a list of insets, one for each \
line segment in the graph. Strip width is twice the inset distance."
}], "Text",
 CellChangeTimes->{{3.721812920743845*^9, 
  3.721813026538582*^9}},ExpressionUUID->"60bf0899-8cae-4267-a174-\
4e491cf38d16"],

Cell[TextData[{
 "Options:\n\tMinimumPleatSize \[Rule] ",
 StyleBox["dmin",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["dmin",
  FontSlant->"Italic"],
 " is the minimum pleat width relative to the inset distance. Default value \
is equal to the inset distance, i.e., 1.\n\tMinimumBorderPleatSize \[Rule] ",
 StyleBox["dbmin",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["dbmin",
  FontSlant->"Italic"],
 " is the minimum width of border pleats for diverging pleats, also relative \
to the inset distance. Default value is 0.01.\n\tBorderInset \[Rule] \
Automatic | None, whether to inset the border by the same amount as the \
interior lines.\n\tWovenParity \[Rule] \[PlusMinus]1, which lets you switch \
the direction of the overlaps.\n\tWovenPeriodicity \[Rule] None | {{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["i", "1"], TraditionalForm]],ExpressionUUID->
  "6a2378a5-3687-4448-99b0-c757e0e87c2d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "1"], TraditionalForm]],ExpressionUUID->
  "4cba7122-6f69-4f09-a133-0a0d7a77adcf"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["i", "2"], TraditionalForm]],ExpressionUUID->
  "6a5dca61-ec48-4edc-9555-b95d5bdcca50"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "2"], TraditionalForm]],ExpressionUUID->
  "0f307780-4a02-426b-b22b-3c4f57bdd29e"],
 "}, ...}, where the list of index pairs describes the desired periodicity of \
the pattern.\n\tStationaryFace \[Rule] ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is the index of the face of the original graph to fix the position of; \
this determines the orientation of the crease pattern.\n\tShowProgress\[Rule] \
True | False, if True, displays intermediate results. Very useful if you need \
to debug things."
}], "Text",
 CellChangeTimes->{{3.721812836179202*^9, 3.721812849591752*^9}, {
  3.721812924908413*^9, 3.721812925364124*^9}, {3.7218189969521*^9, 
  3.721819017116935*^9}, {3.7218443784237227`*^9, 3.7218444172534733`*^9}, {
  3.722164992527965*^9, 3.7221650187186117`*^9}, {3.722166687223383*^9, 
  3.722166751212878*^9}, {3.722182020899949*^9, 3.722182021771138*^9}, {
  3.722252773964024*^9, 
  3.722252797180451*^9}},ExpressionUUID->"2ed4f698-edb5-4c3a-8018-\
91cc530ea880"],

Cell["\<\
Returns: a TGraph2D+TAssigned that describes the crease pattern and folded \
form.\
\>", "Text",
 CellChangeTimes->{{3.721812860810545*^9, 
  3.7218129044639397`*^9}},ExpressionUUID->"94d5da3a-5604-4388-9090-\
05c34581551c"],

Cell[TextData[{
 "The width of each woven strip is twice the inset distance ",
 StyleBox["inset",
  FontSlant->"Italic"],
 ". If ",
 StyleBox["inset",
  FontSlant->"Italic"],
 " is a list of values, then the width of each edge strip is given by its \
corresponding entry in ",
 StyleBox["inset",
  FontSlant->"Italic"],
 ". To avoid insetting the boundary edges, give a list of explicit inset \
distances and set all the edge inset values to zero."
}], "Text",
 CellChangeTimes->{{3.721812912591915*^9, 3.721812914526496*^9}, {
  3.721819032637005*^9, 3.721819097197028*^9}, {3.721844276533368*^9, 
  3.721844318643901*^9}},ExpressionUUID->"3d5140dc-701d-4a82-971a-\
56238161e4e2"],

Cell["\<\
BorderInset \[Rule] Automatic will inset the border for non-periodic patterns \
(to be consistent with previous versions) but will not inset the border for \
periodic patterns.\
\>", "Text",
 CellChangeTimes->{{3.722165031365875*^9, 
  3.722165086655039*^9}},ExpressionUUID->"f07d6fa5-98b8-4a50-8594-\
cfe38ff372f5"],

Cell[TextData[{
 "If you use the WovenPeriodicity option, you will provide a structured list \
of indices that specifies the periodicity constraints, which you can use to \
create a version that tiles periodically. The specific form of this option \
is:\n\tWovenPeriodicity \[Rule] {{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["i", "1"], TraditionalForm]],ExpressionUUID->
  "3d0f0b1c-c5b6-43da-b0d6-904f55cc58d9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "1"], TraditionalForm]],ExpressionUUID->
  "015a54a3-3501-49dd-a968-00b55e2f678c"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["i", "2"], TraditionalForm]],ExpressionUUID->
  "4095e2e5-b24c-4335-a1ad-2c98c967624d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "2"], TraditionalForm]],ExpressionUUID->
  "38b5aabe-c3ae-4789-a285-d80e347234ae"],
 "}...}\nwhere each pair {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 "} are two vertices on the boundary that are periodic images of each other."
}], "Text",
 CellChangeTimes->{{3.721844335434295*^9, 3.721844370621993*^9}, {
  3.721880241745418*^9, 3.721880394000675*^9}, {3.721880430260345*^9, 
  3.721880502832239*^9}, {3.721880551055434*^9, 3.721881144097791*^9}, {
  3.7218990096848803`*^9, 3.721899072457687*^9}, {3.721899107155739*^9, 
  3.721899139231222*^9}, {3.7219053956515207`*^9, 3.721905907113633*^9}, {
  3.722166767371139*^9, 
  3.722166887615376*^9}},ExpressionUUID->"b69dc419-a827-4c48-8e0d-\
86147d0713db"],

Cell["\<\
To construct the WovenPeriodicity conditions, run MakeSimpleWovenTessellation \
with ShowProgress turned on, then pick out the plot of \
\[OpenCurlyDoubleQuote]all new edges\[CloseCurlyDoubleQuote] to see vertex \
indices and how they are connected. Then you can re-run \
MakeSimpleWovenTessellation with the WovenPeriodicity data. \
\>", "Text",
 CellChangeTimes->{{3.7221074110745897`*^9, 3.722107465600656*^9}, {
  3.722107621330347*^9, 
  3.7221076905630407`*^9}},ExpressionUUID->"fe4dab61-23c6-48a1-8f2e-\
83219400aeae"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MinimumPleatSize", "::", "usage"}], 
   "=", "\"\<MinimumPleatSize is an option to MakeSimpleWovenTessellation \
that specifies the minimum pleat width relative to the inset distance.\>\""}],
   ";"}]], "Input",
 CellChangeTimes->{{3.592561953027793*^9, 3.592562019750893*^9}, 
   3.5928287448062887`*^9, 3.6278425358955307`*^9, 3.721819530576223*^9, {
   3.721819652389961*^9, 3.72181965278036*^9}},
 CellLabel->
  "In[3414]:=",ExpressionUUID->"a18813b7-edf6-4608-8335-a039de2e2cfb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MinimumBorderPleatSize", "::", "usage"}], 
   "=", "\"\<MinimumBorderPleatSize is an option to \
MakeSimpleWovenTessellation that specifies the minimum width of border pleats \
for diverging pleats.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.592562008912643*^9, 3.592562036958129*^9}, 
   3.592828744905629*^9, 3.6278425373351*^9, 3.721819530585877*^9, {
   3.721819653828322*^9, 3.721819654270822*^9}},
 CellLabel->
  "In[3415]:=",ExpressionUUID->"0979ac06-c86d-47a9-9cdd-e097221989b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"WovenParity", "::", "usage"}], 
   "=", "\"\<WovenParity is an option to MakeSimpleWovenTessellation that \
specifies the direction of the overlaps beteen the woven strips.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.59256209671349*^9, 3.592562124504647*^9}, 
   3.592828745004587*^9, 3.627842539006833*^9, 3.721819530595045*^9, {
   3.721819656209151*^9, 3.721819656782267*^9}},
 CellLabel->
  "In[3416]:=",ExpressionUUID->"b99b8f39-3ef4-4046-b866-dff5ab9259e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"WovenPeriodicity", "::", "usage"}], 
   "=", "\"\<WovenPeriodicity is an option to MakeSimpleWovenTessellation \
that specifies whether and how the pattern should be periodic.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.59256209671349*^9, 3.592562124504647*^9}, 
   3.592828745004587*^9, 3.627842539006833*^9, 3.721819530595045*^9, {
   3.721819656209151*^9, 3.721819656782267*^9}, {3.721844438998583*^9, 
   3.72184445846264*^9}},
 CellLabel->
  "In[3417]:=",ExpressionUUID->"71586288-7f9a-4e53-8f79-40035be21c21"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BorderInset", "::", "usage"}], 
   "=", "\"\<BorderInset is an option to MakeSimpleWovenTessellation tha \
specifies whether the border should be inset.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.722164940334432*^9, 3.722164972773637*^9}},
 CellLabel->
  "In[3418]:=",ExpressionUUID->"54ec18fe-f790-4afc-b6f9-4c7b22601e8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MinimumPleatSize", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"MinimumBorderPleatSize", "\[Rule]", "0.01"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"BorderInset", "\[Rule]", "Automatic"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"WovenParity", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"WovenPeriodicity", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"StationaryFace", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.462808837367454*^9, 3.46280888118054*^9}, 
   3.462899289199026*^9, 3.46334998392667*^9, {3.463350142076664*^9, 
   3.463350148635154*^9}, 3.533604274502256*^9, 3.592562067168296*^9, 
   3.592828745221448*^9, 3.627766102491526*^9, 3.72181953060424*^9, {
   3.721819658487005*^9, 3.7218196590100403`*^9}, {3.721844462325114*^9, 
   3.7218444663057423`*^9}, {3.722106016741517*^9, 3.722106022674975*^9}, {
   3.722164979437438*^9, 3.72216498433397*^9}},
 CellLabel->
  "In[3419]:=",ExpressionUUID->"aaae641f-a975-4bba-a537-eb3f78d8352b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSimpleWovenTessellation", "::", "badbi"}], 
   "=", "\"\<Option BorderInset \[Rule] `1` must be either Automatic or None.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.722165381419383*^9, 3.722165398489955*^9}, 
   3.722165806391464*^9, {3.722166293067379*^9, 3.722166320642009*^9}},
 CellLabel->
  "In[3420]:=",ExpressionUUID->"35d2f055-6585-4c12-a03b-770b836fc598"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSimpleWovenTessellation", "::", "badper"}], 
   "=", "\"\<Option WovenPeriodicity \[Rule] `1` must be either None or a \
list of index pairs.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.722165381419383*^9, 3.722165398489955*^9}, {
  3.722165806391464*^9, 3.722165832719262*^9}, {3.722166295986749*^9, 
  3.722166317691558*^9}, {3.722173184035572*^9, 3.722173185568563*^9}},
 CellLabel->
  "In[3421]:=",ExpressionUUID->"4eff9d95-dcc8-4499-a1f3-f38786a000a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSimpleWovenTessellation", "::", "badins"}], 
   "=", "\"\<Inset list `1` must have the same length as edge list \
`2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.721818646778886*^9, 3.721818684944826*^9}, 
   3.721819530614349*^9, {3.721819660901813*^9, 3.721819661432448*^9}},
 CellLabel->
  "In[3422]:=",ExpressionUUID->"ade1a1b3-e712-4261-ad40-cdd5f98d9204"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSimpleWovenTessellation", "::", "optfail"}], 
   "=", "\"\<MakeSimpleWovenTessellation failed because it was unable to find \
a minimum in the optimization step.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.462807986359215*^9, 3.462808010635777*^9}, {
   3.462899289444399*^9, 3.462899289698052*^9}, {3.533604274750835*^9, 
   3.533604275002804*^9}, {3.59257648060277*^9, 3.592576481175943*^9}, {
   3.592828745321259*^9, 3.592828745387226*^9}, 3.627766104534579*^9, 
   3.703797967094816*^9, {3.721819530627482*^9, 3.721819530636546*^9}, {
   3.721819662909908*^9, 3.721819669046226*^9}},
 CellLabel->
  "In[3423]:=",ExpressionUUID->"f8db949a-d070-4770-85d9-c0a55d613c4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSimpleWovenTessellation", "::", "nokawa"}], 
   "=", "\"\<MakeSimpleWovenTessellation failed because the best solution \
found has a Kawasaki condition mismatch greater than \
\!\(\*SuperscriptBox[\(10\), \(-4\)]\). Values were: `1`\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.463235239163793*^9, 3.46323532013831*^9}, {
   3.533604275236479*^9, 3.53360427548758*^9}, {3.5928287454892387`*^9, 
   3.592828745553842*^9}, 3.627766106502097*^9, {3.703797947060806*^9, 
   3.703797966007841*^9}, 3.703872465239265*^9, {3.721819530645813*^9, 
   3.721819530655301*^9}, {3.721819664685817*^9, 3.721819671021157*^9}},
 CellLabel->
  "In[3424]:=",ExpressionUUID->"97a66788-28a1-4247-97d9-e00f85e0ec2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeSimpleWovenTessellation", "[", 
   RowBox[{"tobj_TObj", ",", "inset_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mps", ",", "mbps", ",", "bi", ",", "wpar", ",", "wper", ",", "sface", ",",
       "sp", ",", "isper", ",", "tobjdef", ",", "verts", ",", "edges", ",", 
      "faces", ",", "bverts", ",", "bedges", ",", "iedges", ",", "dedges", ",",
       "fei", ",", "vei", ",", "edgepairs", ",", "twocoloring", ",", "tcfv", ",",
       "h", ",", "insetverts", ",", "fvdata", ",", "beqv", ",", "beqe", ",", 
      "di", ",", "db", ",", "makeverts", ",", "ndi", ",", "ndb", ",", 
      "newverts", ",", "newfverts", ",", "newbverts", ",", "ocnmap", ",", 
      "nwper", ",", "hdruleff", ",", "newedges", ",", "newtypes", ",", 
      "nfvpos", ",", "prevnewvert", ",", "newvert", ",", "nextnewvert", ",", 
      "altnewvert", ",", "prevvalvert", ",", "nextvalvert", ",", "addpleat", ",",
       "hdrulecp", ",", "tobjout", ",", "nedges", ",", "nbedges", ",", 
      "niedges", ",", "vva", ",", "kawaconds", ",", "perconds", ",", 
      "kawavals", ",", "merit", ",", "eqns", ",", "ineqns", ",", "vars", ",", 
      "time", ",", "soln", ",", "newvertsff"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "MakeSimpleWovenTessellation"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mps", "=", 
      RowBox[{
       RowBox[{"MinimumPleatSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mbps", "=", 
      RowBox[{
       RowBox[{"MinimumBorderPleatSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bi", "=", 
      RowBox[{
       RowBox[{"BorderInset", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wpar", "=", 
      RowBox[{
       RowBox[{"WovenParity", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wper", "=", 
      RowBox[{
       RowBox[{"WovenPeriodicity", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sface", "=", 
      RowBox[{
       RowBox[{"StationaryFace", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeSimpleWovenTessellation", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"bi", "===", "None"}], "||", 
          RowBox[{"bi", "===", "Automatic"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeSimpleWovenTessellation", "::", "badbi"}], ",", "bi"}],
          "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
