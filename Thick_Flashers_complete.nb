     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertexFromAngles", "[", 
       RowBox[{"sa", ",", "da"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"VertexCreasePatternGraphics", "[", 
       RowBox[{"tobj", ",", "\[IndentingNewLine]", 
        RowBox[{"DihedralAngleLabels", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "Italic", ",", " ", "16"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            
            RowBox[{"\"\<a\>\"", " ", ",", "\"\<b\>\"", ",", "\"\<c\>\"", 
             ",", "\"\<d\>\""}], "}"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"SectorAngleLabels", "\[Rule]", 
         RowBox[{"(", 
          RowBox[{
