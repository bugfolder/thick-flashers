Cell[TextData[{
 "TileArrowCF[{",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["dir",
  FontSlant->"Italic"],
 "] returns a crossing arrowhead centered on the line from ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q",
  FontSlant->"Italic"],
 ". If dir>0, then the arrow points to the right (relative to the line from \
",
 StyleBox["p",
  FontSlant->"Italic"],
 " to ",
 StyleBox["q",
  FontSlant->"Italic"],
 "); otherwise it points to the left."
}], "Text",
 CellChangeTimes->{{3.62758148299821*^9, 3.627581539290063*^9}, {
   3.627581661765328*^9, 3.6275816744975567`*^9}, {3.6275829175557017`*^9, 
