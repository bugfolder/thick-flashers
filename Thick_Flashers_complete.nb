Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the fold line\n\t{",
 StyleBox["bl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["br",
  FontSlant->"Italic"],
 "} \[LongDash] two pure functions giving the endpoints of ruling lines to \
the fold line."
}], "Text",
 CellChangeTimes->{{3.691410176588348*^9, 3.691410235807106*^9}, {
   3.691496540224122*^9, 3.691496572012128*^9}, {3.691503214939596*^9, 
