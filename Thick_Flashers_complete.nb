Cell[CellGroupData[{

Cell[TextData[{
 "NFoldCurvedFold3D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rR",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["\[Gamma]i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ffi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbti",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[NDSolve], Options[FunctionInterpolation]"
}], "Subsubsection",
 CellChangeTimes->{{3.79944274677419*^9, 3.799442797151381*^9}, 
   3.799442988715061*^9, {3.799443047908704*^9, 3.799443049650156*^9}, 
