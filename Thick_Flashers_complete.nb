Cell[CellGroupData[{

Cell[TextData[{
 "FlasherDefaultScalarRules[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.719935170701329*^9, 3.719935184876254*^9}, {
  3.911862529592475*^9, 3.9118625361598787`*^9}, {3.911863347124024*^9, 
  3.91186334829424*^9}},ExpressionUUID->"7cd8ef7e-e162-443a-b66e-\
b3639369984d"],

Cell[TextData[{
 "FlasherDefaultScalarRules[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dr",
  FontSlant->"Italic"],
 "] returns a list of rules for all of the scalar variables that are used in \
a flasher with the given parameters."
}], "Text",
 CellChangeTimes->{{3.719935202222096*^9, 3.71993520817212*^9}, {
  3.719935243956584*^9, 3.719935290268512*^9}, {3.71993542008514*^9, 
  3.719935439796548*^9}},ExpressionUUID->"efc425ba-b43c-4887-9fd6-\
d0f766c796c1"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}], TraditionalForm]],ExpressionUUID->
  "9540c43c-f175-426f-b5d1-ceafa3b4c7c2"],
 " of symbols to use for vector and scalar variables.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the ring number.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order.\n\tdr \[LongDash] the radial increment."
}], "Text",
 CellChangeTimes->{{3.913543697760539*^9, 3.913543745801195*^9}, {
  3.913543776446087*^9, 3.9135437769189243`*^9}, {3.913543826194417*^9, 
  3.913543869643005*^9}, {3.913543961333653*^9, 3.913543989591729*^9}, {
  3.913544290267782*^9, 3.913544295261955*^9}, {3.913544326654612*^9, 
  3.9135443303627977`*^9}},ExpressionUUID->"5960560f-6704-44f6-bc0c-\
a5434b59d9c8"],

Cell["\<\
Returns: a list of rules for all of the scalar variables for the default \
configuration.\
\>", "Text",
 CellChangeTimes->{{3.913544334323271*^9, 
  3.9135443604913487`*^9}},ExpressionUUID->"386bd76e-c360-45bd-80e6-\
3f1726057e16"],

Cell["\<\
Note that while FlasherDefaultCPRules and FlasherDefaultFFRules produced \
rules that were parameterized on their indices, this returns individual rules \
for each possible subscripted scalar variable.\
\>", "Text",
 CellChangeTimes->{{3.71993549939715*^9, 3.719935542796419*^9}, {
  3.719935613405527*^9, 3.719935627444182*^9}, {3.719936124791119*^9, 
  3.719936134069389*^9}, {3.719945382792726*^9, 
  3.719945391567214*^9}},ExpressionUUID->"48ff6826-a951-49dd-bf67-\
c83028297751"],

Cell["\<\
We can (and do) use FlasherDefaultScalarRules for both flat and paraboloidal \
flashers.\
\>", "Text",
 CellChangeTimes->{{3.825675733917015*^9, 
  3.8256757480290837`*^9}},ExpressionUUID->"53be2c61-a863-46ab-bcca-\
48e7063380a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherDefaultScalarRules", "[", 
   RowBox[{"vars_", ",", "r_", ",", "h_", ",", "m_", ",", "dr_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "cprules", ",", "ffrules", ",", "fsv", ",", "svars", ",", 
      "vals"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cprules", "=", 
      RowBox[{"FlasherDefaultCPRules", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ffrules", "=", 
      RowBox[{"FlasherDefaultFFRules", "[", 
       RowBox[{"pp", ",", "h", ",", "m", ",", "dr"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fsv", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"FlasherFirstSectorVertices", "[", 
         RowBox[{
          StyleBox["p",
           FontSlant->"Italic"], ",", 
          StyleBox["r",
           FontSlant->"Italic"], ",", 
          StyleBox["h",
           FontSlant->"Italic"]}], "]"}], ",", 
        RowBox[{"FlasherFirstSectorVertices", "[", 
         RowBox[{
          StyleBox["pp",
           FontSlant->"Italic"], ",", 
          StyleBox["r",
           FontSlant->"Italic"], ",", 
          StyleBox["h",
           FontSlant->"Italic"]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"svars", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"FlasherScalarize", "[", 
        RowBox[{"vars", ",", "fsv", ",", "m"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vals", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"fsv", "/.", 
        RowBox[{"Join", "[", 
         RowBox[{"cprules", ",", "ffrules"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{"Rule", ",", 
       RowBox[{"{", 
        RowBox[{"svars", ",", "vals"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.719935298728257*^9, 3.7199353847965813`*^9}, {
   3.7199355798780613`*^9, 3.719935602795931*^9}, {3.7199361244568863`*^9, 
   3.719936134077149*^9}, {3.91186131656345*^9, 3.911861330196762*^9}, {
   3.911862407218554*^9, 3.911862448312016*^9}, {3.911862560730206*^9, 
   3.911862629844009*^9}, {3.9118627205759478`*^9, 3.911862725673154*^9}, {
   3.9118628444391527`*^9, 3.9118628564500237`*^9}, {3.911863016240614*^9, 
