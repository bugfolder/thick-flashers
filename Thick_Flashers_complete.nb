Cell["\<\
TObj class: TVertex3D
\tInherits from: TVertex\
\>", "Subsubsection",
 CellChangeTimes->{{3.592465708387096*^9, 3.592465709910206*^9}, 
   3.592465846156721*^9, 3.5924659022953157`*^9, 3.592655418954087*^9, 
