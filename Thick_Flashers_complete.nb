Cell["Convenience classes only have Make constructors.", "Text",
 CellChangeTimes->{{3.592854477521141*^9, 
  3.592854496744073*^9}},ExpressionUUID->"f3af2963-4a23-4f7b-94a7-\
5e3f4e2d1379"],

Cell[TextData[{
 "MakeTGraphAssigned",
 "[",
 StyleBox["verts, edges, faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] takes a TGraph and returns an TGraphAssigned with EdgeTypes given by ",
 StyleBox["types",
  FontSlant->"Italic"],
 ". If no types are given, U is assumed."
}], "Text",
 CellChangeTimes->{{3.592422276207472*^9, 3.592422281420859*^9}, {
   3.592422323898386*^9, 3.592422352423834*^9}, {3.592422473536278*^9, 
   3.59242247445608*^9}, {3.592422537604371*^9, 3.5924225471314387`*^9}, 
   3.592435861291727*^9, 3.592661138819635*^9, {3.592828885304256*^9, 
   3.592828885397999*^9}, {3.592854550364366*^9, 3.59285455781973*^9}, 
   3.594734516325542*^9, 
   3.594734556223425*^9},ExpressionUUID->"2644b2be-30ce-47eb-b0f7-\
6ae590873c6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTGraphAssigned", "[", 
   RowBox[{"verts_List", ",", " ", "edges_List", ",", 
    RowBox[{"faces_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", 
    RowBox[{"types_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"MakeTGraph", "[", 
     RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], "//", 
    RowBox[{"AddTAssigned", "[", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"types", "===", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"U", ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "edges", "]"}], "}"}]}], "]"}], ",", 
       "types"}], "]"}], "]"}]}], "//", 
   RowBox[{"AddClass", "[", "TGraphAssigned", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.592422204741423*^9, 3.592422310014381*^9}, {
   3.592422469747477*^9, 3.592422478106968*^9}, {3.592422533007135*^9, 
