Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TileEdgeArrowStyle", "::", "usage"}], 
   "=", "\"\<TileEdgeArrowStyle is an option to RenderTile[{PolygonTile, \
verts}, Tiling, opts] that specifies the arrowhead style to use on the edges \
of the tile.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627584145475473*^9, 3.627584252839938*^9}, 
   3.629823107191671*^9, {3.629823260617198*^9, 3.629823260839156*^9}},
