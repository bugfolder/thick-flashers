       RowBox[{"verts", ",", "edges", ",", 
        RowBox[{"{", "}"}], ",", "verts3d"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReassignGraph3D", "[", 
      RowBox[{"tobj", ",", "opts"}], "]"}]}]}], "]"}]}]], "Input",
