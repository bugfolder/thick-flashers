Cell[CellGroupData[{

Cell[TextData[{
 "MakeRadialPotWedge[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Rho], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TypeMinimumAngle, PotGapHalfAngle, PotFlatFlangeInset, \
PotBorder, Options[PolygonalEllipse2D]\n\t(properties) PotWedgeJoinVertices"
}], "Subsubsection",
 CellChangeTimes->{{3.5945835896833367`*^9, 3.594583608921858*^9}, {
   3.594584701789599*^9, 3.59458470205983*^9}, {3.594584772487775*^9, 
   3.594584773910712*^9}, {3.594664910992372*^9, 3.594664933686892*^9}, {
   3.594665079236754*^9, 3.594665082932379*^9}, 3.594678621668268*^9, {
   3.617903675942418*^9, 3.6179036982005877`*^9}, {3.650047579405183*^9, 
   3.65004758325141*^9}, 3.650047613280377*^9, {3.6500476627018557`*^9, 
   3.650047663125891*^9}, {3.650054143595581*^9, 3.650054165610414*^9}, {
   3.650064622973939*^9, 3.650064625685636*^9}, {3.650071736736527*^9, 
   3.65007173721875*^9}, {3.650110753646872*^9, 3.65011076338856*^9}, {
   3.650111560738832*^9, 3.650111562204171*^9}, 3.6502093570543756`*^9, {
   3.650288711294894*^9, 3.6502887430951357`*^9}, {3.650288785205056*^9, 
   3.650288785908465*^9}, {3.650288884022068*^9, 3.650288887277945*^9}, {
   3.65030302687268*^9, 3.6503030354027853`*^9}, {3.650303074348377*^9, 
   3.650303075151991*^9}},ExpressionUUID->"5f91a4c4-28c7-4424-8fbc-\
015498f9871a"],

Cell[TextData[{
 "MakeRadialPotWedge[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", \[Rho], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " defining a cross-section of a rotational pot with ",
 StyleBox["m",
  FontSlant->"Italic"],
 "-fold rotational symmetry and asymmetry factor \[Rho] and returns a \
TGraph3D+TAssigned describing a single wedge of the pot, both crease pattern \
and folded form. The first point of ",
 StyleBox["pts",
  FontSlant->"Italic"],
 " should be {0,0}, but if it isn\[CloseCurlyQuote]t, we\[CloseCurlyQuote]ll \
translate the cross section to the origin. The asymmetry factor ",
 StyleBox["\[Rho] ",
  FontSlant->"Italic"],
 "\[Element] [\[Dash]1, 1] has this effect: for ",
 StyleBox["\[Rho] ",
  FontSlant->"Italic"],
 "\[Rule] +1, the flanges are flat and point CCW (viewed from the top); for \
\[Dash]1, they point CW; and for ",
 StyleBox["\[Rho] ",
  FontSlant->"Italic"],
 "\[Rule]  0, the flanges are solid and symmetric (Mosely condition). \
Intermediate values give asymmetric solid flanges. Options are:\n\t\
TypeMinimumAngle \[Rule] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "min"], TraditionalForm]],ExpressionUUID->
  "75ce689d-31e9-41d3-9b80-303ba99a62b7"],
 ", specifies the minimum fold angle that is assigned M or V. This is useful \
when we have very shallow angles going up the gores. This options is passed \
through to FoldAngleToType.\n\tPotGapHalfAngle \[Rule] \[Delta], specifies \
the half-angle of the gap between the seams along the inner edges of the pot. \
Note that if the gap angle is nonzero, there may not be a solution for \
asymmetric \[Rho]. In particular, for flat-bottomed cases, there is no \
solution except for \[Rho] \[Rule] 0.\n\tPotFlatFlangeInset \[Rule] \
\[Epsilon], specifies a fractional inset toward the z-axis to be applied to \
the vertices on the inside of a flat flange version (\[Rho] = -1 or 1). This \
makes the renderer happy when rendering the 3D version, because it avoids \
coplanar facets.\n\tPotBorder \[Rule] PotPlanar | PotPolygon | PotCircular, \
specifies the crease pattern polygon shape. PotPlanar puts the boundary into \
a single plane in the folded form. PotPolygon makes the polygon a regular \
m-gon. PotCircular makes it a segment of a circle. \n\t\
Options[PolygonalEllipse2D] are passed through to PolygonalEllipse2D and are \
used to specify the border quantization."
}], "Text",
 CellChangeTimes->{{3.594583620914513*^9, 3.594583712451603*^9}, {
   3.5945841191157427`*^9, 3.594584144471924*^9}, 3.594584713429246*^9, {
   3.594584779079007*^9, 3.594584810893369*^9}, {3.594585161806385*^9, 
   3.5945851903196163`*^9}, {3.594585321292512*^9, 3.5945853642580023`*^9}, {
   3.594585446884306*^9, 3.594585461394816*^9}, {3.594593332557025*^9, 
   3.594593343847333*^9}, 3.594598806391003*^9, {3.594652881856471*^9, 
   3.594652976312571*^9}, {3.594665041393795*^9, 3.5946650759317827`*^9}, {
   3.594678531075056*^9, 3.594678619564049*^9}, {3.615302088365167*^9, 
   3.615302091676679*^9}, {3.650034408267655*^9, 3.650034415496528*^9}, {
   3.650034506418766*^9, 3.650034541984724*^9}, {3.650034589197397*^9, 
   3.650034597589144*^9}, {3.650034644937892*^9, 3.650034648322154*^9}, {
   3.650035594335135*^9, 3.650035596613913*^9}, {3.650035676632546*^9, 
   3.650035684055887*^9}, {3.65003574449161*^9, 3.650035744915497*^9}, {
   3.6500476142283077`*^9, 3.650047673670881*^9}, {3.650052431521241*^9, 
   3.650052483598957*^9}, {3.650053858360255*^9, 3.650053889820717*^9}, {
   3.650053928267414*^9, 3.650053967479802*^9}, {3.6500646352691517`*^9, 
   3.65006470686545*^9}, {3.650110770988643*^9, 3.650110912125697*^9}, {
   3.650288751919765*^9, 3.650288951987486*^9}, {3.650303038347497*^9, 
   3.650303111807828*^9}, {3.651445152257967*^9, 
   3.651445156135133*^9}},ExpressionUUID->"de94069f-85ac-4d4e-ae5a-\
08f9b723fd4f"],

Cell[TextData[{
 "The cross-sectional points must be strictly monotonic in ",
 StyleBox["z",
  FontSlant->"Italic"],
 " (either increasing or decreasing), with the possible exception that the \
first two can be equal."
}], "Text",
 CellChangeTimes->{{3.650053521157255*^9, 3.6500535488415756`*^9}, {
  3.686679639000307*^9, 
  3.686679647543332*^9}},ExpressionUUID->"18abd331-c5c4-4b60-8d8b-\
5dfe2c345c06"],

Cell[TextData[{
 "We add an extra property to the TObj: PotWedgeJoinVertices\[Rule]{",
 StyleBox["vlist1, vlist2",
  FontSlant->"Italic"],
 "}, which gives the indices of the vertices along the two edges, starting \
from the shared middle vertex. These are useful when assembling multiple \
wedges (or rectangles) into a single structure."
}], "Text",
 CellChangeTimes->{{3.6500357751878843`*^9, 3.650035861931844*^9}, 
   3.650054174884356*^9, {3.6500717483654757`*^9, 3.650071786831525*^9}, {
   3.650112246406307*^9, 
   3.6501122520862637`*^9}},ExpressionUUID->"19e9b2b3-bf9f-40a6-a782-\
c738ff4f844f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PotWedgeJoinVertices", "::", "usage"}], 
   "=", "\"\<PotWedgeJoinVertices is a property of the TObj returned from \
MakeRadialPotWedge that gives the indices of the along the two straight sides \
of the wedge.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.650054156626045*^9, 3.650054218160591*^9}, {
  3.650071833117903*^9, 3.65007184767705*^9}},
 CellLabel->
  "In[3457]:=",ExpressionUUID->"d625eb17-47e5-4250-80ae-7bd467fcbcac"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PotGapHalfAngle", "::", "usage"}], 
   "=", "\"\<PotGapHalfAngle is an option to MakeRadialPotWedge that \
specifies the half-angle of the gap between the inner edges of the \
pot.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.594585402838142*^9, 3.594585476107685*^9}, 
   3.650052236920723*^9},
 CellLabel->
  "In[3458]:=",ExpressionUUID->"215bb552-9a4b-4924-816e-89b36373adf7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PotFlatFlangeInset", "::", "usage"}], 
   "=", "\"\<PotFlatFlangeInset is an option to MakeRadialPotWedge that \
specifies a small inset to apply to vertices in the folded form to spread the \
layers of the flange.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.650110923304439*^9, 3.650110948657275*^9}, {
  3.6501109802454643`*^9, 3.650111003461528*^9}},
