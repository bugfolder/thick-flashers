Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherDefaultFFRules[",
 StyleBox["pp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.719856920600662*^9, 3.719856924329483*^9}, 
   3.719936134162424*^9, {3.911846894416492*^9, 3.911846899853397*^9}, {
   3.91184700867723*^9, 
   3.911847014049465*^9}},ExpressionUUID->"b12482f5-cee7-46db-84da-\
9ab0e8e0528f"],

Cell[TextData[{
 "ThickFlasherDefaultFFRules[",
 StyleBox["pp, r, h, m, t",
  FontSlant->"Italic"],
 "] returns a set of rules giving 3-dimensional coordinates for the points of \
the folded form."
}], "Text",
 CellChangeTimes->{{3.555765854618403*^9, 3.555765904317943*^9}, {
   3.555765942659822*^9, 3.555765949659213*^9}, {3.5557663958455553`*^9, 
   3.555766412827883*^9}, {3.5557667541835623`*^9, 3.555766759374092*^9}, {
   3.555766796723678*^9, 3.555766811530325*^9}, {3.5557673005706997`*^9, 
   3.555767300977767*^9}, {3.555854313152871*^9, 3.555854313273855*^9}, 
   3.71985689693543*^9, {3.719856928873528*^9, 3.719856934344864*^9}, 
   3.719936134260705*^9, {3.911846907508112*^9, 3.911846917039384*^9}, {
   3.911847018760962*^9, 
   3.911847068951652*^9}},ExpressionUUID->"123b17bc-1b19-432e-90c9-\
bc81dc55683e"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["pp",
  FontSlant->"Italic"],
 " \[LongDash] the symbol to use for 3D points. It will be subscripted, e.g., \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["pp",
     FontSlant->"Italic"], 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "4fd9e6f0-73a4-4092-9e7a-8af65eca87db"],
 ".\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the ring number.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the desired panel thickness."
}], "Text",
 CellChangeTimes->{{3.91184714662784*^9, 3.911847194639298*^9}, {
  3.911849881140212*^9, 
  3.911849883892754*^9}},ExpressionUUID->"6cb0b8c8-79d7-49cd-bbe3-\
b4501fcaa0d2"],

Cell[TextData[{
 "This is an idealized structure, and in general will not be isometric to a \
flat crease pattern, nor will it have panels of uniform thickness of ",
 StyleBox["t",
  FontSlant->"Italic"],
 ". But we\[CloseCurlyQuote]ll use it as a starting point when we solve for \
the crease pattern."
}], "Text",
 CellChangeTimes->{
  3.911847051915813*^9, {3.9118472019580803`*^9, 
   3.911847229249056*^9}},ExpressionUUID->"cc59e2e0-08df-4b66-a171-\
7b40cf8f0fd7"],

Cell["See FlasherDefaultFFRules, on which this is modeled.", "Text",
 CellChangeTimes->{{3.911847369917751*^9, 
  3.911847384490277*^9}},ExpressionUUID->"17f68c07-e184-47e8-a8e6-\
41378c867594"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherDefaultFFRules", "[", 
   RowBox[{"pp_", ",", "r_", ",", "h_", ",", "m_", ",", 
    RowBox[{"t_", ":", "0.1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rules", ",", "q", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "this", " ", "gives", " ", "the", " ", "desired", " ", "x", " ", "and", " ",
       "y", " ", "coordinates"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rules", "=", 
      RowBox[{"ThickFlasherDefaultFFProjectionRules", "[", 
       RowBox[{"pp", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"add", " ", "the", " ", "z"}], "-", 
       RowBox[{"height", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rules", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["pp", 
           RowBox[{"i_", ",", "j_", ",", "k_"}]], "->", "q_"}], ")"}], ":>", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["pp", 
           RowBox[{"i", ",", "j", ",", "k"}]], "->", 
          RowBox[{"Append", "[", 
           RowBox[{"q", ",", " ", 
            RowBox[{
             RowBox[{"FlasherFFPointDiscreteHeight", "[", 
              RowBox[{"i", ",", "j", ",", "h"}], "]"}], 
             RowBox[{"Tan", "[", 
              FractionBox["\[Pi]", "m"], "]"}]}]}], "]"}]}], ")"}]}], 
       "}"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.555765796889297*^9, 3.5557658148851*^9}, {
   3.55576593656566*^9, 3.555765937269701*^9}, {3.555765980759676*^9, 
   3.555765998532903*^9}, 3.55576610831581*^9, {3.555766224314859*^9, 
   3.555766241929373*^9}, {3.555766281377778*^9, 3.555766290518588*^9}, {
   3.555766325398485*^9, 3.555766374931508*^9}, 3.555766519493807*^9, 
   3.555766556615101*^9, 3.55576659184709*^9, 3.555766625476776*^9, 
   3.555766665562224*^9, {3.555766764106739*^9, 3.555766765817194*^9}, {
