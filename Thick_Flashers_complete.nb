Cell[CellGroupData[{

Cell[TextData[{
 "RotateGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", \[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph3D"
}], "Subsubsection",
 CellChangeTimes->{{3.64311473068294*^9, 3.643114738403314*^9}, {
   3.643114781813347*^9, 3.643114786517091*^9}, 3.643114912736187*^9, {
