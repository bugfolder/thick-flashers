Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.7993427706482053`*^9, 
  3.799342771240275*^9}},ExpressionUUID->"3ddfd9dd-257d-4bb0-9929-\
8d3de8ae66f5"],

Cell["\<\
When we get into developable surfaces, we will have many situations where we \
need to construct a curve and the surrounding surface from its Darboux frame \
coefficients. These two functions are utility routines that are used for that \
purpose. It turns out to be a bit more convenient to supply the curvatures as \
products of curvature and curve speed, because those are invariants on cross \
curves, and so make it easy to construct Darboux frames even when the curve \
is a cone point or EOR.\
\>", "Text",
 CellChangeTimes->{{3.799342773831954*^9, 
  3.799342990458372*^9}},ExpressionUUID->"e9598c61-9b24-4cb5-be04-\
81f4f06cbdad"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "RecoverDarboux3D[{ds, ",
 StyleBox["sd\[Kappa]g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sd\[Kappa]n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sd\[Tau]g",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lli",
  FontSlant->"Italic"],
 ", ",
 StyleBox["uui",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{{3.799339721105556*^9, 3.7993397299938393`*^9}, {
   3.799339766921196*^9, 3.799339799410465*^9}, {3.7993398612113676`*^9, 
   3.7993398622828097`*^9}, {3.799339920843135*^9, 3.799339934435335*^9}, {
   3.7993399688763256`*^9, 3.799339970027488*^9}, {3.799340085302066*^9, 
   3.799340111908122*^9}, 3.7993403603667717`*^9, {3.79934048732714*^9, 
   3.799340488670842*^9}, {3.799353510202591*^9, 3.799353524288464*^9}, 
   3.799353570363385*^9, 3.799353847817906*^9, 3.799353912617774*^9, 
   3.799364002458001*^9, 3.799364047853194*^9, {3.7994107038595257`*^9, 
   3.799410704514854*^9}, 3.799834733126244*^9, 3.800224150208329*^9, 
   3.8004668155055237`*^9, 3.800466866870408*^9, 
   3.801317329204505*^9},ExpressionUUID->"4fcdf2ee-f761-4b50-9a1d-\
9ded6378975e"],

Cell[TextData[{
 "RecoverDarboux3D[{ds, ",
 StyleBox["sd\[Kappa]g",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sd\[Kappa]n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["sd\[Tau]g",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cci",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tti",
  FontSlant->"Italic"],
 ", ",
 StyleBox["lli",
  FontSlant->"Italic"],
 ", ",
 StyleBox["uui",
  FontSlant->"Italic"],
 "}] constructs the curve and Darboux frame for a specified set of \
speed-curvature products and initial values."
}], "Text",
 CellChangeTimes->{{3.7993398176843786`*^9, 3.799339876803041*^9}, {
   3.799339914115159*^9, 3.799339941764666*^9}, {3.7993404924872627`*^9, 
   3.799340492975128*^9}, {3.799340907659059*^9, 3.7993409353860807`*^9}, {
   3.799353510214315*^9, 3.7993535243016376`*^9}, 3.79935357127562*^9, 
   3.799353913448593*^9, 3.799364002473788*^9, 3.7993640478697987`*^9, {
   3.799399886511636*^9, 3.7993999064060802`*^9}, 3.799834733164136*^9, 
   3.8002241502314*^9, 3.800466815537391*^9, 3.800466866889805*^9, 
   3.801317329253696*^9},ExpressionUUID->"d0cca993-1c68-4321-971f-\
073eab65647d"],

Cell[TextData[{
 "Arguments:\n\tds \[LongDash] a pure function giving the curve speed.\n\t",
 StyleBox["sd\[Kappa]g",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the product of the curve speed and \
geodesic curvature.\n\t",
 StyleBox["sd\[Kappa]n",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the product of the curve speed and \
normal curvature.\n\t",
 StyleBox["sd\[Tau]g",
  FontSlant->"Italic"],
 " \[LongDash] a pure function giving the product of the curve speed and \
geodesic torsion.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the curve parameter.\n\t",
 StyleBox["cci",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the curve position.\n\t",
 StyleBox["tti",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the tangent vector.\n\t",
 StyleBox["lli",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the tangent normal vector.\n\t",
 StyleBox["uui",
  FontSlant->"Italic"],
 " \[LongDash] initial value of the surface normal vector."
}], "Text",
 CellChangeTimes->{{3.799339977563547*^9, 3.799340073083741*^9}, 
   3.799340369941988*^9, {3.799340496927218*^9, 3.799340508559649*^9}, {
   3.799353510225627*^9, 3.799353524314043*^9}, 3.7993535720282907`*^9, 
   3.799353849948184*^9, 3.799353914459751*^9, 
   3.8013173292825603`*^9},ExpressionUUID->"71d070e5-e87c-4b0f-b908-\
1ccb4a00b9c3"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify.\n\t\
Options[DSolve] are passed through."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
   3.6912356648227*^9}, {3.691241735558269*^9, 3.691241736473103*^9}, {
   3.694215733040501*^9, 3.69421576583174*^9}, {3.694217281461211*^9, 
   3.694217296724212*^9}, {3.6942183546369*^9, 3.694218359821371*^9}, {
   3.694218471807096*^9, 3.6942184743823833`*^9}, {3.797958405540965*^9, 
   3.797958426213867*^9}, 3.79857320891115*^9, {3.798576234758256*^9, 
   3.798576244797916*^9}, 
   3.7986245590458803`*^9},ExpressionUUID->"3ff64af8-90e1-4dbd-abc7-\
cab68c365789"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["c",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", ",
 StyleBox["l",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u",
  FontSlant->"Italic"],
 "} of the curve and Darboux frame from the specified coefficients and \
initial conditions, all given as vector-valued functions."
}], "Text",
 CellChangeTimes->{{3.799340075300237*^9, 3.799340076308317*^9}, {
  3.799340149740423*^9, 3.799340189765033*^9}, {3.799340776689471*^9, 
  3.799340783321388*^9}},ExpressionUUID->"207441aa-8504-4a0e-b063-\
5b475195f843"],

Cell["\<\
Note that by providing the speed\[Times]curvature products, we can call this \
for cone points, in which case the Darboux frame will be that of the cross \
curves of the cone.\
\>", "Text",
 CellChangeTimes->{{3.799340192084731*^9, 3.799340263749404*^9}, {
  3.7995006796221313`*^9, 
  3.79950070799841*^9}},ExpressionUUID->"a80e6f65-0546-41d7-81c7-\
0cbc4b28d2f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RecoverDarboux3D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.6720634557909117`*^9, 3.672063470735709*^9}, 
   3.687478751238752*^9, 3.688138426340748*^9, 3.690988494045664*^9, 
   3.691184531857682*^9, 3.691252835831396*^9, {3.691575226485341*^9, 
   3.6915752317232523`*^9}, 3.694218523635254*^9, {3.797960355116918*^9, 
   3.7979603627371616`*^9}, {3.798573222723791*^9, 3.798573226871975*^9}, 
   3.7993325945236893`*^9, 3.799340296912849*^9, 3.79936400247819*^9, 
   3.799364047872965*^9, 3.799834733187733*^9, 3.800224150247704*^9, 
   3.800466815552403*^9, 3.80046686690093*^9},
 CellLabel->
  "In[3805]:=",ExpressionUUID->"70ca9423-43d8-48d7-b698-f96c02b5d867"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RecoverDarboux3D", "::", "nosoln"}], 
   "=", "\"\<DSolve couldn't integrate the Darboux frame equations.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.691170076063277*^9, 3.691170116204011*^9}, 
   3.691183720872117*^9, 3.691252750707734*^9, {3.798576024152359*^9, 
   3.7985760302138777`*^9}, 3.799332595748368*^9, 3.799340298385605*^9, 
   3.799364002479739*^9, 3.799364047873686*^9, 3.799834733194869*^9, 
   3.80022415025439*^9, 3.800466815558644*^9, 3.800466866903941*^9},
 CellLabel->
  "In[3806]:=",ExpressionUUID->"3a1dc601-ac11-44c1-b8cd-302d4ba8b58b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "RecoverDarboux3D", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.799415376038302*^9, 3.7994153855383797`*^9}, 
   3.799834733201262*^9, 3.8002241502601624`*^9, 3.80046681556453*^9, 
   3.800466866906833*^9},
 CellLabel->
  "In[3807]:=",ExpressionUUID->"8c43c6ec-d445-482e-a771-4bc460773989"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RecoverDarboux3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ds_Function", ",", "sd\[Kappa]g_Function", ",", "sd\[Kappa]n_Function", 
      ",", "sd\[Tau]g_Function"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "cci_", ",", "tti_", ",", "lli_", ",", "uui_"}], 
     "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sm", ",", "as", ",", "sfn", ",", "dsopts", ",", "s", ",", 
      "\[IndentingNewLine]", "soln", ",", "ccx", ",", "ccy", ",", "ccz", ",", 
      "ttx", ",", "tty", ",", "ttz", ",", "llx", ",", "lly", ",", "llz", ",", 
      "uux", ",", "uuy", ",", "uuz", ",", "\[IndentingNewLine]", "tt", ",", 
      "ll", ",", "uu", ",", "cc"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sm", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "RecoverDarboux3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", 
        RowBox[{
         RowBox[{"Assumptions", "/.", 
          RowBox[{"{", "opts", "}"}]}], "/.", 
         RowBox[{"Options", "[", "RecoverDarboux3D", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sm", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"sm", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"integrate", " ", "the", " ", "Darboux", " ", "frame"}], ",", 
       " ", 
       RowBox[{
        RowBox[{
        "which", " ", "must", " ", "be", " ", "done", " ", "component"}], "-", 
        RowBox[{"wise", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"DSolve", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"ccx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"ccy", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"ccz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"ds", "[", "s", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ttx", "[", "s", "]"}], ",", 
               RowBox[{"tty", "[", "s", "]"}], ",", 
               RowBox[{"ttz", "[", "s", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"ttx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"tty", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"ttz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              RowBox[{"sd\[Kappa]g", " ", "[", "s", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"llx", "[", "s", "]"}], ",", 
                RowBox[{"lly", "[", "s", "]"}], ",", 
                RowBox[{"llz", "[", "s", "]"}]}], "}"}]}], "+", 
             RowBox[{
              RowBox[{"sd\[Kappa]n", "[", "s", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"uux", "[", "s", "]"}], ",", 
                RowBox[{"uuy", "[", "s", "]"}], ",", 
                RowBox[{"uuz", "[", "s", "]"}]}], "}"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"llx", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"lly", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"llz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"sd\[Kappa]g", "[", "s", "]"}]}], " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ttx", "[", "s", "]"}], ",", 
                RowBox[{"tty", "[", "s", "]"}], ",", 
                RowBox[{"ttz", "[", "s", "]"}]}], "}"}]}], "+", 
             RowBox[{
              RowBox[{"sd\[Tau]g", "[", "s", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"uux", "[", "s", "]"}], ",", 
                RowBox[{"uuy", "[", "s", "]"}], ",", 
                RowBox[{"uuz", "[", "s", "]"}]}], "}"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"uux", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"uuy", "'"}], "[", "s", "]"}], ",", 
              RowBox[{
               RowBox[{"uuz", "'"}], "[", "s", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"sd\[Kappa]n", "[", "s", "]"}]}], " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ttx", "[", "s", "]"}], ",", 
                RowBox[{"tty", "[", "s", "]"}], ",", 
                RowBox[{"ttz", "[", "s", "]"}]}], "}"}]}], "-", 
             RowBox[{
              RowBox[{"sd\[Tau]g", "[", "s", "]"}], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"llx", "[", "s", "]"}], ",", 
                RowBox[{"lly", "[", "s", "]"}], ",", 
                RowBox[{"llz", "[", "s", "]"}]}], "}"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ccx", "[", "ui", "]"}], ",", 
              RowBox[{"ccy", "[", "ui", "]"}], ",", 
              RowBox[{"ccz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "cci"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ttx", "[", "ui", "]"}], ",", 
              RowBox[{"tty", "[", "ui", "]"}], ",", 
              RowBox[{"ttz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "tti"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"llx", "[", "ui", "]"}], ",", 
              RowBox[{"lly", "[", "ui", "]"}], ",", 
              RowBox[{"llz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "lli"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"uux", "[", "ui", "]"}], ",", 
              RowBox[{"uuy", "[", "ui", "]"}], ",", 
              RowBox[{"uuz", "[", "ui", "]"}]}], "}"}], "\[Equal]", "uui"}]}],
           "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "ccx", ",", "ccy", ",", "ccz", ",", "ttx", ",", "tty", ",", "ttz", ",",
            "llx", ",", "lly", ",", "llz", ",", "uux", ",", "uuy", ",", 
           "uuz"}], "}"}], ",", "s", ",", 
         RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "DSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"RecoverDarboux3D", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cc", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ccx", "[", "s", "]"}], ",", 
            RowBox[{"ccy", "[", "s", "]"}], ",", 
            RowBox[{"ccz", "[", "s", "]"}]}], "}"}], "/.", "soln"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tt", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ttx", "[", "s", "]"}], ",", 
            RowBox[{"tty", "[", "s", "]"}], ",", 
            RowBox[{"ttz", "[", "s", "]"}]}], "}"}], "/.", "soln"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ll", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"llx", "[", "s", "]"}], ",", 
            RowBox[{"lly", "[", "s", "]"}], ",", 
            RowBox[{"llz", "[", "s", "]"}]}], "}"}], "/.", "soln"}], "//", 
         "sfn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"uux", "[", "s", "]"}], ",", 
            RowBox[{"uuy", "[", "s", "]"}], ",", 
