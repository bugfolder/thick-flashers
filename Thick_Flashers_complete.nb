   RowBox[{"TilePolyFill", "::", "usage"}], 
   "=", "\"\<TilePolyFill is an option to RenderTile[{PolygonTile, verts}, \
Tiling] that specifies the symbolic fill color to use for the tile.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.627584145475473*^9, 3.627584181140386*^9}, {
  3.629820460257217*^9, 3.629820476630827*^9}, {3.629839184829247*^9, 
