   3.9242517748358*^9},ExpressionUUID->"40b066bf-5d62-445b-b1b0-ccb7f180eec0"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "1"}], ",", 
     RowBox[{"h", "=", "2"}], ",", 
     RowBox[{"m", "=", "5"}], ",", 
     RowBox[{"t", "=", "0.2"}], ",", "tobj", ",", "tobjdp", ",", "panels", ",",
      "panelinfo", ",", "table"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tobj", "=", 
     RowBox[{"MakeThickFlasher", "[", 
      RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", 
       RowBox[{"TypeMinimumAngle", "\[Rule]", 
        RowBox[{"10.", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tobjdp", "=", 
     RowBox[{"tobj", "[", "FlasherDPGraph3D", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
     RowBox[{"MakeThickFlasherPanels", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"FlasherDeployed", "->", "False"}], ",", 
       RowBox[{"FlasherScale", "->", "10"}], ",", 
       RowBox[{"PanelClearance", "->", "0.5"}], ",", 
       RowBox[{"FlasherCentralExtraInset", "->", "1.0"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"panels", ",", "SolidStyle"}], "]"}], ",", 
      RowBox[{"Axes", "->", "True"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
