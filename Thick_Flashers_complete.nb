Cell["\<\
Go from  a sharp fold angle down to nearly zero, then fold the CP into a 3D \
FF. Create the 2D pattern, then fold it into 3D to verify that the 2D fold \
neighborhood was a valid developable surface.\
\>", "Text",
 CellChangeTimes->{{3.799706982048368*^9, 3.799706986558339*^9}, {
  3.799944512551824*^9, 3.799944522614853*^9}, {3.799944629799608*^9, 
  3.7999446738959928`*^9}, {3.799944910314721*^9, 3.799944930521748*^9}, {
  3.79994497174559*^9, 3.7999450024978247`*^9}, {3.799945037554886*^9, 
  3.799945040201951*^9}},ExpressionUUID->"89ec6401-9d8e-4497-9c33-\
bc06a70d1f20"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "ip", ",", "u0", ",", "u1", ",", "f", ",", "rL", ",", "rR", ",",
       "\[Gamma]", ",", "\[Gamma]0", ",", "ui", ",", "\[Gamma]i", ",", "ffi", 
      ",", "tti", ",", "bbti", ",", "ff", ",", "rrL", ",", "rrR", ",", "gc", ",",
       "gf"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ip", "=", "64"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]0", "=", 
      RowBox[{
       RowBox[{"150.", "\[Degree]", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{".9999", 
           RowBox[{"#", "/", "u1"}]}]}], ")"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "\[Gamma]i", ",", "ffi", ",", "tti", ",", "bbti"}], 
       "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"u0", ",", 
        RowBox[{"\[Gamma]0", "[", "u0", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "#", "]"}], ",", 
            RowBox[{"Sin", "[", "#", "]"}]}], "}"}], "&"}], "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rL", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Cos", "[", "#", "]"}]}], ",", 
            RowBox[{"-", 
             RowBox[{"Sin", "[", "#", "]"}]}]}], "}"}], "&"}], "[", "s", 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Gamma]0", "[", "s", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "rL", ",", "rR"}], "}"}], "=", 
      RowBox[{"NFoldAcrossRight2D", "[", 
       RowBox[{"f", ",", "rL", ",", "\[Gamma]", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
      RowBox[{"NFoldCurvedFold3D", "[", 
       RowBox[{"f", ",", "rL", ",", "rR", ",", 
        RowBox[{"{", 
         RowBox[{
         "ui", ",", "\[Gamma]i", ",", "ffi", ",", "tti", ",", "bbti"}], "}"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InterpolationPoints", "\[Rule]", "ip"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CurvedFoldGraphics", "[", 
          RowBox[{"f", ",", "rL", ",", "rR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CurvedFoldGraphics3D", "[", 
          RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799491413473093*^9, 3.799491527975568*^9}, {
