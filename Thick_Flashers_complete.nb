  3.627498791291718*^9}},ExpressionUUID->"e119aedc-938e-4fb8-afcf-\
eeb5f70c7a36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "\[Alpha]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", ".5"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.8", ",", "0.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"TwoCycleCriticalTwistAngleCCW", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "pts", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
          
          RowBox[{
          "pts", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "pts", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], ",", 
          
          RowBox[{
          "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<\[Alpha]/\[Degree] = \>\"", ",", 
       RowBox[{"\[Alpha]", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"TestPleat", "[", 
          RowBox[{"#", ",", "\[Alpha]"}], "]"}], "&"}], "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"pts", ",", 
           RowBox[{"RotateLeft", "[", "pts", "]"}]}], "}"}], "]"}]}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.627498795767407*^9, 3.627498971373961*^9}, {
   3.627499008515687*^9, 3.627499149027169*^9}, {3.627499199000394*^9, 
   3.627499208851523*^9}, {3.627499397530702*^9, 3.627499398385737*^9}, {
   3.627499737245192*^9, 3.627499737614787*^9}, {3.627500035428461*^9, 
   3.627500040196513*^9}, {3.627500084366186*^9, 3.627500131178335*^9}, 
   3.627501207429233*^9, {3.627503131047079*^9, 3.627503187719013*^9}, {
   3.627503519100035*^9, 3.627503525659396*^9}},
 CellLabel->
  "In[2685]:=",ExpressionUUID->"a2e800c7-0da7-4f9a-89ef-a64c5f6814ed"],

Cell[TextData[{
 "TwoCycleCriticalTwistAngleCW[{",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "}] returns the clockwise twist angle (\[Alpha]>\[Pi]/2) at which there is a \
2-cycle overlap between edges {",
 StyleBox["q1a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q1b",
  FontSlant->"Italic"],
 "} and {",
 StyleBox["q2a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2b",
  FontSlant->"Italic"],
 "} of a polygon; the vertices in each pair should (still) be given in CCW \
order."
}], "Text",
 CellChangeTimes->{{3.627497752764758*^9, 3.627497828169616*^9}, {
  3.62749786772199*^9, 3.627497900509591*^9}, {3.627499256686692*^9, 
