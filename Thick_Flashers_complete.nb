ba31c7d71916"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "2"}], ",", 
     RowBox[{"h", "=", "1"}], ",", 
     RowBox[{"m", "=", "4"}], ",", 
     RowBox[{"t", "=", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]]}], ",", "vars", ",", "ifns", ",", "srules"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"FlasherVars", "[", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ifns", "=", 
     RowBox[{"ThickFlasherIsometryFns", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"srules", "=", 
     RowBox[{"FlasherDefaultScalarRules", "[", 
      RowBox[{"vars", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ifns", "/.", "srules"}], "//", "Chop"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
