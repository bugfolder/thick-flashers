Cell["\<\
If two graphs have edges that end up mapping to the same edge in the merged \
graph, there will be only one edge in the merged graph. If you pass the \
option KillMergedEdges \[Rule] True, then such edges will be dropped entirely \
and any orphan vertices\[LongDash]vertices that have lost all their edges\
\[LongDash]will be similarly dropped.\
\>", "Text",
 CellChangeTimes->{{3.7077786377880497`*^9, 3.7077788223109913`*^9}, {
   3.7078224615040507`*^9, 3.707822513689271*^9}, 3.707823803745678*^9, 
   3.707824769539379*^9},ExpressionUUID->"1c3fe1b0-fe2f-4328-a5f0-\
f64d335e2b8f"],

Cell[TextData[{
 "If any edges or vertices are dropped, then their indices in ",
 StyleBox["vlist",
  FontSlant->"Italic"],
 " and ",
 StyleBox["elist",
  FontSlant->"Italic"],
 " will be zero."
}], "Text",
 CellChangeTimes->{{3.707782100325361*^9, 
  3.7077821251817417`*^9}},ExpressionUUID->"583de4d8-c066-4499-a1be-\
67e2c7e0ef26"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KillMergedEdges", "::", "usage"}], 
   "=", "\"\<KillMergedEdges is an option to MergeGraphsData that specifies \
whether to delete any edges that are duplicates between graphs.\>\""}], 
  ";"}]], "Input",
