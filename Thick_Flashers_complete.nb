       "Options", "[", "Degree4Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"srp", "=", 
      RowBox[{
       RowBox[{"ShowRulingPlane", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "Degree4Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"stp", "=", 
