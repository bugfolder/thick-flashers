        RowBox[{"{", 
         RowBox[{"q1", ",", "q2"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeThickness", "->", "0.1"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeWireWidth", "->", "0.2"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeNumWires", "->", "100"}], ",", "\[IndentingNewLine]", 
        RowBox[{"HingeMinWireGap", "->", "0.1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", "polys", "}"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", 
          RowBox[{"polys", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"gc", ",", "SolidStyle"}], "]"}]}], "}"}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.925728267746072*^9, 3.925728289159903*^9}, {
  3.925728352328631*^9, 3.925728369566163*^9}, {3.925728420358809*^9, 
  3.925728468315164*^9}, {3.926594114760414*^9, 3.926594135536838*^9}, {
  3.932822564209261*^9, 3.932822642378517*^9}, {3.9328226759589157`*^9, 
  3.932822677754353*^9}},
 CellLabel->
  "In[4364]:=",ExpressionUUID->"32e3434d-2bd2-45d3-bbf6-3b3c26ecb14c"],

Cell["\<\
Example. A stack of parallelopipeds (with spacers) and joined along the edges \
with varying numbers of wire hinges. (This can be used to make a test \
structure for evaluating hinges\[CloseCurlyQuote] performance with different \
materials and fabrication services.) The spacers are there to connect the \
plates so that the part doesn\[CloseCurlyQuote]t fall apart during \
fabrication. They would be cut away to test.\
\>", "Text",
 CellChangeTimes->{{3.9207400612065153`*^9, 3.920740168361356*^9}, {
  3.920741684487977*^9, 3.920741689007483*^9}, {3.920741734743691*^9, 
  3.92074174550366*^9}, {3.920742011955028*^9, 
  3.920742029063086*^9}},ExpressionUUID->"0519ae17-6a1d-4928-a441-\
8e0b87de9cb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pw", ",", "pt", ",", "pc", ",", "ht", ",", "sw", ",", "nwlist", ",", 
      "plate", ",", "plates", ",", "pwh", ",", "gwh", ",", "hth", ",", "swh", 
      ",", "spacer", ",", "spacers", ",", "z", ",", "wires"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pw", "=", "20"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"plate", " ", "width"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pt", " ", "=", " ", "2"}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"(", 
       RowBox[{"plate", " ", "thickness"}], ")"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"pc", "=", "0.5"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"gap", " ", "width", " ", 
       RowBox[{"(", 
        RowBox[{"clearance", " ", "between", " ", "plates"}], ")"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ht", "=", "0.7"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"hinge", " ", "thickness", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"wire", " ", "size"}], ",", " ", 
         RowBox[{"minimum", " ", "wire", " ", "width"}]}], ")"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sw", "=", "1"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"spacer", " ", "width"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"nwlist", "=", 
      RowBox[{"{", 
       RowBox[{
       "2", ",", "3", ",", "4", ",", "6", ",", "8", ",", "12", ",", "16"}], 
       "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "test", " ", "values", " ", "for", " ", "number", " ", "of", " ", 
       "wires"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"plate", "=", 
      RowBox[{"ExtrudeGC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"pw", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"pw", ",", "pw"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "pw"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "pt"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plates", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"TransformGC", "[", 
         RowBox[{"plate", ",", 
          RowBox[{
           RowBox[{"#", "+", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"k", 
               RowBox[{"(", 
                RowBox[{"pt", "+", "pc"}], ")"}]}]}], "}"}]}], "&"}]}], "]"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{"Length", "[", "nwlist", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pwh", ",", "gwh", ",", "hth", ",", "swh"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pw", ",", "pc", ",", "ht", ",", "sw"}], "}"}], "/", "2"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Put", " ", "spacers", " ", "along", " ", "the", " ", "left", " ", 
       "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"spacer", "=", 
      RowBox[{"ExtrudeGC", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"pwh", "-", "swh"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"sw", ",", 
            RowBox[{"pwh", "-", "swh"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"sw", ",", 
            RowBox[{"pwh", "+", "swh"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"pwh", "+", "swh"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "pc"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"spacers", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"TransformGC", "[", 
         RowBox[{"spacer", ",", 
          RowBox[{
           RowBox[{"#", "+", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"pt", "+", 
               RowBox[{"k", 
                RowBox[{"(", 
                 RowBox[{"pt", "+", "pc"}], ")"}]}]}]}], "}"}]}], "&"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{
           RowBox[{"Length", "[", "nwlist", "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Add", " ", "wires"}], ",", " ", 
       RowBox[{
       "flush", " ", "with", " ", "the", " ", "right", " ", "side"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"wires", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"z", "=", 
          RowBox[{"pt", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"pt", "+", "pc"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"HingeMultiWireGC", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"pw", "-", "hth"}], ",", "hth", ",", "z"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"pw", "-", "hth"}], ",", 
               RowBox[{"pw", "-", "hth"}], ",", "z"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"pw", "-", "hth"}], ",", "0", ",", 
               RowBox[{"z", "+", "pc"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"pw", "-", "hth"}], ",", "pw", ",", 
               RowBox[{"z", "+", "pc"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"HingeThickness", "->", "ht"}], ",", "\[IndentingNewLine]", 
           RowBox[{"HingeNumWires", "->", 
            RowBox[{
            "nwlist", "\[LeftDoubleBracket]", "k", 
             "\[RightDoubleBracket]"}]}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", "nwlist", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"plates", ",", "spacers", ",", "wires"}], "}"}], ",", 
        "SolidStyle"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.920740178567061*^9, 3.920740181136488*^9}, {
   3.920740253391425*^9, 3.920740439575182*^9}, {3.920740521465371*^9, 
   3.920740610769237*^9}, {3.9207406476102247`*^9, 3.920740737204728*^9}, {
   3.920740789514224*^9, 3.9207408160434093`*^9}, {3.920740858077244*^9, 
   3.920741104153347*^9}, {3.920741172678823*^9, 3.920741406640497*^9}, {
   3.920741448665435*^9, 3.920741449272749*^9}, {3.920741487464892*^9, 
   3.920741599291073*^9}, {3.920741714763085*^9, 3.920741717738317*^9}, {
   3.920741883500344*^9, 3.920742001204008*^9}, 3.92074298327396*^9, {
   3.920743022866188*^9, 3.920743024752981*^9}, {3.922630596249135*^9, 
   3.922630596300201*^9}, 3.9257285303950644`*^9, {3.929555997547998*^9, 
   3.929556017797235*^9}, {3.9328226561242123`*^9, 3.9328226646671467`*^9}},
 CellLabel->
  "In[4365]:=",ExpressionUUID->"f51d6fdf-7b06-43fd-ace0-c65540b7b939"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
HingeType
HIngeLengthInset\
\>", "Subsubsection",
 CellChangeTimes->{{3.9208038850537567`*^9, 3.9208038861752357`*^9}, {
  3.9228175679028177`*^9, 
  3.922817570800206*^9}},ExpressionUUID->"0e2d3e0c-8c63-48d2-b60b-\
37b17d5805f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeType", "::", "usage"}], 
   "=", "\"\<HingeType is an option to MakeHingeGC that specifies the type of \
hinge to create.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.920803888335028*^9, 3.92080390959788*^9}},
 CellLabel->
  "In[4366]:=",ExpressionUUID->"192fb3e2-3656-4273-8188-e014ecb0c419"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeType", "::", "badtype"}], 
   "=", "\"\<The hinge type `1` is not a valid option to MakeHingeGC.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.920803921764621*^9, 3.920803942621607*^9}},
 CellLabel->
  "In[4367]:=",ExpressionUUID->"5f2f13ab-2e39-4c62-9ac3-d44a52d04440"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeLengthInset", "::", "usage"}], 
   "=", "\"\<HingeLengthInset is an option to MakeHingeGC that specifies to \
inset the edges of the hinge by a specified distance.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.92281757604664*^9, 3.922817612623414*^9}},
 CellLabel->
  "In[4368]:=",ExpressionUUID->"3732843b-bffd-4403-97e9-ee8d93d5b13c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeHingeGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) HingeThickness, HingeType, HingeLengthInset"
}], "Subsubsection",
 CellChangeTimes->{{3.912251256969394*^9, 3.9122512666522007`*^9}, {
   3.912251352950634*^9, 3.9122513889319487`*^9}, 3.912574879056205*^9, {
   3.915799438537242*^9, 3.91579944355147*^9}, {3.920803763622547*^9, 
   3.920803765253774*^9}, {3.9228174972979918`*^9, 
   3.922817501089446*^9}},ExpressionUUID->"5057c98d-fe07-40d5-81f9-\
63a3c7412fed"],

Cell[TextData[{
 "MakeHingeGC[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a GraphicsComplex polyhedron that implements a hinge between two \
panels in a 3D-printed solid."
}], "Text",
 CellChangeTimes->{{3.912251425801676*^9, 3.912251451015481*^9}, 
   3.912574879080297*^9},ExpressionUUID->"10ec501d-6012-4546-804d-\
b8a96af2eeaf"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} \[LongDash] the two panel polyhedron vertices on one side of the hinge.\n\
\t{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} \[LongDash] the corresponding two panel vertices on the other side of the \
hinge."
}], "Text",
 CellChangeTimes->{{3.9122517761975393`*^9, 
  3.91225182910169*^9}},ExpressionUUID->"87ad5ce2-4646-4813-b2af-\
d500e5613a07"],

Cell[TextData[{
 "Options:\n\tHingeThickness \[Rule] ",
 StyleBox["ht",
  FontSlant->"Italic"],
 ", the thickness of hinges between connected parts.\n\tHingeType \[Rule] ",
 StyleBox["htype",
  FontSlant->"Italic"],
 ", the type of hinge (HingeMultiWireGC or HingePlateGC).\n\tHingeLengthInset \
\[Rule] ",
 "d",
 " | {",
 StyleBox["d1,d2",
  FontSlant->"Italic"],
 "} specifies to inset the ends by distance ",
 StyleBox["d",
  FontSlant->"Italic"],
 " at both ends or the distances ",
 StyleBox["d1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["d2",
  FontSlant->"Italic"],
 ", respectively.\n\tOther options (e.g., HingeNumWires, HingeWireCap, \
HingeWireZ) are passed through to the HingeType function if appropriate."
}], "Text",
 CellChangeTimes->{{3.912251839577525*^9, 3.912251855519747*^9}, {
  3.920803775996526*^9, 3.920803850558083*^9}, {3.922817509728714*^9, 
  3.922817556385465*^9}, {3.922817634927082*^9, 3.9228176439193153`*^9}, {
  3.922817773812907*^9, 3.922817782555589*^9}, {3.925729894090575*^9, 
  3.925729912066245*^9}},ExpressionUUID->"1bdff72b-7782-473c-b423-\
b8cc0617956a"],

Cell["\<\
Returns: a list of one or more GraphicsComplex objects that produce the hinge.\
\>", "Text",
 CellChangeTimes->{{3.9122518642937727`*^9, 3.912251989434338*^9}, {
  3.912574780610379*^9, 3.912574781812535*^9}, {3.922629930818728*^9, 
  3.922629944459084*^9}},ExpressionUUID->"607b75a1-93b2-4292-abae-\
034dbbc74b3d"],

Cell["\<\
The default value of HingeType is HingePlateGC for backward compatibility.\
\>", "Text",
 CellChangeTimes->{{3.920804392172062*^9, 
  3.920804407219165*^9}},ExpressionUUID->"384095cd-aa83-4905-ad45-\
5e2336cbe878"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeHingeGC", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"HingeThickness", "->", "0.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"HingeType", "->", "HingePlateGC"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"HingeLengthInset", "->", "0"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.912252524177183*^9, 3.912252549941126*^9}, 
   3.912574879088312*^9, {3.920803860990467*^9, 3.92080387183803*^9}, {
   3.9228176201983433`*^9, 3.922817625207201*^9}, 3.925729921131427*^9},
 CellLabel->
  "In[4369]:=",ExpressionUUID->"7d934c5e-f6aa-47ad-bf90-c1e857962c64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeHingeGC", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hth", ",", "hty", ",", "hli", ",", "d1", ",", "d2", ",", "fopts", ",", 
      "pr", ",", "p1a", ",", "p2a", ",", "qr", ",", "q1a", ",", "q2a"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"hth", ",", "hty", ",", "hli"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "HingeThickness", ",", "HingeType", ",", "HingeLengthInset"}], "}"}],
         "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeHingeGC", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"d1", ",", "d2"}], "}"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "hli", "]"}], "===", "List"}], ",", "hli", ",", 
        
        RowBox[{"{", 
         RowBox[{"hli", ",", "hli"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ContainsAny", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "HingeMultiWireGC", ",", "HingePlateGC", ",", 
            "HingeRoundedPlateGC"}], "}"}], ",", 
          RowBox[{"{", "hty", "}"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"HingeType", "::", "badtype"}], ",", "hty"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "hty", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pr", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"p2", "-", "p1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qr", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"q2", "-", "q1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hty", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p1", "+", 
          RowBox[{"d1", " ", "pr"}]}], ",", 
         RowBox[{"p2", "-", 
          RowBox[{"d2", " ", "pr"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q1", "+", 
          RowBox[{"d1", " ", "qr"}]}], ",", 
         RowBox[{"q2", "-", 
          RowBox[{"d2", " ", "qr"}]}]}], "}"}], ",", "opts"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.912252430334816*^9, 3.912252515628899*^9}, {
   3.912252774696219*^9, 3.912252777045727*^9}, {3.912252897684097*^9, 
   3.912253032898308*^9}, {3.91225308001872*^9, 3.9122530911053267`*^9}, {
   3.912253262686573*^9, 3.912253671195246*^9}, {3.912253732138275*^9, 
   3.912253799497617*^9}, {3.912253830490199*^9, 3.912254025786859*^9}, {
   3.912254071093295*^9, 3.912254097665154*^9}, {3.912254196475916*^9, 
   3.912254411310158*^9}, {3.912254441933828*^9, 3.912254468665284*^9}, {
   3.912257240973328*^9, 3.912257462808109*^9}, {3.912257534090416*^9, 
   3.9122576456077433`*^9}, {3.912257700612996*^9, 3.912257734544495*^9}, 
   3.9122577870502577`*^9, {3.912257832059066*^9, 3.912257838688777*^9}, 
   3.912257871513892*^9, {3.912346535131441*^9, 3.912346707102042*^9}, {
   3.912346800712818*^9, 3.912346803391701*^9}, {3.912347088379651*^9, 
   3.912347139555116*^9}, {3.912352073530635*^9, 3.912352105472742*^9}, {
   3.912352227861081*^9, 3.912352257661276*^9}, {3.912365169871312*^9, 
   3.912365180497987*^9}, {3.912574879093575*^9, 3.912574879097425*^9}, 
   3.9135408803714952`*^9, {3.920736093113104*^9, 3.920736108149659*^9}, {
   3.920803961228863*^9, 3.920804114568918*^9}, 3.920804156349257*^9, {
   3.920804259719596*^9, 3.920804278991907*^9}, {3.92269665778973*^9, 
   3.9226966584436502`*^9}, {3.9228176607603483`*^9, 3.922817767869751*^9}, {
   3.922817798368718*^9, 3.922817840270654*^9}, {3.925729842313905*^9, 
