Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceOrAppendRule", "[", 
   RowBox[{"list_", ",", 
    RowBox[{"lhs_", "\[Rule]", "rhs_"}]}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"HasRuleQ", "[", 
     RowBox[{"list", ",", "lhs"}], "]"}], ",", 
    RowBox[{"ReplaceRule", "[", 
     RowBox[{"list", ",", 
      RowBox[{"lhs", "\[Rule]", "rhs"}]}], "]"}], ",", 
    RowBox[{"Append", "[", 
     RowBox[{"list", ",", 
      RowBox[{"lhs", "\[Rule]", "rhs"}]}], "]"}]}], "]"}]}]], "Input",
