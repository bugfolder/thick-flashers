Cell[CellGroupData[{

Cell[TextData[{
 "UnfoldGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph3D\n\t(options) StationaryFace, ShowProgress"
}], "Subsubsection",
 CellChangeTimes->{{3.595008717379514*^9, 3.59500876636661*^9}, {
   3.59535838404623*^9, 3.595358386749643*^9}, 
   3.72225078182679*^9},ExpressionUUID->"aac76c3a-d940-4058-aa31-\
b42bfc5b9514"],

Cell[TextData[{
 "UnfoldGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] unfolds a TGraph3D from the Vertices3D embedding in the same way that \
UnfoldGraphic2D unfolded it from the Vertices2D embedding."
}], "Text",
 CellChangeTimes->{{3.591808412614337*^9, 3.5918084452922*^9}, {
  3.592791268204608*^9, 3.592791291462787*^9}, {3.594727481114224*^9, 
  3.594727482681447*^9}, {3.594727526694013*^9, 3.594727527102046*^9}, {
