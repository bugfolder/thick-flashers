Cell[CellGroupData[{

Cell["Higher-order vertex reduction", "Subsection",
 CellChangeTimes->{{3.595009581108137*^9, 3.595009585009417*^9}, {
  3.595009864505385*^9, 
  3.595009868335676*^9}},ExpressionUUID->"c240c2e8-0e24-4d96-9c02-\
4b469b839fcd"],

Cell[CellGroupData[{

Cell[TextData[{
 "LFFReduce[{",
 StyleBox["any",
  FontSlant->"Italic"],
 ", ",
 StyleBox["slist",
  FontSlant->"Italic"],
 "}]\nLFFReduction[",
 StyleBox["slist",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.534591058679002*^9, 3.534591068043029*^9}, {
  3.534591154933436*^9, 3.534591158221133*^9}, {3.5345949791477637`*^9, 
  3.534594982787102*^9}, {3.534600146905291*^9, 
  3.534600150999518*^9}},ExpressionUUID->"6e7053e8-cee4-4e96-a905-\
1a5d8c332d0a"],

Cell[TextData[{
 "LFFReduce[{",
 StyleBox["any",
  FontSlant->"Italic"],
 ", ",
 StyleBox["slist",
  FontSlant->"Italic"],
 "}] takes a list {",
 StyleBox["any",
  FontSlant->"Italic"],
 ", ",
 StyleBox["slist",
  FontSlant->"Italic"],
 "} that describes a general conical vertex and returns the result after \
crimping out a BLB sector. ",
 StyleBox["slist",
  FontSlant->"Italic"],
 " is of the form {{",
 StyleBox["i1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["i2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["a2",
  FontSlant->"Italic"],
 "}, ...}, where ",
 StyleBox["i1",
  FontSlant->"Italic"],
 " is an index or label for crease 1, ",
 StyleBox["a1",
  FontSlant->"Italic"],
 " is the angle between crease 1 and 2, and so forth, CCW around the vertex. \
It returns a new list {{",
 StyleBox["ij",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ik",
  FontSlant->"Italic"],
 "}, {...}} where {",
 StyleBox["ij",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ik",
  FontSlant->"Italic"],
 "} are the labels of the creases that get crimped, and {...} is the \
remaining conical vertex. If we ever encounter a configuration where the \
minimum angle is not unique, we stop reducing. Note that the angles can be in \
any units; for readibility, you can use integer numbers of degrees."
}], "Text",
 CellChangeTimes->{{3.5345910697319527`*^9, 3.534591111520247*^9}, {
  3.534591161677237*^9, 3.534591306307267*^9}, {3.534591346872473*^9, 
  3.534591502470154*^9}, {3.534591685316511*^9, 3.5345917082563066`*^9}, {
  3.534594941208772*^9, 3.534595013113693*^9}, {3.534595047025361*^9, 
  3.534595048455425*^9}, {3.534600981670368*^9, 3.534601018670973*^9}, {
  3.534612016301922*^9, 
  3.534612017665838*^9}},ExpressionUUID->"faa583b4-ea71-40da-8eed-\
6d811b058863"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LFFReduce", "[", 
   RowBox[{"{", 
    RowBox[{"any_List", ",", "slist_List"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "ithis", ",", "iprev", ",", "inext", ",", "slistnew"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "slist", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}]}], "}"}], "]"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"emptied", " ", "out"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "slist", "]"}], "\[Equal]", "2"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "/@", "slist"}], ",", 
          RowBox[{"{", "}"}]}], "}"}], "]"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"final", " ", "reduction"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "slist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ithis", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"iprev", "=", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", "-", "1"}], ",", "n", ",", "1"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"previous", " ", "sector"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"inext", "=", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", "+", "1"}], ",", "n", ",", "1"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"next", " ", "sector"}], " ", "*)"}], "\[IndentingNewLine]", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"slist", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "<", 
            RowBox[{"slist", "\[LeftDoubleBracket]", 
             RowBox[{"iprev", ",", "2"}], "\[RightDoubleBracket]"}]}], "&&", 
           RowBox[{
            RowBox[{"slist", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], "<", 
            RowBox[{"slist", "\[LeftDoubleBracket]", 
             RowBox[{"inext", ",", "2"}], "\[RightDoubleBracket]"}]}]}], ",", 
          
          RowBox[{
           RowBox[{"ithis", "=", "i"}], ";", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "find", " ", "index", " ", "of", " ", "any", " ", "BLB", " ", "angle"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ithis", "\[Equal]", "0"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "}"}], ",", "slist"}], "}"}], "]"}]}], "]"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"no", " ", "BLBA", " ", "found"}], ",", " ", 
       RowBox[{"so", " ", "not", " ", "further", " ", "reducible"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"slistnew", "=", "slist"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "replace", " ", "old", " ", "sector", " ", "with", " ", "a", " ", 
       "sector", " ", "that", " ", "has", " ", "new", " ", "angle"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "slistnew", "\[LeftDoubleBracket]", "iprev", "\[RightDoubleBracket]"}], 
      "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"slist", "\[LeftDoubleBracket]", 
         RowBox[{"iprev", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
        RowBox[{
         RowBox[{"slist", "\[LeftDoubleBracket]", 
          RowBox[{"iprev", ",", "2"}], "\[RightDoubleBracket]"}], "-", 
         RowBox[{"slist", "\[LeftDoubleBracket]", 
          RowBox[{"ithis", ",", "2"}], "\[RightDoubleBracket]"}], "+", 
         RowBox[{"slist", "\[LeftDoubleBracket]", 
          RowBox[{"inext", ",", "2"}], "\[RightDoubleBracket]"}]}]}], "}"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"drop", " ", "the", " ", "other", " ", "two", " ", "sectors"}],
        ",", " ", 
       RowBox[{
       "be", " ", "careful", " ", "of", " ", "index", " ", "order"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"slistnew", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"slistnew", ",", 
          RowBox[{"{", 
           RowBox[{"Max", "[", 
            RowBox[{"ithis", ",", "inext"}], "]"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Min", "[", 
          RowBox[{"ithis", ",", "inext"}], "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"slist", "\[LeftDoubleBracket]", 
          RowBox[{"ithis", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"slist", "\[LeftDoubleBracket]", 
          RowBox[{"inext", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",",
        "slistnew"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.534591534891317*^9, 3.53459156549636*^9}, {
   3.534591735341101*^9, 3.53459174233914*^9}, {3.534592399422653*^9, 
   3.5345925193857603`*^9}, {3.534592578525908*^9, 3.534592593366149*^9}, {
   3.534592640655788*^9, 3.534592653624769*^9}, {3.5345926854622793`*^9, 
   3.534592852125839*^9}, 3.534592918063938*^9, {3.534592957190423*^9, 
   3.534593084566087*^9}, {3.534593124229422*^9, 3.534593126371774*^9}, {
   3.534593162705387*^9, 3.534593383323806*^9}, {3.534593426109311*^9, 
   3.534593485343112*^9}, {3.534593564611168*^9, 3.534593603320399*^9}, {
   3.534593681915189*^9, 3.534593804675549*^9}, {3.534594000399788*^9, 
   3.534594033953001*^9}, 3.534594108196315*^9, {3.534594335012916*^9, 
   3.534594371856793*^9}, {3.53459444055931*^9, 3.534594446496578*^9}, {
   3.53459447864623*^9, 3.53459448967737*^9}, {3.534594519897923*^9, 
   3.53459452036265*^9}, {3.534594550806855*^9, 3.534594575317769*^9}, {
   3.534594742099043*^9, 3.534594793872982*^9}, {3.534594825572506*^9, 
   3.534594859610198*^9}, 3.534601093244197*^9, {3.534601199601355*^9, 
   3.534601207118258*^9}, {3.534601243099547*^9, 3.534601445551537*^9}, {
   3.534601477109663*^9, 3.5346015080056458`*^9}, {3.534601555546262*^9, 
   3.534601652975856*^9}},
 CellLabel->
  "In[2049]:=",ExpressionUUID->"24f855ec-49dc-4e62-b376-cd0b1e7e746d"],

