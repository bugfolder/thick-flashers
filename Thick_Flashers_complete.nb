        "hinge", " ", "corners"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"e1", ",", "e2", ",", "e3", ",", "e4"}], "}"}], "=", 
