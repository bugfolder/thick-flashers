   RowBox[{"AxialEdgeFn", "::", "usage"}], 
   "=", "\"\<AxialEdgeFn is a option to MakeRectangularQuadMesh that returns \
the type to be assigned to the {i,j}\[Theta] axial edge.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.594070558714256*^9, 3.594070608325261*^9}, {
   3.594070922571269*^9, 3.594070929254685*^9}, 3.594985001499547*^9, 
