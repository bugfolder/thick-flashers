Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyCollinearCleanup3DTo", "[", 
   RowBox[{"tobj_TObj", ",", "ccdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vlist", ",", "elist", ",", "verts3d", ",", "nverts3d", ",", "angles", ",",
       "nangles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vlist", ",", "elist"}], "}"}], "=", "ccdata"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "angles"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "FoldAngles"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nverts3d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "vlist"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nangles", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"angles", "\[LeftDoubleBracket]", 
         RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "\[RightDoubleBracket]"}], "&"}], "/@", "elist"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperties", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vertices3D", "\[Rule]", "nverts3d"}], ",", 
         RowBox[{"FoldAngles", "\[Rule]", "nangles"}]}], "}"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.707858605723525*^9, 3.707858624332946*^9}, {
   3.707858712702017*^9, 3.707858751523879*^9}, {3.707858955873466*^9, 
