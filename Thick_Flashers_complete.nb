Cell[CellGroupData[{

Cell[TextData[{
 "ReshapeTandev3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Tau], ",
 StyleBox["\[Psi]",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, uui",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, Options[DSolve]"
}], "Subsubsection",
 CellChangeTimes->{{3.799339150703637*^9, 3.799339158354849*^9}, 
   3.799339219120913*^9, {3.799349124085128*^9, 3.799349124515775*^9}, {
   3.79934936200559*^9, 3.799349362341655*^9}, 3.799352918824149*^9, {
   3.799399002896762*^9, 3.799399004781844*^9}, 3.8004808066392117`*^9, 
   3.800480851957001*^9, 
   3.800550221903395*^9},ExpressionUUID->"f4e71f58-1e47-4bc0-875b-\
a7cfa7be4733"],

Cell[TextData[{
 "ReshapeTandev3D[{",
 StyleBox["b",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", \[Sigma]}, \[Tau], ",
 StyleBox["sv",
  FontSlant->"Italic"],
 ", {",
 StyleBox["ui",
  FontSlant->"Italic"],
 ", ",
 StyleBox["bbi",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ddi, uui",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 3D oriented developable surface specified by an oriented ruled \
parameterization that is a tangent developable with b as the EOR and returns \
a different oriented developable surface with the specified torsion along the \
directrix."
}], "Text",
 CellChangeTimes->{{3.798572847292226*^9, 3.798572899717365*^9}, {
   3.7985731966001863`*^9, 3.798573197766917*^9}, {3.798574876085689*^9, 
   3.798574885212594*^9}, {3.798624528951817*^9, 3.798624530092536*^9}, {
   3.799324637560071*^9, 3.799324655520765*^9}, {3.799332469887213*^9, 
   3.799332506695383*^9}, {3.799335590716183*^9, 3.799335626092291*^9}, 
   3.799344116522127*^9, {3.799349274678602*^9, 3.799349302028771*^9}, {
   3.799399010907204*^9, 3.799399016888403*^9}, 3.800480806661339*^9, 
   3.800480851977316*^9},ExpressionUUID->"b5481598-9cdf-4cfc-a21c-\
ad9d75bc4d04"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["b",
  FontSlant->"Italic"],
 " \[LongDash] the 3D directrix, as a pure function. It should be \
well-behaved.\n\t",
 StyleBox["d",
  FontSlant->"Italic"],
 " \[LongDash] the 3D director, as a pure function. It should be \
well-behaved. It should be the tangent vector of b.\n\t\[Sigma] \[LongDash] \
the orientation, which should be \[PlusMinus]1.\n\t",
 StyleBox["ui",
  FontSlant->"Italic"],
 " \[LongDash] the initial value of the ",
 StyleBox["u",
  FontSlant->"Italic"],
 "-parameter.\n\t\[Tau] \[LongDash] the desired torsion of the new directrix.\
\n\t",
 StyleBox["sv",
  FontSlant->"Italic"],
 " \[LongDash] the sign of the branch we\[CloseCurlyQuote]re on, which should \
be \[PlusMinus]1.\n\t",
 StyleBox["bbi",
  FontSlant->"Italic"],
 " \[LongDash] the initial position of the new directrix.\n\t",
 StyleBox["ddi",
  FontSlant->"Italic"],
 " \[LongDash] the initial director of the new surface.\n\t",
 StyleBox["uui",
  FontSlant->"Italic"],
 " \[LongDash] the initial tangent vector of the new directrix."
}], "Text",
 CellChangeTimes->{{3.798572971597745*^9, 3.798573067343102*^9}, {
  3.799324637570926*^9, 3.799324655529855*^9}, {3.799332511270781*^9, 
  3.799332544247019*^9}, {3.7993355394999647`*^9, 3.7993355691326942`*^9}, {
  3.7993493068368053`*^9, 3.79934935909297*^9}, {3.799349390933577*^9, 
  3.799349411726016*^9}, {3.799349444157976*^9, 3.799349448990164*^9}, {
  3.799399294032528*^9, 
  3.799399295145128*^9}},ExpressionUUID->"13821a01-18cd-45fa-9108-\
85206d3e010e"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify.\n\t\
Options[DSolve] are passed through."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
   3.691235123137779*^9, 3.691235148876122*^9}, {3.691235664219194*^9, 
   3.6912356648227*^9}, {3.691241735558269*^9, 3.691241736473103*^9}, {
   3.694215733040501*^9, 3.69421576583174*^9}, {3.694217281461211*^9, 
