Cell[TextData[{
 "FoldAcrossRightBoth[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ff",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rrL",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a 2D and 3D fold and their left ruling vectors and constructs the \
full 2D and 3D ruled neighborhoods, i.e., it adds the right ruling vectors to \
both."
}], "Text",
 CellChangeTimes->{{3.799443094830909*^9, 3.799443137697144*^9}, {
   3.799497627768349*^9, 3.799497628201466*^9}, 3.799697145086274*^9, 
   3.80046520438072*^9, {3.801174683998821*^9, 3.801174685679512*^9}, {
   3.801647976313027*^9, 3.801648032800234*^9}, 
   3.801654974185556*^9},ExpressionUUID->"0940fbe2-6514-4db2-b27a-\
fd41797c7a85"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["f",
  FontSlant->"Italic"],
 " \[LongDash] the 2D space curve of the fold, as a vector-valued function.\n\
\t",
 StyleBox["rL",
  FontSlant->"Italic"],
 " \[LongDash] the 2D left ruling vector.\n\t",
 StyleBox["ff",
  FontSlant->"Italic"],
 " \[LongDash] the 3D space curve of the fold, as a vector-valued function.\n\
\t",
 StyleBox["rrL",
  FontSlant->"Italic"],
 " \[LongDash] the 3D left ruling vector."
}], "Text",
 CellChangeTimes->{{3.7994432330333567`*^9, 3.799443249729931*^9}, {
  3.799443348093048*^9, 3.799443354431157*^9}, {3.799497608731256*^9, 
