   3.643277394670599*^9},ExpressionUUID->"50e64124-c09d-4f36-af05-\
9bb3cd845a8e"],

Cell[TextData[{
 "MakeTYoshimuraOri[",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}] takes a degree-6 TVertex ",
 StyleBox["vtobj",
  FontSlant->"Italic"],
 " that is the generating vertex of a Yoshimura-ori and fold length ",
 StyleBox["d1",
  FontSlant->"Italic"],
 ", and creates a TYoshimuraOri that represents a Yoshimura-ori with ",
 StyleBox["nh",
  FontSlant->"Italic"],
 " iterations horizontally and ",
 StyleBox["nv",
  FontSlant->"Italic"],
 " iterations vertically. The vertex must satisfy the Yoshimura condition \
(the best way to ensure this is to construct it with MakeYoshimuraVertex)."
}], "Text",
 CellChangeTimes->{{3.442882672893553*^9, 3.4428828116669903`*^9}, {
   3.4429714489772468`*^9, 3.4429714526062803`*^9}, {3.443015737240294*^9, 
