   3.801654974035707*^9},ExpressionUUID->"eec6c138-a665-4434-85c1-\
b99057dbef5a"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["ff",
  FontSlant->"Italic"],
 " \[LongDash] the 3D space curve of the fold, as a vector-valued function.\n\
\t",
 StyleBox["rrL",
  FontSlant->"Italic"],
 " \[LongDash] the left ruling vector."
}], "Text",
 CellChangeTimes->{{3.7994432330333567`*^9, 3.799443249729931*^9}, {
  3.799443348093048*^9, 3.799443354431157*^9}, {3.799497608731256*^9, 
