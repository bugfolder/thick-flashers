           RowBox[{"1", "-", 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]", ",", 
           RowBox[{"\[Pi]", "/", "n"}]}], "}"}]}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", "8"}], ";", "\[IndentingNewLine]", 
     RowBox[{
