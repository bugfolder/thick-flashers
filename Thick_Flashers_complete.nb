   3.631101662070079*^9}},ExpressionUUID->"773b376d-ad91-4831-a988-\
a12fbd05d9c0"],

Cell[TextData[{
 "RenderTile[",
 "{UnitCairoPentagonTile, \[Delta]}",
 ", ",
 StyleBox["decoration",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] renders the tile as a PolygonTile for any decoration."
}], "Text",
 CellChangeTimes->{{3.629848267057731*^9, 3.6298482853062563`*^9}, 
   3.631101611177921*^9},ExpressionUUID->"4664885b-b42e-4e27-886a-\
b1b63dd2a3f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"UnitCairoPentagonTile", ",", "\[Delta]_"}], "}"}], ",", 
    "decoration_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"angles", ",", "verts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"angles", "=", 
      RowBox[{"CairoPentagonAngles", "[", "\[Delta]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"UnitEquilateralPolygonVertices", "[", "angles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RenderTile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"PolygonTile", ",", "verts"}], "}"}], ",", "decoration", ",", 
       "opts"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629848115534779*^9, 3.629848180684334*^9}, {
  3.631101621696281*^9, 3.63110162502711*^9}, {3.631101685488462*^9, 
