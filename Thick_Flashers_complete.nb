Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", "1"}], ",", 
       RowBox[{"h", "=", "2"}], ",", 
       RowBox[{"m", "=", "6"}], ",", 
       RowBox[{"t", "=", "0.15"}], ",", "tobj", ",", "panels", ",", 
       "panelinfo", ",", "joinedpanels"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"tobj", "=", 
       RowBox[{"MakeThickFlasher", "[", 
        RowBox[{"r", ",", "h", ",", "m", ",", "t", ",", "\[IndentingNewLine]", 
         RowBox[{"TypeMinimumAngle", "\[Rule]", 
          RowBox[{"10.", "\[Degree]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
         "FlasherSectorDiagFoldLines", "->", 
          "FlasherSectorDiagFoldLinesY"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
       RowBox[{"MakeThickFlasherPanels", "[", 
        RowBox[{"tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"FlasherScale", "->", "2.0"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PanelClearance", "->", "0.1"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"FlasherDeployed", "->", "True"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panels", ",", "panelinfo"}], "}"}], "=", 
       RowBox[{"ThickFlasherTrimTrianglePanels", "[", 
        RowBox[{
        "panels", ",", "panelinfo", ",", "tobj", ",", "\[IndentingNewLine]", 
         RowBox[{"PanelMinThickness", "->", "0.15"}]}], "]"}]}], ";", 
