Cell[TextData[{
 "StyledRuledPatch[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nStyledRuledPatch[",
 StyleBox["b, d",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\nStyledRuledPatch[{",
 StyleBox["b0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) RulingLineDivisions, RulingLineOffset, RulingLineStyle, \
EndLineStyle, CurveDivisions, FillStyle, SurfaceOrientation"
}], "Subsubsection",
