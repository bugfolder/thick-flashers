Cell[TextData[{
 "FindEdge[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["e",
  FontSlant->"Italic"],
 "] returns the index of edge ",
 StyleBox["e",
  FontSlant->"Italic"],
 " in TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " or Null if it doesn\[CloseCurlyQuote]t exist."
}], "Text",
 CellChangeTimes->{{3.59465848234194*^9, 3.594658505084624*^9}, {
   3.594658693297775*^9, 3.594658693792609*^9}, 3.594658794283935*^9, {
