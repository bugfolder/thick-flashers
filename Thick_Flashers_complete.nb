Cell[BoxData[
 RowBox[{
  RowBox[{"Vertex3DFoldedFormGraphics3D", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["opts___",
     FontSlant->"Italic"]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "srs", ",", "smp", ",", "rsr", ",", "gobj", ",", "fv", ",", "mm", ",", 
      "nn", ",", "oo"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TVertex3D", ",", "Vertex3DFoldedFormGraphics3D"}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"srs", "=", 
      RowBox[{
       RowBox[{"ShowRealSphere", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"smp", "=", 
      RowBox[{
       RowBox[{"ShowMidfoldPlanes", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"rsr", "=", 
      RowBox[{
       RowBox[{"RealSphereRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "Vertex3DFoldedFormGraphics3D", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"gobj", "=", 
      RowBox[{"MakeSphericalVertexGraph3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fv", ",", "mm"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"FoldVectors", ",", "MidfoldVectors"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "mm", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"oo", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"srs", ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Sphere", "[", 
              RowBox[{"oo", ",", "rsr"}], "]"}], ",", 
             RowBox[{"Opacity", "[", "0.1", "]"}]}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"bounding", " ", "sphere"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"smp", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Styled3DUnitDiskFromNormal", "[", 
              RowBox[{"#", ",", 
               RowBox[{"LineStyle", "\[Rule]", "MidfoldLine"}], ",", 
               RowBox[{"FillStyle", "\[Rule]", "MidfoldFill"}]}], "]"}], 
             "&"}], "/@", "mm"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"midarc", " ", "planes"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"FoldedFormGraphics3D", "[", 
           RowBox[{"gobj", ",", "opts"}], "]"}], "\[LeftDoubleBracket]", "1", 
          "\[RightDoubleBracket]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"SphericalAngleLabels", "[", 
          RowBox[{"fv", ",", "opts"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", "oo", "]"}], ",", "Black", ",", 
           RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"central", " ", "point"}], " ", "*)"}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.594806859794633*^9, 3.594806891936749*^9}, {
   3.594808618546472*^9, 3.594808671410746*^9}, {3.5948087186646843`*^9, 
