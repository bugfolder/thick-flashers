           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2"}], "}"}], "]"}], ",", "Green"}], "]"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
           RowBox[{"Darker", "[", "Red", "]"}], ",", 
