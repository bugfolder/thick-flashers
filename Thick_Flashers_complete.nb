Cell["Tiling arrows", "Subsection",
 CellChangeTimes->{{3.6276626266271567`*^9, 3.627662630443314*^9}, {
  3.629838793500136*^9, 
  3.62983879417621*^9}},ExpressionUUID->"d3507381-39ca-4c91-8cb4-\
