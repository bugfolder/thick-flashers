Cell[TextData[{
 "WindingNumber[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["face, p",
  FontSlant->"Italic"],
 "] returns the winding number of a closed cycle ",
 StyleBox["face",
  FontSlant->"Italic"],
 " on the vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " relative to point ",
 StyleBox["p",
  FontSlant->"Italic"],
 ". The winding number is the number of net CCW turns the path makes around \
the point ",
 StyleBox["p",
  FontSlant->"Italic"],
 ". If ",
 StyleBox["p",
  FontSlant->"Italic"],
 " lies outside the path, the result is zero; if the path is a CCW cycle \
around ",
 StyleBox["p",
  FontSlant->"Italic"],
 " the result is +1; if the path is a CW cycle, the result is -1."
}], "Text",
 CellChangeTimes->{{3.458172968047273*^9, 3.458173135412712*^9}, {
  3.458174483002457*^9, 3.458174533351099*^9}, {3.595341765237162*^9, 
  3.595341769275921*^9}},ExpressionUUID->"69411207-f531-436d-9a79-\
4fb75810f8ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"WindingNumber", "[", 
   RowBox[{"verts_List", ",", "face_", ",", "p_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sverts", ",", "angles"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "-", "p"}], "&"}], "/@", 
       RowBox[{
       "verts", "\[LeftDoubleBracket]", "face", "\[RightDoubleBracket]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"RotationAngle", ",", 
        RowBox[{"{", 
         RowBox[{"sverts", ",", 
          RowBox[{"RotateLeft", "[", "sverts", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"Plus", "@@", "angles"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "\[Pi]"}], ")"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.458173140109928*^9, 3.45817320381148*^9}, {
   3.458173335451597*^9, 3.458173428893416*^9}, {3.458173475733054*^9, 
   3.458173481186922*^9}, 3.458173558848613*^9, {3.458173603420863*^9, 
   3.458173674880392*^9}, {3.458173754117224*^9, 3.458173791504199*^9}, {
   3.458174254561452*^9, 3.458174256192562*^9}, {3.458174290422745*^9, 
