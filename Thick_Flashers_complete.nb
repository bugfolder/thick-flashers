Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sectorangles", ",", "nh", ",", "nv", ",", "vtobj", ",", "tobj"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sectorangles", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"60", "\[Degree]"}], ",", 
           RowBox[{"90.", "\[Degree]"}], ",", 
           RowBox[{"30.", "\[Degree]"}], ",", 
           RowBox[{"60.", "\[Degree]"}], ",", 
           RowBox[{"90", "\[Degree]"}], ",", 
           RowBox[{"30.", "\[Degree]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vtobj", "=", 
         RowBox[{"MakeYoshimuraVertex", "[", 
          RowBox[{"sectorangles", ",", 
           RowBox[{"{", 
            RowBox[{"gm2", ",", "gm6"}], "}"}]}], "]"}]}], ";", 
