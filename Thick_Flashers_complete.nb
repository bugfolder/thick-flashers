   3.8020953024667883`*^9},ExpressionUUID->"0930c74b-6bbd-4564-b5ca-\
c4686c625182"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["clist",
  FontSlant->"Italic"],
 " \[LongDash] a list of functions that each give various cross sections \
along the strip.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] bounds on the transverse parameter."
}], "Text",
 CellChangeTimes->{{3.693959045126833*^9, 3.693959094919238*^9}, {
  3.800013997008017*^9, 
  3.800014021416117*^9}},ExpressionUUID->"94f8782e-8d08-499b-93d2-\
bed3cd85ad23"],

Cell[TextData[{
 "Options: \n\tTransverseLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", specifies the line style for the transverse lines.\n\t\
RulingLineDivisions, RulingLineStyle, CurveDivisions, FillStyle, \
SurfaceOrientation, ShadowHeight, ShadowColor \[LongDash] are passed through \
to StyledPatch."
}], "Text",
 CellChangeTimes->{{3.691408903076148*^9, 3.691408957807976*^9}, {
   3.691524021832034*^9, 3.691524030839469*^9}, 3.691524101610699*^9, {
   3.692210974822172*^9, 3.692210986369631*^9}, {3.692298927781845*^9, 
   3.692298934436814*^9}, {3.693959034182026*^9, 3.693959039470063*^9}, {
   3.693959136063233*^9, 3.693959198695504*^9}, {3.693960122114469*^9, 
   3.693960129360162*^9}, 3.694002552240829*^9, 3.6940072830806093`*^9, {
   3.69400789529154*^9, 3.694007935257615*^9}, {3.785593656554399*^9, 
   3.785593659162915*^9}, {3.803404424883678*^9, 3.803404428609763*^9}, 
   3.803404752712391*^9, {3.803458942012042*^9, 3.803458963731369*^9}, 
   3.803905613870768*^9},ExpressionUUID->"511f73e6-0644-4e15-8d80-\
57e13a70a08a"],

Cell["\<\
Ruling lines are drawn on the ruling line boundaries of the patch.\
\>", "Text",
 CellChangeTimes->{{3.689274538585758*^9, 3.689274599240209*^9}, 
   3.691407804963612*^9, {3.692210993850868*^9, 3.692211026316312*^9}, {
   3.693959205183027*^9, 
   3.693959205583222*^9}},ExpressionUUID->"dff35c00-2612-43ca-8d1e-\
49f7dc167fcf"],

Cell[TextData[{
 "TransverseLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " has several forms that ",
 StyleBox["style",
  FontSlant->"Italic"],
 " could take:\n\tNone \[LongDash] don\[CloseCurlyQuote]t put lines on the \
transverse lines.\n\t",
 StyleBox["style",
  FontSlant->"Italic"],
 " \[LongDash] a single named style to use for all transverse lines.\n\t{",
 StyleBox["style}",
  FontSlant->"Italic"],
 " \[LongDash] a single named style to use for all transverse lines.\n\t{{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ...}} \[LongDash] multiple style directives , applying the same style to \
all transverse lines.\n\t{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["style2,...",
  FontSlant->"Italic"],
 "} \[LongDash] styles to apply individually to each transverse line.\nFor \
the last option, there should be Length[",
 StyleBox["clist",
  FontSlant->"Italic"],
 "] entries in the list."
}], "Text",
 CellChangeTimes->{{3.6892712528917646`*^9, 3.689271274680113*^9}, {
   3.689271394390013*^9, 3.689271610338603*^9}, {3.6892720782573147`*^9, 
   3.689272082226816*^9}, 3.691407761312769*^9, {3.691523758891292*^9, 
   3.691523761835228*^9}, {3.6922106981080637`*^9, 3.69221070339203*^9}, {
   3.693959394117618*^9, 3.693959445354251*^9}, {3.693960172274999*^9, 
   3.693960211120989*^9}, {3.6940087829385233`*^9, 3.694008797313612*^9}, {
   3.803404102162725*^9, 3.803404108607775*^9}, {3.8034044362354193`*^9, 
   3.8034044486190042`*^9}},ExpressionUUID->"4df413bc-ddb7-4084-9313-\
e34bfde15de0"],

Cell[TextData[{
 "RulingLineStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 " has several forms that ",
 StyleBox["style",
  FontSlant->"Italic"],
 " could take: \n\tNone \[LongDash] don\[CloseCurlyQuote]t put lines on the \
ruling lines.\n\t",
 StyleBox["style",
  FontSlant->"Italic"],
 " \[LongDash] a single named style to use for all ruling lines.\n\t{{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ...}} \[LongDash] multiple style directives , applying the same style to \
all ruling lines.\n\t{",
 StyleBox["style1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["style2,...",
  FontSlant->"Italic"],
 "} \[LongDash] styles to apply individually to each row of ruling lines, \
where each ",
 StyleBox["style",
  FontSlant->"Italic"],
 " should be a valid format for StyledRuledPath. There should be Length[",
 StyleBox["clist",
  FontSlant->"Italic"],
 "]\[Dash]1 entries in the list."
}], "Text",
 CellChangeTimes->{{3.6892712528917646`*^9, 3.689271274680113*^9}, {
   3.689271394390013*^9, 3.689271610338603*^9}, {3.6892720782573147`*^9, 
   3.689272082226816*^9}, 3.691407761312769*^9, {3.691523758891292*^9, 
   3.691523761835228*^9}, {3.6922106981080637`*^9, 3.69221070339203*^9}, {
   3.693959394117618*^9, 3.693959445354251*^9}, {3.693960172274999*^9, 
   3.693960211120989*^9}, {3.694008604818473*^9, 3.694008620145189*^9}, {
   3.694008812083692*^9, 3.694008816073699*^9}, {3.803461377144081*^9, 
   3.803461429574508*^9}, {3.803461634832372*^9, 
   3.8034616420070972`*^9}},ExpressionUUID->"48d400da-f8bf-4d5a-92c2-\
f5045306bf1e"],

Cell["\<\
Transverse lines are drawn in a separate pass from the ruled patches so that \
in 2D, the cross lines end up on top of the polygons.\
\>", "Text",
 CellChangeTimes->{{3.694001702846406*^9, 3.6940017320137033`*^9}, {
  3.694008825041502*^9, 3.694008833793019*^9}, {3.803404455514331*^9, 
  3.8034044568341293`*^9}},ExpressionUUID->"5b0dd9ff-cabd-4b67-a48a-\
c83c2ff6fe1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledRuledPatchSequence", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"CurveDivisions", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
     RowBox[{"TransverseLineStyle", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"RulingLineStyle", "\[Rule]", "UnfoldedLine"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.672144578451386*^9, 3.672144612838942*^9}, {
   3.672144656636854*^9, 3.67214465909191*^9}, {3.688134072271159*^9, 
