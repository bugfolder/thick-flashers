Cell["Example: standard upward-facing pot", "Text",
 CellChangeTimes->{{3.5267315631638317`*^9, 3.526731563879435*^9}, {
  3.526746566658413*^9, 3.526746584416025*^9}, {3.526747291807027*^9, 
  3.5267472998145113`*^9}},ExpressionUUID->"58d77296-fa80-493c-a58b-\
9f0abaa0efd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeRectMoselyPot", "[", 
       RowBox[{"pts", ",", "8", ",", 
        RowBox[{"FlangeExcess", "\[Rule]", "0.3"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PartitionedGraphicsGrid", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{"tobj", "[", "CrossSection", "]"}], ",", 
            RowBox[{"Axes", "\[Rule]", "True"}], ",", 
            RowBox[{"AxesLabel", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<z\>\""}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "CreasePatternWedge", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "FoldedFormWedge", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "CreasePatternSplitWedge", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "FoldedFormSplitWedge", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "CreasePattern", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj", "[", "FoldedForm2D", "]"}]}], "}"}], ",", "5"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.526746491449523*^9, 3.526746531912607*^9}, 
   3.52674867541768*^9, {3.526749501351357*^9, 3.5267495019604483`*^9}, {
   3.526749665093065*^9, 3.526749688625819*^9}, 3.526749765968527*^9, {
   3.526750072179222*^9, 3.526750099501523*^9}, {3.5268232731660748`*^9, 
   3.5268232733645287`*^9}, {3.526827097486429*^9, 3.526827147085638*^9}, {
   3.533659538902526*^9, 3.53365954916927*^9}, {3.592128644676448*^9, 
   3.592128657023713*^9}, 3.592214217384958*^9, 3.592670440229137*^9, 
