Cell[CellGroupData[{

Cell[TextData[{
 "SurfaceSystem[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Simplification, Assumptions, PrincipalAnalysis"
}], "Subsubsection",
 CellChangeTimes->{{3.7819695255910068`*^9, 3.781969561615369*^9}, {
  3.781975075611746*^9, 
  3.781975084123961*^9}},ExpressionUUID->"7b60c524-efdc-434e-815f-\
50a62fe3df68"],

Cell[TextData[{
 "SurfaceSystem[",
 StyleBox["s",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs the differential geometry functions of a regular surface \
related to the first and second fundamental forms."
}], "Text",
 CellChangeTimes->{{3.668947828478882*^9, 3.668947977055999*^9}, {
   3.668948036710371*^9, 3.668948054819468*^9}, 3.668951330975006*^9, {
   3.668951363372705*^9, 3.668951368076372*^9}, {3.668967538192066*^9, 
   3.668967539384394*^9}, {3.672062016459675*^9, 3.672062021305244*^9}, {
   3.6874777368721123`*^9, 3.687477753780041*^9}, {3.689797563389432*^9, 
   3.689797582585987*^9}, 3.690989404744676*^9, 3.690990056637327*^9, {
   3.69119961229562*^9, 3.691199612971944*^9}, {3.6912009456361217`*^9, 
   3.6912009505507107`*^9}, {3.691240436888981*^9, 3.691240470312284*^9}, 
   3.69125269026622*^9, 3.691505296638789*^9, 3.691505593772298*^9, {
   3.781970257518692*^9, 
   3.781970275140445*^9}},ExpressionUUID->"9b7e8617-0810-4d07-8ed6-\
d74fb177a651"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["s",
  FontSlant->"Italic"],
 " is a pure function that parameterizes the surface."
}], "Text",
 CellChangeTimes->{{3.691240429083367*^9, 3.691240440211678*^9}, {
  3.781970278900316*^9, 
  3.781970287628745*^9}},ExpressionUUID->"d29eedec-7e1c-442f-867f-\
27785773b342"],

Cell[TextData[{
 "Options:\n\tSimplification \[Rule] None | Simplify | FullSimplify, \
specifies the level of simplification of intermediate results.\n\tAssumptions \
\[Rule] ",
 StyleBox["list",
  FontSlant->"Italic"],
 ", assumptions that should be passed to Simplify or FullSimplify.\n\t\
PrincipalAnalysis \[Rule] True | False, whether to compute principal \
directions and curvatures."
}], "Text",
 CellChangeTimes->{{3.691235065551579*^9, 3.691235071734006*^9}, {
  3.691235123137779*^9, 3.691235148876122*^9}, {3.7819751684860077`*^9, 
  3.781975190388832*^9}},ExpressionUUID->"812a2fa1-8f18-4ac7-9490-\
8b93a67ba03a"],

Cell["\<\
Returns: a list of rules giving pure functions for the relevant vector and \
scalar fields of the surface.\
\>", "Text",
 CellChangeTimes->{{3.691240447010771*^9, 3.691240453771187*^9}, {
  3.781970295076473*^9, 
  3.781970296244254*^9}},ExpressionUUID->"95e82af6-c55a-42f2-b4c0-\
f8677f32e428"],

Cell["\<\
The option PrincipalAnalysis is used if EigenSystem is unable to create an \
analytic eigensystem for the curvature matrix or it bogs down due to \
complexity. If you get the error \[OpenCurlyDoubleQuote]Eigensystem: Unable \
to find all eigenvectors,\[CloseCurlyDoubleQuote] you can set \
PrincipalAnalysis to False and do your own Eigensystem analysis from the \
curvature matrix point-by-point.\
\>", "Text",
 CellChangeTimes->{{3.781975195677264*^9, 3.781975270782983*^9}, {
  3.78197630758777*^9, 
  3.78197632684414*^9}},ExpressionUUID->"ac10a980-6252-4fdf-b4a1-\
f15a20453ee9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PrincipalAnalysis", "::", "usage"}], 
   "=", "\"\<PrincipalAnalysis is an option to SurfaceSystem that specifies \
whether to compute the principal directions and curvatures from the curvature \
matrix.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.781975285702765*^9, 3.781975311540203*^9}, {
  3.781975356225241*^9, 3.781975356999611*^9}},
 CellLabel->
  "In[3772]:=",ExpressionUUID->"5d0df16b-547a-4e1f-a4aa-58db069d81ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SurfaceSystem", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PrincipalAnalysis", "\[Rule]", "True"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7819750905254297`*^9, 3.781975099139958*^9}, {
   3.781975154478515*^9, 3.7819751639632473`*^9}, 3.781975282392602*^9, 
   3.781975972966135*^9},
 CellLabel->
  "In[3773]:=",ExpressionUUID->"a378c1f7-7f82-40ef-b3e2-38b8aac29aa1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SurfaceSystem", "[", 
   RowBox[{"ss_Function", ",", "opts___"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "pa", ",", "u", ",", "v", ",", "sfn", ",", "s", ",",
       "su", ",", "sv", ",", "E", ",", "F", ",", "G", ",", "n", ",", "suu", ",",
       "suv", ",", "svv", ",", "L", ",", "M", ",", "N", ",", "K", ",", "H", ",",
       "F1", ",", "F2", ",", "A", ",", "ret", ",", "vals", ",", "vecs", ",", 
      "dirs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SurfaceSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SurfaceSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "\[Element]", "Reals"}], ",", 
           RowBox[{"v", "\[Element]", "Reals"}]}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pa", "=", 
      RowBox[{
       RowBox[{"PrincipalAnalysis", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SurfaceSystem", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"ss", "[", 
       RowBox[{"u", ",", "v"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"first", " ", "fundamental", " ", "form"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"su", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"s", ",", "u"}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sv", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"s", ",", "v"}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"E", "=", 
      RowBox[{
       RowBox[{"su", ".", "su"}], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"F", "=", 
      RowBox[{
       RowBox[{"su", ".", "sv"}], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"G", "=", 
      RowBox[{
       RowBox[{"sv", ".", "sv"}], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"normal", " ", "vector"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"suxsv", "=", 
          RowBox[{
           RowBox[{"su", "\[Cross]", "sv"}], "//", "sfn"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"suxsv", "/", 
          RowBox[{"Mag", "[", "suxsv", "]"}]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"second", " ", "fundamental", " ", "form"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"suu", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"su", ",", "u"}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"suv", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"su", ",", "v"}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"svv", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"sv", ",", "v"}], "]"}], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"L", "=", 
      RowBox[{
       RowBox[{"suu", ".", "n"}], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{
       RowBox[{"suv", ".", "n"}], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"N", "=", 
      RowBox[{
       RowBox[{"svv", ".", "n"}], "//", "sfn"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Gaussian", " ", "curvature"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"K", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"L", " ", "N"}], "-", 
         SuperscriptBox["M", "2"]}], 
        RowBox[{
         RowBox[{"E", " ", "G"}], "-", 
         SuperscriptBox["F", "2"]}]], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Mean", " ", "curvature"}], " ", "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"H", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"E", " ", "N"}], " ", "-", " ", 
         RowBox[{"2", " ", "F", " ", "M"}], "+", 
         RowBox[{"G", " ", "L"}]}], 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"E", " ", "G"}], "-", 
           SuperscriptBox["F", "2"]}], ")"}]}]], "//", "sfn"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"first", " ", "fundamental", " ", "form", " ", "matrix"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"F1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"E", ",", "F"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"F", ",", "G"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"second", " ", "fundamental", " ", "form", " ", "matrix"}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"F2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"L", ",", "M"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"M", ",", "N"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"curvature", " ", "matrix"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Inverse", "[", "F1", "]"}], ".", "F2"}], "//", "sfn"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"basic", " ", "return", " ", "values"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ret", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"SurfaceTangentU", "\[Rule]", " ", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"su", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"SurfaceTangentV", "\[Rule]", " ", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"sv", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"SurfaceNormal", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"n", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FundamentalFormE", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"E", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FundamentalFormF", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"F", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FundamentalFormG", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"G", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FundamentalFormL", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"L", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FundamentalFormM", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"M", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FundamentalFormN", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"N", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GaussianCurvature", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"K", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"MeanCurvature", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"H", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"CurvatureMatrix", "\[Rule]", 
         RowBox[{"FunctionizeOld", "[", 
          RowBox[{"A", ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"pa", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
         RowBox[{
          RowBox[{"Eigensystem", "[", "A", "]"}], "//", "sfn"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dirs", "=", 
         RowBox[{
          RowBox[{"vecs", ".", 
           RowBox[{"{", 
            RowBox[{"su", ",", "sv"}], "}"}]}], "//", "sfn"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vecs", "=", 
         RowBox[{
          RowBox[{"NormalizeReal", "/@", "vecs"}], "//", "sfn"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dirs", "=", 
         RowBox[{
          RowBox[{"NormalizeReal", "/@", "dirs"}], "//", "sfn"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"JoinTo", "[", 
         RowBox[{"ret", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PrincipalCurvatures", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"FunctionizeOld", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"{", 
                   RowBox[{"u", ",", "v"}], "}"}]}], "]"}], "&"}], "/@", 
               "vals"}], ")"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"PrincipalDirectionsUV", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"FunctionizeOld", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"{", 
                   RowBox[{"u", ",", "v"}], "}"}]}], "]"}], "&"}], "/@", 
               "vecs"}], ")"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"PrincipalDirections", "\[Rule]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"FunctionizeOld", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"{", 
                   RowBox[{"u", ",", "v"}], "}"}]}], "]"}], "&"}], "/@", 
               "dirs"}], ")"}]}]}], "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "ret"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.668362892429557*^9, 3.66836289243172*^9}, {
   3.668362959737321*^9, 3.668363023189096*^9}, {3.668363067507318*^9, 
   3.668363142539715*^9}, {3.668363195720037*^9, 3.668363241118969*^9}, {
   3.668363407297552*^9, 3.66836340804661*^9}, {3.66836357247464*^9, 
   3.66836382079399*^9}, {3.6683638947498207`*^9, 3.668363930544681*^9}, {
   3.668363963665206*^9, 3.668364002364565*^9}, {3.668364055467094*^9, 
   3.668364087311292*^9}, {3.668364122300975*^9, 3.668364140443993*^9}, {
   3.668416559622469*^9, 3.668416705779197*^9}, {3.66841674295501*^9, 
