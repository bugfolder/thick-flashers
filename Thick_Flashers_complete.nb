Cell[BoxData[
 RowBox[{
  RowBox[{"NRecoverDarboux3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ds_Function", "|", "ds_InterpolatingFunction"}], ",", 
      RowBox[{
      "sd\[Kappa]g_Function", "|", "sd\[Kappa]g_InterpolatingFunction"}], ",", 
      RowBox[{
      "sd\[Kappa]n_Function", "|", "sd\[Kappa]n_InterpolatingFunction"}], ",", 
      RowBox[{
      "sd\[Tau]g_Function", "|", "sd\[Tau]g_InterpolatingFunction"}]}], "}"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "cci_", ",", "tti_", ",", "lli_", ",", "uui_"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "s", ",", "\[IndentingNewLine]", "soln", ",", "ccx", ",", 
      "ccy", ",", "ccz", ",", "ttx", ",", "tty", ",", "ttz", ",", "llx", ",", 
      "lly", ",", "llz", ",", "uux", ",", "uuy", ",", "uuz", ",", 
      "\[IndentingNewLine]", "tt", ",", "ll", ",", "uu", ",", "cc"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
