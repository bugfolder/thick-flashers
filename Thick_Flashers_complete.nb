        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"InitialPosition3D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
