Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", "qlist"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qlist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], "+", 
         RowBox[{"U", "[", 
          RowBox[{"0", "\[Degree]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], "+", 
         RowBox[{"U", "[", 
          RowBox[{"135", "\[Degree]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], "+", 
         RowBox[{"U", "[", 
          RowBox[{"225", "\[Degree]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], "+", 
         RowBox[{"U", "[", 
          RowBox[{"270", "\[Degree]"}], "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Point", "[", "p", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"p", ",", "#"}], "}"}], "]"}], "&"}], "/@", "qlist"}]}],
          "}"}], ",", 
        RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"UnnormalizedFlatFoldabilityCondition", "[", 
      RowBox[{"p", ",", "qlist"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.617550562816021*^9, 3.617550654777918*^9}, {
