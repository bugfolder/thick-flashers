Cell[TextData[{
 "ApplyCollinearCleanupTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 "]\nApplyCollinearCleanup[",
 StyleBox["ccdata",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.707857944527349*^9, 3.707857966815342*^9}, {
   3.707857997263597*^9, 3.707858005095461*^9}, {3.707858145305837*^9, 
