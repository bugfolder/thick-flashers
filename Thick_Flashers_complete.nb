Cell[CellGroupData[{

Cell["TGraph3D+TAssigned utilities", "Subsection",
 CellChangeTimes->{{3.625666999587645*^9, 
  3.6256670065612097`*^9}},ExpressionUUID->"703bf965-204f-4385-bea4-\
8707c111b28d"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.650050311640555*^9, 
  3.650050312086528*^9}},ExpressionUUID->"29e28f47-9ac1-4791-a799-\
e762283521a9"],

Cell["\<\
If you create a TGraph3D+TAssigned by separately providing FoldAngles (with \
the TGraph3D) and EdgeTypes (with the TAssigned), they can end up \
inconsistent with each other, and possibly inconsistent with the actual \
angles between faces that are returned by RecalcFoldAngles. There is also an \
ambiguity in the values returned by RecalcFoldAngles, in that for parallel \
faces, numerical roundoff prevents reliable distinguishment between a M and V \
fold. TweakFoldAngles cleans up the sign of the FoldAngles to agree with a \
the EdgeType values in the assignment.\
\>", "Text",
 CellChangeTimes->{{3.650050314918522*^9, 3.650050392218212*^9}, {
   3.650050426831978*^9, 3.65005047771629*^9}, {3.650050810088537*^9, 
   3.6500508802188263`*^9}, {3.650051570352699*^9, 3.650051628476132*^9}, 
   3.673096624191264*^9},ExpressionUUID->"439b1607-e83d-40aa-b7b2-\
d8e90ca0a356"],

Cell["\<\
TBD, rework this to allow for different options on how dominate the EdgeType \
should be.\
\>", "Text",
 CellChangeTimes->{{3.650051630362851*^9, 
  3.650051678578107*^9}},ExpressionUUID->"f59b54ee-5d50-4e59-b9ed-\
8a7714a8f940"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TweakFoldAnglesTo[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph3D, TAssigned\n",
 "TweakFoldAnglesTo",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph3D\nTweakFoldAngles[]\nTweakFoldAngles[",
 StyleBox["types",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.625667013473343*^9, 3.625667030415674*^9}, {
  3.625667251044662*^9, 3.6256673123280168`*^9}, {3.625667495476931*^9, 
  3.625667519131146*^9}, {3.625667560553181*^9, 3.625667575552795*^9}, {
  3.625684718752544*^9, 3.625684722735139*^9}, {3.625684785051865*^9, 
  3.625684789347234*^9}, {3.6730966242332067`*^9, 
  3.673096632220242*^9}},ExpressionUUID->"24a7e2e7-f84e-4af8-ab2a-\
67c1656fbed6"],

Cell[TextData[{
 "TweakFoldAnglesTo",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] takes a TGraph3D (which may or may not already be a TAssigned) and sets \
the sign of its FoldAngles according to the assignment ",
 StyleBox["types",
  FontSlant->"Italic"],
 ". If ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is empty, then ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " should be a TAssigned and we will use its internal EdgeTypes property. If \
the type is B, the fold angle is set to 0. If the type is U, then the \
foldangle is left unchanged."
}], "Text",
 CellChangeTimes->{{3.625667020200579*^9, 3.625667061574181*^9}, {
   3.625667224693795*^9, 3.625667241011915*^9}, {3.625667320319144*^9, 
   3.625667320486882*^9}, {3.6256673684451036`*^9, 3.62566739281915*^9}, 
   3.625667830004138*^9, {3.625684725776623*^9, 3.6256847273191977`*^9}, 
   3.673096632286792*^9},ExpressionUUID->"430ddb93-0b4e-47c8-a913-\
030bf2bbc90e"],

Cell["\<\
This is useful if we have numerically computed fold angles for a 3D embedding \
and there are \[PlusMinus]180\[Degree] folds; for these, the computed fold \
angle could have the sign reversed due to numerical round-off errors. This \
function lets us correct the fold angle based on a known mountain/valley \
assignment.\
\>", "Text",
 CellChangeTimes->{{3.62566783888241*^9, 3.625667920668106*^9}, {
  3.625684757437426*^9, 
  3.625684767356962*^9}},ExpressionUUID->"37d497f2-fbca-4674-8775-\
da72cb478920"],

Cell["\<\
Note: this function only addresses the sign of the fold angle, not its \
magnitude; you should have previously set the values of the fold angles, \
e.g., using RecalcFoldAngles.\
\>", "Text",
 CellChangeTimes->{{3.625690365312711*^9, 
  3.625690414470049*^9}},ExpressionUUID->"f4fe9f3d-f454-402c-a028-\
b455774a910f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TweakFoldAnglesTo", "[", 
   RowBox[{"tobj_TObj", ",", 
    RowBox[{"types_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ty", ",", "fa", ",", "sfn"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "TweakFoldAnglesTo"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ty", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ListEmptyQ", "[", "types", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AssertClass", "[", 
          RowBox[{"tobj", ",", "TAssigned", ",", "TweakFoldAnglesTo"}], "]"}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"GetValue", "[", 
          RowBox[{"tobj", ",", "EdgeTypes"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "types"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "FoldAngles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fa", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Switch", "[", 
          RowBox[{"#1", ",", "V", ",", 
           RowBox[{"Abs", "[", "#2", "]"}], ",", "M", ",", 
           RowBox[{"-", 
            RowBox[{"Abs", "[", "#2", "]"}]}], ",", "_", ",", "#2"}], "]"}], 
         "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"ty", ",", "fa"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"FoldAngles", "\[Rule]", "fa"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.6256673446382713`*^9, 3.625667357334692*^9}, {
  3.625667398164632*^9, 3.625667404111079*^9}, {3.625684802836607*^9, 
  3.625684803511518*^9}, {3.625685397307246*^9, 3.625685451702536*^9}, {
  3.625685486247192*^9, 3.625685604236104*^9}, {3.62568563733539*^9, 
  3.625685783818033*^9}, {3.625685838196352*^9, 3.6256858444188*^9}, {
  3.625685888695277*^9, 3.6256858908112993`*^9}, {3.625685940131178*^9, 
  3.625685963842699*^9}, {3.625686021926012*^9, 3.625686115976557*^9}, {
  3.673096632305352*^9, 3.673096632334292*^9}},
 CellLabel->
  "In[1968]:=",ExpressionUUID->"f326c51b-db0f-4945-bcdf-aa840323abca"],

Cell[TextData[{
 "TweakFoldAngles",
 "[",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns a pure function that takes a TObj and sets the sign of the fold \
angles according to the specified assignment."
}], "Text",
 CellChangeTimes->{{3.625667469510178*^9, 3.625667475214308*^9}, {
   3.6256675309071617`*^9, 3.625667554241317*^9}, {3.625667635390747*^9, 
   3.6256676502842283`*^9}, {3.625667786293147*^9, 3.625667827129712*^9}, {
   3.625684807891738*^9, 3.625684808162342*^9}, 
   3.673096624318451*^9},ExpressionUUID->"ec06169c-eba2-4f0c-abec-\
993cda4ba793"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TweakFoldAngles", "[", 
   RowBox[{"types_List", ":", 
    RowBox[{"{", "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"TweakFoldAnglesTo", "[", 
    RowBox[{"#", ",", "types"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.592660712195681*^9, 3.592660726134669*^9}, {
  3.59282886342764*^9, 3.592828863494886*^9}, {3.592855544888287*^9, 
  3.592855545686268*^9}, {3.625667657944277*^9, 3.6256676638299437`*^9}, {
  3.625684812931774*^9, 3.625684818089591*^9}, {3.673096624342376*^9, 
  3.673096632353889*^9}},
 CellLabel->
  "In[1969]:=",ExpressionUUID->"898a894d-e037-44fc-885e-02d8e5f38909"],

Cell["\<\
Example. Here\[CloseCurlyQuote]s a simple flat Z fold with (intentionally) \
incorrect fold angles that we correct by assigning types.\
\>", "Text",
 CellChangeTimes->{{3.625684827195068*^9, 3.625684862703211*^9}, {
  3.625684916293488*^9, 
  3.625684925403905*^9}},ExpressionUUID->"fb98e5be-0fc2-40ff-b1de-\
96321a75148a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "faces", ",", "verts3d", ",", "foldangles", ",",
       "types", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "8"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"faces", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "6", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "7", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4", ",", "8", ",", "7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
        "\[Pi]", ",", 
        RowBox[{"-", "\[Pi]"}], ",", "0"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B", ",", 
        "M", ",", "V", ",", "B"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], "//", 
        RowBox[{"AddTGraph3D", "[", 
         RowBox[{"verts3d", ",", "foldangles"}], "]"}]}], "//", 
       RowBox[{"AddTAssigned", "[", "types", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
          RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "/.", 
        RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<fold angles (original) = \>\"", ",", 
       RowBox[{"tobj", "[", "FoldAngles", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"TweakFoldAngles", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Print", "[", 
      RowBox[{"\"\<fold angles (reassigned) = \>\"", ",", 
       RowBox[{"tobj", "[", "FoldAngles", "]"}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.625684931651993*^9, 3.625685361257641*^9}, {
   3.625686125006518*^9, 3.625686143998638*^9}, 3.673096624369261*^9},
 CellLabel->
  "In[1970]:=",ExpressionUUID->"b1b6c687-a2dc-4b73-84e8-d7995c6f1151"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Converting from crease pattern to TGraph3DAssigned", "Subsection",
 CellChangeTimes->{{3.626362899006526*^9, 3.626362914548314*^9}, {
  3.64988190853246*^9, 3.649881914106525*^9}, {3.649886483113261*^9, 
  3.6498864889281673`*^9}, {3.707763641186563*^9, 
  3.70776364155514*^9}},ExpressionUUID->"96a16f2e-1c22-457a-9963-\
54813e115976"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.626362920701126*^9, 
  3.626362921171442*^9}},ExpressionUUID->"2430ab95-af66-4970-9469-\
5d699c612ddb"],

Cell["\<\
If we have a crease pattern (Graphics) in which the crease assignment is \
indicated by graphical style, we can import the crease pattern into a \
TGraphAssigned with the following idiom:
\ttemp0 = Import[<filename>]\[LeftDoubleBracket]1,1\[RightDoubleBracket]; (* \
import the file *)
\ttemp1 = temp0 // Ma9ImportRules; (* convert JoinedCurve primitives to Line \
segments. *)
\tstyleargs = ExtractStyleArgs[temp2,ShowSample\[Rule]True]; (* display all \
of the styles *)
\ttemp2 = ReplaceStyleArgs[temp2, {<symbolic style names in same order>}];
\ttemp3 = CreasePatternToPlaneGraphAssigned[temp2, SamePtTolerance \[Rule] \
<value>]; (* convert to TGraphAssigned *)\
\>", "Text",
 CellChangeTimes->{{3.626363049860338*^9, 3.626363362886965*^9}, 
   3.6263635320072203`*^9, {3.6263639271812153`*^9, 3.626363927460669*^9}, 
   3.626366959204432*^9, 
   3.628786592743791*^9},ExpressionUUID->"64ef756f-359c-489d-abce-\
20b1223966c6"],

Cell["\<\
However, sometimes we have a Graphics of a crease pattern (e.g., a drawn \
crease pattern) where the fold angles are conveyed by multiple styles \
(combinations of color, linewidth, pattern), and a simple mapping from \
graphics style to symbolic style would lose the angle information. In these \
cases, we\[CloseCurlyQuote]ll need to create a mapping from the graphical \
style to fold angles, and then pass that mapping to the conversion function \
CreasePatternToPlaneGraph3DAssigned, defined next.\
\>", "Text",
 CellChangeTimes->{{3.6263629909751873`*^9, 3.626363037820096*^9}, {
   3.62636336890292*^9, 3.6263634093883653`*^9}, {3.626363476911988*^9, 
   3.626363485983323*^9}, {3.626363534149194*^9, 3.626363538676238*^9}, {
   3.626363618999305*^9, 3.626363749294472*^9}, 3.626363939570554*^9, {
   3.626364189090115*^9, 3.62636419564244*^9}, {3.626364941106021*^9, 
   3.626364957680688*^9}},ExpressionUUID->"ea1586d1-e257-43fc-9183-\
ef0e1ccadf18"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "CreasePatternToGraph3DAssigned",
 "[",
 StyleBox["lines",
  FontSlant->"Italic"],
 ", ",
 StyleBox["stylemap",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{
  3.626363782853264*^9, {3.62636416336342*^9, 3.626364164131707*^9}, {
   3.6263647007476273`*^9, 3.626364701392876*^9}, {3.6263651058070393`*^9, 
   3.626365106447313*^9}, {3.626377150661854*^9, 3.626377157827304*^9}, 
   3.649881943075281*^9, 
   3.649882096332676*^9},ExpressionUUID->"4bb2bc68-d6bc-42cd-9c4f-\
34defa6e4dd2"],

Cell[TextData[{
 "CreasePatternToGraph3DAssigned",
 "[",
 StyleBox["lines",
  FontSlant->"Italic"],
 ", ",
 StyleBox["stylemap",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list ",
 StyleBox["lines",
  FontSlant->"Italic"],
 " of styled Line segments styled with some combination of graphical styles \
and a map ",
 StyleBox["stylemap",
  FontSlant->"Italic"],
 " that maps each style to its corresponding fold angle. It converts the list \
to a TGraph3DAssigned, where each edge of the graph is assigned a fold angle \
according the mapping from style to angle and a type according to the value \
of the angle. Note that the result will also be a TPlaneGraph. Options are:\n\
\tSamePtTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the tolerance on distance used when the vertices are Indexified."
}], "Text",
 CellChangeTimes->{{3.62636348995084*^9, 3.626363513533681*^9}, {
   3.626363545443224*^9, 3.626363546115218*^9}, {3.626363761181589*^9, 
   3.626363769148741*^9}, {3.626363999408321*^9, 3.626364128741983*^9}, {
   3.62636470725743*^9, 3.626364790587552*^9}, {3.626365111590841*^9, 
   3.626365290699037*^9}, 3.626377165954324*^9, 3.649881943115788*^9, 
   3.649882096371731*^9},ExpressionUUID->"4264c075-b3f5-48a6-81ad-\
c2a49138ffb0"],

Cell["\<\
Note that unlike CreasePatternToPlaneGraphAssigned, where setting the border \
was optional, in this function the border is always automatically detected \
and set.\
\>", "Text",
 CellChangeTimes->{{3.626377168634235*^9, 
  3.626377205289009*^9}},ExpressionUUID->"1352c722-6338-418b-8e52-\
ea11df4a3f23"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CreasePatternToGraph3DAssigned", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"SamePtTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.484865209729782*^9, 3.484865250006973*^9}, {
   3.484865841463675*^9, 3.484865871525488*^9}, 3.485092294178529*^9, 
   3.592468073548437*^9, 3.592828729594843*^9, 3.592828958234744*^9, 
   3.59465411109897*^9, 3.594739161753255*^9, 3.626365368530395*^9, 
   3.626377208681562*^9, 3.649881943135689*^9, 3.649882096398055*^9},
 CellLabel->
  "In[1971]:=",ExpressionUUID->"e0de03bb-95bd-4dc7-9d77-09933fbb9c77"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CreasePatternToGraph3DAssigned", "::", "dupvert"}], 
   "=", "\"\<The extracted edges `1` contain at least one edge with duplicate \
vertices `2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{3.533679551148519*^9, 3.592468074048597*^9, 
  3.592828729794779*^9, 3.592828958434273*^9, 3.594739162220359*^9, 
  3.626365444053299*^9, 3.649881943160727*^9, 3.64988209642034*^9},
 CellLabel->
  "In[1972]:=",ExpressionUUID->"c41a4e81-d2f2-4b89-987f-141dbc6d2604"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreasePatternToGraph3DAssigned", "[", 
   RowBox[{"lines_List", ",", " ", "stylemap_List", ",", " ", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tol", ",", "styles", ",", "elist", ",", "eangles", ",", "edgetypes", ",",
       "verts", ",", "edges", ",", "tobj", ",", "faces", ",", "boundary", ",",
       "bedges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"SamePtTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "CreasePatternToGraph3DAssigned", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"elist", "=", 
      RowBox[{"First", "/@", "lines"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eangles", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Drop", "[", 
           RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "lines"}], "/.", 
        RowBox[{"Style", "\[Rule]", "List"}]}], "/.", "stylemap"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edgetypes", "=", 
      RowBox[{"FoldAngleToType", "[", "eangles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{
        RowBox[{"First", "/@", "elist"}], ",", "2", ",", 
        RowBox[{"SamePtTolerance", "\[Rule]", "tol"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"Length", "/@", 
           RowBox[{"Union", "/@", "edges"}]}], "]"}], "===", 
         RowBox[{"{", "2", "}"}]}]}], ",", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"CreasePatternToGraph3DAssigned", "::", "dupvert"}], ",", 
         "edges", ",", "verts"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeTGraph", "[", 
        RowBox[{"verts", ",", "edges"}], "]"}], "//", "AddTPlaneGraphTo"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"faces", ",", "boundary"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Faces", ",", "BoundaryVertices"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bedges", "=", 
      RowBox[{"Join", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"Reverse", "/@", "#"}]}], "}"}], "&"}], "@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"boundary", ",", 
            RowBox[{"RotateLeft", "[", "boundary", "]"}]}], "}"}], "]"}]}], 
        ")"}]}]}], ";", 
     RowBox[{"edgetypes", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"bedges", ",", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "]"}], ",", "B", ",", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "]"}], "&"}], "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"edges", ",", "edgetypes"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eangles", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"bedges", ",", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "]"}], ",", "0", ",", 
          RowBox[{
          "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
         "]"}], "&"}], "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"edges", ",", "eangles"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "//", 
       RowBox[{"AddTAssigned", "[", "edgetypes", "]"}]}], "//", 
      RowBox[{"AddTGraph3D", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "eangles"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.626365301839163*^9, 3.626365339466118*^9}, {
   3.626365377792222*^9, 3.62636537818522*^9}, {3.626365430181735*^9, 
   3.626365479631284*^9}, {3.626365750361899*^9, 3.626365750890177*^9}, {
   3.626365788860703*^9, 3.6263659140903187`*^9}, {3.626365994639007*^9, 
   3.6263660219594803`*^9}, 3.6263660554587317`*^9, {3.626366095079422*^9, 
   3.626366152029907*^9}, {3.626366238562709*^9, 3.626366248449394*^9}, {
   3.626377216675179*^9, 3.626377234158381*^9}, {3.627328820611265*^9, 
   3.627328820879372*^9}, {3.649881943186612*^9, 3.649881943222783*^9}, {
   3.649882096444168*^9, 3.6498820964801073`*^9}},
 CellLabel->
  "In[1973]:=",ExpressionUUID->"95f781a8-2504-4455-96ae-49f2397a1fd2"],

Cell["\<\
Example. A 3D fold with two different mountain fold angles, indicated by \
linewidth. Note that we can construct the stylemap from inspection of the \
output of ExtractStyleArgs followed by application of MapThread.\
\>", "Text",
 CellChangeTimes->{{3.62636422535291*^9, 3.626364226167377*^9}, {
   3.626364504183133*^9, 3.6263645093653936`*^9}, {3.626364802268104*^9, 
   3.626364807450204*^9}, {3.6263649789680843`*^9, 3.626365009758017*^9}, {
   3.626366469578011*^9, 3.626366487910571*^9}, {3.626367006223085*^9, 
   3.626367019756299*^9}, 
   3.6287865928473806`*^9},ExpressionUUID->"d0ba0c8e-0779-4391-b972-\
3eac6e46d14e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cp", ",", "lines", ",", "styleargs", ",", "stylemap", ",", "tobj"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cp", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}], ",", "Black"}],
           "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "]"}], ",", "Red", ",", 
           RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"2", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "1"}], "}"}]}], "}"}], "]"}], ",", "Blue", ",", 
           RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"3", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "1"}], "}"}]}], "}"}], "]"}], ",", "Blue", ",", 
           RowBox[{"AbsoluteThickness", "[", "0.5", "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "cp", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{"ExtractFracturedStyledLines", "[", "cp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styleargs", "=", 
      RowBox[{"ExtractStyleArgs", "[", 
       RowBox[{"lines", ",", 
        RowBox[{"ShowSample", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"stylemap", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Rule", ",", 
        RowBox[{"{", 
         RowBox[{"styleargs", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"120", "\[Degree]"}], ",", 
            RowBox[{
             RowBox[{"-", "120"}], "\[Degree]"}], ",", 
            RowBox[{
             RowBox[{"-", "60"}], "\[Degree]"}]}], "}"}]}], "}"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"CreasePatternToGraph3DAssigned", "[", 
       RowBox[{"lines", ",", "stylemap"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"note", ",", " ", 
       RowBox[{
       "Vertices3D", " ", "and", " ", "FoldAngles", " ", "are", " ", 
        "initially", " ", "inconsistent"}], ",", " ", 
       RowBox[{
       "but", " ", "we", " ", "can", " ", "fold", " ", "along", " ", "the", " ",
         "fold", " ", "angles", " ", "to", " ", "make", " ", "them", " ", 
        RowBox[{"consistent", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"tobj", "[", "FoldAngles", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.626364271884828*^9, 3.626364315291888*^9}, {
   3.626364355689091*^9, 3.626364545610781*^9}, {3.626364602686129*^9, 
   3.62636469188244*^9}, {3.626364829649556*^9, 3.626364924257083*^9}, {
   3.626365069603984*^9, 3.626365098073001*^9}, 3.626365625892397*^9, {
   3.62636627121044*^9, 3.626366441217019*^9}, {3.626366998893023*^9, 
   3.626367000729561*^9}, {3.62636704420256*^9, 3.626367061841116*^9}, {
   3.628786571668222*^9, 3.628786592936935*^9}, 3.649881943253083*^9, 
   3.649882096511528*^9},
 CellLabel->
  "In[1974]:=",ExpressionUUID->"f40c1efe-d632-4b8c-b328-1e1ccd7ec221"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Converting from crease pattern+folded form to TGraph3DAssigned\
\>", "Subsection",
 CellChangeTimes->{{3.625658566219858*^9, 3.6256585985672407`*^9}, {
   3.625690853356556*^9, 3.625690857426627*^9}, 
   3.62569328586218*^9},ExpressionUUID->"5a5fdc15-8123-4e06-aafc-\
d7fe90ac0914"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.625658601159185*^9, 
  3.625658601639148*^9}},ExpressionUUID->"3a6091ca-da8a-4b71-a8f2-\
111b6346c384"],

Cell["\<\
Sometimes we have both a 2D crease pattern and a 3D model of the folded form \
and would like to construct a TGraph3DAssigned from the two that includes the \
3D information from the 3D model. This allows, for example, one to easily \
extract and render the fold angles of the 3D form.\
\>", "Text",
 CellChangeTimes->{{3.625658605215013*^9, 3.625658693616987*^9}, {
   3.625663909317466*^9, 3.625663910066579*^9}, 3.6256639749270353`*^9, {
   3.6263635908404093`*^9, 
   3.626363604119568*^9}},ExpressionUUID->"90906e9f-4cc1-4cfd-a289-\
e9188ea45b9b"],

Cell[TextData[{
 "One way of accomplishing the 3D assignment is to first use \
CreasePatternToPlaneGraphAssigned to turn the crease pattern (Graphics) into \
a TPlaneGraphAssigned, then use AddTGraph3D[",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 "] to assign the 3D embedding and RecalcFoldAngles to calculate the \
resulting fold angles. Here\[CloseCurlyQuote]s an example."
}], "Text",
 CellChangeTimes->{{3.625664042697997*^9, 3.6256641846970797`*^9}, {
  3.62566438176608*^9, 3.625664397090699*^9}, {3.625665166789281*^9, 
  3.625665189993345*^9}, {3.625691135825733*^9, 
  3.625691140865378*^9}},ExpressionUUID->"d8fe3a52-f84c-4865-9cc0-\
5952b204cff3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cp", ",", "tobj", ",", "verts3d"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cp", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
           "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
           "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"2", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
           "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"2", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
           "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
           "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
           "BorderLine"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "]"}], ",", 
           "ValleyLine"}], "]"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"cp", "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"CreasePatternToPlaneGraphAssigned", "[", "cp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<vertices = \>\"", ",", 
       RowBox[{"tobj", "[", "Vertices", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"RecalcFoldAngles", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GetAllRules", "[", "tobj", "]"}], "//", "ColumnForm"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.625690887400287*^9, 3.62569130031861*^9}, {
   3.625691357104687*^9, 3.625691358909595*^9}, 3.62878672894801*^9, 
   3.628786796435305*^9},
 CellLabel->
  "In[1975]:=",ExpressionUUID->"d19e92f3-e0f6-4f23-9a7b-62d264894e20"],

Cell["\<\
However, in order to do this, we need the 3D embedding of the vertices \
ordered to match the ordering that was created by \
CreasePatternToPlaneGraphAssigned. For small patterns, one can do that \
manually, but for larger patterns, we\[CloseCurlyQuote]d like to be able to \
do this semi-automatically. If we have a correspondence between the 2D and 3D \
vertices, but not in the same order as the vertices of the TGraph, we can use \
that correspondence with the following function to construct a mapping by \
value.\
\>", "Text",
 CellChangeTimes->{{3.625665199681212*^9, 3.625665329041708*^9}, {
  3.625665367799541*^9, 3.625665418508251*^9}, {3.625691424600888*^9, 
  3.625691479116613*^9}, {3.626362134928529*^9, 
  3.626362188083214*^9}},ExpressionUUID->"018c61b8-08db-4086-a3e1-\
6f684c07413e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "OrderMappingByVertices[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vmap, opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.625691486735255*^9, 3.625691492421709*^9}, {
  3.625691550778585*^9, 3.625691553648178*^9}, {3.625692348807742*^9, 
  3.625692362342552*^9}},ExpressionUUID->"6fe9fc38-811b-4401-aa56-\
742f7a752e24"],

Cell[TextData[{
 "OrderMappingByVertices[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["vmap, opts",
  FontSlant->"Italic"],
 "] takes a TGraph ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " and a mapping, ",
 StyleBox["vmap",
  FontSlant->"Italic"],
 ", of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["v", "1"], "\[Rule]", 
      SubscriptBox["u", "1"]}], ",", 
     RowBox[{
      SubscriptBox["v", "2"], "\[Rule]", 
      SubscriptBox["u", "2"]}], ",", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"fe793a47-4dc0-4f9e-9c16-cfad11095f0e"],
 " that maps each vertex coordinate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "i"], " "}], TraditionalForm]],ExpressionUUID->
  "306d4771-6a0e-473a-acc6-2e482a9d6107"],
 "of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " to another value ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "i"], TraditionalForm]],ExpressionUUID->
  "5f2056c9-f259-421f-8463-58095b715f63"],
 " (e.g., a 3D vertex coordinate); it returns a list of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "i"], " ", "ordered", " ", "to", " ", "match", " ", 
    "the", " ", "ordering", " ", "of"}], TraditionalForm]],ExpressionUUID->
  "ca8f304c-16fa-4d76-af91-4b030c955e64"],
 " the vertices of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ". Each vertex ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "13d9999d-dbd4-406f-ac0e-805051965879"],
 " in ",
 StyleBox["vmap",
  FontSlant->"Italic"],
 " must map to a unique vertex of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "; if two ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "b084e382-268e-4c65-aec9-fd98caeeb5ab"],
 " map to the same vertex, an error will be thrown."
}], "Text",
 CellChangeTimes->{{3.625665422164462*^9, 3.6256657486741858`*^9}, {
   3.625666784409156*^9, 3.625666812908887*^9}, 3.625691491484269*^9, {
   3.6256917510052357`*^9, 3.625691757723926*^9}, {3.625692681637235*^9, 
   3.625692759334181*^9}, {3.626362216521303*^9, 
   3.626362255510456*^9}},ExpressionUUID->"65c8378e-34da-4c0e-a5d7-\
a5ac5aed1b66"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "OrderMappingByVertices", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"SamePtTolerance", "\[Rule]", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.62569179451188*^9, 3.62569181445691*^9}, 
   3.62569210573003*^9},
 CellLabel->
  "In[1976]:=",ExpressionUUID->"fbb253d0-87e9-4a15-97a2-0c7ae395bb74"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OrderMappingByVertices", "::", "badlen"}], 
   "=", "\"\<The length of `1` should match the number `2` of \
vertices.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.625691767246656*^9, 3.625691791771418*^9}, {
  3.625692765551895*^9, 3.625692774151188*^9}, {3.6256930353686953`*^9, 
  3.625693066317699*^9}},
 CellLabel->
  "In[1977]:=",ExpressionUUID->"0aa155e9-d212-4c44-a5a2-ba9872f618a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OrderMappingByVertices", "::", "notdist"}], 
   "=", "\"\<The vertices of `1` do not map to distinct vertices of \
`2`.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.625691767246656*^9, 3.625691791771418*^9}, {
  3.625692765551895*^9, 3.625692774151188*^9}},
 CellLabel->
  "In[1978]:=",ExpressionUUID->"251d139e-4be8-4cf6-88a2-2dd2d276e09c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrderMappingByVertices", "[", 
   RowBox[{"tobj_TObj", ",", "vmap_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tol", ",", "verts", ",", "vv", ",", "vi"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "OrderMappingByVertices"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tol", "=", 
      RowBox[{
       RowBox[{"SamePtTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "OrderMappingByVertices", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "verts", "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "vmap", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"OrderMappingByVertices", "::", "badlen"}], ",", "vmap", ",", 
          RowBox[{"Length", "[", "verts", "]"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vv", "=", 
      RowBox[{"First", "/@", "vmap"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vi", "=", 
      RowBox[{
       RowBox[{"Indexify", "[", 
        RowBox[{"verts", ",", "1", ",", 
         RowBox[{"StartPoints", "\[Rule]", "vv"}]}], "]"}], "\[LeftDoubleBracket]",
        "2", "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Union", "[", "vi", "]"}], "]"}], "\[NotEqual]", 
        RowBox[{"Length", "[", "verts", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"OrderMappingByVertices", "::", "notdist"}], ",", "vmap", ",",
           "tobj"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Last", "/@", "vmap"}], ")"}], "\[LeftDoubleBracket]", "vi", 
      "\[RightDoubleBracket]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.625666893635941*^9, 3.625666912426325*^9}, {
   3.6256914044481683`*^9, 3.62569140522701*^9}, {3.625692087060087*^9, 
   3.625692247250476*^9}, {3.625692369873551*^9, 3.6256923982656717`*^9}, {
   3.62569259367598*^9, 3.625692667224134*^9}, {3.625692777057501*^9, 
   3.625692847493148*^9}, {3.625692879731925*^9, 3.625692890653566*^9}, {
   3.625693076063654*^9, 3.625693140516147*^9}, {3.626373862621097*^9, 
   3.626373866804983*^9}, {3.626374418956111*^9, 3.626374432446978*^9}, 
   3.626374746236226*^9},
 CellLabel->
  "In[1979]:=",ExpressionUUID->"87274d59-8c75-4ae7-9ffd-7f4005a437f5"],

Cell["\<\
Example. Provide a mapping of 2D to 3D vertices in a different order than \
verts but output the 3D vertices in the same order as verts.\
\>", "Text",
 CellChangeTimes->{{3.6256922854434566`*^9, 3.6256922862435837`*^9}, {
  3.625692915172653*^9, 3.625692935283255*^9}, {3.625693157822695*^9, 
  3.625693192899705*^9}, {3.62569322552142*^9, 3.625693234657474*^9}, {
  3.626374665883793*^9, 
  3.626374666097777*^9}},ExpressionUUID->"640e761a-c847-4aea-8be5-\
d1820b09626f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj", ",", "vmap"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"PrintThis", "[", "verts", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "test", " ", "on", " ", "an", " ", "intentionally", " ", "scrambled", " ",
        "mapping"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vmap", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"2", ",", "0", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"OrderMappingByVertices", "[", 
      RowBox[{"tobj", ",", "vmap"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6256923081597357`*^9, 3.625692342075927*^9}, {
   3.625692407142888*^9, 3.625692550497697*^9}, {3.62569314578111*^9, 
   3.62569314755781*^9}, {3.625693195248685*^9, 3.625693206490975*^9}, 
   3.626373798288241*^9, {3.626374343583789*^9, 3.626374359483231*^9}, {
   3.626374593908876*^9, 3.626374594208983*^9}, {3.626374628940211*^9, 
   3.626374638785877*^9}, {3.626374737605263*^9, 3.626374739412164*^9}},
 CellLabel->
  "In[1980]:=",ExpressionUUID->"7fdfcdda-dd25-4ef8-87e1-b90726195592"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Converting from minimal TGraph3D to TGraph3DAssigned", "Subsection",
 CellChangeTimes->{{3.67134412973494*^9, 3.671344140001192*^9}, {
   3.671344260514215*^9, 3.671344262802188*^9}, {3.671356637719063*^9, 
   3.671356638646852*^9}, 
   3.6713747136312947`*^9},ExpressionUUID->"75aea875-dffd-464a-aff1-\
890c989f1a40"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.671344142913474*^9, 
  3.671344143328793*^9}},ExpressionUUID->"869dd0fc-649c-43b7-a7b0-\
103f409178e6"],

Cell["\<\
For fully 3D forms (containing no flat (\[PlusMinus]180\[Degree]) folds), we \
can fully calculate the fold angles and crease assignment (EdgeTypes) from \
the 3D form using ReassignGraph3D. A TGraph3D already has FoldAngles; \
ReassignGraph3D uses the FoldAngles property to infer the crease assignment. \
So, if there are no flat (\[PlusMinus]180\[Degree]) folds, the following will \
give a fully constructed TGraph3D+TAssigned:
\ttobj = MakeTGraph3D[verts, edges, {}, verts3d] // ReassignGraph3D;
You can see an example of this in TwistJoinedTubes below.\
\>", "Text",
 CellChangeTimes->{{3.671344157792398*^9, 3.6713443084314337`*^9}, 
   3.671344341388753*^9, {3.671356820575832*^9, 3.6713568300344467`*^9}, {
   3.671358787437642*^9, 3.671358841329791*^9}, {3.67137440293762*^9, 
   3.671374429043537*^9}, {3.671374463173007*^9, 3.671374529522366*^9}, {
   3.671374686751909*^9, 3.671374688768401*^9}, {3.671375950203474*^9, 
   3.671376007151536*^9}, {3.6713760424849987`*^9, 3.671376057883521*^9}, {
   3.67137612620834*^9, 3.671376135599382*^9}, {3.671376692409181*^9, 
   3.6713766939199553`*^9}, {3.671376761244052*^9, 
   3.6713767900258703`*^9}},ExpressionUUID->"5036138f-55af-4ea4-97f3-\
4fcee58cfcf7"],

Cell["\<\
However, for forms that contain flat folds as well as 3D folds, \
RecalcFoldAngles (called in ReassignGraph3D) does not reliably set the fold \
angle, since, due to numerical round-off, values near \
\[PlusMinus]180\[Degree] are unpredictable. So, for such folds, you\
\[CloseCurlyQuote]ll need to separately construct the EdgeTypes, then use \
that with TweakFoldAngles (below) to given the FoldAngles the proper sign. \
Optionally call ReassignGraph3D to tweak the assignment, but you will need to \
supply TypeMinimumAngle and TypeMaximumAngle options explicitly. The proper \
idiom would be:
\ttobj = MakeTPlaneGraphAssigned[verts,edges,{},types] // \
AddTGraph3D[verts3d] // RecalcFoldAngles // TweakFoldAngles[types] // \
ReassignGraph3D[#,TypeMinimumAngle\[Rule]\[Alpha]min, TypeMaximumAngle\[Rule]\
\[Alpha]max]&;
You can see an example of this in ClosedTwistToppedTube below.\
\>", "Text",
 CellChangeTimes->{{3.671374432007181*^9, 3.671374435967217*^9}, {
   3.671374533993268*^9, 3.671374708974304*^9}, {3.671376068755353*^9, 
   3.671376091401767*^9}, {3.6713766208555403`*^9, 3.671376710528378*^9}, {
   3.6713768176484013`*^9, 3.6713768534946823`*^9}, {3.671530815645805*^9, 
   3.67153085539617*^9}, {3.671530913976136*^9, 3.67153092946318*^9}, {
   3.671531279305057*^9, 3.671531316749889*^9}, {3.671531372675227*^9, 
   3.671531373002651*^9}, {3.671531613867732*^9, 3.671531665240726*^9}, {
   3.6715316977976513`*^9, 3.671531698271337*^9}, 
   3.673100525722439*^9},ExpressionUUID->"360a2b7f-1a51-4e15-ae69-\
d67904b91cf5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ReassignGraph3D[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph3D\n\t(options) TypeMinimumAngle, \
TypeMaximumAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.671349518787665*^9, 3.6713495275225697`*^9}, {
   3.671349620964979*^9, 3.671349629389373*^9}, 3.671355134203077*^9, 
   3.6713552889238577`*^9, {3.671356577282952*^9, 
   3.671356578842752*^9}},ExpressionUUID->"238cd4df-9fd2-49b9-8b45-\
c8406c41a4df"],

Cell[TextData[{
 "ReassignGraph3D[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph3D (which may or may not be a TPlaneGraph) and reassigns \
the crease assignment based on the fold angles in the pattern and any \
previous assignment. Using this, you can build a complete TGraph3DAssigned \
from just Vertices, Edges, and Vertices3D. Arguments are:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph3D\nOptions are:\n\tTypeMinimumAngle, \
TypeMaximumAngle are passed through to ReassignGraphAssigned.\nIt returns a \
TGraph3D+TAssigned. If the EdgeTypes were missing or empty, it will also be a \
TPlaneGraph."
}], "Text",
 CellChangeTimes->{{3.671349552449034*^9, 3.671349649539359*^9}, {
   3.671355063887267*^9, 3.6713551703254337`*^9}, {3.671355295346784*^9, 
   3.6713553978672447`*^9}, 3.671356153668334*^9, {3.671356583154172*^9, 
   3.6713565837409477`*^9}},ExpressionUUID->"f16ca4ad-4326-4d73-9323-\
756d64f59d6f"],

Cell["\<\
This function calls ReassignGraphAssigned. Recall that in \
ReassignGraphAssigned, if the fold angle is smaller than TypeMinimumAngle, \
the assignment is set to U. If the fold angle is larger than \
TypeMaximumAngle, the assignment is left unchanged (if M or V) or an error is \
thrown if it was U, since we can\[CloseCurlyQuote]t properly infer the \
assignment.\
\>", "Text",
 CellChangeTimes->{{3.671375269908679*^9, 3.671375371661742*^9}, {
  3.671531140100397*^9, 
  3.671531144232887*^9}},ExpressionUUID->"209c0ac8-315b-417a-b051-\
0c9ff6a94fb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReassignGraph3D", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj1", ",", "types", ",", "foldangles"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "ReassignGraph3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", "tobj"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasPropertyQ", "[", 
        RowBox[{"tobj1", ",", "EdgeTypes"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"types", "=", 
        RowBox[{"GetValue", "[", 
         RowBox[{"tobj1", ",", "EdgeTypes"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tobj1", "=", 
         RowBox[{"tobj1", "//", 
          RowBox[{"AddTAssigned", "[", "]"}]}]}], ";", 
        RowBox[{"types", "=", 
         RowBox[{"GetValue", "[", 
          RowBox[{"tobj1", ",", "EdgeTypes"}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{"types", ",", "B"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"HasClassQ", "[", 
            RowBox[{"tobj1", ",", "TPlaneGraph"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"tobj1", "=", 
           RowBox[{"tobj1", "//", "AddTPlaneGraph"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"types", "=", 
         RowBox[{"PlaneGraphTypes", "[", "tobj1", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tobj1", "=", 
         RowBox[{"ReplacePropertyIn", "[", 
          RowBox[{"tobj1", ",", 
           RowBox[{"EdgeTypes", "\[Rule]", "types"}]}], "]"}]}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj1", "//", "RecalcFoldAngles"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj1", ",", "FoldAngles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReassignGraphAssigned", "[", 
      RowBox[{"tobj1", ",", "foldangles", ",", "opts"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.671355227836553*^9, 3.671355247069235*^9}, {
   3.671355424923968*^9, 3.671355593343964*^9}, {3.671355635908972*^9, 
   3.6713556721621647`*^9}, {3.671355714195704*^9, 3.671356016013835*^9}, {
   3.671356100029056*^9, 3.6713561458654838`*^9}, {3.671356482581506*^9, 
   3.671356603645619*^9}, {3.671374995280105*^9, 3.671375010637759*^9}, 
   3.825686776805833*^9, 3.825687096488344*^9},
 CellLabel->
  "In[1981]:=",ExpressionUUID->"9d76e305-cdf9-41be-bd0d-8d3933a1363c"],

