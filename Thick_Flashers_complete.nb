Cell[CellGroupData[{

Cell["CrossPleatedSquareGraph", "Subsubsection",
 CellChangeTimes->{{3.706829075794573*^9, 
  3.706829078945255*^9}},ExpressionUUID->"2ef56a9d-5915-41b2-991f-\
142300a2097c"],

Cell["\<\
A square graph with two pleats, one horizontal, one vertical.\
\>", "Text",
 CellChangeTimes->{{3.70682923080404*^9, 
  3.706829243467512*^9}},ExpressionUUID->"ee679f87-18ae-4bc1-a1f3-\
69a4bd9c2d89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "CrossPleatedSquareGraph", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AddTGraphExample", "[", 
  RowBox[{"CrossPleatedSquareGraph", ",", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"verts", ",", "edges", ",", "faces", ",", "tobj"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"verts", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "-", "1", "+", 
              RowBox[{"0.1", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "i"]}]}], ",", 
             RowBox[{"j", "-", "1", "+", 
              RowBox[{"0.1", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "j"]}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"edges", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", 
                RowBox[{"4", 
                 RowBox[{"(", 
                  RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
               RowBox[{"i", "+", "1", "+", 
                RowBox[{"4", 
                 RowBox[{"(", 
                  RowBox[{"j", "-", "1"}], ")"}]}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "4"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", 
                RowBox[{"4", 
                 RowBox[{"(", 
                  RowBox[{"j", "-", "1"}], ")"}]}]}], ",", 
               RowBox[{"i", "+", 
                RowBox[{"4", 
                 RowBox[{"(", "j", ")"}]}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"faces", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "6", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3", ",", "7", ",", "6"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4", ",", "8", ",", "7"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "6", ",", "10", ",", "9"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "7", ",", "11", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"7", ",", "8", ",", "12", ",", "11"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"9", ",", "10", ",", "14", ",", "13"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"10", ",", "11", ",", "15", ",", "14"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"11", ",", "12", ",", "16", ",", "15"}], "}"}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}]}]}], "]"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.458257163865542*^9, 3.458257166549923*^9}, {
   3.4582607853270273`*^9, 3.4582609556404057`*^9}, 3.462733423003314*^9, {
   3.4627396782930813`*^9, 3.462739679976206*^9}, 3.484777342036934*^9, {
   3.484780057628642*^9, 3.484780060385479*^9}, 3.4848290747582703`*^9, {
   3.484832614808112*^9, 3.484832614855424*^9}, 3.484927941216462*^9, {
   3.484928140542224*^9, 3.484928146902413*^9}, 3.533505179142047*^9, {
   3.533505390926952*^9, 3.533505393221818*^9}, {3.5917266839342327`*^9, 
   3.591726780432581*^9}, 3.591737011550611*^9, 3.592039961458695*^9, 
   3.592208506296332*^9, {3.592344303671149*^9, 3.59234430370113*^9}, {
   3.592345817035779*^9, 3.59234581708453*^9}, 3.592352139119213*^9, {
   3.592432490606738*^9, 3.592432493629829*^9}, {3.592432544324202*^9, 
   3.592432575892641*^9}, {3.592432652224172*^9, 3.592432674696317*^9}, {
   3.592432825106231*^9, 3.592432852797521*^9}, {3.592435855765297*^9, 
   3.592435855965745*^9}, 3.59264764665961*^9, {3.592790853180888*^9, 
   3.5927908993130627`*^9}, 3.592791268123336*^9, {3.594727220282016*^9, 
