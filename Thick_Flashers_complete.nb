Cell["Example. Folding across a cone.", "Text",
 CellChangeTimes->{{3.80117524694804*^9, 3.801175247218978*^9}, {
  3.801175294579705*^9, 3.801175295467395*^9}, {3.801648320419106*^9, 
  3.801648323522393*^9}},ExpressionUUID->"5aaf73db-973a-4382-981e-\
e399975337db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "\[Theta]", ",", "ff", ",", "rrL", ",", "rrR", ",", "f", ",", 
      "rL", ",", "rR", ",", "u0", ",", "u1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "The", " ", "basic", " ", "cone", " ", "in", " ", "3", "D", " ", "and", " ",
       "2", "D"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
           RowBox[{"Sin", "[", "s", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], 
           RowBox[{"Cos", "[", "s", "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"-", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
            RowBox[{"Sin", "[", "s", "]"}]}], ",", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], 
            RowBox[{"Cos", "[", "s", "]"}]}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", 
            RowBox[{"s", " ", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], ",", 
          RowBox[{"Cos", "[", 
           RowBox[{"s", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rL", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"-", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", 
             RowBox[{"s", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], ",", 
           RowBox[{"Cos", "[", 
            RowBox[{"s", " ", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], "}"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"30", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "rL", ",", "rR", ",", "ff", ",", "rrL", ",", "rrR"}],
        "}"}], "=", 
      RowBox[{"FoldAcrossRightBoth", "[", 
       RowBox[{"f", ",", "rL", ",", "ff", ",", "rrL", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}], ",", 
        RowBox[{"Assumptions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Theta]", ">", "0"}], ",", 
           RowBox[{"\[Theta]", "<", 
            RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CurvedFoldGraphics3D", "[", 
          RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], ",", 
         RowBox[{"CurvedFoldGraphics", "[", 
          RowBox[{"f", ",", "rL", ",", "rR", ",", 
           RowBox[{"{", 
            RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
