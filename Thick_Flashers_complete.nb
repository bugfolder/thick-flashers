Cell[TextData[{
 "MergeGraphsData[",
 StyleBox["tglist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a list of TGraphs and returns a list of data that dictates how the \
old graphs should be merged into a new graph."
}], "Text",
 CellChangeTimes->{{3.707777881375506*^9, 3.707777896214168*^9}, {
   3.707777991557645*^9, 3.707778015038863*^9}, {3.7078223833912582`*^9, 
