          RowBox[{"PlotLabel", "\[Rule]", "\"\<Graph 2\>\""}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "pr"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GraphGraphics", "[", 
         RowBox[{"tobj", ",", 
          RowBox[{"PlotLabel", "\[Rule]", "\"\<Merged\>\""}], ",", 
          RowBox[{"Frame", "\[Rule]", "True"}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "pr"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
