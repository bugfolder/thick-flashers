Cell[CellGroupData[{

Cell[TextData[{
 "EdgeFaceAngles",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.595335988604109*^9, 3.595335993065559*^9}, 
   3.5953360430803547`*^9, 3.595336084902326*^9, 3.5953428663218393`*^9, 
   3.595342917687168*^9, {3.5953430952518673`*^9, 3.595343100399111*^9}, {
   3.595343939327521*^9, 3.595343940407378*^9}, 
   3.6264591623400087`*^9},ExpressionUUID->"6bd011a9-d8a1-4226-b80e-\
04f6f1574ce6"],

Cell[TextData[{
 "EdgeFaceAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of the angles between incident faces of each edge, \
computed from the 2D embedding Vertices, according to these rules:\n\t\
Boundary edges have an edge angle of 0 by definition.\n\tEdges between two \
faces with the same winding number have an edge angle of 0.\n\tEdges between \
two faces with opposite winding numbers have an edge angle of \[Pi].\nFor a \
planar TGraph, all edge angles will be zero. To represent a folded form, you \
should use a TGraph2D, and then you can get the corresponding angles using \
EdgeFaceAngles2D. To represent a 3D folded form, use a TGraph3D and get the \
corresponding angles from EdgeFaceAngles3D."
}], "Text",
 CellChangeTimes->{{3.5953359945062833`*^9, 3.59533601892816*^9}, {
   3.595336092596756*^9, 3.595336236834133*^9}, {3.595339271895361*^9, 
   3.595339274637434*^9}, {3.595339643662042*^9, 3.595339651165415*^9}, {
   3.595339720216488*^9, 3.595339774589556*^9}, {3.595342907344264*^9, 
   3.595342917739517*^9}, {3.5953430216626453`*^9, 3.595343091094489*^9}, {
   3.59534324342325*^9, 3.5953432732515306`*^9}, 3.626459162498704*^9, {
   3.626459258136767*^9, 3.626459341336629*^9}, {3.62646028046813*^9, 
   3.626460307826721*^9}},ExpressionUUID->"73fca4fc-a3f0-4845-975a-\
92af55c6aaf3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeFaceAngles", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "faces", ",", "efi", ",", "fwn", ",", "fpair"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "faces", ",", "efi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Faces", ",", "EdgeFaceIncidence"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fwn", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"WindingNumber", "[", 
         RowBox[{"verts", ",", "#"}], "]"}], "&"}], "/@", "faces"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"winding", " ", "number", " ", "of", " ", "each", " ", "face"}],
       " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"fpair", "=", 
         RowBox[{
         "efi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"fpair", ",", "0"}], "]"}], ",", "\[IndentingNewLine]", 
          "0", ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fwn", "\[LeftDoubleBracket]", 
              RowBox[{
              "fpair", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
               "\[RightDoubleBracket]"}], "\[Equal]", " ", 
             RowBox[{"fwn", "\[LeftDoubleBracket]", 
              RowBox[{
              "fpair", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
               "\[RightDoubleBracket]"}]}], ",", "0", ",", "\[Pi]"}], "]"}]}],
          "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "efi", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.595339044710459*^9, 3.595339158399909*^9}, {
   3.595339222755669*^9, 3.595339251347137*^9}, {3.595339295766979*^9, 
   3.595339378835322*^9}, {3.59533943144966*^9, 3.5953395741185913`*^9}, {
   3.595339608149478*^9, 3.595339630075109*^9}, {3.595339678720539*^9, 
   3.595339685154252*^9}, {3.5953428833899*^9, 3.595342917779654*^9}, 
   3.626459162615781*^9},
 CellLabel->
  "In[1287]:=",ExpressionUUID->"cf5359c1-357c-4540-a390-6e584fca60eb"],

