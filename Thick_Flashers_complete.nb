Cell[CellGroupData[{

Cell[TextData[{
 "MakeMiuraOri[\[Alpha], {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dv",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MajorFoldAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.703598702801132*^9, 3.703598708264971*^9}, {
   3.70359877760286*^9, 3.703598790345876*^9}, 3.703598898155394*^9, {
   3.7035990217486973`*^9, 3.703599024500696*^9}, {3.703600121238299*^9, 
   3.703600121918006*^9}, {3.704023910918069*^9, 
   3.7040239178835177`*^9}},ExpressionUUID->"8e161958-bdc0-4b25-8915-\
8b0470015351"],

Cell[TextData[{
 "MakeMiuraOri[\[Alpha], {",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dv",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}] creates a Miura-ori in which the crease pattern is oriented so that \
major folds zigzag vertically, minor folds run strictly horizontally."
}], "Text",
 CellChangeTimes->{{3.703598860718053*^9, 3.703598884115151*^9}, {
  3.703598916462899*^9, 3.703598940803869*^9}, {3.70359909166179*^9, 
  3.703599094245612*^9}},ExpressionUUID->"6fd0f765-9b4f-47a6-be5c-\
ecfbf82ba5d9"],

Cell[TextData[{
 "Arguments:\n\t\[Alpha] \[LongDash] the bottom left sector angle (typically \
acute).\n\t{",
 StyleBox["dh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dv",
  FontSlant->"Italic"],
 "} \[LongDash] lengths of the horizontal and near-vertical creases, \
respectively.\n\t{",
 StyleBox["nh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "} \[LongDash] number of facets in the horizontal and vertical directions, \
respectively."
}], "Text",
 CellChangeTimes->{{3.703598951539398*^9, 3.703599029292788*^9}, {
  3.7035991125415797`*^9, 3.703599118260792*^9}, {3.703600018462603*^9, 
  3.703600029693411*^9}},ExpressionUUID->"a8862d94-ec8e-492e-bb7a-\
2805da3e92ab"],

Cell["\<\
Options:
\tMajorFoldAngle \[Rule] \[Gamma], specifies the major fold angle in the 3D \
form.\
\>", "Text",
 CellChangeTimes->{{3.70360012517419*^9, 
  3.703600152742341*^9}},ExpressionUUID->"2dacd799-e48a-4370-960c-\
a10e2520bfd4"],

Cell["\<\
Returns a TGraph3D+TAssigned of the crease pattern and folded form.\
\>", "Text",
 CellChangeTimes->{{3.703599120461484*^9, 3.7035991362138033`*^9}, {
  3.703599170245399*^9, 
  3.703599175293489*^9}},ExpressionUUID->"ff42b65d-5647-460a-8ddc-\
84bde2e35905"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MajorFoldAngle", "::", "usage"}], 
   "=", "\"\<MajorFoldAngle is an option to MakeMiuraOri that specifies the \
major fold angle of the first vertical fold in the 3D form.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7036001611632557`*^9, 3.703600238327153*^9}},
 CellLabel->
  "In[2517]:=",ExpressionUUID->"b981d2da-f6e6-42e3-85c6-52e1c9f32f52"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeMiuraOri", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"MajorFoldAngle", "\[Rule]", 
     RowBox[{"90", "\[Degree]"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.703600225055538*^9, 3.703600255256542*^9}},
 CellLabel->
  "In[2518]:=",ExpressionUUID->"452264d4-bb72-4bb4-9b2f-e9979f93c602"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeMiuraOri", "[", 
   RowBox[{"\[Alpha]_", ",", 
    RowBox[{"{", 
     RowBox[{"dh_", ",", "dv_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"nh_", ",", "nv_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gmj", ",", "ca", ",", "sa", ",", "gmn", ",", "gmjp", ",", "gmnp", ",", 
      "vfn", ",", "v3dfn", ",", "hetfn", ",", "vetfn", ",", "heafn", ",", 
      "veafn", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gmj", "=", 
      RowBox[{
       RowBox[{"MajorFoldAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeMiuraOri", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ca", ",", "sa"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Alpha]", "]"}], ",", 
        RowBox[{"Sin", "[", "\[Alpha]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gmn", "=", 
      RowBox[{"2", " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"ca", " ", 
         RowBox[{"Tan", "[", 
          RowBox[{"gmj", "/", "2"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"i", " ", "dh"}], "+", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"j", ",", "2"}], "]"}], "\[Equal]", "1"}], ",", 
           RowBox[{"dv", " ", "ca"}], ",", "0"}], "]"}]}], ",", 
        RowBox[{"j", " ", "dv", " ", "sa"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gmjp", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"gmj", "\[GreaterEqual]", "0"}], ",", "0", ",", "1"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "major", " ", "fold", " ", "parity"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gmnp", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"gmn", "\[GreaterEqual]", "0"}], ",", "0", ",", "1"}], 
       "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "minor", " ", "fold", " ", "parity"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", "+", "gmjp"}], ",", "2"}], "]"}], "\[Equal]", "1"}], ",",
         "V", ",", "M"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", "+", "j", "+", "gmnp"}], ",", "2"}], "]"}], "\[Equal]",
          "0"}], ",", "V", ",", "M"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"veafn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"i", ",", "2"}], "]"}], "\[Equal]", "1"}], ",", "gmj", ",", 
        
        RowBox[{"-", "gmj"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"heafn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", "+", "j"}], ",", "2"}], "]"}], "\[Equal]", "0"}], ",",
         "gmn", ",", 
        RowBox[{"-", "gmn"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{"MakeQuadMesh", "[", 
        RowBox[{"nh", ",", "nv", ",", "\[IndentingNewLine]", 
         RowBox[{"VerticesFn", "\[Rule]", "vfn"}], ",", "\[IndentingNewLine]", 
         RowBox[{"HorizontalEdgeTypeFn", "\[Rule]", "hetfn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VerticalEdgeTypeFn", "\[Rule]", "vetfn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"HorizontalEdgeAngleFn", "\[Rule]", "heafn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VerticalEdgeAngleFn", "\[Rule]", "veafn"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"FoldGraph3D", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"tobj", "[", "FoldAngles", "]"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"AddProperties", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MiuraOriSectorAngle", "->", "\[Alpha]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"MiuraOriMajorFoldAngle", "->", "gmj"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"MiuraOriEdgeLengths", "->", 
          RowBox[{"{", 
           RowBox[{"dh", ",", "dv"}], "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"MiuraOriNumUnits", "->", 
          RowBox[{"{", 
           RowBox[{"nh", ",", "nv"}], "}"}]}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "tobj"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.703599178944511*^9, 3.703599199005152*^9}, {
  3.703599334015287*^9, 3.703599375127532*^9}, {3.703599425401246*^9, 
  3.703599460544527*^9}, {3.703599623571434*^9, 3.703599839284009*^9}, {
  3.703599909845066*^9, 3.7035999199887257`*^9}, {3.703599955806253*^9, 
  3.703599987197762*^9}, {3.703600038135757*^9, 3.703600078021848*^9}, {
  3.703600261311837*^9, 3.703600289376577*^9}, {3.70360045904334*^9, 
  3.7036004806657457`*^9}, {3.703600526447012*^9, 3.703600745582404*^9}, {
  3.703600788151904*^9, 3.703600795853896*^9}, {3.703600841595739*^9, 
  3.7036008547598886`*^9}, {3.703600923246702*^9, 3.703601012759622*^9}, {
  3.70360104442437*^9, 3.703601076328532*^9}, {3.70360111685032*^9, 
  3.7036011329032297`*^9}, {3.912593939969002*^9, 3.9125940207675*^9}},
 CellLabel->
  "In[2519]:=",ExpressionUUID->"333c0b20-841b-4b4d-9c77-491037e0308e"],

