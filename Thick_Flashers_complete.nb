   3.4660879036647367`*^9}, {3.466088138764228*^9, 3.466088203525941*^9}, {
   3.466088285007281*^9, 3.466088327002902*^9}, {3.466088385206354*^9, 
   3.466088456958179*^9}, {3.466088797654642*^9, 3.46608879795267*^9}, {
   3.466089111349001*^9, 3.466089193062587*^9}, {3.46608923986326*^9, 
   3.466089330047535*^9}, {3.4660894910372*^9, 3.466089650428166*^9}, {
   3.466089720857908*^9, 3.46609000819297*^9}, {3.466090621686934*^9, 
   3.466090794606924*^9}, {3.466090825231608*^9, 3.466090863303516*^9}, 
   3.466090945179895*^9, 3.484829045658318*^9, {3.484829078267195*^9, 
   3.48482907844907*^9}, 3.592237422072282*^9, 3.592401552558452*^9, {
   3.59252208263443*^9, 3.592522082865937*^9}, {3.592522116664053*^9, 
   3.592522191787541*^9}, {3.5925222632884007`*^9, 3.592522438425503*^9}, 
   3.592647648677293*^9, 3.592659845617742*^9, 3.592681708560546*^9, 
   3.5927077216630993`*^9, {3.592828742463019*^9, 3.592828742531697*^9}, {
   3.592828811224072*^9, 3.592828811276397*^9}, 3.593044507691039*^9, {
   3.594072164496187*^9, 3.594072164530672*^9}},
 CellLabel->
  "In[3376]:=",ExpressionUUID->"cdac7d7e-84a4-4bbd-b150-6c76b439b0ca"],

Cell["Example", "Text",
 CellChangeTimes->{{3.466085297437316*^9, 
  3.466085298108862*^9}},ExpressionUUID->"674474ec-b367-445a-906f-\
b895e964e538"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bounds", ",", "points", ",", "tobjpd", ",", "\[Gamma]", ",", "\[Alpha]",
       ",", "dir", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bounds", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"SeedRandom", "[", "0", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"0.1", "+", 
         RowBox[{"0.8", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Random", "[", "]"}], ",", 
            RowBox[{"Random", "[", "]"}]}], "}"}]}]}], ",", 
        RowBox[{"{", "8", "}"}]}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Use", " ", "7", " ", "pts", " ", "to", " ", "test", " ", "the", " ", 
        "error"}], ",", " ", 
       RowBox[{
       "use", " ", "8", " ", "for", " ", "complete", " ", "function"}]}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjpd", "=", 
      RowBox[{"MakeBoundedVoronoiDiagramPrimalDualGraph", "[", 
       RowBox[{"bounds", ",", "points"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", "1.0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"15.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", "=", "CCW"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakePrimalDualTwistTessellation", "[", 
       RowBox[{"tobjpd", ",", "\[Gamma]", ",", "\[Alpha]", ",", 
        RowBox[{"Direction", "\[Rule]", "dir"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PrimalDualGraphics", "[", "tobjpd", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"VisibleFoldedFormGraphics", "[", 
          RowBox[{"tobj", ",", 
           RowBox[{"FaceupFace", "\[Rule]", 
            RowBox[{"-", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", "}"}], 
       "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.466085300290951*^9, 3.466085406012287*^9}, {
