Cell[CellGroupData[{

Cell["Crease patterns and folded form decorations", "Subsection",
 CellChangeTimes->{{3.629846150482974*^9, 3.629846172418014*^9}, {
   3.629847370069665*^9, 3.629847385637732*^9}, {3.6299235998943*^9, 
   3.629923603404208*^9}, 3.707767940018841*^9, 3.707770972607416*^9, {
   3.707772161678892*^9, 
   3.707772164679435*^9}},ExpressionUUID->"cf7c3099-6d98-484e-82c0-\
276b1eafe9bb"],

Cell[CellGroupData[{

Cell["\<\
Tiling decorations
\tCreasePattern, FoldedForm2D, FoldedForm3D\
\>", "Subsubsection",
 CellChangeTimes->{{3.630163167340782*^9, 3.630163197337969*^9}, {
   3.707767919737798*^9, 3.7077679388663597`*^9}, 
   3.70777235503295*^9},ExpressionUUID->"801e130c-6588-4085-ab2d-\
f3b1cd519cd8"],

Cell["\<\
CreasePattern, FoldedForm2D, and FoldedForm3D are decorations that produce \
renditions of the crease pattern and folded form for a tile.\
\>", "Text",
