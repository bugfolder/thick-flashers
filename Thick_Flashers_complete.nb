Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nh", ",", "nv", ",", "vfn", ",", "hetfn", ",", "vetfn", ",", "tobj"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nh", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nv", "=", "3"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2.", " ", "i"}], "+", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", "j", "]"}], ",", 
           RowBox[{"-", "0.3"}], ",", "0"}], "]"}]}], ",", " ", 
        RowBox[{"3.", " ", "j"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", 
         RowBox[{"i", "+", "j"}], "]"}], ",", "M", ",", "V"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vetfn", "[", 
       RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "i", "]"}], ",", "V", ",", "M"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeQuadMesh", "[", 
       RowBox[{"nh", ",", "nh", ",", 
        RowBox[{"VerticesFn", "\[Rule]", "vfn"}], ",", 
        RowBox[{"HorizontalEdgeTypeFn", "\[Rule]", "hetfn"}], ",", 
        RowBox[{"VerticalEdgeTypeFn", "\[Rule]", "vetfn"}], ",", 
        RowBox[{"BorderOverride", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<CornerIndices = \>\"", ",", 
       RowBox[{"tobj", "[", "CornerIndices", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "tobj", "]"}], ",", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.594057643412326*^9, 3.5940577370554457`*^9}, {
