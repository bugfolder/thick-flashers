Cell["\<\
A good check on the validity of a folded form is to verify that \
VertexEdgeAngles and VertexEdgeAngles2D agree for all faces.\
\>", "Text",
 CellChangeTimes->{{3.595272732889398*^9, 3.595272824875722*^9}, {
  3.595275136317527*^9, 3.595275163890504*^9}, {3.626460379932168*^9, 
  3.6264604072800703`*^9}},ExpressionUUID->"b00eeb23-bf2a-421f-b367-\
5117e8da7a48"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexEdgeAngles2D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "vva", ",", "vfi", ",", "va", ",", "vfa"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "vva", ",", "vfi"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices2D", ",", "VertexVertexAdjacency", ",", 
          "VertexFaceIncidence"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"va", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"AbsoluteAngle", "[", 
            RowBox[{
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
             "-", 
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "i", 
              "\[RightDoubleBracket]"}]}], "]"}], "&"}], "/@", 
          RowBox[{
          "vva", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"vfa", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"Subtract", "@@", "#"}], ",", 
              RowBox[{"2", "\[Pi]"}], ",", 
              RowBox[{"-", "\[Pi]"}]}], "]"}], "]"}], "&"}], "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RotateLeft", "[", "va", "]"}], ",", "va"}], "}"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#1", "\[Equal]", "0"}], ",", "Null", ",", "#2"}], "]"}],
            "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "vfi", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
             "vfa"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "vva", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.59190881949539*^9, 3.591908873049375*^9}, {
   3.5919114536682577`*^9, 3.591911521296246*^9}, {3.591911683166413*^9, 
