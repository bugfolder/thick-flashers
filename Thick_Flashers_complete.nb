   3.555877759390441*^9}, {3.555953532176882*^9, 3.5559535350633707`*^9}, {
   3.555953668751749*^9, 3.555953717889508*^9}, {3.71993102902227*^9, 
   3.719931037998898*^9}, {3.911146236426675*^9, 3.9111462489373837`*^9}, {
   3.9117531902241583`*^9, 3.911753223647645*^9}, {3.911753269681005*^9, 
   3.911753303881095*^9}, 3.911902750098153*^9, 3.911988247939807*^9, {
   3.913476446269066*^9, 3.9134764475978622`*^9}, {3.913542927353022*^9, 
   3.91354294612856*^9}},ExpressionUUID->"6c72a99c-d719-43b3-b4d0-\
895deb685149"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["p",
  FontSlant->"Italic"],
 " \[LongDash] A symbol to use for points.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " -- the number of rings.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " -- the height order (how many turns a diagonal takes to get from the \
bottom to the top of a ring)\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " -- the rotational symmetry\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " -- the desired panel thickness."
}], "Text",
 CellChangeTimes->{{3.719931396604858*^9, 3.71993146171073*^9}, {
  3.911146252736969*^9, 3.911146260680785*^9}, {3.911753226895897*^9, 
  3.911753239327874*^9}},ExpressionUUID->"efd8bd76-03d2-4446-a3b3-\
f4af0ca67521"],

Cell["\<\
Returns: a list of rules that gives the vertex positions of the EZT surface \
in the folded form projection (view from the top of the folded form) for the \
ideal configuration. \
\>", "Text",
 CellChangeTimes->{{3.911583432765998*^9, 3.911583438582089*^9}, {
  3.9115835306550813`*^9, 3.911583603218736*^9}, {3.911646365443915*^9, 
  3.911646366634304*^9}, {3.911753328656706*^9, 3.911753329160631*^9}, {
  3.913476464989378*^9, 3.913476468183876*^9}, {3.913542974985557*^9, 
  3.913543061947129*^9}},ExpressionUUID->"013a82ad-558c-4fca-907d-\
4b6bac13c6d2"],

Cell["\<\
That is, we\[CloseCurlyQuote]re solving for the correct x-y positions of all \
of the vertices in the folded form of the EZT surface. (We don\
\[CloseCurlyQuote]t yet know their z-positions in the folded form, nor their \
x-y positions in the deployed pattern. Those will come later.)\
\>", "Text",
 CellChangeTimes->{
  3.9135430643744087`*^9},ExpressionUUID->"fe8b19eb-934a-42fa-a09f-\
3aaf2f006ea5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeThickFlasherFFProjectionRules", "[", 
   RowBox[{"p_", ",", "r_", ",", "h_", ",", "m_", ",", "t_", ",", "opts___"}],
    "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "lines", ",", "rules", ",", "rpred", ",", "asucc", ",", "apred", ",", 
      "fsverts", ",", "raverts", ",", "nv", ",", "vind", ",", "dx", ",", "dy",
       ",", "vars", ",", "fns", ",", "R90", ",", "soln", ",", "gverts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Construct", " ", "fold", " ", "lines", " ", "for", " ", "k"}],
        "=", 
       RowBox[{
        RowBox[{"0", " ", "and", " ", "k"}], "=", "1"}]}], ",", " ", 
      RowBox[{
      "which", " ", "we", " ", "use", " ", "for", " ", "reference", " ", 
       "when", " ", "computing", " ", 
       RowBox[{"coordination", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"lines", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}], ",", 
        RowBox[{"ThickFlasherSectorFoldLinesStructure", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Functions", " ", "for", " ", "adjacencies", " ", "in", " ", "the", " ",
        "CP"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"radial", " ", "predecessor"}], ";", " ", 
        RowBox[{"every", " ", "vertex", " ", "except", " ", "the", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "k"}], "}"}], " ", "vertex", " ", "has",
          " ", "one"}]}], ",", " ", 
       RowBox[{"so", " ", "return", " ", "Null", " ", "for", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "k"}], "}"}], "."}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rpred", "[", "v_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"v", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           "==", "0"}], "&&", 
         RowBox[{
          RowBox[{"v", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}],
           "==", "0"}]}], ",", "Null", ",", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"lines", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "\[LeftDoubleBracket]", 
               RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "==", 
              "v"}], "&&", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "==", "\"\<mn\>\""}]}], "&"}]}], "]"}], "\[LeftDoubleBracket]", 
         
         RowBox[{"1", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"axial", " ", "successor", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"on", " ", "the", " ", 
          RowBox[{"left", ".", " ", "Not"}], " ", "all", " ", "have", " ", 
          "them"}], ",", " ", 
         RowBox[{
         "return", " ", "Null", " ", "for", " ", "those", " ", "that", " ", 
          RowBox[{"don", "'"}], 
          RowBox[{"t", "."}]}]}], " "}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"asucc", "[", "Null", "]"}], ":=", "Null"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"asucc", "[", "v_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "cans", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"cans", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"lines", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "\[LeftDoubleBracket]", 
                RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "==", 
               "v"}], "&&", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 "==", "\"\<mj\>\""}], "||", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                 "==", "\"\<dg\>\""}]}], ")"}]}], "&"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"PrintThis", "[", "cans", "]"}], "//", "Hold"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"Length", "[", "cans", "]"}], ",", "\[IndentingNewLine]", 
           "0", ",", "Null", ",", "\[IndentingNewLine]", "1", ",", 
           RowBox[{"cans", "\[LeftDoubleBracket]", 
            RowBox[{"1", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",",
            "\[IndentingNewLine]", "3", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
               "v", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "==",
                "0"}], "&&", 
              RowBox[{
               RowBox[{
               "v", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "==",
                "0"}]}], ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{
               RowBox[{
               "v", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",",
                "1", ",", "0", ",", 
               RowBox[{
               "v", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
              "]"}], ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{
               RowBox[{
               "v", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "v", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
               RowBox[{
                RowBox[{
                "v", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "+",
                 "1"}], ",", 
               RowBox[{
               "v", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
              "]"}]}], "]"}], ",", "\[IndentingNewLine]", "_", ",", 
           RowBox[{"Print", "[", "\"\<ERROR\>\"", "]"}]}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"axial", " ", "predecessor", " ", "on", " ", "the", " ", 
        RowBox[{"right", ".", " ", "All"}], " ", "vertices", " ", "have", " ", 
        RowBox[{"one", ".", " ", "Note"}], " ", "wrap"}], "-", 
       RowBox[{"around", " ", "needed", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"could", " ", "have", " ", "k"}], "="}], "\[Dash]", "1"}],
           ")"}], "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"apred", "[", "Null", "]"}], ":=", "Null"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"apred", "[", "v_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"lines", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "==", "v"}],
             "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               "==", "\"\<mj\>\""}], "||", 
              RowBox[{
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               "==", "\"\<dg\>\""}]}], ")"}]}], "&"}]}], "]"}], "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"i_", ",", "j_", ",", 
           RowBox[{"-", "1"}]}]], "->", 
         SubscriptBox["p", 
          RowBox[{"i", ",", "j", ",", 
           RowBox[{"m", "-", "1"}]}]]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"A", " ", "list", " ", "of", " ", "all", " ", "first"}], "-", 
       RowBox[{"sector", " ", 
        RowBox[{"vertices", ".", " ", 
         RowBox[{"We", "'"}]}], "ll", " ", "create", " ", "two", " ", 
        "equations", " ", 
        RowBox[{"(", 
         RowBox[{"and", " ", "two", " ", "variables"}], ")"}], " ", "for", " ",
         "each", " ", "of", " ", 
        RowBox[{"these", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fsverts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"FlasherSectorVerticesRadiallyOrdered", "[", 
        RowBox[{"p", ",", "r", ",", "h"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"Length", "[", "fsverts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "A", " ", "list", " ", "of", " ", "the", " ", "outer", " ", "ring", " ",
         "vertices", " ", "that", " ", "are", " ", "not", " ", "incident", " ",
         "to", " ", "a", " ", "diagonal", " ", 
        RowBox[{"fold", ".", " ", "These"}], " ", "are", " ", "the", " ", 
        "ones", " ", "that", " ", "get", " ", "the", " ", "right"}], "-", 
       RowBox[{"angle", " ", 
        RowBox[{"treatment", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"raverts", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"FlasherOuterRingSectorVertices", "[", 
         RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "0"}], "]"}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{"v", ",", 
          RowBox[{"ListEmptyQ", "[", 
           RowBox[{"Select", "[", 
            RowBox[{"lines", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "\[LeftDoubleBracket]", 
                 RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "==", 
                "v"}], "&&", 
               RowBox[{
                RowBox[{
                "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                "==", "\"\<dg\>\""}]}], "&"}]}], "]"}], "]"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Index", " ", "of", " ", "a", " ", "vertex", " ", "into", " ", "this", 
        " ", "list"}], ",", " ", 
       RowBox[{
        RowBox[{"independent", " ", "of", " ", "k"}], "-", 
        RowBox[{"value", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vind", "[", "v_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"fsverts", ",", 
         RowBox[{"Subscript", "[", 
          RowBox[{
           RowBox[{
           "v", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "v", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "v", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
           "0"}], "]"}]}], "]"}], "\[LeftDoubleBracket]", 
       RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Construct", " ", "default", " ", "FFP", " ", "rules", " ", "for", " ", 
       "the", " ", "first", " ", 
       RowBox[{"sector", ".", " ", 
        RowBox[{"We", "'"}]}], "ll", " ", "use", " ", "these", " ", "as", " ",
        "the", " ", "initial", " ", 
       RowBox[{"guess", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rules", "=", 
      RowBox[{"ThickFlasherDefaultFFProjectionRules", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Create", " ", "a", " ", "version", " ", "of", " ", "these", " ", 
        "rules", " ", "that", " ", "includes", " ", "dx"}], ",", " ", 
       RowBox[{"dy", " ", "offsets", "  ", "on", " ", "every", " ", 
        RowBox[{"vertex", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rules", "=", 
      RowBox[{"rules", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["p", 
            RowBox[{"i_", ",", "j_", ",", "k_"}]], "->", "q_"}], ")"}], ":>", 
         
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["p", 
            RowBox[{"i", ",", "j", ",", "k"}]], "->", 
           RowBox[{"(", 
            RowBox[{"q", "+", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{"FlasherRotation2D", "[", 
                RowBox[{"k", ",", "m"}], "]"}], "]"}], ".", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"dx", "[", 
                 RowBox[{"vind", "[", 
                  SubscriptBox["p", 
                   RowBox[{"i", ",", "j", ",", "k"}]], "]"}], "]"}], ",", 
                RowBox[{"dy", "[", 
                 RowBox[{"vind", "[", 
                  SubscriptBox["p", 
                   RowBox[{"i", ",", "j", ",", "k"}]], "]"}], "]"}]}], 
               "}"}]}]}], ")"}]}], ")"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Build", " ", "equations", " ", "that", " ", "enforce", " ", "uniform", 
       " ", "panel", " ", "thickness", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"to", " ", "the", " ", "extent", " ", "possible"}], ")"}], 
        "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fns", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"R90", "=", 
      RowBox[{"RotationMatrix2D", "[", 
       FractionBox["\[Pi]", "2"], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "pa", ",", "pb", ",", "pc", ",", "pd", ",", "a", ",", "b", ",", "c",
            ",", "d"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Symbolic", " ", "points"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"pa", "=", 
           RowBox[{
           "fsverts", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"pb", "=", 
           RowBox[{"rpred", "[", "pa", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"pc", "=", 
           RowBox[{"asucc", "[", "pb", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"pd", "=", 
           RowBox[{"apred", "[", "pb", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Points", " ", "in", " ", "terms", " ", "of", " ", "numerics", " ",
             "and", " ", "dx", " ", "and", " ", "dy", " ", 
            RowBox[{"variables", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
          
          RowBox[{"a", "=", 
           RowBox[{"pa", "/.", "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"b", "=", 
           RowBox[{"pb", "/.", "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"c", "=", 
           RowBox[{"pc", "/.", "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"d", "=", 
           RowBox[{"pd", "/.", "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Which", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             SubscriptBox["p", 
              RowBox[{"0", ",", "0", ",", "0"}]], ",", " ", 
             RowBox[{"no", " ", "displacement"}]}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"i", "==", "1"}], ",", " ", 
            RowBox[{"JoinTo", "[", 
             RowBox[{"fns", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"dx", "[", "1", "]"}], ",", 
                RowBox[{"dy", "[", "1", "]"}]}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"boundary", ",", " ", 
              RowBox[{
              "use", " ", "right", " ", "angle", " ", "on", " ", "one", " ", 
               "side"}], ",", " ", 
              RowBox[{
              "panel", " ", "thickness", " ", "on", " ", "the", " ", 
               "other"}]}], " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"!", 
             RowBox[{"ListEmptyQ", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"raverts", ",", "pa"}], "]"}], "]"}]}], 
            RowBox[{"(*", 
             RowBox[{"c", "===", "Null"}], "*)"}], ",", " ", 
            RowBox[{"JoinTo", "[", 
             RowBox[{"fns", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"a", "-", "b"}], ")"}], ".", 
                 RowBox[{"(", 
                  RowBox[{"b", "-", "d"}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"R90", ".", 
                    RowBox[{"NormalizeReal", "[", 
                    RowBox[{"d", "-", "b"}], "]"}]}], ")"}], ".", 
                  RowBox[{"(", 
                   RowBox[{"a", "-", "b"}], ")"}]}], "-", "t"}]}], "}"}]}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "triangle", " ", "vertices", " ", "after", " ", "a", " ", 
              "split"}], " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"pd", "===", 
             RowBox[{"apred", "[", "pa", "]"}]}], ",", 
            RowBox[{"JoinTo", "[", 
             RowBox[{"fns", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"R90", ".", 
                    RowBox[{"NormalizeReal", "[", 
                    RowBox[{"b", "-", "c"}], "]"}]}], ")"}], ".", 
                  RowBox[{"(", 
                   RowBox[{"a", "-", "b"}], ")"}]}], "-", "t"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"R90", ".", 
                    RowBox[{"NormalizeReal", "[", 
                    RowBox[{"d", "-", "a"}], "]"}]}], ")"}], ".", 
                  RowBox[{"(", 
                   RowBox[{"a", "-", "b"}], ")"}]}], "-", "t"}]}], "}"}]}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"all", " ", "other", " ", "vertices"}], ",", " ", 
              RowBox[{
              "choose", " ", "panel", " ", "thickness", " ", "on", " ", 
               "both", " ", "sides"}]}], " ", "*)"}], "\[IndentingNewLine]", 
            "True", ",", " ", 
            RowBox[{"JoinTo", "[", 
             RowBox[{"fns", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"R90", ".", 
                    RowBox[{"NormalizeReal", "[", 
                    RowBox[{"b", "-", "c"}], "]"}]}], ")"}], ".", 
                  RowBox[{"(", 
                   RowBox[{"a", "-", "b"}], ")"}]}], "-", "t"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"R90", ".", 
                    RowBox[{"NormalizeReal", "[", 
                    RowBox[{"d", "-", "b"}], "]"}]}], ")"}], ".", 
                  RowBox[{"(", 
                   RowBox[{"a", "-", "b"}], ")"}]}], "-", "t"}]}], "}"}]}], 
             "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nv"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"vars", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dx", "[", "i", "]"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nv"}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dy", "[", "i", "]"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nv"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindRoot", "@@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "fns", "}"}], ",", "vars"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rules", "/.", "soln"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
