   3.6264643952219567`*^9}},ExpressionUUID->"04647805-0dcf-4bd9-80f0-\
477e5509453c"],

Cell["\<\
AddTPlaneGraphTo builds all of these properties and adds them to the TObj.\
\>", "Text",
 CellChangeTimes->{{3.591897597115032*^9, 3.591897604322241*^9}, {
   3.591898709142816*^9, 3.591898712427823*^9}, 3.5920399643778753`*^9, 
