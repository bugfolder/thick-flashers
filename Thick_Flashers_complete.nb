        RowBox[{"ll", "[", "3", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"Curve2DSystems", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"cs", "[", "3", "]"}], ",", 
           RowBox[{"cs", "[", "4", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "render", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"flist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", "[", "0", "]"}], ",", 
        RowBox[{"f", "[", "1", "]"}], ",", 
        RowBox[{"f", "[", "2", "]"}], ",", 
        RowBox[{"f", "[", "3", "]"}], ",", 
        RowBox[{"f", "[", "4", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gc", "=", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"StyledRuledPatchSequence", "[", 
           RowBox[{"flist", ",", 
            RowBox[{"{", 
             RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"RulingLineDivisions", "\[Rule]", "50"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"StyledCurve", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "&"}], "/@", 
           "flist"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", "}"}]}], "}"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fflist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ff", "[", "0", "]"}], ",", 
        RowBox[{"ff", "[", "1", "]"}], ",", 
        RowBox[{"ff", "[", "2", "]"}], ",", 
        RowBox[{"ff", "[", "3", "]"}], ",", 
        RowBox[{"ff", "[", "4", "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"gf", "=", 
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"StyledRuledPatchSequence", "[", 
            RowBox[{"fflist", ",", 
             RowBox[{"{", 
              RowBox[{"u0", ",", "u1"}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"RulingLineDivisions", "\[Rule]", "50"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"StyledCurve", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "&"}], "/@", 
            "fflist"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ShrinkWrap\>\"", " ", "\[Rule]", " ", "True"}], 
           "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Lighting", "\[Rule]", 
          RowBox[{"NeutralLighting", "[", ".8", "]"}]}]}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{"gc", ",", "gf"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.804525806550187*^9, 3.804526052815617*^9}, {
   3.804526113834241*^9, 3.804526125059143*^9}, 3.8045261954296913`*^9, {
   3.804527269499494*^9, 3.804527533379818*^9}, {3.804527571943935*^9, 
   3.804527572783236*^9}, {3.804527723383706*^9, 3.804527741870051*^9}, {
   3.804527856840281*^9, 3.804527913535244*^9}, {3.804527948503746*^9, 
   3.804527949568778*^9}, {3.804528573645267*^9, 3.804528695213153*^9}, 
   3.804528750760364*^9, {3.804528801986573*^9, 3.804528821582273*^9}, {
   3.8045289072652407`*^9, 3.804528908965319*^9}, {3.804536774736354*^9, 
   3.804536801723574*^9}, {3.804609643710669*^9, 3.804609855069942*^9}, {
   3.80460988820603*^9, 3.8046098892046137`*^9}, {3.804609977922142*^9, 
   3.804610033560066*^9}, {3.804610335788042*^9, 3.8046103787935*^9}, {
   3.804610416161296*^9, 3.804610483478544*^9}, {3.804610745730123*^9, 
   3.804610777204698*^9}, {3.804610850446346*^9, 3.804610995104854*^9}, 
   3.804611075539342*^9, {3.804611223346528*^9, 3.804611234564279*^9}, 
   3.804611349084066*^9, 3.804612212006924*^9, {3.804612665003253*^9, 
   3.804612815610608*^9}, 3.804612849204817*^9, {3.804612892413981*^9, 
   3.804612950027315*^9}, {3.804613183142371*^9, 3.804613207571023*^9}, 
   3.804613252912345*^9, 3.804613409353437*^9, {3.80461363196415*^9, 
   3.804613726817829*^9}, {3.804613796421213*^9, 3.8046137976905403`*^9}, {
   3.8046151617777843`*^9, 3.804615181556304*^9}, {3.804615242392284*^9, 
