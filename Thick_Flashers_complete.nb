Cell[TextData[{
 "CircularlyCompletePoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pface",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) CircleDivisions"
}], "Subsubsection",
 CellChangeTimes->{{3.457900740910446*^9, 3.457900768611012*^9}, {
   3.457900810421474*^9, 3.457900828996201*^9}, {3.457900869741046*^9, 
   3.457900871333272*^9}, {3.457901143775663*^9, 3.457901148694468*^9}, 
   3.48519664380492*^9, {3.594749081419354*^9, 3.594749082657612*^9}, 
   3.5951899145384903`*^9, 3.595297494165615*^9, 3.59529752939012*^9, 
   3.5952976929524817`*^9, {3.595297855140208*^9, 
   3.595297855708288*^9}},ExpressionUUID->"3daa025b-3bf8-4aab-b94f-\
c3860f44c0cb"],

Cell[TextData[{
 "CircularlyCompletePoly[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faces",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pface",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 ",",
 StyleBox[" r",
  FontSlant->"Italic"],
 "] takes lists ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["faces",
  FontSlant->"Italic"],
 ", along with a partial face ",
 StyleBox["pface",
  FontSlant->"Italic"],
 " and adds vertices that complete ",
 StyleBox["pface",
  FontSlant->"Italic"],
 " along a circular arc with center ",
 StyleBox["ctr",
  FontSlant->"Italic"],
 " and radius ",
 StyleBox["r",
  FontSlant->"Italic"],
 " that begins at pface\[LeftDoubleBracket]-1\[RightDoubleBracket] and runs \
CCW, connecting to pface\[LeftDoubleBracket]1\[RightDoubleBracket]. New \
vertices, edges, and the new face ",
 StyleBox["pface",
  FontSlant->"Italic"],
 " are appended to the lists ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edge",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["faces",
  FontSlant->"Italic"],
 ", which are modified in-place. Options are:\n\tCircleDivisions \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the number of divisions per full circle to use in the polygonal \
approximation of a circle. CircleDivisions is also used as an option \
elsewhere."
}], "Text",
 CellChangeTimes->{{3.457900833876122*^9, 3.457901130415318*^9}, 
   3.485196343947042*^9, {3.4851964576743517`*^9, 3.485196458585017*^9}, {
