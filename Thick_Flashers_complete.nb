Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyCollinearCleanupAssignedTo", "[", 
   RowBox[{"tobj_TObj", ",", "ccdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"elist", ",", "types", ",", "ntypes"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"elist", "=", 
      RowBox[{
      "ccdata", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"tobj", "[", "EdgeTypes", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ntypes", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"types", "\[LeftDoubleBracket]", 
         RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "\[RightDoubleBracket]"}], "&"}], "/@", "elist"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"EdgeTypes", "\[Rule]", "ntypes"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.707858605723525*^9, 3.707858624332946*^9}, {
   3.707858712702017*^9, 3.707858751523879*^9}, {3.707858955873466*^9, 
