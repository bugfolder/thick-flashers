Cell["\<\
Example. show minimum and maximum angles for this quadrilateral.\
\>", "Text",
 CellChangeTimes->{{3.627500382839064*^9, 3.627500383622518*^9}, {
  3.627503796304261*^9, 
  3.627503807142041*^9}},ExpressionUUID->"96efaefe-8e63-4d1c-b2b3-\
f266d655f2ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pts", ",", "angles", ",", "\[Alpha]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", ".5"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.8", ",", 
          RowBox[{"-", "0.2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"angles", "=", 
      RowBox[{"TwoCycleCriticalTwistAngles", "[", "pts", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<angles/\[Degree] = \>\"", ",", 
       RowBox[{"angles", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"First", "[", "angles", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TestPleat", "[", 
            RowBox[{"#", ",", 
             RowBox[{"First", "[", "angles", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"pts", ",", 
             RowBox[{"RotateLeft", "[", "pts", "]"}]}], "}"}], "]"}]}], "]"}],
         ",", 
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TestPleat", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Last", "[", "angles", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"pts", ",", 
             RowBox[{"RotateLeft", "[", "pts", "]"}]}], "}"}], "]"}]}], 
         "]"}]}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.627498795767407*^9, 3.627498971373961*^9}, {
   3.627499008515687*^9, 3.627499149027169*^9}, {3.627499199000394*^9, 
   3.627499208851523*^9}, {3.627499397530702*^9, 3.627499398385737*^9}, {
   3.627499451649159*^9, 3.627499484796914*^9}, {3.627499621764941*^9, 
