   3.707855761220742*^9}, {3.707855813292909*^9, 3.707855922807098*^9}, 
   3.7078580192220907`*^9, 3.707858156014952*^9, {3.707859309574733*^9, 
   3.707859309595572*^9}, 3.707859360800392*^9, {3.707859756953392*^9, 
   3.707859836857767*^9}, 3.707860126740468*^9},
 CellLabel->
  "In[1245]:=",ExpressionUUID->"ab701303-6a20-4b6c-aa10-26182b1033bd"],

