   3.594749436546071*^9, 3.59474954209256*^9}, {3.594749749408268*^9, 
   3.594749754905495*^9}, {3.594749798136131*^9, 3.594749815020357*^9}, 
   3.5947498977097273`*^9, {3.594749948644008*^9, 3.59474998449109*^9}, {
   3.5947518005649242`*^9, 3.594751807950993*^9}, 3.594751866424372*^9, 
   3.594753331864957*^9, {3.595189915073326*^9, 3.595189915104787*^9}, {
   3.595297495157014*^9, 3.595297495389953*^9}, {3.59529753041999*^9, 
   3.595297530653754*^9}, 3.595297794574432*^9, {3.595298058447447*^9, 
   3.595298139156887*^9}, {3.595298186200344*^9, 3.59529820938074*^9}, {
   3.595298318695895*^9, 3.595298353269989*^9}, {3.595298390715713*^9, 
   3.5952984445459223`*^9}, {3.595298506708417*^9, 3.595298510178279*^9}, 
   3.627328594570418*^9, 3.627328639169278*^9, {3.627407644066461*^9, 
   3.627407675277714*^9}, {3.627407717421915*^9, 3.627407727084745*^9}, {
   3.627407955870165*^9, 3.6274079796356497`*^9}, {3.627408047473649*^9, 
   3.627408066693581*^9}},
 CellLabel->
