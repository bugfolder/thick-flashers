Cell[BoxData[
 RowBox[{
  RowBox[{"Curve2DSystemPlots", "[", 
   RowBox[{"sys_List", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "t", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Curve2D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<c\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Speed2D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<ds\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LeftCurvature2D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Kappa]l\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Curvature2D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<\[Kappa]\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"TangentVector2D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<t\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LeftNormalVector2D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<l\>\""}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NormalVector2D", "[", "t", "]"}], "/.", "sys"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", "\"\<n\>\""}]}], "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.691197387539918*^9, 3.691197446083116*^9}, 
