   3.707860285380719*^9}},ExpressionUUID->"27a1b223-5a44-4069-884c-\
ad0566e5d240"],

Cell[TextData[{
 "CollinearCleanupGraph[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a revised version with collinear degree-2 \
vertices removed."
}], "Text",
 CellChangeTimes->{{3.707843669233399*^9, 3.707843705887328*^9}, {
   3.707852955658692*^9, 3.707852972206331*^9}, 3.707857268745355*^9, 
   3.707859309813449*^9, {3.707859427851668*^9, 3.7078594291316633`*^9}, {
   3.707860228107521*^9, 
   3.707860228795771*^9}},ExpressionUUID->"a9818b68-8725-40d7-b396-\
712d238f26ba"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph being reduced."
}], "Text",
 CellChangeTimes->{{3.707843707838018*^9, 3.707843755815661*^9}, {
  3.707853111188617*^9, 3.707853141196183*^9}, {3.707853225923746*^9, 
  3.707853227540487*^9}},ExpressionUUID->"188b9e0a-1232-4dde-8ad5-\
b382146194df"],

Cell[TextData[{
 "Options:\n\tCollinearTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", specifies the angle below which two edges at a degree-2 vertex will be \
considered to be collinear."
}], "Text",
 CellChangeTimes->{{3.707843759583011*^9, 
  3.707843797007491*^9}},ExpressionUUID->"c36080d7-9a12-4108-9d28-\
f74806b842f6"],

Cell["Returns: the revised TGraph.", "Text",
 CellChangeTimes->{{3.707843802951194*^9, 3.7078438436892643`*^9}, {
  3.707844019089117*^9, 3.707844065666017*^9}, {3.707844112594449*^9, 
  3.707844319501901*^9}, {3.7078532054296007`*^9, 
  3.7078532104929953`*^9}},ExpressionUUID->"e74eeeb3-1339-424b-aa74-\
9e05fb34f49f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CollinearCleanupGraph", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ccdata", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "CollinearCleanupGraph"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ccdata", "=", 
      RowBox[{"CollinearCleanupData", "[", 
       RowBox[{"tobj", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ApplyCollinearCleanup", "[", "ccdata", "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.707857332377728*^9, 3.707857377587949*^9}, {
   3.707859288608979*^9, 3.707859309866687*^9}, 3.707859457801815*^9, {
