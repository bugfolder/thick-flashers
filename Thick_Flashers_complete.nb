Cell[CellGroupData[{

Cell["Extrusion", "Subsection",
 CellChangeTimes->{{3.708871096509448*^9, 
  3.70887109760258*^9}},ExpressionUUID->"790e0cec-e733-4970-b024-\
5f456a419a74"],

Cell[CellGroupData[{

Cell[TextData[{
 "ExtrudeGC[",
 StyleBox["xypts",
  FontSlant->"Italic"],
 ", {",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["xyz",
  FontSlant->"Italic"],
 "]\nExtrudeGC[",
 StyleBox["xypts",
  FontSlant->"Italic"],
 ", {",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.708310347056088*^9, 3.708310367259384*^9}, {
  3.708871140650055*^9, 3.708871158660396*^9}, {3.708871521749938*^9, 
  3.7088715217773952`*^9}, {3.709071918565713*^9, 
  3.709071918599604*^9}},ExpressionUUID->"9121b5ee-5e82-4028-9304-\
4abc78d636f6"],

Cell[TextData[{
 "ExtrudeGC[",
 StyleBox["xypts",
  FontSlant->"Italic"],
 ", {",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["xyz",
  FontSlant->"Italic"],
 "] takes a 2D polygon as a point list and extrudes a 3D solid with Polygon \
faces, given as a GraphicsComplex."
}], "Text",
 CellChangeTimes->{{3.708310379194362*^9, 3.708310407894135*^9}, {
   3.708871498395753*^9, 3.708871565363188*^9}, 
   3.709071918632878*^9},ExpressionUUID->"208ef05d-f9c8-4d48-9ab3-\
ab6777c1cc5d"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["xypts",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that defines a planar closed polygon.\n\t{",
 StyleBox["z0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["z1",
  FontSlant->"Italic"],
 "} \[LongDash] the interval of extrusion.\n\t",
 StyleBox["xyz",
  FontSlant->"Italic"],
 " \[LongDash] a list of unit vectors that define the plane of the polygon \
and direction of extrusion."
}], "Text",
 CellChangeTimes->{{3.708871569805011*^9, 3.708871600015812*^9}, {
  3.708871633179426*^9, 
  3.708871698112944*^9}},ExpressionUUID->"4d3b2596-0271-45f5-a0ae-\
5b4b49daee11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtrudeGC", "[", 
   RowBox[{"xypts_List", ",", 
    RowBox[{"{", 
     RowBox[{"z0_", ",", "z1_"}], "}"}], ",", 
    RowBox[{"xyz_List", ":", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "x", ",", "y", ",", "z", ",", "pts"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "xypts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", "xyz"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"y", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"z", " ", "z1"}]}], "&"}], "/@", "xypts"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"y", 
            RowBox[{
            "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "+", 
           RowBox[{"z", " ", "z0"}]}], "&"}], "/@", "xypts"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"GraphicsComplex", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Polygon", "[", 
           RowBox[{"Range", "[", "n", "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Polygon", "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"1", ",", "n"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"n", "+", 
               RowBox[{"Range", "[", 
                RowBox[{"1", ",", "n"}], "]"}]}], ",", "\[IndentingNewLine]", 
              
              RowBox[{"n", "+", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"2", ",", 
                   RowBox[{"n", "+", "1"}]}], "]"}], ",", "n", ",", "1"}], 
                "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"Range", "[", 
                 RowBox[{"2", ",", 
                  RowBox[{"n", "+", "1"}]}], "]"}], ",", "n", ",", "1"}], 
               "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"Polygon", "[", 
           RowBox[{"Reverse", "[", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"n", "+", "1"}], ",", 
              RowBox[{"2", "n"}]}], "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.708310425872294*^9, 3.708310454742715*^9}, {
   3.708310489030179*^9, 3.708310504634966*^9}, {3.7083105366482*^9, 
