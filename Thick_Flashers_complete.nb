                "s1", ",", "s2", ",", "s3", ",", "s4", ",", "s5", ",", "s6", ",",
                  "s7", ",", "s8"}], "}"}]}], "}"}]}], "]"}], ",", "Blue"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Build", " ", "the", " ", "polyhedron"}], ";", " ", 
