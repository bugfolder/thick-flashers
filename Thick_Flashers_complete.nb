  3.592667745028508*^9}},ExpressionUUID->"06cae59e-8d49-4866-882c-\
831418c5d070"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "types", ",", "tobjcp", ",", "tobjff", ",", 
      "cp", ",", "ff", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "4"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "2"}], ",", 
          RowBox[{"5", "/", "4"}]}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "3"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{
       "B", ",", "V", ",", "B", ",", "B", ",", "B", ",", "B", ",", "B"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjcp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"verts", ",", "edges"}], "]"}], "//", 
        RowBox[{"AddTAssigned", "[", "types", "]"}]}], "//", 
       "AddTPlaneGraph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobjff", "=", 
      RowBox[{"FoldGraph2DAll", "[", "tobjcp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cp", "=", 
      RowBox[{"CreasePatternGraphics", "[", "tobjcp", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"VisibleFoldedFormGraphics", "[", "tobjff", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Build", " ", "with", " ", "the", " ", "constructor"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTDisplayPair", "[", 
       RowBox[{"cp", ",", "ff"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tobj", "[", "CreasePattern", "]"}], ",", 
         RowBox[{"tobj", "[", "FoldedForm2D", "]"}]}], "}"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
    "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.592667159413827*^9, 3.592667371670163*^9}, {
