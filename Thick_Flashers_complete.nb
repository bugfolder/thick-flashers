b57bc5592b81"],

Cell[CellGroupData[{

Cell[TextData[{
 "TriangleArea3D[",
 StyleBox["p, q, r",
  FontSlant->"Italic"],
 "]\nTriangleArea3D[{",
 StyleBox["p, q, r}",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595977396538769*^9, 3.595977415296077*^9}, {
  3.595977563159644*^9, 3.595977577532938*^9}, {3.915801430278407*^9, 
  3.915801434454524*^9}},ExpressionUUID->"5fa46eb0-666c-4cac-aa21-\
4b64d0517dda"],

Cell[TextData[{
 "TriangleArea3D[",
 StyleBox["p, q, r",
  FontSlant->"Italic"],
 "] returns the (positive) area of a triangle whose 3D vertices are ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["r.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.595803611505752*^9, 3.5958036516686683`*^9}, {
  3.595804484920073*^9, 3.595804491960034*^9}, {3.595977441873708*^9, 
  3.595977442718299*^9}, {3.595977581343642*^9, 
  3.5959775942600393`*^9}},ExpressionUUID->"f3baf0b3-29ef-488f-9d72-\
134b59849813"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleArea3D", "[", 
   StyleBox[
    RowBox[{"p_", ",", " ", "q_", ",", " ", "r_"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", "2"}], ")"}], 
   RowBox[{"Mag", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"q", "-", "p"}], ")"}], "\[Cross]", 
     RowBox[{"(", 
      RowBox[{"r", "-", "p"}], ")"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.5959775059758873`*^9, 3.595977519059346*^9}, 
   3.595977566480669*^9, {3.595977604830563*^9, 3.595977625980956*^9}},
 CellLabel->
  "In[629]:=",ExpressionUUID->"8ff08f29-66d8-42c8-9a84-e8aab39658a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TriangleArea3D", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_"}], "}"}], "]"}], ":=", 
  RowBox[{"TriangleArea3D", "[", 
   RowBox[{"p", ",", "q", ",", "r"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.915801451957342*^9, 3.915801473148966*^9}},
 CellLabel->
  "In[630]:=",ExpressionUUID->"e02fecdc-a0ce-4971-82fb-1a3ae0998b2b"],

