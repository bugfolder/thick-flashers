Cell[CellGroupData[{

Cell[TextData[{
 "EmbeddedIntersectify[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) IntersectionTolerance\nIntersectify[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "]\n\t(checked class) TGraph\n\t(options) IntersectionTolerance, \
SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.46281390208912*^9, 3.4628139076710978`*^9}, {
   3.462813971537443*^9, 3.46281398099337*^9}, {3.462848885772493*^9, 
   3.4628488891397867`*^9}, {3.462899329917235*^9, 3.462899346769518*^9}, 
   3.591652191382069*^9, {3.591652294538287*^9, 3.591652306448092*^9}, {
   3.591691908946412*^9, 3.591691920371397*^9}, 3.591728609050655*^9, {
   3.592350118095604*^9, 3.59235011986927*^9}, 3.59243192032475*^9, 
   3.592435848981208*^9, 3.592441213113738*^9, 3.594653999554034*^9, 
   3.594654322423831*^9, {3.595286491768395*^9, 3.595286492888921*^9}, {
   3.595286613688536*^9, 3.595286614864683*^9}, {3.676398129232843*^9, 
   3.6763981332808437`*^9}, 3.6763983488130693`*^9, {3.676399937664008*^9, 
   3.676399955407723*^9}, {3.676469011798554*^9, 3.676469014984731*^9}, {
   3.676472324615561*^9, 
   3.676472328030992*^9}},ExpressionUUID->"20a3b5b7-74e5-43cc-addf-\
f8414a1609aa"],

Cell[TextData[{
 "EmbeddedIntersectify[",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a collection of vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " and edges ",
 StyleBox["edges",
  FontSlant->"Italic"],
 " and creates new edges by putting a vertex at the intersection of every \
pair of line segments. Arguments are:\n\t",
 StyleBox["verts",
  FontSlant->"Italic"],
 " \[LongDash] a list of vertices as coordinate pairs, not necessarily \
distinct\n\t",
 StyleBox["edges",
  FontSlant->"Italic"],
 " \[LongDash] a list of edges, indexed on ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "\nOptions are:\n\tIntersectionTolerance \[Rule] i",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["tol",
  FontSlant->"Italic"],
 " is the tolerance used for potential intersections.\nIt returns a list {",
 StyleBox["emedges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["emap",
  FontSlant->"Italic"],
 "}, where.\n\t",
 StyleBox["emedges",
  FontSlant->"Italic"],
 " is a list of embedded edges (i.e., numerical vertex coordinate pairs)\n\t\
",
 StyleBox["emap",
  FontSlant->"Italic"],
 " is a list that for each new edge gives the index of the original edge it \
came from."
}], "Text",
 CellChangeTimes->{{3.462899409768204*^9, 3.46289951788608*^9}, {
   3.591652082714221*^9, 3.591652093934197*^9}, {3.591652165417175*^9, 
   3.591652183198937*^9}, {3.591652316248911*^9, 3.5916523169585233`*^9}, {
   3.592784114241265*^9, 3.592784119142994*^9}, {3.6763981543053217`*^9, 
   3.676398313717366*^9}, {3.676399942855421*^9, 3.676399999843062*^9}, {
   3.676400393442388*^9, 3.676400393898446*^9}, {3.676469019973614*^9, 
   3.676469066093894*^9}, {3.6764692449228973`*^9, 3.676469261050024*^9}, 
   3.70834296556692*^9},ExpressionUUID->"7b23abca-9c2d-40da-9585-\
672f0ffe0f33"],

Cell[TextData[{
 "Note: versions of this prior to Tessellatica 2.7 returned just the list ",
 StyleBox["emedges",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.67639835341094*^9, 3.676398367689732*^9}, {
  3.67639980059437*^9, 3.676399832461115*^9}, {3.67640030808959*^9, 
  3.676400313790808*^9}, {3.676469136129378*^9, 3.676469140240747*^9}, {
