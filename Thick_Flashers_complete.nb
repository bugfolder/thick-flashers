Cell["A general 3D vertex.", "Text",
 CellChangeTimes->{{3.594897428342053*^9, 3.5948974325336533`*^9}, 
   3.6173158494046187`*^9},ExpressionUUID->"1d557347-3cce-40ff-9d87-\
e99960c25b5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dirs", ",", "tobj", ",", "sal", ",", "dal", ",", "\[Alpha]1", ",", 
      "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4", ",", "\[Gamma]1", ",", 
      "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4", ",", "\[Zeta]", ",", 
      "\[Theta]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "This", " ", "is", " ", "a", " ", "set", " ", "of", " ", "vertex", " ", 
       "directions", " ", "for", " ", "a", " ", "computed", " ", 
       "developable"}], ",", " ", 
      RowBox[{"non", "-", "flat", "-", 
       RowBox[{"foldable", " ", 
        RowBox[{"vertex", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dirs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.9972215532662916`", ",", 
          RowBox[{"-", "0.03575020412413242`"}], ",", 
          "0.06535362733810356`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.6708746129934421`"}], ",", "0.4126653780055379`", ",",
           "0.6161449013312116`"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2779109459922161`"}], ",", 
          RowBox[{"-", "0.8460225167640658`"}], ",", "0.4549850626404195`"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.49522944528027024`"}], ",", 
          RowBox[{"-", "0.8687605191174532`"}], ",", 
          "0.0017195784858716062`"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTDegree4Vertex3D", "[", "dirs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", "\[Alpha]4"}], 
       "}"}], "=", 
      RowBox[{"tobj", "[", "SectorAngles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4"}], 
       "}"}], "=", 
      RowBox[{"tobj", "[", "DihedralAngles", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Zeta]", "=", 
      RowBox[{"tobj", "[", "RulingAngle", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"tobj", "[", "OsculatingAngle", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<OsculatingAngle/\[Degree] = \>\"", ",", 
       RowBox[{"\[Zeta]", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<RulingAngle/\[Degree] = \>\"", ",", 
       RowBox[{"\[Theta]", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<SectorAngles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{"tobj", "[", "SectorAngles", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<DihedralAngles/\[Degree] = \>\"", ",", 
       RowBox[{
        RowBox[{"tobj", "[", "DihedralAngles", "]"}], "/", "\[Degree]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "Identities", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Huffman's Major-Angle \[CapitalDelta] = \>\"", ",", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           FractionBox["\[Gamma]2", "2"], "]"}], "2"], 
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           FractionBox["\[Gamma]4", "2"], "]"}], "2"]], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]3", "]"}], 
          RowBox[{"Sin", "[", "\[Alpha]4", "]"}]}], 
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
          RowBox[{"Sin", "[", "\[Alpha]2", "]"}]}]]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Huffman's Minor-Angle \[CapitalDelta] = \>\"", ",", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           FractionBox["\[Gamma]1", "2"], "]"}], "2"], 
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           FractionBox["\[Gamma]3", "2"], "]"}], "2"]], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]2", "]"}], 
          RowBox[{"Sin", "[", "\[Alpha]3", "]"}]}], 
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]1", "]"}], 
          RowBox[{"Sin", "[", "\[Alpha]4", "]"}]}]]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Eqn 8.51 \[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cot", "[", 
            FractionBox["\[Gamma]1", "2"], "]"}], 
           RowBox[{"Cot", "[", 
            FractionBox["\[Gamma]2", "2"], "]"}], 
           RowBox[{"Csc", "[", 
            RowBox[{"\[Pi]", "-", "\[Alpha]1"}], "]"}]}], "+", 
          RowBox[{"Cot", "[", 
           RowBox[{"\[Pi]", "-", "\[Alpha]1"}], "]"}]}], ")"}], "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cot", "[", 
            FractionBox["\[Gamma]4", "2"], "]"}], 
           RowBox[{"Cot", "[", 
            RowBox[{"-", 
             FractionBox["\[Gamma]3", "2"]}], "]"}], 
           RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}], "+", 
          RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}]}]}], "]"}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Eqn 8.52 \[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cot", "[", 
            FractionBox["\[Gamma]1", "2"], "]"}], 
           RowBox[{"Cot", "[", 
            FractionBox["\[Gamma]4", "2"], "]"}], 
           RowBox[{"Csc", "[", 
            RowBox[{"\[Pi]", "-", "\[Alpha]4"}], "]"}]}], "+", 
          RowBox[{"Cot", "[", 
           RowBox[{"\[Pi]", "-", "\[Alpha]4"}], "]"}]}], ")"}], "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cot", "[", 
            FractionBox["\[Gamma]2", "2"], "]"}], 
           RowBox[{"Cot", "[", 
            RowBox[{"-", 
             FractionBox["\[Gamma]3", "2"]}], "]"}], 
           RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}], "+", 
          RowBox[{"Cot", "[", "\[Alpha]2", "]"}]}], ")"}]}]}], "]"}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Adjacent Cot[\!\(\*FractionBox[\(\[Gamma]1\), \(2\)]\)] \
\[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"Cot", "[", 
         FractionBox["\[Gamma]1", "2"], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]2", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]4", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]2", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]4", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]3", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]1", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}]}], ")"}]}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Adjacent Cot[\!\(\*FractionBox[\(\[Gamma]2\), \(2\)]\)] \
\[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"Cot", "[", 
         FractionBox["\[Gamma]2", "2"], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]3", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]2", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]4", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]1", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]1", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]2", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}]}], ")"}]}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Adjacent Cot[\!\(\*FractionBox[\(\[Gamma]3\), \(2\)]\)] \
\[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"Cot", "[", 
         FractionBox["\[Gamma]3", "2"], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]2", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]2", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]4", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]1", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]4", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]3", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]1", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}]}], ")"}]}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Adjacent Cot[\!\(\*FractionBox[\(\[Gamma]4\), \(2\)]\)] \
\[CapitalDelta] = \>\"", ",", 
       RowBox[{
        RowBox[{"Cot", "[", 
         FractionBox["\[Gamma]4", "2"], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]3", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]1", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]3", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]2", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Cot", "[", 
             FractionBox["\[Gamma]1", "2"], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cot", "[", "\[Alpha]2", "]"}], "+", 
              RowBox[{"Cot", "[", "\[Alpha]4", "]"}]}], ")"}], 
            RowBox[{"Csc", "[", "\[Alpha]1", "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]1", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]4", "]"}]}], "-", 
           RowBox[{
            RowBox[{"Csc", "[", "\[Alpha]2", "]"}], 
            RowBox[{"Csc", "[", "\[Alpha]3", "]"}]}]}], ")"}]}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
