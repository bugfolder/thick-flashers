Cell["Convenience classes only have Make constructors.", "Text",
 CellChangeTimes->{{3.592854477521141*^9, 
  3.592854496744073*^9}},ExpressionUUID->"9e9b5237-9da6-46f9-89fa-\
dee489f973ae"],

Cell[TextData[{
 "MakeTGraph3DAssigned[",
 StyleBox["verts, edges, faces, verts3d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] takes a TGraph and returns an TGraph3DAssigned with Vertices3D defined by \
",
 StyleBox["verts3d and ",
  FontSlant->"Italic"],
 "EdgeTypes given by ",
 StyleBox["types",
  FontSlant->"Italic"],
 ". If no ",
 StyleBox["verts3d",
  FontSlant->"Italic"],
 " are given, a 3D embedding of ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " is used. If no ",
 StyleBox["types",
  FontSlant->"Italic"],
 " are given, U is assumed."
}], "Text",
 CellChangeTimes->{{3.592422276207472*^9, 3.592422281420859*^9}, {
   3.592422323898386*^9, 3.592422352423834*^9}, {3.592422473536278*^9, 
   3.59242247445608*^9}, {3.592422537604371*^9, 3.5924225471314387`*^9}, 
   3.592435861291727*^9, 3.592661138819635*^9, {3.592828885304256*^9, 
