Cell["Example", "Text",
 CellChangeTimes->{{3.629826293494502*^9, 
  3.629826294309113*^9}},ExpressionUUID->"ce30ad4b-93d8-40e9-a517-\
a8a3cd3117cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "w", ",", "d", ",", "types"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"UnitRegularPolygonVertices", "[", "4", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"w", "=", "0.2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"types", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", "M", ",", "V", ",", "V"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RenderTile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "PolygonOffsetTwistTile", ",", "verts", ",", "w", ",", "d", ",", 
         "types"}], "}"}], ",", "TileVertices"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.6298263240615673`*^9, 3.629826402339705*^9}, {
   3.629837261855932*^9, 3.62983728546114*^9}, {3.62983736334065*^9, 
   3.629837363937069*^9}, 3.707758138454176*^9},
 CellLabel->
  "In[2914]:=",ExpressionUUID->"3bfb8672-6ff1-482b-afc5-3eaa4594cf24"],

Cell[TextData[{
 "RenderTile[{PolygonOffsetTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, Tiling, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a rendering of the tiling polygon. Edge directions are created \
from crease assignment and offset. Fills are set based on the sign of ",
 StyleBox["d",
  FontSlant->"Italic"],
 " and the cyclic assignment. All-cylic assignments result in a proper \
2-coloring of the tiling. Mixed assignments (both M and V within the same \
tile) are assigned a third intermediate color, resulting in a (not \
necessarily proper) 3-coloring of the tiling."
}], "Text",
 CellChangeTimes->{{3.62982656442409*^9, 3.6298265729637203`*^9}, {
  3.6298372619440327`*^9, 3.629837285536593*^9}, {3.629839704185357*^9, 
  3.629839732926796*^9}, {3.629839847359008*^9, 3.629839856526931*^9}, {
  3.6298399007795258`*^9, 3.629839912171451*^9}, {3.629840099326803*^9, 
  3.629840127358233*^9}, {3.6299777521388197`*^9, 
  3.629977812750828*^9}},ExpressionUUID->"3227f39a-b9ad-48a0-8b91-\
9bb346799e46"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RenderTile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "PolygonOffsetTwistTile", ",", "verts_List", ",", "w_", ",", "d_", ",", 
      "types_List"}], "}"}], ",", "Tiling", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"polyfill", ",", "edgedirs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TileCheckTypes", "[", 
      RowBox[{"verts", ",", "types"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"polyfill", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"Union", "[", "types", "]"}], "]"}], "\[GreaterEqual]", 
         "2"}], ",", "TilingMedFill", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", "cyclic", " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"d", ">", "0"}], "&&", 
            RowBox[{
             RowBox[{
             "types", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "===", "M"}]}], "||", 
           RowBox[{
            RowBox[{"d", "<", "0"}], "&&", 
            RowBox[{
             RowBox[{
             "types", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "===", "V"}]}]}], ",", "TilingDarkFill", ",", 
          "TilingLightFill"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edgedirs", "=", 
      RowBox[{
       RowBox[{"Sign", "[", "d", "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#", "===", "M"}], ",", 
            RowBox[{"+", "1"}], ",", 
            RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", "types"}], ")"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"RenderTile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"PolygonTile", ",", "verts"}], "}"}], ",", "Tiling", ",", 
       RowBox[{"TilePolyFill", "\[Rule]", "polyfill"}], ",", 
       RowBox[{"TileEdgeArrowDirs", "\[Rule]", "edgedirs"}], ",", "opts"}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.629825816001389*^9, 3.62982581819101*^9}, {
   3.629826043030598*^9, 3.6298260721092653`*^9}, {3.629826144409466*^9, 
   3.629826186112677*^9}, {3.629826222511072*^9, 3.629826287354376*^9}, {
   3.629826484318952*^9, 3.6298264949223022`*^9}, {3.6298265920392437`*^9, 
   3.629826592774555*^9}, 3.629826720295165*^9, {3.629837261971216*^9, 
   3.629837285565906*^9}, 3.629839223350675*^9, {3.629839736129242*^9, 
   3.629839770784979*^9}, {3.62983983060531*^9, 3.629839866225333*^9}, {
   3.629839915142267*^9, 3.6298400785600443`*^9}, {3.630109919345006*^9, 
   3.630109932060356*^9}},
 CellLabel->
  "In[2915]:=",ExpressionUUID->"22814cab-64e5-48ab-8c22-cac5c2593b41"],

