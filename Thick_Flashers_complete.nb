Cell[TextData[{
 "MakeTVertex3DFromTGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["i1",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595276148402703*^9, 3.595276165168747*^9}, {
