Cell[CellGroupData[{

Cell[TextData[{
 "StyledGaussMapGrid[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) UDivisions, VDivisions, GaussMapPointSize, \
SurfaceColorFunction"
}], "Subsubsection",
 CellChangeTimes->{{3.69128243259626*^9, 3.69128249555287*^9}, {
   3.691283154729074*^9, 3.691283196457193*^9}, 3.691283924857367*^9, {
   3.691284080338058*^9, 3.6912840952266893`*^9}, {3.691284796917365*^9, 
   3.691284799143566*^9}, {3.799523187443559*^9, 3.79952323335508*^9}, 
   3.800002728623913*^9, 3.8000027747167387`*^9, {3.800011111629051*^9, 
   3.800011136494359*^9}, {3.800011190277675*^9, 3.800011199415766*^9}, 
   3.800014566498513*^9, 
   3.800016533876184*^9},ExpressionUUID->"07a18d0a-3338-4374-8878-\
edc3e1124572"],

Cell[TextData[{
 "StyledGaussMapGrid[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", {",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "}, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates an array of spheres representing points on the Gauss map of a \
surface."
}], "Text",
 CellChangeTimes->{{3.6912825086792*^9, 3.6912825277633877`*^9}, {
   3.691282564182978*^9, 3.691282567522933*^9}, {3.6912828158255987`*^9, 
   3.691282828806187*^9}, 3.691283924876347*^9, {3.691283956369951*^9, 
   3.6912839686904597`*^9}, {3.7995231874621696`*^9, 
   3.7995232333721857`*^9}, {3.800002752992991*^9, 3.800002789203819*^9}, 
   3.80001120269359*^9, {3.800014540035678*^9, 
   3.800014566517297*^9}},ExpressionUUID->"1f74c187-2743-4d34-81d2-\
c3b9accf093e"],

Cell[TextData[{
 "Arguments are:\n\ts \[LongDash] the surface function, as a vector-valued \
function taking two arguments.\n\t",
 StyleBox["u",
  FontSlant->"Italic"],
 " \[LongDash] the surface normal direction vector, as a vector-valued \
function taking two arguments.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of the first argument of s.\n\t{",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "} \[LongDash] the domain of the second argument of s."
}], "Text",
 CellChangeTimes->{{3.691282570549293*^9, 3.6912826209163637`*^9}, {
  3.691284805259028*^9, 3.691284820041588*^9}, {3.799523187481942*^9, 
  3.79952323338943*^9}},ExpressionUUID->"65f4806d-da20-4ad4-970b-\
788986ebea06"],

Cell[TextData[{
 "Options:\n\tUDivisions \[Rule] ",
 StyleBox["nu",
  FontSlant->"Italic"],
 ", specifies number of divisions in the u-direction (there are nu+1 \
vectors).\n\tVDivisions \[Rule] ",
 StyleBox["nv",
  FontSlant->"Italic"],
 ", specifies number of divisions in the v-direction (there are nv+1 \
vectors).\n\tGaussMapPointSize \[Rule] ",
 StyleBox["size",
  FontSlant->"Italic"],
 ", specifies the size of the points on the surface.\n\tSurfaceColorFunction \
\[Rule] Automatic | ",
 StyleBox["f",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "], specifies the color to use at position {",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.691282625337624*^9, 3.691282810626891*^9}, {
   3.691282844761531*^9, 3.69128285667592*^9}, {3.691283205553375*^9, 
   3.6912832125692053`*^9}, 3.691283636459249*^9, {3.6912837575816717`*^9, 
   3.6912837637537117`*^9}, {3.69128406625499*^9, 3.691284075534457*^9}, 
   3.800002794392981*^9, {3.800006448068396*^9, 3.800006511542076*^9}, 
   3.800016533896668*^9},ExpressionUUID->"d98902fc-167e-4c1e-9d25-\
eb489d26f569"],

Cell["\<\
The points are actually drawn as spheres, so that they stand out nicely from \
any angle. GaussMapPointSize specifies the radius of the point sphere.\
\>", "Text",
 CellChangeTimes->{{3.800007126952679*^9, 
  3.8000071754402637`*^9}},ExpressionUUID->"90fe0078-f466-4fc5-a33b-\
e7de3f282c71"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "StyledGaussMapGrid", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"UDivisions", "\[Rule]", "5"}], ",", "\[IndentingNewLine]", 
     RowBox[{"VDivisions", "\[Rule]", "5"}], ",", "\[IndentingNewLine]", 
     RowBox[{"GaussMapPointSize", "\[Rule]", ".02"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"SurfaceColorFunction", "\[Rule]", "Automatic"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.691282914088623*^9, 3.691282961543233*^9}, 
   3.691283924883078*^9, {3.6912846950062*^9, 3.691284698555337*^9}, {
   3.800002825651476*^9, 3.8000028501562223`*^9}, {3.800003096597303*^9, 
   3.800003127202894*^9}, {3.800006791889615*^9, 3.800006792165624*^9}, 
   3.800007178778219*^9, 3.800014566533401*^9, 3.800016533908701*^9},
 CellLabel->
  "In[3752]:=",ExpressionUUID->"67dd605e-ca9c-4868-a6b2-b3a15b490072"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GaussMapPointSize", "::", "usage"}], 
   "=", "\"\<GaussMapPointSize is an option to StyledGaussMapGrid that \
specifies the point size to use for the grid points.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.80000653227665*^9, 3.8000065510520782`*^9}, 
   3.800014566549893*^9},
 CellLabel->
  "In[3753]:=",ExpressionUUID->"cabfedfb-b131-46fe-804c-5552a5f85919"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StyledGaussMapGrid", "[", 
   RowBox[{"uu_Function", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v0_", ",", "v1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nvl", ",", "nu", ",", "nv", ",", "gmps", ",", "sncf", ",", "du", ",", 
      "dv"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nvl", "=", 
      RowBox[{
       RowBox[{"NormalVectorLength", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledGaussMapGrid", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nu", "=", 
      RowBox[{
       RowBox[{"UDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledGaussMapGrid", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{
       RowBox[{"VDivisions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledGaussMapGrid", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gmps", "=", 
      RowBox[{
       RowBox[{"GaussMapPointSize", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledGaussMapGrid", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sncf", "=", 
      RowBox[{
       RowBox[{"SurfaceColorFunction", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "StyledGaussMapGrid", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sncf", "===", "Automatic"}], ",", 
       RowBox[{"sncf", "=", 
        RowBox[{"SurfaceNormalVectorColor", "&"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"du", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u1", "-", "u0"}], ")"}], "/", "nu"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dv", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v1", "-", "v0"}], ")"}], "/", "nv"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Sphere", "[", 
          RowBox[{
           RowBox[{"uu", "[", 
            RowBox[{"u", ",", "v"}], "]"}], ",", "gmps"}], "]"}], ",", 
         RowBox[{"sncf", "[", 
          RowBox[{"u", ",", "v"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "u0", ",", "u1", ",", "du"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "v0", ",", "v1", ",", "dv"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.691282860417791*^9, 3.6912829073092*^9}, {
   3.691283660170455*^9, 3.691283781693937*^9}, {3.691283851839113*^9, 
   3.691283865145548*^9}, {3.691283924889424*^9, 3.69128392490695*^9}, {
   3.691283991721624*^9, 3.691284041203856*^9}, {3.691284109201885*^9, 
   3.691284118309393*^9}, 3.691284167299905*^9, 3.691284413135786*^9, {
   3.799523187489857*^9, 3.799523233396883*^9}, 3.800002840564691*^9, {
   3.800002985581688*^9, 3.800003046755038*^9}, {3.800006563102805*^9, 
   3.800006615381674*^9}, {3.800006720864802*^9, 3.800006771118251*^9}, {
   3.800006919098287*^9, 3.80000691967114*^9}, {3.800006976027561*^9, 
   3.800006993664007*^9}, 3.800007186299844*^9, 3.800011207261926*^9, {
   3.800014566554535*^9, 3.800014566580432*^9}, 3.800016533913308*^9},
 CellLabel->
  "In[3754]:=",ExpressionUUID->"63ebec4c-84e2-4f81-9af0-68af20e59756"],

Cell["Example. Surface normals and Gauss map, using a color grid.", "Text",
 CellChangeTimes->{{3.691284231613813*^9, 3.691284232358836*^9}, 
   3.691284685760316*^9, {3.800006855414725*^9, 
   3.800006862518116*^9}},ExpressionUUID->"1bdeacbd-ab9d-4a0a-9ef5-\
b0a1dd9393c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "ss", ",", "uu", ",", "u0", ",", "u1", ",", "v0", ",",
       "v1", ",", "sncf", ",", "sng", ",", "gmg", ",", "ggs", ",", "ggm"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ss", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", "#2", ",", 
         RowBox[{
          RowBox[{"a", " ", 
           SuperscriptBox["#1", "2"]}], "+", 
          RowBox[{"b", " ", 
           SuperscriptBox["#2", "2"]}]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", "a", " ", "#1"}], 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["#1", "2"]}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["b", "2"], " ", 
              SuperscriptBox["#2", "2"]}]}]]]}], ",", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", "b", " ", "#2"}], 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["#1", "2"]}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["b", "2"], " ", 
              SuperscriptBox["#2", "2"]}]}]]]}], ",", 
         FractionBox["1", 
          SqrtBox[
           RowBox[{"1", "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["a", "2"], " ", 
             SuperscriptBox["#1", "2"]}], "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["b", "2"], " ", 
             SuperscriptBox["#2", "2"]}]}]]]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".3"}], ",", 
        RowBox[{"-", ".5"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
