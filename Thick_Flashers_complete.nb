          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pts1", "]"}], "]"}], ",", "Red"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pts2", "]"}], "]"}], ",", "Green"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "/@", "pts1"}], ",", 
           RowBox[{"PointSize", "[", ".025", "]"}], ",", 
           RowBox[{"Darker", "[", "Red", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
