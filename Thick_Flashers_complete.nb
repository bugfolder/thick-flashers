 RowBox[{
  RowBox[{"DevelopabilityExcess", "[", "sectorangles_List", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Plus", "@@", "sectorangles"}], ")"}], "-", 
   RowBox[{"2", "\[Pi]"}]}]}]], "Input",
 CellChangeTimes->{{3.594757103454548*^9, 3.59475712894868*^9}},
 CellLabel->
  "In[594]:=",ExpressionUUID->"0843d273-7f07-46b9-91bb-cc038e71a765"],

