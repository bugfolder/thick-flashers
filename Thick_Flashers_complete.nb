Cell[TextData[{
 "MakeOffsetGoldbergTilingGraph[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["o",
  FontSlant->"Italic"],
 "] returns a TGraph representing a plane graph of an offset Goldberg \
tiling."
}], "Text",
 CellChangeTimes->{{3.485219610267399*^9, 3.485219631458827*^9}, {
