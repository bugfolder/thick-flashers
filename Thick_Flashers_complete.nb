Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.629827371328141*^9, 
  3.629827371807748*^9}},ExpressionUUID->"683f83a1-fedd-440a-9634-\
257c0eb7dd9d"],

Cell["\<\
Since all centered twist tiles have the same twist angle \[Alpha] for the \
same tilt angle \[Tau], an alternate form of specifying the tiles is to use \
tile parameters (w, \[Alpha]), rather than (w, \[Tau]). So we provide an \
alternate tile type.\
\>", "Text",
 CellChangeTimes->{{3.629827374288644*^9, 
  3.629827437980804*^9}},ExpressionUUID->"37b3995a-01b4-4c70-aa50-\
c6d8198c11e6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "{PolygonCenteredTwist",
 "AltTile,",
 " ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}"
}], "Subsubsection",
 CellChangeTimes->{{3.629825581181041*^9, 3.62982559509096*^9}, {
   3.629825719482769*^9, 3.629825801430343*^9}, {3.629825855794893*^9, 
   3.629825863308705*^9}, {3.629827301405672*^9, 3.629827301660526*^9}, {
   3.629827360634171*^9, 3.629827360824616*^9}, 3.630149588887414*^9, 
   3.630149649518065*^9, 
   3.630160566333083*^9},ExpressionUUID->"ddaf8cc3-53dc-4de1-8c74-\
a2a67792581b"],

Cell[TextData[{
 "{PolygonCenteredTwist",
 "AltTile,",
 " ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Alpha], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "} is a tiletype that describes a simple flat twist in a specified polygon \
where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \[Alpha] \
is the twist angle, and ",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley. "
}], "Text",
 CellChangeTimes->{{3.457724672224969*^9, 3.457724676219144*^9}, {
   3.457738952692883*^9, 3.457738953914077*^9}, {3.457740040392891*^9, 
