Cell[CellGroupData[{

Cell[TextData[{
 "HatVertexDevelopabilityConditions2D[",
 StyleBox["sectorhats, opts",
  FontSlant->"Italic"],
 "]\n\t(options) HatExcess, HatMatrixSplit"
}], "Subsubsection",
 CellChangeTimes->{{3.595611881981205*^9, 3.595611925560431*^9}, {
   3.59561203019345*^9, 3.595612034112474*^9}, {3.5956125976681557`*^9, 
   3.5956125984762783`*^9}, 3.595700504972647*^9, {3.595700830194435*^9, 
   3.5957008314010777`*^9}, {3.5957021694013433`*^9, 3.595702170993789*^9}, 
   3.5957051878569517`*^9, {3.596023026223368*^9, 3.596023029064384*^9}, 
   3.596023070280302*^9, {3.596023517682484*^9, 3.596023518272595*^9}, {
   3.5960307259942303`*^9, 3.596030727599366*^9}, {3.596030806435885*^9, 
   3.59603080692213*^9}},ExpressionUUID->"60785d6b-b762-4743-8816-\
9c9acd6d3f9f"],

Cell[TextData[{
 "HatVertexDevelopabilityConditions2D[",
 StyleBox["sectorhats",
  FontSlant->"Italic"],
 "] returns the 2x2 matrix whose entries must be zero in order for the sum of \
the sector angles around the vertex to be 2\[Pi]",
 StyleBox["n",
  FontSlant->"Italic"],
 " for some integer ",
 StyleBox["n",
  FontSlant->"Italic"],
 " or 2\[Pi]",
 StyleBox["n",
  FontSlant->"Italic"],
 "+ArcHat[",
 StyleBox["excess",
  FontSlant->"Italic"],
 "] if you provided an excess angle. Options are:\n\tHatExcess \[Rule] ",
 StyleBox["excess",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["excess",
  FontSlant->"Italic"],
 " is the hat transformation of the excess angle, or 0 for a developable \
vertex.\n\tHatMatrixSplit \[Rule] Automatic | None | ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where n is the number of matrices on the left and the remainder are on \
the right. None puts all of the numerators on the left. Automatic splits them \
as evenly as possible between left and right. In either case, denominators \
are cleared from either side so that each entry is a polynomial."
}], "Text",
 CellChangeTimes->{{3.595611934877542*^9, 3.595611964333376*^9}, {
   3.595612011691249*^9, 3.595612082429765*^9}, {3.595612112636605*^9, 
   3.595612138642123*^9}, 3.59561260392588*^9, {3.595700505096412*^9, 
   3.595700564614696*^9}, {3.595700833881599*^9, 3.595700850199109*^9}, {
   3.595702165387916*^9, 3.595702166266199*^9}, 3.5957022075537148`*^9, 
   3.595705188030451*^9, 3.596023497631353*^9, {3.596030808674378*^9, 
   3.596030887957447*^9}},ExpressionUUID->"a92607f3-ed24-405b-928d-\
4aebbf726914"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HatVertexDevelopabilityConditions2D", "[", 
   RowBox[{
    StyleBox[
     RowBox[{
      StyleBox["sectorhats_",
       FontSlant->"Italic"], "List"}]], ",", "opts___"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"HatRotationConditions2D", "[", 
   RowBox[{"sectorhats", ",", "opts"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595612141092373*^9, 3.595612305947384*^9}, {
   3.59561235540265*^9, 3.595612355904353*^9}, {3.5956123945569077`*^9, 
