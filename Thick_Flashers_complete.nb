   3.694218471807096*^9, 3.6942184743823833`*^9}, {3.797958405540965*^9, 
   3.797958426213867*^9}, 3.79857320891115*^9, {3.798576234758256*^9, 
   3.798576244797916*^9}, 
   3.7986245590458803`*^9},ExpressionUUID->"8eea05a1-55e6-47d9-8a8c-\
e8dce29b9682"],

Cell[TextData[{
 "Returns: a list {",
 StyleBox["bb",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dd",
  FontSlant->"Italic"],
 ", \[Sigma]} for the new surface."
}], "Text",
