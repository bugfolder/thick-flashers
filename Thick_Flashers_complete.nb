          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"LineStyle", "\[Rule]", "MountainLine"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{"gc", ",", "gopts"}], "]"}]}]}], "]"}]}]], "Input",
