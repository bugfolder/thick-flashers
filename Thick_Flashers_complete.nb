Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "\[Gamma]0", ",", "u0", ",", "u1", ",", "ff", ",", "rrL", ",", 
      "rrR", ",", "f", ",", "rL", ",", "rR", ",", "ui", ",", "fi", ",", 
      "ti"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Gamma]0", "=", 
      RowBox[{"120", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", "fi", ",", "ti"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "s", "]"}], ",", 
          RowBox[{"Sin", "[", "s", "]"}], ",", "0"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrL", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}]}], " ", 
          RowBox[{"Cos", "[", "#1", "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}]}], " ", 
          RowBox[{"Sin", "[", "#1", "]"}]}], ",", 
         RowBox[{"Sin", "[", 
          FractionBox["\[Gamma]0", "2"], "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrR", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[Gamma]0", "2"], "]"}], " ", 
          RowBox[{"Cos", "[", "#1", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[Gamma]0", "2"], "]"}], " ", 
          RowBox[{"Sin", "[", "#1", "]"}]}], ",", 
         RowBox[{"Sin", "[", 
          FractionBox["\[Gamma]0", "2"], "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
      RowBox[{"FoldAcrossRight3D", "[", 
       RowBox[{"ff", ",", "rrL", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rrR", "//", "PrettyParameters"}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CurvedFoldGraphics3D", "[", 
       RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}], "\[IndentingNewLine]", "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
