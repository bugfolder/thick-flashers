             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Sphere", "[", 
               RowBox[{"p2", ",", ".1"}], "]"}], ",", "Blue"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], ",", 
          RowBox[{"Axes", "\[Rule]", "True"}], ",", 
