Cell[TextData[{
 "TransformGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 ", ",
 StyleBox["fn",
  FontSlant->"Italic"],
 "] applies a function to all point coordinates in the GraphicsComplex object."
}], "Text",
 CellChangeTimes->{{3.912660819130587*^9, 
  3.912660845248693*^9}},ExpressionUUID->"bc5919db-3809-4810-8764-\
1c9126e50614"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["gc",
  FontSlant->"Italic"],
 " \[LongDash] a GraphicsComplex object.\n\t",
 StyleBox["fn",
  FontSlant->"Italic"],
 " \[LongDash] a function to be applied to the point."
}], "Text",
 CellChangeTimes->{{3.912660864063431*^9, 
  3.912660885266059*^9}},ExpressionUUID->"9e771faa-6044-4606-bd36-\
5fa21e7ec795"],

Cell["Returns: the modified GraphicsComplex.", "Text",
 CellChangeTimes->{{3.912660887454228*^9, 
  3.912660893656911*^9}},ExpressionUUID->"40daaf8b-b7a1-4b19-840b-\
f72a59d2e29d"],

Cell["\<\
This is similar to the behavior of FunctionTransform, which acts on the \
coordinates of Graphics and Graphics3D elements.\
\>", "Text",
 CellChangeTimes->{{3.912660897930804*^9, 
  3.912660938619504*^9}},ExpressionUUID->"4be85e6f-acb8-4fa1-b403-\
de4f6c209d44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TransformGC", "[", 
   RowBox[{
    RowBox[{"GraphicsComplex", "[", 
     RowBox[{"pts_", ",", "more___"}], "]"}], ",", "fn_Function"}], "]"}], ":=", 
  RowBox[{"GraphicsComplex", "[", 
   RowBox[{
    RowBox[{"fn", "/@", "pts"}], ",", "more"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.912660949470752*^9, 3.91266102661611*^9}, {
