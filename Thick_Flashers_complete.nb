Cell[CellGroupData[{

Cell[TextData[{
 "PruneUnivalentEdges[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked class) ",
 "TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.591645885550441*^9, 3.5916458985395327`*^9}, 
   3.5917286084411983`*^9, {3.592349361170568*^9, 3.592349371831595*^9}, {
   3.592432320025783*^9, 3.592432320784742*^9}, 
   3.592435847077609*^9},ExpressionUUID->"c1321581-4e57-4826-9cf0-\
543128ff4ed1"],

Cell[TextData[{
 "PruneUnivalentEdges[t",
 StyleBox["obj",
  FontSlant->"Italic"],
 "] takes a ",
 "TGraph",
 " and repeatedly removes any edges that are connected to a univalent \
(degree-1) vertex until there are no more univalent vertices. It returns a \
TObj containing the pruned list."
}], "Text",
 CellChangeTimes->{{3.457624083531452*^9, 3.4576240856496077`*^9}, {
