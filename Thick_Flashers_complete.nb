Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dirs", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationZMatrix3D", "[", 
          RowBox[{
           RowBox[{"-", "10."}], "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", 
       RowBox[{"dirs", ",", 
        RowBox[{"OffsetAngle", "\[Rule]", 
         RowBox[{"20", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"VertexCreasePatternGraphics", "[", "tobj", "]"}], "/.", 
          RowBox[{"OrigamiStyle", "[", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Red", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "#"}], 
                 "}"}], "]"}], "&"}], "/@", "dirs"}]}], "}"}], ",", 
           RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tobj", "//", "GetAllRules"}], "//", "ColumnForm"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.442617298550125*^9, 3.442617473782814*^9}, 
