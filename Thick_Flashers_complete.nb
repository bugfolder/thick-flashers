Cell["Converting from TGraph2D+TAssigned to TGraph3DAssigned", "Subsection",
 CellChangeTimes->{{3.731193327081547*^9, 
  3.7311933395293922`*^9}},ExpressionUUID->"44c9b4bf-e44b-4814-8a55-\
7a67629de414"],

Cell[CellGroupData[{

Cell[TextData[{
 "Graph2DAssignedToGraph3DAssigned[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph2D, TAssigned"
}], "Subsubsection",
 CellChangeTimes->{{3.7311933839256988`*^9, 
  3.731193407577333*^9}},ExpressionUUID->"427c7352-5cf2-4efa-a65e-\
56becfb3c44f"],

Cell["\<\
Graph2DAssignedToGraph3DAssigned[tobj] converts a TGraph2D+TAssigned to a \
flat-folded TGraph3DAssigned.\
\>", "Text",
 CellChangeTimes->{{3.731193427534412*^9, 
  3.7311934467142367`*^9}},ExpressionUUID->"8be7206c-49ae-4a47-be1e-\
96a81231d4de"],

Cell["Returns: a TGraph3DAssigned.", "Text",
 CellChangeTimes->{{3.731193451098257*^9, 
  3.731193458136938*^9}},ExpressionUUID->"6e9fb1a3-376c-4b54-8c90-\
6eb12963b055"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["Graph2DAssignedToGraph3DAssigned", "Input"], "[", "tobj_TObj", 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tobj1", ",", "foldangles"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"AssertClasses", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"{", 
        RowBox[{"TGraph2D", ",", "TAssigned"}], "}"}], ",", 
       StyleBox["Graph2DAssignedToGraph3DAssigned", "Input"]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"tobj", "//", 
       RowBox[{"AddTGraph3D", "[", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"foldangles", "=", 
      RowBox[{"TypeToFlatFoldAngle", "/@", 
       RowBox[{"tobj", "[", "EdgeTypes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FoldGraph3D", "[", 
      RowBox[{"tobj", ",", "foldangles"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.731193355106802*^9, 3.731193377273655*^9}, {
  3.731193497146095*^9, 3.731193533834732*^9}, {3.731193624500083*^9, 
  3.731193645995212*^9}},
 CellLabel->
  "In[1983]:=",ExpressionUUID->"fb8601d3-3937-4742-8d3f-b552e52e4e62"],

