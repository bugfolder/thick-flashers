   3.643227360985037*^9, 
   3.643227361680456*^9}},ExpressionUUID->"e7ce9ee2-a973-407a-aba8-\
670205c3632e"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{
