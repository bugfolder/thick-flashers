Cell[CellGroupData[{

Cell["Triangulated cylinders", "Subsection",
 CellChangeTimes->{{3.6433625364987497`*^9, 3.643362550026461*^9}, {
  3.702999781454208*^9, 
  3.702999784973612*^9}},ExpressionUUID->"e1ba3c59-75f8-40d6-a8db-\
28251ca392ba"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.64336254146822*^9, 
  3.643362542026284*^9}},ExpressionUUID->"32ed30c5-7162-4c8e-a6d2-\
da4e485c473d"],

Cell["\<\
If you join the ends of a Yoshimura pattern, you get a rigid tube. For \
certain sets of parameters, the tube is bistable and transitions between the \
two states via a twisting motion. These functions compute crease patterns and \
folded forms of such tubes.\
\>", "Text",
 CellChangeTimes->{{3.643362558008868*^9, 3.643362600878898*^9}, {
  3.643375070162092*^9, 
  3.643375095399241*^9}},ExpressionUUID->"74d6fe21-14dd-4580-bddf-\
999517b2c895"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TwistTubeParametersRH[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 "}]\nTwistTubeParametersLH[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 "}]\nTwistTubeParameters[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dir}",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.654260948072319*^9, 3.654260958341356*^9}, {
  3.654262223660147*^9, 3.654262231912637*^9}, {3.654262641090583*^9, 
  3.654262646369341*^9}},ExpressionUUID->"b986f4fb-bfff-4d9a-a037-\
886e528a1d05"],

Cell[TextData[{
 "TwistTubeParametersRH[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 "}] returns the list {\[Alpha], ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", {d\[Phi]1, d\[Phi]2}} that describe the parameters of a right-handed \
twist tube segment, where\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " is the rotational order.\n\t",
 StyleBox["h1",
  FontSlant->"Italic"],
 " is one design height that the folded form can assume;\n\t",
 StyleBox["h2",
  FontSlant->"Italic"],
 " is the second design height that the folded form can assume;\nThe return \
parameters describe the crease pattern and folded form; \n\t\[Alpha] is the \
lower left corner angle of the parallelogram in the CP (the one that has a \
valley fold)\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the length of the tilted sides of each parallelogram in the CP\n\td\
\[Phi]1 and d\[Phi]2 are the the rotational phase shifts of the top of the \
folded form"
}], "Text",
 CellChangeTimes->{{3.654260467373205*^9, 3.654260620913128*^9}, {
  3.654260992572318*^9, 3.654261082509302*^9}, {3.654262287721127*^9, 
  3.6542623221419477`*^9}, {3.654262453318296*^9, 
  3.654262456981316*^9}},ExpressionUUID->"32506b81-9173-41da-a289-\
b67f498433fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwistTubeParameters", "::", "badhs"}], 
   "=", "\"\<Height spec `1` is invalid because the height difference is too \
large.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.643319945767899*^9, 3.64332002387447*^9}, {
   3.643320064216872*^9, 3.643320098211975*^9}, {3.643324619091144*^9, 
   3.643324620586535*^9}, 3.64336315036825*^9, {3.654261470515713*^9, 
   3.6542614727735863`*^9}},
 CellLabel->
  "In[2567]:=",ExpressionUUID->"5c3f6f3d-da9b-4c95-8480-3a8a46b2678b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwistTubeParametersRH", "[", 
   RowBox[{"m_", ",", 
    RowBox[{"{", 
     RowBox[{"h1_", ",", "h2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Phi]", ",", "x1", ",", "x2", ",", "d\[Phi]1", ",", "d\[Phi]2", ",", 
      "r", ",", "\[Alpha]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]", "=", 
      RowBox[{"\[Pi]", "/", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          SuperscriptBox["h1", "2"], "-", 
          SuperscriptBox["h2", "2"]}], "]"}], ">", 
        RowBox[{
         RowBox[{"Cot", "[", "\[Phi]", "]"}], 
         RowBox[{"Csc", "[", "\[Phi]", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"TwistTubeParameters", "::", "badhs"}], ",", 
          RowBox[{"{", 
           RowBox[{"h1", ",", "h2"}], "}"}]}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"x1", "=", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
          RowBox[{
           SqrtBox[
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["h1", "2"], "-", 
                 SuperscriptBox["h2", "2"]}], ")"}], "2"]}], "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"Cot", "[", "\[Phi]", "]"}], "2"], " ", 
              SuperscriptBox[
               RowBox[{"Csc", "[", "\[Phi]", "]"}], "2"]}]}]], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}], 
       RowBox[{"1", "+", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["h1", "2"], "-", 
          SuperscriptBox["h2", "2"]}], ")"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["h1", "2"], "-", 
             SuperscriptBox["h2", "2"]}], ")"}]}], ")"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Phi]"}], "]"}]}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"x2", "=", "\[InvisibleSpace]", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
          RowBox[{
           SqrtBox[
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["h1", "2"], "-", 
                 SuperscriptBox["h2", "2"]}], ")"}], "2"]}], "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"Cot", "[", "\[Phi]", "]"}], "2"], " ", 
              SuperscriptBox[
               RowBox[{"Csc", "[", "\[Phi]", "]"}], "2"]}]}]], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}], 
       RowBox[{"1", "-", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["h1", "2"], "-", 
          SuperscriptBox["h2", "2"]}], ")"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["h1", "2"], "-", 
             SuperscriptBox["h2", "2"]}], ")"}]}], ")"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Phi]"}], "]"}]}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]1", "=", 
      RowBox[{"2", " ", 
       RowBox[{"ArcTan", "[", "x1", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d\[Phi]2", "=", 
      RowBox[{"2", 
       RowBox[{"ArcTan", "[", "x2", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["h2", "2"], "+", 
        FractionBox[
         RowBox[{
          SuperscriptBox["x2", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Csc", "[", "\[Phi]", "]"}], "2"]}], 
         RowBox[{"1", "+", 
          SuperscriptBox["x2", "2"]}]]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"\[Pi]", "-", 
       RowBox[{"ArcCos", "[", 
        FractionBox[
         RowBox[{"x2", " ", 
          RowBox[{"(", 
           RowBox[{"x2", "-", 
            RowBox[{"Cot", "[", "\[Phi]", "]"}]}], ")"}]}], 
         SqrtBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["x2", "2"]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["h2", "2"], " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                SuperscriptBox["x2", "2"]}], ")"}]}], "+", 
             RowBox[{
              SuperscriptBox["x2", "2"], " ", 
              SuperscriptBox[
               RowBox[{"Csc", "[", "\[Phi]", "]"}], "2"]}]}], ")"}]}]]], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "r", ",", 
       RowBox[{"{", 
        RowBox[{"d\[Phi]1", ",", "d\[Phi]2"}], "}"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.654260428921097*^9, 3.65426046085356*^9}, {
   3.654260626138051*^9, 3.654260823982753*^9}, {3.654260882165799*^9, 
   3.654260903193404*^9}, {3.65426111535371*^9, 3.654261118578017*^9}, {
   3.654261210791133*^9, 3.654261279507449*^9}, {3.654261314505527*^9, 
   3.654261334791469*^9}, {3.654261368037627*^9, 3.654261385188014*^9}, {
   3.654261425365273*^9, 3.65426144264643*^9}, {3.6542614820085278`*^9, 
   3.654261523959357*^9}, 3.654262181647417*^9, {3.654262327026987*^9, 
   3.654262327836342*^9}, 3.65426246716969*^9},
 CellLabel->
  "In[2568]:=",ExpressionUUID->"41201fbd-24b8-46ef-8ac6-da796102b4e1"],

Cell["Example", "Text",
 CellChangeTimes->{{3.654261546183151*^9, 
  3.654261546918998*^9}},ExpressionUUID->"64242357-6013-46ef-bff0-\
42672acc1f78"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "h1", ",", "h2", ",", "\[Alpha]", ",", "r", ",", "d\[Phi]1", ",",
       "d\[Phi]2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"h1", "=", ".9"}], ";", "\[IndentingNewLine]", 
     RowBox[{"h2", "=", ".1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "r", ",", "d\[Phi]1", ",", "d\[Phi]2"}], 
       "}"}], "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"TwistTubeParametersRH", "[", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"h1", ",", "h2"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<h1\>\"", "\[Rule]", "h1"}], ",", 
        RowBox[{"\"\<h2\>\"", "\[Rule]", "h2"}], ",", 
        RowBox[{"\"\<\[Alpha]/\[Degree]\>\"", "\[Rule]", 
         RowBox[{"\[Alpha]", "/", "\[Degree]"}]}], ",", 
        RowBox[{"\"\<r\>\"", "\[Rule]", "r"}], ",", 
        RowBox[{"\"\<d\[Phi]1/\[Degree]\>\"", "\[Rule]", 
         RowBox[{"d\[Phi]1", "/", "\[Degree]"}]}], ",", 
        RowBox[{"\"\<d\[Phi]2/\[Degree]\>\"", "\[Rule]", 
         RowBox[{"d\[Phi]2", "/", "\[Degree]"}]}]}], "}"}], "//", 
      "ColumnForm"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.654261730145712*^9, 3.654261899922448*^9}, {
  3.654262038875855*^9, 3.654262044753956*^9}, {3.654262199833839*^9, 
  3.654262206127318*^9}, {3.654262475814844*^9, 3.654262491343521*^9}},
 CellLabel->
  "In[2569]:=",ExpressionUUID->"286851ea-f9d8-4327-81b0-2fc454c753a1"],

Cell[TextData[{
 "TwistTubeParametersLH[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 "}] does the same thing but for a left-handed twist. \[Alpha] is still the \
lower left corner angle, but now it doesn\[CloseCurlyQuote]t have a valley \
fold through it."
}], "Text",
 CellChangeTimes->{{3.6542622452107153`*^9, 3.6542622516289268`*^9}, {
  3.654262337708964*^9, 
  3.6542623878013988`*^9}},ExpressionUUID->"71639fcb-d972-4760-afe7-\
6736aaa1d8ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwistTubeParametersLH", "[", 
   RowBox[{"m_", ",", 
    RowBox[{"{", 
     RowBox[{"h1_", ",", "h2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "r", ",", "d\[Phi]1", ",", "d\[Phi]2"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "r", ",", "d\[Phi]1", ",", "d\[Phi]2"}], 
       "}"}], "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"TwistTubeParametersRH", "[", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"h1", ",", "h2"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Pi]", "-", "\[Alpha]"}], ",", "r", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "d\[Phi]1"}], ",", 
         RowBox[{"-", "d\[Phi]2"}]}], "}"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.654262397995851*^9, 3.654262431961233*^9}, {
  3.654262505737078*^9, 3.654262593863049*^9}},
 CellLabel->
  "In[2570]:=",ExpressionUUID->"7d8b69e3-d47e-401d-a659-f2e9f5bdfde1"],

Cell["Example", "Text",
 CellChangeTimes->{{3.654261546183151*^9, 
  3.654261546918998*^9}},ExpressionUUID->"430aa56b-f443-483b-884e-\
3d63af51fe62"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "h1", ",", "h2", ",", "\[Alpha]", ",", "r", ",", "d\[Phi]1", ",",
       "d\[Phi]2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "5"}], ";", "\[IndentingNewLine]", 
     RowBox[{"h1", "=", ".9"}], ";", "\[IndentingNewLine]", 
     RowBox[{"h2", "=", ".1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "r", ",", "d\[Phi]1", ",", "d\[Phi]2"}], 
       "}"}], "=", 
