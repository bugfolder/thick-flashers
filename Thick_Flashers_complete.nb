   3.671182048382059*^9}, 3.671182127130238*^9, 3.671182163011779*^9, 
   3.671182251838939*^9, {3.671182577554877*^9, 3.671182617337886*^9}, {
   3.67120710574034*^9, 3.671207158854443*^9}, {3.671207352855898*^9, 
   3.671207368995403*^9}, {3.67124377944036*^9, 3.671243786480406*^9}, {
   3.6712462311154747`*^9, 3.671246236613549*^9}, 3.671246344682671*^9, {
   3.6712473329556437`*^9, 3.671247332975922*^9}, {3.671250308280368*^9, 
   3.671250324061421*^9}, {3.6712504478471203`*^9, 3.67125045456723*^9}, 
   3.6712506461439943`*^9, {3.67125070285382*^9, 3.671250703397125*^9}, {
   3.671250747226901*^9, 3.671250769521792*^9}, {3.671250806462312*^9, 
   3.671250926398635*^9}, {3.671250976179468*^9, 3.671251052512512*^9}, {
   3.671290402682025*^9, 3.671290402990567*^9}, 3.671290605857765*^9, 
   3.671290947971496*^9, {3.671377091673734*^9, 3.671377093400069*^9}, 
   3.671553777391135*^9, {3.673101661899107*^9, 3.673101674220333*^9}, {
   3.6753556541330967`*^9, 3.6753556603483343`*^9}},
 CellLabel->
  "In[3572]:=",ExpressionUUID->"89dce1a6-2544-489c-9033-3feaef46fee6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "TwistJoinedTubes[",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dz",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) TwistDirection, TitleAxialAngle, ",
 "TiltAzimuthalAngle, ",
 "TubeHeight, PanelOverlap, TypeMinimumAngle, TypeMaximumAngle"
}], "Subsubsection",
 CellChangeTimes->{{3.6711788953470993`*^9, 3.671178896638007*^9}, {
   3.67117922313023*^9, 3.671179234799026*^9}, {3.671179279851207*^9, 
   3.671179281202106*^9}, 3.671290969759507*^9, {3.671332896415043*^9, 
   3.671332901260229*^9}, {3.6715283040522547`*^9, 3.67152830482096*^9}, {
   3.673101661954793*^9, 3.673101674247295*^9}, {3.675322972469213*^9, 
   3.6753229895706367`*^9}, {3.6753241667824717`*^9, 3.675324167777259*^9}, {
   3.676111600803761*^9, 
   3.676111607793683*^9}},ExpressionUUID->"a4397268-ec97-493e-8b61-\
c625592e7e45"],

Cell[TextData[{
 "TwistJoinedTubes[",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dz",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates an isometric triangulated joint between two quasi-cylindrical \
tubes. The bottom tube is z-oriented; the top tube can be tilted at a \
specified angle. Arguments are:\n\t",
 StyleBox["botpts2d",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that traces the bottom tube cross section \
in the ",
 StyleBox["x-y",
  FontSlant->"Italic"],
 " plane\n\t",
 StyleBox["toppts2d",
  FontSlant->"Italic"],
 " \[LongDash] a list of 2D points that traces the top tube cross section in \
the ",
 StyleBox["x-y",
  FontSlant->"Italic"],
 " plane, incorporating offsets and/or rotation\n\t",
 StyleBox["dz",
  FontSlant->"Italic"],
 " \[LongDash] the ",
 StyleBox["z",
  FontSlant->"Italic"],
 "-offset between the centroids of the top and bottom surfaces.\nOptions are:\
\n\tTwistDirection \[Rule] CCW | CW, specifies the direction of the twist \
folds.\n\tTitleAxialAngle \[Rule] \[Phi], specifies the rotation angle in the \
",
 StyleBox["xy",
  FontSlant->"Italic"],
 " plane of the axis about which the top is tilted.\n\tTiltAzimuthalAngle \
\[Rule] \[Theta], specifies the angle by which the top is tilted about this \
axis.\n\tTubeHeight \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", specifies the cylinder height of the top and bottom cylinders.\n\t\
PanelOverlap \[Rule] True | False, specifies whether to add an extra panel \
for overlap\n\tTypeMinimumAngle, TypeMaximumAngle are passed through to \
ReassignGraph3D"
}], "Text",
 CellChangeTimes->{{3.671178906081423*^9, 3.671178965584174*^9}, {
   3.6711790212561197`*^9, 3.671179200430028*^9}, 3.671290969808563*^9, {
   3.6715283112826853`*^9, 3.6715283434795103`*^9}, 3.673098033769256*^9, {
   3.673101661990464*^9, 3.6731016743111773`*^9}, {3.675322993457251*^9, 
   3.675323012521871*^9}, {3.676111291032411*^9, 
   3.676111398083809*^9}},ExpressionUUID->"7a43a307-bac1-4460-97d8-\
991bbd7c6dcf"],

Cell["\<\
This works by making the heights of the top and bottom cylinders at each \
point around the cylinder variables, then solving the isometry equations that \
relate the crease pattern and the folded form to define the heights.\
\>", "Text",
 CellChangeTimes->{{3.671180643505306*^9, 3.671180698056677*^9}, {
  3.67310172703985*^9, 
  3.67310174535763*^9}},ExpressionUUID->"fbf5ad3f-8fff-46ed-87a3-\
bca950d778c7"],

Cell["\<\
Top and bottom are joined by skew quadrilaterals that are folded along one or \
the other diagonals. TwistDirection specifies which diagonal is folded: CCW \
specifies the upward diagonal, CW specifies the downward diagonal.\
\>", "Text",
 CellChangeTimes->{{3.675323073030187*^9, 3.675323162775642*^9}, {
  3.676111258950724*^9, 
  3.676111259684544*^9}},ExpressionUUID->"9e9619e1-e45c-43da-8c05-\
69c185a2ce42"],

Cell["\<\
There is no automatic checking for self-intersection, and it is fairly easy \
to construct examples in which the paper self-intersects. You can detect this \
by examining the assignment of the crease pattern or rotating the folded form \
and looking for intersections.\
\>", "Text",
 CellChangeTimes->{{3.676111262220183*^9, 3.676111272554113*^9}, {
  3.676111423967435*^9, 
  3.676111532261507*^9}},ExpressionUUID->"0d0c9f8d-15f8-4a6e-a578-\
01d65c9c30ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TiltAxialAngle", "::", "usage"}], " ", "=", 
   " ", "\"\<TiltAxialAngle is an option to TwistJoinedTubes that specifies \
the angle of the axis of tilt of the top tube.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.676111541614958*^9, 3.676111565768694*^9}},
 CellLabel->
  "In[3573]:=",ExpressionUUID->"77c37e75-8925-4613-88a3-2bf1859cb39e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TiltAzimuthalAngle", "::", "usage"}], 
   "=", "\"\<TiltAzimuthalAngle is an option to TwistJoinedTubes that \
specifies the tilt angle of the top tube.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.676111571938281*^9, 3.676111591037057*^9}},
 CellLabel->
  "In[3574]:=",ExpressionUUID->"f84811eb-6280-4da2-a647-845ba02cca8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TubeHeight", "::", "usage"}], 
   "=", "\"\<TubeHeight is an option to TwistJoinedTubes that specifies the \
heights of the top and bottom cylinders.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.6711792830786333`*^9, 3.671179302527566*^9}, 
   3.671290969828333*^9},
 CellLabel->
  "In[3575]:=",ExpressionUUID->"bc48b4af-c8cd-421a-b0d3-b64b35084f83"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PanelOverlap", "::", "usage"}], 
   "=", "\"\<PanelOverlap is an option to TwistJoinedTubes that specifies \
whether to add an extra panel that overlaps the first.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.6713329064203453`*^9, 3.671332966297659*^9}},
 CellLabel->
  "In[3576]:=",ExpressionUUID->"aef28c16-e8c3-4024-883d-0a05ed9ea601"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "TwistJoinedTubes", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TwistDirection", "\[Rule]", "CCW"}], ",", "\[IndentingNewLine]", 
     RowBox[{"TiltAxialAngle", "\[Rule]", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"TiltAzimuthalAngle", "\[Rule]", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"TubeHeight", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PanelOverlap", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.671179304791991*^9, 3.671179323748104*^9}, 
   3.6712909698490047`*^9, {3.671332970605996*^9, 3.671332981127567*^9}, {
   3.675323015332824*^9, 3.675323022585432*^9}, {3.676110265471974*^9, 
   3.676110291303213*^9}},
 CellLabel->
  "In[3577]:=",ExpressionUUID->"5e158f5f-ea76-4fa5-a6c3-af74b13988fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwistJoinedTubes", "::", "badlens"}], 
   "=", "\"\<Lists `1` and `2` must have the same length.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.671180064037623*^9, 3.671180089794998*^9}, {
   3.671180392948053*^9, 3.6711803937339153`*^9}, 3.671290969869729*^9},
 CellLabel->
  "In[3578]:=",ExpressionUUID->"b882d517-332c-44a8-9e07-ed8b4139d62a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwistJoinedTubes", "::", "badperi"}], 
   "=", "\"\<Lists `1` and `2` must have the same perimeter.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.671180064037623*^9, 3.671180089794998*^9}, {
   3.671180318415332*^9, 3.671180318705687*^9}, {3.671180367607332*^9, 
   3.671180368649484*^9}, {3.671180401321964*^9, 3.6711804017164*^9}, 
   3.671290969891457*^9},
 CellLabel->
  "In[3579]:=",ExpressionUUID->"1e3da4ed-3010-4d0c-8686-c3c4bed37a3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwistJoinedTubes", "[", 
   RowBox[{
   "botpts2d_List", ",", "toppts2d_List", ",", "dz_", ",", "opts___"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "td", ",", "tf", ",", "tt", ",", "th", ",", "po", ",", "m", ",", "blens",
       ",", "tlens", ",", "pxvals", ",", "qxvals", ",", "g", ",", "h", ",", 
      "gavg", ",", "havg", ",", "ppavg", ",", "qqavg", ",", "p", ",", "q", ",",
       "trm", ",", "tz", ",", "pp", ",", "qq", ",", "dl", ",", "dh", ",", 
      "gbot", ",", "htop", ",", "eqns", ",", "vars", ",", "vars0", ",", 
      "soln", ",", "mm", ",", "cp", ",", "ff", ",", "verts", ",", "edges", ",",
       "types", ",", "verts3d", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"td", "=", 
      RowBox[{
       RowBox[{"TwistDirection", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TwistJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tf", "=", 
      RowBox[{
       RowBox[{"TiltAxialAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TwistJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tt", "=", 
      RowBox[{
       RowBox[{"TiltAzimuthalAngle", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TwistJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"th", "=", 
      RowBox[{
       RowBox[{"TubeHeight", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TwistJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"po", "=", 
      RowBox[{
       RowBox[{"PanelOverlap", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "TwistJoinedTubes", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "botpts2d", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "toppts2d", "]"}], "\[NotEqual]", "m"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"TwistJoinedTubes", "::", "badlens"}], ",", "botpts2d", ",",
           "toppts2d"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"blens", "=", 
      RowBox[{"Mag", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"RotateLeft", "[", "botpts2d", "]"}], "-", "botpts2d"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tlens", "=", 
      RowBox[{"Mag", "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"RotateLeft", "[", "toppts2d", "]"}], "-", "toppts2d"}], 
        ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Plus", "@@", "blens"}], ")"}], "-", 
          RowBox[{"(", 
           RowBox[{"Plus", "@@", "tlens"}], ")"}]}], "]"}], ">", 
        SuperscriptBox["10", 
         RowBox[{"-", "6"}]]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"TwistJoinedTubes", "::", "badperi"}], ",", "botpts2d", ",",
           "toppts2d"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"unwrapped", " ", "x"}], "-", 
        RowBox[{"coordinates", " ", "of", " ", "bottom", " ", "and", " ", 
         RowBox[{"top", ".", " ", "Double"}], " ", "the", " ", "length", " ", 
         "so", " ", "we", " ", "can", " ", "index", " ", "at", " ", "j"}]}], "=", 
       RowBox[{
        RowBox[{"0", " ", "and", " ", "j"}], "=", 
        RowBox[{
         RowBox[{
         "m", " ", "in", " ", "the", " ", "cp", " ", "without", " ", "wrap"}],
          "-", 
         RowBox[{"around", " ", 
          RowBox[{"effects", "."}]}]}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"pxvals", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"blens", ",", "blens"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qxvals", "=", 
      RowBox[{"FoldList", "[", 
       RowBox[{"Plus", ",", "0", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"tlens", ",", "tlens"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"wraparound", " ", "behavior"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", "[", "j_", "]"}], ":=", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"Mod", "[", 
         RowBox[{"j", ",", "m"}], "]"}], "]"}], "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"j", "<", "0"}], "||", 
         RowBox[{"j", "\[GreaterEqual]", "m"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"h", "[", "j_", "]"}], ":=", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"Mod", "[", 
         RowBox[{"j", ",", "m"}], "]"}], "]"}], "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"j", "<", "0"}], "||", 
         RowBox[{"j", "\[GreaterEqual]", "m"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"average", " ", "variables"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gavg", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"g", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "/", "m"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"havg", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"h", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "/", "m"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ppavg", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"pp", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "/", "m"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qqavg", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"qq", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], "/", "m"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"ff", " ", "points"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"trm", "=", 
      RowBox[{"RotationMatrix3Du", "[", 
       RowBox[{"tt", ",", 
        RowBox[{"U3D", "[", "tf", "]"}]}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"axis", " ", "of", " ", "top", " ", "rotation"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tz", "=", 
      RowBox[{"trm", ".", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"direction", " ", "of", " ", "top"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pp", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"botpts2d", "\[LeftDoubleBracket]", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], 
         "\[RightDoubleBracket]"}], ",", "z"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pp", "[", "j_", "]"}], ":=", 
      RowBox[{"pp", "[", 
       RowBox[{"j", ",", 
        RowBox[{"g", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qq", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"trm", ".", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"toppts2d", "\[LeftDoubleBracket]", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], 
          "\[RightDoubleBracket]"}], ",", "z"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qq", "[", "j_", "]"}], ":=", 
      RowBox[{"qq", "[", 
       RowBox[{"j", ",", 
        RowBox[{"h", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"cp", " ", "points"}], ";", " ", 
       RowBox[{
       "dl", " ", "and", " ", "dh", " ", "are", " ", "variables", " ", "to", " ",
         "be", " ", "solved", " ", 
        RowBox[{"for", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pxvals", "\[LeftDoubleBracket]", 
         RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], ",", "z"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", "j_", "]"}], ":=", 
      RowBox[{"p", "[", 
       RowBox[{"j", ",", 
        RowBox[{"g", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"j_", ",", "z_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"qxvals", "\[LeftDoubleBracket]", 
          RowBox[{"j", "+", "1"}], "\[RightDoubleBracket]"}], "+", "dl"}], ",", 
        RowBox[{"z", "+", "dh"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "j_", "]"}], ":=", 
      RowBox[{"q", "[", 
       RowBox[{"j", ",", 
        RowBox[{"h", "[", "j", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"equations", ":", " ", 
       RowBox[{"isometries", " ", "plus", " ", "offsets"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{
       RowBox[{"Join", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Mag2", "[", 
              RowBox[{
               RowBox[{"p", "[", "j", "]"}], "-", 
               RowBox[{"q", "[", "j", "]"}]}], "]"}], "-", 
             RowBox[{"Mag2", "[", 
              RowBox[{
