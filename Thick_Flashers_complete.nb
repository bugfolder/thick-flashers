Cell[BoxData[
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ds", ",", "\[Kappa]l", ",", "ui", ",", "ci", ",", "ti", ",", "u0", ",", 
      "u1", ",", "csys", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ds", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]l", "=", 
      RowBox[{"1", "&"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ui", ",", " ", "ci", ",", " ", "ti"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"RecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "ci", ",", "ti"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "csys", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"#", "//", "PrettyParameters"}], "]"}], "&"}], "/@", "csys"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Curve2D", "/.", "csys"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"c", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "u0", ",", "u1"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.799487328819302*^9, 3.7994874384596863`*^9}, {
