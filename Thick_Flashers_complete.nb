Cell[CellGroupData[{

Cell[TextData[{
 "EdgeValleyFoldConstraints[",
 StyleBox["{i1, f1, i2, f2}, verts",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.702581735995819*^9, 3.702581754553783*^9}, {
   3.702581891673012*^9, 3.702581908360849*^9}, {3.702662277683584*^9, 
   3.702662292155494*^9}, 3.702664772797439*^9, {3.702668329402912*^9, 
   3.702668330187209*^9}},ExpressionUUID->"67b0c265-2c64-4556-bfce-\
1bddd49aa4a2"],

Cell[TextData[{
 "EdgeValleyFoldConstraints[{",
 StyleBox["i1, f1, i2, f2",
  FontSlant->"Italic"],
 "}",
 StyleBox[", verts",
  FontSlant->"Italic"],
 "] creates constraints that force a fold to have a fold angle between 0\
\[Degree] and 180\[Degree], i.e., to be a valley fold."
}], "Text",
 CellChangeTimes->{{3.702581757784544*^9, 3.702581806303808*^9}, 
   3.702662368518146*^9, 3.702664772828959*^9, {3.702668335819405*^9, 
   3.702668336595442*^9}},ExpressionUUID->"f24ec047-79c6-440d-9ee7-\
4d1674b84b14"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["i1, f1, i2, f2",
  FontSlant->"Italic"],
 "} \[LongDash] An edge vertex neighborhood, e.g., from \
InteriorEdgeVertexNeighborhoods.\n\tverts \[LongDash] the vertices that {",
 StyleBox["i1, f1, i2, f2",
  FontSlant->"Italic"],
 "} index into."
}], "Text",
 CellChangeTimes->{{3.702581808119735*^9, 3.702581841704116*^9}, {
  3.7025819181374006`*^9, 3.70258193781772*^9}, {3.702662371718914*^9, 
  3.7026623801177187`*^9}, {3.702668350419347*^9, 3.702668359555696*^9}, {
  3.702668524374791*^9, 
  3.702668526943631*^9}},ExpressionUUID->"d5a02dd0-3651-407a-83ad-\
4cf509942014"],

Cell[TextData[{
 "Returns:\n\tA pure function f[",
 StyleBox["verts",
  FontSlant->"Italic"],
 "] that accepts a list ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " of vertices and returns a list of constraints inequalities."
}], "Text",
 CellChangeTimes->{{3.702581856616185*^9, 3.7025818789524617`*^9}, {
  3.7025819476972246`*^9, 3.702581948425012*^9}, {3.7026623921419897`*^9, 
  3.702662393284088*^9}},ExpressionUUID->"635e00ce-f50c-4ba3-97b4-\
f5b757eb8ef5"],

Cell["\<\
Since polygons with >3 sides could be skew, we use the centroid of each \
polygon to measure fold angle.\
\>", "Text",
 CellChangeTimes->{{3.702662402332014*^9, 
  3.702662441868724*^9}},ExpressionUUID->"538c0766-9b47-4ae9-ac64-\
337f58fbda72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeValleyFoldConstraints", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i1_", ",", "f1_", ",", "i2_", ",", "f2_"}], "}"}], ",", 
    "verts_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "p3", ",", "p4", ",", "u2", ",", "u4", ",", 
      "r13"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p1", "=", 
      RowBox[{
      "verts", "\[LeftDoubleBracket]", "i1", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "f1", "\[RightDoubleBracket]"}]}], "/", 
       RowBox[{"Length", "[", "f1", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p3", "=", 
      RowBox[{
      "verts", "\[LeftDoubleBracket]", "i2", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"p4", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{
        "verts", "\[LeftDoubleBracket]", "f2", "\[RightDoubleBracket]"}]}], "/", 
       RowBox[{"Length", "[", "f2", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p2", "-", "p1"}], ")"}], "\[Cross]", 
       RowBox[{"(", 
        RowBox[{"p3", "-", "p1"}], ")"}]}]}], ";", 
     RowBox[{"u2", "=", 
      RowBox[{"u2", "/", 
       RowBox[{"Mag", "[", "u2", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u4", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p3", "-", "p1"}], ")"}], "\[Cross]", 
       RowBox[{"(", 
        RowBox[{"p4", "-", "p1"}], ")"}]}]}], ";", 
     RowBox[{"u4", "=", 
      RowBox[{"u4", "/", 
       RowBox[{"Mag", "[", "u4", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r13", "=", 
      RowBox[{"p3", "-", "p1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"u2", "\[Cross]", "u4"}], ")"}], ".", "r13"}], "/", 
        RowBox[{"Mag", "[", "r13", "]"}]}], "\[GreaterEqual]", "0"}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.70258200662281*^9, 3.7025820268818417`*^9}, {
   3.702582537440918*^9, 3.702582677103499*^9}, {3.702582710441899*^9, 
   3.702582777729388*^9}, {3.702582955076584*^9, 3.702582956027372*^9}, 
   3.702583177053684*^9, {3.70258321570234*^9, 3.702583225525756*^9}, {
