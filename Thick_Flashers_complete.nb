         "\[IndentingNewLine]", "glist"}], "]"}], ",", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics3D", "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
