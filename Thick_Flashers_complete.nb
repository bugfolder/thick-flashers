Cell[TextData[{
 "SpaceCurveMaximumWidth \[Rule] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["w", "l"], ",", 
     SubscriptBox["w", "r"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "ed5ef588-b603-4ca9-89ae-043734ec73a0"],
