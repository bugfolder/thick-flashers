Cell[BoxData[
 RowBox[{
  RowBox[{"PinHingedPanelPartsGraphics3D", "[", "panelparts_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           "SolidStyle", ",", 
           RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
         RowBox[{"(*", " ", "panels", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
           "Pink", ",", 
           RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}], ",", 
         RowBox[{"(*", " ", "cutouts", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
           "Orange", ",", 
           RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
         RowBox[{"(*", " ", "knuckles", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], ",", 
           "Purple", ",", 
           RowBox[{"Opacity", "[", "0.8", "]"}]}], "]"}], ",", 
         RowBox[{"(*", " ", "holes", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"{", "}"}]}], "}"}], "]"}], "&"}], "/@", "panelparts"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
