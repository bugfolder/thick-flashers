       RowBox[{"glist", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alist", "=", 
      RowBox[{"{", 
       RowBox[{"2.`", ",", "0.8`", ",", "1.0`", ",", "2.2`"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Sector angles = \>\"", ",", 
       RowBox[{"alist", "/", "\[Degree]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{"VertexConsistencyMatrix3D", "[", 
        RowBox[{"glist", ",", "alist"}], "]"}], "]"}], "//", 
      "MatrixForm"}]}]}], "\[IndentingNewLine]", "]"}], "//", 
  "ShowExample"}]], "Input",
 CellChangeTimes->{{3.591381510529553*^9, 3.591381611640764*^9}, {
   3.591381783976893*^9, 3.591381800992807*^9}, {3.591381978425333*^9, 
   3.591381980316917*^9}, 3.594224175742584*^9, 3.595982950347766*^9, {
   3.616165538528188*^9, 3.616165554230673*^9}, 3.616165762570235*^9, 
   3.704570877719983*^9, 3.704571186827021*^9},
 CellLabel->
  "In[738]:=",ExpressionUUID->"b69602b7-fee1-4571-954f-dd6861e11954"],

Cell["\<\
Note that we can get a spurious matrix with two diagonal elements equal to -1:\
\>", "Text",
 CellChangeTimes->{{3.704571033015194*^9, 
  3.7045710659614487`*^9}},ExpressionUUID->"33df898a-0b3e-44e3-9e2a-\
1e4346345efc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"glist1", ",", "glist2", ",", "alist"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"glist1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{"90", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"glist2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"90", "\[Degree]"}], ",", 
        RowBox[{
         RowBox[{"-", "90"}], "\[Degree]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alist", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"180", "\[Degree]"}], ",", 
        RowBox[{"180", "\[Degree]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<valid = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"VertexConsistencyMatrix3D", "[", 
         RowBox[{"glist1", ",", "alist"}], "]"}], "//", "MatrixForm"}], 
       ",", "\"\<, spurious = \>\"", ",", 
       RowBox[{
        RowBox[{"VertexConsistencyMatrix3D", "[", 
         RowBox[{"glist2", ",", "alist"}], "]"}], "//", "MatrixForm"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.591381510529553*^9, 3.591381611640764*^9}, {
