Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyCollinearCleanup2DTo", "[", 
   RowBox[{"tobj_TObj", ",", "ccdata_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vlist", ",", "verts2d", ",", "nverts2d"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vlist", "=", 
      RowBox[{
      "ccdata", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{"tobj", "[", "Vertices2D", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"nverts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts2d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "vlist"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices2D", "\[Rule]", "nverts2d"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
