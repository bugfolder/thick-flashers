Cell[TextData[{
 "ThreeCycleCriticalTwistAngles",
 "[",
 StyleBox["{q1a, q1b}, {q2a, a2b}, {q3a, q3b}",
  FontSlant->"Italic"],
 "] takes the endpoints of three edges and returns both critical twist angles \
for those three edges; for twist angles between these two values, the \
NAE-3-SAT condition applies."
}], "Text",
 CellChangeTimes->{{3.4577347935465817`*^9, 3.457734800684619*^9}, {
   3.592165196828599*^9, 3.592165200442717*^9}, 
   3.6275013152045407`*^9},ExpressionUUID->"3cc21153-aab2-4d69-a033-\
ef67dd11bed7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThreeCycleCriticalTwistAngles", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1a_", ",", "q1b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q2a_", ",", "q2b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q3a_", ",", "q3b_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ThreeCycleCriticalTwistAngleCCW", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q1a", ",", "q1b"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q2a", ",", "q2b"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q3a", ",", "q3b"}], "}"}]}], "]"}], ",", 
    RowBox[{"ThreeCycleCriticalTwistAngleCW", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q1a", ",", "q1b"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q2a", ",", "q2b"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"q3a", ",", "q3b"}], "}"}]}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.627501293949748*^9, 3.627501315249625*^9}},
 CellLabel->
  "In[2698]:=",ExpressionUUID->"7b9a80bf-8e9f-4043-a014-5a8db916eba3"],

Cell[TextData[{
 "ThreeCycleCriticalTwistAngles[",
 StyleBox["plist",
  FontSlant->"Italic"],
 "] returns the angular range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "min"], ",", 
     SubscriptBox["\[Alpha]", "max"]}]}], TraditionalForm]],ExpressionUUID->
  "c27b69c5-cdc6-43b1-b3cf-094d3d43fb4c"],
 "} between which there is a 3-cycle overlap between some trio of edges in \
the polygon ",
 StyleBox["plist",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.627497752764758*^9, 3.627497828169616*^9}, {
  3.62749786772199*^9, 3.627497900509591*^9}, {3.627499256686692*^9, 
  3.627499268997582*^9}, {3.627499301931741*^9, 3.627499336770604*^9}, {
  3.627499405636975*^9, 3.627499406429365*^9}, {3.627499681404904*^9, 
  3.6274997205612392`*^9}, {3.6274999434038477`*^9, 3.627499969729388*^9}, {
  3.6275014110643806`*^9, 
  3.6275014235895853`*^9}},ExpressionUUID->"4dd8917c-5a37-417e-b128-\
0a21976271e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThreeCycleCriticalTwistAngles", "[", "plist_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "itrios", ",", "apairs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "plist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"itrios", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", "j", ",", "k"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"n", "-", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"n", ",", 
              RowBox[{"n", "+", "i", "-", "2"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"j", "+", "1"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"n", ",", 
              RowBox[{"n", "+", "i", "-", "1"}]}], "]"}]}], "}"}]}], "]"}], ",",
         "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"apairs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ThreeCycleCriticalTwistAngles", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+",
               "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{
              "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "+",
               "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
             "\[RightDoubleBracket]"}], ",", 
            RowBox[{"plist", "\[LeftDoubleBracket]", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                "#", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "+",
                 "1"}], ",", "n", ",", "1"}], "]"}], 
             "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], "&"}], "/@", 
       "itrios"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"apairs", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"apairs", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ">", 
           "0"}], "&&", 
          RowBox[{
           RowBox[{
           "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "<", 
           "\[Pi]"}]}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           "]"}]}], "}"}], "&"}], "[", 
      RowBox[{"Transpose", "[", "apairs", "]"}], "]"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.627499886889738*^9, 3.627499923207949*^9}, {
   3.627499977508484*^9, 3.627499983972032*^9}, {3.627500206027563*^9, 
