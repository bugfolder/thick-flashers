Cell[CellGroupData[{

Cell["CairoPatch[\[Delta]]", "Subsubsection",
 CellChangeTimes->{{3.63112237669798*^9, 3.6311223795523376`*^9}, {
  3.63112862091422*^9, 
  3.6311286211207323`*^9}},ExpressionUUID->"663d028a-6cce-4ce4-ba57-\
4c5a3c425468"],

Cell["\<\
CairoPatch[\[Delta]] returns a lattice patch of a periodic Cairo tiling using \
the Cairo pentagon with base angle \[Delta]. Note that the tiling is made up \
of both the tile and its mirror image, which we obtain by using a base angle \
of \[Pi]-\[Delta].\
\>", "Text",
 CellChangeTimes->{{3.631122381456271*^9, 3.631122388088087*^9}, {
  3.6311224423638487`*^9, 3.631122459442388*^9}, {3.631128624209104*^9, 
  3.631128634743651*^9}, {3.6312247614169497`*^9, 
  3.63122478120129*^9}},ExpressionUUID->"1590ad2f-5a10-4b7c-9c58-\
d42ed6dc4e49"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CairoPatch", "[", "\[Delta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JoinTiling", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"UnitCairoPentagonTile", ",", " ", "\[Delta]"}], "}"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", " ", 
           RowBox[{"\[Pi]", "-", "\[Delta]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "4", ",", "4"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", " ", "\[Delta]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "1"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"UnitCairoPentagonTile", ",", " ", 
           RowBox[{"\[Pi]", "-", "\[Delta]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4", ",", "4"}], "}"}]}], "}"}]}], 
      "\[IndentingNewLine]", "}"}], "]"}], "//", "Chop"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.631122755669158*^9, 3.631122899049856*^9}, {
  3.631128638817532*^9, 3.631128660148101*^9}, {3.631138052700929*^9, 
  3.631138063891567*^9}, {3.631138108512341*^9, 3.631138119941947*^9}, {
  3.631138207038879*^9, 3.631138268570266*^9}, {3.6312151773427467`*^9, 
  3.631215178231927*^9}},
 CellLabel->
  "In[3283]:=",ExpressionUUID->"867dd0cb-8d35-4567-b2a5-8056efc645ea"],

Cell["Example: the taller skinny symmetric base angle.", "Text",
 CellChangeTimes->{{3.631613566804276*^9, 3.6316135926804657`*^9}, 
   3.631615251940219*^9},ExpressionUUID->"986a3ade-d47a-4bd0-8ad2-\
5af639721eff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"EmbedTiling", "[", 
     RowBox[{
      RowBox[{"CairoPatch", "[", "CairoSymmetricPentagonBaseAngle", "]"}], ",",
       "Tiling", ",", 
      RowBox[{"TileVertexIndices", "\[Rule]", "True"}], ",", 
      RowBox[{"TileIndices", "\[Rule]", "True"}]}], "]"}], "]"}], "/.", 
