Cell["\<\
Arguments:
\t\[Kappa] \[LongDash] the left curvature, as a pure function or \
InterpolatingFunction.
\tv \[LongDash] the curve speed, as a pure function or InterpolatingFunction.\
\
\>", "Text",
 CellChangeTimes->{{3.691236017669279*^9, 3.691236019302292*^9}, {
  3.69125680077477*^9, 
  3.691256815335795*^9}},ExpressionUUID->"8faf6231-e145-4a08-b1fb-\
7e10126cf11a"],

Cell[TextData[{
 "Options:\n\tInitialPosition2D \[Rule] ",
 StyleBox["c0",
  FontSlant->"Italic"],
 ", specifies the initial (t=0) position of the curve.\n\t\
InitialTangentVector2D \[Rule] ",
 StyleBox["d0",
  FontSlant->"Italic"],
 ", specifies the initial tangent direction of the curve as a unit vector.\n\t\
Options[NDSolve] are passed through.\n\tOptions[FunctionInterpolation] are \
passed through."
}], "Text",
 CellChangeTimes->{{3.691236026526136*^9, 3.691236028802852*^9}, {
   3.6916967725440288`*^9, 3.691696778618708*^9}, {3.691697374784804*^9, 
   3.691697380740122*^9}, 3.691697514404504*^9, {3.691697663694072*^9, 
   3.691697683079525*^9}, 3.691697988484082*^9, 3.691698253269991*^9, 
   3.691921636776013*^9, 
   3.691921671481689*^9},ExpressionUUID->"fddf9570-b0c8-4415-ab73-\
c175c405297f"],

Cell["\<\
Returns:
\t A list of rules giving pure functions based on InterpolatingFunctions that \
describe the differential geometry of the curve. The returned curve is in \
standard position: c[u0] = {0,0}, with initial direction along the x-axis. \
\>", "Text",
 CellChangeTimes->{{3.691236036897108*^9, 3.691236112215464*^9}, 
   3.79952309520342*^9},ExpressionUUID->"93469c4b-6f50-4185-94da-\
7137227a5928"],

Cell[TextData[{
 "NRecoverCurve2DSystemOld[\[Kappa], ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] constructs a 2D unit-speed curve from its signed (left) curvature."
}], "Text",
 CellChangeTimes->{{3.691164313050246*^9, 3.691164336142476*^9}, 
   3.691182773282259*^9, {3.69123612169248*^9, 3.691236138001078*^9}, 
   3.691252662545153*^9, 3.691257519052329*^9, 3.691258591467435*^9, 
   3.80046101015716*^9},ExpressionUUID->"58815a3f-2ffa-4dd1-90a5-\
4812099368a8"],

Cell["\<\
This does the calculation differently from the analytic version, by \
integrating the matrix system of differential equations.\
\>", "Text",
 CellChangeTimes->{{3.69125752974865*^9, 3.691257545025199*^9}, {
  3.691258531688381*^9, 
  3.6912585434711027`*^9}},ExpressionUUID->"b8c93636-986d-43e9-83bb-\
a3387da5668e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "NRecoverCurve2DSystemOld", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"InitialPosition2D", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"InitialTangentVector2D", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.690971199004568*^9, 3.690971217037642*^9}, 
   3.690988493844738*^9, 3.691182773297948*^9, 3.6912356848331137`*^9, 
   3.691235885131102*^9, 3.691252613445842*^9, {3.691696403881215*^9, 
   3.691696426117591*^9}, {3.691696838923752*^9, 3.691696842776973*^9}, 
   3.6916969177986403`*^9, 3.691697514420358*^9, {3.691697691150033*^9, 
   3.6916976943687773`*^9}, 3.69169798849727*^9, 3.6916982532828093`*^9, 
   3.6919216367953653`*^9, 3.69192167149786*^9, 3.800461010172505*^9},
 CellLabel->
  "In[3647]:=",ExpressionUUID->"b31444e5-aae6-42e1-b65e-3b7cb0472ad9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NRecoverCurve2DSystemOld", "[", 
   RowBox[{
    RowBox[{"lkpf_Function", "|", "lkpf_InterpolatingFunction"}], ",", 
    RowBox[{"vf_Function", "|", "vf_InterpolatingFunction"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ip", ",", "it", ",", "fopts", ",", "ndopts", ",", "in", ",", "t", ",", 
      "soln", ",", "tx", ",", "ty", ",", "nx", ",", "ny", ",", "cx", ",", 
      "cy", ",", "kpf", ",", "nxf", ",", "nyf"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ip", "=", 
      RowBox[{
       RowBox[{"InitialPosition2D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NRecoverCurve2DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"it", "=", 
      RowBox[{
       RowBox[{"InitialTangentVector2D", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "NRecoverCurve2DSystemOld", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ndopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "NDSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "FunctionInterpolation", "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"it", "=", 
      RowBox[{"it", "/", 
       RowBox[{"Mag", "[", "it", "]"}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"normalize", ",", " ", 
       RowBox[{"just", " ", "in", " ", "case"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"in", "=", 
      RowBox[{
       RowBox[{"RotationMatrix2D", "[", 
        RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", "it"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "left", " ", "normal"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"tx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"ty", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"vf", "[", "t", "]"}], 
             RowBox[{"lkpf", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"nx", "[", "t", "]"}], ",", 
               RowBox[{"ny", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"nx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"ny", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"vf", "[", "t", "]"}]}], 
             RowBox[{"lkpf", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "t", "]"}], ",", 
               RowBox[{"ty", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"cx", "'"}], "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"cy", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
            RowBox[{
             RowBox[{"vf", "[", "t", "]"}], 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tx", "[", "t", "]"}], ",", 
               RowBox[{"ty", "[", "t", "]"}]}], "}"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tx", "[", "0", "]"}], ",", 
              RowBox[{"ty", "[", "0", "]"}]}], "}"}], "\[Equal]", "it"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"nx", "[", "0", "]"}], ",", 
              RowBox[{"ny", "[", "0", "]"}]}], "}"}], "\[Equal]", "in"}], ",",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"cx", "[", "0", "]"}], ",", 
              RowBox[{"cy", "[", "0", "]"}]}], "}"}], "\[Equal]", "ip"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tx", "[", "t", "]"}], ",", 
           RowBox[{"ty", "[", "t", "]"}], ",", 
           RowBox[{"nx", "[", "t", "]"}], ",", 
           RowBox[{"ny", "[", "t", "]"}], ",", 
           RowBox[{"cx", "[", "t", "]"}], ",", 
           RowBox[{"cy", "[", "t", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "u0", ",", "u1"}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "ndopts", "]"}]}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "reinterpolate", " ", "some", " ", "derived", " ", "functions"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"kpf", "=", 
      RowBox[{"FunctionInterpolation", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
