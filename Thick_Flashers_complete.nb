  3.912755639283828*^9}},ExpressionUUID->"14f5a6dd-1d7d-47ee-ae32-\
ecd8b639241e"],

Cell["\<\
SolidStyle is a set of style directives used in Graphics3D rendering of 3D \
printed shapes that shows green on the outside, red on the inside, and has \
some transparency so we can see edges on the far side of a shape.\
\>", "Text",
 CellChangeTimes->{{3.912755646834255*^9, 
  3.912755688712943*^9}},ExpressionUUID->"39e5dc64-fc69-476c-a83c-\
946d729937cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SolidStyle", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FaceForm", "[", 
      RowBox[{"Green", ",", "Red"}], "]"}], ",", 
     RowBox[{"Opacity", "[", ".5", "]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.912755607050081*^9, 3.912755609934635*^9}, {
  3.9127556425685263`*^9, 3.912755644272114*^9}},
 CellLabel->
  "In[4239]:=",ExpressionUUID->"7716defb-3a59-4a3e-bf35-976394026844"]
}, Closed]]
}, Closed]],

