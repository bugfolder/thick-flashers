Cell[CellGroupData[{

Cell[TextData[{
 "MakeOffsetGoldbergTiling[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["o",
  FontSlant->"Italic"],
 "]\nMakeOffsetGoldbergTilingGraph[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["o",
  FontSlant->"Italic"],
 "]\n",
 "MakeOffsetGoldbergTilingPrimalDualGraph",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["o",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.485217806831367*^9, 3.485217812326803*^9}, {
   3.485218415598672*^9, 3.485218419806274*^9}, {3.485219587508164*^9, 
   3.485219604011448*^9}, {3.485221048248446*^9, 3.485221067255951*^9}, {
   3.485221289319805*^9, 3.485221291260625*^9}, {3.4852213247290177`*^9, 
   3.485221333576082*^9}, 3.551747570692354*^9, 3.592297961193136*^9, {
   3.592298010136295*^9, 3.5922980245677543`*^9}, 3.592828741596359*^9, 
   3.5940721218229837`*^9},ExpressionUUID->"85c8a5aa-654d-45b1-b63a-\
9d616463f495"],

Cell[TextData[{
 "MakeOffsetGoldbergTiling[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["o",
  FontSlant->"Italic"],
 "] returns a list of point pairs for a Goldberg tiling whose top and bottom \
halves are offset by ",
 StyleBox["o",
  FontSlant->"Italic"],
 " units relative to one another (but the overall pattern is still centered \
on the origin). Rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " must be even or an error will result."
}], "Text",
 CellChangeTimes->{{3.485218422766589*^9, 3.485218483766191*^9}, {
  3.485268487840856*^9, 
  3.485268509688465*^9}},ExpressionUUID->"64eb9f66-c509-438f-ae0b-\
898d3b86e175"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MakeOffsetGoldbergTiling", "::", "badrot"}], 
   "=", "\"\<The rotational order `1` must be even.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeOffsetGoldbergTiling", "::", "badoff"}], 
   "=", "\"\<The offset `1` must be positive.\>\""}], ";"}]}], "Input",
 CellChangeTimes->{{3.485218536282074*^9, 3.485218549649265*^9}, {
  3.485219637478641*^9, 3.485219653522908*^9}},
 CellLabel->
  "In[3364]:=",ExpressionUUID->"e7205677-d6aa-4c44-b88f-8bfcbe78a3fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeOffsetGoldbergTiling", "[", 
   RowBox[{"m_", ",", "n_", ",", 
    RowBox[{"o_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"elist", ",", "etop", ",", "ebot"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"m", ",", "2"}], "]"}], "\[NotEqual]", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeOffsetGoldbergTiling", "::", "badrot"}], ",", "m"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"o", "<", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeOffsetGoldbergTiling", "::", "badoff"}], ",", "o"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"elist", "=", 
      RowBox[{"MakeGoldbergTiling", "[", 
       RowBox[{"m", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"etop", ",", "ebot"}], "}"}], "=", 
      RowBox[{"GatherBy", "[", 
       RowBox[{"elist", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "<", 
           RowBox[{"-", 
            SuperscriptBox["10", 
             RowBox[{"-", "6"}]]}]}], "||", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"#", "\[LeftDoubleBracket]", 
             RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "<", 
           RowBox[{"-", 
            SuperscriptBox["10", 
             RowBox[{"-", "6"}]]}]}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "o"}], "/", "2"}], ",", "0"}], "}"}], "+", "#"}], 
          "&"}], ",", "etop", ",", 
