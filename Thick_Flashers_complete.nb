      "ff", ",", "uu", ",", "cs3s", ",", "tt", ",", "nn", ",", "bb", ",", 
      "ll", ",", "fda", ",", "kn", ",", "kg", ",", "tg", ",", "r"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "surface"}], " ", "*)"}], "\[IndentingNewLine]", 
