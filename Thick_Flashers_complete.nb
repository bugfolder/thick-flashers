   3.594734672455151*^9}},ExpressionUUID->"699a65ec-4fd1-4ce5-a120-\
207aa7fc1a04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTGraph2DAssigned", "[", 
   RowBox[{"verts_List", ",", " ", "edges_List", ",", 
    RowBox[{"faces_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", 
    RowBox[{"verts2d_List", ":", 
     RowBox[{"{", "}"}]}], ",", " ", 
    RowBox[{"types_List", ":", 
     RowBox[{"{", "}"}]}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"MakeTGraph", "[", 
      RowBox[{"verts", ",", "edges", ",", "faces"}], "]"}], "//", 
     RowBox[{"AddTGraph2D", "[", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"verts2d", "===", 
         RowBox[{"{", "}"}]}], ",", "verts", ",", "verts2d"}], "]"}], "]"}]}],
     "//", 
    RowBox[{"AddTAssigned", "[", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"types", "===", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"U", ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "edges", "]"}], "}"}]}], "]"}], ",", 
       "types"}], "]"}], "]"}]}], "//", 
   RowBox[{"AddClass", "[", "TGraph2DAssigned", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.592422204741423*^9, 3.592422310014381*^9}, {
   3.592422469747477*^9, 3.592422478106968*^9}, {3.592422533007135*^9, 
