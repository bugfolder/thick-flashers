            RowBox[{
             RowBox[{
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
               "-", 
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{"ctr", "-", 
              RowBox[{
              "verts", "\[LeftDoubleBracket]", "1", 
               "\[RightDoubleBracket]"}]}]}], "]"}], ",", 
