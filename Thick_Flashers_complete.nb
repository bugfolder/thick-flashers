                    RowBox[{
                    "nfaces", "\[LeftDoubleBracket]", "cf", 
                    "\[RightDoubleBracket]"}], "/.", 
                    RowBox[{"vv", "\[Rule]", "nv"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"{", "}"}]}]}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2", ",", 
              RowBox[{"Length", "[", "vvei", "]"}]}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
