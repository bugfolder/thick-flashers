   3.597524813747836*^9},ExpressionUUID->"a75c3e91-1050-4241-b8db-\
3ac1f15da2f7"],

Cell[TextData[{
 "MakeSphericalVertexGraph3D",
 "[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TVertex3D and creates a TGraph3D+TAssigned that represents the \
crease pattern and folded form, located at the origin but with the folded \
orientation of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.597516659184429*^9, 3.597516750240417*^9}, 
   3.597524813810664*^9},ExpressionUUID->"4ab08b3c-e6b1-4cfd-9d65-\
1528d4e765e1"],

Cell["\<\
Note that the 3D vertex is not necessarily developable, so that isometry is \
not necessarily preserved from the 2D crease pattern to the 3D folded form.\
\>", "Text",
 CellChangeTimes->{{3.597516799972896*^9, 3.597516838330364*^9}, {
  3.597516985480986*^9, 
  3.597517002008015*^9}},ExpressionUUID->"dccb46b9-9c8f-4cec-a71c-\
fdf780faaa39"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeSphericalVertexGraph3D", "[", 
    RowBox[{
     StyleBox["tobj_TObj",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["opts___",
      FontSlant->"Italic"]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "cv", ",", "fv", ",", "nn", ",", "gobj", ",", "verts", ",", "faces", ",",
        "verts3d", ",", "face", ",", "cvp", ",", "cvn", ",", "fvp", ",", 
       "fvn", ",", "a2", ",", "x", ",", "z", ",", "y", ",", "a3", ",", "m", ",",
        "k", ",", "v2", ",", "a"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"AssertClass", "[", 
       RowBox[{"tobj", ",", "TVertex3D", ",", "MakeSphericalVertexGraph3D"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cv", ",", "fv"}], "}"}], "=", 
       RowBox[{"GetValues", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"{", 
          RowBox[{"CreaseVectors", ",", "FoldVectors"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"nn", "=", 
       RowBox[{"Length", "[", "cv", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gobj", "=", 
       RowBox[{"MakeCircularVertexGraph", "[", 
        RowBox[{"tobj", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"verts", ",", "faces"}], "}"}], "=", 
       RowBox[{"GetValues", "[", 
        RowBox[{"gobj", ",", 
         RowBox[{"{", 
          RowBox[{"Vertices", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verts3d", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Length", "[", "verts", "]"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"for", " ", "each", " ", "face"}], ",", " ", 
        RowBox[{
        "map", " ", "and", " ", "radially", " ", "scale", " ", "vertices", " ",
          "in", " ", "3", "D"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"face", "=", 
          RowBox[{
          "faces", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"cvp", "=", 
          RowBox[{
          "cv", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";", 
         RowBox[{"cvn", "=", 
          RowBox[{"cv", "\[LeftDoubleBracket]", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "nn", ",", "1"}], "]"}], 
           "\[RightDoubleBracket]"}]}], ";", 
         RowBox[{"(*", " ", 
          RowBox[{"defines", " ", "wedge", " ", "in", " ", "2", "d"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fvp", "=", 
          RowBox[{
          "fv", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";", 
         RowBox[{"fvn", "=", 
          RowBox[{"fv", "\[LeftDoubleBracket]", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "nn", ",", "1"}], "]"}], 
           "\[RightDoubleBracket]"}]}], ";", " ", 
         RowBox[{"(*", " ", 
          RowBox[{"defines", " ", "wedge", " ", "in", " ", "3", "d"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"a2", "=", 
          RowBox[{"RotationAngle", "[", 
           RowBox[{"cvp", ",", "cvn"}], "]"}]}], ";", 
         RowBox[{"(*", " ", 
          RowBox[{"wedge", " ", "angle", " ", "in", " ", "2", "d"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"x", "=", "fvp"}], ";", "\[IndentingNewLine]", 
         RowBox[{"z", "=", 
          RowBox[{"NormalizeReal", "[", 
           RowBox[{"fvp", "\[Cross]", "fvn"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"y", "=", 
          RowBox[{"z", "\[Cross]", "x"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"a3", "=", 
          RowBox[{"OrientedAngle3D", "[", 
           RowBox[{"fvp", ",", "fvn", ",", "z"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"m", "=", 
          RowBox[{"a3", "/", "a2"}]}], ";", 
         RowBox[{"(*", " ", 
          RowBox[{
          "angular", " ", "magnification", " ", "from", " ", "2", "d", " ", 
           "to", " ", "3", "d"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "=", 
             RowBox[{
             "face", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}],
             ";", 
            RowBox[{"(*", " ", 
             RowBox[{"index", " ", "of", " ", "the", " ", "vertex"}], " ", 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"k", "\[Equal]", "1"}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"v2", "=", 
             RowBox[{
             "verts", "\[LeftDoubleBracket]", "k", 
              "\[RightDoubleBracket]"}]}], ";", 
            RowBox[{"(*", " ", 
             RowBox[{"vertex", " ", "to", " ", "be", " ", "transformed"}], 
             " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"a", " ", "=", 
             RowBox[{"m", " ", 
              RowBox[{"RotationAngle", "[", 
               RowBox[{"cvp", ",", "v2"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
             "verts3d", "\[LeftDoubleBracket]", "k", 
              "\[RightDoubleBracket]"}], "=", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", "a", "]"}], " ", "x"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"Sin", "[", "a", "]"}], " ", "y"}]}]}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "face", "]"}]}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Add", " ", "verts3d", " ", "to", " ", "the", " ", "graph"}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"gobj", "//", 
       RowBox[{"AddTGraph3D", "[", "verts3d", "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.597516537458443*^9, 3.597516597004375*^9}, {
   3.597517022706255*^9, 3.597517047120122*^9}, {3.597517356293581*^9, 
   3.597517451472494*^9}, {3.5975174984518003`*^9, 3.59751769218092*^9}, {
   3.597518275059923*^9, 3.597518350931613*^9}, {3.597518415303192*^9, 
   3.597518521185685*^9}, {3.597518599904476*^9, 3.597518811500752*^9}, 
   3.597518972403833*^9, {3.597519015289111*^9, 3.597519027291364*^9}, {
   3.597519061267668*^9, 3.597519157449522*^9}, {3.597519201372514*^9, 
   3.597519205150757*^9}, {3.59751944293366*^9, 3.597519454631907*^9}, {
   3.597519504368622*^9, 3.597519511106611*^9}, {3.597519669788661*^9, 
   3.597519734426497*^9}, {3.59751981598682*^9, 3.597519868839301*^9}, 
   3.597522302952811*^9, {3.597524813877384*^9, 3.597524814193177*^9}, {
   3.628786222516592*^9, 3.628786222552297*^9}, 3.628786332239724*^9, 
   3.701092810237485*^9, {3.778749050422837*^9, 3.778749050427503*^9}},
 CellLabel->
  "In[2169]:=",ExpressionUUID->"5ac2f0fb-5aa8-4b9a-b510-12061e3fb8df"],

