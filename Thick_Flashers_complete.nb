Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StyledRuledPatchSequence", "::", "badxvrs"}], 
   "=", "\"\<`1` is an invalid format for the TransverseLineStyle \
option.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.689272201267986*^9, 3.689272246702151*^9}, 
   3.691407764494983*^9, {3.693959499918167*^9, 3.693959504197316*^9}, {
   3.69396067180645*^9, 3.693960675197074*^9}, {3.694008644776211*^9, 
