Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"boundary", ",", "lines"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"boundary", "=", 
      RowBox[{"SquareVertices", "[", "1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{"MakeCourteousAnarchyLines", "[", 
       RowBox[{"6", ",", "0.1", ",", "boundary", ",", 
        RowBox[{"RandSeed", "\[Rule]", "0"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Found \>\"", ",", 
       RowBox[{
        RowBox[{"Length", "[", "lines", "]"}], "-", 
        RowBox[{"Length", "[", "boundary", "]"}]}], ",", "\"\< lines\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Line", "/@", "lines"}], ",", "Blue"}], "]"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.627764437515332*^9, 3.627764468203155*^9}, {
   3.627764498746941*^9, 3.627764564702236*^9}, {3.627764598621269*^9, 
