Cell[CellGroupData[{

Cell[TextData[{
 "BackPlaneGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TGraph3D\n\t(options) BackPlaneFacet, \
BackPlaneTolerance, Options[Graphics]"
}], "Subsubsection",
 CellChangeTimes->{{3.693483062137084*^9, 3.693483090782201*^9}, {
  3.6934834253126717`*^9, 
  3.693483429681595*^9}},ExpressionUUID->"d479933d-5769-454e-adc6-\
1fc5b98d6c30"],

Cell[TextData[{
 "BackPlaneGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph3D and creates a Graphics object that represents a \
backplane that the object could be glued to. The backplane is the border \
polygon of the folded form, projected into the plane of the specified facet, \
minus any vertices whose perpendicular offset from the backplane facet \
exceeds the specified tolerance. Errors are thrown in any part of the crease \
pattern extends below the backplane, or if the computed backplane is not a \
valid polygon."
}], "Text",
 CellChangeTimes->{{3.693482969687779*^9, 3.693483053870489*^9}, {
  3.693483113182867*^9, 3.6934831453838043`*^9}, {3.693483321831563*^9, 
  3.693483372321238*^9}, {3.693490396403275*^9, 
  3.693490466117069*^9}},ExpressionUUID->"75677bb6-0fc4-453a-9d37-\
07896b00d70b"],

Cell["\<\
Arguments:
\ttobj \[LongDash] the TGraph3D object\
\>", "Text",
 CellChangeTimes->{{3.693483216159587*^9, 
  3.693483223968178*^9}},ExpressionUUID->"28a0e4b4-eb33-44a3-8533-\
db9347345139"],

Cell[TextData[{
 "Options:\n\tBackPlaneFacet \[Rule] ",
 StyleBox["k | {i1,i2,i3}",
  FontSlant->"Italic"],
 ". specifies facet or vertex indices that set the height and orientation of \
the backplane.\n\tBackPlaneTolerance \[Rule] ",
 StyleBox["tol",
  FontSlant->"Italic"],
 ", sets the z-tolerance of which vertices are included.\n\tOptions[Graphics] \
are passed through."
}], "Text",
 CellChangeTimes->{{3.693483230503363*^9, 3.693483251800346*^9}, {
  3.693483287279922*^9, 3.693483319136911*^9}, {3.693483415890053*^9, 
  3.693483422441557*^9}, {3.697673381243113*^9, 
  3.697673451178281*^9}},ExpressionUUID->"d7f824f2-efa8-4a1c-bfa6-\
809f7ed50d35"],

Cell["\<\
Returns a Graphics object containing the styled outline of the backplane.\
\>", "Text",
 CellChangeTimes->{{3.693483376392426*^9, 
  3.6934833921132717`*^9}},ExpressionUUID->"d77e69f3-91db-4db0-995b-\
cb53a18efad8"],

Cell["\<\
This is primarily useful as a backing for RigidlyFoldableQuadMesh patterns. \
If you scale the CP and the backplane by the same amount, the backplane can \
be used as mounting for the folded CP.\
\>", "Text",
 CellChangeTimes->{{3.693490514997736*^9, 
  3.693490570422017*^9}},ExpressionUUID->"947035cb-77b4-4deb-9a7d-\
e65181468df6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BackPlaneFacet", "::", "usage"}], 
   "=", "\"\<BackPlaneFacet is an option to BackPlaneGraphics that specifies \
the facet or vertex indices that the backplane should be coplanar \
with.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.693483470194716*^9, 3.693483515770193*^9}, {
  3.697673458410307*^9, 3.697673460827354*^9}},
 CellLabel->
  "In[2107]:=",ExpressionUUID->"e90df463-bbd5-4804-897b-fbb7ca41b38d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BackPlaneTolerance", "::", "usage"}], 
   "=", "\"\<BackPlaneTolerance is an option to BackPlaneGraphics that \
specifies the tolerance on border polygon vertices relative to the backplane.\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.693483470194716*^9, 3.693483558266012*^9}},
 CellLabel->
  "In[2108]:=",ExpressionUUID->"89bb5c6d-3d48-4c92-b4c2-cd58a9679d5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "BackPlaneGraphics", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"BackPlaneFacet", "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"BackPlaneTolerance", "\[Rule]", 
      SuperscriptBox["10", 
       RowBox[{"-", "6"}]]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.693483410246331*^9, 3.693483463928215*^9}},
 CellLabel->
  "In[2109]:=",ExpressionUUID->"08f06116-880f-4ed7-9a09-633de043a34e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BackPlaneGraphics", "::", "badfacet"}], 
   "=", "\"\<Backplane vertex list `1` should have 3 entries.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.693484091270434*^9, 3.693484110454142*^9}, {
  3.697673606124651*^9, 3.69767362404438*^9}},
 CellLabel->
  "In[2110]:=",ExpressionUUID->"af423d7c-8843-4172-be36-eaa70327325e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BackPlaneGraphics", "::", "badverts"}], 
   "=", "\"\<Vertices `1` lie below the backplane facet `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.693484091270434*^9, 3.693484110454142*^9}},
 CellLabel->
  "In[2111]:=",ExpressionUUID->"0b5b7c30-d2b0-44db-8e38-593a6149ebf3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BackPlaneGraphics", "::", "badpoly"}], 
   "=", "\"\<The backplane `1` is not a valid polygon.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.693484091270434*^9, 3.693484110454142*^9}, {
  3.693484396784892*^9, 3.693484411952217*^9}},
 CellLabel->
  "In[2112]:=",ExpressionUUID->"16001b00-cdd5-4c2c-9bdb-9f201cf51d2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BackPlaneGraphics", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bpf", ",", "bpt", ",", "tobj1", ",", "bverts", ",", "verts3d", ",", 
      "faces", ",", "f0", ",", "xx", ",", "yy", ",", "zz", ",", "p0", ",", 
      "badverts", ",", "bpverts", ",", "gopts"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "BackPlaneGraphics"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"bpf", "=", 
      RowBox[{
       RowBox[{"BackPlaneFacet", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "BackPlaneGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bpt", "=", 
      RowBox[{
       RowBox[{"BackPlaneTolerance", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "BackPlaneGraphics", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", "tobj", ",", 
        RowBox[{"tobj", "//", "AddTPlaneGraph"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bverts", ",", "verts3d", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{"BoundaryVertices", ",", "Vertices3D", ",", "Faces"}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f0", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "bpf", "]"}], "===", "List"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "bpf", "]"}], "\[NotEqual]", "3"}], ",", 
           RowBox[{
            RowBox[{"Message", "[", 
             RowBox[{
              RowBox[{"BackPlaneGraphics", "::", "badfacet"}], ",", "bpf"}], 
             "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "bpf", 
          "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"verts3d", "\[LeftDoubleBracket]", 
           RowBox[{
           "faces", "\[LeftDoubleBracket]", "bpf", "\[RightDoubleBracket]"}], 
           "\[RightDoubleBracket]"}], ",", "3"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"zz", "=", 
      RowBox[{"TriangleNormal3D", "@@", "f0"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"xx", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{
        RowBox[{"f0", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        "-", 
        RowBox[{
        "f0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"yy", "=", 
      RowBox[{"zz", "\[Cross]", "xx"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p0", "=", 
      RowBox[{"f0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Check", " ", "to", " ", "ensure", " ", "that", " ", "no", " ", 
       "vertices", " ", "lie", " ", "below", " ", "the", " ", "backplane", " ",
        "face"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"badverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#1", "-", "p0"}], ")"}], ".", "zz"}], "<", 
           RowBox[{"-", "bpt"}]}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"badverts", ",", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "]"}]}], "]"}], "&"}], ",", "verts3d"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"ListEmptyQ", "[", "badverts", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"BackPlaneGraphics", "::", "badverts"}], ",", "badverts", ",",
           "bpf"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "build", " ", "list", " ", "of", " ", "vertices", " ", "of", " ", 
        "border", " ", "polygon", " ", "that", " ", "are", " ", "at", " ", 
        "that", " ", "height"}], ",", " ", 
       RowBox[{
       "keeping", " ", "only", " ", "those", " ", "vertices", " ", "in", " ", 
        "the", " ", "same", " ", 
        RowBox[{"plane", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"bpverts", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", "-", "p0"}], ")"}], ".", "zz"}], "]"}], "\[LessEqual]",
           "bpt"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"bpverts", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "-", "p0"}], ")"}], ".", "xx"}], ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"#", "-", "p0"}], ")"}], ".", "yy"}]}], "}"}]}], 
          "]"}]}], "]"}], "&"}], "/@", 
      RowBox[{
      "verts3d", "\[LeftDoubleBracket]", "bverts", 
       "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "check", " ", "that", " ", "we", " ", "actually", " ", "have", " ", "a",
        " ", "valid", " ", "polygon"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "bverts", "]"}], "<", "3"}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"PolygonSignedArea2D", "[", "bverts", "]"}], "]"}], "<", 
         "bpt"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"BackPlaneGraphics", "::", "badpoly"}], ",", "bpverts"}], 
         "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"return", " ", 
       RowBox[{"backplane", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"gopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Style", "[", 
