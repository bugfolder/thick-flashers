Cell[CellGroupData[{

Cell[TextData[{
 "FoldAngleMultipliers2D[",
 StyleBox["f",
  FontSlant->"Italic"],
 ", {",
 StyleBox["rl",
  FontSlant->"Italic"],
 ", ",
 StyleBox["rr",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.692217777669051*^9, 
  3.6922178111983356`*^9}},ExpressionUUID->"868e20b1-d471-4304-b301-\
2f718d5159fd"],

Cell[TextData[{
 StyleBox["FoldAngleMultipliers2D[", "Text"],
 StyleBox["f", "Text",
  FontSlant->"Italic"],
 StyleBox[", {", "Text"],
 StyleBox["rl", "Text",
  FontSlant->"Italic"],
 StyleBox[", ", "Text"],
 StyleBox["rr", "Text",
  FontSlant->"Italic"],
 StyleBox["}] takes a discretized fold and its left and right ruling angles \
and computes the fold angle multipliers for each vertex, assuming individual \
flat-foldability at each vertex (which we check).", "Text"]
}], "Text",
 CellChangeTimes->{{3.69221776425238*^9, 
  3.692217879563823*^9}},ExpressionUUID->"c75e10b0-33d0-4a4a-bb9c-\
44c4c1e0375b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FoldAngleMultipliers2D", "::", "notff"}], 
   "=", "\"\<Vertex `1` is not flat-foldable; it has Kawasaki sum `2` \
\[Degree].\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.692225104437888*^9, 3.692225129908803*^9}, {
  3.692225167990843*^9, 3.692225180274272*^9}, {3.692225323621517*^9, 
  3.692225324277732*^9}},
 CellLabel->
  "In[4088]:=",ExpressionUUID->"83b0d927-8a40-4658-b09f-038faa4775c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAngleMultipliers2D", "[", 
   RowBox[{"f_List", ",", 
    RowBox[{"{", 
     RowBox[{"rl_List", ",", "rr_List"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "a1", ",", "a2", ",", "a3", ",", "a4", ",", "ak"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{"a2", "=", 
       RowBox[{"a3", "=", 
        RowBox[{"a4", "=", 
         RowBox[{"{", "}"}]}]}]}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "sector", " ", "angles", " ", "at", " ", "each", " ", "vertex"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"a1", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "\[NotEqual]", "1"}], ",", 
            RowBox[{"RotationAngle", "[", 
             RowBox[{
              RowBox[{
              "rl", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
              RowBox[{
               RowBox[{"f", "\[LeftDoubleBracket]", 
                RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}], "-", 
               RowBox[{
               "f", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}]}], "]"}], ",", "Null"}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"a2", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "\[NotEqual]", "1"}], ",", 
            RowBox[{"RotationAngle", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"f", "\[LeftDoubleBracket]", 
                RowBox[{"i", "-", "1"}], "\[RightDoubleBracket]"}], "-", 
               RowBox[{
               "f", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
              ",", 
              RowBox[{
              "rr", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             "]"}], ",", "Null"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"a3", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "\[NotEqual]", "n"}], ",", 
            RowBox[{"RotationAngle", "[", 
             RowBox[{
              RowBox[{
              "rr", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
              RowBox[{
               RowBox[{"f", "\[LeftDoubleBracket]", 
                RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "-", 
               RowBox[{
               "f", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}]}], "]"}], ",", "Null"}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"a4", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "\[NotEqual]", "n"}], ",", 
            RowBox[{"RotationAngle", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"f", "\[LeftDoubleBracket]", 
                RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "-", 
               RowBox[{
               "f", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
              ",", 
              RowBox[{
              "rl", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             "]"}], ",", "Null"}], "]"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ak", "=", 
         RowBox[{
          RowBox[{
          "a1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "a2", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "+", 
          RowBox[{
          "a3", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "-", 
          RowBox[{
          "a4", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Chop", "[", "ak", "]"}], "\[NotEqual]", "0"}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"FoldAngleMultipliers2D", "::", "notff"}], ",", "i", ",", 
             RowBox[{"ak", "/", "\[Degree]"}]}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "\[NotEqual]", "1"}], ",", 
         FractionBox[
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
              "a1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "+", 
              RowBox[{
              "a2", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             ")"}], "/", "2"}], "]"}], 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
              "a1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "-", 
              RowBox[{
              "a2", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             ")"}], "/", "2"}], "]"}]], ",", 
         FractionBox[
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
              "a4", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "+", 
              RowBox[{
              "a3", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             ")"}], "/", "2"}], "]"}], 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
              "a4", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "-", 
              RowBox[{
              "a3", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             ")"}], "/", "2"}], "]"}]]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.692217881244052*^9, 3.692217903655357*^9}, {
  3.692224585723638*^9, 3.692224701855068*^9}, {3.6922248113292437`*^9, 
  3.692225098993704*^9}, {3.692225140374881*^9, 3.692225338448326*^9}, {
  3.692225505742127*^9, 3.692225542815756*^9}, {3.692225801079068*^9, 
  3.692225828756396*^9}, {3.692225908696828*^9, 3.692225926957822*^9}, {
  3.778749050675837*^9, 3.778749050686041*^9}},
 CellLabel->
  "In[4089]:=",ExpressionUUID->"e99e6470-3ec1-4725-98cd-931823104601"],

Cell["\<\
Example. Compute fold angle multipliers for an ellipse. We should get the \
same values if we\[CloseCurlyQuote]ve properly discretized the curve.\
\>", "Text",
 CellChangeTimes->{{3.6922179059248867`*^9, 3.692217906971982*^9}, {
  3.692225959291457*^9, 3.692225966479836*^9}, {3.692226429775934*^9, 
  3.692226440629406*^9}},ExpressionUUID->"e3d65b3e-7a4e-4937-b5ab-\
853e771b8bde"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cs2", ",", "f", ",", "cl", ",", "cr", ",", "bl", ",", "br", ",", "gg1", 
      ",", "tlist", ",", "dcs2", ",", "gg2", ",", "rl", ",", "rr"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Set", " ", "up", " ", "an", " ", "elliptical", " ", "system"}], 
     " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cs2", "=", 
      RowBox[{"ConicSection2DSystem", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], "/", "2"}], ",", "1"}], "}"}], ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"cs2", "//", "PrettyParameters"}], "//", "ColumnForm"}], "//", 
      "Hold"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "cl", ",", "cr", ",", "bl", ",", "br"}], "}"}], "=", 
      
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "CurvedFold2D", ",", "SecondCrossCurveLeft2D", ",", 
         "SecondCrossCurveRight2D", ",", "DirectrixLeft2D", ",", 
         "DirectrixRight2D"}], "}"}], "/.", "cs2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gg1", "=", 
      RowBox[{"StyledCurvedFoldOptical", "[", 
       RowBox[{"f", ",", 
        RowBox[{"{", 
         RowBox[{"cl", ",", "cr"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bl", ",", "br"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Degree]"}], ",", 
          RowBox[{"90", "\[Degree]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"FoldLineStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"Black", ",", 
           RowBox[{"Thickness", "[", ".005", "]"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"DirectrixLeftPointStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Darker", "[", "Red", "]"}], ",", 
           RowBox[{"PointSize", "[", ".015", "]"}]}], "}"}]}], ",", 
        RowBox[{"DirectrixRightPointStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Darker", "[", "Green", "]"}], ",", 
           RowBox[{"PointSize", "[", ".015", "]"}]}], "}"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Graphics", "[", "gg1", "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"discretize", " ", "the", " ", "system"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tlist", "=", 
      RowBox[{"DiscretizeCurveUniformly", "[", 
       RowBox[{"f", ",", "5", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"90", "\[Degree]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<tlist/\[Degree] = \>\"", ",", 
        RowBox[{"tlist", "/", "\[Degree]"}]}], "]"}], "//", "Hold"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dcs2", "=", 
      RowBox[{"DiscretizeSystem", "[", 
       RowBox[{"cs2", ",", "tlist"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", ",", "cl", ",", "cr", ",", "bl", ",", "br"}], "}"}], "=", 
      
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "CurvedFold2D", ",", "SecondCrossCurveLeft2D", ",", 
         "SecondCrossCurveRight2D", ",", "DirectrixLeft2D", ",", 
         "DirectrixRight2D"}], "}"}], "/.", "dcs2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Draw", " ", "discrete", " ", "version"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"gg2", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", "f", "]"}], ",", "Black"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", "cl", "]"}], ",", 
          RowBox[{"Lighter", "[", 
           RowBox[{"Purple", ",", ".75"}], "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Line", "[", "cr", "]"}], ",", 
          RowBox[{"Lighter", "[", 
           RowBox[{"Purple", ",", ".75"}], "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "#", "]"}], ",", "LightGray"}], "]"}], "&"}],
          "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"bl", ",", "f"}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "#", "]"}], ",", "LightGray"}], "]"}], "&"}],
          "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"br", ",", "f"}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "#", "]"}], ",", "Red"}], "]"}], "&"}], "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"cl", ",", "f"}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Line", "[", "#", "]"}], ",", "Green"}], "]"}], "&"}], "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"cr", ",", "f"}], "}"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Point", "[", "#", "]"}], ",", "Black", ",", 
            RowBox[{"PointSize", "[", ".015", "]"}]}], "]"}], "&"}], "/@", 
         "f"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Point", "[", "#", "]"}], ",", "Red", ",", 
            RowBox[{"PointSize", "[", ".015", "]"}]}], "]"}], "&"}], "/@", 
         "cl"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Point", "[", "#", "]"}], ",", "Green", ",", 
            RowBox[{"PointSize", "[", ".015", "]"}]}], "]"}], "&"}], "/@", 
         "cr"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Graphics", "[", "gg1", "]"}], ",", 
          RowBox[{"Graphics", "[", "gg2", "]"}]}], "}"}], "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "//", "Print"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "construct", " ", "left", " ", "and", " ", "right", " ", "ruling", " ", 
       "lines", " ", "and", " ", "FAMs"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rl", "=", 
      RowBox[{"cl", "-", "f"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rr", "=", 
      RowBox[{"cr", "-", "f"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"FoldAngleMultipliers2D", "[", 
      RowBox[{"f", ",", 
       RowBox[{"{", 
        RowBox[{"rl", ",", "rr"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.692199962069858*^9, 3.692199997388245*^9}, {
   3.692200142738181*^9, 3.692200161501679*^9}, {3.692200228301399*^9, 
   3.6922002290077763`*^9}, {3.69220066408462*^9, 3.692200666727583*^9}, {
   3.692200919069356*^9, 3.692200924932605*^9}, {3.692202681876543*^9, 
   3.692202685391226*^9}, {3.692206189069113*^9, 3.692206303124434*^9}, {
   3.69221239207813*^9, 3.692212406659828*^9}, {3.692218057595321*^9, 
   3.6922182055301237`*^9}, {3.692218263940379*^9, 3.692218382552505*^9}, {
   3.692218458181726*^9, 3.6922185576894617`*^9}, {3.692218592881954*^9, 
   3.6922186486081867`*^9}, {3.6922245372112913`*^9, 3.692224548087056*^9}, {
   3.692225350388684*^9, 3.692225365106969*^9}, {3.692225408810891*^9, 
   3.692225447631414*^9}, 3.69222549372884*^9, {3.692225990720243*^9, 
   3.692226018403274*^9}, {3.692226069235769*^9, 3.6922261271515903`*^9}, {
   3.692226159961765*^9, 3.692226246242886*^9}, {3.692281941905144*^9, 
   3.692281953088224*^9}},
 CellLabel->
  "In[4090]:=",ExpressionUUID->"09a929be-e468-4026-b0a9-0a686418f705"]
