eec2fa2c4073"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["s",
  FontSlant->"Italic"],
 " \[LongDash] a pure function of two variables that gives the surface vector \
in 2D or 3D.\n\t{",
 StyleBox["u0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["u1",
  FontSlant->"Italic"],
 "} \[LongDash] bounds on the first parameter.\n\t{",
 StyleBox["v0",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v1",
  FontSlant->"Italic"],
 "} \[LongDash] bounds on the second parameter, either evaluatable quantities \
or functions of ",
 StyleBox["u",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.691407631452083*^9, 3.691407646510158*^9}, {
   3.782510994812099*^9, 3.782511007095962*^9}, 3.800011078324512*^9, {
   3.800011356534876*^9, 3.800011386942893*^9}, {3.800016483304716*^9, 
   3.80001649492918*^9}},ExpressionUUID->"5217d02e-84a9-42cd-8ef7-\
c6bfde079c23"],

Cell[TextData[{
 "Options:\n\tPatchDivisions \[Rule] {",
 StyleBox["nu",
  FontSlant->"Italic"],
 ", ",
 StyleBox["nv",
  FontSlant->"Italic"],
 "}, the number of divisions to use in the two parameters.\n\t\
SurfaceColorFunction \[Rule] Automatic | ",
 StyleBox["f",
  FontSlant->"Italic"],
 "[",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "], specifies the color to use at position {",
 StyleBox["u",
  FontSlant->"Italic"],
 ", ",
 StyleBox["v",
  FontSlant->"Italic"],
 "}."
}], "Text",
 CellChangeTimes->{{3.691407622644957*^9, 3.691407624510171*^9}, 
   3.691407757895178*^9, {3.69152370275533*^9, 3.691523704134989*^9}, {
   3.691523736543352*^9, 3.6915237509816933`*^9}, {3.692211331236106*^9, 
