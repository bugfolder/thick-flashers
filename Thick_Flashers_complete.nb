             RowBox[{"StdFaceLabels", "[", 
              RowBox[{"verts3d", ",", "faces"}], "]"}], ",", "_", ",", "fl"}],
             "]"}], ",", 
           RowBox[{"Darker", "[", 
            RowBox[{"fc", ",", "0.75"}], "]"}]}], "]"}]}], "]"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
