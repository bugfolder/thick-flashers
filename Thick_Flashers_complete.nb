Cell[BoxData[
 RowBox[{
  RowBox[{"SphericalAngleLabels", "[", 
   StyleBox[
    RowBox[{"foldvectors_List", ",", " ", "opts___"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sal", ",", "dal", ",", "sar", ",", "dar", ",", "nn", ",", 
      "sectorvectors"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sal", "=", 
      RowBox[{
       RowBox[{"SectorAngleLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SphericalAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dal", "=", 
      RowBox[{
       RowBox[{"DihedralAngleLabels", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SphericalAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sar", "=", 
      RowBox[{
       RowBox[{"SectorAngleRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SphericalAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dar", "=", 
      RowBox[{
       RowBox[{"DihedralAngleRadius", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "SphericalAngleLabels", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"Length", "[", "foldvectors", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sal", "===", "Automatic"}], ",", 
       RowBox[{"sal", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            
            SubscriptBox["\"\<\!\(\*StyleBox[\"\[Alpha]\",FontFamily->\"\
Symbol\",FontWeight->\"Regular\"]\)\>\"", 
             RowBox[{"ToString", "[", "i", "]"}]], ",", "16"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nn"}], "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dal", "===", "Automatic"}], ",", 
       RowBox[{"dal", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            
            SubscriptBox["\"\<\!\(\*StyleBox[\"\[Gamma]\",FontFamily->\"\
Symbol\",FontWeight->\"Regular\"]\)\>\"", 
             RowBox[{"ToString", "[", "i", "]"}]], ",", "16"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nn"}], "}"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sectorvectors", "=", " ", 
      RowBox[{"NormalizeReal", "/@", 
       RowBox[{"(", 
        RowBox[{"foldvectors", " ", "+", " ", 
         RowBox[{"RotateLeft", "[", "foldvectors", "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sal", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Text", ",", 
           RowBox[{"{", 
            RowBox[{"sal", ",", 
             RowBox[{"sar", " ", "sectorvectors"}]}], "}"}]}], "]"}]}], "]"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dal", "===", "None"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Text", ",", 
           RowBox[{"{", 
            RowBox[{"dal", ",", 
             RowBox[{"dar", " ", "foldvectors"}]}], "}"}]}], "]"}]}], "]"}]}],
       "}"}]}]}], "]"}]}]], "Input",
