 RowBox[{
  RowBox[{"PartitionedGraphicsGrid", "[", 
   RowBox[{"glist_List", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
  RowBox[{"GraphicsGrid", "[", 
   RowBox[{"Partition", "[", 
    RowBox[{"glist", ",", "n", ",", "n", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.533644770345911*^9, 3.5336448206450644`*^9}, {
