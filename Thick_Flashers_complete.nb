a664e6ec0020"],

Cell[TextData[{
 "AbsorbOneDivalentVertex[",
 StyleBox["edges",
  FontSlant->"Italic"],
 "] absorbs a single divalent vertex at a time from a list of edge indices. \
Only used internally."
}], "Text",
 CellChangeTimes->{{3.5916490588003798`*^9, 
  3.5916490676799507`*^9}},ExpressionUUID->"717cdabe-f703-4732-bc07-\
f50cbaeb7052"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AbsorbOneDivalentVertex", "[", "edges_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vinds", ",", "vvals", ",", "dvvals", ",", "di"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vinds", "=", 
      RowBox[{"Flatten", "[", "edges", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vvals", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Count", "[", 
           RowBox[{"vinds", ",", "i"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Max", "[", "vinds", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dvvals", "=", 
      RowBox[{"First", "/@", 
       RowBox[{"Select", "[", 
        RowBox[{"vvals", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], "\[Equal]", "2"}], "&"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListEmptyQ", "[", "dvvals", "]"}], ",", 
       RowBox[{"Return", "[", "edges", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"di", "=", 
      RowBox[{"First", "[", "dvvals", "]"}]}], ";", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"edges", ",", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"#", ",", "di"}], "]"}]}], "&"}]}], "]"}], ",", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"edges", ",", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"#", ",", "di"}], "]"}], "&"}]}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"#", "\[NotEqual]", "di"}], "&"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.458217300902017*^9, {3.484834014155257*^9, 3.484834014704535*^9}, {
   3.591649076101227*^9, 3.591649101690565*^9}},
 CellLabel->
  "In[1103]:=",ExpressionUUID->"f130ac6e-49c5-4446-a2ad-e439c53e0534"],

Cell["Example", "Text",ExpressionUUID->"409431e7-ef44-4129-9503-620390ebdf92"],

