Cell[CellGroupData[{

Cell[TextData[{
 "MakeCourteousAnarchyLines[",
 StyleBox["ngoal",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mindist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["boundary",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MaxTries, RandSeed\nMakeCourteousAnarchyGraph[",
 StyleBox["ngoal",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mindist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["boundary",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) MaxTries, RandSeed, SamePtTolerance"
}], "Subsubsection",
 CellChangeTimes->{
  3.627764766276497*^9, 3.627770260963334*^9, {3.6278180547102003`*^9, 
   3.6278180856189404`*^9}},ExpressionUUID->"0d63e8e7-4496-46e2-bc48-\
f06f32591d4b"],

Cell[TextData[{
 "MakeCourteousAnarchyLines[",
 StyleBox["ngoal",
  FontSlant->"Italic"],
 ", ",
 StyleBox["mindist",
  FontSlant->"Italic"],
 ", ",
 StyleBox["boundary",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a list of the outline of the polygon ",
 StyleBox["boundary",
  FontSlant->"Italic"],
 " plus up to ",
 StyleBox["ngoal",
  FontSlant->"Italic"],
 " randomly placed lines plus whose intersections are separated by at least \
",
 StyleBox["mindist",
  FontSlant->"Italic"],
 " from each other. ",
 StyleBox["ngoal",
  FontSlant->"Italic"],
 " is the desired number of lines to be added, but we may not be successful \
in finding that many. It returns a list of point pairs of the line segments. \
Options are:\n\tMaxTries \[Rule] ",
 StyleBox["n",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the maximum number of attempts to find a compliant line. If we haven\
\[CloseCurlyQuote]t reached ",
 StyleBox["ngoal",
  FontSlant->"Italic"],
 " successes but have reached MaxTries attempts, we stop and return a list of \
the lines we were able to find.\n\tRandSeed \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", used to seed the random number generator."
}], "Text",
 CellChangeTimes->{{3.627763099001589*^9, 3.627763263447844*^9}, {
   3.627763366898576*^9, 3.627763410781938*^9}, {3.627763603017812*^9, 
   3.627763624880324*^9}, 3.627770261021336*^9, {3.627818770870226*^9, 
   3.627818840105757*^9}},ExpressionUUID->"ca268be6-fb06-4457-8d8a-\
e09ddd6b4f94"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MaxTries", "::", "usage"}], 
   "=", "\"\<MaxTries is an option to MakeCourteousAnarchyLines that \
specifies the maximum number of attempts to find courteous lines.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.6277643538616886`*^9, 3.62776439236034*^9}, 
   3.627770261046388*^9},
 CellLabel->
  "In[3403]:=",ExpressionUUID->"8b5749cf-cc6b-4613-b201-cde5ac7b3171"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RandSeed", "::", "usage"}], 
   "=", "\"\<RandSeed is an option to MakeCourteousAnarchyLines that \
specifies a seed for the random number generator.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.627764397327794*^9, 3.627764428979903*^9}, 
   3.627770261296335*^9},
 CellLabel->
  "In[3404]:=",ExpressionUUID->"3899c066-0fcd-4db1-a0fb-1a0ea27acf2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MakeCourteousAnarchyLines", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MaxTries", "\[Rule]", "20000"}], ",", "\[IndentingNewLine]", 
     RowBox[{"RandSeed", "\[Rule]", "0"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.62776304007912*^9, 3.627763094619073*^9}, {
   3.627763592662462*^9, 3.6277635999392443`*^9}, 3.627763635241506*^9, 
   3.62777026154383*^9},
 CellLabel->
  "In[3405]:=",ExpressionUUID->"4380d6b4-ac48-474d-86c7-52182a0450b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeCourteousAnarchyLines", "[", 
   RowBox[{"ngoal_", ",", "mindist_", ",", "boundary_List", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mt", ",", "rs", ",", "box", ",", "ctr", ",", "rad", ",", "lines", ",", 
      "ints", ",", "randline", ",", "fails", ",", "addone"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mt", "=", 
      RowBox[{
       RowBox[{"MaxTries", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeCourteousAnarchyLines", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rs", "=", 
      RowBox[{
       RowBox[{"RandSeed", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MakeCourteousAnarchyLines", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"box", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{
             "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "}"}], "&"}], "@", 
       RowBox[{"Transpose", "[", "boundary", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"Plus", "@@", "box"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rad", "=", 
      RowBox[{"Mag", "[", 
       RowBox[{"Subtract", "@@", "box"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"boundary", ",", 
         RowBox[{"RotateLeft", "[", "boundary", "]"}]}], "}"}], "]"}]}], ";", 
     
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"accumulated", " ", "lines"}], ",", " ", 
       RowBox[{"start", " ", 
        RowBox[{"w", "/", " ", "boundary"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ints", "=", "boundary"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"accumulated", " ", "intersection", " ", "points"}], ",", " ", 
       
       RowBox[{"start", " ", 
        RowBox[{"w", "/", " ", "boundary"}]}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"randline", "[", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rctr", ",", "dir"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "this", " ", "function", " ", "returns", " ", "a", " ", "random", " ",
           "line", " ", "whose", " ", "center", " ", "point", " ", "lies", " ",
           "within", " ", "the", " ", "polygon", " ", "and", " ", "with", " ",
           "a", " ", "random", " ", "direction"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rctr", "=", "Null"}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rctr", "\[Equal]", "Null"}], "||", 
            RowBox[{"!", 
             RowBox[{"PtInConvexPolygonQ", "[", 
              RowBox[{"rctr", ",", "boundary"}], "]"}]}]}], ",", 
           RowBox[{"rctr", "=", 
            RowBox[{"ctr", "+", 
             RowBox[{"rad", " ", 
              RowBox[{"Random", "[", "]"}], 
              RowBox[{"U", "[", 
               RowBox[{"2", "\[Pi]", " ", 
                RowBox[{"Random", "[", "]"}]}], "]"}]}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dir", "=", 
          RowBox[{"rad", " ", 
           RowBox[{"U", "[", 
            RowBox[{"2", "\[Pi]", " ", 
             RowBox[{"Random", "[", "]"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ClipSegmentToConvexPolygon", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"rctr", "-", " ", "dir"}], ",", " ", 
             RowBox[{"rctr", "+", "dir"}]}], "}"}], ",", "boundary"}], 
          "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fails", "=", "0"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"tracks", " ", "numbers", " ", "of", " ", "attempts"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"addone", "[", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"newline", ",", "newints"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "This", " ", "function", " ", "attempts", " ", "to", " ", "add", " ",
           "a", " ", "new", " ", "line", " ", "to", " ", "the", " ", 
          "collection"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Catch", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"newline", "=", 
               RowBox[{"randline", "[", "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"newints", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"LineInt2D1", "[", 
                  RowBox[{
                   RowBox[{
                   "newline", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", 
                   RowBox[{
                   "newline", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], ",", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], "]"}], "&"}], "/@", 
                "lines"}]}], ";", 
              RowBox[{"(*", " ", 
               RowBox[{
               "get", " ", "all", " ", "intersection", " ", "pts", " ", 
                "with", " ", "existing", " ", "lines"}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"newints", "=", 
               RowBox[{"Select", "[", 
                RowBox[{"newints", ",", 
                 RowBox[{
                  RowBox[{"PtInConvexPolygonQ", "[", 
                   RowBox[{"#", ",", "boundary"}], "]"}], "&"}]}], "]"}]}], ";", 
              RowBox[{"(*", " ", 
               RowBox[{
               "keep", " ", "only", " ", "the", " ", "ones", " ", "withn", " ",
                 "the", " ", "boundary"}], " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "newints", "]"}], "\[LessEqual]", 
                  "2"}], "&&", 
                 RowBox[{
                  RowBox[{"Length", "[", "lines", "]"}], "\[NotEqual]", 
                  RowBox[{"Length", "[", "boundary", "]"}]}]}], ",", 
                RowBox[{"Throw", "[", 
                 RowBox[{"-", "1"}], "]"}]}], "]"}], ";", 
              RowBox[{"(*", " ", 
               RowBox[{
               "we", " ", "want", " ", "all", " ", "new", " ", "lines", " ", 
                "to", " ", "intersect", " ", "at", " ", "least", " ", "one", " ",
                 "other", " ", "interior", " ", "line"}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "check", " ", "intersections", " ", "along", " ", "this", " ", 
                "line"}], " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Mag", "[", 
                    RowBox[{
                    RowBox[{
                    "newints", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "-", 
                    RowBox[{
                    "newints", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}], "]"}], "<", "mindist"}], ",", 
                  RowBox[{
                   RowBox[{"fails", "++"}], ";", 
                   RowBox[{"Throw", "[", 
                    RowBox[{"-", "1"}], "]"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", 
                  RowBox[{"Length", "[", "newints", "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", 
                  RowBox[{"i", "+", "1"}], ",", 
                  RowBox[{"Length", "[", "newints", "]"}]}], "}"}]}], "]"}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "check", " ", "intersections", " ", "with", " ", "other", " ", 
                "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Mag", "[", 
                    RowBox[{
                    RowBox[{
                    "newints", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "-", "#"}], "]"}], "<", 
                    "mindist"}], ",", 
                    RowBox[{
                    RowBox[{"fails", "++"}], ";", 
                    RowBox[{"Throw", "[", 
                    RowBox[{"-", "1"}], "]"}]}]}], "]"}], "&"}], "/@", 
                 "ints"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", 
                  RowBox[{"Length", "[", "newints", "]"}]}], "}"}]}], "]"}], 
              ";"}], "\[IndentingNewLine]", "]"}], "\[Equal]", 
            RowBox[{"-", "1"}]}], ",", 
           RowBox[{"Return", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"still", " ", 
            RowBox[{"here", "?", " ", "then"}], " ", 
            RowBox[{"it", "'"}], "s", " ", "a", " ", "valid", " ", 
            RowBox[{"line", ".", " ", "Add"}], " ", "it"}], ",", " ", 
           RowBox[{"and", " ", "its", " ", 
            RowBox[{"intersections", "."}]}]}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"lines", ",", "newline"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ints", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"ints", ",", "newints"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"SeedRandom", "[", "rs", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fails", "<", "mt"}], "&&", 
        RowBox[{
         RowBox[{"Length", "[", "lines", "]"}], "<", 
         RowBox[{"ngoal", "+", 
          RowBox[{"Length", "[", "boundary", "]"}]}]}]}], ",", 
       RowBox[{"addone", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "lines"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.62776291195389*^9, 3.6277629175982237`*^9}, {
  3.627762952828456*^9, 3.627762973369012*^9}, {3.627763003650021*^9, 
