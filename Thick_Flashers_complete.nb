   RowBox[{"Options", "[", "FrenetRibbonPlotPair", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"FrenetRibbonWidth", "\[Rule]", "1.0"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.800643081300602*^9, 3.800643098323678*^9}, {
  3.80064398738719*^9, 3.800643987929886*^9}, {3.8006479717522297`*^9, 
  3.800647997569232*^9}},
 CellLabel->
