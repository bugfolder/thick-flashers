Cell[BoxData[
 RowBox[{
  RowBox[{"NMatchCurvesPair", "[", 
   RowBox[{
    RowBox[{"c_Function", "|", "c_InterpolatingFunction"}], ",", 
    RowBox[{"cc_Function", "|", "cc_InterpolatingFunction"}], ",", "\[Psi]_", 
    ",", "\[Sigma]_", ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "c2dsys", ",", "ds", ",", "\[Kappa]l", ",", "t", ",", "l", ",",
       "c3dsys", ",", "tt", ",", "nn", ",", "bb", ",", "\[Kappa]", ",", 
      "c\[Eta]", ",", "s\[Eta]", ",", "ll", ",", "uu", ",", "duu", ",", 
      "\[Kappa]n", ",", "\[Tau]g", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", 
      "dd", ",", "d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c2dsys", "=", 
      RowBox[{"NCurve2DSystem", "[", 
       RowBox[{"c", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed2D", ",", "LeftCurvature2D", ",", "TangentVector2D", ",", 
         "LeftNormalVector2D"}], "}"}], "/.", "c2dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c3dsys", "=", 
      RowBox[{"NCurve3DSystem", "[", 
       RowBox[{"cc", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", ",", "nn", ",", "bb", ",", "\[Kappa]"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "TangentVector3D", ",", "NormalVector3D", ",", "BinormalVector3D", ",",
          "Curvature3D"}], "}"}], "/.", "c3dsys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c\[Eta]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        FractionBox[
         RowBox[{"\[Kappa]l", "[", "s", "]"}], 
         RowBox[{"\[Kappa]", "[", "s", "]"}]]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Eta]", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"\[Psi]", 
         FractionBox[
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"\[Kappa]", "[", "s", "]"}], "2"], "-", 
            SuperscriptBox[
             RowBox[{"\[Kappa]l", "[", "s", "]"}], "2"]}]], 
          RowBox[{"\[Kappa]", "[", "s", "]"}]]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ll", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"c\[Eta]", "[", "s", "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "-", 
         RowBox[{
          RowBox[{"s\[Eta]", "[", "s", "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"s\[Eta]", "[", "s", "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"c\[Eta]", "[", "s", "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"duu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uu", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"duu", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         RowBox[{"Mag", "[", 
          RowBox[{"duu", "[", "s", "]"}], "]"}]], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"duu", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
         FractionBox[
          RowBox[{
           RowBox[{"duu", "[", "s", "]"}], ".", 
           RowBox[{"ll", "[", "s", "]"}]}], 
          RowBox[{"Mag", "[", 
           RowBox[{"duu", "[", "s", "]"}], "]"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
            RowBox[{"tt", "[", "s", "]"}]}], "+", 
           RowBox[{
            RowBox[{"s\[Rho]L", " ", "[", "s", "]"}], 
            RowBox[{"ll", "[", "s", "]"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
            RowBox[{"t", "[", "s", "]"}]}], "+", 
           RowBox[{
            RowBox[{"s\[Rho]L", "[", "s", "]"}], " ", 
            RowBox[{"l", "[", "s", "]"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d", ",", "cc", ",", "dd"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.688069915560059*^9, 3.688069954792525*^9}, {
