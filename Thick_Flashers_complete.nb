Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MatchCurveSpeed", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Simplification", "\[Rule]", "None"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.691580406330134*^9, 3.691580428135356*^9}, 
   3.800209302364388*^9, 3.800211638718344*^9},
 CellLabel->
  "In[3724]:=",ExpressionUUID->"972e1b30-3c09-4676-899f-19e0e72a55a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"StrictArguments", "[", "MatchCurveSpeed", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.800212174090212*^9, 3.800212201939888*^9}},
 CellLabel->
  "In[3725]:=",ExpressionUUID->"98b958c5-3cd7-4ba2-b573-c8c034aa1811"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatchCurveSpeed", "[", 
   RowBox[{"c1_Function", ",", "c2_Function", ",", "ui_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dsopts", ",", "si", ",", "as", ",", "sfn", ",", "s", ",", "dc1", ",", 
      "dc2", ",", "f", ",", "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dsopts", "=", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "DSolve", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MatchCurveSpeed", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "MatchCurveSpeed", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dc1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"c1", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dc2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"c2", "'"}], "[", "s", "]"}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"f", "'"}], "[", "s", "]"}], 
            SqrtBox[
             RowBox[{
              RowBox[{"dc2", "[", 
               RowBox[{"f", "[", "s", "]"}], "]"}], ".", 
              RowBox[{"dc2", "[", 
               RowBox[{"f", "[", "s", "]"}], "]"}]}]]}], "\[Equal]", 
           SqrtBox[
            RowBox[{
             RowBox[{"dc1", "[", "s", "]"}], ".", 
             RowBox[{"dc1", "[", "s", "]"}]}]]}], ",", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"f", "[", "ui", "]"}], "\[Equal]", "ui"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"f", "[", "s", "]"}], ",", "s", ",", 
        RowBox[{"Evaluate", "[", "dsopts", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "soln", "]"}], "===", "DSolve"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"MatchCurveSpeed", "::", "nosoln"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Flatten", "[", "soln", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Functionize", "[", 
      RowBox[{"s", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"c2", "[", 
          RowBox[{"f", "[", "s", "]"}], "]"}], "/.", "soln"}], "//", 
        "sfn"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.691580180808895*^9, 3.69158022627394*^9}, {
   3.691580371475801*^9, 3.691580403355137*^9}, {3.691580443846138*^9, 
   3.691580445713138*^9}, {3.691580506762929*^9, 3.691580547344147*^9}, {
   3.691581206084708*^9, 3.691581283947212*^9}, {3.69158145120671*^9, 
   3.691581525884199*^9}, {3.691581757855204*^9, 3.691581828170006*^9}, {
   3.691581863211568*^9, 3.691581873699428*^9}, {3.6915821540076313`*^9, 
   3.691582157619039*^9}, {3.691582448836617*^9, 3.691582450959959*^9}, {
   3.691583831419962*^9, 3.691583972656747*^9}, {3.691584011017163*^9, 
   3.691584027211404*^9}, {3.69158406186489*^9, 3.691584064555792*^9}, {
   3.691589671318015*^9, 3.691589706053676*^9}, {3.691589739714995*^9, 
   3.69158984374032*^9}, {3.691589884054215*^9, 3.6915899000568337`*^9}, {
   3.691589932208186*^9, 3.691590006598542*^9}, {3.691592247443031*^9, 
   3.69159225113265*^9}, {3.691592378680536*^9, 3.691592386339531*^9}, {
   3.6915924273528214`*^9, 3.691592457529774*^9}, {3.691592510079536*^9, 
   3.691592513243249*^9}, {3.691592548422641*^9, 3.691592569725093*^9}, {
   3.691592736472949*^9, 3.691592738422306*^9}, {3.691592769857585*^9, 
   3.691592810506574*^9}, {3.691598439818201*^9, 3.691598440530613*^9}, 
   3.79862284466453*^9, {3.800209302369616*^9, 3.800209604531046*^9}, {
   3.800209687962478*^9, 3.800209699896929*^9}, {3.800209829170886*^9, 
   3.800209874124205*^9}, 3.800210228859967*^9, 3.800210390727558*^9, {
   3.800210422334145*^9, 3.8002104223380327`*^9}, {3.800210564352685*^9, 
   3.8002105759200687`*^9}, {3.800211638723769*^9, 3.800211638729621*^9}, {
   3.800211691233405*^9, 3.800211691574333*^9}},
 CellLabel->
  "In[3726]:=",ExpressionUUID->"6bb2bf7e-356d-4996-884e-395edb57fc68"],

Cell["Example. Match two circles of different radii.", "Text",
 CellChangeTimes->{{3.691581530314789*^9, 3.691581531264145*^9}, {
  3.691592586522756*^9, 
  3.691592594485487*^9}},ExpressionUUID->"edd891a3-ea59-4fa2-a93b-\
b8b77ea006b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "c1", ",", "sd1", ",", "c2", ",", "sd2", ",", "c3", ",", 
      "sd3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c1", "=", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd1", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"c1", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c1 = \>\"", ",", 
       RowBox[{"c1", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<sd1 = \>\"", ",", 
       RowBox[{"sd1", "/.", 
        RowBox[{"s", "\[Rule]", "\"\<s\>\""}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c2", "=", 
      RowBox[{
       RowBox[{"3", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "#", "]"}], ",", 
          RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd2", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"c2", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c2 = \>\"", ",", 
       RowBox[{"c2", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<sd2 = \>\"", ",", 
       RowBox[{"sd2", "/.", 
        RowBox[{"s", "\[Rule]", "\"\<s\>\""}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"c3", "=", 
      RowBox[{"MatchCurveSpeed", "[", 
       RowBox[{"c1", ",", "c2", ",", "0", ",", 
        RowBox[{"Simplification", "\[Rule]", "Simplify"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sd3", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Mag", "[", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"c3", "[", "s", "]"}], ",", "s"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", "\[Element]", "Reals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c3 = \>\"", ",", 
       RowBox[{"c3", "//", "PrettyParameters"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<sd3 = \>\"", ",", 
       RowBox[{"sd3", "/.", 
        RowBox[{"s", "\[Rule]", "\"\<s\>\""}]}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.691581534487035*^9, 3.691581719797289*^9}, {
   3.6915821845856037`*^9, 3.691582187931343*^9}, {3.691582256572974*^9, 
   3.6915824372391353`*^9}, {3.691592583406347*^9, 3.691592585029074*^9}, {
