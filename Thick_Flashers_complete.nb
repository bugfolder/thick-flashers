Cell[TextData[{
 "GenericFoldedFormGraphics[",
 StyleBox["tobj, opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned and returns a Graphics object that shows the \
full crease pattern, both lines and polys. Options are:\n\t\
Options[FoldedFormPolys] are passed through.\n\tOptions[Graphics] are passed \
through."
}], "Text",
 CellChangeTimes->{{3.457894329999373*^9, 3.457894376905277*^9}, {
   3.45789443308113*^9, 3.457894433681082*^9}, 3.457894579355758*^9, 
   3.484782322130635*^9, {3.484835815845973*^9, 3.484835845402801*^9}, {
