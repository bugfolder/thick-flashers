    RowBox[{"{", 
     RowBox[{
     "w", ",", "e", ",", "u0", ",", "u1", ",", "s", ",", "tf", ",", "q", ",", 
      "\[Gamma]", ",", "f", ",", "cs", ",", "flist"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"e", "=", "0.1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u0", ",", "u1"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tf", "[", "i_", "]"}], ":=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"i", " ", "w"}]}], ")"}], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "s", "]"}], ",", 
           RowBox[{"Sin", "[", "s", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"f", "[", "i", "]"}], "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{"tf", "[", "i", "]"}], "[", 
          RowBox[{
           RowBox[{"q", "[", "i", "]"}], "[", "s", "]"}], "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "0", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", "1", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"s", "+", 
         RowBox[{"e", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", "s"}], "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Gamma]", "[", "0", "]"}], "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{"120.", "\[Degree]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
      "precompute", " ", "the", " ", "Curve2DSystems", " ", "analytically"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cs", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"cs", "[", "i", "]"}], "=", 
       RowBox[{"Curve2DSystem", "[", 
        RowBox[{"tf", "[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", "[", "1", "]"}], ",", 
           RowBox[{"q", "[", "2", "]"}]}], "}"}], "=", 
         RowBox[{"NLinkedFoldsNext2D", "[", 
          RowBox[{
           RowBox[{"tf", "[", "0", "]"}], ",", 
           RowBox[{"q", "[", "0", "]"}], ",", 
           RowBox[{"\[Gamma]", "[", "0", "]"}], ",", 
