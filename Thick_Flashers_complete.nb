   3.911850488671927*^9, 3.911850489160056*^9}, {3.911863713537054*^9, 
   3.911863717934305*^9}, {3.911878822130949*^9, 
   3.911878828601664*^9}},ExpressionUUID->"898b2fe2-8285-4f47-a2f4-\
f4f91cd0bfc8"],

Cell[TextData[{
 "ThickFlasherXYFns[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["t",
  FontSlant->"Italic"],
 "] returns a list of functions that return zero when the ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and ",
 StyleBox["y",
  FontSlant->"Italic"],
 " coordinates of the folded form points of the specified flasher are equal \
to their ideal (not default!) values for panel thickness ",
 StyleBox["t",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.555770103802979*^9, 3.555770107960988*^9}, {
   3.5557701658540297`*^9, 3.555770286221524*^9}, {3.555776958114599*^9, 
   3.555776962241098*^9}, {3.5558543182796383`*^9, 3.555854318370816*^9}, 
   3.55585435499504*^9, 3.719856897022521*^9, 3.719869501687148*^9, {
   3.719869577331402*^9, 3.719869588005479*^9}, 3.719869648079232*^9, {
   3.719869709086398*^9, 3.719869710934148*^9}, 3.719925980220142*^9, {
   3.719934017694395*^9, 3.71993403838063*^9}, {3.719934070684871*^9, 
   3.719934071436253*^9}, {3.911850375460519*^9, 3.911850410491301*^9}, 
   3.911850493153677*^9, 
   3.911878822158961*^9},ExpressionUUID->"d617c1bf-7041-4ff3-ab08-\
50b1b2d1eba6"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] A list of the symbolic variables of the form {",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["px",
  FontSlant->"Italic"],
 ", ",
 StyleBox["py",
  FontSlant->"Italic"],
 ", ",
 StyleBox["pp",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppx",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppy",
  FontSlant->"Italic"],
 ", ",
 StyleBox["ppz",
  FontSlant->"Italic"],
 "}.\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the number of rings.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational symmetry.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the desired thickness of the DP (used to define the sag values \
in the unfolded (deployed) form)."
}], "Text",
 CellChangeTimes->{{3.9118388009082327`*^9, 3.911839059495854*^9}, {
   3.911839142921675*^9, 3.9118391520110397`*^9}, {3.9118391990257664`*^9, 
   3.911839262431355*^9}, {3.913476666549242*^9, 3.913476674243342*^9}, 
   3.913544962787702*^9},ExpressionUUID->"21417162-adf3-4d42-9139-\
e20844830e68"],

Cell["\<\
Returns: a list of the functions whose value is zero when the x-y positions \
of the folded form points match those of the computed folded form projection.\
\
\>", "Text",
 CellChangeTimes->{{3.913544972841875*^9, 
  3.913545013320135*^9}},ExpressionUUID->"7fbfb717-4cb5-43eb-a714-\
1a480296979e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThickFlasherXYFns", "[", 
   RowBox[{"vars_", ",", "r_", ",", "h_", ",", "m_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", "ppz",
       ",", "ffprules", ",", "fsv", ",", "fsvs", ",", "fsvv"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
        "ppz"}], "}"}], "=", "vars"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fsv", "=", 
      RowBox[{"FlasherFirstSectorVertices", "[", 
       RowBox[{"pp", ",", "r", ",", "h"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"2", "D", " ", "scalarized", " ", "variables"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fsvs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
       RowBox[{"N", "[", 
        RowBox[{"FlasherScalarize", "[", 
         RowBox[{"vars", ",", "fsv", ",", "m"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Desired", " ", "2", "D", " ", "values"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"fsvv", "=", 
      RowBox[{"fsv", "/.", 
       RowBox[{"MakeThickFlasherFFProjectionRules", "[", 
        RowBox[{"pp", ",", "r", ",", "h", ",", "m", ",", "t"}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"fsvs", "-", "fsvv"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.555770401924124*^9, 3.555770415047363*^9}, {
   3.5557704496843853`*^9, 3.555770496762341*^9}, {3.555770528727864*^9, 
   3.555770589295057*^9}, {3.555770640890703*^9, 3.5557706510349293`*^9}, {
   3.555770720717556*^9, 3.555770730157117*^9}, {3.55577091863483*^9, 
   3.5557709307441*^9}, {3.555771277865065*^9, 3.555771279552263*^9}, 
   3.555771340733203*^9, 3.555788857142105*^9, {3.555854318467854*^9, 
   3.555854318531867*^9}, {3.555854355101766*^9, 3.555854355178629*^9}, 
