Cell[CellGroupData[{

Cell[TextData[{
 "RotationMatrix3DTwixt[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.707925157157031*^9, 
  3.707925177805718*^9}},ExpressionUUID->"0ac57305-f471-4b31-9cea-\
f0103016d01c"],

Cell[TextData[{
 "RotationMatrix3DTwixt[",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 "] returns the rotation matrix in 3D that rotates the vector ",
 StyleBox["p",
  FontSlant->"Italic"],
 " to point along ",
 StyleBox["q",
  FontSlant->"Italic"],
 ". Neither needs to be normalized."
}], "Text",
 CellChangeTimes->{{3.707925192968479*^9, 
  3.707925240181711*^9}},ExpressionUUID->"4e65927a-c475-482f-bd31-\
68b8f4bb4832"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotationMatrix3DTwixt", "[", 
   RowBox[{"p_List", ",", "q_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"w", ",", "\[Phi]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"p", "\[Cross]", "q"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"RotationMatrix3Du", "[", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"p", ".", "q"}], " ", ",", 
         RowBox[{"p", ".", 
          RowBox[{"(", 
           RowBox[{"q", "\[Cross]", "w"}], ")"}]}]}], "]"}], ",", "w"}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.707925253488728*^9, 3.707925318902629*^9}, {
  3.707925370192024*^9, 3.707925436377651*^9}, {3.707925466417395*^9, 
  3.707925478597155*^9}, {3.707925545489849*^9, 3.707925588857123*^9}},
 CellLabel->
  "In[705]:=",ExpressionUUID->"4e1ed0d6-1ba3-4e44-a921-f0f0b6223963"],

