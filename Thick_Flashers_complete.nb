Cell[CellGroupData[{

Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Tolerance"
}], "Subsubsection",
 CellChangeTimes->{{3.629846622752091*^9, 3.629846625422895*^9}, 
   3.630111642350101*^9, 
   3.7078398958882732`*^9},ExpressionUUID->"ee402cb1-f124-45c2-b88c-\
0e2405a86aef"],

Cell[TextData[{
 "RenderTile[{PolygonCenteredTwistTile, ",
 StyleBox["verts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ", ",
 StyleBox["types",
  FontSlant->"Italic"],
 "}, TGraph2DAssigned, ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] returns a TGraph2DAssigned+TTwistGraph for the folded form of a split \
twist in a quadrilateral specified by its vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " where \n\t",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the fractional width of each pleat where it subtends its edge, \n\td is \
the offset,\n\t",
 StyleBox["ip",
  FontSlant->"Italic"],
 " is the index of the vertex to preserve,\n\t",
 StyleBox["ctype",
  FontSlant->"Italic"],
 " is the fold type of the crossing fold,\n\t",
 StyleBox["types",
  FontSlant->"Italic"],
 " is a list of the form {M, V...} that specifies whether the central polygon \
creases are mountain or valley."
}], "Text",
 CellChangeTimes->{{3.4577256920561132`*^9, 3.4577257049238033`*^9}, {
   3.4577412006642714`*^9, 3.457741207355151*^9}, 3.4851968678273377`*^9, 
