Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MultilineSpacing", "::", "usage"}], 
   "=", "\"\<MultilineSpacing is an option to VeneerScoringGraphics that \
specifies the spacing between hairlines to use when we create a kerf from a \
group of lines.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.624891292191949*^9, 3.624891348379841*^9}, {
   3.624894772717886*^9, 3.624894789839224*^9}, 3.624913968239804*^9, {
