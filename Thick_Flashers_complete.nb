Cell[TextData[{
 "RotateGraph3D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", {\[Phi], ",
 StyleBox["w",
  FontSlant->"Italic"],
 "}] takes a TGraph3D ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " and rotates the folded form about the origin through angle \[Phi] about \
axis ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", which does not need to be normalized."
}], "Text",
 CellChangeTimes->{{3.643114801184241*^9, 3.643114844650379*^9}, {
  3.688165210526024*^9, 
  3.688165224715682*^9}},ExpressionUUID->"a5e856d8-d193-4fb8-91bd-\
849ff4d51878"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RotateGraph3D", "[", 
   RowBox[{"tobj_TObj", ",", " ", "\[Phi]_", ",", " ", "w_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "verts3d", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph3D", ",", "RotateGraph3D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Vertices3D"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts3d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationMatrix3D", "[", 
          RowBox[{"\[Phi]", ",", "w"}], "]"}], ".", "#"}], "&"}], "/@", 
       "verts3d"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tobj", "//", 
      RowBox[{"ReplaceProperty", "[", 
       RowBox[{"Vertices3D", "\[Rule]", "verts3d"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.643114793507264*^9, 3.643114793511322*^9}, {
  3.643114855867939*^9, 3.643114887834278*^9}, {3.643114921121286*^9, 
