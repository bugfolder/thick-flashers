Cell[CellGroupData[{

Cell["Voronoi/Delaunay tilings", "Subsection",
 CellChangeTimes->{{3.4660795935119877`*^9, 3.466079607003788*^9}, {
  3.551745405729474*^9, 
  3.551745406336516*^9}},ExpressionUUID->"5d2f079a-201b-44ad-8851-\
0d2ebe590a2e"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.466079609099495*^9, 
  3.466079609595439*^9}},ExpressionUUID->"69f6f36f-5c5e-4c1d-aebd-\
699390b99e82"],

Cell["\<\
Voronoi-Delaunay tessellations are a special case of primal-dual \
tessellations, which make use of the nice fact that the Delaunay \
Triangulation of a set of points and the Voronoi Diagram are reciprocal \
diagrams of one another. So, given a set of points, once can construct a \
tessellation from that set by constructing  the DT or VD, without having to \
solve a LP problem for the reciprocal diagram.\
\>", "Text",
 CellChangeTimes->{{3.466079617571042*^9, 3.466079732210042*^9}, {
  3.466092382793219*^9, 3.4660923978926377`*^9}, {3.4660934200996037`*^9, 
  3.466093423760477*^9}},ExpressionUUID->"e3917b0f-1df8-4194-aa82-\
d74055f448a2"],

Cell["\<\
This uses the ComputationalGeometry package, which we already read in as part \
of our plane graph functions.\
\>", "Text",
 CellChangeTimes->{{3.4660798814154797`*^9, 3.466079904061509*^9}, 
   3.484829045416284*^9},ExpressionUUID->"f1bcc359-8204-47da-bfcb-\
500ccc467159"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeDelaunayTriangulationPrimalDualGraph",
 "[",
 StyleBox["points",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.466091142832511*^9, 3.466091156095151*^9}, 
   3.484829077321531*^9, 3.551747576043488*^9, {3.592521306467882*^9, 
   3.592521307099109*^9}, 3.592521432573183*^9, {3.592522017390919*^9, 
   3.5925220296927757`*^9}, 3.592828810306772*^9, 
   3.594072140282771*^9},ExpressionUUID->"613d919d-476e-4010-bb8b-\
52cf99a8be9b"],

Cell[TextData[{
 "MakeDelaunayTriangulationPrimalDualGraph",
 "[",
 StyleBox["points",
  FontSlant->"Italic"],
 "] takes a list of points ",
 StyleBox["points",
  FontSlant->"Italic"],
 ", constructs the Delaunay triangulation of those points, and then turns \
that triangulation into a primal-dual pair where the dual is the reciprocal \
diagram for the primal graph. It returns a TPrimalDualGraph. The convex hull \
of the set of points will be the boundary of the primal graph."
}], "Text",
 CellChangeTimes->{{3.466091172104958*^9, 3.4660912368582077`*^9}, {
   3.466092423379387*^9, 3.4660924439295683`*^9}, 3.484829077384969*^9, {
   3.5925212149393477`*^9, 3.59252123603952*^9}, {3.592521268414212*^9, 
   3.592521272181381*^9}, 3.592521432734434*^9, {3.5928288104173317`*^9, 
   3.592828810511909*^9}, 
   3.594072140392837*^9},ExpressionUUID->"35f0ef87-3b1c-4d82-8f8e-\
a042af42c199"],

Cell["\<\
The orthogonal interior dual will be a Voronoi diagram of the interior points \
of the set (those points not on the convex hull), but since this is a \
triangle graph, we can compute the dual graph from the circumcenters of all \
the triangles, using our MakeTriangleGraphReciprocalDiagram function.\
\>", "Text",
 CellChangeTimes->{{3.466093446550252*^9, 3.466093575230147*^9}, {
   3.485219919513791*^9, 3.485219921727868*^9}, 
   3.592208599274582*^9},ExpressionUUID->"c5ebf16a-bdfe-4497-a958-\
94aff2d3086a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeDelaunayTriangulationPrimalDualGraph", "[", "pverts_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "delval", ",", "pedges", ",", "tobj", ",", "pfaces", ",", "dverts", ",", 
      "dedges", ",", "dfaces", ",", "iverts", ",", "bverts", ",", "iedges", ",",
       "bedges", ",", "bfaces"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"delval", "=", 
      RowBox[{"DelaunayTriangulation", "[", "pverts", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                 "#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"Length", "[", 
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "]"}], "}"}]}], "]"}], ",", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
              "}"}], "]"}], "&"}], "/@", "delval"}], ",", "1"}], "]"}], ",", 
        RowBox[{"SameTest", "\[Rule]", "SameEdgeQ"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"pverts", ",", "pedges"}], "]"}], "//", "AddTPlaneGraphTo"}],
        "//", "AddTPrimalDualGraphTo"}], "//", 
      "MakeTriangleGraphReciprocalDiagram"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.466091252364641*^9, 3.466091258219734*^9}, {
   3.466091807872834*^9, 3.46609181558496*^9}, {3.466091912691566*^9, 
   3.466091933518086*^9}, {3.466091974117098*^9, 3.466092183887244*^9}, {
   3.4660922195974293`*^9, 3.46609222135374*^9}, {3.484829077515445*^9, 
   3.484829077614487*^9}, 3.592208599352607*^9, 3.592237421978294*^9, 
   3.592401552458556*^9, {3.592521310282034*^9, 3.59252143277037*^9}, {
