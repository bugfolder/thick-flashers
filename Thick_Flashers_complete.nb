      RowBox[{"Darker", "[", 
       RowBox[{"Brown", ",", "0.8"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"TilingLineColor", "\[Rule]", "Orange"}], ",", 
     "\[IndentingNewLine]", 
