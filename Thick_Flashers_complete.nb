Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SingleVertexGraph2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AddTGraphExample", "[", 
   RowBox[{"SingleVertexGraph2D", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tobj", ",", "verts2d"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tobj", "=", "SingleVertexGraph"}], ";", "\[IndentingNewLine]", 
       RowBox[{"verts2d", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"1", "/", 
              SqrtBox["3"]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 RowBox[{"1", "/", 
                  SqrtBox["3"]}]}], ")"}]}]}], ",", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "/", "2"}], ")"}], " ", 
               SqrtBox["3"], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 RowBox[{"1", "/", 
                  SqrtBox["3"]}]}], ")"}]}], "-", 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "/", "2"}], ")"}], " ", 
                  SqrtBox["3"], " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    RowBox[{"1", "/", 
                    SqrtBox["3"]}]}], ")"}]}]}], ")"}]}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "/", 
              SqrtBox["3"]}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tobj", "//", 
        RowBox[{"AddTGraph2D", "[", "verts2d", "]"}]}]}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",
