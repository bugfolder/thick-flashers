90c1fe764c71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherSectorFoldedFoldLines", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "i", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"r", " ", "h"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "total", " ", "number", " ", "of", " ", "radial", " ", "increments"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"major", " ", "region"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"j", "=", 
               RowBox[{"h", " ", "ig"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   SubscriptBox["v", 
                    RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                   SubscriptBox["v", 
                    RowBox[{
                    RowBox[{"i", "-", "1"}], ",", "j", ",", "k"}]]}], "}"}], 
                 "]"}], ",", 
                RowBox[{"FlasherSharpFold", "[", "ig", "]"}]}], "]"}]}], ",", 
             
             RowBox[{"(*", " ", 
              RowBox[{"bottom", " ", "of", " ", "quadrant"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  SubscriptBox["v", 
                   RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{"i", ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "h"}], ",", 
                    RowBox[{"i", "+", "1"}]}], "]"}], ",", "k"}]]}], "}"}], 
                "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "\[Equal]", "n"}], ",", "FlasherBorderFold", ",", 
                 RowBox[{"FlasherMedFold", "[", "ig", "]"}]}], "]"}]}], 
              "]"}]}], 
            RowBox[{"(*", " ", 
             RowBox[{"left", " ", "of", " ", "quadrant"}], " ", "*)"}], 
            "\[IndentingNewLine]", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ig", ",", "0", ",", 
             RowBox[{"r", "-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"h", " ", "ig"}], ",", "n"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              SubscriptBox["v", 
               RowBox[{"n", ",", "n", ",", "k"}]], ",", 
              SubscriptBox["v", 
               RowBox[{
                RowBox[{"n", "-", "1"}], ",", "n", ",", "k"}]]}], "}"}], 
            "]"}], ",", "FlasherBorderFold"}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"extra", " ", "segment", " ", "at", " ", "corner"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "diagonal", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i", "=", 
              RowBox[{
               RowBox[{"h", " ", "ig"}], "+", "j"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"i", "-", "1"}], ",", "i", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{"i", ",", 
                    RowBox[{"i", "+", "1"}], ",", "k"}]]}], "}"}], "]"}], ",", 
               RowBox[{"FlasherSharpFold", "[", 
                RowBox[{"ig", "+", "1"}], "]"}]}], "]"}]}], 
            "\[IndentingNewLine]", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ig", ",", "0", ",", 
             RowBox[{"r", "-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"h", "-", "1"}]}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"minor", " ", "region"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{
                RowBox[{"h", " ", "ig"}], "-", "1"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"ig", "\[NotEqual]", "0"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"Line", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    SubscriptBox["v", 
                    RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                    SubscriptBox["v", 
                    RowBox[{"i", ",", 
                    RowBox[{"j", "-", "1"}], ",", "k"}]]}], "}"}], "]"}], ",", 
                  RowBox[{"FlasherSharpFold", "[", "ig", "]"}]}], "]"}], ",", 
                
                RowBox[{"{", "}"}]}], "]"}]}], ",", 
             RowBox[{"(*", " ", 
              RowBox[{"bottom", " ", "of", " ", "quadrant"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  SubscriptBox["v", 
                   RowBox[{"i", ",", "j", ",", "k"}]], ",", 
                  SubscriptBox["v", 
                   RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"i", "+", "h"}], ",", 
                    RowBox[{"j", "-", "1"}]}], "]"}], ",", "j", ",", "k"}]]}],
                  "}"}], "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"j", "\[Equal]", "n"}], ",", "FlasherBorderFold", ",", 
                 RowBox[{"FlasherMedFold", "[", 
                  RowBox[{"ig", "+", "1"}], "]"}]}], "]"}]}], "]"}]}], 
            RowBox[{"(*", " ", 
             RowBox[{"left", " ", "of", " ", "quadrant"}], " ", "*)"}], 
            "\[IndentingNewLine]", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"ig", ",", "0", ",", 
             RowBox[{"r", "-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"h", " ", "ig"}], "+", "1"}], ",", "n"}], "}"}]}], 
          "]"}]}], "\[IndentingNewLine]", "}"}], "]"}], "/.", 
      RowBox[{"FlasherWrapRules", "[", "v", "]"}]}]}]}], "]"}]}]], "Input",
