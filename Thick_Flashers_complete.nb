 CellChangeTimes->{{3.629219224907051*^9, 
  3.629219225647904*^9}},ExpressionUUID->"e8031350-871d-41f4-afff-\
841059d13f7c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolygonSides", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["16", "25"], ",", 
       FractionBox["12", "25"]}], "}"}]}], "}"}], "]"}], "//", 
  "ShowExample"}]], "Input",
