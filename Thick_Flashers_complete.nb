Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ff", ",", "\[Gamma]", ",", "rrr", ",", "rrl", ",", "t", ",", "t0"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#", "]"}], ",", 
         RowBox[{"Sin", "[", "#", "]"}], ",", "0.05"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      RowBox[{"90", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t0", "=", 
      RowBox[{"\[Pi]", "/", "4"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rrl", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"RotationZMatrix3D", "[", "t", "]"}], ".", 
         RowBox[{"RotationYMatrix3D", "[", 
          RowBox[{"\[Gamma]", "/", "2"}], "]"}], ".", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rrr", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"RotationZMatrix3D", "[", "t", "]"}], ".", 
         RowBox[{"RotationYMatrix3D", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]"}], "/", "2"}], "]"}], ".", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Styled3DAxes", "[", 
          RowBox[{".5", ",", ".5", ",", ".5"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"StyledCurvedFold", "[", 
             RowBox[{"ff", ",", 
              RowBox[{"{", 
               RowBox[{"rrl", ",", "rrr"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledVector", "[", 
             RowBox[{
              RowBox[{"ff", "[", "t0", "]"}], ",", 
              RowBox[{"rrl", "[", "t0", "]"}], ",", 
              RowBox[{"VectorColor", "\[Rule]", "Red"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"StyledVector", "[", 
             RowBox[{
              RowBox[{"ff", "[", "t0", "]"}], ",", 
              RowBox[{"rrr", "[", "t0", "]"}], ",", 
              RowBox[{"VectorColor", "\[Rule]", "Green"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", "}"}]}], "}"}], "//", "AddShadow"}]}], "}"}], "]"}], 
      "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
