   3.5942066950901747`*^9}, {3.594206892822216*^9, 3.594206931244713*^9}, {
   3.594206985167815*^9, 3.594206994471964*^9}, 3.594734255467813*^9, 
   3.59473443657824*^9, {3.5953607839450903`*^9, 
   3.595360826925818*^9}},ExpressionUUID->"7b8605a1-ee50-44ff-bd1b-\
e1463be702d8"],

Cell["\<\
The default color scheme of Graph3DGraphics3D matches that of \
Graph2DGraphics, since both are typically used to render the folded form.\
\>", "Text",
 CellChangeTimes->{{3.59536109879837*^9, 
  3.595361128506521*^9}},ExpressionUUID->"426216ad-86d1-4577-a324-\
d630a8be732f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DirectedEdges3D", "::", "usage"}], 
   "=", "\"\<DirectedEdges3D is an option to Graph3DGraphics3D that specifies \
whether to use 3D arrows for directed edges.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.593009293214488*^9, 3.593009322435884*^9}, {
