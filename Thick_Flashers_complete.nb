Cell[CellGroupData[{

Cell["Hat (Weierstrass) transformations", "Section",
 CellChangeTimes->{{3.595526251154416*^9, 3.595526256056656*^9}, 
   3.595526601714638*^9, {3.595973646828978*^9, 3.595973673282524*^9}, {
   3.614959080405488*^9, 3.614959082709045*^9}, 
   3.703968976916508*^9},ExpressionUUID->"25d3cc43-1bc0-4a97-acc2-\
98a9852fc8db"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.595526258726105*^9, 
  3.595526259199743*^9}},ExpressionUUID->"85c3536c-5edd-4d20-b585-\
0f8436e2f824"],

Cell["\<\
The Weierstrass transformation is a useful transformation for converting \
trigonometric expressions to algebraic ones, commonly encountered in integral \
calculus. We\[CloseCurlyQuote]ll refer to it as the HAT (Half Angle Tangent) \
transformation. It allows us to convert the 3D Kawasaki RotationMatrix2D(\
\[Gamma])=1 (vertex consistency) condition to an algebraic form that lets us \
use the theory of Gr\[ODoubleDot]bner bases to analyze degrees of freedom. We \
can also create vertex developability, flat-foldability, and face planarity \
conditions in the same fashion.\
\>", "Text",
 CellChangeTimes->{{3.595526260827573*^9, 3.5955263393792963`*^9}, {
   3.59561403271384*^9, 3.595614087244673*^9}, {3.5957099392501793`*^9, 
   3.595709943257901*^9}, {3.614959032201253*^9, 3.614959065701921*^9}, 
   3.688166836298344*^9, 
   3.7039689770465*^9},ExpressionUUID->"bb275fe9-8258-4ead-a1af-9a04ec35a6c0"]
}, Closed]],

Cell[CellGroupData[{

Cell["Hat definitions", "Subsection",
 CellChangeTimes->{{3.779216821081481*^9, 
  3.779216823748637*^9}},ExpressionUUID->"04417958-60a7-4d19-b898-\
9d4dc95d2c1a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Hat[",
 StyleBox["angle",
  FontSlant->"Italic"],
 "]\n",
 "Hat",
 "[",
 StyleBox["angles",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595526347394846*^9, 3.595526394958897*^9}, {
  3.595686105580825*^9, 
  3.5956861057026443`*^9}},ExpressionUUID->"216e2f07-8723-4227-bc0b-\
00386a2c4a72"],

Cell[TextData[{
 "Hat[",
 StyleBox["angle",
  FontSlant->"Italic"],
 "] returns the hat transformation of the given angle."
}], "Text",
 CellChangeTimes->{{3.595526355457483*^9, 3.595526382055745*^9}, 
   3.5956861058212223`*^9, {3.736600971976632*^9, 
   3.736600975310241*^9}},ExpressionUUID->"17a3e77d-14f5-48e5-8aab-\
b020556909d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hat", "[", "a_", "]"}], ":=", 
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{"a", "\[Equal]", "\[Pi]"}], ",", "\[Infinity]", ",", 
    RowBox[{"a", "\[Equal]", 
     RowBox[{"-", "\[Pi]"}]}], ",", 
    RowBox[{"-", "\[Infinity]"}], ",", "True", ",", 
    RowBox[{"Tan", "[", 
     RowBox[{
      FractionBox["1", "2"], "a"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595526383351937*^9, 3.5955264268314857`*^9}, {
   3.595526468125042*^9, 3.5955264993511677`*^9}, 3.5956861058494167`*^9},
 CellLabel->
  "In[740]:=",ExpressionUUID->"3457e8ea-273b-473c-85cc-f219356f76fb"],

Cell[TextData[{
 "Hat",
 "[",
 StyleBox["angles",
  FontSlant->"Italic"],
 "] returns the hat transformation of a list of angles."
}], "Text",
 CellChangeTimes->{{3.595526432860622*^9, 3.595526444243894*^9}, 
   3.595686105941895*^9},ExpressionUUID->"e60deb4c-7e2c-4539-b9fd-\
8351f5c5a453"],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"Hat", ",", "Listable"}], "]"}]], "Input",
 CellChangeTimes->{{3.595526452308303*^9, 3.595526461234001*^9}, 
   3.595686105968342*^9},
 CellLabel->
  "In[741]:=",ExpressionUUID->"e2915b74-6cad-4d47-a2c8-7c620cdc6892"],

Cell["Examples", "Text",
