Cell[CellGroupData[{

Cell[TextData[{
 "ExportVeneerScoring[",
 StyleBox["file",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(checked classes) TPlaneGraph, TAssigned\n\t(options) \
Options[VeneerScoringGraphics], ShowProgress"
}], "Subsubsection",
 CellChangeTimes->{{3.62791373305524*^9, 
  3.627913735856694*^9}},ExpressionUUID->"16ddf33d-6064-437d-8519-\
5ca8ddfdf028"],

Cell[TextData[{
 "ExportVeneerScoring[",
 StyleBox["file",
  FontSlant->"Italic"],
 ", ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] creates a veneer scoring Graphics object and exports it to a file. \
Options are:\n\tImageWidth \[Rule] ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["w",
  FontSlant->"Italic"],
 " is the desired image width.\n\tImageHeight \[Rule] ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["h",
  FontSlant->"Italic"],
 " is the desired image height. You must supply either width or height (if \
you specify both, ImageWidth wins out).\n\tVeneerThickness \[Rule] ",
 StyleBox["vt",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["vt",
  FontSlant->"Italic"],
 " is the veneer thickness, also given in points (for unit consistency).\n\t\
MultilineSpacing \[Rule] ",
 StyleBox["ls",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["ls",
  FontSlant->"Italic"],
 " is the spacing to use in the VeneerMultiline function.\n\tInvertFolds \
\[Rule] True | False inverts the crease assignment in the pattern.\n\t\
FoldAngles \[Rule] ",
 StyleBox["angle | anglelist",
  FontSlant->"Italic"],
 " | Automatic, where ",
 StyleBox["anglelist",
  FontSlant->"Italic"],
 " is a list of specified angles, a single ",
 StyleBox["angle",
  FontSlant->"Italic"],
 " uses that angle for all valley folds, and Automatic makes them all 180\
\[Degree].\n\tand\n\tScoreLineThickness \[Rule] ",
 StyleBox["t",
  FontSlant->"Italic"],
 ", specifies the score line thickness, in points\n\tShowProgress \[Rule] \
True | False, whether to display detailed size and the score image."
}], "Text",
 CellChangeTimes->{{3.627905082455618*^9, 3.627905158100513*^9}, {
  3.627906380629628*^9, 3.627906420298707*^9}, {3.627906663798135*^9, 
  3.6279067066484747`*^9}},ExpressionUUID->"497411d7-a9cb-465f-a8c2-\
b3ea2317edb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ExportVeneerScoring", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ShowProgress", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ScoreLineThickness", "\[Rule]", "0.216"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.627905891187298*^9, 3.627905912213375*^9}, {
  3.6279064015582447`*^9, 3.627906408124607*^9}},
 CellLabel->
  "In[4229]:=",ExpressionUUID->"fa2baac5-7f34-4479-887c-0d0459d34968"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExportVeneerScoring", "[", 
   RowBox[{"file_String", ",", "tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sp", ",", "slt", ",", "g", ",", "w", ",", "h"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sp", "=", 
      RowBox[{
       RowBox[{"ShowProgress", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportVeneerScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"slt", "=", 
      RowBox[{
       RowBox[{"ScoreLineThickness", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "ExportVeneerScoring", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{
       RowBox[{"VeneerScoringGraphics", "[", 
        RowBox[{"tobj", ",", "opts"}], "]"}], "/.", 
       RowBox[{"ScoringStyle", "[", 
        RowBox[{"ScoreLineThickness", "\[Rule]", "slt"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"w", ",", "h"}], "}"}], "=", 
      RowBox[{"GraphicsExtent", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"sp", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<width = \>\"", ",", "w", ",", "\"\< pt, \>\"", ",", " ", 
          RowBox[{"w", "/", "28.35"}], ",", "\"\< cm, \>\"", ",", 
          RowBox[{"w", "/", "72."}], ",", "\"\< in\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<height = \>\"", ",", "h", ",", "\"\< pt, \>\"", ",", 
          RowBox[{"h", "/", "28.35"}], ",", "\"\< cm, \>\"", ",", 
          RowBox[{"h", "/", "72."}], ",", "\"\< in\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "g", "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"file", ",", "g", ",", 
       RowBox[{"ImageSize", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"w", ",", "h"}], "}"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.627905829964896*^9, 3.627905886459118*^9}, {
   3.627905922943392*^9, 3.627906037313222*^9}, {3.627906076871149*^9, 
