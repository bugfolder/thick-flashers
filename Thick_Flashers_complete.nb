Cell[CellGroupData[{

Cell[TextData[{
 "EdgeVertexAngles2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph2D, TPlaneGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.626460049615485*^9, 3.6264600541786957`*^9}, {
   3.626460154166882*^9, 3.62646015486858*^9}, 3.626461241200854*^9, {
   3.626462833962691*^9, 
   3.626462846257021*^9}},ExpressionUUID->"c556a2eb-0093-43c3-b2e0-\
ea328d9a1d74"],

Cell[TextData[{
 "EdgeVertexAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of the four sector angles around both vertices of all of \
the edges, of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{"i", ",", "r"}]], ",", " ", 
         SubscriptBox["\[Alpha]", 
          RowBox[{"i", ",", "l"}]]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{"j", ",", "r"}]], ",", 
         SubscriptBox["\[Alpha]", 
          RowBox[{"j", ",", "l"}]]}], "}"}]}], "}"}], ",", " ", 
     "\[Ellipsis]"}], "}"}], TraditionalForm]],ExpressionUUID->
  "affcf455-00ab-41b3-865c-867250f782b9"],
 ", where each list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", 
        RowBox[{"i", ",", "r"}]], ",", " ", 
       SubscriptBox["\[Alpha]", 
        RowBox[{"i", ",", "l"}]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", 
        RowBox[{"j", ",", "r"}]], ",", 
       SubscriptBox["\[Alpha]", 
        RowBox[{"j", ",", "l"}]]}], "}"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"403a7b26-3bd6-43c8-86f6-c9b9d1e5839d"],
 " applies to edge ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], TraditionalForm]],ExpressionUUID->
  "e16386d9-bb6b-4317-8545-85a51e1020e5"],
 " of ",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", and angle ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{"i", ",", "r"}]], TraditionalForm]],ExpressionUUID->
  "3d228cfd-72bd-4f03-9c0a-28b1280518fc"],
 " lies to the right of vertex ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", as viewed from the edge, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{"i", ",", "l"}]], TraditionalForm]],ExpressionUUID->
  "41e99155-0075-4e3a-a713-71fc0986bb53"],
 " lies to its left, and similarly for the other two angles. Or, \
equivalently, for each edge, the first angle lies CCW of the first vertex, \
and then the angles circulate CCW about the edge. Same as EdgeVertexAngles, \
but computed from the Vertices2D data."
}], "Text",
 CellChangeTimes->{{3.626460113028257*^9, 3.6264601145375557`*^9}, {
  3.6264601585835247`*^9, 3.626460191214245*^9}, {3.626460715385646*^9, 
  3.626460738303229*^9}, {3.626460872049326*^9, 3.626461114959526*^9}, {
  3.626462684428374*^9, 3.6264627168507757`*^9}, {3.626462906214664*^9, 
  3.626462918011832*^9}},ExpressionUUID->"6bbd01e7-bbc8-47d2-bbab-\
a6dec17e6c5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EdgeVertexAngles2D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "edges", ",", "vei", ",", "vea", ",", "ia", ",", "ib", ",", "veaa", ",", 
      "veab"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "vei"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "VertexEdgeIncidence"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"vea", "=", 
      RowBox[{"VertexEdgeAngles2D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ia", ",", "ib"}], "}"}], "=", 
         RowBox[{
         "edges", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"veaa", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{
           "vea", "\[LeftDoubleBracket]", "ia", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "ia", "\[RightDoubleBracket]"}],
                ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}],
           "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "edge", " ", "angles", " ", "around", " ", "vertex", " ", "ia"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"veab", "=", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{
           "vea", "\[LeftDoubleBracket]", "ib", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{
               "vei", "\[LeftDoubleBracket]", "ib", "\[RightDoubleBracket]"}],
                ",", "i"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}],
           "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{
         "edge", " ", "angles", " ", "around", " ", "vertex", " ", "ib"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "veaa", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"veaa", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "veab", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"veab", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}]}], 
         "}"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.626461149608427*^9, 3.626461235540138*^9}, {
  3.626461280984852*^9, 3.626461303775401*^9}, {3.626461505608955*^9, 
  3.626461762220671*^9}, {3.626461828222152*^9, 3.6264618793646517`*^9}, {
