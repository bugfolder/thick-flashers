   3.825770325067623*^9, 3.825770387634217*^9}, {3.825770444026363*^9, 
   3.8257704626908007`*^9}, {3.825770497268276*^9, 3.825770500563483*^9}, {
   3.82577059409553*^9, 3.825770612661096*^9}, {3.825770665326902*^9, 
