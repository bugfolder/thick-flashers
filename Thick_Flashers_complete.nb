Cell["Example. Display and number the quads.", "Text",
 CellChangeTimes->{{3.555787653455091*^9, 3.555787654213188*^9}, {
  3.55583503546666*^9, 
  3.555835042120996*^9}},ExpressionUUID->"bc88e94f-c187-4f87-93fa-\
95ceb8ee183b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"r", "=", "3"}], ",", 
      RowBox[{"h", "=", "2"}], ",", 
      RowBox[{"m", "=", "5"}], ",", "fsq", ",", "fspolys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fsq", "=", 
      RowBox[{"FlasherSectorQuads", "[", 
       RowBox[{"p", ",", "r", ",", "h", ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fspolys", "=", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ctr", "=", 
             RowBox[{
              RowBox[{"Plus", "@@", "#1"}], "/", "4"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Polygon", "[", 
                RowBox[{"ctr", "+", 
                 RowBox[{"0.8", 
                  RowBox[{"(", 
                   RowBox[{"#1", "-", "ctr"}], ")"}]}]}], "]"}], ",", 
               "LightGray"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"\"\<q\>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{
                   "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}]}], ",", "ctr"}], "]"}], ",", 
               RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}]}], 
          "]"}], "&"}], ",", "fsq"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fspolys", ",", 
         RowBox[{"FlasherFirstSectorAllPossibleVerticesLabels", "[", 
          RowBox[{"\"\<p\>\"", ",", "p", ",", 
           RowBox[{"r", "*", "h"}]}], "]"}]}], "}"}], "/.", 
       RowBox[{"FlasherDefaultCPRules", "[", 
        RowBox[{"p", ",", "m"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.555787674648052*^9, 3.555787707225848*^9}, {
   3.555787857060193*^9, 3.555788031468622*^9}, {3.555788112529481*^9, 
   3.555788115917809*^9}, {3.555788745379881*^9, 3.555788745850748*^9}, {
   3.555834800351925*^9, 3.555835017940179*^9}, {3.555835076028693*^9, 
   3.555835077284805*^9}, {3.555854307525507*^9, 3.555854307724849*^9}, {
   3.555854345236913*^9, 3.5558543454395647`*^9}, 3.555956433173531*^9, 
   3.719848622702276*^9, 3.719848673680263*^9, 3.7198490916797533`*^9, 
   3.7198491437711563`*^9, 3.719850658315396*^9, 3.719854079754209*^9, {
