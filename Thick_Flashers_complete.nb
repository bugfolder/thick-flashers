  "In[721]:=",ExpressionUUID->"5fd4c7b6-e453-4b64-86bb-9d8febe6b53e"],

Cell[TextData[{
 "Example: if ",
 StyleBox["c",
  FontSlant->"Italic"],
 " is not perpendicular to ",
 StyleBox["a",
  FontSlant->"Italic"],
 " and ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", we get the wrong answer."
}], "Text",
 CellChangeTimes->{{3.496237841402113*^9, 
  3.49623788449636*^9}},ExpressionUUID->"4ed4aebc-6490-4e7d-a5c0-\
010e9c261a95"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DirectedAngle3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0."}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", ".1", ",", "1."}], "}"}]}], "]"}], "/", "\[Degree]"}],
   " ", "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.441837024540153*^9, 3.441837096445868*^9}, 
   3.442671213490768*^9, {3.457703675336994*^9, 3.457703678752977*^9}, {
