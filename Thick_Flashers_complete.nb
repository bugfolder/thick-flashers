Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTMiuraMarsOri", "::", "badsize"}], 
   "=", "\"\<TVertex `1` must be degree-4; its degree is `2`.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.595005148978063*^9, 3.5950051820813847`*^9}, 
   3.595010922831157*^9, 3.642433020943276*^9},
