Cell["Example. Flatten a cylinder.", "Text",
 CellChangeTimes->{{3.799336707300763*^9, 
  3.799336712004108*^9}},ExpressionUUID->"8a668bfc-f3a8-4bfe-8bea-\
60a68e60cfeb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Sigma]", ",", "bb", ",", "dd", ",", "ui", ",", "bi", ",", "ti", ",", 
      "di", ",", "\[Kappa]n", ",", "b", ",", "d", ",", "u0", ",", "u1", ",", 
      "v0", ",", "v1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"a", " ", "cylinder"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bb", "=", 
      RowBox[{"Function", "[", 
       RowBox[{"u", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Cos", "[", "u", "]"}]}], ",", "0", ",", 
          RowBox[{"Sin", "[", "u", "]"}]}], "}"}]}], "]"}]}], ";", 
