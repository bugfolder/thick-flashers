Cell[TextData[{
 "U[\[Phi]]\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "[", 
    RowBox[{
     SubscriptBox["\[Phi]", "1"], ",", 
     SubscriptBox["\[Phi]", "2"], ",", "..."}]}], TraditionalForm]],
  ExpressionUUID->"44f20a6e-7785-4959-a588-99e89fd88792"],
 "]"
}], "Subsubsection",
