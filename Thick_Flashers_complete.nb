Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dirs", ",", "tobj", ",", "gobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dirs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RotationZMatrix3D", "[", 
          RowBox[{
           RowBox[{"-", "110."}], "\[Degree]"}], "]"}], ".", "#"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTVertex3DFromFoldVectors", "[", "dirs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gobj", "=", 
      RowBox[{"MakeSphericalVertexGraph3D", "[", "tobj", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GraphGraphics", "[", "gobj", "]"}], ",", 
        RowBox[{"Graph3DGraphics3D", "[", "gobj", "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.442617298550125*^9, 3.442617473782814*^9}, 
   3.442671214103341*^9, {3.443045037385807*^9, 3.443045042253828*^9}, 
