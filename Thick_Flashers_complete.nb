   3.7079379292903433`*^9},ExpressionUUID->"ce89ea56-bfed-444c-a9dd-\
882f2657d784"],

Cell[TextData[{
 "TwoColorableGraphQ",
 "[",
 StyleBox["edges",
  FontSlant->"Italic"],
 ", ",
 StyleBox["faces",
  FontSlant->"Italic"],
 "] returns true if the specified plane graph is two-colorable, assuming that \
the faces come from a plane graph embedding of the vertices. We simply check \
to make sure that all the interior vertices have even degree."
}], "Text",
 CellChangeTimes->{{3.484778993654539*^9, 3.4847791080787287`*^9}, 
   3.484928180038191*^9, 3.592828711776609*^9, 
   3.592859438530988*^9},ExpressionUUID->"1cc784db-7376-4a36-8e6e-\
3a1344f070af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoColorableGraphQ", "[", 
   RowBox[{"tobj_TObj", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"edges", ",", "faces", ",", "bface", ",", "vdeg"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"edges", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bface", "=", 
      RowBox[{"BoundaryFromFaces", "[", "faces", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vdeg", "=", 
      RowBox[{"VertexDegreeFromEdges", "[", "edges", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"And", "@@", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"bface", ",", 
            RowBox[{
            "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
           "]"}], "||", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"#1", ",", "2"}], "]"}], "\[Equal]", "0"}]}], "&"}], ",", 
        "vdeg"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.484777627549423*^9, 3.484777670857979*^9}, {
   3.484778108733219*^9, 3.484778212917128*^9}, {3.484778247462346*^9, 
   3.484778324486532*^9}, {3.484778368111902*^9, 3.484778427977932*^9}, 
   3.484778472870954*^9, {3.484778796689151*^9, 3.484778799659546*^9}, {
   3.48477889152944*^9, 3.484778893762788*^9}, {3.484778924152178*^9, 
   3.484778978748554*^9}, {3.484781963847013*^9, 3.484781967693891*^9}, 
   3.484928180059825*^9, {3.591728868976306*^9, 3.591728899257386*^9}, {
   3.592432954469031*^9, 3.592432956667385*^9}, 3.592435744012867*^9, 
   3.592828711871455*^9, 3.592859438556829*^9},
 CellLabel->
  "In[1197]:=",ExpressionUUID->"ea8c7913-4465-4e68-b282-d05fda9f389c"],

