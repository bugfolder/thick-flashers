      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobjw", "=", 
      RowBox[{"MakeSimpleWovenTessellationOld", "[", 
       RowBox[{"tobjcsg", ",", "8.", ",", 
        RowBox[{"WovenParity", "\[Rule]", "1"}], ",", 
        RowBox[{"ShowProgress", "\[Rule]", "True"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Turn", " ", "over", " ", "the", " ", "folded", " ", "form"}], 
       ",", " ", 
       RowBox[{"i", ".", "e", "."}], ",", " ", 
       RowBox[{
       "invert", " ", "the", " ", "crease", " ", "assignment", " ", "and", " ",
         "flop", " ", "the", " ", 
        RowBox[{"image", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"temp", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobjw", "]"}], "//", 
         "InvertFoldType"}], ")"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}]}]}]}], "\[IndentingNewLine]", 
   "]"}], "//", "ShowExample"}]], "Input",
