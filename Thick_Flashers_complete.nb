Cell[CellGroupData[{

Cell[TextData[{
 "DiscreteEllipseEquiaxial[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi], \[Theta]]\nDiscreteEllipseEquiaxial[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi]]\n",
 "DiscreteEllipseEquiaxial",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.6712472301761713`*^9, 3.671247296683461*^9}, {
  3.671247481752191*^9, 3.671247482970381*^9}, {3.671250064325303*^9, 
  3.6712500703559237`*^9}, {3.671290622200027*^9, 3.671290622291307*^9}, {
  3.673174061399475*^9, 
  3.673174061475593*^9}},ExpressionUUID->"ed38ff3c-3bfa-42ec-bb0a-\
3239cf07af46"],

Cell[TextData[{
 "DiscreteEllipseEquiaxial",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi], \[Theta]] returns a polygon with vertices on an ellipse, equally \
spaced in angle measured about the origin. Arguments are:\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the number of points.\n\t{",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "} \[LongDash] the semimajor and semiminor axes, respectively.\n\t\[Phi] \
\[LongDash] the angle of the first point relative to the semimajor axis.\n\t\
\[Theta] \[LongDash] the angle by which the ellipse is rotated about the \
origiin."
}], "Text",
 CellChangeTimes->{{3.6712473556680117`*^9, 3.671247549843657*^9}, 
   3.671247988936877*^9, {3.671248751303081*^9, 3.6712487657427263`*^9}, 
   3.6712906223464613`*^9, 
   3.673174061525873*^9},ExpressionUUID->"f9075b1c-5b2d-4268-85e8-\
ed3cf55f73b8"],

Cell["\<\
Note that the points are equally spaced in angle, and so are in general not \
equally spaced in distance. For that, see EquilateralDiscreteEllipse, below.\
\>", "Text",
 CellChangeTimes->{{3.671250003953591*^9, 
  3.671250038845793*^9}},ExpressionUUID->"d692305d-c565-4c11-94a3-\
29f2560e8484"],

Cell["Start by working out the polar equation for an ellipse.", "Text",
 CellChangeTimes->{{3.671248329299247*^9, 
  3.671248341920889*^9}},ExpressionUUID->"2ab55925-06b6-4ac1-aa9a-\
4322ebf131a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "soln"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"r", " ", 
       RowBox[{"Cos", "[", "\[Psi]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"r", " ", 
       RowBox[{"Sin", "[", "\[Psi]", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox[
           SuperscriptBox["x", "2"], 
           SuperscriptBox["a", "2"]], "+", 
          FractionBox[
           SuperscriptBox["y", "2"], 
           SuperscriptBox["b", "2"]]}], "\[Equal]", "1"}], ",", "r"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], "/.", 
       RowBox[{
       "soln", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",\

 CellChangeTimes->{{3.671248137478787*^9, 3.671248276278488*^9}, {
  3.67124835081724*^9, 3.671248353835894*^9}, {3.671248776406909*^9, 
  3.671248778270502*^9}},
 CellLabel->
  "In[455]:=",ExpressionUUID->"f29cf87a-aaa5-4ade-9003-00c6baa87587"],

Cell["Use this in our function.", "Text",
 CellChangeTimes->{{3.671248364896995*^9, 
  3.67124838295884*^9}},ExpressionUUID->"6155b682-137f-4f5b-af02-\
e56a118c99a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiscreteEllipseEquiaxial", "[", 
   RowBox[{"m_", ",", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_"}], "}"}], ",", 
    RowBox[{"\[Phi]_", ":", "0"}], ",", 
    RowBox[{"\[Theta]_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "rm", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rm", "=", 
      RowBox[{"RotationMatrix2D", "[", "\[Theta]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"rm", ".", 
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"Cos", "[", "\[Psi]", "]"}], 
           SqrtBox[
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Psi]", "]"}], "2"], 
              SuperscriptBox["a", "2"]], "+", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Psi]", "]"}], "2"], 
              SuperscriptBox["b", "2"]]}]]], ",", 
          FractionBox[
           RowBox[{"Sin", "[", "\[Psi]", "]"}], 
           SqrtBox[
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Psi]", "]"}], "2"], 
              SuperscriptBox["a", "2"]], "+", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Psi]", "]"}], "2"], 
              SuperscriptBox["b", "2"]]}]]]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Psi]", ",", "\[Phi]", ",", 
         RowBox[{"\[Phi]", "+", 
          RowBox[{"2", "\[Pi]"}]}], ",", 
         RowBox[{"2", 
          RowBox[{"\[Pi]", "/", "m"}]}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.671247560484779*^9, 3.671247579586459*^9}, {
   3.671247675128248*^9, 3.671247765241412*^9}, {3.671248301356289*^9, 
   3.671248309054126*^9}, {3.671250055295847*^9, 3.671250059462243*^9}, 
   3.671290622375464*^9, 3.67317406155551*^9},
 CellLabel->
  "In[456]:=",ExpressionUUID->"4634dbab-85f5-483e-a0c2-c2b8354364eb"],

Cell["Example", "Text",
 CellChangeTimes->{{3.671247773373589*^9, 
  3.6712477741092587`*^9}},ExpressionUUID->"8fa5bc84-deed-42d5-9a90-\
22d6bec7159f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "a", ",", "b", ",", "\[Phi]", ",", "\[Theta]", ",", "pts"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "16"}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", "GoldenRatio"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", "1."}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"45", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"45", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pts", "=", 
      RowBox[{"DiscreteEllipseEquiaxial", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", "\[Phi]", ",", "\[Theta]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"AppendFirst", "[", "pts", "]"}], "]"}], ",", "Black"}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Point", "[", 
            RowBox[{
            "pts", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            "]"}], ",", 
           RowBox[{"PointSize", "[", ".02", "]"}], ",", "Red"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.671206414422072*^9, 3.671206601412654*^9}, {
   3.671207035166952*^9, 3.6712070575981073`*^9}, 3.671247332934986*^9, {
   3.671247792079098*^9, 3.671247866643363*^9}, {3.671247996808866*^9, 
   3.671247998768283*^9}, {3.6712483212059307`*^9, 3.671248321371995*^9}, {
   3.671248400304749*^9, 3.671248400471505*^9}, {3.671249991043627*^9, 
   3.671249995353189*^9}, 3.671290622408333*^9, 3.671553771316563*^9, 
   3.673174061580751*^9},
 CellLabel->
  "In[457]:=",ExpressionUUID->"8102d668-256b-4855-9318-7cde10708816"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "DiscreteEllipseEquilateral[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi], \[Theta]]\nDiscreteEllipseEquilateral[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi]]\n",
 "DiscreteEllipseEquilateral",
 "[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.6712472301761713`*^9, 3.671247308747309*^9}, {
  3.6712475564127*^9, 3.671247557397189*^9}, {3.6712486962561603`*^9, 
  3.671248697461388*^9}, {3.671249880744821*^9, 3.671249886735858*^9}, {
  3.671290605565471*^9, 
  3.671290605658852*^9}},ExpressionUUID->"70cbae0c-4015-46db-9483-\
6684886ec0dd"],

Cell[TextData[{
 "DiscreteEllipseEquilateral[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "}, \[Phi], \[Theta]] returns an equilateral polygon with vertices on an \
ellipse. Arguments are:\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the number of points.\n\t{",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 "} \[LongDash] the semimajor and semiminor axes, respectively.\n\t\[Phi] \
\[LongDash] the angle of the first point relative to the semimajor axis.\n\t\
\[Theta] \[LongDash] the angle by which the ellipse is rotated about the \
origiin."
}], "Text",
 CellChangeTimes->{{3.6712473556680117`*^9, 3.671247549843657*^9}, 
   3.671247988936877*^9, {3.671248729619396*^9, 3.671248744768272*^9}, 
   3.671290605714727*^9, {3.6712906431239758`*^9, 
   3.671290643991749*^9}},ExpressionUUID->"2e70bac8-d068-4c2f-ab51-\
aa725f1e9f75"],

Cell["\<\
While DiscreteEllipseEquiaxial can return analytic formulas for the vertices, \
DiscreteEllipseEquilateral returns numeric values, and so all of the \
arguments must evaluate to numeric values.\
\>", "Text",
 CellChangeTimes->{{3.671249920549181*^9, 3.671249975178143*^9}, {
   3.6712906057707148`*^9, 3.671290622462727*^9}, 
   3.673174078689419*^9},ExpressionUUID->"883772c9-0dbd-4dca-a953-\
b255bd82f188"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiscreteEllipseEquilateral", "[", 
   RowBox[{"m_", ",", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_"}], "}"}], ",", 
    RowBox[{"\[Phi]_", ":", "0"}], ",", 
    RowBox[{"\[Theta]_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pts", ",", "\[Psi]", ",", "vars", ",", "vars0", ",", "eqns", ",", "d", ",",
       "soln", ",", "rm"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"Cos", "[", 
            RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], 
           SqrtBox[
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["a", "2"]], "+", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Sin", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["b", "2"]]}]]], ",", 
          FractionBox[
           RowBox[{"Sin", "[", 
            RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], 
           SqrtBox[
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"Cos", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["a", "2"]], "+", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Sin", "[", 
                RowBox[{"\[Psi]", "[", "j", "]"}], "]"}], "2"], 
              SuperscriptBox["b", "2"]]}]]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "0", "]"}], "=", "\[Phi]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "j", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", 
          RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
      "=", "d"}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars0", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"\[Psi]", ",", 
        RowBox[{"{", 
         RowBox[{"\[Psi]", ",", "\[Phi]", ",", 
          RowBox[{"\[Phi]", "+", 
           RowBox[{"2", "\[Pi]"}], "-", 
           RowBox[{"2", 
            RowBox[{"\[Pi]", "/", "m"}]}]}], ",", 
          RowBox[{"2", 
           RowBox[{"\[Pi]", "/", "m"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars0", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
       "=", 
      RowBox[{"\[Pi]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "+", "b"}], ")"}], "/", "m"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{
           "pts", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "-", 
           RowBox[{"pts", "\[LeftDoubleBracket]", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"1", "+", "j"}], ",", "m", ",", "1"}], "]"}], 
            "\[RightDoubleBracket]"}]}], "]"}], "\[Equal]", "d"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "m"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"soln", "=", 
      RowBox[{"FindRoot", "@@", 
       RowBox[{"{", 
        RowBox[{"eqns", ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"vars", ",", "vars0"}], "}"}], "]"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rm", "=", 
      RowBox[{"RotationMatrix2D", "[", "\[Theta]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rm", ".", "#"}], "&"}], "/@", 
      RowBox[{"(", 
       RowBox[{"pts", "/.", "soln"}], ")"}]}]}]}], "]"}]}]], "Input",
