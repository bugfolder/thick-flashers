Cell["\<\
Example. Ellipse. Compare default styles and CurvedFoldOpticalStyles.\
\>", "Text",
 CellChangeTimes->{{3.692202652486759*^9, 3.692202656054554*^9}, {
  3.802099410633273*^9, 3.802099415897059*^9}, {3.802099565278161*^9, 
  3.802099566645322*^9}},ExpressionUUID->"487de112-2663-4ddc-a638-\
6030e252bf1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "f", ",", "bl", ",", "dl", ",", "cl", ",", "br", ",", "dr", ",", "cr"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"6", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              RowBox[{"Cos", "[", "#1", "]"}]}], ")"}]}], 
           RowBox[{
            RowBox[{"-", "3"}], "+", 
            RowBox[{"Cos", "[", "#1", "]"}]}]]}], ",", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"4", " ", 
            RowBox[{"Sin", "[", "#1", "]"}]}], 
           RowBox[{
            RowBox[{"-", "3"}], "+", 
            RowBox[{"Cos", "[", "#1", "]"}]}]]}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bl", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "0"}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dl", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "#1", "]"}], ",", 
         RowBox[{"Sin", "[", "#1", "]"}]}], "}"}], "&"}]}], ";", 
     RowBox[{"cl", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "4"}], "+", 
            RowBox[{"Cos", "[", "#1", "]"}]}], ")"}]}], ",", 
         FractionBox[
          RowBox[{"Sin", "[", "#1", "]"}], "2"]}], "}"}], "&"}]}], ";", 
     RowBox[{"br", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}], "&"}]}], ";", 
     RowBox[{"dr", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox[
          RowBox[{"3", "-", 
           RowBox[{"5", " ", 
            RowBox[{"Cos", "[", "#1", "]"}]}]}], 
          RowBox[{
           RowBox[{"-", "5"}], "+", 
           RowBox[{"3", " ", 
            RowBox[{"Cos", "[", "#1", "]"}]}]}]], ",", 
         FractionBox[
          RowBox[{"4", " ", 
           RowBox[{"Sin", "[", "#1", "]"}]}], 
          RowBox[{"5", "-", 
           RowBox[{"3", " ", 
            RowBox[{"Cos", "[", "#1", "]"}]}]}]]}], "}"}], "&"}]}], ";", 
     RowBox[{"cr", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox[
          RowBox[{"11", "-", 
           RowBox[{"13", " ", 
            RowBox[{"Cos", "[", "#1", "]"}]}]}], 
          RowBox[{
           RowBox[{"-", "5"}], "+", 
           RowBox[{"3", " ", 
            RowBox[{"Cos", "[", "#1", "]"}]}]}]], ",", 
         FractionBox[
          RowBox[{"8", " ", 
           RowBox[{"Sin", "[", "#1", "]"}]}], 
          RowBox[{"5", "-", 
           RowBox[{"3", " ", 
            RowBox[{"Cos", "[", "#1", "]"}]}]}]]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GraphicsRow", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"StyledCurvedFoldOptical", "[", 
           RowBox[{"f", ",", 
            RowBox[{"{", 
             RowBox[{"cl", ",", "cr"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"bl", ",", "br"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"0", "\[Degree]"}], ",", 
              RowBox[{"90", "\[Degree]"}]}], "}"}]}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Graphics", "[", 
          RowBox[{"StyledCurvedFoldOptical", "[", 
           RowBox[{"f", ",", 
            RowBox[{"{", 
             RowBox[{"cl", ",", "cr"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"bl", ",", "br"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"0", "\[Degree]"}], ",", 
              RowBox[{"90", "\[Degree]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Sequence", "@@", "CurvedFoldOpticalStyles"}]}], "]"}], 
          "]"}]}], "}"}], "]"}], "/.", 
      RowBox[{"OrigamiStyle", "[", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
  "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.692202658931429*^9, 3.692202660374149*^9}, {
   3.692202698075099*^9, 3.692202887192435*^9}, 3.692204257371759*^9, 
   3.69220448375702*^9, 3.6922048008118887`*^9, {3.692211924444062*^9, 
   3.692211961433166*^9}, {3.6922120163625917`*^9, 3.692212018840461*^9}, {
   3.692212124410537*^9, 3.692212170082032*^9}, {3.692281141237039*^9, 
   3.692281141844592*^9}, {3.6922811836835938`*^9, 3.692281205730628*^9}, 
   3.692281242368434*^9, {3.692281514618649*^9, 3.692281515600727*^9}, {
   3.802099577881065*^9, 3.80209964150323*^9}, {3.802100054547641*^9, 
   3.802100061223329*^9}, 3.803905494384248*^9},
 CellLabel->
  "In[1789]:=",ExpressionUUID->"cb062bc5-396f-4cf7-9c88-593d0cfb13a1"]
}, Closed]]
}, Closed]]
