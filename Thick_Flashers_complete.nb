Cell[TextData[{
 "GenericPairGraphics[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "] takes a TGraph2D+TAssigned representing the crease pattern and the folded \
form and returns a single Graphics object that displays both the crease \
pattern and generic folded form side-by-side, with the crease pattern \
centered on the x-axis about the origin. Options are:\n\tSpacing \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the fractional width by which to space the two objections, passed \
through to PlaceInRowGraphics.\n\tPaperFill \[Rule] PaperWhiteSideFill | \
PaperColoredSideFill, specifies the color of the paper that will be used to \
render all polygons, passed through to FoldedFormPolys.\n\tOptions[Graphics] \
are passed through."
}], "Text",
 CellChangeTimes->{{3.484926817998731*^9, 3.484926918166051*^9}, {
   3.4849271731566567`*^9, 3.484927182041171*^9}, {3.484927325901083*^9, 
