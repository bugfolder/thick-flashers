Cell["Cone-cyl parabola (collimated right).", "Text",
 CellChangeTimes->{{3.692263928674754*^9, 3.692263935227799*^9}, {
   3.692266048518237*^9, 3.692266052773455*^9}, 3.6922661939582973`*^9, {
