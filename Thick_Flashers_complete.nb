Cell[CellGroupData[{

Cell["Clearances & minimum thicknesses", "Subsection",
 CellChangeTimes->{{3.914838082431872*^9, 3.914838088640572*^9}, {
   3.914838132223963*^9, 3.914838134877523*^9}, 3.9226309862111473`*^9, {
   3.922901690569036*^9, 3.922901702777443*^9}, {3.9265822379995832`*^9, 
   3.9265822391719913`*^9}},ExpressionUUID->"6806e416-df19-4660-a114-\
4f9fa8a538e7"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.9119322451862097`*^9, 
  3.911932245773657*^9}},ExpressionUUID->"a5f78ddb-9ee4-419c-9b2f-\
bc1b72d15aa7"],

Cell["\<\
When we have GC polyhedra, we can export those directly from Mathematica as \
STL models. However, if we want to make a monolithic 3D-printable pattern, we \
need to add
\t(a) gaps between distinct panels,
\t(b) hinged connections where they are joined.
We can accomplish (a) by insetting the panels (e.g., via InsetGC) , and then \
accomplish (b) by adding more GC polyhedra that connect paired edges that \
should be joined by a hinge.\
\>", "Text",
 CellChangeTimes->{{3.911932251371686*^9, 3.911932379867152*^9}, {
  3.913553843350876*^9, 3.9135538709501953`*^9}, {3.913985300885351*^9, 
  3.913985338444664*^9}, {3.920732523891851*^9, 3.920732549113357*^9}, {
  3.9226311027188883`*^9, 
  3.9226311037818213`*^9}},ExpressionUUID->"23d86a65-30aa-4ed5-838d-\
a6f03535ff50"]
}, Closed]],

Cell[CellGroupData[{

Cell["PanelClearance", "Subsubsection",
 CellChangeTimes->{{3.91398373737064*^9, 3.913983742354388*^9}, 
   3.9139839145109158`*^9, 
   3.922630581871792*^9},ExpressionUUID->"98c61a41-ac07-44de-b016-\
904456f63cb6"],

Cell["\<\
PanelClearance is an option used in functions that create panels for 3D \
printing to specify a gap between elements that should not be touching. \
Typically one will create panels with a non-zero gap between them, then use \
HingeJoinPanels (see below) to add hinges that connect panels where they \
should have hinges between them.\
\>", "Text",
 CellChangeTimes->{{3.913983951838641*^9, 3.913984011424378*^9}, 
   3.922630581916458*^9, {3.922630949678574*^9, 
   3.9226309660285683`*^9}},ExpressionUUID->"9dceeeef-6174-4e37-8b4e-\
7d103066ba39"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PanelClearance", "::", "usage"}], 
   "=", "\"\<PanelClearance is an option to 3D printing functions that \
specifies the width of gaps between non-touching panels.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.912178237649675*^9, 3.912178285875486*^9}, {
  3.912251327736335*^9, 3.912251327737365*^9}, {3.913554187715762*^9, 
  3.913554187717082*^9}, {3.915799505551454*^9, 3.915799506135488*^9}, {
  3.922630581929499*^9, 3.922630581933463*^9}},
 CellLabel->
  "In[4326]:=",ExpressionUUID->"4b52b9c6-a2d0-413e-86aa-36697c2af0e4"],

Cell["\<\
Tessellatica does not currently define any general-purpose functions that \
make use of PanelClearance, but we define it as an option so that \
panel-generating functions use a consistent way of specifying the desired \
clearance between panels.\
\>", "Text",
 CellChangeTimes->{{3.922631006514579*^9, 
  3.922631066831641*^9}},ExpressionUUID->"8d5875e7-55f1-4e0a-a851-\
9ed04302d413"]
}, Closed]],

Cell[CellGroupData[{

Cell["PanelMinThickness", "Subsubsection",
 CellChangeTimes->{{3.922901587479924*^9, 3.922901590143962*^9}, 
   3.9265822632011023`*^9},ExpressionUUID->"5b08d816-3310-4ae3-b79e-\
d64842d59fc1"],

Cell["\<\
PanelMinThickness is an option used in functions that create panels for 3D \
printing to specify a minimum thickness for panels. This is particular \
relevant for thin panels whose cross-section looks like a knife-edge, but it \
is up to the panel creation function to take this value into account.\
\>", "Text",
 CellChangeTimes->{{3.913983951838641*^9, 3.913984011424378*^9}, 
   3.922630581916458*^9, {3.922630949678574*^9, 3.9226309660285683`*^9}, {
   3.922901601282239*^9, 3.9229016545187597`*^9}, 
   3.9265822632294483`*^9},ExpressionUUID->"7b8b4169-9d9f-4651-b54e-\
7de11445aa10"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PanelMinThickness", "::", "usage"}], 
   "=", "\"\<PanelMinThickness is an option to 3D printing functions that \
specifies the minimum width, e.g., minimum wall thickness.\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.920648547852103*^9, 3.920648601204362*^9}, {
  3.926582263243377*^9, 3.926582263247356*^9}},
 CellLabel->
  "In[4327]:=",ExpressionUUID->"eaadd30f-c5b1-4110-b5d8-86a0e52773e5"],

Cell["\<\
Tessellatica does not currently define any general-purpose functions that \
make use of PanelMinThickness, but we define it as an option so that \
panel-generating functions use a consistent way of specifying the desired \
constraint on panels.\
\>", "Text",
 CellChangeTimes->{{3.922631006514579*^9, 3.922631066831641*^9}, {
   3.922901667106887*^9, 3.922901674792417*^9}, 
   3.9265822632669086`*^9},ExpressionUUID->"74e9e5f7-2e37-451c-94d9-\
8412b2a17c18"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Bendy hinges", "Section",
 CellChangeTimes->{{3.935335187279689*^9, 
  3.935335190072414*^9}},ExpressionUUID->"4a1831eb-17fb-4b74-9b7a-\
53a61889879a"],

Cell[CellGroupData[{

Cell["Bendy hinges", "Subsection",
 CellChangeTimes->{{3.9226309013850613`*^9, 3.922630902000608*^9}, {
  3.934726812360333*^9, 
  3.934726823544177*^9}},ExpressionUUID->"06f9ec9c-0aa7-44b8-96e4-\
721a367e2909"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.922630930999423*^9, 
  3.9226309318310833`*^9}},ExpressionUUID->"96f7c4f0-b7dc-4d46-9593-\
82662dfff6ec"],

Cell["\<\
These functions support the creation of flexible (bendy) hinges that connect \
panels. Each hinge will consist of one or more GraphicsComplex objects. We\
\[CloseCurlyQuote]ll make the hinges overlap their corresponding panels to \
ensure good connection (and we\[CloseCurlyQuote]ll assume that the slicer \
software can handle multiple overlapping STL polyhedra).\
\>", "Text",
 CellChangeTimes->{{3.913553919078064*^9, 3.9135540200800047`*^9}, {
  3.9207325800165462`*^9, 3.920732581016659*^9}, {3.922631124613422*^9, 
  3.922631131140238*^9}, {3.932815845877713*^9, 3.932815847357396*^9}, {
  3.934726839383869*^9, 
  3.934726860239129*^9}},ExpressionUUID->"007fc48b-592f-429f-8934-\
5bfaa19adde7"],

Cell["\<\
The types of hinges (and the functions that create them) are:
HingePlateGC \[LongDash] a uniform plate with squared-off edges.
HingeRoundedPlateGC \[LongDash] same thing, but with rounded edges (useful if \
the plate corners interfere with adjacent structure).
HingeRectWireGC \[LongDash] a single number of wires with a square or \
rectangular cross section.
HingeMultiWireGC \[LongDash] a specifiable number of wires, each with a \
square or rectangular cross section.\
\>", "Text",
 CellChangeTimes->{{3.93281585143754*^9, 3.9328159783490553`*^9}, {
  3.9328163812449303`*^9, 3.932816430467276*^9}, {3.932818084923945*^9, 
  3.932818140135054*^9}},ExpressionUUID->"3c333db2-1ab5-44a7-90f3-\
8e8e51b7ba52"]
}, Closed]],

Cell[CellGroupData[{

Cell["HingeThickness", "Subsubsection",
 CellChangeTimes->{{3.915799447911077*^9, 
  3.9157994502963123`*^9}},ExpressionUUID->"5864d8f2-3e6c-4cad-8189-\
a7ca0e96ec18"],

Cell["\<\
HingeThickness will be used to specify the thickness of plate, wire, and \
strap hinges.\
\>", "Text",
 CellChangeTimes->{{3.920732610184491*^9, 3.920732623967861*^9}, {
  3.9328156943297586`*^9, 
  3.932815701819675*^9}},ExpressionUUID->"c402018a-ea3f-4bf9-9f49-\
391bf895c268"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeThickness", "::", "usage"}], 
   "=", "\"\<HingeThickness is an option to 3D printing functions that \
specifies the thickness of hinges used to join panels.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.912178237649675*^9, 3.912178296871338*^9}, {
  3.912251327738995*^9, 3.912251347980993*^9}, {3.915799487130596*^9, 
  3.915799502095591*^9}},
 CellLabel->
  "In[4328]:=",ExpressionUUID->"af9aef58-b906-4e3a-9474-8c0e98c5796f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "HingeEndsClipped\nHingeEndsClip[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}]"
}], "Subsubsection",
 CellChangeTimes->{{3.926592206528008*^9, 3.926592238618123*^9}, 
   3.926594390196445*^9, {3.926594427887479*^9, 
   3.926594430374855*^9}},ExpressionUUID->"766abb0a-f0c8-4ddc-806b-\
e08c0c9a01b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HingeEndsClipped", "::", "usage"}], 
   "=", "\"\<HingeEndsClipped is an option to several hinge functions that \
specifies whether to clip a set of hinge points so that the ends of the \
hinges are squared off.\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.926592254234312*^9, 3.926592328935892*^9}, {
  3.926594390212751*^9, 3.926594390217007*^9}},
 CellLabel->
  "In[4329]:=",ExpressionUUID->"99a8232d-83ad-4b12-bbc3-6cef42443ea1"],

Cell[TextData[{
 "HingeEndsClip[{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}] takes a set of points that specify a hinge and returns a revised set of \
points that are clipped so that the ends of the hinge are squared off."
}], "Text",
 CellChangeTimes->{{3.926592367327064*^9, 3.926592415707333*^9}, 
   3.926594390236438*^9, {3.9265944630184097`*^9, 
   3.92659446479801*^9}},ExpressionUUID->"031f7439-93bd-4bd4-b53f-\
1ca494e4bb7d"],

Cell[TextData[{
 "Arguments:\n\t{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "} \[LongDash] the two panel polyhedron vertices on one side of the hinge.\n\
\t{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "} \[LongDash] the corresponding two panel vertices on the other side of the \
hinge."
}], "Text",
 CellChangeTimes->{{3.926592592887813*^9, 
  3.9265926049706383`*^9}},ExpressionUUID->"19e36264-7a43-4f10-be85-\
e411233159a8"],

Cell[TextData[{
 "Returns: a list {{",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 "}, {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 "}} of revised point values that give a squared-off hinge."
}], "Text",
 CellChangeTimes->{{3.926592618951849*^9, 
  3.926592658136899*^9}},ExpressionUUID->"4e2eb024-5731-4ef0-9374-\
54f5c20f1b83"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HingeEndsClip", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1_", ",", "p2_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"q1_", ",", "q2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r1", ",", "r2", ",", "r12", ",", "p12", ",", "q12", ",", "p1r", ",", 
      "p2r", ",", "q1r", ",", "q2r"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "construct", " ", "the", " ", "average", " ", "line", " ", "between", " ",
       "the", " ", "two", " ", "hinge", " ", 
      RowBox[{"lines", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r1", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p1", "+", "q1"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p2", "+", "q2"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r12", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"r2", "-", "r1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p12", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"p2", "-", "p1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"q12", "=", 
      RowBox[{"NormalizeReal", "[", 
       RowBox[{"q2", "-", "q1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Find", " ", "projection", " ", "of", " ", "all", " ", "four", " ", 
       "points", " ", "onto", " ", "this", " ", "line", " ", "and", " ", 
       "choose", " ", "the", " ", "intersection", " ", "of", " ", "the", " ", 
       "two", " ", 
       RowBox[{"intervals", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p1", "-", "r1"}], ")"}], ".", "r12"}], ">", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q1", "-", "r1"}], ")"}], ".", "r12"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"r1", "+=", 
        RowBox[{"r12", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p1", "-", "r1"}], ")"}], ".", "r12"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"r1", "+=", 
        RowBox[{"r12", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"q1", "-", "r1"}], ")"}], ".", "r12"}], ")"}]}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p2", "-", "r2"}], ")"}], ".", "r12"}], "<", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q2", "-", "r2"}], ")"}], ".", "r12"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"r2", "+=", 
        RowBox[{"r12", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"p2", "-", "r2"}], ")"}], ".", "r12"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"r2", "+=", 
        RowBox[{"r12", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"q2", "-", "r2"}], ")"}], ".", "r12"}], ")"}]}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Back", "-", 
       RowBox[{
       "project", " ", "onto", " ", "the", " ", "original", " ", "lines", " ",
         "to", " ", "get", " ", "endpoints"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"p1r", "=", 
      RowBox[{"p1", "+", 
       RowBox[{"p12", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r1", "-", "p1"}], ")"}], ".", "p12"}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q1r", "=", 
      RowBox[{"q1", "+", 
       RowBox[{"q12", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r1", "-", "q1"}], ")"}], ".", "q12"}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p2r", "=", 
      RowBox[{"p2", "+", 
       RowBox[{"p12", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r2", "-", "p2"}], ")"}], ".", "p12"}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q2r", "=", 
      RowBox[{"q2", "+", 
       RowBox[{"q12", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r2", "-", "q2"}], ")"}], ".", "q12"}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Return", " ", "the", " ", "revised", " ", "hinge", " ", "points", " ", 
       "in", " ", "a", " ", 
       RowBox[{"list", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1r", ",", "p2r"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q1r", ",", "q2r"}], "}"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.926592336907943*^9, 3.926592363120754*^9}, {
   3.9265924414879107`*^9, 3.926592586775996*^9}, 3.92659439025431*^9},
 CellLabel->
  "In[4330]:=",ExpressionUUID->"6fa1defb-f90c-4968-a9ef-9fd373f21eed"],

Cell["\<\
Example. Show with two unmatched lines with a little skew between them.\
\>", "Text",
 CellChangeTimes->{{3.926592663569722*^9, 3.9265926654545393`*^9}, {
  3.926593443324896*^9, 
  3.926593456562263*^9}},ExpressionUUID->"524d4ee0-d060-4079-b911-\
c76dd94ed16f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "p1", ",", "p2", ",", "q1", ",", "q2", ",", "p1r", ",", "p2r", ",", 
      "q1r", ",", "q2r"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.3", ",", ".2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", ".3", ",", ".1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1r", ",", "p2r", ",", "q1r", ",", "q2r"}], "}"}], "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"HingeEndsClip", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p1", ",", "p2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(1\)]\)\>\"", ",", "p1", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(2\)]\)\>\"", ",", "p2", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(q\), \(1\)]\)\>\"", ",", "q1", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "0"}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(q\), \(2\)]\)\>\"", ",", "q2", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "/@", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2", ",", "q1", ",", "q2"}], "}"}]}], ",", 
          RowBox[{"AbsolutePointSize", "[", "5", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{"q1", ",", "q2"}], "}"}], "]"}]}], "}"}], ",", 
          RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(1, r\)]\)\>\"", ",", "p1r", 
          ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(2, r\)]\)\>\"", ",", "p2r", 
          ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(q\), \(1, r\)]\)\>\"", ",", "q1r", 
          ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(q\), \(2, r\)]\)\>\"", ",", "q2r", 
          ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Point", "/@", 
           RowBox[{"{", 
            RowBox[{"p1r", ",", "p2r", ",", "q1r", ",", "q2r"}], "}"}]}], ",", 
          RowBox[{"AbsolutePointSize", "[", "5", "]"}], ",", "Red"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Polygon", "[", 
           RowBox[{"{", 
