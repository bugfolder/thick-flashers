Cell[TextData[{
 "QuadBendEnergy[",
 StyleBox["p1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p3",
  FontSlant->"Italic"],
 ", ",
 StyleBox["p4",
  FontSlant->"Italic"],
 "] returns the bend energy of a quad (or two paired triangles) summed over \
both diagonals."
}], "Text",
 CellChangeTimes->{{3.701174555001946*^9, 3.701174584780357*^9}, 
   3.701174959850958*^9, {3.701175035119615*^9, 3.701175035606922*^9}, {
