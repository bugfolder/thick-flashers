     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"mas", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Start", " ", "a", " ", "new", " ", "script", " ", "for", " ", "the", 
         " ", "complete", " ", "assembly"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"script", " ", "=", " ", "preamble"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Re", "-", 
          RowBox[{
          "read", " ", "in", " ", "all", " ", "of", " ", "the", " ", "panels",
            " ", "and", " ", "join", " ", "them", " ", "up", " ", "into", " ",
            "a", " ", "single", " ", 
           RowBox[{"mesh", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"im", "=", 
         RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "=", 
            RowBox[{
            "pps", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{
            "script", "<>", "\"\<ms.load_new_mesh(file_name = '\>\"", "<>", 
             RowBox[{"phname", "[", "i", "]"}], 
             "<>", "\"\<', unify_vertices = True) # \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"++", "im"}], "]"}], "<>", "\"\<\\n\>\""}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"script", "=", 
            RowBox[{"script", "<>", "\"\<print('Loaded file \>\"", "<>", 
             RowBox[{"phname", "[", "i", "]"}], "<>", "\"\<')\\n\>\""}]}], 
           ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", "pps", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"script", "=", 
         RowBox[{
         "script", 
          "<>", "\"\<ms.generate_by_merging_visible_meshes(mergevisible = \
False)\\n\\n\>\""}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "And", " ", "save", " ", "that", " ", "mesh", " ", "to", " ", "the", 
          " ", "main", " ", 
          RowBox[{"directory", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"outputname", "=", "\"\<panel_assy.stl\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"script", "=", 
         RowBox[{
         "script", "<>", "\"\<ms.save_current_mesh(file_name = '\>\"", "<>", 
          "outputname", "<>", "\"\<')\\n\>\""}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"script", "=", 
         RowBox[{
         "script", "<>", "\"\<print('Saved \>\"", "<>", "outputname", 
          "<>", "\"\<')\\n\>\""}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Export", " ", "the", " ", "script", " ", "to", " ", "assemble", " ",
           "the", " ", 
          RowBox[{"panels", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"scr2", "=", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"dir", "<>", "\"\</make_assy.py\>\""}], ",", "script", 
           ",", "\"\<Text\>\""}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
