Cell[CellGroupData[{

Cell[TextData[{
 "FaceOverlaps2D[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t(unchecked class) TGraph2D"
}], "Subsubsection",
 CellChangeTimes->{{3.628820874675579*^9, 3.628820902576483*^9}, 
   3.628821237379483*^9, {3.628863759639919*^9, 3.6288637600306067`*^9}, {
   3.628868466336857*^9, 
   3.628868466480153*^9}},ExpressionUUID->"aaeb3eb6-feb0-4b67-8c4b-\
bc46d94249c6"],

Cell[TextData[{
 "FaceOverlaps[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] returns a list of undirected edges on the Vertices2D faces that define \
the overlap graph; an edge {",
 StyleBox["i",
  FontSlant->"Italic"],
 ", ",
 StyleBox["j",
  FontSlant->"Italic"],
 "} is in the graph iff the folded form embedding of face ",
 StyleBox["i",
  FontSlant->"Italic"],
 " and face ",
 StyleBox["j",
  FontSlant->"Italic"],
 " overlap."
}], "Text",
 CellChangeTimes->{{3.628820920481954*^9, 3.6288210103457136`*^9}, 
   3.628821071109744*^9, 3.6288212387999177`*^9, {3.628863729233081*^9, 
   3.628863749519408*^9}, {3.628868373478641*^9, 
   3.6288683741821547`*^9}},ExpressionUUID->"9f2f68be-c896-4dcf-bedb-\
97bcd3a8e3d8"],

Cell["\<\
You can rely on the ordering of the indices: first index is always smaller.\
\>", "Text",
 CellChangeTimes->{{3.628868383414173*^9, 
  3.6288683941411333`*^9}},ExpressionUUID->"bf41f9a9-08ce-42fb-ad9f-\
8deea55d55b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FaceOverlaps2D", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts2d", ",", "faces", ",", "polys", ",", "infos", ",", "oedges"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts2d", ",", "faces"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices2D", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"polys", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
        "verts2d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
        "&"}], "/@", "faces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"infos", "=", 
      RowBox[{"QuasiConvexPolygonIntersectionInfo", "/@", "polys"}]}], ";", 
     " ", 
     RowBox[{"(*", " ", 
      RowBox[{"each", " ", "entry", " ", "is", " ", 
       RowBox[{"{", 
        RowBox[{
        "verts", ",", " ", "bbox", ",", " ", "convex", ",", " ", 
         "triangles"}], " ", "}"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"oedges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"first", " ", "quick", " ", "check"}], ",", " ", 
        RowBox[{
        "see", " ", "if", " ", "bounding", " ", "boxes", " ", "intersect"}]}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"BoundingBoxesIntersectQ", "[", 
            RowBox[{
             RowBox[{"infos", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
             RowBox[{"infos", "\[LeftDoubleBracket]", 
              RowBox[{"j", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}]}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"now", " ", "check", " ", "for", " ", "real"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"QuasiConvexPolygonsIntersectQ", "[", 
           RowBox[{
            RowBox[{
            "infos", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
            "infos", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}],
            "]"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"oedges", ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "i"}], "}"}]}], "]"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{"Length", "[", "faces", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "oedges"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.628821038869235*^9, 3.628821051983617*^9}, {
  3.628821092262985*^9, 3.628821262421224*^9}, {3.628821374752664*^9, 
  3.628821375727336*^9}, {3.628863764284336*^9, 3.628863846093107*^9}, {
  3.628863879707308*^9, 3.628863987159552*^9}, {3.628864232991782*^9, 
  3.628864272118204*^9}, {3.6288648671192*^9, 3.6288648997953672`*^9}, {
  3.628865104254892*^9, 3.628865120798539*^9}, {3.628868358295842*^9, 
  3.628868358967044*^9}, {3.628872466706537*^9, 3.628872510019723*^9}},
 CellLabel->
  "In[1870]:=",ExpressionUUID->"bd56f3b9-c8da-4a53-be4d-841b18a276e6"],

Cell["Example. ", "Text",
