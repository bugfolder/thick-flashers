            RowBox[{"StyledRuledPatch", "[", 
             RowBox[{"bb1", ",", 
              RowBox[{"Functionize", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"ff", "[", "s", "]"}], "-", 
                 RowBox[{"bb1", "[", "s", "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"u0", ",", "u1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
