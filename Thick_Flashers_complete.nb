0a28844078ad"],

Cell[TextData[{
 "A segment set represents a set of segments of a common line and has the \
representation {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}, where ",
 StyleBox["q1",
  FontSlant->"Italic"],
 " and ",
 StyleBox["q2",
  FontSlant->"Italic"],
 " are two points that define the line parameterized by (1-",
 StyleBox["t",
  FontSlant->"Italic"],
 ")",
 StyleBox["q1",
  FontSlant->"Italic"],
 "+",
 StyleBox["t",
  FontSlant->"Italic"],
 " ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["is",
  FontSlant->"Italic"],
 " is an interval set of values for the parameter ",
 StyleBox["t",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.484754567034259*^9, 3.484754694369258*^9}, {
  3.484759029122191*^9, 3.48475903388209*^9}, {3.484776021155663*^9, 
  3.484776021338468*^9}},ExpressionUUID->"365c476f-74b9-4d78-b8bc-\
d7cd56261257"],

Cell[TextData[{
 "SegmentSetLine[{",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "}] takes a segment set {",
 StyleBox["q1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["is",
  FontSlant->"Italic"],
 "} and returns a list of Line[] objects for each segment of parameterized \
line (1-",
 StyleBox["t",
  FontSlant->"Italic"],
 ")",
 StyleBox["q1",
  FontSlant->"Italic"],
 "+",
 StyleBox["t",
  FontSlant->"Italic"],
 " ",
 StyleBox["q2",
  FontSlant->"Italic"],
 " whose parameter ",
 StyleBox["t",
  FontSlant->"Italic"],
 " lies within the interval set ",
 StyleBox["is",
  FontSlant->"Italic"],
 ". If an interval pair is of zero length, no line is returned."
}], "Text",
 CellChangeTimes->{{3.484755583014914*^9, 3.484755669656467*^9}, {
  3.628338956530594*^9, 
  3.6283390052874403`*^9}},ExpressionUUID->"255b1588-1f2d-4f79-b72d-\
55812768d9f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SegmentSetLine", "[", 
   RowBox[{"{", 
    RowBox[{"q1_", ",", "q2_", ",", "is_"}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]", 
       RowBox[{"#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
      ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"Line", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "#"}], ")"}], "q1"}], "+", 
       RowBox[{"#", "q2"}]}], "&"}], ",", "is", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.4847555620117693`*^9, 3.484755576802188*^9}, {
   3.484755718912298*^9, 3.484755763821091*^9}, {3.484757724450919*^9, 
   3.484757750378495*^9}, 3.484757835646677*^9, {3.484757917756734*^9, 
   3.484757952798581*^9}, {3.628339021842125*^9, 3.628339085861107*^9}, {
   3.6289664740304813`*^9, 3.628966554160214*^9}, {3.628966665580793*^9, 
   3.628966670243741*^9}},
 CellLabel->
  "In[550]:=",ExpressionUUID->"b35e38d0-6e20-40f5-b757-cce8945d4969"],

