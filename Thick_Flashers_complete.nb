Cell[CellGroupData[{

Cell[TextData[{
 "AtLeastTrivalentQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t",
 "(unchecked class",
 ") TGraph"
}], "Subsubsection",
 CellChangeTimes->{
  3.4559230286816874`*^9, {3.591651328951108*^9, 3.591651337669913*^9}, 
   3.591728608848328*^9, 3.592431912660681*^9, 3.592435848619715*^9, 
   3.59473248989925*^9},ExpressionUUID->"21e7c80a-1bcd-472f-a02d-\
f3e9e3dd8c67"],

Cell[TextData[{
 "AtLeastTrivalentQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a ",
 "TObj",
 " containing vertices ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " and edges ",
 StyleBox["edges",
  FontSlant->"Italic"],
 " and returns true if the graph defined by ",
 StyleBox["edges",
  FontSlant->"Italic"],
 " on ",
 StyleBox["verts",
  FontSlant->"Italic"],
 " has vertex valency \[GreaterEqual]3 at every vertex."
}], "Text",
 CellChangeTimes->{
  3.4576204411052637`*^9, {3.591651354652343*^9, 3.591651372458715*^9}, 
   3.592435738616796*^9},ExpressionUUID->"8e4afd4b-17f4-48e3-899e-\
d86633faa287"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AtLeastTrivalentQ", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Edges"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"And", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", "edges", "]"}], ",", "i"}], "]"}], "\[GreaterEqual]",
          "3"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "verts", "]"}]}], "}"}]}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.591651386405942*^9, 3.591651426371838*^9}, 
   3.59243573870892*^9},
 CellLabel->
  "In[1111]:=",ExpressionUUID->"4a5811c6-41fb-4f73-b7eb-bed7d6dcdac1"],

Cell["Example. This one is trivalent.", "Text",
 CellChangeTimes->{{3.591651432303547*^9, 3.591651433039202*^9}, {
  3.591651484613418*^9, 
  3.591651487740141*^9}},ExpressionUUID->"7005648b-c6b4-4093-bf7c-\
f84850eea48e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"verts", ",", "edges", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "0.5"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTGraph", "[", 
       RowBox[{"verts", ",", "edges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AtLeastTrivalentQ", "[", "tobj", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.591651434323502*^9, 3.591651476309857*^9}, {
