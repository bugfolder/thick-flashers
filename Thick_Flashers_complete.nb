   3.595356659370408*^9}, {3.59535781512136*^9, 3.595357827127346*^9}, {
   3.595358423613907*^9, 3.595358499076394*^9}, {3.595360663556126*^9, 
   3.595360673271929*^9}, 3.626460410772919*^9, 3.708400177975294*^9, 
   3.708603657004341*^9, {3.72225087240914*^9, 3.722250902779169*^9}, {
   3.722250932865107*^9, 3.722250978225957*^9}, {3.722251066235651*^9, 
   3.7222511394305563`*^9}, {3.722251192989384*^9, 3.722251277252685*^9}, {
   3.722251457951897*^9, 3.722251459334145*^9}, {3.722251676553008*^9, 
   3.722251813562976*^9}, {3.722251861204348*^9, 3.7222518628977*^9}, {
   3.722251916347665*^9, 3.722251937411115*^9}, {3.72225198215865*^9, 
   3.722252146351406*^9}, {3.726081163465451*^9, 3.726081208080735*^9}, 
   3.726081242082734*^9, {3.726082218984149*^9, 3.726082255881081*^9}},
