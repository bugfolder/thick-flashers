Cell[CellGroupData[{

Cell[TextData[{
 "TetrahedronSinA[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595801909397413*^9, 
  3.595801929651012*^9}},ExpressionUUID->"53849299-0061-4f51-8650-\
6231044611eb"],

Cell[TextData[{
 "TetrahedronSinA[",
 StyleBox["a, b, c, d, e, f",
  FontSlant->"Italic"],
 "] returns the sine of the dihedral angle along edge ",
 StyleBox["a",
  FontSlant->"Italic"],
 " for a tetrahedron with edge lengths ",
 StyleBox["a\[Dash]f",
  FontSlant->"Italic"],
 " where ",
 StyleBox["f",
  FontSlant->"Italic"],
 " is opposite ",
 StyleBox["a",
  FontSlant->"Italic"],
 ", ",
 StyleBox["b",
  FontSlant->"Italic"],
 " and ",
 StyleBox["d",
  FontSlant->"Italic"],
 " meet at ",
 StyleBox["a",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["e",
  FontSlant->"Italic"],
 " and ",
 StyleBox["e",
  FontSlant->"Italic"],
 " meet at ",
 StyleBox["a",
  FontSlant->"Italic"],
 ". (See the Notes example for a picture.)"
}], "Text",
 CellChangeTimes->{{3.595801948795414*^9, 3.5958020372196603`*^9}, 
   3.595975863484608*^9, {3.595975991453219*^9, 
   3.595975992027862*^9}},ExpressionUUID->"832b87d8-af76-44ff-a7c4-\
a4ce6f94ac91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronSinA", "[", 
   StyleBox[
    RowBox[{
    "a_", ",", " ", "b_", ",", " ", "c_", ",", " ", "d_", ",", " ", "e_", ",",
      " ", "f_"}],
    FontSlant->"Italic"], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"2", " ", "a", " ", 
     RowBox[{"\[Sqrt]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["b", "4"]}], " ", 
         SuperscriptBox["e", "2"]}], "-", 
        RowBox[{
         SuperscriptBox["a", "4"], " ", 
         SuperscriptBox["f", "2"]}], "+", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["b", "2"]}], "+", 
              SuperscriptBox["c", "2"]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"d", "-", "e"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"d", "+", "e"}], ")"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["b", "2"], "+", 
              SuperscriptBox["c", "2"], "+", 
              SuperscriptBox["d", "2"], "+", 
              SuperscriptBox["e", "2"]}], ")"}], " ", 
            SuperscriptBox["f", "2"]}], "-", 
           SuperscriptBox["f", "4"]}], ")"}]}], "-", 
        RowBox[{
         SuperscriptBox["d", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["c", "4"], "+", 
           RowBox[{
            SuperscriptBox["e", "2"], " ", 
            SuperscriptBox["f", "2"]}], "+", 
           RowBox[{
            SuperscriptBox["c", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["d", "2"], "-", 
              SuperscriptBox["e", "2"], "-", 
              SuperscriptBox["f", "2"]}], ")"}]}]}], ")"}]}], "+", 
        RowBox[{
         SuperscriptBox["b", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["c", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["d", "2"], "+", 
              SuperscriptBox["e", "2"], "-", 
              SuperscriptBox["f", "2"]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["e", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["d", "2"], "-", 
              SuperscriptBox["e", "2"], "+", 
              SuperscriptBox["f", "2"]}], ")"}]}]}], ")"}]}]}], ")"}]}]}], 
    ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"a", "-", "b", "-", "c"}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "b", "-", "c"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "-", "b", "+", "c"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "b", "+", "c"}], ")"}]}]], " ", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"a", "-", "d", "-", "e"}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "d", "-", "e"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "-", "d", "+", "e"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"a", "+", "d", "+", "e"}], ")"}]}]]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.595802045134791*^9, 3.595802125227784*^9}, {
  3.5958028871799507`*^9, 3.595802899845161*^9}},
 CellLabel->
  "In[645]:=",ExpressionUUID->"3e6e028f-0c88-4f91-adcd-bd5ee0a77610"],

