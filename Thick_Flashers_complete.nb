Cell[CellGroupData[{

Cell["Fluted cones and sliced vertices", "Subsection",
 CellChangeTimes->{{3.442788987593774*^9, 3.442788994101701*^9}, {
  3.533657381882107*^9, 
  3.53365738789001*^9}},ExpressionUUID->"cff5aa8a-bde2-4ccd-ae01-\
48cc3ac6f127"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.533657619209609*^9, 
  3.533657619761798*^9}},ExpressionUUID->"8905215b-66b3-472a-a5d4-\
5d3c03990937"],

Cell["\<\
A structure that both Ron Resch and David Huffman studied involved slicing \
cones with planes. Huffman developed a particularly nice sculpture, created \
by slicing a single cone with a set of tilted planes. However, one needs to \
glue together the required cone; it\[CloseCurlyQuote]s not made from a flat \
sheet. An alternative (my idea) is to simulate the cone by pleating a flat \
sheet conically, then performing the slicing. One needs to be careful, \
though, of the slice angle, to insure that after the reflection, the cone \
doesn\[CloseCurlyQuote]t penetrate itself.\
\>", "Text",
 CellChangeTimes->{{3.533657622121771*^9, 
  3.533657758912704*^9}},ExpressionUUID->"d4482580-4542-4621-a090-\
54fd44be79f0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "MakeFlutedConeCreaseVectors[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qmin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qmax",
  FontSlant->"Italic"],
 "]\nMakeFlutedConeCreaseVectors[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qmin",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.442790076755446*^9, 3.442790093066337*^9}, {
  3.5336569789697843`*^9, 
  3.533656984917681*^9}},ExpressionUUID->"98e2c622-1541-418b-80c7-\
b78d5482e8a6"],

Cell[TextData[{
 "MakeFlutedConeCreaseVectors[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qmin",
  FontSlant->"Italic"],
 ", ",
 StyleBox["qmax",
  FontSlant->"Italic"],
 "] constructs the crease vectors for a fluted cone where ",
 StyleBox["m",
  FontSlant->"Italic"],
 " is the rotational order, ",
 StyleBox["k",
  FontSlant->"Italic"],
 " is the number of facets to use between min and max angles, ",
 StyleBox["qmin",
  FontSlant->"Italic"],
 " is the minimum angle and ",
 StyleBox["qmax",
  FontSlant->"Italic"],
 " is the maximum angle. The form of the crease direction vectors is of an \
upward-pointing cone, suitable for input to ",
 "MakeTVertex3DFromFoldVectors",
 "."
}], "Text",
 CellChangeTimes->{{3.442789123642165*^9, 3.442789203118382*^9}, {
   3.533656987463113*^9, 3.5336569896543813`*^9}, {3.533657059577996*^9, 
   3.533657062201555*^9}, {3.592153319809885*^9, 3.592153320126975*^9}, 
   3.592437131661758*^9, 3.5928291699721527`*^9, 
   3.616173723964545*^9},ExpressionUUID->"327609d0-3d64-4a73-85b8-\
ef55c8019ab7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeFlutedConeCreaseVectors", "[", 
   RowBox[{"m_", ",", "k_", ",", "qmin_", ",", "qmax_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qa", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qmax", "+", "qmin"}], ")"}], "/", "2"}]}], ",", 
      RowBox[{"qb", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qmax", "-", "qmin"}], ")"}], "/", "2"}]}], ",", "qfn"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"qfn", "=", 
      RowBox[{
       RowBox[{"qa", " ", "+", " ", 
        RowBox[{"qb", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"m", " ", "#"}], "]"}]}]}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Phi]", "=", 
           RowBox[{"2", "\[Pi]", " ", 
            RowBox[{"i", "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "m", " ", "k"}], ")"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"qfn", "[", "\[Phi]", "]"}], "]"}], 
            RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"qfn", "[", "\[Phi]", "]"}], "]"}], 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
           RowBox[{"Cos", "[", 
            RowBox[{"qfn", "[", "\[Phi]", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{
          RowBox[{"2", " ", "m", " ", "k"}], "-", "1"}]}], "}"}]}], "]"}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.442769472068254*^9, 3.442769780763247*^9}, {
   3.442769838562531*^9, 3.442769853303514*^9}, {3.442770659349992*^9, 
