Cell[BoxData[
 RowBox[{
  RowBox[{"NFoldSurfaceToCylinder", "[", 
   RowBox[{
   "b1_Function", ",", "d1_Function", ",", "bb1_Function", ",", 
    "dd1_Function", ",", 
    RowBox[{"{", 
     RowBox[{
     "p2i_List", ",", "d2i_List", ",", "pp2i_List", ",", "dd2i_List"}], "}"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "vi", ",", "fi", ",", "ffi", ",", "d20i", ",", "dd20i", ",", 
      "\[Psi]", ",", "d23", ",", "f", ",", "ff", ",", "b2", ",", "bb2", ",", 
      "d2", ",", "dd2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d23", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", ",", "fp", ",", "ffp", ",", "b2p", ",", "bb2p"}], 
           "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"v", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"p2i", "-", 
                 RowBox[{"b1", "[", "s", "]"}]}], ")"}], ".", "d2i"}], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"pp2i", "-", 
                 RowBox[{"bb1", "[", "s", "]"}]}], ")"}], ".", "dd2i"}]}], 
             RowBox[{
              RowBox[{
               RowBox[{"d1", "[", "s", "]"}], ".", "d2i"}], "-", 
              RowBox[{
               RowBox[{"dd1", "[", "s", "]"}], ".", "dd2i"}]}]]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"fp", "=", 
            RowBox[{
             RowBox[{"b1", "[", "s", "]"}], "+", 
             RowBox[{"v", " ", 
              RowBox[{"d1", "[", "s", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"ffp", "=", 
            RowBox[{
             RowBox[{"bb1", "[", "s", "]"}], "+", 
             RowBox[{"v", " ", 
              RowBox[{"dd1", "[", "s", "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"b2p", "=", 
            RowBox[{"fp", "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"fp", "-", "p2i"}], ")"}], ".", "d2i"}], ")"}], 
              "d2i"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"bb2p", "=", 
            RowBox[{"ffp", "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"ffp", "-", "pp2i"}], ")"}], ".", "dd2i"}], ")"}], 
              "dd2i"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Join", "[", 
            RowBox[{"b2p", ",", "bb2p", ",", "fp", ",", "ffp"}], "]"}]}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"b2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"d23", "[", "s", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bb2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"d23", "[", "s", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4", ",", "5"}], "}"}], 
         "\[RightDoubleBracket]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"d23", "[", "s", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"6", ",", "7"}], "}"}], "\[RightDoubleBracket]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ff", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"d23", "[", "s", "]"}], "\[LeftDoubleBracket]", 
         RowBox[{"{", 
          RowBox[{"8", ",", "9", ",", "10"}], "}"}], 
         "\[RightDoubleBracket]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "d2i"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dd2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", "dd2i"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"b2", ",", "d2", ",", "bb2", ",", "dd2", ",", "f", ",", "ff"}], 
      "}"}]}]}], "]"}]}]], "Input",
