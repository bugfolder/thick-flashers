   3.713634954438652*^9}},ExpressionUUID->"825c1efe-f8f5-48fb-9d6f-\
ebafb11d3ffa"],

Cell[TextData[{
 "Options:\n\tArrowPosition \[Rule] ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", where ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the fractional position along the line. Default is in the middle of the \
line.\n\tArrowheadStyle \[Rule] Arrowheads[",
 StyleBox["spec",
  FontSlant->"Italic"],
 "], to modify the appearance of arrowheads."
}], "Text",
 CellChangeTimes->{{3.7136349565021276`*^9, 
  3.713634965439851*^9}},ExpressionUUID->"02746de9-4701-4281-9f2c-\
0276cbe87aed"],

