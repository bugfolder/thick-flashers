86db5379439a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TetrahedronCosA", "[", 
   RowBox[{"p_", ",", " ", "q_", ",", " ", "r_", ",", " ", "s_"}], "]"}], " ",
   ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", "s"}], ")"}], "\[Cross]", 
     RowBox[{"(", 
      RowBox[{"q", "-", "s"}], ")"}]}], 
    RowBox[{"Mag", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "s"}], ")"}], "\[Cross]", 
      RowBox[{"(", 
       RowBox[{"q", "-", "s"}], ")"}]}], "]"}]], ".", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", "r"}], ")"}], "\[Cross]", 
     RowBox[{"(", 
      RowBox[{"q", "-", "r"}], ")"}]}], 
    RowBox[{"Mag", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "r"}], ")"}], "\[Cross]", 
      RowBox[{"(", 
       RowBox[{"q", "-", "r"}], ")"}]}], "]"}]]}]}]], "Input",
