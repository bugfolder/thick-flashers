Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CurvatureMatrix", "::", "usage"}], 
   "=", "\"\<CurvatureMatrix is a key to the rules returned by SurfaceSystem \
that gives the curvature matrix of the surface.\>\""}], ";"}]], "Input",
