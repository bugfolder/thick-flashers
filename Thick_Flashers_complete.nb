Cell["Example: two ellipses, one rotated relative to the other.", "Text",
 CellChangeTimes->{{3.671179378580347*^9, 3.671179379315285*^9}, {
  3.671179476269991*^9, 3.67117948130822*^9}, {3.671250683102395*^9, 
