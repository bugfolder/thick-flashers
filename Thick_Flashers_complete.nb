Cell[TextData[{
 "FlasherOuterRingSectorVertices[",
 StyleBox["v",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 "] returns the vertices of the outer ring of the ",
 StyleBox["k",
  FontSlant->"Italic"],
 "th sector. Useful for both the FlasherOuterRingFns (where ",
 StyleBox["v",
  FontSlant->"Italic"],
 "\[Rule]pp, see next) and for finding incircle and circumcircle of crease \
patterns (where ",
 StyleBox["v",
  FontSlant->"Italic"],
 "\[Rule]p)."
}], "Text",
 CellChangeTimes->{{3.555838449551999*^9, 3.5558385618964443`*^9}, {
   3.555839183591411*^9, 3.5558391998224077`*^9}, {3.55584259345015*^9, 
   3.555842635004098*^9}, {3.555843279548465*^9, 3.555843363668029*^9}, {
   3.555843451360186*^9, 3.55584345829412*^9}, 3.555854319749591*^9, 
   3.555854356266938*^9, {3.719869793674446*^9, 
   3.719869806259355*^9}},ExpressionUUID->"4c2cae57-4ea4-4786-8713-\
bc9d7811420a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FlasherOuterRingSectorVertices", "[", 
   RowBox[{"v_", ",", "r_", ",", "h_", ",", "m_", ",", "k_"}], "]"}], " ", ":=", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      SubscriptBox["v", 
       RowBox[{
        RowBox[{"r", "*", "h"}], ",", 
        RowBox[{"j", "*", "h"}], ",", "k"}]], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "r"}], "}"}]}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      SubscriptBox["v", 
       RowBox[{
        RowBox[{
         RowBox[{"i", "*", "h"}], "-", "1"}], ",", 
        RowBox[{"r", "*", "h"}], ",", "k"}]], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "r"}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.555843376827015*^9, 3.555843415398972*^9}, {
