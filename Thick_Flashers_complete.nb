Cell[BoxData[
 RowBox[{
  RowBox[{"NRibbonPair", "[", 
   RowBox[{
    RowBox[{"cc_Function", "|", "cc_InterpolatingFunction"}], ",", 
    RowBox[{"\[Eta]_Function", "|", "\[Eta]_InterpolatingFunction"}], ",", 
    "\[Sigma]_", ",", 
    RowBox[{"{", 
     RowBox[{"ui_", ",", "ci_List", ",", "ti_List"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"u0_", ",", "u1_"}], "}"}], ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "csys3d", ",", "ds", ",", "tt", ",", "nn", ",", "bb", ",", 
      "ll", ",", "uu", ",", "duu", ",", "c", ",", "t", ",", "l", ",", "u", ",",
       "c\[Rho]L", ",", "s\[Rho]L", ",", "dd", ",", "\[Kappa]l", ",", 
      "csys2d", ",", "d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"csys3d", "=", 
      RowBox[{"NCurve3DSystem", "[", 
       RowBox[{"cc", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "tt", ",", "nn", ",", "bb"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed3D", ",", "TangentVector3D", ",", "NormalVector3D", ",", 
         "BinormalVector3D"}], "}"}], "/.", "csys3d"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ll", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "-", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
          RowBox[{"nn", "[", "s", "]"}]}], "+", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Eta]", "[", "s", "]"}], "]"}], 
          RowBox[{"bb", "[", "s", "]"}]}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duu", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"uu", "'"}], "[", "s", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"duu", "[", "s", "]"}], ".", 
           RowBox[{"tt", "[", "s", "]"}]}], "]"}], 
         RowBox[{"Mag", "[", 
          RowBox[{"duu", "[", "s", "]"}], "]"}]], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sign", "[", 
           RowBox[{
            RowBox[{"duu", "[", "s", "]"}], ".", 
            RowBox[{"tt", "[", "s", "]"}]}], "]"}]}], 
         FractionBox[
          RowBox[{
           RowBox[{"duu", "[", "s", "]"}], ".", 
           RowBox[{"ll", "[", "s", "]"}]}], 
          RowBox[{"Mag", "[", 
           RowBox[{"duu", "[", "s", "]"}], "]"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"dd", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
            RowBox[{"tt", "[", "s", "]"}]}], "+", 
           RowBox[{
            RowBox[{"s\[Rho]L", " ", "[", "s", "]"}], 
            RowBox[{"ll", "[", "s", "]"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]l", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"ll", "[", "s", "]"}], ".", 
          RowBox[{
           RowBox[{"tt", "'"}], "[", "s", "]"}]}], "/", 
         RowBox[{"ds", "[", "s", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"csys2d", "=", 
      RowBox[{"NRecoverCurve2DSystem", "[", 
       RowBox[{"ds", ",", "\[Kappa]l", ",", 
        RowBox[{"{", 
         RowBox[{"ui", ",", "ci", ",", "ti"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Curve2D", ",", "TangentVector2D", ",", "LeftNormalVector2D"}], "}"}],
        "/.", "csys2d"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
      RowBox[{"FunctionInterpolationAlt", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"c\[Rho]L", "[", "s", "]"}], " ", 
            RowBox[{"t", "[", "s", "]"}]}], "+", 
           RowBox[{
            RowBox[{"s\[Rho]L", "[", "s", "]"}], " ", 
            RowBox[{"l", "[", "s", "]"}]}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "u0", ",", "u1"}], "}"}], ",", "opts"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d", ",", "cc", ",", "dd"}], "}"}]}]}], 
   "]"}]}]], "Input",
