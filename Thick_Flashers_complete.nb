Cell["\<\
Example. A circle, but with linearly varying curve speed and initial position \
and turning angle.\
\>", "Text",
 CellChangeTimes->{{3.690972134800218*^9, 3.690972138816057*^9}, {
  3.690972528555483*^9, 3.690972543213759*^9}, {3.6909753872624893`*^9, 
  3.690975392427096*^9}, {3.691196383252036*^9, 3.691196383594311*^9}, {
  3.691696945761037*^9, 
  3.691696950531046*^9}},ExpressionUUID->"94b728a6-851b-495d-a222-\
063a106116b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "lkp", ",", "v", ",", "u0", ",", "u1", ",", "rcs", ",", "plots"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lkp", "=", 
      RowBox[{"2", "&"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"constant", " ", "curvature"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"#", "&"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"linearly", " ", "increasing", " ", "speed"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"u0", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"u1", "=", 
      RowBox[{"\[Pi]", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rcs", "=", 
      RowBox[{"NRecoverCurve2DSystemOld", "[", 
       RowBox[{"lkp", ",", "v", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}], ",", 
        RowBox[{"InitialPosition2D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], ",", 
        RowBox[{"InitialTangentVector2D", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plots", "=", 
      RowBox[{"Curve2DSystemPlots", "[", 
       RowBox[{"rcs", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "u1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PartitionedGraphicsGrid", "[", 
      RowBox[{"plots", ",", "4"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "//",
   "ShowExample"}]], "Input",
 CellChangeTimes->{{3.69097154200583*^9, 3.690971745596602*^9}, {
   3.690971788658461*^9, 3.690971792111229*^9}, {3.690972128266711*^9, 
