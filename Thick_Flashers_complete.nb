Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "\[Phi]", ",", "dx", ",", "dy", ",", "dz", ",", "botpts2d", ",",
       "toppts2d", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", "=", "24"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"rotational", " ", "order"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"175.", "\[Degree]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "amount", " ", "of", " ", "twist", " ", "from", " ", "bottom", " ", 
       "to", " ", "top"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dx", ",", "dy"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", "0.5"}], "}"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "lateral", " ", "offset", " ", "from", " ", "bottom", " ", "to", " ", 
       "top"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dz", "=", "0.32"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{"hand", "-", 
       RowBox[{
       "tweaked", " ", "to", " ", "get", " ", "tangency", " ", "of", " ", 
        "top", " ", "and", " ", "bottom"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"botpts2d", "=", 
      RowBox[{"DiscreteCircle", "[", 
       RowBox[{"m", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"toppts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dx", ",", "dy"}], "}"}], "+", "#"}], "&"}], "/@", 
       RowBox[{"DiscreteCircle", "[", 
        RowBox[{"m", ",", "1", ",", "\[Phi]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"TwistJoinedTubeGraphics", "[", 
        RowBox[{"botpts2d", ",", "toppts2d"}], "]"}], "]"}], "//", "Hold"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"TwistJoinedTubes", "[", 
       RowBox[{"botpts2d", ",", "toppts2d", ",", "dz", ",", 
        RowBox[{"PanelOverlap", "\[Rule]", "True"}], ",", 
        RowBox[{"TypeMinimumAngle", "\[Rule]", 
         RowBox[{"30", "\[Degree]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"CreasePatternGraphics", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}], ",", 
        RowBox[{
         RowBox[{"FoldedFormGraphics3D", "[", "tobj", "]"}], "/.", 
         RowBox[{"OrigamiStyle", "[", "]"}]}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
