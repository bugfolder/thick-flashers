             RowBox[{"RotateLeft", "[", 
              RowBox[{
              "star", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"alist", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"alist", ",", 
