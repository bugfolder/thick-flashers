Cell[TextData[{
 "DelaunayTriangleGraphQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "]\n\t",
 "(unchecked class",
 ") TGraph"
}], "Subsubsection",
 CellChangeTimes->{{3.466096797166306*^9, 3.466096822436408*^9}, {
   3.591734979624111*^9, 3.591734984206434*^9}, {3.591735465270252*^9, 
   3.5917354656657248`*^9}, {3.592239606275723*^9, 3.59223960965028*^9}, 
   3.5924025273908167`*^9, {3.592403167564247*^9, 3.592403168714073*^9}, 
   3.592828722927034*^9, 3.5930169315061817`*^9, 
   3.5947324934070787`*^9},ExpressionUUID->"4fb3e0d6-204c-4e0e-85bb-\
96523b4bb77b"],

Cell[TextData[{
 "DelaunayTriangleGraphQ[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph and returns true if the given graph satisfies the Delaunay \
property, which is that for every triangular face of the graph, the \
circumcircle of that triangle contains no other vertices of the graph. This \
is slightly looser than requiring that the graph actually be a Delaunay \
triangulation. The graph doesn't need to be convex to satisfy this property, \
but Delaunay triangulations are convex."
}], "Text",
 CellChangeTimes->{{3.466096826628319*^9, 3.466096890399782*^9}, {
   3.4660969319491587`*^9, 3.466096976986129*^9}, {3.466097055445075*^9, 
   3.466097075763615*^9}, {3.466097439468854*^9, 3.466097448514055*^9}, {
   3.591735470002403*^9, 3.591735479666561*^9}, {3.592403181945444*^9, 
   3.592403182913459*^9}, {3.5924033157449703`*^9, 3.5924033211441*^9}, 
   3.592828723083025*^9, 
   3.593016933722369*^9},ExpressionUUID->"b010c01a-81e6-466f-ae4f-\
7f26c444d515"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DelaunayTriangleGraphQ", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "faces", ",", "dverts", ",", "ctr", ",", "rad", ",", 
      "testverts", ",", "ret"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "faces"}], "}"}], " ", "=", " ", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices", ",", "Faces"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"TriangleGraphQ", "[", "tobj", "]"}]}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Circumcenter", "[", 
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], 
         "]"}], "&"}], "/@", "faces"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ret", "=", "True"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ctr", "=", 
         RowBox[{
         "dverts", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"rad", "=", 
         RowBox[{"Mag", "[", 
          RowBox[{
           RowBox[{"verts", "\[LeftDoubleBracket]", 
            RowBox[{"faces", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], 
            "\[RightDoubleBracket]"}], "-", "ctr"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"testverts", "=", 
         RowBox[{"verts", "\[LeftDoubleBracket]", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "verts", "]"}], "]"}], ",", 
            RowBox[{
            "faces", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
            "]"}], "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Or", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Mag", "[", 
                RowBox[{"#", "-", "ctr"}], "]"}], "<", "rad"}], "&"}], "/@", 
             "testverts"}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"ret", "=", "False"}], ";", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "faces", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "ret"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.466096998891396*^9, 3.466097241390723*^9}, {
   3.466097287868937*^9, 3.4660973891989594`*^9}, {3.466097561107944*^9, 
   3.466097587827197*^9}, {3.466097634083717*^9, 3.466097721600352*^9}, {
   3.466097772110841*^9, 3.466097864291256*^9}, {3.466097902736884*^9, 
   3.466098065465805*^9}, {3.5917354911095324`*^9, 3.5917355257560043`*^9}, 
   3.5924357483497972`*^9},
 CellLabel->
  "In[1513]:=",ExpressionUUID->"88a99761-ddb4-484e-9618-24a92cbb8a7e"],

Cell["Example: this one satisfies the Delaunay property.", "Text",
 CellChangeTimes->{{3.466097473354134*^9, 3.466097475048683*^9}, 
   3.466098094033005*^9, {3.592050302479931*^9, 
   3.592050311997682*^9}},ExpressionUUID->"84a33230-f9c4-4e58-9582-\
87f8d496fac3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", "pverts", ",", "pedges", ",", "tobj"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", "1.0"}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"1.0", " ", "gives", " ", "non"}], "-", 
         RowBox[{"crossing", " ", "graph"}]}]}], ",", " ", 
       RowBox[{"r", "=", 
        RowBox[{
        "1.6", " ", "gives", " ", "a", " ", "crossing", " ", "dual"}]}]}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pverts", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1.0", ",", "r"}], "}"}], "*", "#"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0.3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1.7"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "7"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"6", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"8", ",", "7"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{"MakeTPlaneGraph", "[", 
       RowBox[{"pverts", ",", "pedges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"GraphGraphics", "[", "tobj", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DelaunayTriangleGraphQ", "[", "tobj", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], "//", "ShowExample"}]], "Input",
 CellChangeTimes->{{3.4660955904131308`*^9, 3.466095639562449*^9}, {
   3.466095678855829*^9, 3.466095807479356*^9}, {3.466095919322153*^9, 
