Cell[TextData[{
 "Here\[CloseCurlyQuote]s a manipulable 3D vertex, not flat-foldable, that \
binds on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "4"], TraditionalForm]],ExpressionUUID->
  "c5363280-2061-4dc4-919c-b98086916ac9"],
 ". We compute the binding angle to set the range of manipulation angles."
}], "Text",
 CellChangeTimes->{{3.59766653011241*^9, 3.59766654959671*^9}, {
  3.597671076165353*^9, 3.597671079962151*^9}, {3.617308473197006*^9, 
