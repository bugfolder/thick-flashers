5d266840a567"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeTVertex3DFromTGraph3D", "::", "badadj"}], 
   "=", "\"\<Vertex `1` is not adjacent to vertex `2`.\>\""}], ";"}]], "Input",\

 CellChangeTimes->{{3.5952763235224533`*^9, 3.595276356205989*^9}, {
   3.595278772250638*^9, 3.595278784608114*^9}, 3.595279202056597*^9},
 CellLabel->
  "In[2166]:=",ExpressionUUID->"a1aac24d-624f-45ae-b88a-c5ece00d9ca4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeTVertex3DFromTGraph3D", "[", 
   RowBox[{
    StyleBox["tobj_TObj",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["i0_",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["i1_",
     FontSlant->"Italic"]}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobj1", ",", "verts3d", ",", "vva", ",", "glist", ",", "tobj2"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tobj1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"HasClassQ", "[", 
         RowBox[{"tobj", ",", "TPlaneGraph"}], "]"}], ",", "tobj", ",", 
        RowBox[{"tobj", "//", "RebuildPlaneGraph"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts3d", ",", "vva"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj1", ",", 
        RowBox[{"{", 
         RowBox[{"Vertices3D", ",", "VertexVertexAdjacency"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{
          "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
           "i1"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"MakeTVertex3DFromTGraph3D", "::", "badadj"}], ",", "i1", ",",
           "i0"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"glist", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}], "-", 
         RowBox[{
         "verts3d", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}],
         "&"}], "/@", 
       RowBox[{
       "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"glist", "=", 
      RowBox[{"RotateLeft", "[", 
       RowBox[{"glist", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
            "vva", "\[LeftDoubleBracket]", "i0", "\[RightDoubleBracket]"}], ",",
             "i1", ",", "1", ",", "1"}], "]"}], "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "-", "1"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"MakeTVertex3DFromFoldVectors", "[", "glist", "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5952763101089363`*^9, 3.595276318024272*^9}, {
   3.595276359798087*^9, 3.595276363662991*^9}, {3.595278427768565*^9, 
   3.5952787467030478`*^9}, {3.595278791946889*^9, 3.595278818020694*^9}, 
   3.59527894324346*^9, {3.595279208409768*^9, 3.595279214596252*^9}, 
