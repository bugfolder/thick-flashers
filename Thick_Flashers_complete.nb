Cell[TextData[{
 "AbsorbDivalentVertices[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a TGraph and returns a ",
 "TGraph",
 " containing a list ",
 StyleBox["newedges",
  FontSlant->"Italic"],
 " in which any divalent (order-2) vertices have been eliminated from the \
graph."
}], "Text",
 CellChangeTimes->{{3.59164856632844*^9, 3.591648600757898*^9}, {
  3.592349519920062*^9, 3.5923495450524077`*^9}, {3.592435847575465*^9, 
  3.592435847666019*^9}},ExpressionUUID->"bb02b00b-9ce4-4325-a362-\
4426dd6cb69d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AbsorbDivalentVertices", "[", "tobj_TObj", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"AssertClass", "[", 
       RowBox[{"tobj", ",", "TGraph", ",", "AbsorbDivalentVertices"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"ReplacePropertiesIn", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{"Edges", "\[Rule]", 
          RowBox[{"FixedPoint", "[", 
           RowBox[{"AbsorbOneDivalentVertex", ",", 
            RowBox[{"tobj", "[", "Edges", "]"}]}], "]"}]}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.591648928951211*^9, 3.591648937682648*^9}, {
   3.591649144734411*^9, 3.591649163117183*^9}, {3.591649252271452*^9, 
