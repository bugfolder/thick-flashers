Cell[TextData[{
 "Example. Note that the corners are slightly clipped since in this example \
we make the radius slightly larger than the radius of ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["pface",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]-1\[RightDoubleBracket]\[RightDoubleBracket] and ",
 StyleBox["verts",
  FontSlant->"Italic"],
 "\[LeftDoubleBracket]",
 StyleBox["pface",
  FontSlant->"Italic"],
