     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", "\[Gamma]"}], "}"}], "=", 
       RowBox[{"CurvedFoldUniformHelix3D", "[", 
        RowBox[{"r", ",", "\[Theta]", ",", "\[Gamma]0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"as", "=", 
       RowBox[{"as", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", ">", "0"}], ",", 
          RowBox[{"\[Gamma]0", ">", "0"}], ",", 
          RowBox[{"\[Theta]", "\[Element]", "Reals"}], ",", 
          RowBox[{
           RowBox[{"Sec", "[", "\[Theta]", "]"}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{"Cos", "[", 
            FractionBox["\[Gamma]0", "2"], "]"}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Theta]", "]"}], ">", "0"}]}], "}"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ff", ",", "rrL", ",", "rrR"}], "}"}], "=", 
       RowBox[{"FlattenFold2D", "[", 
        RowBox[{"ff", ",", "rrL", ",", "rrR", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
         RowBox[{"Simplification", "\[Rule]", "FullSimplify"}], ",", 
         RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"some", " ", "further", " ", "simplification"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ff", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ff", "[", "s", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              SqrtBox[
               RowBox[{
                RowBox[{"-", "1"}], "-", 
                RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}]], "\[Rule]", 
              RowBox[{"I", " ", 
               SqrtBox[
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}]]}]}], "}"}]}], ",", 
           "as"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rrL", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rrL", "[", "s", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              SqrtBox[
               RowBox[{
                RowBox[{"-", "1"}], "-", 
                RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}]], "\[Rule]", 
              RowBox[{"I", " ", 
               SqrtBox[
                RowBox[{"1", "+", 
                 RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}]]}]}], "}"}]}], ",", 
           "as"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rrR", "=", 
       RowBox[{"Functionize", "[", 
        RowBox[{"s", ",", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rrR", "[", "s", "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              SqrtBox[
               RowBox[{
                RowBox[{"-", "1"}], "-", 
                RowBox[{"Cos", "[", "\[Gamma]0", "]"}]}]], "\[Rule]", 
              RowBox[{"I", " ", 
