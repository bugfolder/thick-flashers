Cell[CellGroupData[{

Cell[TextData[{
 "ReverseFacesGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 "]\nReverseFacesGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.922912435616074*^9, 3.922912441264724*^9}, {
  3.922912524378208*^9, 
  3.922912528495462*^9}},ExpressionUUID->"fa599364-1a0a-4978-84c8-\
800093bddab1"],

Cell[TextData[{
 "ReverseFacesGC[",
 StyleBox["gc",
  FontSlant->"Italic"],
 "] takes a GraphicsComplex of a polyhedron and reverses the order of all of \
the faces. Use this when you are mirroring a GraphicsComplex to preserve the \
proper face ordering."
}], "Text",
 CellChangeTimes->{{3.922912449591783*^9, 
  3.922912491259218*^9}},ExpressionUUID->"66d72cb0-c2dc-4f04-8b8f-\
57e72660ea2c"],

Cell[TextData[{
 "ReverseFacesGC[",
 StyleBox["expr",
  FontSlant->"Italic"],
 "] does the same for any GraphicsComplex objects in ",
 StyleBox["expr",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.922912564180789*^9, 
  3.922912587557914*^9}},ExpressionUUID->"10d32d85-23df-467f-9d6e-\
9f7a68948947"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReverseFacesGC", "[", "gc_GraphicsComplex", "]"}], ":=", 
  RowBox[{"gc", "/.", 
   RowBox[{
    RowBox[{"Polygon", "[", "pts_", "]"}], ":>", 
    RowBox[{"Polygon", "[", 
     RowBox[{"Reverse", "[", "pts", "]"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.922912493020026*^9, 3.922912516615495*^9}, {
  3.922912593631839*^9, 3.922912629541222*^9}},
 CellLabel->
  "In[4306]:=",ExpressionUUID->"a8880f36-0c09-4311-aa2b-903765ed898b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReverseFacesGC", "[", "expr_", "]"}], ":=", 
  RowBox[{"expr", "/.", 
   RowBox[{"gc_GraphicsComplex", ":>", 
    RowBox[{"ReverseFacesGC", "[", "gc", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.922912635108142*^9, 3.922912669008202*^9}},
 CellLabel->
  "In[4307]:=",ExpressionUUID->"19fde5b6-a16a-4501-9622-b9b5707b0eee"],

Cell["Example.", "Text",
 CellChangeTimes->{{3.9229126924299*^9, 
  3.922912693397888*^9}},ExpressionUUID->"9d6c3ca0-02dc-4c93-be27-\
2de35c8617d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"expr1", ",", "expr2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expr1", "=", 
      RowBox[{"{", "CubeGC", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr2", "=", 
      RowBox[{"ReverseFacesGC", "[", "expr1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Graphics3D", "[", 
         RowBox[{"Style", "[", 
          RowBox[{"expr1", ",", "SolidStyle", ",", 
           RowBox[{"Opacity", "[", "1", "]"}]}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
