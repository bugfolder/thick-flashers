   3.722248631823864*^9}},ExpressionUUID->"814b0447-bf28-4d39-bb31-\
09591ff45410"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["tobj",
  FontSlant->"Italic"],
 " \[LongDash] the TGraph being folded.\n\t",
 StyleBox["foldangles",
  FontSlant->"Italic"],
 " \[LongDash] an array of fold angles for each edge. Should be 0 for \
unfolded and border, \[PlusMinus]\[Pi] for folded edges."
}], "Text",
 CellChangeTimes->{{3.722248663085514*^9, 
  3.7222487159177217`*^9}},ExpressionUUID->"87ce010e-e8d3-4d94-af6a-\
59e5fc99dcfe"],

Cell[TextData[{
 "Options:\n\tStationaryFace \[Rule] ",
 StyleBox["sface",
  FontSlant->"Italic"],
 ", the index of the face whose position remains unchanged.\n\tShowProgress \
\[Rule] True | False, whether to show progress and internal structures. \
Useful for debugging."
}], "Text",
 CellChangeTimes->{
  3.722248539983442*^9, {3.722248727638082*^9, 3.722248741877592*^9}, 
   3.7222488281772833`*^9},ExpressionUUID->"dda26fa6-67cb-4b40-be65-\
00bedfca1903"],

Cell["\<\
Returns a TGraph2D with the new embedding in property Vertices2D. Any \
existing Vertices2D data is replaced.\
\>", "Text",
 CellChangeTimes->{{3.722248636363839*^9, 3.722248645972193*^9}, {
  3.722248960721542*^9, 
  3.722248970663919*^9}},ExpressionUUID->"e2c78494-5ca9-4c28-bfc1-\
cf565dc03162"],

Cell["\<\
The original embedding should obey the Kawasaki-Justin Condition for all \
folded creases. If it doesn\[CloseCurlyQuote]t, no error will be generated \
but the results may be unreliable/unpredictable. \
\>", "Text",
 CellChangeTimes->{{3.722248532270993*^9, 3.722248537760838*^9}, 
   3.722248751181284*^9},ExpressionUUID->"4d638429-4b7f-41e6-967a-\
3b116b97d3c8"],

Cell["\<\
Note that although we only need a TGraph, not necessarily a full TPlaneGraph, \
if it isn\[CloseCurlyQuote]t a TPlaneGraph, index StationaryFace will apply \
to the default face list computed by TPlaneGraph, which might not be the same \
as the current Faces property.\
\>", "Text",
 CellChangeTimes->{{3.592432729886676*^9, 3.5924327491495037`*^9}, {
   3.592435855502573*^9, 3.592435855592004*^9}, 3.5928287114548483`*^9, {
   3.595340356451926*^9, 3.595340392461034*^9}, {3.595344357190323*^9, 
   3.595344372867652*^9}, {3.595344434041288*^9, 
   3.595344447591094*^9}},ExpressionUUID->"bc2d09ae-f94f-4a1e-b545-\
455de631f472"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FoldGraph2D", "]"}], "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"StationaryFace", "\[Rule]", "1"}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.484828799316506*^9, 3.484828811909363*^9}, 
   3.484829074387739*^9, 3.484927941083176*^9, {3.484928084298373*^9, 
   3.484928084659789*^9}, 3.592791267910019*^9, 3.5952002459112453`*^9},
 CellLabel->
  "In[1338]:=",ExpressionUUID->"baced0b1-c91e-48ef-ba78-f430a0d6890e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FoldGraph2D", "[", 
   RowBox[{"tobj_TObj", ",", "foldangles_List", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tobj1", ",", "verts", ",", "edges", ",", "faces", ",", "sface", ",", 
      "v", ",", "e", ",", "f", ",", "m", ",", "p", ",", "el", ",", "ea", ",", 
      "vfa", ",", "verts2d"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TGraph", ",", "FoldGraph2D"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"verts2d", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{"#", ",", 
          RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", 
       RowBox[{"FoldEmbedding", "[", 
        RowBox[{"tobj", ",", 
         RowBox[{"tobj", "[", "Vertices", "]"}], ",", "foldangles", ",", 
         "opts"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"HasClassQ", "[", 
        RowBox[{"tobj", ",", "TGraph2D"}], "]"}], ",", 
       RowBox[{"tobj", "//", 
        RowBox[{"ReplaceProperty", "[", 
         RowBox[{"Vertices2D", "\[Rule]", "verts2d"}], "]"}]}], ",", 
       RowBox[{"tobj", "//", 
        RowBox[{"AddTGraph2D", "[", "verts2d", "]"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.722248872255693*^9, 3.722248943952078*^9}},
 CellLabel->
  "In[1339]:=",ExpressionUUID->"dbad6c78-23d7-47ca-ae72-16382ffdb9a0"],

