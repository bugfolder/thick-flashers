Cell[TextData[{
 "Options:\n\tFoldLineStyle \[Rule] ",
 StyleBox["style,",
  FontSlant->"Italic"],
 " style directive to use for the drawn fold curve.\n\tRulingLineLeftStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the left ruling lines.\n\tRulingLineRightStyle \
\[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the right ruling lines.\n\t\
BoundaryLineLeftStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the left boundary line.\n\t\
BoundaryLineRightStyle \[Rule] ",
 StyleBox["style",
  FontSlant->"Italic"],
 ", style directive to use for the right boundary line.\n\t\
RulingLineDivisions, CurveDivisions, FillStyle, SurfaceOrientation are passed \
through to StyledRuledPatch.  "
}], "Text",
