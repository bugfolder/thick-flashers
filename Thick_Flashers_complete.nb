Cell[TextData[{
 "PotCrossSectionGraphics[",
 StyleBox["pts",
  FontSlant->"Italic"],
 ", ",
 StyleBox["opts",
  FontSlant->"Italic"],
 "]\n\t(options) Options[Graphics]"
}], "Subsubsection",
 CellChangeTimes->{{3.594584500841204*^9, 3.594584523127022*^9}, {
  3.594584567212632*^9, 3.594584575111659*^9}, {3.594664895234211*^9, 
