          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"gc", ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"igc", ",", "SolidStyle"}], "]"}]}], "}"}], ",", 
          RowBox[{"Axes", "->", "True"}]}], "]"}], ",", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
