          RowBox[{"FoldedFormGraphics3D", "[", "tobj3d", "]"}]}], "}"}], 
        "]"}], "/.", 
       RowBox[{"OrigamiStyle", "[", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
