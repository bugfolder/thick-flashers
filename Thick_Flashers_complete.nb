                RowBox[{"-", "z"}], ",", "z"}], "}"}], ",", 
              RowBox[{"LineStyle", "\[Rule]", "RulingLine"}]}], "]"}], "}"}], 
           ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"ruling", " ", "vector"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
