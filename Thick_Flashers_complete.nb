Cell[BoxData[
 RowBox[{
  RowBox[{"MakePenroseRhombTilingPrimalDualGraph", "[", 
   RowBox[{"n_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bt", ",", "sd", ",", "\[Phi]", ",", "a1", ",", "a2", ",", "o1", ",", 
      "o2", ",", "deflate", ",", "tl", ",", "tdv", ",", "dv", ",", "cmp", ",",
       "pairs", ",", "solos", ",", "lut", ",", 
      StyleBox["pverts",
       FontSlant->"Italic"], ",", 
      StyleBox["pedges",
       FontSlant->"Italic"], ",", "tobj", ",", 
      StyleBox["pfaces",
       FontSlant->"Italic"], ",", 
      StyleBox["dverts",
       FontSlant->"Italic"]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bt", "=", 
      RowBox[{
       RowBox[{"PenroseBorderTriangles", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{
       "Options", "[", "MakePenroseRhombTilingPrimalDualGraph", "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "infrastructure", " ", "for", " ", "building", " ", "Penrose", " ", 
       "tilings"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"GoldenRatio", "//", "N"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sd", "=", 
      RowBox[{
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", "2"}], "]"}], ",", "\[IndentingNewLine]", "1", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "i", "}"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"a1", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"72", " ", "i", " ", "\[Degree]"}], "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"72", " ", "i", "  ", "\[Degree]"}], "]"}]}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"36", "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"36", "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}]}], "}"}]}], "]"}], ",", 
                RowBox[{"a1", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"72", " ", "i", "  ", "\[Degree]"}], "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"72", " ", "i", "  ", "\[Degree]"}], "]"}]}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "36"}], "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "36"}], "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], 
          "]"}], ",", "\[IndentingNewLine]", "0", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "i", "}"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"o1", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"72", " ", "i", "  ", "\[Degree]"}], "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"72", " ", "i", "  ", "\[Degree]"}], "]"}]}], 
                   "}"}], ",", 
                  RowBox[{"\[Phi]", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"36", "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"36", "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}]}], "}"}]}]}], "]"}], ",", 
                RowBox[{"o1", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"72", " ", "i", "  ", "\[Degree]"}], "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"72", " ", "i", "  ", "\[Degree]"}], "]"}]}], 
                   "}"}], ",", 
                  RowBox[{"\[Phi]", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "36"}], "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}], ",", 
                    RowBox[{"Sin", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "36"}], "+", 
                    RowBox[{"72", " ", "i"}]}], ")"}], "  ", "\[Degree]"}], 
                    "]"}]}], "}"}]}]}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", "4"}], "}"}]}], "]"}], "]"}]}], 
          "]"}], ",", "\[IndentingNewLine]", "_", ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"MakePenroseRhombTilingPrimalDualGraph", "::", "badopt"}],
             ",", "sd"}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"deflation", " ", "rules"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflate", "[", 
       RowBox[{"a1", "[", 
        RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "]"}], ":=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[Phi]", "-", "1"}], ")"}], " ", "x"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"2", "-", "\[Phi]"}], ")"}], " ", "y"}]}], ")"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a2", "[", 
           RowBox[{"d", ",", "z", ",", "x"}], "]"}], ",", 
          RowBox[{"o2", "[", 
           RowBox[{"z", ",", "d", ",", "y"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflate", "[", 
       RowBox[{"o1", "[", 
        RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{"o2", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflate", "[", 
       RowBox[{"a2", "[", 
        RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{"a1", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflate", "[", 
       RowBox[{"o2", "[", 
        RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "]"}], ":=", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "-", "\[Phi]"}], ")"}], " ", "x"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Phi]", "-", "1"}], ")"}], " ", "z"}]}]}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"o1", "[", 
           RowBox[{"z", ",", "d", ",", "y"}], "]"}], ",", 
          RowBox[{"a1", "[", 
           RowBox[{"y", ",", "x", ",", "d"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflate", "[", "x_List", "]"}], ":=", 
      RowBox[{"Join", "@@", 
       RowBox[{"(", 
        RowBox[{"deflate", "/@", "x"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflate", "[", 
       RowBox[{"x_List", ",", "0"}], "]"}], ":=", "x"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"deflate", "[", 
       RowBox[{"x_List", ",", "nn_"}], "]"}], ":=", 
      RowBox[{"Nest", "[", 
       RowBox[{"deflate", ",", "x", ",", "nn"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "the", " ", "desired", " ", "raw", " ", "tiling", " ", "in", " ", 
       "triangle", " ", "form"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tl", "=", 
      RowBox[{"deflate", "[", 
       RowBox[{"sd", ",", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"\[LeftFloor]", 
           RowBox[{"n", "/", "2"}], "\[RightFloor]"}]}], "+", "1"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "record", " ", "the", " ", "dual", " ", "vertex", " ", "coordinates", " ",
        "for", " ", "each", " ", "triangle"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"tdv", "=", 
      RowBox[{"tl", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"a2", "[", 
           RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"x", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "2"}], "-", 
              RowBox[{"\[Phi]", "/", "2"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{"z", "-", "x"}], ")"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"o2", "[", 
           RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"z", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"\[Phi]", "/", "2"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{"x", "-", "z"}], ")"}]}]}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"indexify", " ", "all", " ", "vertex", " ", "coordinates"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pverts", ",", "tl"}], "}"}], "=", 
      RowBox[{"Indexify", "[", 
       RowBox[{"tl", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "group", " ", "triangles", " ", "into", " ", "pairs", " ", "and", " ", 
       "isolated", " ", "triangles", " ", 
       RowBox[{"(", 
        RowBox[{"which", " ", "are", " ", "on", " ", "the", " ", "border"}], 
        ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cmp", "[", 
       RowBox[{
        RowBox[{"a2", "[", 
         RowBox[{"x1_", ",", "y1_", ",", "z1_"}], "]"}], ",", " ", 
        RowBox[{"a2", "[", 
         RowBox[{"x2_", ",", "y2_", ",", "z2_"}], "]"}]}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x1", "\[Equal]", "x2"}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{"z1", "\[Equal]", "z2"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cmp", "[", 
       RowBox[{
        RowBox[{"o2", "[", 
         RowBox[{"x1_", ",", "y1_", ",", "z1_"}], "]"}], ",", " ", 
        RowBox[{"o2", "[", 
         RowBox[{"x2_", ",", "y2_", ",", "z2_"}], "]"}]}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x1", "\[Equal]", "x2"}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{"z1", "\[Equal]", "z2"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pairs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solos", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"cmp", "[", 
          RowBox[{
           RowBox[{
           "tl", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{
           "tl", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
          "]"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"pairs", ",", 
            RowBox[{
            "tl", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
           "]"}], ";", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"pairs", ",", 
            RowBox[{
            "tl", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{"Length", "[", "tl", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"IntersectingQ", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "tl", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "}"}], ",", "pairs"}], "]"}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"solos", ",", 
           RowBox[{
           "tl", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
          "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tl", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "build", " ", "edges", " ", "of", " ", "rhombs", " ", "and", " ", 
       "border", " ", "triangles"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"pairs", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"a2", "[", 
              RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "|", 
             RowBox[{"o2", "[", 
              RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}]}], "\[RuleDelayed]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", "z"}], "}"}]}], "}"}]}], "}"}]}], ",", "1"}],
         "]"}], "~", "Join", "~", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"solos", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"a2", "[", 
              RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "|", 
             RowBox[{"o2", "[", 
              RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}]}], "\[RuleDelayed]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", "z"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"z", ",", "x"}], "}"}]}], "}"}]}], "}"}]}], ",", "1"}],
         "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pedges", "=", 
      RowBox[{"Union", "[", 
       RowBox[{"Sort", "/@", "pedges"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "build", " ", "the", " ", "full", " ", "set", " ", "of", " ", "plane", 
        " ", "graph", " ", "data"}], ",", " ", 
       RowBox[{
       "using", " ", "centroids", " ", "for", " ", "the", " ", "dual", " ", 
        "vertices"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tobj", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MakeTGraph", "[", 
         RowBox[{"pverts", ",", "pedges"}], "]"}], "//", "AddTPlaneGraphTo"}],
        "//", "AddTPrimalDualGraphTo"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pfaces", "=", 
      RowBox[{"GetValue", "[", 
       RowBox[{"tobj", ",", "Faces"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "but", " ", "substitute", " ", "the", " ", "dual", " ", "vertices", " ",
        "we", " ", "already", " ", "computed"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dv", ",", "tdv"}], "}"}], "=", 
      RowBox[{"Indexify", "[", "tdv", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "lut", " ", "is", " ", "a", " ", "lookup", " ", "table", " ", "that", " ",
        "maps", " ", "a", " ", "trio", " ", "of", " ", "pvert", " ", 
       "indices", " ", "to", " ", "an", " ", "index", " ", "into", " ", 
       "dv"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"lut", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"List", "@@", "#"}], "&"}], "/@", "tl"}], ",", "tdv"}], 
        "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dverts", "=", 
      RowBox[{"dv", "\[LeftDoubleBracket]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"lut", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"IntersectingQ", "[", 
               RowBox[{
                RowBox[{
                "pfaces", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"#", "\[LeftDoubleBracket]", 
                  RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "}"}]}],
                "]"}], "&&", 
              RowBox[{"IntersectingQ", "[", 
               RowBox[{
                RowBox[{
                "pfaces", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"#", "\[LeftDoubleBracket]", 
                  RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "}"}]}],
                "]"}], "&&", 
              RowBox[{"IntersectingQ", "[", 
               RowBox[{
                RowBox[{
                "pfaces", "\[LeftDoubleBracket]", "i", 
                 "\[RightDoubleBracket]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"#", "\[LeftDoubleBracket]", 
                  RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], "}"}]}],
                "]"}]}], "&"}]}], "]"}], "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "pfaces", "]"}]}], "}"}]}], "]"}], 
       "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ReplacePropertyIn", "[", 
      RowBox[{"tobj", ",", 
       RowBox[{"DualVertices", "\[Rule]", "dverts"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.551736442879821*^9, 3.551736679456603*^9}, {
