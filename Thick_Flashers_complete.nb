Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]", ",", "dh", ",", "dv", ",", "ds", ",", "nh", ",", "nv", ",", 
      "\[Gamma]", ",", "tobj"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"60.", "\[Degree]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
