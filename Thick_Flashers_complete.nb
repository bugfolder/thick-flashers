   3.594732493208119*^9}},ExpressionUUID->"c27f14ab-a045-4229-8e8d-\
d0a089f65577"],

Cell[TextData[{
 "OrthogonalityAngles[",
 StyleBox["tobj",
  FontSlant->"Italic"],
 "] takes a ",
 "TObj",
 " containing Vertices, InteriorEdges, DualVertices, and DualEdges, \
representing a primal graph and its (putatively) orthogonal dual, and returns \
the orthogonality angle in degrees, which is a check on whether \
BuildOrthogonalDualVerticesRobust (see below) came up with a valid solution."
}], "Text",
 CellChangeTimes->{{3.455924161197736*^9, 3.45592424995257*^9}, {
   3.455928772483404*^9, 3.455928775203309*^9}, {3.455996903053591*^9, 
   3.455996934145217*^9}, {3.455997901465541*^9, 3.455997901823592*^9}, {
   3.4559979485127997`*^9, 3.455997949817065*^9}, {3.457623853394144*^9, 
   3.457623855161932*^9}, 3.461737384533427*^9, {3.591734669768697*^9, 
   3.591734710227128*^9}, {3.591737528724859*^9, 3.591737529423643*^9}, 
   3.592159003073547*^9, 
   3.592435747795032*^9},ExpressionUUID->"76fe6620-17df-4e9a-98fb-\
1c8ea1411407"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OrthogonalityAngles", "[", "tobj_TObj", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "dverts", ",", "dedges", ",", "pairsv", ",", 
      "dpairsv", ",", "dplens"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"AssertClass", "[", 
      RowBox[{"tobj", ",", "TPrimalDualGraph", ",", "OrthogonalityAngles"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"verts", ",", "edges", ",", "dverts", ",", "dedges"}], "}"}], "=", 
      RowBox[{"GetValues", "[", 
       RowBox[{"tobj", ",", 
        RowBox[{"{", 
         RowBox[{
         "Vertices", ",", "InteriorEdges", ",", "DualVertices", ",", 
          "DualEdges"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pairsv", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Subtract", "@@", 
         RowBox[{
         "verts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
        "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dpairsv", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Subtract", "@@", 
         RowBox[{
         "dverts", "\[LeftDoubleBracket]", "#", "\[RightDoubleBracket]"}]}], 
        "&"}], "/@", "dedges"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dplens", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Dot", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NormalizeReal", "/@", 
           RowBox[{"Rotate90", "/@", "pairsv"}]}], ",", "dpairsv"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dplens", "=", 
      RowBox[{"dplens", "*", 
       RowBox[{"(", 
        RowBox[{"Sign", "/@", "dplens"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#1", ".", 
             RowBox[{"Rotate90", "[", "#2", "]"}]}], "]"}], ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"#1", ".", "#2"}], "]"}]}], "]"}], "/", "\[Degree]"}], 
        "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"dpairsv", ",", "pairsv"}], "}"}]}], "]"}]}]}], " ", 
   RowBox[{"(*", " ", "orthogonality", " ", "*)"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.455924140467669*^9, 3.455924155500388*^9}, 
   3.455928631352027*^9, {3.455928663552086*^9, 3.455928674213242*^9}, {
