   3.629821997344095*^9, 3.629822186768804*^9, 3.629822289659562*^9, {
   3.629823130992614*^9, 3.629823165324048*^9}, 3.629823261074506*^9, {
   3.629825188232587*^9, 3.629825188633411*^9}, 3.629839184900758*^9, 
   3.629839223113677*^9},
 CellLabel->
  "In[2851]:=",ExpressionUUID->"4dfcc1d0-d6e6-4371-b321-5bbfe01a5290"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PolygonTile", "::", "badpolys"}], 
   "=", "\"\<Value `1` to option TilePolys should be True or False.\>\""}], 
