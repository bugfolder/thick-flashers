Cell["Unit regular polygon centered twist properties", "Subsection",
 CellChangeTimes->{{3.4577434164303713`*^9, 3.457743417723331*^9}, {
   3.457922043675967*^9, 3.457922044017687*^9}, {3.461408642944976*^9, 
   3.461408644013864*^9}, {3.533668924652453*^9, 3.533668927724152*^9}, {
   3.5336836982941527`*^9, 3.533683699078156*^9}, 3.627340097634039*^9, 
   3.627385975716701*^9, 3.628636961940662*^9, {3.628692029252412*^9, 
   3.628692031330206*^9}, {3.628693009747274*^9, 3.628693009955231*^9}, {
   3.628693115460939*^9, 3.6286931218839493`*^9}, 
   3.628708777576641*^9},ExpressionUUID->"feabf212-7b49-49c0-837d-\
cee123630244"],

Cell[CellGroupData[{

Cell[TextData[{
 "UnitRegularPolygonCenteredTwistSelfContainedQ[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.4577235862583*^9, 3.457723598119549*^9}, {
   3.6273396661993513`*^9, 3.627339666327326*^9}, 3.627385865792481*^9, 
   3.6273859757179327`*^9, {3.628637059981819*^9, 3.628637060121711*^9}, 
   3.6286933567219677`*^9, 
   3.629849183745897*^9},ExpressionUUID->"bdd94bbc-5e9f-4799-95f2-\
00beca659d73"],

Cell[TextData[{
 "UnitRegular",
 "PolygonCenteredTwist",
 "SelfContainedQ[",
 StyleBox["n",
  FontSlant->"Italic"],
 ", ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", \[Tau], ",
 StyleBox["types",
  FontSlant->"Italic"],
 "] returns True if the angles and MV-assignment are consistent with a valid \
simple flat twist AND the resulting tile is self-contained, meaning that the \
twist polygon ends up wholly contained by its tile."
}], "Text",
 CellChangeTimes->{{3.457723653072911*^9, 3.4577236552213187`*^9}, {
   3.4577438050259666`*^9, 3.457743822183509*^9}, 3.6273396664819*^9, 
   3.627385865961005*^9, 3.627385975718347*^9, 
   3.6286370602676992`*^9},ExpressionUUID->"cdab2056-13a3-433d-85d2-\
054e71b708e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitRegularPolygonCenteredTwistSelfContainedQ", "[", 
    RowBox[{"n_", ",", "w_", ",", "\[Tau]_", ",", "types_List"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"RegularPolygonTwistValidQ", "[", 
     RowBox[{"n", ",", 
      RowBox[{"CenteredTwistAngle", "[", 
       RowBox[{"w", ",", "\[Tau]"}], "]"}], ",", "types"}], "]"}], "&&", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Tan", "[", "\[Tau]", "]"}], "]"}], ">", 
     FractionBox[
      RowBox[{"Tan", "[", 
       FractionBox["\[Pi]", "n"], "]"}], 
      RowBox[{"1", "-", 
       RowBox[{"2", "w"}]}]]}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.592165344562351*^9, {3.627339666516111*^9, 3.627339666550647*^9}, 
   3.627340267218552*^9, {3.627385866044093*^9, 3.627385866176783*^9}, 
   3.6273859757188053`*^9, 3.627591720857094*^9, {3.628637060410754*^9, 
   3.628637060611026*^9}, 3.628637203127329*^9, 3.629839433172655*^9},
 CellLabel->
  "In[2999]:=",ExpressionUUID->"28c7ce0b-f114-4a6c-80ab-66f8a1551c52"]
}, Closed]],

