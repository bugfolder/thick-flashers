Cell[CellGroupData[{

Cell["Vertices as vectors and scalars", "Subsection",
 CellChangeTimes->{{3.911880524241758*^9, 3.911880538699801*^9}, {
   3.911880873061475*^9, 3.911880887571677*^9}, 
   3.91188502209451*^9},ExpressionUUID->"4af67b6d-da6a-4081-8230-\
ec34dfcc0662"],

Cell[CellGroupData[{

Cell["Notes", "Subsubsection",
 CellChangeTimes->{{3.913543342388354*^9, 
  3.913543342861786*^9}},ExpressionUUID->"efb04f92-5ea8-44d6-8ef0-\
0e038638ec6b"],

Cell["\<\
For regular flashers, we defined a set of symbols that were used in symbolic \
calculations:\
\>", "Text",
 CellChangeTimes->{{3.913543446679626*^9, 
  3.913543477346072*^9}},ExpressionUUID->"fb91f668-426e-4a09-ae39-\
931a179ef396"],

Cell[BoxData[
 RowBox[{"FlasherVars", "[", "]"}]], "Input",
 CellChangeTimes->{{3.913543478832929*^9, 3.913543484658611*^9}},
 CellLabel->
  "In[4476]:=",ExpressionUUID->"7277e7b9-da07-47fc-b3cc-355413b55a44"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "f2665cb3-93a5-4543-81cc-e8d466655bed"],
 " was a 2D vector point of the CP with scalar components ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["px", 
      RowBox[{"i", ",", "j"}]], ",", 
     SubscriptBox["py", 
      RowBox[{"i", ",", "j"}]]}], "}"}], TraditionalForm]],ExpressionUUID->
  "03dcd740-c7e0-406d-9e96-c8876da13a7d"],
 " (no third subscript needed, since rotation was applied based on ",
 StyleBox["k",
  FontSlant->"Italic"],
 "); ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "0eee45b7-a767-4992-9f93-61d520532d81"],
 " was a 3D vector point of the FF with scalar components ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["ppx", 
      RowBox[{"i", ",", "j"}]], ",", 
     SubscriptBox["ppy", 
      RowBox[{"i", ",", "j"}]], ",", 
     SubscriptBox["ppz", 
      RowBox[{"i", ",", "j"}]]}], "}"}], TraditionalForm]],ExpressionUUID->
  "40c42d6a-38a5-457d-86a1-f531c6b409e6"],
 "."
}], "Text",
 CellChangeTimes->{{3.913543492758335*^9, 
  3.91354364907187*^9}},ExpressionUUID->"1e898cb9-a4b8-42a3-bb40-\
f2e4e5abfc8a"],

Cell[TextData[{
 "For thick flashers, we will still represent the 3D deployed pattern by two \
scalar variables ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["px", 
      RowBox[{"i", ",", " ", "j"}]], ",", " ", 
     SubscriptBox["py", 
      RowBox[{"i", ",", "j"}]]}], "}"}], TraditionalForm]],ExpressionUUID->
  "6ef0a9fc-8fae-4733-ae15-cb5ef4f1ab0f"],
 "; the third component of the 3D vector will come from appending the \
known/desired sag function to the two scalar variables."
}], "Text",
 CellChangeTimes->{{3.825675514211935*^9, 3.825675608060205*^9}, {
   3.825675657340533*^9, 3.825675681276762*^9}, {3.911834728701408*^9, 
   3.911834729116726*^9}, {3.911835179454873*^9, 3.911835181438797*^9}, 
   3.911880845538673*^9, {3.913543658588602*^9, 
   3.913543669458757*^9}},ExpressionUUID->"49c25fee-017e-4594-8e11-\
84ad6e272151"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "ThickFlasherScalarize[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m, t",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.719867069526457*^9, 3.7198670834218197`*^9}, {
   3.719868237117741*^9, 3.719868237404257*^9}, 3.719925980335895*^9, {
   3.825606494524758*^9, 3.825606497900666*^9}, {3.825606741766476*^9, 
   3.825606743158532*^9}, 3.825675647964883*^9, 3.911828158118345*^9, {
   3.911834712699238*^9, 3.911834719416144*^9}, {3.911835090990333*^9, 
   3.911835098743725*^9}, 3.911880861281067*^9, {3.913543795864734*^9, 
   3.913543796291584*^9}},ExpressionUUID->"7ec88f84-296d-4662-8f26-\
3379119b7542"],

Cell[TextData[{
 "ThickFlasherScalarize[",
 StyleBox["vars",
  FontSlant->"Italic"],
 ", ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", ",
 StyleBox["m, f",
  FontSlant->"Italic"],
 "] takes an expression that contains ",
 StyleBox["p",
  FontSlant->"Italic"],
 " or ",
 StyleBox["pp",
  FontSlant->"Italic"],
 " points and converts three-subscript vertices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"b21197e0-564e-44c2-8dcd-0cdc8e0df0d0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", " ", "j", ",", " ", "k"}]], TraditionalForm]],
  ExpressionUUID->"e69a4478-157e-4580-8b31-94c6b9841278"],
 " into vectors of components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", 
     RowBox[{"i", ",", "j", ",", "0"}]], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["px", 
       RowBox[{"i", ",", " ", "j"}]], ",", " ", 
      SubscriptBox["py", 
       RowBox[{"i", ",", "j"}]], ",", 
      SubscriptBox["s", 
       RowBox[{"i", ",", "j", ",", "0"}]]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"44970834-51ee-4716-b9b8-71fbc4ee2e99"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["pp", 
     RowBox[{"i", ",", "j", ",", "0"}]], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["ppx", 
       RowBox[{"i", ",", "j"}]], ",", " ", 
      SubscriptBox["ppy", 
       RowBox[{"i", ",", "j"}]], ",", " ", 
      SubscriptBox["ppz", 
       RowBox[{"i", ",", "j"}]]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "4b8ade9e-c39b-4940-9b31-176193e177b6"],
 ", respectively, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "2e1c059a-dad7-4501-97d0-7a4d02c1cc6e"],
 " is the sag value for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ",", "j", ",", "k"}], TraditionalForm]],ExpressionUUID->
  "1512a908-512f-4743-84d9-add56e9719fe"],
 "th vertex. It also applies rotation based on the rotational subscript ",
 StyleBox["k",
  FontSlant->"Italic"],
 " for rotational order ",
 StyleBox["m",
  FontSlant->"Italic"],
 " (thereby removing subscript ",
 StyleBox["k",
  FontSlant->"Italic"],
 " from ",
 StyleBox["obj",
  FontSlant->"Italic"],
 ")."
}], "Text",
 CellChangeTimes->{{3.55574892375367*^9, 3.5557489969319983`*^9}, {
   3.5557490732244463`*^9, 3.555749085982279*^9}, {3.555749308291521*^9, 
   3.555749394354454*^9}, {3.555750639818749*^9, 3.555750656767137*^9}, {
   3.555759846359387*^9, 3.555759846459425*^9}, {3.555765151624693*^9, 
   3.55576517054405*^9}, {3.555765216012394*^9, 3.555765231917538*^9}, 
   3.555788856636939*^9, {3.555837080438752*^9, 3.555837091393918*^9}, 
   3.719857926361224*^9, {3.719858026617935*^9, 3.719858057975539*^9}, {
   3.719865741320323*^9, 3.71986574246982*^9}, {3.7198682655013638`*^9, 
   3.719868265780978*^9}, 3.719925980350588*^9, {3.825606503119826*^9, 
   3.825606599285439*^9}, 3.911828158154406*^9, {3.9118347717307*^9, 
   3.91183482788453*^9}, {3.9118351934021883`*^9, 3.911835200421*^9}, 
   3.911880861308629*^9, {3.913543799777399*^9, 
   3.9135438165422*^9}},ExpressionUUID->"895d2e3f-547e-4e40-8835-\
29a699bfc001"],

Cell[TextData[{
 "Arguments:\n\t",
 StyleBox["vars",
  FontSlant->"Italic"],
 " \[LongDash] the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "p", ",", "px", ",", "py", ",", "pp", ",", "ppx", ",", "ppy", ",", 
     "ppz"}], "}"}], TraditionalForm]],ExpressionUUID->
  "1cb5e420-b9ce-421c-9854-152ba2e8d4d0"],
 " of symbols to use for vector and scalar variables.\n\t",
 StyleBox["expr",
  FontSlant->"Italic"],
 " \[LongDash] any expression contain subscripted vector points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "26fa994a-c16c-4975-a889-a9d6f53def26"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pp", 
    RowBox[{"i", ",", "j", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "bbeabfdf-bb68-4846-baca-b93ca5b3f80a"],
 ".\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " \[LongDash] the ring number.\n\t",
 StyleBox["h",
  FontSlant->"Italic"],
 " \[LongDash] the height index.\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " \[LongDash] the rotational order.\n\t",
 StyleBox["t",
  FontSlant->"Italic"],
 " \[LongDash] the desired panel thickness."
}], "Text",
 CellChangeTimes->{{3.913543697760539*^9, 3.913543745801195*^9}, {
  3.913543776446087*^9, 3.9135437769189243`*^9}, {3.913543826194417*^9, 
