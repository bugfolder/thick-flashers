Cell[TextData[{
 "Options:\n\tInitialPosition3D \[Rule] ",
 StyleBox["c0",
  FontSlant->"Italic"],
 ", specifies the initial (",
 StyleBox["t",
  FontSlant->"Italic"],
 "=u0) position of the curve.\n\tInitialTangentVector3D \[Rule] ",
 StyleBox["t0",
  FontSlant->"Italic"],
 ", specifies the initial tangent direction of the curve as a unit vector.\n\t\
InitialNormalVector3D\[Rule] ",
 StyleBox["n0",
  FontSlant->"Italic"],
 ", specifies the initial normal direction of the curve as a unit vector.\n\t\
Options[NDSolve] are passed through. "
}], "Text",
