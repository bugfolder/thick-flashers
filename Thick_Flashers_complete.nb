Cell[TextData[{
 "ArcHat[",
 StyleBox["hat",
  FontSlant->"Italic"],
 "]\n",
 "ArcHat",
 "[",
 StyleBox["hats",
  FontSlant->"Italic"],
 "]"
}], "Subsubsection",
 CellChangeTimes->{{3.595526577021424*^9, 3.595526590771595*^9}, {
  3.595686133997364*^9, 
  3.595686134115243*^9}},ExpressionUUID->"6b1d0f71-1329-4c9c-bfe5-\
b05b29733b90"],

Cell[TextData[{
 "ArcHat",
 "[",
 StyleBox["hat",
  FontSlant->"Italic"],
 "] inverts the hat transformation and recovers the original angle."
}], "Text",
 CellChangeTimes->{{3.595526620459847*^9, 3.595526634047665*^9}, {
   3.595526683989338*^9, 3.595526700203356*^9}, 
   3.595686134233503*^9},ExpressionUUID->"d7e36ba1-deb1-4ddc-8d55-\
5c042b754446"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ArcHat", "[", "h_", "]"}], ":=", 
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{"h", "\[Equal]", "\[Infinity]"}], ",", "\[Pi]", ",", 
    RowBox[{"h", "\[Equal]", 
     RowBox[{"-", "\[Infinity]"}]}], ",", 
    RowBox[{"-", "\[Pi]"}], ",", "True", ",", 
    RowBox[{"2", " ", 
     RowBox[{"ArcTan", "[", "h", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.595526636059004*^9, 3.595526676592109*^9}, 
   3.595686134260744*^9},
 CellLabel->
  "In[743]:=",ExpressionUUID->"e3bcf4f4-83cf-4886-9ff9-71c74ba6d29b"],

Cell[TextData[{
 "ArcHat",
 "[",
 StyleBox["hats",
  FontSlant->"Italic"],
 "] inverts the hat transformation for a list of hats."
}], "Text",
 CellChangeTimes->{{3.595526620459847*^9, 3.595526634047665*^9}, {
   3.595526683989338*^9, 3.5955267231298013`*^9}, 
   3.595686134355081*^9},ExpressionUUID->"e3aa5ab8-e55f-4541-9f14-\
c0f18fe765bd"],

