Cell[TextData[{
 "TwistTubeParameters[",
 StyleBox["m",
  FontSlant->"Italic"],
 ", {",
 StyleBox["h1",
  FontSlant->"Italic"],
 ", ",
 StyleBox["h2",
  FontSlant->"Italic"],
 ", ",
 StyleBox["dir}",
  FontSlant->"Italic"],
 "] returns a list {\[Alpha], ",
 StyleBox["r",
  FontSlant->"Italic"],
 ", {d\[Phi]1, d\[Phi]2}} of the four parameters that define a segment of \
twist tube, where\n\t",
 StyleBox["m",
  FontSlant->"Italic"],
 " is the rotational order.\n\t",
 StyleBox["h1",
  FontSlant->"Italic"],
 " is one design height that the folded form can assume\n\t",
 StyleBox["h2",
  FontSlant->"Italic"],
 " is the second design height and the one that will be used\n\t",
 StyleBox["dir",
  FontSlant->"Italic"],
 " = +1 for right-handed twist, -1 for left-handed twist.\nThe return \
parameters describe the crease pattern and folded form; \n\t\[Alpha] is the \
lower left corner angle of each parallelogram in the CP\n\t",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the length of the tilted sides of each parallelogram in the CP\n\td\
\[Phi]1 and d\[Phi]2 are the rotational phase shifts of the top of the folded \
form"
}], "Text",
 CellChangeTimes->{{3.643362655597189*^9, 3.643362681057213*^9}, {
   3.643362727440913*^9, 3.643363059089159*^9}, {3.6433631919279747`*^9, 
   3.643363196791993*^9}, {3.643365452470531*^9, 3.643365502283786*^9}, 
   3.654260143051799*^9, 3.654261607683501*^9, {3.654262666521215*^9, 
   3.6542627250349293`*^9}},ExpressionUUID->"2609346d-cff1-412b-b32a-\
e16d99e3d42a"],

