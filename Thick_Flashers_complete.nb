793396d8ed27"],

Cell["\<\
We\[CloseCurlyQuote]ll use GenericFoldedFormGraphics for the folded form \
because the non-crossing line confuses VisibleFoldedFormGraphics when it \
tries to render hidden lines.\
\>", "Text",
 CellChangeTimes->{{3.722109250698985*^9, 
  3.722109285826885*^9}},ExpressionUUID->"143ed50e-be6e-40c6-b12a-\
babaa8de8aef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "edges", ",", "tobj", ",", "wper", ",", "tobjw", ",", 
      "tobjwf"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
