Cell[BoxData[
 RowBox[{
  RowBox[{"FoldAcrossRight2D", "[", 
   RowBox[{
   "f_Function", ",", "rL_Function", ",", "\[Gamma]_Function", ",", " ", 
    "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "si", ",", "as", ",", "s", ",", "sfn", ",", "csys", ",", "ds", ",", 
      "\[Kappa]g", ",", "t", ",", "l", ",", "cot\[Rho]L", ",", "expr1", ",", 
      "expr2", ",", "c\[Rho]L", ",", "s\[Rho]L", ",", "rR"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"si", "=", 
      RowBox[{
       RowBox[{"Simplification", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAcrossRight2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{
       RowBox[{"Assumptions", "/.", 
        RowBox[{"{", "opts", "}"}]}], "/.", 
       RowBox[{"Options", "[", "FoldAcrossRight2D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"as", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", "\[Element]", "Reals"}], "}"}], ",", "as"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sfn", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"si", "===", "None"}], ",", 
        RowBox[{"#", "&"}], ",", 
        RowBox[{
         RowBox[{"si", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "\[Rule]", "as"}]}], "]"}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "curve", " ", "fold", " ", "system", " ", "and", " ", "Frenet", " ", 
       "frame"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"csys", "=", 
      RowBox[{"Curve2DSystem", "[", 
       RowBox[{"f", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ds", ",", "\[Kappa]g", ",", "t", ",", "l"}], "}"}], "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Speed2D", ",", "LeftCurvature2D", ",", "TangentVector2D", ",", 
         "LeftNormalVector2D"}], "}"}], "/.", "csys"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Left", " ", "side"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{"NormalizeReal", "[", 
          RowBox[{
           RowBox[{"f", "'"}], "[", "s", "]"}], "]"}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"l", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationMatrix2D", "[", 
           RowBox[{"\[Pi]", "/", "2"}], "]"}], ".", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cot\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"t", "[", "s", "]"}], ".", 
           RowBox[{"rL", "[", "s", "]"}]}], 
          RowBox[{
           RowBox[{"l", "[", "s", "]"}], ".", 
           RowBox[{"rL", "[", "s", "]"}]}]], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Right", " ", "ruling", " ", "angle", " ", "sines", " ", "and", " ", 
       "cosines"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"expr1", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Tan", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], 
           RowBox[{"cot\[Rho]L", "[", "s", "]"}]}], "-", 
          FractionBox[
           RowBox[{
            RowBox[{"\[Gamma]", "'"}], "[", "s", "]"}], 
           RowBox[{
            RowBox[{"ds", "[", "s", "]"}], " ", 
            RowBox[{"\[Kappa]g", "[", "s", "]"}]}]]}], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expr2", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"Tan", "[", 
             FractionBox[
              RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"expr1", "[", "s", "]"}], "2"]}]], "//", "sfn"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"\[Gamma]", "[", "s", "]"}], "]"}], 
          FractionBox[
           RowBox[{
            RowBox[{"expr1", "[", "s", "]"}], " "}], 
           RowBox[{"expr2", "[", "s", "]"}]]}], "//", "sfn"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"s\[Rho]L", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         FractionBox[
          RowBox[{"Abs", "[", 
           RowBox[{"Tan", "[", 
            FractionBox[
             RowBox[{"\[Gamma]", "[", "s", "]"}], "2"], "]"}], "]"}], 
          RowBox[{"expr2", "[", "s", "]"}]], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Right", " ", "ruling", " ", "vector"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rR", "=", 
      RowBox[{"Functionize", "[", 
       RowBox[{"s", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationMatrix2D", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c\[Rho]L", "[", "s", "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"s\[Rho]L", "[", "s", "]"}]}]}], "}"}], "]"}], ".", 
          RowBox[{"t", "[", "s", "]"}]}], "//", "sfn"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"f", ",", "rL", ",", "rR"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.799443499854664*^9, 3.799443551389594*^9}, {
