   3.688138426320023*^9, 3.688138473786905*^9}, 3.690989404996224*^9, 
   3.690990056862054*^9, 3.690992249779747*^9, 3.691183131442524*^9, {
   3.691184520882509*^9, 3.691184531843586*^9}, 3.6912524663875437`*^9, {
   3.691252772181922*^9, 3.69125277223553*^9}, 3.691252835818444*^9, 
